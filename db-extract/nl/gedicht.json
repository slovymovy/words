            {
                "entry_id": "9cd2f41b-3306-3766-ab89-69ca3fbfb5c9",
                "word": "gedicht",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                        "entry_id": "9cd2f41b-3306-3766-ab89-69ca3fbfb5c9",
                        "glosses": [
                            "voltooid deelwoord van dichten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "cf4349e2-29ff-463a-8a5e-298ddba74a69",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "We hebben het gat gedicht."
                            },
                            {
                                "example_id": "547191f5-9a5b-4299-b085-b30979718ff4",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "Wie heeft Hallél gedicht?"
                            },
                            {
                                "example_id": "fccdba39-4c3b-4acd-af49-4975baa61199",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "De maas in de regelgeving wordt gedicht met de nieuwe wet"
                            },
                            {
                                "example_id": "18f09668-2f0a-41fc-bb3a-ffb8137c76fe",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "De tekst werd gedicht door de toneelschrijver Hippoliet van Peene en getoonzet door de componist Karel Miry."
                            },
                            {
                                "example_id": "eb74dbd2-8ec8-46c0-ae5f-b1adb3381a4b",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "Het gisteren opnieuw gedichte gat in de dijk heeft vannacht gehouden."
                            },
                            {
                                "example_id": "a2b9d706-5bd1-4132-9381-954515d030c9",
                                "sense_id": "778c6b7e-1fd3-37f9-9bb0-1e9a8d675e26",
                                "text": "De zangeres zingt door haarzelf gedichte en gecomponeerde liedjes."
                            }
                        ]
                    }
