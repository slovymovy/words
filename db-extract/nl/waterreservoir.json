                    {
                        "translation_id": "8c4dfc25-ccf6-4a63-ae5b-e7f3d32c04fd",
                        "source_entry_id": "2f1bd254-ad5a-3c81-92aa-916007a7346c",
                        "source_sense_id": "83139b64-2b12-3457-924c-fd7372fe6bda",
                        "target_lang_word": "cistern",
                        "target_lang_code": "en",
