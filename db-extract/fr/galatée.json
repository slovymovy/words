                    {
                        "sense_id": "3724fb9d-b0b3-3c88-a10f-802eaf49c10e",
                        "entry_id": "5b0d405a-0232-3291-99e4-314513d41d7c",
                        "glosses": [
                            "Néréide, nymphe marine de la mythologie grecque, fille de Nérée, dieu marin primitif, et de Doris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2671110b-f4e1-4112-b6a3-195582c62178",
                                "sense_id": "3724fb9d-b0b3-3c88-a10f-802eaf49c10e",
                                "text": "Galatée est connue pour avoir la peau blanche comme du lait."
                            }
                        ]
                    },
                    {
                        "sense_id": "abcf2327-5b68-32c2-90e0-eeff14b86c04",
                        "entry_id": "5b0d405a-0232-3291-99e4-314513d41d7c",
                        "glosses": [
                            "Statue d’ivoire créée par Pygmalion, dont il tomba amoureux et qu’Aphrodite anima pour exaucer son vœu d’avoir une épouse « semblable à la statue »."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "7f1fd9c1-95b0-46cc-b910-e1ab4f25bce5",
                                "sense_id": "abcf2327-5b68-32c2-90e0-eeff14b86c04",
                                "text": "L’histoire de Galatée préfigure légèrement celle de Pinocchio."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cc5eb1a-4da7-37e5-bd4b-ff6e274e2d2d",
                        "entry_id": "5b0d405a-0232-3291-99e4-314513d41d7c",
                        "glosses": [
                            "Type de bergère coquette, inventé par Virgile dans ses Églogues."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "34bbbb05-bce0-3778-8b78-7e875a9a8f12",
                        "entry_id": "5b0d405a-0232-3291-99e4-314513d41d7c",
                        "glosses": [
                            "Satellite naturel de la planète Neptune."
