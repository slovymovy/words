{
    "word_family": [
        "reclamation",
        "reclaimable",
        "reclaimer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "093e8f78-53ce-3998-a63e-134736166df8",
                    "sense_definition": "To demand or get back something that belonged to you or was lost",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "take_back",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>reclaim</w> her lost luggage at the airport after a few hours.",
                            "target_lang_translations": {
                                "zh": "几小时后，她在机场成功<w>取回</w>了丢失的行李。"
                            }
                        },
                        {
                            "text": "You can <w>reclaim</w> your property from the station with proper identification.",
                            "target_lang_translations": {
                                "zh": "你可以凭有效证件从车站<w>索回</w>你的财物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recover",
                        "retrieve",
                        "repossess"
                    ],
                    "common_phrases": [
                        "reclaim your property",
                        "reclaim lost items"
                    ],
                    "target_lang_definitions": {
                        "zh": "要求或取回属于自己或丢失的东西"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "取回",
                                "target_lang_sense_clarification": "指拿回属于自己的物品"
                            },
                            {
                                "target_lang_word": "索回",
                                "target_lang_sense_clarification": "指通过要求或法律手段拿回"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc6c1d6f-d242-3932-95e5-6167f30885c8",
                    "sense_definition": "To make land suitable for building or farming, often by draining water or restoring it",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land_restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city plans to <w>reclaim</w> land from the sea to build a new public park.",
                            "target_lang_translations": {
                                "zh": "该市计划从海中<w>围垦</w>土地以建设一座新的公园。"
                            }
                        },
                        {
                            "text": "They want to <w>reclaim</w> unused land for sustainable agriculture.",
                            "target_lang_translations": {
                                "zh": "他们希望<w>开垦</w>闲置土地用于可持续农业。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reclaim land"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过排水或修复使土地适合建筑或耕种"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "开垦",
                                "target_lang_sense_clarification": "指将荒地或水域变为可利用的土地"
                            },
                            {
                                "target_lang_word": "围垦",
                                "target_lang_sense_clarification": "特指从海中或湖中围筑土地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be762b3-172b-36aa-a306-1a19d5bad81b",
                    "sense_definition": "To recover useful materials or energy from waste products",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recycle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recycling plant works to <w>reclaim</w> materials from industrial waste.",
                            "target_lang_translations": {
                                "zh": "这家回收厂致力于从工业废料中<w>回收</w>材料。"
                            }
                        },
                        {
                            "text": "Engineers designed a system to <w>reclaim</w> waste heat to generate power.",
                            "target_lang_translations": {
                                "zh": "工程师们设计了一套系统来<w>回收</w>废热以进行发电。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recycle",
                        "recover"
                    ],
                    "common_phrases": [
                        "reclaim materials",
                        "reclaim waste"
                    ],
                    "target_lang_definitions": {
                        "zh": "从废弃物中回收有用的材料或能源"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回收",
                                "target_lang_sense_clarification": "指对废弃物进行再利用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9208170-57c5-3c03-81e0-c3867763d1bc",
                    "sense_definition": "To adopt a previously offensive or pejorative word and use it with positive pride",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community decided to <w>reclaim</w> a word that was previously used as an insult.",
                            "target_lang_translations": {
                                "zh": "该群体决定<w>重新定义</w>一个曾经被用作侮辱的词汇。"
                            }
                        },
                        {
                            "text": "activists often <w>reclaim</w> negative labels to strip them of their power.",
                            "target_lang_translations": {
                                "zh": "活动家们经常<w>重新定义</w>负面标签，以剥夺其伤害力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reclaim a word"
                    ],
                    "target_lang_definitions": {
                        "zh": "采用一个以前具有冒犯性或贬义的词，并以积极自豪的态度使用它"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重新定义",
                                "target_lang_sense_clarification": "指赋予旧词新的、积极的含义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                    "sense_definition": "To help someone return to a proper, moral, or correct way of life",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "moral_reform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rehabilitation program aims to <w>reclaim</w> young offenders before it is too late.",
                            "target_lang_translations": {
                                "zh": "该康复计划旨在为时已晚之前<w>挽救</w>年轻的违法者。"
                            }
                        },
                        {
                            "text": "He dedicated his life to trying to <w>reclaim</w> troubled youth from crime.",
                            "target_lang_translations": {
                                "zh": "他毕生致力于将误入歧途的青少年从犯罪中<w>挽救</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reform",
                        "rehabilitate"
                    ],
                    "target_lang_definitions": {
                        "zh": "帮助某人回归正途或道德生活"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挽救",
                                "target_lang_sense_clarification": "指使人脱离错误或危险的境地"
                            },
                            {
                                "target_lang_word": "感化",
                                "target_lang_sense_clarification": "指通过教育使人改过自新"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0682cdf1-8c7e-30c5-a102-26fe19bd3f0a",
                    "sense_definition": "To tame or domesticate a wild animal, especially a hawk",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It requires patience and skill to <w>reclaim</w> a wild hawk for hunting.",
                            "target_lang_translations": {
                                "zh": "驯服一只野鹰用于狩猎需要耐心和技巧，将其<w>驯服</w>并非易事。"
                            }
                        },
                        {
                            "text": "The falconer managed to <w>reclaim</w> the bird after weeks of quiet training.",
                            "target_lang_translations": {
                                "zh": "经过数周的安静训练，驯鹰人成功地<w>驯服</w>了这只鸟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tame"
                    ],
                    "antonyms": [
                        "subjugate"
                    ],
                    "target_lang_definitions": {
                        "zh": "驯服野生动物，尤指猎鹰"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驯服",
                                "target_lang_sense_clarification": "指使野性动物变得温顺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df7b3091-2a59-39b1-9bcc-d27e1d19224b",
                    "sense_definition": "To call back or quiet down unruly people or animals",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver tried in vain to <w>reclaim</w> the frightened horses.",
                            "target_lang_translations": {
                                "zh": "车夫试图<w>召回</w>受惊的马匹，但徒劳无功。"
                            }
                        },
                        {
                            "text": "No shouting could <w>reclaim</w> the excited dogs as they ran after the deer.",
                            "target_lang_translations": {
                                "zh": "当兴奋的狗追逐鹿时，任何喊叫都无法将它们<w>召回</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary/historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "召回或安抚难以控制的人或动物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "召回",
                                "target_lang_sense_clarification": "指叫回离开的人或动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c0f4fd7-d978-3903-ac3c-f18b776cf954",
                    "sense_definition": "To cry out in opposition, protest, or contradiction",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens began to <w>reclaim</w> against the new unjust taxes.",
                            "target_lang_translations": {
                                "zh": "市民们开始对不公正的新税收表示<w>抗议</w>。"
                            }
                        },
                        {
                            "text": "Scholars did <w>reclaim</w> strongly against the inaccurate findings in the report.",
                            "target_lang_translations": {
                                "zh": "学者们对报告中不准确的结论进行了强烈的<w>抗议</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "protest",
                        "object"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大声反对、抗议或反驳"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "指对某事表示强烈反对"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f503666c-b5cb-3f76-8504-a9cd39877f9a",
                    "sense_definition": "To draw back or yield",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the danger, his stubborn heart would not <w>reclaim</w> a single step.",
                            "target_lang_translations": {
                                "zh": "尽管危险重重，他那固执的心也不愿<w>退缩</w>一步。"
                            }
                        },
                        {
                            "text": "The warrior refused to <w>reclaim</w> from his firm position.",
                            "target_lang_translations": {
                                "zh": "战士拒绝从他坚守的阵地上<w>退缩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retreat"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "退缩或屈服"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "退缩",
                                "target_lang_sense_clarification": "指在困难或危险面前后退"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69bf16a1-daa4-35a0-85af-6e19fca19901",
                    "sense_definition": "To appeal a judge's ruling to a higher chamber in Scottish law",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense team decided to <w>reclaim</w> against the judge's preliminary decision.",
                            "target_lang_translations": {
                                "zh": "辩护团队决定对法官的初步裁决提出<w>上诉</w>。"
                            }
                        },
                        {
                            "text": "They intend to <w>reclaim</w> to the full court next month.",
                            "target_lang_translations": {
                                "zh": "他们打算下个月向全体法庭提出<w>上诉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appeal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在苏格兰法律中，将法官的裁决上诉至更高级别法院"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "上诉",
                                "target_lang_sense_clarification": "指请求上级法院重新审理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a13131ff-13b1-30aa-910c-0b5c3725d7c1",
                    "sense_definition": "Short form of baggage reclaim, the area in an airport where passengers collect luggage",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "baggage_claim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please head directly to the <w>reclaim</w> area to get your suitcases.",
                            "target_lang_translations": {
                                "zh": "请直接前往<w>行李提取处</w>领取您的手提箱。"
                            }
                        },
                        {
                            "text": "I will meet you near baggage <w>reclaim</w> after clearing customs.",
                            "target_lang_translations": {
                                "zh": "过完海关后，我在<w>行李提取处</w>附近等你。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "baggage reclaim"
                    ],
                    "target_lang_definitions": {
                        "zh": "机场行李提取处"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "行李提取处",
                                "target_lang_sense_clarification": "指机场专门领取托运行李的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8b393c7-9d3d-3f46-b05b-18965e06f7eb",
                    "sense_definition": "An attempt or act to get something back",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "take_back",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made a formal <w>reclaim</w> for the lost assets.",
                            "target_lang_translations": {
                                "zh": "公司就丢失的资产提出了正式的<w>索回</w>请求。"
                            }
                        },
                        {
                            "text": "Her <w>reclaim</w> of the family property took several years of legal action.",
                            "target_lang_translations": {
                                "zh": "她对家族财产的<w>索回</w>经历了数年的法律诉讼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery"
                    ],
                    "target_lang_definitions": {
                        "zh": "试图取回某物的行为"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "索回",
                                "target_lang_sense_clarification": "指要求归还财产的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e73dcd-6efe-33ed-b81a-3567c5d20974",
                    "sense_definition": "The act of bringing back or recalling a person",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king demanded the immediate <w>reclaim</w> of his exiled advisor.",
                            "target_lang_translations": {
                                "zh": "国王要求立即<w>召回</w>他被流放的顾问。"
                            }
                        },
                        {
                            "text": "They planned the secret <w>reclaim</w> of the captured prisoner.",
                            "target_lang_translations": {
                                "zh": "他们策划了秘密<w>召回</w>被俘囚犯的行动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "召回某人的行为"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "召回",
                                "target_lang_sense_clarification": "指将人从外地叫回"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4a2965-a837-3bb1-aaab-77a0c5c1b9f4",
                    "sense_definition": "The call used to summon a hunting bird back to its owner",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer gave a sharp whistle as a <w>reclaim</w> to the soaring bird.",
                            "target_lang_translations": {
                                "zh": "驯鹰人吹了一声尖锐的口哨，作为对高空飞翔的鸟儿的<w>召唤</w>。"
                            }
                        },
                        {
                            "text": "The hawk responded immediately to the handler's familiar <w>reclaim</w>.",
                            "target_lang_translations": {
                                "zh": "猎鹰对驯养员熟悉的<w>召唤</w>做出了立即回应。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in falconry"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于召唤猎鹰回到主人身边的呼唤"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "召唤",
                                "target_lang_sense_clarification": "指呼唤动物回到身边"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}