                                "target_senses": [
                                    {
                                        "sense_id": "670d5966-d2bf-3b75-8724-0679df9f2573",
                                        "entry_id": "a76df305-29b0-3a56-838d-a63e6836d982",
                                        "glosses": [
                                            "In an apt or suitable manner; fittingly; appropriately; suitably"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec6ad41-2568-4a6b-8eac-d7aaaa5e99dd",
                                                "sense_id": "670d5966-d2bf-3b75-8724-0679df9f2573",
                                                "text": "an aptly named hotel"
                                            },
                                            {
                                                "example_id": "da853e75-5f58-4de6-9be4-ce6b66f24a53",
                                                "sense_id": "670d5966-d2bf-3b75-8724-0679df9f2573",
                                                "text": "My friend, aptly nicknamed “Shorty”, was small but strong."
                                            },
                                            {
                                                "example_id": "8d3c4d5a-d7ea-4c1c-9819-96c028434ddb",
                                                "sense_id": "670d5966-d2bf-3b75-8724-0679df9f2573",
                                                "text": "The border-land where the white and black races meet in common debauch, the aptly-named black-and-tan saloon, has never been debatable ground from a moral stand-point."
                                            },
                                            {
                                                "example_id": "7abea1e0-01bb-4cf2-b8f0-7fe2c50cacc5",
                                                "sense_id": "670d5966-d2bf-3b75-8724-0679df9f2573",
                                                "text": "The Noisy Scrub-bird is aptly named because its main call of several sweet notes is ear-piercingly loud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cad48bb-bbc6-4961-8a8f-21950d7dc3d1",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "903da8e3-b550-3985-ae58-a49cdfbda7e9",
