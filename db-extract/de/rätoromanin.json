                "senses": [
                    {
                        "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                        "entry_id": "44f7b413-5e55-355b-a6d1-c8c3506fd341",
                        "glosses": [
                            "Angehörige einer im Alpenraum ansässigen Volksgruppe mit eigener Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673ef0c6-6d4d-4f6a-b1da-d7c8b2e5fb2c",
                                "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                                "text": "Die 31-jährige Rätoromanin wird Kadermitarbeiterin im Stab des Generaldirektors, wie RTR Radiotelevisiun Svizra Rumantscha in Chur mitteilte."
                            },
                            {
                                "example_id": "d0ff64a2-3263-4125-8a8e-125771955c0f",
                                "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                                "text": "»… Ah, ich glaube, dass du eine … oberengadinische Rätoromanin bist!«, sagte ich mit einem triumphierenden Lächeln auf den Lippen."
                            },
                            {
                                "example_id": "3da0f67a-72a4-4547-aba8-02cc842f9712",
                                "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                                "text": "Die gebürtige Rätoromanin löst Jean-Marc Widmer ab und ist die erste Frau an der Spitze des wichtigen Berufsverbandes der Polizistinnen und Polizisten der Schweiz."
                            },
                            {
                                "example_id": "391a9303-86c1-4e21-a016-72dc8a822d0d",
                                "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                                "text": "Die Leute müssten sich überlegen, wer überhaupt Rätoromane oder Rätoromanin sei."
                            },
                            {
                                "example_id": "22e1280d-1cd6-4eee-b1dc-35207de54434",
                                "sense_id": "81b5b135-aad0-3cd2-b6f5-c05be320a1b7",
                                "text": "Ein besonderes Anliegen war mir als Rätoromanin die Förderung der Viersprachigkeit der Schweiz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
