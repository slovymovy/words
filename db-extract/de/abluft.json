                        "form": "die Ablüfte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0df10d11-8d88-316e-8c98-61544347b3a1",
                        "entry_id": "c0a2ff56-71c8-32c7-86e6-0ee8b20a294d",
                        "glosses": [
                            "Luft, die aus einem Raum oder Gebäude abgesaugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee3e117-a1ec-4863-9ed9-cc4f5a3e030e",
                                "sense_id": "0df10d11-8d88-316e-8c98-61544347b3a1",
                                "text": "Eine Lüftungsanlage saugt Raumluft als Abluft durch ein Abluftgitter aus dem Raum an und führt diese als Fortluft in das Freie."
                            },
                            {
                                "example_id": "4f556595-397f-4130-b0f0-d0acf7ae83e3",
                                "sense_id": "0df10d11-8d88-316e-8c98-61544347b3a1",
                                "text": "„Abluft aus Räumen mit Lasten (Stoff-, Feuchte-, Wärmelasten) darf als Umluft nur dann genutzt werden, wenn Gesundheitsgefahren und Belästigungen ausgeschlossen werden können. Abluft aus Sanitärräumen, Raucherräumen und Küchen darf nicht als Zuluft genutzt werden.“"
                            },
                            {
                                "example_id": "bb9fd88d-94ab-4357-9e87-13bc2e700301",
                                "sense_id": "0df10d11-8d88-316e-8c98-61544347b3a1",
                                "text": "„Ob sie mit Umluft oder mit Abluft arbeiten – Abzugshauben in der Küche müssen mit der Wohnungslüftung harmonieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
