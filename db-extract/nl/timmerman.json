                                    {
                                        "sense_id": "ae9a366b-acab-3439-a8c6-ddf85d8121e6",
                                        "entry_id": "495abe8e-d70e-3803-a679-80c9d390d8e0",
                                        "glosses": [
                                            "colui che lavora il legno fabbricando e riparando mobili e altri oggetti"
                                        ],
                                        "tags": [
                                            "professione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59923873-612e-458f-ad53-ca5e06e3e903",
                                                "sense_id": "ae9a366b-acab-3439-a8c6-ddf85d8121e6",
