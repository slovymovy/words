                    {
                        "form_id": "d814fe57-dfec-44ab-ba09-2a244d1bc202",
                        "entry_id": "8f335f83-94f6-3630-bd3c-9f60b40a957b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hebraismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                        "entry_id": "8f335f83-94f6-3630-bd3c-9f60b40a957b",
                        "glosses": [
                            "ein Wort oder sonstiger sprachlicher Ausdruck der hebräischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bd31f2-e780-4d5a-b565-ccb01eaf7307",
                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                "text": "Eine ganze Reihe von Wörtern, die ursprünglich Hebraismen waren, sind über das Jiddische, also als Jiddismen ins Deutsche gelangt, so etwa das bekannte Adjektiv „koscher“."
                            },
                            {
                                "example_id": "4a8736db-dfc6-4571-8f20-ffe7c08d7b72",
                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                "text": "„Im Jiddischen ist nun eine Komponente die der Hebraismen, die für die alte Zeit schwer oder gar nicht von zitierten hebräischen Wörtern oder Wendungen sauber zu trennen sind, von Elementen also, die gar nicht dem Jiddischen zugehören.“"
                            },
                            {
                                "example_id": "1799f947-3529-43e0-9b5a-97c51009517a",
                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                "text": "„Hebraismen und Aramäismen des Jiddischen beschränken sich nicht nur auf Substantive, sondern es gibt auch Verben, Adjektive, Adverbien und Partikel…“"
                            },
                            {
                                "example_id": "603067f7-6237-4ea7-9f60-1ff8916e0263",
                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                "text": "„Sollten ihre Schriften von den einfachen Juden überhaupt verstanden werden, mußten sie sich deren Sprache mit all ihren Slawismen und Hebraismen bedienen.“"
                            },
                            {
                                "example_id": "c07ebc5d-4895-450d-a6a4-3b77057df76f",
                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                "text": "„Die Untersuchung hat ergeben, dass in der Gemeinsprache mit rund 150 mehr oder weniger geläufigen Hebraismen zu rechnen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7c3096-e608-4184-a3b7-f27b340c77f2",
                        "source_entry_id": "8f335f83-94f6-3630-bd3c-9f60b40a957b",
                        "source_sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                        "target_lang_word": "Hebraism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebraism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d57ed77-1521-3ff2-b932-83fe3e1975ae",
                                        "entry_id": "9e229e8c-3ae6-39e6-9301-eefbabd863ca",
                                        "glosses": [
                                            "A characteristic trait of the Hebrew language. By extension it is sometimes applied to the Jewish people or their faith, national ideology, or culture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3431cd63-4568-425c-bcc2-5f6c2953440b",
                                                "sense_id": "8d57ed77-1521-3ff2-b932-83fe3e1975ae",
                                                "text": "The Scripture Greek is observed to be full of Syriasms and Hebraisms."
                                            },
                                            {
                                                "example_id": "4358a678-a121-4d5d-b7cc-427c6e38776a",
                                                "sense_id": "8d57ed77-1521-3ff2-b932-83fe3e1975ae",
                                                "text": "Who, in reading this magnificent Hebraism, in his conception, sees aught but the heroic son of Nun, with the outstretched arm, and the greater and lesser light obsequious?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4840de3-059b-32a8-9b6b-3a40a3b83f19",
                                        "entry_id": "9e229e8c-3ae6-39e6-9301-eefbabd863ca",
                                        "glosses": [
                                            "Excessive use of expressions derived from Hebrew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b02d33b-b159-47f5-9d6b-9588be3befa9",
                        "source_entry_id": "8f335f83-94f6-3630-bd3c-9f60b40a957b",
                        "source_sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                        "target_lang_word": "hébraïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hébraïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5d114d-c115-3476-8e54-cac9e1c197ee",
                                        "entry_id": "0c229d57-9939-3eaf-a821-cb90b88354b9",
                                        "glosses": [
                                            "Façon de parler propre et particulière à la langue hébraïque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d9ce96-1d93-4506-bcae-9d0d8c248a5a",
                                                "sense_id": "7c5d114d-c115-3476-8e54-cac9e1c197ee",
                                                "text": "C’est un hébraïsme, né d’une traduction irréfléchie de la particule."
                                            },
                                            {
                                                "example_id": "8301a758-154b-410b-bb73-e954db8e9875",
                                                "sense_id": "7c5d114d-c115-3476-8e54-cac9e1c197ee",
                                                "text": "Et de fait, à condition d’éviter les hébraïsmes, et d’en aligner la syntaxe sur le modèle allemand, le yiddish peut s’apparenter à l’un des multiples dialectes qui parcourent ce pays ultradécentralisé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
