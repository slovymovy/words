                                            {
                                                "example_id": "645c0511-3ad9-4cf3-a496-bb60c2e8060f",
                                                "sense_id": "f175f613-af5c-3632-bf13-c8f98a1c844f",
                                                "text": "Die Nockenwelle dreht sich in einem Ölbad."
                                            },
                                            {
                                                "example_id": "34d8b439-3791-445c-8c8d-fb6e2abb6189",
                                                "sense_id": "f175f613-af5c-3632-bf13-c8f98a1c844f",
                                                "text": "Dabei bewirkt die Drehbewegung des Wasserrads über eine Nockenwelle das periodische Heben des Hammers, der dann durch die Schwerkraft auf das zwischen Amboss und Hammer gehaltene Werkstück schlägt."
                                            },
                                            {
                                                "example_id": "7732671f-0736-4ce6-88bb-acb6d2593a33",
                                                "sense_id": "f175f613-af5c-3632-bf13-c8f98a1c844f",
                                                "text": "In der Vergangenheit war das Bauteildesign einer Nockenwelle durch die Verwendung einer massiven Welle gekennzeichnet, die entweder spanend oder mit Hilfe von Schmiede- bzw. Gießverfahren hergestellt wurde."
                                            }
