                "senses": [
                    {
                        "sense_id": "61ccf747-8784-3320-b56a-2de36cac1b0b",
                        "entry_id": "158f2122-3ef3-3cc1-a487-f6d56584fba1",
                        "glosses": [
                            "чужая сторона, земля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7991f7c5-fa69-4439-9bef-5f16c9c1cbc7",
                                "sense_id": "61ccf747-8784-3320-b56a-2de36cac1b0b",
                                "text": "Что ж за козак тот, который кинул в беде товарища, кинул его, как собаку, пропасть на чужбине?"
                            },
                            {
                                "example_id": "90cef048-0b89-4d03-835f-722b35354e46",
                                "sense_id": "61ccf747-8784-3320-b56a-2de36cac1b0b",
                                "text": "Батюшка из своего села на чужбину завезенной девушке не только поп, а и друг, и приятель, и милый гость."
                            }
                        ]
                    }
                ],
                "translations": [
