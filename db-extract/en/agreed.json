                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Einverstanden."
                                            },
                                            {
                                                "example_id": "10d0d0c7-547c-46fd-86a8-0be7ea6c224d",
                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Sind sie damit einverstanden?"
                                            },
                                            {
                                                "example_id": "c4ac19ca-f506-4101-8e91-eb3612a48ab5",
                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Wir sind nicht damit einverstanden, dass du wegziehst."
                                            },
                                            {
                                                "example_id": "b66c4311-93f5-4293-bc8b-34918c3be58d",
                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Wir sind uns doch einverstanden, dass „morgen“ „morgen früh“ bedeutet, oder?"
                                            },
                                            {
                                                "example_id": "00414b4d-591f-453d-b34a-d94d5e2a3ba4",
                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Wir erklären uns mit der vorzeitigen Rückzahlung des Darlehens einverstanden."
                                            },
                                            {
                                                "example_id": "f7ba6a6f-ad31-40a6-9f71-7c0271e111bc",
                                                "sense_id": "160652da-1ddb-37ae-a6fb-f440db4fec91",
                                                "text": "Ein einverstandener Kunde ist natürlich viel angenehmer, als einer, den man noch überzeugen muss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
