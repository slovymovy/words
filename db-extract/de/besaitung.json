                                                "sense_id": "992cfdc3-ab7e-39b7-91a4-45f7bd557bf7",
                                                "text": "One of the family's diversions was singing \"quodlibets.\" These \"what-you-wills\" were simply stringings together of various melodies […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6f4ba6-948d-3f8b-a9c9-0843b0e571c0",
                                        "entry_id": "b82d8955-6a04-3d8a-902e-314f4f7de212",
                                        "glosses": [
                                            "A defect in 3D printing where strings or whiskers of material are left on the finished product."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5c55ee-6008-46a8-81be-555ba60a6748",
                                                "sense_id": "0f6f4ba6-948d-3f8b-a9c9-0843b0e571c0",
                                                "text": "When a printer is extruding and has open spaces in a layer, printers pull the filament back so that stringing does not occur."
                                            }
                                        ]
