                "senses": [
                    {
                        "sense_id": "1cbbed76-8203-3506-aecd-ab4f5331b6d3",
                        "entry_id": "27ba3706-c968-31bd-b790-3a94f4fd0faa",
                        "glosses": [
                            "weibliche Person, die mit den Verhältnissen in einem bestimmten Land vertraut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e008f6e-0c65-4d99-9c94-7ea92ad6f2b8",
                                "sense_id": "1cbbed76-8203-3506-aecd-ab4f5331b6d3",
                                "text": "„Als gute Landeskennerin weisen die Autorin auch allerlei andere Details aus - der Hinweis etwa auf Selbsthilfeprojekte der Frauen oder auf Wiedereingliederungsmaßnahmen für ehemalige Kämpfer.“"
                            },
                            {
                                "example_id": "b3b1f514-1919-466f-aa31-4549e04b904a",
                                "sense_id": "1cbbed76-8203-3506-aecd-ab4f5331b6d3",
                                "text": "„‚Ich habe den Einsatz in Afghanistan immer unterstützt, gemeinsam mit meinen afghanischen Freunden, die sich nach Freiheit und Demokratie sehnen‘, sagt eine deutsche Landeskennerin, die anonym bleiben möchte.“"
                            }
                        ],
