{
    "word_family": [
        "currently",
        "currency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec95e62e-66b1-35fd-8f53-40b62546f819",
                    "sense_definition": "Existing or occurring at the moment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to discuss the <w>current</w> situation before making any decisions.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обсудить <w>текущую</w> ситуацию, прежде чем принимать какие-либо решения.",
                                "zh": "在做任何决定之前，我们需要讨论<w>当前</w>的情况。"
                            }
                        },
                        {
                            "text": "The <w>current</w> president has served for three years.",
                            "target_lang_translations": {
                                "ru": "<w>Нынешний</w> президент занимает свой пост уже три года.",
                                "zh": "<w>现任</w>总统已经任职三年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "present",
                        "contemporary",
                        "modern",
                        "present-day"
                    ],
                    "antonyms": [
                        "past",
                        "future"
                    ],
                    "common_phrases": [
                        "current events",
                        "current situation",
                        "current status",
                        "current year"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или происходящий в данный момент.",
                        "zh": "存在于或发生于当下的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текущий",
                                "target_lang_sense_clarification": "происходящий сейчас"
                            },
                            {
                                "target_lang_word": "нынешний",
                                "target_lang_sense_clarification": "относящийся к настоящему времени"
                            },
                            {
                                "target_lang_word": "теперешний",
                                "target_lang_sense_clarification": "разг. существующий теперь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当前",
                                "target_lang_sense_clarification": "指目前的情况"
                            },
                            {
                                "target_lang_word": "目前",
                                "target_lang_sense_clarification": "指现在"
                            },
                            {
                                "target_lang_word": "现任",
                                "target_lang_sense_clarification": "指担任职务的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a19b9f4-4be0-3a5a-b7ea-0c8878b1b5be",
                    "sense_definition": "Generally accepted, used, practiced, or prevalent at the moment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_present",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This word is no longer in <w>current</w> use among young people.",
                            "target_lang_translations": {
                                "ru": "Это слово больше не в <w>ходу</w> среди молодежи.",
                                "zh": "这个词在年轻人中已经不再<w>通用</w>了。"
                            }
                        },
                        {
                            "text": "The <w>current</w> fashion trends favor bright colors and bold patterns.",
                            "target_lang_translations": {
                                "ru": "<w>Современные</w> модные тенденции отдают предпочтение ярким цветам и смелым узорам.",
                                "zh": "<w>流行</w>的时尚趋势偏爱明亮的颜色和大胆的图案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prevailing",
                        "prevalent",
                        "common",
                        "fashionable",
                        "popular"
                    ],
                    "antonyms": [
                        "out-of-date",
                        "unfashionable"
                    ],
                    "common_phrases": [
                        "current fashion",
                        "current opinion",
                        "current practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятый, используемый или распространенный в настоящее время.",
                        "zh": "目前普遍接受、使用、实行或流行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространённый",
                                "target_lang_sense_clarification": "часто встречающийся"
                            },
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "относящийся к настоящему времени, новый"
                            },
                            {
                                "target_lang_word": "актуальный",
                                "target_lang_sense_clarification": "важный в данный момент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流行",
                                "target_lang_sense_clarification": "指在当下广泛传播"
                            },
                            {
                                "target_lang_word": "通用",
                                "target_lang_sense_clarification": "指目前普遍使用"
                            },
                            {
                                "target_lang_word": "现代",
                                "target_lang_sense_clarification": "指属于当代的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a71f3e9-6332-3e8c-835c-3dd94331e114",
                    "sense_definition": "Running or moving rapidly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>current</w> stream flowed quickly through the dense forest.",
                            "target_lang_translations": {
                                "ru": "<w>Быстрый</w> ручей стремительно тек через густой лес.",
                                "zh": "<w>湍急</w>的溪流迅速穿过茂密的森林。"
                            }
                        },
                        {
                            "text": "They chased the stag through the <w>current</w> waters of the river.",
                            "target_lang_translations": {
                                "ru": "Они преследовали оленя через <w>бурные</w> воды реки.",
                                "zh": "他们追赶着那头雄鹿，穿过了河中<w>奔腾</w>的流水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speeding"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро текущий или движущийся.",
                        "zh": "快速流动或移动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "о движении воды"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "стремительный, неспокойный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "湍急",
                                "target_lang_sense_clarification": "形容水流急"
                            },
                            {
                                "target_lang_word": "奔腾",
                                "target_lang_sense_clarification": "形容水流猛烈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e105693-6295-376a-a39d-9d2c8e6ab452",
                    "sense_definition": "The generally unidirectional movement of a gas or fluid, such as water or air.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "flow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is dangerous to swim against the strong <w>current</w>.",
                            "target_lang_translations": {
                                "ru": "Опасно плыть против сильного <w>течения</w>.",
                                "zh": "逆着强劲的<w>水流</w>游泳是很危险的。"
                            }
                        },
                        {
                            "text": "Warm air <w>currents</w> help the eagle soar high above the mountains.",
                            "target_lang_translations": {
                                "ru": "Тёплые воздушные <w>потоки</w> помогают орлу парить высоко над горами.",
                                "zh": "温暖的<w>气流</w>帮助老鹰在高山之上翱翔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flow",
                        "stream",
                        "tide"
                    ],
                    "common_phrases": [
                        "strong current",
                        "ocean current",
                        "air current",
                        "against the current"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленное движение газа или жидкости, например воды или воздуха.",
                        "zh": "气体或液体（如水或空气）的定向流动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "движение воды в реке или море"
                            },
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "движущаяся масса жидкости или газа"
                            },
                            {
                                "target_lang_word": "струя",
                                "target_lang_sense_clarification": "узкий поток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水流",
                                "target_lang_sense_clarification": "指水的流动"
                            },
                            {
                                "target_lang_word": "气流",
                                "target_lang_sense_clarification": "指空气的流动"
                            },
                            {
                                "target_lang_word": "潮流",
                                "target_lang_sense_clarification": "指海洋的流动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1d6567e-171e-3054-94d5-90af37a6c804",
                    "sense_definition": "The flow of electric charge through a medium.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "flow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always switch off the power to stop the electric <w>current</w> before fixing the socket.",
                            "target_lang_translations": {
                                "ru": "Всегда отключайте питание, чтобы остановить электрический <w>ток</w>, прежде чем чинить розетку.",
                                "zh": "修理插座前，一定要切断电源以停止<w>电流</w>。"
                            }
                        },
                        {
                            "text": "Copper is a material that conducts <w>current</w> very efficiently.",
                            "target_lang_translations": {
                                "ru": "Медь — это материал, который очень эффективно проводит <w>ток</w>.",
                                "zh": "铜是一种能非常高效地传导<w>电流</w>的材料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "electricity"
                    ],
                    "common_phrases": [
                        "electric current",
                        "alternating current",
                        "direct current"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток электрического заряда через проводник.",
                        "zh": "电荷通过介质的流动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ток",
                                "target_lang_sense_clarification": "электрический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电流",
                                "target_lang_sense_clarification": "物理学中的电荷流动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25fae41-94a0-3b20-b520-488bffad2cf7",
                    "sense_definition": "A tendency or a course of events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>current</w> of sadness beneath her cheerful words.",
                            "target_lang_translations": {
                                "ru": "За её веселыми словами скрывалась <w>нотка</w> грусти.",
                                "zh": "在她欢快的话语下，隐藏着一丝忧伤的<w>思潮</w>。"
                            }
                        },
                        {
                            "text": "He tried to change the political <w>current</w> of the time.",
                            "target_lang_translations": {
                                "ru": "Он пытался изменить политическое <w>течение</w> того времени.",
                                "zh": "他试图改变当时的政治<w>趋势</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tendency",
                        "trend",
                        "drift"
                    ],
                    "common_phrases": [
                        "current of thought",
                        "underlying current"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тенденция, направление или ход событий.",
                        "zh": "一种趋势或事件的发展方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "направление в искусстве, политике"
                            },
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "развитие событий"
                            },
                            {
                                "target_lang_word": "тенденция",
                                "target_lang_sense_clarification": "направленность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "趋势",
                                "target_lang_sense_clarification": "事物发展的动向"
                            },
                            {
                                "target_lang_word": "思潮",
                                "target_lang_sense_clarification": "思想的动向"
                            }
                        ]
                    }
                }
            ]
        },
        {
