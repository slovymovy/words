                        "form": "die Verwesungsgerüche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                        "entry_id": "fac26ca7-5129-3023-b1ae-500b6ce01bc1",
                        "glosses": [
                            "Wahrnehmung von Geruch nach Verwesung in der Umgebungsluft, an sich selbst oder an organischen Materialien; durch das Geruchsorgan wahrgenommene markante Ausdünstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70304904-f369-4d5e-9013-0b213f7db7d5",
                                "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                                "text": "„Die wesentlichen Duftstoffe, die dem Verwesungsgeruch seinen beißenden Charakter verleihen, heißen Cadaverin und Putrescin.“"
                            },
                            {
                                "example_id": "b2130bb1-ef86-40d2-92e0-ab0ba5d0048d",
                                "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                                "text": "„Ein leichter Verwesungsgeruch stieg vom Boden auf, der mit verrrotteten Blättern bedeckt war.“"
                            },
                            {
                                "example_id": "db406a8b-0a54-435d-862d-d2be851f0907",
                                "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                                "text": "„Dann öffnete er die Tür und ging hinein. Das Zimmer abgedunkelt. Leichter Verwesungsgeruch.“"
                            },
                            {
                                "example_id": "fd00a1f0-701b-484c-b8fa-704898e7480d",
                                "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                                "text": "„Aber zu dem süßlichen Geruch gesellt sich auch ein furchtbarer Gestank. Ein fauliger, brandiger Verwesungsgeruch, der viel intensiver ist als der Geruch von menschlichem Stuhl.“"
                            },
                            {
                                "example_id": "57898ee9-5ed4-4ae0-96d8-11fc9565d90c",
                                "sense_id": "7cbcd4be-3cba-3a29-8bac-5ab85d55cc46",
                                "text": "„Sie schmolzen zusammen und verwandelten sich von Fleisch zu Schleim, von Mensch zu Tier und von Tier zu Stein, eine abscheuliche Illusion, bei deren Anblick die drei Dörfler die Treppe hinabstürzten und die Flucht ergriffen, verfolgt von einem Verwesungsgeruch wie aus tausend Gräbern, der ihre Lungen vergiftete und in ihre Seelen sickerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
