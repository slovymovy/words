                {
                    "sense_id": "027082b9-c7a7-3dcf-87ff-48f0a268b9c8",
                    "sense_definition": "de grond klaarmaken voor landbouw, zoals ploegen of zaaien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer gaat elke ochtend vroeg het land <w>bewerken</w> met zijn tractor.",
                            "target_lang_translations": {
                                "en": "The farmer goes out early every morning to <w>cultivate</w> the land with his tractor.",
                                "ru": "Фермер каждое утро рано уезжает <w>обрабатывать</w> землю на своем тракторе."
                            }
                        },
                        {
                            "text": "Mijn vader zoekt sterke mannen om de grond te <w>bewerken</w> voor de nieuwe oogst.",
                            "target_lang_translations": {
                                "en": "My father is looking for strong men to <w>till</w> the soil for the new harvest.",
                                "ru": "Мой отец ищет сильных мужчин, чтобы <w>возделывать</w> почву для нового урожая."
