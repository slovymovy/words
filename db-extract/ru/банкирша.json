                                        "glosses": [
                                            "Celle qui fait le commerce de banque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca6b849-95de-4c9f-b1a3-a9b4372349f2",
                                                "sense_id": "36d8a62b-dfc3-345a-8ffd-30a9528bd8f3",
                                                "text": "En France, plus d’un banquier sur deux est une banquière"
                                            },
                                            {
                                                "example_id": "221908ea-9ca0-42b8-9a71-be1aef6aa500",
                                                "sense_id": "36d8a62b-dfc3-345a-8ffd-30a9528bd8f3",
                                                "text": "On la surnomme “la ravissante banquière” aussi bien que “Madame 8 %”, le rendement promis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6809b1d7-1e0e-3a71-949f-1b07db336e17",
                                        "entry_id": "4f2ef619-376b-3f75-bf21-fce8b6b5377d",
                                        "glosses": [
                                            "Celle qui tient le jeu contre tous ceux qui veulent jouer avec lui et qui met sur table une certaine somme d’argent pour les payer lorsqu’ils gagnent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b76ae4b-f91d-35ee-a540-7d4b40f4b05a",
                                        "entry_id": "4f2ef619-376b-3f75-bf21-fce8b6b5377d",
                                        "glosses": [
                                            "Épouse ou maitresse d’un banquier."
                                        ],
