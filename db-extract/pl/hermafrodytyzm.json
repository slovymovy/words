                                        "glosses": [
                                            "The condition of an organism that is able to reproduce as both male and female, either simultaneously (simultaneous hermaphroditism or cosexuality) or sequentially (sequential hermaphroditism or dichogamy)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
