                                                "sense_id": "08fb96f9-3ec6-3a80-99ff-2b5c7904a481",
                                                "text": "De hond begon te blaffen. \"Koest!\" riep zijn baasje, en meteen was het weer stil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "koest",
