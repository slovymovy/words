{
    "word_family": [
        "disguiser",
        "undisguised"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "317fbf25-ff78-3161-9f27-207cecdf6947",
                    "sense_definition": "Material (such as clothing, makeup, a wig) used to alter one’s visual appearance in order to hide one's identity or assume another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cape and moustache completed his <w>disguise</w>.",
                            "target_lang_translations": {
                                "ru": "Плащ и усы дополнили его <w>маскировку</w>.",
                                "zh": "一件斗篷和一撇胡子完成了他的<w>伪装</w>。"
                            }
                        },
                        {
                            "text": "She wore a clever <w>disguise</w> to the party so no one would recognize her.",
                            "target_lang_translations": {
                                "ru": "Она надела хитроумную <w>маскировку</w> на вечеринку, чтобы никто её не узнал.",
                                "zh": "她<w>乔装</w>打扮去参加聚会，这样就没人能认出她了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mask",
                        "camouflage",
                        "garb",
                        "costume"
                    ],
                    "common_phrases": [
                        "wear a disguise",
                        "perfect disguise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал (одежда, грим, парик), используемый для изменения внешности с целью скрыть личность.",
                        "zh": "用于改变外貌以隐藏身份或伪装成他人的物品（如服装、化妆品、假发）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировка",
                                "target_lang_sense_clarification": "средство изменения внешности"
                            },
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "одежда для изменения облика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伪装",
                                "target_lang_sense_clarification": "用于改变外貌的手段"
                            },
                            {
                                "target_lang_word": "化装",
                                "target_lang_sense_clarification": "通过改变装束来隐藏身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bd2af47-ea23-3878-bc7d-ed849f17f848",
                    "sense_definition": "The act or state of concealing one's identity or true nature, often as a ploy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He traveled in <w>disguise</w> to avoid being recognized by the guards.",
                            "target_lang_translations": {
                                "ru": "Он путешествовал <w>переодетым</w>, чтобы стражники его не узнали.",
                                "zh": "他<w>乔装</w>旅行，以免被守卫认出来。"
                            }
                        },
                        {
                            "text": "Any <w>disguise</w> may expose soldiers to be deemed enemy spies.",
                            "target_lang_translations": {
                                "ru": "Любая <w>маскировка</w> может привести к тому, что солдат сочтут вражескими шпионами.",
                                "zh": "任何<w>伪装</w>都可能导致士兵被视为敌方间谍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pretense"
                    ],
                    "common_phrases": [
                        "in disguise",
                        "master of disguise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или состояние сокрытия своей личности или истинной сущности.",
                        "zh": "隐藏身份或真实本性的行为或状态，通常作为一种策略。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировка",
                                "target_lang_sense_clarification": "действие по сокрытию личности"
                            },
                            {
                                "target_lang_word": "переодевание",
                                "target_lang_sense_clarification": "изменение внешнего вида одеждой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伪装",
                                "target_lang_sense_clarification": "隐藏真实身份的行为"
                            },
                            {
                                "target_lang_word": "乔装",
                                "target_lang_sense_clarification": "改变外表以掩盖身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9234622d-1ba2-3e5c-8fd4-ec864f6b8da6",
                    "sense_definition": "The appearance of something on the outside which masks what is beneath.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her apparent cheerfulness was just a <w>disguise</w> for her deep sadness.",
                            "target_lang_translations": {
                                "ru": "Её кажущаяся жизнерадостность была лишь <w>маской</w> для глубокой печали.",
                                "zh": "她表面上的开朗只是为了<w>掩饰</w>内心深处的悲伤。"
                            }
                        },
                        {
                            "text": "The blessing came in the <w>disguise</w> of a difficult challenge.",
                            "target_lang_translations": {
                                "ru": "Благословение пришло под <w>видом</w> сложного испытания.",
                                "zh": "这份祝福是以困难挑战的<w>伪装</w>形式出现的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guise",
                        "mask"
                    ],
                    "common_phrases": [
                        "thin disguise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний вид чего-либо, скрывающий то, что находится внутри или под ним.",
                        "zh": "掩盖内在本质的外部表象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "перен. притворная видимость"
                            },
                            {
                                "target_lang_word": "прикрытие",
                                "target_lang_sense_clarification": "то, что скрывает истинное положение"
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "внешняя форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伪装",
                                "target_lang_sense_clarification": "掩盖真相的表象"
                            },
                            {
                                "target_lang_word": "掩饰",
                                "target_lang_sense_clarification": "用来遮盖真实情况的手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0821d87f-01c7-3b30-afa2-2c20a501dd7b",
                    "sense_definition": "A change of behaviour resulting from intoxication or drunkenness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constable noticed the man's <w>disguise</w> after he stumbled out of the tavern.",
                            "target_lang_translations": {
                                "ru": "Констебль заметил <w>опьянение</w> мужчины после того, как тот, спотыкаясь, вышел из таверны.",
                                "zh": "警官在那人跌跌撞撞走出酒馆后，注意到了他的<w>醉意</w>。"
                            }
                        },
                        {
                            "text": "His sudden anger was attributed to the <w>disguise</w> of too much wine.",
                            "target_lang_translations": {
                                "ru": "Его внезапный гнев списали на <w>хмель</w> от чрезмерного количества вина.",
                                "zh": "他突然的愤怒被归咎于饮酒过量带来的<w>醉意</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to intoxication"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение поведения в результате опьянения.",
                        "zh": "因饮酒而导致的行为改变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опьянение",
                                "target_lang_sense_clarification": "состояние под воздействием алкоголя"
                            },
                            {
                                "target_lang_word": "хмель",
                                "target_lang_sense_clarification": "состояние опьянения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "醉意",
                                "target_lang_sense_clarification": "饮酒后的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "646c4fda-c144-3d63-978e-0ae4579b7c74",
                    "sense_definition": "To change the appearance of a person or thing so as to hide their identity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spies often <w>disguise</w> themselves to blend into the crowd.",
                            "target_lang_translations": {
                                "ru": "Шпионы часто <w>маскируются</w>, чтобы смешаться с толпой.",
                                "zh": "间谍经常<w>伪装</w>自己以混入人群。"
                            }
                        },
                        {
                            "text": "He tried to <w>disguise</w> himself as a delivery driver to enter the building.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>замаскироваться</w> под курьера, чтобы проникнуть в здание.",
                                "zh": "他试图<w>乔装</w>成送货司机进入大楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mask",
                        "camouflage",
                        "hide",
                        "conceal"
                    ],
                    "common_phrases": [
                        "disguise oneself",
                        "heavily disguised"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять внешний вид человека или предмета, чтобы скрыть его личность или свойства.",
                        "zh": "改变人或物的外观以隐藏其身份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскироваться",
                                "target_lang_sense_clarification": "изменять свою внешность"
                            },
                            {
                                "target_lang_word": "замаскироваться",
                                "target_lang_sense_clarification": "совершенный вид действия"
                            },
                            {
                                "target_lang_word": "переодеваться",
                                "target_lang_sense_clarification": "менять одежду для неузнаваемости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伪装",
                                "target_lang_sense_clarification": "改变外貌以隐藏身份"
                            },
                            {
                                "target_lang_word": "乔装",
                                "target_lang_sense_clarification": "改变装束以掩盖身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d2b3930-b66d-3fa4-abb6-5602f5086c02",
                    "sense_definition": "To avoid giving away or revealing something secret, such as feelings or intentions; to hide by a false appearance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>disguised</w> his true intentions with a friendly smile.",
                            "target_lang_translations": {
                                "ru": "Он <w>скрыл</w> свои истинные намерения за дружелюбной улыбкой.",
                                "zh": "他用友好的微笑<w>掩饰</w>了自己的真实意图。"
                            }
                        },
                        {
                            "text": "It was difficult to <w>disguise</w> my disappointment when I heard the news.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>скрыть</w> моё разочарование, когда я услышал новости.",
                                "zh": "听到这个消息时，我很难<w>掩盖</w>自己的失望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "mask",
                        "cloak"
                    ],
                    "common_phrases": [
                        "disguise the fact",
                        "disguise feelings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выдавать или не раскрывать что-либо тайное (чувства, намерения); прятать за ложной внешностью.",
                        "zh": "通过虚假的表象来隐藏秘密，如情感或意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "утаивать чувства или мысли"
                            },
                            {
                                "target_lang_word": "скрыть",
                                "target_lang_sense_clarification": "совершенный вид действия"
                            },
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "делать незаметным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掩饰",
                                "target_lang_sense_clarification": "隐藏真实想法或情感"
                            },
                            {
                                "target_lang_word": "掩盖",
                                "target_lang_sense_clarification": "使某事不被发现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c4060cc-91b3-3e11-adf7-ed9416e93712",
                    "sense_definition": "To affect or change by liquor; to intoxicate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests were well <w>disguised</w> with liquor by the end of the feast.",
                            "target_lang_translations": {
                                "ru": "К концу пира гости были изрядно <w>пьяны</w>.",
                                "zh": "宴会结束时，客人们都被酒<w>灌醉</w>了。"
                            }
                        },
                        {
                            "text": "He became <w>disguised</w> after drinking several gallons of ale.",
                            "target_lang_translations": {
                                "ru": "Он <w>опьянел</w>, выпив несколько галлонов эля.",
                                "zh": "喝了几加仑麦芽酒后，他<w>醉</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning to intoxicate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздействовать алкоголем; опьянять.",
                        "zh": "受酒精影响；使醉酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опьянять",
                                "target_lang_sense_clarification": "приводить в состояние опьянения"
                            },
                            {
                                "target_lang_word": "одурманивать",
                                "target_lang_sense_clarification": "затуманивать сознание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灌醉",
                                "target_lang_sense_clarification": "使人喝醉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}