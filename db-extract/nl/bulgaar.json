                                                "sense_id": "c5cfc2f5-5bca-3e02-911c-a70f05cf11ca",
                                                "text": "Gary Cahill, a target for Arsenal and Tottenham before the transfer window closed, put England ahead early on and Rooney was on target twice before the interval as the early hostility of the Bulgarian supporters was swiftly subdued."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bulgarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "455c76b7-2c8b-35fb-b1fb-7dc2b1989c16",
                                        "entry_id": "3aeb1edc-b95a-3091-95b1-7778741c0548",
                                        "glosses": [
                                            "A native of Bulgaria."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe1f02a7-6335-43cb-926a-b4f494e21d3c",
                                                "sense_id": "455c76b7-2c8b-35fb-b1fb-7dc2b1989c16",
                                                "text": "Actually, this ethnic situation—a “macédoine” of peoples—was complicated even more from the 1860s on when some of the Slavs in Macedonia who had always called themselves Bulgarians (and were considered so by most foreign experts) began developing a Macedonian national consciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8e08e7-3b15-3718-bb2c-f4a228d21645",
                                        "entry_id": "3aeb1edc-b95a-3091-95b1-7778741c0548",
                                        "glosses": [
                                            "The official language of Bulgaria."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b578857a-d9d0-44f9-80f5-7e7f72ee21d4",
                                                "sense_id": "7c8e08e7-3b15-3718-bb2c-f4a228d21645",
                                                "text": "The big advantage of learning Russian is that, once you’re proficient, you can understand other Slav languages such as Czech, Polish or Bulgarian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365f4dd0-0853-3309-91ad-dcb44c610599",
                                        "entry_id": "3aeb1edc-b95a-3091-95b1-7778741c0548",
                                        "glosses": [
                                            "Ellipsis of Bulgarian split squat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": [
