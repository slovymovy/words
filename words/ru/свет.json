            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3032bc3a-7824-3285-bcf4-4c7f8118d22f",
                    "sense_definition": "Электромагнитное излучение, воспринимаемое глазом и делающее окружающий мир видимым.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Яркий солнечный <w>свет</w> разбудил меня рано утром.",
                            "target_lang_translations": {
                                "en": "Bright sun<w>light</w> woke me up early in the morning.",
                                "zh": "明亮的太阳<w>光</w>在清晨很早就把我唤醒了。"
                            }
                        },
                        {
                            "text": "В комнате было темно, и я включил верхний <w>свет</w>.",
                            "target_lang_translations": {
                                "en": "It was dark in the room, so I turned on the overhead <w>light</w>.",
                                "zh": "房间里很黑，我打开顶灯，屋里立刻有了<w>光</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сияние",
                        "освещение"
                    ],
                    "antonyms": [
                        "темнота́",
                        "тьма",
                        "мрак",
                        "тень",
                        "темень",
                        "ночь"
                    ],
                    "common_phrases": [
                        "дневной свет",
                        "солнечный свет",
                        "яркий свет",
                        "скорость света"
                    ],
                    "target_lang_definitions": {
                        "en": "Electromagnetic radiation perceived by the eye and making the surrounding world visible.",
                        "zh": "电磁辐射，被人眼感知并使周围世界可见。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "light",
                                "target_lang_sense_clarification": "visible radiation"
                            },
                            {
                                "target_lang_word": "illumination",
                                "target_lang_sense_clarification": "lighting"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光",
                                "target_lang_sense_clarification": "可见的电磁辐射"
                            },
                            {
                                "target_lang_word": "光线",
                                "target_lang_sense_clarification": "光束或光照"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "006d8491-972d-33d1-b534-253b7222b836",
                    "sense_definition": "Электрическая энергия, используемая для освещения помещений и работы бытовых приборов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера вечером во всём доме внезапно отключили <w>свет</w>.",
                            "target_lang_translations": {
                                "en": "Last night, the <w>power</w> was suddenly cut off in the whole house.",
                                "zh": "昨天晚上整栋房子的<w>电</w>突然停了。"
                            }
                        },
                        {
                            "text": "Мы платим за <w>свет</w> и воду в конце каждого месяца.",
                            "target_lang_translations": {
                                "en": "We pay for <w>electricity</w> and water at the end of each month.",
                                "zh": "我们每个月底都要交<w>电</w>费和水费。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "выключить свет",
                        "нет света",
                        "дать свет",
                        "платить за свет"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in everyday speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Electrical energy used for lighting rooms and operating household appliances.",
                        "zh": "用于照明房间和运行家用电器的电能。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "power",
                                "target_lang_sense_clarification": "electricity supply"
                            },
                            {
                                "target_lang_word": "electricity",
                                "target_lang_sense_clarification": "energy source"
                            },
                            {
                                "target_lang_word": "lights",
                                "target_lang_sense_clarification": "lighting system"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电",
                                "target_lang_sense_clarification": "电力供应"
                            },
                            {
                                "target_lang_word": "电力",
                                "target_lang_sense_clarification": "能源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "012659b3-1a9b-37e2-8132-1e89164a68ea",
                    "sense_definition": "Земной шар со всем существующим на нём; мир, вселенная.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "world",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Путешественник мечтал объехать весь <w>свет</w> на парусном корабле.",
                            "target_lang_translations": {
                                "en": "The traveler dreamed of sailing around the whole <w>world</w> on a sailing ship.",
                                "zh": "那位旅行者梦想着乘帆船环游整个<w>世界</w>。"
                            }
                        },
                        {
                            "text": "Для матери не было никого дороже на всём белом <w>свете</w>.",
                            "target_lang_translations": {
                                "en": "For the mother, there was no one dearer in the whole wide <w>world</w>.",
                                "zh": "对于母亲来说，<w>世上</w>没有比他更珍贵的人了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мир",
                        "Вселе́нная"
                    ],
                    "common_phrases": [
                        "конец света",
                        "на этом свете",
                        "на том свете",
                        "весь белый свет"
                    ],
                    "target_lang_definitions": {
                        "en": "The globe with everything existing on it; the world, the universe.",
                        "zh": "地球及其上存在的一切；世界，宇宙。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "world",
                                "target_lang_sense_clarification": "earth and its inhabitants"
                            },
                            {
                                "target_lang_word": "earth",
                                "target_lang_sense_clarification": "planet"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "地球及其居民"
                            },
                            {
                                "target_lang_word": "世上",
                                "target_lang_sense_clarification": "人世间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efae794a-1d7f-31d7-9b7f-65baed7a0e43",
                    "sense_definition": "Время восхода солнца, начало утра; рассвет.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встали чуть <w>свет</w>, чтобы успеть на первый утренний поезд.",
                            "target_lang_translations": {
                                "en": "We got up at the crack of <w>dawn</w> to catch the first morning train.",
                                "zh": "我们<w>天刚亮</w>就起床了，为了赶上第一班早车。"
                            }
                        },
                        {
                            "text": "Охотники вышли из леса, когда уже занялся <w>свет</w>.",
                            "target_lang_translations": {
                                "en": "The hunters came out of the forest when <w>daybreak</w> had already begun.",
                                "zh": "猎人们在<w>黎明</w>时分走出了森林。"
                            }
                        }
                    ],
                    "antonyms": [
                        "закат"
                    ],
                    "common_phrases": [
                        "чуть свет",
                        "ни свет ни заря"
                    ],
                    "target_lang_definitions": {
                        "en": "The time of sunrise, the beginning of the morning; dawn.",
                        "zh": "日出的时间，早晨的开始；黎明。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dawn",
                                "target_lang_sense_clarification": "time of sunrise"
                            },
                            {
                                "target_lang_word": "daybreak",
                                "target_lang_sense_clarification": "beginning of the day"
                            },
                            {
                                "target_lang_word": "first light",
                                "target_lang_sense_clarification": "early morning light"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黎明",
                                "target_lang_sense_clarification": "日出时分"
                            },
                            {
                                "target_lang_word": "天亮",
                                "target_lang_sense_clarification": "天色变亮的时候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd8c998a-78f9-3648-beaf-6bb7faa74bdc",
                    "sense_definition": "Высший слой привилегированных классов общества, аристократия.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "society",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодая графиня впервые вышла в <w>свет</w> на зимнем балу.",
                            "target_lang_translations": {
                                "en": "The young countess first came out into <w>society</w> at the winter ball.",
                                "zh": "年轻的伯爵夫人第一次在冬天的舞会上进入<w>上流社会</w>。"
                            }
                        },
                        {
                            "text": "Правила поведения, принятые в высшем <w>свете</w>, были очень строгими.",
                            "target_lang_translations": {
                                "en": "The rules of conduct accepted in high <w>society</w> were very strict.",
                                "zh": "<w>上流社会</w>所遵循的行为准则非常严格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "аристокра́тия",
                        "знать"
                    ],
                    "common_phrases": [
                        "высший свет",
                        "выходить в свет"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest layer of privileged classes of society, the aristocracy.",
                        "zh": "社会特权阶层的最高层，贵族。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "society",
                                "target_lang_sense_clarification": "high social class"
                            },
                            {
