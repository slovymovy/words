                "senses": [
                    {
                        "sense_id": "45b2e4ec-7259-3911-8328-95451ed1613b",
                        "entry_id": "abadfe46-aac3-38b1-b0fa-6410e33938ec",
                        "glosses": [
                            "In an uncertain manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f75a52-9f34-4ee2-bed4-20a90b6f2cdc",
                                "sense_id": "45b2e4ec-7259-3911-8328-95451ed1613b",
                                "text": "\"No — don't you get it?\" said Rimmer. ¶ \"Get what?\" said Kryten, uncertainly."
                            },
                            {
                                "example_id": "c814ca6a-25d8-474a-be5c-c2abd9a04c88",
                                "sense_id": "45b2e4ec-7259-3911-8328-95451ed1613b",
                                "text": "I sketch the place of others, pinning them down with objective confidence within an institutional, urban, or rural landscape, yet only failingly, uncertainly, imagine where I really belong[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7d805e6-87c7-4a44-a270-9875a6cbac44",
                        "source_entry_id": "abadfe46-aac3-38b1-b0fa-6410e33938ec",
                        "source_sense_id": "45b2e4ec-7259-3911-8328-95451ed1613b",
                        "source_sense_description": "in an uncertain manner",
                        "target_lang_word": "aléatoirement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aléatoirement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                                        "entry_id": "3e955ff2-47ba-381a-a019-c875410e6c38",
                                        "glosses": [
                                            "D’une manière aléatoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd3805c-69b1-40ec-b2e3-c18ed96c35a6",
                                                "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                                                "text": "Comment alors aurait-elle pu aléatoirement transiger sur un legs plus ou moins important, puisqu'il n'y avait ni testament ni legs ?"
                                            },
                                            {
                                                "example_id": "f08f5df0-d076-4a33-8c48-96e87a887f8f",
                                                "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                                                "text": "On remarque que l'erreur de mesure se répartit sensiblement aléatoirement sur l'image et que son amplitude est de l'ordre de ± 0,02°C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21507952-dbeb-47fe-8ee2-4d920ae02c23",
                        "source_entry_id": "abadfe46-aac3-38b1-b0fa-6410e33938ec",
                        "source_sense_id": "45b2e4ec-7259-3911-8328-95451ed1613b",
                        "source_sense_description": "in an uncertain manner",
                        "target_lang_word": "confusément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confusément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                        "entry_id": "d9b4d637-4400-3608-ad7b-54b454e0366d",
                                        "glosses": [
                                            "D’une manière confuse, indistincte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114bb6fa-f47d-4b1a-8ce1-29c3aa962f84",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "[…]; un peu plus loin sur la droite, face au large, l'étrange roche à figure humaine qu'on appelle le roi Grallon se silhouettait confusément."
                                            },
                                            {
                                                "example_id": "bb3785a9-cf0d-4fcb-a42d-34ef41732173",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Cet horrible débris d’aigles, d’armes, de chars,\nSur ces champs empestés confusément épars."
                                            },
                                            {
                                                "example_id": "ebc489ae-c0d6-4890-8ed6-b7ddb766e100",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Les perles avec l’or confusément mêlées."
                                            },
                                            {
                                                "example_id": "1caaebdf-7835-441f-98a1-fb72e811736c",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Par un si grand bruit semé confusément."
                                            },
                                            {
                                                "example_id": "18079892-f614-4754-8c51-3c183d434921",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Les oisillons, las de l’entendre,\nSe mirent à jaser aussi confusément\nQue faisaient les Troyens, quand la pauvre Cassandre\nOuvrait la bouche seulement."
                                            },
                                            {
                                                "example_id": "4f42c65e-7043-4ba7-a749-0f24a303470b",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Il [l’ouvrage de Tournefort] est fait pour mettre de l’ordre dans ce nombre prodigieux de plantes semées si confusément sur la terre et même sous les eaux de la mer."
                                            },
                                            {
                                                "example_id": "96402c93-6e3f-4a93-b32e-db3198a69803",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Hier confusément j’en appris la nouvelle."
                                            },
                                            {
                                                "example_id": "51c9dcde-4a3f-450f-9472-dca75f4171b6",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Fables et vérités, ténèbres et lumière\nFlottent confusément devant notre paupière,\nEt l’un dit : C’est le jour ! et l’autre : C’est la nuit !"
                                            },
                                            {
                                                "example_id": "c7783118-8775-4869-a101-11468a7dc538",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Toutefois, le sergent crut apercevoir confusément, à travers un bouquet de bouleaux, une masse blanche, énorme, qui se mouvait lentement […]"
                                            },
                                            {
                                                "example_id": "66234776-6ec9-4178-8561-3b488de858bf",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Et, sans qu'il s'expliquât pourquoi, c'était cette première syllabe qui lui rappelait confusément un souvenir que son esprit en travail cherchait à préciser."
                                            },
                                            {
                                                "example_id": "f0354b2d-6112-4b33-9fd3-b9d010ecbbe5",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Je crois confusément à beaucoup de choses ; par dessus tout, à l’existence de Dieu, sinon aux dogmes de la religion […]"
                                            },
                                            {
                                                "example_id": "6fa32847-1111-4491-99c3-92c932102adc",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
