{
    "word_family": [
        "lender",
        "lending",
        "loan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8655be32-5a3e-3388-82b1-c67cc9a27631",
                    "sense_definition": "To allow someone to use something temporarily on the condition that it will be returned.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "provide_temporarily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will only <w>lend</w> you my car if you promise to fill up the gas tank.",
                            "target_lang_translations": {
                                "ru": "Я <w>одолжу</w> тебе машину только в том случае, если ты пообещаешь заправить полный бак.",
                                "zh": "只有在你答应加满油箱的情况下，我才会把车<w>借给</w>你。"
                            }
                        },
                        {
                            "text": "Could you <w>lend</w> a book to me for the weekend so I can finish the chapter?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты <w>дать</w> мне книгу на выходные, чтобы я мог дочитать главу?",
                                "zh": "你能把书<w>借给</w>我周末看吗？这样我就能读完这一章了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loan"
                    ],
                    "antonyms": [
                        "borrow"
                    ],
                    "common_phrases": [
                        "lend a book",
                        "lend money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо вещь в пользование на время с условием её возврата.",
                        "zh": "暂时把东西给别人使用，条件是以后要归还。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одалживать",
                                "target_lang_sense_clarification": "давать в пользование"
                            },
                            {
                                "target_lang_word": "давать в долг",
                                "target_lang_sense_clarification": "обычно о деньгах"
                            },
                            {
                                "target_lang_word": "ссужать",
                                "target_lang_sense_clarification": "официально или о деньгах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "借出",
                                "target_lang_sense_clarification": "把东西借给别人"
                            },
                            {
                                "target_lang_word": "借给",
                                "target_lang_sense_clarification": "将某物借给某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                    "sense_definition": "To provide or contribute a quality, name, or assistance to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contribute_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soft lighting helped <w>lend</w> a hand in creating a very relaxing atmosphere.",
                            "target_lang_translations": {
                                "ru": "Мягкое освещение <w>помогло</w> создать очень расслабляющую атмосферу.",
                                "zh": "柔和的灯光有助于<w>营造</w>出一种非常放松的氛围。"
                            }
                        },
                        {
                            "text": "The famous director decided to <w>lend</w> his name to the new independent film project.",
                            "target_lang_translations": {
                                "ru": "Знаменитый режиссер решил <w>предоставить</w> свое имя новому проекту независимого кино.",
                                "zh": "那位著名导演决定为这个新的独立电影项目<w>提供</w>他的名义支持。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lend a hand",
                        "lend support",
                        "lend weight to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо определенное качество или оказывать помощь.",
                        "zh": "为某事物提供某种品质、名声或协助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придавать",
                                "target_lang_sense_clarification": "о качестве или атмосфере"
                            },
                            {
                                "target_lang_word": "оказывать",
                                "target_lang_sense_clarification": "о помощи или поддержке"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "свое имя или авторитет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增添",
                                "target_lang_sense_clarification": "增加某种氛围或品质"
                            },
                            {
                                "target_lang_word": "提供",
                                "target_lang_sense_clarification": "给予支持或名义上的帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e6a1872-b384-34d5-a1f4-5ddb47f4bc09",
                    "sense_definition": "To be suitable or appropriate for a particular purpose or treatment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Complex poems do not <w>lend</w> themselves to simple translation without losing their original meaning.",
                            "target_lang_translations": {
                                "ru": "Сложные стихи не <w>поддаются</w> простому переводу без потери их первоначального смысла.",
                                "zh": "复杂的诗歌如果不失原意，很难<w>适合</w>简单的翻译。"
                            }
                        },
                        {
                            "text": "The historical facts of the case do not <w>lend</w> themselves to a black and white interpretation.",
                            "target_lang_translations": {
                                "ru": "Исторические факты этого дела не <w>допускают</w> однозначного толкования.",
                                "zh": "这个案件的历史事实并不<w>适合</w>非黑即白的解读。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lend itself to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть подходящим для определенной цели или толкования.",
                        "zh": "适合某种特定的目的或处理方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддаваться",
                                "target_lang_sense_clarification": "об обработке или переводе"
                            },
                            {
                                "target_lang_word": "быть пригодным",
                                "target_lang_sense_clarification": "для чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适合",
                                "target_lang_sense_clarification": "适用于某种处理"
                            },
                            {
                                "target_lang_word": "易于",
                                "target_lang_sense_clarification": "容易被某种方式处理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                    "sense_definition": "The act of lending something or the permission to borrow it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "loan_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only have the <w>lend</w> of this bicycle for the afternoon while mine is being repaired.",
                            "target_lang_translations": {
                                "ru": "Этот велосипед у меня только в <w>пользовании</w> на вторую половину дня, пока мой в ремонте.",
                                "zh": "我的自行车在修理期间，我下午只能<w>借用</w>这辆自行车。"
                            }
                        },
                        {
                            "text": "He thanked his neighbor for the <w>lend</w> of the tools needed to fix the fence.",
                            "target_lang_translations": {
                                "ru": "Он поблагодарил соседа за то, что тот <w>одолжил</w> инструменты, необходимые для починки забора.",
                                "zh": "他感谢邻居把修理栅栏所需的工具<w>借给</w>他使用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loan"
                    ],
                    "common_phrases": [
                        "the lend of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in phrases like 'the lend of'"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Common in Irish and Scottish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт предоставления чего-либо во временное пользование.",
                        "zh": "借出某物的行为或借用的许可。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользование",
                                "target_lang_sense_clarification": "временное владение чужой вещью"
                            },
                            {
                                "target_lang_word": "одалживание",
                                "target_lang_sense_clarification": "процесс передачи в долг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "借用",
                                "target_lang_sense_clarification": "暂时使用他人的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5807cd3-2a6e-3f77-8d22-03878ec172e5",
                    "sense_definition": "The lower back or lumbar region of the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old medical text described a sharp pain originating in the <w>lend</w> of the patient.",
                            "target_lang_translations": {
                                "ru": "В старом медицинском тексте описывалась острая боль, возникающая в <w>пояснице</w> пациента.",
                                "zh": "那本古老的医学文献描述了患者<w>腰部</w>产生的剧烈疼痛。"
                            }
                        },
                        {
                            "text": "He felt a strain across his <w>lend</w> after lifting the heavy crates all morning.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал напряжение в <w>пояснице</w> после того, как все утро таскал тяжелые ящики.",
                                "zh": "整个上午搬运沉重的板条箱后，他感到<w>腰部</w>一阵酸痛。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть спины или поясничная область тела.",
                        "zh": "身体的下背部或腰部区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поясница",
                                "target_lang_sense_clarification": "анатомическая область"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腰部",
                                "target_lang_sense_clarification": "解剖学上的腰部区域"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}