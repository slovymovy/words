                },
                {
                    "sense_id": "ae0dd364-1a6c-3422-bebf-431eda09d4b6",
                    "sense_definition": "A large formal party that includes dancing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful long dress to the charity <w>ball</w> last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером она надела красивое длинное платье на благотворительный <w>бал</w>.",
                                "zh": "昨晚她穿着漂亮的长裙去参加慈善<w>舞会</w>。"
                            }
                        },
                        {
                            "text": "The prince invited everyone in the kingdom to a grand <w>ball</w> at the palace.",
                            "target_lang_translations": {
                                "ru": "Принц пригласил всех жителей королевства на торжественный <w>бал</w> во дворце.",
                                "zh": "王子邀请全国的人来王宫参加一场盛大的<w>舞会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "formal dance",
                        "gala"
                    ],
                    "common_phrases": [
                        "charity ball",
                        "masked ball",
                        "attend a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое официальное торжество с танцами.",
                        "zh": "带有跳舞活动的大型正式社交聚会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бал",
                                "target_lang_sense_clarification": "торжественное мероприятие"
