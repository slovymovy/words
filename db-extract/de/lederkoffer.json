                ],
                "senses": [
                    {
                        "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                        "entry_id": "9ee0d1d5-2c2e-3a4f-b9fc-22bcbdbf502e",
                        "glosses": [
                            "Koffer der vollständig oder größtenteils aus Leder beschaffen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1cfbfb5-fa10-4ca2-8138-a8b00b582096",
                                "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                                "text": "„Sima verschwindet kurz und erscheint mit einem großen hellblauen Lederkoffer wieder in der Tür.“"
                            },
                            {
                                "example_id": "46168546-be86-44a6-934e-1e401ea4f98b",
                                "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                                "text": "Der Manager hatte seinen Lederkoffer dabei."
                            },
                            {
                                "example_id": "700453a5-f1a0-410d-9a07-cd187ad55d73",
                                "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                                "text": "Es war mir aufgefallen, daß, wo er auch sein mochte, stets ein länglicher, gelber Lederkoffer, den er nicht aus dem Auge verlor, in seiner dichtesten Nähe stand."
                            },
                            {
                                "example_id": "19bbd317-7dc8-468e-b61f-02680d395106",
                                "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                                "text": "Er nahm sie an der Hand und führte sie zu der improvisirten Chaiselongue, – es war ein großer Lederkoffer mit einer Matratze darauf, über die eine buntgestreifte italienische Decke gebreitet war."
                            },
                            {
                                "example_id": "6a85aa70-5c21-4e5f-9dbb-17c7f7d85b5e",
                                "sense_id": "03a40082-dd85-3e41-8a6e-d5f85446eaee",
                                "text": "„Er schaffte es, den Mantel zuzuknöpfen, steckte das Geld in die Innentasche, schulterte die Tasche und hob den Lederkoffer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
