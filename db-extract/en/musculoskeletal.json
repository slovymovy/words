                "senses": [
                    {
                        "sense_id": "dfd97840-9d4c-3a63-8e78-4fc80bbd9c97",
                        "entry_id": "6cc59be7-2b01-3582-b08e-5dc29c1a1636",
                        "glosses": [
                            "Of, or relating to both muscles and the skeleton."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f883c58-cff0-499b-b015-efb795e5a6ee",
                                "sense_id": "dfd97840-9d4c-3a63-8e78-4fc80bbd9c97",
                                "text": "Have the patient collect an hour-by-hour log of work activities, with an attempt to define actions that may cause or exacerbate musculoskeletal problems."
                            },
                            {
                                "example_id": "b6899553-6a46-45e9-8ea3-9767a974e330",
                                "sense_id": "dfd97840-9d4c-3a63-8e78-4fc80bbd9c97",
                                "text": "The superficial fascia surrounds the body and includes subcutaneous fat; the deep fascia surrounds the musculoskeletal system; the meningeal fascia surrounds the nervous system; the visceral fascia surrounds body cavities and organs."
                            },
                            {
                                "example_id": "491297e4-0173-4f90-82e1-b775b6a0bef8",
                                "sense_id": "dfd97840-9d4c-3a63-8e78-4fc80bbd9c97",
                                "text": "The most common cause of absence in the rail and bus sectors is musculoskeletal - conditions that affect joints, bones and muscles. Between January 1 2019 and June 30 2022, 6.5 million working days were lost due to musculoskeletal illness at a cost of £946m."
                            }
                        ]
                    }
