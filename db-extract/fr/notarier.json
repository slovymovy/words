                "senses": [
                    {
                        "sense_id": "f7a2e8a5-dd7f-333e-a7c5-c1b24d6f2af2",
                        "entry_id": "21b2a1b2-0f5d-337a-8e3f-adc42305eba3",
                        "glosses": [
                            "Faire traiter par un notaire (pour des formalités exigeant un notaire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6373d096-836e-4fd7-8d7c-300c296d587d",
                                "sense_id": "f7a2e8a5-dd7f-333e-a7c5-c1b24d6f2af2",
                                "text": "C’est normal parce qu’on paie monnaie sonnante et trébuchante sur-le-champ pour notarier les papiers."
                            },
                            {
                                "example_id": "3119c2cd-fa73-46b0-b336-626445f2fe0b",
                                "sense_id": "f7a2e8a5-dd7f-333e-a7c5-c1b24d6f2af2",
                                "text": "Un notaire Godbout qui ne se contentait pas de notarier la déroute."
                            }
                        ]
                    },
                    {
                        "sense_id": "0db089c5-83ad-3c77-83f2-c06c3678a164",
                        "entry_id": "21b2a1b2-0f5d-337a-8e3f-adc42305eba3",
                        "glosses": [
                            "Enregistrer afin d’avoir valeur probante ou testimoniale."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6af02f-3b15-4a7c-a7dd-9641d3d5209d",
                                "sense_id": "0db089c5-83ad-3c77-83f2-c06c3678a164",
                                "text": "Durant les derniers jours à Kaboul, j’ai tourné autant que possible avec mon téléphone : face à d’éventuelles controverses, je voulais tout « notarier » et montrer ce que nous faisions."
                            }
                        ]
                    }
