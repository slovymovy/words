                                "target_senses": [
                                    {
                                        "sense_id": "db59c295-c279-31ec-8c35-ea92f94fb944",
                                        "entry_id": "6955e828-2773-30b3-8d01-23fa81bf54c1",
                                        "glosses": [
                                            "Appareil permettant une transmission instantanée des informations entre deux points de l’univers quel que soit leur éloignement."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de950da2-4f67-47cf-8d8c-895f766b8302",
                                                "sense_id": "db59c295-c279-31ec-8c35-ea92f94fb944",
                                                "text": "Je ne veux pas un ansible de poche, je veux un relais qui me permette d’utiliser les ansibles planétaires."
                                            }
                                        ]
                                    }
                                ]
