                        "examples": [
                            {
                                "example_id": "92ff4bf2-66c1-47d1-b440-62b0f0f1af13",
                                "sense_id": "d9ed92c5-1837-3335-9232-83855da9950e",
                                "text": "»Aber wenn man irgendeinen Sieg als pyrrhisch bezeichnen kann, dann ist es dieser.« »Gab es viele Tote?« »Es war das reinste Massaker«, sagte Quaver."
                            },
                            {
                                "example_id": "56ace21c-75c5-42b8-98f8-b01a88c2322e",
                                "sense_id": "d9ed92c5-1837-3335-9232-83855da9950e",
                                "text": "Der nach langen Jahren errungene oströmische Sieg erwies sich bald als pyrrhisch, da Italien im Verlaufe des Krieges entvölkert worden war und die wiedergewonnenen Gebiete völlig verarmt waren."
                            }
                        ]
