                                            {
                                                "example_id": "85f64169-8117-4b73-bb38-a90dd72afd96",
                                                "sense_id": "bfd0a07b-4661-3be4-9b4a-53d80d607cbd",
                                                "text": "the era of gray, boring banality and stagnation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a4c6b4-dc34-3efe-9f62-af8b064396d7",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Of indistinct, disputed or uncertain quality or acceptability."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "593a9e96-cdd2-3d9a-9b14-c4331964f234",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Gray-haired."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71da71ef-38f1-3d06-a488-6cbd013c398c",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Old."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09e921a-d18c-48f7-bb4f-918d5ae9e45d",
                                                "sense_id": "71da71ef-38f1-3d06-a488-6cbd013c398c",
                                                "text": "Two hours, whose mighty circle did embrace\nMore time than might make grey the infant world,\nRolled thus, a weary and tumultuous space: […]"
                                            },
                                            {
                                                "example_id": "08d533ee-5493-4ee5-b27f-3ffaad41f244",
                                                "sense_id": "71da71ef-38f1-3d06-a488-6cbd013c398c",
                                                "text": "In a subculture that idealizes youth, being gay and gray does not exactly make one a hot ticket. Older gays and lesbians often relegate themselves to separate and unequal meeting places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6734add9-00b8-3acd-af18-972070205ee5",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Relating to older people."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "036bb3f8-0df1-45da-a5eb-2773a20a163a",
                                                "sense_id": "6734add9-00b8-3acd-af18-972070205ee5",
                                                "text": "the gray dollar",
                                                "translation": "the purchasing power of the elderly",
                                                "english": "the purchasing power of the elderly"
                                            },
                                            {
                                                "example_id": "feca1260-afff-4f3a-bcf2-ec98c5aaaaa6",
                                                "sense_id": "6734add9-00b8-3acd-af18-972070205ee5",
                                                "text": "February 8, 1800, Fisher Ames, Eulogy on Washington\nGray experience listened to his counsels with respect, and, at a time when youth is almost privileged to be rash, Virginia committed the safety of her frontier, and ultimately the safety of America, not merely to his valor,—for that would be scarcely praise,—but to his prudence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5e55cd-60f6-3749-81d5-bcf87d527ad4",
                                        "entry_id": "135b362f-6c68-3937-a82a-6dec037d78f2",
                                        "glosses": [
                                            "To turn gray."
                                        ],
                                        "tags": [
                                            "US",
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06680d6-e790-4b44-aa79-e49bc9d44a0d",
                                                "sense_id": "2e5e55cd-60f6-3749-81d5-bcf87d527ad4",
                                                "text": "My hair is beginning to gray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef5c2eb6-63cb-31f0-80d3-a4d5842b92ba",
                                        "entry_id": "135b362f-6c68-3937-a82a-6dec037d78f2",
                                        "glosses": [
                                            "To turn progressively older, alluding to graying of hair through aging (used in context of the population of a geographic region)"
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b057905a-5834-4156-a0e2-1898d70417cb",
                                                "sense_id": "ef5c2eb6-63cb-31f0-80d3-a4d5842b92ba",
                                                "text": "the graying of America"
                                            },
                                            {
                                                "example_id": "54f63c43-c0f1-487f-b932-4910ef9a9d8e",
                                                "sense_id": "ef5c2eb6-63cb-31f0-80d3-a4d5842b92ba",
                                                "text": "It’s not what advocates of retrofitting the suburbs may have had in mind, but it’s a logical outcome of the graying of America, and of suburbia in particular."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1413b5-e31a-3da9-a235-0591b16b86c0",
                                        "entry_id": "135b362f-6c68-3937-a82a-6dec037d78f2",
                                        "glosses": [
                                            "To give a soft effect to (a photograph) by covering the negative while printing with a ground-glass plate."
                                        ],
                                        "tags": [
