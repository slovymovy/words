                                        "entry_id": "64bdd098-e704-3b76-a619-0c96b3075bfd",
                                        "glosses": [
                                            "het onverzettelijk en halsstarrig zijn van personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cca718-dddd-4d24-97f9-ee1dcd391702",
                                                "sense_id": "2d5d1370-716d-3154-99e9-31036afd4cda",
                                                "text": "Zelfs de hardnekkigheid van die hanekamjongens had het daartegen op den duur moeten afleggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff082bd-9d08-3be5-96e7-86200c78ed7a",
                                        "entry_id": "64bdd098-e704-3b76-a619-0c96b3075bfd",
                                        "glosses": [
                                            "het onverwoestbaar of onuitroeibaar zijn van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "949632be-e876-42f5-8ec7-7b920ab82c1a",
                                                "sense_id": "9ff082bd-9d08-3be5-96e7-86200c78ed7a",
                                                "text": "Bij 12 procent van de jongeren in Nederland is het huishoudbudget te krap. In Zaanstad ligt het percentage jongeren dat in armoede opgroeit ongeveer op het landelijk gemiddelde. Ook komt de hardnekkigheid van armoede overeen met het landelijke beeld."
                                            }
                                        ]
                                    }
                                ]
                            }
