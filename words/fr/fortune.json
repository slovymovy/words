                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce séducteur invétéré aimait se vanter de ses nombreuses bonnes <w>fortunes</w> au salon."
                        },
                        {
                            "text": "Le héros du roman passe pour un homme à bonnes <w>fortunes</w> redouté de tous."
