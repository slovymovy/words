                        "target_lang_word": "lait caillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lait caillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df7976d6-c3fb-3a19-bcaa-b6e7789a3fdf",
                                        "entry_id": "8085a124-e47e-3e96-8562-d62d92c7b67a",
                                        "glosses": [
                                            "Synonyme de caillé."
                                        ],
                                        "tags": [
                                            "Caséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad695615-ad51-4938-a40d-cbbcb46375ca",
                                                "sense_id": "df7976d6-c3fb-3a19-bcaa-b6e7789a3fdf",
                                                "text": "J’ai vu, dans le Valais, des pâtres qui, ne se nourrissant que de lait caillé, perdent leurs dents de bonne heure."
                                            },
                                            {
                                                "example_id": "d40ab354-8ed6-4a73-a4b3-f40fcde8d3b2",
                                                "sense_id": "df7976d6-c3fb-3a19-bcaa-b6e7789a3fdf",
                                                "text": "On entendait, de tous côtés, les carillons des vendeurs de sorbet, de pignolats et de lait caillé, les timbales des astrologues en plein vent, les chansons des guzlares aveugles, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00b8a40-3a60-4f84-95ab-ce513bf490ad",
                        "source_entry_id": "0989e95b-8ef1-31cc-b6c7-f207b3da553b",
                        "source_sense_description": "part of milk that coagulates",
                        "target_lang_word": "caillot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caillot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                        "entry_id": "1e104418-0041-3dcf-812a-ddc041c8ef28",
                                        "glosses": [
                                            "Petite masse de liquide coagulé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74cbed2-a43f-4741-87d0-40667a96473e",
                                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                                "text": "Aussitôt l’abatage des animaux, le sang est fortement agité, pour en séparer la fibrine, et empêcher la formation du caillot sanguin."
                                            },
                                            {
                                                "example_id": "62e671a4-d967-4b6b-823f-f88539b1591a",
                                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                                "text": "Il y a de grandes vagues dans la cuve, et le sucre ruisselle par terre, pend en caillots noirs qui roulent sur la terre couverte de feuilles et de paille."
                                            },
                                            {
                                                "example_id": "c2d1c88e-e38e-4625-a823-83b5236f2e91",
                                                "sense_id": "c33ec277-002e-3d60-9767-2410a5ebfdb8",
                                                "text": "Il existe aussi des médicaments (warfarine) dont l'usage est destiné à ralentir la formation du caillot sanguin, à « éclaircir le sang », comme disent certains patients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
