    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                    "sense_definition": "To pour out, spew, discharge, or vomit contents rapidly and in large quantities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damaged pipe began to <w>disgorge</w> tons of raw sewage directly into the river."
                        },
                        {
                            "text": "The commuter train opened its doors to <w>disgorge</w> hundreds of tired passengers into the busy station."
                        }
                    ],
                    "synonyms": [
                        "discharge",
                        "spew",
                        "eject",
                        "emit"
                    ],
                    "common_phrases": [
                        "disgorge passengers",
                        "disgorge contents"
                    ]
                },
                {
                    "sense_id": "dd0943d2-2466-31b1-8a39-a6baeef7d375",
                    "sense_definition": "To surrender, give up, or repay illegally gained money or property, typically under legal pressure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt official was ordered by the court to <w>disgorge</w> millions of dollars in stolen funds."
                        },
                        {
                            "text": "Under the settlement terms, the corporate executive had to <w>disgorge</w> ill-gotten profits from the illegal trades."
                        }
                    ],
                    "synonyms": [
                        "relinquish",
                        "surrender",
                        "forfeit"
                    ],
                    "common_phrases": [
                        "disgorge profits",
                        "disgorge stolen funds"
                    ]
                },
                {
                    "sense_id": "33eaa698-1b1e-3cdf-8365-80c4dc883ba3",
                    "sense_definition": "To remove the sediment or yeast deposit from a bottle of sparkling wine during production.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "winemaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cellar master must carefully chill the neck of the bottle before he can <w>disgorge</w> the wine."
                        },
                        {
                            "text": "Automated machinery is now commonly used to freeze the neck and <w>disgorge</w> sediment quickly."
                        }
                    ]
                }
            ]
        }
    ]
