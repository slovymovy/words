                "translations": [
                    {
                        "translation_id": "3a473219-bd33-4132-8334-b5ae5aa5a383",
                        "source_entry_id": "58af6123-e33f-3d1e-83a1-3f8b754fdf1e",
                        "source_sense_id": "01a91163-227c-32cd-b9b5-b77537b60807",
                        "target_lang_word": "master",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "master",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87c03f70-c04b-3039-9040-5629a9c6acbe",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To be a master."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd758c57-8f86-3471-b910-da1c9dfb3c39",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To become the master of; to subject to one's will, control, or authority; to conquer; to overpower; to subdue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afaa9d44-de5b-4869-88da-c59fbf351810",
                                                "sense_id": "fd758c57-8f86-3471-b910-da1c9dfb3c39",
                                                "text": "Obstinacy and willful neglects must be mastered, even though it cost blows."
                                            },
                                            {
                                                "example_id": "d4c76bdf-9d1c-47b4-ae35-aa47d4bc52dc",
                                                "sense_id": "fd758c57-8f86-3471-b910-da1c9dfb3c39",
                                                "text": "Then Elzevir cried out angrily, 'Silence. Are you mad, or has the liquor mastered you? Are you Revenue-men that you dare shout and roister? or contrabandiers with the lugger in the offing, and your life in your hand. You make noise enough to wake folk in Moonfleet from their beds.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aa4f37-b06b-39f3-8454-0de2df7d3efe",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To learn to a high degree of proficiency."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e11e2f3-8e69-4f2f-bf1a-c34f2a5e466d",
                                                "sense_id": "72aa4f37-b06b-39f3-8454-0de2df7d3efe",
                                                "text": "It took her years to master the art of needlecraft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafc6c8b-86a7-3991-a992-86e581579229",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To own; to possess."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03bfdd3-e9c9-4abb-9f28-cea1f45098bd",
                                                "sense_id": "dafc6c8b-86a7-3991-a992-86e581579229",
                                                "text": "[…]the wealth / That the world maſters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8312ffcd-4ffb-30df-b207-796e6b336e58",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To make a master copy of."
                                        ],
                                        "tags": [
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dfad094-af49-32af-a6ce-ec1a16afbb0c",
                                        "entry_id": "4a8cdb87-35c0-3c9e-a2bd-c3ed560c225d",
                                        "glosses": [
                                            "To earn a Master's degree."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de838758-cdcd-4895-9212-96d75257e513",
                                                "sense_id": "7dfad094-af49-32af-a6ce-ec1a16afbb0c",
                                                "text": "He mastered in English at the state college."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "master",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "Someone who has control over something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4557d6-bc16-4048-98e0-ecf7bf3ed48f",
                                                "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                                                "text": "We are masters of the sea."
                                            },
                                            {
                                                "example_id": "eb78b791-648c-4437-855e-9c18671ff58c",
                                                "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                                                "text": "Maſters commands come with a power reſiſtleſs / To ſuch as owe them abſolute ſubjection; / And for a life who will not change his purpoſe? / (So mutable are all the ways of men) / Yet this be ſure, in nothing to comply / Scandalous or forbidden in our Law."
                                            },
                                            {
                                                "example_id": "44500842-0c9c-402a-87df-cda9d7813451",
                                                "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                                                "text": "When I have thus made myself master of a hundred thousand drachmas […]."
                                            },
                                            {
                                                "example_id": "5b0c00ba-76a8-4777-bbff-8623a0358151",
                                                "sense_id": "999ba1ca-8d79-364b-8eba-8fb53de7a7ae",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93a0bc9-89b2-3aac-bee3-4a1f22b8e060",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "The owner of an animal or slave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d59419c4-fc14-3a0c-a12c-43c0de61e6f0",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "The captain of a merchant ship; a master mariner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1be9b045-8007-3313-8fde-67d7ef7ab46e",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A male head of household."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14f63a11-c02b-39f9-849d-6a0be931bdd8",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "Someone who employs others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12ee017-9332-403f-be88-69742e64f34b",
                                                "sense_id": "14f63a11-c02b-39f9-849d-6a0be931bdd8",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "An expert at something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e50457-40aa-469a-b4fa-c8aea6e0bdcd",
                                                "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                                "text": "Mark Twain was a master of fiction."
                                            },
                                            {
                                                "example_id": "de0cc575-8c43-4d26-afa6-7033cf7a263a",
                                                "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                                "text": "But that which chiefly distinguishes Addison from Swift, from Voltaire, from almost all the other great masters of ridicule, is the grace, the nobleness, the moral purity, which we find even in his merriment."
                                            },
                                            {
                                                "example_id": "f7c63c07-ae59-49c3-ad9c-415067ab13c9",
                                                "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                                "text": "No care is taken to improve young men in their own language, that they may thoroughly understand and be masters of it."
                                            },
                                            {
                                                "example_id": "9da1f7cc-aab8-434b-8e84-917272a01af3",
                                                "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                                "text": "Darth Vader: I've been waiting for you, Obi-Wan. We meet again, at last. The circle is now complete. When I left you I was but the learner; now I am the master.\nObi-Wan Kenobi: Only a master of evil, Darth."
                                            },
                                            {
                                                "example_id": "4c72799e-0660-44a6-93f2-6a35e364da0d",
                                                "sense_id": "6e7a532b-e4e1-37d4-b690-1f8a0d7ec371",
                                                "text": "A turning point came earlier this year. In January 2000, the local Qigong master who treated me asked me to find Falun Gong material on the Internet for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc977701-5069-3b88-8194-6eb2e824ded1",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A tradesman who is qualified to teach apprentices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d2d7853-a323-354d-afb5-5680c872d9a1",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A male schoolteacher."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df78b22b-367a-3dcb-a2e5-f98436805f63",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A skilled artist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27a58ce1-f62e-30a9-b3ee-e425c045b1a3",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A man or a boy; mister. See Master."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74d46dc-426d-440f-aca6-16257a6fb2fe",
                                                "sense_id": "27a58ce1-f62e-30a9-b3ee-e425c045b1a3",
                                                "text": "Where there are little Maſters and Miſſes in a Houſe, they are uſually great Impediments to the Diverſions of the Servants;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b13c79a-ce4d-3169-8d6c-a340bbb918f1",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A master's degree; a type of postgraduate degree, usually undertaken after a bachelor degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b324dd-6eab-4981-ac5e-b56ee358463c",
                                                "sense_id": "3b13c79a-ce4d-3169-8d6c-a340bbb918f1",
                                                "text": "She has a master in psychology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d2b510-384f-36da-88ab-75d4c773efcc",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A person holding such a degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6d42bf-c4b5-4553-8ed5-73728aa3fc47",
                                                "sense_id": "c4d2b510-384f-36da-88ab-75d4c773efcc",
                                                "text": "He is a master of marine biology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2258ea59-92e2-3be8-b57b-898d36ec2eaa",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "The original of a document or of a recording."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f748c1f8-bd5b-4c44-a09d-8acf730095ca",
                                                "sense_id": "2258ea59-92e2-3be8-b57b-898d36ec2eaa",
                                                "text": "The band couldn't find the master, so they re-recorded their tracks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df197b8-f83a-3311-900c-b1771c038f7c",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "The primary wide shot of a scene, into which the closeups will be edited later."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4174d24-b080-3f57-9659-c15444820b2b",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A parajudicial officer (such as a referee, an auditor, an examiner, or an assessor) specially appointed to help a court with its proceedings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27098591-cf5f-4371-8ed7-a9c945326957",
                                                "sense_id": "b4174d24-b080-3f57-9659-c15444820b2b",
                                                "text": "The case was tried by a master, who concluded that the plaintiffs were the equitable owners of the property.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edec922-89b4-3885-9f4a-bbf53fcf5712",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A device that is controlling other devices or is an authoritative source."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b78209-58af-4934-801d-c939de30dbc8",
                                                "sense_id": "2edec922-89b4-3885-9f4a-bbf53fcf5712",
                                                "text": "a master wheel"
                                            },
                                            {
                                                "example_id": "69855c79-4185-4d64-a6df-62934e467c7a",
                                                "sense_id": "2edec922-89b4-3885-9f4a-bbf53fcf5712",
                                                "text": "a master database"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25d55a61-ccf0-3219-80d8-0e17fa5837da",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A person holding an office of authority, especially the presiding officer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ddc718a-135e-3a10-acca-2710507160ec",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "A person holding a similar office in other civic societies."
                                        ],
