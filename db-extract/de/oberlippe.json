                ],
                "senses": [
                    {
                        "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                        "entry_id": "65eb317b-dc8b-3d60-9a2e-33ea20c2c643",
                        "glosses": [
                            "der obere Teil der Lippen von Säugetieren und des Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c266df85-10d3-4cc5-ac43-ef252a83f623",
                                "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                                "text": "Bei diesem Zusammenstoß hat er sich die Oberlippe verletzt."
                            },
                            {
                                "example_id": "ed7d6f07-dc7a-4aa4-ae02-e1e26b838e3c",
                                "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                                "text": "„Der Rauch wälzte sich über Joes Oberlippe und verschwand in seinen Nasenlöchern.“"
                            },
                            {
                                "example_id": "1f56c392-ca84-4ab9-9ecc-d80148825236",
                                "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                                "text": "„Dann schiebt er den Unterkiefer vor, stülpt die Unterlippe über die Oberlippe, in der einen Hand den Hammer, in der anderen einen Nagel.“"
                            },
                            {
                                "example_id": "96090352-2d05-408a-af2f-5745825816eb",
                                "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                                "text": "„Wie so oft behielten die Briten eine steife Oberlippe.“"
                            },
                            {
                                "example_id": "bad30b4d-17ba-49f3-b13a-db636a48a792",
                                "sense_id": "45a4f099-2648-3df1-9094-f91c8a892513",
                                "text": "„Schweißperlen bilden sich auf ihrer Oberlippe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
