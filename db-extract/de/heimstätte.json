                    {
                        "sense_id": "cfb5bfc8-60f4-30be-8b43-a771e7a48a98",
                        "entry_id": "d3376cea-a83a-3111-9ee1-1466fa8cf4dd",
                        "glosses": [
                            "Ort, Platz, an dem jemand heimisch ist oder werden kann"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "49521770-e401-4fca-b804-2d7656d2a02e",
                                "sense_id": "cfb5bfc8-60f4-30be-8b43-a771e7a48a98",
                                "text": "„Vielmehr stellte der Bogen - in seiner Vorstellung - Rolands letzte Heimstätte dar.“"
                            },
                            {
                                "example_id": "8e223cb3-17ef-4f76-bb84-a7c2dd5eeb78",
                                "sense_id": "cfb5bfc8-60f4-30be-8b43-a771e7a48a98",
                                "text": "„Weit über 90 Prozent der pakistanischen Bevölkerung sind Muslime. Dies erstaunt weiter nicht, wurde Pakistan doch als Heimstätte für die Muslime des Indischen Subkontinents gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
