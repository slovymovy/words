    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "73b71742-f0bf-3cb0-9b2f-9853a1e13ae7",
                "word": "vetiver",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a95e9206-2d35-4b58-9951-ae5e2dfaf885",
                        "entry_id": "73b71742-f0bf-3cb0-9b2f-9853a1e13ae7",
                        "tags": [
                            "plural"
                        ],
                        "form": "vetivers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74f3147f-8417-3ea2-81ab-b8eb0627d2dd",
                        "entry_id": "73b71742-f0bf-3cb0-9b2f-9853a1e13ae7",
                        "glosses": [
                            "The grass Chrysopogon zizanioides (synonym Vetiveria zizanioides), which is native to India, but planted throughout the tropics for its fragrant roots and for erosion control."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0522cd17-faa3-41e0-8dc4-d50ac2c2a3eb",
                                "sense_id": "74f3147f-8417-3ea2-81ab-b8eb0627d2dd",
                                "text": "Two types of vetiver have been found in India – (i) flowering or seeding vetiver which grows wild in North India, and (ii) non-flowering or non-seeding vetiver which is cultivated in South India."
                            },
                            {
                                "example_id": "131f6ff6-2ac3-42e9-8111-81dabc6d1bd5",
                                "sense_id": "74f3147f-8417-3ea2-81ab-b8eb0627d2dd",
                                "text": "2007, R. Sinha, et al., Phytoremediation: Role of Plants in Site Management, S.N. Singh, R. D. Tripathi, Environmental Bioremediation Technologies, page 328,\nVetiver can easily thrive in wetlands and can be used in the constructed wetlands for removal of nitrogen (N) and phosphorus (P) and heavy metals from the polluted storm water, municipal and industrial wastewater, and effluents from abattoirs, feedlots, piggeries and other intensive livestock industries."
                            },
                            {
                                "example_id": "200d4532-7349-4b2c-aff7-a72c83d5ffc9",
                                "sense_id": "74f3147f-8417-3ea2-81ab-b8eb0627d2dd",
                                "text": "Vetiver barriers are planted in 0.50–1m wide strips to minimize the land area under the barrier. Vetiver grass is the only species that is effective for controlling soil erosion on steep terrains (30 and 60% slope). Vetiver strips are also used as windbreaks."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc9bce4-effc-352e-859d-6188f3cf173e",
                        "entry_id": "73b71742-f0bf-3cb0-9b2f-9853a1e13ae7",
                        "glosses": [
                            "The aromatic root of the grass."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1d73570e-56b7-384b-a664-3cfa8e956181",
                        "entry_id": "73b71742-f0bf-3cb0-9b2f-9853a1e13ae7",
                        "glosses": [
                            "An essential oil derived from the root; the fragrance of the oil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "32ecdf0f-b61d-4673-9c95-f2491e7cc244",
                                "sense_id": "1d73570e-56b7-384b-a664-3cfa8e956181",
                                "text": "She pressed his hand and was gone in a mist of vetiver, abruptly as the other evening."
                            },
                            {
                                "example_id": "6cb92abf-f464-49ad-858f-9e720ee49d34",
                                "sense_id": "1d73570e-56b7-384b-a664-3cfa8e956181",
                                "text": "A sweet scent which relieves stress, tension and headache, promotes restful sleep, heals the skin, lowers high blood pressure and cures sunburn (when blended with cedarwood, clove, clary sage, pine, geranium, vetiver and patchouli)."
                            },
                            {
                                "example_id": "c590389a-97c3-492f-8a91-b4c9378f8571",
                                "sense_id": "1d73570e-56b7-384b-a664-3cfa8e956181",
                                "text": "[…]it came in a joyful fuzz of hair spray and noise, with a delicious, dissonant Habanita-like base of patchouli-vetiver-vanilla putting a growl in its voice."
                            },
                            {
                                "example_id": "ee521744-9d21-43f2-8951-50dc0ceb7b06",
                                "sense_id": "1d73570e-56b7-384b-a664-3cfa8e956181",
                                "text": "Essential oils such as jasmine, rose, vetiver, ilang-ilang, iris, vanilla, sandalwood or lavender cannot be synthesised in the laboratory."
                            }
                        ]
                    }
                ],
