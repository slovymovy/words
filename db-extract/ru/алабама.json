                    },
                    {
                        "translation_id": "55917090-3e38-4a06-b11f-db37a211f3cf",
                        "source_entry_id": "2dc69b36-5be1-3a35-b5b6-84885fa815f4",
                        "target_lang_word": "Alabama",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alabama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f009b4-5f22-3dda-b1af-46cdfe671bd4",
                                        "entry_id": "adcae30b-9725-3680-9522-1f4f5e37bb80",
                                        "glosses": [
                                            "US-Bundesstaat im Süden der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb33973a-0051-406c-86bc-0d9d9212f2f4",
                                                "sense_id": "02f009b4-5f22-3dda-b1af-46cdfe671bd4",
                                                "text": "Montgomery ist die Hauptstadt Alabamas."
                                            },
                                            {
                                                "example_id": "b1ad7580-b4a6-48f8-9553-c4aeaee10954",
                                                "sense_id": "02f009b4-5f22-3dda-b1af-46cdfe671bd4",
                                                "text": "„Alabama besteht zu 50 Prozent aus Kiefer- und Laubwäldern, weshalb es auch eine große Forst- und Holzwirtschaft besitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alabama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14db622f-008f-389f-b63c-4b812202d22d",
                                        "entry_id": "39ecefda-dfc1-3410-b899-18a12f8afb14",
                                        "glosses": [
                                            "Sprache, die vom gleichnamigen Volk im Südosten der USA gesprochen wird und welche dem Coushatta ähnlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51fbb196-bebd-4930-9e76-3186a9dd4546",
                                                "sense_id": "14db622f-008f-389f-b63c-4b812202d22d",
                                                "text": "„Auch die verwandten Sprachen Alabama, Koasati, Hitchiti, Mikasuki, Creek und Seminole weisen ähnliche Konstruktionen auf[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alabama",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df5cb67d-f663-3c5f-b91e-75ca0fae910c",
                                        "entry_id": "329210a1-6342-37cf-8a05-423b29992ab6",
                                        "glosses": [
                                            "ein Indianervolk, das heute vor allem in Alabama sowie Florida, Oklahoma und Louisiana (USA) lebt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad07f6bb-5136-48d4-a1f4-f020f408c2ae",
                                                "sense_id": "df5cb67d-f663-3c5f-b91e-75ca0fae910c",
                                                "text": "„Im Innern wohnen auch die bei Alabama genannten Indianer Stämme, die immer mehr an Europäische Cultur gewöhnt werden und vermischt unter Weißen leben[.]“"
                                            },
                                            {
                                                "example_id": "b1919898-be27-4753-9866-98a4837c63ef",
                                                "sense_id": "df5cb67d-f663-3c5f-b91e-75ca0fae910c",
                                                "text": "„[…] und später die Yuchi, Teile der Natchez, die Alabama und andere Stammesreste aufnahm, waren die Dörfer entweder von ›weißen‹ oder ›roten‹ Klanen beherrscht.“"
                                            },
                                            {
                                                "example_id": "3b3571a0-37e3-4403-b63c-5e707852aee1",
                                                "sense_id": "df5cb67d-f663-3c5f-b91e-75ca0fae910c",
                                                "text": "„Er verbot ernstlich allen Verkehr mit den Weißen, und überredete den größten Theil der Alabama-Indianer, das Handwerkszeug und die Kleidung abzuschaffen, welches sie in diesem Verkehr erworben[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7eec0195-7719-38f5-9f65-cca25eea2b9b",
                                        "entry_id": "329210a1-6342-37cf-8a05-423b29992ab6",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen Indianervolks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09782b0c-b236-45b3-b1a1-065c09e6c039",
                                                "sense_id": "7eec0195-7719-38f5-9f65-cca25eea2b9b",
                                                "text": "„Ferner gesellten sich einige Alabama, Yuchi und andere Splittergruppen zu ihnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
