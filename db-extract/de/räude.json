                "senses": [
                    {
                        "sense_id": "4b4b9b18-b713-36a5-a6a0-30fd3195faf0",
                        "entry_id": "d450e202-05d1-397b-a6fa-65ab6e2aaeff",
                        "glosses": [
                            "durch Milben verursachte ansteckende Hautkrankheit der Haustiere (beim Menschen entspricht dies der Krätze oder der Skabies)"
                        ],
                        "tags": [
                            "Tiermedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "040c0a2f-dea9-4919-8ba2-594dc641328f",
                                "sense_id": "4b4b9b18-b713-36a5-a6a0-30fd3195faf0",
                                "text": "„Anfangs ist die Räude auf eine oder einige Hautstellen beschränkt, breitet sich dann aber allmählich fast über den ganzen Körper aus.“"
                            },
                            {
                                "example_id": "a81a4bd7-014d-4a03-8b65-edb9a85a6012",
                                "sense_id": "4b4b9b18-b713-36a5-a6a0-30fd3195faf0",
                                "text": "„Die Räude des Hundes, verursacht durch Sarkoptes squamiferus, ist in Deutschland eine sehr verbreitete Hundekrankheit, in einzelnen Gegenden, besonders in grossen Städten, fand man 10–16 % aller kranken Hunde daran leidend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1de9e58f-90c2-49ae-906e-82eb59e2a341",
