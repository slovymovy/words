                "senses": [
                    {
                        "sense_id": "e659888b-ba51-3166-a242-2b96148d6c7e",
                        "entry_id": "eea3340e-4a6a-3941-a706-9bab366b96ee",
                        "glosses": [
                            "kleine knopfähnliche Scheibe, die hinter dem Ball abgelegt wird, bevor der Ball vom Grün aufgehoben wird"
                        ],
                        "tags": [
                            "Golfsport"
                        ],
                        "examples": [
                            {
                                "example_id": "1ea9dd94-2026-412f-bea6-f23c4c3da14d",
                                "sense_id": "e659888b-ba51-3166-a242-2b96148d6c7e",
                                "text": "Da ich meinen Ballmarker verloren habe, nahm ich eine Münze zum Markieren."
                            },
                            {
                                "example_id": "7c9bcf94-b082-4ac8-9a0b-5845009d0c7c",
                                "sense_id": "e659888b-ba51-3166-a242-2b96148d6c7e",
                                "text": "„Heute darf ein Ball auf dem Grün aufgenommen und geputzt werden, nachdem seine Position mit einem geeigneten Ballmarker markiert wurde.“"
                            },
                            {
                                "example_id": "b8add1f8-67d8-4cf8-b651-53ee92326e4b",
                                "sense_id": "e659888b-ba51-3166-a242-2b96148d6c7e",
                                "text": "„Du brauchst einen Ballmarker, um deinen Ball auf dem Grün zu markieren, wenn er einen anderen Ball behindert.“"
                            },
                            {
                                "example_id": "083b494a-5a03-4e74-98e5-91441dbdc2d4",
                                "sense_id": "e659888b-ba51-3166-a242-2b96148d6c7e",
                                "text": "„Würde Beckstein golfen, könnte er auch sein Konterfei mit dem Parteilogo auf Bälle, Shirts, Kappen oder Ballmarker drucken, wie es in den USA Barack Obama und sein politischer Gegner, der Republikaner John McCain, auf ihrer Homepage anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
