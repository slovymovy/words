                    },
                    {
                        "translation_id": "d97ad71a-ae41-4cd5-901c-e60167255ffc",
                        "source_entry_id": "ef2cdab4-273a-3d9c-9dc3-ef767dc3d29c",
                        "source_sense_id": "3b871f12-59ed-3805-a2ed-6936341e731e",
                        "source_sense_description": "relevancy",
                        "target_lang_word": "Eignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eignung",
