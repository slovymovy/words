                            {
                                "example_id": "f19c5435-278e-4d8c-9469-4d8be3e2eb6e",
                                "sense_id": "51706c93-f5a6-35bb-a119-cfe72d5645e3",
                                "text": "Zaël méprisait de s’anonchalir aux bazars (où l’on vend des étoffes brodées de contes de fées), aux cafés (où de tremblantes mains défrisent la chevelure parfumée des adolescents)."
                            },
                            {
                                "example_id": "95eadc35-4205-482a-a771-e1c81ae83fc4",
                                "sense_id": "51706c93-f5a6-35bb-a119-cfe72d5645e3",
                                "text": "Sur une place circulaire, entourée de bâtisses sordides, s’anonchalissaient des hidalgos en feutres coniques, avec des prunelles de félins et de noires moustaches circonflexes."
                            }
                        ]
                    }
