                                        "entry_id": "e182f78b-0660-3f23-a877-7a58b3b8e3ce",
                                        "glosses": [
                                            "The state of being bisexual (“having both male and female parts or roles”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d697371-c563-4335-a8f2-b8a776d37d1a",
                                                "sense_id": "5deab376-48e2-3c40-809e-eec975b8c10a",
                                                "text": "Recall from earlier in this paper that H. longicornis consists of obligatory bisexual diploid races (20+XX 0; 20+X) […] and variance is obscured because of the simultaneous variables of method of reproduction (bisexuality vs. thelytoky) and […]"
                                            }
                                        ]
