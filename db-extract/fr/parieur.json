                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9515a3bf-6194-4f62-a62d-1b26d47c963a",
                        "entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                        "tags": [
                            "plural"
                        ],
                        "form": "parieurs"
                    },
                    {
                        "form_id": "d5330535-93a2-4d24-8189-f282077b68f6",
                        "entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                        "tags": [
                            "feminine"
                        ],
                        "form": "parieuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                        "entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                        "glosses": [
                            "Personne qui parie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d793b00-28bb-4ecb-a1e6-93fce687588c",
                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                "text": "Les matches se disputaient au milieu d'un grand vacarme produit par les cris des parieurs comme les parties de chistera en Espagne."
                            },
                            {
                                "example_id": "46298f0b-098f-4f27-b1b4-346cf380b25c",
                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                "text": "Toursène s’acharnait, comme un parieur qui, dans l’égarement de sa passion et contre tout bon sens va jusqu’à son dernier afghani."
                            },
                            {
                                "example_id": "8465a8be-4d76-48e1-b061-335ad414c446",
                                "sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                                "text": "Chacun peut s'adonner aux joies des paris. Il faut alors entendre les hurlements des parieurs, et les cris des spectateurs. Seul un habitué des gallodromes est capable de comprendre ce qui est en train de se passer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baf37933-effd-4f9b-9150-83a8a3501e46",
                        "source_entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                        "source_sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                        "target_lang_word": "Glücksspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glücksspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c930db4-6e71-36a4-abe4-2ed308dabd55",
                                        "entry_id": "38b84816-3842-356c-ae20-6fe32a6e1675",
                                        "glosses": [
                                            "Person, die an Glücksspielen teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac4c5d7-aec9-41a9-8a93-8841ecb4d91f",
                                                "sense_id": "5c930db4-6e71-36a4-abe4-2ed308dabd55",
                                                "text": "Glücksspieler Hardy und Glücksspielerin Erhardine verzockten gemeinsam ihre letzten Barschaften."
                                            },
                                            {
                                                "example_id": "9c9562eb-e7a3-47e5-a561-408dc12ad7b6",
                                                "sense_id": "5c930db4-6e71-36a4-abe4-2ed308dabd55",
                                                "text": "„Alexej, die Hauptfigur in Dostojewskijs Erzählung der Spieler, offenbart alle Züge des Glücksspielers.\""
                                            },
                                            {
                                                "example_id": "7328f593-2f47-4a66-b8d7-d5433844190d",
                                                "sense_id": "5c930db4-6e71-36a4-abe4-2ed308dabd55",
                                                "text": "„Was meinem teuren Kumpan den Befehl eintrug, das Gebiet der Republik zu verlassen, war nicht das Spiel; denn die Staatsinquisitoren hätten viel zu tun, wollten sie den Staat von allen Glücksspielern säubern.“"
                                            },
                                            {
                                                "example_id": "70ad7820-98cf-4f9a-b59b-ccecb3e87484",
                                                "sense_id": "5c930db4-6e71-36a4-abe4-2ed308dabd55",
                                                "text": "„Dort gibt es kleine Bars, in denen sich fast ausschließlich Huren, Zuhälter, Halsabschneider und Glücksspieler drängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba40a1de-7d33-48f4-92de-6cb6b9c9e16a",
                        "source_entry_id": "12875131-b578-3919-b56d-ba33a06a1486",
                        "source_sense_id": "6885570a-a965-3a3d-9470-90edf5bf3866",
                        "target_lang_word": "Wetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                        "entry_id": "711438b6-b10f-3264-87dd-d85a288c0d0d",
                                        "glosses": [
                                            "aktueller Zustand der Atmosphäre an einem bestimmten Ort und zu einer bestimmten Zeit"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249750f0-621a-4db5-8d72-390d68fdc75e",
                                                "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                                "text": "Morgen wird schönes Wetter."
                                            },
                                            {
                                                "example_id": "05d1bfb4-8cfd-45fd-8855-d41ba7798da1",
                                                "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                                "text": "„Es gibt kaum einen Ort auf der Welt, der unbeständigeres Wetter hat als Island.“"
                                            },
                                            {
                                                "example_id": "ca58560e-cfe0-490d-a265-5eb4dde0b2a8",
                                                "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                                "text": "„Bei gutem Wetter genießt man jedoch immer wieder eine herrliche Aussicht auf schroffe Gebirgskämme und in tiefe Fjordtäler.“"
                                            },
                                            {
                                                "example_id": "23cbef52-7f90-4819-9a1a-1ac8ac21a5f3",
                                                "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                                "text": "„Auf Fotos ist das Wetter nie schlecht. In der Realität aber schon, immer mehr Bergsteiger überschätzen sich auf dem Weg auf den Gipfel.“"
                                            },
                                            {
                                                "example_id": "fcd7258a-4ff9-46fc-8a44-4ba7f8e51e18",
                                                "sense_id": "eda4648e-df9b-305c-b49f-6295c565f44b",
                                                "text": "„Das Wetter verschlechterte sich wieder, und es war notwendig, einen Halt einzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "073e07fe-3b2f-306b-aa6c-cb6c4b8d0a1d",
                                        "entry_id": "711438b6-b10f-3264-87dd-d85a288c0d0d",
                                        "glosses": [
                                            "die Luft in einem Bergwerk"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeeb5678-0bab-4966-80d6-57d007abf627",
                                                "sense_id": "073e07fe-3b2f-306b-aa6c-cb6c4b8d0a1d",
                                                "text": "Der Wetterschacht versorgt die Grube mit frischen Wettern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "32e4df7d-9b3b-393c-a6ff-d339a9512cdb",
                                        "entry_id": "711438b6-b10f-3264-87dd-d85a288c0d0d",
                                        "glosses": [
                                            "Unwetter, Gewitter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51fd9ac2-ac10-4f83-ab8a-801ae9fd4949",
                                                "sense_id": "32e4df7d-9b3b-393c-a6ff-d339a9512cdb",
                                                "text": "„›Es hat gedonnert‹, log ich in meiner Angst, ›es kommt ein Wetter. Wir wollen zurück nach Hause.‹“"
                                            },
                                            {
                                                "example_id": "9a43bc1b-b318-4799-a322-85108f610a05",
                                                "sense_id": "32e4df7d-9b3b-393c-a6ff-d339a9512cdb",
                                                "text": "„Gilt, was ihr könnt; Geht nicht zu tief ins Land, es kommt ein Wetter, Und überties ist dieser Platz berüchtigt Der Raubthier wegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87f3ed35-e478-3b23-ac3f-9ae2ff08c0df",
                                        "entry_id": "92089ff9-b3c1-3224-bdd2-92762dccc17b",
                                        "glosses": [
                                            "jemand, der wettet; Person, die eine Wette abschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0640e5-d009-4e8a-b582-0431f9467c0e",
                                                "sense_id": "87f3ed35-e478-3b23-ac3f-9ae2ff08c0df",
                                                "text": "Da werden die meisten Wetter lange Gesichter machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
