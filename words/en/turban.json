{
    "word_family": [
        "turbaned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "029ced05-8683-390b-bb03-6c265eaaa5bc",
                    "sense_definition": "A traditional headdress made by winding a long piece of cloth around the head.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man wore a traditional <w>turban</w> made of bright blue silk.",
                            "target_lang_translations": {
                                "zh": "那个男人戴着一条用亮蓝色丝绸制成的传统<w>头巾</w>。"
                            }
                        },
                        {
                            "text": "He carefully adjusted his <w>turban</w> before entering the temple.",
                            "target_lang_translations": {
                                "zh": "他在进入寺庙前仔细整理了一下自己的<w>头巾</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "headwrap"
                    ],
                    "common_phrases": [
                        "wear a turban"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种传统的头饰，由长布条缠绕在头上而成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "头巾",
                                "target_lang_sense_clarification": "指缠绕在头上的传统布制头饰。"
                            },
                            {
                                "target_lang_word": "缠头巾",
                                "target_lang_sense_clarification": "特指缠绕式的头饰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "456ca416-92d3-399f-b4bb-94735f08ca15",
                    "sense_definition": "A towel or cloth wrapped around wet hair to dry it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrapped her wet hair in a <w>turban</w> after her shower.",
                            "target_lang_translations": {
                                "zh": "洗完澡后，她用一条<w>干发帽</w>把湿头发包了起来。"
                            }
                        },
                        {
                            "text": "Using a microfiber <w>turban</w> helps dry hair faster without damage.",
                            "target_lang_translations": {
                                "zh": "使用超细纤维<w>干发帽</w>有助于更快地吹干头发且不会造成损伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hair-wrap"
                    ],
                    "common_phrases": [
                        "towel turban"
                    ],
                    "target_lang_definitions": {
                        "zh": "洗澡后包裹湿头发的毛巾或布。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "干发帽",
                                "target_lang_sense_clarification": "专门用于包裹湿发以加速干燥的布帽。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc10dc5-c895-3ca5-a911-7ca3987fa23d",
                    "sense_definition": "A woman's close-fitting hat that has no brim.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage fashion show featured models wearing elegant velvet <w>turbans</w>.",
                            "target_lang_translations": {
                                "zh": "那场复古时装秀上的模特们戴着优雅的丝绒<w>无檐帽</w>。"
                            }
                        },
                        {
                            "text": "She accessorized her evening gown with a stylish beaded <w>turban</w>.",
                            "target_lang_translations": {
                                "zh": "她用一顶时尚的珠饰<w>无檐帽</w>来搭配她的晚礼服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cloche"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种女性佩戴的紧身无檐帽。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无檐帽",
                                "target_lang_sense_clarification": "指时尚风格的紧身无檐女帽。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a8b06d5-d234-30c8-ab26-a7eaf3547a24",
                    "sense_definition": "The complete set of spiral whorls found on a shell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist examined the <w>turban</w> of the rare sea snail.",
                            "target_lang_translations": {
                                "zh": "生物学家检查了那只稀有海螺的<w>螺层</w>。"
                            }
                        },
                        {
                            "text": "The shell's <w>turban</w> showed signs of significant erosion over time.",
                            "target_lang_translations": {
                                "zh": "贝壳的<w>螺层</w>显示出随着时间推移而产生的严重侵蚀迹象。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "贝壳上螺旋状的纹路或结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "螺层",
                                "target_lang_sense_clarification": "生物学上指贝壳的螺旋结构。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b4b2242-baf2-308c-a535-66758d88accc",
                    "sense_definition": "To cover or wrap a person's head with a turban.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor helped to <w>turban</w> the guest for the wedding ceremony.",
                            "target_lang_translations": {
                                "zh": "裁缝帮那位客人为婚礼仪式<w>缠头</w>。"
                            }
                        },
                        {
                            "text": "It is customary to <w>turban</w> the head before entering the sacred space.",
                            "target_lang_translations": {
                                "zh": "在进入神圣空间之前，按习俗需要<w>缠头</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrap"
                    ],
                    "target_lang_definitions": {
                        "zh": "用头巾包裹某人的头部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缠头",
                                "target_lang_sense_clarification": "动词，指用布包裹头部。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}