                "senses": [
                    {
                        "sense_id": "5089d3d0-b5bc-3dfa-a36a-e816f34eeba2",
                        "entry_id": "32fd17e0-39d7-38ff-bc65-093fa458bbd9",
                        "glosses": [
                            "Kamin aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75ba9fc-02b4-4fb8-8501-f682f6961b8a",
                                "sense_id": "5089d3d0-b5bc-3dfa-a36a-e816f34eeba2",
                                "text": "„Weil das Apartmenthaus selbst auf einem langen, schmalen Grundstück errichtet worden war, war die Eingangshalle lang und schmal, mit einem riesigen weißen Marmorkamin, in dem nichts verbrannt werden konnte und über dem ein ebenso riesiger Spiegel mit Goldrand hing, der mit Hilfe eines kleinen Krans an seinen Platz gehoben worden war.“"
                            },
                            {
                                "example_id": "a75df086-47ca-4d96-ace1-d6b1a1a1a878",
                                "sense_id": "5089d3d0-b5bc-3dfa-a36a-e816f34eeba2",
                                "text": "„Die Barnabaskreatur kniff bedrohlich die Augen zusammen und schaute sich im Zimmer um, betrachtete ostentativ den Kristallleuchter, den Rosenholzflügel, den Marmorkamin und die Samtpolster.“"
                            },
                            {
                                "example_id": "419235f2-6ad8-499e-9ac3-c18d4a6e8f74",
                                "sense_id": "5089d3d0-b5bc-3dfa-a36a-e816f34eeba2",
                                "text": "„Als der Makler ihr die sonnige geflieste Küche zeigte, den Aufzug mit dem kunstvoll verschnörkelten Schmiedeeisen und die gemeißelten Marmorkamine, stellte Penny, ohne zu feilschen, einen Scheck über den vollen Preis aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
