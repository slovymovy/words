{
    "word_family": [
        "concession",
        "concessive",
        "conceder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9aa9c9ef-1090-3e4e-9c92-e0829786d797",
                    "sense_definition": "To admit that something is true or valid, often after first denying or resisting it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "acknowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After reviewing the new evidence, the scientist had to <w>concede</w> that his initial theory was incorrect.",
                            "target_lang_translations": {
                                "ru": "После изучения новых доказательств ученому пришлось <w>признать</w>, что его первоначальная теория была неверной."
                            }
                        },
                        {
                            "text": "The government has finally <w>conceded</w> defeat in its attempt to pass the controversial new law.",
                            "target_lang_translations": {
                                "ru": "Правительство наконец <w>признало</w> поражение в своей попытке принять спорный новый закон."
                            }
                        }
                    ],
                    "synonyms": [
                        "grant"
                    ],
                    "antonyms": [
                        "deny",
                        "dispute",
                        "reject"
                    ],
                    "common_phrases": [
                        "concede defeat",
                        "concede a point",
                        "reluctantly concede"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать что-либо истинным или действительным, часто после первоначального отрицания или сопротивления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "соглашаться с фактом"
                            },
                            {
                                "target_lang_word": "признать",
                                "target_lang_sense_clarification": "согласиться с фактом (сов. вид)"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "соглашаться с возможностью чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "393c97cd-ed96-308e-adf0-f7f7a5215a89",
                    "sense_definition": "To surrender or yield something, such as a right, a territory, or a competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate decided to <w>concede</w> the election once it became clear she could not win.",
                            "target_lang_translations": {
                                "ru": "Кандидат решила <w>признать поражение</w> на выборах, как только стало ясно, что она не сможет победить."
                            }
                        },
                        {
                            "text": "The rebels were forced to <w>concede</w> the territory after weeks of heavy fighting.",
                            "target_lang_translations": {
                                "ru": "Повстанцы были вынуждены <w>сдать</w> территорию после недель тяжелых боев."
                            }
                        }
                    ],
                    "synonyms": [
                        "give up",
                        "capitulate",
                        "give way"
                    ],
                    "antonyms": [
                        "win",
                        "retain",
                        "defend"
                    ],
                    "common_phrases": [
                        "concede the race",
                        "concede the argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдавать или уступать что-либо, например, право, территорию или победу в соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступать",
                                "target_lang_sense_clarification": "отдавать в чью-то пользу"
                            },
                            {
                                "target_lang_word": "уступить",
                                "target_lang_sense_clarification": "отдать в чью-то пользу (сов. вид)"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "прекращать удерживать позицию"
                            },
                            {
                                "target_lang_word": "признавать поражение",
                                "target_lang_sense_clarification": "в контексте выборов или споров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79181e74-97b7-3564-8f47-db90bbcee06e",
                    "sense_definition": "To allow an opponent to score a goal or point in a game or sport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's defense was so solid that they did not <w>concede</w> a goal during the entire tournament.",
                            "target_lang_translations": {
                                "ru": "Защита команды была настолько прочной, что они не <w>пропустили</w> ни одного гола в течение всего турнира."
                            }
                        },
                        {
                            "text": "It is frustrating to <w>concede</w> a goal in the final minutes of such an important match.",
                            "target_lang_translations": {
                                "ru": "Обидно <w>пропустить</w> гол на последних минутах такого важного матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "let in"
                    ],
                    "antonyms": [
                        "score"
                    ],
                    "common_phrases": [
                        "concede a goal",
                        "concede a penalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволить противнику забить гол или набрать очко в игре или спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропускать",
                                "target_lang_sense_clarification": "о голе или очке"
                            },
                            {
                                "target_lang_word": "пропустить",
                                "target_lang_sense_clarification": "о голе или очке (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d09f51e-8299-3c59-9b90-b277705440e1",
                    "sense_definition": "To grant a right, privilege, or demand, often as a compromise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company agreed to <w>concede</w> better working conditions to the union to avoid a strike.",
                            "target_lang_translations": {
                                "ru": "Компания согласилась <w>предоставить</w> профсоюзу лучшие условия труда, чтобы избежать забастовки."
                            }
                        },
                        {
                            "text": "The king was unwilling to <w>concede</w> any power to the local parliament.",
                            "target_lang_translations": {
                                "ru": "Король не желал <w>уступать</w> никакую власть местному парламенту."
                            }
                        }
                    ],
                    "synonyms": [
                        "grant",
                        "accede"
                    ],
                    "antonyms": [
                        "withhold",
                        "refuse"
                    ],
                    "common_phrases": [
                        "concede a privilege",
                        "concede demands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять право, привилегию или выполнять требование, часто в качестве компромисса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступать",
                                "target_lang_sense_clarification": "идти на уступки"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать право или привилегию"
                            },
                            {
                                "target_lang_word": "соглашаться",
                                "target_lang_sense_clarification": "на требования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}