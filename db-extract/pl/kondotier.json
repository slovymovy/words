                                        "sense_id": "c7ffaac1-8d7e-31ed-b9aa-dd439f15e541",
                                        "entry_id": "b82aef0b-abc5-337b-9d0d-634d27d100fc",
                                        "glosses": [
                                            "A mercenary military leader from 14th-century Italy and later in other parts of Europe."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca8cc63-f945-4bbc-a7ff-f0b66b892be6",
                                                "sense_id": "c7ffaac1-8d7e-31ed-b9aa-dd439f15e541",
                                                "text": "Statues of condottieri stood in their airless niches, darkness flaring in their eye sockets and nostrils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "349ba00e-0dd6-4e59-88e1-e55037d0bcff",
                        "source_entry_id": "93990d80-1bad-3256-9ea0-ddf93b9d2341",
