                "senses": [
                    {
                        "sense_id": "7c6afa5b-e38d-36b7-93a0-1fdfb7d5764c",
                        "entry_id": "6e437903-f9eb-30c8-bfa1-9426bea7fd77",
                        "glosses": [
                            "mit Apfelbäumen bewachsener Hain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cde1f5-45e6-458c-9ed4-3af0e9ddbbab",
                                "sense_id": "7c6afa5b-e38d-36b7-93a0-1fdfb7d5764c",
                                "text": "„Am nächsten Morgen stand er früh auf und lief durch den Apfelhain mit seinen gekrümmten Ästen zu dem höher gelegenen Wald, wo die Öffnung der Schlangengrube schwarz und Einhalt gebietend zwischen bizarren, fetten Eichen klaffte.“"
                            },
                            {
                                "example_id": "f33d46f5-6254-40e4-aee4-5cb7a32bbbbd",
                                "sense_id": "7c6afa5b-e38d-36b7-93a0-1fdfb7d5764c",
                                "text": "„In einer stürmischen Nacht ging er flussab durchs Dunkel der Apfelhaine, Böen fegten heran, Blitze illuminierten ihn mitsamt seinem leeren Sack.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
