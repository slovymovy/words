                        "sense_id": "7e49e4d0-a084-3d99-93ff-f2904b2f9bcd",
                        "entry_id": "0d8ab9dd-f192-38da-a5e2-336b517f5a73",
                        "glosses": [
                            "Qui est d’une douceur fade, un peu doux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b8194f-12e0-4e98-90ed-2c694093277f",
                                "sense_id": "7e49e4d0-a084-3d99-93ff-f2904b2f9bcd",
                                "text": "Une saveur douçâtre."
                            },
                            {
                                "example_id": "99f2b47e-adc9-4db8-addb-ce3863d247d7",
                                "sense_id": "7e49e4d0-a084-3d99-93ff-f2904b2f9bcd",
                                "text": "— Webster posa son verre et lui sourit, mais derrière son sourire douceâtre se profilait une menace. Certes, il jouait bien son jeu, mais Victor n'était pas né de la dernière pluie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee32d1fd-efe3-4479-a0ba-35bceeae1b61",
                        "source_entry_id": "0d8ab9dd-f192-38da-a5e2-336b517f5a73",
                        "source_sense_id": "7e49e4d0-a084-3d99-93ff-f2904b2f9bcd",
                        "target_lang_word": "sweetish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
