                    {
                        "form_id": "fab2cbad-06c6-4662-9512-7f06872bebf8",
                        "entry_id": "7893c5a2-b892-39ce-869e-5781acdcd3c9",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "legendarischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4a9f20e-c5b8-3134-86e7-c44f51acc1b5",
                        "entry_id": "7893c5a2-b892-39ce-869e-5781acdcd3c9",
                        "glosses": [
                            "waarover legendes verteld worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82928fa2-99ca-4b3b-8de2-eddf36e985eb",
                                "sense_id": "c4a9f20e-c5b8-3134-86e7-c44f51acc1b5",
                                "text": "Arthur is een legendarische Britse koning."
                            },
                            {
                                "example_id": "377edae0-4a7e-41ed-9186-5eb978f0e090",
                                "sense_id": "c4a9f20e-c5b8-3134-86e7-c44f51acc1b5",
                                "text": "In Assen komen de twee beelden samen in Window of my Eyes, een tentoonstelling in het Drents Museum over leven en werk van Harry Muskee, die met zijn Cuby + Blizzards legendarisch werd met een heel eigenzinnige Nederblues. De tentoonstelling opent morgen voor het publiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcfb32b0-b6d0-3254-99af-db77d6c20b5b",
                        "entry_id": "7893c5a2-b892-39ce-869e-5781acdcd3c9",
                        "glosses": [
                            "overdrachtelijk overbekend, beroemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2e5da3-8a87-4183-979e-bcfe6549d5d0",
                                "sense_id": "bcfb32b0-b6d0-3254-99af-db77d6c20b5b",
                                "text": "Zijn vermogen tot overdrijving is legendarisch te noemen."
                            },
                            {
                                "example_id": "b0f74afb-2cf2-442a-9713-cd5eac8cb6fe",
                                "sense_id": "bcfb32b0-b6d0-3254-99af-db77d6c20b5b",
                                "text": "'Op drukke dagen hadden we hier enorme files. Er stond zelfs een gendarme op een rond podiumpje het verkeer te regelen', zegt ze, wijzend op een totaal verlaten kruispunt. Velen hebben zowaar heimwee naar die legendarische files van volgepakte auto's die zich door smalle dorpsstraten wurmden."
                            },
                            {
                                "example_id": "cf0f326f-55cb-4f4b-bd10-0dab8289d0b4",
                                "sense_id": "bcfb32b0-b6d0-3254-99af-db77d6c20b5b",
                                "text": "Gelukkig zou de trail binnenkort een weg kruisen waarlangs ik het legendarische ‘Paradise Café’ kon bereiken."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
