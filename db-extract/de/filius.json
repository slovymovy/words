                                "target_senses": [
                                    {
                                        "sense_id": "966924ec-3b6a-3d50-b199-08fff80e75bc",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "One's male offspring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e653ee2f-e64f-479c-8907-c3231e406ec7",
                                                "sense_id": "966924ec-3b6a-3d50-b199-08fff80e75bc",
                                                "text": "Before the birth of the man's child, he said: \"I want a son, not a daughter.\""
                                            },
                                            {
                                                "example_id": "65b499cb-8457-466f-a4d1-d44d406b9291",
                                                "sense_id": "966924ec-3b6a-3d50-b199-08fff80e75bc",
                                                "text": "From what conſummate vertue I have choſe / This perfect Man, by merit call'd my Son,"
                                            },
                                            {
                                                "example_id": "b4235833-b743-44c5-96a0-7b6b02224b9c",
                                                "sense_id": "966924ec-3b6a-3d50-b199-08fff80e75bc",
                                                "text": "“We are pleased that LSST has now been named the Vera C. Rubin Observatory,” said Rubin’s sons Allan Rubin, David Rubin, and Karl Rubin in a statement."
                                            },
                                            {
                                                "example_id": "c359795e-2052-47c5-a085-2c89c357f117",
                                                "sense_id": "966924ec-3b6a-3d50-b199-08fff80e75bc",
                                                "text": "Cristiano Ronaldo’s eldest son has earned his first call-up for the Portugal Under-15 national squad, the team announced on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742d72c2-1b9b-394d-92c2-6386a2af9948",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "A male adopted person in relation to his adoptive parents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0af11b18-6653-32cd-958b-28c7f2d8636a",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "A male person who has such a close relationship with an older or otherwise more authoritative person that he can be regarded as a son of the other person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ee8b94-d0b1-4b8d-ad91-33b7d0a871f0",
                                                "sense_id": "0af11b18-6653-32cd-958b-28c7f2d8636a",
                                                "text": "Eli called Samuel his son. Be plain, good son, and homely in thy drift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "987a7cf7-9e42-3e02-ba90-8d48609eaeca",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "A male person considered to have been significantly shaped by social conflict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd44f33c-5ec9-447e-a2b7-774c03ec571f",
                                                "sense_id": "987a7cf7-9e42-3e02-ba90-8d48609eaeca",
                                                "text": "He was a son of the mafia system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9178d3-6f0c-3e0d-bfdb-d6a45fb5acda",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "A person regarded as the product of some place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85326d85-ede5-4f24-b2dc-f60cf51e6137",
                                                "sense_id": "8a9178d3-6f0c-3e0d-bfdb-d6a45fb5acda",
                                                "text": "I hold it to be true, that the people are the sons of the soil; and we are only their instruments here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a16ad15e-39b8-3663-a5ea-536eeb5cd69f",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "A familiar address to a male person from an older or otherwise more authoritative person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ac0fcd-1731-4c99-9f52-6624abedc55e",
                                                "sense_id": "a16ad15e-39b8-3663-a5ea-536eeb5cd69f",
                                                "text": "Shepard: Stay with me. We're almost through this.\nAdmiral Anderson: You did good, son. You did good. I'm proud of you.\nShepard: Thank you, sir. Anderson?"
                                            },
                                            {
                                                "example_id": "b8fb5e8f-c609-4e15-b3cb-093996c96ff7",
                                                "sense_id": "a16ad15e-39b8-3663-a5ea-536eeb5cd69f",
                                                "text": "Son, can't you see that she's just a little girl?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bdbbc25-54aa-3a9b-a65d-d428f0d18e98",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "An informal address to a friend or person of equal authority."
                                        ],
                                        "tags": [
                                            "New-York-City",
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31d3bf7c-f218-34d0-9b68-ce5d1d34f5f2",
                                        "entry_id": "f426fac1-f6d0-38ed-b284-0efbbd155ab5",
                                        "glosses": [
                                            "The current version of a file, derived from the preceding father file."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad3f193-fea1-44fa-aa09-1ed2bd376989",
                                                "sense_id": "31d3bf7c-f218-34d0-9b68-ce5d1d34f5f2",
                                                "text": "Three generations of file are usually kept, being the grandfather, father and son files."
                                            },
                                            {
                                                "example_id": "94b9c023-6631-4b4a-81aa-4f2028f440b1",
                                                "sense_id": "31d3bf7c-f218-34d0-9b68-ce5d1d34f5f2",
                                                "text": "After the update, the new file master file is the son. The file from which the father was developed with the transaction files of the appropriate day is the grandfather. The grandfather and son files are stored in different locations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "son",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7beae28b-2a5a-3260-a667-99658ca147d2",
                                        "entry_id": "555097f0-6ced-30d3-b585-8cb188a4087c",
                                        "glosses": [
                                            "To produce (i.e. bear, father, beget) a son."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e28ca4-20c4-4d89-81c5-e2b51bab66bc",
                                                "sense_id": "7beae28b-2a5a-3260-a667-99658ca147d2",
                                                "text": "I sonned a father who would not be sonned, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94da6b52-d373-3ed4-83e3-7954db2687cc",
                                        "entry_id": "555097f0-6ced-30d3-b585-8cb188a4087c",
                                        "glosses": [
                                            "To address (someone) as \\\"son\\\"."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d952fba3-3c9a-4d91-bf43-79da9fb60c75",
                                                "sense_id": "94da6b52-d373-3ed4-83e3-7954db2687cc",
                                                "text": "“Don't 'son' me.” “I'm old enough to be your father,” he said with a dismissive wave of his hand."
                                            },
                                            {
                                                "example_id": "75b9c1fb-f84c-4932-8ea5-885b54915a04",
                                                "sense_id": "94da6b52-d373-3ed4-83e3-7954db2687cc",
                                                "text": "“Son—now's not the time, please.” “It's the perfect time—it's the best time fucking time I ever had. There's not gonna be another time, so don't son me, you bastard. […]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
