                ],
                "translations": [
                    {
                        "translation_id": "cd91293b-2752-4d08-8b98-a6b6aa496daf",
                        "source_entry_id": "b8f21d93-f18b-3955-a70d-202d335c1579",
                        "source_sense_id": "d40451d8-6b22-3a11-8689-7e16c0e6a454",
                        "source_sense_description": "ein Haushaltsgerät, um den Korken aus einer Flasche Wein herauszuziehen",
                        "target_lang_word": "corkscrew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corkscrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "562f8ade-4364-3a74-9bd7-34620128b4e1",
                                        "entry_id": "3edaa790-d325-3084-911e-d4e303884240",
                                        "glosses": [
                                            "An implement for opening bottles that are sealed by a cork. Sometimes specifically such an implement that includes a screw-shaped part, or worm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdb75fc-7604-47d2-8f59-19619537f290",
                                                "sense_id": "562f8ade-4364-3a74-9bd7-34620128b4e1",
                                                "text": "I opened the wine with a corkscrew."
                                            },
                                            {
                                                "example_id": "71c7fb95-f058-447a-b902-09322be870f0",
                                                "sense_id": "562f8ade-4364-3a74-9bd7-34620128b4e1",
                                                "text": "There stood presented to his sight, Or seem'd to stand, the God of wine, […] This hand a Cork-scrue did contain, And that a Bottle of Champaign."
                                            },
                                            {
                                                "example_id": "aa3190a9-9a13-4132-81d1-5e2087ab3c69",
                                                "sense_id": "562f8ade-4364-3a74-9bd7-34620128b4e1",
                                                "text": "A corkscrew is designed so that when it is turned it creates effectively a helical undulation pushing it into the cork, whereas rotation in the opposite sense pulls it out."
                                            },
                                            {
                                                "example_id": "16f46ad0-6086-4d18-85b6-3899efdaaa86",
                                                "sense_id": "562f8ade-4364-3a74-9bd7-34620128b4e1",
                                                "text": "A two-prong or ah-so corkscrew with sheath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a8ab0a3-1251-32ff-bd14-0f306e2ea8f3",
                                        "entry_id": "3edaa790-d325-3084-911e-d4e303884240",
                                        "glosses": [
                                            "The screw-shaped worm of a typical corkscrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c390e7-5f12-43d9-aeb1-9e1aac1c5bd6",
                                                "sense_id": "7a8ab0a3-1251-32ff-bd14-0f306e2ea8f3",
                                                "text": "A bubble rising rapidly in water describes a spiral closely resembling a corkscrew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c8f1e2-104b-317c-9770-e48052e60d52",
                                        "entry_id": "3edaa790-d325-3084-911e-d4e303884240",
                                        "glosses": [
                                            "A type of sharp, twisting punch, often one thrown close and from the side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3531c1f9-bbb0-4853-969e-75a16e5e452b",
                                                "sense_id": "01c8f1e2-104b-317c-9770-e48052e60d52",
                                                "text": "[…] the immovable McCoy let fly his most miraculous punch of the evening, of his lives, a world-beater of a right corkscrew, a punch years in the windup […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45c2e8e-7140-398a-849f-aca006ea1c30",
                                        "entry_id": "3edaa790-d325-3084-911e-d4e303884240",
                                        "glosses": [
                                            "A type of inversion used in roller coasters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0493ef47-d7a6-440a-9e08-feb8a8e92b05",
                                                "sense_id": "f45c2e8e-7140-398a-849f-aca006ea1c30",
                                                "text": "A corkscrew has a 90° turn just prior to the loop and a 90° turn just afterward."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corkscrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d74e75-6501-3b08-a310-c13b8329d40c",
                                        "entry_id": "74a6cac5-ce56-3e7a-833d-bc977843ce75",
                                        "glosses": [
                                            "Having the tightly winding shape of a corkscrew."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c27507-6808-4669-9950-b59363ecde11",
                                                "sense_id": "35d74e75-6501-3b08-a310-c13b8329d40c",
                                                "text": "Then the old gentleman spun himself round with velocity in the opposite direction, continued to spin until his long cloak was all wound neatly about him, clapped his cap on his head, very much on one side (for it could not stand upright without going through the ceiling), gave an additional twist to his corkscrew mustaches, and replied with perfect coolness."
                                            },
                                            {
                                                "example_id": "1289d6fb-3877-4f34-ad41-9f5a33b66199",
                                                "sense_id": "35d74e75-6501-3b08-a310-c13b8329d40c",
                                                "text": "All the heat of a decade of fierce Indian summers is stored in the pitch-black, polished walls of the corkscrew staircase."
                                            },
                                            {
                                                "example_id": "f4a0120b-07cb-4451-a0f2-41d1300dc2d0",
                                                "sense_id": "35d74e75-6501-3b08-a310-c13b8329d40c",
                                                "text": "Wide eyes and corkscrew hair / Tied with lace you found somewhere"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corkscrew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bba2cff5-c729-3d90-8df9-718980b7ee42",
                                        "entry_id": "3dcb0154-602b-38d8-995f-687e2f5bebe2",
                                        "glosses": [
                                            "To wind or twist in the manner of a corkscrew; to move with much horizontal and vertical shifting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c32ab2d-18cd-4ad0-b19a-6c68e8efc1b8",
                                                "sense_id": "bba2cff5-c729-3d90-8df9-718980b7ee42",
                                                "text": "Into the tea–room Mr. Pickwick turned; and catching sight of him, Mr. Bantam corkscrewed his way through the crowd and welcomed him with ecstasy."
                                            },
                                            {
                                                "example_id": "449e23b2-4bc4-4ad5-94f1-0696651e7381",
                                                "sense_id": "bba2cff5-c729-3d90-8df9-718980b7ee42",
                                                "text": "The street corkscrewed endlessly. Sometimes it seemed to stop; then it found a hole in the opposing masonry and edged its way in."
                                            },
                                            {
                                                "example_id": "a0f0e973-4dfe-4129-aa67-deff77d869be",
                                                "sense_id": "bba2cff5-c729-3d90-8df9-718980b7ee42",
                                                "text": "Far off to starboard an Atlantic liner, all lights blazing, came towards us, corkscrewing with a motion which must have left the passengers unhappy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41024bf1-84df-358b-bada-1c221d3206fd",
                                        "entry_id": "3dcb0154-602b-38d8-995f-687e2f5bebe2",
                                        "glosses": [
                                            "To cause something to twist or move in a spiral path or shape."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11129306-0c14-4834-a6fe-338c31fb7115",
                                                "sense_id": "41024bf1-84df-358b-bada-1c221d3206fd",
                                                "text": "Caught and twisted—corkscrewed in the mazes of the line, loose harpoons and lances, with all their bristling barbs and points, came flashing and dripping up to the chocks in the bows of Ahab’s boat."
                                            },
                                            {
                                                "example_id": "de4322ae-7b5c-4496-ac8d-24fe958fb52f",
                                                "sense_id": "41024bf1-84df-358b-bada-1c221d3206fd",
                                                "text": "Rusty corkscrewed the plane back down again, but instead of mashing the throttles to the wall, he pulled them to idle."
                                            },
                                            {
                                                "example_id": "5e36d8cb-7582-4e36-9ef9-61de58ac7342",
                                                "sense_id": "41024bf1-84df-358b-bada-1c221d3206fd",
                                                "text": "Soon he was corkscrewed into place, suspended from the ceiling in an impossible maze of unforgiving circuitry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ae364b-3aa2-3a7d-b1ee-f24d5dc2c15a",
                                        "entry_id": "3dcb0154-602b-38d8-995f-687e2f5bebe2",
                                        "glosses": [
                                            "To extract information or consent from someone."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df487d02-0df2-4563-9c3a-dffd74f09052",
                                                "sense_id": "14ae364b-3aa2-3a7d-b1ee-f24d5dc2c15a",
                                                "text": "I strongly suspect (from what Small has dropped, and from what we have corkscrewed out of him) that those letters I was to have brought to your ladyship were not destroyed when I supposed they were."
                                            },
                                            {
                                                "example_id": "fec3d87c-90e5-4839-a541-58720ade1f20",
                                                "sense_id": "14ae364b-3aa2-3a7d-b1ee-f24d5dc2c15a",
                                                "text": "Yes, I believe you did after it was corkscrewed out of you, but I got the impression at the outset that you were, just as willing to let it stand there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
