                    {
                        "sense_id": "3d9cf5f9-cf3a-378f-bf37-3203a212c2f6",
                        "entry_id": "41b8e492-3b63-34b6-afbb-0b08fdaa0870",
                        "glosses": [
                            "A person's focus of attention."
