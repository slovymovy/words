                "translations": [
                    {
                        "translation_id": "e4e72904-371a-40e8-9e71-91e43271f641",
                        "source_entry_id": "2450715b-7dc7-3a64-9ea6-61e39af7efca",
                        "source_sense_id": "5cc3406b-0231-31d6-b653-1ce9c9d263c5",
                        "target_lang_word": "regressive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regressive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                                        "glosses": [
                                            "That tends to return, revert or regress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea491d35-33ce-4de4-a3c9-f23f4a2d084b",
                                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                                "text": "Some say history repeats itself, that time is cyclical. Others cling to the notion of progress and change over time. Apparently Nancy Walker marches to a different drummer — marches backwards, that is. Her ideas on art and society seem quaint and odd on the one hand and, on the other, petty and regressive."
                                            },
                                            {
                                                "example_id": "4e2c02ea-aa89-4511-90ec-cb0c48fdd953",
                                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                                "text": "A contributing factor to this slightly regressive femininity may have been the sugary fabrics (silver lamé, tulle over sequins) and the meringuelike puffs and baby Googums bows at the neck."
                                            },
                                            {
                                                "example_id": "b969d126-b647-46fb-a8ac-5aa382113845",
                                                "sense_id": "597e088d-b188-316d-af80-9e2bd9e2f588",
                                                "text": "He likes experimenting with flamboyant clothes! That’s it! It’s weird and regressive to think that means he is making a statement about his sexual orientation or gender identity. Let the man wear his “clowncore” jumpsuits in peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6501c434-64d4-3ed7-8774-041d0c2b2ece",
                                        "entry_id": "52dc07d8-4593-3bbb-a6a9-909832e614b3",
                                        "glosses": [
                                            "Whose rate decreases as the taxed amount increases."
                                        ],
                                        "tags": [
                                            "of a tax"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb466c0a-a6e7-4c28-86d8-bc346d5adffa",
                        "source_entry_id": "2450715b-7dc7-3a64-9ea6-61e39af7efca",
                        "source_sense_id": "5cc3406b-0231-31d6-b653-1ce9c9d263c5",
