                                    }
                                ]
                            },
                            {
                                "target_word": "epigenética",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0b9d7b48-66a1-31a5-ac0f-49fc9ad52710",
                                        "entry_id": "11d20da6-b208-36b1-a89e-d8ca57d5a439",
                                        "glosses": [
                                            "Estudio de los mecanismos que regulan la expresión de los genes sin una modificación en la secuencia del ADN. Establece la relación entre las influencias genéticas y ambientales que determinan un fenotipo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41ddbb0d-3ce2-4581-bf9e-7b3cc0ddfe2b",
                        "source_entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
                        "source_sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                        "target_lang_word": "Epigenetik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epigenetik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d22b85a0-40a1-3af8-9ccf-33944cf0bdb5",
                                        "entry_id": "82a02e47-63c4-306d-89c9-fe1e6be003c9",
                                        "glosses": [
                                            "Zweig der Biologie, der die kausalen Wechselwirkungen zwischen Genen und ihren Produkten untersucht, welche die Genexpressionen und den Phänotypus (Erscheinungsform) der Organismen, nicht jedoch das Genom (die DNA) verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0fc67e-70a6-4d51-8014-a543abb8b712",
                                                "sense_id": "d22b85a0-40a1-3af8-9ccf-33944cf0bdb5",
                                                "text": "Die Epigenetik beschäftigt sich mit der Aktivierung bzw. Deaktivierung von Gensequenzen durch Schaltermoleküle, Umwelteinflüsse und zufällige Ereignisse."
                                            },
                                            {
                                                "example_id": "60dce25a-5ab0-444d-a841-733346238321",
                                                "sense_id": "d22b85a0-40a1-3af8-9ccf-33944cf0bdb5",
                                                "text": "Er sieht die Epigenetik vielmehr als eine „Spielwiese der Genetik“, die rasche Anpassungen an bestimmte Umstände und Bedingungen erlaubt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea33f71e-aa6a-37b2-8522-137b598d499f",
                                        "entry_id": "82a02e47-63c4-306d-89c9-fe1e6be003c9",
                                        "glosses": [
                                            "Zweig der Biologie, der sich mit der Weitergabe von Eigenschaften auf die Nachkommen beschäftigt, die nicht auf Mutationen des Genoms, sondern auf eine vererbbare Änderung der Genexpression und der Genregulation zurückzuführen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d10ef32-2a4a-4a30-ab5e-5efecffc7492",
                                                "sense_id": "ea33f71e-aa6a-37b2-8522-137b598d499f",
                                                "text": "Die sogenannte transgenerationale Epigenetik ist erst seit Kurzem wissenschaftlich akzeptiert. Die Epigenetik erklärt, warum beispielsweise Haar- und Muskelzellen völlig verschieden sind, obwohl sie dieselbe DNA besitzen."
                                            },
                                            {
                                                "example_id": "f6ed0930-c30e-4a1b-acad-b129ab303bdf",
                                                "sense_id": "ea33f71e-aa6a-37b2-8522-137b598d499f",
                                                "text": "Die Epigenetik beschäftigt sich u.a. mit jenen vererbbaren Unterschieden, die sich nicht auf die Veränderungen des Gencodes zurückführen lassen."
                                            },
                                            {
                                                "example_id": "7b2aa99c-1604-4fbb-a234-de371c8dcf0d",
                                                "sense_id": "ea33f71e-aa6a-37b2-8522-137b598d499f",
                                                "text": "„Man spricht in diesem Zusammenhang von der Epigenetik und Lamarckismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
