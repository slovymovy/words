                    },
                    {
                        "sense_id": "fde9a37a-d8a2-32ba-8a5c-855ab1b0f066",
                        "entry_id": "5bdb2515-2351-32f0-bbb7-9b42246c6159",
                        "glosses": [
                            "Tirer un clou qui faisait boiter un cheval."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3345fe65-8dea-3f87-bd47-d788932ba3d9",
                        "entry_id": "5bdb2515-2351-32f0-bbb7-9b42246c6159",
                        "glosses": [
                            "Ôter le clou qui est enfoncé dans la lumière d'un canon pour le mettre hors de service."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a69cd4-91a9-4124-bd59-76c7fbed156d",
                                "sense_id": "3345fe65-8dea-3f87-bd47-d788932ba3d9",
                                "text": "Nos encloueurs et leur vaillante escorte avaient renouvelé sur la côte des Heyvaux le hardi coup de main de la nuit du 19 au 20. Depuis cette époque les Allemands avaient réarmé leurs batteries, soit avec de nouveaux canons, soit avec les anciens qu'ils étaient parvenus à désenclouer; […]."
                            },
                            {
                                "example_id": "6c0cae9f-02dc-43f1-a2e1-4918ad46414e",
                                "sense_id": "3345fe65-8dea-3f87-bd47-d788932ba3d9",
                                "text": "De 23 pièces de canon qu'ils [les ennemis] avaient enclouées, ils virent et entendirent qu'on avait trouvé le moyen d’en désenclouer vingt et une"
                            }
                        ]
                    }
