                            {
                                "example_id": "4040bf5a-2d3c-474d-9cd5-71284d5bb834",
                                "sense_id": "e7e6b3b7-db79-30f9-8c5f-8392279be8fb",
                                "text": "Die Äffchen ärgerten ihre Affenmutter.",
                                "translation": "De aapjes ergerden hun apenmoeder."
                            }
                        ]
                    },
                    {
                        "sense_id": "949df5fd-d39e-3d28-b90d-88cd092fbfbc",
                        "entry_id": "060f5184-be73-3693-80c0-28500f333ca6",
