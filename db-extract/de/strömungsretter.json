                ],
                "senses": [
                    {
                        "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                        "entry_id": "b23a3d1f-d886-3f14-be94-9f32ab3cdec5",
                        "glosses": [
                            "(männliche^☆) Person, die im Wasserrettungsdienst tätig ist und dort als Spezialist vor allem für die Rettung aus stark strömenden Gewässern sowie für die Rettung und Bergung aus Schluchten (mit Wildbach) eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4dec48-2eae-4012-b425-2a7029953116",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Ein Strömungsretter mit Helm, Trockenanzug und Spezialschwimmweste hechtet in die Donau, greift Markus und zieht ihn über die Rampe ins sichere Boot.“"
                            },
                            {
                                "example_id": "87be059a-75c3-46ad-bdef-2f2d706c59b7",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Das mögliche Aufgabenspektrum eines Strömungsretters ist vielfältig: Rettung von Menschen aus schnell fließenden Gewässern (Flussrettung, Wildwasser, Hochwasser), Rettung und Bergung aus schlecht zugänglichen Klammen und Schluchten (Canyoning-Touristen in Notlage), Absicherung von Sportveranstaltungen.“"
                            },
                            {
                                "example_id": "485d30ad-68b1-4096-9670-856cef7cc30a",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Die Strömungsretter seilten sich gekonnt ab und retteten die Bootsinsassen.“"
                            },
                            {
                                "example_id": "73dec68a-2c91-4220-af71-570d72c39b54",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Ein Strömungsretter ist ein speziell ausgebildeter Rettungsschwimmer, der auf stark strömende Gewässer, Wildwasser und Hochwasser spezialisiert ist.“"
                            },
                            {
                                "example_id": "2e63add9-e30b-4b7e-9a59-81ec683e9081",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Ein Strömungsretter darf niemals alleine ohne entsprechende Sicherung eingesetzt werden! […] Strömungsretter sind mit spezieller PSA, Neoprenanzug, Helm und Wildwasserweste ausgestattet.“"
                            },
                            {
                                "example_id": "59f1e45e-deb8-40f3-869e-e25280a447b9",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„Die Bandbreite erstreckt sich vom Rettungsschwimmer über die weiter qualifizierten Wasserretter und Katastrophenschutzhelfer, Einsatztaucher, Bootsführer, Strömungsretter, Ausbilder und Prüfer in den jeweiligen Bereichen bis hin zu Führungskräften im Wasserrettungsdienst und im Katastrophenschutz.“"
                            },
                            {
                                "example_id": "3e4f8b64-3103-4365-82f1-e3290d8291ff",
                                "sense_id": "5a06e76b-f4f5-3342-966c-254082ea622b",
                                "text": "„In der vergangenen Woche hatten Suchtrupps mit einem Hubschrauber, Strömungsrettern der Feuerwehr und vielen freiwilligen Helfern tagelang das Ufer, den Fluss und die Region abgesucht, um das Mädchen zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
