                "senses": [
                    {
                        "sense_id": "a77e3945-a442-3e57-b0aa-04846024758f",
                        "entry_id": "ef80b4df-e2bf-3b33-b7d7-53ed999761a9",
                        "glosses": [
                            "sehr hartes Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8a04f7-a729-403d-9cf0-90017163f970",
                                "sense_id": "a77e3945-a442-3e57-b0aa-04846024758f",
                                "text": "„Kerzengerade stand Giacomo vor seinen Männern, hob die Brauen, schwang den Stock aus Eisenholz und nahm den Sohn, als Alf gehen konnte, mit auf die Proben.“"
                            },
                            {
                                "example_id": "06264a63-9a81-4344-99da-86a0a99686a1",
                                "sense_id": "a77e3945-a442-3e57-b0aa-04846024758f",
                                "text": "„International ist dieses spezielle Tropenholz als ‚Red Ironwood‘ bekannt, als ‚rotes Eisenholz‘.“"
                            },
                            {
                                "example_id": "bd24719d-964c-410e-bc5b-421ce42ff8fb",
                                "sense_id": "a77e3945-a442-3e57-b0aa-04846024758f",
                                "text": "„Alles ist nun Wildnis, verschlungen in Laubgrün, Torf-, Rotbraun und Schwarz – und wir mittendrin auf einem Plankenweg aus Eisenholz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
