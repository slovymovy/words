                    {
                        "sense_id": "a7313e82-2204-3a7c-9c31-07b5a4707918",
                        "entry_id": "9cf81231-6da1-3690-858e-4dda055124ea",
                        "glosses": [
                            "Stellplatz, auf dem Taxis für Kunden bereitstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d7b2e2-ffd9-437f-84e5-469c3b98f23f",
                                "sense_id": "a7313e82-2204-3a7c-9c31-07b5a4707918",
                                "text": "„Viele Fluggäste hatten bereits ihr Gepäck vom Laufband gefischt und waren auf dem Weg zum Parkplatz oder zu den Taxiständen.“"
                            },
                            {
                                "example_id": "3ff3aec8-0e20-415a-a1c1-e67f4292ce3a",
                                "sense_id": "a7313e82-2204-3a7c-9c31-07b5a4707918",
                                "text": "„Er ging die Straße entlang zum Taxistand, öffnete die hintere Tür des dort stehenden Taxis und stieg ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
