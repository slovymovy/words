        "fr-extract.jsonl": [
            {
                "entry_id": "ff082f81-905d-3a74-ab61-ec5f20bca4e8",
                "word": "croquis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ae89ed4-a300-309b-bc9a-d16137a8a623",
                        "entry_id": "ff082f81-905d-3a74-ab61-ec5f20bca4e8",
                        "glosses": [
                            "Esquisse rapide d'une peinture, d'une sculpture, d'un monument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be9d015-a0df-4ff1-baca-f0f5b6ca3e25",
                                "sense_id": "1ae89ed4-a300-309b-bc9a-d16137a8a623",
                                "text": "Faire le croquis d’une figure, d’un groupe. — Le croquis d’un dessin. — Cahier de croquis."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9847ab9-b84a-398d-a67f-ab1475bdbdcc",
                        "entry_id": "ff082f81-905d-3a74-ab61-ec5f20bca4e8",
                        "glosses": [
                            "Dessin dont le minimalisme suffit à représenter le concept à transmettre."
                        ],
                        "tags": [
                            "Graphisme"
                        ],
                        "examples": [
                            {
                                "example_id": "1e197a1f-d3a9-49c2-a477-7d9ceb7d8e78",
                                "sense_id": "c9847ab9-b84a-398d-a67f-ab1475bdbdcc",
                                "text": "Une petite croix était marquée à la plume sur chacun des croquis, et certainement ces croix n'avaient pas été mises là pour rien."
                            },
                            {
                                "example_id": "6fc39820-83e2-4a54-9256-c17d0352dcb4",
                                "sense_id": "c9847ab9-b84a-398d-a67f-ab1475bdbdcc",
                                "text": "\"C'est l'illustration de cette culture française de la caricature\", salue Aurel, en précisant que le dessin de presse se déploie aussi avec succès sous la forme du croquis d'audience."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f8cee89-7209-4578-94f5-c37d6931ee6f",
                        "source_entry_id": "ff082f81-905d-3a74-ab61-ec5f20bca4e8",
                        "target_lang_word": "sketch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65be32d8-daff-3219-87fe-8fe88cd34222",
                                        "entry_id": "25506a7f-a86b-3bf7-8f03-2c9bc42cc83d",
                                        "glosses": [
                                            "To make a brief, basic drawing."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155fc2a0-9c82-4de9-b815-ec526b09d76e",
                                                "sense_id": "65be32d8-daff-3219-87fe-8fe88cd34222",
                                                "text": "I usually sketch with a pen rather than a pencil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85f45a84-1964-3f9a-bb98-27a89be74cc5",
                                        "entry_id": "25506a7f-a86b-3bf7-8f03-2c9bc42cc83d",
                                        "glosses": [
                                            "To describe briefly and with very few details."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e7bb652-b4f7-4556-9f63-ad27af4775f8",
                                                "sense_id": "85f45a84-1964-3f9a-bb98-27a89be74cc5",
                                                "text": "He sketched the accident, sticking to the facts as they had happened."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "091ed9a5-bea9-38b5-bc49-34121242f8f1",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A rapidly executed freehand drawing that is not intended as a finished work, often consisting of a multitude of overlapping lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e043df78-cae5-4a0d-b7fd-0da89a35d6a7",
                                                "sense_id": "091ed9a5-bea9-38b5-bc49-34121242f8f1",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "63a05a0e-ff52-4b69-a0aa-bfff9acec3c9",
                                                "sense_id": "091ed9a5-bea9-38b5-bc49-34121242f8f1",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8675266-8a1b-326a-a691-f5b35eed868a",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A rough design, plan, or draft, as a rough draft of a book."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b9ad7e5-7d0b-30f8-9213-9b0f2b2e62d5",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A brief description of a person or account of an incident; a general presentation or outline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c634cd-5b6d-4ff6-bfb6-d23e450815b6",
                                                "sense_id": "0b9ad7e5-7d0b-30f8-9213-9b0f2b2e62d5",
                                                "text": "I have to write a character sketch for a novel study."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "486d8a0f-2443-3ff6-8090-8298c34a8bb3",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A brief, light, or unfinished dramatic, musical, or literary work or idea; especially a short, often humorous or satirical scene or play, frequently as part of a revue or variety show.",
                                            "A brief musical composition or theme, especially for the piano."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a743918-0faa-300f-9fb2-3c7e3cbf8f13",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A brief, light, or unfinished dramatic, musical, or literary work or idea; especially a short, often humorous or satirical scene or play, frequently as part of a revue or variety show.",
                                            "A brief, light, or informal literary composition, such as an essay or short story."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "450c66d2-6867-3b20-bc1c-7541812f63a4",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "An amusing person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61bed39d-ad81-393c-9c37-28555aabc96b",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A lookout; vigilant watch for something."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1a5a296-18f1-4526-b610-fd107ac88d99",
                                                "sense_id": "61bed39d-ad81-393c-9c37-28555aabc96b",
                                                "text": "to keep sketch"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a02fb0-33a0-3be5-917f-40d3becdde4d",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A humorous newspaper article summarizing political events, making heavy use of metaphor, paraphrase and caricature."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2eca09-676b-403b-ab1e-7068156c09e4",
                                                "sense_id": "78a02fb0-33a0-3be5-917f-40d3becdde4d",
                                                "text": "A very capable journalist, he wrote the Parliamentary sketch for the Pall Mall and the Westminster Gazette for several years."
                                            },
                                            {
                                                "example_id": "c8523e50-7807-4f6e-aa6a-d93cf16d5467",
                                                "sense_id": "78a02fb0-33a0-3be5-917f-40d3becdde4d",
                                                "text": "The Daily Telegraph sketch concentrated on the Bishop's attack and included rebutting remarks from Lord Longford, describing the attack as monumentally unfair because Mr. Cook could not reply."
                                            },
                                            {
                                                "example_id": "c1731e47-2e95-457f-98d1-4d57eb43492f",
                                                "sense_id": "78a02fb0-33a0-3be5-917f-40d3becdde4d",
                                                "text": "Frank had won a reputation while writing the Times sketch as one of the wittiest writers and talkers in England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b0ce94-72d4-3081-8ceb-a3e6456b0970",
                                        "entry_id": "74a9e244-24e9-3520-9104-6698c7b25298",
                                        "glosses": [
                                            "A formal specification of a mathematical structure or a data type described in terms of a graph and diagrams (and cones (and cocones)) on it. It can be implemented by means of “models”, which are functors which are graph homomorphisms from the formal specification to categories such that the diagrams become commutative, the cones become limiting (i.e., products), the cocones become colimiting (i.e., sums)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "340a837d-b55d-33c2-ab15-e6756990c24e",
                                        "entry_id": "4192ee48-237e-3aab-ae1c-93c5ac1abf9e",
                                        "glosses": [
                                            "Sketchy, shady, questionable."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11ccfda-3b22-4e27-8f1a-d3fa536ae200",
                                                "sense_id": "340a837d-b55d-33c2-ab15-e6756990c24e",
                                                "text": "You call at 9 am on a Saturday, lucky I'm even awake. [...] Then expect me to pick you up at a gas station near a loony bin, that's sketch. I don't even want to ask what you're doing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
