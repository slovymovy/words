    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81c06d6d-9d45-3304-9559-0ed8afdc88f6",
                    "sense_definition": "Zichzelf niet onder controle houdend, gedreven door hevige emoties of impulsen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de nederlaag reageerde hij met een <w>onbeheerste</w> woede-uitbarsting.",
                            "target_lang_translations": {
                                "en": "After the defeat, he reacted with an <w>uncontrolled</w> outburst of rage."
                            }
                        },
                        {
                            "text": "Het was een <w>onbeheerste</w> reactie die hij later heel erg zou betreuren.",
                            "target_lang_translations": {
                                "en": "It was an <w>uncontrolled</w> reaction that he would deeply regret later."
                            }
                        }
                    ],
                    "synonyms": [
                        "driftig",
                        "wild",
                        "bandeloos",
                        "teugelloos",
                        "ongecontroleerd"
                    ],
                    "antonyms": [
                        "beheerst",
                        "gecontroleerd",
                        "rustig"
                    ],
                    "common_phrases": [
                        "een onbeheerste reactie",
                        "onbeheerste emoties"
                    ],
                    "target_lang_definitions": {
                        "en": "Not keeping oneself under control, driven by intense emotions or impulses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncontrolled",
                                "target_lang_sense_clarification": "lacking self-control or restraint"
                            },
                            {
                                "target_lang_word": "unrestrained",
                                "target_lang_sense_clarification": "not limited or kept under control"
                            },
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "passionate and out of control"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79cebda3-e012-3529-aa7e-bc77bf8a3a7a",
                    "sense_definition": "Zonder beperking of terughoudendheid; niet beteugeld of gereguleerd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>onbeheerste</w> woord schiet zijn doel voorbij.",
                            "target_lang_translations": {
                                "en": "The <w>unbridled</w> word misses its mark."
                            }
                        },
                        {
                            "text": "In deze <w>onbeheerste</w> groei van de stad schuilt een heel groot risico.",
                            "target_lang_translations": {
                                "en": "There is a very big risk in this <w>unchecked</w> growth of the city."
                            }
                        }
                    ],
                    "synonyms": [
