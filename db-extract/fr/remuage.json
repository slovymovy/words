                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c254c8-66c5-435c-88d5-dd82b44ecd59",
                                "sense_id": "0d137605-1574-3fa2-a219-104f12050eeb",
                                "text": "Le remuage de céréales stockées pour éviter qu'elles ne s'échauffent"
                            },
                            {
                                "example_id": "aea480d9-3eb2-4786-bd9a-2341dbd8eb60",
                                "sense_id": "0d137605-1574-3fa2-a219-104f12050eeb",
                                "text": "Le congé de remuage. (droit sur le vin que l'on transporte d'un endroit à un autre)"
                            }
                        ]
                    },
                    {
                        "sense_id": "56ec5dd1-7f6f-3a26-8808-a1ddf77079fa",
                        "entry_id": "442a834f-e2b4-3589-b3c4-662e71009aa0",
                        "glosses": [
                            "Opération de rotation et d'inclinaison régulière des bouteilles dans le processus d'élaboration des vins en méthode champenoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d598365-0d37-4f98-9650-714f0fc02c97",
                                "sense_id": "56ec5dd1-7f6f-3a26-8808-a1ddf77079fa",
                                "text": "Le dosage est ajusté pour obtenir un cidre sec suite au remuage et au dégorgement."
                            },
                            {
                                "example_id": "61d7f12c-9a63-4c4a-bc96-15094d6a944b",
                                "sense_id": "56ec5dd1-7f6f-3a26-8808-a1ddf77079fa",
                                "text": "Aujourd’hui, on peut considérer que plus de 90 % du remuage en Champagne est réalisé sur de tels appareils, le remuage manuel n’étant conservé que par quelques opérateurs soucieux de préserver l’image de tradition du champagne."
                            }
                        ]
