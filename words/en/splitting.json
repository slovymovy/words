        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60bf6f84-2959-3d0c-b4d0-5153006a3055",
                    "sense_definition": "Severely painful; usually describing a headache.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have such a <w>splitting</w> headache that I need to lie down in a dark room.",
                            "target_lang_translations": {
                                "ru": "У меня так <w>раскалывается</w> голова, что мне нужно прилечь в темной комнате.",
                                "pl": "Mam tak <w>rozsadzający</w> ból głowy, że muszę się położyć w ciemnym pokoju."
                            }
                        },
                        {
                            "text": "The loud music gave him a <w>splitting</w> headache by the end of the night.",
                            "target_lang_translations": {
                                "ru": "К концу вечера от громкой музыки у него началась <w>адская</w> головная боль.",
                                "pl": "Pod koniec wieczoru od głośnej muzyki dostał <w>pękającego</w> bólu głowy."
                            }
