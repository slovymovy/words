                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c35d38-3c9f-4e86-b6a6-d3acd6217f57",
                                "sense_id": "c42825eb-5748-3bd7-9455-378e12a9378e",
                                "text": "Ik sta daar op een rots midden in snelstromend water, en terecht of niet, ik voelde me op die leeftijd ook echt door alle wateren gewassen."
                            },
                            {
                                "example_id": "cd65ee81-7d8e-439b-861f-e1dc9cd5e438",
                                "sense_id": "c42825eb-5748-3bd7-9455-378e12a9378e",
                                "text": "In Noorwegen wordt met man en macht gezocht naar een Nederlandse jongen. Hij viel donderdagmiddag in een snelstromend riviertje in het zuidwesten van het land en is sindsdien spoorloos. Reddingswerkers vonden alleen zijn trui en vrezen het ergste, meldden Noorse media vrijdagochtend."
                            }
                        ]
                    }
