                        "cross_references": [
                            {
                                "target_word": "simpelheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "affac60a-ed77-30d9-9f11-f8bd41c2dd40",
                                        "entry_id": "9f9d94f7-ca2f-327c-a9a4-b8e5b9e1354c",
                                        "glosses": [
                                            "de mate waarin iets makkelijk en eenvoudig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af70974-1a8a-4aa8-8be6-df2b38a72593",
                                                "sense_id": "affac60a-ed77-30d9-9f11-f8bd41c2dd40",
                                                "text": "Maar intussen hoeft men slechts af te zien van de studie van rapporten en generale plannen en zich te verdiepen in de beweging van die honderdduizend mensen die rechtstreeks en direct deelnamen aan de gebeurtenissen, en alle vragen die eerder onoplosbaar leken krijgen plotseling met ongewone lichtheid en simpelheid een alle twijfel uitsluitende oplossing."
                                            },
                                            {
                                                "example_id": "d6dacf31-392e-4ea3-8971-3bacf64b6175",
                                                "sense_id": "affac60a-ed77-30d9-9f11-f8bd41c2dd40",
                                                "text": "En er is meer dat verklaart waarom mensen zoveel van Apple houden. \"Mensen hebben heel veel behoefte aan simpelheid, overzichtelijkheid en Apple belooft dat. Complexiteit is tegenwoordig één van onze belangrijkste onzekerheden.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5ed471-d79f-3b2c-8927-d9535583d9aa",
                                        "entry_id": "9f9d94f7-ca2f-327c-a9a4-b8e5b9e1354c",
                                        "glosses": [
                                            "geestelijk onvermogen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ecb137c-c908-4d34-97fb-cff7e3393f35",
                        "source_entry_id": "ef7d5692-cdd7-3ac2-ae7c-fdcf3a10ae1b",
