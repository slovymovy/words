                "translations": [
                    {
                        "translation_id": "1b2386d5-bd82-47e5-a422-20a3a75ed2c0",
                        "source_entry_id": "13ebd71d-6d9c-3f41-9f14-fa656ff632a1",
                        "source_sense_id": "0d278c2b-c29a-396f-aa24-11061edb1a48",
                        "target_lang_word": "ahead of time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ahead of time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65e3770-59c4-3815-980d-4df582ec936d",
                                        "entry_id": "b4a0751a-25dd-38c9-ab29-3f9e08347b0d",
                                        "glosses": [
                                            "Prior to an expected time; early."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6761b08c-dbc3-46ec-ba44-56869eb6bc6a",
                                                "sense_id": "c65e3770-59c4-3815-980d-4df582ec936d",
                                                "text": "He navigated the course adeptly, having trained on it for months ahead of time."
                                            },
                                            {
                                                "example_id": "a3f9c845-31d0-465b-a835-f966cb59d1da",
                                                "sense_id": "c65e3770-59c4-3815-980d-4df582ec936d",
                                                "text": "In the future, if you know that you're going to be mixing inviteds and uninviteds while out, call them all ahead of time to caution the inviteds against talking about the wedding and to tell the uninviteds about your guest list so they know you didn't forget about them […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cac60cb-a794-4c0a-8945-674d60a5dbd0",
                        "source_entry_id": "13ebd71d-6d9c-3f41-9f14-fa656ff632a1",
                        "source_sense_id": "0d278c2b-c29a-396f-aa24-11061edb1a48",
                        "target_lang_word": "anteriorly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anteriorly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08fbd545-eb08-3aff-b764-5a04c12e99bc",
                                        "entry_id": "b6afce32-b36f-32ba-8121-3c09baacb264",
                                        "glosses": [
                                            "before (in time)"
                                        ],
