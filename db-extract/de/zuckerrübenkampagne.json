                    {
                        "sense_id": "d53fc03b-a0f4-35a5-8b15-e3fd5a06380b",
                        "entry_id": "d1a7e4a8-ef11-3b25-9652-549bfcbf4347",
                        "glosses": [
                            "Zeitraum, in dem Zuckerrüben geerntet und in den Zuckerfabriken verarbeitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0f4423-261d-4284-a039-e8cdb2ccaa88",
                                "sense_id": "d53fc03b-a0f4-35a5-8b15-e3fd5a06380b",
                                "text": "„Der börsenotierte Zucker-, Stärke- und Fruchtkonzern Agrana hat die Zuckerproduktion um 7,5 Prozent auf rund 803.000 Tonnen gesteigert, teilte das Unternehmen heute, Donnerstag, zum Abschluss der Zuckerrübenkampagne 2010/11 mit.“"
                            },
                            {
                                "example_id": "15c1b02f-3bcd-4851-9ccd-2676576b89d1",
                                "sense_id": "d53fc03b-a0f4-35a5-8b15-e3fd5a06380b",
                                "text": "„Vor dem Start der diesjährigen Zuckerrübenkampagne rechnet die Anklamer Zuckerfabrik mit einem leicht überdurchschnittlichen Zuckerertrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
