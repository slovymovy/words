                "senses": [
                    {
                        "sense_id": "3928d51c-aef5-3dea-8723-ef720728dcb9",
                        "entry_id": "5ed9dc4e-0efb-3937-9f1f-631ba3bb08de",
                        "glosses": [
                            "anderer Ausdruck für Bedeutungsbeziehung: Verhältnis der Bedeutungen verschiedener sprachlicher Ausdrücke (Wörter, Syntagmen) zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf226c28-9768-403f-9566-8a7d9206c817",
                                "sense_id": "3928d51c-aef5-3dea-8723-ef720728dcb9",
                                "text": "Die Bedeutungsrelation zwischen den Wörtern „groß“ und „klein“ ist die Antonymie."
                            },
                            {
                                "example_id": "cf95d060-5890-4fd6-985c-c521d5e23f37",
                                "sense_id": "3928d51c-aef5-3dea-8723-ef720728dcb9",
                                "text": "Der Satz „Mein Teppich frisst Mäuse“ ist grammatisch korrekt, semantisch aber wegen der unverträglichen Bedeutungsrelationen zwischen den Satzgliedern misslungen."
                            },
                            {
                                "example_id": "3795d8f7-d9af-4c22-b675-34fcbd778fd0",
                                "sense_id": "3928d51c-aef5-3dea-8723-ef720728dcb9",
                                "text": "„Konventionell ist dabei nicht die Relation der Denotation, die für das Sprachzeichen sowieso nicht konstitutiv ist, sondern die Bedeutungsrelation.“"
                            },
                            {
                                "example_id": "be7d7f55-9ed8-46b2-8e7a-2cec5d3617a8",
                                "sense_id": "3928d51c-aef5-3dea-8723-ef720728dcb9",
                                "text": "„Damit wendet er das Modell der Bedeutungsrelationen auf die Lesarten eines als polysem bestimmten Lemmazeichens an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
