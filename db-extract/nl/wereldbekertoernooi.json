                        "examples": [
                            {
                                "example_id": "2267bec1-0bd4-4c3b-a3d1-6493b766df6a",
                                "sense_id": "21f1bd4e-e509-39a8-9770-6eb625c2b556",
                                "text": "Anish Giri heeft bij het wereldbekertoernooi in Bakoe de kwartfinales bereikt. In de achtste finales rekende de 21-jarige grootmeester na een barrage af met de Pool Radoslaw Wojtaszek."
                            },
                            {
                                "example_id": "166b17bd-ea24-4ebf-8505-e802b86c6f10",
                                "sense_id": "21f1bd4e-e509-39a8-9770-6eb625c2b556",
                                "text": "Driebander Torbjörn Blomdahl heeft in Korinthe in Griekenland voor de 42ste keer in zijn carrière een wereldbekertoernooi gewonnen. In de finale was de Zweed in 15 beurten met 40-19 te sterk voor de Spanjaard Ruben Legazpi, die zijn eerste finale speelde."
                            }
                        ]
