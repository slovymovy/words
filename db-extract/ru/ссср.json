                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a99e233e-a7df-4f93-a08c-dc5f07fbeeea",
                                "sense_id": "ff4fd1dd-6df9-34b6-b671-eb5af90df530",
                                "text": "Чем моло́же бло́гер, тем ху́же ему́ жи́лось в СССР.",
                                "translation": "The younger the blogger, the worse his life was in the USSR.",
                                "english": "The younger the blogger, the worse his life was in the USSR."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
