                "senses": [
                    {
                        "sense_id": "7a471a72-8f1d-34e7-aba1-b53add30158e",
                        "entry_id": "bcba4b2f-3e58-3020-9abb-9d51570d2d37",
                        "glosses": [
                            "физ. молекулярное сцепление между находящимися в контакте поверхностями двух однородных по составу тел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a50af7ea-fa1d-4036-a7e7-8f30bdc10e18",
                                "sense_id": "7a471a72-8f1d-34e7-aba1-b53add30158e",
                                "text": "На использовании когезии основана горячая и холодная сварка металлов."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f000a52-ce1c-33e4-abe0-080263d45477",
