                                    },
                                    {
                                        "sense_id": "1e54be26-2567-35df-b703-671634244a9a",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "The state of being mad, insanity",
                                            "Insanity implying legal irresponsibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "Something deeply misguided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d19b8b-9523-4d1c-9059-14b0a3840af4",
                                                "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                                "text": "Two days have passed since that day of lunacy. What a noise and a fuss and a chattering and an uproar there was! And what a welter of unseemliness and disorder and stupidity and bad manners! And I the cause of it all! Yet part of the scene was also ridiculous—at all events to myself it was so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "767f34e4-398f-4a05-abf4-03fba53bf5c4",
                        "source_entry_id": "62cb56ca-d20c-337d-8e8e-243901f5f4bc",
                        "source_sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                        "source_sense_description": "tijdelijk ontbreken van normale verstandelijke vermogens door hevige emotie",
                        "target_lang_word": "mental derangement",
