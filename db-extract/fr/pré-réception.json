                        "entry_id": "59720c32-c73b-3705-a6dc-27fc950f1557",
                        "glosses": [
                            "Procédure par laquelle on accepte provisoirement un résultat comme conforme à la commande passée, avant la réception définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067bbdfa-093f-418d-9e37-81e40753d977",
                                "sense_id": "62855512-5cee-37e7-bb18-5062c2ad8faf",
                                "text": "La pré-réception acte le fait que le fournisseur a livré tandis que la véritable réception rend disponible les produits en magasin pour leur utilisation."
                            },
                            {
                                "example_id": "c3e4a73e-804b-45bd-b587-bab3b2a563f1",
                                "sense_id": "62855512-5cee-37e7-bb18-5062c2ad8faf",
                                "text": "La constatation de l’exécution de ces prestations doit donner lieu à un procès-verbal dressé dans les mêmes conditions que le procès-verbal de visite pré-réception."
                            },
                            {
                                "example_id": "a7f028b5-34bc-4a9f-a61a-123ea5cf5503",
                                "sense_id": "62855512-5cee-37e7-bb18-5062c2ad8faf",
                                "text": "Celui-ci est assisté de l’architecte qui a auparavant procédé à des pré-réceptions afin de s’assurer de la conformité et de la qualité des ouvrages proposés à la réception."
                            }
                        ]
                    }
