                {
                    "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                    "sense_definition": "With careful attention, strong connection, or very little space between things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to listen <w>closely</w> to understand the instructions.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно слушать <w>внимательно</w>, чтобы понять инструкции.",
                                "zh": "你需要<w>仔细</w>听才能理解说明。"
                            }
                        },
                        {
                            "text": "The two languages are <w>closely</w> related and share many words.",
                            "target_lang_translations": {
                                "ru": "Эти два языка <w>тесно</w> связаны и имеют много общих слов.",
                                "zh": "这两种语言<w>紧密</w>相关，并且有很多共同的词汇。"
                            }
                        },
                        {
                            "text": "Security guards monitored the entrance <w>closely</w>.",
                            "target_lang_translations": {
                                "ru": "Охранники <w>пристально</w> следили за входом.",
                                "zh": "保安人员<w>密切</w>监视着入口。"
                            }
                        }
