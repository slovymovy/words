                        "source_sense_id": "3460ec08-2cc7-3699-9b97-cac5d484ceeb",
                        "source_sense_description": "disapproval",
                        "target_lang_word": "afkeuring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afkeuring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                        "entry_id": "b8859241-fb84-3cb7-b244-594dcd881127",
                                        "glosses": [
                                            "het uitspreken van een negatief oordeel over iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ab6799-1218-450e-ba0a-3c5b88c703d4",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De zieke man was helemaal niet blij met de afkeuring voor zijn werk dat hij altijd met plezier had gedaan."
                                            },
                                            {
                                                "example_id": "a5236d96-a9b1-4778-bd2c-09907f70afde",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De afkeuring van de oude volledig doorgeroeste auto kwam niet als een verrassing."
                                            },
                                            {
                                                "example_id": "e5ce8964-faf6-4865-9fb6-81ec4293389a",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "'Het is een lang verhaal,' zei hij in reactie op de afkeuring die hij in mijn woorden had bespeurd."
                                            },
                                            {
                                                "example_id": "e22a81ef-a961-43d9-a255-30f71f4d16e6",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "Naast het feit dat er zeker een kern van waarheid in hun reactie zat, verbaasde ik me vooral over de felle toon van hun afkeuring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d1ba1fb-c6b0-4686-a61f-6a3c0e854a04",
                        "source_entry_id": "1a8c25f6-a73a-38e2-a0d1-822dff5e1cfd",
                        "source_sense_id": "3460ec08-2cc7-3699-9b97-cac5d484ceeb",
                        "source_sense_description": "disapproval",
                        "target_lang_word": "désapprobation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désapprobation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                        "entry_id": "50433f51-53ef-3dc6-acbe-1bb30a2a980b",
                                        "glosses": [
                                            "Action de désapprouver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1f00bd-ae33-45d9-ba7c-02a7cd511348",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "Ah ! messieurs, vous prenez vite pied chez nous ! Vous êtes de mauvaise humeur parce que je n’ai pas été assez sot pour signer, comme Louis XIV, la désapprobation des libertés gallicanes !"
                                            },
                                            {
                                                "example_id": "2dbc673d-e2ae-490a-8743-8442c5d631b0",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "– Bien, fit-elle, alors, vous allez comprendre à merveille. Mais que je ne voie pas dans vos regards la moindre nuance de désapprobation. Je m’arrêterais à l’instant même."
                                            },
                                            {
                                                "example_id": "ade96099-4964-4992-8cdf-792e8cc8992a",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "Au troisième stade, la tension pouvait aller jusqu’à la désapprobation verbale ou, partiellement verbalisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
