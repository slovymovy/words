        "fr-extract.jsonl": [
            {
                "entry_id": "184a29c1-0bb8-369d-aa15-a91e77e8ee52",
                "word": "stupre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "882c29f4-32ee-4742-bee1-09f6722864c4",
                        "entry_id": "184a29c1-0bb8-369d-aa15-a91e77e8ee52",
                        "tags": [
                            "plural"
                        ],
                        "form": "stupres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2eb81cf-f9fc-356e-b57f-f4d80b45b5a9",
                        "entry_id": "184a29c1-0bb8-369d-aa15-a91e77e8ee52",
                        "glosses": [
                            "Débauche avilissante, honteuse, érotisme débridé, lubricité."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "02e1700d-156f-4633-ba94-e1c74a748ba4",
                                "sense_id": "f2eb81cf-f9fc-356e-b57f-f4d80b45b5a9",
                                "text": "À l’orgie latine succédèrent les ébats des Barbares, dignes héritiers de ces Romains gorgés de falerne et de sang, épuisés de stupre, sombrés dans les velléités."
                            },
                            {
                                "example_id": "b4d09544-f8d2-42d6-a1e7-b979a6a2f85f",
                                "sense_id": "f2eb81cf-f9fc-356e-b57f-f4d80b45b5a9",
                                "text": "27 novembre 44 – Le vice ne se supporte qu’avec beaucoup de talent. Le petit stupre honteux, c’est minable."
                            },
                            {
                                "example_id": "74961390-fcea-40d1-94d4-7171bbf5acc5",
                                "sense_id": "f2eb81cf-f9fc-356e-b57f-f4d80b45b5a9",
                                "text": "Manquant à la pudeur la plus élémentaire,\nDois-je, pour les besoins d' la caus' publicitaire,\nDivulguer avec qui, et dans quell' position\nJe plonge dans le stupre et la fornication ?"
                            },
                            {
                                "example_id": "7a6cfe91-c52d-4f90-ba9c-2a33f48fa000",
                                "sense_id": "f2eb81cf-f9fc-356e-b57f-f4d80b45b5a9",
                                "text": "Fallait-il que je pique ce qu’il avait sur lui et que j’avais vu, quasi une demi-patate, trois semaines de stupre avec Karine, heureuse, jouasse, amoureuse de son homme. Ça ne pouvait pas se dédaigner."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ba43f5d-aa1b-394d-a1d7-514021e1b139",
                        "entry_id": "184a29c1-0bb8-369d-aa15-a91e77e8ee52",
                        "glosses": [
                            "Souillure, outrage aux mœurs, viol."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "967cfe08-aa30-46a2-b7ee-b131f3f99db2",
                                "sense_id": "7ba43f5d-aa1b-394d-a1d7-514021e1b139",
                                "text": "Gilles s’installait aux fenêtres du château et […] faisait monter ceux dont la physionomie l’incitait au stupre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e101fdbf-6a5f-49a0-8383-c69cca0461f5",
                        "source_entry_id": "184a29c1-0bb8-369d-aa15-a91e77e8ee52",
                        "source_sense_description": "Débauche avilissante",
                        "target_lang_word": "Schändung",
                        "target_lang_code": "de",
