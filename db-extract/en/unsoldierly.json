                        "entry_id": "5a3f7053-724b-30d9-8cb2-1c25e714a878",
                        "glosses": [
                            "In a manner that is not appropriate for a soldier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "854ac65e-f867-4ad7-9d70-0a0f35556f28",
                                "sense_id": "4f63d060-5eb2-3704-9713-8958d901c6dc",
                                "text": "A few of them limped unsoldierly in deference to blistered feet."
                            },
                            {
                                "example_id": "74de06d7-c4fe-4652-ae89-807ac60487f0",
                                "sense_id": "4f63d060-5eb2-3704-9713-8958d901c6dc",
                                "text": "[…] you, soldiers, that shift unsoldierly\nThe weapons that should be upright, at attention, like stiff grass-blades:"
                            }
                        ]
                    }
