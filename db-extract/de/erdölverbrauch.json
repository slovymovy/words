                ],
                "senses": [
                    {
                        "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                        "entry_id": "e4860731-bcf4-3c11-834d-b3dd86e70c4c",
                        "glosses": [
                            "die genutzte Menge an Erdöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2e27b3-399e-4f26-8761-ecee85b79b52",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„In den vergangenen 50 Jahren hat sich der weltweite Erdölverbrauch fast verdreifacht.“"
                            },
                            {
                                "example_id": "0435e999-9f2a-475d-996d-681d04fdec8d",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Erdöl ist der einzige Energierohstoff bei dem sich eine Limitierung abzeichnet: Zwar kann in den nächsten Jahren auch hier aus geologischer Sicht ein moderater Anstieg des Erdölverbrauchs gedeckt werden, für die kommenden Jahrzehnte gilt dies jedoch laut BGR wahrscheinlich nicht.“"
                            },
                            {
                                "example_id": "888ff2b8-0fda-4b85-b1c1-b230a3dab570",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Lange werden wir den hohen Erdölverbrauch jedoch nicht mehr aufrechterhalten können, denn die Reserven neigen sich dem Ende zu.“"
                            },
                            {
                                "example_id": "c560164f-3b3f-4012-8c0a-b3891a9dca77",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Laut IEA geht derzeit rund die Hälfte des weltweiten Erdölverbrauchs auf Fahrzeuge zurück.“"
                            },
                            {
                                "example_id": "d9b56517-e0fe-4b84-9683-23821ec08438",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Wegen des Coronavirus und seinen wirtschaftlichen Auswirkungen stagniert der weltweite Erdölverbrauch. Es wird weniger gereist, die Nachfrage nach Benzin, Diesel und Kerosin sinkt drastisch.“"
                            },
                            {
                                "example_id": "35d0a00a-9c87-4f06-9a32-cb4bc89b5823",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„2017 ging der Verbrauch von Benzin und Diesel in der Schweiz um rund 0,4 Prozent zurück, in den letzten 10 Jahren gar um rund 8.5 Prozent. Nimmt man das Heizöl dazu, schrumpfte der Schweizer Erdölverbrauch seit 2008 um über 17 Prozent.“"
                            },
                            {
                                "example_id": "2d44f241-9ca6-462f-aa6d-b56bef0a8461",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Offizielle Daten, wie viel Erdöl Kuba täglich aus Venezuela bezieht, gibt es nicht. Zu Hochzeiten sollen es 115.000 Barrel gewesen sein, was rund 80 Prozent des gesamten Erdölverbrauchs auf der Karibikinsel ausmachte.“"
                            },
                            {
                                "example_id": "b798122b-deee-41eb-ad31-975ca0584893",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„Wirtschaftswachstum und Massenmotorisierung steigern Chinas Nachfrage nach Erdöl: Von 225 Millionen Tonnen im Jahr 2000 stieg der Erdölverbrauch des Landes im Jahr 2010 auf 425 Millionen Tonnen.“"
                            },
                            {
                                "example_id": "19ef347e-5dd1-446a-85f5-46d9941f96fb",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "[Petrochemische Industrie:] „Nach Einschätzung der Internationalen Energieagentur wird der Erdölverbrauch in diesem Industriezweig weiter steigen; seit dem Jahr 2000 hat sich der Verbrauch bereits verdoppelt. Ein weiterer Anstieg wird für den Verbrauch im Verkehr erwartet – der Öldurst der Welt wächst.“"
                            },
                            {
                                "example_id": "b8f38d87-e822-4488-a706-94dc81196fc0",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "„»Kunststoffverpackungen machten 2010 nur 1,5 Prozent des deutschen Erdölverbrauchs aus«, so Fritze.“"
                            },
                            {
                                "example_id": "80d13e70-8e21-4b81-9fe4-64688facdb54",
                                "sense_id": "861120fa-4206-38eb-8dc4-ce530a403dfd",
                                "text": "[Ölpreisexplosion 2008:] „Auch der Erdölverbrauch in Ostasien kann die Preisexplosion nicht erklären. So nahmen die Netto-Importe Chinas seit 2005 pro Jahr nur im Ausmaß von 0,3 Prozent des Weltverbrauchs zu, da China seinen Bedarf zur Hälfte aus eigener Produktion deckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
