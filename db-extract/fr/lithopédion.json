                    {
                        "sense_id": "4a7607e7-e284-3803-a127-e5bf236ca7d4",
                        "entry_id": "6c9a2cd9-0fdc-3ce7-9532-2ebdcd0e2194",
                        "glosses": [
                            "Fœtus issu d'une grossesse extra-utérine, non arrivé à terme, non expulsé et calcifié qui peut être toléré par l'organisme et persister jusqu'à un demi-siècle sans être diagnostiqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37520a1-e432-4b5f-8e2a-4ef2cd41aff0",
                                "sense_id": "4a7607e7-e284-3803-a127-e5bf236ca7d4",
                                "text": "Les cas de lithopédion sont très rares et surviennent dans un milieu socioculturel défavorisé non suivi médicalement."
                            },
                            {
                                "example_id": "d8ecce05-bbbb-47a7-8624-a7044c47c74e",
                                "sense_id": "4a7607e7-e284-3803-a127-e5bf236ca7d4",
                                "text": "Dans le cas d'un fœtus momifié ou d'un lithopédion, une nouvelle grossesse expose à la suppuration, à la gangrène du sac, à des infections septiques et putrides générales."
                            }
                        ]
                    }
                ],
