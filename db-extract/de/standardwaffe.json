                "senses": [
                    {
                        "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                        "entry_id": "8f1445d9-9931-30a1-9814-c66a51c2f88e",
                        "glosses": [
                            "Waffe, die als übliche/reguläre Waffe für eine Organisation (beispielsweise die Streitkräfte, Polizei) angeschafft wird"
                        ],
                        "tags": [
                            "Polizei"
                        ],
                        "examples": [
                            {
                                "example_id": "62bb57dd-ae2b-41b4-90dd-e1bddcd69b3f",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "[Drohnen:] „Was einst das Privileg von Supermächten war, wird nun zur Standardwaffe.“"
                            },
                            {
                                "example_id": "939e9cd2-3bb2-47aa-aa04-ed739b4ffd44",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "[Amokläufe in den USA:] „Das Sturmgewehr AR-15 ist die Standardwaffe der Amerikaner. Und ein Symbol für großes Leid“"
                            },
                            {
                                "example_id": "7495536a-1a7e-4c32-a621-3f445a365396",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Anders als die Kalaschnikow, die als Standardwaffe unter anderem von Terroristen, Islamisten, Kindersoldaten und dubiosen Milizen weltweit viele Millionen Tote gefordert hat, ist die Uzi vorrangig bei Polizei und Militär verbreitet.“"
                            },
                            {
                                "example_id": "143079e1-a97f-42d3-a50d-dcb9f84add68",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "[Confederate States Army:] „Die Standardwaffe der Infanterie war die Pattern 1853 Enfield Rifled Musket Kaliber 577, von der aus Großbritannien 800.000 Stück importiert wurden.“"
                            },
                            {
                                "example_id": "f0a559ee-d2f6-4a8d-adbf-8d855604941c",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Das Maschinengewehr MG 08/15 war während dem ersten Weltkrieg die Standardwaffe der Armee des Deutschen Kaiserreiches.“ [Anmerkung: grammatisch korrekt ist „während des ersten Weltkriegs“, auf „während“ folgt der Genitiv]"
                            },
                            {
                                "example_id": "e87290d6-8138-42bf-9090-7b173d25bf71",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Die Bundeswehr nutzt das von Heckler & Koch hergestellte G36 seit knapp 20 Jahren als Standardwaffe und hat seit den 90er Jahren 180.000 Stück davon gekauft.“"
                            },
                            {
                                "example_id": "c52f2ba6-8fa5-47b8-abd9-d4c2cea6a55b",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Nach Angaben des deutschen Militärs verwenden auch die Streitkräfte Spaniens, Lettlands und Litauens das Gewehr als Standardwaffe.“"
                            },
                            {
                                "example_id": "9880191e-ad7a-4c0f-8f08-0ea77095d2e4",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Erst die Drohne \"Euro Hawk\", jetzt das Sturmgewehr G36: Ermittlungen gegen einen seiner Beamten wegen der Beschaffung der Standardwaffe der Bundeswehr bringen [Bundesminister der Verteidigung] Thomas de Maizière neuen Ärger.“"
                            },
                            {
                                "example_id": "c169760a-b163-4793-8b55-714c640de99b",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„\"Bumm\". Der Knall der Glock-Pistole ist trotz Gehörschutz sehr laut, sie ist Standardwaffe von Bundesheer und Polizei in Österreich, weil das Gehäuse aus Plastik und die Waffe daher leicht ist.“"
                            },
                            {
                                "example_id": "5110f967-a7ee-4bc8-aada-7676fd78101a",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "„Die vollautomatische Glock 18 der österreichischen Firma Glock ist eine Weiterentwicklung der Glock 17, einer Standardwaffe des FBI und anderer Polizeibehörden.“"
                            },
                            {
                                "example_id": "2021d904-9b69-4899-a27b-0b29ce9e4d04",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "[Schlagzeile:] „Polizeigewerkschaft wünscht sich Taser als Standardwaffe“"
                            },
                            {
                                "example_id": "1084fc0e-1d01-4f34-af75-dd4827dfee87",
                                "sense_id": "62ff3678-4fa4-3af1-94f1-ef6d5ed05f5f",
                                "text": "Mit [dem internationale KK-Gewehr „Freie Waffe“ (Kaliber 5,6 mm, Gewicht höchstens 8 kg)] werden auf eine Entfernung der Scheibe von jeweils 50 m der 120-Schuss-Dreistellungskampf (je 40 Schuss liegend, stehend, kniend freihändig) und der KK-Liegendkampf (60 Schuss) durchgeführt, mit der Standardwaffe [, dem nationale KK-Standard-Gewehr (Kaliber 5,6 mm, Gewicht 5,5 kg, genormte Bauart),] der 60-Schuss-Dreistellungskampf (je 20 Schuss in den drei Anschlagsarten)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
