                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "611aa055-bc7b-436b-868e-d716bf6f6150",
                                "sense_id": "be8edd29-7f89-3538-83da-5b16a49f6047",
                                "text": "Baal scuttles with ten tails\nBetween as many legs as he could carry—\nPerhaps Thomas poking through the holes\nAnd finding resolution beyond the scales\nAnd incorporeal pain of the hammered Messiah,"
                            }
                        ]
                    },
                    {
                        "sense_id": "183e7833-044c-3b10-ba00-d0937db0e51f",
                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                        "glosses": [
                            "To subdue the appetite by poor or scanty diet; to mortify."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6ba7009e-7ea2-3fac-b109-baee0464b885",
                        "entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                        "glosses": [
                            "To mortify the flesh in general."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "40318a1f-92b6-4665-a960-f7bb9de4d51c",
                                "sense_id": "6ba7009e-7ea2-3fac-b109-baee0464b885",
                                "text": "“My dear child, how are you employed?” I knew the voice of the Superior, and I replied, “My father, I was sleeping.” “And I was macerating myself at the foot of the altar for you, my child,—the scourge is red with my blood.” I returned no answer, for I felt the maceration was better merited by the betrayer than the betrayed."
                            }
                        ]
                    },
