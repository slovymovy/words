                    {
                        "translation_id": "055bd1d1-8a26-44c3-90ab-8e1f0ad5a9a6",
                        "source_entry_id": "30dec59d-2273-315d-b051-f85b680510b7",
                        "source_sense_id": "734de417-3f81-3c70-9a49-b1d897af91c2",
