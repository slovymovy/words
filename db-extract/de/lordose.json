                                        "entry_id": "53946f5a-b115-360e-aed2-72c34ec79ea9",
                                        "glosses": [
                                            "An excessive backwards curvature of the spine, causing a hollow in the back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7294e31c-2d75-375c-bb11-a2f915f144ca",
                                        "entry_id": "53946f5a-b115-360e-aed2-72c34ec79ea9",
                                        "glosses": [
                                            "A body posture of some female mammals, indicating receptivity to copulation. It involves lowering of the forelimbs but with the rear limbs extended and hips raised, ventral arching of the spine and a raising, or sideward displacement, of the tail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d3de647-95d1-4ca6-be53-9975ff0e6948",
                        "source_entry_id": "24879477-bf7b-39ed-ba03-0b2b6902f5b8",
                        "source_sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                        "source_sense_description": "konvexe Verkrümmung der Wirbelsäule nach ventral in der Medianebene",
                        "target_lang_word": "lordose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lordose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd970a5-27db-3b2a-870a-a952014abc5d",
                                        "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                                        "glosses": [
                                            "Courbure de la colonne vertébrale à convexité antérieure."
                                        ],
                                        "tags": [
                                            "Squelette"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34df775-a174-4691-bf0f-3190660471ad",
                                                "sense_id": "1bd970a5-27db-3b2a-870a-a952014abc5d",
                                                "text": "Chez l'adulte, le rachis présente quatre courbures alternantes, de la tête jusqu'au coccyx, dans le plan sagittal … : lordose, cyphose, lordose et cyphose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "579c4d63-8d00-3238-b622-492660ae3e7d",
                                        "entry_id": "fdc8159f-17cf-3a26-9af2-1a0a0390156c",
                                        "glosses": [
                                            "Position sexuelle réflexe chez les mammifères lors de la copulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70680e54-aa18-4930-9930-94761979d4ca",
                                                "sense_id": "579c4d63-8d00-3238-b622-492660ae3e7d",
                                                "text": "… 2 à 3 % seulement des mâles naïfs, que nous présentions à des congénères connus pour monter aussi vigoureusement des mâles que des femelles, leur répondaient en adoptant une posture de lordose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
