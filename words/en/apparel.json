        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b357329f-9acb-3213-9784-7b5a8da19d4b",
                    "sense_definition": "To dress or clothe someone, often in a formal, elaborate, or magnificent way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was <w>appareled</w> in robes of purple and gold for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Король был <w>облачен</w> в пурпурные и золотые одежды для церемонии.",
                                "de": "Der König war für die Zeremonie in Roben aus Purpur und Gold <w>gekleidet</w>."
                            }
                        },
                        {
                            "text": "Guests arrived at the ball <w>appareled</w> in their finest costumes.",
                            "target_lang_translations": {
                                "ru": "Гости прибыли на бал, <w>наряженные</w> в свои лучшие костюмы.",
                                "de": "Die Gäste kamen zum Ball, <w>gewandet</w> in ihre feinsten Kostüme."
                            }
