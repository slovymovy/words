                "senses": [
                    {
                        "sense_id": "be4d4757-acaa-3a1c-a18a-b4571cb5cdf9",
                        "entry_id": "1556f233-c0bc-36c3-beb4-7c3ba8fd8361",
                        "glosses": [
                            "verschluckter, der Verdauung dienender, im Magen befindlicher Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8815ae-614d-49b2-8295-afd2902c9f26",
                                "sense_id": "be4d4757-acaa-3a1c-a18a-b4571cb5cdf9",
                                "text": "Ausgestattet mit Hartteilen wie Reibplatten, Leisten oder „Zähnen“ sowie unter Umständen mit Gastrolithen (Magensteinen), dient er der Zerkleinerung der Nahrung und somit als eine Art Ersatz für die bei anderen Tiergruppen durch Kauen (im Mundraum mittels Zähnen) vorgenommene Zerkleinerung."
                            },
                            {
                                "example_id": "1aad4661-2ce2-49f3-a8c2-8ada7ffc20a1",
                                "sense_id": "be4d4757-acaa-3a1c-a18a-b4571cb5cdf9",
                                "text": "Die Cuticula dient als Reibeplatte, auf der die aufgenommenen Magensteinchen (Gastrolithe oder Grit genannt) die Nahrung zermahlen."
                            },
                            {
                                "example_id": "acae3061-878f-4b8f-bde4-5d394c8cd6ce",
                                "sense_id": "be4d4757-acaa-3a1c-a18a-b4571cb5cdf9",
                                "text": "Gastrolithen sind aus den Mägen von verschiedenen Robben- und Seelöwenarten bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
