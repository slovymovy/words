                "senses": [
                    {
                        "sense_id": "c78f3122-e450-328a-aca9-282cdee519ec",
                        "entry_id": "3da43827-05e3-372a-ba70-3bd30af34a73",
                        "glosses": [
                            "(misstönendes) Geschrei der Katzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff6287c-1988-48cf-897e-d41cd7efb76e",
                                "sense_id": "c78f3122-e450-328a-aca9-282cdee519ec",
                                "text": "Die Katzenmusik rolliger Kater kann einem lange den Schlaf rauben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0f2bb784-c607-366c-bb09-19980aa0d281",
                        "entry_id": "3da43827-05e3-372a-ba70-3bd30af34a73",
                        "glosses": [
                            "misstönende, dissonante Musik"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ff8e3ac4-3bc6-4cde-bae7-b65893836439",
                                "sense_id": "0f2bb784-c607-366c-bb09-19980aa0d281",
                                "text": "Der eine kam mit der Maultrommel, der andere mit einer verstimmten Fidel, der dritte mit Stock und Waschzuber - da kannst du dir denken, was die für eine Katzenmusik gemacht haben."
                            },
                            {
                                "example_id": "69186b54-be7b-471e-a554-894bbf1550b4",
                                "sense_id": "0f2bb784-c607-366c-bb09-19980aa0d281",
                                "text": "Wenn man Free Jazz das erste Mal hört, kann man denken, das sei Katzenmusik."
                            },
                            {
                                "example_id": "40b82354-d158-4be5-9741-57a59f9d9695",
                                "sense_id": "0f2bb784-c607-366c-bb09-19980aa0d281",
                                "text": "Alle Ensemblemitglieder aus Zagreb […] schrammeln mehr schlecht als recht auf den Instrumenten herum; die Katzenmusik, die dabei entsteht, war sicher selbst in Kroatien bestenfalls vor längerer Zeit mal modern."
                            },
                            {
                                "example_id": "d5e1e587-9858-44f7-a6d4-c3c332b1abee",
                                "sense_id": "0f2bb784-c607-366c-bb09-19980aa0d281",
                                "text": "„Diese Katzenmusik heilt von innen, ihr Lärm tut wohl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "992fa740-8518-34da-9820-18614b261e85",
                        "entry_id": "3da43827-05e3-372a-ba70-3bd30af34a73",
                        "glosses": [
                            "soziale Sanktion, bei der von meist mehreren Personen ein Geschrei, Gejohle, eine absichtlich misstönende Musik gegenüber einer anderen Person aufgeführt wird, um ihr damit einen Schimpf anzutun"
                        ],
                        "tags": [
                            "übertragen aus [2]"
                        ],
                        "examples": [
                            {
                                "example_id": "e721731b-16fe-4fef-9b2f-944d9bbf3ecc",
                                "sense_id": "992fa740-8518-34da-9820-18614b261e85",
                                "text": "Früher kam es auf dem Land vor, dass abgewiesene Liebhaber, durch Geselligkeit und Alkohol mutig geworden, in der Nacht vor dem ersten Mai vor dem Haus ihrer einstigen Liebe eine Katzenmusik vollführten, um sich für die Abweisung zu rächen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "599a1c73-c86f-4a6c-8e28-fc2b67c8815e",
                        "source_entry_id": "3da43827-05e3-372a-ba70-3bd30af34a73",
                        "source_sense_id": "c78f3122-e450-328a-aca9-282cdee519ec",
                        "source_sense_description": "(misstönendes) Geschrei der Katzen",
                        "target_lang_word": "cacophony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacophony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                        "entry_id": "1675cda0-6e52-3048-8672-3412b8411d08",
                                        "glosses": [
                                            "A mix of discordant sounds; dissonance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42447518-36d3-4784-a13f-2a82a3556fe9",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "1921-1922, H. P. Lovecraft, Herbert West: Reanimator,\nNot more unutterable could have been the chaos of hellish sound if the pit itself had opened to release the agony of the damned, for in one inconceivable cacophony was centered all the supernal terror and unnatural despair of animate nature."
                                            },
                                            {
                                                "example_id": "d7723af7-4811-42b9-8ec8-caa720c0c8b7",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "The Japanese got their attack in first. About ten minutes after passing the U.S. aircraft, they spotted Hornet (local weather patterns temporarily concealing Enterprise). Things had improved a little bit compared to the Eastern Solomons, and three dozen F4F Wildcats on combat air patrol were vectored onto the oncoming hostiles, but once that initial task was accomplished, things began to collapse back into the cacophony and chaos that was all too familiar to those aboard the Enterprise, meaning that the end result was round about the same[…]"
                                            },
                                            {
                                                "example_id": "ab262b14-724f-48c3-9921-75929e5eafaf",
                                                "sense_id": "1aef174d-6dc4-3839-ac1d-aa52c7e2a7a8",
                                                "text": "A blistering start from the Scots served to steady the ship amid a cacophony that defied the quarter-full national stadium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
