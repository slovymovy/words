                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                        "entry_id": "d9d5d6cf-2a4a-3ae6-85b5-9c2528f13034",
                        "glosses": [
                            "Doucement ; modérément ; sans se presser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e416b4ed-cd37-43b3-bf55-327142bd988e",
                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                "text": "Posément le uhlan avait replié sa carte, ressanglé, puis enfourché sa bête. Il disparut."
                            },
                            {
                                "example_id": "1c3584e7-c58f-40f7-8a0b-4dbf827efb76",
                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                "text": "Ce qu’il faut, c’est marcher posément, comme un homme posé, en regardant où on marche, pour ne pas mettre le pied dans une bouse de vache."
                            },
                            {
                                "example_id": "e7715ebb-6d98-4be1-b3f3-9d32ad0fc628",
                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                "text": "Il reporta sur son carnet les éléments qu'il avait mémorisés, il y penserait chez lui, posément… Lorsqu'il serait plus calme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "955f3849-2d32-4a01-82b0-76d43c5f311a",
                        "source_entry_id": "d9d5d6cf-2a4a-3ae6-85b5-9c2528f13034",
                        "source_sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
