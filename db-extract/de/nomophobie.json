                ],
                "senses": [
                    {
                        "sense_id": "920d4300-dcf4-373c-9b08-efcff56b3ad5",
                        "entry_id": "c0871c16-a717-3cd7-bdb1-b30a7e40d943",
                        "glosses": [
                            "Angst, ohne Mobiltelefon unerreichbar für soziale und geschäftliche Kontakte zu sein"
                        ],
                        "tags": [
                            "Psychopathologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac9c806a-8584-49da-9048-7ef4364117f2",
                                "sense_id": "920d4300-dcf4-373c-9b08-efcff56b3ad5",
                                "text": "„Es gibt mittlerweile die \"Nomophobie\", das ist eine Angststörung, die sich immer dann einstellt, wenn der User Angst davor hat, nicht mehr online sein zu können. Die digitalen Medien haben uns fest im Griff, Mediziner und Psychologen sprechen von \"Internetsucht\".“"
                            },
                            {
                                "example_id": "4392516a-c211-48dd-b498-b0566ee5274c",
                                "sense_id": "920d4300-dcf4-373c-9b08-efcff56b3ad5",
                                "text": "„Nomophobie, abgeleitet von »no mobile phone«, nennen die Briten die Angst, ohne Mobiltelefon zu sein.“"
                            },
                            {
                                "example_id": "d19b3823-c2ce-44d3-9d8f-19a054ac9c0a",
                                "sense_id": "920d4300-dcf4-373c-9b08-efcff56b3ad5",
                                "text": "„Es gibt die Angst vor Mundgeruch (Halitophobie), eine Angst vor Licht (Photophobie), sogar Angst vor Handyfunklöchern (Nomophobie).“"
                            },
                            {
                                "example_id": "cd289f19-51f6-4ec3-abf6-ded564eaac8b",
                                "sense_id": "920d4300-dcf4-373c-9b08-efcff56b3ad5",
                                "text": "„Inzwischen gibt es einen offiziellen Ausdruck für die Angst vor dem Offline: Nomophobie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
