                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86c4d96d-c5e5-4200-bf3e-ae26505c8ef4",
                        "source_entry_id": "7123ce40-b15e-3a55-bc74-9c6456bb09dd",
                        "source_sense_id": "a9876709-abe9-3ba3-93ac-fcc0a9f61875",
                        "source_sense_description": "außenbords befindlicher Motor",
                        "target_lang_word": "moteur hors-bord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur hors-bord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8573a1aa-45f3-34e6-9886-929ed2c88a45",
                                        "entry_id": "c8196f13-2bbf-382b-9867-8fd78976f43b",
                                        "glosses": [
                                            "Système de propulsion regroupant le moteur (à combustion ou électrique), la transmission et l’hélice, en un ensemble fixé sur le tableau arrière d’un bateau."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36571c62-77f8-4060-a34b-8591faffc23f",
                                                "sense_id": "8573a1aa-45f3-34e6-9886-929ed2c88a45",
                                                "text": "Mercury Marine vient de présenter le moteur hors-bord électrique Mercury® Avator™ 7.5e. C’est le premier d’une série de moteurs adaptés pour les annexes qui seront commercialisés en 2023."
                                            },
                                            {
                                                "example_id": "82683c65-dc65-4a35-84f7-90b0599bd92c",
                                                "sense_id": "8573a1aa-45f3-34e6-9886-929ed2c88a45",
                                                "text": "Il releva le moteur hors-bord en pesant de tout son poids sur la longue tige de direction. … L’hélice était maintenant hors de l’eau."
                                            },
                                            {
                                                "example_id": "d3021c64-8037-4905-8172-e014c9e54f5f",
                                                "sense_id": "8573a1aa-45f3-34e6-9886-929ed2c88a45",
                                                "text": "Il est plus simple et plus rapide de réparer à terre un moteur hors-bord qu’un en-bord, dans la mesure où il s’enlève et se remonte plus facilement sur le bateau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
