                {
                    "sense_id": "d3eb00ab-c3be-3112-b3a1-26afddeef99b",
                    "sense_definition": "A narrow inlet or arm of the sea, especially in Scotland; an estuary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coastal_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridge spans the wide <w>firth</w> connecting the two coastal towns.",
                            "target_lang_translations": {
                                "ru": "Мост перекинут через широкий <w>залив</w>, соединяя два прибрежных города."
                            }
                        },
                        {
                            "text": "They sailed out of the sheltered <w>firth</w> into the open waters of the North Sea.",
                            "target_lang_translations": {
                                "ru": "Они вышли из укрытого от ветров <w>лимана</w> в открытые воды Северного моря."
                            }
                        }
                    ],
                    "synonyms": [
