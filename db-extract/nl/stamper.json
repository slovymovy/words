                        "cross_references": [
                            {
                                "target_word": "Stößel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3191f301-a3f7-3410-ba1b-da0a73e60832",
                                        "entry_id": "dbb3a0b2-f754-3a39-82bf-f69505105b3e",
                                        "glosses": [
                                            "stabartiges Gerät zum Verkleinern/Zerstoßen oder Zerreiben von Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "055c36ff-f9e0-4d8e-9d96-ce1a29d4ba6a",
                                                "sense_id": "3191f301-a3f7-3410-ba1b-da0a73e60832",
                                                "text": "„Ihre Muskeln treten an ihren sehnigen Oberarmen hervor, bevor sie den Stößel, der fast so groß wie sie selbst ist, mit voller Wucht in den grob behauenen, hölzernen Mörser donnern lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1581568-f89b-4610-99e6-a3103b969619",
                        "source_entry_id": "2905bfdb-44ff-3e47-a026-d3da5485b3a8",
                        "source_sense_id": "04182658-01e2-31df-b920-71b8c6ed4bf8",
                        "source_sense_description": "vijzelstamper",
                        "target_lang_word": "pestle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pestle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a42f471f-29a9-30c1-981c-c8ffd218f9f7",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "A club-shaped, round-headed stick used in a mortar to pound, crush, rub or grind things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786acad8-1eeb-4608-a564-af84f1358caf",
                                                "sense_id": "a42f471f-29a9-30c1-981c-c8ffd218f9f7",
                                                "text": "She then sat down by the fire, and carefully separated the stone from the pulp, which she burnt; and her next task was to extract the kernel, which she did by means of a heavy pestle and the hearth. The kernels were next crushed together, and placed to simmer over the furnace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1bce503-69b8-3336-a13a-38aa6b4b8d3a",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "A constable's or bailiff's staff; so called from its shape."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f590331-50f6-4279-b2e1-e81444ba9dba",
                                                "sense_id": "b1bce503-69b8-3336-a13a-38aa6b4b8d3a",
                                                "text": "[…]whether the chopping-knife or their pestles were the better weapons"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56eaed6-cdfb-3a32-bd23-4839b2f959e4",
                                        "entry_id": "de79741b-69dd-3422-88e1-60a04cd2a8fe",
                                        "glosses": [
                                            "The leg and leg bone of an animal, especially of a pig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b315cde-2a16-4405-badf-e64ca5f33542",
                                                "sense_id": "b56eaed6-cdfb-3a32-bd23-4839b2f959e4",
                                                "text": "a pestle of pork"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pestle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50b867a0-7a1d-31b2-a016-db8619557fd9",
                                        "entry_id": "154c6d1a-2062-3323-a176-04098ffd012b",
                                        "glosses": [
                                            "To pound, crush, rub or grind, as in a mortar with a pestle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11c995a-d948-428b-baaa-4ac2abe9da6f",
                                                "sense_id": "50b867a0-7a1d-31b2-a016-db8619557fd9",
                                                "text": "‘Next time, boy, that you use that mortar for garlic, I will personally knock out your brain, place it in the said mortar, pestle it to a fine paste and give it to Dick Purser for feeding the dogs.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d40d98f0-d64f-487e-b040-42644193ed76",
                        "source_entry_id": "2905bfdb-44ff-3e47-a026-d3da5485b3a8",
                        "source_sense_id": "04182658-01e2-31df-b920-71b8c6ed4bf8",
                        "source_sense_description": "vijzelstamper",
                        "target_lang_word": "pilon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6261396b-0d3f-3ecd-b088-e2446ff52214",
                                        "entry_id": "2a6cdbe8-3650-39b2-94cb-afdfec7a1e51",
                                        "glosses": [
                                            "Instrument dont on se sert pour piler quelque chose dans un mortier, pour écraser quelque chose dans un mortier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b791dd0-56a0-4db0-a500-99d03d9e433c",
                                                "sense_id": "6261396b-0d3f-3ecd-b088-e2446ff52214",
                                                "text": "L’usage des moulins pour la transformation du blé en farine paraît avoir été introduit en Europe par les Romains après la conquête de l’Asie ; auparavant on se servait probablement de pilons et de mortiers, ou même simplement de pierres."
                                            },
                                            {
                                                "example_id": "f8f0d981-a457-449a-b39f-ec4d9505ec04",
                                                "sense_id": "6261396b-0d3f-3ecd-b088-e2446ff52214",
                                                "text": "D’un pas leste, il gagna sa chambre, où il avait installé une sorte de laboratoire, et il s’y enferma. La défense d’y entrer était formelle. C’était là qu’il se livrait à des préparations spéciales, dont il ne parlait à personne. Presque tout de suite, on entendit le bruit régulier et lent d’un pilon dans un mortier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b195e462-3781-3e6f-88b7-6ffd11fef0e2",
                                        "entry_id": "2a6cdbe8-3650-39b2-94cb-afdfec7a1e51",
                                        "glosses": [
                                            "Gros maillets et marteaux qui, dans les moulins à tan, à papier, etc., servent à pilonner, à briser, à hacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb0791d-42dd-4fed-a942-9d9c0ed61a4f",
                                                "sense_id": "b195e462-3781-3e6f-88b7-6ffd11fef0e2",
                                                "text": "Mettre un livre au pilon, le vendre comme papier de rebut aux cartonniers, qui le pilent pour le réduire en pâte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cdb7448-343e-37fd-a28e-586db6c4fe35",
                                        "entry_id": "2a6cdbe8-3650-39b2-94cb-afdfec7a1e51",
                                        "glosses": [
                                            "Cessation de la vente et destruction, en particulier des publications sur papier (livres, etc.)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc44e329-b029-47d5-aff4-0c06f3e9c47b",
                                                "sense_id": "2cdb7448-343e-37fd-a28e-586db6c4fe35",
                                                "text": "Vu sous cet angle, le livre, donc, n’est ni plus ni moins qu’un objet de consommation, et tout aussi éphémère qu’un autre : immédiatement passé au pilon s’il ne « marche pas », il meurt le plus souvent sans avoir été lu."
                                            },
                                            {
                                                "example_id": "f7553ff2-2ab7-49f3-80f9-9f4a4595a259",
                                                "sense_id": "2cdb7448-343e-37fd-a28e-586db6c4fe35",
                                                "text": "L’éditeur doit prévenir l’auteur en cas de mise au pilon de l’ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38743b67-f610-34b0-a58f-85cb72eb26cd",
                                        "entry_id": "2a6cdbe8-3650-39b2-94cb-afdfec7a1e51",
                                        "glosses": [
                                            "Jambe de bois."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c1f7aee-01d2-31e4-931f-fa8c20a4e7cb",
                                        "entry_id": "2a6cdbe8-3650-39b2-94cb-afdfec7a1e51",
                                        "glosses": [
                                            "Mendiant, notamment mendiant infirme ou qui simule une infirmité."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ed41a9-e86e-4c11-b92c-456680e8e852",
                                                "sense_id": "3c1f7aee-01d2-31e4-931f-fa8c20a4e7cb",
                                                "text": "Mais ils ont peur qu'on se donne pas de mal, pour être plus sûrs ils insistent ; c'est des ventouses, des radios, des prises... qu'on les tripote de haut en bas... Qu'on mesure tout... L'artérielle et puis la connerie... Gustin lui à la Jonction ça fait trente ans qu'il pratique. Les miens, mes pilons, j'y pense, je vais les envoyer un beau matin à la Vilette, boire du sang chaud."
                                            }
