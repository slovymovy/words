                ],
                "senses": [
                    {
                        "sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                        "entry_id": "2c001a10-8214-3143-99dd-588f9504f36e",
                        "glosses": [
                            "Stimmritze im Kehlkopf, gebildet durch die Stimmbänder/Stimmlippen"
                        ],
                        "tags": [
                            "und"
                        ],
                        "examples": [
                            {
                                "example_id": "4aaa9628-8a4f-4436-bbf8-01296ab93731",
                                "sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                                "text": "Die Glottis ist ein Spalt, der durch die Stimmbänder begrenzt wird."
                            },
                            {
                                "example_id": "e19da0ce-f0a5-4a16-a9a4-7038932cb16f",
                                "sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                                "text": "Die Glottis ist das Organ, mit dem stimmhafte Laute und der Knacklaut gebildet werden."
                            },
                            {
                                "example_id": "01f4f94a-fb05-4c14-aa08-5d112e9dd3f3",
                                "sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                                "text": "„Die Beschreibung von Stimmritze, Nase mit Velum, Mund, Zunge, Zähnen und Lippen als Artikulatoren und von Lunge, Luftröhre und Larynx mit Glottis als zur Stimmerzeugung notwendigen Werkzeugen entspricht im Wesentlichen der auch heute noch in der artikulatorischen Phonetik benutzten KLassifikation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c79640-a6b2-4a54-9b44-cf33d2d3447a",
                        "source_entry_id": "2c001a10-8214-3143-99dd-588f9504f36e",
                        "source_sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                        "source_sense_description": "Anatomie und Linguistik: Stimmritze im Kehlkopf, gebildet durch die Stimmbänder/Stimmlippen",
                        "target_lang_word": "glottis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glottis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee802dd8-8c9b-389a-9983-2f4d828f357e",
                                        "entry_id": "cf145924-ec30-35f7-b904-57ec8deffc66",
                                        "glosses": [
                                            "The opening between the true vocal cords which is located in the larynx and affects voice modulation through expansion or contraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "682c2101-7df6-4ec2-9172-afa2dedbef70",
                        "source_entry_id": "2c001a10-8214-3143-99dd-588f9504f36e",
                        "source_sense_id": "f6951576-0291-3401-b6e9-2c85e48cd714",
                        "source_sense_description": "Anatomie und Linguistik: Stimmritze im Kehlkopf, gebildet durch die Stimmbänder/Stimmlippen",
                        "target_lang_word": "glotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a51a9abd-7639-35f6-91d5-a03068693d11",
                                        "entry_id": "e5c49d7c-24c7-392a-9a37-9869658c5f06",
                                        "glosses": [
                                            "Orifice du larynx qui sert à l’émission de la voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b1c575-ed05-423e-b1e5-8a2f8a2f194a",
                                                "sense_id": "a51a9abd-7639-35f6-91d5-a03068693d11",
                                                "text": "D’abord, tandis que le crapaud guette sa proie, il contracte les muscles rétracteurs de son système hyoglosse, en sorte qu’il ramène vers la glotte l’extrémité libre de la langue."
                                            },
                                            {
                                                "example_id": "5f90dcc7-e3c2-4a33-9e38-a8153694c488",
                                                "sense_id": "a51a9abd-7639-35f6-91d5-a03068693d11",
                                                "text": "« Avalez tous ces menus plaisirs de la renommée ! Mettez-vous en jusque-là ! Et venez les vomir sur mon tapis, lorsque vous en aurez par-dessus la glotte ! »"
                                            },
                                            {
                                                "example_id": "76951c2b-99a6-4e03-9710-ff1a68f647a1",
                                                "sense_id": "a51a9abd-7639-35f6-91d5-a03068693d11",
                                                "text": "Il noua avec application un bandana noir à pois blancs autour de sa glotte, inclina son décalitre, descendit avec précaution, sur la pointe de ses bottes, l’escalier pentu de la résidence d’anciens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963aa7b2-669f-32f3-bacf-c86c7cc921a1",
                                        "entry_id": "e5c49d7c-24c7-392a-9a37-9869658c5f06",
                                        "glosses": [
                                            "Voix."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf973591-a5a6-478c-be64-59cc9b1f5f15",
                                                "sense_id": "963aa7b2-669f-32f3-bacf-c86c7cc921a1",
                                                "text": "Coffe ne put retenir un petit éclat de glotte en voyant la manière dont le bon préfet ajouta :\n— Ma foi, monsieur, c’est y aller bon jeu bon argent."
                                            },
                                            {
                                                "example_id": "74f87c01-5fe6-4856-9bf4-e5cfed210bd9",
                                                "sense_id": "963aa7b2-669f-32f3-bacf-c86c7cc921a1",
                                                "text": "Ceci coupa la glotte à de La Hourmerie, qui, s’étant attendu à tout excepté à ce qui arrivait, ne trouva qu’un amer sourire et qu’un lent élevé de ses cils vers le ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
