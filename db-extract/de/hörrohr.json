                "senses": [
                    {
                        "sense_id": "6c476443-2f27-3722-80f7-a28a1d8e600d",
                        "entry_id": "91136152-58e2-37c0-9f80-945d44f06853",
                        "glosses": [
                            "Hilfsmittel in Trichter- oder Röhrenform für Personen mit schwachem Gehör, welches etwa aus Metall, Holz oder dem Horn von Tieren besteht und durch die Sammlung der Schallwellen mehr Schallenergie zum Trommelfell bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb56efd5-37f9-442f-98a0-3c20338a87c2",
                                "sense_id": "6c476443-2f27-3722-80f7-a28a1d8e600d",
                                "text": "Wenn Opa sein Hörrohr verlegt hat, kann man mit ihm nur schreiend kommunizieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "693032f8-a606-3e8e-83b4-3c140488a99e",
                        "entry_id": "91136152-58e2-37c0-9f80-945d44f06853",
                        "glosses": [
                            "rohrförmiges Utensil aus Holz, das Hebammen – historisch auch Ärzte – zum besseren Hören der Körpergeräusche benutzen"
                        ],
                        "tags": [],
                        "examples": [],
