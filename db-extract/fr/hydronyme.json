        "fr-extract.jsonl": [
            {
                "entry_id": "c0b0ae01-8168-3c47-810c-30a7a1a5d041",
                "word": "hydronyme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "deae8e5f-2928-4950-bb48-cfae1a4f3ba3",
                        "entry_id": "c0b0ae01-8168-3c47-810c-30a7a1a5d041",
                        "tags": [
                            "plural"
                        ],
                        "form": "hydronymes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b6aae8a-2052-3e0d-b22c-1d1b1090d734",
                        "entry_id": "c0b0ae01-8168-3c47-810c-30a7a1a5d041",
                        "glosses": [
                            "Nom propre désignant un élément hydrographique (cours d’eau, mer, lac, etc)."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "31f42f6b-e7ee-4339-9b25-b9cda1fb8882",
                                "sense_id": "3b6aae8a-2052-3e0d-b22c-1d1b1090d734",
                                "text": "Nous appellerons donc hydronyme toute dénomination (appellatif, qualificatif ou nom propre) donnée non seulement aux sources, aux rivières, aux canalisations, mais aux marécages, aux mares, aux lacs et même à la mer."
                            },
                            {
                                "example_id": "a33f4b84-0797-4f16-afa3-78781c770ff1",
                                "sense_id": "3b6aae8a-2052-3e0d-b22c-1d1b1090d734",
                                "text": "La toponymie se prête en Comminges aux subdivisions usuelles : oronymes de relief ou de dépressions, hydronymes, toponymes pastoraux, phytonymes et zoonymes, descriptifs de nature, thèmes humains, hagionymie."
                            },
                            {
                                "example_id": "335e499c-b603-4ebc-8851-4bf8b8cc1f46",
                                "sense_id": "3b6aae8a-2052-3e0d-b22c-1d1b1090d734",
                                "text": "Des exemples d’hydronymes sont Rhin, Tamise, Seine, mais aussi Baie des Anges, Golfe du Bengale, exemples dans lesquels le terme générique et le terme spécifique prennent une majuscule — (Conseil National de l’Information Géographique - Commission Nationale de Toponymie, Charte de Toponymie.)"
                            }
                        ]
                    }
                ],
