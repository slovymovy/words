                ],
                "senses": [
                    {
                        "sense_id": "0623a60a-5442-3f33-85b5-3676ac7edca9",
                        "entry_id": "691427cc-82ff-3280-8b8d-bf04146d6615",
                        "glosses": [
                            "Protagonist eines Witzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0982aad9-685c-4167-86db-3e78e9fc8649",
                                "sense_id": "0623a60a-5442-3f33-85b5-3676ac7edca9",
                                "text": "Witzfiguren sind in der Regel personifizierte Stereotypen."
                            },
                            {
                                "example_id": "f19e5af5-ba8a-4464-9471-bf150fcba843",
                                "sense_id": "0623a60a-5442-3f33-85b5-3676ac7edca9",
                                "text": "„Ganze Witzgruppen und -figuren sind ausgefallen.“"
                            },
                            {
                                "example_id": "4efed77d-aacf-4d14-a0ea-a7a9f3a60dea",
                                "sense_id": "0623a60a-5442-3f33-85b5-3676ac7edca9",
                                "text": "„Eine dankbare Zielscheibe des Spottes und Witzes war in dieser Hinsicht König August von Sachsen, der ja unbeschreiblich populär war – und auch selbst von sich aus viel dazu beitrug, als Witzfigur in den Zeitungen und Zeitschriften zu erscheinen.“"
                            },
                            {
                                "example_id": "f452bbad-416f-4dc0-8629-ab801df9fbf3",
                                "sense_id": "0623a60a-5442-3f33-85b5-3676ac7edca9",
                                "text": "„Deren Witzfiguren flogen aus dem Schlaraffenland der ‚tüchtigen Deutschen‘ gewissermaßen wie gebratene Tauben in den Volksmund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98ced6a5-4f9e-3af0-b1a8-481063611c32",
                        "entry_id": "691427cc-82ff-3280-8b8d-bf04146d6615",
                        "glosses": [
                            "lächerlich wirkende, nicht ernst zu nehmende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55332d59-c81d-4571-bf8e-d4130e5ca9b3",
                                "sense_id": "98ced6a5-4f9e-3af0-b1a8-481063611c32",
                                "text": "Wegen seiner unbedachten Äußerungen wurde der junge Politiker in den Medien als Witzfigur diffamiert."
                            },
                            {
                                "example_id": "d956f408-df68-48fc-a2b6-6b3aadf6c472",
                                "sense_id": "98ced6a5-4f9e-3af0-b1a8-481063611c32",
                                "text": "„Doch die Witzfigur im Zimmer war ich, denn ich forderte sie auf – sie lag bereits breitbeinig da –, die Beine wieder zusammenzulegen.“"
                            },
                            {
                                "example_id": "b6550e56-e052-4fbb-adb0-fea0fface0cf",
                                "sense_id": "98ced6a5-4f9e-3af0-b1a8-481063611c32",
                                "text": "„Erstaunlich aber ist, dass dieser Witz zunächst gar nicht auf Politiker gemünzt war, sondern im Offiziersmilieu Preußens mit der Witzfigur des Oberst von Zitzewitz seinen Ursprung hat.“"
                            },
                            {
                                "example_id": "015b44b0-af46-4068-9366-dc3c0ab09a80",
                                "sense_id": "98ced6a5-4f9e-3af0-b1a8-481063611c32",
                                "text": "„Auch Menachem Mendels Tragödie ließ sich nur als Farce kaschieren, weil der Spekulant als eine Witzfigur konzipiert war, die unverantwortlich handeln durfte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
