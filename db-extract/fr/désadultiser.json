                "senses": [
                    {
                        "sense_id": "8cb00386-c9b5-36c8-b4d6-61aff83b8e22",
                        "entry_id": "df83d237-5572-32b9-aa8a-1f28c7801d5d",
                        "glosses": [
                            "Faire perdre son caractère adulte à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38947812-78a6-4190-b246-1adbebacf26e",
                                "sense_id": "8cb00386-c9b5-36c8-b4d6-61aff83b8e22",
                                "text": "Pour moi, c’est une source d’inspiration inépuisable que d’essayer de “désenfantiser“ l’enfant et de “désadultiser“ l’adulte."
                            },
                            {
                                "example_id": "ae7606b0-7ba3-407f-afd7-dc82867243d1",
                                "sense_id": "8cb00386-c9b5-36c8-b4d6-61aff83b8e22",
                                "text": "La rencontre, ils se la fabriquent et, s’ils ont du vin à boire, ils vont le « désadultiser »."
                            },
                            {
                                "example_id": "7dc95962-7771-4f21-a143-26d07a304339",
                                "sense_id": "8cb00386-c9b5-36c8-b4d6-61aff83b8e22",
                                "text": "Cette idée est basée sur le discours que les \" jeunes sont des cannibales d’adultes ”, que l’imitation est un facteur important du processus de développement social de ces jeunes surtout au moment où la société se désadultise."
                            }
                        ]
                    }
