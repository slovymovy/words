                "senses": [
                    {
                        "sense_id": "4d5beae4-82aa-3df9-8d2c-b104d104829d",
                        "entry_id": "bb97a83f-3816-32e7-829a-bf8ab3e363e1",
                        "glosses": [
                            "Donner un caractère temporaire à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3914d36f-0b7b-4542-8bd5-b7984e30c111",
                                "sense_id": "4d5beae4-82aa-3df9-8d2c-b104d104829d",
                                "text": "J'aimerais \"temporariser\" ce fichier. En gros j'aimerais qu'après un certain temps, il se ferme tout seul."
                            },
                            {
                                "example_id": "0ca11210-27d5-41a9-9e1e-03b8e2e27185",
                                "sense_id": "4d5beae4-82aa-3df9-8d2c-b104d104829d",
                                "text": "Comme cela ne devrait avoir aucun impact sur la valeur des actions du CN, il n'y a pas lieu de supprimer ou de temporariser cette restriction."
                            },
                            {
                                "example_id": "500eeb63-b762-4f09-88be-8da7aa3bec31",
                                "sense_id": "4d5beae4-82aa-3df9-8d2c-b104d104829d",
                                "text": "Cependant il a été prouvé que beaucoup d'éclairs peuvent temporariser ces fonctions."
                            }
                        ]
                    }
