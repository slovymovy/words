                ],
                "senses": [
                    {
                        "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                        "entry_id": "c128a837-8679-3d96-b56f-d6ae12af07f0",
                        "glosses": [
                            "Quelle, die mineral- oder kohlensäurehaltiges Wasser hervorbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04bfefc1-577e-408c-860c-bd99c771b0c7",
                                "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                                "text": "„Die Mineralquelle Utting hat im vergangenen acht Millionen Flaschen abgefüllt.“"
                            },
                            {
                                "example_id": "da2a377e-0f88-4662-9a4f-ab8d03bd4282",
                                "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                                "text": "„Selbst die Therme entspringt einer Portion lokalen Eigensinns, der eine Mineralquelle erhoffte, wo üblicherweise keine zu erwarten ist.“"
                            },
                            {
                                "example_id": "d955ea86-5fc4-41cd-90fb-19038afc400c",
                                "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                                "text": "„Gekocht wird mit Solarenergie, gebadet nur draußen, in einer heißen Mineralquelle.“"
                            },
                            {
                                "example_id": "aef8f73e-64a0-4364-8e61-eef14f1a33a9",
                                "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                                "text": "„Jahrhundert konnte sich der Kurflecken mit seinem Heilwasser aus der an Schwefel reichsten kalten Mineralquelle Deutschlands trotz harter Konkurrenz in der Nachbarschaft aber behaupten.“"
                            },
                            {
                                "example_id": "97efeb68-79e0-48df-8605-8a8f9a6d42bd",
                                "sense_id": "9de88af3-63af-3729-b708-c4a37775ee15",
                                "text": "„Einst gab es hier große Pläne: Im Jahr 1739 entdeckte man eine Mineralquelle, die wundersame Heilkräfte und den Aufschwung des Ortes als feudales Kurbad versprach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
