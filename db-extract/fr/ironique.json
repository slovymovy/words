            {
                "entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                "word": "ironique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "581e3163-2612-4392-b63b-fccd16ee9937",
                        "entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "ironiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80c3e68b-6429-3951-b46e-a11c8fa8c7dd",
                        "entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "glosses": [
                            "Où il y a de l’ironie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d82f873-5c73-4b3d-bf2d-a1ae90871917",
                                "sense_id": "80c3e68b-6429-3951-b46e-a11c8fa8c7dd",
                                "text": "Il remarqua l'étonnement ironique du caporal... Le tirailleur était impassible."
                            },
                            {
                                "example_id": "f1bb170e-d7f7-4d13-adf3-bfac8b4f1fca",
                                "sense_id": "80c3e68b-6429-3951-b46e-a11c8fa8c7dd",
                                "text": "[…] dans un discours du 11 mai 1907, à la Chambre des députés, Jaurès m’a appelé le « métaphysicien du syndicalisme », sans aucun doute avec une intention ironique."
                            },
                            {
                                "example_id": "e06693d7-9526-4987-89cb-b4b4d629c55d",
                                "sense_id": "80c3e68b-6429-3951-b46e-a11c8fa8c7dd",
                                "text": "Sofer se rendit compte qu'il souriait niaisement bien que les questions posées méritassent beaucoup plus de sérieux. Il se contrôla et reprit sa posture distante, plus ironique que vraiment sévère."
                            }
                        ]
                    },
                    {
                        "sense_id": "dec073ce-d0e9-3ee4-aa00-f8276aa574c1",
                        "entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "glosses": [
                            "Contraire, opposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06b5cde-d8b0-4462-88d0-1c8400da9103",
                                "sense_id": "dec073ce-d0e9-3ee4-aa00-f8276aa574c1",
                                "text": "Grâce aux combinaisons subtiles d’un ironique destin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a153a2f5-dc0b-457c-a8bb-bfc89fd3d8d5",
                        "source_entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "source_sense_description": "Qui a de l’ironie",
                        "target_lang_word": "ironisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "912d86b9-056d-33ab-bb9a-9ad150d3f547",
                                        "entry_id": "d98bceaf-1690-354c-a23f-a4b47088d39a",
                                        "glosses": [
                                            "spöttisch oder humorvoll das Gegenteil aussagend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275bc8e9-a1bb-4c4d-bddc-6141bbfa9bf2",
                                                "sense_id": "912d86b9-056d-33ab-bb9a-9ad150d3f547",
                                                "text": "Du darfst das nicht ernst nehmen – das war ironisch gemeint."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "227c5e59-573c-4b3d-893e-efb677bb8c8a",
                        "source_entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "source_sense_description": "Qui a de l’ironie",
                        "target_lang_word": "ironic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                                        "glosses": [
                                            "Characterized by or constituting (any kind of) irony."
                                        ],
                                        "tags": [
                                            "of a situation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd79392-df69-4d30-ba0c-9649059f8401",
                                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                                "text": "It's somewhat ironic to have a wave of smog right on Earth Day."
                                            },
                                            {
                                                "example_id": "eada0f7e-7dfb-4f61-bedf-58a77bb0438c",
                                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                                "text": "It was ironic I forgot my textbook on human memory."
                                            },
                                            {
                                                "example_id": "80479409-9547-4bdf-a4dc-4f1cdc7dbb5f",
                                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                                "text": "Chloe had once seen a real-life goth hanging around by a garbage bin in the high street and become incredibly excited. She really wanted to go over and ask her how to get started in the goth world, but she was too shy. Which was ironic, since shyness is something you need if you want to be a successful goth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b75cb5-b5f2-395e-af0e-3dcd756828b6",
                                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                                        "glosses": [
                                            "Characterized by or constituting (any kind of) irony.",
                                            "Odd or coincidental; strange."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6af9920-12bf-4846-a173-f63d4a5b1817",
                                                "sense_id": "e7b75cb5-b5f2-395e-af0e-3dcd756828b6",
                                                "text": "It's ironic that we are eating a sandwich in Sandwich, Massachusetts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5eab24-ba43-31e4-9f45-e5626c4d420f",
                                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                                        "glosses": [
                                            "Acting in an unserious and teasing manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93069f1-647c-4e5a-8f02-2190954127e5",
                                                "sense_id": "fa5eab24-ba43-31e4-9f45-e5626c4d420f",
                                                "text": "Don't take it personally. We're just being ironic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                                        "glosses": [
                                            "Done in an insincere and mocking manner; satirical."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a61d2f-e13f-4eb2-a8a8-80827d5f1d21",
                                                "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                                                "text": "You should assume that everything this guy posts is ironic."
                                            },
                                            {
                                                "example_id": "109ae1e9-2f1e-48f2-93d1-1e3a981bf287",
                                                "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                                                "text": "Here’s a tip: If a group of people start using something as ironic hate speech, it will eventually be used for unironic hate speech. Don’t act surprised."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00c00a95-62c3-4c3e-97bf-4cea4cee7677",
                        "source_entry_id": "5733674f-dbd6-3e02-86c0-b6a2401a3312",
                        "source_sense_description": "Qui a de l’ironie",
                        "target_lang_word": "wry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d20bb963-b993-3d51-844e-a7c179c23e3d",
                                        "entry_id": "3338aefd-0a29-3106-b33e-3a1e2ad1615c",
                                        "glosses": [
                                            "Turned away, contorted (of the face or body)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ad9231-ddbe-46bb-8186-74047e812f4e",
                                                "sense_id": "d20bb963-b993-3d51-844e-a7c179c23e3d",
                                                "text": "'\"Why, you snivelling, wry-faced, puny villain,\" gasped old Lobbs."
                                            },
                                            {
                                                "example_id": "3433e215-3ced-4e1d-a3ea-a3cd8261e7d1",
                                                "sense_id": "d20bb963-b993-3d51-844e-a7c179c23e3d",
                                                "text": "“Humph! Had to,” said Pep with a wry grimace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15d8002-dc84-3451-b2b2-075e5e74b8d8",
                                        "entry_id": "3338aefd-0a29-3106-b33e-3a1e2ad1615c",
                                        "glosses": [
                                            "Dryly humorous; sardonic or bitterly ironic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b517d521-3e0c-4058-834e-292d961750f4",
                                                "sense_id": "d15d8002-dc84-3451-b2b2-075e5e74b8d8",
                                                "text": "\"[T]he master says a wry word now and then; and so ye let your spirits go down, don't ye see, and all sorts o' fancies comes into your head.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da57609a-810e-3b1e-8d85-fa13b3e5934c",
                                        "entry_id": "3338aefd-0a29-3106-b33e-3a1e2ad1615c",
                                        "glosses": [
                                            "Twisted, bent, crooked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c5f625a-6546-3248-bd4b-c59ac54e569d",
                                        "entry_id": "3338aefd-0a29-3106-b33e-3a1e2ad1615c",
                                        "glosses": [
                                            "Deviating from the right direction; misdirected; out of place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992507e3-4db0-40ad-9a53-55301609e1b5",
                                                "sense_id": "2c5f625a-6546-3248-bd4b-c59ac54e569d",
                                                "text": "Catherine hath made a wry stitch in her broidery, when she was thinking of something else than her work."
                                            },
                                            {
                                                "example_id": "94c6f082-a8c8-41c6-9ae9-8c91dfefc0f5",
                                                "sense_id": "2c5f625a-6546-3248-bd4b-c59ac54e569d",
                                                "text": ". . . the wry rigour of our neighbours, who never take up an old idea without some extravagance in its application."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b37bbff-afc6-3f17-a284-95bc418136dc",
                                        "entry_id": "1455f4e9-aa94-3c27-a1f4-f9076e5ee160",
                                        "glosses": [
                                            "To turn (away); to swerve or deviate."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23205ad8-ee67-4834-9f68-1cea03c3baf4",
                                                "sense_id": "5b37bbff-afc6-3f17-a284-95bc418136dc",
                                                "text": "God pricketh them of his great goodness still. And the grief of this great pang pincheth them at the heart, and of wickedness they wry away."
                                            },
                                            {
                                                "example_id": "bb14070d-0180-4aab-b55c-1f62f80107d5",
                                                "sense_id": "5b37bbff-afc6-3f17-a284-95bc418136dc",
                                                "text": "You married ones,\nIf each of you should take this course, how many\nMust murder wives much better than themselves\nFor wrying but a little!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245ef2fb-f41a-3caf-a80b-b67599819c7a",
                                        "entry_id": "1455f4e9-aa94-3c27-a1f4-f9076e5ee160",
                                        "glosses": [
                                            "To divert; to cause to turn away."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6082ea33-74be-3b56-8c1e-811f19d8dbb6",
                                        "entry_id": "1455f4e9-aa94-3c27-a1f4-f9076e5ee160",
                                        "glosses": [
                                            "To twist or contort (the body, face, etc.)."
                                        ],
                                        "tags": [
