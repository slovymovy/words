                    "frequency": "High",
                    "semantic_group_id": "cavite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aiment <w>creuser</w> un grand trou dans le sable avec une pelle."
                        },
                        {
