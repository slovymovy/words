                ],
                "senses": [
                    {
                        "sense_id": "2d632f69-21d1-39fa-9a59-86e914e3855d",
                        "entry_id": "f6ad02fb-544b-3570-ae00-408601e6ae06",
                        "glosses": [
                            "eine Stadt, in der die Behörden eines Landkreises ihren Sitz haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7818cd5-c3e9-4e9e-bb95-0991875424e1",
                                "sense_id": "2d632f69-21d1-39fa-9a59-86e914e3855d",
                                "text": "„Sie ist die Kreisstadt des Landkreises Fulda und gleichzeitig eine von sieben Sonderstatusstädten Hessens.“"
                            },
                            {
                                "example_id": "807b205c-d07d-412b-874b-01bc5f073256",
                                "sense_id": "2d632f69-21d1-39fa-9a59-86e914e3855d",
                                "text": "„Höhepunkt der Schulband-Karriere sind Auftritte außerhalb, Bandwettbewerbe in der nächsten Kreisstadt, bei der sie den zweiten Platz belegt und das Gerücht, dass ein Label echt interessiert wäre.“"
                            },
                            {
                                "example_id": "227b34c8-9fd6-4bef-9c0f-5c5533bdeb0f",
                                "sense_id": "2d632f69-21d1-39fa-9a59-86e914e3855d",
                                "text": "„Dabei ist Will Vesper seinem Ziel schon greifbar nah: Seit Jahren macht er Urlaub auf dem Gutshof seines Freundes Hans Rimpau in Triangel östlich von Hannover in der Nähe der Kreisstadt Gifhorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caaeaa55-435f-4ed9-9891-c24d5952185e",
                        "source_entry_id": "f6ad02fb-544b-3570-ae00-408601e6ae06",
                        "source_sense_id": "2d632f69-21d1-39fa-9a59-86e914e3855d",
                        "source_sense_description": "eine Stadt, in der die Behörden eines Landkreises ihren Sitz haben",
                        "target_lang_word": "county seat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "county seat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15a25df0-efc4-3a8d-9e9d-580176e8da07",
                                        "entry_id": "18e35da8-42e7-3570-9ddf-6307fa99a838",
                                        "glosses": [
                                            "The city in which the offices of county government are located."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6503c91a-3576-414d-82a8-8e1b831480bc",
                                                "sense_id": "15a25df0-efc4-3a8d-9e9d-580176e8da07",
                                                "text": "Lawrence is the county seat of Douglas County."
                                            },
                                            {
                                                "example_id": "362f9a95-8b12-4ead-90ee-04bab66aaf86",
                                                "sense_id": "15a25df0-efc4-3a8d-9e9d-580176e8da07",
                                                "text": "Some ten thousand peasants in Hsichuan county in Honan province used hoes, scythes, wooden poles, etc. as weapons and took over the county seat. They expanded their forces and held areas in two neighboring counties. The CC sent a force of one hundred thousand troops and fought the peasants for nearly two months before the uprising was put down."
                                            },
                                            {
                                                "example_id": "d500a180-989a-49eb-b647-63a078a95a02",
                                                "sense_id": "15a25df0-efc4-3a8d-9e9d-580176e8da07",
                                                "text": "As the Yeh-Ho armies approached Swatow, peasants briefly captured two other county seats, Ch’ao-yang and Chieh-yang, but there was very little coordination between the local forces and the oncoming troops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
