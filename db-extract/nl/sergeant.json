                                                "example_id": "207cb01b-6578-429b-9496-02a27842c4fd",
                                                "sense_id": "257bf5bd-695d-32d4-bfcc-0cf048ad2245",
                                                "text": "“Yes, there are two distinct sets of footprints, both wearing rubber shoes—one I think ordinary plimsolls, the other goloshes,” replied the sergeant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30b0fa3-7e4b-357f-802e-18d297809300",
                                        "entry_id": "e79a9935-9573-39bb-99ba-107c4c0fcb4f",
                                        "glosses": [
                                            "A lawyer of the highest rank, equivalent to the doctor of civil law."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e255ce2-f35d-41d6-9b32-cd715bb1a4cc",
                                                "sense_id": "a30b0fa3-7e4b-357f-802e-18d297809300",
                                                "text": "All other sergeants and barristers indiscriminately (except in the Court of Common Pleas, where only sergeants are admitted) may take upon them the protection and defense of any suitors."
                                            }
                                        ]
                                    },
                                    {
