    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22088ae4-5dfd-32da-8ccb-09f8abd7f660",
                    "sense_definition": "Сравнительная степень прилагательного <w>молодой</w>; отличающийся меньшим возрастом по сравнению с кем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "age_comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат <w>моложе</w> меня на два года.",
                            "target_lang_translations": {
                                "en": "My brother is two years <w>younger</w> than me.",
                                "pl": "Mój brat jest ode mnie o dwa lata <w>młodszy</w>."
                            }
                        },
                        {
                            "text": "Она выглядит значительно <w>моложе</w> своих лет.",
                            "target_lang_translations": {
                                "en": "She looks significantly <w>younger</w> than her age.",
                                "pl": "Ona wygląda znacznie <w>młodziej</w> niż wskazuje jej wiek."
                            }
                        }
                    ],
                    "synonyms": [
                        "младше"
                    ],
                    "antonyms": [
                        "старше"
                    ],
                    "common_phrases": [
                        "намного моложе",
                        "значительно моложе",
                        "выглядеть моложе",
                        "моложе своих лет"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative form of the adjective \"young\"; having a lesser age compared to someone else.",
                        "pl": "Stopień wyższy przymiotnika „młody”; mający mniej lat w porównaniu z kimś innym."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "younger",
                                "target_lang_sense_clarification": "comparative of young (age)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "młodszy",
                                "target_lang_sense_clarification": "o wieku, mający mniej lat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "40c30c20-cd6f-3376-a0b0-d5b2054227ac",
                    "sense_definition": "Сравнительная степень наречия <w>молодо</w>; более свежо, бодро, свойственно юности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она старается одеваться <w>моложе</w>, чтобы скрыть свой возраст.",
                            "target_lang_translations": {
                                "en": "She tries to dress <w>younger</w> to hide her age.",
                                "pl": "Ona stara się ubierać <w>młodziej</w>, aby ukryć swój wiek."
                            }
                        },
                        {
                            "text": "С новой причёской ты стала смотреться гораздо <w>моложе</w> и интереснее.",
                            "target_lang_translations": {
                                "en": "With the new hairstyle, you look much <w>younger</w> and more interesting.",
                                "pl": "W nowej fryzurze zaczęłaś wyglądać znacznie <w>młodziej</w> i ciekawiej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "одеваться моложе"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative form of the adverb \"youthfully\"; in a manner that is fresher, more vigorous, or characteristic of youth.",
                        "pl": "Stopień wyższy przysłówka „młodo”; w sposób bardziej młodzieńczy, świeższy, właściwy młodości."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "younger",
                                "target_lang_sense_clarification": "more youthfully (manner/appearance)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "młodziej",
                                "target_lang_sense_clarification": "w sposób bardziej młodzieńczy, świeżo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}