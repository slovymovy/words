{
    "word_family": [
        "celebrate",
        "celebratory",
        "celebrant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc16e087-4bd5-37cd-988d-6e8207aa4829",
                    "sense_definition": "A social gathering or party to enjoy a special occasion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are having a <w>celebration</w> for my dad's new job.",
                            "target_lang_translations": {
                                "ru": "Мы устраиваем <w>праздник</w> в честь новой работы папы.",
                                "zh": "我们正在为我爸爸的新工作举办一场<w>庆祝活动</w>。"
                            }
                        },
                        {
                            "text": "The family held a small birthday <w>celebration</w> at home.",
                            "target_lang_translations": {
                                "ru": "Семья устроила дома небольшое <w>празднование</w> дня рождения.",
                                "zh": "这家人在家里举办了一个小型的生日<w>庆祝活动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "festivity",
                        "festival",
                        "feast",
                        "party"
                    ],
                    "common_phrases": [
                        "birthday celebration",
                        "wedding celebration",
                        "family celebration",
                        "anniversary celebration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное собрание или вечеринка по особому случаю.",
                        "zh": "为庆祝特殊场合而举行的社交聚会或派对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "праздник",
                                "target_lang_sense_clarification": "радостное событие, вечеринка"
                            },
                            {
                                "target_lang_word": "празднование",
                                "target_lang_sense_clarification": "процесс отмечания праздника"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "большое, официальное праздничное мероприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庆祝活动",
                                "target_lang_sense_clarification": "指为了庆祝而举办的活动或聚会"
                            },
                            {
                                "target_lang_word": "庆典",
                                "target_lang_sense_clarification": "较为正式的庆祝仪式或活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10c81563-7f41-3ef7-9797-f6b4c91e4465",
                    "sense_definition": "The act of showing happiness and appreciation for a special event or achievement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She jumped in the air in <w>celebration</w> when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Услышав новость, она подпрыгнула в воздухе от <w>ликования</w>.",
                                "zh": "听到这个消息时，她高兴得跳了起来以示<w>庆祝</w>。"
                            }
                        },
                        {
                            "text": "There was much <w>celebration</w> in the streets after the victory.",
                            "target_lang_translations": {
                                "ru": "После победы на улицах было шумное <w>празднование</w>.",
                                "zh": "胜利后，街上到处都在<w>欢庆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "festivity",
                        "party",
                        "festival"
                    ],
                    "common_phrases": [
                        "in celebration of",
                        "cause for celebration",
                        "day of celebration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение радости и признательности по поводу особого события или достижения.",
                        "zh": "对特殊事件或成就表示快乐和赞赏的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "празднование",
                                "target_lang_sense_clarification": "действие по выражению радости"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "чувство радости, триумф"
                            },
                            {
                                "target_lang_word": "ликование",
                                "target_lang_sense_clarification": "бурное выражение радости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庆祝",
                                "target_lang_sense_clarification": "表达喜悦或纪念的行为"
                            },
                            {
                                "target_lang_word": "欢庆",
                                "target_lang_sense_clarification": "热烈地庆祝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "096d5c30-322a-372f-84c3-de9a19c3b748",
                    "sense_definition": "The formal performance of a solemn or religious ceremony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will attend the Christmas <w>celebration</w> in church.",
                            "target_lang_translations": {
                                "ru": "Мы посетим рождественское <w>празднование</w> в церкви.",
                                "zh": "我们将去教堂参加圣诞<w>仪式</w>。"
                            }
                        },
                        {
                            "text": "The priest led the <w>celebration</w> of the sacrament with great reverence.",
                            "target_lang_translations": {
                                "ru": "Священник с великим благоговением провел <w>совершение</w> таинства.",
                                "zh": "牧师怀着极大的敬意主持了圣餐<w>仪式</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "religious celebration",
                        "solemn celebration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное проведение торжественной или религиозной церемонии.",
                        "zh": "庄严或宗教仪式的正式举行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "празднование",
                                "target_lang_sense_clarification": "отмечание религиозного праздника"
                            },
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "торжественная церемония"
                            },
                            {
                                "target_lang_word": "чествование",
                                "target_lang_sense_clarification": "торжественное проявление уважения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "正式的宗教或庄严活动"
                            },
                            {
