{
    "word_family": [
        "adversarial",
        "adversity",
        "adverse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "144bec8f-96e7-36d7-9363-2eb71c3ce2a1",
                    "sense_definition": "A person, group, or force that opposes or attacks; an opponent or enemy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opponent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer studied his <w>adversary</w> carefully before the championship match began.",
                            "target_lang_translations": {
                                "ru": "Боксер внимательно изучал своего <w>противника</w> перед началом чемпионского боя."
                            }
                        },
                        {
                            "text": "In the political drama, he could not have dreamed up a more formidable <w>adversary</w> than his former mentor.",
                            "target_lang_translations": {
                                "ru": "В этой политической драме он и представить себе не мог более грозного <w>соперника</w>, чем его бывший наставник."
                            }
                        }
                    ],
                    "synonyms": [
                        "antagonist"
                    ],
                    "antonyms": [
                        "ally"
                    ],
                    "common_phrases": [
                        "formidable adversary",
                        "political adversary",
                        "worthy adversary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, группа или сила, которая противостоит или нападает; противник или враг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "общий термин для оппонента или врага"
                            },
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "тот, кто состязается или конкурирует"
                            },
                            {
                                "target_lang_word": "неприятель",
                                "target_lang_sense_clarification": "враг, часто в военном контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5cb89022-913e-32ac-a8a9-b703095f5711",
                    "sense_definition": "A title used to refer to the Devil or Satan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_figure",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The ancient text describes the release of the <w>Adversary</w> from his eternal prison.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает освобождение <w>Противника</w> из его вечной темницы."
                            }
                        },
                        {
                            "text": "In many theological debates, the <w>Adversary</w> is depicted as the ultimate source of temptation.",
                            "target_lang_translations": {
                                "ru": "Во многих теологических спорах <w>Враг</w> изображается как первоисточник искушения."
                            }
                        }
                    ],
                    "synonyms": [
                        "Satan"
                    ],
                    "common_phrases": [
                        "the Adversary"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in religious or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя или титул, используемый для обозначения Дьявола или Сатаны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Противник",
                                "target_lang_sense_clarification": "религиозный эпитет Сатаны"
                            },
                            {
                                "target_lang_word": "Враг рода человеческого",
                                "target_lang_sense_clarification": "традиционное именование дьявола"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}