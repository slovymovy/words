                        "examples": [
                            {
                                "example_id": "db711080-042a-459a-9780-4cc934a26979",
                                "sense_id": "b28f4ecc-a7a3-35f5-87c9-51c2e0e54a06",
                                "text": "„Die Grundmaterialien für PVDF sind Fluorwasserstoff und Methylchloroform die zu Chlordifluorethan und weiter zu Vinylidenfluorid synthetisiert werden.“"
                            },
                            {
                                "example_id": "c91aa722-f595-4b88-b24c-5da146b8cd1f",
                                "sense_id": "b28f4ecc-a7a3-35f5-87c9-51c2e0e54a06",
                                "text": "„Wir verarbeiten PVDF zu Filterglocken und Armaturen, Funktionsteilen für Autoklaven und für die Medizintechnik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
