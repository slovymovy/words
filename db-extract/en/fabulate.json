                ],
                "senses": [
                    {
                        "sense_id": "6daeeb07-71c7-34bd-a8fd-816814b55f7c",
                        "entry_id": "fe750a84-242c-3951-9c7e-b0a9cef95982",
                        "glosses": [
                            "A folk story that is not entirely believable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8f3a5ea6-23f5-4b31-835a-0a467a00f5dc",
                                "sense_id": "6daeeb07-71c7-34bd-a8fd-816814b55f7c",
                                "text": "It is a rule, though, that each fabulate, as well as every other narrative that requires credence or pretense or at least the possibility of belief as its ingredient, is based on either a truly existing or an assumed memorate[…] or something similar."
                            }
                        ]
                    },
                    {
                        "sense_id": "37211667-789e-39b6-adbb-c22252bb8e4c",
                        "entry_id": "fe750a84-242c-3951-9c7e-b0a9cef95982",
                        "glosses": [
                            "A folk story that is told for entertainment, and not intended to be taken as true."
                        ],
                        "tags": [
                            "countable",
                            "specifically",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "95d01b74-73fd-42d2-861e-cd922795e939",
                                "sense_id": "37211667-789e-39b6-adbb-c22252bb8e4c",
                                "text": "To jocular fabulates (Sherzfabulate) I place inter alia some of the “Tales of the Stupid Ogre” in Aarne’s Type Register."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
