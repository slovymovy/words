                "senses": [
                    {
                        "sense_id": "f2c97c3b-6185-3927-87ac-082a7b84fde9",
                        "entry_id": "3c1b34ff-a458-3152-a04c-0d3ac2f12e49",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b68c6af-31d8-4064-8447-a78006698781",
                                "sense_id": "f2c97c3b-6185-3927-87ac-082a7b84fde9",
                                "text": "Maryam Touzani, Denis Ménochet, Rungano Nyoni, Brie Larson, Paul Dano, Atiq Rahimi, Damian Szifron et Julia Ducourneau seront invités à exprimer leur avis en toute liberté."
