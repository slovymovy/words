                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
                                        "glosses": [
                                            "Copying of another person's ideas, text, or other creative work, and presenting it as one's own, especially without permission; plagiarizing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36384008-6f88-412e-9b45-a44714b0041c",
                                                "sense_id": "86d7e140-92a1-3e50-a4f0-fdb7fca264a6",
                                                "text": "Even if it's not illegal, plagiarism is usually frowned upon."
                                            },
                                            {
                                                "example_id": "23409f7e-474a-4b6d-bbc2-c25c71b6d79e",
                                                "sense_id": "86d7e140-92a1-3e50-a4f0-fdb7fca264a6",
                                                "text": "Copy from one, it's plagiarism. Copy from two, it's research."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43501afa-cd65-3b10-b3bd-da7284504042",
                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
                                        "glosses": [
                                            "Text or other work resulting from this act."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "439e3962-0918-4554-89a3-b82029ce1294",
                                                "sense_id": "43501afa-cd65-3b10-b3bd-da7284504042",
                                                "text": "The novel was awash in plagiarism, with entire passages lifted verbatim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bbc384f-3b56-339f-8d3c-71fba04f1438",
                                        "entry_id": "11d7a82a-d958-3716-8871-dba60f8a9798",
