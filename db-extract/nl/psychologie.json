                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c72a7b0-d5bf-38ac-bb0e-c28e9a6465dc",
                                        "entry_id": "c73a6759-a436-3700-81f8-6b247c336c44",
                                        "glosses": [
                                            "Wissenschaft von den bewussten und unbewussten psychischen Prozessen, vom Erleben und Verhalten des Menschen in Abhängigkeit von der Umwelt"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd60f6fa-e740-4565-ac29-563400449e69",
                                                "sense_id": "6c72a7b0-d5bf-38ac-bb0e-c28e9a6465dc",
                                                "text": "Ein Studium der Psychologie setzt großes Einfühlungsvermögen und Menschenverständnis voraus."
                                            },
                                            {
                                                "example_id": "714585d1-34e7-4f5a-b62d-1c6d950e841d",
                                                "sense_id": "6c72a7b0-d5bf-38ac-bb0e-c28e9a6465dc",
                                                "text": "Die moderne Psychologie geht zurück auf Wilhelm Wundt, der sie gemeinsam mit einigen seiner Schüler als experimentelle Erfahrungswissenschaft von der Philosophie abkoppelte."
                                            },
                                            {
                                                "example_id": "0592e311-99a3-4104-99a3-8c52801c2ba3",
                                                "sense_id": "6c72a7b0-d5bf-38ac-bb0e-c28e9a6465dc",
                                                "text": "„Die Psychologie weiß, dass Verdrängtes im Verborgenen weiterlebt und unter Umständen wiederkehrt, in Form von Verhaltensstörungen oder Blockaden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95186397-ee31-356f-b3bd-08f40355bdf9",
                                        "entry_id": "c73a6759-a436-3700-81f8-6b247c336c44",
                                        "glosses": [
                                            "die Psyche eines Menschen; das innere, insbesondere geistige Reagieren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff58c7a-1723-4a59-b3a9-0af8e7999178",
                                                "sense_id": "95186397-ee31-356f-b3bd-08f40355bdf9",
                                                "text": "Wenn ich die Psychologie des Computergegners in diesem Computerspiel richtig verstehe, könnte ich eine Taktik aufbauen, um ihm in den Rücken zu fallen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f80b44d2-f43f-3319-81aa-bf73b122b557",
                                        "entry_id": "c73a6759-a436-3700-81f8-6b247c336c44",
                                        "glosses": [
                                            "das Eingehen auf die menschliche Psyche, psychologisches Verständnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b85bcf-c699-4341-9e64-a1c91009984c",
                                                "sense_id": "f80b44d2-f43f-3319-81aa-bf73b122b557",
                                                "text": "In solchen Fällen muss man Fingerspitzengefühl und Psychologie anwenden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "459620f3-2189-421f-8a72-37dca10d5951",
                        "source_entry_id": "c7354e0a-f892-3986-9182-33dcfd8127f2",
                        "source_sense_id": "ef0644dc-0b51-3c25-9f93-6ae194494843",
                        "source_sense_description": "de wetenschap die zich bezighoudt met het onderzoek naar bewustzijnsverschijnselen",
                        "target_lang_word": "psychology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8a4034-35f1-358d-9f40-c4ac75ce275c",
                                        "entry_id": "3a273022-c4ae-3fdb-9f17-57b485594355",
                                        "glosses": [
                                            "The study of the human mind."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a64024d-e5aa-47bc-b78f-039c4e7fed8e",
                                                "sense_id": "ec8a4034-35f1-358d-9f40-c4ac75ce275c",
                                                "text": "Idleness is the beginning of all psychology ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc7c558-1c3e-3b10-a525-3e2a80c6c3ca",
                                        "entry_id": "3a273022-c4ae-3fdb-9f17-57b485594355",
                                        "glosses": [
                                            "The study of human or animal behavior."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57893040-a192-3ef5-8ce1-5df25135b809",
                                        "entry_id": "3a273022-c4ae-3fdb-9f17-57b485594355",
                                        "glosses": [
                                            "The study of the soul."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "944e719c-ba24-41a9-9225-51c150890355",
                                                "sense_id": "57893040-a192-3ef5-8ce1-5df25135b809",
                                                "text": "Alcinous in Didascalius chapter 23 uses the three physical locations of the human soul from Timaeus 69c–72c […] to lead into a dedicated discussion of psychology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e7eb6f-5153-3408-b735-411f615bd54c",
                                        "entry_id": "3a273022-c4ae-3fdb-9f17-57b485594355",
                                        "glosses": [
                                            "The mental, emotional, and behavioral characteristics pertaining to a specified person, group, or activity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449818b8-67d6-478f-8c3e-9d56b22d3431",
                                                "sense_id": "65e7eb6f-5153-3408-b735-411f615bd54c",
                                                "text": "For generations, historians have conjectured everything from a warped psychology to a deformed body as accounting for Elizabeth's preferred spinsterhood..."
                                            },
                                            {
                                                "example_id": "790b02ea-366a-4ce4-ba1b-cabc659316bd",
                                                "sense_id": "65e7eb6f-5153-3408-b735-411f615bd54c",
                                                "text": "In the United States, the psychology of a laborer, a farmer, a businessman does not differ in any important respect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7691f8d3-5bd2-4d94-a004-8ea2e9affef6",
                        "source_entry_id": "c7354e0a-f892-3986-9182-33dcfd8127f2",
                        "source_sense_id": "ef0644dc-0b51-3c25-9f93-6ae194494843",
                        "source_sense_description": "de wetenschap die zich bezighoudt met het onderzoek naar bewustzijnsverschijnselen",
                        "target_lang_word": "psychologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                        "entry_id": "9cb2acf6-a4e3-3734-884a-1731ceaa0dba",
                                        "glosses": [
                                            "Étude scientifique des phénomènes psychiques."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291d9af4-2d5b-417b-9247-5aea846e2e61",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "Soit qu'on envisage la psychologie ou la physique générale de Descartes, on y trouve la même faute."
                                            },
                                            {
                                                "example_id": "aec13e75-63ff-4fb3-8189-4b1b8ea01c40",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "J’aurais dû vous le dire plus tôt : pour la psychologie, il n’y a guère d’employable que la femme jeune et gentille ; ça au moins c’est consistant et ça rend sous la plume !"
                                            },
                                            {
                                                "example_id": "94ad2f3c-da48-42b6-a0aa-19110e4e7409",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "Pavlov ne s'est pas borné à abdiquer simplement la psychologie en tant que science. Il voyait naître en lui le sentiment d'hostilité irréconciliable envers cette « alliée de la physiologie » qui n'a pas fait ses preuves."
                                            },
                                            {
                                                "example_id": "01b41f30-dc02-4c87-a25f-03329ce055a9",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "À la Sorbonne, personne ne suivait les cours de sociologie, ni ceux de psychologie, tant ils nous semblaient insipides."
                                            },
                                            {
                                                "example_id": "82accbd7-52d8-4f22-95f4-2e60b27f2adb",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                                            },
                                            {
                                                "example_id": "e7e3bb20-302b-41ba-8dcc-06de0d1582fc",
                                                "sense_id": "9a21f9a4-b258-3023-9ba6-7d6728a9f89b",
                                                "text": "J’ai moi-même été militant marxiste-léniniste et j’ai pourtant produit une thèse en anthropologie biologique en recourant au paradigme de la sociobiologie et de la psychologie évolutionniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33bafce-a218-3784-8e61-46e395de7a14",
                                        "entry_id": "9cb2acf6-a4e3-3734-884a-1731ceaa0dba",
                                        "glosses": [
                                            "Série d’états d’âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6669e9de-4df1-449a-9ee0-6005f1651142",
                                                "sense_id": "f33bafce-a218-3784-8e61-46e395de7a14",
                                                "text": "Ce romancier excelle à analyser la psychologie féminine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcfb1711-e804-342e-8227-10fcb409c6f0",
                                        "entry_id": "9cb2acf6-a4e3-3734-884a-1731ceaa0dba",
                                        "glosses": [
                                            "Capacité à se rendre compte des sentiments humains."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d992573f-5588-43e6-bc03-fffe9b9dbc9a",
                                                "sense_id": "dcfb1711-e804-342e-8227-10fcb409c6f0",
                                                "text": "— On a toujours fait pour le bien ! leur psychologie du racoleur leur ayant depuis longtemps appris que celui-ci interprétait toujours le « bon côté » et le « bien » comme étant sa façon de voir à lui et d’agir."
                                            },
                                            {
                                                "example_id": "3f9947a9-1ed6-4786-955a-97842e4bfbe7",
                                                "sense_id": "dcfb1711-e804-342e-8227-10fcb409c6f0",
                                                "text": "Comme beaucoup d’esprits médiocres et qui ont lu quelques romans, le capitaine se piquait de ce qu’ils nommait psychologie et s’amusait à observer les gens de son entourage. Il s’accordait à lui-même de la pénétration et ne doutait pas qu’au bout de quelques jours il pût trouver, pour employer une expression qu’il aimait bien, la formule des personnes qu’il examinait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
