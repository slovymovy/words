                "entry_id": "4fb16d35-f77e-334e-8303-a00ecb853060",
                "word": "omnibenevolent",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ca03178-2917-3fb3-b701-6ffdb9532680",
                        "entry_id": "4fb16d35-f77e-334e-8303-a00ecb853060",
                        "glosses": [
                            "All-loving, or infinitely good, usually in reference to a deity or supernatural being, for example, God."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f9408dce-5511-4428-adc9-2e9a178f1076",
                                "sense_id": "4ca03178-2917-3fb3-b701-6ffdb9532680",
                                "text": "The omnibenevolent God, by definition, was unable to withhold forgiveness from his people."
                            },
                            {
                                "example_id": "7d491b4c-8484-4067-bf05-b85a8cf286f4",
                                "sense_id": "4ca03178-2917-3fb3-b701-6ffdb9532680",
                                "text": "Any omnibenevolent being would will the complete and immediate nonexistence of evil."
                            }
                        ]
                    }
                ],
                "translations": [
