                        "cross_references": [
                            {
                                "target_word": "Altar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                        "entry_id": "4a66df12-f978-3ffb-9ff1-fc4218655b0a",
                                        "glosses": [
                                            "tischähnliche Einrichtung (zum Beispiel in einer Kirche) zur Feier eines Gottesdienstes, zur kultischen Verehrung oder für das Abhalten von Ritualen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8ec55b-2778-49c8-9baf-3c96c4a0a84c",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "Viele Gaben waren am Altar vorbereitet."
                                            },
                                            {
                                                "example_id": "2d4a6e2c-7629-4b80-a7ee-3eddc121904f",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Anmutig zum Klang von Panflöten tanzend, brachte er vor dem Altar Opfer dar.“"
                                            },
                                            {
                                                "example_id": "9153eb8e-3148-49ee-8317-e59a23ae6e0d",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Neben dem Altar ist eine Replik des Bischofsstabs ausgestellt.“"
                                            },
                                            {
                                                "example_id": "57ab8671-2ad6-4a0a-a475-805fa9a5e354",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Kurator und Senat der Universität empfingen den Trauerzug am Kircheneingang; der Sarg wurde auf einem Katafalk vor dem Altar aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
