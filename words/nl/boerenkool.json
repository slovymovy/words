                    "sense_id": "5563aaea-b4a2-3290-ae10-dab2f509cc70",
                    "sense_definition": "Een koolsoort met sterk gekrulde, groene bladeren die als groente wordt gegeten (boerenkoolplant).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "groente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter oogsten we verse <w>boerenkool</w> uit onze eigen moestuin.",
                            "target_lang_translations": {
                                "en": "In winter, we harvest fresh <w>kale</w> from our own vegetable garden."
                            }
                        },
                        {
                            "text": "De <w>boerenkool</w> groeit het beste als er een nacht vorst overheen is gegaan.",
                            "target_lang_translations": {
                                "en": "The <w>kale</w> grows best after a night of frost has passed over it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verse boerenkool"
                    ],
                    "target_lang_definitions": {
                        "en": "A type of cabbage with strongly curled, green leaves that is eaten as a vegetable (kale plant)."
                    },
