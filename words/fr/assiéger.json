            "senses": [
                {
                    "sense_id": "9a55bf17-cdc4-332b-8892-828f3bdf229e",
                    "sense_definition": "Encercler une ville ou une place forte avec des troupes militaires pour la contraindre à capituler.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée ennemie a décidé d'<w>assiéger</w> la capitale pendant plusieurs mois."
                        },
                        {
                            "text": "Les troupes ont fini par <w>assiéger</w> le château médiéval pour forcer les défenseurs à se rendre."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "cerner",
                        "investir"
                    ],
                    "common_phrases": [
