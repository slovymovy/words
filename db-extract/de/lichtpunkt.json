                "senses": [
                    {
                        "sense_id": "fe681dd0-7979-3b60-93db-95c78a7d762a",
                        "entry_id": "52354c40-05dd-396f-97a3-1dcbf51cec39",
                        "glosses": [
                            "durch einen Lichtstrahl entstandene punktförmige Erscheinung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f61202f-072b-4a83-86ef-ce072841b601",
                                "sense_id": "fe681dd0-7979-3b60-93db-95c78a7d762a",
                                "text": "„An der echten Seite des Herkules kann man in dunklen Nächten einen schwachen Lichtpunkt erkennen – den Kugelsternhaufen Messier 13.“"
                            },
                            {
                                "example_id": "a0ff51da-c861-40b7-b651-53fa62bd081e",
                                "sense_id": "fe681dd0-7979-3b60-93db-95c78a7d762a",
                                "text": "„Bei transparenten Vorlagen (z. B. Dia, Film) wird das Bild mithilfe eines von einer Kathodenstrahlröhre erzeugten Lichtpunkts entsprechend dem Fernsehraster zeilenweise abgetastet und mit einer Fotozelle in ein elektrisches Signal umgewandelt.“"
                            },
                            {
                                "example_id": "e8230894-0dc3-4054-bafe-dda9cf7a8ad2",
                                "sense_id": "fe681dd0-7979-3b60-93db-95c78a7d762a",
                                "text": "„Während man im volkstümlichen Sprachgebrauch alles als »Sterne« bezeichnet, was man in einer klaren Nacht als Lichtpunkte am Himmel beobachtet, sind für den Astronomen Sterne im engeren Sinn selbständig leuchtende Himmelskörper, die durch Verschmelzung von leichteren zu schwereren Atomkernen Energie erzeugen.“"
                            },
                            {
                                "example_id": "58e5da3d-861d-4100-87e1-e34c784558fa",
                                "sense_id": "fe681dd0-7979-3b60-93db-95c78a7d762a",
                                "text": "„Lichtpunkte leuchten in Gelb, Weiß, Rot, die meisten stehen still, nur wenige bewegen sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d75cb442-ebdb-3f07-aaf1-4605b3386ae8",
                        "entry_id": "52354c40-05dd-396f-97a3-1dcbf51cec39",
                        "glosses": [
                            "wenn auch kleiner, so doch positiver Aspekt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1302ac3b-2821-4068-a265-a58a328ce1c8",
                                "sense_id": "d75cb442-ebdb-3f07-aaf1-4605b3386ae8",
                                "text": "Zumindest der geplante Ausflug war ein Lichtpunkt am Horizont."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
