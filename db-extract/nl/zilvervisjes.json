                            "insecten"
                        ],
                        "examples": [
                            {
                                "example_id": "51c76049-9239-4792-a121-86d805f3abad",
                                "sense_id": "50227bd5-31b4-3ca4-a63b-2f9475cc92aa",
                                "text": "Amerikaanse biologen hebben maar liefst 27 nieuwe soorten spinnen, duizendpoten en zilvervisjes ontdekt in onderaardse grotten in de Sequoia en Kings Canyon Nationale Parken in de Amerikaanse staat Californië."
                            }
                        ]
                    },
                    {
