                    "sense_definition": "To add together to find the total number or amount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_add",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer program <w>sums</w> the data automatically.",
                            "target_lang_translations": {
                                "ru": "Компьютерная программа <w>суммирует</w> данные автоматически.",
                                "zh": "计算机程序会自动将数据<w>相加</w>。"
                            }
                        },
                        {
                            "text": "We need to <w>sum</w> the expenses before submitting the report.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сложить</w> расходы перед подачей отчета.",
                                "zh": "在提交报告之前，我们需要把费用<w>汇总</w>一下。"
                            }
