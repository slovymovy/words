                "senses": [
                    {
                        "sense_id": "ae883d78-5e7e-34a5-85e8-d782bb4402d2",
                        "entry_id": "9f21dd3c-027f-36cf-9a30-f7c6b9306e1a",
                        "glosses": [
                            "Langue romane parlée en Italie dans la région du Frioul-Vénétie Julienne et à Portogruaro en Vénétie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c7d529-0eed-4535-bd6e-a8877a673099",
                                "sense_id": "ae883d78-5e7e-34a5-85e8-d782bb4402d2",
                                "text": "Le frioulan offre encore exactement la forme tchavéli au sing., voy. Gartner, Gram., p. 169. C’est un de ces pluriels que les Italiens appelleraient « fossilizzati » et qui s’emploient pour les deux nombres."
                            }
                        ]
                    }
                ],
