                    {
                        "sense_id": "a2b3221c-630c-3891-953d-789fb929084e",
                        "entry_id": "c2209b1d-9aa8-387f-b88e-8537ee6722d2",
                        "glosses": [
                            "Ancien nom de la commune française Chaumont-en-Vexin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e2971521-bdf5-3cb1-b650-4694d2b2b530",
                        "entry_id": "c2209b1d-9aa8-387f-b88e-8537ee6722d2",
                        "glosses": [
                            "Forme brève du nom de la commune de Chaumont-sur-Loire, commune française située dans le département du Loir-et-Cher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b667d9f9-a4c0-4f51-b6fa-a1df73ab1c31",
                                "sense_id": "e2971521-bdf5-3cb1-b650-4694d2b2b530",
                                "text": "À Chaumont, nous nous sommes promenés sur les bords de la Loire. Le vent chassait d’immenses nuages blancs dans un ciel bleu clair. Le fleuve d’un bleu qui tournait au noir s’argentait par endroits, en longues striures parallèles, là où le soleil frappait l’eau."
                            },
                            {
                                "example_id": "e5fe5d69-1946-46fe-9221-d60a346e4e76",
                                "sense_id": "e2971521-bdf5-3cb1-b650-4694d2b2b530",
                                "text": "Le château de Chaumont-sur-Loire et les terres avoisinantes faisant partie de la propriété."
                            },
                            {
                                "example_id": "23222ad4-0bf1-47ca-aabd-cb37a13d971d",
                                "sense_id": "e2971521-bdf5-3cb1-b650-4694d2b2b530",
                                "text": "Catherine de Médicis acquiert Chaumont en 1550 pour chasser, mais surtout pour les revenus qu'il générait."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a37898a-a00c-3b92-a36c-f07080292d6e",
                        "entry_id": "c2209b1d-9aa8-387f-b88e-8537ee6722d2",
                        "glosses": [
                            "Chef-lieu de l'ancienne commune de Chaumont-Saint-Quentin, et, depuis 1828, hameau de la commune de Noyers-Pont-Maugis, dans le département des Ardennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff048494-21d8-4ea3-8c5d-e80d28daf98a",
                                "sense_id": "3a37898a-a00c-3b92-a36c-f07080292d6e",
                                "text": "Ce ne fut donc que le 6, à 8 heures du matin, que l'armée royale quitta Remilly. […]. Elle vint donc passer au-dessus de Thelonne, s'acheminant vers Chaumont et le bois de la Marphée."
                            },
                            {
                                "example_id": "6ac16941-7746-4d7d-9e46-2689fcfa9e09",
                                "sense_id": "3a37898a-a00c-3b92-a36c-f07080292d6e",
                                "text": "Chaumont et la ferme Saint-Quentin sont évacués vers 18 heures; plus au sud, cependant, les brigades se maintiennent au prix d'une lutte sévère devant Thélonne et la ferme de Beau-Ménil où, à 19 heures, la 32ᵉ parvient à repousser une attaque menée à la baïonnette."
                            },
                            {
                                "example_id": "e7393a8c-4200-4018-b6f3-c9bf53164bd3",
                                "sense_id": "3a37898a-a00c-3b92-a36c-f07080292d6e",
                                "text": "- le 26/8, les Allemands traversent la Meuse à Donchery et contournent la Marfée ; des Français sont tués à Chaumont par des tirs français ; d'autres, en reculant, pillent Thélonne,\n- le 27/8 c'est la bataille de la Marfée proprement dite, les Français sont attaqués par des mitrailleuses arrivées pendant la nuit ; il y a plusieurs assauts, faisant des milliers de morts ; les allemands reculent jusqu'à la Meuse ; puis finalement Noyers, Thélonne et Chaumont sont pris et les Allemands y commencent le pillage."
                            }
                        ]
                    }
