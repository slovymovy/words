                                "example_id": "ed0a7407-07ff-41bb-bb7c-98359f7d031d",
                                "sense_id": "c389ba26-7051-3385-a123-3f0e6d06dc29",
                                "text": "1999, Kant (Guyer and Wood trans.), Critique of Pure Reason, Cambridge University Press.\nHence pure reason is that which contains the principles for cognizing something absolutely a priori. An organon of pure reason would be a sum total of those principles."
                            }
                        ]
                    },
                    {
                        "sense_id": "75a9df67-d9a9-31cc-accb-10892576550d",
                        "entry_id": "5334ee5d-b4a0-32b3-b0c5-9c8108277868",
                        "glosses": [
                            "The name given by Aristotle's followers to his six works on logic."
                        ],
                        "tags": [],
                        "examples": [
                            {
