                                "example_id": "03c234b1-a415-4b4d-bc1c-de848d3f6213",
                                "sense_id": "9c41548b-dc93-30bb-bf4c-3f2fba765b5c",
                                "text": "Adjuvanter un mortier ou du béton"
                            },
                            {
                                "example_id": "46a30a0d-ea00-43f1-b774-54a557c8134f",
                                "sense_id": "9c41548b-dc93-30bb-bf4c-3f2fba765b5c",
                                "text": "ne pas adjuvanter ni hydrofuger."
                            }
                        ]
