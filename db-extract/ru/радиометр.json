                    {
                        "translation_id": "13aafdc7-011a-41bc-98a1-aa84787c8f79",
                        "source_entry_id": "c9d22cd9-4cc7-3088-800a-d7114248c842",
                        "source_sense_description": "прибор для измерения параметров излучения, лучистой энергии",
                        "target_lang_word": "radiomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                        "entry_id": "d32e6d6c-853f-3014-ab9d-7854615d1fd3",
                                        "glosses": [
                                            "Instrument de mesure de l'intensité du flux de rayonnement électromagnétique, dans différentes longueurs d'onde telles que l'ultraviolet, la lumière visible ou l'infrarouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b067a282-7f94-4772-9e2a-f1c95b58d5ad",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Supposons un radiomètre observant un corps plan lambertien isotherme et considérons que θ et θ’ sont dans le même plan. L est la luminance intégrée dans la bande spectrale du radiomètre."
                                            },
                                            {
                                                "example_id": "ed2502e8-32b4-43f8-bc19-d10689668f28",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Ils avaient brûlé ce qu’ils avaient adoré : les miroirs de sorcière, les billots, les stupides petits mobiles, les radiomètres, les cailloutis multicolores, les panneaux de jute agrémentés de paraphes à la Mathieu."
                                            },
                                            {
                                                "example_id": "62c2cb86-f081-4a31-8c00-bb2e9c134adb",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Les radiomètres sont utilisés en météorologie pour mesurer avec précision le contenu en vapeur d'eau et en eau liquide de l'atmosphère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
