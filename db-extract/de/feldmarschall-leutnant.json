                    },
                    {
                        "sense_id": "c5f2e58f-ebe5-37d4-bb5d-4c1fe88879d0",
                        "entry_id": "f57c88d3-90a5-3eb8-91b9-481542bebf60",
                        "glosses": [
                            "Generalsdienstgrad der kaiserlichen (später österreichischen) Truppen",
                            "Zweithöchster Dienstgrad, hinter dem Feldzeugmeister oder dem General (Zusatz der Waffengattung)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "53124bb1-ff82-4045-ad9c-499ccfc47465",
                                "sense_id": "c5f2e58f-ebe5-37d4-bb5d-4c1fe88879d0",
                                "text": "„General v. Brentano wird zum Feldmarschall-Leutnant vorgeschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "f01894ec-67ca-300c-99f0-1492f1b8d4ba",
                        "entry_id": "f57c88d3-90a5-3eb8-91b9-481542bebf60",
                        "glosses": [
                            "Generalsdienstgrad der kaiserlichen (später österreichischen) Truppen",
                            "Dritthöchster Dienstgrad, hinter dem Generaloberst"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "0abc33b6-2d88-34fe-a32a-4140e0467d2d",
                        "entry_id": "f57c88d3-90a5-3eb8-91b9-481542bebf60",
                        "glosses": [
                            "General im Range eines Feldmarschall-Leutnants"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1e0ea869-f714-44e3-a19a-7355cc9e7729",
                                "sense_id": "0abc33b6-2d88-34fe-a32a-4140e0467d2d",
                                "text": "„Feldmarschall-Leutnant von Nagy sprengt auf seinem Rosse vor die Mannschaft und erinnert mit guten Worten an Eid und Pflicht.“"
                            },
                            {
                                "example_id": "93969522-ff27-45d4-a8a3-e1fae6abaece",
                                "sense_id": "0abc33b6-2d88-34fe-a32a-4140e0467d2d",
                                "text": "„Die ‚Friedensvettel‘, die Alfred Nobelzur Gründung des Nobelpreises anregte und die selber 1905 den Friedensnobelpreis erhielt, war übrigens eine geborene Gräfin Kinsky, Tochter eines k.u.k. Feldmarschall-Leutnants; mütterlicherseits stammte sie aus der Familie des deutschen Freiheitskämpfers Theodor von Körner.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
