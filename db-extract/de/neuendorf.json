                        "entry_id": "beecf11b-2bf3-3d01-942b-8b3da1ddc5fe",
                        "glosses": [
                            "ein linksrheinischer im Norden gelegener Stadtteil von Koblenz am Rhein"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "ba036d0e-ef41-45d5-96d1-43b9360cf40b",
                                "sense_id": "80b0e892-382b-34e3-9870-39576c43b900",
                                "text": "„Wenn auch die großen Planungen der Stadtverwaltung kaum durchführbar waren, so hatte doch eine Reihe kleinerer Betriebe innerhalb und an der Peripherie der Stadt, im Rauental und im Bereich Neuendorf Bedeutung für das Wirtschaftsleben der Stadt gewonnen.“"
                            },
                            {
                                "example_id": "52fb9f32-59fe-4966-97a4-6ac8a790c511",
                                "sense_id": "80b0e892-382b-34e3-9870-39576c43b900",
                                "text": "Der Stadtteil Neuendorf leidet häufig unter dem Rhein- und Moselhochwasser."
                            }
                        ],
