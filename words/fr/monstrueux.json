    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ad7ce68-415e-3b45-8186-4971143aa7d4",
                    "sense_definition": "Qui choque profondément la conscience morale par son caractère révoltant, cruel ou injuste.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce criminel a commis un acte <w>monstrueux</w> qui a profondément choqué toute la population."
                        },
                        {
                            "text": "Il serait absolument <w>monstrueux</w> d'abandonner ces familles sans aucune assistance."
                        }
                    ],
                    "synonyms": [
                        "abominable",
                        "atroce",
                        "inhumain",
                        "odieux"
                    ],
                    "antonyms": [
                        "normal",
                        "rassurant"
                    ],
                    "common_phrases": [
                        "acte monstrueux",
                        "crime monstrueux"
                    ]
                },
                {
                    "sense_id": "7fa8e8d6-a14e-3a5b-81af-245c1b925970",
                    "sense_definition": "Qui dépasse excessivement la mesure ordinaire par son ampleur, sa puissance ou sa taille.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vague <w>monstrueuse</w> a déferlé sur le port pendant la tempête nocturne."
                        },
                        {
                            "text": "La rénovation complète de ce bâtiment nécessite une somme <w>monstrueuse</w> d'argent."
                        }
                    ],
                    "synonyms": [
                        "effroyable",
                        "terrible"
                    ],
                    "antonyms": [
                        "normal"
                    ],
                    "common_phrases": [
                        "somme monstrueuse",
                        "vague monstrueuse"
                    ]
                },
                {
                    "sense_id": "efe19caa-4366-3214-92e2-2d4deb3fc5e4",
                    "sense_definition": "Qui présente une difformité physique anormale, effrayante ou qui rappelle celle d'un monstre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les contes anciens, une créature <w>monstrueuse</w> terrorisait les habitants de la vallée."
                        },
                        {
                            "text": "Ce poisson des abysses possède une tête <w>monstrueuse</w> garnie de crocs acérés."
                        }
                    ],
                    "synonyms": [
                        "affreux",
                        "anormal",
                        "difforme",
                        "répugnant"
                    ],
                    "antonyms": [
                        "beau",
                        "charmant",
                        "normal"
                    ],
                    "common_phrases": [
                        "animal monstrueux",
                        "créature monstrueuse"
                    ]
                }
            ]
        }
    ]
