                "senses": [
                    {
                        "sense_id": "dd8e78e4-387c-383b-b0f5-e2584ba64b17",
                        "entry_id": "ea9f973e-1a9b-30f2-a601-1a161736f490",
                        "glosses": [
                            "Deserving compassion or pity."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6260ca7f-b323-4828-8d96-babbdedd34f2",
                                "sense_id": "dd8e78e4-387c-383b-b0f5-e2584ba64b17",
                                "text": "1585, Robert Parsons, A Christian Directorie Guiding Men to their Saluation, Rouen: Fr. Parson’s Press, Part 1, Chapter 8,\nHe spared him not […] euen then, when he beheld him sorowful vnto death, and bathed in that agonie of blood and water, when he hard him vtter thos most dolorous and compassionable speeches, O my father, if it be possible, let this cuppe passe from me."
                            },
                            {
                                "example_id": "41a98e1f-00db-4aea-aaab-238eb69019e3",
                                "sense_id": "dd8e78e4-387c-383b-b0f5-e2584ba64b17",
                                "text": "[…] a good Judg […] should tender the Parties Case as compassionable, and desire that he may be delivered from the evil threatning him;"
                            },
                            {
                                "example_id": "2c39af1e-3599-469b-9cae-8e7f31aa1431",
                                "sense_id": "dd8e78e4-387c-383b-b0f5-e2584ba64b17",
                                "text": "The following interview between Juliet and her parents places her in a very compassionable situation;"
                            },
                            {
                                "example_id": "5ee45fa9-ea27-48c7-9bb6-3d3b7e128f81",
                                "sense_id": "dd8e78e4-387c-383b-b0f5-e2584ba64b17",
                                "text": "A man of this kind, on an enforced holiday, is a very compassionable object."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab5997cd-f2b7-3a47-bc8c-d7f763f77277",
                        "entry_id": "ea9f973e-1a9b-30f2-a601-1a161736f490",
                        "glosses": [
                            "Having, feeling, or showing compassion."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d220a8a9-4f25-4c9d-ac01-5fd2c2171041",
                                "sense_id": "ab5997cd-f2b7-3a47-bc8c-d7f763f77277",
                                "text": "1536, uncredited translator (attributed to Miles Coverdale), A Myrrour or Glasse for them that be Syke [and] in Payne by Guglielmus Gnaphaeus, London: Ian Gough,\nCan not thynke ye the poore haue a mercifull, and compassionable harte towarde the, that be in pouerte, & anguysshe, though theyr power can not extende to declare it?"
                            },
                            {
                                "example_id": "3d15f83c-28e8-4603-a3b0-1165a3878a57",
                                "sense_id": "ab5997cd-f2b7-3a47-bc8c-d7f763f77277",
                                "text": "1625, Samuel Purchas, Purchas His Pilgrimes, Part 2 in Five Books, London: Henry Fetherstone, “Præritorum, or Discoveries of the World,” Chapter 13, p. 1843,\n[…] they in reuenge pulled mee by the heeles from the horse backe, beating me most pittifully, and left mee almost for dead […] and if it had not beene for some compassionable Greekes, who by accident came by and relieued me, I had (doubtlesse) immediately perished."
                            }
                        ]
                    }
