                "senses": [
                    {
                        "sense_id": "c1bbb5a1-09a4-371b-bc6b-63087c9394de",
                        "entry_id": "7757caf8-f870-3a1d-b918-868a2eb814d5",
                        "glosses": [
                            "vorlaute, polternde, zuweilen antagonistische Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169daf80-56e2-4d8b-9048-ff45438306f3",
                                "sense_id": "c1bbb5a1-09a4-371b-bc6b-63087c9394de",
                                "text": "„Es waren heilige Narren, Geiferer, Gottbesessene, welche aus ihrer Gabe, in schäumendem Zustande wahrzusagen, ihren Lebensunterhalt gewannen, – Orakellaller, die, umherziehend oder von der Kundschaft in Felsenhöhlen besucht, für allerlei Tagwählerei und Anzeige des Verborgenen Lebensmittel und Geldeswert einstrichen.“"
                            },
                            {
                                "example_id": "cdacacba-c9df-4654-9262-4388539d1beb",
                                "sense_id": "c1bbb5a1-09a4-371b-bc6b-63087c9394de",
                                "text": "„Doch Josephs Träume, das fühlte der Alte, konnten es brauchen, in genaue Zucht genommen zu werden durchs Buchstäblich-Vernünftige, – das konnte zur Festigung seiner Schwankheit segensreich beitragen, und mit gehörnten Nacktläufern und Geiferern würde er, der Gebildete, keine Ähnlichkeit haben.“"
                            }
                        ],
