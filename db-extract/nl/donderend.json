                            {
                                "example_id": "8e09fac3-78b2-4cb9-8f74-29665bb72415",
                                "sense_id": "409b0b55-9b06-3fba-a87b-aad884e3ef8d",
                                "text": "VVD’ers applaudisseren het hardst. Ze petsen de weldoorvoede handen tegen elkander in een donderende ovatie."
                            },
                            {
                                "example_id": "6a74686d-0b42-49f5-8c40-d69dab34aaa0",
                                "sense_id": "409b0b55-9b06-3fba-a87b-aad884e3ef8d",
                                "text": "Breed lachend verscheen de Amerikaanse legende Patti Smith twee weken terug in Paradiso. Tot ze een toeschouwer met z'n mobieltje zag filmen: 'Vertrekken, asshole!' Op haar 71ste is Smith nog weinig van haar punkmentaliteit kwijt. En ook niet van haar vocale kracht, zo bewees ze met donderende versies van Because the Night en People Have the Power. Benieuwd hoe de jongste generatie Lowlandsgangers de kennismaking met Godmother of Punk bevalt."
                            }
                        ]
                    }
