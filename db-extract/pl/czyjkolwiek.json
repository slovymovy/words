                                                "example_id": "fc91e398-3931-4f61-a15a-e8c2fa102298",
                                                "sense_id": "1f5032b6-60f3-39df-92d4-ef96c753870a",
                                                "text": "\"And she is not wholesome, whosever word it was. She was there, hanging about him when he was so bad, before the worst came.\""
                                            }
