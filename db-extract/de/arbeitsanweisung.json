                "senses": [
                    {
                        "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                        "entry_id": "43dc6f9a-6bfc-39be-a58d-6ae56587de54",
                        "glosses": [
                            "Vorgabe/Erklärung, wie bestimmte Aufgabe oder Arbeit ausgeführt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2215c97-7ee4-495c-bd22-d57748948288",
                                "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                                "text": "„In der Arbeitsanweisung wurde angegeben und visuell dargestellt, dass bei einer Verschraubung eine Mutter mit einer gewissen Höhe verwendet werden musste.“"
                            },
                            {
                                "example_id": "67ed1473-0eb9-4f06-8f90-78fdcfc53610",
                                "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                                "text": "„Wenn die Gruppenarbeit angekündigt wird, erfolgt wieder die Erklärung der Arbeitsanweisung, welche wieder, wie in den anderen Beispielen, geteilt wird.“"
                            },
                            {
                                "example_id": "f8e41298-2fd8-4f60-b1a3-2cab9619434d",
                                "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                                "text": "„Die Verarbeitung der Daten geschieht nach einer bestimmten zweckdienlichen Arbeitsanweisung.“"
                            },
                            {
                                "example_id": "377cdb7c-76cd-40c5-a97e-4eaa2152f083",
                                "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                                "text": "„Die Arbeitsanweisung beschreibt, wie eine eindeutig festzulegende Tätigkeit ausgeführt wird und enthält die Anweisung, die delegierte Tätigkeit in der beschriebenen Weise durchzuführen.“"
                            },
                            {
                                "example_id": "3e24d7d3-4e3e-4e97-8b21-7ebd3c0e8c52",
                                "sense_id": "332ff65a-27ea-3531-8f23-06914f995740",
                                "text": "„Eloise lässt sich von ihrer Nachbarin die Arbeitsanweisung auf der nächsten Seite vorlesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
