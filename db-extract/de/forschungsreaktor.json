                "senses": [
                    {
                        "sense_id": "80f3cfbb-345a-3ac3-a911-b70520753758",
                        "entry_id": "a785666b-e9a8-3350-8b34-43841f56dc7f",
                        "glosses": [
                            "Kernreaktor, der Forschungszwecken und der Erzeugung von Radionukliden für Medizin und Technik dient"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "4f9d72fc-e6a2-43ee-81f3-a47070f5b5fb",
                                "sense_id": "80f3cfbb-345a-3ac3-a911-b70520753758",
                                "text": "„Der Forschungsreaktor München (FRM) in Garching bei München wurde am 31. Oktober 1957 als erster Forschungsreaktor in Deutschland in Betrieb genommen.“"
                            },
                            {
                                "example_id": "fff5540c-b8cc-4026-ab13-53d0ff13e4e8",
                                "sense_id": "80f3cfbb-345a-3ac3-a911-b70520753758",
                                "text": "„Ein Schwimmbadreaktor (auch Swimmingpool-Reaktor oder Wasserbeckenreaktor) ist ein Forschungsreaktor, dessen Reaktorkern sich in einem mehrere Meter tiefen, nach oben offenen Wasserbecken befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
