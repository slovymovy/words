                                                "example_id": "a3b8aa58-f11c-4aec-b0e5-b71ae56b8b2a",
                                                "sense_id": "9ac848cb-6dc9-3532-b2b2-bcb915a78a9d",
                                                "text": "In den Stätten der Zwerge fand man unzählige Schmieden in denen die schärfsten und größten Äxte des gesamten Landes geschmiedet wurden."
                                            },
                                            {
                                                "example_id": "4207d6d9-294d-4f01-b9d9-bf8428d8026a",
                                                "sense_id": "9ac848cb-6dc9-3532-b2b2-bcb915a78a9d",
                                                "text": "„Den Besuchern schlagen das Dröhnen der Schmieden und der Gestank von Tausend Misthaufen entgegen.“"
                                            }
