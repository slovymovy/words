                "entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                "word": "expressionism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "830f7b1a-cde5-481a-bb07-9fe10c2f7e65",
                        "entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "tags": [
                            "plural"
                        ],
                        "form": "expressionisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af1e8cc9-f5a9-38eb-99ff-fdd3303a937e",
                        "entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "glosses": [
                            "A movement in the arts in which the artist did not depict objective reality, but rather a subjective expression of their inner experiences."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4219fdab-dc03-363b-ab86-1a2d8496e91b",
                        "entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "glosses": [
                            "A somewhat analogous genre in early 20th century music."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86496290-3753-4da0-b0d3-20a41489f239",
                        "source_entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "source_sense_description": "movement in the arts",
