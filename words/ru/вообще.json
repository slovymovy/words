    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fd065654-9943-37a9-835d-72e777738f36",
                    "sense_definition": "В целом, обычно, по отношению к большей части случаев.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Вообще</w> это верно, но бывают и исключения.",
                            "target_lang_translations": {
                                "en": "<w>In general</w>, this is true, but there are exceptions.",
                                "es": "<w>En general</w> es cierto, pero hay excepciones.",
                                "fr": "<w>En général</w>, c'est vrai, mais il y a des exceptions.",
                                "zh": "<w>总的来说</w>这是对的，但也有例外。"
                            }
                        },
                        {
                            "text": "Мне <w>вообще</w> нравится этот город, здесь очень красиво.",
                            "target_lang_translations": {
                                "en": "I <w>generally</w> like this city; it is very beautiful here.",
                                "es": "<w>Por lo general</w> me gusta esta ciudad, es muy hermosa aquí.",
                                "fr": "J'aime <w>généralement</w> cette ville, c'est très beau ici.",
                                "zh": "我<w>通常</w>很喜欢这座城市，这里非常漂亮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в целом",
                        "в общем",
                        "обычно"
                    ],
                    "antonyms": [
                        "в частности"
                    ],
                    "common_phrases": [
                        "вообще говоря"
                    ],
                    "target_lang_definitions": {
                        "en": "In general, usually, regarding the majority of cases.",
                        "es": "En general, usualmente, con respecto a la mayoría de los casos.",
                        "fr": "En général, habituellement, en tenant compte de la majorité des cas.",
                        "zh": "大体上，通常，指大多数情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in general",
                                "target_lang_sense_clarification": "referring to the whole or majority"
                            },
                            {
                                "target_lang_word": "generally",
                                "target_lang_sense_clarification": "usually; as a rule"
                            },
                            {
                                "target_lang_word": "on the whole",
                                "target_lang_sense_clarification": "taking everything into account"
                            },
                            {
                                "target_lang_word": "usually",
                                "target_lang_sense_clarification": "under normal conditions"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "en general",
                                "target_lang_sense_clarification": "refiriéndose al conjunto o a la mayoría"
                            },
                            {
                                "target_lang_word": "por lo general",
                                "target_lang_sense_clarification": "habitualmente; como norma"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en général",
                                "target_lang_sense_clarification": "pour désigner la globalité ou la majorité des cas"
                            },
                            {
                                "target_lang_word": "généralement",
                                "target_lang_sense_clarification": "le plus souvent, comme règle"
                            },
                            {
                                "target_lang_word": "habituellement",
                                "target_lang_sense_clarification": "dans des conditions normales"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总的来说",
                                "target_lang_sense_clarification": "指整体情况"
                            },
                            {
                                "target_lang_word": "通常",
                                "target_lang_sense_clarification": "指一般规律"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "618de755-c1a8-34b2-aadf-0fc6a4e583d3",
                    "sense_definition": "Совсем, совершенно, при любых условиях (часто используется в отрицательных предложениях).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>вообще</w> не понимаю, о чём ты говоришь.",
                            "target_lang_translations": {
                                "en": "I don't understand what you're talking about <w>at all</w>.",
                                "es": "No entiendo <w>en absoluto</w> de lo que estás hablando.",
                                "fr": "Je ne comprends <w>du tout</w> pas de quoi tu parles.",
                                "zh": "我<w>根本</w>听不懂你在说什么。"
                            }
                        },
                        {
                            "text": "У нас сегодня <w>вообще</w> нет времени на отдых.",
                            "target_lang_translations": {
                                "en": "We have <w>absolutely</w> no time for rest today.",
                                "es": "Hoy no tenemos <w>para nada</w> tiempo para descansar.",
                                "fr": "Nous n'avons <w>absolument</w> pas de temps pour nous reposer aujourd'hui.",
                                "zh": "我们今天<w>完全</w>没有时间休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "совсем",
                        "совершенно",
                        "абсолютно",
                        "вовсе",
                        "полностью"
                    ],
                    "common_phrases": [
                        "вообще не",
                        "вообще ничего",
                        "вообще нет"
                    ],
                    "target_lang_definitions": {
                        "en": "At all, completely, under any conditions (often used in negative sentences).",
                        "es": "En absoluto, completamente, bajo cualquier condición (usado frecuentemente en oraciones negativas).",
                        "fr": "Du tout, complètement, sous n'importe quelle condition (souvent utilisé dans des phrases négatives).",
                        "zh": "根本，完全，用于否定句中表示彻底的否定。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at all",
                                "target_lang_sense_clarification": "used with negatives for emphasis"
                            },
                            {
                                "target_lang_word": "absolutely",
                                "target_lang_sense_clarification": "completely; often used with 'no' or 'nothing'"
                            },
                            {
                                "target_lang_word": "altogether",
                                "target_lang_sense_clarification": "completely; entirely"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "en absoluto",
                                "target_lang_sense_clarification": "usado con negaciones para dar énfasis"
                            },
                            {
                                "target_lang_word": "para nada",
                                "target_lang_sense_clarification": "enfático, usado en contextos negativos"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "du tout",
                                "target_lang_sense_clarification": "utilisé avec une négation pour insister"
                            },
                            {
                                "target_lang_word": "absolument",
                                "target_lang_sense_clarification": "complètement, souvent utilisé avec 'pas' ou 'aucun'"
                            },
                            {
                                "target_lang_word": "tout à fait",
                                "target_lang_sense_clarification": "pour renforcer une négation ou une absence totale"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "用于否定句，表示完全不"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "表示程度彻底"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b1999cf-9dd7-3358-9f25-1b8b9f4a2de8",
                    "sense_definition": "Всегда, постоянно, по своей сути (о характерном свойстве человека или предмета).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>вообще</w> очень спокойный и добрый человек.",
                            "target_lang_translations": {
                                "en": "He is <w>generally</w> a very calm and kind person.",
                                "es": "Él es <w>por naturaleza</w> una persona muy tranquila y amable.",
                                "fr": "C'est <w>en général</w> quelqu'un de très calme et gentil.",
                                "zh": "他<w>本来</w>就是一个非常冷静且善良的人。"
                            }
                        },
                        {
                            "text": "Ты <w>вообще</w> любишь читать книги или предпочитаешь фильмы?",
                            "target_lang_translations": {
                                "en": "Do you <w>actually</w> like reading books, or do you prefer movies?",
                                "es": "¿<w>En realidad</w> te gusta leer libros o prefieres las películas?",
                                "fr": "Est-ce que tu aimes <w>vraiment</w> lire des livres ou préfères-tu les films ?",
                                "zh": "你<w>一向</w>喜欢看书还是更喜欢看电影？"
                            }
                        }
                    ],
                    "synonyms": [
                        "всегда",
                        "постоянно",
                        "по сути"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Always, constantly, by nature (regarding a characteristic trait).",
                        "es": "Siempre, constantemente, por naturaleza (referido a un rasgo característico).",
                        "fr": "Toujours, constamment, par nature (concernant un trait de caractère).",
                        "zh": "本质上，一贯地，指人或事物的固有特征。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "generally",
                                "target_lang_sense_clarification": "by nature; characteristically"
                            },
                            {
                                "target_lang_word": "actually",
                                "target_lang_sense_clarification": "in fact; really (used in questions)"
                            },
                            {
                                "target_lang_word": "always",
                                "target_lang_sense_clarification": "at all times; constantly"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por naturaleza",
                                "target_lang_sense_clarification": "característicamente; por su forma de ser"
                            },
                            {
                                "target_lang_word": "en realidad",
                                "target_lang_sense_clarification": "usado en preguntas para indagar sobre la esencia"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en général",
                                "target_lang_sense_clarification": "par nature, de manière caractéristique"
                            },
                            {
                                "target_lang_word": "en fait",
                                "target_lang_sense_clarification": "utilisé dans les questions pour demander la réalité d'un trait"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本来",
                                "target_lang_sense_clarification": "指事物的固有属性"
                            },
                            {
                                "target_lang_word": "一贯",
                                "target_lang_sense_clarification": "指一向如此"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa52ca6c-024b-3cfe-b5e1-b3e563037c95",
                    "sense_definition": "Употребляется для эмоционального усиления сказанного, выражения удивления или возмущения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну ты <w>вообще</w> даёшь, как ты мог такое придумать!",
                            "target_lang_translations": {
                                "en": "You are <w>unbelievable</w>! How could you come up with that?",
                                "es": "¡Es <w>increíble</w> lo que haces, cómo pudiste inventar algo así!",
                                "fr": "Tu es <w>incroyable</w>, comment as-tu pu imaginer une chose pareille !",
                                "zh": "你<w>简直</w>太厉害了，你怎么能想出这种主意！"
                            }
                        },
                        {
                            "text": "Это бесконечное ожидание может <w>вообще</w> свести с ума.",
                            "target_lang_translations": {
                                "en": "This endless waiting can <w>totally</w> drive one crazy.",
                                "es": "Esta espera interminable puede <w>totalmente</w> volver loco a cualquiera.",
                                "fr": "Cette attente interminable peut <w>totalement</w> rendre fou.",
                                "zh": "这种无休止的等待<w>简直</w>能让人发疯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ну ты вообще"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used for emotional emphasis, expressing surprise or indignation.",
                        "es": "Usado para énfasis emocional, expresando sorpresa o indignación.",
                        "fr": "Utilisé pour une emphase émotionnelle, exprimant la surprise ou l'indignation.",
                        "zh": "用于加强语气，表达惊讶、愤怒或感叹。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "totally",
                                "target_lang_sense_clarification": "colloquial intensifier"
                            },
                            {
                                "target_lang_word": "unbelievable",
                                "target_lang_sense_clarification": "used to express shock or surprise"
                            },
                            {
                                "target_lang_word": "completely",
                                "target_lang_sense_clarification": "intensifier for extreme states"
                            }
