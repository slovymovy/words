                "senses": [
                    {
                        "sense_id": "fc3da8fe-1b03-3a30-b77d-5536f79a70d3",
                        "entry_id": "59101582-3ac8-3335-8573-5a3af949e728",
                        "glosses": [
                            "Schüler, der die sechste Klasse besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab951bf3-c48b-46b6-ae9b-e0cbb5d9ca18",
                                "sense_id": "fc3da8fe-1b03-3a30-b77d-5536f79a70d3",
                                "text": "„Er solle die Schule in Sachen Völkerverständigung nach vorn bringen, hieß es dort. Sicherlich wegen dieser Geschichte damals, als ein paar Sechstklässler den Zweitklässler aus Gambia drangsaliert hatten.“"
                            },
                            {
                                "example_id": "0fd0c768-8603-4e5c-90ce-3df9e1d4465b",
                                "sense_id": "fc3da8fe-1b03-3a30-b77d-5536f79a70d3",
                                "text": "„Es fällt auf, dass es zahlreiche Witze gibt, die sich sowohl bei den Kindergärtlern wie auch bei den Sechstklässlern grosser Belebtheit erfreuen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
