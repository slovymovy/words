                ],
                "senses": [
                    {
                        "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                        "entry_id": "46eecfb7-6995-3d34-ad9d-7d9cb98c575a",
                        "glosses": [
                            "technische Anlage, die mechanische Strömungsenergie von Wasser oder Wind in Rotationsenergie an einer Welle umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2c4c6b-fde1-487d-99a2-aa383fb82636",
                                "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                                "text": "„Bei Strömungskraftmaschinen tritt die Primärenergie in Form von potenzieller Energie aus Höhengefällen oder als Enthalpiedifferenz aus Wärmegefällen in die Maschine ein.“"
                            },
                            {
                                "example_id": "fc633cb0-b1b1-43a9-8427-86f82ade40a2",
                                "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                                "text": "„Bei welchem Dreieck (A, B) handelt es sich eine Strömungsarbeitsmaschine und bei welchem um eine Strömungskraftmaschine?“"
                            },
                            {
                                "example_id": "7dd2322e-38ba-4d26-83aa-f620f7ea27ba",
                                "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                                "text": "„Strömungskraftmaschinen: Wasser und Windturbinen wandeln Energie aus Wasser und Wind in elektrische Energie um.“"
                            },
                            {
                                "example_id": "eb8c3cf7-5a9a-452f-bb9e-ffde6fb2677e",
                                "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                                "text": "„Turbine: Strömungskraftmaschine, die einem durchfließenden Medium mechanisch Energie entzieht und diese als Rotationsenergie über Wellen oder Kupplungen an das anzutreibende Aggregat abgibt.“"
                            },
                            {
                                "example_id": "dbae3b65-ffef-4786-b0de-c7ca08fb5c3e",
                                "sense_id": "9463ea97-c8a0-301e-8fc0-6a35ae7f4ac3",
                                "text": "„Bei Strömungskraftmaschinen (Turbinen) entsteht durch die Wirkung von Druck und Geschwindigkeit des Arbeitsmittels auf die Schaufeln des Rotors ein Drehmoment an der Welle, das beispielsweise zum Antrieb eines elektrischen Generators genutzt werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
