                "senses": [
                    {
                        "sense_id": "0c1a9046-8b67-39b0-a28c-30bcba760a74",
                        "entry_id": "f52be9b0-828a-3349-b0fb-97ca6cb85ddf",
                        "glosses": [
                            "besondere Fahrkarte für öffentliche Verkehrsmittel, die Berufstätigen vom Arbeitgeber für die Fahrt von und zur Arbeit vergünstigt überlassen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3dd046b-b6d6-44e9-9c5e-927f623e3111",
                                "sense_id": "0c1a9046-8b67-39b0-a28c-30bcba760a74",
                                "text": "„Jobtickets sind persönliche, nicht übertragbare Abo-Zeitkarten mit monatlicher oder jährlicher Abbuchung vom Privatkonto des Arbeitnehmers.“"
                            },
                            {
                                "example_id": "7a543e5c-6e9f-4a49-b206-d7eefb43749c",
                                "sense_id": "0c1a9046-8b67-39b0-a28c-30bcba760a74",
                                "text": "„Das Jobticket ist ein Angebot der Halleschen Verkehrs-AG (HAVAG) für Arbeitnehmer, die entspannt, schnell und sicher zur Arbeit fahren wollen - ohne Stress, Stau oder lange Parkplatzsuche.“"
                            },
                            {
                                "example_id": "540eda54-c89e-4ed5-b12b-3c36d1064351",
                                "sense_id": "0c1a9046-8b67-39b0-a28c-30bcba760a74",
                                "text": "„Die insgesamt rund 5.400 bisherigen Verträge mit Firmentickets wurden von der SSB auf das neue Jobticket umgestellt.“"
                            },
                            {
                                "example_id": "7ba4e2c9-b032-43e4-9f02-11db2aec9903",
                                "sense_id": "0c1a9046-8b67-39b0-a28c-30bcba760a74",
                                "text": "„Außerdem stellen wir Dir ein Jobticket zur Verfügung, damit Du die Wege in die Firma und zur Schule umweltfreundlich und sicher zurücklegen kannst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
