                                    {
                                        "sense_id": "232da885-9767-3904-933e-568037cbdc3f",
                                        "entry_id": "cc6ceccb-20af-3534-8459-48a5155641f1",
                                        "glosses": [
                                            "Commerçant qui vend des disques ou tout support d’enregistrements sonores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78704cfd-6bc3-4384-888c-37e4f4591fcd",
                                                "sense_id": "232da885-9767-3904-933e-568037cbdc3f",
                                                "text": "À quinze ans ma mère m’a donné\nEn cadeau d’anniversaire\nTout Tchaïkovski dans un coffret\nMoi j’ai couru chez le disquaire\nLe lendemain pour l’échanger […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8e068f-8734-39d2-844a-d58ce85cd4ec",
                                        "entry_id": "cc6ceccb-20af-3534-8459-48a5155641f1",
                                        "glosses": [
                                            "Magasin qui vend des disques et autres enregistrements sonores."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d1ad2e8-af17-4cf9-8c6f-90867156500f",
                                                "sense_id": "4e8e068f-8734-39d2-844a-d58ce85cd4ec",
                                                "text": "Dans l’embrasure des disquaires, des punks à crête iroquoise, bracelets cloutés et blousons transpercés d’épingles à nourrice, sifflent des cannettes de bière en parlant fort."
                                            }
                                        ]
                                    }
