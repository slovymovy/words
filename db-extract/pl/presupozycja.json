                        "sense_id": "4bee1570-9ec6-37be-924b-8955738f5587",
                        "entry_id": "d4155f61-bf83-3dd9-9805-4eef507e2443",
                        "glosses": [
                            "ukryte wstępne założenie, wymagane żeby dane zdanie miało w danym kontekście logiczny sens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b278978c-7e50-4855-838e-25aa557336d5",
                                "sense_id": "4bee1570-9ec6-37be-924b-8955738f5587",
                                "text": "Zdanie \"Czy wolałby pan spotkać się ze mną w środę czy w czwartek?\" zawiera presupozycję \"Pan chciałby się ze mną spotkać\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
