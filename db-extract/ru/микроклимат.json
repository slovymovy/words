                        "source_entry_id": "7b2815bf-ad41-3f0c-beb6-27b88c33641e",
                        "source_sense_description": "климат приземного слоя воздуха на небольшом пространстве, обусловленный особенностями местности",
                        "target_lang_word": "microclimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microclimate",
