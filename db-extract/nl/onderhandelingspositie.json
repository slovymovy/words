                        "sense_id": "7feef0bd-6f20-3855-ab36-4bd385122237",
                        "entry_id": "bf6c1e5c-68fc-3e88-a286-919e0b2ed20e",
                        "glosses": [
                            "de kracht die men heeft om tijdens onderhandelingen het eigen voordeel te kunnen verdedigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24c5841-718c-436f-ad87-19149a923a99",
                                "sense_id": "7feef0bd-6f20-3855-ab36-4bd385122237",
                                "text": "Ten eerste verliep de campagne van het Pragmatieke leger, in het vroege voorjaar van '44, enkele weken al na de breuk van de Barrière in het veld gebracht, dermate rampzalig dat de onderhandelingspositie van de Republiek er nog zwakker door werd dan zij reeds was, en de Franse vredeswil nauwelijks nog te weerstreven was."
                            },
                            {
                                "example_id": "b01c0148-6e23-408d-931f-5be8b8ea60d6",
                                "sense_id": "7feef0bd-6f20-3855-ab36-4bd385122237",
                                "text": "\"Naarmate de vredesonderhandelingen intensiveren, neemt ook het geweld toe\", zegt een hoge VN-vertegenwoordiger. \"Ik roep partijen op niet meer geweld te gebruiken in de hoop dat het hun onderhandelingspositie versterkt.\""
                            }
                        ]
                    }
