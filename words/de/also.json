                        "also dann"
                    ]
                },
                {
                    "sense_id": "b3a4a9ec-2af8-3838-a5fb-c5b9641b8fe7",
                    "sense_definition": "verleiht einer Aussage emotionalen Nachdruck oder drückt Entrüstung aus",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Also</w> wirklich, so eine unverschämte Antwort habe ich von ihm überhaupt nicht erwartet!"
                        },
                        {
                            "text": "Nein, <w>also</w> dieses Essen schmeckt mir heute leider überhaupt nicht gut."
                        }
                    ],
                    "common_phrases": [
                        "also wirklich"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "zur emotionalen Verstärkung in der gesprochenen Sprache"
                        }
                    ]
                }
            ]
        }
