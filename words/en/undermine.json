{
    "word_family": [
        "underminer",
        "undermining"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                    "sense_definition": "To weaken or damage someone or something, especially gradually or insidiously.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant criticism from his manager began to <w>undermine</w> his confidence at work.",
                            "target_lang_translations": {
                                "ru": "Постоянная критика со стороны менеджера начала <w>подрывать</w> его уверенность в себе на работе."
                            }
                        },
                        {
                            "text": "The scandal threatened to <w>undermine</w> authority and lead to calls for a total resignation.",
                            "target_lang_translations": {
                                "ru": "Скандал грозил <w>подорвать</w> авторитет власти и привести к призывам к полной отставке."
                            }
                        }
                    ],
                    "synonyms": [
                        "undercut"
                    ],
                    "antonyms": [
                        "undergird"
                    ],
                    "common_phrases": [
                        "undermine authority",
                        "undermine confidence",
                        "undermine efforts",
                        "undermine credibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослаблять или наносить ущерб кому-либо или чему-либо, особенно постепенно или скрытно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "авторитет, доверие, здоровье"
                            },
                            {
                                "target_lang_word": "подорвать",
                                "target_lang_sense_clarification": "совершить действие, наносящее вред"
                            },
                            {
                                "target_lang_word": "расшатывать",
                                "target_lang_sense_clarification": "делать менее устойчивым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd429e30-0869-36e9-bfb4-08839593dc68",
                    "sense_definition": "To erode the base or foundation of something, such as by the action of water or wind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy floods managed to <w>undermine</w> the foundation of the old bridge.",
                            "target_lang_translations": {
                                "ru": "Сильные наводнения смогли <w>подмыть</w> фундамент старого моста."
                            }
                        },
                        {
                            "text": "The constant flow of the river will <w>undermine</w> riverbanks over many decades.",
                            "target_lang_translations": {
                                "ru": "Постоянное течение реки будет <w>подмывать</w> берега на протяжении многих десятилетий."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrode"
                    ],
                    "common_phrases": [
                        "undermine the foundation",
                        "undermine riverbanks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размывать основание или фундамент чего-либо, например, под воздействием воды или ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмывать",
                                "target_lang_sense_clarification": "о воде: разрушать берег или фундамент"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "разрушать основание"
                            },
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "постепенно уничтожать течением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dba05e8-57aa-3f34-8beb-64edc502f7f8",
                    "sense_definition": "To dig a tunnel or passage underneath something, often for military or destructive purposes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers attempted to <w>undermine</w> the castle walls by digging a secret tunnel.",
                            "target_lang_translations": {
                                "ru": "Солдаты пытались <w>подкопать</w> стены замка, вырыв секретный туннель."
                            }
                        },
                        {
                            "text": "Ancient engineers would <w>undermine</w> a tree to force it to fall in a specific direction.",
                            "target_lang_translations": {
                                "ru": "Древние инженеры могли <w>подрыть</w> дерево, чтобы заставить его упасть в определенном направлении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "undermine the walls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыть туннель или проход под чем-либо, часто в военных или разрушительных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкапывать",
                                "target_lang_sense_clarification": "делать подкоп"
                            },
                            {
                                "target_lang_word": "подкопать",
                                "target_lang_sense_clarification": "проложить ход снизу"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "разрывать землю под чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77422c49-ff76-3254-86a0-628b3c4c0b54",
                    "sense_definition": "In philosophy, to regard an object solely as the sum of the smaller parts that compose it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In object-oriented ontology, to <w>undermine</w> an object is to reduce it to its sub-components.",
                            "target_lang_translations": {
                                "ru": "В объектно-ориентированной онтологии <w>подрывать</w> объект — значит сводить его к его подкомпонентам."
                            }
                        },
                        {
                            "text": "Philosophers often <w>undermine</w> complex entities by focusing only on their physical atoms.",
                            "target_lang_translations": {
                                "ru": "Философы часто <w>редуцируют</w> сложные сущности, сосредотачиваясь только на их физических атомах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical philosophical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В философии: рассматривать объект исключительно как совокупность составляющих его более мелких частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редуцировать",
                                "target_lang_sense_clarification": "сводить сложное к простому"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "в контексте объектно-ориентированной онтологии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}