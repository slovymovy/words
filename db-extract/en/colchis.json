                "forms": [],
                "senses": [
                    {
                        "sense_id": "6587a4f3-b432-3c6f-a3a6-b9d02cc8aca2",
                        "entry_id": "8c97606a-ad09-3447-b7ff-159ded71df5f",
                        "glosses": [
                            "A historical region and ancient Georgian kingdom on the coast of the Black Sea in the South Caucasus on the border between Europe and Asia, corresponding to what is now western Georgia (including Abkhazia), as well as parts of Russia and Turkey."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
