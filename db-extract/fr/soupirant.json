                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "One who pursues someone, especially a woman, for a romantic relationship or marriage; a wooer; one who falls in love with or courts someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2621bbf8-ec3f-4a0c-9df6-4f6c34a1657e",
                                                "sense_id": "83dac2ac-d90c-3207-b00d-e9cec04ab763",
                                                "text": "(Notice that \"Lysias\" begins from the realistic assumption that an attractive young man with many suitors will \"gratify\" one of them, the only question being which. Rightly or wrongly, he treats the question, \"Shall I at all?\" as already resolved.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "A person or organization that expresses an interest in working with, or taking over, another."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3022a34-92e5-4a6e-ab48-4c7b6da5842f",
                                                "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                                "text": "[…] and Mortimer asserted he had no shortage of suitors ready, willing, and able to make acquisition loans […]"
                                            },
                                            {
                                                "example_id": "2eb4b99d-e94b-4ece-baf7-6d8d8a525000",
                                                "sense_id": "546e2a88-a85f-3e0c-b969-6bca69dd0063",
                                                "text": "The Betaville blog wrote earlier this week about market speculation that Adevinta was attracting takeover interest, without naming the suitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e5448d-d0e6-3b0e-b322-beae8736754f",
                                        "entry_id": "28cb1188-460e-3968-8b81-4fb269cfcc48",
                                        "glosses": [
                                            "A party to a suit or litigation."
