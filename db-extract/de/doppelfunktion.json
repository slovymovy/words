                "senses": [
                    {
                        "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                        "entry_id": "51834949-29dd-371c-9418-f3882c42b3e6",
                        "glosses": [
                            "zwei verschiedene Aufgaben / Funktionen / Rollen, die parallel erfüllt werden (beispielsweise von einer Person)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da7878f6-b3f8-49c4-a89a-f8909846df60",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Während der Studentenproteste der 60er-Jahre in Berlin hatte Grünen-Politiker und Jurist Hans-Christian Ströbele stets eine Doppelfunktion: Aktivist und Rechtsvertreter.“"
                            },
                            {
                                "example_id": "5f4ffd13-4677-4018-b086-12469b052430",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "Frau Kamp-Karrenbauer hat eine Doppelfunktion als CDU-Vorsitzende und Verteidigungsministerin."
                            },
                            {
                                "example_id": "7132dd27-cadd-4f97-ad63-43e8592a5ddc",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Seehofers Wort war […] aufgrund seiner Doppelfunktion als CSU-Chef und bayrischer Ministerpräsident von größtem Einfluss.“"
                            },
                            {
                                "example_id": "bab983c3-3a02-424a-92a6-092440cdb7a6",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Herr Gauland […] ist immer noch der mächtige starke Mann in der Partei, auch mit dieser Doppelfunktion als Partei- und Fraktionschef.“"
                            },
                            {
                                "example_id": "19b204d0-f0d3-4170-b516-026e1f9ab33c",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Gusenbauer hatte auf einer Krisensitzung des SPÖ-Präsidiums seine Doppelfunktion als SPÖ-Vorsitzender und Bundeskanzler aufgeben müssen.“"
                            },
                            {
                                "example_id": "03ef575d-4310-46e8-a015-68a66cc40f42",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Der parlamentarische Geschäftsführer der CDU/CSU und Bundestagsabgeordnete Norbert Röttgen hat gestern auf seinen Posten als Geschäftsführer beim Bundesverband der Deutschen Industrie (BDI) verzichtet. An der Doppelfunktion als Mandatsträger und Lobbyist wurde heftige Kritik geübt.“"
                            },
                            {
                                "example_id": "643bdf08-4e16-4e43-8ed4-464eecee6f73",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Spicer arbeitet derzeit in einer Doppelfunktion als Pressesprecher und als Kommunikationschef im Weißen Haus […]“"
                            },
                            {
                                "example_id": "b33ea701-8e1a-4a7f-87fd-511b2afc0bde",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Manfred Hofmann ist leidenschaftlicher Inline-Skater und Mountainbiker. In dieser Doppelfunktion kam der Hobbysportler auf die Idee für seine gedämpften Inline-Skates.“"
                            },
                            {
                                "example_id": "82d5170e-f3b8-4053-a6e4-a40258645f5f",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "[Es war] „eine mutige Entscheidung, den jungen Künstler Barenboim in Doppelfunktion als Pianist und Dirigent zu engagieren.“"
                            },
                            {
                                "example_id": "c993b075-e6de-4024-9c39-637d89e8f868",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Grundsätzlich will Tom Enders den Airbus-Konzern weiter verschlanken. Er klagte immer wieder über viele Doppelfunktionen im Unternehmen, die unter anderem dafür sorgen, dass Entscheidungswege zu lang seien.“"
                            },
                            {
                                "example_id": "7486708d-015f-42cc-8ec5-47e30217a2f2",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Das Alte Testament hat eine Doppelfunktion: Es ist bis heute die Bibel der Juden und zugleich der erste Teil der heiligen Schrift der Christen.“"
                            },
                            {
                                "example_id": "7a7f2dd5-ab93-46d6-ba9e-2e163cacd667",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "Der Pankreassaft der Bauchspeicheldrüse hat eine Doppelfunktion: Er spaltet Nähstoffe der Nahrung auf, damit die später über den Darm aufgenommen werden können, und reguliert unseren Blutzucker."
                            },
                            {
                                "example_id": "bffdf801-3493-4ac9-a0ef-e41a6b64708b",
                                "sense_id": "7a5efccc-c92c-3e89-9173-4df623af1f11",
                                "text": "„Die Forscher haben herausgefunden, dass dieses Kontroll-Protein nicht nur die Pigmentproduktion reguliert, sondern auch das Immunsystem. «Diese Doppelfunktion hat uns sehr überrascht», sagt Melissa Harris.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
