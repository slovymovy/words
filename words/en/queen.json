                                "target_lang_word": "королева",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "царица",
                                "target_lang_sense_clarification": "лидер в своей области"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天后",
                                "target_lang_sense_clarification": "演艺界极具影响力的女性"
                            }
                        ]
