                "senses": [
                    {
                        "sense_id": "ba442be9-7ade-328e-a174-e479f0cddce6",
                        "entry_id": "a4ecb5bb-afea-3cb4-85e1-b6dd7f007959",
                        "glosses": [
                            "menslievend en sociaal behulpzaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7394528-b81a-4da2-ae8c-1971a61f74fb",
                                "sense_id": "ba442be9-7ade-328e-a174-e479f0cddce6",
                                "text": "De documenten onthullen dat de regering van president Vladimir Poetin bij de start van de Russische invasie van Oekraïne in 2022 de opdracht had gegeven om kinderen uit weeshuizen mee te nemen naar Rusland. Dat moest gebeuren onder het mom van \"humanitaire evacuaties\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57571819-70e7-468f-b0fa-2e30992f5b16",
                        "source_entry_id": "a4ecb5bb-afea-3cb4-85e1-b6dd7f007959",
                        "source_sense_id": "ba442be9-7ade-328e-a174-e479f0cddce6",
