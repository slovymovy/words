        "fr-extract.jsonl": [
            {
                "entry_id": "08cf5666-39db-3ea1-9306-d5ea2abfd04a",
                "word": "envahissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ccbb7744-ee8e-44fa-8054-c0ad289e26bb",
                        "entry_id": "08cf5666-39db-3ea1-9306-d5ea2abfd04a",
                        "tags": [
                            "plural"
                        ],
                        "form": "envahissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                        "entry_id": "08cf5666-39db-3ea1-9306-d5ea2abfd04a",
                        "glosses": [
                            "Action d’envahir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a48a9f-22d0-4e0f-978e-c03cd2cb2cba",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "Le véritable et profond caractère du Djehad fut, à son origine, d'être une guerre de propagande et d’envahissement."
                            },
                            {
                                "example_id": "d64686ca-a3bb-4add-865a-266a5b56b079",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "Rien de sublime comme cet envahissement de la saison hivernale, de cette prise de possession des régions hyperboréennes par le froid de l'hiver!"
                            },
                            {
                                "example_id": "a88cb4c8-7c72-4092-8f70-969602e210aa",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "En revenant de son voyage autour du monde, Heyrem s’est occupé d’étudier la question de l’envahissement de la mer à Soulac et à la pointe de Grave."
                            },
                            {
                                "example_id": "f75fb3da-1b01-462a-9de0-144ef4b323a5",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "Les États-Unis ont hérité de l’Angleterre ce système d’envahissement et d’usurpation continuel qui est un des points les plus saillants du caractère britannique."
                            },
                            {
                                "example_id": "1342620d-b2c2-457d-9a35-5848e23088fd",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "[…] ; le petit verre de vin blanc ingéré le matin à jeun pour tuer le ver finit par tuer le buveur de gastrite alcoolique ou de cirrhose hépatique ou bien par déterminer une diminution de la nutrition favorable à l’envahissement de l’organisme par la tuberculose."
                            },
                            {
                                "example_id": "a8c76174-ad52-4e28-85bd-860be0b20527",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "Elles s'inspirent des ordonnances de nos rois dont les grands ministres, Choiseul et autres, ont dû tout comme les serviteurs de la République, lutter contre le pullulement et les envahissements du clergé régulier."
                            },
                            {
                                "example_id": "ac5f23cb-9dd3-43ae-8fae-c602df0bd17a",
                                "sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                                "text": "Plus on a de compartiments étanches, moins le risque d’envahissement [du navire] est grand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "946fbe35-4e7e-4cd8-ab22-5f24445501bd",
                        "source_entry_id": "08cf5666-39db-3ea1-9306-d5ea2abfd04a",
                        "source_sense_id": "1dff4a1c-a1cd-3292-b6bc-047a257788b3",
                        "target_lang_word": "invasion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invasion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "A military action consisting of armed forces of one geopolitical entity entering territory controlled by another such entity, generally with the objective of conquering territory or altering the established government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ff51b7-b159-463a-89ed-345965a22b58",
                                                "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                                "text": "Since Michel's days, however, many barbarian invasions had subdivided the Three Gauls into a melange of warsome states and tribes, all, nevertheless, acquiring a vaguely similar grace, if not a petite grandeur."
                                            },
                                            {
                                                "example_id": "5789575d-4961-4130-9ae0-089a1e65f90a",
                                                "sense_id": "904bbab8-12da-3b75-b1fc-917a5cc4ecf4",
                                                "text": "Yeh actually works in marketing, and his weapon is a replica -- but he is spending the weekend attending an urban warfare workshop to prepare for what he sees as the very real threat of a Chinese invasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The entry without consent of an individual or group into an area where they are not wanted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4306a8f1-65a0-411d-b20e-86c88a71486e",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of mobile phones"
                                            },
                                            {
                                                "example_id": "439e66d0-a1e5-4eef-a410-c4458caefad0",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of bees"
                                            },
                                            {
                                                "example_id": "612d810e-3282-479e-97a5-130bb7903fd1",
                                                "sense_id": "add84fde-ba79-362d-b91c-12ca8f8aa4bb",
                                                "text": "an invasion of foreign tourists"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372f5947-4869-3285-a562-89ed4d941ab8",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The spread of cancer cells, bacteria and such to the organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28da780-f38a-4846-95ca-01bfbcfbae37",
                                                "sense_id": "372f5947-4869-3285-a562-89ed4d941ab8",
                                                "text": "The histological diagnosis of PC is currently restricted to lesions showing unequivocal extra-parathyroidal growth, as evidenced by perineural invasion, full thickness capsular invasion with growth into adjacent tissues, extratumoral vascular invasion, or metastasis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f592e4-41ae-3744-ae65-fdd3aac67b2a",
                                        "entry_id": "0bf99f3b-e33d-3b90-9998-0107f4136d82",
                                        "glosses": [
                                            "The breaching of the skin barrier."
                                        ],
