                ],
                "senses": [
                    {
                        "sense_id": "cce16268-888c-3f42-ac24-c7f1f42041c2",
                        "entry_id": "94b16aa6-5de3-3dab-b0ba-2b6725dd088a",
                        "glosses": [
                            "Wasserfahrzeug, das bei ansteigender Geschwindigkeit mit Hilfe von unter Wasser liegenden Tragflächen während der Fahrt angehoben wird, um den Reibungswiderstand und die Wasserverdrängung zu reduzieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8741a6ed-df20-4277-b8a1-be034d0e3f16",
                                "sense_id": "cce16268-888c-3f42-ac24-c7f1f42041c2",
                                "text": "Tragflächenboote können Geschwindigkeiten von bis zu 90 km/h erreichen."
                            },
                            {
                                "example_id": "2aee886f-247a-48da-bb58-ba795fcb8143",
                                "sense_id": "cce16268-888c-3f42-ac24-c7f1f42041c2",
                                "text": "„Bei einem Fährunglück in Japan sind am Samstag mindestens 87 Menschen verletzt worden. Wie die japanische Küstenwache mitteilte, war das Tragflächenboot auf dem Weg von der Hauptinsel Honshu zur Insel Sado.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7d3bc8c-6737-4760-adaf-112a7a57d31d",
                        "source_entry_id": "94b16aa6-5de3-3dab-b0ba-2b6725dd088a",
                        "source_sense_id": "cce16268-888c-3f42-ac24-c7f1f42041c2",
                        "target_lang_word": "hydroptère",
