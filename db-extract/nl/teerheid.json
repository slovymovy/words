        "nl-extract.jsonl": [
            {
                "entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                "word": "teerheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3ab65cd8-6ca7-4c8a-904c-1402d0b4736a",
                        "entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                        "tags": [
                            "plural"
                        ],
                        "form": "teerheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c18a546a-edb9-3b4b-9d1a-63be98809add",
                        "entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                        "glosses": [
                            "van iets dat het bij verkeerd gebruik makkelijk kapot gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740ba5cc-c5b8-4a6e-9ebd-721e2e23ce48",
                                "sense_id": "c18a546a-edb9-3b4b-9d1a-63be98809add",
                                "text": "Behalve de betrekkelijke teerheid heeft wol als nadeel dat je goed moet opletten bij het wassen. Zelfs het uittrekken van een trui behoort op een speciale manier te gebeuren, lees je in de klantenbrochure ’Joe and the art of pullover maintenance’. Alle producten kunnen in de wasmachine. Beckers: „Handwas is levensgevaarlijk. Met het wolprogramma op de wasmachine gaat het wel meteen goed.”"
                            },
                            {
                                "example_id": "38b64772-5ccb-4b64-ba12-40e32f4f96cb",
                                "sense_id": "c18a546a-edb9-3b4b-9d1a-63be98809add",
                                "text": "Het laatste schilderij was „het beginpunt” van de tentoonstelling, vertelt conservator Betsy Wieseman. Kenwood House, een zeventiende-eeuws landhuis aan Hampstead Heath in het noorden van Londen, wordt verbouwd, en het doek werd aan The National Gallery uitgeleend. Vanwege de teerheid van De gitaarspeelster, dat nog steeds de originele houten omlijsting heeft en waarvan het canvas niet is omlijnd, kan het schilderij eigenlijk niet reizen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e93edf28-5e9b-3778-b152-ab2510d63c92",
                        "entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                        "glosses": [
                            "heel zacht en gevoelig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda380b8-b119-40ac-bfa0-e932fb855cc7",
                                "sense_id": "e93edf28-5e9b-3778-b152-ab2510d63c92",
                                "text": "Nieuw is de tenor Marco Berti als Radamès, die zijn gebrek aan kleur en nuances probeert te compenseren met extra hard zingen, wat in de Munt zeker niet nodig is en het zangersensemble volledig uit zijn verband trekt. Dat wreekte zich vooral in de slotscène, waar hij samen met Aida in een grafruimte wordt ingemetseld en zij een langzame dood zullen sterven, een moment waarop de teerheid van de muziek voorop zou moeten staan. De Standaard 12 OKTOBER 2004 OM 00:00 UUR"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13cf70aa-7ba8-4868-8b90-f142b49f7b1b",
                        "source_entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                        "source_sense_id": "c18a546a-edb9-3b4b-9d1a-63be98809add",
                        "source_sense_description": "van iets dat het makkelijk kapot kan gaan",
                        "target_lang_word": "frailty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frailty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1addfe4e-382a-3950-883c-5ae0b327a748",
                                        "entry_id": "56bb3dbd-a28a-3b4d-9528-5acd8034f341",
                                        "glosses": [
                                            "The condition quality of being frail, physically, mentally, or morally; weakness of resolution; liability to be deceived."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16b6978-2679-4ffb-81df-57570205d105",
                                                "sense_id": "1addfe4e-382a-3950-883c-5ae0b327a748",
                                                "text": "the limitations and restraints of civil government, and a legal constitution, may be defended, either from reason, which reflecting on the great frailty and corruption of human nature, teaches, that no man can safely be trusted with unlimited authority ;"
                                            },
                                            {
                                                "example_id": "5508bc83-3607-4bf7-a72f-83d23c2e5d63",
                                                "sense_id": "1addfe4e-382a-3950-883c-5ae0b327a748",
                                                "text": "For all their frailty at the back, Arsenal possessed genuine menace in attack and they carved through Chelsea with ease to restore parity nine minutes before half-time. Aaron Ramsey's pass was perfection and Gervinho took the unselfish option to set up Van Persie for a tap-in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74863c80-ab17-35e9-8dc5-6721364881c0",
                                        "entry_id": "56bb3dbd-a28a-3b4d-9528-5acd8034f341",
                                        "glosses": [
                                            "A fault proceeding from weakness; foible; sin of infirmity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c1d4625-a897-44d7-94ab-3db1aeafc165",
                        "source_entry_id": "3722d940-ed89-3779-8dcc-b7d7be92624d",
                        "source_sense_id": "e93edf28-5e9b-3778-b152-ab2510d63c92",
                        "source_sense_description": "zacht en gevoelig",
                        "target_lang_word": "tenderness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenderness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A tendency to express warm, compassionate feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d6ff4-4459-4112-9015-bd7211d76a3b",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "When the lovers were together, their cold indifference gave way to love and tenderness."
                                            },
                                            {
                                                "example_id": "d2b3be4e-dbac-4f9f-a68a-7c1c5ddca360",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "I had known him jealous, suspicious; I had seen about him certain tendernesses, fitfulnesses—a softness which came like a warm air, and a ruth which passed like early dew, dried in the heat of his irritabilities: this was all I had seen."
                                            },
                                            {
                                                "example_id": "1b8b6812-4d12-404a-bc6b-813fbeec3c94",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "Love me, try to be understanding / Tenderness is all that I'm asking / Don't feel like I'm making conditions / I want to overcome my inhibitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A concern for the feelings or welfare of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c4063b-7cf4-47f6-b543-2c383550d5cb",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "When they saw the poor orphans, they were overwhelmed with tenderness for them."
                                            },
                                            {
                                                "example_id": "e414184b-6466-4038-a4d3-88bcac8bd1e6",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Everybody needs a little tenderness sometimes."
                                            },
                                            {
                                                "example_id": "28b2fa57-649a-483c-800d-1ed4add66bbe",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A pain or discomfort when an affected area is touched."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84d9696-ee46-4e78-9355-6b630d3836ca",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "He noted her extreme tenderness when he touched the bruise on her thigh."
                                            },
                                            {
                                                "example_id": "d84c563c-bca3-4ab2-80ce-6ac815af45fb",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
