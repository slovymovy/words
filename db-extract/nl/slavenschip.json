                "translations": [
                    {
                        "translation_id": "ec70f031-f2ef-46de-8e22-1018e3b7bd73",
                        "source_entry_id": "67036236-7a4d-303e-a864-9fa4f0dc6c26",
                        "source_sense_id": "a9b64d26-c0b1-3352-b050-f40c04209c93",
                        "target_lang_word": "Sklavenschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sklavenschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbdc36a8-9186-356f-97d1-a83def14f7cd",
                                        "entry_id": "ec95fc94-0afc-31c9-b155-854332116155",
                                        "glosses": [
                                            "Schiff, das Sklaven transportiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6de204-c160-449d-88fc-cce9b6d25e01",
                                                "sense_id": "cbdc36a8-9186-356f-97d1-a83def14f7cd",
                                                "text": "„Der Erste Offizier, der früher auf Sklavenschiffen gefahren war, griff hart durch, was die Spannungen noch verstärkte.“"
                                            },
                                            {
                                                "example_id": "0a3ff7f7-818a-446e-a7c2-82eab5df75e7",
                                                "sense_id": "cbdc36a8-9186-356f-97d1-a83def14f7cd",
                                                "text": "„Die Fahrt der Diligent war nur eine von schätzungsweise 40000, zu denen Sklavenschiffe aufbrachen und durch die mehr als elf Millionen Menschen über einen Zeitraum von vier Jahrhunderten hinweg von den Küsten Afrikas in andere Regionen der Welt verschleppt wurden.“"
                                            },
                                            {
                                                "example_id": "b847925f-cf71-4345-b987-53f71dde514c",
                                                "sense_id": "cbdc36a8-9186-356f-97d1-a83def14f7cd",
                                                "text": "„Besonders auf Sklavenschiffen starben die Matrosen schneller als die Schwarzen, wenn das überhaupt möglich war.“"
                                            },
                                            {
                                                "example_id": "6b680088-18cc-4c90-b1aa-6608dfde2bd1",
                                                "sense_id": "cbdc36a8-9186-356f-97d1-a83def14f7cd",
                                                "text": "„In einer Sammlung mit Augenzeugenberichten fand ich ein Dokument aus dem Jahr 1829, in dem es um ein amerikanisches Sklavenschiff ging, das von der britischen Marine im südlichen Atlantik aufgebracht worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
