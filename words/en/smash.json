{
    "word_family": [
        "smasher",
        "smashing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                    "sense_definition": "To break something brittle into many pieces with violence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves <w>smashed</w> the car window to steal the radio.",
                            "target_lang_translations": {
                                "zh": "小偷<w>砸碎</w>了车窗去偷收音机。"
                            }
                        },
                        {
                            "text": "She was so angry that she <w>smashed</w> the plate against the wall.",
                            "target_lang_translations": {
                                "zh": "她太生气了，把盘子<w>砸</w>在墙上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shatter",
                        "dash",
                        "break"
                    ],
                    "common_phrases": [
                        "smash a window",
                        "smash to pieces",
                        "smash open"
                    ],
                    "target_lang_definitions": {
                        "zh": "用力将易碎物品击碎成碎片。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砸碎",
                                "target_lang_sense_clarification": "指用力击打使物体破碎。"
                            },
                            {
                                "target_lang_word": "打碎",
                                "target_lang_sense_clarification": "指击打导致物体破裂。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d90955-492a-3334-b53f-f103092318ab",
                    "sense_definition": "To break into pieces violently, often making a loud noise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vase fell off the shelf and <w>smashed</w> on the floor.",
                            "target_lang_translations": {
                                "zh": "花瓶从架子上掉下来，<w>摔碎</w>在地板上。"
                            }
                        },
                        {
                            "text": "The bottle <w>smashed</w> into tiny shards when it hit the ground.",
                            "target_lang_translations": {
                                "zh": "瓶子撞到地面时<w>碎</w>成了细小的碎片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shatter",
                        "crash"
                    ],
                    "common_phrases": [
                        "smash on the floor",
                        "smash into pieces"
                    ],
                    "target_lang_definitions": {
                        "zh": "物体因猛烈撞击而破碎，通常伴随巨大声响。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摔碎",
                                "target_lang_sense_clarification": "指物体掉落或撞击地面而破碎。"
                            },
                            {
                                "target_lang_word": "撞碎",
                                "target_lang_sense_clarification": "指因猛烈撞击而破碎。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212152ec-9423-3332-a8a0-0c0fe8fbeaa8",
                    "sense_definition": "To hit or collide with something with great force.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car lost control and <w>smashed</w> into a tree.",
                            "target_lang_translations": {
                                "zh": "汽车失控并<w>猛撞</w>在一棵树上。"
                            }
                        },
                        {
                            "text": "He <w>smashed</w> his fist on the table to get everyone's attention.",
                            "target_lang_translations": {
                                "zh": "他用拳头<w>重击</w>桌面以引起大家的注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "pound",
                        "thump",
                        "wallop"
                    ],
                    "common_phrases": [
                        "smash into",
                        "smash against",
                        "smash through"
                    ],
                    "target_lang_definitions": {
                        "zh": "以极大的力量撞击或碰撞某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猛撞",
                                "target_lang_sense_clarification": "指以极大的力量碰撞。"
                            },
                            {
                                "target_lang_word": "重击",
                                "target_lang_sense_clarification": "指用力击打。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c28afc-8a61-3a9e-ba24-dd9f8b312919",
                    "sense_definition": "To crush or flatten something soft by applying pressure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>smash</w> the garlic cloves before adding them to the pan.",
                            "target_lang_translations": {
                                "zh": "你应该先把蒜瓣<w>捣碎</w>再放入锅中。"
                            }
                        },
                        {
                            "text": "He <w>smashed</w> the empty soda can flat with his foot.",
                            "target_lang_translations": {
                                "zh": "他用脚把空汽水罐<w>压扁</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "smash flat",
                        "smash garlic"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过施加压力将柔软物体压扁或压碎。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压扁",
                                "target_lang_sense_clarification": "指通过压力使物体变平。"
                            },
                            {
                                "target_lang_word": "捣碎",
                                "target_lang_sense_clarification": "指将食物等捣成泥状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e93ccad-c24d-3c23-950e-1b151231d9fb",
                    "sense_definition": "To defeat an opponent overwhelmingly or achieve great success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team <w>smashed</w> their rivals in the final game of the season.",
                            "target_lang_translations": {
                                "zh": "我们的球队在赛季决赛中<w>大胜</w>对手。"
                            }
                        },
                        {
                            "text": "She <w>smashed</w> the world record by more than two seconds.",
                            "target_lang_translations": {
                                "zh": "她以超过两秒的优势<w>打破</w>了世界纪录。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slaughter",
                        "trounce"
                    ],
                    "common_phrases": [
                        "smash a record",
                        "smash the competition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以压倒性优势击败对手或取得巨大成功。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大胜",
                                "target_lang_sense_clarification": "指在比赛中取得压倒性胜利。"
                            },
                            {
                                "target_lang_word": "打破",
                                "target_lang_sense_clarification": "指在记录方面取得突破。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ccf68cc-0dbb-3702-b885-611988262941",
                    "sense_definition": "To destroy or ruin something completely, such as hopes or plans.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news <w>smashed</w> all our plans for the summer holiday.",
                            "target_lang_translations": {
                                "zh": "坏消息<w>粉碎</w>了我们所有的暑假计划。"
                            }
                        },
                        {
                            "text": "His injury <w>smashed</w> his dream of playing professionally.",
                            "target_lang_translations": {
                                "zh": "他的伤病<w>粉碎</w>了他成为职业选手的梦想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dash"
                    ],
                    "common_phrases": [
                        "smash hopes",
                        "smash dreams"
                    ],
                    "target_lang_definitions": {
                        "zh": "彻底摧毁或破坏某事，如希望或计划。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "粉碎",
                                "target_lang_sense_clarification": "指彻底破坏梦想或计划。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f0967e5-6947-3832-b444-89fc8343dade",
                    "sense_definition": "To have sexual intercourse with someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was bragging to his friends that he <w>smashed</w> her last night.",
                            "target_lang_translations": {
                                "zh": "他向朋友吹嘘说他昨晚和她<w>上床</w>了。"
                            }
                        },
                        {
                            "text": "The internet meme asks users whether they would <w>smash</w> or pass.",
                            "target_lang_translations": {
                                "zh": "网络梗询问用户是否愿意<w>上床</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep with",
                        "go to bed with"
                    ],
                    "common_phrases": [
                        "smash or pass"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "originally US"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与某人发生性关系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "上床",
                                "target_lang_sense_clarification": "指发生性行为的俚语。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                    "sense_definition": "Something that is very successful or popular, especially a song, movie, or play.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new musical is a Broadway <w>smash</w> and tickets are sold out.",
                            "target_lang_translations": {
                                "zh": "这部新音乐剧是百老汇的<w>热门作品</w>，票已售罄。"
                            }
                        },
                        {
                            "text": "Her debut album was a global <w>smash</w> that topped the charts.",
                            "target_lang_translations": {
                                "zh": "她的首张专辑是全球<w>大热</w>之作，登上了排行榜榜首。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "smash hit"
                    ],
                    "common_phrases": [
                        "box office smash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非常成功或受欢迎的作品，如歌曲、电影或戏剧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "热门作品",
                                "target_lang_sense_clarification": "指极受欢迎的娱乐产品。"
                            },
                            {
                                "target_lang_word": "大热",
                                "target_lang_sense_clarification": "指非常成功的作品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce38943d-6cd8-3bf7-ae4b-41622258cd69",
                    "sense_definition": "A violent collision between vehicles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a bad <w>smash</w> on the highway this morning.",
                            "target_lang_translations": {
                                "zh": "今天早上高速公路上发生了一起严重<w>车祸</w>。"
                            }
                        },
                        {
                            "text": "Luckily, no one was seriously injured in the <w>smash</w>.",
                            "target_lang_translations": {
                                "zh": "幸运的是，在这起<w>车祸</w>中没有人受重伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crash"
                    ],
                    "common_phrases": [
                        "car smash",
                        "bad smash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "车辆之间的猛烈碰撞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "车祸",
                                "target_lang_sense_clarification": "指车辆发生的碰撞事故。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90ce7c76-5a1c-33f1-9383-264dba1f007f",
                    "sense_definition": "The loud sound of a violent impact or the act of breaking something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the <w>smash</w> of glass coming from the kitchen.",
                            "target_lang_translations": {
                                "zh": "我们听到厨房传来玻璃<w>撞击声</w>。"
                            }
                        },
                        {
                            "text": "The heavy box hit the floor with a loud <w>smash</w>.",
                            "target_lang_translations": {
                                "zh": "沉重的箱子重重地砸在地板上，发出巨大的<w>撞击声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crash"
                    ],
                    "common_phrases": [
                        "loud smash",
                        "hear a smash"
                    ],
                    "target_lang_definitions": {
                        "zh": "猛烈撞击或物体破碎时发出的巨大声响。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撞击声",
                                "target_lang_sense_clarification": "指物体碰撞发出的声音。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77767dff-d43f-3e13-80c6-5f42c1b0ed51",
                    "sense_definition": "A powerful overhead shot hit downwards in sports like tennis or badminton.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "7",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the match with a perfect <w>smash</w> that his opponent couldn't reach.",
                            "target_lang_translations": {
                                "zh": "他以一记对手无法接到的完美<w>扣杀</w>赢得了比赛。"
                            }
                        },
                        {
                            "text": "The player prepared for a <w>smash</w> close to the net.",
                            "target_lang_translations": {
                                "zh": "球员在网前准备进行<w>扣杀</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overhead smash",
                        "forehand smash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "网球或羽毛球中向下猛力扣杀的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扣杀",
                                "target_lang_sense_clarification": "指体育运动中的强力击球。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c2e3461-e75d-37d0-8079-aacc3412c1c9",
                    "sense_definition": "A dish consisting of mashed ingredients, particularly avocado, served on toast.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will have the avocado <w>smash</w> and a black coffee, please.",
                            "target_lang_translations": {
                                "zh": "请给我一份牛油果<w>捣碎泥</w>和一杯黑咖啡。"
                            }
                        },
                        {
                            "text": "This cafe is famous for its delicious feta <w>smash</w>.",
                            "target_lang_translations": {
                                "zh": "这家咖啡馆以其美味的羊乳酪<w>捣碎泥</w>而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "avocado smash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种将食材捣碎后放在吐司上的菜肴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捣碎泥",
                                "target_lang_sense_clarification": "指捣碎的食材，常指牛油果泥。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}