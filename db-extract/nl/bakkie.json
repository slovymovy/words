                            "plural"
                        ],
                        "form": "bakkies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5302b126-c475-3ae5-a402-5c18d4e884ba",
                        "entry_id": "6aaa1166-0ee3-30f8-a9d6-0eb5fe4c94b0",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord bak"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a58acd-c416-4cb3-b71e-c95d03f086f5",
                                "sense_id": "5302b126-c475-3ae5-a402-5c18d4e884ba",
                                "text": "Die blinde muzikant, met die rooie kop, die krijgt altijd een tientje van me. Altijd. En het aardige is, dat ie altijd heel erg beleefd dank je wel zegt. Kijk, een tientje hoor je niet in het bakkie vallen, een kwartje wel."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c0e9a63-9df9-3a1a-a673-4974021a6bb5",
                        "entry_id": "6aaa1166-0ee3-30f8-a9d6-0eb5fe4c94b0",
                        "glosses": [
                            "toestel voor het zenden en ontvangen van radiosignalen in de 27 MHz-band, die gebruikt kan worden door particulieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed39dbb8-f79d-4f00-9530-31539b74e535",
                                "sense_id": "1c0e9a63-9df9-3a1a-a673-4974021a6bb5",
                                "text": "Lena praat met de buren via een radio, een bakkie. Bijna iedereen in de buurt heeft er een."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c630b22-d0bb-3443-aa1a-7dcd7001beb7",
                        "entry_id": "6aaa1166-0ee3-30f8-a9d6-0eb5fe4c94b0",
                        "glosses": [
                            "kopje of schoteltje voor warme drank"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "af7d6168-462d-464b-a56d-e58824aca0c8",
                                "sense_id": "3c630b22-d0bb-3443-aa1a-7dcd7001beb7",
                                "text": "Maar goed, Cor heeft snel weer wat aangetrokken en een bakkie soep voor hem gemaakt en toen moesten we die foto's zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a98c365-91da-3c8d-9256-be726afbd7f6",
                        "entry_id": "6aaa1166-0ee3-30f8-a9d6-0eb5fe4c94b0",
                        "glosses": [
                            "kopje koffie"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cad94ff7-4399-411c-8016-9ee396a0de00",
                                "sense_id": "7a98c365-91da-3c8d-9256-be726afbd7f6",
                                "text": "Verder is zijn vrouw natuurlijk wel goed voor hem. Wil hij nog een kopje koffie, nou ze zal nog een lekker bakkie maken."
                            },
                            {
                                "example_id": "cad96149-10a9-4758-8cd1-dcde319ad103",
                                "sense_id": "7a98c365-91da-3c8d-9256-be726afbd7f6",
                                "text": "'Zo, zo, jij bent moe, moet ik niet ook een bakkie koffie voor je halen?' 'Ik heb om halfvijf een Oxazepam genomen,' zeg ik."
                            }
                        ]
                    },
                    {
                        "sense_id": "07997493-2448-3540-b7c5-362e461367c4",
                        "entry_id": "6aaa1166-0ee3-30f8-a9d6-0eb5fe4c94b0",
                        "glosses": [
                            "zijspan van een motorfiets"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "68f2f235-907c-4a28-90a2-725023513d8d",
                                "sense_id": "07997493-2448-3540-b7c5-362e461367c4",
                                "text": "Broer zwaait zijn magere been over het zadel en ik klauter in het bakkie en geef hem de helm. Hij zet het roomkleurig leren potje, met leren oorkleppen en riempjes voor de kin, op zijn kop. Hij draait de Heinkelsleutel een kwartslag om."
                            }
                        ]
                    }
                ],
