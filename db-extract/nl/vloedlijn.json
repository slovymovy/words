                "senses": [
                    {
                        "sense_id": "68ce8a84-0f42-36f4-82c7-93759b26c291",
                        "entry_id": "63257b8e-cf41-3f1f-9ccb-bdc2b55a1ee8",
                        "glosses": [
                            "door aangespoeld materiaal gevormde lijn die het verste bereik van vloed aangeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9f1a73-dff1-4443-bbeb-426e371e821c",
                                "sense_id": "68ce8a84-0f42-36f4-82c7-93759b26c291",
                                "text": "Gistermiddag om een uur of vijf liepen mijn vriendin en ik, beiden tachtigers, heerlijk langs de vloedlijn bij de Wassenaarse Slag."
                            },
                            {
                                "example_id": "2fab7890-140b-46a5-a078-acbfb49f9f67",
                                "sense_id": "68ce8a84-0f42-36f4-82c7-93759b26c291",
                                "text": "Een schoonmaker van een strandtent in Scheveningen geloofde gistermorgen zijn ogen niet toen hij op de vloedlijn een dode krokodil zag liggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a606b203-71de-41f1-a543-d8f4b472b313",
                        "source_entry_id": "63257b8e-cf41-3f1f-9ccb-bdc2b55a1ee8",
                        "source_sense_id": "68ce8a84-0f42-36f4-82c7-93759b26c291",
