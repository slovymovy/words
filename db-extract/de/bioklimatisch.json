                "senses": [
                    {
                        "sense_id": "603dfce0-d86a-31c0-a3ac-b89d97394e38",
                        "entry_id": "a420f1a9-5d02-3c6a-b6e6-2c1828994225",
                        "glosses": [
                            "in Bezug zur Bioklimatologie, die den Einfluss klimatischer Faktoren auf Mensch, Tier und Pflanze untersucht, stehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8643ae69-db17-4b76-af22-168cce9d205a",
                                "sense_id": "603dfce0-d86a-31c0-a3ac-b89d97394e38",
                                "text": "„Bioklimatisch, also in seinem Einfluß auf den Menschen, haben wir den Föhn schon beim Studium der Warmfront kennengelernt.“"
                            },
                            {
                                "example_id": "b090993c-6b60-4ae5-a6c2-8a99ad68bcea",
                                "sense_id": "603dfce0-d86a-31c0-a3ac-b89d97394e38",
                                "text": "„Aus der Sicht der Forstwirtschaft in den alten Kulturlandschaften und unter den bioklimatischen Verhältnissen Mitteleuropas war die Verdrängung des Feuers aus dem intensiv bewirtschafteten Wald verständlich; in den großen Naturräumen Nordamerikas aber, in denen Blitzschlagfeuer und die Brände aus den Landnutzungspraktiken der indianischen Urbevölkerung die Wälder und Prärien entscheidend geformt hatten, erwies sich die neue Devise, Feuer weitgehend auszuschließen, als fatal.“"
                            },
                            {
                                "example_id": "0323454a-75d1-463b-a061-3f07273dc037",
                                "sense_id": "603dfce0-d86a-31c0-a3ac-b89d97394e38",
                                "text": "„Große Teile des Oberrheinischen Tieflandes sind bioklimatisch belastend. Nur die Hügelund Mittellagen der Gebirgsränder weisen ein bioklimatisch günstiges „Schonklima“ auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
