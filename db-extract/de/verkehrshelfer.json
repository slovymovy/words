                ],
                "senses": [
                    {
                        "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                        "entry_id": "55a686dd-3b6f-310f-9436-01755e95009b",
                        "glosses": [
                            "in der Regel ehrenamtlich beauftragte Person, die hilfsbedürftigen Menschen bei der Verkehrsteilnahme Unterstützung leistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69eacd7e-4de8-4bd1-be71-1d97f96d37e9",
                                "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                                "text": "„Die Städte, mit ihren von der Armee abgestellten Verkehrshelfern, glichen am Wochenanfang kleinen Heerlagern.“"
                            },
                            {
                                "example_id": "30bd01ad-dc9d-4576-ab07-a3483bc65cba",
                                "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                                "text": "„Verkehrspolizisten, Schülerlotsen, Schulweghelfer sind die bekanntesten Verkehrshelfer.“"
                            },
                            {
                                "example_id": "cfc82ae4-c8ee-4820-93e1-3e11fbf7b534",
                                "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                                "text": "„Die Verkehrshelfer sind vor Verkehrsknotenpunkten an fünf Marzahner und fünf Hellersdorfer Schulen tätig.“"
                            },
                            {
                                "example_id": "35a724fe-3134-40c5-a141-bb778b0bc668",
                                "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                                "text": "„Am diszipliniertesten seien Autofahrer dann, wenn den jungen Verkehrshelfern ein Polizist zur Seite stünde - dann hielten sich die Autofahrer besonders akribisch an die vorgeschriebene Geschwindigkeit.“"
                            },
                            {
                                "example_id": "37635d20-8fc3-49b9-95ea-c9ad50ddfc99",
                                "sense_id": "f2f3bfd9-6471-349c-8e34-a45f645ab59f",
                                "text": "„Einer einwöchigen Ausbildung schließt sich eine theoretische und praktische Prüfung an, bevor Mütze, Umhang und Kelle an die Verkehrshelfer ausgeteilt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
