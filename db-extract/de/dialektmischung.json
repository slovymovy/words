                "senses": [
                    {
                        "sense_id": "186f892c-fbdb-3997-a3f2-d2a48660e659",
                        "entry_id": "4009fdcf-93c5-38a1-af44-8a5240d5efd3",
                        "glosses": [
                            "Sprachform, in der Ausdrücke unterschiedlicher dialektaler Herkunft vorkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e1cb18-db94-472c-913c-2416d864e342",
                                "sense_id": "186f892c-fbdb-3997-a3f2-d2a48660e659",
                                "text": "„Eheschließungen zwischen Angehörigen verschiedener Gruppen und das Zusammenleben in kleinen Sprachinseln haben zu Dialektmischungen geführt, ohne dass sich dabei ein von allen gebrauchter Ausgleichsdialekt herausgebildet hat.“"
                            },
                            {
                                "example_id": "ec077720-6a5f-457d-bbd9-bdcd9669e2b5",
                                "sense_id": "186f892c-fbdb-3997-a3f2-d2a48660e659",
                                "text": "„Das Prinzip (i) besagt, daß morphologischer Wandel (soweit er nicht auf Sprach- und Dialektmischung, Entlehnung, Normierung usw. beruht) in Richtung von mehr Markiertheit/weniger Natürlichkeit zu weniger Markiertheit/mehr Natürlichkeit verläuft.“"
                            },
                            {
                                "example_id": "429c0313-374b-4544-b0eb-754c50d89017",
                                "sense_id": "186f892c-fbdb-3997-a3f2-d2a48660e659",
                                "text": "„Dialektmischung innerhalb eines zusammenhängenden Sprachgebietes hebt sich dann von der normalen ausgleichenden Wirkung des Verkehrs deutlich ab, wenn sie zwischen Dialekten vor sich geht, deren Gebiete nicht räumlich nebeneinander liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
