                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tactless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf565c3-b910-3721-aad3-cc4a381fa531",
                                        "entry_id": "cf627bd1-0fde-352f-bf70-5e7c999478af",
                                        "glosses": [
                                            "having no tact; unaware or intentionally inconsiderate of someone else's feelings"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2fe537-3516-4079-a316-c4c9b79a8a98",
                                                "sense_id": "edf565c3-b910-3721-aad3-cc4a381fa531",
                                                "text": "It was tactless of you not to attend your sister's wedding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214aced1-47eb-4305-93a7-72be45dd3fad",
                        "source_entry_id": "954ea784-3172-34e2-93f1-01b9f5a67ede",
                        "source_sense_id": "3fc18472-03bd-35da-8d8c-8d66d6365984",
                        "target_lang_word": "clumsy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clumsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68cf3b4-4ad0-381a-9c9d-3a87781603ec",
                                        "entry_id": "c3a2911f-a9b9-3790-b322-89028b7a0ce2",
                                        "glosses": [
                                            "Awkward, lacking coordination, not graceful, not dextrous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c0bc8b-ca46-406c-b7c1-d08f7c41bb46",
                                                "sense_id": "b68cf3b4-4ad0-381a-9c9d-3a87781603ec",
                                                "text": "He's very clumsy. I wouldn't trust him with carrying the dishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a61a2e6-9ac9-3f72-a1f7-51f4543ed9f8",
                                        "entry_id": "c3a2911f-a9b9-3790-b322-89028b7a0ce2",
                                        "glosses": [
                                            "Not elegant or well-planned, lacking tact or subtlety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "392654a0-60ae-4604-91d4-dd03b7a42862",
                                                "sense_id": "3a61a2e6-9ac9-3f72-a1f7-51f4543ed9f8",
                                                "text": "It is a clumsy solution, but it might work for now."
                                            },
                                            {
                                                "example_id": "5df09ce4-2aaf-4743-ba93-55182d6cafb4",
                                                "sense_id": "3a61a2e6-9ac9-3f72-a1f7-51f4543ed9f8",
                                                "text": "What a clumsy joke"
                                            },
                                            {
                                                "example_id": "1997cae1-9c78-4673-8fee-f13b1139d46b",
                                                "sense_id": "3a61a2e6-9ac9-3f72-a1f7-51f4543ed9f8",
                                                "text": "The ravviſh danke of clumzie vvinter ramps / The fluent ſummers vaine: and drizling ſleete / Chilleth the vvan bleak cheek of the numd earth, / VVhilſt ſnarling guſts nibble the iuyceles leaues, / From the nak't ſhuddring branch; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847694db-abe7-3491-91d6-5209a01dc6b2",
                                        "entry_id": "c3a2911f-a9b9-3790-b322-89028b7a0ce2",
                                        "glosses": [
                                            "Awkward or inefficient in use or construction, difficult to handle or manage especially because of shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clumsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a1a5c42-8ff1-30d7-b200-1872dd33fbf0",
                                        "entry_id": "357769b7-a8c7-3fec-aaad-0fb8ea8c2664",
                                        "glosses": [
                                            "A clumsy person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27dd9bc-35cd-4140-a4d0-189cb13e69a4",
                                                "sense_id": "9a1a5c42-8ff1-30d7-b200-1872dd33fbf0",
                                                "text": "On the stairs he met Ellen, the housemaid, and as he passed her he knocked the hot-water jug out of her hand. “Well, you are a clumsy,” said Ellen, as she bent down to mop up the water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
