                "senses": [
                    {
                        "sense_id": "3ea62b2a-219c-332e-aed2-b58dd63a596d",
                        "entry_id": "90011b3e-74ee-3db5-a310-8356d6d9d45c",
                        "glosses": [
                            "Art du sculpteur sur ivoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844915e7-26b3-4306-8752-b8e89ddc88b0",
                                "sense_id": "3ea62b2a-219c-332e-aed2-b58dd63a596d",
                                "text": "Dans chaque période sont successivement passés en revue les divers modes d’expression de l’art; l’architecture, puis la sculpture occupent naturellement les premières places; la peinture, l’ivoirerie, le bronze, la miniature ne sont pas oubliés."
                            }
                        ]
                    },
                    {
                        "sense_id": "c424d4eb-bb2c-3035-af1f-d1732524baf5",
                        "entry_id": "90011b3e-74ee-3db5-a310-8356d6d9d45c",
                        "glosses": [
                            "Objets d’ivoires, commerce de ces objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fe7b0f-31d3-4ea2-a246-2ae0ec7cd747",
                                "sense_id": "c424d4eb-bb2c-3035-af1f-d1732524baf5",
                                "text": "Il se fait quelques exportations d’ivoirerie , de sucre raffiné, de fruits, d’œufs et de beurre."
                            },
                            {
                                "example_id": "13aa2b48-1582-4a13-882a-ff48c63dfada",
                                "sense_id": "c424d4eb-bb2c-3035-af1f-d1732524baf5",
                                "text": "Le principal commerce de Dieppe consiste en harangs, dont elle fournit Paris et la Province, la pêche du merlan et du maquereau, le transport des huitres, l’ivoirerie et la dentelles."
                            }
                        ]
                    }
