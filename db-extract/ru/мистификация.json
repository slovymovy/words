                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10305bd4-c982-4178-9e62-7f083283873f",
                                                "sense_id": "0900d42d-97dd-3d6f-9a4e-8184368bd7e8",
                                                "text": "Das war eine Täuschung meinerseits."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9f21a25-a5b1-39a0-abe5-46413c18e0c1",
                                        "entry_id": "966a4570-6c63-3115-98c3-80d97b1bae74",
                                        "glosses": [
                                            "falsche Wahrnehmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d130b0a-4eb7-4e45-96d9-a806544840e7",
                                                "sense_id": "e9f21a25-a5b1-39a0-abe5-46413c18e0c1",
                                                "text": "Eine Karawane in der Wüste kann durchaus eine Täuschung sein."
                                            },
                                            {
                                                "example_id": "91cced3e-0fa7-4851-914c-50b28c695c88",
                                                "sense_id": "e9f21a25-a5b1-39a0-abe5-46413c18e0c1",
                                                "text": "„Phantastische Wolkengebilde am Himmel weckten gelegentlich die Hoffnung auf Land, das sich beim Näherkommen jedoch als Täuschung erwies.“"
                                            },
                                            {
                                                "example_id": "e1e9a9dd-0c0b-4a5b-ac49-8092e02bee91",
                                                "sense_id": "e9f21a25-a5b1-39a0-abe5-46413c18e0c1",
                                                "text": "„Es war eine Täuschung, ich mußte sofort erwachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f5ae331-4678-48b3-a6ea-bac3be073b5f",
                        "source_entry_id": "7c94a89c-fdb7-3471-8654-9a5dc1a3ebcf",
                        "source_sense_id": "0b1dbddd-77bb-3888-aee6-645262846125",
                        "target_lang_word": "mistyfikacja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistyfikacja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                                        "entry_id": "a37227c6-7f00-37a4-a1b9-761fe311dfc2",
                                        "glosses": [
                                            "celowe wprowadzenie kogoś w błąd przez zaaranżowanie sytuacji stwarzającej pozory prawdy, a nie będącej prawdą; także: to, co jest rezultatem takiego działania"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e9bcce9-03b1-4137-b9b1-cfd62470cf01",
                                                "sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                                                "text": "Ten rozwód był mistyfikacją, oni nadal żyją szczęśliwie, chodziło tylko o podatki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc7b29e-c47f-409a-8b1f-d9a065e9fe81",
                        "source_entry_id": "7c94a89c-fdb7-3471-8654-9a5dc1a3ebcf",
                        "source_sense_id": "0b1dbddd-77bb-3888-aee6-645262846125",
                        "target_lang_word": "mystification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                        "entry_id": "c03f5acb-0eb3-32f3-86a9-713139bdf691",
                                        "glosses": [
                                            "Action de mystifier, de berner, de duper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75665053-a567-480b-a096-a4adc14133f5",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "La mystification est la ressource des petits esprits. Depuis quelque temps, je ne réponds plus aux masques..."
                                            },
                                            {
                                                "example_id": "0dd4c70b-6b81-4093-a77f-4e77e88afd6e",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Le sophisme que je combats dans cet écrit est d’autant plus dangereux, appliqué aux travaux publics, qu’il sert à justifier les entreprises et les prodigalités les plus folles. Quand un chemin de fer ou un pont ont une utilité réelle, il suffit d’invoquer cette utilité. Mais si on ne le peut, que fait-on ? On a recours à cette mystification : « Il faut procurer de l’ouvrage aux ouvriers. »"
                                            },
                                            {
                                                "example_id": "a9419d93-f280-4ccd-8899-305862852db9",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Sir Walter-Scott avait honte de son métier. Il a passé une partie de son existence à donner le change sur la nature de ses occupations. C'était le secret de la comédie ; mais tout le monde se fit le complice volontaire de cette innocente mystification."
                                            },
                                            {
                                                "example_id": "c3ec5d5d-4ed4-4d6f-8709-d738ee906c38",
                                                "sense_id": "96c9ff62-7286-30a1-bb85-8ca4c7b22ff8",
                                                "text": "Il se considérait, non sans raison, comme un mystifié de la nature, et il ne pardonnerait jamais à la nature une pareille mystification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8e69a0e-bd45-487d-896d-9f58af9809b0",
                        "source_entry_id": "7c94a89c-fdb7-3471-8654-9a5dc1a3ebcf",
                        "source_sense_id": "0b1dbddd-77bb-3888-aee6-645262846125",
                        "target_lang_word": "fumisterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fumisterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8072453a-2ba5-3e80-bfc1-6950b1b6dd14",
                                        "entry_id": "b5e47350-59f8-3626-b989-3158d5d14f16",
                                        "glosses": [
                                            "Profession, travail du fumiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad1dc88-35a6-4436-b0d3-aefc91dd3424",
                                                "sense_id": "8072453a-2ba5-3e80-bfc1-6950b1b6dd14",
                                                "text": "Avant de quitter Bâle, il ne faut cependant pas oublier de signaler les merveilleux poêles qu’on y peut admirer un peu partout, dans les hôtels, auberges et autres lieux publics. Ce n’est plus de la fumisterie, c’est de l’art ! les tuyaux surtout sont splendides. = Albert Robida (1848-1926), \"Les Vieilles villes de Suisse\" (1879)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03211562-4c15-3532-b441-4120db5948c0",
                                        "entry_id": "b5e47350-59f8-3626-b989-3158d5d14f16",
                                        "glosses": [
                                            "Se dit familièrement d’une mauvaise plaisanterie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59fe5fd9-b9e2-480b-9094-37fe7dd570ad",
                                                "sense_id": "03211562-4c15-3532-b441-4120db5948c0",
                                                "text": "Dans le courant de 1881, le conseil municipal crut donc me faire une énorme fumisterie en adoptant une proposition qui supprimait la brigade des mœurs à partir du 1ᵉʳ Janvier 1882 et m’invitait à prendre mes mesures en conséquence."
                                            },
                                            {
                                                "example_id": "19261a17-1da5-4aec-8990-f3bd80f54339",
                                                "sense_id": "03211562-4c15-3532-b441-4120db5948c0",
                                                "text": "Le choc que l’on reçoit d’abord d’un objet d’art est un choc psychique, ensuite vient l’examen technique, la patine, les trous de ver dans le bois et autres fumisteries."
                                            },
                                            {
                                                "example_id": "4f09b630-bea8-47b3-874e-cee96bedce4d",
                                                "sense_id": "03211562-4c15-3532-b441-4120db5948c0",
                                                "text": "Printemps 1910, New York. La vente aux enchères de la collection Hoe, surnommée la vente du siècle.[…]\n– Cette vente n’était qu’une fumisterie !!! Tout, absolument tout a été surpayé… Quelle honte !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
