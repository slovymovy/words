                        "glosses": [
                            "To undo or remove grace; render grace ineffective; make ungraceful or ungracious."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a0076ba-5e37-409f-ae4a-3b3be843fd67",
                                "sense_id": "bf6bb4ae-6299-36ec-8a11-aaac025d3dda",
                                "text": "It is another one of those experiences of ungracing the grace of God and putting boundaries, putting dogmas, putting creeds around the grace of God that ungraces the grace of God."
                            }
                        ]
                    }
