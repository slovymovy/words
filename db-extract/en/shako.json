                "translations": [
                    {
                        "translation_id": "421cf5da-feb8-4d79-87c8-3d09c4ad8066",
                        "source_entry_id": "bfb35664-563f-39fd-8384-699e3af5b12e",
                        "source_sense_description": "military dress hat",
                        "target_lang_word": "čáka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čáka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4896634a-8c83-35e9-aab4-a60834f0d61e",
                                        "entry_id": "86415615-0e56-3141-ad8a-7ca76c2b8796",
                                        "glosses": [
                                            "očekávání, naděje, vyhlídka"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf9a402-55e7-41a7-a940-7c746c4e6d27",
                                                "sense_id": "4896634a-8c83-35e9-aab4-a60834f0d61e",
                                                "text": "Když nemocný v horečce o sobě již zase ví, tu jest čáka brzkého se uzdravení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34fe2c0f-37e5-3cbd-923d-20f0cab9e03f",
                                        "entry_id": "86415615-0e56-3141-ad8a-7ca76c2b8796",
                                        "glosses": [
                                            "vysoká tvrdá pokrývka hlavy k uniformě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b32d07-1886-45b9-b0cf-192fe15fc05a",
                                                "sense_id": "34fe2c0f-37e5-3cbd-923d-20f0cab9e03f",
                                                "text": "Měl na hlavě černou čáku se zlatými prýmkami a lesklým jablíčkem, na těle modrý kabát s výložkami a vyleštěnými knoflíky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8df4b7ce-a16d-4670-b49c-fd72abffb423",
                        "source_entry_id": "bfb35664-563f-39fd-8384-699e3af5b12e",
                        "source_sense_description": "military dress hat",
                        "target_lang_word": "shako",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shako",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                        "entry_id": "c7e23198-c134-3503-a1df-771be01bb8b9",
                                        "glosses": [
                                            "Coiffure militaire rigide, portée autrefois par les hussards, les chasseurs et la plupart des corps d’infanterie et qu’ont seulement conservée les saints-Cyriens et la garde républicaine à pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f914523d-ef5a-4438-8dd6-3ec53efec3bb",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "Je pourrais vous tuer ; mais les hommes de cœur sont devenus rares, et je vous donne la vie. Voici un souvenir qui vous apprendra à m’éviter. À votre schako ! »\nEn parlant ainsi il l’ajuste, et d’une balle il traverse le haut du schako du capitaine. Aussitôt il tourna bride et disparut avec ses gens."
                                            },
                                            {
                                                "example_id": "3fc522bd-beb1-423b-91b4-f16a99edec42",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "Presque aussitôt cinq ou six officiers russes avec leurs shakos relevés devant, aplatis derrière, leurs grands manteaux vert sombre, le sabre à la ceinture et les hautes bottes montant jusqu'aux genoux, entrèrent en se penchant sous notre porte, et regardant à droite et à gauche."
                                            },
                                            {
                                                "example_id": "6ab82d47-ae88-4837-8d69-0045169feea3",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "De vieux châteaux sont demeurés en ce vallage féodal. Doumely-Bégny orne les quatre angles du sien de tours à bec, coiffées de cônes anguleux, pareils à des shakos longtemps portés, avachis par l'usage."
                                            },
                                            {
                                                "example_id": "ed15ac4d-37fb-425b-8143-03209ba04d0a",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "Donc, dans un enchevêtrement de brandebourgs et d'épaulettes, plus constellé de boutons d'or qu'une prairie au printemps, coiffé d'une espèce de shako insensé, le « président-général » Béru se présente dans la cour."
                                            },
                                            {
                                                "example_id": "9ccfebef-7e3e-493e-aff0-b78352e08fe5",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "[…], Beau Geste se leva et, beau comme un dieu avec sa pelisse écarlate à tresses jaunes, son shako noir à plumet, sa sabretache de cuir verni et sa ceinture cramoisie à olives jaunes, se mit à tonner :\n “Aubergiste, à boire ou je tue le chien ! Donne à mes hussards ton meilleur vin de Moselle et descends pour nous dans la cave."
                                            },
                                            {
                                                "example_id": "4f0435e7-bfbc-4b33-981b-36813abc3c91",
                                                "sense_id": "15121d82-4dc9-3071-a392-b7cc9393fd86",
                                                "text": "Raides comme des pantins, deux saint-cyriens arrivaient vers lui. Une mauvaise peau leur faisait les joues luisantes sous leurs shakos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba842689-4962-48d0-8b8e-4599efa074a5",
                        "source_entry_id": "bfb35664-563f-39fd-8384-699e3af5b12e",
                        "source_sense_description": "military dress hat",
                        "target_lang_word": "Tschako",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tschako",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dca3c6-8286-3b83-ae5f-900bbc462207",
                                        "entry_id": "23918324-eb2c-34b5-8da9-340671912a66",
                                        "glosses": [
                                            "Militär, Polizei: helmartige Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6bbc07e-0572-4328-997b-d161ab08da89",
                                                "sense_id": "d5dca3c6-8286-3b83-ae5f-900bbc462207",
                                                "text": "„Drohend sitzen eng über den Brauen die vom Sturmband gehaltenen Tschakos.“"
                                            },
                                            {
                                                "example_id": "c4dd89d5-2ef6-476d-81b9-bb1bcac80a6b",
                                                "sense_id": "d5dca3c6-8286-3b83-ae5f-900bbc462207",
                                                "text": "„Die Sturmriemen der Tschakos waren heruntergelassen.“"
                                            },
                                            {
                                                "example_id": "95beead4-2b59-46d8-a4e6-3774daf1696a",
                                                "sense_id": "d5dca3c6-8286-3b83-ae5f-900bbc462207",
                                                "text": "„Gendarmeriewachtmeister Schubert ließ das Papier sinken, nahm den Tschako vom Kopf, wischte den Innenrand mit dem Taschentuch ab, setzte den Helm wieder auf und ging ans Fenster.“"
                                            },
                                            {
                                                "example_id": "43fe1325-9b95-456a-8832-fd51f65cb3b7",
                                                "sense_id": "d5dca3c6-8286-3b83-ae5f-900bbc462207",
                                                "text": "„Er hieß den Kaiser mit einem Grußwort auf französisch willkommen, dann schritten die beiden das Ehrenspalier der baden-württembergischen Bereitschaftspolizei in Paradeuniform mit Tschako ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf054b57-939e-4e1d-bbdb-ca00e783ab04",
                        "source_entry_id": "bfb35664-563f-39fd-8384-699e3af5b12e",
                        "source_sense_description": "military dress hat",
                        "target_lang_word": "czako",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "czako",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f2bf6802-f61c-36c6-8b9a-22add4169e78",
                                        "entry_id": "22cc9b22-7de5-3dbc-8c9d-773c75536acc",
                                        "glosses": [
                                            "wojskowa czapka, wysoka i bardzo sztywna, używana od końca XVIII wieku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98de1846-399a-4787-be0b-3a0a727d3ae9",
                                                "sense_id": "f2bf6802-f61c-36c6-8b9a-22add4169e78",
                                                "text": "Cała gwardia zazdrościła im tego, jako też grenadierek: czak z czasów Pawła I"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad48d24c-36e6-49c1-8b1a-22752f8f441c",
                        "source_entry_id": "bfb35664-563f-39fd-8384-699e3af5b12e",
                        "source_sense_description": "military dress hat",
                        "target_lang_word": "ки́вер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ки́вер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "39ca0eba-9d36-3c19-9e10-6ba2a105f960",
                                        "entry_id": "78e48f5c-142c-3443-8e6f-91f4b349e6c6",
                                        "glosses": [
                                            "истор., воен. в некоторых европейских армиях XVIII—XIX вв. — высокий жёсткий головной убор цилиндрической или конусообразной формы с плоским верхом, с козырьком и подбородочным ремнем, часто с украшением в виде султана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e7bea1-a13c-4170-933c-c1dfbf680898",
                                                "sense_id": "39ca0eba-9d36-3c19-9e10-6ba2a105f960",
                                                "text": "Поглядев на мост, он видел столь же однообразные живые волны солдат, кутасы, кивера с чехлами, ранцы, штыки, длинные ружья и из-под киверов лица с широкими скулами, ввалившимися щеками и беззаботно-усталыми выражениями и движущиеся ноги по натасканной на доски моста липкой грязи."
                                            },
                                            {
                                                "example_id": "f06a24dd-1c9a-40d9-aad4-03e3f6c97abb",
                                                "sense_id": "39ca0eba-9d36-3c19-9e10-6ba2a105f960",
                                                "text": "Кузьма Васильевич посторонился; чувство сострадания победило в нём опасение смалодушничать, и когда она с ним поровнялась, он вежливо прикоснулся к козырьку своего кивера и спросил её о причине её слез."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
