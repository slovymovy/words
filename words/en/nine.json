                                "ru": "Он работает с <w>девяти</w> до пяти каждый будний день.",
                                "zh": "他每个工作日都从<w>九</w>点工作到五点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nine times out of ten",
                        "nine to five",
                        "on cloud nine",
                        "dressed to the nines"
