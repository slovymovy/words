                        "entry_id": "f41dc8e3-f219-3c1b-8fff-b617238fe8fc",
                        "glosses": [
                            "een maaimachine die het graan tevens schoven bindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ff44dd-2f38-4d8e-935d-3b33b3fc1a74",
                                "sense_id": "1b4e39f3-4170-3274-b83d-3b2bdd898204",
                                "text": "Naast het handmatig oogsten worden ook modernere manieren gedemonstreerd. Het zachte geruis van de zicht wordt ingeruild voor een maaimachine getrokken door paard, een zelfbinder en een combain."
                            },
                            {
                                "example_id": "e8260526-bc5a-4c73-bf66-8db348e9e642",
                                "sense_id": "1b4e39f3-4170-3274-b83d-3b2bdd898204",
                                "text": "Ook is er een demonstratie door een ‘zelfbinder’ met drie paarden. Je kunt gratis deze bijzondere middag bijwonen."
                            },
                            {
                                "example_id": "f1fb5c76-761c-497c-986c-1bd712b0195b",
                                "sense_id": "1b4e39f3-4170-3274-b83d-3b2bdd898204",
                                "text": "Het spant er in de ochtend om, maar het bestuur van de vereniging besluit om zeven uur de zeis en zelfbinder toch in te zetten."
                            }
                        ]
                    }
