                    {
                        "sense_id": "6f3fef6a-24a7-353c-963e-9d7ac976ec89",
                        "entry_id": "5e505539-67f2-367a-88d5-251f5f93d7e1",
                        "glosses": [
                            "główny kościół parafialny w mieście"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fd4ee413-8bb7-42d1-a5ab-afb30fc858aa",
                                "sense_id": "6f3fef6a-24a7-353c-963e-9d7ac976ec89",
                                "text": "Poszliśmy najpierw do fary, a stamtąd ze śpiewem i chorągwiami do Franciszkanów, gdzie pielgrzymi ze wszystkich kaliskich parafii się zebrali na uroczyste pobłogosławienie pielgrzymki i pożegnanie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e8583afb-a446-318a-bed7-c0b2ef40d023",
                        "entry_id": "5e505539-67f2-367a-88d5-251f5f93d7e1",
                        "glosses": [
                            "gw. (Górny Śląsk) parafia"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "dc534bcc-e9f5-3497-b24e-0a7fdcd2ff77",
                        "entry_id": "5e505539-67f2-367a-88d5-251f5f93d7e1",
                        "glosses": [
                            "gw. (Górny Śląsk) plebania, probostwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1211ec2-8313-418a-bf89-d73773131bd2",
                                "sense_id": "dc534bcc-e9f5-3497-b24e-0a7fdcd2ff77",
                                "text": "Byłżech dzisiej na farze zamówić mszo za fatra.",
                                "translation": "Byłem dziś na plebanii zamówić mszę za ojca."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
