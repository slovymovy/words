{
    "word_family": [
        "passion",
        "passionnant",
        "passionnément",
        "passionnel",
        "dépassionner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84fe1b54-a0ca-39c3-b31f-9a73bbfb6800",
                    "sense_definition": "Éveiller un vif intérêt, captiver ou enthousiasmer une personne ou un public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "susciter_interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau professeur sait captiver ses élèves et <w>passionner</w> tout son auditoire."
                        },
                        {
                            "text": "Ce sujet d'actualité <w>passionne</w> les foules depuis plusieurs semaines dans tout le pays."
                        }
                    ],
                    "synonyms": [
                        "captiver",
                        "enthousiasmer",
                        "intéresser"
                    ],
                    "antonyms": [
                        "ennuyer",
                        "désintéresser",
                        "lasser"
                    ],
                    "common_phrases": [
                        "passionner les foules"
                    ]
                },
                {
                    "sense_id": "2c3b07db-215b-379d-a51c-8f5fd74b534d",
                    "sense_definition": "Prendre un intérêt très vif pour une activité, un sujet ou un domaine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eprouver_interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son enfance, elle a commencé à se <w>passionner</w> pour la musique classique."
                        },
                        {
                            "text": "Mon frère se <w>passionne</w> pour les jeux vidéo et y consacre tout son temps libre."
                        }
                    ],
                    "synonyms": [
                        "s'engouer",
                        "s'enthousiasmer"
                    ],
                    "antonyms": [
                        "se désintéresser"
                    ],
                    "common_phrases": [
                        "se passionner pour"
                    ]
                },
                {
                    "sense_id": "485d8043-0cea-3050-93d7-bdb6ec622d33",
                    "sense_definition": "Rendre un débat ou un échange particulièrement animé et ardent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "susciter_interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les récents événements politiques ont contribué à <w>passionner</w> le débat parmi les citoyens."
                        },
                        {
                            "text": "Le journaliste tente de <w>passionner</w> cette controverse pour attirer davantage de lecteurs."
                        }
                    ],
                    "synonyms": [
                        "enflammer",
                        "animer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "passionner le débat"
                    ]
                },
                {
                    "sense_id": "faf54400-15ca-3888-8ec7-08934b51c780",
                    "sense_definition": "Éprouver une passion amoureuse vive et ardente pour quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eprouver_interet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Romantique dans l'âme, il a tendance à se <w>passionner</w> pour chaque personne qu'il rencontre."
                        },
                        {
                            "text": "Elle finit par se <w>passionner</w> pour cet artiste mystérieux rencontré lors d'un voyage."
                        }
                    ],
                    "synonyms": [
                        "s'éprendre",
                        "s'amouracher"
                    ],
                    "antonyms": [
                        "se détacher"
                    ]
                }
            ]
        }
    ]
}