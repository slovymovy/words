    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4df15dc5-a537-36c0-84e6-06fe249990ff",
                    "sense_definition": "The killing of animals, generally for food.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "killing_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer prepared the cattle for <w>slaughter</w> before the winter.",
                            "target_lang_translations": {
                                "ru": "Фермер подготовил скот к <w>убою</w> перед зимой.",
                                "zh": "农民在入冬前准备将牛<w>屠宰</w>。"
                            }
                        },
                        {
                            "text": "Strict regulations govern the humane <w>slaughter</w> of livestock.",
                            "target_lang_translations": {
                                "ru": "Строгие правила регулируют гуманный <w>забой</w> скота.",
                                "zh": "严格的法规规范了牲畜的人道<w>屠宰</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cattle slaughter",
                        "lambs to the slaughter",
                        "fit for slaughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерщвление животных, как правило, для получения пищи.",
                        "zh": "指为了获取肉食而进行的动物屠宰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убой",
                                "target_lang_sense_clarification": "профессиональный или технический термин"
                            },
                            {
                                "target_lang_word": "забой",
                                "target_lang_sense_clarification": "процесс убийства скота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠宰",
                                "target_lang_sense_clarification": "指宰杀牲畜"
                            },
                            {
                                "target_lang_word": "宰杀",
                                "target_lang_sense_clarification": "指杀牲畜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5de1d472-1b62-388e-a837-7940ca4e2807",
                    "sense_definition": "A massacre; the violent killing of a large number of people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war resulted in the terrible <w>slaughter</w> of thousands of innocent civilians.",
                            "target_lang_translations": {
                                "ru": "Война привела к ужасной <w>резне</w> тысяч невинных мирных жителей.",
                                "zh": "战争导致了数千名无辜平民遭到可怕的<w>屠杀</w>。"
                            }
                        },
                        {
                            "text": "Historians described the battle as a scene of wholesale <w>slaughter</w>.",
                            "target_lang_translations": {
                                "ru": "Историки описывали эту битву как сцену массовой <w>бойни</w>.",
                                "zh": "历史学家将这场战役描述为一场大规模的<w>屠杀</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wholesale slaughter",
                        "scene of slaughter",
                        "innocent slaughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массовое убийство; жестокое умерщвление большого количества людей.",
                        "zh": "指大规模的暴力杀戮，即屠杀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резня",
                                "target_lang_sense_clarification": "жестокое массовое убийство"
                            },
                            {
                                "target_lang_word": "бойня",
                                "target_lang_sense_clarification": "кровопролитное сражение или убийство"
                            },
                            {
                                "target_lang_word": "массовое убийство",
                                "target_lang_sense_clarification": "нейтральный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠杀",
                                "target_lang_sense_clarification": "指大规模杀戮"
                            },
                            {
                                "target_lang_word": "大屠杀",
                                "target_lang_sense_clarification": "指惨无人道的大规模杀戮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8daec13a-25ff-3871-82fd-59b8ee8ec156",
                    "sense_definition": "A rout or decisive defeat, often used in sports or games.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The championship game ended in a total <w>slaughter</w> for the visiting team.",
                            "target_lang_translations": {
                                "ru": "Финальная игра чемпионата закончилась полным <w>разгромом</w> для команды гостей.",
                                "zh": "冠军赛以客队的彻底<w>惨败</w>告终。"
                            }
                        },
                        {
                            "text": "It wasn't just a loss; it was an absolute <w>slaughter</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Это был не просто проигрыш, это был абсолютный <w>разгром</w> на поле.",
                                "zh": "这不仅仅是一场失利，简直是赛场上的彻底<w>惨败</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe a heavy defeat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разгром или решительное поражение, часто используется в спорте или играх.",
                        "zh": "指在体育比赛或游戏中遭遇惨败。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгром",
                                "target_lang_sense_clarification": "сокрушительное поражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "指彻底的失败"
                            },
                            {
                                "target_lang_word": "大败",
                                "target_lang_sense_clarification": "指严重的失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "849c82d3-5b8e-37a1-9d4f-15115dd9424e",
                    "sense_definition": "A mass destruction of non-living things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slaughter</w> of the old steam trains marked the end of an era.",
                            "target_lang_translations": {
                                "ru": "<w>Уничтожение</w> старых паровозов ознаменовало конец эпохи.",
                                "zh": "旧蒸汽火车的<w>毁灭</w>标志着一个时代的终结。"
                            }
                        },
                        {
                            "text": "Environmentalists protested the <w>slaughter</w> of the ancient forest by logging companies.",
                            "target_lang_translations": {
                                "ru": "Экологи протестовали против <w>истребления</w> древнего леса лесозаготовительными компаниями.",
                                "zh": "环保人士抗议伐木公司对原始森林的<w>毁灭</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Массовое уничтожение неодушевленных предметов.",
                        "zh": "指对无生命物体的大规模破坏或毁灭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уничтожение",
                                "target_lang_sense_clarification": "полное разрушение"
                            },
                            {
                                "target_lang_word": "истребление",
                                "target_lang_sense_clarification": "метафорически о предметах (леса, техника)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毁灭",
                                "target_lang_sense_clarification": "指彻底摧毁"
                            },
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "指造成严重损坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "012e15f0-cbac-33b9-8903-3b6d854ab01e",
                    "sense_definition": "A group of iguanas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We observed a <w>slaughter</w> of iguanas basking on the rocks.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали <w>стаю</w> игуан, греющихся на камнях.",
                                "zh": "我们观察到<w>一群</w>鬣蜥在岩石上晒太阳。"
                            }
                        },
                        {
                            "text": "The guide pointed out a <w>slaughter</w> moving through the underbrush.",
                            "target_lang_translations": {
                                "ru": "Гид указал на <w>группу</w> игуан, движущуюся через подлесок.",
                                "zh": "导游指出了正在灌木丛中穿行的<w>一群</w>鬣蜥。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа игуан.",
                        "zh": "指一群鬣蜥。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一群",
                                "target_lang_sense_clarification": "指动物的聚集"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2772646c-291e-3451-be55-66d19d5c9d32",
                    "sense_definition": "To butcher animals, generally for food.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "killing_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They raise pigs on the farm and <w>slaughter</w> them in the autumn.",
                            "target_lang_translations": {
                                "ru": "На ферме выращивают свиней и <w>забивают</w> их осенью.",
                                "zh": "他们在农场养猪，并在秋天将它们<w>屠宰</w>。"
                            }
                        },
                        {
                            "text": "The cattle were <w>slaughtered</w> for their meat and hides.",
                            "target_lang_translations": {
                                "ru": "Скот <w>зарезали</w> ради мяса и шкур.",
                                "zh": "牛被<w>屠宰</w>以获取肉和皮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slaughter cattle",
                        "slaughter for meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забивать животных, обычно на мясо.",
                        "zh": "指宰杀动物以获取肉食。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "убивать скот на мясо"
                            },
                            {
                                "target_lang_word": "резать",
                                "target_lang_sense_clarification": "разговорное, убивать ножом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠宰",
                                "target_lang_sense_clarification": "指宰杀牲畜"
                            },
                            {
                                "target_lang_word": "宰杀",
                                "target_lang_sense_clarification": "指杀牲畜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3fc70ec-9b63-3670-9077-3c7d12f494e5",
                    "sense_definition": "To massacre people in large numbers.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army <w>slaughtered</w> the villagers without mercy.",
                            "target_lang_translations": {
                                "ru": "Армия захватчиков безжалостно <w>вырезала</w> жителей деревни.",
                                "zh": "侵略军无情地<w>屠杀</w>了村民。"
                            }
                        },
                        {
                            "text": "Thousands of soldiers were <w>slaughtered</w> during the first day of the offensive.",
                            "target_lang_translations": {
                                "ru": "Тысячи солдат были <w>истреблены</w> в первый день наступления.",
                                "zh": "在进攻的第一天，数千名士兵遭到<w>屠杀</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slaughter civilians",
                        "slaughter the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массово убивать людей; устраивать резню.",
                        "zh": "指大规模地杀害人群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "убить всех или многих"
                            },
                            {
                                "target_lang_word": "истреблять",
                                "target_lang_sense_clarification": "уничтожать полностью"
                            },
                            {
                                "target_lang_word": "устроить резню",
                                "target_lang_sense_clarification": "совершить массовое насилие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屠杀",
                                "target_lang_sense_clarification": "指大规模杀戮"
                            },
                            {
                                "target_lang_word": "残杀",
                                "target_lang_sense_clarification": "指残酷地杀害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3466b666-2f50-3a25-ab7a-612f3b8095e3",
                    "sense_definition": "To kill someone or something, especially in a particularly brutal manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "killing_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero vowed to defeat the beast that had <w>slaughtered</w> his family.",
                            "target_lang_translations": {
                                "ru": "Герой поклялся победить зверя, который <w>зверски убил</w> его семью.",
                                "zh": "英雄发誓要打败那只<w>残忍杀害</w>了他家人的野兽。"
                            }
                        },
                        {
                            "text": "He was accused of <w>slaughtering</w> his rivals to seize power.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он <w>расправился</w> с соперниками ради захвата власти.",
                                "zh": "他被指控为了夺权而<w>残忍杀害</w>了竞争对手。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить кого-то или что-то, особенно жестоким способом.",
                        "zh": "指以极其残忍的方式杀害某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверски убить",
                                "target_lang_sense_clarification": "убить с особой жестокостью"
                            },
                            {
                                "target_lang_word": "расправиться",
                                "target_lang_sense_clarification": "жестоко наказать или убить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "残忍杀害",
                                "target_lang_sense_clarification": "指极其残暴地杀人"
                            },
                            {
                                "target_lang_word": "屠戮",
                                "target_lang_sense_clarification": "指残暴地杀戮"
                            }
                        ]
                    }
                }
            ]
        },
        {
