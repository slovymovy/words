                    {
                        "translation_id": "5b626c49-dd05-446a-835a-a288e88f29b9",
                        "source_entry_id": "9779ea45-f0c8-359a-94f2-2598ac3687c4",
                        "source_sense_id": "aab33802-03f0-33e0-8e59-a83c856c0fdd",
