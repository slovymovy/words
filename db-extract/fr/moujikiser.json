                        "examples": [
                            {
                                "example_id": "b1c2a00f-68c5-4cd8-8d2a-816ee9d7ffd1",
                                "sense_id": "46dca82c-d320-36a7-835e-c5bf9b9200d1",
                                "text": "On sera envahis — moujikisés, lithuanisés en cinq secs — Amen ."
                            },
                            {
                                "example_id": "798e3f9e-e608-4baf-8efe-85369a483144",
                                "sense_id": "46dca82c-d320-36a7-835e-c5bf9b9200d1",
                                "text": "Et voilà qu’un architecte « moujikisé » nous propose sans vergogne de « monter » dans nos villes des « isbas » de chasseurs de cerfs."
                            }
                        ]
