                        "examples": [
                            {
                                "example_id": "399894c7-1329-4793-83ca-0667c9868c27",
                                "sense_id": "468e86e3-7210-3b88-9733-4a857b1e95bb",
                                "text": "Wspomnienia o Magdalenie Samozwaniec to (…) kopalnia wiedzy o pisarce, która przez całe życie piórem walczyła z hipokryzją, zakłamaniem i kołtuństwem"
                            }
