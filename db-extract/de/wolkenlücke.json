                "senses": [
                    {
                        "sense_id": "ec013cda-401b-3d8e-8653-2c4a48e493a3",
                        "entry_id": "3a00c46f-a199-3dd7-8090-a10173a6e9b1",
                        "glosses": [
                            "kleine Öffnung in den Wolken"
