            "senses": [
                {
                    "sense_id": "94a97b11-e46c-345c-94b1-0e926c7159e9",
                    "sense_definition": "Son produit par un appareil ou un objet qui retentit pour donner un signal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>sonnerie</w> de mon téléphone m'a réveillé au milieu de la nuit."
                        },
                        {
                            "text": "À la fin du cours, les élèves attendent tous la <w>sonnerie</w> avec impatience."
                        }
                    ],
                    "synonyms": [
                        "signal sonore"
                    ],
                    "common_phrases": [
                        "sonnerie de téléphone",
                        "sonnerie du réveil"
                    ]
                },
                {
                    "sense_id": "57c71965-4a3e-3107-861c-131f17efa3ca",
                    "sense_definition": "Dispositif électrique ou mécanique conçu pour émettre un signal sonore d'avertissement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le facteur a appuyé sur le bouton de <w>sonnerie</w> pour annoncer son arrivée."
                        },
                        {
                            "text": "La <w>sonnerie</w> de l'entrée est en panne, il faut frapper à la porte."
                        }
                    ],
                    "synonyms": [
                        "avertisseur acoustique",
                        "timbre"
                    ],
                    "common_phrases": [
                        "bouton de sonnerie"
                    ]
                },
                {
                    "sense_id": "4addb074-23d9-3eee-b879-3cb5292d2f67",
                    "sense_definition": "Air musical ou signal exécuté avec un instrument à vent ou des cloches pour une circonstance particulière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats écoutaient avec recueillement la <w>sonnerie</w> aux morts lors de la commémoration."
                        },
                        {
                            "text": "Au petit matin, une <w>sonnerie</w> de clairon a réveillé tout le camp militaire."
