                                        "glosses": [
                                            "Jamais de la vie !"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49871f0-789d-4f6b-b6b3-48f67779f4ba",
                                                "sense_id": "31f97712-fb15-3fc4-9650-33b2af338ffa",
                                                "text": "– Vous avez cru me coudre la bouche avec votre pension de six cents francs, plus souvent que je me laisserai faire ; Marie Silvert ne veut pas de vos rentes, ça la salirait !"
                                            },
                                            {
                                                "example_id": "6ed516f8-f740-45a6-b850-52f22cb6c7b9",
                                                "sense_id": "31f97712-fb15-3fc4-9650-33b2af338ffa",
                                                "text": "N. de D., d’la rigolade y en aurait que pour eux ? Plus souvent, puisque j’peux pas trouver un homme qui me prenne, j’vas me les payer tous — mes enfants, ça vous fera honneur, votre future belle-sœur vient vous faire part de son entrée au b… !"
                                            },
                                            {
                                                "example_id": "72028792-b0c9-4659-94d8-175ad1a4c632",
                                                "sense_id": "31f97712-fb15-3fc4-9650-33b2af338ffa",
                                                "text": "« Plus souvent ! murmura-t-il… Si elle croit que j’irai chez cette Gaudran… »"
                                            }
                                        ]
