                                    },
                                    {
                                        "sense_id": "9b98fc29-6b21-3aed-809b-e96343d5ab11",
                                        "entry_id": "73ebfb41-b097-34d2-9bfe-0b2fd6e82662",
                                        "glosses": [
                                            "sehr schnell, mit hohem Tempo"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
