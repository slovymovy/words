                        "glosses": [
                            "w XVIII–XIX w.: zwolennik ruchu dążącego do zniesienia niewolnictwa i sprzeciwiającego się dyskryminacji rasowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d350e12-d3ad-4ee7-ace4-fb9a2124e1e7",
                                "sense_id": "d28f636a-d5ee-333f-b721-32a058bcb5ef",
                                "text": "Stał się częstym mówcą na spotkaniach w kręgach abolicjonistów"
                            }
                        ],
