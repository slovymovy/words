                "senses": [
                    {
                        "sense_id": "86968b03-e142-3b2e-9fd4-0bcf5ddfcb11",
                        "entry_id": "d42e9a14-e695-3754-b77c-4c0bf699994b",
                        "glosses": [
                            "veraltend: dichte, voluminöse Behaarung des männlichen Gesichts"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "scherzhaft,"
                        ],
                        "examples": [
                            {
                                "example_id": "af7d6df3-94f0-4859-8967-2d0e7fb188bd",
                                "sense_id": "86968b03-e142-3b2e-9fd4-0bcf5ddfcb11",
                                "text": "„Der Hotelbesitzer nimmt es mit der Individualität erkennbar ernst, er trägt Kutte und Rauschebart zu zwei unterschiedlichen Fell-Clogs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "492e3239-e7e3-3c6c-829d-5e430e53573e",
                        "entry_id": "d42e9a14-e695-3754-b77c-4c0bf699994b",
                        "glosses": [
                            "veraltend: Mann mit [1], meist im betagten Alter"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "scherzhaft,"
                        ],
                        "examples": [
                            {
                                "example_id": "e30df7c5-aed4-4d58-8563-c51b13c99168",
                                "sense_id": "492e3239-e7e3-3c6c-829d-5e430e53573e",
                                "text": "„Auf dem Podium sitzen ein bis auf die Stoppeln rasierter Kandidat und zwei von jenen Rauschebärten, die im streng religiösen Saudi-Arabien stets zugegen sind, sobald etwas öffentlich wird – islamische Geistliche.“"
                            },
                            {
                                "example_id": "0714803d-8a4a-4a38-90fb-95c07c02fc05",
                                "sense_id": "492e3239-e7e3-3c6c-829d-5e430e53573e",
                                "text": "„Nun, der Meister jedenfalls, den sie drei Treppenstufen weiter oben im Haus im Kaminzimmer antrafen, überraschte Böhnel und war kein bisschen moppeliger Rauschebart.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
