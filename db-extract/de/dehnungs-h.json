                    }
                ],
                "senses": [
                    {
                        "sense_id": "12f3cac8-52b4-38f0-9e28-dcf1e542cde7",
                        "entry_id": "4c42b09d-9f5a-3fd0-b380-b2350b6c191d",
                        "glosses": [
                            "Buchstabe ›h‹ in einem Wort, der anzeigt, dass der vorhergehende Vokal lang gesprochen werden soll, selbst aber nicht gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf7943a-b8fc-42c2-a30a-602a3a1ee6ea",
                                "sense_id": "12f3cac8-52b4-38f0-9e28-dcf1e542cde7",
                                "text": "„Da das Dehnungs-h in morphologisch einfachen Formen nur bei kurzem, das heißt einfachem Endrand auftritt, trägt es gleichzeitig dazu bei, dass die Endränder optisch verlängert werden.“"
                            },
                            {
                                "example_id": "45c3084a-6983-46c5-b83f-f107703479c7",
                                "sense_id": "12f3cac8-52b4-38f0-9e28-dcf1e542cde7",
                                "text": "„Wer solche Fragen stellt, blendet aus, dass es um weit mehr geht als um Dehnungs-h und Doppel-s.“"
                            },
                            {
                                "example_id": "f6f6c31a-340d-4e71-af65-faec5981e373",
                                "sense_id": "12f3cac8-52b4-38f0-9e28-dcf1e542cde7",
                                "text": "„Die Maskilim, die Aufklärer, fügten Doppelkonsonanten und sogar das Dehnungs-h aus dem Neuhochdeutschen in die jiddische Schreibweise ein.“"
                            },
                            {
                                "example_id": "5995bb02-4eeb-41d2-922c-1824ef991e77",
                                "sense_id": "12f3cac8-52b4-38f0-9e28-dcf1e542cde7",
                                "text": "„Was ich für die Schule aufholen mußte, brachte Mama mir bei. Das Dehnungs-h in Kohl, Kuh, mehr, Möhren, Ohr, sehr, weh und Zeh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
