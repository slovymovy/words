                        ],
                        "examples": [
                            {
                                "example_id": "fce0d804-6537-40b2-84d2-4a89fb87b7ca",
                                "sense_id": "f3c1ebe4-1282-3c73-be9c-1d597fb38935",
                                "text": "Le maintien d’un sous-étage limite les risques de brognes sur le Chêne pédonculé."
                            }
                        ]
