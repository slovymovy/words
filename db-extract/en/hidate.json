                "senses": [
                    {
                        "sense_id": "6f12feff-7115-3574-8c13-b59d05fdd96c",
                        "entry_id": "617d7b97-4d40-3c05-a111-f260011e6b04",
                        "glosses": [
                            "To divide (a region, such as a shire or hundred) into hides."
                        ],
                        "tags": [
                            "historical",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c7949025-2c29-43ad-9101-2c04afd76902",
                                "sense_id": "6f12feff-7115-3574-8c13-b59d05fdd96c",
                                "text": "In general, the newly-won districts were reckoned in carucates, while the older English territory was hidated."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f3bfb8-aebf-315f-a0d3-2123c82da95a",
                        "entry_id": "617d7b97-4d40-3c05-a111-f260011e6b04",
                        "glosses": [
                            "To assess the geld of (a place, such as a manor or borough) in terms of hides."
                        ],
                        "tags": [
                            "historical",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c09f4423-b2a1-4bb9-9061-4996f5c7e08b",
                                "sense_id": "90f3bfb8-aebf-315f-a0d3-2123c82da95a",
                                "text": "[…] the well-known habit of beneficially hidating land, that is of arbitrarily estimating the number of hides on which it should pay Danegeld without regard for the number of hides there."
                            },
                            {
                                "example_id": "8606f25e-f93d-4f3e-a3fd-e48b67706f6c",
                                "sense_id": "90f3bfb8-aebf-315f-a0d3-2123c82da95a",
                                "text": "Some of the king's manors were not hidated, and some were hidated but did not geld."
                            }
                        ]
                    }
                ],
