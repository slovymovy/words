                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc76e7f4-8ebb-4243-b038-4e57c0005010",
                                "sense_id": "3a02fe2b-781e-35b1-843d-c7d476a39fb0",
                                "text": "Образовавшуюся выемку заполняет длинный остров Эвбея, который можно считать продолжением континента, поскольку на севере и востоке Эвбея отделена от материка затопленными долинами."
                            }
                        ]
                    }
                ],
