                        "sense_id": "da631e5e-14d9-3b38-bb94-7cd6f92a7ddb",
                        "entry_id": "218a317b-b047-3552-8097-c4751bdbebad",
                        "glosses": [
                            "действ. прич. прош. вр. от испускать"
                        ],
                        "tags": [
