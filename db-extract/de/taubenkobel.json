                            {
                                "example_id": "842721f6-3e1c-4ca2-b854-c8a00f487602",
                                "sense_id": "df0da112-eb68-3e57-878c-8a28d1c3c009",
                                "text": "„Er verminderte heimlich die Anzahl der pfarrlichen Hühner und Enten, er streute vergifteten Weizen in den Taubenkobel des hochwürdigen Herrn und sorgte dafür, daß die Forellen in dem Fischkalter des Wassers entbehrten.“"
                            }
                        ],
