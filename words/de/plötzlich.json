                    "sense_definition": "ohne Vorwarnung und unerwartet eintretend; auf einmal",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während der Fahrt ging der Motor <w>plötzlich</w> aus.",
                            "target_lang_translations": {
                                "en": "While driving, the engine <w>suddenly</w> cut out.",
                                "ru": "Во время поездки двигатель <w>внезапно</w> заглох.",
                                "nl": "Tijdens de rit viel de motor <w>plotseling</w> uit.",
                                "pl": "Podczas jazdy silnik <w>nagle</w> zgasł.",
                                "fr": "Pendant le trajet, le moteur s'est <w>soudain</w> arrêté.",
                                "it": "Durante la guida, il motore si è spento <w>all'improvviso</w>.",
                                "cs": "Během jízdy motor <w>najednou</w> zhasl.",
                                "tr": "Sürüş esnasında motor <w>aniden</w> durdu.",
                                "es": "Durante la marcha, el motor se apagó <w>de repente</w>.",
                                "zh": "在行驶过程中，发动机<w>突然</w>熄火了。"
                            }
                        },
                        {
                            "text": "<w>Plötzlich</w> klopfte es laut an der geschlossenen Tür.",
                            "target_lang_translations": {
                                "en": "<w>Suddenly</w>, there was a loud knock on the closed door.",
                                "ru": "<w>Внезапно</w> в закрытую дверь громко постучали.",
                                "nl": "<w>Plotseling</w> werd er hard op de gesloten deur geklopt.",
                                "pl": "<w>Nagle</w> głośno zapukano do zamkniętych drzwi.",
                                "fr": "<w>Tout à coup</w>, on frappa fort à la porte fermée.",
                                "it": "<w>All'improvviso</w> bussarono forte alla porta chiusa.",
                                "cs": "<w>Náhle</w> někdo hlasitě zaklepal na zavřené dveře.",
                                "tr": "<w>Birdenbire</w> kapalı kapıya yüksek sesle vuruldu.",
                                "es": "<w>De repente</w>, llamaron fuerte a la puerta cerrada.",
                                "zh": "<w>突然</w>，关着的门上传来了大声的敲门声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "auf einmal",
                        "unvermittelt"
                    ],
                    "antonyms": [
                        "allmählich",
                        "langsam"
                    ],
                    "common_phrases": [
