                                        "examples": [
                                            {
                                                "example_id": "9107a438-cd39-441a-b482-6ac45d2707c3",
                                                "sense_id": "f1662347-8451-3718-8a4e-b30716645837",
                                                "text": "Vždy byl demagogem, lhářem a bezcharakterním, amorálním člověkem"
                                            }
