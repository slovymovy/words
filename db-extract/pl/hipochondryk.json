                                        "glosses": [
                                            "iemand die aan hypochondrie lijdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1551e39b-3b09-4ea5-ae38-43585a48732a",
                                                "sense_id": "4f4a8523-6919-31b6-8bd5-721e4bcaf638",
                                                "text": "hypochonders lijden vaak aan het 'ik heb alle ziektes'-syndroom"
                                            }
                                        ]
