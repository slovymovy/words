                        "form": "das Binärsystem"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                        "entry_id": "f5980759-b13f-362c-95ca-cc97172543ac",
                        "glosses": [
                            "Stellenwertsystem zur Basis 2"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f4b5cd-bc93-418a-b1c8-05182d4e998c",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "Im Binärsystem stehen zwei Ziffern zur Verfügung, die 0 und die 1."
                            },
                            {
                                "example_id": "3898629b-63c9-4cc6-95a9-6f79019b486b",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "Eine „111“ im Binärsystem entspricht einer „7“ im Dezimalsystem."
                            },
                            {
                                "example_id": "bf6ae5ee-b1f8-4439-a224-bfb1ab678f7d",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "Maschinen rechnen üblicherweise im Binärsystem, um es leichter lesen zu können, wird oft das Hexadezimalsystem als Lesehilfe genutzt."
                            },
                            {
                                "example_id": "14abf935-bb4d-4004-96e7-4392d54d7877",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "„Er wandelte die ersten zwanzig Dezimalstellen von Pi in Binärziffern um, weil er glaubte, das Binärsystem sei für Thomas Gray weniger schädlich als das Dezimalsystem.“"
                            },
                            {
                                "example_id": "dc56a74f-6542-4c75-bb77-dbda60f2a565",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "„Auch mit dem Binär- und Hexadezimalsystem wusste er dann später als Erstklässler seine Lehrerin zu verblüffen.“"
                            },
                            {
                                "example_id": "463437e5-2310-4b4c-8945-6c9da1beb1c1",
                                "sense_id": "7d80a7f8-4024-32fc-9a61-9e8376e73198",
                                "text": "„Beim Binärsystem hat eine 1 an der vorletzten Stelle den Wert 2; die Zahl 2 wird also geschrieben 10.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51c0c13b-8ce6-49bd-8c76-d96861e22019",
                        "source_entry_id": "f5980759-b13f-362c-95ca-cc97172543ac",
