    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fc8c6870-282f-3216-af55-c912b90bd19a",
                    "sense_definition": "Sert à intensifier un adjectif, un adverbe ou un verbe ; extrêmement, tout à fait.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce repas est <w>vraiment</w> délicieux, tout le monde adore."
                        },
                        {
                            "text": "Je suis <w>vraiment</w> fatigué après cette longue journée de travail."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "carrément",
                        "extrêmement",
                        "totalement",
                        "tout à fait"
                    ],
                    "common_phrases": [
                        "vraiment bien",
                        "vraiment pas"
                    ]
                },
                {
                    "sense_id": "6442dcf1-d3b7-3f57-aa31-c9fa253bbc9e",
                    "sense_definition": "D'une manière conforme à la réalité ou à la vérité ; effectivement, réellement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce qu'il pense <w>vraiment</w> ce qu'il a dit ce matin ?"
                        },
                        {
                            "text": "Personne ne sait <w>vraiment</w> ce qui s'est passé hier soir."
                        }
                    ],
                    "common_phrases": [
                        "savoir vraiment",
                        "exister vraiment"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "019f6598-76a4-3a81-8f44-28f8241197bf",
                    "sense_definition": "Exprime l'étonnement, l'incrédulité ou la demande de confirmation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as gagné le premier prix, <w>vraiment</w> ?"
                        },
                        {
                            "text": "Ah <w>vraiment</w>, je ne savais pas que tu partais demain !"
                        }
                    ],
                    "synonyms": [
                        "pour de vrai ?",
                        "sérieux ?"
                    ],
                    "common_phrases": [
                        "ah vraiment"
                    ]
                },
                {
                    "sense_id": "df591960-f663-37dc-9a03-71eb9fcd5c70",
                    "sense_definition": "Marque le dépit, l'exaspération ou l'adhésion marquée aux propos d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a encore oublié ses clés au bureau, <w>vraiment</w> !"
                        },
                        {
                            "text": "Tu refuses de m'aider pour ce travail, <w>vraiment</w> !"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Particulièrement fréquent en français d'Afrique"
                        }
                    ]
                }
            ]
        }
