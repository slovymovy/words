                "senses": [
                    {
                        "sense_id": "22611933-6b95-3894-8529-ffd4d22a3f99",
                        "entry_id": "1dd38914-68e0-3300-85ff-48fdc7192f6e",
                        "glosses": [
                            "Sabler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50bd105-3197-480f-9f02-57fb77825a3f",
                                "sense_id": "22611933-6b95-3894-8529-ffd4d22a3f99",
                                "text": "Mais pour ce genre de pièce, nous pouvons les ressabler à la demande, gratuitement, car le procédé est simple, et très rapide."
                            },
                            {
                                "example_id": "35f6a0ec-adfe-4531-ac8d-b453510c41ad",
                                "sense_id": "22611933-6b95-3894-8529-ffd4d22a3f99",
                                "text": "Ma nouvelle question, si j’ai peinturé le contour de ma fenêtre est ce que je dois la ressabler avant de mettre du gel-javel et par la suite repeindre."
                            },
                            {
                                "example_id": "b934d3f9-c19b-4898-ae8d-d53d55571bd3",
                                "sense_id": "22611933-6b95-3894-8529-ffd4d22a3f99",
                                "text": "Ressabler les chemins, pailler les arbustes, biner au pied des plantes, c’est du désherbant en moins !"
                            }
                        ]
                    }
