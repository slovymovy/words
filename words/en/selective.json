{
    "word_family": [
        "select",
        "selection",
        "selectivity",
        "selector",
        "selectively",
        "selectness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8bca6d15-07ab-3b86-b77e-ddcaf9e814d5",
                    "sense_definition": "Choosy, fussy, or discriminating when making a choice.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "personality_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is very <w>selective</w> about the food she eats and avoids anything processed.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>разборчива</w> в еде и избегает всего переработанного.",
                                "zh": "她对吃的食物非常<w>挑剔</w>，避免吃任何加工食品。"
                            }
                        },
                        {
                            "text": "The university is highly <w>selective</w> and accepts only the top students from around the world.",
                            "target_lang_translations": {
                                "ru": "Этот университет очень <w>избирателен</w> и принимает только лучших студентов со всего мира.",
                                "zh": "这所大学的选拔非常<w>严格</w>，只录取来自世界各地的顶尖学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "choosy",
                        "picky",
                        "particular",
                        "discriminating",
                        "fussy"
                    ],
                    "antonyms": [
                        "unselective",
                        "indiscriminate"
                    ],
                    "common_phrases": [
                        "highly selective",
                        "selective about",
                        "very selective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к тщательному выбору; привередливый или требовательный.",
                        "zh": "有选择性的；挑剔的，讲究的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разборчивый",
                                "target_lang_sense_clarification": "привередливый, требовательный к качеству"
                            },
                            {
                                "target_lang_word": "избирательный",
                                "target_lang_sense_clarification": "тщательный в выборе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "指在选择时要求苛刻、认真苛求"
                            },
                            {
                                "target_lang_word": "严格",
                                "target_lang_sense_clarification": "指选拔标准高、要求严"
                            },
                            {
                                "target_lang_word": "讲究",
                                "target_lang_sense_clarification": "指对品质等有较高要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ada81f19-d66e-3ed3-a771-f44ed6ed790e",
                    "sense_definition": "Relating to or involving the act of selecting specific elements while excluding others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seems to have a <w>selective</w> memory, remembering only the facts that benefit him.",
                            "target_lang_translations": {
                                "ru": "Кажется, у него <w>избирательная</w> память: он помнит только те факты, которые ему выгодны.",
                                "zh": "他似乎有着<w>选择性</w>记忆，只记住对自己有利的事实。"
                            }
                        },
                        {
                            "text": "The software uses <w>selective</w> data processing to speed up the final results.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение использует <w>выборочную</w> обработку данных для ускорения получения конечных результатов.",
                                "zh": "该软件采用<w>选择性</w>数据处理，以加快生成最终结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discriminatory"
                    ],
                    "antonyms": [
                        "comprehensive",
                        "all-encompassing"
                    ],
                    "common_phrases": [
                        "selective memory",
                        "selective attention",
                        "selective hearing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с выбором конкретных элементов при исключении других; не сплошной.",
                        "zh": "有选择的；选择性的，只针对特定部分而非全部的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избирательный",
                                "target_lang_sense_clarification": "направленный на определенные объекты"
                            },
                            {
                                "target_lang_word": "выборочный",
                                "target_lang_sense_clarification": "частичный, не полный"
                            },
                            {
                                "target_lang_word": "селективный",
                                "target_lang_sense_clarification": "технический или научный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择性",
                                "target_lang_sense_clarification": "指挑选特定部分而排除其他的属性或状态"
                            },
                            {
                                "target_lang_word": "有选择",
                                "target_lang_sense_clarification": "指并非全盘接受或处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39abceaf-8119-3a5e-a6a5-fbb2d7aeee7d",
                    "sense_definition": "Of or relating to the biological process of natural selection or breeding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "process_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers use <w>selective</w> breeding to produce crops with higher yields and better resistance to disease.",
                            "target_lang_translations": {
                                "ru": "Фермеры используют <w>селекционное</w> разведение для получения культур с более высокой урожайностью и устойчивостью к болезням.",
                                "zh": "农民利用<w>选择性</w>育种来培育产量更高、抗病性更强的农作物。"
                            }
                        },
                        {
                            "text": "Environmental changes create <w>selective</w> pressure on the local wildlife population.",
                            "target_lang_translations": {
                                "ru": "Изменения окружающей среды создают <w>селективное</w> давление на местную популяцию диких животных.",
                                "zh": "环境变化对当地野生动物种群造成了<w>选择性</w>压力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "selective breeding",
                        "selective pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к биологическому процессу естественного отбора или выведения новых пород.",
                        "zh": "生物学中与人工选育或自然选择相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "селекционный",
                                "target_lang_sense_clarification": "относящийся к селекции (разведению)"
                            },
                            {
                                "target_lang_word": "селективный",
                                "target_lang_sense_clarification": "относящийся к отбору"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择性",
                                "target_lang_sense_clarification": "指自然或人为的选择作用"
                            },
                            {
                                "target_lang_word": "选育",
                                "target_lang_sense_clarification": "人工挑选并繁殖优良品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffa03107-9b2c-3a48-a571-e0520a54266f",
                    "sense_definition": "Having the authority, capability, or function to make a selection.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "process_authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>selective</w> committee will decide which candidates proceed to the final round of interviews.",
                            "target_lang_translations": {
                                "ru": "<w>Отборочный</w> комитет решит, какие кандидаты пройдут в финальный раунд собеседований.",
                                "zh": "<w>选拔</w>委员会将决定哪些候选人可以进入最后一轮面试。"
                            }
                        },
                        {
                            "text": "In some countries, young men must register with the <w>selective</w> service system.",
                            "target_lang_translations": {
                                "ru": "В некоторых странах молодые люди должны встать на учет в системе <w>выборочной</w> службы.",
                                "zh": "在一些国家，年轻男子必须在<w>选兵</w>役政系统登记。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "selective service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий полномочиями или функцией производить отбор.",
                        "zh": "具有选拔、筛选权力或功能的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отборочный",
                                "target_lang_sense_clarification": "служащий для отбора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选拔",
                                "target_lang_sense_clarification": "用于挑选合适人选或对象"
                            },
                            {
                                "target_lang_word": "选兵",
                                "target_lang_sense_clarification": "专指征兵或筛选服役人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58eb5c5e-51a9-3bd7-8541-dbf1af732665",
                    "sense_definition": "Relating to social programs that target specific groups based on eligibility criteria rather than being universal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "process_social_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government shifted from universal benefits to more <w>selective</w> programs based on income.",
                            "target_lang_translations": {
                                "ru": "Правительство перешло от всеобщих льгот к более <w>адресным</w> программам, основанным на уровне дохода.",
                                "zh": "政府从普遍福利转向了更多基于收入的<w>定向</w>救助项目。"
                            }
                        },
                        {
                            "text": "Critics argue that <w>selective</w> welfare creates a stigma for those who apply for help.",
                            "target_lang_translations": {
                                "ru": "Критики утверждают, что <w>избирательная</w> социальная помощь создает стигму для тех, кто обращается за поддержкой.",
                                "zh": "批评者认为，<w>选择性</w>福利会给申请救助的人带来耻辱感。"
                            }
                        }
                    ],
                    "antonyms": [
                        "universal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к социальным программам, нацеленным на конкретные группы населения на основе критериев соответствия.",
                        "zh": "（福利或政策）针对特定群体的，非普惠的，定向的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адресный",
                                "target_lang_sense_clarification": "целевой, направленный конкретным получателям"
                            },
                            {
                                "target_lang_word": "избирательный",
                                "target_lang_sense_clarification": "ограниченный определенными условиями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定向",
                                "target_lang_sense_clarification": "指瞄准特定群体"
                            },
                            {
                                "target_lang_word": "针对性",
                                "target_lang_sense_clarification": "根据资格标准特定实施"
                            },
                            {
                                "target_lang_word": "选择性",
                                "target_lang_sense_clarification": "非普遍享受的福利机制"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}