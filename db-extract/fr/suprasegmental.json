                "senses": [
                    {
                        "sense_id": "e2e4adbf-2a6d-3b09-bab8-87263e1082d3",
                        "entry_id": "2d78b2b6-8630-3323-a7ac-b76e15ebfe9e",
                        "glosses": [
                            "Qui n’est pas phonologiquement segmenté comme les voyelles ou les consonnes mais coexistant avec un ou plusieurs phonèmes en modifiant la prononciation, comme l’accent, l’intonation et le ton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a32ae0-f7e1-445a-afcd-378ef96b6de9",
                                "sense_id": "e2e4adbf-2a6d-3b09-bab8-87263e1082d3",
                                "text": "Pour n’en donner qu’une illustration, certaines langues sans tons ont été décrites comme possédant des tons par des linguistes chinois, et des langues distinguant des tons ont été décrites comme n’en possédant pas par des linguistes européens qui ont des difficultés à entendre ces différences suprasegmentales."
                            }
                        ]
                    }
                ],
