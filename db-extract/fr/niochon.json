                        ],
                        "examples": [
                            {
                                "example_id": "9d5a2080-f03f-4fc0-9388-9fc6426eef37",
                                "sense_id": "3911aee4-1356-31d9-8709-a3d2b8b3fab6",
                                "text": "Y m’parle pas de son travail. J’comprendrais pas. Trop d’monde, trop d’paperasses, trop d’boss. Y m’prend pour plus niochonne que chu."
                            }
                        ]
