    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d9968db-2c0f-3c1a-8a65-5bab44cbc2e4",
                    "sense_definition": "Plaats of gebouw waar goederen tijdelijk worden opgeslagen voor verder transport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De goederen worden eerst naar een centrale <w>stapelplaats</w> gebracht voordat ze geëxporteerd worden.",
                            "target_lang_translations": {
                                "en": "The goods are first taken to a central <w>depot</w> before they are exported."
                            }
                        },
                        {
                            "text": "In de nabijgelegen <w>stapelplaats</w> liggen honderden kisten te wachten op vervoer.",
                            "target_lang_translations": {
                                "en": "In the nearby <w>warehouse</w>, hundreds of crates are waiting for transport."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewaarplaats"
                    ],
                    "common_phrases": [
                        "centrale stapelplaats",
                        "tijdelijke stapelplaats"
                    ],
                    "target_lang_definitions": {
                        "en": "A place or building where goods are temporarily stored before further transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depot",
                                "target_lang_sense_clarification": "temporary storage place"
                            },
                            {
                                "target_lang_word": "warehouse",
                                "target_lang_sense_clarification": "storage facility"
                            },
                            {
                                "target_lang_word": "dumping ground",
                                "target_lang_sense_clarification": "storage area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60bb3bc5-7da3-3bad-a071-2192aab5e946",
                    "sense_definition": "Stad die historisch het recht had om bepaalde goederen als eerste te ontvangen en te verkopen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de middeleeuwen was Amsterdam een belangrijke <w>stapelplaats</w> voor graan en hout.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, Amsterdam was an important <w>entrepôt</w> for grain and wood."
                            }
                        },
                        {
                            "text": "Dankzij het privilege werd de stad een rijke <w>stapelplaats</w> voor de regio.",
                            "target_lang_translations": {
                                "en": "Thanks to the privilege, the city became a wealthy <w>staple port</w> for the region."
                            }
                        }
                    ],
                    "common_phrases": [
                        "historische stapelplaats"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historische betekenis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A historical city holding the right to receive and sell certain goods first."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entrepôt",
