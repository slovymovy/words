                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carefully place the glass slide onto the microscope <w>stage</w>.",
                            "target_lang_translations": {
                                "ru": "Осторожно поместите предметное стекло на <w>предметный столик</w> микроскопа.",
                                "tr": "Lamı mikroskop <w>tablasına</w> dikkatlice yerleştirin.",
                                "zh": "小心地将载玻片放在显微镜的<w>载物台</w>上。"
                            }
                        },
                        {
                            "text": "Adjust the clips on the <w>stage</w> to hold the sample in place.",
                            "target_lang_translations": {
                                "ru": "Отрегулируйте зажимы на <w>предметном столике</w>, чтобы зафиксировать образец.",
                                "tr": "Örneği sabitlemek için <w>tabla</w> üzerindeki klipsleri ayarlayın.",
                                "zh": "调整<w>载物台</w>上的夹子以固定样本。"
