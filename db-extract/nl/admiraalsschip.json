                        "examples": [
                            {
                                "example_id": "d1e07cb5-564b-4ca2-afe0-e15cb8df99ac",
                                "sense_id": "6aa501b1-b344-3570-ab4d-813f8f52efbf",
                                "text": "Het admiraalsschip De Walcheren verging in 1689. Historici zijn ervan overtuigd dat er nog resten op de bodem van de Schelde-monding liggen. Duikers zoeken al jaren. Nu krijgen ze hulp van de marine."
                            },
                            {
                                "example_id": "e40fb8d8-d6f0-4379-8928-4ad999dfb9d7",
                                "sense_id": "6aa501b1-b344-3570-ab4d-813f8f52efbf",
                                "text": "Het admiraalsschip Walcheren van commandant Cornelis Evertsen deed mee aan grote zeeslagen en verging in 1689 in het zicht van de haven. Van de 380 opvarenden kwamen er 24 om het leven."
                            }
                        ]
                    }
