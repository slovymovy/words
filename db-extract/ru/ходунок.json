                        "translation_id": "a3b34d29-d745-4062-ae51-b7619f4242ff",
                        "source_entry_id": "11b83272-2194-32d2-b659-ae222996df4c",
                        "source_sense_description": "ребёнок",
                        "target_lang_word": "toddler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toddler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                        "entry_id": "40593122-7c0d-3bf1-bf9e-a5bd6ad875ab",
                                        "glosses": [
                                            "A young child who has started walking but not fully mastered it, typically between one and three years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8484e5fe-787f-4f1a-9aa6-b34d2f10641c",
                                                "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                                "text": "I can't believe Vanessa's baby is now a toddler already!"
                                            },
                                            {
                                                "example_id": "eb15d944-ae15-43d1-a85f-0724f06e4045",
                                                "sense_id": "ba5d6c59-17af-3bcd-9ed0-7715e1bc539a",
                                                "text": "One inexpensive possibility is to purchase a toddler seat that can be placed on your current carriage. There are seats especially designed for that purpose, with seat belts and all. Some toddlers enjoy their high perch, but safety is a concern with these seats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1081a5-8966-3b93-9fea-e90fe1eb3c5c",
                                        "entry_id": "40593122-7c0d-3bf1-bf9e-a5bd6ad875ab",
                                        "glosses": [
                                            "One unsteady on their feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e169fdd4-3fc2-458b-be57-4a92302961aa",
                                                "sense_id": "9b1081a5-8966-3b93-9fea-e90fe1eb3c5c",
                                                "text": "He is sixty-five years old if he is a fortnight, while the girl has only just done with her dolls,and hos no more love for the toothless old toddler than I have for Mammy Wombat, the black gin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
