                "senses": [
                    {
                        "sense_id": "c7c24d80-451d-3dd8-9ea4-83f7ac123e5a",
                        "entry_id": "6247634a-90df-30d4-8fc2-2c6e5d40b868",
                        "glosses": [
                            "von ihm aus, von seiner Seite aus, was ihn betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10044074-4022-4dfb-843e-a3032f63f857",
                                "sense_id": "c7c24d80-451d-3dd8-9ea4-83f7ac123e5a",
                                "text": "Ich wäre für etwas mehr Unterstützung seinerseits sehr dankbar."
                            },
                            {
                                "example_id": "9092a770-a40f-4fb8-a65b-2c8050636677",
                                "sense_id": "c7c24d80-451d-3dd8-9ea4-83f7ac123e5a",
                                "text": "Es handelt sich wohl um ein Missverständnis seinerseits."
                            },
                            {
                                "example_id": "56eaff6c-0ba9-45da-8c40-78c658c5c988",
                                "sense_id": "c7c24d80-451d-3dd8-9ea4-83f7ac123e5a",
                                "text": "„Groener seinerseits würde alles tun, um von der alten Armee zu retten, was zu retten war, und Zeit zu gewinnen, damit sie sich in der deutschen Nachkriegsgesellschaft als Machtfaktor etablieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
