                "senses": [
                    {
                        "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                        "entry_id": "4e8f18ff-e561-378f-84e1-2a5a10c1adb7",
                        "glosses": [
                            "Laufen/Joggen an einem Mittwoch"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "40e2c13c-2a98-44ec-af09-eb57e4479124",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„So viel, dass bei meinem Mittwochslauf, den ich mal wieder allein durchführen durfte (weil Chef sich in ne Besprechung verdrückt hatte und lieber ne Stunde später allein durch den dunklen Wald gelaufen ist) mal wieder eine kleine Pulverisierung eines persönlichen Rekords bei rum kam.“"
                            },
                            {
                                "example_id": "62dc477b-74c6-4885-a4e9-0a9d15cfb72e",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„Der Treffpunkt zum wöchentlichen Mittwochslauf wurde unmittelbar vor dem Start an den Germeringer See verlegt.“"
                            },
                            {
                                "example_id": "b8754a5f-c774-4bf3-b9f1-742bbc87a950",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„Der entspannte Dienstags-Jogg stellte kein Problem dar, nach dem Mittwochslauf war meine Motivation jedoch im Keller.“"
                            },
                            {
                                "example_id": "85205017-dd33-4cb7-bf2b-ee67bb393874",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„Die Mittwochsläufe haben im Januar zusammen 46 km ergeben.“"
                            },
                            {
                                "example_id": "838b4af3-f034-4d44-9a89-a26dfb823cd8",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„Auch der Mittwochslauf verlief schmerzfrei.“"
                            },
                            {
                                "example_id": "65733de0-1e53-4813-be5c-3b9c77b4e928",
                                "sense_id": "4037c306-d55b-3366-a4fc-2c6380654be9",
                                "text": "„Meistens endet der Mittwochslauf mit Frustration, mit hängendem Kopf trotte ich den Berg hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
