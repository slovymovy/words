                "senses": [
                    {
                        "sense_id": "0ed4b36a-7f5e-3035-9cc2-7ef0e4c4c8f6",
                        "entry_id": "e3630900-1f49-3f44-b2a9-5accd03284d9",
                        "glosses": [
                            "Person, die in einer Gemeindeverwaltung als Beamter oder Angestellter tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac50d018-fdf6-4397-9c8d-a60fe0a20725",
                                "sense_id": "0ed4b36a-7f5e-3035-9cc2-7ef0e4c4c8f6",
                                "text": "Der Beigeordnete sprach sich gegen den Bau einer neuen Kreisstraße aus."
                            },
                            {
                                "example_id": "01bc511c-bac9-428b-8b9f-e673819809a8",
                                "sense_id": "0ed4b36a-7f5e-3035-9cc2-7ef0e4c4c8f6",
                                "text": "Alle Beigeordneten trafen sich zu einer Sitzung."
                            },
                            {
                                "example_id": "c0c9922d-9c2f-4d20-a943-7e48a675f551",
                                "sense_id": "0ed4b36a-7f5e-3035-9cc2-7ef0e4c4c8f6",
                                "text": "„Sie mochten sich noch so viel an den Beigeordneten, dann an den ersten Stadtrat wenden, eine Antwort aus Villers erhielten sie nie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
