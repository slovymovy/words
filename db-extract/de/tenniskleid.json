                "senses": [
                    {
                        "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                        "entry_id": "7cbadc77-928b-30ef-acc3-a984794a07d6",
                        "glosses": [
                            "Kleid für eine Frau/ein Mädchen, die/das Tennis spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5878246-1972-4ef7-805d-e8ea1829d6aa",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "Du siehst einfach klasse aus in diesem Tenniskleid!"
                            },
                            {
                                "example_id": "8f44c771-68e6-41c6-a626-af6177731127",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "Dieses Tenniskleid passt ihnen wie angegossen."
                            },
                            {
                                "example_id": "ba85c0d7-9b88-45fd-8497-aff618ddd6b4",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "Das Turnier spielte ich in einem engen, knappen Tenniskleid."
                            },
                            {
                                "example_id": "d2782bee-910c-4aa7-aa57-a4adfed0b082",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„[…] schon 1910 gab es kurze, legere Tenniskleider, sportliche Mode war allerdings nur wohlhabenden Damen der Gesellschaft vorbehalten.“"
                            },
                            {
                                "example_id": "3ab557cd-8784-4b5c-a10b-8989725eb34a",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„So spielt eine 29-jährige Frau in rot-weißem Tenniskleid und perlenweißen Turnschuhen selbstverständlich auf einem gepflegten Platz mitten in Nairobi.“"
                            },
                            {
                                "example_id": "606af056-87ba-4068-917d-ffd8cbaac67e",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„Sie war müde; die Beine und der rechte Arm taten weh, die Sonne stach ihr in die Augen, und das neue weiße Tenniskleid war durchgeschwitzt.“"
                            },
                            {
                                "example_id": "9eda4d75-20df-4386-b421-645269eb406e",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„Seit längerem beteiligt sich die 21-Jährige bei ihrem Sponsor Reebok am Entwerfen von Tenniskleidern.“"
                            },
                            {
                                "example_id": "4a8cf72a-e8c7-4602-bd07-c311f6f0c673",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„Bezeichnend ist in Paris, daß über das gewagt geschnittene Tenniskleid einer Mary Pierce mehr geredet wird als über die Spiele der weltbesten Frauen.“"
                            },
                            {
                                "example_id": "6950a650-64dd-496a-bc55-4bce797618d5",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„Zu diesem Zeitpunkt hatte die in einem fliederfarbenen Tenniskleid […] spielende Williams zwischenzeitlich fast die Nerven, den Mut und den Willen verloren, endlich diesen vermaledeiten Rekord von 24 Grand-Slam-Titeln, den sie seit längerem jagt, zu erringen.“"
                            },
                            {
                                "example_id": "1d190260-450d-478f-8668-5fb8c54f28ba",
                                "sense_id": "ba40d047-9141-308f-91f7-1fdf4fd7e9fc",
                                "text": "„Einmal bat ich sie, mir ein Tenniskleid zu nähen, mit kurzem Rock, wie die jungen Frauen es trugen, die auf den Plätzen im Letná-Park Tennis spielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
