                        "glosses": [
                            "Enlever son caractère de bocage à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dbaf3e7-4a8a-4cf7-a687-e8427d61e8a4",
                                "sense_id": "76757e14-206d-3e30-ae36-c280b54e095d",
                                "text": "Le bassin-versant du ruisseau NOLANGE a été débocagé, déméandré, privé de sa ripisylve, de ses zones humides."
                            },
                            {
                                "example_id": "4ccefa16-8d00-4616-b332-2927db87f984",
                                "sense_id": "76757e14-206d-3e30-ae36-c280b54e095d",
                                "text": "On critique la ville, mais l'agriculture, surtout lorsqu'elle tend à débocager est tout aussi artificialisante."
                            },
                            {
                                "example_id": "82284d87-c74f-48f7-bbbb-819b9949a5e4",
                                "sense_id": "76757e14-206d-3e30-ae36-c280b54e095d",
                                "text": "Pour débocager, il faut une serpe et une faucille..."
                            }
                        ]
