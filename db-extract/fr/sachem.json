                        "sense_id": "e323f489-bf3b-3654-ab5c-afc9c273c749",
                        "entry_id": "30ecd1e2-fd7f-318d-99af-7537b6a45a31",
                        "glosses": [
                            "Vieillard, ancien, membre du conseil de la nation parmi les peuplades de l’Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708603f0-b887-40a2-9257-672005e1ffe0",
                                "sense_id": "e323f489-bf3b-3654-ab5c-afc9c273c749",
                                "text": "Depuis la chasse du castor où le sachem aveugle raconta ses aventures à René."
                            },
                            {
                                "example_id": "b646b4c6-61bf-4881-bcd6-c791ced04582",
                                "sense_id": "e323f489-bf3b-3654-ab5c-afc9c273c749",
                                "text": "Le sachem assista au conseil secret convoqué la nuit par Ondouré ; […]"
                            },
                            {
                                "example_id": "aefc5c0b-fa49-45e8-9b69-a24657cfdac6",
                                "sense_id": "e323f489-bf3b-3654-ab5c-afc9c273c749",
                                "text": "Le 3 septembre, Charles Le Moyne arrive à l’anse de la Famine accompagné de 14 sachems."
                            },
                            {
                                "example_id": "493186d1-4875-4d72-80ae-bc36bf831a46",
                                "sense_id": "e323f489-bf3b-3654-ab5c-afc9c273c749",
                                "text": "Le grand sachem mourut lui aussi et avec lui, presque tous ses amis et ses proches."
                            }
                        ]
                    }
                ],
