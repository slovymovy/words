                    {
                        "translation_id": "03fa6701-5483-4d8a-b327-fc0270a71eea",
                        "source_entry_id": "0c5acfd0-2e68-328f-a9d0-06d65b013d9a",
                        "source_sense_id": "24f96e95-7886-3c1e-a1d9-0c9f3a491a2d",
                        "source_sense_description": "a place where a tent may be or is pitched",
                        "target_lang_word": "campement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                        "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                                        "glosses": [
                                            "Action de camper, ou le camp lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d153910b-4f77-4cd3-8cf1-f7526fb17584",
                                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                                "text": "Une demi-heure après, ils atteignaient leur campement situé dans une étroite gorge de la vallée, où les attendait le chariot gardé par deux conducteurs de race boschjesmane."
                                            },
                                            {
                                                "example_id": "c9b8d23b-51de-459c-b3bf-81b98b5f18ea",
                                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                                "text": "Enfin, je finis par m’arrêter, comprenant que j’avais fait fausse route et que j’avais dû dépasser le campement."
                                            },
                                            {
                                                "example_id": "0e3d0c09-115c-4c2b-b002-8c9c6e075e3e",
                                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                                "text": "A la tombée de la nuit, six hommes de garde envoyés par le caïd sont venus s’accroupir autour de notre petit campement pour veiller à notre sécurité."
                                            },
                                            {
                                                "example_id": "82b9d3f0-8183-406a-9d8f-2199101eb46c",
                                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                                "text": "Un campement à la bordure d’une forêt, et éclairé par quelques bougies, donne d’étranges apparences ; je crus voir une falaise et des cavernes ; je revis ce lieu plus d’une fois ; jamais je n’y pus reconnaître ma première impression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46530c85-6e95-3eab-9261-7dc3bee1e827",
                                        "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                                        "glosses": [
                                            "Objets nécessaires pour camper."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d8c9909-c290-46dc-b96a-99fb2a67c7a0",
                        "source_entry_id": "0c5acfd0-2e68-328f-a9d0-06d65b013d9a",
                        "source_sense_id": "24f96e95-7886-3c1e-a1d9-0c9f3a491a2d",
                        "source_sense_description": "a place where a tent may be or is pitched",
                        "target_lang_word": "Campingplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Campingplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                        "entry_id": "f365b7fa-2be4-3fa8-8131-ad63981bacae",
                                        "glosses": [
                                            "ein abgegrenztes Gelände, auf dem man mit einem Zelt oder Wohnwagen übernachten darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036221e3-3b6f-41c8-a887-b3a43dab989d",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "Wer ein Zelt hat, kann auf einem Campingplatz übernachten."
                                            },
                                            {
                                                "example_id": "114eb0cc-6b1f-46f7-b008-247e6963161d",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Ich hatte damals immer ein Zelt dabei, und auf den Campingplätzen waren fast nur Franzosen.“"
                                            },
                                            {
                                                "example_id": "7553a8ef-b9a1-4b2c-9a34-ee47471a10fd",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Im Zentrum angelangt machte ich mich auf die Suche nach einem Campingplatz, doch leider gab es in der Hauptstadt keine Möglichkeit zum Zeltaufschlagen.“"
                                            },
                                            {
                                                "example_id": "7ce94545-01ad-427b-b06e-e3689485e04a",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Der Campingplatz (Wohnmobilstellplätze und Zelte) erstreckt sich auf dem alten Fußballplatz östlich des Ortes.“"
                                            },
                                            {
                                                "example_id": "57a0b122-7082-43b0-93d8-6d3a73d98a31",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Als es auf dem Campingplatz fernab jeder Stromleitung dunkel wird, beobachten die Kinder, wie wir im Schein der Taschenlampe kochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6934894a-b53e-402b-a4be-9e3cdcdfbe7b",
