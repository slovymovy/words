        "nl-extract.jsonl": [
            {
                "entry_id": "84695670-ded7-3732-b887-5b4d892df0b3",
                "word": "opgeruimd",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "84b27a74-d132-3210-9978-fe7bf60be97c",
                        "entry_id": "84695670-ded7-3732-b887-5b4d892df0b3",
                        "glosses": [
                            "vrolijk, opgewekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63701b7-9405-4320-9d99-7913730cbebf",
                                "sense_id": "84b27a74-d132-3210-9978-fe7bf60be97c",
                                "text": "Topscorer van de Premier League zal hij wel nooit worden. Maar toch behoort Adebayo Akinfenwa (38 jaar) al jaren tot de bekendste spitsen van het Engelse voetbal. En dat heeft vooral te maken met zijn imposante postuur en zijn aanstekelijk opgeruimde karakter."
                            },
                            {
                                "example_id": "7d2d42e1-4b8f-43d0-9740-295c92826663",
                                "sense_id": "84b27a74-d132-3210-9978-fe7bf60be97c",
                                "text": "Het chagrijn bij de doorgaans opgeruimde aanvoerder ontstond zaterdag, toen Bas Nijhuis in het VAR-centrum in Zeist de punt van de schoen van Mike van der Hoorn over het hoofd zag."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d69a7c-1110-3003-b5e0-d2f9db06bfe7",
                        "entry_id": "84695670-ded7-3732-b887-5b4d892df0b3",
                        "glosses": [
                            "door een schoonmaakactie verwijderd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857b7e99-2ca5-468c-9b5c-f85d1d3e6c09",
                                "sense_id": "c3d69a7c-1110-3003-b5e0-d2f9db06bfe7",
                                "text": "Het schoonmaken is logistiek trouwens nog wel ingewikkeld: de Biesbosch is voor het grootste deel alleen per boot toegankelijk. Mensen moeten met platbodems worden weggebracht en het opgeruimde plastic moet dus ook met die boten worden afgevoerd."
                            },
                            {
                                "example_id": "07206fac-a9d8-4845-9ad7-2ffe32971735",
                                "sense_id": "c3d69a7c-1110-3003-b5e0-d2f9db06bfe7",
                                "text": "Van Uffelen coördineerde vandaag een landelijke opruimactie van vispluis. Ruim dertig vrijwilligers verzamelden vispluis op een aantal stranden. Met het opgeruimde spul wil Centree een kunstwerk maken in de vorm van een hand, die de noodkreet van de zee moet symboliseren."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e36340c-2dd8-3f79-872c-fb4f85ef8395",
                        "entry_id": "84695670-ded7-3732-b887-5b4d892df0b3",
                        "glosses": [
                            "gereinigd na een schoonmaakactie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b617b73e-c708-44c5-a90c-3c68a3a174bb",
                                "sense_id": "3e36340c-2dd8-3f79-872c-fb4f85ef8395",
                                "text": "Het was fijn om in het opgeruimde kantoor te leven."
                            }
                        ]
                    }
                ],
