                                            {
                                                "example_id": "c6ea9b17-f9ef-446d-bcc7-622d9bfca1cb",
                                                "sense_id": "ca41c265-59c0-3d00-9d8f-667ce22b63d5",
                                                "text": "‘Waarom gooien ze er dan geen bataljon advocaten tegenaan? Ze zijn toch zo machtig? ’"
                                            },
                                            {
                                                "example_id": "1eb9f509-aded-4fb8-8da7-0c0af292f964",
                                                "sense_id": "ca41c265-59c0-3d00-9d8f-667ce22b63d5",
                                                "text": "Én wat doen wij dan?'\n'Proberen eruit te zien als advocaten, ik tenminste.'"
                                            },
                                            {
                                                "example_id": "a6d3697a-a1e5-4f3f-a925-da4ef5763ca7",
                                                "sense_id": "ca41c265-59c0-3d00-9d8f-667ce22b63d5",
                                                "text": "De advocaat is een rechtshulpverlener, die zijn cliënten met raad en daad terzijde staat. Iedere burger dient, wanneer hij rechtshulp nodig heeft, een onbelemmerde toegang tot een advocaat te hebben."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advocaat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "db2d11bf-8379-3d7e-8f04-ad6968ec8123",
                                        "entry_id": "59e8124a-4052-3c37-a0ec-58a1a4ebeac8",
                                        "glosses": [
                                            "alcoholische dikvloeibare drank van eieren, eierlikeur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19f009b-48ad-4ef2-b245-f40d1ad83c2b",
                                                "sense_id": "db2d11bf-8379-3d7e-8f04-ad6968ec8123",
                                                "text": "Iedereen rookte mee, op een paar mensen na, meestal vrouwen die nog wel een glaasje advocaat beliefden. Maar die hadden er verder geen last van. Mensen die klaagden over andermans rook bestonden nog niet."
                                            }
                                        ]
                                    }
