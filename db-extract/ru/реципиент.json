                    {
                        "translation_id": "79e623e6-ca5b-4c27-898b-e3caac4e8b11",
                        "source_entry_id": "cc909df9-334f-3271-9f84-35b415f2a0fc",
                        "target_lang_word": "Empfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Person, die etwas empfängt, bekommt, erhält, entgegennimmt; jemand, der etwas in Empfang nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34f6999-3493-49cc-896f-71d36a69d963",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "Der Empfänger des Briefes muss für den unfrankierten Brief Strafporto zahlen."
                                            },
                                            {
                                                "example_id": "5b5839da-4df0-4d5e-a859-dbfa6ac7b91f",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Es ist undenkbar, daß sich in einem solchen Augenblick der Empfänger einer Wohltat nicht ebenfalls entschlossen fühlt, alles in seinen Kräften Stehende zu tun, um den zu beglücken, der so bereitwillig zu seinem Glück beigetragen hat.“"
                                            },
                                            {
                                                "example_id": "c7c3af37-6467-4c01-96a9-7ba64ff5b5da",
                                                "sense_id": "e1fb11c0-f89c-37fa-85a6-27e56117da29",
                                                "text": "„Empfänger seiner Mitteilung ist Johannes Kagelmacher, Bauer aus Guderitz auf Rügen, bei dem er in seiner Zeit als Drogenabhängiger oft untergekrochen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                        "entry_id": "57c9d099-d87e-3969-9945-0afed7766f35",
                                        "glosses": [
                                            "Gerät, das Signale empfängt"
                                        ],
                                        "tags": [
                                            "Funktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69cf1cef-c31c-4f53-ba67-0fe0a089d52b",
                                                "sense_id": "315ca416-df38-316b-9097-4780aaa4a42b",
                                                "text": "Der Empfänger ist defekt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3546ffb-ffcb-4c37-83e1-9024c6980715",
