                "senses": [
                    {
                        "sense_id": "200c1f33-169d-3786-bc2f-49fb68e750b3",
                        "entry_id": "5d7879cd-b9e5-38be-9d39-8540b5f0cc52",
                        "glosses": [
                            "iets tot op de bodem onderzoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "381f438d-3853-4de9-971c-05085d55b974",
                                "sense_id": "200c1f33-169d-3786-bc2f-49fb68e750b3",
                                "text": "Wat weten we per slot van rekening van God? Zijn beschikkingen zijn ondoorgrondelijk en zijn wegen onnaspeurlijk, zegt de bijbel. En in de apocriefe boeken staat: “Wij kunnen de diepten van 's mensen hart niet peilen noch ontdekken wat een mens denkt; hoe kunnen wij verwachten Gods bedoelingen te kunnen uitvorsen - God, die al die dingen heeft gemaakt?”"
                            },
                            {
                                "example_id": "401102d4-f642-4f1e-8a97-f8b3c6a32dc9",
                                "sense_id": "200c1f33-169d-3786-bc2f-49fb68e750b3",
                                "text": "De spelers zijn speculanten. Dat komt van het Latijnse speculare, spieden, uitvorsen, door uitvragen iets te weten komen, een geheim blootleggen. Speculanten zijn altijd op zoek naar geheimen, kennis die een ander niet bezit."
                            }
                        ]
                    }
                ],
