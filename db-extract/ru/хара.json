                        "entry_id": "e2591e49-e59b-322e-999f-5360cae09588",
                        "glosses": [
                            "река в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad949f63-de95-4998-b111-15791f3057c7",
                                "sense_id": "c9904a6b-199f-36ea-a780-936eef8669ff",
                                "text": "Хара — одна из многочисленных рек, протекающих по территории России."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1363da0f-64af-398a-aa58-46a0975d8aca",
