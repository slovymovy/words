                        "glosses": [
                            "Les fesses de l’homme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4e7509d7-d552-41ff-ad12-58c7ecb53597",
                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                "text": "Puis il y a eu le duel des équipes de pom-poms girls pour chauffer la salle, et pour la première fois depuis le lycée, je n'ai pas bandé en les regardant dandiner leurs jolis fessiers au rythme de la musique. Pourtant, nos nanas sont toutes chaudes comme la braise."
                            },
                            {
                                "example_id": "68ad9591-fc8a-4a8a-a469-b552be72895f",
                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                "text": "Avec des gradins déserts et la perspective angoissante de ramener les fessiers à 200 $ la craque des les sièges vides, les patrons du Canadien n'ont pas le choix."
                            },
                            {
                                "example_id": "2be5c7ce-1ee8-45f6-8b0a-b0ca0d0fbdaa",
                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                "text": "Des amasseuses qui prennent leur fessier pour une tirelire !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1b9e999e-4a19-3b4a-ab9e-021051749c7d",
                        "entry_id": "aeb3b384-c070-3cbb-a19c-22c1d3df9eb9",
