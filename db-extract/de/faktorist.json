                "senses": [
                    {
                        "sense_id": "6374acc4-c1e3-3ab8-9b35-fa969f582ded",
                        "entry_id": "ed5fd73d-5b71-36db-b8fa-1c114c82fa61",
                        "glosses": [
                            "Leiter einer Faktorei/Handelsniederlassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e361c8a-342c-4f89-8358-387268240025",
                                "sense_id": "6374acc4-c1e3-3ab8-9b35-fa969f582ded",
                                "text": "„Die Faktorei gilt gleichzeitig als Wohnraum für den Faktoristen.“"
                            },
                            {
                                "example_id": "7efdeb71-5ad7-4b90-bee7-72538486f52e",
                                "sense_id": "6374acc4-c1e3-3ab8-9b35-fa969f582ded",
                                "text": "„Einer der letzten Meier, der Ochsenwirt und Vogt, hatte Mitte des 18. Jahrhunderts als Faktorist den Salzkasten in den oberen Landen der Markgrafschaft zu besorgen.“"
                            },
                            {
                                "example_id": "11b7c570-4359-46c4-8467-206af7e7f557",
                                "sense_id": "6374acc4-c1e3-3ab8-9b35-fa969f582ded",
                                "text": "„Darunter verstand man die Niederlassung eines Handelsunternehmens, dem ein Faktor (auch Faktorist genannt) als Geschäftsführer und Vertreter vorstand und der zwischen dem Arbeitgeber (Leinenhändler) und dessen Arbeitern (Hauswebern) vermittelte, Aufträge erteilte, Abrechnungen erstellte und Material lagerte und ausgab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
