                        "examples": [
                            {
                                "example_id": "5a7f9f53-8ff6-4da2-9ca3-025ba7b222ac",
                                "sense_id": "8ded0a71-f8cd-373f-8eee-327366936483",
                                "text": "Surinamers lopen af en aan voor hun dagelijkse inkopen. Bij Tjin’s – Surinaamse broodjes en maaltijden, bij de Surinaamse-Chinees Kim-Yin, op het marktplein. Groente, fruit, kleding. Een Surinaamse ijsboer verkoopt schaafijs met siroop. In twaalf smaken."
                            },
                            {
                                "example_id": "6675f7c3-630c-4b05-803e-c6c9432103f6",
                                "sense_id": "8ded0a71-f8cd-373f-8eee-327366936483",
                                "text": "Twijfel jij bij de ijsboer altijd over welke smaak je moet kiezen? IJscoman Rob Kok van IJspaleis Driehuis heeft de oplossing. Voor klanten die niet kunnen kiezen en 'euh' stamelen is er nu de speciale 'euh'-smaak. Maar hoe smaakt die?"
                            }
                        ]
                    }
