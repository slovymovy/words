                                "sense_id": "327faec2-fc6e-3b81-a4e6-614190d21c09",
                                "text": "листы́ разлете́лись по ко́мнате",
                                "translation": "the pages flew about the room",
                                "english": "the pages flew about the room"
                            },
                            {
                                "example_id": "c16dc47a-c71f-42fa-a26b-889c728ccd5d",
                                "sense_id": "327faec2-fc6e-3b81-a4e6-614190d21c09",
                                "text": "разлете́ться в дым; разлете́ться в прах",
                                "translation": "to go to pieces, fall to pieces, go to rack and ruin, go up in smoke",
                                "english": "to go to pieces, fall to pieces, go to rack and ruin, go up in smoke"
                            }
                        ]
