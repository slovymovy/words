                                        "sense_id": "95696444-10d1-365e-8959-626e856d4edc",
                                        "entry_id": "49dc6ca3-3acd-33c3-9249-52c6a6b90cb5",
                                        "glosses": [
                                            "A short, sleeveless undergarment worn by women underneath a blouse, or as a form of short négligée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ed6d28-353c-4d75-81af-5bb834dd094b",
                                                "sense_id": "95696444-10d1-365e-8959-626e856d4edc",
                                                "text": "A visible bra strap, a bit of camisole peeking, a partially exposed thong: Innerwear slinks into a new role"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cddcfa-86cc-3f7b-a0df-c2fbaab9071f",
                                        "entry_id": "49dc6ca3-3acd-33c3-9249-52c6a6b90cb5",
