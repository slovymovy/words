                        ],
                        "form": "die Kombüsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                        "entry_id": "f4fdcf2c-9f4c-3b88-90eb-00bc1fdcbd6e",
                        "glosses": [
                            "der Raum auf einem Schiff, in dem das Essen zubereitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a30f91-4b41-45ba-af1f-bb85d25ce9d5",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "„Die Angebote sind vielfältig: von der Betriebsküche mit geregelten Arbeitszeiten bis zur Kombüse auf dem Luxusdampfer.“"
                            },
                            {
                                "example_id": "b41f3494-8e62-4109-9965-d9b0987db254",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "„Das Schott geht auch schon auf, und ölverschmiert kommt der Eintänzer in die Kombüse.“"
                            },
                            {
                                "example_id": "cfc28c4f-c80d-4f77-99a0-012353c91df0",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "Die Kombüse auf alten Großseglern war meist von Ziegeln umschlossen, um die Hitze vorm restlichen Schiff abzuschirmen."
                            },
                            {
                                "example_id": "0ebe351f-82a5-4e78-96aa-e87d05579d29",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "„Ich befand mich gerade an Deck, als mir Kröger, der achtern in Höhe der Kombüse ein lautes Gespräch mit dem Koch führte, zurief, daß sich jemand dem Schiff nähere.“"
                            },
                            {
                                "example_id": "c110f712-97ac-437b-89b3-e36d1838f6b6",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "„Selbst der Koch hatte seine Kombüse verlassen.“"
                            },
                            {
                                "example_id": "ae803440-7086-48c7-ac55-9ebb56802324",
                                "sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                                "text": "„Nur Mr. Morgan, dessen Geschmacksnerven auch gegenüber den scheußlichsten Erzeugnissen der Kombüse unempfindlich zu sein schienen, langte tüchtig zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6a351be-a5a0-4e4b-8652-da95d2688813",
