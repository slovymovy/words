{
    "word_family": [
        "thorn",
        "thorniness",
        "thornless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                    "sense_definition": "Full of or covered with thorns or sharp spines.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literal_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when walking through that field because the <w>thorny</w> bushes can easily tear your clothes.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, идя по этому полю, потому что <w>колючие</w> кусты могут легко порвать вашу одежду."
                            }
                        },
                        {
                            "text": "The rose stems were so <w>thorny</w> that she needed thick leather gloves to prune them.",
                            "target_lang_translations": {
                                "ru": "Стебли роз были настолько <w>колючими</w>, что ей понадобились плотные кожаные перчатки, чтобы их обрезать."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickly",
                        "spiny"
                    ],
                    "common_phrases": [
                        "thorny bush",
                        "thorny path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый шипами или колючками; колючий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "имеющий шипы, колючки"
                            },
                            {
                                "target_lang_word": "тернистый",
                                "target_lang_sense_clarification": "заросший терновником, шипами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                    "sense_definition": "Causing difficulty, disagreement, or trouble; hard to deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "troublesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tax reform remains a <w>thorny</w> issue that politicians are reluctant to address before the election.",
                            "target_lang_translations": {
                                "ru": "Налоговая реформа остаётся <w>щекотливым</w> вопросом, который политики не хотят затрагивать перед выборами."
                            }
                        },
                        {
                            "text": "The committee spent several hours debating the <w>thorny</w> problem of budget distribution.",
                            "target_lang_translations": {
                                "ru": "Комитет провел несколько часов, обсуждая <w>острую</w> проблему распределения бюджета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thorny issue",
                        "thorny problem",
                        "thorny question",
                        "thorny subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий споры, разногласия или трудности; сложный для решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щекотливый",
                                "target_lang_sense_clarification": "деликатный, вызывающий разногласия"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "проблематичный, наболевший"
                            },
                            {
                                "target_lang_word": "трудный",
                                "target_lang_sense_clarification": "сложный, непростой"
                            },
                            {
                                "target_lang_word": "тернистый",
                                "target_lang_sense_clarification": "полный препятствий и невзгод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                    "sense_definition": "Prone to anger or irritation; touchy and unfriendly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "troublesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been in a <w>thorny</w> mood all morning, snapping at anyone who speaks to him.",
                            "target_lang_translations": {
                                "ru": "Всё утро он был в <w>раздражительном</w> настроении, огрызаясь на каждого, кто заговаривал с ним."
                            }
                        },
                        {
                            "text": "Do not take her sharp remarks personally; she simply tends to turn <w>thorny</w> under stress.",
                            "target_lang_translations": {
                                "ru": "Не принимайте её резкие замечания на свой счёт; в стрессовых ситуациях она просто становится <w>колючей</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражительный, обидчивый, колкий или неприветливый по характеру или настроению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "язвительный, резкий в общении"
                            },
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "легко выходящий из себя, сердитый"
                            },
                            {
                                "target_lang_word": "обидчивый",
                                "target_lang_sense_clarification": "вспыльчивый, задевающийся по мелочам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}