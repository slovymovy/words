                        "examples": [
                            {
                                "example_id": "2d9afb98-a9ab-486d-9134-c04fc48f4d60",
                                "sense_id": "dc1485e3-b0ea-3506-8d34-16c39c851b26",
                                "text": "Cardinale speelt in de film twee klassieke vrouwenrollen ineen: een voormalige hoer en de loyale echtgenote die ze wil zijn. Met haar wilde haren, woeste kohl-omrande ogen, onverzettelijke mond, en, natuurlijk, dat met diamanten zweetdruppeltjes beparelde decolleté. Een jongensdroom die alleen in film kan bestaan. Een meisjesdroom. Voor een tijd die seksueel nog vrijgevochten moest worden. Haar wilde je zijn. Haar wilde je bezitten."
                            }
                        ]
                    }
