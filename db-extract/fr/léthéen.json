                        "entry_id": "8767314d-f4c4-33b8-abdd-503bb2ac1373",
                        "glosses": [
                            "Relatif au Léthé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8600f827-aa07-449a-a071-42e68bb4d5ce",
                                "sense_id": "0c68aafc-c43f-337d-b76d-3ca24cec1386",
                                "text": "Et toi, sors des étangs léthéens et ramasse / En t’en venant la vase et les pâles roseaux, / Cher Ennui, pour boucher d’une main jamais lasse / Les grands trous bleus que font méchamment les oiseaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5927b22-c90e-4851-b581-4f15d86458bc",
                        "source_entry_id": "8767314d-f4c4-33b8-abdd-503bb2ac1373",
                        "source_sense_id": "0c68aafc-c43f-337d-b76d-3ca24cec1386",
                        "target_lang_word": "Lethean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lethean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "294867c1-8ae8-3cb2-a806-2413398fdc0a",
                                        "entry_id": "f25c0de1-1466-3f5c-9bdc-23ec256c9fe8",
                                        "glosses": [
                                            "Of or relating to the river Lethe, one of the four rivers of Hades. Those who drank from it experienced complete forgetfulness."
                                        ],
                                        "tags": [
                                            "Greek",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e3a5d2-f1a6-491e-8952-5cb0094c61f9",
                                                "sense_id": "294867c1-8ae8-3cb2-a806-2413398fdc0a",
                                                "text": "They ferry over this Lethean sound."
                                            },
                                            {
                                                "example_id": "ace3a120-ffd6-4163-9cd2-12765f141e2e",
                                                "sense_id": "294867c1-8ae8-3cb2-a806-2413398fdc0a",
                                                "text": "The cup which was offered to you when you departed from Elysium was to be the Lethean draught, which would make you forget the joys you had experienced[.]"
                                            },
                                            {
                                                "example_id": "bcb8ee2b-e91e-4e2c-b961-ca562ebf34f8",
                                                "sense_id": "294867c1-8ae8-3cb2-a806-2413398fdc0a",
                                                "text": "Accordingly, she one day took the Lethean crown from off his head: immediately all his old ideas rushed on his mind, and inflamed him with an ardent desire to revisit his country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53216f6d-217b-43d5-bbca-4647b3ca7a10",
                        "source_entry_id": "8767314d-f4c4-33b8-abdd-503bb2ac1373",
                        "source_sense_id": "0c68aafc-c43f-337d-b76d-3ca24cec1386",
