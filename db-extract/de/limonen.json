                        "glosses": [
                            "Kohlenwasserstoff mit einem zitrusartigen Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bbdddf-15fe-4c69-a45f-f1817c63201a",
                                "sense_id": "045f60b8-de36-358d-af78-278b327d74cf",
                                "text": "„Limonen kommt in zwei unterschiedlichen Stereoisomeren vor. Das R-Enantiomer kommt in Orangen, das S-Enantiomer in Zitronen vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fee35479-3449-4626-9bcd-f89c492ac0e4",
