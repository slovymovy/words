{
    "word_family": [
        "zinken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b33f9630-0f2b-31c2-97fb-b1acfd4bc210",
                    "sense_definition": "Een scheikundig element met symbool Zn en atoomnummer 30, een blauw-wit overgangsmetaal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dakgoot is gemaakt van <w>zink</w>.",
                            "target_lang_translations": {
                                "it": "La grondaia è fatta di <w>zinco</w>."
                            }
                        },
                        {
                            "text": "Veel metalen voorwerpen worden beschermd door een laagje <w>zink</w>.",
                            "target_lang_translations": {
                                "it": "Molti oggetti metallici sono protetti da uno strato di <w>zinco</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "laagje zink"
                    ],
                    "target_lang_definitions": {
                        "it": "Elemento chimico metallico di colore bianco-azzurro, simbolo Zn e numero atomico 30."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "zinco",
                                "target_lang_sense_clarification": "metallo di transizione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1db29e4e-8536-3406-80d3-b98a6b9cc65f",
                    "sense_definition": "Een historisch koperblaasinstrument met vingergaten, vergelijkbaar met een blokfluit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muzikant speelde een prachtig stuk op de <w>zink</w>.",
                            "target_lang_translations": {
                                "it": "Il musicista ha suonato un pezzo meraviglioso sul <w>cornetto</w>."
                            }
                        },
                        {
                            "text": "In de oude muziek wordt de <w>zink</w> vaak gebruikt als solo-instrument.",
                            "target_lang_translations": {
                                "it": "Nella musica antica il <w>cornetto</w> è spesso usato come strumento solista."
                            }
                        }
                    ],
                    "synonyms": [
                        "cornetto"
                    ],
                    "target_lang_definitions": {
                        "it": "Antico strumento a fiato in legno con fori per le dita, simile a un flauto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cornetto",
                                "target_lang_sense_clarification": "strumento musicale storico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06588bb2-8eac-376e-b7db-ca1c6fa477d1",
                    "sense_definition": "Een specifiek register in een orgel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De organist trok het register <w>zink</w> open voor een heldere klank.",
                            "target_lang_translations": {
                                "it": "L'organista ha aperto il registro <w>zinco</w> per un suono limpido."
                            }
                        },
                        {
                            "text": "Het <w>zink</w> geeft het orgel een karakteristieke klankkleur.",
                            "target_lang_translations": {
                                "it": "Lo <w>zinco</w> conferisce all'organo un timbro caratteristico."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Registro specifico di un organo a canne."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "zinco",
                                "target_lang_sense_clarification": "registro d'organo (raro)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03b4515f-bc0b-3bd9-947b-0db3c3338d49",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>zinken</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zink</w> langzaam naar de bodem van het zwembad.",
                            "target_lang_translations": {
                                "it": "Io <w>affondo</w> lentamente verso il fondo della piscina."
                            }
                        },
                        {
                            "text": "Wanneer ik in de zachte stoel ga zitten, <w>zink</w> ik helemaal weg.",
                            "target_lang_translations": {
                                "it": "Quando mi siedo sulla poltrona morbida, <w>affondo</w> completamente."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prima persona singolare del verbo affondare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affondo",
                                "target_lang_sense_clarification": "prima persona singolare di affondare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00895148-b867-35c9-8886-65921cae3063",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>zinken</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zink</w> jij ook zo diep weg in die zachte bank?",
                            "target_lang_translations": {
                                "it": "<w>Affondi</w> anche tu così profondamente in quel divano morbido?"
                            }
                        },
                        {
                            "text": "Waarom <w>zink</w> je steeds verder weg in je gedachten?",
                            "target_lang_translations": {
                                "it": "Perché <w>affondi</w> sempre di più nei tuoi pensieri?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Seconda persona singolare del verbo affondare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affondi",
                                "target_lang_sense_clarification": "seconda persona singolare di affondare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2be2b6e-6d20-3e59-8717-448b537cdfe7",
                    "sense_definition": "Gebiedende wijs van <w>zinken</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zink</w> in de kussens en ontspan volledig.",
                            "target_lang_translations": {
                                "it": "<w>Affonda</w> nei cuscini e rilassati completamente."
                            }
                        },
                        {
                            "text": "Laat je niet afleiden, <w>zink</w> gewoon in je werk.",
                            "target_lang_translations": {
                                "it": "Non farti distrarre, <w>affonda</w> semplicemente nel tuo lavoro."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma imperativa del verbo affondare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affonda",
                                "target_lang_sense_clarification": "imperativo di affondare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
