                "senses": [
                    {
                        "sense_id": "b251c123-680b-3436-91d7-f864089df3a8",
                        "entry_id": "de202e9c-fa82-3084-9186-b5aa8170279b",
                        "glosses": [
                            "An inexperienced person; a novice."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5b800a5f-187a-3c29-9611-d2e93245ccd5",
                        "entry_id": "de202e9c-fa82-3084-9186-b5aa8170279b",
                        "glosses": [
                            "A newcomer or arriviste to the region in the American frontier (Old West and Wild West)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "90eca40d-bba3-4aa0-bc1e-6ba30369a2df",
                                "sense_id": "5b800a5f-187a-3c29-9611-d2e93245ccd5",
                                "text": "Watson had risen so hurriedly that he had not been careful about his “tarp” and water had run into his bed. But that wouldn’t disconcert anybody but a tenderfoot."
                            },
                            {
                                "example_id": "4e12278e-a3a0-48f9-aeaf-cf403d717c37",
                                "sense_id": "5b800a5f-187a-3c29-9611-d2e93245ccd5",
                                "text": "\"Lavender Cowboy,\" a pseudo folk song, is a tale of futility. It tells of a tenderfoot \"with only two hairs on his chest,\" whose heroic attempt to prove his manhood results in his death."
                            }
                        ]
                    },
                    {
                        "sense_id": "d62fd79d-6fa8-3d6a-a94a-16616b3f0153",
                        "entry_id": "de202e9c-fa82-3084-9186-b5aa8170279b",
                        "glosses": [
                            "A Boy Scout of the lowest rank."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e4b7c84-a0e7-431f-be2b-077374c5beab",
                        "source_entry_id": "de202e9c-fa82-3084-9186-b5aa8170279b",
                        "source_sense_description": "novice",
                        "target_lang_word": "pied-tendre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pied-tendre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ffed04e-ef78-3c2a-b7e5-1b6316e85034",
                                        "entry_id": "68b47272-9ee2-306f-a372-65caf3b7fa57",
                                        "glosses": [
                                            "Nom donné aux Blancs par les Amérindiens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cfe4268-aca7-3b07-a68b-5d3796685e44",
                                        "entry_id": "68b47272-9ee2-306f-a372-65caf3b7fa57",
                                        "glosses": [
                                            "Être fondamentalement délicat et doux, qui n’oserait s’opposer à quiconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef3b188-7329-4352-9d61-5a77fcea0124",
                                                "sense_id": "9cfe4268-aca7-3b07-a68b-5d3796685e44",
                                                "text": "Pays à vendre à qui veut le prendre, bonus en plus : huit millions de pied-tendres !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6751c0-af18-3a9c-b824-96a89e883b74",
                                        "entry_id": "68b47272-9ee2-306f-a372-65caf3b7fa57",
                                        "glosses": [
                                            "Novice, inexpérimenté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545aa1f2-0c19-454e-ad71-b0e8c4289e9c",
                                                "sense_id": "ac6751c0-af18-3a9c-b824-96a89e883b74",
                                                "text": "\"C’est un pied-tendre, il ne connaît rien au protocole\", a commenté Most."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9781ebea-bba2-4faa-8904-d8747c413997",
                        "source_entry_id": "de202e9c-fa82-3084-9186-b5aa8170279b",
                        "source_sense_description": "novice",
                        "target_lang_word": "blanc-bec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blanc-bec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25ae0c20-c248-340b-bf06-b6fbc08b71bd",
                                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                                        "glosses": [
                                            "Jeune homme qui n’a pas encore de barbe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                                        "glosses": [
                                            "Jeune homme sans expérience et trop sûr de lui."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6413c4ad-6f00-484e-9d48-08bad6382da2",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Il trouvait que ce muscadin avait du bon et se mit à lui expliquer la façon de se comporter au régiment, pour ne pas avoir l’air d’un blanc-bec."
                                            },
                                            {
                                                "example_id": "446d8688-32e4-47e7-8d68-c6fda55c937f",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "— Tu ne sais donc pas ce que disait ma mère, blanc-bec ? reprenait gravement le plus vieux en baissant les yeux d’un air farouche et solennel pour se faire écouter."
                                            },
                                            {
                                                "example_id": "5decb270-aa7a-4471-baa7-77112ef66977",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Un blanc-bec tel que vous provoquer en duel un personnage comme le baron !"
                                            },
                                            {
                                                "example_id": "56fcbc31-0801-43c9-8ace-1f8c106537e4",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "L’autre, en rajustant son habit, prenait cet air las et dégoûté des jeunes blancs-becs qui s’en viennent de livrer un galant assaut."
                                            },
                                            {
                                                "example_id": "c12033b4-09e1-4655-9bde-e17c385a61ce",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "— Sacrés jean-foutres de blancs-becs ! grogne le facteur en promenant autour de lui un œil courroucé. Le lait leur coule encore des narines, et ça voudrait chambarder tout !"
                                            },
                                            {
                                                "example_id": "01fef8bc-f0e9-4703-8348-84a70ce68470",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Alors blanc bec t’aimes le basket\nBen on va ouèj à ma façon ;\nJ’vais juste un peu changer les règles :\nOn est les joueurs, toi t’es l’ballon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
