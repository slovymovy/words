                        "glosses": [
                            "Cigare de la manufacture de tabacs de Sion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfdfdc8-e799-4baa-a8a3-8881ae3032fe",
                                "sense_id": "38cba2d4-564e-3dd8-b9a6-e94a2f530056",
                                "text": "À propos je suis converti aux cigares. Je ne fume plus que des Sédunois : cette suave pestilence de l’après dîner."
