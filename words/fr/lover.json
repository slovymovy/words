                    "frequency": "Middle",
                    "semantic_group_id": "posture_repliee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat aime se <w>lover</w> sur le canapé pendant les après-midis d'hiver."
                        },
                        {
                            "text": "Fatiguée par cette longue journée, elle s'est <w>lovée</w> sous la couette chaude."
                        }
                    ],
                    "synonyms": [
                        "se blottir",
                        "se pelotonner"
                    ],
                    "common_phrases": [
                        "se lover dans un fauteuil",
                        "se lover sous la couette",
                        "se lover contre quelqu'un"
                    ]
                },
                {
                    "sense_id": "c3360372-15e3-396d-93b4-b338d54b5076",
                    "sense_definition": "S'enrouler sur lui-même en formant des anneaux, en parlant d'un serpent ou d'un reptile.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture_repliee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serpent se <w>love</w> au soleil pour réchauffer lentement son corps."
                        },
                        {
                            "text": "La vipère s'était <w>lovée</w> entre deux pierres plates au bord du sentier."
                        }
                    ],
                    "synonyms": [
                        "s'enrouler"
                    ],
                    "antonyms": [
                        "se dérouler"
                    ],
                    "common_phrases": [
                        "serpent qui se love"
                    ]
                },
                {
                    "sense_id": "c6257940-c28d-3179-bf60-5d9e6153e866",
                    "sense_definition": "Enrouler en spirale ou en cercles réguliers un cordage ou un câble pour le ranger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de quitter le pont, le marin a soigneusement <w>lové</w> les cordages mouillés."
                        },
                        {
                            "text": "Il faut apprendre à <w>lover</w> un câble sans faire de nœuds inutiles."
                        }
                    ],
                    "synonyms": [
                        "enrouler"
                    ],
                    "antonyms": [
                        "dérouler"
                    ],
                    "common_phrases": [
