                "senses": [
                    {
                        "sense_id": "b2d19c2b-1933-3867-88bb-f75490a14247",
                        "entry_id": "9ed40210-7e20-3389-b9c1-cbac20174581",
                        "glosses": [
                            "Donner un caractère imperceptible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe0a215-4bfe-4542-9e8c-ae8e21e941b6",
                                "sense_id": "b2d19c2b-1933-3867-88bb-f75490a14247",
                                "text": "Un on préfère sa personnalité imperceptibilisée à une individualité impersonnelle (on pense être plus l'un que l'autre (on est ici souvent très peu impersonnel))."
                            },
                            {
                                "example_id": "a68e46ab-112d-4219-b5f8-005ac90be14d",
                                "sense_id": "b2d19c2b-1933-3867-88bb-f75490a14247",
                                "text": "Néanmoins, on imagine sans peine qu'il aura à cœur de se dissoudre dans le vin et de s'imperceptibiliser, tant la matière disponible est là !"
                            },
                            {
                                "example_id": "eabf522d-90a2-49d9-93b3-db3aa8fb0ae5",
                                "sense_id": "b2d19c2b-1933-3867-88bb-f75490a14247",
                                "text": "Je m'évaporilise dans l'espacement grand paradis, m'imperceptibilise… me sublimatise… et m'é…ter…nii…se."
                            }
                        ]
                    }
                ],
