                    },
                    {
                        "translation_id": "10674938-7067-47a9-8077-ea2f7bfb2c93",
                        "source_entry_id": "f9077487-d6c0-38b5-b5b6-311edc0a1335",
                        "source_sense_id": "83aa2d26-7d55-3e16-b53b-b48c6a9f41bd",
                        "source_sense_description": "one who preaches",
                        "target_lang_word": "prediker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prediker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8a239302-3ccb-389a-a0cb-12f2cbce21dc",
                                        "entry_id": "b1eacbf9-bf8c-3b14-b2d4-098398be9f64",
                                        "glosses": [
                                            "een warm voorstander van een zaak die voor die zaak pleit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf1cb7b-b899-468d-ab75-9ecbfc5e43f8",
                                                "sense_id": "8a239302-3ccb-389a-a0cb-12f2cbce21dc",
                                                "text": "Hij was een waar prediker voor meer soberheid en eenvoud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b46c0dc5-bae7-37e9-8735-96fc4a950bc2",
                                        "entry_id": "b1eacbf9-bf8c-3b14-b2d4-098398be9f64",
                                        "glosses": [
                                            "verkondiger van de Goddelijke Waarheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded2212b-0bb3-4313-b6c5-fce638018749",
                                                "sense_id": "b46c0dc5-bae7-37e9-8735-96fc4a950bc2",
                                                "text": "Helemaal toevallig is dat niet. Franciscus past wonderwel bij de behoefte aan ‘spirituele stilte’, rurale eenvoud en puurheid van de natuur die zo populair zijn bij de stedelijke middenklasse. Zelfs zijn zuiverende vasten sluit naadloos aan bij wellness-centra die geestelijk en fysiek comfort bevorderen. Zijn liefde voor dieren, speciaal vogels, lijkt al te goed herkenbaar in een samenleving waarin de consument meeleeft met het treurige verhaal van de voor de slager bestemde kip of het kalfje. Wie echter denkt dat Franciscus erelid avant la lettre was van de Partij voor de Dieren, moet beseffen dat hij ook een opstandig prediker en een behendig onderhandelaar was tegenover de Saraceense sultan tijdens de vijfde kruistocht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfecc276-2dc9-36c4-87f6-7577b5a69880",
                                        "entry_id": "b1eacbf9-bf8c-3b14-b2d4-098398be9f64",
                                        "glosses": [
                                            "bijbelboek Ecclesiastes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9939cfd2-6fcd-4091-8611-324b3faa1983",
                                                "sense_id": "cfecc276-2dc9-36c4-87f6-7577b5a69880",
                                                "text": "„De tekst waar ik mij al jaren door laat inspireren is Prediker 3, vers 1 tot en met 15. Er is een tijd voor oorlog en een tijd voor vrede. Alles wat er nu gebeurt in de wereld is al eens eerder gedaan. Daar kun je lering uit trekken. Ik vind het een eer om dat op Zwarte Cross te mogen vertellen. Het is elke keer weer een hele toer voor de organisatie om dat festival uit de grond te stampen, met de brandweer erbij en met muziek in alle soorten en kleuren. Zeg maar tegen heel Nederland dat ze moeten komen en dat ze iets bijzonders gaan meemaken.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb6668e5-bba5-4021-b141-cb21be2126b3",
                        "source_entry_id": "f9077487-d6c0-38b5-b5b6-311edc0a1335",
                        "source_sense_id": "83aa2d26-7d55-3e16-b53b-b48c6a9f41bd",
                        "source_sense_description": "one who preaches",
                        "target_lang_word": "predikant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predikant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6092e4ae-bd84-363f-9a27-d2291ac25dcd",
                                        "entry_id": "e41cdb37-03ff-3cf9-a4e4-cbc612cc5aac",
                                        "glosses": [
                                            "iemand die gerechtigd is een kerkdienst te leiden in een protestantse kerk"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc80608-4376-41f6-a299-5e424edb5254",
                                                "sense_id": "6092e4ae-bd84-363f-9a27-d2291ac25dcd",
                                                "text": "De predikant kondigde aan welk gezang er gezongen ging worden en ging zitten."
                                            },
                                            {
                                                "example_id": "66df78b1-7316-4eee-b095-712641b2e0fa",
                                                "sense_id": "6092e4ae-bd84-363f-9a27-d2291ac25dcd",
                                                "text": "De predikanten De Lange (hervormde kerk), Van den Hout (gereformeerde kerk) en Wittmer (baptistengemeente) leiden de dienst. Van den Hout houdt de preek, waarin hij vertelt dat hij drie jongens heeft - alle drie op de basisschool - en dat ze het thuis wel eens 'gezellig' maken."
                                            },
                                            {
                                                "example_id": "31ea571c-fca5-49e7-84df-af055df0bc85",
                                                "sense_id": "6092e4ae-bd84-363f-9a27-d2291ac25dcd",
                                                "text": "Zo kwam ik bij de vraag: geloof ik in God? Hoewel ik protestant ben opgevoed en mijn hele leven als religieuze pelgrim op zoek naar God van kerk naar kerk zwierf ben ik nooit een grote fan van predikanten geweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "776140d0-920e-4ba6-bcbf-1c798848a7eb",
                        "source_entry_id": "f9077487-d6c0-38b5-b5b6-311edc0a1335",
                        "source_sense_id": "83aa2d26-7d55-3e16-b53b-b48c6a9f41bd",
                        "source_sense_description": "one who preaches",
                        "target_lang_word": "prédicateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédicateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af48e824-8fbd-3543-9cf5-170a9f7a77a2",
                                        "entry_id": "a91b6801-44d1-301f-945a-4af466b04661",
                                        "glosses": [
                                            "Celui qui prêche, qui annonce en chaire la parole de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62560d36-fcdb-41e1-84d8-44344e815e4f",
                                                "sense_id": "af48e824-8fbd-3543-9cf5-170a9f7a77a2",
                                                "text": "Pour lancer contre nous ces furieux prédicateurs, il faut que les chefs du clergé se soient sentis bien atteints."
                                            },
                                            {
                                                "example_id": "71784f61-9b2c-4b72-a1d4-e4f45f09a490",
                                                "sense_id": "af48e824-8fbd-3543-9cf5-170a9f7a77a2",
                                                "text": "Avant la révocation de l'Édit de Nantes, une idée domine chez tous les prédicateurs réformés : la défense de leur Église et de ses doctrines. Les réformés étaient menacés de plusieurs manières, et la lutte était pour eux une nécessité."
                                            },
                                            {
                                                "example_id": "2db1078b-bbd0-4bbd-9e0a-c0c9cb49ddf9",
                                                "sense_id": "af48e824-8fbd-3543-9cf5-170a9f7a77a2",
                                                "text": "Et les hordes fanatisées par les prédicateurs de la Croisade trouvèrent tout naturel, avant de régler leur compte à ceux qui avaient profané (soi-disant) le tombeau du Christ, de châtier les descendants des « déicides »."
                                            },
                                            {
                                                "example_id": "866583f2-bea8-4c2e-a92e-86f776e6d133",
                                                "sense_id": "af48e824-8fbd-3543-9cf5-170a9f7a77a2",
                                                "text": "Le jeune prédicateur timide étend la main droite, en tenant du bout des doigts un coin de son surplis, puis la gauche. Il lève ensuite les deux bras et comme il observe ces trois ﬁgures de ballet avec la plus stricte régularité, il oublie son texte que personne n'écoute, comme si l'on était venu pour voir danser et non pour entendre prêcher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35232513-ad2b-4766-97a0-88a8e13c6432",
                        "source_entry_id": "f9077487-d6c0-38b5-b5b6-311edc0a1335",
                        "source_sense_id": "83aa2d26-7d55-3e16-b53b-b48c6a9f41bd",
                        "source_sense_description": "one who preaches",
                        "target_lang_word": "prêcheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêcheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                                        "glosses": [
                                            "ou Prédicateur ; celui qui prêche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33458375-5415-4d19-af6d-6fbe19bfd57f",
                                                "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                                                "text": "Les terribles prêcheurs de Seize, les moines qui portaient le mousquet aux processions de la Ligue, s'humanisent tout à coup ; les voilà devenus bénins. C'est qu'il faut bien essayer d’endormir ceux qu'on n'a pas pu tuer."
                                            },
                                            {
                                                "example_id": "1bad5d69-bbad-4bdc-a2d4-dc50a9651780",
                                                "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                                                "text": "Frères prêcheurs, Religieux de l’ordre de Saint-Dominique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07aa5257-0c9b-3e1b-aef8-096dc5fe2300",
                                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                                        "glosses": [
                                            "Celui qui fait la leçon aux autres."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79237f9-9e0b-4389-af27-2898096fbf9a",
                                                "sense_id": "07aa5257-0c9b-3e1b-aef8-096dc5fe2300",
                                                "text": "Et les camarades bien divers d’agir en sourdine, de miner peu à peu les résolutions les plus vaillantes, prêcheurs d’oubli, de laisser-courre, d’exutoires !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2431e6e8-732a-3723-bb69-759b057b2ce5",
                                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                                        "glosses": [
                                            "Celui qui se mêle de faire toujours des réprimandes, des remontrances sur les moindres choses."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e9efc79-ebe9-4a25-83dd-67c765858f98",
                                                "sense_id": "2431e6e8-732a-3723-bb69-759b057b2ce5",
                                                "text": "C’est un prêcheur éternel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112ea212-e4e3-4a57-8618-b5fb0601ba77",
                        "source_entry_id": "f9077487-d6c0-38b5-b5b6-311edc0a1335",
                        "source_sense_id": "83aa2d26-7d55-3e16-b53b-b48c6a9f41bd",
                        "source_sense_description": "one who preaches",
                        "target_lang_word": "Prediger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prediger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                        "entry_id": "129447b9-4bfa-3cc4-94d7-bc18663badda",
                                        "glosses": [
                                            "Person, die Glaubenswahrheiten verkündigt, meist handelt es sich dabei um Geistliche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ae6996-e1b1-442e-a0ce-9d15580ace79",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "Manche bezeichnen Vogel als radikal-islamischen Prediger."
                                            },
                                            {
                                                "example_id": "31cd871e-6ac2-4b69-bb18-c60d893bc0c6",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "Der Prediger sprach heute über das Wunder zu Kanaan."
                                            },
                                            {
                                                "example_id": "fe3e327c-9a0a-4a65-b4e8-09d7725f066d",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "Der Prediger tritt zur besten Sendezeit auf und hat ein Millionenpublikum."
                                            },
                                            {
                                                "example_id": "36cdea7c-36b7-4bb7-a7d1-65e5e32ab578",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "„Der Prediger sollte recht behalten.“"
                                            },
                                            {
                                                "example_id": "43764ae8-99e4-4e43-b8b5-39b18da48f9b",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "„Dies ist kein schlechter Gedanke, aber aus dem Munde eines anderen Predigers wäre er uns ziemlich hart vorgekommen.“"
                                            },
                                            {
                                                "example_id": "c20f0e7a-2d37-4686-8101-0a14e17bd373",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "„Jedes einzelne Wort des Predigers war eine Verkündigung.“"
                                            },
                                            {
                                                "example_id": "3d1ec912-158c-4307-a024-2e8752c213ad",
                                                "sense_id": "340dcd05-4484-3d4d-b9df-9415d0ceff50",
                                                "text": "„Was der Prediger vorne auf der Kanzel redete, interessierte weniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
