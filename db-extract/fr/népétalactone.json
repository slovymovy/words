                "senses": [
                    {
                        "sense_id": "b5512ec1-1b38-3561-90dd-46a896b4964d",
                        "entry_id": "aa0cf2d8-0ccd-3395-b3e3-cd20b10aacac",
                        "glosses": [
                            "Composé chimique de formule brute C₁₀H₁₄O₂ de la famille des lactones, huile essentielle des feuilles et tiges de la cataire (Nepeta cataria) ou herbe-à-chats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5233cc-d1db-490b-9e64-381a7e9ec46b",
                                "sense_id": "b5512ec1-1b38-3561-90dd-46a896b4964d",
                                "text": "Outre le chat domestique, le cougar, le chat sauvage, le lynx et le lion sont sensibles à la népétalactone."
                            },
                            {
                                "example_id": "b9ce9e6f-0b3b-4000-ab3d-0374cbb52711",
                                "sense_id": "b5512ec1-1b38-3561-90dd-46a896b4964d",
                                "text": "Environ 75% des chats réagissent à la népétalactone ; c’est aussi un chasse-moustiques."
                            },
                            {
                                "example_id": "710e4245-99f7-415f-b489-58824bd730a1",
                                "sense_id": "b5512ec1-1b38-3561-90dd-46a896b4964d",
                                "text": "Il est généralement admis que ce comportement serait provoqué par l’inhalation d’une molécule biochimique naturelle présente dans la cataire : le népétalactone, de la famille des lactones."
                            }
                        ]
                    }
                ],
