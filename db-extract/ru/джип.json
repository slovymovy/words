                    },
                    {
                        "translation_id": "25f05a8b-6cf0-4ae0-a67c-ece952b973b3",
                        "source_entry_id": "090ac890-3e61-3e2e-9359-e6a236d60bb8",
                        "source_sense_description": "внедорожник",
                        "target_lang_word": "sport utility vehicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sport utility vehicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1120fa55-7452-3fc9-b115-0f918f4db257",
                                        "entry_id": "cdd3e4ea-0b0d-3fa4-b881-432bb4a4e700",
                                        "glosses": [
                                            "A passenger vehicle which combines the towing capacity of a pickup truck with the passenger-carrying space of a minivan or station wagon together with on- or off-road ability."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50391f62-8e5d-417b-a362-f3f30793d07e",
                        "source_entry_id": "090ac890-3e61-3e2e-9359-e6a236d60bb8",
                        "source_sense_description": "внедорожник",
                        "target_lang_word": "SUV",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SUV",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                        "entry_id": "995fdde5-50e3-346d-ae1e-b1f5f87ac586",
                                        "glosses": [
                                            "Initialism of sport utility vehicle; also S.U.V."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14faea86-ef0c-4b05-a8a2-12b56415c05d",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                                            },
                                            {
                                                "example_id": "7df3c2dc-9122-40bd-8db3-a2ac484648b4",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "As SUVs are higher and heavier, they are more likely to kill the people they hit. Driving an SUV in an urban area is an antisocial act."
                                            },
                                            {
                                                "example_id": "c2b40e73-13d5-4e34-a186-5403874394a4",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "Audi, which markets a variety of electrified S.U.V.s like the E-tron, is developing other designs as pure electrics, said an Audi of America spokesman, Mark Dahncke."
                                            },
                                            {
                                                "example_id": "022cd8c7-f477-4e55-aa03-021152fe2bea",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "For the whole year, the exotic automaker sold 7,430 cars and SUVs, down 9.5% compared to 2019. But the last quarter of 2020 was the best in the Italian supercar maker’s history and its order banks are already filled for the first nine months of 2021, Lamborghini CEO Stephan Winkelmann said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b93f6d4-04e0-4225-8e61-3981b2e1f3b6",
                        "source_entry_id": "090ac890-3e61-3e2e-9359-e6a236d60bb8",
                        "source_sense_description": "внедорожник",
                        "target_lang_word": "Geländewagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geländewagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                        "entry_id": "4a568ca3-7598-37f9-817d-caa6eb3d2c02",
                                        "glosses": [
                                            "ein Automobil zum Befahren von schwierigem Gelände abseits von ausgebauten Straßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c751717e-abc1-4398-9a75-14809b4c7b87",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Mein Vater fährt einen Geländewagen Baujahr 2001."
                                            },
                                            {
                                                "example_id": "d8043dd4-db01-4bee-b112-d48edf5f3add",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Gestern wurde ein Geländewagen vom Dorfplatz gestohlen."
                                            },
                                            {
                                                "example_id": "2a7a950f-5de4-4971-9a3e-98059d292a08",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Auf dem Supermarktparkplatz stehen zwei hochwertige Geländewagen."
                                            },
                                            {
                                                "example_id": "f95ef263-7426-4dae-bd50-7467442748f6",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Während der Fahrt nach München überholten uns zwei schwarze Geländewagen."
                                            },
                                            {
                                                "example_id": "5c3c308d-db50-4b1a-b40b-13d81745f719",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Ein chromblitzender Geländewagen mit einer auffälligen Werbeaufschrift wurde von einem braungebrannten Muskelmann aus einer Ausfahrt gesteuert.“"
                                            },
                                            {
                                                "example_id": "ffe0f57b-934e-419d-86de-2bb39da33d18",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Bis auf 150 Meter kamen wir mit dem Geländewagen an den Schlund heran, dann zu Fuß weiter.“"
                                            },
                                            {
                                                "example_id": "1a99b769-97f3-4bbe-9d01-aef8060a4fde",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„In meinem Geländewagen sitzt man höher als in den meisten anderen Fahrzeugen, endlich muss Negusse nicht zu allen aufblicken!“"
                                            },
                                            {
                                                "example_id": "6e3eceab-f68d-43f9-b67a-24fd3190297e",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Wir hatten einen Geländewagen mit Vierradantrieb, aber genau davor habe ich seit jeher einen Horror, noch dazu bei schwierigem Gelände und allem, was das so mit sich bringt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "879d37be-574d-4c90-94b5-db0ac0345fc8",
                        "source_entry_id": "090ac890-3e61-3e2e-9359-e6a236d60bb8",
                        "source_sense_description": "внедорожник",
                        "target_lang_word": "SUV",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SUV",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                        "entry_id": "e32180ef-a652-3aa2-bd03-c0a7fc42142f",
                                        "glosses": [
                                            "Sport Utility Vehicle; Fahrzeug, das zwar das Aussehen eines Geländewagens besitzt, meist aber nicht für Geländefahrten geeignet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d1e373-ba99-43b4-abb1-e880974af723",
                                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                                "text": "„Audi-Chef Rupert Stadler ließ auf der Peking Auto Show wenig Zweifel offen: Bis 2020 werden 45 Prozent aller verkauften Audi-Modelle SUV sein.“"
                                            },
                                            {
                                                "example_id": "72f3cbab-36e6-4947-b91c-7fc28c588bca",
                                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben.“"
                                            },
                                            {
                                                "example_id": "db767539-e7e5-4c03-838d-7ae4f4521d76",
                                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                                "text": "„Schon am Parkplatz davor fällt mein verdreckter Dacia-Lieferwagen unter den ganzen schnittigen Sportwagen und den SUVs ziemlich auf.“"
                                            },
                                            {
                                                "example_id": "c5f13d66-de76-44f0-8bec-cd28dcecff73",
                                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                                "text": "„Die Fahrt mit einem SUV sollte um die hundert Euro kosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
