    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c34ad9f-7649-3430-9352-f7cdc6237bd1",
                    "sense_definition": "The day of the week that comes after Sunday and before Tuesday, often considered the first day of the work week.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "days_of_the_week",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually feel very tired on <w>Monday</w> morning after the weekend.",
                            "target_lang_translations": {
                                "ru": "Обычно я чувствую себя очень уставшим в <w>понедельник</w> утром после выходных."
                            }
                        },
                        {
                            "text": "The office will remain closed next <w>Monday</w> due to the public holiday.",
                            "target_lang_translations": {
                                "ru": "В следующий <w>понедельник</w> офис будет закрыт в связи с государственным праздником."
                            }
                        }
                    ],
                    "synonyms": [
                        "Mon",
                        "Mon."
                    ],
                    "common_phrases": [
                        "Monday morning",
                        "next Monday",
                        "last Monday",
                        "every Monday"
                    ],
                    "target_lang_definitions": {
                        "ru": "День недели, следующий за воскресеньем и предшествующий вторнику, часто считающийся первым днем рабочей недели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понедельник",
                                "target_lang_sense_clarification": "день недели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0c1caeba-5ecc-311b-a41d-3c275150e7e4",
                    "sense_definition": "On the day of <w>Monday</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "days_of_the_week",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store is usually very busy <w>Monday</w> when they restock the shelves.",
                            "target_lang_translations": {
                                "ru": "В магазине обычно много народу в <w>понедельник</w>, когда они пополняют запасы на полках."
                            }
                        },
                        {
                            "text": "We are planning to go shopping <w>Monday</w> afternoon if the weather is nice.",
                            "target_lang_translations": {
                                "ru": "Мы планируем пойти за покупками в <w>понедельник</w> днем, если будет хорошая погода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shopping Monday",
                        "starting Monday"
                    ],
                    "traits": [
