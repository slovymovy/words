                "senses": [
                    {
                        "sense_id": "b4045cca-bbf6-3ec7-b81a-2974bdd8aa48",
                        "entry_id": "f2e493b3-29ab-3993-a182-38f9407f0a24",
                        "glosses": [
                            "バラ科の落葉高木、サービスツリー。コルマ（Cormus domestica; シノニム: Sorbus domestica）。"
                        ],
                        "tags": [],
