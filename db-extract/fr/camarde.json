                        "sense_id": "ef36192b-e346-318f-a085-60956727ba23",
                        "entry_id": "ac09861b-ea25-3c8b-8a4d-99f5552c9568",
                        "glosses": [
                            "Death (personification of death)"
                        ],
                        "tags": [
