                {
                    "sense_id": "3cdc732e-979d-367e-9620-edda535c091d",
                    "sense_definition": "Forma liczby mnogiej rzeczownika <w>lasek</w> (mały las).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lasek_grove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijaliśmy malownicze pola i sosnowe <w>laski</w>.",
                            "target_lang_translations": {
                                "ru": "Мы проезжали живописные поля и сосновые <w>лески</w>.",
                                "en": "We passed picturesque fields and pine <w>groves</w>."
                            }
                        },
                        {
                            "text": "W okolicy znajdują się liczne brzozowe <w>laski</w>, gdzie rosną grzyby.",
                            "target_lang_translations": {
                                "ru": "В округе находятся многочисленные берёзовые <w>рощи</w>, где растут грибы.",
                                "en": "There are numerous birch <w>woods</w> in the area where mushrooms grow."
                            }
