                            {
                                "example_id": "f073b322-1db0-4a00-b223-225a49b15caa",
                                "sense_id": "e716750f-710d-3839-b6a1-c4b41079d7fb",
                                "text": "До еза сходить — не в ямщину за полста верст съездить."
