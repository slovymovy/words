                "senses": [
                    {
                        "sense_id": "43922d0b-ca9e-3a27-8853-dcd86d6d5579",
                        "entry_id": "cc2497c5-ad1b-3562-8550-ddc25870785c",
                        "glosses": [
                            "otwór umożliwiający wymianę gazową rośliny z otoczeniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6d8b1a-be2d-41c9-978c-a5e64d7207ed",
                                "sense_id": "43922d0b-ca9e-3a27-8853-dcd86d6d5579",
                                "text": "Przetchlinki powstają zarówno na pędach, jak też na korzeniach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d72e2c4b-6586-3a7d-b3f4-7a04d8d8114f",
                        "entry_id": "cc2497c5-ad1b-3562-8550-ddc25870785c",
                        "glosses": [
                            "otwór w skórze lub pancerzu umożliwiający wymianę gazową organizmu z otoczeniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b995e66f-de8d-4600-b98d-2d4e7bb70fee",
                                "sense_id": "d72e2c4b-6586-3a7d-b3f4-7a04d8d8114f",
                                "text": "Pamiętajcie, że przetchlinki mają pajęczaki, wije i owady."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81f9bd1a-0fdd-42fd-a057-0fcc037902b7",
                        "source_entry_id": "cc2497c5-ad1b-3562-8550-ddc25870785c",
                        "source_sense_id": "43922d0b-ca9e-3a27-8853-dcd86d6d5579",
                        "target_lang_word": "lenticel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenticel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75e4708e-d321-33b6-8096-c13d4c96c2db",
                                        "entry_id": "27e23c94-54c9-3d64-8b86-2d502003a926",
                                        "glosses": [
                                            "One of the small, oval, rounded spots upon the stem or branch of a plant, from which the underlying tissues may protrude or roots may issue, either in the air, or more commonly when the stem or branch is covered with water or earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a209b4-5fdd-4f8e-a58c-305d753f838c",
                                                "sense_id": "75e4708e-d321-33b6-8096-c13d4c96c2db",
                                                "text": "He raises his binocular telescope, bringing the birches near the shoreline into sharp relief, the eye-shaped lenticels in the pale bark seeming to stare back at him, as if following the train’s progress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a11c374-d931-37e8-b22f-d9ce4b472856",
                                        "entry_id": "27e23c94-54c9-3d64-8b86-2d502003a926",
                                        "glosses": [
                                            "A small, lens-shaped gland on the underside of some leaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c643a3-7dad-4832-9451-d8c058f7794e",
                        "source_entry_id": "cc2497c5-ad1b-3562-8550-ddc25870785c",
                        "source_sense_id": "43922d0b-ca9e-3a27-8853-dcd86d6d5579",
                        "target_lang_word": "lenticelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenticelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                                        "entry_id": "a728007a-938b-35aa-b1a4-41160a7e05e2",
                                        "glosses": [
                                            "Tache ovale sous l’épiderme des arbres, lui servant à échanger avec le milieu extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e9db34-ac0f-4ef2-9e80-fb1662a2878e",
                                                "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                                                "text": "La lenticelle n’est ni plus ni moins qu’une déchirure du liège, ménageant une ouverture qui devient une zone privilégiée où l’air ambiant peut entrer dans la branche."
                                            },
                                            {
                                                "example_id": "1def50a4-44a5-4367-9ca5-ae30296b4646",
                                                "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                                                "text": "Une des réponses des plantes à l’inondation est la production de lenticelles de grande dimension qui facilitent les échanges gazeux […] et la production, à des fins d’échanges gazeux, de racines adventives situées au-dessus du plan d’immersion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1a3d17-8712-3fbc-bf1e-2162f68ed4a1",
                                        "entry_id": "a728007a-938b-35aa-b1a4-41160a7e05e2",
                                        "glosses": [
                                            "Tache rousse et ovale de l’épiderme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
