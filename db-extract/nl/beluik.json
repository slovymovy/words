                    },
                    {
                        "sense_id": "4b74cd05-9ab2-3fae-9831-785c0387fff2",
                        "entry_id": "1b3984ad-4762-358b-8dec-fae8c554f0af",
                        "glosses": [
                            "omsloten ruimte",
                            "complex kleine woningen gelegen rond een binnenterrein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adde278f-0a1e-4fb1-a971-78f874d52c3e",
                                "sense_id": "4b74cd05-9ab2-3fae-9831-785c0387fff2",
                                "text": "Het meest beruchte beluik van Gent is de Bataviawijk. Honderd bij dertig meter groot, ligt het binnen het huizenblok omgeven door de huidige Sint-Hubertusstraat, de Rozier en de Jozef Plateaustraat. Drie kleine doorgangen geven toegang tot 117 woningen, verdeeld over vier smalle straatjes. De huisjes meten vier bij vijf meter en bieden elk onderdak aan ongeveer vijf personen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f9dd599-0d69-360e-88a1-97e86800f5df",
                        "entry_id": "1b3984ad-4762-358b-8dec-fae8c554f0af",
                        "glosses": [
                            "omsloten ruimte",
                            "klein vertrek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eced9150-1a9c-48dc-b25d-e7206cd862b7",
                                "sense_id": "2f9dd599-0d69-360e-88a1-97e86800f5df",
                                "text": "Hij ging het laddertje op naar het beluik waar de meid sliep en vond de deur open."
                            }
                        ]
                    },
                    {
                        "sense_id": "43fa7d09-ac0f-3dba-a607-34a5d4f43ba8",
                        "entry_id": "1b3984ad-4762-358b-8dec-fae8c554f0af",
                        "glosses": [
                            "omsloten ruimte",
                            "gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bdf14f0-4a57-4a4a-930f-439d65633f58",
                                "sense_id": "43fa7d09-ac0f-3dba-a607-34a5d4f43ba8",
                                "text": "Een deel van die hekkens was gewoonlijk voorbehouden aan de eigenaar van de roterij, die haast altijd zelf vlasbaas was, en de overige waren aan huurders toegewezen. Elk kreeg zijn plaats aangeduid die dan voor heel 't seizoen zijn gebied zou blijven, en reeds vóór 't begin van 't roten stond ieders beluik met paaltjes uitgesteken, zowel in de meers als langs de oever."
                            },
                            {
                                "example_id": "439243bf-645a-407e-ba6b-765e8bde7a23",
                                "sense_id": "43fa7d09-ac0f-3dba-a607-34a5d4f43ba8",
                                "text": "Dewijl hij op St-Baefsstede niets te verrichten had, en zijn dienst hem integendeel verplichtte binnen het beluik der stad te blijven, was hij wel klaarblijkend dien nacht met vrijen wil buiten den Rooden Toren gegaan, en dit kon volgens het algemeen gevoelen slechts geschied zijn op uitdaging, om eenen twist met de dagge te beslissen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdc3db19-4490-3457-8b65-3861c7ea9771",
                        "entry_id": "1b3984ad-4762-358b-8dec-fae8c554f0af",
                        "glosses": [
                            "omsloten ruimte",
                            "gebouw, complex"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e57e6d6a-c883-469f-910d-3efb74eb4986",
                                "sense_id": "cdc3db19-4490-3457-8b65-3861c7ea9771",
                                "text": "Dit nieuw voorstel werd niet in aanmerking genomen, en op 16 juni 1855 keurde de gemeenteraad de plannen en het bestek goed voor het bouwen van zeven ziekenzalen in het beluik van het oude hospitaal."
                            }
                        ]
                    }
