                {
                    "sense_id": "26795f39-fef6-386a-a4ae-348be1a50dc0",
                    "sense_definition": "The way in which the parts of a system or object are arranged or organized.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to understand the <w>structure</w> of the organization before making changes.",
                            "target_lang_translations": {
                                "ru": "Нам нужно понять <w>структуру</w> организации, прежде чем вносить изменения.",
                                "tr": "Değişiklik yapmadan önce organizasyonun <w>yapısını</w> anlamamız gerekiyor.",
                                "pl": "Musimy zrozumieć <w>strukturę</w> organizacji przed wprowadzeniem zmian.",
                                "zh": "在做出改变之前，我们需要了解该组织的<w>结构</w>。"
                            }
                        },
                        {
                            "text": "The teacher explained the grammatical <w>structure</w> of the complex sentence.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил грамматическую <w>структуру</w> сложного предложения.",
                                "tr": "Öğretmen, karmaşık cümlenin dil bilgisel <w>yapısını</w> açıkladı.",
                                "pl": "Nauczyciel wyjaśnił <w>budowę</w> gramatyczną zdania złożonego.",
                                "zh": "老师讲解了这个复杂句的语法<w>结构</w>。"
                            }
                        }
                    ],
