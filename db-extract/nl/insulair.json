                        "cross_references": [
                            {
                                "target_word": "insular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d0744f-17d0-372d-ba73-790f5ad10f5a",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "Of or being, pertaining to, situated on, or resembling an island or islands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6338d068-7800-44e2-a777-0b11bf529b03",
                                                "sense_id": "d3d0744f-17d0-372d-ba73-790f5ad10f5a",
                                                "text": "Near-synonym: islandic"
                                            },
                                            {
                                                "example_id": "c2779417-2915-4b22-9b8e-cdcf87626888",
                                                "sense_id": "d3d0744f-17d0-372d-ba73-790f5ad10f5a",
                                                "text": "At the time of the arrival of the Tonquin he had about forty schooners, of from twenty to thirty tons burthen, and one old American ship. With these he held undisputed sway over his insular domains, and carried on intercourse with the chiefs or governors whom he had placed in command of the several islands."
                                            },
                                            {
                                                "example_id": "2b55318d-e41a-4f84-b0d1-f82f5b0b81d4",
                                                "sense_id": "d3d0744f-17d0-372d-ba73-790f5ad10f5a",
                                                "text": "There now is your insular city of the Manhattoes, belted round by wharves as Indian isles by coral reefs—commerce surrounds it with her surf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be746238-9d6d-371e-b55c-d4f571564a0e",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "Separate or isolated from the surroundings; having little regard for others opinions or prejudices; provincial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46425d88-dbe0-4b28-b4d1-084ac082ba59",
                                                "sense_id": "be746238-9d6d-371e-b55c-d4f571564a0e",
                                                "text": "Near-synonym: peninsular"
                                            },
                                            {
                                                "example_id": "8d43e401-329f-478a-8fe7-430813509b24",
                                                "sense_id": "be746238-9d6d-371e-b55c-d4f571564a0e",
                                                "text": "During the four years since his puppyhood he had lived the life of a sated aristocrat; he had a fine pride in himself, was even a trifle egotistical, as country gentlemen sometimes become because of their insular situation."
                                            },
                                            {
                                                "example_id": "f4a81fd0-d011-4050-ad60-2b7d1df135c8",
                                                "sense_id": "be746238-9d6d-371e-b55c-d4f571564a0e",
                                                "text": "Making Sense of the Sixties used the typical Americanocentric documentary style that avoided a world or historical context for events […] Other countries were mentioned only insofar as they disturbed the insular course of events in the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a3639f-00c2-372a-ab41-f76d467517c5",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "Having an inward-looking, standoffish, or withdrawn manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e0c43d-b767-4627-bfbf-c36a25338819",
                                                "sense_id": "41a3639f-00c2-372a-ab41-f76d467517c5",
                                                "text": "Harriet was fretful and insular. Miss Abbott was pleasant, and insisted on praising everything: her only regret was that she had no pretty clothes with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce6909aa-64ac-3703-8a98-67994a3092ae",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "Relating to the insula in the brain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f71c594-5bed-3c72-9c67-98902bcb0ef8",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "Relating to insulin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecdf8ed2-ed23-3daa-a7c9-60c59257652e",
                                        "entry_id": "245a5643-6408-39f1-bb74-d1838c4d5a3d",
                                        "glosses": [
                                            "(often with a capital letter) Relating to the varieties of a language or languages spoken chiefly on islands. Insular Latin, Latin as it was spoken in Britain and Ireland. Insular Celtic, the Celtic languages of Britain, Ireland and also Brittany, as opposed to those spoken in mainland Europe other than Brittany. Insular Scandinavian, relating to the Icelandic and Faroese languages as opposed to the ones spoken in Sweden, Denmark and Norway."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
