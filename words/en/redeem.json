{
    "word_family": [
        "redemption",
        "redeemable",
        "redeemer",
        "irredeemable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c5dd7e6-3580-3c24-9568-5a31de415743",
                    "sense_definition": "To exchange a coupon, voucher, or points for goods, services, or cash.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>redeem</w> your points for a variety of gift cards at any time.",
                            "target_lang_translations": {
                                "ru": "Вы можете в любое время <w>обменять</w> свои баллы на различные подарочные карты.",
                                "zh": "你可以随时用积分<w>兑换</w>各种礼品卡。"
                            }
                        },
                        {
                            "text": "The customer wanted to <w>redeem</w> a voucher for a free coffee.",
                            "target_lang_translations": {
                                "ru": "Клиент хотел <w>использовать</w> ваучер на бесплатный кофе.",
                                "zh": "顾客想用代金券<w>换取</w>一杯免费咖啡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "redeem a voucher",
                        "redeem points",
                        "redeem a coupon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обменивать купон, ваучер или баллы на товары, услуги или наличные деньги.",
                        "zh": "指用优惠券、代金券或积分换取商品、服务或现金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать",
                                "target_lang_sense_clarification": "купон или баллы"
                            },
                            {
                                "target_lang_word": "обменивать",
                                "target_lang_sense_clarification": "баллы на призы"
                            },
                            {
                                "target_lang_word": "обналичивать",
                                "target_lang_sense_clarification": "чек или ваучер"
                            },
                            {
                                "target_lang_word": "погашать",
                                "target_lang_sense_clarification": "сертификат или облигацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兑换",
                                "target_lang_sense_clarification": "积分或优惠券"
                            },
                            {
                                "target_lang_word": "使用",
                                "target_lang_sense_clarification": "代金券"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6848a3d-5f3d-3f07-b996-0c5e43ffa60a",
                    "sense_definition": "To do something that compensates for poor past performance or bad behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>redeem</w> himself by scoring the winning goal in the final minute.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>реабилитироваться</w>, забив победный гол на последней минуте.",
                                "zh": "他在最后一分钟踢进了制胜一球，成功<w>挽回</w>了形象。"
                            }
                        },
                        {
                            "text": "The actor's brilliant performance helped <w>redeem</w> an otherwise boring movie.",
                            "target_lang_translations": {
                                "ru": "Блестящая игра актера помогла <w>спасти</w> в остальном скучный фильм.",
                                "zh": "这位演员精彩的表演让这部原本乏味的电影得以<w>弥补</w>不足。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "redeem himself",
                        "redeem a reputation",
                        "redeeming feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-то, что компенсирует плохие результаты в прошлом или плохое поведение.",
                        "zh": "指通过某种行为来弥补过去的过失或糟糕的表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реабилитироваться",
                                "target_lang_sense_clarification": "в глазах окружающих"
                            },
                            {
                                "target_lang_word": "искупать",
                                "target_lang_sense_clarification": "вину или ошибку"
                            },
                            {
                                "target_lang_word": "спасать",
                                "target_lang_sense_clarification": "ситуацию или репутацию"
                            },
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挽回",
                                "target_lang_sense_clarification": "声誉或形象"
                            },
                            {
                                "target_lang_word": "弥补",
                                "target_lang_sense_clarification": "过失或不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abfeaa0b-a537-38ea-b994-a228aeb98a06",
                    "sense_definition": "To recover ownership of something by paying a sum of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>redeem</w> his watch from the pawnshop before the deadline.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было <w>выкупить</w> свои часы из ломбарда до истечения срока.",
                                "zh": "他必须在截止日期前从当铺把手表<w>赎回</w>。"
                            }
                        },
                        {
                            "text": "The family worked hard to <w>redeem</w> the property after the mortgage crisis.",
                            "target_lang_translations": {
                                "ru": "Семья упорно трудилась, чтобы <w>вернуть</w> собственность после ипотечного кризиса.",
                                "zh": "抵押贷款危机后，这家人努力工作以<w>赎回</w>房产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buy back",
                        "repurchase"
                    ],
                    "antonyms": [
                        "abandon"
                    ],
                    "common_phrases": [
                        "redeem a mortgage",
                        "redeem from pawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть право собственности на что-либо, выплатив определенную сумму денег.",
                        "zh": "指通过支付一定金额取回某物的拥有权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкупать",
                                "target_lang_sense_clarification": "вещь из залога"
                            },
                            {
                                "target_lang_word": "выкупить",
                                "target_lang_sense_clarification": "имущество"
                            },
                            {
                                "target_lang_word": "погашать",
                                "target_lang_sense_clarification": "закладную"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赎回",
                                "target_lang_sense_clarification": "抵押物或典当品"
                            },
                            {
                                "target_lang_word": "偿还",
                                "target_lang_sense_clarification": "债务或抵押贷款"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31e4c3fa-1a85-3443-909b-e9fcaa007761",
                    "sense_definition": "To save someone from the power of evil or the consequences of sin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "salvation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many religions teach that faith can <w>redeem</w> a person from their past sins.",
                            "target_lang_translations": {
                                "ru": "Многие религии учат, что вера может <w>избавить</w> человека от его прошлых грехов.",
                                "zh": "许多宗教教导说，信仰可以使人从过去的罪孽中得到<w>救赎</w>。"
                            }
                        },
                        {
                            "text": "The priest spoke about the power of God to <w>redeem</w> even the most lost souls.",
                            "target_lang_translations": {
                                "ru": "Священник говорил о силе Бога <w>спасать</w> даже самые заблудшие души.",
                                "zh": "牧师谈到了上帝有能力<w>拯救</w>即使是最迷失的灵魂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "redeem from sin",
                        "redeem the soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасти кого-либо от власти зла или последствий греха.",
                        "zh": "指在宗教语境下，将某人从罪恶或罪孽的后果中拯救出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искупать",
                                "target_lang_sense_clarification": "грехи"
                            },
                            {
                                "target_lang_word": "спасать",
                                "target_lang_sense_clarification": "душу"
                            },
                            {
                                "target_lang_word": "избавлять",
                                "target_lang_sense_clarification": "от греха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "救赎",
                                "target_lang_sense_clarification": "灵魂或罪孽"
                            },
                            {
                                "target_lang_word": "拯救",
                                "target_lang_sense_clarification": "脱离罪恶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7a4c4cb-3be1-3215-914f-d864630761fc",
                    "sense_definition": "To set someone free from captivity or slavery by paying a ransom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government refused to <w>redeem</w> the hostages through a cash payment.",
                            "target_lang_translations": {
                                "ru": "Правительство отказалось <w>выкупать</w> заложников путем денежной выплаты.",
                                "zh": "政府拒绝通过支付现金来<w>赎回</w>人质。"
                            }
                        },
                        {
                            "text": "In ancient times, families would often <w>redeem</w> prisoners of war.",
                            "target_lang_translations": {
                                "ru": "В древние времена семьи часто <w>выкупали</w> военнопленных.",
                                "zh": "在古代，家人经常会<w>赎回</w>战俘。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "redeem a hostage",
                        "redeem from captivity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить кого-либо из плена или рабства, заплатив выкуп.",
                        "zh": "指通过支付赎金使某人从囚禁或奴役中获得自由。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкупать",
                                "target_lang_sense_clarification": "пленного"
                            },
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "за выкуп"
                            },
                            {
                                "target_lang_word": "вызволять",
                                "target_lang_sense_clarification": "из плена"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赎回",
                                "target_lang_sense_clarification": "人质或俘虏"
                            },
                            {
                                "target_lang_word": "解救",
                                "target_lang_sense_clarification": "支付赎金后获释"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}