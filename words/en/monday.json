                    "sense_id": "4c34ad9f-7649-3430-9352-f7cdc6237bd1",
                    "sense_definition": "The day of the week that comes after Sunday and before Tuesday, often considered the first day of the work week.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "days_of_the_week",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually feel very tired on <w>Monday</w> morning after the weekend.",
                            "target_lang_translations": {
                                "ru": "Обычно я чувствую себя очень уставшим в <w>понедельник</w> утром после выходных.",
                                "zh": "周末过后，我通常在<w>星期一</w>早上感到非常疲惫。"
                            }
                        },
                        {
                            "text": "The office will remain closed next <w>Monday</w> due to the public holiday.",
                            "target_lang_translations": {
                                "ru": "В следующий <w>понедельник</w> офис будет закрыт в связи с государственным праздником.",
                                "zh": "由于公共假期，办公室下个<w>星期一</w>将保持关闭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mon",
                        "Mon."
                    ],
                    "common_phrases": [
                        "Monday morning",
                        "next Monday",
                        "last Monday",
                        "every Monday"
                    ],
                    "target_lang_definitions": {
