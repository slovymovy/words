{
    "word_family": [
        "slier",
        "geslier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24ad850f-c0b0-3001-9a6e-9b433394c88e",
                    "sense_definition": "glijdend voortbewegen, over een glad oppervlak glijden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "glijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>slieren</w> over het ijs op de bevroren vijver.",
                            "target_lang_translations": {
                                "en": "The children <w>slide</w> across the ice on the frozen pond."
                            }
                        },
                        {
                            "text": "We zagen de slee soepel over de sneeuw <w>slieren</w>.",
                            "target_lang_translations": {
                                "en": "We saw the sled <w>glide</w> smoothly over the snow."
                            }
                        }
                    ],
                    "synonyms": [
                        "glijden",
                        "glibberen"
                    ],
                    "common_phrases": [
                        "over het ijs slieren"
                    ],
                    "target_lang_definitions": {
                        "en": "To move in a sliding or gliding manner, especially over a slippery surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slide",
                                "target_lang_sense_clarification": "to move smoothly along a surface"
                            },
                            {
                                "target_lang_word": "glide",
                                "target_lang_sense_clarification": "to move continuously and easily"
                            },
                            {
                                "target_lang_word": "slip",
                                "target_lang_sense_clarification": "to slide unintentionally or easily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00f00ee2-d39d-3755-8710-27c036ca4c9f",
                    "sense_definition": "slepend, glijdend voortbewegen of dansen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>slierden</w> elegant over de dansvloer tijdens de wals.",
                            "target_lang_translations": {
                                "en": "They <w>glided</w> elegantly across the dance floor during the waltz."
                            }
                        },
                        {
                            "text": "Met lange, slepende passen zagen we hem door de gangen <w>slieren</w>.",
                            "target_lang_translations": {
                                "en": "With long, dragging steps, we saw him <w>shuffle</w> through the corridors."
                            }
                        }
                    ],
                    "synonyms": [
                        "glijden"
                    ],
                    "common_phrases": [
                        "over de dansvloer slieren"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or dance with dragging, sliding, or gliding steps."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glide",
                                "target_lang_sense_clarification": "to move gracefully and smoothly"
                            },
                            {
                                "target_lang_word": "slide",
                                "target_lang_sense_clarification": "to move with smooth, continuous steps"
                            },
                            {
                                "target_lang_word": "shuffle",
                                "target_lang_sense_clarification": "to walk or dance with dragging feet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e98a25c-5e4c-3767-8ac3-539cbabb006a",
                    "sense_definition": "doelloos ergens ronddolen, kronkelen of rondlopen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rondhangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongeren <w>slieren</w> de hele middag doelloos door de winkelstraten.",
                            "target_lang_translations": {
                                "en": "The youths <w>loiter</w> aimlessly through the shopping streets all afternoon."
                            }
                        },
                        {
                            "text": "In plaats van te werken, bleef hij maar een beetje op straat <w>slieren</w>.",
                            "target_lang_translations": {
                                "en": "Instead of working, he just kept <w>hanging around</w> on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondhangen"
                    ],
                    "common_phrases": [
                        "op straat slieren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak in informele context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To wander aimlessly, loiter, or stroll around without a clear purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loiter",
                                "target_lang_sense_clarification": "to stand or wait around idly"
                            },
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to roam or stroll aimlessly"
                            },
                            {
                                "target_lang_word": "hang around",
                                "target_lang_sense_clarification": "to spend time in a place doing nothing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af41a729-9172-3975-8c12-88865d1f148e",
                    "sense_definition": "met moeite achter zich aan trekken; slepen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest de zware takken moeizaam achter zich aan over de grond <w>slieren</w>.",
                            "target_lang_translations": {
                                "en": "He had to laboriously <w>drag</w> the heavy branches behind him along the ground."
                            }
                        },
                        {
                            "text": "De vermoeide reiziger bleef zijn koffer door het zand <w>slieren</w>.",
                            "target_lang_translations": {
                                "en": "The tired traveler kept <w>dragging</w> his suitcase through the sand."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleuren"
                    ],
                    "common_phrases": [
                        "over de grond slieren"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in bepaalde dialecten of regio's gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To drag or pull something heavy along the ground with effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "to pull along with effort or difficulty"
                            },
                            {
                                "target_lang_word": "haul",
                                "target_lang_sense_clarification": "to pull or drag with effort"
                            },
                            {
                                "target_lang_word": "trail",
                                "target_lang_sense_clarification": "to drag along behind"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "786dc775-aaf8-3600-ae9b-be44bb0978e4",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>slier</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hingen lange <w>slieren</w> klimop langs de oude bakstenen muur.",
                            "target_lang_translations": {
                                "en": "There were long <w>strands</w> of ivy hanging along the old brick wall."
                            }
                        },
                        {
                            "text": "De kok sneed de groenten in dunne <w>slieren</w> voor de soep.",
                            "target_lang_translations": {
                                "en": "The chef cut the vegetables into thin <w>strips</w> for the soup."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lange slieren"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'slier'; long, thin, trailing pieces, strands, or ribbons."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strands",
                                "target_lang_sense_clarification": "thin, thread-like pieces"
                            },
                            {
                                "target_lang_word": "streamers",
                                "target_lang_sense_clarification": "long, narrow ribbons or strips"
                            },
                            {
                                "target_lang_word": "trails",
                                "target_lang_sense_clarification": "long, hanging or dragging pieces"
                            },
                            {
                                "target_lang_word": "strips",
                                "target_lang_sense_clarification": "long, narrow pieces of material or food"
                            }
                        ]
                    }
                }
            ]
        }
    ]
