                        "examples": [
                            {
                                "example_id": "b19fc996-435d-4034-bc21-80bebd1844b8",
                                "sense_id": "fec3a500-5830-3c1c-901a-9507d853e959",
                                "text": "„Wird die Prozesskostenhilfe in vollem Umfang bewilligt, werden die Gerichtskosten sowie die Anwaltsgebühren des eigenen Rechtsanwaltes nach dem Rechtsanwaltsvergütungsgesetz dann durch die Staatskasse getragen, wenn der Antragsteller den Prozess verliert.“"
                            }
                        ],
