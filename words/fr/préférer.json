            "senses": [
                {
                    "sense_id": "2a92b0fd-7762-3bc0-a08e-3f895d996331",
                    "sense_definition": "Aimer mieux une personne ou une chose plutôt qu'une autre ; choisir de manière privilégiée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère <w>préfère</w> le chocolat noir mais moi j'aime mieux le chocolat au lait."
                        },
                        {
                            "text": "Je <w>préfère</w> voyager en train plutôt qu'en avion pour ces vacances."
                        }
                    ],
                    "synonyms": [
                        "aimer mieux"
                    ],
                    "common_phrases": [
                        "préférer le thé au café",
                        "préférer la marche"
                    ]
                },
                {
                    "sense_id": "3d8c8dbb-d66f-307b-a761-3a3c0fef4ee5",
                    "sense_definition": "Désirer ou vouloir faire une chose par inclination personnelle ou prudence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme il commençait à pleuvoir, nous avons <w>préféré</w> rester chez nous ce soir."
                        },
                        {
                            "text": "Le directeur a précisé qu'il <w>préférerait</w> discuter de ce projet demain matin."
                        }
                    ],
                    "common_phrases": [
                        "préférer partir",
                        "préférer attendre"
                    ]
                },
                {
                    "sense_id": "06b518b6-cbd5-314a-8064-cb98e820963a",
                    "sense_definition": "Se développer plus facilement ou prospérer dans des conditions données, en parlant d'un végétal ou d'un organisme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette variété de rose <w>préfère</w> les sols riches et une exposition ensoleillée."
                        },
                        {
                            "text": "Certaines bactéries anaérobies <w>préfèrent</w> les milieux totalement dépourvus d'oxygène."
                        }
                    ],
