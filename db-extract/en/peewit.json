                        "source_entry_id": "2218d71c-6cf9-3107-8f82-bb95570062bd",
                        "source_sense_description": "Vanellus vanellus",
                        "target_lang_word": "vanneau huppé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanneau huppé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "193e5576-d885-3d06-b063-59194ad43ab6",
                                        "entry_id": "6a2a3559-35c8-3a2e-8a0c-cd1bf696eafb",
                                        "glosses": [
                                            "Espèce d'oiseau petit échassier, limicole de l'Ancien Monde qui a une longue huppe noire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea57224-38f1-4f98-8efe-df975bd1a3cc",
                                                "sense_id": "193e5576-d885-3d06-b063-59194ad43ab6",
                                                "text": "Tous sont des oiseaux aquatiques à l'exception du vanneau huppé qui, cependant, occupe également les rives d'étangs aussi souvent que les prairies humides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36899bd3-321e-4a53-a720-47c7697c8239",
                        "source_entry_id": "2218d71c-6cf9-3107-8f82-bb95570062bd",
                        "source_sense_description": "Vanellus vanellus",
                        "target_lang_word": "Kiebitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiebitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fdbecd-721c-33bc-8878-84d50129de79",
                                        "entry_id": "4898d284-84ba-3984-a792-8813b51175fb",
                                        "glosses": [
                                            "Regenpfeifer aus der Gattung Vanellus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74297010-b339-4aab-bf25-196bd51fa2da",
                                                "sense_id": "c5fdbecd-721c-33bc-8878-84d50129de79",
                                                "text": "Der Steppenkiebitz ist einer der seltensten Kiebitze der Welt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                        "entry_id": "4898d284-84ba-3984-a792-8813b51175fb",
                                        "glosses": [
                                            "der heimische , ein Vogel mit aufrichtbarer schwarzer Federhaube"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba78f262-babc-4ba1-a3d2-23cab64fc565",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "Der Kiebitz ist bei den Strandwanderern sehr beliebt."
                                            },
                                            {
                                                "example_id": "d270dc32-a8b1-413c-b7b2-e17317ede723",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "Der Kiebitz war der Vogel des Jahres 1996; 2001 wurde er auf die Rote Liste gefährdeter Arten gesetzt."
                                            },
                                            {
                                                "example_id": "cbcc72e6-0998-42bb-9aa8-97b2af26b00a",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„Kiebitze hatten sich längst aus der Sperrzone verzogen, ebenso waren die Fasane ausgewandert und die wilden, auf Stille angewiesenen Kaninchen.“"
                                            },
                                            {
                                                "example_id": "367804c2-578e-436b-9c04-4a4578b05df4",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„In einem goldenen Schild ein, auf einem grünen Ast mit daran hängender grüner Weintraube sitzender naturfarbener Kiebitz.“"
                                            },
                                            {
                                                "example_id": "b8cab2f0-71d5-4f1e-af29-764cc95b4687",
                                                "sense_id": "672f19d9-8782-34a1-be2f-79757add7320",
                                                "text": "„Die Schatten schreckten die Kiebitze in ihren Nestern auf, sodass die Jungs mit etwas Glück die zurückgelassenen Eier finden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kiebitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                        "entry_id": "d6c4a8ba-fa15-30a2-949b-fe637ca6326e",
                                        "glosses": [
                                            "Zuschauer beim Kartenspiel, störender Zuschauer und Ratgeber beim Schachspiel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71167343-2e7d-4d6a-ba8b-f163e4b67878",
                                                "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                                "text": "„Quetschke war ein Genie, er war Hellseher. Wenn er in der Friedenszeit beim Skatspiel als Kiebitz riet: »August, riskier’s,« und August riskierte es, gewann er das Spiel oft wider Erwarten; wenn Quetschke aber abriet: »August, lasse die Hand davon,« und August wagte das Spiel dennoch, dann kam er ins Minus.“"
                                            },
                                            {
                                                "example_id": "c29484ab-aeb1-4d91-8c6c-f0fc43a6a766",
                                                "sense_id": "7f0dc763-e4ba-33c4-83a1-59fd1072f335",
                                                "text": "„Er sah, daß dem Kiebitz beide Füße fehlten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
