                    {
                        "translation_id": "1c6b693a-1f59-4051-a5b2-5f21841de22a",
                        "source_entry_id": "3ef41f54-63f7-3f76-b7d6-c551352db27e",
                        "source_sense_id": "0e33e09b-fb79-3135-99ac-596b7587fc3d",
                        "target_lang_word": "isotherme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6fa051-ead2-34c2-bcab-2ae07dd12fb6",
                                        "entry_id": "4a5aa3f2-e0c8-3003-9631-514de309b9fc",
                                        "glosses": [
                                            "Qui a la même température moyenne."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1450f7c-117a-4d85-a78b-e104f95d0f7b",
                                                "sense_id": "fe6fa051-ead2-34c2-bcab-2ae07dd12fb6",
                                                "text": "Supposons un radiomètre observant un corps plan lambertien isotherme et considérons que θ et θ’ sont dans le même plan. L est la luminance intégrée dans la bande spectrale du radiomètre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                                        "entry_id": "b1af5a49-61e2-317e-95c6-7ffcc61c40e0",
                                        "glosses": [
                                            "Se dit de récipients conçus pour conserver le plus longtemps possible la température de leur contenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10039fbe-0c1c-4790-8661-a67e5d19f650",
                                                "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                                                "text": "Le record du choix appartient à la banque danoise Cryos, qui offre « 700 donneurs et plus de 100 litres de sperme congelé ». Les paillettes sont livrées par DHL dans une boîte isotherme façon surgelés Picard."
                                            },
                                            {
                                                "example_id": "9d9e414a-f791-48d9-bfac-2e98375bc669",
                                                "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                                                "text": "Cette bouteille isotherme en acier inoxydable est la solution la plus saine pour transporter vos boissons. Elle est 100% étanche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                                        "entry_id": "261f4d0c-089c-35bd-a749-b4b7f41e7638",
                                        "glosses": [
                                            "Ligne fictive sur laquelle l'on mesure la même température moyenne, déterminant des frontières entre différents biotopes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab6d1f7-92e4-4d15-8fca-b041772ee99a",
                                                "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                                                "text": "Il est bien évident que les plantes vivent uniquement dans les milieux qui leur conviennent, […] : ainsi l’isotherme de 4°5 moyenne du mois de janvier concorde remarquablement avec la répartition de Rubia peregrina en Europe occidentale."
                                            },
                                            {
                                                "example_id": "ced0390f-485c-4cee-87ef-ed74eba2d7cd",
                                                "sense_id": "d5ab4362-3824-3fb0-a23a-dd56bfc0e9bc",
                                                "text": "Le retrait de la limite des glaces vers les pôles, en latitude, et vers les sommets des montagnes, en altitude, est la manifestation visible et tangible de la migration d’une ligne invisible qui relie les lieux où la température moyenne annuelle de l’air est proche de zéro : l’isotherme 0 °C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a2b1a10-e0e6-41db-aaa0-87e6d5a0523c",
                        "source_entry_id": "3ef41f54-63f7-3f76-b7d6-c551352db27e",
                        "source_sense_id": "0e33e09b-fb79-3135-99ac-596b7587fc3d",
                        "target_lang_word": "Isotherme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isotherme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0afe1d2-bb5b-3f0d-ac63-9e0b56a72608",
                                        "entry_id": "fb34c089-c845-3c77-9abb-13c9dd5d662a",
                                        "glosses": [
                                            "eine Linie gleicher Temperatur auf Klimakarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0405d9-961a-4a84-9b08-1ad2b2d36aa3",
                                                "sense_id": "e0afe1d2-bb5b-3f0d-ac63-9e0b56a72608",
                                                "text": "„Der Abstand der Isothermen gibt einen Hinweis auf den Umfang des Temperaturgefälles in einem Gebiet.“"
                                            },
                                            {
                                                "example_id": "7cfd1274-171e-471b-be9a-2bf1ee80c378",
                                                "sense_id": "e0afe1d2-bb5b-3f0d-ac63-9e0b56a72608",
                                                "text": "„Über dem Atlantik befand sich ein barometrisches Minimum; es wanderte ostwärts, einem über Rußland lagernden Maximum zu, und verriet noch nicht die Neigung, diesem nördlich auszuweichen. Die Isothermen und Isotheren taten ihre Schuldigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
