                "senses": [
                    {
                        "sense_id": "554be8f3-e4d6-341d-b338-a26e1305ac58",
                        "entry_id": "115e553a-3c0d-36a5-a358-ba1ca04b3f53",
                        "glosses": [
                            "Donner un caractère facho à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4333a28c-6e61-4f59-b29f-53082433873a",
                                "sense_id": "554be8f3-e4d6-341d-b338-a26e1305ac58",
                                "text": "Elle se droitise, se fachise, se xénophobise chaque jour un peu plus."
                            },
                            {
                                "example_id": "97f6a12d-36e5-4bb0-9095-6756f84c1cdb",
                                "sense_id": "554be8f3-e4d6-341d-b338-a26e1305ac58",
                                "text": "Sévir, et le politique qui en prendra l'initiative ne sera pas réélu, marginalisé et fachisé."
                            },
                            {
                                "example_id": "5c2ef9b8-bc71-4723-a8e5-607108e8390e",
                                "sense_id": "554be8f3-e4d6-341d-b338-a26e1305ac58",
                                "text": "Maintenant ils tentent de \"fachiser\" les électeurs UMP qui ont permis à S. Monteil de faire 49% dans le Doubs."
                            }
                        ]
                    }
