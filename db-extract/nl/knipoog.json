                "senses": [
                    {
                        "sense_id": "4f6f58b0-b55f-3aba-9d6c-62f8e0a2c2e2",
                        "entry_id": "01201160-fa6e-3e45-aaf9-5f29314235f9",
                        "glosses": [
                            "teken in de vorm van het kort toeknijpen van een oog om verstandhouding, waardering of een humoristische bedoeling uit te drukken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c1a599d-bdc1-426c-95ae-74c28b5c6102",
                                "sense_id": "4f6f58b0-b55f-3aba-9d6c-62f8e0a2c2e2",
                                "text": "Na haar inbreng, toen Kaag weer plaatsnam in de bankjes, kreeg ze een knipoog van Rutte."
                            },
                            {
                                "example_id": "ba88ee56-3dd2-4cc0-8921-03593454c416",
                                "sense_id": "4f6f58b0-b55f-3aba-9d6c-62f8e0a2c2e2",
                                "text": "Ik werk als verpleegkundige in het ziekenhuis en heb bij een patiënt een zakje bloed aangehangen. Ruim twee uur later belt hij en zegt: „Wat ik nog wel wil weten zuster, is dit bloed gegeven door een Ajacied? Want dat moet ik niet hebben!” Ik kijk op m’n blaadje en zeg met een knipoog: „Helaas meneer, de mutatie is al begonnen..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b108ef-ee76-3615-a39e-9888035fd1ef",
                        "entry_id": "01201160-fa6e-3e45-aaf9-5f29314235f9",
                        "glosses": [
                            "lichtvoetige verwijzing of toespeling"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "edd08ad0-5a71-4cc4-b5e9-237c342de155",
                                "sense_id": "b2b108ef-ee76-3615-a39e-9888035fd1ef",
                                "text": "De Tweede-Kamerfractie van het CDA heeft een nota het licht doen zien met de titel ‘Alles van Waarde is Weerbaar’ (NRC Handelsblad, 17 januari). Op de inhoud ervan wil ik hier niet ingaan. Het gaat mij om de titel. Een titel met een knipoog naar Luceberts ‘Alles van waarde is weerloos’."
                            },
                            {
                                "example_id": "5c0b7eae-4eca-4e13-9096-4ce57bd7e192",
                                "sense_id": "b2b108ef-ee76-3615-a39e-9888035fd1ef",
                                "text": "Liam maakte nog een laatste knipoog naar hun onrustige verleden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee36fa9d-323f-40ca-8b88-18424feb2a88",
                        "source_entry_id": "01201160-fa6e-3e45-aaf9-5f29314235f9",
                        "source_sense_id": "4f6f58b0-b55f-3aba-9d6c-62f8e0a2c2e2",
