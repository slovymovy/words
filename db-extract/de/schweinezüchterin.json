                "senses": [
                    {
                        "sense_id": "31ea5ea5-1100-3d7b-b176-329686f5c036",
                        "entry_id": "52b7a929-0fcc-3cb5-bc9c-b05312b6c988",
                        "glosses": [
                            "Frau, die Schweine züchtet, die eine Schweinezucht betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02603484-6d98-4f29-9567-d42bf58d1c13",
                                "sense_id": "31ea5ea5-1100-3d7b-b176-329686f5c036",
                                "text": "„ Im Mittelpunkt des Geschehens steht die Schweinezüchterin Selma, die furchtlos versucht, dem Kollektivzwang der sozialistischen Gesellschaft zu entfliehen und ihre Individualität zu verteidigen.“"
                            },
                            {
                                "example_id": "19799ce0-a406-47ba-862f-3dea77c89541",
                                "sense_id": "31ea5ea5-1100-3d7b-b176-329686f5c036",
                                "text": "„Witzige Geschichten aus dem Leben mit zwei borstigen Gefährten kombiniert Whyman mit dem fachlichen Wissen einer Schweinezüchterin und eines Veterinärprofessors, die Faszinierendes zur Evolution, dem Verhalten und der Kommunikation von Schweinen zu erzählen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
