                    {
                        "translation_id": "cfdeae52-509f-42f2-b804-3b02b8eee5eb",
                        "source_entry_id": "4e0126d1-ed8e-300f-bab3-3e361acae0b0",
                        "source_sense_id": "b1c196c6-0884-3dd0-83a3-01ba3381a9d4",
