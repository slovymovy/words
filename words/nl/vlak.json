    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "951ab852-700f-3694-94d5-cf619cea6163",
                    "sense_definition": "zonder bergen of dalen; horizontaal en gelijkmatig",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "oppervlakte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het landschap in dit deel van Nederland is erg <w>vlak</w> en open.",
                            "target_lang_translations": {
                                "en": "The landscape in this part of the Netherlands is very <w>flat</w> and open.",
                                "ru": "Ландшафт в этой части Нидерландов очень <w>равнинный</w> и открытый."
                            }
                        },
                        {
                            "text": "We fietsten urenlang over een <w>vlakke</w> weg zonder enige heuvel.",
                            "target_lang_translations": {
                                "en": "We cycled for hours over a <w>flat</w> road without any hills.",
                                "ru": "Мы часами ехали на велосипедах по <w>ровной</w> дороге без единого холма."
                            }
                        }
                    ],
                    "synonyms": [
                        "plat"
                    ],
                    "antonyms": [
                        "heuvelachtig",
                        "steil",
                        "ruw"
                    ],
                    "common_phrases": [
                        "vlak land",
                        "vlakke weg"
                    ],
                    "target_lang_definitions": {
                        "en": "without mountains or valleys; horizontal and even",
                        "ru": "без гор или долин; горизонтальный и ровный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "having no variations in height"
                            },
                            {
                                "target_lang_word": "level",
                                "target_lang_sense_clarification": "the same height at all places"
                            },
                            {
                                "target_lang_word": "even",
                                "target_lang_sense_clarification": "flat and level"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "плоский",
                                "target_lang_sense_clarification": "не имеющий возвышенностей"
                            },
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "гладкий, без неровностей"
                            },
                            {
                                "target_lang_word": "равнинный",
                                "target_lang_sense_clarification": "о ландшафте"
                            }
                        ]
                    }
                }
            ]
        },
        {
