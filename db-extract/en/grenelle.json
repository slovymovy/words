                                    {
                                        "sense_id": "1cbfd6a6-dba5-3110-bc0b-b578583d0747",
                                        "entry_id": "76917ffc-232b-3335-a821-869382ca6c15",
                                        "glosses": [
                                            "Ancienne commune du département de la Seine en France, annexée par Paris en 1860."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ba7de6-f7fd-4578-a2a3-701289df2f65",
                                                "sense_id": "1cbfd6a6-dba5-3110-bc0b-b578583d0747",
                                                "text": "Le pont de Grenelle, construit en bois en 1828, met en communication l’ancien Auteuil et l’ancien Grenelle."
                                            },
                                            {
                                                "example_id": "41539628-ed2c-4521-830f-c3d38a644b0a",
                                                "sense_id": "1cbfd6a6-dba5-3110-bc0b-b578583d0747",
                                                "text": "Exception faite pour le coucou qu’ils prenaient pour aller à Grenelle ou à Brévannes, c’est la première fois qu’il dépense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca63173e-00b2-35db-8c7b-3d00a12c5c3f",
                                        "entry_id": "76917ffc-232b-3335-a821-869382ca6c15",
                                        "glosses": [
                                            "Le 59ᵉ quartier administratif de Paris, situé dans le 15ᵉ arrondissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9687f26-c0b6-44cd-8fcd-12ebd0e219aa",
                                                "sense_id": "ca63173e-00b2-35db-8c7b-3d00a12c5c3f",
                                                "text": "Mais pour que vous pigiez l’histoire, faut que j’remonte à 1919, au temps qu’Milo-la-Graisse terrorisait le quartier. C’est à Grenelle qu’il habitait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Grenelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b00b02-99a1-3652-9de5-e7806fcef95b",
                                        "entry_id": "c3d00c74-d16b-333b-8814-13a593a4baa3",
                                        "glosses": [
                                            "Négociations multipartites qui associent le gouvernement français et les acteurs sociaux (syndicats, ONG, etc.)."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae00894b-74cd-4968-86db-b22f55f0d539",
                                                "sense_id": "e1b00b02-99a1-3652-9de5-e7806fcef95b",
                                                "text": "Les Grenelles se suivent et ne se ressemblent pas."
                                            },
                                            {
                                                "example_id": "2e1b5198-b061-4e07-a939-ea03f4b3dea5",
                                                "sense_id": "e1b00b02-99a1-3652-9de5-e7806fcef95b",
                                                "text": "Nous assistons à la grand-messe du Grenelle, n’en percevant que le résultat le plus concret, un immense encombrement de voitures et de journalistes qui stationnent sous nos fenêtres."
                                            },
                                            {
                                                "example_id": "1b02cffb-3cab-458b-b5af-fe52d9d196ed",
                                                "sense_id": "e1b00b02-99a1-3652-9de5-e7806fcef95b",
                                                "text": "Depuis le Grenelle des violences conjugales, en 2019, les dépôts de plainte ont été facilités, des policiers et des magistrats formés. Il reste à garantir que les plaignantes soient écoutées et protégées."
                                            }
                                        ]
                                    },
