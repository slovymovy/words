                                            {
                                                "example_id": "59c0cf78-c66a-4440-bf6d-d5c4e3459c55",
                                                "sense_id": "9afcab58-372d-3caa-9443-f9c84029c8d5",
                                                "text": "Then Iohnson raising with the goblette of wine in sinister and sup. porting himself as he mought with his dexter"
                                            },
                                            {
                                                "example_id": "d7b6526b-e28c-4baf-959c-eeb4a2220f65",
                                                "sense_id": "9afcab58-372d-3caa-9443-f9c84029c8d5",
                                                "text": "Dan paid, unfumblingly, for a round of drinks. He hoisted a foaming beer to his lips. Janice smiled and lifted a goblette of lambent wine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goblette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4605eb70-7496-3f4c-9813-134beaf137e1",
                                        "entry_id": "0e5d1524-efbf-3494-82db-76995519b2f8",
                                        "glosses": [
                                            "a female goblin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f7bf87-df53-489b-95e3-3ed52203661c",
                                                "sense_id": "4605eb70-7496-3f4c-9813-134beaf137e1",
                                                "text": "\"I am Gwendolyn Goblin, soon to be chief on Goblin Mountain. Now get out of the way before I move you out.\"\n\"Ho, ho, ho. It is to laugh. You can't move me out, you skirted goblette. You must pay\"\n..\n\"So you're stuck, goblette,\" Hugh Mongous said. \"Pay.\"\n\"This is outrageous!\" Gwenndy said, stamping her little foot.\n..\n“Cups, glasses, containers, bottles, mugs—”\n“Goblets?”\n\"Whatever.\"\n“Nothing interesting,” Gwenny said, hoping the demoness would go away. There was no point in correcting her about the distinction between a goblet and a goblette, or in reminding her that there was only one goblin in this party. They had enough problems without having them complicated by a supernatural creature. Demonesses were supposed to be less worse than demons, being mischievous rather than mean, but their mischief could be formidable."
                                            },
                                            {
                                                "example_id": "22f029be-9800-4e7c-885c-1cf47309ae59",
                                                "sense_id": "4605eb70-7496-3f4c-9813-134beaf137e1",
                                                "text": "A girl Goblin. Happy Halloween to all you Goblins and Goblettes!"
                                            },
                                            {
                                                "example_id": "89b65d1e-abcc-4607-983f-14730ef47af3",
                                                "sense_id": "4605eb70-7496-3f4c-9813-134beaf137e1",
                                                "text": "My dear, dear goblette, there is really nothing to it."
                                            },
                                            {
                                                "example_id": "adb49819-0bdb-4789-9009-a6b8cb016273",
                                                "sense_id": "4605eb70-7496-3f4c-9813-134beaf137e1",
                                                "text": "I decided a \"Goblette\" was a shortstacked android goblin girl."
                                            }
                                        ]
                                    }
                                ]
