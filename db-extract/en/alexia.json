                                        "examples": [
                                            {
                                                "example_id": "c682ae23-0ee0-4ea8-99ca-bac74bc35fed",
                                                "sense_id": "bd5cc0d5-7522-3a97-9d93-6844033c7a70",
                                                "text": "On le sait déjà, l’alexie qui fait suite aux lésions du corps calleux est une variante étrange et instructive d’alexie pure elle met en valeur la circulation de l’information entre les hémisphères pendant la lecture."
                                            },
                                            {
                                                "example_id": "5dbc6c23-57d4-45b0-8512-5c61ff9fca6c",
                                                "sense_id": "bd5cc0d5-7522-3a97-9d93-6844033c7a70",
                                                "text": "Et cela se voit tout aussi bien dans la situation où se trouvent placés les adversaires ou les critiques non réactionnaires du russo-communisme, qui tendent à être réduits à l’aphasie ou à l’alexie."
                                            }
                                        ]
                                    }
