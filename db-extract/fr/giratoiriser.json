                "senses": [
                    {
                        "sense_id": "97959a3d-ab42-31a5-8f45-98488f002070",
                        "entry_id": "eed0657d-8962-30e4-aa70-3b72929feb33",
                        "glosses": [
                            "Donner un caractère giratoire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25244dce-1d11-46c8-9d7c-063e7a33ddb9",
                                "sense_id": "97959a3d-ab42-31a5-8f45-98488f002070",
                                "text": "Donc giratoiriser les deux feux de Mignaloux, c'est ce qui pourrait se faire en attendant mieux."
                            },
                            {
                                "example_id": "9ccdeb52-2712-47ba-ba1b-22149da8828c",
                                "sense_id": "97959a3d-ab42-31a5-8f45-98488f002070",
                                "text": "les carrefours à niveau seront moins fréquentés, du fait du report sur l'autoroute. D'ou une insertion moins dangereuse qui limite l'intérieur de giratoiriser le moindre croisement à niveau..."
                            },
                            {
                                "example_id": "f063373c-d1ed-472b-9ff5-50a0e2b4319a",
                                "sense_id": "97959a3d-ab42-31a5-8f45-98488f002070",
                                "text": "Le revers du tablier, aussi propre, organisé, giratoirisé et professionnalisé que l’autre est un peu Sali, un peu négligé, un peu bazardisé et professionnalisé."
                            }
                        ]
                    }
