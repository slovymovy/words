                "senses": [
                    {
                        "sense_id": "557cd626-bfdc-3bf8-a65b-abdb70e15a6e",
                        "entry_id": "8cbdc048-c971-342a-94d5-49dea3e7f895",
                        "glosses": [
                            "Bau eines Fuchses; die Höhle eines Fuchses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fd6acb-a19f-48bc-8c0f-8ad13859d293",
                                "sense_id": "557cd626-bfdc-3bf8-a65b-abdb70e15a6e",
                                "text": "„Laut Gert trainierte sie die Dackel in künstlich angelegten Dachs- und Fuchsbauen, damit sie besser Witterung aufnehmen lernten.“"
                            },
                            {
                                "example_id": "604d7627-cf25-486e-ac0e-b2edef27bce2",
                                "sense_id": "557cd626-bfdc-3bf8-a65b-abdb70e15a6e",
                                "text": "„Bevorzugt leben sie in Wäldern und auf Wiesen, übernehmen den einen oder anderen Fuchsbau als Nachmieter.“"
                            },
                            {
                                "example_id": "bd9cdac3-4954-478a-931c-a0d28edff23a",
                                "sense_id": "557cd626-bfdc-3bf8-a65b-abdb70e15a6e",
                                "text": "Der Fuchsbau befindet sich an der südlichen Waldkante, 200 m östlich der Wegegabelung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b16834b2-30be-3f8e-a6b4-fc931dc3bab8",
                        "entry_id": "8cbdc048-c971-342a-94d5-49dea3e7f895",
                        "glosses": [
                            "Bezeichnung oder Namensbestandteil verschiedener Bunker und unterirdischer Anlagen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bb3e7c5c-78fe-4953-ac92-e2dcee7dd803",
                                "sense_id": "b16834b2-30be-3f8e-a6b4-fc931dc3bab8",
                                "text": "Der Fuchsbau befindet sich an der südlichen Waldkante, 200 m östlich der Wegegabelung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
