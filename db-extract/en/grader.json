                        "source_entry_id": "84306182-1b31-33ca-bf97-2bf798f266e9",
                        "source_sense_description": "machine",
                        "target_lang_word": "niveleuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niveleuse",
