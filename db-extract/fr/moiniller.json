                "senses": [
                    {
                        "sense_id": "f5310717-9430-32ef-b78a-6337a74c9de9",
                        "entry_id": "83840ef0-4779-3861-a543-6f343d750fd5",
                        "glosses": [
                            "(Moyen français) Mener une vie de moinillon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7df80a22-b86d-3c25-ad38-54b9436a5d3e",
                        "entry_id": "83840ef0-4779-3861-a543-6f343d750fd5",
                        "glosses": [
                            "Moine moinillant : moine de peu de considération, dont toute la dévotion est de s’attacher aux dehors de la règle sans rien sacrifier de ses aises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547f2cf5-ecf1-42df-a99b-81de8d65adc2",
                                "sense_id": "7df80a22-b86d-3c25-ad38-54b9436a5d3e",
                                "text": "Tu m'interromps ! merci ! Car j'allais oublier\nCes hommes noirs qui font commerce de prier ;\nVrais moines moinillant, de l’espèce qui pue\nEt soulève le cœur quand sous l’ongle on la tue."
                            },
                            {
                                "example_id": "11f1f84e-574e-4a04-9867-fad30885efac",
                                "sense_id": "7df80a22-b86d-3c25-ad38-54b9436a5d3e",
                                "text": "S’il y a dans les rues beaucoup de soldats, de prêtres, de moines moinillant, de béguines béguinant, on n’aperçoit presque jamais de gendarmes."
                            }
                        ]
                    }
                ],
