                "senses": [
                    {
                        "sense_id": "dc03f442-06bf-34c1-8348-5023ab6453f5",
                        "entry_id": "06c7577e-6f6f-3cce-8195-4724b0c7fccc",
                        "glosses": [
                            "markantes, charakteristisches Merkmal, eigenes Zeichen oder die Gesamtheit charakteristischer Merkmale, Zeichen zur eindeutigen Identifizierung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbd103d-43bd-436c-b104-8fa5863ab84b",
                                "sense_id": "dc03f442-06bf-34c1-8348-5023ab6453f5",
                                "text": "„Reifen mit N- Kennung (N0, N1, N2, N3, N4) sind Reifen mit Freigaben für Porsche- Fahrzeuge.“"
                            },
                            {
                                "example_id": "5626b5a7-824f-4bf9-abea-fcd39ef48aa0",
                                "sense_id": "dc03f442-06bf-34c1-8348-5023ab6453f5",
                                "text": "„So lautet die Kennung eines deutschen Firefox 3.0.10 auf einem XP-Rechner etwa \"Mozilla/5.0 (Windows; U; Windows NT 5.1; de; rv:1.9.0.10) Gecko/2009042316 Firefox/3.0.10\", für den Internet Explorer 7 kann sie so aussehen: \"Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 5.1)\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f2388fe-70ea-3991-9eb9-4076b9f62e49",
                        "entry_id": "06c7577e-6f6f-3cce-8195-4724b0c7fccc",
                        "glosses": [
                            "akustisches, elektronisches Signal, an dem eine Funkstation zu erkennen oder zu identifizieren ist"
                        ],
                        "tags": [
                            "Funkwesen"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0d1d5697-02ce-39d3-b7e9-ace7cef938d0",
                        "entry_id": "06c7577e-6f6f-3cce-8195-4724b0c7fccc",
                        "glosses": [
                            "Landmarke"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "cf6bfb36-9f80-4130-8334-d5c4f5ab16fe",
                                "sense_id": "0d1d5697-02ce-39d3-b7e9-ace7cef938d0",
                                "text": "„Unter der Kennung eines Leuchtfeuers versteht man den typischen Verlauf von Lichterscheinung und Verdunklung des Lichtes.“"
                            },
                            {
                                "example_id": "7691ebf6-d9dc-4b80-8e57-a8c36baeea15",
                                "sense_id": "0d1d5697-02ce-39d3-b7e9-ace7cef938d0",
                                "text": "„Um eine zuverlässige Identifikation zu ermöglichen, bekamen die Leuchtfeuer eine eindeutige Kennungen zugewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ba4f8ec2-872f-3cfd-b23f-ce0279660e86",
                        "entry_id": "06c7577e-6f6f-3cce-8195-4724b0c7fccc",
