                "senses": [
                    {
                        "sense_id": "ac670c76-a1a5-3ec1-bc7a-8c6b460d2101",
                        "entry_id": "4f6974f5-bb29-338d-90b0-dadc52f8e451",
                        "glosses": [
                            "regering van slechts weinig personen die behoren tot de bevoorrechte klasse; een verbasterde vorm van de aristocratie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9134c154-6022-4a7c-9cd0-6a34d01cc986",
                        "source_entry_id": "4f6974f5-bb29-338d-90b0-dadc52f8e451",
                        "source_sense_id": "ac670c76-a1a5-3ec1-bc7a-8c6b460d2101",
                        "target_lang_word": "Oligarchie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oligarchie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                        "entry_id": "c300bd67-51cb-3f8f-a220-78f3051dbc8b",
                                        "glosses": [
                                            "Herrschaft einer kleinen, bestimmten Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4e99e1-d4b4-4c01-92e2-3dc11d9b7b57",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "Das alte Rom war eine Oligarchie."
                                            },
                                            {
                                                "example_id": "c88c85eb-3b4e-4a1d-ba07-1b1f14ddd2da",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            },
                                            {
                                                "example_id": "b67b01eb-f5e0-4368-a1c9-936476825c1f",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "„In Nürnberg war die Oligarchie ebenso schmal und ebenso abgeschlossen wie in Augsburg, anders als etwa in der Hansestadt Lübeck, wo die Fluktuation der Eliten verhinderte, dass sich eine geburtsständische Exklusivität der politischen Macht herausbildete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cff7c842-c162-49f7-9332-8e148125e4df",
                        "source_entry_id": "4f6974f5-bb29-338d-90b0-dadc52f8e451",
                        "source_sense_id": "ac670c76-a1a5-3ec1-bc7a-8c6b460d2101",
                        "target_lang_word": "oligarchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A government run by and for only a few, often the aristocracy, the wealthy, or their friends and associates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0264089d-8515-4654-b4e1-d1068e03eb63",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "Despite the involvement of all classes of society, America's political duopoly and the importance of money to mass-market campaigning has established an oligarchy that is seldom responsive to the citizenry as a whole, when opposed to the wealthy or major interest groups."
                                            },
                                            {
                                                "example_id": "ca3d50df-5afc-4b6d-b792-ad8b1b6c44c9",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "It's an oligarchy because these families own and run almost everything that makes money in El Salvador. Coffee gave birth to the oligarchy in the late 19th century, and economic growth has revolved around them ever since."
                                            },
                                            {
                                                "example_id": "8f63c0c0-c64e-439a-9cbc-63cfffd1371f",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "The Itasca Project is just one example of existing oligarchy, and a surprisingly open one at that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A state ruled by such a government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40742ca1-100f-4afa-8b4f-ec7b1aa657d6",
                                                "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                                "text": "The 1832 Reform Act aimed to transform the British oligarchy and allow Parliament to represent the interests of a broader range of the population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "Those who make up an oligarchic government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54eea853-dab3-421a-ba1f-fe61c32293af",
                                                "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                                "text": "The modern British oligarchy—particularly during periods of Tory rule—has been called a chumocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ad85508-4df9-4dc2-9ee6-9985c6e28177",
                        "source_entry_id": "4f6974f5-bb29-338d-90b0-dadc52f8e451",
                        "source_sense_id": "ac670c76-a1a5-3ec1-bc7a-8c6b460d2101",
                        "target_lang_word": "oligarchie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarchie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc398847-bdf9-3cff-94ec-e8d619c994e2",
                                        "entry_id": "6bfff255-1786-3069-a26a-ad532e04ea70",
                                        "glosses": [
                                            "Gouvernement politique où l’autorité souveraine est entre les mains d’un petit nombre de personnes ou d’une puissante famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2492e173-59e7-49ee-8d1d-42497d65de81",
                                                "sense_id": "cc398847-bdf9-3cff-94ec-e8d619c994e2",
                                                "text": "Si nous voulons répondre aux défis du XXIᵉ siècle, il faut revenir en démocratie : cela suppose de reconnaître l’oligarchie pour ce qu’elle est, un régime qui vise à maintenir les privilèges des riches au mépris des urgences sociales et écologiques."
                                            },
                                            {
                                                "example_id": "6dfbd244-243c-4aa1-8420-1c6da185c2f4",
                                                "sense_id": "cc398847-bdf9-3cff-94ec-e8d619c994e2",
                                                "text": "À vrai dire, la République romaine n’était qu’une oligarchie despotique et pillarde dont les chefs s’enrichissaient en dépouillant le monde par les guerres et les rapines."
                                            },
                                            {
                                                "example_id": "33a1bc84-c3e7-4024-b33c-732152e8ae35",
                                                "sense_id": "cc398847-bdf9-3cff-94ec-e8d619c994e2",
                                                "text": "Déchirée par des factions qui se disputent un pouvoir éphémère, opprimée par des oligarchies ruineuses, […], elle s’affaisse lentement sous le poids de son inertie […]."
                                            },
                                            {
                                                "example_id": "2c993255-d200-4484-915e-e61ac5018182",
                                                "sense_id": "cc398847-bdf9-3cff-94ec-e8d619c994e2",
                                                "text": "L’inflexion actuelle des populations noires gagnées à l’islamisme, les pousse à renverser leurs monarchies absolues et guerrières, pour y substituer des gouvernemens théocratiques sous forme d’oligarchies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4bb1f33-20d0-3a66-8ef0-3f6f346b788f",
                                        "entry_id": "6bfff255-1786-3069-a26a-ad532e04ea70",
                                        "glosses": [
                                            "Groupe restreint de personnes qui a accaparé le pouvoir à son profit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3c0561-bee7-4a3b-bf7a-ce9f6c3fc4bf",
                                                "sense_id": "a4bb1f33-20d0-3a66-8ef0-3f6f346b788f",
                                                "text": "La raison d’État n’est le plus souvent qu’un manteau commode pour couvrir l’ignorance, la bêtise ou la scélératesse d’une oligarchie…"
                                            },
                                            {
                                                "example_id": "e093525b-a1dd-4aa3-923c-6debb8f82a33",
                                                "sense_id": "a4bb1f33-20d0-3a66-8ef0-3f6f346b788f",
                                                "text": "La démocratie avait depuis longtemps laissé place dans les nations occidentales à une oligarchie, trop heureuse d’exercer l’essentiel du pouvoir économique sous le paravent des « volontés populaires » dont l’expression se limitait à des élections sporadiques aux résultats de moins en moins influents sur l’évolution économique et sociale."
                                            },
                                            {
                                                "example_id": "ecb540e0-f9ef-4b72-aaf3-fc9b76d4aeb5",
                                                "sense_id": "a4bb1f33-20d0-3a66-8ef0-3f6f346b788f",
                                                "text": "Antitotalitaire, antiraciste, attentif au sort des minorités, il prônait une révolution continentale contre les nationalismes et les oligarchies économiques pour aboutir à la construction, une fois le IIIe Reich vaincu, d’une Europe unifiée et démocratique dotée de sa propre armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44c354d-b272-3510-8598-9eb1e4d19b5c",
                                        "entry_id": "6bfff255-1786-3069-a26a-ad532e04ea70",
                                        "glosses": [
                                            "Groupe restreint de personnes qui se partagent les richesses d’un territoire donné."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d68447e1-7d5d-4f8c-9579-bd9d441c15db",
                                                "sense_id": "d44c354d-b272-3510-8598-9eb1e4d19b5c",
                                                "text": "L’oligarchie britannique rêva un jour la domination des mers, […]. L’oligarchie anglaise perdit le sens commun. Elle saisit, inventa, provoqua toutes les occasions de faire la guerre aux puissances maritimes, à l'Espagne, au Portugal, à la France, à la Hollande."
                                            },
                                            {
                                                "example_id": "1f840e57-f963-476a-b11f-240096a2411c",
                                                "sense_id": "d44c354d-b272-3510-8598-9eb1e4d19b5c",
                                                "text": "Le pays de Vaud, de tout temps français par ses habitudes, ses mœurs, son caractère, son commerce, ses besoins, son langage, conspirait, à la faveur du voisinage de la révolution, pour s’affranchir de l’oligarchie bernoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
