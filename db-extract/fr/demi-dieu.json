                        ]
                    },
                    {
                        "translation_id": "8fa735b8-e373-4283-b6df-725a931c34c6",
                        "source_entry_id": "d9069a0c-7f1e-35a5-9d84-34efb4f55998",
                        "target_lang_word": "halfgod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halfgod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                        "entry_id": "c34652dc-a378-3bc5-9a93-a63bdbee29da",
                                        "glosses": [
                                            "A demigod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f64535-b4bd-4772-8cb8-4a588aea5a1e",
                                                "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                                "text": "Yes, I. Her. Who are you and what? Half. Halfgod, the demigod. Her. Not a man? Half. No I'm immortal; for the first Halfgod Was born of Ceres and Triptolemus, His only son was Celeus, Celeus married Phamarete my grandmother; [...]"
                                            },
                                            {
                                                "example_id": "30643158-33ce-43a5-81e8-700cab1cd673",
                                                "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                                "text": "[...] the halfgod shouted. \"Make way for Her Divinity!\""
                                            },
                                            {
                                                "example_id": "949ff2d4-c496-411b-8ade-58fd8213698e",
                                                "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                                "text": "The halfgod followed, dark nose held high, as if offended by every reek around him. Four blue sacristans carried the canopied chair of honor, the divine tourist smiling out as if delighted with everything she saw. A dog barked. A child screamed."
                                            },
                                            {
                                                "example_id": "a851fa17-e729-4727-92bb-21cbde398077",
                                                "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                                "text": "This union results in the birth of Herakles (called Hercules by the Romans), the legendary yet tragic halfgod hero of classical mythology."
                                            },
                                            {
                                                "example_id": "a6fb1b6c-ead5-4511-8d68-23b91ce74c50",
                                                "sense_id": "97208d09-fae6-3405-8853-ba8c5f8b3ad0",
                                                "text": "What have we done to you? Jews have had to ask this question for 2000 years or better. Why do you hate us so? Actually, Jews know. They failed to find any evidence that Jesus was a HalfGod. And they lived next door to Jesus at the time!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
