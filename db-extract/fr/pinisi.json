                        "form": "pinisis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59f6565e-b0af-3180-861d-a8bd01069d6f",
                        "entry_id": "87673cba-a759-3004-801a-c6031a103083",
                        "glosses": [
                            "Type de gréement à deux mâts et sept voiles, apparu vers 1900 sur la côte sud de Célèbes sur les bateaux en bois traditionnels appelés palaris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f7c571-0745-434c-8d5c-497e9f2b8f08",
                                "sense_id": "59f6565e-b0af-3180-861d-a8bd01069d6f",
                                "text": "Le pinisi, l’art de la construction navale en Sulawesi du sud, désigne le gréement et les voiles de la célèbre « goélette de Sulawesi »."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa8ca74b-bb9f-37af-ac70-e9a1e1a8f421",
                        "entry_id": "87673cba-a759-3004-801a-c6031a103083",
                        "glosses": [
                            "Bateau traditionnel indonésien portant ce type de gréement."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "994dad77-7bd1-4ad6-a552-ddda1e3c29f7",
                                "sense_id": "aa8ca74b-bb9f-37af-ac70-e9a1e1a8f421",
                                "text": "L’exemple type est celui du Pinisi, qui qualifie maintenant un type de bateaux, alors que le mot signifiait il y a cinquante ans un type de gréement."
                            },
                            {
                                "example_id": "1e874112-ee93-4319-bd59-c3baafa1bfce",
                                "sense_id": "aa8ca74b-bb9f-37af-ac70-e9a1e1a8f421",
                                "text": "Le symbole de leur ubiquité est la silhouette des grands voiliers pinisi, que l’on retrouve par dizaines, et naguère par centaines, dans tous les grands ports : à Jakarta comme à Surabaya, à Banjarmasin comme à Palembang."
                            },
                            {
                                "example_id": "35f62252-4fa5-4738-8bb3-eec50a00c10a",
                                "sense_id": "aa8ca74b-bb9f-37af-ac70-e9a1e1a8f421",
                                "text": "Avec sa silhouette de bateau pirate, ce pinisi (voilier traditionnel indonésien) de 46 m de long sillonne les mers des archipels de Komodo, des Célèbes, des Moluques et Raja Ampat."
                            }
                        ]
                    }
                ],
