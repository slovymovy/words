                "senses": [
                    {
                        "sense_id": "31d92dd8-3f04-3209-b66b-7d94490bc089",
                        "entry_id": "c4bd2313-3efe-37b3-8e91-c11ab9d62b8d",
                        "glosses": [
                            "Minéral composé de sulfate de cuivre hydraté de formule CuSO₄+_(5 H)2_O."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319b9039-5283-41f0-b5c8-0afad97f95e2",
                                "sense_id": "31d92dd8-3f04-3209-b66b-7d94490bc089",
                                "text": "Rappelons que la chalcantite qu’on retrouve dans l’Aude est une espèce minérale composée de sulfate de cuivre hydraté pouvant contenir des traces de fer, de magnésium et de cobalt ; cette pierre extraordinaire est de couleur bleu intense parfois nuancé de vert, c’est un minéral secondaire d’altération des sulfures de cuivre."
                            }
                        ]
                    }
                ],
                "translations": [
