                    "frequency": "Middle",
                    "semantic_group_id": "propreté physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants apprennent à manger <w>proprement</w> avec leurs couverts à table.",
                            "target_lang_translations": {
