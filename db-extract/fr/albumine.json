                                "target_senses": [
                                    {
                                        "sense_id": "f6d4474f-6774-3a37-97e2-efae07b8c870",
                                        "entry_id": "13962240-abb4-3880-9cb6-ddb47bfbea21",
                                        "glosses": [
                                            "einfaches Protein (Eiweiß), das hauptsächlich im Blutplasma, in der Milch und in Eiern vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121ca74f-b557-4d36-8445-92c687a93303",
                                                "sense_id": "f6d4474f-6774-3a37-97e2-efae07b8c870",
                                                "text": "„Albumin stellt ein wichtiges Transporteiweiß für verschiedenste Stoffe dar. So werden unter anderem viele Medikamente, aber auch freie Fettsäuren, Bilirubin und Hormone an Albumin gebunden mit dem Blut durch den Körper transportiert[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce1203a3-2e7d-44fe-8cd3-4a58d320b108",
                        "source_entry_id": "3d02326a-dfbb-39ef-92c8-d6245ee3cc33",
