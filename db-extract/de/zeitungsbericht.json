                ],
                "senses": [
                    {
                        "sense_id": "97577485-3a14-38b9-bf4a-1e221f9cca2c",
                        "entry_id": "fcab3382-9080-3ae0-9448-7341c581d91b",
                        "glosses": [
                            "Text in einer Zeitung, der ausführliche Informationen zu einem relevanten Thema enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa376d0f-9f54-47a3-b6a7-af1198cb6f0f",
                                "sense_id": "97577485-3a14-38b9-bf4a-1e221f9cca2c",
                                "text": "„Vermutlich wäre es nicht so gekommen, hätte es nicht die vielen Zeitungsberichte gegeben, die Empörung im ganzen Land über den Tod des jungen Mannes und die Unterstützung der anderen Rechtswissenschaftler.“"
                            },
                            {
                                "example_id": "056a1553-6ba3-4322-b6e5-1f1dd8e07de6",
                                "sense_id": "97577485-3a14-38b9-bf4a-1e221f9cca2c",
                                "text": "„Während ich in alten Zeitungsberichten nach Spuren suchte, um die Situation der Kinder besser erfassen zu können, stieß ich auf einen interessanten Hinweis.“"
                            },
                            {
                                "example_id": "fa2d962d-10f4-442d-9efb-286fd4ff79c6",
                                "sense_id": "97577485-3a14-38b9-bf4a-1e221f9cca2c",
                                "text": "„Meine Sammlung ausgeschnittener Zeitungsberichte, hier auf der ›Exitus‹, wandert von Hand zu Hand.“"
                            },
                            {
                                "example_id": "59fc9a60-ef73-43a8-a400-51e52df8567a",
                                "sense_id": "97577485-3a14-38b9-bf4a-1e221f9cca2c",
                                "text": "„Es ist bekannt und in Zeitungsberichten oft behandelt worden, dass sich im Netz eine große Anzahl von Witz-Datenbanken breit gemacht hat, in denen man nach Sparten geordnet jedes erdenkliche Witzthema abrufen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
