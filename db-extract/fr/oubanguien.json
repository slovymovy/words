                        "glosses": [
                            "Relatif à l’Oubangui et à son bassin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48307377-6dfc-48b6-ab39-83b518eeee02",
                                "sense_id": "780bde77-2b1a-3154-be02-b5d74755fafd",
                                "text": "Les eaux du bassin oubanguien sont drainées vers le sud en direction de la mer, ce qui explique la séparation nette du pays par la dorsale oubanguienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "35fdbbd7-6ce6-30ee-beba-433e929f729c",
                        "entry_id": "fac26e17-6e04-3c0b-9b47-344397bad2f8",
                        "glosses": [
                            "Relatif à la sous-branche des langues adamawa-oubanguiennes, de la famille des langues nigéro-congolaises, parlée dans la région de l’Oubangui en Afrique centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc334f9-27e0-46ae-a1e4-57ea01eb2b42",
                                "sense_id": "35fdbbd7-6ce6-30ee-beba-433e929f729c",
                                "text": "Ces derniers, à la différence de leurs voisins orientaux, les Aka, de langue bantu, sont de langue oubanguienne."
                            }
                        ]
