                "forms": [],
                "senses": [
                    {
                        "sense_id": "5cdeafa6-33c5-301e-a5e4-719ce8b41522",
                        "entry_id": "01a479be-dbc5-3f08-b984-6f9e6448124c",
                        "glosses": [
                            "in der Umgebung, im Umkreis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b02c57-bed2-4643-85fc-06cbf0f5d2cf",
                                "sense_id": "5cdeafa6-33c5-301e-a5e4-719ce8b41522",
                                "text": "Überall umher liefen streunende Hunde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c59e9d2e-090a-4ed1-96fc-6db48a9c89f3",
                        "source_entry_id": "01a479be-dbc5-3f08-b984-6f9e6448124c",
                        "source_sense_id": "5cdeafa6-33c5-301e-a5e4-719ce8b41522",
                        "source_sense_description": "in der Umgebung, im Umkreis",
                        "target_lang_word": "around",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "Forming a circle or closed curve containing (something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45511ddc-d8f6-46cc-8255-4c6ed12b72e6",
                                                "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                                                "text": "She wore a gold chain around her neck."
                                            },
                                            {
                                                "example_id": "1af35535-90cc-474d-b02f-440adf7eeb50",
                                                "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                                                "text": "I planted a row of lilies around the statue."
                                            },
                                            {
                                                "example_id": "7e460854-adfe-441f-9c95-eb93ec6d6c68",
                                                "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                                                "text": "The jackals began to gather around the carcass."
                                            },
                                            {
                                                "example_id": "81034708-386c-46a7-9fd1-3ae7aae84c15",
                                                "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0fcb6f2-4a1e-34a5-8efe-e2099622765c",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "Centred upon; surrounding; regarding."
                                        ],
                                        "tags": [
                                            "of abstract things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "367efa69-4ee7-47f4-9ac2-f82bb5d053ae",
                                                "sense_id": "d0fcb6f2-4a1e-34a5-8efe-e2099622765c",
                                                "text": "We could use some clarification around the new rules."
                                            },
                                            {
                                                "example_id": "7c3205d5-adb8-4a3c-9969-cc0cd2cf2a37",
                                                "sense_id": "d0fcb6f2-4a1e-34a5-8efe-e2099622765c",
                                                "text": "There has been a lot of controversy around the handling of personal information."
                                            },
                                            {
                                                "example_id": "f536628c-ec8c-4619-8624-fec6bc94a143",
                                                "sense_id": "d0fcb6f2-4a1e-34a5-8efe-e2099622765c",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0efb69f8-c1d7-3010-9b61-61bbcdb7678f",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "Following the perimeter of a specified area and returning to the starting point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339cf923-3b50-41ac-b23e-7a928a57b510",
                                                "sense_id": "0efb69f8-c1d7-3010-9b61-61bbcdb7678f",
                                                "text": "We walked around the football field."
                                            },
                                            {
                                                "example_id": "44e7dd2d-9fd9-49be-97fe-490f1c233033",
                                                "sense_id": "0efb69f8-c1d7-3010-9b61-61bbcdb7678f",
                                                "text": "She went around the track fifty times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554ecb14-1686-3470-ac60-68dd143ee6b9",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "Following a path which curves near an object, with the object on the inside of the curve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90ac0a2-33ed-4bc6-9229-1c0300cf716a",
                                                "sense_id": "554ecb14-1686-3470-ac60-68dd143ee6b9",
                                                "text": "The road took a brief detour around the large rock formation, then went straight on."
                                            },
                                            {
                                                "example_id": "abcc5b4a-a080-4693-a73c-14e38771ae8a",
                                                "sense_id": "554ecb14-1686-3470-ac60-68dd143ee6b9",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "4ed5a6b1-75c9-4998-be34-ea4e6ec55b22",
                                                "sense_id": "554ecb14-1686-3470-ac60-68dd143ee6b9",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35a8fa08-e905-3c52-ade3-56e09168365b",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "Near; in the vicinity of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad37feb9-0cb6-41a7-836a-fa755dfd1788",
                                                "sense_id": "35a8fa08-e905-3c52-ade3-56e09168365b",
                                                "text": "I left my keys somewhere around here."
                                            },
                                            {
                                                "example_id": "2cc5e7fc-8dc2-4e6a-a6e6-1a9af28a777e",
                                                "sense_id": "35a8fa08-e905-3c52-ade3-56e09168365b",
                                                "text": "I left the house around 10 this morning."
                                            },
                                            {
                                                "example_id": "7c495c6f-5723-497f-9615-604605e3993f",
                                                "sense_id": "35a8fa08-e905-3c52-ade3-56e09168365b",
                                                "text": "I don't want you around me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                        "entry_id": "675270ec-bf8b-3796-a91b-a02f9213272c",
                                        "glosses": [
                                            "At or to various places within or throughout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a535a1-e06c-4bb2-b5fa-ec5b78e0a3e6",
                                                "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                                "text": "The pages from the notebook were scattered around the room."
                                            },
                                            {
                                                "example_id": "b0598313-846c-439d-aff8-f059b362a12b",
                                                "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                                "text": "Those teenagers like to hang around the mall."
                                            },
                                            {
                                                "example_id": "3ad1b1b2-5625-486f-8e20-fb94065d4d64",
                                                "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                                "text": "She went around the office and got everyone to sign the card."
                                            },
                                            {
                                                "example_id": "3fad7a94-bbf2-461e-b668-6736a2e1d7a3",
                                                "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                                "text": "The estate agent showed me around the property."
                                            },
                                            {
                                                "example_id": "6e43b5c4-3728-4d3d-814d-4d7de56da8ef",
                                                "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                                                "text": "Men that I knew around Wapatomac didn't wear high, shiny plug hats, nor yeller spring overcoats, nor carry canes with ivory heads as big as a catboat's anchor, as you might say."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd8acda-20b2-3f28-9f06-64c91e13b1bd",
                                        "entry_id": "be73b73f-bf0e-300e-b02b-62171eadc042",
                                        "glosses": [
                                            "Present in the vicinity."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2008076e-a468-4eff-9ea2-ba95f9713fdc",
                                                "sense_id": "cdd8acda-20b2-3f28-9f06-64c91e13b1bd",
                                                "text": "Is Clare around today?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "718c399b-7ae3-3397-9920-209700d32adb",
                                        "entry_id": "be73b73f-bf0e-300e-b02b-62171eadc042",
                                        "glosses": [
                                            "Alive; existing."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370531b0-356b-4e8c-85c0-35bc54ba5d48",
                                                "sense_id": "718c399b-7ae3-3397-9920-209700d32adb",
                                                "text": "The record store on Main Street? Yes, it's still around."
                                            },
                                            {
                                                "example_id": "5c0032a1-5d0a-426a-a758-3543744750c9",
                                                "sense_id": "718c399b-7ae3-3397-9920-209700d32adb",
                                                "text": "\"How is old Bob? I heard that his health is failing.\" \"Oh, he's still around. He's feeling better now.\""
                                            },
                                            {
                                                "example_id": "6ed94ab3-1808-4923-b226-b9b2da52b9ce",
                                                "sense_id": "718c399b-7ae3-3397-9920-209700d32adb",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf9fd68-694c-34d3-a5ef-ee588851424a",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "So as to form a circle or trace a circular path, or approximation thereof."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f50124-5a0e-4623-a049-3ad6f6bb5093",
                                                "sense_id": "cdf9fd68-694c-34d3-a5ef-ee588851424a",
                                                "text": "High above, vultures circled around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea01940-db80-384a-afdc-4fd41e1e6b6e",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "So as to surround or be near."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18456d64-0087-4f73-bab9-38129d4aeac2",
                                                "sense_id": "1ea01940-db80-384a-afdc-4fd41e1e6b6e",
                                                "text": "Everybody please gather around."
                                            },
                                            {
                                                "example_id": "5b94d0f5-6ef8-46cc-a587-f77115a0daa1",
                                                "sense_id": "1ea01940-db80-384a-afdc-4fd41e1e6b6e",
                                                "text": "There isn't another house for miles around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a7daa09-db3e-3d0b-87f2-f5e87991d3f2",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "Nearly; approximately; about."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9208d9a9-553f-40a0-b4fc-c39822548a5b",
                                                "sense_id": "3a7daa09-db3e-3d0b-87f2-f5e87991d3f2",
                                                "text": "Around a thousand people attended."
                                            },
                                            {
                                                "example_id": "e1cd9fc4-1748-4bd2-95f5-35db0185070f",
                                                "sense_id": "3a7daa09-db3e-3d0b-87f2-f5e87991d3f2",
                                                "text": "An adult elephant weighs around five tons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "From place to place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5266733-90a7-48fd-a4e9-5051df8a190d",
                                                "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                                "text": "There are rumors going around that the company is bankrupt."
                                            },
                                            {
                                                "example_id": "db37dc3d-766b-4acd-bcde-e4e47f9929c0",
                                                "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                                "text": "Look around and see what you find."
                                            },
                                            {
                                                "example_id": "15d5bf2e-789e-4439-adaf-008dcd0c1ef2",
                                                "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                                "text": "We moved the furniture around in the living room."
                                            },
                                            {
                                                "example_id": "a110e2fe-4f86-45c4-8cd8-6b3fb181f06d",
                                                "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady.[…]She looked around expectantly, and recognizing Mrs. Cooke's maid[…]Miss Thorn greeted her with a smile which greatly prepossessed us in her favor."
                                            },
                                            {
                                                "example_id": "1814f122-01ee-4d97-9fd1-f2071d0f5756",
                                                "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                                                "text": "Of all the transitions brought about on the Earth’s surface by temperature change, the melting of ice into water is the starkest. It is binary. And for the land beneath, the air above and the life around, it changes everything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "From one state or condition to an opposite or very different one; with a metaphorical change in direction; bringing about awareness or agreement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff9f36a3-3ab7-43e1-8cbc-3b085b6b0c8b",
                                                "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                                                "text": "The team wasn't doing well, but the new coach really turned things around."
                                            },
                                            {
                                                "example_id": "c4c4400a-63b7-4db8-ada1-3f7822d1938b",
                                                "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                                                "text": "He used to stay up late but his new girlfriend changed that around."
                                            },
                                            {
                                                "example_id": "dd12b7c2-55a4-4124-8536-779a3a4ef12f",
                                                "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                                                "text": "The patient was unconscious but the doctor brought him around quickly."
                                            },
                                            {
                                                "example_id": "5c10421d-fb19-4777-883a-a49ce146a611",
                                                "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                                                "text": "I didn't think he would ever like the new design, but eventually we brought him around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a5b4176-999e-3676-b72d-c568bf51ee36",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "So as to partially or completely rotate; so as to face in the opposite direction."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08fe587d-f34c-47ef-8c68-a5dbd5d726b1",
                                                "sense_id": "8a5b4176-999e-3676-b72d-c568bf51ee36",
                                                "text": "Turn around at the end of this street."
                                            },
                                            {
                                                "example_id": "b033aa44-3669-4b8b-9123-da8bb158ba66",
                                                "sense_id": "8a5b4176-999e-3676-b72d-c568bf51ee36",
                                                "text": "She spun around a few times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b3c3c6-a344-3b4c-a22f-ffedf6e46541",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "Used with verbs to indicate repeated or continuous action, or in numerous locations or with numerous people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe07fb1-926b-4220-b3d1-65a73ef608ba",
                                                "sense_id": "e3b3c3c6-a344-3b4c-a22f-ffedf6e46541",
                                                "text": "I asked around, and no-one really liked it."
                                            },
                                            {
                                                "example_id": "041418ff-bb6a-4432-b3f0-e014ab279f3a",
                                                "sense_id": "e3b3c3c6-a344-3b4c-a22f-ffedf6e46541",
                                                "text": "Shopping around can get you a better deal."
                                            },
                                            {
                                                "example_id": "cffa2fd9-376a-4213-b5de-f254b636193a",
                                                "sense_id": "e3b3c3c6-a344-3b4c-a22f-ffedf6e46541",
                                                "text": "When are you going to stop whoring around, find a nice girl, and give us grandchildren?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31e79b0-cf99-3dae-8337-2f2633e98a7b",
                                        "entry_id": "5ca0fff7-e8ce-3b49-90b9-4551fe495737",
                                        "glosses": [
                                            "Used with certain verbs to suggest unproductive activity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
