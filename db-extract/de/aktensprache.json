                "senses": [
                    {
                        "sense_id": "f3472da8-7929-33e9-baeb-08c109ebf2fd",
                        "entry_id": "27e6e000-f1f0-3958-820c-5c833312f071",
                        "glosses": [
                            "betont neutrale und nüchterne Schriftsprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f106ed7f-15cf-4dc0-8e15-54c738ce6127",
                                "sense_id": "f3472da8-7929-33e9-baeb-08c109ebf2fd",
                                "text": "„Auf diese Weise kamen Texte zustande, deren Tonfall immer mehr demjenigen der Aktensprache glich.“"
                            },
                            {
                                "example_id": "c824b077-308b-40fc-b6dc-4675504aedf1",
                                "sense_id": "f3472da8-7929-33e9-baeb-08c109ebf2fd",
                                "text": "„Die Aktensprache, die diese 120 lehrreichen Minuten beherrscht, ist auf die Dauer schwer zu ertragen.“"
                            },
                            {
                                "example_id": "455581f1-5bca-4fa6-be07-2f0cc3c19aa9",
                                "sense_id": "f3472da8-7929-33e9-baeb-08c109ebf2fd",
                                "text": "„Das gemeinsame persönliche Gespräch hilft Zusammenhänge, Aktensprache und eigene Erinnerung zu verstehen.“"
                            },
                            {
                                "example_id": "aed86233-640d-4647-85fc-229c91782736",
                                "sense_id": "f3472da8-7929-33e9-baeb-08c109ebf2fd",
                                "text": "„Was passiert, wenn wir jetzt diese nüchterne Aktensprache, die teilweise nur aus Kürzeln besteht – wenn Sie die Originalpapiere lesen, sind die teilweise überhaupt nicht verständlich –, kontrastieren das mit sehr harten Schnitten mit Arien aus genau diesen Opern, und plötzlich entsteht ein Spannungsfeld und eine Reibung zwischen einem Wohlklang, zwischen einem schönen Gesang und einem absolut grausamen Inhalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
