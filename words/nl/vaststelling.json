                {
                    "sense_id": "91777e46-6cf9-3040-8260-f0025d89a1b6",
                    "sense_definition": "De handeling van het waarnemen of opmerken van een bepaald feit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een korte <w>vaststelling</w> van de feiten kon de politie de situatie snel oplossen.",
                            "target_lang_translations": {
                                "en": "After a brief <w>determination</w> of the facts, the police were able to resolve the situation quickly."
                            }
                        },
                        {
                            "text": "De arts deed een belangrijke <w>vaststelling</w> over de gezondheid van de patiënt.",
                            "target_lang_translations": {
                                "en": "The doctor made an important <w>finding</w> regarding the patient's health."
                            }
                        }
                    ],
                    "synonyms": [
                        "constatering",
                        "waarneming",
                        "bevinding"
                    ],
                    "common_phrases": [
                        "vaststelling van feiten"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of observing, noticing, or establishing a specific fact."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finding",
                                "target_lang_sense_clarification": "a conclusion reached after an investigation"
                            },
                            {
                                "target_lang_word": "observation",
                                "target_lang_sense_clarification": "the act of noticing or perceiving something"
                            },
                            {
                                "target_lang_word": "determination",
                                "target_lang_sense_clarification": "the process of establishing something exactly by calculation or investigation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97c27fe2-2cc6-354d-809e-5c21b0704539",
                    "sense_definition": "Het officieel bepalen of vastleggen van een besluit, regel of prijs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "besluitvorming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vaststelling</w> van de nieuwe begroting zal volgende week in de raad plaatsvinden.",
                            "target_lang_translations": {
                                "en": "The <w>adoption</w> of the new budget will take place in the council next week."
                            }
                        },
                        {
                            "text": "De jaarlijkse <w>vaststelling</w> van de prijzen zorgt vaak voor veel discussie.",
                            "target_lang_translations": {
                                "en": "The annual <w>fixing</w> of prices often causes a lot of discussion."
                            }
                        }
                    ],
                    "synonyms": [
                        "bepaling",
                        "besluit",
                        "vastlegging"
                    ],
                    "common_phrases": [
                        "vaststelling van de begroting",
                        "vaststelling van de prijs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in formele of bestuurlijke context"
                        }
                    ],
                    "target_lang_definitions": {
