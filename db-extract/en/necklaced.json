                            {
                                "example_id": "156c4f0f-222d-43c0-b5ee-a9950a61b904",
                                "sense_id": "626c4360-4ca4-3bbd-95ec-3ef059c3ebef",
                                "text": "To each she gave a goblet rich till by good hap at last / The necklaced queen with courtly grace before Beowulf trod, / Gave him the cup of mead and greeted him, with thanks to God / In seemly words that He had given her heart’s desire indeed / To find an earl whom she could trust to help them in their need."
                            },
                            {
                                "example_id": "5412d1a0-373e-4f92-8c96-d8331d8c0018",
                                "sense_id": "626c4360-4ca4-3bbd-95ec-3ef059c3ebef",
                                "text": "“Great chief—Powana. Him sleep! Bimeby wake,” grunted the necklaced gentleman, who seemed quite proud of his familiarity with the English tongue; […]"
                            },
                            {
                                "example_id": "7c44a575-60cc-4278-80da-f0c9516378e4",
                                "sense_id": "626c4360-4ca4-3bbd-95ec-3ef059c3ebef",
                                "text": "Exotic colognes, plush, dark nightclubs, maitais and daquiris, necklaced ladies in satin gowns, misty and sexy like in a tequila ad."
                            }
                        ]
                    }
