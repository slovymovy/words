                                        "sense_id": "24b2c4ae-cf95-3579-96ef-bab2f1df9619",
                                        "entry_id": "54600c1d-fbe6-30ec-9426-d8d5723e9dba",
                                        "glosses": [
                                            "nordostkaukasische Sprache, die Amtssprache in Tschetschenien ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f494275c-608f-419d-b78d-1ac820a1c252",
                                                "sense_id": "24b2c4ae-cf95-3579-96ef-bab2f1df9619",
                                                "text": "Wie heißt das auf Tschetschenisch?"
                                            },
                                            {
                                                "example_id": "ae5ee575-e5d6-45d4-842a-d4a7bd8fba94",
                                                "sense_id": "24b2c4ae-cf95-3579-96ef-bab2f1df9619",
                                                "text": "Das Tschetschenische ist eine lexikografische Herausforderung, da die Schaffung neuer Wörter eher in der Fixierung ganzer Ausdrücke als in der Kombination existierender Wörter liegt."
                                            },
                                            {
                                                "example_id": "a1c645f9-2147-403b-8749-208604b599d8",
                                                "sense_id": "24b2c4ae-cf95-3579-96ef-bab2f1df9619",
                                                "text": "„»Gleiches gilt für das Wainachische, das verschiedene Formen aufweist, von denen die wichtigsten das Tschetschenische und Inguschische sind«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
