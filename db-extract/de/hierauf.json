        "de-extract.jsonl": [
            {
                "entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                "word": "hierauf",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8338050-2a17-35f5-a99b-88c91568a50b",
                        "entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                        "glosses": [
                            "auf etwas hinweisend, das man jemandem zeigt oder zuvor erwähnt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c759ab-ee50-4573-bee1-6c2e7daddd5b",
                                "sense_id": "f8338050-2a17-35f5-a99b-88c91568a50b",
                                "text": "Hierauf kannst du deinen Arsch verwetten."
                            },
                            {
                                "example_id": "b690fcd5-a5ec-4e69-ba44-32836dea1828",
                                "sense_id": "f8338050-2a17-35f5-a99b-88c91568a50b",
                                "text": "Hierauf wollen wir anstoßen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "817210d5-0f82-387a-8855-44259aedb691",
                        "entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                        "glosses": [
                            "zeitlich nach dem vorher Gesagten oder Geschehenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73dd0009-aa1d-4405-b67e-4f54e80792fb",
                                "sense_id": "817210d5-0f82-387a-8855-44259aedb691",
                                "text": "Wir kennen das doch: erst gibt es eine Provokation, hierauf Feindseligkeiten hierauf Streit und schließlich dann die Versöhnung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dab41ffb-7457-3b4c-8f15-62e8a0fec376",
                        "entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                        "glosses": [
                            "räumlich auf etwas auf das man zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860b12c1-39a1-439b-b4c0-b0f63886e9a3",
                                "sense_id": "dab41ffb-7457-3b4c-8f15-62e8a0fec376",
                                "text": "Hierauf soll ich meine Unterschrift setzen?"
                            },
                            {
                                "example_id": "3451585c-1309-4f0f-86b5-5fa38c4ab589",
                                "sense_id": "dab41ffb-7457-3b4c-8f15-62e8a0fec376",
                                "text": "Hierauf soll man bequem schlafen können? Das glaube ich nicht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
