                {
                    "sense_id": "04d0a362-0dd4-3e2d-9b71-e24d845c8ad2",
                    "sense_definition": "Of or relating to the metric system of measurement, which uses meters, grams, and liters.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most countries in the world use the <w>metric</w> system for everyday measurements.",
                            "target_lang_translations": {
                                "ru": "Большинство стран мира используют <w>метрическую</w> систему для повседневных измерений.",
                                "zh": "世界上大多数国家在日常测量中使用<w>公制</w>系统。"
                            }
                        },
                        {
                            "text": "Please convert these imperial measurements into <w>metric</w> units before submitting the report.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, переведите эти имперские меры в <w>метрические</w> единицы перед сдачей отчета.",
                                "zh": "请在提交报告前将这些英制单位转换为<w>公制</w>单位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metric system",
                        "metric unit",
                        "metric ton",
                        "metric conversion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к метрической системе мер, использующей метры, граммы и литры.",
                        "zh": "指与使用米、克和升的公制测量系统有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метрический",
                                "target_lang_sense_clarification": "относящийся к системе мер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公制的",
                                "target_lang_sense_clarification": "指公制测量系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4657503-1c02-3599-9ce3-1044ac0e59ad",
                    "sense_definition": "Of or relating to the rhythmic structure (meter) of a piece of music or poetry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor analyzed the <w>metric</w> patterns found in ancient Greek poetry.",
                            "target_lang_translations": {
                                "ru": "Профессор проанализировал <w>метрические</w> схемы, найденные в древнегреческой поэзии.",
                                "zh": "教授分析了古希腊诗歌中的<w>格律</w>模式。"
                            }
                        },
                        {
                            "text": "Composers often experiment with complex <w>metric</w> structures to create tension in the music.",
                            "target_lang_translations": {
                                "ru": "Композиторы часто экспериментируют со сложными <w>метрическими</w> структурами для создания напряжения в музыке.",
                                "zh": "作曲家经常尝试复杂的<w>节拍</w>结构来营造音乐的张力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metric pattern",
                        "metric structure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к ритмической структуре (метру) музыкального произведения или стихотворения.",
                        "zh": "指与音乐或诗歌的节奏结构（格律）有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метрический",
                                "target_lang_sense_clarification": "относящийся к ритму/метру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格律的",
                                "target_lang_sense_clarification": "指诗歌或音乐的节奏结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87e24cc2-429a-3461-9a02-23a141ed1870",
                    "sense_definition": "A standard of measurement or a set of figures used to evaluate performance, quality, or progress.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation_standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Customer satisfaction is a key <w>metric</w> for the success of our business.",
                            "target_lang_translations": {
                                "ru": "Удовлетворенность клиентов — ключевая <w>метрика</w> успеха нашего бизнеса.",
                                "zh": "客户满意度是我们业务成功的关键<w>指标</w>。"
                            }
                        },
                        {
                            "text": "The manager introduced a new <w>metric</w> to track employee productivity more accurately.",
                            "target_lang_translations": {
                                "ru": "Менеджер ввел новую <w>метрику</w> для более точного отслеживания производительности сотрудников.",
                                "zh": "经理引入了一项新的<w>度量</w>标准，以更准确地追踪员工的生产力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "measure"
                    ],
                    "common_phrases": [
                        "performance metric",
                        "key metric",
                        "business metric",
                        "baseline metric"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт измерения или набор данных, используемых для оценки эффективности, качества или прогресса.",
                        "zh": "用于评估绩效、质量或进展的衡量标准或一组数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метрика",
                                "target_lang_sense_clarification": "показатель эффективности"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "критерий оценки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指标",
                                "target_lang_sense_clarification": "用于评估的衡量标准"
                            },
                            {
                                "target_lang_word": "度量",
                                "target_lang_sense_clarification": "评估的量化标准"
                            }
                        ]
                    }
