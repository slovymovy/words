                "senses": [
                    {
                        "sense_id": "6bd5a13b-b701-3ff3-8ce2-e40d48b96242",
                        "entry_id": "3c10be54-5577-36c9-acda-b5ae0494a863",
                        "glosses": [
                            "jüdischer Gelehrter und Lehrer"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "8377ebc2-797e-4a77-9009-51501d1b8b99",
                                "sense_id": "6bd5a13b-b701-3ff3-8ce2-e40d48b96242",
                                "text": "„Mechanisch wiederholte ich Absatz für Absatz, was der Rebbe auf hebräisch sagte, ohne ein Wort zu verstehen.“"
                            },
                            {
                                "example_id": "e7327cd4-d9a8-4610-b352-27cc44a845ce",
                                "sense_id": "6bd5a13b-b701-3ff3-8ce2-e40d48b96242",
                                "text": "„Die Tochter des Rebbe, dieses blutjunge Ding, hatte mit einem einzigen Wort ausgedrückt, was mit ihm los war und warum er diese Reise gemacht hatte.“"
                            },
                            {
                                "example_id": "ffa1ec70-50dd-4293-b50a-274427ff7cda",
                                "sense_id": "6bd5a13b-b701-3ff3-8ce2-e40d48b96242",
                                "text": "„Aber der Rebbe von Nemirow ist kein Bontsche, die Sündhaftigkeit der Welt nimmt er nicht passiv hin, und mit Bußgebeten begnügt er sich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
