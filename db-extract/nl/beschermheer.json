                                    },
                                    {
                                        "sense_id": "eb3dbee2-b64d-3133-aa37-008559e42f99",
                                        "entry_id": "224785f2-ff7f-3ec4-971a-22f388ee3308",
                                        "glosses": [
                                            "A customer, as of a certain store or restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0445e5-7c1a-455e-b36a-8ff896992087",
                                                "sense_id": "eb3dbee2-b64d-3133-aa37-008559e42f99",
                                                "text": "This car park is for patrons only."
                                            },
                                            {
                                                "example_id": "ae86a27c-37c0-4562-9141-e1da3fd984fa",
                                                "sense_id": "eb3dbee2-b64d-3133-aa37-008559e42f99",
                                                "text": "In our trial of the AOT, a transect was used to collect data about the languages being spoken by patrons of the NIE cafeteria during lunchtimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80bf7841-f535-3444-b452-71afdf10568c",
                                        "entry_id": "224785f2-ff7f-3ec4-971a-22f388ee3308",
                                        "glosses": [
                                            "A protector of a dependent, especially a master who had freed a slave but still retained some paternal rights."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c952c6f4-feb8-3680-b48b-8d56fdb95aed",
                                        "entry_id": "224785f2-ff7f-3ec4-971a-22f388ee3308",
                                        "glosses": [
                                            "One who has gift and disposition of a benefice."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb2e466-710c-3430-a2f2-3ad12eadaa0a",
                                        "entry_id": "224785f2-ff7f-3ec4-971a-22f388ee3308",
