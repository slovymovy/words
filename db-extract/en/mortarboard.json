                                    {
                                        "sense_id": "773cb9e1-8d43-3db0-8d95-24dd2cfec21f",
                                        "entry_id": "8af8f4fc-1002-3946-91b8-60cc7cf67f91",
                                        "glosses": [
                                            "ein Maurer- bzw. Putzerwerkzeug, um Putz auf Oberflächen zu glätten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31825b67-19ab-46bd-a3bd-bf82035c4240",
                                                "sense_id": "773cb9e1-8d43-3db0-8d95-24dd2cfec21f",
