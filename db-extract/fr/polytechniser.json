                "senses": [
                    {
                        "sense_id": "0e847ebb-a20c-3b63-b31c-9b2daa5d5fb6",
                        "entry_id": "c60ba27f-b1ec-3550-89dd-7134419b1e3c",
                        "glosses": [
                            "Donner un caractère polytechnique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb06336c-57f1-435f-b044-b48358eb1b62",
                                "sense_id": "0e847ebb-a20c-3b63-b31c-9b2daa5d5fb6",
                                "text": "Cet enseignement général commun qui suppose la reconversion du cycle moyen et sa combinaison avec le cycle élémentaire qui le précède, doit être progressivement « polytechnisé » en commençant par la dernière année."
                            },
                            {
                                "example_id": "3451a5cc-ee9e-4a88-981f-fe6de333022a",
                                "sense_id": "0e847ebb-a20c-3b63-b31c-9b2daa5d5fb6",
                                "text": "La dernière étape de l'enseignement fondamental (l'enseignement moyen actuel) sera polytechnisé dans sa quasi totalité, à partir de 1975."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1c6b2d5-afb8-3352-9ce1-c15226be6f37",
                        "entry_id": "c60ba27f-b1ec-3550-89dd-7134419b1e3c",
                        "glosses": [
                            "Raisonner comme un polytechnicien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bde9ef8-3840-4c8e-bca0-0a61405b6ccf",
                                "sense_id": "e1c6b2d5-afb8-3352-9ce1-c15226be6f37",
                                "text": "On schématise, on polytechnise, on technocratise."
                            }
                        ]
                    }
