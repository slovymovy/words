                        "glosses": [
                            "Personne présentant une personnalité marquée par l’hypothymie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53375ff-c266-4750-a12b-cf45ebe64bcf",
                                "sense_id": "be3acb25-13d6-3ca2-826c-f1207d21b4c2",
                                "text": "C’est parmi les hypothymiques constitutionnels qu’on recrute beaucoup d’enfants suicide."
                            },
                            {
                                "example_id": "97b94cc5-b137-4dfb-ac3b-a4961ef12fee",
                                "sense_id": "be3acb25-13d6-3ca2-826c-f1207d21b4c2",
                                "text": "On peut se demander au point de vue thérapeutique si notre patient, asthénique chronique devenu secondairement un hypothymique incurable, n’était pas susceptible de guérir."
