                "entry_id": "edf2aaf8-e9c5-3275-86c0-5ef9dc087742",
                "word": "huns",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c24e18b9-2a20-356f-bf0a-24544dc0bbc5",
                        "entry_id": "edf2aaf8-e9c5-3275-86c0-5ef9dc087742",
                        "glosses": [
                            "genitief (van) hun"
                        ],
                        "tags": [
                            "masculine",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6e048221-edcf-402b-9b61-ab19f63dfbcc",
                                "sense_id": "c24e18b9-2a20-356f-bf0a-24544dc0bbc5",
                                "text": "Ik heb menschen gezien, die door den krijg helemaal te gronde waren gebracht; (…) weduwen-moeders van den steun huns mans of van den steun hunner zonen beroofd; maar geen enkel verwijt of klacht heb ik hooren opgaan tegen 't verbod van doorlating van 't duitsche leger over België."
                            }
                        ]
                    },
                    {
                        "sense_id": "e49e10ab-29c7-3943-86d6-c0705802792e",
                        "entry_id": "edf2aaf8-e9c5-3275-86c0-5ef9dc087742",
                        "glosses": [
                            "genitief (van) hun"
                        ],
                        "tags": [
                            "neuter",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e132d50c-ef76-4e6b-8bd5-6e7414f26c27",
                                "sense_id": "e49e10ab-29c7-3943-86d6-c0705802792e",
                                "text": "Toen, volgens de zede huns volks, schoren de Hunnen het hoofdhaar (…)"
                            }
                        ]
                    }
