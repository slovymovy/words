                    },
                    {
                        "translation_id": "77bed29d-69ff-426e-ad63-fd776c733fd9",
                        "source_entry_id": "1ff3ac27-6f33-34ed-b4b6-9daa0773ad25",
                        "source_sense_id": "6f9ac7bb-69ba-3ec9-85f3-4f596654c2d6",
