                                "example_id": "b4c8d96c-c309-4553-98b7-a99b3239a0e8",
                                "sense_id": "8981f48b-9a12-3f2c-8484-6b99dcedd8a8",
                                "text": "De Noren zijn, sinds begin jaren negentig de kwestie van toetreding weer actueel werd, overvoerd met informatie over de voor- en nadelen van de Europese Unie. Het debat is intensief, veel verhitter dan in Zweden, dat twee weken geleden voor toetreding stemde."
                            },
                            {
                                "example_id": "85db38aa-cf0b-4ebc-a523-1292592b2419",
                                "sense_id": "8981f48b-9a12-3f2c-8484-6b99dcedd8a8",
                                "text": "Naarmate de gemoederen verhitter raakten werden de pamfletten grover."
                            },
                            {
                                "example_id": "93aa0ee0-9640-406f-a867-ca249d349a3f",
                                "sense_id": "8981f48b-9a12-3f2c-8484-6b99dcedd8a8",
                                "text": "Hoe verhitter men is geworden, hoe meer men verlangt naar ijswater of sneeuw; hoe kouder men daarna is, des te grotere hitte men kan verdragen."
                            }
                        ]
                    }
