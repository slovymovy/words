                                "target_senses": [
                                    {
                                        "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Rückstand bei der Teerherstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafabc1b-3221-471a-9d71-6989ab229f4c",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "Pech ist eine schwarze klebrige Masse."
                                            },
                                            {
                                                "example_id": "d8690f06-9c21-4209-882f-f05f0b4bedb3",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "„Der Kapitän hatte Cooper befohlen, etwas Pech in der Kombüse zu kochen.“"
                                            },
                                            {
                                                "example_id": "bc35b1cb-a3f7-4ce0-ab45-63a879d4eb15",
                                                "sense_id": "d47499a8-e4ef-346c-9153-37e85eb34067",
                                                "text": "„Für den Fisch brauchte man Fässer, für die Fässer Dauben, für die Dauben Holz und gegen die Luft dazwischen Pech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Harz"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09d8d3b-f540-4ceb-8c28-f9950eea5c5d",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "Als er den Ast abgebrochen hatte, drang Pech aus dem Baum."
                                            },
                                            {
                                                "example_id": "dd7732ca-6926-4636-924a-7194e39e6ced",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "„Holzfässer sind innen mit Pech (einem Produkt aus Kiefernharz) ausgekleidet.“"
                                            },
                                            {
                                                "example_id": "d180268d-e85a-4ce2-be6e-cae8bbb80078",
                                                "sense_id": "1e77d0d9-6d24-362c-9164-87efde99c63c",
                                                "text": "„Dann setzte er sich auf einen Stock, aus dessen Poren just kein Pech floß, und schaute den Holzhauern zu bei ihrer Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0792a5a5-7cda-3b85-b44e-81777cc45a83",
                                        "entry_id": "8face483-b5d1-3f77-a152-0663b742bd65",
                                        "glosses": [
                                            "Misserfolg, unglücklicher Zufall"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0393e5c1-9168-408a-8ccc-3b60c02931e0",
                                                "sense_id": "0792a5a5-7cda-3b85-b44e-81777cc45a83",
                                                "text": "Er hatte viel Pech in seinem Leben; vieles, was er anpackte, missglückte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
