                ],
                "senses": [
                    {
                        "sense_id": "28822faf-6961-31ce-9df6-1b58c7add6c8",
                        "entry_id": "a980e451-97f1-3310-b4d0-f5fb7895078d",
                        "glosses": [
                            "seitlich arkadenartig offener, oft überdachter/überwölbter Gang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ec781c-d443-4e21-ae2e-c83bc3fc1c79",
                                "sense_id": "28822faf-6961-31ce-9df6-1b58c7add6c8",
                                "text": "„Ich springe heftig zurück, schreie um Hilfe, ziehe meinen Degen und stoße ihn dem ersten durch den Leib; dann springe ich über die kleine Mauer, die den Bogengang zur Straße hin abgrenzt, ins Freie.“"
                            },
                            {
                                "example_id": "5702d80f-6ba2-4219-aef8-c3bbe311b8a2",
                                "sense_id": "28822faf-6961-31ce-9df6-1b58c7add6c8",
                                "text": "„Unter den fast zweihundert Bogengängen, in den Gärten mischte sich eine vornehme Welt, die Halbwelt und die Unterwelt.“"
                            },
                            {
                                "example_id": "09ac765d-0ecd-43a4-8416-1eb1156c9089",
                                "sense_id": "28822faf-6961-31ce-9df6-1b58c7add6c8",
                                "text": "„Unter den Bogengängen leuchteten die Schaufenster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
