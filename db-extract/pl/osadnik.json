                    }
                ],
                "translations": [
                    {
                        "translation_id": "50445bf3-3f31-4f46-92ca-2e5687ed38ed",
                        "source_entry_id": "4cab4852-00aa-3037-846c-7e7a9d4e731d",
                        "source_sense_id": "366686f5-ea75-3847-97c2-39f7d8230731",
                        "target_lang_word": "settler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "settler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who settles in a new location, especially one who takes up residence in a previously uninhabited place; a colonist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7939f95-5ddf-4655-821d-910db909bc84",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "the first settlers of New England"
                                            },
                                            {
                                                "example_id": "52579e07-6333-46ef-88dd-f34be51f8b08",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "The law, which let settlers stay on private land if they had built there without knowing the property belonged to Palestinians or had done so at the state’s direction, was backed by Israel’s most right-wing governing coalition to date."
                                            },
                                            {
                                                "example_id": "a96ceb0e-4704-4f57-a394-17ba58908b57",
                                                "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race. […] This belief was one of the drivers of the ‘protection’ laws that led to the settler government’s theft of children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f6dfcc-cc19-3cd8-a353-b98529b3dcca",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "Someone who decides or settles something, such as a dispute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5146319-0904-3f07-bdc9-7d0926625dec",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "That which settles or finishes, such as a blow that decides a contest."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec4ceef8-d623-33f8-a7a0-24115af212b1",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "The person in a betting shop who calculates the winnings."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A drink which settles the stomach, especially a bitter drink, often a nightcap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525268af-54b3-4f76-b911-29805489aefe",
                                                "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                                                "text": "[H]aving got out the rum bottle for a quiet “settler” just as the victim of his fascinations glided through the carefully adjusted door, he had been persuaded to go on drinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                        "entry_id": "0d82e921-b719-3d75-a257-5e7066a6237c",
                                        "glosses": [
                                            "A vessel, such as a tub, in which something, such as pulverized ore suspended in a liquid, is allowed to settle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b2a9f2-7664-466b-962d-12e5514cfbac",
                                                "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                                                "text": "First, there will be little reaction in the settler so that the concentrations of soluble constituents in the recycle stream are the same as those in the bioreactor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b68927-e2ae-4ad6-8247-a985fae80c76",
                        "source_entry_id": "4cab4852-00aa-3037-846c-7e7a9d4e731d",
