                "senses": [
                    {
                        "sense_id": "41784799-648f-3828-b5d5-9628f023f065",
                        "entry_id": "1c32307d-6ef4-3c38-9136-1aa46ad53365",
                        "glosses": [
                            "Faire en sorte que quelque chose qui était défini ne le soit plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a7b026-c38c-4777-add3-83cce9009580",
                                "sense_id": "41784799-648f-3828-b5d5-9628f023f065",
                                "text": "Effectivement, c’est dans ces années 1960-1970 que l’expérience esthétique fut réputée exclue de l’art par les artistes conceptuels, par Warhol ou par les minimalistes, par ceux qui voulaient dé-définir l'art et en même temps le désesthétiser."
                            },
                            {
                                "example_id": "e72c286d-80b2-49c3-a940-469399822413",
                                "sense_id": "41784799-648f-3828-b5d5-9628f023f065",
                                "text": "Dé-définir le mot de passe, ça enlève tout intérêt à Filevault, donc je saisis pas du tout ce que tu veux."
                            },
                            {
                                "example_id": "c211292b-0101-4958-b09b-5194a3eca1d5",
                                "sense_id": "41784799-648f-3828-b5d5-9628f023f065",
                                "text": "Dé-définir l'art."
                            }
                        ]
                    }
