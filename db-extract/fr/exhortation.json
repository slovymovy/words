                                        "glosses": [
                                            "обращение с предложением или просьбой о каком-либо действии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f3d15e-bbb1-451e-9c71-2fd032122eb5",
                                                "sense_id": "920993ec-e332-3359-9da3-1336df3b09b9",
                                                "text": "Куба отвергает призыв США к проведению демократических перемен."
                                            },
                                            {
                                                "example_id": "ca44ac7b-b6d0-4a02-ad84-20468172bbec",
                                                "sense_id": "920993ec-e332-3359-9da3-1336df3b09b9",
                                                "text": "Новый доклад содержит призыв к мобилизации финансовых ресурсов на борьбу с недоеданием."
                                            },
                                            {
                                                "example_id": "0512aaf5-66fe-4919-aafe-28d895ba1368",
                                                "sense_id": "920993ec-e332-3359-9da3-1336df3b09b9",
                                                "text": "В Эстонии распространяется призыв к русским и эстонцам приносить к имеющим значение для обеих общин местам белые тюльпаны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bcdf149-93de-3987-919a-401c64c02e7e",
                                        "entry_id": "614a1214-cd45-339d-b34d-601ee6d7040a",
                                        "glosses": [
                                            "обязательное назначение на срочную военную службу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e709e508-8e48-4bb6-bf76-70a5323b6e0a",
                                                "sense_id": "7bcdf149-93de-3987-919a-401c64c02e7e",
                                                "text": "На пресс-конференции генерал рассказал об итогах весеннего призыва."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f429b82d-8555-4dac-8159-14d8398a55ad",
                        "source_entry_id": "adabd130-e33c-3daf-a369-cd7ed3fc328f",
                        "source_sense_id": "17b12444-d762-3833-9802-c070e88a94d0",
                        "source_sense_description": "Discours pieux qu’on fait pour exciter à la dévotion",
                        "target_lang_word": "Schreiben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                        "entry_id": "c10a9668-df1b-392c-b022-5b9325d69679",
                                        "glosses": [
                                            "Vorgang des schriftlichen Verfassens von Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d66a336-e06e-4404-b2f7-0513fdf4f741",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "Das Schreiben muss in der Schule gelernt werden."
                                            },
                                            {
                                                "example_id": "790c212c-a422-4ebc-991a-6d7be97f3783",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "„Das (handschriftliche) Schreiben wird als Chirographie, das Drucken als Typographie bezeichnet (…).“"
                                            },
                                            {
                                                "example_id": "0bb89b77-956a-4eb1-9c68-19bf45a2f7f2",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "„Außerdem ist Schreiben, also das eigentliche Formen der Buchstaben, eine Art Kunsthandwerk gewesen, das man von jemandem lernen mußte.“"
                                            },
                                            {
                                                "example_id": "c10d74c0-e404-4bce-844c-b56ed84aa1eb",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "„Der moderne Mensch ist auf die Schrift und das Schreiben ebenso angewiesen wie auf die gesprochene Sprache, sein wichtigstes Kommunikationsmedium.“"
                                            },
                                            {
                                                "example_id": "ef1bbfba-ca85-4f0d-9610-2edcb0260b10",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            },
                                            {
                                                "example_id": "b093c5ca-be3e-44ca-bd20-840654973cfc",
                                                "sense_id": "ca577ae3-b3a4-39fb-9736-49172cfa7d9c",
                                                "text": "„In Finnland etwa greift schon nach drei Monaten ein Krisenmanagement, wenn es mit Lesen und Schreiben nicht voran geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07640051-402a-3697-bcbf-157847f3a161",
                                        "entry_id": "c10a9668-df1b-392c-b022-5b9325d69679",
                                        "glosses": [
                                            "an einen Adressaten gerichteter verfasster Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "260217fd-7bd8-4977-85dc-e2de4b139032",
                                                "sense_id": "07640051-402a-3697-bcbf-157847f3a161",
                                                "text": "Das Schreiben war in einem unangenehmen Ton gehalten."
                                            },
                                            {
                                                "example_id": "622bc011-391d-475d-9ed9-c4e1ed5fb362",
                                                "sense_id": "07640051-402a-3697-bcbf-157847f3a161",
                                                "text": "„Noch kursiert das Schreiben nur in den Landesregierungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "477be73e-70ca-3cc0-8390-6c45e1d101bb",
                                        "entry_id": "c10a9668-df1b-392c-b022-5b9325d69679",
                                        "glosses": [
                                            "kulturelle Fähigkeit der Schriftbenutzung"
                                        ],
                                        "tags": [],
                                        "examples": [],
