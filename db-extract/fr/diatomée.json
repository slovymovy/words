        "fr-extract.jsonl": [
            {
                "entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                "word": "diatomée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d243d70-dc17-40e1-94cf-6fd9c9b9dafe",
                        "entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                        "tags": [
                            "plural"
                        ],
                        "form": "diatomées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                        "entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                        "glosses": [
                            "Organisme unicellulaire et planctonique, souvent associé aux microalgues, enfermé entre deux valves siliceuses : le frustule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "574e1a6f-5823-4334-b756-fb7981fec986",
                                "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                            },
                            {
                                "example_id": "fb7ea40e-d1ff-4498-a83b-16f4830f7de4",
                                "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                                "text": "À votre droite, traces imperceptibles dans des pulvérisations de rochasses couvertes de diatomées."
                            },
                            {
                                "example_id": "51dd3902-83f9-4640-b414-0e47e4de10e8",
                                "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                                "text": "Un anneau composé de soluble dans la pyridine pour 64 % en poids, de silice (sable, diatomées, foraminifères) pour 18 % et de sulfate de calcium pour 12 %, et datant de 3500 avant J.C. a été découvert à Ur en Irak du Sud."
                            },
                            {
                                "example_id": "c74e25b2-c5c1-420f-b497-1369194b69e7",
                                "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                                "text": "Parmi les diatomées radiolaires, de très nombreuses espèces possèdent une enveloppe adoptant la forme d’un polyèdre platonicien."
                            },
                            {
                                "example_id": "f264ee82-4e09-4891-aeca-7853f922d327",
                                "sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                                "text": "Un autre indicateur du changement climatique serait la variation des biomasses de certaines espèces vivantes dans l'océan, comme, par exemple, les coccolithophores, type de diatomées dont la production a augmenté de 40 % dans les dernières décennies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb44a635-1a5f-4b6f-a57c-85d91d679e56",
                        "source_entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                        "source_sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                        "target_lang_word": "Diatomee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b54d4738-86e4-4ca0-a507-ceb6c7d1d414",
                        "source_entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                        "source_sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                        "target_lang_word": "Kieselgu(h)r",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d60f1d55-5f3d-44df-843e-5a7c972a4f2e",
                        "source_entry_id": "80cbd82f-7aea-36a1-9ae9-a86d4cd75665",
                        "source_sense_id": "8418e0bf-4c5b-34e9-b265-5b2cf199e5cf",
                        "target_lang_word": "diatom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diatom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1104d2-103f-3196-9406-788153822b52",
                                        "entry_id": "60b48fe4-fced-3b27-a900-150da392603d",
                                        "glosses": [
                                            "Any of a group of minute unicellular algae having a siliceous covering of great delicacy, now categorized as class Diatomophyceae or division Bacillariophyta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674958fa-cae7-42b3-91f1-5816d30b07ff",
                                                "sense_id": "ef1104d2-103f-3196-9406-788153822b52",
                                                "text": "Diatoms are enclosed in two shells that fit together like a pillbox."
                                            },
                                            {
                                                "example_id": "38c3848f-786a-4a8d-8a16-ce579c80fe8a",
                                                "sense_id": "ef1104d2-103f-3196-9406-788153822b52",
                                                "text": "Diatoms are characterized by a cell wall called a fistula made of silica, which usually has two overlapping sections."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diatom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86d312f4-5a8a-3593-b74b-a563d2b029e5",
                                        "entry_id": "572c8a8c-a518-3671-83ad-b2e77f87fe52",
                                        "glosses": [
                                            "A molecule composed of two atoms of the same element; a homonuclear diatomic molecule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660ebe6a-cf53-49d4-9e2c-e6c5da223bff",
                                                "sense_id": "86d312f4-5a8a-3593-b74b-a563d2b029e5",
                                                "text": "We show here, through a systematic study of the covalent chemical bond covering the entire periodic system, that the maximum bond multiplicity is six. The maximum value is reached by the tungsten diatom, W₂. No other pair of atoms in the periodic system (atomic numbers smaller than about 100) reaches a higher bond order."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
