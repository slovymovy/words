                ],
                "senses": [
                    {
                        "sense_id": "30b287b0-b338-3121-91ce-1e68d5591479",
                        "entry_id": "1a060aac-a4a9-30fb-82aa-7ff86d249dd7",
                        "glosses": [
                            "aufgerichteter Mittelfinger bei sonst geschlossener Hand als Geste der Verachtung, der Beleidigung"
                        ],
                        "tags": [
                            "Geste"
                        ],
                        "examples": [
                            {
                                "example_id": "81d0b763-4b65-4eca-97c3-952082c3a139",
                                "sense_id": "30b287b0-b338-3121-91ce-1e68d5591479",
                                "text": "„Nun aber - wie heißt dieser aufgerichtete Mittelfinger bei uns? Eben: er heißt (und wir denken uns gar nichts dabei) Stinkefinger!“"
                            },
                            {
                                "example_id": "ae07ef46-123c-41ba-822c-2eba8e0fc771",
                                "sense_id": "30b287b0-b338-3121-91ce-1e68d5591479",
                                "text": "Dann ist er ausgeflippt und hat uns allen den Stinkefinger gezeigt."
                            },
                            {
                                "example_id": "53c5e7aa-85ef-47c4-9181-89616d4e8a88",
                                "sense_id": "30b287b0-b338-3121-91ce-1e68d5591479",
                                "text": "„[Auf einem Internetvideo] ist zu sehen, wie [SPD-Politiker Sigmar] Gabriel mit einem müden Lächeln auf die rechten Störer reagiert, erst abwinkt, ihnen dann den \"Stinkefinger\" zeigt und sich schließlich abwendet.“"
                            },
                            {
                                "example_id": "60217cea-a982-4b1f-bbc6-37b028ef9b3a",
                                "sense_id": "30b287b0-b338-3121-91ce-1e68d5591479",
                                "text": "„Bestimmte Gesten – wie etwa das Vogelzeigen oder der Stinkefinger – können richtig Geld kosten. Da kann man eine Beleidigungsklage an den Hals kriegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
