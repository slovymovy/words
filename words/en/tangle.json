{
    "word_family": [
        "entangle",
        "entanglement",
        "tangled",
        "tangly",
        "untangle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                    "sense_definition": "To become mixed together or intertwined in a confused mass",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intertwine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her long hair began to <w>tangle</w> after a day spent out in the strong wind.",
                            "target_lang_translations": {
                                "ru": "Её длинные волосы начали <w>спутываться</w> после целого дня, проведённого на сильном ветру."
                            }
                        },
                        {
                            "text": "The fishing lines will <w>tangle</w> easily if you do not store them properly in the box.",
                            "target_lang_translations": {
                                "ru": "Рыболовные лески легко <w>запутаются</w>, если не хранить их в коробке должным образом."
                            }
                        }
                    ],
                    "synonyms": [
                        "knot",
                        "snarl",
                        "mat"
                    ],
                    "antonyms": [
                        "untangle",
                        "unsnarl"
                    ],
                    "common_phrases": [
                        "tangle easily",
                        "tangle together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочно переплетаться или перемешиваться в запутанную массу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутываться",
                                "target_lang_sense_clarification": "о волосах, нитках или проводах"
                            },
                            {
                                "target_lang_word": "спутываться",
                                "target_lang_sense_clarification": "переплетаться в беспорядке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d26a558f-2637-389d-a80c-8c83d1ee8d64",
                    "sense_definition": "To mix things together or intertwine them into a confused mass",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intertwine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>tangle</w> the threads while you are sewing the button onto the shirt.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>запутать</w> нитки, пока пришиваете пуговицу к рубашке."
                            }
                        },
                        {
                            "text": "The kitten managed to <w>tangle</w> the yarn all over the living room floor.",
                            "target_lang_translations": {
                                "ru": "Котёнку удалось <w>спутать</w> пряжу по всему полу в гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "entangle",
                        "knot",
                        "snarl",
                        "dishevel",
                        "tousle"
                    ],
                    "antonyms": [
                        "untangle",
                        "unsnarl"
                    ],
                    "common_phrases": [
                        "tangle the wires",
                        "tangle the hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочно перемешивать или переплетать вещи в запутанную массу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "приводить в беспорядок нити или волосы"
                            },
                            {
                                "target_lang_word": "спутывать",
                                "target_lang_sense_clarification": "переплетать что-либо между собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                    "sense_definition": "To enter into an argument, conflict, dispute, or fight with someone",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is never a good idea to <w>tangle</w> with someone who has much more power than you.",
                            "target_lang_translations": {
                                "ru": "Связываться с кем-то, кто обладает гораздо большей властью, чем вы — всегда плохая идея."
                            }
                        },
                        {
                            "text": "The two companies have continued to <w>tangle</w> in court over the patent rights for years.",
                            "target_lang_translations": {
                                "ru": "Две компании годами продолжают <w>судиться</w> из-за патентных прав."
                            }
                        }
                    ],
                    "synonyms": [
                        "argue",
                        "conflict",
                        "dispute",
                        "fight"
                    ],
                    "common_phrases": [
                        "tangle with the law",
                        "tangle with someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в спор, конфликт, разногласие или драку с кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связываться",
                                "target_lang_sense_clarification": "вступать в конфликт с кем-то опасным"
                            },
                            {
                                "target_lang_word": "вступать в спор",
                                "target_lang_sense_clarification": "начинать дискуссию или тяжбу"
                            },
                            {
                                "target_lang_word": "встрять",
                                "target_lang_sense_clarification": "разг. ввязаться в неприятную ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                    "sense_definition": "To catch and hold someone or something as if in a net or trap",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird was <w>tangled</w> in the garden netting and could not fly away.",
                            "target_lang_translations": {
                                "ru": "Птица <w>запуталась</w> в садовой сетке и не могла улететь."
                            }
                        },
                        {
                            "text": "He felt himself <w>tangled</w> in a web of lies that he could no longer escape.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что <w>увяз</w> в паутине лжи, из которой больше не мог выбраться."
                            }
                        }
                    ],
                    "synonyms": [
                        "ensnare",
                        "entrap",
                        "entangle"
                    ],
                    "common_phrases": [
                        "tangled in a web",
                        "tangled in a mess"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать и удерживать кого-либо или что-либо, словно в сети или ловушке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутаться",
                                "target_lang_sense_clarification": "застрять в чем-то физически или метафорически"
                            },
                            {
                                "target_lang_word": "увязнуть",
                                "target_lang_sense_clarification": "оказаться втянутым в сложную ситуацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b53a3ba3-7c8c-38f4-ac7b-0499b5959719",
                    "sense_definition": "A twisted, knotted, or confused mass of something like hair or wire",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a huge <w>tangle</w> of cables behind the television that was impossible to organize.",
                            "target_lang_translations": {
                                "ru": "За телевизором был огромный <w>узел</w> кабелей, который невозможно было привести в порядок."
                            }
                        },
                        {
                            "text": "She used a special comb to remove every <w>tangle</w> from her daughter's long hair.",
                            "target_lang_translations": {
                                "ru": "Она использовала специальную расчёску, чтобы убрать каждый <w>колтун</w> из длинных волос дочери."
                            }
                        }
                    ],
                    "synonyms": [
                        "knot",
                        "mess",
                        "snarl"
                    ],
                    "common_phrases": [
                        "tangle of hair",
                        "tangle of wires"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрученная, завязанная узлом или беспорядочная масса чего-либо (например, волос или проводов)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колтун",
                                "target_lang_sense_clarification": "спутанный ком волос"
                            },
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "запутанное место в проводах или нитях"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "беспорядочное переплетение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                    "sense_definition": "A complicated or confused state or condition",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal case became a <w>tangle</w> of conflicting evidence and confusing witness testimonies.",
                            "target_lang_translations": {
                                "ru": "Судебное дело превратилось в <w>клубок</w> противоречивых улик и запутанных показаний свидетелей."
                            }
                        },
                        {
                            "text": "I tried to sort through this <w>tangle</w> of bureaucracy but I got nowhere.",
                            "target_lang_translations": {
                                "ru": "Я пытался разобраться в этой бюрократической <w>путанице</w>, но ничего не добился."
                            }
                        }
                    ],
                    "synonyms": [
                        "maze",
                        "snarl",
                        "mess"
                    ],
                    "common_phrases": [
                        "tangle of emotions",
                        "bureaucratic tangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложное или запутанное состояние или ситуация"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клубок",
                                "target_lang_sense_clarification": "перен. сплетение противоречий или проблем"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "отсутствие ясности и порядка"
                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "хаотичная ситуация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b830b86a-ff44-37a5-8387-425fb4bcbb85",
                    "sense_definition": "An argument, conflict, dispute, or physical fight",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two players got into a <w>tangle</w> on the field after a rough tackle.",
                            "target_lang_translations": {
                                "ru": "Два игрока вступили в <w>стычку</w> на поле после грубого подката."
                            }
                        },
                        {
                            "text": "He wanted to avoid another <w>tangle</w> with his boss over the project budget.",
                            "target_lang_translations": {
                                "ru": "Он хотел избежать очередной <w>ссоры</w> с начальником из-за бюджета проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "argument",
                        "conflict",
                        "dispute",
                        "fight"
                    ],
                    "common_phrases": [
                        "get into a tangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спор, конфликт, разногласие или физическая стычка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "небольшой конфликт или драка"
                            },
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "ухудшение отношений или громкий спор"
                            },
                            {
                                "target_lang_word": "перепалка",
                                "target_lang_sense_clarification": "словесный спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                    "sense_definition": "Any large type of seaweed, especially species of the genus Laminaria",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seaweed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shore was covered in thick <w>tangle</w> and shells after the heavy storm.",
                            "target_lang_translations": {
                                "ru": "После сильного шторма берег был покрыт густыми <w>водорослями</w> и ракушками."
                            }
                        },
                        {
                            "text": "Fishermen often find their nets filled with <w>tangle</w> when working in these shallow waters.",
                            "target_lang_translations": {
                                "ru": "Рыбаки часто находят свои сети забитыми <w>ламинарией</w> при работе в этих мелководьях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea tangle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Scotland and Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой крупный вид морских водорослей, особенно рода Ламинария"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ламинария",
                                "target_lang_sense_clarification": "научное название морской капусты"
                            },
                            {
                                "target_lang_word": "морские водоросли",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fa0f4829-0641-32f0-830d-43a5e8cec84c",
                    "sense_definition": "A barangay located in Mexico, Pampanga, Philippines",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The local government of <w>Tangle</w> organized a community event for the residents.",
                            "target_lang_translations": {
                                "ru": "Местное правительство <w>Тангла</w> организовало общественное мероприятие для жителей."
                            }
                        },
                        {
                            "text": "He was born and raised in the barangay of <w>Tangle</w> in the Philippines.",
                            "target_lang_translations": {
                                "ru": "Он родился и вырос в барангае <w>Тангл</w> на Филиппинах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Барангай (район), расположенный в Мексике, Пампанга, Филиппины"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тангл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}