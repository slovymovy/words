                        "cross_references": [
                            {
                                "target_word": "wattle and daub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe33fc8-d76d-39cf-929d-a8761ca9455e",
                                        "entry_id": "407000bf-0095-34ad-9784-7614d489094b",
                                        "glosses": [
                                            "A structure of interwoven branches and twigs plastered with mud, clay or dung, used in the construction of dwellings, especially as infill in a half-timbered wall"
                                        ],
