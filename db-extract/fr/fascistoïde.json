                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2c564f5-07bd-3c5f-9794-1416e02d4307",
                                        "entry_id": "93306170-75a1-3e36-b53d-eaec253c8725",
                                        "glosses": [
                                            "Resembling fascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09220ab3-6cc3-47bf-a308-ebae1ca0782b",
                                                "sense_id": "c2c564f5-07bd-3c5f-9794-1416e02d4307",
                                                "text": "We must now be prepared, too, for that Puritan reaction here, which seems to accompany all Fascistoid movements."
                                            },
                                            {
                                                "example_id": "ca0fbb29-6a10-4874-b103-614bddccc02f",
                                                "sense_id": "c2c564f5-07bd-3c5f-9794-1416e02d4307",
                                                "text": "In sum, we ought to realise that our enthusiasm for sports heroes is fascistoid in nature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fascistoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "170f4ccb-1ae5-3c1b-821b-454f9d4f506d",
                                        "entry_id": "8031f469-25ad-31b5-b334-b178beaa2c85",
                                        "glosses": [
                                            "A person who holds fascistoid views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abcf6a9d-872f-41ff-83e1-38377d60e499",
                                                "sense_id": "170f4ccb-1ae5-3c1b-821b-454f9d4f506d",
                                                "text": "The modern fascistoids employ terribly violent language, with often tragic and murderous consequences, but they do not stage invasions and do not really aim at war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
