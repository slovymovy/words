                "senses": [
                    {
                        "sense_id": "d6af6940-69f8-34e6-b9c4-80095148debc",
                        "entry_id": "6f1e7d9f-d656-3929-84a0-78e087699d07",
                        "glosses": [
                            "Étalonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03fd70e8-13c5-4be3-bd95-e810917853de",
                                "sense_id": "d6af6940-69f8-34e6-b9c4-80095148debc",
                                "text": "Il faut donc re-étalonner les noirs lorsque vous ajoutez du gain sous peine d’obtenir une image verdâtre."
                            },
                            {
                                "example_id": "3f73e964-09d8-4b28-bbeb-35afcb08b119",
                                "sense_id": "d6af6940-69f8-34e6-b9c4-80095148debc",
                                "text": "Parlant de l’âge, il faudra re-étalonner les agendas d’anniversaire."
                            },
                            {
                                "example_id": "17507c20-f7ab-41f7-a472-326141ac29a4",
                                "sense_id": "d6af6940-69f8-34e6-b9c4-80095148debc",
                                "text": "Les réparations du matériel de pulvérisation doivent être effectuées rapidement ; ensuite, l’avion doit être re-étalonné et la largeur de l’andain doit être re-vérifiée."
                            }
                        ]
                    }
