                "senses": [
                    {
                        "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                        "entry_id": "24b1d758-8da4-3260-adb1-965eb526e575",
                        "glosses": [
                            "James Webb Space Telescope"
                        ],
                        "tags": [
                            "Akronym"
                        ],
                        "examples": [
                            {
                                "example_id": "e91dc54c-f631-4df6-adb1-d5b3b31cb5b8",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Mit Spannung und wachsender Ungeduld harren die Astronomen auf den mehrfach verschobenen Start des bisher leistungsfähigsten Weltraumteleskops, des James Webb Space Telescope (JWST)."
                            },
                            {
                                "example_id": "f573cb21-774d-4c1b-827b-14a6c7da507e",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Mindes fünf, wahrscheinlich aber zehn Jahre lang wird das JWST ins All spähen und unser Wissen über Aufbau und Entwicklung des Universums und seiner Gestirne enorm erweitern."
                            },
                            {
                                "example_id": "ed227ac9-273e-4de4-abd4-402153c1bac9",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Das JWST ist als Korsch-Teleskop (TMA – Three-Mirror-Anastigmat) aufgebaut."
                            },
                            {
                                "example_id": "f6765e5e-7da3-4cec-bc3f-54afbb94df37",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Die Ausrichtung des JWST auf Infrarot macht natürlich auch im Weltraum zusätzliche Maßnahmen erforderlich, damit die Wärme der Sonne nicht ständig zu Störungen führt."
                            },
                            {
                                "example_id": "094c7e86-d194-44eb-ad5b-7e0170da939e",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Acht Milliarden Dollar und keinen Cent mehr – so viel darf das James Webb Space Telescope (JWST) am Ende kosten."
                            },
                            {
                                "example_id": "9989988a-71a5-4624-ab60-395cd3251ffe",
                                "sense_id": "a315a4cd-004a-39dc-aaf9-fca972abab19",
                                "text": "Damit wird das JWST frühestens im Mai 2020 starten – und wohl deutlich teurer als zuletzt angekündigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
