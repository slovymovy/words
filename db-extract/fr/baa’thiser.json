                        "glosses": [
                            "Donner un caractère baa’thiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e1c441-e24e-4d8f-9da8-6bf80efec64f",
                                "sense_id": "49972c3a-ca45-3196-a4c1-7152e9349a17",
                                "text": "Haidalla avait bien raison de réprimer ces milices de nationalistes arabisants, qui voulaient baa’thiser, irakiser, ou nassériser le pays en l’entraînant vers un avenir incertain."
                            },
                            {
                                "example_id": "0a1dd8f3-2a35-4e3b-98d8-91b700319823",
                                "sense_id": "49972c3a-ca45-3196-a4c1-7152e9349a17",
                                "text": "Par exemple, elles auront le droit de s'arabiser, de se baa'thiser ou de se nasseriser autant qu'elles le voudront."
                            }
                        ]
                    }
