                ],
                "senses": [
                    {
                        "sense_id": "9958a101-2e27-39d9-b214-ef3690a7d4f0",
                        "entry_id": "5b65e4c5-4a3d-3420-84ef-94d1ebae8f8d",
                        "glosses": [
                            "Donner un caractère original à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f319c36-b4bd-45de-88fd-9139dc8b3cf2",
                                "sense_id": "9958a101-2e27-39d9-b214-ef3690a7d4f0",
                                "text": "Je n’ai pas investi dans la recherche mais j’exploite la « molécule active » de mon concurrent ; je la déforme assez pour « l’originaliser », même médiocrement, et en tirer des bénéfices."
                            },
                            {
                                "example_id": "94d047d2-b907-401a-a2b5-7d21bd58279f",
                                "sense_id": "9958a101-2e27-39d9-b214-ef3690a7d4f0",
                                "text": "Il faut y rattacher les Notes sur la femme, d’une amertume si vécue et d’une acuité si personnelle, malgré un trop évident désir de s’originaliser."
                            }
                        ]
                    }
                ],
