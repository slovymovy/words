                "senses": [
                    {
                        "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                        "entry_id": "726b5922-7cd2-3d65-9fdd-382f6a710caa",
                        "glosses": [
                            "Rückenstück einer bestimmten Art von Plattfisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5268b5cc-9690-48f2-8518-a4481532a1b7",
                                "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                                "text": "„Wenn man tiefgefrorenes Schollenfilet verwendet, sollte man es möglichst schonend auftauen.“"
                            },
                            {
                                "example_id": "9bb6a03d-d9ff-489b-93e1-02109af8b753",
                                "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                                "text": "„Damit das Schollenfilet nicht trocken wird, sollte es nur möglichst kurz gebraten werden oder in Sauce gar ziehen.“"
                            },
                            {
                                "example_id": "62acc2b5-f46b-45c4-af4c-f9ce8d36e9da",
                                "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                                "text": "„Man kann Schollenfilet auch panieren, braten und nach Wunsch warm oder kalt z.B. auf dänischem Smørrebrød mit selbstgemachter Remoulade servieren.“"
                            },
                            {
                                "example_id": "6228f13a-5063-4ba0-846b-dedaa1eaa8b7",
                                "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                                "text": "„[…] Schollenfilets […] erhält man das ganze Jahr über tiefgefroren in den Supermärkten oder von Mai bis Oktober frisch bei Fischhändlern oder größeren Supermärkten mit Frischfisch-Abteilung.“"
                            },
                            {
                                "example_id": "a85aafe3-1772-4b7e-9512-0dc26e47b0a0",
                                "sense_id": "9f64ac98-df99-39e6-a603-8d91b5486709",
                                "text": "„Schollenfilets besitzen ein sehr zartes helles aromatisches Fleisch und sind bereits von Gräten und Haut befreit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
