                ],
                "translations": [
                    {
                        "translation_id": "85eab0fd-fa98-449c-bf43-a7c634db8293",
                        "source_entry_id": "3cd234f8-051a-36f9-ab08-67bdbe80adb9",
                        "source_sense_id": "a670dacf-678d-35fb-800c-e3e9b11648c0",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Herbert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herbert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a1a264-aa29-312a-b302-a81d54099c5b",
                                        "entry_id": "c12c8f20-bb7f-35a9-b244-7a52e44610c8",
                                        "glosses": [
                                            "A male given name from the Germanic languages, in modern use partly transferred back from the surname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29731d61-04ed-44a3-8830-0a7f27851a41",
                                                "sense_id": "c8a1a264-aa29-312a-b302-a81d54099c5b",
                                                "text": "Herbert, Sydney, Milton, Seymour. You know, all the time I was growing up I thought those were the most ordinary Jewish first names, until someone pointed out that they were British last names. I guess to my great-grandparents those names must have sounded so modern, so sophisticated, so - non-Eastern European. And now they're just Uncle Miltie, Uncle Sy, Uncle Herb. Do other people have Uncle Donne and Uncle Wordsworth?"
                                            },
                                            {
                                                "example_id": "4ea46ef1-252e-46b7-bdcd-95f4d5d0037e",
                                                "sense_id": "c8a1a264-aa29-312a-b302-a81d54099c5b",
                                                "text": "To be clear what we're talking about, read Cronon's piece. He offers a great introduction to the concept, and its originator, Herbert Butterfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081084ea-ea1b-3387-ba3d-43f0f8a595c5",
                                        "entry_id": "c12c8f20-bb7f-35a9-b244-7a52e44610c8",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadc840e-bec7-43d9-8481-065f8412d517",
                                                "sense_id": "081084ea-ea1b-3387-ba3d-43f0f8a595c5",
                                                "text": "And you, Sir Walter Herbert, stay with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb055bd7-57dd-3fa0-99e5-a4c32b71d335",
                                        "entry_id": "c12c8f20-bb7f-35a9-b244-7a52e44610c8",
