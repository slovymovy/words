            "senses": [
                {
                    "sense_id": "b1445308-9a69-3ed9-a3c4-e4bc871a8091",
                    "sense_definition": "The state or quality of being full of sorrow, misery, or distress.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>woefulness</w> in her eyes revealed the depth of her recent loss.",
                            "target_lang_translations": {
                                "zh": "她眼中流露出的<w>悲伤</w>揭示了她近期遭受的丧亲之痛有多深。"
                            }
                        },
                        {
                            "text": "He could not hide the <w>woefulness</w> of his situation after the business failed.",
                            "target_lang_translations": {
                                "zh": "生意失败后，他无法掩饰自己处境的<w>凄惨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sorrowfulness",
                        "misery",
                        "wretchedness",
                        "sadness"
                    ],
                    "antonyms": [
                        "joyfulness",
                        "happiness"
                    ],
                    "target_lang_definitions": {
                        "zh": "充满悲伤、痛苦或苦难的状态或特质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "悲伤",
                                "target_lang_sense_clarification": "指内心深处的忧伤或哀痛。"
                            },
                            {
                                "target_lang_word": "凄惨",
                                "target_lang_sense_clarification": "形容境遇极其悲惨或令人心酸。"
                            },
                            {
                                "target_lang_word": "苦难",
                                "target_lang_sense_clarification": "指遭受痛苦或不幸的境地。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
