        "fr-extract.jsonl": [
            {
                "entry_id": "043a8a0f-08eb-38f8-bd27-1d3e8fa977db",
                "word": "zoorama",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "786c3754-890b-4dc0-93ca-2efb6d7c4a82",
                        "entry_id": "043a8a0f-08eb-38f8-bd27-1d3e8fa977db",
                        "tags": [
                            "plural"
                        ],
                        "form": "zooramas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ce0519e-c3af-3833-9064-665fe88e934e",
                        "entry_id": "043a8a0f-08eb-38f8-bd27-1d3e8fa977db",
                        "glosses": [
                            "Diorama ou panorama zoologique, présentant des animaux naturalisés ou vivants dans leur biotope reconstitué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a88b71e-09b6-46da-9081-47e5dc41c094",
                                "sense_id": "6ce0519e-c3af-3833-9064-665fe88e934e",
                                "text": "Un zoorama plus vrai que nature."
                            }
                        ]
                    },
                    {
                        "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                        "entry_id": "043a8a0f-08eb-38f8-bd27-1d3e8fa977db",
                        "glosses": [
                            "Synonyme de zoo."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9204ff-0c9b-48e4-8e66-076a0fbf6ee9",
                                "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                                "text": "Le zoorama européen de la forêt de Chizé constitue une sorte de musée vivant, grandeur nature."
                            },
                            {
                                "example_id": "0175b8ac-5ad8-4576-9357-ebc147e1e0ff",
                                "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                                "text": "L'aimable duchesse s'intéressait beaucoup à son futur zoogymnaste et au zoorama qu'il avait conçu le projet de créer."
                            },
                            {
                                "example_id": "c2c9b62a-6730-474e-b93d-1c47d1e0ef91",
                                "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                                "text": "Il était perdu dans un rêve : la fondation d'un « Zoorama », espèce de jardin zoologique."
                            },
                            {
                                "example_id": "09d935ea-463d-4c28-93a2-d145163f4d50",
                                "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                                "text": "Enfin, le zoorama européen de Chizé (Deux-Sèvres), qui s’appuie sur des laboratoires du CNRS et de l’ONC, présente des espèces européennes, ce qui est suffisamment original pour être signalé."
                            },
                            {
                                "example_id": "3464b249-135e-4050-ab58-2b9cc4bf2685",
                                "sense_id": "d822d78d-6c40-3309-945e-b77f0ad8b4e3",
                                "text": "Au moment d'en tracer les plans, il s'est sans doute souvenu de ses conversations avec Martin, l'ancêtre des dompteurs modernes, qui avait avant 1830 le projet d'un vaste zoorama mêlant les espèces et offrant l'illusion parfaite d'un monde idéal."
                            }
                        ]
                    }
                ],
