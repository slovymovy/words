                                "target_senses": [
                                    {
                                        "sense_id": "00684f42-2d0c-3161-9bed-d42b966c8e40",
                                        "entry_id": "5d6582fe-5ad8-3e35-942a-16488a300776",
                                        "glosses": [
                                            "gezielte Handlung, die zu einem bestimmten Ergebnis beziehungsweise der Lösung einer Aufgabe führt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8242db95-9d1a-4978-9dd8-6a6e12f102a2",
                                                "sense_id": "00684f42-2d0c-3161-9bed-d42b966c8e40",
                                                "text": "Der Chef bewilligte die Gehaltserhöhung des Mitarbeiters aufgrund seiner guten Leistungen."
                                            },
                                            {
                                                "example_id": "5e51c899-2f4b-4923-bb46-80fca10bafe2",
                                                "sense_id": "00684f42-2d0c-3161-9bed-d42b966c8e40",
                                                "text": "„Der Artikel wurde zwei volle Spalten lang, und als Simon, nach Entgegennahme der Gratulation seiner sämtlichen Kollegen, endlich den Hörer auflegte, war er zum erstenmal in seiner journalistischen Laufbahn mit seiner Leistung hundertprozentig zufrieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90dd518c-0dbf-3996-9148-e1dc52657fd9",
                                        "entry_id": "5d6582fe-5ad8-3e35-942a-16488a300776",
                                        "glosses": [
                                            "verrichtete Arbeit pro Zeit"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e43408-c85f-4e14-85c4-96c54b683656",
                                                "sense_id": "90dd518c-0dbf-3996-9148-e1dc52657fd9",
                                                "text": "Die Sonne strahlt jeden Quadratmeter auf die Erdoberfläche mit einer Leistung von bis zu 1000 Watt."
                                            },
                                            {
                                                "example_id": "f2ff2472-d520-4128-bd1e-3585b26db632",
                                                "sense_id": "90dd518c-0dbf-3996-9148-e1dc52657fd9",
                                                "text": "Ein guter Radfahrer erbringt im Sprint eine Leistung von über einem Kilowatt."
                                            },
                                            {
                                                "example_id": "b9e3be30-2e09-4845-ab8a-b9a7b7a5f241",
                                                "sense_id": "90dd518c-0dbf-3996-9148-e1dc52657fd9",
                                                "text": "[Wärmepumpe:] „Falls nur ein oder zwei Heizkörper nicht genug Leistung bringen, kann es genügen, diese gegen leistungsfähigere Geräte auszutauschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99e551e0-f76e-31f2-9358-4ec04d30fc63",
                                        "entry_id": "5d6582fe-5ad8-3e35-942a-16488a300776",
                                        "glosses": [
                                            "im Sinne von ^([2]) im Radsprint, Radsport, Rudern und der gleichen; bei anderen Sportarten im weiteren Sinn, nämlich von größeren erzielten Höhen, Weiten, Geschwindigkeiten oder höheren anderen Wertungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd976a48-baf8-474d-8077-0778c4b73f84",
                                                "sense_id": "99e551e0-f76e-31f2-9358-4ec04d30fc63",
                                                "text": "Die Eiskunstläuferin errang mit ihrer überzeugenden Leistung Bestnoten."
                                            },
                                            {
                                                "example_id": "9d6a1d2e-dd64-456f-987c-17a4aba776fd",
                                                "sense_id": "99e551e0-f76e-31f2-9358-4ec04d30fc63",
                                                "text": "„Neben sportlichen Leistungen sind bei den Olympischen Spielen auch die Disziplinen Architektur, Malerei, Musik und Literatur im Rennen.“"
                                            },
                                            {
                                                "example_id": "aeec06e8-e96a-4c5e-9149-398c3a57394a",
                                                "sense_id": "99e551e0-f76e-31f2-9358-4ec04d30fc63",
                                                "text": "[Fahrradrennen:] „Es gibt […] mehr zugelassene, teils noch in der Forschung befindliche Präparate, die die Leistung […] steigern können – und auf die auch nicht routinemäßig getestet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f3848a92-be19-356b-b535-d2b918a35485",
                                        "entry_id": "5d6582fe-5ad8-3e35-942a-16488a300776",
                                        "glosses": [
                                            "die bewusste und zweckgerichtete Mehrung fremden Vermögens"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
