                                        "entry_id": "194f74c9-13e7-3512-88fb-b2171edf8691",
                                        "glosses": [
                                            "Wort aus der Wortklasse, zu der Gefühlsausdrücke wie oh, ah, äh und so weiter gehören"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec3b836f-33e2-415e-8862-c2c2b7e52fee",
                                                "sense_id": "6d596c4a-7503-3d46-be0c-7e547c7650f9",
                                                "text": "Das Wort ›huch‹ ist eine Interjektion."
                                            },
                                            {
                                                "example_id": "976a9d19-399c-469b-ba78-211550add38c",
                                                "sense_id": "6d596c4a-7503-3d46-be0c-7e547c7650f9",
                                                "text": "„Eine Sonderstellung in Bezug auf die Etymologie nehmen die Interjektionen (Ausrufewörter) ein.“"
                                            },
                                            {
                                                "example_id": "9ae0b5c6-9f04-453c-bec3-1ee93825b687",
                                                "sense_id": "6d596c4a-7503-3d46-be0c-7e547c7650f9",
                                                "text": "„Interjektionen werden vom Satz durch Komma abgetrennt, wenn sie nicht überhaupt allein stehen, wie oft in Comics.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
