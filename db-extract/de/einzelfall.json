                "senses": [
                    {
                        "sense_id": "fe765174-547d-309c-b5b0-af250c05439f",
                        "entry_id": "8d392f76-d35b-3eb2-9af0-bac2de4e424f",
                        "glosses": [
                            "Cas particulier, situation particulière, cas isolé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec03069-fd0a-4f6d-90b0-a2e40e53bb25",
                                "sense_id": "fe765174-547d-309c-b5b0-af250c05439f",
                                "text": "Das IOC sprach danach von einem Einzelfall, den Haas schrieb bei Twitter jedoch, dass er und Kollegen in den vergangenen Wochen oft bei ihrer Arbeit behindert worden seien.",
                                "translation": "Le CIO a ensuite parlé d'un cas isolé, mais Haas a écrit sur Twitter que lui et ses collègues avaient souvent été gênés dans leur travail ces dernières semaines."
                            },
                            {
                                "example_id": "3cc54d08-a345-4681-8b57-654f866d4e15",
                                "sense_id": "fe765174-547d-309c-b5b0-af250c05439f",
                                "text": "Chinas Parteiführung (...) lässt Ökonomen verschwinden, die den Ernst der Lage benennen. (...) Zhu ist kein Einzelfall, die Partei soll auch andere Ökonomen zuletzt freundlich oder weniger freundlich ermahnt haben, die Wirtschaftslage in ein gutes Licht zu rücken.",
                                "translation": "La direction du parti chinois (...) fait disparaître les économistes qui ont mis le doigt sur la gravité de la situation. (...) Zhu n'est pas un cas isolé, le parti aurait récemment exhorté, gentiment ou moins gentiment, d'autres économistes à présenter la situation économique sous un jour favorable."
                            }
                        ]
                    },
                    {
                        "sense_id": "073adb55-3064-3924-b305-6528b62fbd41",
                        "entry_id": "8d392f76-d35b-3eb2-9af0-bac2de4e424f",
                        "glosses": [
                            "Cas individuel, cas précis."
                        ],
                        "tags": [],
                        "examples": []
                    }
