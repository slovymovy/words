                "senses": [
                    {
                        "sense_id": "1d8b35a9-2c39-32e8-a1b9-b8d138868f46",
                        "entry_id": "d19c6a29-16d0-374d-bb76-d3875d3b8f2f",
                        "glosses": [
                            "Kabel, mit dessen Hilfe elektrischer Strom bei hoher Spannung transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19aa5c0f-be89-4c64-b010-1f533ef23574",
                                "sense_id": "1d8b35a9-2c39-32e8-a1b9-b8d138868f46",
                                "text": "Das Hochspannungskabel hat eine Kapazität von 1400 Megawatt und soll die Stromschwankungen in Deutschland durch zunehmenden Wind- und Sonnenstrom ausgleichen."
                            },
                            {
                                "example_id": "c08051a1-2755-4757-b2e0-778c53d8f49f",
                                "sense_id": "1d8b35a9-2c39-32e8-a1b9-b8d138868f46",
                                "text": "„Am Dienstag war die Stromversorgung in großen Teilen des Stadtteils zusammengebrochen, nachdem bei Bauarbeiten zwei Hochspannungskabel durchtrennt worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
