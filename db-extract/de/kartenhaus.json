                "senses": [
                    {
                        "sense_id": "968c2f4a-ccc3-3d86-99fa-431432143ce5",
                        "entry_id": "a312626a-f3bb-3b47-ba1a-acd776abfce9",
                        "glosses": [
                            "aus Spielkarten oder Ähnlichem errichtetes Häuschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5162cd9-b451-4d40-ba98-d1302c9f3e81",
                                "sense_id": "968c2f4a-ccc3-3d86-99fa-431432143ce5",
                                "text": "Ich habe sehr lange an diesem Kartenhaus gearbeitet."
                            },
                            {
                                "example_id": "a3f1ee4c-c97d-410c-a70b-e71fa62c28b7",
                                "sense_id": "968c2f4a-ccc3-3d86-99fa-431432143ce5",
                                "text": "„Die Tage sind überallhin gefallen, sie sind wie ein Kartenhaus zusammengefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29ef2d4d-e07a-3f29-bdca-22f010fc7557",
                        "entry_id": "a312626a-f3bb-3b47-ba1a-acd776abfce9",
                        "glosses": [
                            "zur Aufbewahrung von Seekarten dienender Raum auf der Kommandobrücke eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a489f3e8-5157-404f-ab3e-abe0353879bc",
                                "sense_id": "29ef2d4d-e07a-3f29-bdca-22f010fc7557",
                                "text": "Gestern verbrachte ich den ganzen Tag im Kartenhaus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54759829-7249-4e2c-b808-8880e84c5a21",
                        "source_entry_id": "a312626a-f3bb-3b47-ba1a-acd776abfce9",
                        "source_sense_id": "968c2f4a-ccc3-3d86-99fa-431432143ce5",
                        "source_sense_description": "aus Spielkarten oder Ähnlichem errichtetes Häuschen",
                        "target_lang_word": "house of cards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "house of cards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "600ffbcd-d94c-39e7-8785-2e73cf46e1b9",
                                        "entry_id": "4e586bda-cb15-3af8-b10d-50d00314520c",
                                        "glosses": [
                                            "A structure made by stacking playing cards in a pyramidal fashion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6253ddba-a737-3450-bd4b-f62a0c8f7eef",
                                        "entry_id": "4e586bda-cb15-3af8-b10d-50d00314520c",
                                        "glosses": [
                                            "Any structure with alternating vertical and horizontal layers."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1dc4df7-01f0-4602-ba28-fa9e69467b74",
                                                "sense_id": "6253ddba-a737-3450-bd4b-f62a0c8f7eef",
                                                "text": "The essentials of megalithic construction are either the single large slab or the large slab as walling stone with another large slab resting on two or more large walling stones as a capstone—a sort of house of cards architecture."
                                            },
                                            {
                                                "example_id": "0e9a7704-67d0-48f5-9c90-9500afe8005b",
                                                "sense_id": "6253ddba-a737-3450-bd4b-f62a0c8f7eef",
                                                "text": "Dolmens impress only by their massiveness: their house-of-cards construction is the simplest possible […]"
                                            },
                                            {
                                                "example_id": "ef42894d-f8cc-478e-b24c-90f3b05bd4d2",
                                                "sense_id": "6253ddba-a737-3450-bd4b-f62a0c8f7eef",
                                                "text": "Also, it has been proposed that lithium ions can be adsorbed on both sides of the graphene sheets that are aggregated disorderly into a “house of cards” architecture, leading to two layers of lithium for each graphene sheet […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb543bc9-b933-32e1-a948-45a112ea73a8",
                                        "entry_id": "4e586bda-cb15-3af8-b10d-50d00314520c",
                                        "glosses": [
                                            "A structure or argument built on a shaky foundation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8bd9683-77c5-466e-9d6e-75b8d761a34d",
                        "source_entry_id": "a312626a-f3bb-3b47-ba1a-acd776abfce9",
                        "source_sense_id": "968c2f4a-ccc3-3d86-99fa-431432143ce5",
                        "source_sense_description": "aus Spielkarten oder Ähnlichem errichtetes Häuschen",
                        "target_lang_word": "château de cartes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "château de cartes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9d9487-836d-34f4-a99d-c8a1da16dcd1",
                                        "entry_id": "81786e1f-0f8a-30ee-9c5e-6b8694bf136d",
                                        "glosses": [
                                            "Empilement construit avec des cartes à jouer qui s’écroule très facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835e7ebd-9271-471f-bc7d-0fdedfaf1bd7",
                                                "sense_id": "fd9d9487-836d-34f4-a99d-c8a1da16dcd1",
                                                "text": "M. Nicole était un être de quatre pieds et demi au plus, d'une maigreur étique, à demi contrefait et qui, debout, semblait un château de cartes mal étayé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "442a1714-8c94-32ba-9fd4-b2dcaeff9daa",
                                        "entry_id": "81786e1f-0f8a-30ee-9c5e-6b8694bf136d",
                                        "glosses": [
                                            "Structure fragile."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10556f04-f15e-4557-845b-b5c131aae0bc",
                                                "sense_id": "442a1714-8c94-32ba-9fd4-b2dcaeff9daa",
                                                "text": "La façon dont Donald Trump a stimulé la croissance laisse craindre que l’on se retrouve face à un château de cartes qui peut s’effondrer à tout moment."
                                            },
                                            {
                                                "example_id": "c1d1623f-813f-4b55-ab31-b38b28cd4713",
                                                "sense_id": "442a1714-8c94-32ba-9fd4-b2dcaeff9daa",
                                                "text": "Depuis, son fondateur, Adam Neumann, a démissionné de ses fonctions de PDG, et toute la société s’effondre comme un château de cartes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
