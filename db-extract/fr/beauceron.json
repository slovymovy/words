                        "glosses": [
                            "Habitant de la Beauce (autant la Beauce française que la québecoise)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50fbf378-248d-4041-a836-3cb30a28ba06",
                                "sense_id": "7a68d40d-6ef8-36ed-9cce-550ad6e1abf1",
                                "text": "« Le Solognot ne ressemble pas plus au Beauceron que la Sologne à la Beauce. » (Le Solognot, par F. Pyat.)"
                            },
                            {
                                "example_id": "875e2129-68ff-452c-84f5-661da3207d58",
                                "sense_id": "7a68d40d-6ef8-36ed-9cce-550ad6e1abf1",
                                "text": "Hier, le Beauceron a à peine mieux fait (3,6%)."
                            },
                            {
                                "example_id": "4807a2e4-f3a3-4006-941c-d3f0b3ce3854",
                                "sense_id": "7a68d40d-6ef8-36ed-9cce-550ad6e1abf1",
                                "text": "Étoile montante du circuit de la Coupe du monde ces dernières années, le Beauceron confirme ainsi qu’il fait déjà partie des meilleurs planchistes au monde à un an des Jeux olympiques."
                            }
                        ]
                    }
