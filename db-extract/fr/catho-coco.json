                        "glosses": [
                            "En même temps catholique et communiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afed31e6-bcbb-43c3-97d3-8a615ef21334",
                                "sense_id": "49ef0abc-3a87-39f0-b53e-39d7445be6f7",
                                "text": "Ici, voyez-vous, on est plutôt catho-coco."
                            },
                            {
                                "example_id": "3a494271-f1d5-4ffc-a6b6-f279750c9f48",
                                "sense_id": "49ef0abc-3a87-39f0-b53e-39d7445be6f7",
                                "text": "Francis, lui, a détesté ses parents parce qu’ils étaient tout le temps à ses basques, pour leur cohérence et pour ces éternels sermons cathos-cocos, pour tout ce qu’ils faisaient et ce qu’ils étaient, ce qu’on attend précisément d’un père et d’une mère."
                            },
                            {
                                "example_id": "96ce6ff6-fbcf-476a-8140-321e50494e8d",
                                "sense_id": "49ef0abc-3a87-39f0-b53e-39d7445be6f7",
                                "text": "Malaparte aussi a laissé un mystère, qui peut-être n’est qu’une mystification générale, celle de l’homme \"catho-coco\", ainsi qu’on disait à l'époque."
                            }
                        ]
                    }
