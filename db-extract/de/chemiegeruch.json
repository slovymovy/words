                "senses": [
                    {
                        "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                        "entry_id": "684fc3ac-b52e-3da3-aa2a-3453ef0f322e",
                        "glosses": [
                            "Wahrnehmung von unnatürlichem Geruch, der von chemischen Substanzen stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9422f242-07ea-4fce-a878-318ae8cbfb48",
                                "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                                "text": "Die Wahrnehmung unnatürliche Chemiegerüche ist immer auch ein Signal, das von Nase, aus dem Hirn und einem immensen Wissensspeicher (Erfahrung des Menschen) kommt."
                            },
                            {
                                "example_id": "949ebafb-1bb2-4e67-ac38-9f89e56d9b7f",
                                "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                                "text": "Der Chemiegeruch in öffentlichen Toiletten steigt einem immerzu in die Nase."
                            },
                            {
                                "example_id": "859d588f-7975-4498-8471-be30d09cf1e1",
                                "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                                "text": "Gott sei Dank ist in der Zapfpistole eine Absaugung installiert, damit die üblen Chemiegerüche nach Benzin oder auch Diesel direkt abgesaugt werden und sich nicht verbreiten können."
                            },
                            {
                                "example_id": "35728414-b1e4-4e64-b0bf-a38ca50c5887",
                                "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                                "text": "Gerade bei neuen Sachen sollte man den Chemiegeruch vor dem ersten Tragen ordentlich in der Waschmaschine auswaschen."
                            },
                            {
                                "example_id": "3a193a81-c56f-4890-8797-fbde22f6722b",
                                "sense_id": "9d7994cd-37fe-3ec4-8914-90a8160e64db",
                                "text": "So manches Industriegebiet liegt nicht ohne Grund fernab, denn Nachbarschaftsstreitigkeiten wegen diverser Chemiegerüche wären unvermeidbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
