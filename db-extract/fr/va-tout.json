                ],
                "senses": [
                    {
                        "sense_id": "9dc589e6-cd11-3098-a9c1-9125fa9b38c5",
                        "entry_id": "9c1b85c7-d864-3a13-a720-fab666354aad",
                        "glosses": [
                            "Coup où l’on risque tout l’argent qu’on a devant soi."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "42b1f592-fbad-4b5a-be46-0db7e600948d",
                                "sense_id": "9dc589e6-cd11-3098-a9c1-9125fa9b38c5",
                                "text": "On dit au jeu du Brelan, Va tout, faire va tout, faire un va tout, pour dire hasarder en un seul coup tout l'argent qu'on a devant soi."
                            },
                            {
                                "example_id": "9e0e1459-f19b-4903-bdae-ec7a8bdfb762",
                                "sense_id": "9dc589e6-cd11-3098-a9c1-9125fa9b38c5",
                                "text": "Faire vatout en termes de jeux, c'est faire la vade ou le renvoi de tout ce qu'on a devant soi."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cba0f88-9652-3a4b-8372-2abb1b36dc65",
                        "entry_id": "9c1b85c7-d864-3a13-a720-fab666354aad",
                        "glosses": [
                            "Tenter sa dernière chance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "04eb141c-7b90-40f5-a8aa-a5866a2e1e52",
                                "sense_id": "9cba0f88-9652-3a4b-8372-2abb1b36dc65",
                                "text": "Or, c’est mal connaître l’ancien premier ministre libéral que de penser qu’il s’en verrait le moindrement découragé. Jean Charest, le winner, est prêt à jouer son va-tout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e08442c-8ac0-4735-bc1e-f42e046e2cc6",
                        "source_entry_id": "9c1b85c7-d864-3a13-a720-fab666354aad",
                        "target_lang_word": "Vabanquespiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
