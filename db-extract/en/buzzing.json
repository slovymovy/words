                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca1ab56-cf75-4b1a-9e52-6d357a02a0e7",
                                                "sense_id": "0a9df436-096d-3868-b5f7-1c86004d915b",
                                                "text": "Или бури завываньем ты, мой друг, утомлена, или дремлешь под жужжанье своего веретена?"
                                            },
                                            {
                                                "example_id": "be67e144-88d2-4679-84a5-ac0aa695f7f1",
                                                "sense_id": "0a9df436-096d-3868-b5f7-1c86004d915b",
                                                "text": "В воздухе реяли крупные синие, зелёные и красные стрекозы, проносились с громким жужжанием чёрные и бронзовые жуки с детский кулак."
                                            },
                                            {
                                                "example_id": "ca79843e-a6fa-4476-9ba5-1eb9d3ff64b5",
                                                "sense_id": "0a9df436-096d-3868-b5f7-1c86004d915b",
                                                "text": "Из классов неслось жужжание голосов, хоровые выкрики."
                                            },
                                            {
                                                "example_id": "3dba4e99-349e-4c5b-abc5-5485cf455094",
                                                "sense_id": "0a9df436-096d-3868-b5f7-1c86004d915b",
                                                "text": "Она ныряет в комнату, и через минуту оттуда доносится жужжание электробритвы."
                                            }
                                        ]
