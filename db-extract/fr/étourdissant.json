                                "example_id": "279dc9ce-0be8-42ba-97ca-35bb349f96af",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Un bruit étourdissant."
                            },
                            {
                                "example_id": "82cd8f68-d300-477d-9f29-13b2f0923bb4",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Ces cloches sont étourdissantes."
                            },
                            {
                                "example_id": "4afed15d-91c1-4589-bb77-2981a306fbe3",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Un succès étourdissant."
                            },
                            {
                                "example_id": "5e1d00d1-fc8c-4565-a5e1-c7e2b44bbbca",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Une nouvelle étourdissante."
                            },
                            {
                                "example_id": "37e8f252-6442-416c-b3b0-fbdf82f75c0a",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Une verve étourdissante."
                            },
                            {
                                "example_id": "2ebbe22d-a4d8-48db-beaf-10d118cfb224",
                                "sense_id": "b492a75a-610d-3fe9-a803-ff8768404554",
                                "text": "Elle, pour vaincre, n’avait rien imaginé de mieux que de faire une toilette étourdissante, une robe de satin jaune, couverte de vieux point d’Alençon."
                            }
