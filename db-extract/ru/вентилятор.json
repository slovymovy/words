                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f3dc9fc-850f-3692-a021-5e08e1150725",
                        "entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "glosses": [
                            "устар. отдушина в стене для вентиляции; вентиляционная труба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab16975-6bee-4682-b5b4-1f9c990feadc",
                                "sense_id": "7f3dc9fc-850f-3692-a021-5e08e1150725",
                                "text": "В вентилятор доносился к нему шум работавшей фабрики."
                            },
                            {
                                "example_id": "188abc73-315a-4953-8a19-eedaf2e503bf",
                                "sense_id": "7f3dc9fc-850f-3692-a021-5e08e1150725",
                                "text": "Выбравшись через вытяжные вентиляторы на церковную колокольню, арестанты спустили вниз веревку, случайно попавшую в проходивший мимо патруль."
                            },
                            {
                                "example_id": "db33c604-1802-4980-a4d1-7b8a4f022d21",
                                "sense_id": "7f3dc9fc-850f-3692-a021-5e08e1150725",
                                "text": "Белеют накрытые парусиной шлюпки, блестят медные раструбы вентиляторов."
                            }
                        ]
                    },
                    {
                        "sense_id": "512a5b49-44cd-373c-ba62-40c4be61e96b",
                        "entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "glosses": [
                            "устройство для вентиляции, обычно с вращающимися лопастями, приводящими воздух в движение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0b822e-7bf0-4c48-ade5-a3185f1e2afb",
                                "sense_id": "512a5b49-44cd-373c-ba62-40c4be61e96b",
                                "text": "Сотни вентиляторов вращались на оси и мерно покачивали и крутили головой ― обмахивая первый класс."
                            }
                        ]
                    },
                    {
                        "sense_id": "a18790d7-b6f9-33ee-a4c5-5b21fb99a28f",
                        "entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "glosses": [
                            "что-либо быстро вращающееся либо находящееся в быстром циклическом движении"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e2d06e23-ac06-3ca5-8b28-5f7a648fdc9a",
                        "entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "glosses": [
                            "неол., разг."
                        ],
                        "tags": [
                            "об аппарате ИВЛ — искусственной вентиляции лёгких"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
