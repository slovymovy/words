                        "glosses": [
                            "De manière macroscopique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45090b0d-4d94-4f30-b63f-7a4ad4361531",
                                "sense_id": "8ab9a078-0a76-3d53-a9ee-269c81a93f42",
                                "text": "La triplite a été décelée dans les pegmatites et filons de quartz stannifères des régions de Kaïlo et de Kisanda. Macroscopiquement, la triplite de couleur rose (Kaïlo) à brun clair (Kisanda) possède des clivages nets."
                            },
                            {
                                "example_id": "9ae02986-0244-4566-9e82-cf41c6ce0aec",
                                "sense_id": "8ab9a078-0a76-3d53-a9ee-269c81a93f42",
                                "text": "Macroscopiquement, il s'agit d'une tumeur arrondie, bien limitée, à contours nets et à contenu mucoïde."
                            }
                        ]
                    }
                ],
