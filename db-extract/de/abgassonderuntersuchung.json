                "senses": [
                    {
                        "sense_id": "d3c8cb0f-9e45-363e-9448-8163e677fc49",
                        "entry_id": "c71a759b-18e0-3631-852e-269ce0ffc8a4",
                        "glosses": [
                            "bestimmte Untersuchung des Abgases bei speziellen Fahrzeugen"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "d1da8b9a-bc02-4403-8273-cb762b4e0cd9",
                                "sense_id": "d3c8cb0f-9e45-363e-9448-8163e677fc49",
                                "text": "„In der Bundesrepublik Deutschland wird für alle Kraftfahrzeuge mit Otto- und Wankelmotor eine regelmäßige Abgassonderuntersuchung zur Überprüfung der Abgaswerte und der Motoreinstellung eingeführt.“"
                            },
                            {
                                "example_id": "816ceab3-b399-4c09-b43e-7761d0f3f951",
                                "sense_id": "d3c8cb0f-9e45-363e-9448-8163e677fc49",
                                "text": "„Der Bundesrat stimmt einer Verordnung der Bundesregierung zu, nach der künftig auch Katalysator- und Dieselfahrzeuge in regelmäßigen Abständen zur Abgassonderuntersuchung (ASU) müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
