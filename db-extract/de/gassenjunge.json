                "senses": [
                    {
                        "sense_id": "24b1512c-acde-3c7e-a64b-56423b7cf847",
                        "entry_id": "fd02c766-8a6c-36c0-a6c7-6ccce409649a",
                        "glosses": [
                            "junge, männliche Person, die sich auffallend viel im Freien (auf der Gasse, Straße) herumtreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b1a3a2-f75c-4b8a-a259-19a9c068a252",
                                "sense_id": "24b1512c-acde-3c7e-a64b-56423b7cf847",
                                "text": "„In Rimini gab ich dem ersten Gassenjungen, dem ich begegnete, zwei Baiocchi und ließ mich zum Hause führen, in dem Teresa wohnte.“"
                            },
                            {
                                "example_id": "9eaecdf7-e3ff-4d76-b842-1564b2e822f0",
                                "sense_id": "24b1512c-acde-3c7e-a64b-56423b7cf847",
                                "text": "„Die Gassenjungen johlten hinter ihm her.“"
                            },
                            {
                                "example_id": "c6dc816f-761d-4666-961f-8ebc3714fe0d",
                                "sense_id": "24b1512c-acde-3c7e-a64b-56423b7cf847",
                                "text": "„Sobald sie am Hafen ankamen, lief ein Haufen Gassenjungen hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
