                "senses": [
                    {
                        "sense_id": "3d9a00bd-9fad-3df1-8672-1a74424379b0",
                        "entry_id": "9e385d01-e500-3725-8770-fe4c10de8b4a",
                        "glosses": [
                            "Sensory stimulation."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3550cb1-5dac-44d2-975c-280e4c4ebb1e",
                                "sense_id": "3d9a00bd-9fad-3df1-8672-1a74424379b0",
                                "text": "“Electric therapy has been used in medicine for thousands of years,” says Ken Rusche, director of Wellington Sports Medicine and Rehabilitation Center, a physical therapist and athletic trainer. “[…] Electrical stim is being used in the field of medicine for rehabilitation and strengthening after injuries. […]”"
                            }
                        ]
                    },
                    {
                        "sense_id": "51ed77c2-fdf2-32a9-a76c-72319b83d5da",
                        "entry_id": "9e385d01-e500-3725-8770-fe4c10de8b4a",
                        "glosses": [
                            "Any repetitive self-stimulatory behavior (e.g. hand flapping, head banging, repeating noises or words), frequent in autistic people."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86bb2a15-cbad-4f95-9d85-df391344c74f",
                                "sense_id": "51ed77c2-fdf2-32a9-a76c-72319b83d5da",
                                "text": "Autistic people often stim with the help of technologies such as music and stim toys or tools to mediate between inner worlds and outer environments that may over/underwhelm us."
                            }
                        ]
                    },
                    {
                        "sense_id": "baf6cfde-a129-3d65-9250-11530bc561bc",
                        "entry_id": "9e385d01-e500-3725-8770-fe4c10de8b4a",
                        "glosses": [
                            "Any drug that stimulates a woman's ovaries to produce eggs."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d23ddd3d-9d33-47c3-9d4a-3a4a353f2865",
                        "source_entry_id": "9e385d01-e500-3725-8770-fe4c10de8b4a",
                        "source_sense_description": "repetitive self-stimulatory action",
                        "target_lang_word": "autostimulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autostimulation",
