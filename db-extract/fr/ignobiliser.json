                "senses": [
                    {
                        "sense_id": "ce67c02c-5e51-367d-b559-664e23f67380",
                        "entry_id": "3be5d45e-0995-334a-b31b-26c6aff250a3",
                        "glosses": [
                            "Donner un caractère ignoble (non noble) à."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "82d9eaa9-0a88-4689-8784-41860c10eefa",
                                "sense_id": "ce67c02c-5e51-367d-b559-664e23f67380",
                                "text": "Le feu me montait aux joues, et je sentais des étincelles de colère électriser mes cheveux rien qu’à la pensée de ces calomnies des pamphlets parlementaires sous la Régence, qui allaient jusqu’à ignobiliser mon origine."
                            },
                            {
                                "example_id": "3fd21c07-584c-4245-bdba-81c479f6f2d4",
                                "sense_id": "ce67c02c-5e51-367d-b559-664e23f67380",
                                "text": "Non content d’ôter à Charles-Martel la gloire, si peu disputée jusqu’à présent, d’avoir repoussé les Sarrasins, il se complaît à ignobiliser son nom, qu’il traduit par Karl—Marteau ;"
                            }
                        ]
                    }
                ],
