                        "sense_id": "473b6143-f9cc-34bb-8930-d853b1b1a4a7",
                        "entry_id": "3b4ca148-b1b3-3699-8a63-3f6bcc095672",
                        "glosses": [
                            "Celle qui participe à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d35372-5775-4373-b32a-23933b1d4778",
                                "sense_id": "473b6143-f9cc-34bb-8930-d853b1b1a4a7",
                                "text": "C’est une règle qui peut être rappelée a chaque cercle et à chaque fois qu’une participante l’enfreint."
                            },
                            {
                                "example_id": "e2d54ced-c1df-4ac5-b133-35be9098c1b0",
                                "sense_id": "473b6143-f9cc-34bb-8930-d853b1b1a4a7",
                                "text": "De jeudi à samedi, 108 participantes tenteront de remporter la 32ᵉ édition de l’épreuve, dont la tenante du titre, Céline Boutier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
