                                "target_senses": [
                                    {
                                        "sense_id": "36f283f9-f682-3650-9dbd-3f4033c75fe7",
                                        "entry_id": "1ca85fc1-f169-3e9b-9e07-4e61ade6f208",
                                        "glosses": [
                                            "To confine (someone) to a straitjacket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984d38f0-bbc6-4c59-b513-b7846bcffffa",
                                                "sense_id": "36f283f9-f682-3650-9dbd-3f4033c75fe7",
                                                "text": "‘None of your gab, I tell you! If you speak another word, I'll have you jacketed[…]!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                        "entry_id": "1ca85fc1-f169-3e9b-9e07-4e61ade6f208",
                                        "glosses": [
                                            "To enclose or encase in a jacket or other covering."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf98cd7f-8834-4d6c-9650-c7b9da29ca7f",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "...to...prevent...the loss of heat...there is also a layer of silicate cotton or slag wool. This latter material is also employed to jacket the chimney for a certain portion of its length."
                                            },
                                            {
                                                "example_id": "4ade6554-b515-4a00-b654-a9db1fc95a3b",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "By jacketting the mercury tube determinations can be made at any temperature desired."
                                            },
                                            {
                                                "example_id": "817487d4-c99c-4f4b-937e-150033423e20",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "By jacketting the rod and putting the whole resonant-bar device in a pressure vessel, the intrinsic attenuation can be measured under helium confining pressure."
                                            },
                                            {
                                                "example_id": "4cbbb956-fbce-4a23-8c2c-08b85f269d3a",
                                                "sense_id": "ec2cc643-b7a8-3905-9cfb-a47591d6bd8e",
                                                "text": "Jaw has been exposed for preserving and jacketting. Note other bone fragments near jaw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04cf495-6ae7-44f4-b99a-5ae6daac1521",
