                                        "glosses": [
                                            "узкая полоса, линия, как правило, прямая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002ef48b-fc7e-4036-b02c-140201097519",
                                                "sense_id": "68783b06-6935-3ab9-a3bd-c3e0eb23be78",
                                                "text": "Нарисовать черту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8adb88d-453a-3211-bbfa-188379938548",
                                        "entry_id": "2ed48934-126a-3246-b69f-aea3a57a3c2b",
                                        "glosses": [
                                            "перен., ед. ч. рубеж, граница, предел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c17a8d-1400-4a79-b1cf-3d56fd82a6bd",
                                                "sense_id": "c8adb88d-453a-3211-bbfa-188379938548",
                                                "text": "В черте города. За чертой города. Зайти за черту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b8e72c-0785-3a80-bd4d-7b23c78b3a21",
                                        "entry_id": "2ed48934-126a-3246-b69f-aea3a57a3c2b",
                                        "glosses": [
                                            "перен., мн. ч. особенности формы, очертания, контуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecd2802-3c31-4e5b-9067-6e010207f80c",
                                                "sense_id": "97b8e72c-0785-3a80-bd4d-7b23c78b3a21",
                                                "text": "Правильные черты лица."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cff78b-19d7-36b6-a4e2-fcb84bfa5487",
                                        "entry_id": "2ed48934-126a-3246-b69f-aea3a57a3c2b",
                                        "glosses": [
                                            "перен. характерный признак, отличительная особенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e332aac-0c72-4bb8-8cde-466a10086702",
                                                "sense_id": "d0cff78b-19d7-36b6-a4e2-fcb84bfa5487",
                                                "text": "Но гла́вная фи́рменная черта́ журна́ла ― профессиона́льная, хладнокро́вная кри́тика."
                                            },
                                            {
                                                "example_id": "5811e81b-dd15-419f-9ae7-5564aab8c466",
                                                "sense_id": "d0cff78b-19d7-36b6-a4e2-fcb84bfa5487",
                                                "text": "У Люды появи́лась стра́нная черта́: она́ начала́ сори́ть де́ньга́ми."
                                            }
                                        ]
                                    }
                                ]
                            },
