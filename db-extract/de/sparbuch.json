                    {
                        "sense_id": "a4b1f40a-255a-32d3-8141-25c00af92ff1",
                        "entry_id": "e2f8654c-df71-359f-8477-3f12349fda8e",
                        "glosses": [
                            "eine Geldanlagemöglichkeit, Geldprodukt bei Banken, welche sich im Besitz des Sparers befindet und in das das Geldinstitut eingezahlte oder abgehobene Geldbeträge sowie die Verzinsung einträgt"
                        ],
                        "tags": [
                            "Finanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "de44230e-27dd-4f0d-a7b4-d61cf0ae8fb9",
                                "sense_id": "a4b1f40a-255a-32d3-8141-25c00af92ff1",
                                "text": "Ich habe 1000 Euro auf mein Sparbuch eingezahlt."
                            },
                            {
                                "example_id": "43ba5ed7-b939-4171-b22d-f83147f71f16",
                                "sense_id": "a4b1f40a-255a-32d3-8141-25c00af92ff1",
                                "text": "„Diese wurden auf ein Sparbuch gelegt.“"
                            },
                            {
                                "example_id": "fae33b04-be41-4041-b71a-c156488d2990",
                                "sense_id": "a4b1f40a-255a-32d3-8141-25c00af92ff1",
                                "text": "„Er bekommt einen doppelten Boden, unter dem unsere Sparbücher verschwinden, außerdem alles Geld, das wir aus der eisernen Gutskasse noch besitzen: 8400 Reichsmark.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9255a75a-b1a5-3f17-9ba5-f9737da9961d",
                        "entry_id": "e2f8654c-df71-359f-8477-3f12349fda8e",
                        "glosses": [
                            "eine Urkunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
