                        "glosses": [
                            "hohe, senkrechte, pfeilerähnliche Stange, die eine elektrische Oberleitung trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333db1ed-b5d4-4b06-916d-13e7a0222821",
                                "sense_id": "ae6986d7-eceb-3034-8eac-67748b889e35",
                                "text": "„Wie die Polizei mitteilte, sei ein gegen 0.15 Uhr auf der Mahlsdorfer Straße ein Auto, das in Richtung Hultschiner Damm unterwegs war, nach links von der Fahrbahn abgekommen und gegen einen Oberleitungsmast der Straßenbahn geprallt.“"
                            },
                            {
                                "example_id": "8d06cedc-77d3-49e5-9a28-ccf723de0aa8",
                                "sense_id": "ae6986d7-eceb-3034-8eac-67748b889e35",
                                "text": "„Durch die Wucht des Aufpralls drückte die Bahn einen Oberleitungsmasten schief.“"
                            }
                        ],
