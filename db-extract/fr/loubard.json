                "senses": [
                    {
                        "sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
                        "entry_id": "06fdcd76-e916-3aca-8d16-fd3362b9ab52",
                        "glosses": [
                            "Jeune au comportement marginal, ressenti comme une menace, un danger et souvent effectivement délinquant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f8dec8-9e5b-4541-9101-eaed35d2a268",
                                "sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
                                "text": "J’suis un loubard parmi tant d’autres\nJe crèche pas loin de la Défense\nJ’ai l’air crado, c’est pas ma faute\nMon HLM, c’est pas Byzance\nMon pote, mon pote."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "143b2039-d8a4-418e-bf94-229206cf3e0d",
                        "source_entry_id": "06fdcd76-e916-3aca-8d16-fd3362b9ab52",
                        "source_sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
                        "target_lang_word": "Rowdy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rowdy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fcc8fa6-d10b-3eb2-a6c0-5cabe4d71bf6",
                                        "entry_id": "425e1dfe-1ac7-3d6c-ab0f-be015b164bdc",
                                        "glosses": [
                                            "Mensch, der sich übermäßig grob und gewalttätig aufführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cbe46d-218a-4256-8746-e3c9b3580871",
                                                "sense_id": "6fcc8fa6-d10b-3eb2-a6c0-5cabe4d71bf6",
                                                "text": "„Ein anderes Mädchen tänzelt im Brooklyner Zwielicht vorüber, und Riesel, dieser Rowdy, stelzt hinter ihr her und bewegt sich wie ein Affe.“"
                                            },
                                            {
                                                "example_id": "4271ccc1-afc0-46af-a694-79a4a4ab68fb",
                                                "sense_id": "6fcc8fa6-d10b-3eb2-a6c0-5cabe4d71bf6",
                                                "text": "„Meyer der Blinde war der Anführer der Rowdys dieser Gegend, eine Art Rabbi der Rabauken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1455eeff-cd89-4ff4-b376-935232407400",
                        "source_entry_id": "06fdcd76-e916-3aca-8d16-fd3362b9ab52",
                        "source_sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
                        "target_lang_word": "chav",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chav",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64c9516e-c3ee-35a8-9337-313c463469d2",
                                        "entry_id": "248b8222-1a57-3e87-9dce-cf29e4c5f5dc",
                                        "glosses": [
                                            "A working-class youth, especially one associated with aggression, poor education, and a perceived \\\"common\\\" taste in clothing and lifestyle."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Multicultural-London-English",
                                            "UK",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03fcdba8-b27b-4623-91d0-0735cadee657",
                                                "sense_id": "64c9516e-c3ee-35a8-9337-313c463469d2",
                                                "text": "Lyrical staff / Never could they ever take me for a chav / Scholar in the English, scholar in the Math / Dizzee ain't no riff raff"
                                            },
                                            {
                                                "example_id": "0ab5890d-1cfc-46f3-bd81-4e71659aa105",
                                                "sense_id": "64c9516e-c3ee-35a8-9337-313c463469d2",
                                                "text": "His book concerns ‘chavs’, a supposed underclass of ill-educated, fast-breeding, violent and amoral poor people currently plaguing Britain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c93054ee-2e98-4857-acac-a88059573563",
                        "source_entry_id": "06fdcd76-e916-3aca-8d16-fd3362b9ab52",
                        "source_sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
                        "target_lang_word": "gemeen volk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5925a7ed-106e-4d7f-ad52-7af135b1626d",
                        "source_entry_id": "06fdcd76-e916-3aca-8d16-fd3362b9ab52",
                        "source_sense_id": "f4f5cadb-1dd4-327c-931e-93e56d02b299",
