                ],
                "senses": [
                    {
                        "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                        "entry_id": "54e7c04c-1a73-3331-8e84-434c8601937f",
                        "glosses": [
                            "Gruppe von Unternehmen, die nah verwandte Produkte, Güter, Waren und Dienstleistungen herstellen und anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5993781c-a49b-4f1e-bfd4-e097288e7790",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Die größte Industriebranche Hessens erwartet für das Jahr 2020 Milliardenverluste.“"
                            },
                            {
                                "example_id": "cbae0c52-0dc5-488f-b010-3959c5a9b6bd",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Gleichwohl schauen viele Firmen aus der umsatzstärksten Industriebranche in Hessen (siehe Kasten) eher pessimistisch in die nähere Zukunft.“"
                            },
                            {
                                "example_id": "7ca54af9-4ac6-4302-b450-148b9df99209",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Das Gros der akademischen Fach- und Führungskräfte arbeitet nach eigenen Angaben vierzig bis fünfzig Stunden in der Woche – jedenfalls in der drittgrößten deutschen Industriebranche, der Chemie- und Pharmabranche.“"
                            },
                            {
                                "example_id": "ceb8090a-5854-4ff7-abf0-f52a758d42c3",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Die größte deutsche Industriebranche scheint immun gegen Dollar-Schwäche, teure Rohstoffe und drohende Flaute zu sein.“"
                            },
                            {
                                "example_id": "89a3781d-8cb0-430c-850e-c4e66b7e4195",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Ich kann mir nicht vorstellen, dass diese wichtigste deutsche Industriebranche in einem Konjunkturprogramm nicht berücksichtigt würde.“"
                            },
                            {
                                "example_id": "20146904-de05-4c14-a160-739ba4774738",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Doch unterbelichtet bleibt dabei meist eine Industriebranche mit beeindruckender Strahlkraft: die Luxuswaren-Hersteller.“"
                            },
                            {
                                "example_id": "8f973224-e059-4a01-9761-c4e1ce23ed16",
                                "sense_id": "cf6f768c-3d74-388c-baa1-6772efaccf5c",
                                "text": "„Damit ist die gute Nachricht verbunden, daß die von der Zahl der Beschäftigten her wichtigste Industriebranche in Deutschland sogar Arbeitsplätze in diesem Jahr schafft, und zwar im Saldo mindestens 4000, ein Anstieg auf mehr als 870000 Stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
