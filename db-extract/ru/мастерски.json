                                        "entry_id": "79e932ed-e5a6-32a9-a8d9-edb884b77351",
                                        "glosses": [
                                            "In an expert manner; with great skill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09661c2-4e81-4341-ba27-08942429b515",
                                                "sense_id": "12826786-c012-3c72-ad29-38432345fe62",
                                                "text": "This time Cudicini was left helpless when Natcho stepped up to expertly curl the ball into the top corner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
