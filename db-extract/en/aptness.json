                        ],
                        "examples": [
                            {
                                "example_id": "b25a0689-dfd5-4be6-9ec1-1b55e7148d02",
                                "sense_id": "ca9fe1b4-7719-3ad0-b543-111b4557d5e8",
                                "text": "A regular supply of coking slack is sent from Durham to the Scunthorpe area, in view of its special aptness for steelmaking processes, [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ee571ca-0da1-3b30-b9ac-687a9a8dd7cd",
                        "entry_id": "afe95c57-e882-3f0a-9268-3287674f53c8",
                        "glosses": [
                            "Disposition of the mind; propensity."
