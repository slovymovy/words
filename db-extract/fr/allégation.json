                                "target_senses": [
                                    {
                                        "sense_id": "4ed3f80d-67ce-3a15-9fd0-b04b30fb0a84",
                                        "entry_id": "52c7b92f-77b9-339a-8cca-fa6b225bd0e3",
                                        "glosses": [
                                            "An assertion, especially an accusation, not necessarily based on facts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c79804c-470c-4e9f-b83a-d9bc31c9cc06",
                                                "sense_id": "4ed3f80d-67ce-3a15-9fd0-b04b30fb0a84",
                                                "text": "She put forth several allegations regarding her partner in hopes of discrediting his actions."
                                            },
                                            {
                                                "example_id": "1cee66e6-aa8d-4c24-b628-495d9d0402dc",
                                                "sense_id": "4ed3f80d-67ce-3a15-9fd0-b04b30fb0a84",
                                                "text": "A spokesman for Lothian and Borders Police said: \"We can confirm that a 15-year-old boy has been arrested and charged in connection with the murder of Jodi Jones. A 45-year-old has also been arrested in connection with allegations of attempting to pervert the course of justice. A report on this has been sent to the procurator fiscal.\""
                                            },
                                            {
                                                "example_id": "b698f95a-4a53-4b80-81fe-1cd49d6f94d8",
                                                "sense_id": "4ed3f80d-67ce-3a15-9fd0-b04b30fb0a84",
                                                "text": "Philip Miles, defending, said: \"This was a single instance, there was no allegation of continuing behaviour over a long period of time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311e63df-ae43-306e-b013-427743f534e0",
