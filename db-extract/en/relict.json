                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1fadd14-5705-35ee-8d67-94d9aeb7af12",
                        "entry_id": "3ff604f5-4c94-3bfe-a53f-fd181214114d",
                        "glosses": [
                            "Witwe"
                        ],
                        "tags": [],
