                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его пламенная речь вызвала настоящее <w>воспаление</w> умов среди слушателей.",
                            "target_lang_translations": {
                                "en": "His fiery speech caused a real <w>agitation</w> of minds among the listeners.",
                                "nl": "Zijn vurige toespraak veroorzaakte een ware <w>verhitheid</w> onder de toehoorders.",
                                "pl": "Jego płomienna przemowa wywołała prawdziwe <w>pobudzenie</w> umysłów wśród słuchaczy.",
                                "de": "Seine flammende Rede löste eine echte <w>Aufregung</w> unter den Zuhörern aus.",
                                "fr": "Son discours enflammé a provoqué une véritable <w>agitation</w> des esprits parmi les auditeurs.",
                                "it": "Il suo discorso infuocato ha causato una vera <w>agitazione</w> tra gli ascoltatori.",
                                "cs": "Jeho plamenný projev vyvolal mezi posluchači skutečné <w>rozrušení</w> myslí.",
                                "tr": "Onun ateşli konuşması, dinleyiciler arasında gerçek bir <w>heyecan</w> yarattı.",
                                "es": "Su apasionado discurso provocó una verdadera <w>agitación</w> mental entre los oyentes.",
                                "zh": "他那慷慨激昂的演讲在听众中引起了真正的<w>激动</w>。"
                            }
                        },
                        {
                            "text": "В состоянии крайнего <w>воспаления</w> он не мог мыслить логически.",
                            "target_lang_translations": {
                                "en": "In a state of extreme <w>agitation</w>, he could not think logically.",
                                "nl": "In een staat van extreme <w>opwinding</w> kon hij niet logisch nadenken.",
                                "pl": "W stanie skrajnego <w>pobudzenia</w> nie potrafił logicznie myśleć.",
                                "de": "In einem Zustand extremer <w>Erregung</w> konnte er nicht logisch denken.",
                                "fr": "Dans un état d'<w>exaltation</w> extrême, il ne pouvait pas penser logiquement.",
                                "it": "In uno stato di estrema <w>agitazione</w>, non riusciva a pensare in modo logico.",
                                "cs": "Ve stavu krajního <w>rozrušení</w> nedokázal logicky myslet.",
                                "tr": "Aşırı bir <w>heyecan</w> durumunda mantıklı düşünemiyordu.",
                                "es": "En un estado de <w>excitación</w> extrema, no podía pensar con lógica.",
                                "zh": "在极度<w>亢奋</w>的状态下，他无法进行逻辑思考。"
                            }
