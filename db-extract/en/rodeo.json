                                        "entry_id": "6df6fcab-236e-3e1e-9cf8-3ad9129c7f9c",
                                        "glosses": [
                                            "vor allem in Nordamerika verbreitete Sportart, bei der die Sportler unter anderem Fähigkeiten im Reiten von wilden Pferden oder Stieren zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014c2f80-9fb2-4163-b2ce-a05c8ee1227b",
                                                "sense_id": "b3f5c571-abbf-39c0-b3ce-f085b9507f23",
                                                "text": "„Drinnen auf der Tribüne beim Rodeo, wackelten die Balken und die Bretter. Die Männer brüllten und rochen nach Bier und Schweiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78256b90-cd93-35b8-a9f1-8c30903cc6db",
                                        "entry_id": "6df6fcab-236e-3e1e-9cf8-3ad9129c7f9c",
                                        "glosses": [
                                            "das Zusammentreiben des Viehs"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7845a10a-90c2-4ffb-93e2-b715c3d25301",
                                                "sense_id": "78256b90-cd93-35b8-a9f1-8c30903cc6db",
                                                "text": "Rodeo ist das Zusammentreiben frei weidender Viehherden in einen eingefriedigten Platz, um sie zu sondern, zu zählen und zu zeichnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
