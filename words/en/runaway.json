{
    "word_family": [
        "run"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ff18b44-462b-3403-bc79-c560ffaaae59",
                    "sense_definition": "Moving or accelerating out of control",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "out_of_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>runaway</w> train sped down the tracks without a driver.",
                            "target_lang_translations": {
                                "ru": "<w>Неуправляемый</w> поезд мчался по путям без машиниста."
                            }
                        },
                        {
                            "text": "Scientists are worried about the <w>runaway</w> greenhouse effect on our climate.",
                            "target_lang_translations": {
                                "ru": "Ученые обеспокоены <w>бесконтрольным</w> парниковым эффектом, влияющим на наш климат."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontrolled",
                        "unrestrained"
                    ],
                    "common_phrases": [
                        "runaway train"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся или ускоряющийся без контроля"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуправляемый",
                                "target_lang_sense_clarification": "о технике или процессах, вышедших из-под контроля"
                            },
                            {
                                "target_lang_word": "бесконтрольный",
                                "target_lang_sense_clarification": "о процессах, которые невозможно остановить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb2e12b3-bf28-3274-adb8-3cdff1a661ce",
                    "sense_definition": "Unchecked or rampant",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "out_of_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is struggling to control <w>runaway</w> inflation.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается справиться со <w>стремительной</w> инфляцией."
                            }
                        },
                        {
                            "text": "High interest rates are needed to stop <w>runaway</w> prices.",
                            "target_lang_translations": {
                                "ru": "Высокие процентные ставки необходимы, чтобы остановить <w>необузданный</w> рост цен."
                            }
                        }
                    ],
                    "synonyms": [
                        "unchecked",
                        "rampant"
                    ],
                    "antonyms": [
                        "controlled"
                    ],
                    "common_phrases": [
                        "runaway inflation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несдерживаемый или стремительно растущий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремительный",
                                "target_lang_sense_clarification": "о быстром росте цен или инфляции"
                            },
                            {
                                "target_lang_word": "необузданный",
                                "target_lang_sense_clarification": "о процессах, которые невозможно сдержать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33aa487f-c588-34e0-b8b4-a2d6a857ff3d",
                    "sense_definition": "Having escaped from a place or person",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escaped",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police are searching for the <w>runaway</w> prisoner.",
                            "target_lang_translations": {
                                "ru": "Полиция ищет <w>беглого</w> заключенного."
                            }
                        },
                        {
                            "text": "The farmer caught the <w>runaway</w> horse in the field.",
                            "target_lang_translations": {
                                "ru": "Фермер поймал <w>сбежавшую</w> лошадь в поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "escaped",
                        "fugitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбежавший из какого-либо места или от кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беглый",
                                "target_lang_sense_clarification": "о человеке или животном, совершившем побег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd55d0a8-bfaa-37c2-a762-36eda8b5e92c",
                    "sense_definition": "Easily won or achieved",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate celebrated a <w>runaway</w> victory in the election.",
                            "target_lang_translations": {
                                "ru": "Кандидат отпраздновал <w>убедительную</w> победу на выборах."
                            }
                        },
                        {
                            "text": "It was a <w>runaway</w> success for the new movie.",
                            "target_lang_translations": {
                                "ru": "Это был <w>безоговорочный</w> успех для нового фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "landslide"
                    ],
                    "common_phrases": [
                        "runaway victory",
                        "runaway success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко выигранный или достигнутый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убедительный",
                                "target_lang_sense_clarification": "о легкой и полной победе"
                            },
                            {
                                "target_lang_word": "безоговорочный",
                                "target_lang_sense_clarification": "о полном успехе или победе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3303a77f-93fa-3745-8412-74304f923be4",
                    "sense_definition": "A person or animal that has escaped from captivity or home",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escaped",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelter provides support for every young <w>runaway</w>.",
                            "target_lang_translations": {
                                "ru": "Приют оказывает поддержку каждому юному <w>беглецу</w>."
                            }
                        },
                        {
                            "text": "The dog was a <w>runaway</w> that had been missing for weeks.",
                            "target_lang_translations": {
                                "ru": "Эта собака была <w>беглой</w> и отсутствовала несколько недель."
                            }
                        }
                    ],
                    "synonyms": [
                        "fugitive",
                        "escapee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, сбежавшее из неволи или из дома"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беглец",
                                "target_lang_sense_clarification": "человек, совершивший побег"
                            },
                            {
                                "target_lang_word": "беглый",
                                "target_lang_sense_clarification": "животное, которое сбежало"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adeb0ef1-78e2-34e4-ab16-dcc7f85e4eb4",
                    "sense_definition": "An overwhelming or easy victory",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team won the championship in a <w>runaway</w>.",
                            "target_lang_translations": {
                                "ru": "Команда выиграла чемпионат с <w>разгромным</w> преимуществом."
                            }
                        },
                        {
                            "text": "The election result was a complete <w>runaway</w> for the incumbent.",
                            "target_lang_translations": {
                                "ru": "Результат выборов стал полным <w>триумфом</w> для действующего лица."
                            }
                        }
                    ],
                    "synonyms": [
                        "landslide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавляющая или легкая победа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромная победа",
                                "target_lang_sense_clarification": "очень легкая и полная победа"
                            },
                            {
                                "target_lang_word": "триумф",
                                "target_lang_sense_clarification": "блестящий успех"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}