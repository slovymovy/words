                "translations": [
                    {
                        "translation_id": "76899978-359c-4c2f-b06d-cbb0487b5ea4",
                        "source_entry_id": "39294858-cc12-3aaf-aa4a-4fa016dd707f",
                        "source_sense_description": "to remove the harness from a horse, etc.",
                        "target_lang_word": "débrider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débrider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Débarrasser de la bride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1da45ca-e4b5-4033-8418-f92616fa8316",
                                                "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                                "text": "Il ne faut pas encore débrider ce cheval."
                                            },
                                            {
                                                "example_id": "5167ecee-e693-4b67-8e97-50483e1250eb",
                                                "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                                "text": "— Si je ne la débridais pas, elle casserait tout.\nFanchon, débarrassée de la bride et même de la selle que son maître lui enleva lestement, alla flairer et saluer, d’un hennissement amical, sa paisible hôtesse, la jument du métayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25be7e4a-5933-34f2-b24b-0704058ce29a",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Ôter le dispositif qui bride la vitesse d'un moteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b21fc3f2-d6d4-3d24-b491-125a8d0f3982",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Se donner un temps de repos, cesser un mouvement."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a2f208-4e77-4d17-9e83-ba028c626e7d",
                                                "sense_id": "b21fc3f2-d6d4-3d24-b491-125a8d0f3982",
                                                "text": "Il est temps de débrider. - La cavalerie venait de débrider, quand tout à coup on vit paraître les ennemis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca9546d-9058-3988-8faf-31e8d3bf3131",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Dégager ce qui est serré."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4cd082e-2277-3326-8dce-89535c485afb",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Couper les fils avec lesquels on avait attaché les membres d'une volaille, pour la faire cuire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3386f6-4e2d-4c6f-8a0b-addb24fdfd5c",
                                                "sense_id": "c4cd082e-2277-3326-8dce-89535c485afb",
                                                "text": "Au moment de servir, déballez, débridez et dressez; passez à l’étamine le jus égoutté, ajoutez-le à une sauce financière demi-liée, et saucez les perdreaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b5d6e3-a4d8-3641-b3f5-62c5fc142bb9",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Dégager une charge du câble qui a servi à la hisser."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Couper les brides ou filaments d'une suture, qui empêchent l’écoulement du pus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d5cd05-4415-4c85-a910-d41edd44bb08",
                                                "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                                "text": "Pour prévenir le moindre soupçon, je lui tendis la lettre ; mais il affecta de ne point la lire, et comme s’il eût décidé que le moment était venu de me parler raison et de débrider largement une plaie qui languissait sans résultat : […]"
                                            },
                                            {
                                                "example_id": "7993622c-7acc-40bf-9743-ae9f231a7777",
                                                "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                                "text": "Les choses n'iront pas plus loin, mais la soirée sera gâchée par une lancinante impression d'abcès non débridé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96cc361d-3001-3fff-9030-d57a8cb89ccd",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Contourner les protections d’un système pour supprimer les restrictions d’utilisation mises en place par le constructeur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Agir sans retenue."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071166c7-3fa8-430d-8659-d72b08896a93",
                                                "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                                "text": "Ils mangent et boivent, font ripaille, remuent leurs membres, embrassent les filles, sonnent les cloches, s'emplissent de bruit : rudes bacchanales où l'homme se débride, et qui sont la consécration de la vie naturelle : les puritains ne s'y sont pas trompés."
                                            },
                                            {
                                                "example_id": "7ef15700-70cb-4610-ab91-1f45ab09d3ec",
                                                "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                                "text": "Et durant deux grandes heures, je travaillai à mon drame, écrivant sans débrider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33e6607d-55e6-4a53-a6b0-0d484f6b5508",
                        "source_entry_id": "39294858-cc12-3aaf-aa4a-4fa016dd707f",
                        "source_sense_description": "to remove the harness from a horse, etc.",
                        "target_lang_word": "dételer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dételer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Détacher une bête de trait d’une voiture, d’une charrue ou de tout autre engin à traction animale à laquelle elle était attelée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9eb34c6-a250-4b9c-beb7-5d46b6ff44d5",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Peu à peu les canots regagnèrent la plage, les charrettes furent dételées, les bêtes de somme renfermées dans les parcs, […]."
                                            },
                                            {
                                                "example_id": "bd329e8e-1176-4696-b813-5371a24dc569",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Il fut un peu surpris de voir, stationnant sur la grande route, un immense break, dont les chevaux avaient été dételés et emmenés."
                                            },
                                            {
                                                "example_id": "eeb177da-cba1-4790-b497-11fe1a1ca916",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Le même après-midi, à l’heure où l’on dételait les bœufs de la charrue, douze femmes sortirent de la maison du fiancé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Cesser un travail, une occupation (intellectuelle ou manuelle)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da1709c-22b4-45dc-8420-0dd55b09c40c",
                                                "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                                "text": "Bon, assez travaillé, maintenant on va dételer !"
                                            },
                                            {
                                                "example_id": "ec88c171-64d2-484b-b4ef-8404cb8a65c1",
                                                "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                                "text": "Il est l’heure, il faut dételer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Renoncer à une activité malhonnête, renoncer à certains plaisirs."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f929ee4-4588-4481-9455-a41087691ed9",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "Environ trois ans après le mariage d’Hortense, en 1841, le baron Hulot d’Ervy passait pour s’être rangé, pour avoir dételé, selon l’expression du premier chirurgien de Louis XV, et madame Marneffe lui coûtait cependant deux fois plus que ne lui avait coûté Josépha."
                                            },
                                            {
                                                "example_id": "268d2e65-9805-4498-b2cb-a0846c82cf90",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "– Mais enfin, pourquoi ?… Une femme de mon tempérament n’a pas encore dételé, à cinquante-quatre ans.\n– Detélé ! Quelle expression ! Si Riquet vous entendait…"
                                            },
                                            {
                                                "example_id": "caa1e86e-19d1-40bf-a30c-98804baa6c52",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "Je n'en veux pas à mon oncle, seulement je trouve drôle que mon conseil de famille, qui s'est toujours montré si sévère pour moi, soit composé précisément des parents qui ont le plus fait la bombe, à commencer par le plus noceur de tous, mon oncle Charlus, qui est mon subrogé tuteur, qui a eu autant de femmes que don Juan et qui à son âge ne dételle pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
