{
    "word_family": [
        "bouffonnerie",
        "bouffonner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                    "sense_definition": "Personne stupide, ridicule ou méprisable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de te comporter comme un <w>bouffon</w> devant tout le monde."
                        },
                        {
                            "text": "Ne fais pas attention à cet individu, c'est juste un sale <w>bouffon</w>."
                        }
                    ],
                    "common_phrases": [
                        "espèce de bouffon"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme péjoratif et familier"
                        }
                    ]
                },
                {
                    "sense_id": "7210aed4-ca0c-3136-8f11-15160abbaaca",
                    "sense_definition": "Personnage dont la fonction officielle était de faire rire et divertir un souverain ou une cour noble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metier_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bouffon</w> du roi était le seul qui pouvait critiquer le monarque sans être puni."
                        },
                        {
                            "text": "Autrefois, chaque grand seigneur avait son <w>bouffon</w> pour divertir ses invités lors des banquets."
                        }
                    ],
                    "synonyms": [
                        "fou"
                    ],
                    "common_phrases": [
                        "bouffon du roi",
                        "bouffon de cour"
                    ]
                },
                {
                    "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                    "sense_definition": "Personne qui cherche constamment à amuser les autres par des plaisanteries et des pitreries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "farceur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore faire le <w>bouffon</w> en classe pour attirer l'attention de ses camarades."
                        },
                        {
                            "text": "Ce garçon est un vrai <w>bouffon</w> qui trouve toujours une blague à raconter."
                        }
                    ],
                    "synonyms": [
                        "clown",
                        "farceur",
                        "pitre"
                    ],
                    "common_phrases": [
                        "faire le bouffon"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                    "sense_definition": "Qui suscite le rire par un caractère outrancier, ridicule ou grotesque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dispute sans gravité a rapidement tourné en une situation <w>bouffonne</w>."
                        },
                        {
                            "text": "Le ministre s'est retrouvé au milieu d'un quiproquo aux allures tout à fait <w>bouffonnes</w>."
                        }
                    ],
                    "synonyms": [
                        "bouffe",
                        "grotesque"
                    ],
                    "common_phrases": [
                        "situation bouffonne"
                    ]
                },
                {
                    "sense_id": "7bc73345-27d5-3329-9ab8-1e39c27b1b7e",
                    "sense_definition": "Qui relève d'un comique excessif, burlesque ou farcesque dans une œuvre littéraire ou artistique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La troupe présente ce soir une comédie au ton résolument <w>bouffon</w>."
                        },
                        {
                            "text": "Ce dramaturge s'est illustré dans le registre <w>bouffon</w> durant toute sa carrière."
                        }
                    ],
                    "common_phrases": [
                        "opéra bouffon",
                        "genre bouffon"
                    ]
                }
            ]
        }
    ]
}