                "senses": [
                    {
                        "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                        "entry_id": "041ab726-19fc-34ee-81b7-e1720fc7133f",
                        "glosses": [
                            "Person, welche die Welt realistischerweise so sieht, wie sie ist, und danach spricht und handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b33222d-8adc-421c-8c59-98d88d4960fd",
                                "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                                "text": "„Kühlen Kopf bewahren - ein Beispiel: Dick Keyser, Chairman und CEO der WW Grainger Inc., ist das wandelnde Beispiel eines Klardenkers. 1995, als er zum CEO des globalen Zulieferers für Industriebetriebe ernannt wurde, dachte jeder, dass der gesamte Geschäftszweig vom Internet ausgehöhlt werden würde. Keyser glaubte das nicht.“"
                            },
                            {
                                "example_id": "1c8c41a8-0468-4041-a06e-291d810c205e",
                                "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                                "text": "„Durch gezielte Falschinformation lassen sich unbequeme Klardenker sehr schnell diffamieren.“"
                            },
                            {
                                "example_id": "fbe6e637-6b7d-47e1-be07-36212bd530bd",
                                "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                                "text": "„Beide sind sie nüchterne, realistische Klardenker, Zyniker und rücksichtslose Jünger Machiavells.“"
                            },
                            {
                                "example_id": "68c7f4a3-2fd3-4744-a1f2-6c028fd6ed21",
                                "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                                "text": "„Oder ein skeptischer und mutiger Klardenker, der nach der Abdankung der Metaphysik konsequenterweise sich vor der \"Allmacht des endgültigen Nicht-Sinnes\" (EM. Cioran) beugt?“"
                            },
                            {
                                "example_id": "2699d11b-61f1-4073-a95e-129c9ecce7ad",
                                "sense_id": "5136636d-2f84-36ea-8232-f45ab5ebcc9a",
                                "text": "„Darum ist Nietzsche zum Klardenker ohnegleichen prädestiniert: wer selber Psychologie als eine Leidenschaft versteht und betreibt, empfindet sein ganzes Wesen mit jener Wollust, die man einzig Vollendetem entgegenbringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
