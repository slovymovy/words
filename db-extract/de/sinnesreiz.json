                ],
                "senses": [
                    {
                        "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                        "entry_id": "b1089074-b594-3fe1-b4b1-544d3f1fa771",
                        "glosses": [
                            "Einwirkung auf ein Sinnesorgan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5d72a9-a4ec-418c-ade7-ceafe6f6d332",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Die beiden Amygdalae verarbeiten Sinnesreize von außen und beurteilen, ob ein Sinnesreiz gefährlich oder ungefährlich ist.“"
                            },
                            {
                                "example_id": "7372da9a-32b2-4571-b201-5c38af48f3e4",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Für die Erkennung von solchen Sinnesreizen sind beim Hören, Sehen, Riechen, Schmecken und Tasten sogenannte Rezeptoren zuständig.“"
                            },
                            {
                                "example_id": "60c99762-8a22-41bd-89f7-db9b0e0a672a",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Diese Sinnesreize werden in unserem Nervensystem verarbeitet, indem elektrische Impulse, die durch den Sinnesreiz entstehen, an das Gehirn gesendet werden.“"
                            },
                            {
                                "example_id": "853866cb-cae1-468e-980a-18c3b22c45ce",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Das, was wir als Wahrnehmung empfinden, ist letztlich nichts anderes als die Umwandlung der Energie der Sinnesreize in elektrische Impulse.“"
                            },
                            {
                                "example_id": "0e7db66c-bbb0-4752-b21f-7eb712671503",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Der durch die Augen aufgenommene Sinnesreiz wird über den Thalamus an die entsprechende Region im Kortex weitergeleitet.“"
                            },
                            {
                                "example_id": "f36c2f5e-ead9-45f5-9f4c-58fc4eea8ca8",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Wenn es nicht jedesmal ein von außen kommender Sinnesreiz sein kann, so mag dafür ein von den inneren Organen ausgehender, sogenannter Leibreiz eintreten.“"
                            },
                            {
                                "example_id": "33596e18-52e6-46d4-b61e-598f162a2b2d",
                                "sense_id": "51bbb735-98d7-3af9-9321-f3d5bbaaacf5",
                                "text": "„Es seien in der Neurowissenschaft vergleichbare Phänomene bekannt, bei denen eine Empfindung durch einen Sinnesreiz ausgelöst werde – zum Beispiel die Wahrnehmung von Tönen als Farben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
