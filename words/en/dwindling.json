{
    "word_family": [
        "dwindle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3591f509-3518-3fa9-b20d-855b848d15d3",
                    "sense_definition": "Becoming smaller in size, amount, or strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is <w>dwindling</w> support for the new policy among the voters.",
                            "target_lang_translations": {
                                "nl": "Er is <w>afnemende</w> steun voor het nieuwe beleid onder de kiezers.",
                                "de": "Es gibt <w>schwindende</w> Unterstützung für die neue Politik unter den Wählern."
                            }
                        },
                        {
                            "text": "The team faced a <w>dwindling</w> supply of food during the long winter.",
                            "target_lang_translations": {
                                "nl": "Het team had te maken met een <w>slinkende</w> voedselvoorraad tijdens de lange winter.",
                                "de": "Das Team sah sich während des langen Winters mit einem <w>schrumpfenden</w> Nahrungsvorrat konfrontiert."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminishing",
                        "decreasing",
                        "shrinking"
                    ],
                    "antonyms": [
                        "increasing",
                        "growing"
                    ],
                    "common_phrases": [
                        "dwindling resources",
                        "dwindling numbers"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kleiner wordend in omvang, hoeveelheid of kracht.",
                        "de": "Wird kleiner an Größe, Menge oder Stärke; allmählich abnehmend oder schrumpfend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verminderend",
                                "target_lang_sense_clarification": "Iets dat in hoeveelheid of intensiteit afneemt."
                            },
                            {
                                "target_lang_word": "slinkend",
                                "target_lang_sense_clarification": "Iets dat geleidelijk kleiner wordt of afneemt."
                            },
                            {
                                "target_lang_word": "afnemend",
                                "target_lang_sense_clarification": "Iets dat in kracht of omvang terugloopt."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schwindend",
                                "target_lang_sense_clarification": "allmählich weniger werdend oder vergehend"
                            },
                            {
                                "target_lang_word": "abnehmend",
                                "target_lang_sense_clarification": "in Anzahl, Größe oder Intensität geringer werdend"
                            },
                            {
                                "target_lang_word": "schrumpfend",
                                "target_lang_sense_clarification": "an Umfang oder Vorrat kleiner werdend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcd1a4b6-b6eb-339b-bf23-b95e95e7982d",
                    "sense_definition": "Present participle and gerund of <w>dwindle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>dwindling</w> in size due to poor management.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf is in omvang aan het <w>afnemen</w> door slecht management.",
                                "de": "Das Unternehmen <w>schrumpft</w> aufgrund von schlechtem Management an Größe."
                            }
                        },
                        {
                            "text": "He watched the fire <w>dwindling</w> until it finally went out.",
                            "target_lang_translations": {
                                "nl": "Hij keek hoe het vuur <w>slinkte</w> totdat het uiteindelijk uitging.",
                                "de": "Er sah zu, wie das Feuer <w>schwand</w>, bis es schließlich erlosch."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het onvoltooid deelwoord van 'dwindle' (slinken, afnemen).",
                        "de": "Partizip Präsens von „dwindle“; im Begriff, kleiner, weniger oder schwächer zu werden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "slinkend",
                                "target_lang_sense_clarification": "Het proces van kleiner worden of afnemen."
                            },
                            {
                                "target_lang_word": "afnemend",
                                "target_lang_sense_clarification": "Het proces van verminderen in omvang of intensiteit."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schwinden",
                                "target_lang_sense_clarification": "allmählich weniger werden oder nachlassen"
                            },
                            {
                                "target_lang_word": "abnehmen",
                                "target_lang_sense_clarification": "an Menge oder Intensität zurückgehen"
                            },
                            {
                                "target_lang_word": "schrumpfen",
                                "target_lang_sense_clarification": "an Größe oder Umfang einbüßen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31e9df72-0971-3216-a839-2dc6d9892ba9",
                    "sense_definition": "A slow and steady decrease until something disappears.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>dwindling</w> of the forest area is a major environmental concern.",
                            "target_lang_translations": {
                                "nl": "De constante <w>afname</w> van het bosareaal is een grote zorg voor het milieu.",
                                "de": "Das ständige <w>Schwinden</w> der Waldflächen ist ein großes Umweltproblem."
                            }
                        },
                        {
                            "text": "We observed a slow <w>dwindling</w> of the crowd as the night went on.",
                            "target_lang_translations": {
                                "nl": "We zagen een langzame <w>afname</w> van de menigte naarmate de nacht vorderde.",
                                "de": "Wir beobachteten einen langsamen <w>Rückgang</w> der Menschenmenge im Laufe der Nacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "reduction"
                    ],
                    "antonyms": [
                        "growth",
                        "increase"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een langzame en gestage afname totdat iets verdwijnt.",
                        "de": "Ein langsamer und stetiger Rückgang, bis etwas fast oder ganz verschwunden ist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afname",
                                "target_lang_sense_clarification": "Het proces van vermindering."
                            },
                            {
                                "target_lang_word": "slinking",
                                "target_lang_sense_clarification": "Het proces van geleidelijk kleiner worden."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Schwinden",
                                "target_lang_sense_clarification": "der kontinuierliche Verlust oder Rückgang"
                            },
                            {
                                "target_lang_word": "der Rückgang",
                                "target_lang_sense_clarification": "das Kleiner- oder Wenigerwerden"
                            },
                            {
                                "target_lang_word": "die Abnahme",
                                "target_lang_sense_clarification": "das Nachlassen oder Sinken einer Menge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
