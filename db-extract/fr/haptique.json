                "translations": [
                    {
                        "translation_id": "5f4c7cbd-9b78-4792-a706-78e876ecd4de",
                        "source_entry_id": "b705d0cf-8c10-3625-95aa-6499fcfdac48",
                        "source_sense_id": "515b44e2-a00b-37b3-816f-371a59170a7a",
                        "source_sense_description": "Psychologie: haptisch",
                        "target_lang_word": "haptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                        "entry_id": "6b01a8f1-4139-3fa9-9227-1bf46ce8a597",
                                        "glosses": [
                                            "den Tastsinn betreffend, auf ihm beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8ced89-8dd4-48e5-92c9-966eb8826285",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Der Tastsinn ist die haptische Wahrnehmung von Lebewesen."
                                            },
                                            {
                                                "example_id": "b3fbb769-a81c-45bb-a8fb-0beb7182fda0",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Diese Geräte erlauben das intuitive „Begreifen“ und die haptisch unterstützte Manipulation von Objekten in der 3D-Simulationsumgebung."
                                            },
                                            {
                                                "example_id": "196d7288-687a-40cf-9e74-8aa675cc9e76",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Durch die Bilder und die Aktivität des Schreibens haben die Lerner einen haptischeren Zugang zum Thema, als wenn sie sich theoretisch und reflektierend damit befassen würden."
                                            },
                                            {
                                                "example_id": "cba824ea-4d87-4307-9239-d8b1a4a4860f",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Es war der vielleicht haptischste Versuch, den Raum als Ganzes zurückzuerobern, seit dieser nicht mehr gebraucht wurde von PC und Bildschirm."
                                            },
                                            {
                                                "example_id": "a4ce83aa-f30b-4f4c-9fdf-a1c7084d6536",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "Überhaupt betont selbstverständlich das Fleischliche die Körperlichkeit in der Kunst, sodass Hrdlicka pointiert behauptet, dass sein Kontakt zu Prostituierten ihm in der Entscheidung, sich der Bildhauerei - der haptischsten künstlerischen Gattung - zuzuwenden, behilflich gewesen sei."
                                            },
                                            {
                                                "example_id": "b729d8bd-e0f1-4c75-8a22-b1adefb8b7ac",
                                                "sense_id": "05496867-20e4-3ba8-94a6-969a14557618",
                                                "text": "… auf die Frage, ob die Rollen von modernen Vätern und Müttern austauschbar sind: \"Das glaube ich nicht. Väter sind viel haptischer mit ihren Kindern. Greta fordert mich zur Zeit dauernd zum Ringen heraus, wir machen fast jeden Abend eine Runde Wrestling. Klar, dass ich sie gewinnen lasse.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
