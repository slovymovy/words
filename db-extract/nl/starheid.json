                                "target_senses": [
                                    {
                                        "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                        "entry_id": "8820cd73-b7cd-39be-ad6c-0d7c0bf03228",
                                        "glosses": [
                                            "The state or quality of being strict."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec038508-cba9-4047-b062-9cc6cd94f756",
                                                "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                                "text": "Discipline calls for a certain strictness."
                                            },
                                            {
                                                "example_id": "9c0d66e7-b349-408c-a41d-eed96db90a42",
                                                "sense_id": "e08cfabe-4a23-3ae5-9714-7a3c370ebeb3",
                                                "text": "I lost all restraint, and yielding to the force of the emotion, gave down, as mere woman, those effusions of pleasure, which, in the strictness of still faithful love, I could have wished to have held up.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483ba4cf-ab90-3d94-b127-caef2ab92d3b",
                                        "entry_id": "8820cd73-b7cd-39be-ad6c-0d7c0bf03228",
