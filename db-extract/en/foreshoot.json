                "senses": [
                    {
                        "sense_id": "df168a44-1ee2-3f0e-89b6-b8887fcc7c6d",
                        "entry_id": "b1a0e395-cf37-3e08-9e52-324ce3c6874a",
                        "glosses": [
                            "To go too far forward; overshoot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa7400e-e0ff-40f3-8284-a2f44eb1ddf9",
                                "sense_id": "df168a44-1ee2-3f0e-89b6-b8887fcc7c6d",
                                "text": "Instantly he gave the rein to his horse, and with panting speed foreshot his little army : in a moment after his beloved Fanny sprang into his arms."
                            },
                            {
                                "example_id": "eb07b240-f398-44b7-bd28-4012d15205f3",
                                "sense_id": "df168a44-1ee2-3f0e-89b6-b8887fcc7c6d",
                                "text": "The form of the barrel will, in most cases, compel the rope to \"fleet\" itself, that is, work upward, as it winds on, maintaining nearly an equal leverage in work, and if it should by accident do this suddenly, or as the seamen say, surge upwards, the men cannot be thrown down by the foreshooting and recoil of the bars they are working with, so that they work with an increased confidence, that greatly facilitates their labor; and all this is done without carrying the spindle through the deck, as has been the common practice."
                            },
                            {
                                "example_id": "6914259e-596b-475b-b6d4-878deea66ee7",
                                "sense_id": "df168a44-1ee2-3f0e-89b6-b8887fcc7c6d",
                                "text": "We coasted into the harbor, took down the sails, foreshot a little, let go the anchor, the moon rose, and Cecilia already had a meal prepared."
                            }
                        ]
                    }
