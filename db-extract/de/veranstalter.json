                ],
                "senses": [
                    {
                        "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                        "entry_id": "3b27528a-0c41-3095-83bc-86aa718780b4",
                        "glosses": [
                            "Person oder Organisation, die eine Veranstaltung, eine gesellschaftliche Unternehmung (Ausstellung, Fest, Wettbewerb), vorbereitet und organisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6448263f-d56a-49d0-abe3-31077665ce1c",
                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                "text": "Der Veranstalter ist dabei sowohl für die Inhalte als auch für das Verhalten der Gäste und deren Sicherheit, jeweils im Rahmen seiner Sorgfaltspflicht, zuständig."
                            },
                            {
                                "example_id": "bfe58ada-d472-4fa3-a764-8c9bef330633",
                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                "text": "„Mit einer Geschwindigkeit von rund 13 Kilometern in der Stunde gehe es nicht um Spitzensport, so der Veranstalter.“"
                            },
                            {
                                "example_id": "08b20157-4e02-41f5-8495-e808f093a79b",
                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                "text": "„Gegen die noch immer beliebten Gatterjagden laufen die Tierschützer vom VgT (Verein gegen Tierfabriken) seit Jahren Sturm. Mehrere Prozesse gegen diverse Veranstalter sind anhängig.“"
                            },
                            {
                                "example_id": "66e64a60-5cd4-438b-bc34-e2d429f1bfee",
                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9e20d8a-494d-4dd1-9205-2d022ee26241",
                        "source_entry_id": "3b27528a-0c41-3095-83bc-86aa718780b4",
