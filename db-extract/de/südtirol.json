                "senses": [
                    {
                        "sense_id": "fd2e5943-d407-30ee-bb22-1116320d69af",
                        "entry_id": "f777af23-b4ab-301f-b89b-69340dbddeb6",
                        "glosses": [
                            "die nördlichste Provinz Italiens mit der Hauptstadt Bozen; der südlich des Brenners gelegene Teil Tirols"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "5e73cd04-c082-4608-9322-c552119831d1",
                                "sense_id": "fd2e5943-d407-30ee-bb22-1116320d69af",
                                "text": "Wir wandern nach Südtirol."
                            },
                            {
                                "example_id": "fbde5f90-23d5-4b02-a7e0-0fb6c551edb9",
                                "sense_id": "fd2e5943-d407-30ee-bb22-1116320d69af",
                                "text": "„In Südtirol sollte man sich auf Stau auf der Brennerautobahn Richtung Bozen vor der Mautstelle Sterzing, in Salzburg auf der Tauernautobahn (A10) vor den Tunnelabschnitten Richtung Villach einstellen.“"
                            },
                            {
                                "example_id": "4a589be4-6f2b-43bf-ac8f-3c4e5fadf8e8",
                                "sense_id": "fd2e5943-d407-30ee-bb22-1116320d69af",
                                "text": "„Die Brennerautobahn war in Südtirol zeitweilig gesperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
