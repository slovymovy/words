                        "target_lang_word": "île-prison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "île-prison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "866644cb-d847-39ed-b4fd-c4975bfac982",
                                        "entry_id": "e8710c3a-a717-31dd-a4e5-c875d249e0f6",
                                        "glosses": [
                                            "Île où l’on est prisonnier."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6109d3f0-ab8f-476f-b58b-324f3fcef08a",
                                                "sense_id": "866644cb-d847-39ed-b4fd-c4975bfac982",
                                                "text": "Icare est donc pleinement un personnage yourcenarien, lui qui rêve de fuir son île-prison, en atteignant un zénith inaccessible aux limitations de sa condition de mortel."
                                            },
                                            {
                                                "example_id": "a6a1abe7-a12c-4414-ae2b-3f95d91ba2ff",
                                                "sense_id": "866644cb-d847-39ed-b4fd-c4975bfac982",
                                                "text": "Ce n’est qu’une fois à Paris, que Condé rejoint l’itinéraire des auteurs de la génération précédente et commence à soupçonner que l’île-prison était en fait une île déjà exilée de son origine africaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a5dda7-6fe7-3108-867b-66155e9072d9",
                                        "entry_id": "e8710c3a-a717-31dd-a4e5-c875d249e0f6",
                                        "glosses": [
                                            "Île occupée principalement par une prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39818f1e-6b92-4680-898e-479c22068922",
                                                "sense_id": "e4a5dda7-6fe7-3108-867b-66155e9072d9",
                                                "text": "Trois mois après, le 18 octobre, on le déposa dans l’île-prison qu’il ne devait plus quitter avant sa mort."
                                            },
                                            {
                                                "example_id": "45564eff-1716-47f3-b18e-c30e67e0de82",
                                                "sense_id": "e4a5dda7-6fe7-3108-867b-66155e9072d9",
                                                "text": "Il en tirera L'île de Sakhaline, un récit bouleversant qui attirera l'attention du gouvernement russe sur les sévices intolérables que les prisonniers subissent sur cette île-prison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
