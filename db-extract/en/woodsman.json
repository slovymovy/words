                        "entry_id": "64e3c5e2-d34d-38da-87a5-82d4e16e0323",
                        "glosses": [
                            "A man who lives and works in woodland; a forester or woodman."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e3da3db0-cf9c-3477-90e9-8b0e7f46935d",
                        "entry_id": "64e3c5e2-d34d-38da-87a5-82d4e16e0323",
                        "glosses": [
                            "Designating a group of sports related to forestry culture, including axe throwing, wood splitting, wood chopping, axe cutting, chainsaw cutting, pulpwood tossing, log rolling and decking, pole climbing, and firemaking."
                        ],
                        "tags": [
                            "attributive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07e47aad-077a-4aed-ad8a-5f52c58f74c9",
                        "source_entry_id": "64e3c5e2-d34d-38da-87a5-82d4e16e0323",
                        "source_sense_description": "a forester or woodman",
                        "target_lang_word": "лесник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лесник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "лесной сторож"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52aff9ca-0ee5-423e-8ccd-8be44c1ab63f",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "В деревне своей был я лесником: должность наша такая, чтоб день спать, а ночь ходить по лесу."
                                            },
                                            {
                                                "example_id": "4572c52a-f2fd-4af9-865e-da03862f031f",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "На хижине, покрытой сосновыми ветвями, написано: «Царю хорошо в своём дворце, а леснику в своём шалаше» .."
                                            },
                                            {
                                                "example_id": "2121e25d-fdc0-4395-ad84-319ec36f201a",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "Вольнопрактикующий землемер Жмакин и студент Николай Николаевич .. возвращаются со съёмки. Идти домой, в Сердюковку, им поздно и далеко: они заночуют сегодня в казённом лесу, у знакомого лесника — Степана."
                                            },
                                            {
                                                "example_id": "607f6aab-1871-4e91-8265-cca35372222a",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "За домом волновался сад, и всё долетал оттуда разносимый ветром злой и беспомощный, отрывистый лай собак над ямой в ёлках: там сидела лисица, которую поймал в капкан и принёс на барский двор лесник Казаковой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72dc4dd5-4648-39ce-bb91-f217725200fc",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "работник лесного хозяйства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e38607-d94d-424b-9e50-336f78bb020c",
                                                "sense_id": "72dc4dd5-4648-39ce-bb91-f217725200fc",
                                                "text": "Канадский тополь, как выражаются лесники, самое «гонкое» дерево, растёт со сказочной быстротой – по полтора, а то и по два метра в год."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8ee4d7-3be3-3e7b-b473-e22b6a521051",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "мифологическое существо у славян"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
