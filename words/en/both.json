        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "fbfc8f66-b822-3b7a-8212-fad1b489a554",
                    "sense_definition": "Used before the first of two alternatives to emphasize that the statement applies to each of them (used with 'and').",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She can <w>both</w> sing and dance very well.",
                            "target_lang_translations": {
                                "ru": "Она умеет <w>и</w> петь, и танцевать очень хорошо.",
                                "nl": "Ze kan <w>zowel</w> heel goed zingen als dansen.",
                                "pl": "Ona potrafi <w>zarówno</w> śpiewać, jak i tańczyć bardzo dobrze.",
                                "de": "Sie kann <w>sowohl</w> sehr gut singen als auch tanzen.",
                                "fr": "Elle sait <w>à la fois</w> chanter et très bien danser.",
                                "it": "Sa <w>sia</w> cantare sia ballare molto bene.",
                                "cs": "Umí <w>jak</w> velmi dobře zpívat, tak i tancovat.",
                                "tr": "O <w>hem</w> çok iyi şarkı söyleyebiliyor hem de dans edebiliyor.",
                                "es": "Ella puede <w>tanto</w> cantar como bailar muy bien.",
                                "zh": "她<w>既</w>会唱歌，跳舞也跳得很好。"
                            }
                        },
                        {
                            "text": "<w>Both</w> you and I are students at this university.",
                            "target_lang_translations": {
                                "ru": "<w>И</w> ты, и я — студенты этого университета.",
                                "nl": "<w>Zowel</w> jij als ik zijn studenten aan deze universiteit.",
                                "pl": "<w>Zarówno</w> ty, jak i ja jesteśmy studentami tego uniwersytetu.",
                                "de": "<w>Sowohl</w> du als auch ich sind Studenten an dieser Universität.",
                                "fr": "<w>Et</w> toi et moi sommes étudiants dans cette université.",
                                "it": "<w>Sia</w> io che te siamo studenti in questa università.",
                                "cs": "<w>Jak</w> ty, tak i já jsme studenti na této univerzitě.",
                                "tr": "<w>Hem</w> sen hem de ben bu üniversitede öğrenciyiz.",
                                "es": "<w>Tanto</w> tú como yo somos estudiantes en esta universidad.",
                                "zh": "<w>你和我</w>都是这所大学的学生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "both ... and"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется перед первым из двух однородных членов предложения для усиления (в сочетании с 'and').",
                        "nl": "Gebruikt voor het eerste van twee alternatieven om te benadrukken dat de bewering voor elk van hen geldt (gebruikt in combinatie met 'and').",
                        "pl": "Używane przed pierwszym z dwóch elementów w celu podkreślenia, że stwierdzenie dotyczy każdego z nich (używane z 'and').",
                        "de": "Wird vor der ersten von zwei Alternativen verwendet, um zu betonen, dass die Aussage auf beide zutrifft (in Kombination mit 'and').",
                        "fr": "Utilisé devant la première de deux options pour souligner que l'affirmation s'applique à chacune d'elles (utilisé avec 'and').",
                        "it": "Usato prima della prima di due alternative per sottolineare che l'affermazione si applica a ciascuna di esse (usato in correlazione con 'and').",
                        "cs": "Používá se před první ze dvou možností pro zdůraznění, že tvrzení platí pro každou z nich (ve spojení s 'and').",
                        "tr": "İki seçenekten her birinin geçerli olduğunu vurgulamak için birincisinin önünde kullanılır ('and' ile birlikte).",
                        "es": "Se usa antes de la primera de dos alternativas para enfatizar que la afirmación se aplica a cada una de ellas (se usa con 'and').",
                        "zh": "用于两个并列成分之前，强调两者兼而有之（常与 and 连用）。"
                    },
