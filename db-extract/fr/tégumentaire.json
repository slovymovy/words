                            {
                                "example_id": "4b7a10c9-1576-4730-bc27-dae3b625038c",
                                "sense_id": "016ca4fc-9e7e-3914-b7ad-890c2b097014",
                                "text": "Ces surdités disparaissent très vite quand la réparation tégumentaire rétablit la tension de la membrane."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8cb04e6-d2ff-344e-abee-a937f1739fb4",
