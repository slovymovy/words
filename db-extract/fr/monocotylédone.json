            {
                "entry_id": "22199d90-e705-3b61-b166-3e5bc567f345",
                "word": "monocotylédone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "231c4fad-7924-42fa-83e2-5f3cc40c1ed6",
                        "entry_id": "22199d90-e705-3b61-b166-3e5bc567f345",
                        "tags": [
                            "plural"
                        ],
                        "form": "monocotylédones"
