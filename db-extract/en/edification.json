                        "target_lang_word": "Gebäude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebäude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                        "entry_id": "55df35a9-e584-31f2-aab4-5e3d9b8243a9",
                                        "glosses": [
                                            "ein vom Menschen errichtetes, meist oberirdisches, ortsfestes Konstrukt/Bauwerk, das einen oder mehrere Räume enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01daaf8f-0937-4f9d-9df1-e406910aafa8",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "Jedes Haus ist ein Gebäude."
                                            },
                                            {
                                                "example_id": "24c271f8-1971-4ad1-966e-0eb918480672",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "Öffentliche Gebäude sind meistens relativ groß."
                                            },
                                            {
                                                "example_id": "0487d56d-4093-4e05-83a8-5e3acca54697",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "„Der Gasthof befand sich in einem zweistöckigen Gebäude außerhalb der Ortschaft.“"
                                            },
                                            {
                                                "example_id": "3d93f80f-4713-4674-a2ba-3b48b095b443",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "„Aber natürlich war das Gebäude der Handelsgesellschaft noch größer.“"
                                            },
                                            {
                                                "example_id": "990433cd-2117-4773-80bb-e97eb1a81916",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "„Sie lenkte in die Parkgarage des Gebäudes.“"
                                            },
                                            {
                                                "example_id": "48e3d752-ff96-4224-926f-545c20addec8",
                                                "sense_id": "be25543e-ef7a-379a-b1b4-3d18a4e9ccef",
                                                "text": "„Experten schätzen, dass gut ein Drittel der bestehenden Gebäude ohne weiteres mit Erdwärmeheizungen ausgerüstet werden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f61728b-b0eb-41d8-8e37-d9ab1c309c0d",
                        "source_entry_id": "dbd3a4df-9400-3e46-b451-8e5b4e1841ee",
                        "source_sense_description": "building",
                        "target_lang_word": "Bauwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6f1327-c323-307c-ba77-b93cee6303ce",
                                        "entry_id": "dd6d7fc3-9b49-30e7-a820-1ad69d8ac7d4",
                                        "glosses": [
                                            "von Menschen gebauter, ortsfester Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37deccdf-26d3-4b1b-9c4d-61a550da9e0b",
                                                "sense_id": "1a6f1327-c323-307c-ba77-b93cee6303ce",
                                                "text": "Hier sind alle gewässertechnischen Bauwerke an und in der Elbe verzeichnet."
                                            },
                                            {
                                                "example_id": "2fc9ca84-b566-4554-8451-84fb050a962a",
                                                "sense_id": "1a6f1327-c323-307c-ba77-b93cee6303ce",
                                                "text": "„Manchmal fand ich mich schon mitten in dem verschlungenen Bauwerk vor, manchmal schritt ich erst durch eine düstere Tannenlandschaft darauf zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                        "entry_id": "dd6d7fc3-9b49-30e7-a820-1ad69d8ac7d4",
                                        "glosses": [
                                            "durch seine architektonische Gestaltung größerer, bedeutender Bau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f19207c-5fba-40f6-bfe1-6cd9e8fdecb5",
                                                "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                                "text": "Die imposanten Bauwerke der alten Ägypter faszinieren noch heute."
                                            },
                                            {
                                                "example_id": "dd15db53-9d73-4a34-b7f8-79ea92119941",
                                                "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                                "text": "„Es stellte sich dies als ein Bauwerk heraus, das von außen nicht im geringsten als Postamt zu erkennen war, sondern es war ein Hinterhof mit mehreren greulich ineinander verschachtelten Häuserruinen.“"
                                            },
                                            {
                                                "example_id": "e52495a6-1b4a-4a77-8054-a5a5b354ac81",
                                                "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                                "text": "„Doch es war wirklich ein schönes Bauwerk geworden, bei dem jeder einzelne Stein so behauen war, dass er perfekt mit den anderen zusammenpasste.“"
                                            },
                                            {
                                                "example_id": "7c1ed389-d337-442d-bf2d-6acc7bc8c9c9",
                                                "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                                "text": "„Ich habe gelesen, die Stadt sei jetzt arm und ruinenhaft, ihr bedeutendstes Bauwerk soll eine Kathedrale aus dem vierten Jahrhundert sein.“"
                                            },
                                            {
                                                "example_id": "49d4f7bd-95ca-4028-b93b-ac66b40e82b5",
                                                "sense_id": "1fbedba5-05b6-35dd-9ffa-ae5d4b24499a",
                                                "text": "„Ein pfiffiger Mensch hat in der Nähe des Bauwerks einen Stand mit Rostbratwürsten aufgebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
