                            {
                                "example_id": "d5b21ce2-1329-4b4a-b015-717d8f7536c1",
                                "sense_id": "2570994a-5afd-3733-8e12-a33240d37f07",
                                "text": "„Dabei ist es zu betonen, daß die auf der Wortkarte dargestellte Verbreitung von partiellen Heteronymen nicht mit der Verbreitung der betreffenden lexikalischen Einheit überhaupt verwechselt werden darf.“"
                            },
                            {
                                "example_id": "7e4eeb9f-4d29-47d5-8a2c-115115610698",
                                "sense_id": "2570994a-5afd-3733-8e12-a33240d37f07",
                                "text": "„NBC erstellte darüber hinaus eine Wortkarte Trumps, in denen man Worte des Staunens oder der Bewunderung mit der Lupe suchen muss.“"
                            }
