                        "entry_id": "cc9c1d24-4712-3c76-924a-86840fbb9707",
                        "glosses": [
                            "natürliche Vergrößerung der weiblichen Brust im Wachstum oder in der Schwangerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ed161a7-3eb0-453c-8c7c-e54aa3ddd16b",
                                "sense_id": "97a70017-097b-3071-a0cf-3422f0f5efd2",
                                "text": "Die Brustvergrößerung ist das Ergebnis der Muttermilch-Produktion."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "867f65a0-a136-3b37-a055-b2dce2f6ed39",
                        "entry_id": "cc9c1d24-4712-3c76-924a-86840fbb9707",
                        "glosses": [
                            "künstliche operative Vergrößerung der weiblichen Brust mittels Einsetzen von Fremdkörpern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87ce1fb-27db-4c09-b9d0-6a5344ed14a1",
                                "sense_id": "867f65a0-a136-3b37-a055-b2dce2f6ed39",
                                "text": "Um das Selbstwertgefühl zu steigern oder das Wirken auf das männliche Geschlecht zu erhöhen, lassen sich viele Frauen unnötig auf eine kostspielige Brustvergrößerung ein."
                            },
                            {
                                "example_id": "4fa7bfae-0332-4d2b-8b84-72c62f8df6b2",
                                "sense_id": "867f65a0-a136-3b37-a055-b2dce2f6ed39",
                                "text": "Eine Brustvergrößerung vergrößert auch das Vermögen mancher Schönheitschirurgen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
