                ],
                "senses": [
                    {
                        "sense_id": "1b383474-a522-3437-8e2b-3de8ce1c4d45",
                        "entry_id": "8f01fd0f-b867-3487-b2c4-77e8d30addd6",
                        "glosses": [
                            "Tasche in der Oberbekleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9bfe395-382e-42c4-a7f1-c16c10558c12",
                                "sense_id": "1b383474-a522-3437-8e2b-3de8ce1c4d45",
                                "text": "„Im Gedränge bekommen viele nicht mit, dass ihnen Handys oder Geldtaschen aus dem Mantelsack gestohlen werden.“"
                            },
                            {
                                "example_id": "0d142f9c-36dc-4b11-bb18-2066e5201e6d",
                                "sense_id": "1b383474-a522-3437-8e2b-3de8ce1c4d45",
                                "text": "„Die rechte Hand steckt - eher nachlässig als lässig - im Mantelsack, die linke zerknüllt die Kopfbedeckung.“"
                            },
                            {
                                "example_id": "5054844a-455d-46e4-80b9-bbd54019e6fa",
                                "sense_id": "1b383474-a522-3437-8e2b-3de8ce1c4d45",
                                "text": "„Wie das Berufungsgericht bereits zutreffend ausgeführt hat, können die Schlüssel auch an einem anderen belebten Ort aus dem Mantelsack gestohlen werden (zB Einkaufszentrum) und kann auch der Dieb bereits im vorhinein beobachtet haben, wo das spätere Opfer sein Fahrzeug abstellte.“"
                            },
                            {
                                "example_id": "28c4e229-bc90-4b99-b7e6-5520cc6c3275",
                                "sense_id": "1b383474-a522-3437-8e2b-3de8ce1c4d45",
                                "text": "„Ich griff in den Mantelsack, sagte: »Da hast, schenk ich dir zu Weihnachten«, und überreichte dem Schurli das Geduldsspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87a2f6ed-8dda-3a5e-868b-159deb4a0a8a",
                        "entry_id": "8f01fd0f-b867-3487-b2c4-77e8d30addd6",
                        "glosses": [
                            "Reisetasche (auf Pferden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a42c9f-a335-491c-8a83-31b64d3171ef",
                                "sense_id": "87a2f6ed-8dda-3a5e-868b-159deb4a0a8a",
                                "text": "„Verblüfft über diesen Vorschlag, ließ Efix sich noch etwas nötigen, lud seinen Mantelsack schließlich auf das Pferd, das wie eingeschlafen zu sein schien, schwang sich dann selber hinter Don Pedro auf die Kruppe und versuchte sich so leicht wie möglich zu machen.“"
                            },
                            {
                                "example_id": "41c989cb-fdd7-4164-a308-61d714a3a2e9",
                                "sense_id": "87a2f6ed-8dda-3a5e-868b-159deb4a0a8a",
                                "text": "„Der Mantelsack war schnell gepackt, den er wollte liegen lassen, keinen Brief schrieb er dazu, nur mit wenig Worten sollte sein Ausbleiben vom Tisch, vielleicht auch vom Abend, durch den Reitknecht entschuldigt werden, den er ohnehin aufwecken mußte.“"
                            },
                            {
                                "example_id": "9db2cbb7-1453-4da1-9c6b-d74cce68b49b",
                                "sense_id": "87a2f6ed-8dda-3a5e-868b-159deb4a0a8a",
                                "text": "„Der alle seine Staaten mit sich führt",
                                "translation": "Im Mantelsack, lebt bloß vom Körbeholen.“"
                            },
                            {
                                "example_id": "f166ae47-1068-49a2-84e2-23718da54212",
                                "sense_id": "87a2f6ed-8dda-3a5e-868b-159deb4a0a8a",
                                "text": "„Marthe band den Mantelsack zu und reichte ihn Jakob. »Wir müssen weiter, wenn wir noch vor Einbruch der Dunkelheit einen Schlafplatz finden wollen.« Jakob schulterte den Mantelsack.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
