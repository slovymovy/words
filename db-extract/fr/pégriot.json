                        "glosses": [
                            "Qui concerne le monde de la pègre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd6c0dd-148a-4d80-8bdf-706efb4c6f17",
                                "sense_id": "0b881b5f-8e78-3dda-9bcb-07661dcf7c41",
                                "text": "Cela avait été dit du ton paterne qui pouvait aussi bien convenir au commissaire de police bienveillant qu’à quelque prêtre-ouvrier lancé dans l’apostolat pégriot."
                            },
                            {
                                "example_id": "2801a715-2e04-40b7-a850-ba06c4b3f7d8",
                                "sense_id": "0b881b5f-8e78-3dda-9bcb-07661dcf7c41",
                                "text": "Quand vous cambriolez une banque, ils vous donnent un reçu ?… Je ne me moque pas de vous, j’essaie de comprendre la comptabilité pégriote."
                            }
                        ]
                    }
