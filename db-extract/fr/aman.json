                                                "sense_id": "0307a283-ca6a-34d4-87ff-7ec375e8b532",
                                                "text": "Aman, acele etmeli, vakit geçiyor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7c6ee8-28cb-3de2-912d-d1a8a077a324",
