{
    "word_family": [
        "torment",
        "tormenter",
        "tormentingly",
        "tormentor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa846616-2f4d-3eac-bb60-4397fce0a8b2",
                    "sense_definition": "Simple past tense and past participle of <w>torment</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel bullies <w>tormented</w> the young boy every single day after school.",
                            "target_lang_translations": {
                                "ru": "Жестокие хулиганы каждый божий день после школы <w>мучили</w> маленького мальчика."
                            }
                        },
                        {
                            "text": "Memories of the terrible accident had <w>tormented</w> her for years.",
                            "target_lang_translations": {
                                "ru": "Воспоминания об ужасной аварии <w>терзали</w> её годами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола torment (мучить, терзать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучил",
                                "target_lang_sense_clarification": "причинял страдания"
                            },
                            {
                                "target_lang_word": "терзал",
                                "target_lang_sense_clarification": "душевно или физически мучил"
                            },
                            {
                                "target_lang_word": "измученный",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "40a0fd7e-9a6c-3431-a7c2-a9b715dd9791",
                    "sense_definition": "Suffering from severe mental pain, anxiety, anguish, or guilt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anguished",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked like a deeply <w>tormented</w> soul wrestling with a terrible secret.",
                            "target_lang_translations": {
                                "ru": "Он выглядел глубоко <w>мятущейся</w> душой, борющейся с ужасной тайной."
                            }
                        },
                        {
                            "text": "The artist poured his <w>tormented</w> feelings directly onto the canvas.",
                            "target_lang_translations": {
                                "ru": "Художник выплеснул свои <w>терзающие</w> чувства прямо на холст."
                            }
                        }
                    ],
                    "synonyms": [
                        "anguished",
                        "tortured",
                        "distressed",
                        "afflicted"
                    ],
                    "antonyms": [
                        "peaceful",
                        "serene",
                        "untroubled"
                    ],
                    "common_phrases": [
                        "tormented soul",
                        "deeply tormented",
                        "tormented mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий от сильной душевной боли, тревоги, мучений или чувства вины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзаемый",
                                "target_lang_sense_clarification": "мучимый сомнениями, болью или чувствами"
                            },
                            {
                                "target_lang_word": "замученный",
                                "target_lang_sense_clarification": "изнурённый переживаниями"
                            },
                            {
                                "target_lang_word": "мятущийся",
                                "target_lang_sense_clarification": "о душе, мыслях"
                            },
                            {
                                "target_lang_word": "мучимый",
                                "target_lang_sense_clarification": "испытывающий душевные терзания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2d81dfc-87d0-3b56-8164-675bde0c3ba0",
                    "sense_definition": "Suffering eternal punishment or suffering; damned or accursed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_anguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient myths describe the <w>tormented</w> spirits trapped in the underworld.",
                            "target_lang_translations": {
                                "ru": "Древние мифы описывают <w>мучимых</w> духов, заточённых в подземном царстве."
                            }
                        },
                        {
                            "text": "The priest warned that the <w>tormented</w> wicked would find no rest in the afterlife.",
                            "target_lang_translations": {
                                "ru": "Священник предупреждал, что <w>проклятые</w> грешники не найдут покоя в загробной жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "damned",
                        "accursed",
                        "condemned"
                    ],
                    "antonyms": [
                        "blessed",
                        "redeemed"
                    ],
                    "common_phrases": [
                        "tormented spirits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терпящий вечные муки или наказание; проклятый, обречённый на страдания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "обречённый на вечные муки"
                            },
                            {
                                "target_lang_word": "мучимый",
                                "target_lang_sense_clarification": "терпящий вечные страдания"
                            },
                            {
                                "target_lang_word": "страждущий",
                                "target_lang_sense_clarification": "пребывающий в муках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}