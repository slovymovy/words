                ],
                "senses": [
                    {
                        "sense_id": "0608130a-2958-3ba4-97a7-369541288843",
                        "entry_id": "53ef72e5-0a40-3930-b82d-c1e6484e6ccb",
                        "glosses": [
                            "Rendre infertile, ou moins fertile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "065013a9-7e0c-4bf9-a955-1cff77abb631",
                                "sense_id": "0608130a-2958-3ba4-97a7-369541288843",
                                "text": "Pour obtenir des betteraves comme on les obtient en Allemagne, il faut défertiliser la terre ; vous ne pouvez pas produire 27.000 kil. à l'hectare sans que notre sol soit appauvri."
                            },
                            {
                                "example_id": "17eed7ee-5dbe-4c53-9ba6-cd28404dd52d",
                                "sense_id": "0608130a-2958-3ba4-97a7-369541288843",
                                "text": "Dès lors, les Meo sont acculés à trouver de nouvelles terres pour cultiver davantage l'opium qui continue de défertiliser le sol."
                            },
                            {
                                "example_id": "b48a2077-0238-416f-90b9-f7eb0b85477e",
                                "sense_id": "0608130a-2958-3ba4-97a7-369541288843",
                                "text": "Les plaines se défertilisent. Les terres arables vont à la mer entraînant ainsi l’exode rural."
                            }
                        ]
                    }
                ],
