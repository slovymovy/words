                        "entry_id": "5ce0fccb-b002-39e8-be42-5df56b44b273",
                        "glosses": [
                            "op een vooronderstelling berustend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd72b7d0-ef98-4e0d-b2d3-8a6d917aea5e",
                                "sense_id": "a5e6baf6-fe40-3fde-87b7-2d11967ecdc2",
                                "text": "Op die hypothetische vraag ga ik liever niet in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bce92467-eeee-41f9-b044-ac4f22c7c41c",
                        "source_entry_id": "5ce0fccb-b002-39e8-be42-5df56b44b273",
                        "source_sense_id": "a5e6baf6-fe40-3fde-87b7-2d11967ecdc2",
                        "source_sense_description": "op een vooronderstelling berustend",
                        "target_lang_word": "hypothetical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothetical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8302f6a9-c28e-3e67-9952-0fd5200fa203",
                                        "entry_id": "307e0c87-b3b5-34f6-8296-3871b6a1efa0",
                                        "glosses": [
                                            "Based upon a hypothesis; conjectural"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e372c9-8758-4405-b5dd-d5fd6b192bf6",
                                                "sense_id": "8302f6a9-c28e-3e67-9952-0fd5200fa203",
                                                "text": "Such a subjunctive as appears in the principal clause (i.e. the apodosis) of a conditional sentence may be called a hypothetical subjunctive. An hypothetical subjunctive expresses an action¹ which, while its non-occurrence is implied, is yet supposed to occur, if some other action occur."
                                            },
                                            {
                                                "example_id": "3383ac90-c5b2-4a04-a709-9b9bcf376742",
                                                "sense_id": "8302f6a9-c28e-3e67-9952-0fd5200fa203",
                                                "text": "To establish standing under Article III, a plaintiff must satisfy the following three requirements: (1) \"the plaintiff must have suffered an injury in fact - an invasion of a legally protected interest which is (a) concrete and particularized, and (b) actual or imminent, not conjectural or hypothetical\"; ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e44cab5e-9e07-39fe-8fda-0d5590dfa64c",
                                        "entry_id": "307e0c87-b3b5-34f6-8296-3871b6a1efa0",
                                        "glosses": [
                                            "conditional; contingent upon some hypothesis/antecedent"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hypothetical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "375319c5-73b6-3816-b74b-8b24efaa057a",
                                        "entry_id": "c7ec7bf6-7253-3716-b209-46f723a061b1",
                                        "glosses": [
                                            "A possible or hypothetical situation or proposition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e069065-4a3e-464e-8e6b-99316d04fb92",
                                                "sense_id": "375319c5-73b6-3816-b74b-8b24efaa057a",
                                                "text": "These hypotheticals serve no purpose until we have more information."
                                            },
                                            {
                                                "example_id": "ab0c990e-4ef0-454c-b136-9253584f0214",
                                                "sense_id": "375319c5-73b6-3816-b74b-8b24efaa057a",
                                                "text": "He told ABC News: “Just to give you a hypothetical, we would respond by leading a Nato – a collective – effort that would take out every Russian conventional force that we can see and identify on the battlefield in Ukraine and also in Crimea and every ship in the Black sea.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afba4c13-f0ad-4c25-819b-b1373a8809fe",
                        "source_entry_id": "5ce0fccb-b002-39e8-be42-5df56b44b273",
                        "source_sense_id": "a5e6baf6-fe40-3fde-87b7-2d11967ecdc2",
                        "source_sense_description": "op een vooronderstelling berustend",
                        "target_lang_word": "hypothétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0033a0-0a5f-3a89-9a1d-d1928de96bd8",
                                        "entry_id": "b4b815d3-cc7b-35ac-9559-069b94aa59fe",
                                        "glosses": [
                                            "Qui repose sur une hypothèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849ab660-1c9d-420b-8d6a-3878fedcfd36",
                                                "sense_id": "1e0033a0-0a5f-3a89-9a1d-d1928de96bd8",
                                                "text": "Mais ces distinctions hypothétiques sont dépourvues de fondement solide, et après avoir beaucoup varié sur la classification de l’hydrophobie, presque tout restait encore à faire pour la bien connaître."
                                            },
                                            {
                                                "example_id": "b18b5970-3631-455e-a324-cb5557385cef",
                                                "sense_id": "1e0033a0-0a5f-3a89-9a1d-d1928de96bd8",
                                                "text": "Les médecins lui pronostiquèrent une meilleure santé ; mais la marquise ne crut point à ces présages hypothétiques."
                                            },
                                            {
                                                "example_id": "f2959f94-82f3-4303-8617-4589e1e50835",
                                                "sense_id": "1e0033a0-0a5f-3a89-9a1d-d1928de96bd8",
                                                "text": "Le Président a qualifié d’« hypothétique » la possibilité de démilitariser Quemoy et Matsu en échange d'un cessez-le-feu, néanmoins il a reconnu que c'était théoriquement envisagé par la diplomatie américaine."
                                            },
                                            {
                                                "example_id": "d29a0681-3baf-4d25-bbf0-4a20dc2c2ea4",
                                                "sense_id": "1e0033a0-0a5f-3a89-9a1d-d1928de96bd8",
                                                "text": "Prenons un cas hypothétique où l’algorithme catégoriserait un prévenu comme étant à « haut risque », alors que l’individu semble peu dangereux au magistrat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f905a552-e840-3c75-bf11-fed56b0e7ce9",
                                        "entry_id": "b4b815d3-cc7b-35ac-9559-069b94aa59fe",
                                        "glosses": [
                                            "S’oppose à catégorique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81133639-dcd4-4b97-b15d-2602bc6fa3e8",
                                                "sense_id": "f905a552-e840-3c75-bf11-fed56b0e7ce9",
                                                "text": "Une proposition hypothétique est celle qui énonce une relation d’interdépendance conditionnelle entre deux autres propositions : « Un triangle peut être inscrit dans une demi-circonférence si le triangle est rectangle. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d696b5e0-545f-42d0-be0a-965ff7a4612a",
                        "source_entry_id": "5ce0fccb-b002-39e8-be42-5df56b44b273",
                        "source_sense_id": "a5e6baf6-fe40-3fde-87b7-2d11967ecdc2",
                        "source_sense_description": "op een vooronderstelling berustend",
