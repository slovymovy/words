{
    "word_family": [
        "break",
        "breakable",
        "breaker",
        "breakout",
        "unbreakable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5caaa60-3964-37f9-9fe8-8ebb4063574d",
                    "sense_definition": "The act or instance of breaking something, or the state of being broken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for new packaging materials to reduce the risk of <w>breakage</w> during shipping.",
                            "target_lang_translations": {
                                "ru": "Компания ищет новые упаковочные материалы, чтобы снизить риск <w>поломки</w> при транспортировке."
                            }
                        },
                        {
                            "text": "Careful handling of these glass ornaments is essential to <w>prevent</w> <w>breakage</w>.",
                            "target_lang_translations": {
                                "ru": "Осторожное обращение с этими стеклянными украшениями необходимо, чтобы <w>предотвратить</w> <w>бой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fracture",
                        "rupture"
                    ],
                    "common_phrases": [
                        "prevent breakage",
                        "risk of breakage",
                        "accidental breakage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай поломки чего-либо, либо состояние поврежденного предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поломка",
                                "target_lang_sense_clarification": "процесс или факт повреждения"
                            },
                            {
                                "target_lang_word": "разрушение",
                                "target_lang_sense_clarification": "нарушение целостности структуры"
                            },
                            {
                                "target_lang_word": "повреждение",
                                "target_lang_sense_clarification": "нанесение ущерба предмету"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb33a6d-180b-30f7-92e4-aaab0112898e",
                    "sense_definition": "An object or quantity of items that have been broken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant manager had to pay for all the <w>breakages</w> that occurred during the busy weekend shift.",
                            "target_lang_translations": {
                                "ru": "Менеджеру ресторана пришлось заплатить за весь <w>бой</w> посуды, случившийся во время загруженной смены в выходные."
                            }
                        },
                        {
                            "text": "After the move, we found several <w>breakages</w> among our kitchen supplies.",
                            "target_lang_translations": {
                                "ru": "После переезда мы обнаружили несколько <w>сломанных вещей</w> среди кухонных принадлежностей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "report breakages",
                        "pay for breakages"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или количество предметов, которые были сломаны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "разбитые хрупкие предметы, например, посуда"
                            },
                            {
                                "target_lang_word": "лом",
                                "target_lang_sense_clarification": "сломанные или негодные вещи"
                            },
                            {
                                "target_lang_word": "битые изделия",
                                "target_lang_sense_clarification": "совокупность поврежденных товаров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a2b5ec5-2a72-376d-8a9f-18d5dab6bed4",
                    "sense_definition": "Revenue gained by a company from unredeemed gift cards or services that were paid for but never used.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Retailers often count on <w>breakage</w> from gift cards to boost their annual profit margins.",
                            "target_lang_translations": {
                                "ru": "Ритейлеры часто рассчитывают на <w>невостребованные остатки</w> по подарочным картам, чтобы увеличить годовую прибыль."
                            }
                        },
                        {
                            "text": "The financial report highlights a significant increase in <w>breakage</w> income this quarter.",
                            "target_lang_translations": {
                                "ru": "В финансовом отчете отмечается значительный рост доходов от <w>неиспользованных средств</w> в этом квартале."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gift card breakage",
                        "breakage income"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and accounting context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доход компании от неиспользованных подарочных карт или оплаченных, но не востребованных услуг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невостребованный остаток",
                                "target_lang_sense_clarification": "в контексте подарочных карт"
                            },
                            {
                                "target_lang_word": "доход от неиспользованных услуг",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb9f67c-9fe0-32b8-a081-2f3b2c3fd692",
                    "sense_definition": "The small change or leftover money in betting pools resulting from rounding down the payouts to winners.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In horse racing, the <w>breakage</w> is usually kept by the track or the state as a form of tax.",
                            "target_lang_translations": {
                                "ru": "В скачках <w>остаток от округления</w> обычно удерживается ипподромом или государством в качестве налога."
                            }
                        },
                        {
                            "text": "The total <w>breakage</w> from the pari-mutuel pool was redistributed to the next race.",
                            "target_lang_translations": {
                                "ru": "Общая сумма <w>округлений</w> из пула тотализатора была перераспределена на следующий заезд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "betting breakage"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gambling and betting context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелочь или остаток средств в пулах ставок, возникающий в результате округления выплат победителям в меньшую сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "округление",
                                "target_lang_sense_clarification": "в пользу организатора пари"
                            },
                            {
                                "target_lang_word": "сдача",
                                "target_lang_sense_clarification": "остаток от округления выигрыша"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}