                ],
                "translations": [
                    {
                        "translation_id": "0166ed3a-cfb4-480d-8f66-6bb14268bd5d",
                        "source_entry_id": "45eaf140-5268-32ff-b558-a6df685c0f52",
                        "target_lang_word": "demonstrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonstrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show how to use (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc6ee62-da39-4461-a841-3d16f39769c1",
                                                "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                                "text": "Can you demonstrate the new tools for us?"
                                            },
                                            {
                                                "example_id": "30c1b261-7646-47a8-8025-47741e960620",
                                                "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                                "text": "In this tape, a velvet-voiced narrator provides a stroke-by-stroke guide to massaging your partner. As she speaks, comely nude couples demonstrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6b3c10-cc54-315a-b961-8729d714bc88",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show the steps taken to create a logical argument or equation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6362f091-c483-3dd4-a197-7b53d63a2c04",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To participate in or organize a demonstration."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77342f0-9784-446d-b5ed-c26fca2b6138",
                                                "sense_id": "6362f091-c483-3dd4-a197-7b53d63a2c04",
                                                "text": "Those people outside are demonstrating against the election results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show, display, or present; to prove or make evident"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78c78c2-8062-41d9-8c0c-5717fba18f0e",
                                                "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                                "text": "The debate was not long on policy, as questions about the Affordable Care Act and the war in Syria demonstrated."
                                            },
                                            {
                                                "example_id": "ea3db344-bddc-4510-8124-5e59321aabd6",
                                                "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                                "text": "\"What we are trying to demonstrate is that freight lines at lower speeds can be electrified much more cheaply. […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67a52218-0a58-479b-b3c6-71b6ef53cc1e",
                        "source_entry_id": "45eaf140-5268-32ff-b558-a6df685c0f52",
                        "target_lang_word": "manifester",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifester",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22f5e54b-3a13-375b-8c39-eea0a49619d4",
                                        "entry_id": "833e9c06-4513-30eb-ab43-62bfbc139fb0",
                                        "glosses": [
                                            "Rendre manifeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcca9b9-dbca-4182-848e-078e3bb3ebd7",
                                                "sense_id": "22f5e54b-3a13-375b-8c39-eea0a49619d4",
                                                "text": "Pendant toute la période des fiançailles, le futur gendre va, pour manifester sa bonne volonté au travail et rendre service à sa belle-mère, régulièrement approvisionner la maison de ses beaux-parents en bois de feu."
                                            },
                                            {
                                                "example_id": "296cdcde-9b90-428f-b079-4388683c2c79",
                                                "sense_id": "22f5e54b-3a13-375b-8c39-eea0a49619d4",
                                                "text": "Les habitants de la capitale, qui ont manifesté leur joie, mardi soir, appellent à abattre tout un « système », au-delà du président : « Il y a les autres et la lutte continue. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                                        "entry_id": "833e9c06-4513-30eb-ab43-62bfbc139fb0",
                                        "glosses": [
                                            "Se rendre visible."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c732343-b2aa-4601-ad48-70c1478757f4",
                                                "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                                                "text": "Enfin, dans tous les groupes étudiés jusqu’ici, l’individualité de chaque être se manifeste dès la première apparition du germe, dès les premiers rudimens de l’œuf, et persiste pleine et entière jusqu’à la mort."
                                            },
                                            {
                                                "example_id": "c4432877-80c3-4fa9-bd00-195fc6aca265",
                                                "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            },
                                            {
                                                "example_id": "0d43bca1-0e25-4ebc-a439-d1bf96eed09a",
                                                "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                                                "text": "La liquidation de l’affaire Dreyfus, […], a montré que le sublime bourgeois est une valeur de Bourse. Dans cette affaire se manifestèrent toutes les tares intellec­tuelles et morales d’une classe atteinte de folie."
                                            },
                                            {
                                                "example_id": "77a19a54-808a-4e94-b73b-7ccee23bbd82",
                                                "sense_id": "5c0b1276-e92d-3711-a9f0-bb876768d420",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse et l’on peut voir se manifester à la fois coopération et stratégie d’encerclement et de diversion dans la chasse aux petits potamochères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a957ef8-fe58-3c6e-a569-cbefe67830e3",
                                        "entry_id": "833e9c06-4513-30eb-ab43-62bfbc139fb0",
                                        "glosses": [
                                            "Faire une manifestation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2c687af-c696-426f-afbf-e50c30b79452",
                                                "sense_id": "0a957ef8-fe58-3c6e-a569-cbefe67830e3",
                                                "text": "La police ne permit pas de manifester."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d72168-83da-3a0f-a6cc-b616f1de4213",
                                        "entry_id": "833e9c06-4513-30eb-ab43-62bfbc139fb0",
                                        "glosses": [
                                            "Participer à une manifestation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f008fa6-53bc-430e-9331-28f6028a72b9",
                                                "sense_id": "54d72168-83da-3a0f-a6cc-b616f1de4213",
                                                "text": "Même les bouffeurs de curés manifestaient leur colère. Qu’on taguât les cathédrales, qu’on manifestât dans les couvents, peu leur importait."
                                            },
                                            {
                                                "example_id": "19581c35-aa25-46f5-9304-e55aecb34432",
                                                "sense_id": "54d72168-83da-3a0f-a6cc-b616f1de4213",
                                                "text": "Des « collectifs citoyens » mahorais se sont associés au mouvement en appelant la population à se rassembler à Mamoudzou, le chef-lieu du département, où quelque 200 personnes ont manifesté, arborant des salouvas, le pagne traditionnel, aux couleurs de Mayotte."
                                            },
                                            {
                                                "example_id": "f57d78ec-1a2a-4b6d-9adc-fcce3d039d4a",
                                                "sense_id": "54d72168-83da-3a0f-a6cc-b616f1de4213",
                                                "text": "De l’Iran au Pérou, du Sénégal au Chili en passant par la Chine, la Russie ou la France, des menaces sans précédent pèsent aujourd’hui sur le droit de manifester : tel est le terrible constat des enquêtes que nos chercheuses ont menées partout dans le monde grâce à vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96907e29-9d53-3513-a92a-04e1f27194b3",
                                        "entry_id": "833e9c06-4513-30eb-ab43-62bfbc139fb0",
                                        "glosses": [
                                            "Inscrire dans un manifeste de douane."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee9030a-467c-4b56-b15b-33ad5a522750",
                                                "sense_id": "96907e29-9d53-3513-a92a-04e1f27194b3",
                                                "text": "Sont passibles de la confiscation des marchandises litigieuses […] toute différence dans la nature des marchandises manifestées ou déclarées sommairement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
