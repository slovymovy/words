                                        "glosses": [
                                            "kleine domestizierte Tiere, die als Nutztiere gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5e5477-af06-4fd1-a3d0-cc164e7add05",
                                                "sense_id": "b0ad56b9-3795-3877-9ff8-ad0759abe056",
                                                "text": "Neben Rindern hält er auch etwas Kleinvieh, wie Kaninchen, Enten und Gänse."
                                            },
                                            {
                                                "example_id": "e75bc3ac-6a55-41b5-9b45-46a06ed00e61",
                                                "sense_id": "b0ad56b9-3795-3877-9ff8-ad0759abe056",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            },
                                            {
                                                "example_id": "d7429ce3-a286-4be8-9276-ebe0e4658f44",
                                                "sense_id": "b0ad56b9-3795-3877-9ff8-ad0759abe056",
                                                "text": "„Das Kleinvieh war der wesentliche Lieferant von Milch und Fleisch.“"
                                            }
                                        ],
