            "senses": [
                {
                    "sense_id": "f73e4e38-734f-33cf-8429-3924d701c4db",
                    "sense_definition": "present participle and gerund of <w>vomit</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient has been <w>vomiting</w> continuously since eating the undercooked seafood.",
                            "target_lang_translations": {
                                "de": "Der Patient <w>übergibt sich</w> ununterbrochen, seit er die unzureichend gekochten Meeresfrüchte gegessen hat.",
                                "ru": "Пациента непрерывно <w>рвет</w> с тех пор, как он съел недоваренные морепродукты."
                            }
                        },
                        {
                            "text": "She had to pull the car over because she started <w>vomiting</w> uncontrollably.",
                            "target_lang_translations": {
                                "de": "Sie musste das Auto anhalten, weil sie anfing, sich unkontrolliert zu <w>übergeben</w>.",
                                "ru": "Ей пришлось остановить машину, потому что её начала безудержно <w>рвать</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop vomiting",
                        "vomiting blood"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'vomit'; sich übergeben, erbrechen.",
                        "ru": "Причастие настоящего времени и герундий от глагола vomit; рвать, тошнить."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich erbrechen",
                                "target_lang_sense_clarification": "gehoben/medizinisch"
                            },
                            {
                                "target_lang_word": "sich übergeben",
                                "target_lang_sense_clarification": "standardsprachlich"
                            },
                            {
                                "target_lang_word": "kotzen",
                                "target_lang_sense_clarification": "umgangssprachlich"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "безличный процесс извержения содержимого желудка"
                            },
                            {
                                "target_lang_word": "тошнить",
                                "target_lang_sense_clarification": "приступ рвоты или тошноты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "299bd3f2-4f87-3eb8-be0d-92814b815daa",
                    "sense_definition": "The act of ejecting matter from the stomach through the mouth, or the matter that is ejected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe cases of the stomach flu often involve persistent nausea and <w>vomiting</w>.",
                            "target_lang_translations": {
                                "de": "Schwere Fälle von Magen-Darm-Grippe gehen oft mit anhaltender Übelkeit und <w>Erbrechen</w> einher.",
                                "ru": "Тяжелые случаи желудочного гриппа часто сопровождаются постоянной тошнотой и <w>рвотой</w>."
                            }
                        },
                        {
                            "text": "The doctor asked if the sudden bouts of <w>vomiting</w> were accompanied by a fever.",
                            "target_lang_translations": {
                                "de": "Der Arzt fragte, ob die plötzlichen Anfälle von <w>Erbrechen</w> von Fieber begleitet waren.",
                                "ru": "Врач спросил, сопровождались ли внезапные приступы <w>рвоты</w> повышенной температурой."
                            }
                        }
                    ],
                    "synonyms": [
                        "emesis",
                        "throwing up",
                        "vomit"
                    ],
                    "common_phrases": [
                        "nausea and vomiting",
                        "persistent vomiting"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Ausstoßen von Mageninhalt durch den Mund (Erbrechen) oder das Erbrochene selbst.",
                        "ru": "Извержение содержимого желудка через рот, а также сами извергнутые массы."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Erbrechen",
