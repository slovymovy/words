                                            {
                                                "example_id": "57bceb70-d578-4d5a-bf3c-b454651211d7",
                                                "sense_id": "bc015be3-03a3-3bbc-92d5-faa60f121c0b",
                                                "text": "Er vindt vooral veel sinificatie plaats in Tibet."
