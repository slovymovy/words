                "senses": [
                    {
                        "sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                        "entry_id": "a850218b-b2a9-3b98-9404-553f62cb30d5",
                        "glosses": [
                            "Wort oder Wortgruppe, womit jemand einen Fluch äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae02231-d8ea-45e2-b28c-19733f866351",
                                "sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                                "text": "„Dann ist als Fluchwort auch die Hölle helvete wichtig, statt ›verpiss dich!‹ heißt es unter den Schweden ›Geh zur Hölle!‹ Dra åt helvete!“"
                            },
                            {
                                "example_id": "f2647f3b-ba0c-4ea5-a318-0ad45cb36cc9",
                                "sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                                "text": "„Bereitwilligst verpflichtete ich mich hierzu mit den feierlichsten Fluchworten und Verwünschungen, die der Teufel und wir beide nur zu finden vermochten.“"
                            },
                            {
                                "example_id": "53d40e54-6870-4161-9a0e-8336a94ca029",
                                "sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                                "text": "„Noch verstärkt werden konnte dieses Fluchwort durch die Zusammensetzung mit Schock: Schockschwerenot!“"
                            },
                            {
                                "example_id": "be9d59f0-5d0e-4dfa-82e7-f03977c21825",
                                "sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                                "text": "„Ein Pferd wieherte, eine Peitsche klappte, ein Fluchwort kam hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52fc6f8-ac0d-45b2-b8a0-b478448d740e",
                        "source_entry_id": "a850218b-b2a9-3b98-9404-553f62cb30d5",
                        "source_sense_id": "ddf1740c-fd24-37b4-b807-401ebef12ed5",
                        "source_sense_description": "Wort oder Wortgruppe, womit jemand einen Fluch äußert",
                        "target_lang_word": "juron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fdb6ec5-1cf8-375a-ba01-3a0d440fe346",
                                        "entry_id": "05dab255-4289-3669-8535-149cc985daef",
                                        "glosses": [
                                            "Exclamation de colère ou de surprise n’ayant généralement pas de destinataire particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f565cb-77a3-4296-b968-347ce49abf24",
                                                "sense_id": "7fdb6ec5-1cf8-375a-ba01-3a0d440fe346",
                                                "text": "Qu'est-ce qu'un juron, en effet...? Un mot par lequel l'homme en colère exhale d'un seul coup des sentiments qui demanderaient quelquefois un volume pour s'exprimer congrûment."
                                            },
                                            {
                                                "example_id": "03e55098-54bc-49df-87ea-6fbedcf05ef7",
                                                "sense_id": "7fdb6ec5-1cf8-375a-ba01-3a0d440fe346",
                                                "text": "Le buraliste, plutôt lève-tard et de mauvaise humeur, montait à peine son rideau de fer récalcitrant en poussant quelques jurons."
                                            },
                                            {
                                                "example_id": "3aed9d46-3b69-4231-9900-7c576e0c8598",
                                                "sense_id": "7fdb6ec5-1cf8-375a-ba01-3a0d440fe346",
                                                "text": "Dans la bande dessinée Zembla, l’un des jurons préférés de Yéyé est : Par saint Frusquin ! Dans cette même bande dessinée, l’un des jurons préférés de Satanas est : Par Astaroth !'"
                                            },
                                            {
                                                "example_id": "67da1a3f-2a9d-46ca-a663-37cf81d62be8",
                                                "sense_id": "7fdb6ec5-1cf8-375a-ba01-3a0d440fe346",
                                                "text": "Heathcliff grogna un juron et serra plus étroitement contre lui Catherine, qui restait immobile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca4db89-86d6-31cf-914e-5171873ce6de",
                                        "entry_id": "05dab255-4289-3669-8535-149cc985daef",
                                        "glosses": [
                                            "Ce par quoi on jure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b24b228-7bf4-42ea-8143-8c407334d5a7",
                                                "sense_id": "1ca4db89-86d6-31cf-914e-5171873ce6de",
                                                "text": "...lequel luy demãdant compte d'vn sien anneau, qui eftoit eftimé valoir cinquante mil pagodes, l'autre iura par les pieds du Roy (car c'eft le plus grand juron qu'ils ayent) ne l'auoir point prins"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "juron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a8dc74-8c86-3423-bfc8-c9c8f9662e32",
                                        "entry_id": "a2088593-d937-3e24-b019-dc6a868cf559",
                                        "glosses": [
                                            "Vent devant de l’est."
