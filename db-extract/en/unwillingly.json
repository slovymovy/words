                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c65004-96f5-4a58-bba5-395453fe47a6",
                                "sense_id": "50611514-5884-301f-9f6f-936fcbc414b1",
                                "text": "Mai unwillingly starts her journey, wondering how she, still dependent on her parents, can possibly be a reliable companion to her frail grandmother."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb4b7082-3a1c-4eda-8a8d-b05f50b5eb59",
                        "source_entry_id": "20b77f01-e245-3550-b951-95567d79f0b9",
