                        "form": "(das) Arkansas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ca1fb47-4266-3345-aa75-e7d14b676ba3",
                        "entry_id": "c659b002-24d0-3b05-8286-86a42d0d1183",
                        "glosses": [
                            "US-Bundesstaat im Süden der USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "375c5d17-bb53-4dfd-9f70-632552ee8a76",
                                "sense_id": "2ca1fb47-4266-3345-aa75-e7d14b676ba3",
                                "text": "Die Hauptstadt von Arkansas ist Little Rock."
                            },
                            {
                                "example_id": "a2f56945-76bc-4d0b-80e4-4a6490d3db8d",
                                "sense_id": "2ca1fb47-4266-3345-aa75-e7d14b676ba3",
                                "text": "„Jawohl, der Frühling kam, nachdem Tom Sawyer und ich unseren alten Neger Jim befreit hatten, der von Toms Onkel Silas in Arkansas fürs Ausreißen in Ketten gelegt worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b2638c5-1ae3-36c7-8ba7-83460b802280",
                        "entry_id": "c659b002-24d0-3b05-8286-86a42d0d1183",
                        "glosses": [
                            "Nebenfluss des Mississippi, USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17135369-1965-41c7-9855-66a033d80650",
                                "sense_id": "6b2638c5-1ae3-36c7-8ba7-83460b802280",
                                "text": "„Von St. Louis fließt der Strom [der Mississippi] ungehindert zum Meer. Auf dem Weg münden der Ohio, der Red River und der Arkansas ein.“"
                            },
                            {
                                "example_id": "3bfc7f15-bb9f-4275-98cb-91965711a045",
                                "sense_id": "6b2638c5-1ae3-36c7-8ba7-83460b802280",
                                "text": "„Jacques Marquette, französischer Jesuit und Missionar in Kanada, entdeckt gemeinsam mit dem Forschungsreisenden Louis Joillet westlich des Michigansees den Oberlauf des Mississippi und befährt ihn als erster Europäer bis zur Mündung des Arkansas.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
