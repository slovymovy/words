                        "glosses": [
                            "Établissement de restauration tenant à la fois du restaurant et du bistro."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed497a1-c4b1-4612-ad7c-f157fe0aa6da",
                                "sense_id": "c61859d6-d9fd-3cd1-a801-244be532699d",
                                "text": "Dans ce petit restaurant-bistro, la cuisine et le service sont assurés par les patrons. On aime la bavette et l’onglet, le flétan à l’huile de truffes, la joue de bœuf braisée, les fromages d’ici et la tarte flambée, sans oublier la qualité des vins servis et les prix plus que corrects."
                            },
                            {
                                "example_id": "30b1f267-5a2c-4bf7-90ae-fd39af1274ac",
                                "sense_id": "c61859d6-d9fd-3cd1-a801-244be532699d",
                                "text": "Le bar fait également partie de l’attrait de ce restaurant-bistro. On y prépare autant les cocktails que le vin, servi à prix raisonnable tant au verre qu’en bouteille."
                            }
                        ]
                    }
