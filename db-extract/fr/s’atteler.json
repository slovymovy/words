                    {
                        "sense_id": "c00c1902-cb80-3b64-9332-0f59985d002c",
                        "entry_id": "d21f6ba7-626e-3aed-b71c-f3e85668db32",
                        "glosses": [
                            "Se mettre au travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea1530f-ba60-4dd0-b3a4-112e50b6fc6a",
                                "sense_id": "c00c1902-cb80-3b64-9332-0f59985d002c",
                                "text": "S'atteler à la tâche."
                            },
                            {
                                "example_id": "3dc468d5-d5c5-4f41-870d-d5219972ff2e",
                                "sense_id": "c00c1902-cb80-3b64-9332-0f59985d002c",
                                "text": "Je ne peux pas écrire sur le temps que Lucile a passé avec mon père.\nC’est une donnée de départ, une contrainte formelle, un chapitre en creux, dérobé à l’écriture. Je le savais avant même de commencer ce livre et cela fait partie des raisons qui m’ont longtemps empêchée de m’y atteler."
                            }
                        ]
                    }
