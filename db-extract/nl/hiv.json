        "nl-extract.jsonl": [
            {
                "entry_id": "3057c22c-bdc8-3a5b-bcce-1772ce57ae4f",
                "word": "hiv",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbcd6079-c56f-31e4-bb47-c3336f18ab75",
                        "entry_id": "3057c22c-bdc8-3a5b-bcce-1772ce57ae4f",
                        "glosses": [
                            "menselijk immuundeficiëntievirus, de soort die aids kan veroorzaken"
                        ],
                        "tags": [
                            "virussen"
                        ],
                        "examples": [
                            {
                                "example_id": "069f64c9-2751-415c-b971-7ccd5ceca90a",
                                "sense_id": "cbcd6079-c56f-31e4-bb47-c3336f18ab75",
                                "text": "Hiv is een snel muterend retrovirus en is tevens verantwoordelijk voor het syndroom aids."
                            },
                            {
                                "example_id": "0614d7b1-e4f3-4172-917b-915d5b6608f2",
                                "sense_id": "cbcd6079-c56f-31e4-bb47-c3336f18ab75",
                                "text": "Zij zei dat dit prikgaatje bijna niet anders dan van een naald kon komen. Ik ben meteen getest op hiv en hepatitis, alleen moet je daar na drie maanden voor terugkomen. Dat was stressvol, want ik dacht dagelijks: zou ik nu ziek zijn?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "292eca5e-cb29-4dc8-8a9d-9740f30ad40b",
                        "source_entry_id": "3057c22c-bdc8-3a5b-bcce-1772ce57ae4f",
                        "source_sense_id": "cbcd6079-c56f-31e4-bb47-c3336f18ab75",
                        "source_sense_description": "menselijk immuundeficiëntievirus",
                        "target_lang_word": "HIV",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "HIV",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d981a98-4017-3bbc-b834-bed7d79b23c5",
                                        "entry_id": "22e2095f-4cdc-356c-9313-495267fb46bc",
                                        "glosses": [
                                            "Human Immunodeficiency Virus, zu deutsch Menschliches Immun-Schwäche-Virus"
                                        ],
                                        "tags": [
                                            "meist im Singular",
                                            "meist ohne Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3f6f88-307d-43eb-923d-0780d1a198ef",
                                                "sense_id": "5d981a98-4017-3bbc-b834-bed7d79b23c5",
                                                "text": "In Deutschland leben rund 43 000 Menschen mit HIV."
                                            },
                                            {
                                                "example_id": "bc73dc0d-b853-4291-8967-db4af539ec6a",
                                                "sense_id": "5d981a98-4017-3bbc-b834-bed7d79b23c5",
                                                "text": "„Allerdings ist HIV medial nicht deswegen so ein großes Thema, weil so viele Menschen daran sterben, sondern weil viele Prominente an Aids erkranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b2ebfd4-88ce-4b72-acc2-7212c624c4da",
                        "source_entry_id": "3057c22c-bdc8-3a5b-bcce-1772ce57ae4f",
                        "source_sense_id": "cbcd6079-c56f-31e4-bb47-c3336f18ab75",
                        "source_sense_description": "menselijk immuundeficiëntievirus",
                        "target_lang_word": "HIV",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "HIV",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43836b08-d1e0-3084-a93b-77fdfdd53fed",
                                        "entry_id": "6adf2a12-349a-38be-98d3-a0e6aa5abdab",
                                        "glosses": [
                                            "Initialism of human immunodeficiency virus."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2271de6d-d2a0-473f-a426-1a9d3ce2a369",
                                                "sense_id": "43836b08-d1e0-3084-a93b-77fdfdd53fed",
                                                "text": "There have been other drugs since reticulose that I became aware of the successes of, some even able to claim \"cure,\" even turning people from HIV-positive to negative."
                                            },
                                            {
                                                "example_id": "dfe8340d-f393-440e-ad90-743dae9ecf52",
                                                "sense_id": "43836b08-d1e0-3084-a93b-77fdfdd53fed",
                                                "text": "Accordingly, we varied HIV transmission probability per coital act, duration of each HIV stage, frequency of coital acts per HIV stage, duration of partnership, degree of assortativeness, scale parameter in the gamma distribution of the population across the risk groups, and exponent parameter in the power-law function of the distribution of sexual-risk behavior."
                                            },
                                            {
                                                "example_id": "4cf61f60-da65-4e1d-9705-e04f2f3f02f2",
                                                "sense_id": "43836b08-d1e0-3084-a93b-77fdfdd53fed",
                                                "text": "A 2013 study found the HIV rate among injecting IPED users in England and Wales was 1.5 percent, comparable to 1.2 percent among users of psychoactive drugs like heroin and crack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c92b549-62ef-31e3-8af0-09e4608a48dc",
                                        "entry_id": "6adf2a12-349a-38be-98d3-a0e6aa5abdab",
                                        "glosses": [
                                            "Initialism of header isolation valve."
                                        ],
