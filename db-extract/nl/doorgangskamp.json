                        "examples": [
                            {
                                "example_id": "96ff6f96-e9f4-42f0-beb8-0c41c0c02fba",
                                "sense_id": "1f9ec68c-1f27-31fa-b314-d9c8d9655d42",
                                "text": "\"Het was hier een doorgangskamp voor 1500 tot 3000 vluchtelingen. Die bleven enkele uren of sliepen hier een nachtje en gingen weer verder. Dat kan nu niet meer en daardoor is het hier veel drukker. Er is gebrek aan tenten, schoon water, sanitair en voeding.\""
                            },
                            {
                                "example_id": "47d8cdca-3e72-428e-ad66-a2dd16f82724",
                                "sense_id": "1f9ec68c-1f27-31fa-b314-d9c8d9655d42",
                                "text": "Vandaag precies 70 jaar geleden bevrijdden de Canadezen doorgangskamp Westerbork, waar op dat moment nog bijna 900 Joden gevangen waren. Door de bevrijding bleef hun het lot van deportatie naar de vernietigingskampen bespaard."
                            }
                        ]
