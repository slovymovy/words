                "senses": [
                    {
                        "sense_id": "6d00f51c-9f97-3f3a-9215-2f9dcbb8ddc0",
                        "entry_id": "4b540e29-3783-3b5c-9218-dccea76550c0",
                        "glosses": [
                            "Raum für Gäste in einem Gasthaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1780e1d7-6a71-4e3f-80f1-4b5ee945b5e0",
                                "sense_id": "6d00f51c-9f97-3f3a-9215-2f9dcbb8ddc0",
                                "text": "„Minutenlang wirbelte der Herbert jetzt zwischen Küche und Gastraum, um Saucieren und Assietten nachzufüllen.“"
                            },
                            {
                                "example_id": "647d7cde-0222-490b-9a84-502dc75ad7eb",
                                "sense_id": "6d00f51c-9f97-3f3a-9215-2f9dcbb8ddc0",
                                "text": "„Er hatte rasch gefrühstückt und war dann rechtzeitig vor den anderen aus dem Gastraum aufgebrochen.“"
                            },
                            {
                                "example_id": "765e29d2-b348-470d-86fa-d97642762ef9",
                                "sense_id": "6d00f51c-9f97-3f3a-9215-2f9dcbb8ddc0",
                                "text": "„Wir kamen in den Gastraum zurück und setzten uns an den Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
