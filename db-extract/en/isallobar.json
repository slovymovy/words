                    {
                        "sense_id": "8425fd2f-60f1-3a81-bf0f-2b44766c840c",
                        "entry_id": "f5d4662e-002a-3064-be70-c30b0a52315f",
                        "glosses": [
                            "A line joining points of equal pressure change during a specific time interval, especially over three hours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c84867-2ee5-482d-b4b8-e24de0c06a34",
                                "sense_id": "8425fd2f-60f1-3a81-bf0f-2b44766c840c",
                                "text": "Seasonal variations of atmospheric pressure are illustrated by the isallobaric chart […] which gives the differences between mean pressure in July–August, and in January–February. The position of the isallobars on this chart is largely indicative of the role of monsoonal factors […]"
                            },
                            {
                                "example_id": "7a669625-b6e2-4d81-9df8-0453636dfcc5",
                                "sense_id": "8425fd2f-60f1-3a81-bf0f-2b44766c840c",
                                "text": "Successive values of pressure provide figures for the barometric tendency, permitting the plotting of isallobars […] This is called tendency analysis."
                            },
                            {
                                "example_id": "1fd762d5-96ea-436d-9cd4-4afa7cec121d",
                                "sense_id": "8425fd2f-60f1-3a81-bf0f-2b44766c840c",
                                "text": "If your barometer has dropped 0.05 of an inch in the last three hours, you are on the -0.05 isallobar."
                            }
                        ]
                    }
                ],
