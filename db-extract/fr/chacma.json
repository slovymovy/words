                    {
                        "sense_id": "0076f226-19c3-3e87-928e-257a7aec0cd0",
                        "entry_id": "69ff66e5-d027-3443-90ec-6184772248c5",
                        "glosses": [
                            "Espèce de grand singe des savanes d’Afrique australe, de la famille des babouins, au pelage gris cendre brunâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412108cb-5bd4-4e30-9de8-f6e499284260",
                                "sense_id": "0076f226-19c3-3e87-928e-257a7aec0cd0",
                                "text": "L’autre femelle, de même que celle-ci, avait été couverte par plusieurs mâles, dont le plus vigoureux était, non un Papion (Cynocephalus Sphinx), mais un Chacma (Cynocephalus Porcarius)."
                            },
                            {
                                "example_id": "3ac82131-99ce-459c-9ce2-b2df182b714b",
                                "sense_id": "0076f226-19c3-3e87-928e-257a7aec0cd0",
                                "text": "Chez le babouin chacma, par exemple, les mâles sont progressivement acceptés dans les groupes matrilinéaires en s'associant avec des individus femelles et leurs enfants."
                            }
                        ]
                    }
                ],
