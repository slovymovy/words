                                        "entry_id": "6607d37e-7fb5-3524-a555-0b40604c8c2f",
                                        "glosses": [
                                            "Galerie réservée aux matrones dans certaines églises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6f9f53-341d-4304-adb5-60bf2bc24fd1",
                                                "sense_id": "adf8f229-f49c-3fa9-abc5-80bb92645ccb",
                                                "text": "Au-dessus des nefs latérales avait été aménagée une galerie que l’on donne comme un emplacement réservé aux chrétiennes, le matroneum."
                                            }
                                        ]
                                    }
                                ]
