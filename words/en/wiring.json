    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fe09f18-1394-3358-a1af-9296dc4b5a63",
                    "sense_definition": "A system or network of electric wires used to carry electricity in a building, vehicle, or device.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "electrical_systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician spent the whole afternoon checking the faulty <w>wiring</w> in the old house.",
                            "target_lang_translations": {
                                "ru": "Электрик провел весь день, проверяя неисправную <w>проводку</w> в старом доме."
                            }
                        },
                        {
                            "text": "You should replace the electrical <w>wiring</w> to prevent any risk of a fire.",
                            "target_lang_translations": {
                                "ru": "Вам следует заменить электро<w>проводку</w>, чтобы предотвратить риск возникновения пожара."
                            }
                        }
                    ],
                    "synonyms": [
                        "cabling",
                        "electrical system"
                    ],
                    "common_phrases": [
                        "electrical wiring",
                        "faulty wiring",
                        "internal wiring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система или сеть электрических проводов, используемых для передачи электроэнергии в здании, транспортном средстве или устройстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводка",
                                "target_lang_sense_clarification": "электрическая система в здании или устройстве"
                            },
                            {
                                "target_lang_word": "электропроводка",
                                "target_lang_sense_clarification": "совокупность проводов и кабелей"
                            },
                            {
                                "target_lang_word": "монтаж",
                                "target_lang_sense_clarification": "процесс или результат прокладки проводов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7a77120-1cb2-3897-b3ef-347efce1bd27",
                    "sense_definition": "The present participle and gerund of <w>wire</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>wiring</w> the new office for high-speed internet access.",
                            "target_lang_translations": {
                                "ru": "В данный момент он <w>прокладывает кабель</w> в новом офисе для высокоскоростного доступа в интернет."
                            }
                        },
                        {
                            "text": "After <w>wiring</w> the money to his family, he felt a great sense of relief.",
                            "target_lang_translations": {
                                "ru": "После <w>перевода</w> денег своей семье он почувствовал огромное облегчение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiring money",
                        "wiring a house"
                    ],
                    "traits": [
