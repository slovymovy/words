                                "target_senses": [
                                    {
                                        "sense_id": "d75f276f-f990-3768-92ca-e99e1f92954a",
                                        "entry_id": "6d2748c1-5fda-3045-a0e5-fe5416dbee76",
                                        "glosses": [
                                            "Procédé comparable à la lithographie, appliqué sur du zinc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920b9d59-8e78-43c4-80cb-62ab6564cd0e",
                                                "sense_id": "d75f276f-f990-3768-92ca-e99e1f92954a",
                                                "text": "En 1829, M. Bregnot fit des essais pour imprimer au moyen de planches de zinc, […]. M. Bregnot céda son brevet à M. Carcenac, et il paraît que c’est vers cette époque que la zincographie commença à se répandre en Angleterre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1372923-c6d3-37d6-b235-31d5114d6146",
                                        "entry_id": "6d2748c1-5fda-3045-a0e5-fe5416dbee76",
                                        "glosses": [
                                            "Résultat de ce procédé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497ca2f3-22ab-435d-9688-8c6a251df224",
                                                "sense_id": "f1372923-c6d3-37d6-b235-31d5114d6146",
                                                "text": "Parmi les nouveautés, acquises ou données, Les Misères humaines, 1889, une zincographie de Paul Gauguin, Jeune fille de Pont-Aven, 1889, une huile sur toile d'Henry Mosler, […]."
                                            },
                                            {
                                                "example_id": "0880476b-05e6-4c35-b5e1-96bacf7e90d1",
                                                "sense_id": "f1372923-c6d3-37d6-b235-31d5114d6146",
                                                "text": "Une des sept zincographies de la série Paris intense publiée par L. Joly, un marchand qui fut un des plus solides défenseurs de Vallotton."
                                            }
                                        ]
                                    }
                                ]
                            },
