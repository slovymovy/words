                "senses": [
                    {
                        "sense_id": "1b21fe96-dfc7-394e-9675-f4a0f7429c17",
                        "entry_id": "1e09d096-95c3-34f6-8d34-0b6ae5568a1b",
                        "glosses": [
                            "Avancée en encorbellement sur une façade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd9138e-c0a2-43b6-a627-e8647a47e0b2",
                                "sense_id": "1b21fe96-dfc7-394e-9675-f4a0f7429c17",
                                "text": "Un oriel permet de jouir d’un peu plus de clarté et de chaleur solaire, en plus d’une meilleure vue sur la rue (sa fonction militaire initiale)."
                            },
                            {
                                "example_id": "4ed5f0b3-38e1-413c-8f69-4f45b208cbaf",
                                "sense_id": "1b21fe96-dfc7-394e-9675-f4a0f7429c17",
                                "text": "Les voiles des rideaux se sont agités comme des spectres. En regardant le fleuve à travers la croisée de l’oriel, j'ai eu l'impression de voguer sur un vaisseau fantôme dont je ne débarquerais pas avant une éternité..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c6b383e-3f2c-44d3-90aa-77769edf7db2",
                        "source_entry_id": "1e09d096-95c3-34f6-8d34-0b6ae5568a1b",
                        "source_sense_id": "1b21fe96-dfc7-394e-9675-f4a0f7429c17",
                        "target_lang_word": "Erker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                        "entry_id": "a5c90b42-3c81-3020-a93f-8ff28ac25740",
                                        "glosses": [
                                            "geschlossener, mit Fenstern versehener Vorbau an Gebäuden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94282b00-389b-4ff0-8a13-5ad528fdb645",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "Wenn ich mal ein Haus baue, dann muss es unbedingt einen Erker haben."
                                            },
                                            {
                                                "example_id": "3a4fdfa1-e4c9-4a4b-8b59-d78e4e476ece",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "„Cecilienhof war erst 1917, ein Jahr vor dem Ende des Ersten Weltkriegs, fertig gestellt worden, ein Landsitz mit 176 Räumen im überladenen Tudor-Stil: lauter Erker, ein Wald von Schornsteinen, efeuumschlungene Fachwerkfassaden.“"
                                            },
                                            {
                                                "example_id": "8e324153-e1c2-4a27-9041-e75e03ebd1b0",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "„Die weißgetünchte zweistöckige Villa mit hohen Sprossenfenstern und einem runden Erker an der rechten Seite lag am Ende eines parkähnlichen Grundstücks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b66def9-f6aa-4304-b8e6-95eacaf93bbd",
                        "source_entry_id": "1e09d096-95c3-34f6-8d34-0b6ae5568a1b",
                        "source_sense_id": "1b21fe96-dfc7-394e-9675-f4a0f7429c17",
