                        ]
                    },
                    {
                        "translation_id": "a8ce102c-c714-471c-9cd3-31572d096bb1",
                        "source_entry_id": "083e72f2-f312-373e-8492-58222fe85cda",
                        "source_sense_id": "8dc9e5ab-36cf-3a4a-8872-178d27a63855",
                        "target_lang_word": "climacteric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climacteric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "777ef3d0-4e5c-3b9c-8e8e-f9e7ae95c895",
                                        "entry_id": "8f639c69-de2d-3d5b-8a30-1517fdab713f",
                                        "glosses": [
                                            "Pertaining to any of several supposedly critical years of a person's life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cddeb50-2cd6-40d3-a799-aa655013e2f3",
                                                "sense_id": "777ef3d0-4e5c-3b9c-8e8e-f9e7ae95c895",
                                                "text": "Closely parallel to the belief in unlucky days was the notion of climacteric years, those periodic dates in a man's life which were potential turning-points in his health and fortune."
                                            },
                                            {
                                                "example_id": "02f72425-1232-48f9-ac27-d082c5921e19",
                                                "sense_id": "777ef3d0-4e5c-3b9c-8e8e-f9e7ae95c895",
                                                "text": "Asari pass through three climacteric life stages, marked by biochemical and physiological changes. The Maiden stage begins at birth and is marked by the drive to explore and experience. Most young asari are curious and restless. The Matron stage of life begins around the age of 350, though it can be triggered earlier if the individual melds frequently. This period is marked by a desire to settle in one area and raise children. The Matriarch stage begins around 700, or earlier if the individual melds rarely. Matriarchs become active in their community as sages and councilors, dispensing wisdom from centuries of experience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f05434-3ffd-31ab-960d-e849cbd259dc",
                                        "entry_id": "8f639c69-de2d-3d5b-8a30-1517fdab713f",
                                        "glosses": [
                                            "Critical or crucial; decisive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a6d077-2edb-4573-8fd3-50d0d22f1a81",
                                                "sense_id": "f3f05434-3ffd-31ab-960d-e849cbd259dc",
                                                "text": "The seeds of a climateric insurrection against the hypocrisy of cultural norms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d670de-a5db-34b4-8187-e41742b4d361",
                                        "entry_id": "8f639c69-de2d-3d5b-8a30-1517fdab713f",
                                        "glosses": [
                                            "Relating to a period of physiological change during middle age; especially, menopausal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6471d5db-939e-3f87-8cd3-2db9486de0bb",
                                        "entry_id": "8f639c69-de2d-3d5b-8a30-1517fdab713f",
                                        "glosses": [
                                            "Climactic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "climacteric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d0d8aa-0803-3822-a3c7-c8e85c60b368",
                                        "entry_id": "4878ccbf-6dbb-367a-8a6f-d091928c6efa",
                                        "glosses": [
                                            "A critical stage or decisive point; a turning point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e6c4aa-dfcc-4b5a-a71c-90788491acb9",
                                                "sense_id": "c0d0d8aa-0803-3822-a3c7-c8e85c60b368",
                                                "text": "It is your lot, as it was mine, to live during one of the grand climacterics of the world."
                                            },
                                            {
                                                "example_id": "801901e6-c7d1-413c-a5e5-afd0306c5e2a",
                                                "sense_id": "c0d0d8aa-0803-3822-a3c7-c8e85c60b368",
                                                "text": "Sketch of Connecticut, Forty Years Since, p. 66-67.\n[H]e was in his grand climacterick, with a florid brow, and a step like youthful agility. Sigourney, Lydia."
                                            },
                                            {
                                                "example_id": "b412454f-d495-4275-92a2-7c0852cff24d",
                                                "sense_id": "c0d0d8aa-0803-3822-a3c7-c8e85c60b368",
                                                "text": "I should hardly yield my rigid fibers to be regenerated by them; nor begin, in my grand climacteric, to squall in their new accents, or to stammer, in my second cradle, the elemental sounds of their barbarous metaphysics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae254118-16c3-33b6-9295-528a6163a560",
                                        "entry_id": "4878ccbf-6dbb-367a-8a6f-d091928c6efa",
                                        "glosses": [
                                            "A period in human life in which some great change is supposed to take place, calculated in different ways by different authorities (often identified as every seventh or ninth year)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a75eee6-82dd-3614-bc7b-d2fa471ca4e1",
                                        "entry_id": "4878ccbf-6dbb-367a-8a6f-d091928c6efa",
                                        "glosses": [
                                            "The period of life that leads up to and follows the end of menstruation in women; the menopause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a31e73e-2f45-4258-b0a2-be55f4e9015d",
                                                "sense_id": "3a75eee6-82dd-3614-bc7b-d2fa471ca4e1",
                                                "text": "Once women have traversed the turmoil of the climacteric years and reached the hormonal steady-state of the post-menopause, there is almost certainly no increase in the incidence of depression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
