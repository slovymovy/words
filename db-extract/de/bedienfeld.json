                "senses": [
                    {
                        "sense_id": "64ec1905-5075-334f-86cf-ac0f2d11e01e",
                        "entry_id": "4a10b28c-53ce-3099-9a06-3be290aea2e9",
                        "glosses": [
                            "Fläche, auf der unter anderem Knöpfe und Tasten platziert sind, um damit eine Maschine, Anlage oder Ähnliches zu steuern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f1b066-b9ca-44e3-9b4b-53b17e52d7f1",
                                "sense_id": "64ec1905-5075-334f-86cf-ac0f2d11e01e",
                                "text": "„Mit einer Wärmekamera und einer normalen Filmkamera könnte künftig nahezu jede Oberfläche zu einem interaktiven Bedienfeld werden.“"
                            },
                            {
                                "example_id": "d8e14072-79d9-4cf5-aa5d-d967d9ce6476",
                                "sense_id": "64ec1905-5075-334f-86cf-ac0f2d11e01e",
                                "text": "„Haben sich die Piloten davon überzeugt, dass ein Crewmitglied draußen steht, entriegeln sie die Tür mit einem kleinen Schalter, der sich entweder auf der Mittelkonsole oder auf dem Bedienfeld an der Decke befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14dc2300-90e1-4106-88b4-9a8be4843538",
                        "source_entry_id": "4a10b28c-53ce-3099-9a06-3be290aea2e9",
                        "source_sense_id": "64ec1905-5075-334f-86cf-ac0f2d11e01e",
                        "source_sense_description": "Fläche, auf der Steuerungselemente platziert sind, um eine Apparatur zu steuern",
