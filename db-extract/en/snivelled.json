                        "sense_id": "d9b2b596-9eeb-3dc0-9e2f-a20f2b023301",
                        "entry_id": "6b3d1edb-3ede-3c98-a87f-7f0d826818a4",
                        "glosses": [
                            "Covered or dripping with nasal mucus; snotty."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff1cda30-895c-4cfb-a9ae-7fb4120505f7",
                                "sense_id": "d9b2b596-9eeb-3dc0-9e2f-a20f2b023301",
                                "text": "And to mend these slouenly maners, [they] be not ashamed, many tymes with these filthy napkyns, to wype awaye the sweat that trickleth and falleth downe their browes, their face and their necke (they be such greedy guts in their feeding) and otherwhile to, (when it comes vppon them) spare not to snot their sniueld nose vppon them."
                            },
                            {
                                "example_id": "e3545df7-261f-42f1-a2a3-633c6b3f5835",
                                "sense_id": "d9b2b596-9eeb-3dc0-9e2f-a20f2b023301",
                                "text": "Nor imitate with Socrates\nto wipe thy snivelled nose\nUpon thy cap, as he would doe,\nnor yet upon thy clothes."
                            },
                            {
                                "example_id": "70da2fd3-396c-49b1-ae49-fb4dbfbc0a93",
                                "sense_id": "d9b2b596-9eeb-3dc0-9e2f-a20f2b023301",
                                "text": "[…] she felt she could not forgive the boy for being the huddled, blubbering object, all wet and snivelled, which he was."
                            }
                        ]
                    }
