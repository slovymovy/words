                "senses": [
                    {
                        "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                        "entry_id": "90061ea4-f37d-34e2-b3ca-4bf2b030f3f3",
                        "glosses": [
                            "Fahrzeug der Feldpost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e78a4dd-49f7-44b8-99f6-c5baa5e62c27",
                                "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                                "text": "„Im Nachbarhof lag der Feldpostwagen.“"
                            },
                            {
                                "example_id": "a49b074f-97f9-43d6-b96a-12c7e728f4fb",
                                "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                                "text": "„Die Beutel mit Nachrichtenpost, auf deren Beutelfahnen der Laufweg angegeben war, gelangten in erster Linie in Feldpostwagen oder in Feldpost-Abteilen von Reise- oder Schnellzügen für Fronturlauber, sogenannten SF-Zügen, zu den Postleitpunkten.“"
                            },
                            {
                                "example_id": "cb049544-1cc0-43fa-a581-fdcb547eeeee",
                                "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                                "text": "„Wie klang dagegen der Freudenruf unserer Bataillone, wenn die Feldpostwagen angerückt kamen.“"
                            },
                            {
                                "example_id": "d8ee04be-49ca-435d-88d8-46a5fde5a49d",
                                "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                                "text": "„Dabei werden sie von Kavallerie und Artillerie, Sanitätseinheiten, Feldküchen, Radfahrertruppen, Feldschmieden und Feldpostwagen begleitet.“"
                            },
                            {
                                "example_id": "7fb3628b-ee6f-4dbd-a46d-38c0c70b9208",
                                "sense_id": "bf32afbc-a1ea-33ec-9a9f-060710680d63",
                                "text": "„Hier mußte Olivia eine andere Gelegenheit suchen, und der Bemühung des einen Offiziers gelang es, ihr einen Platz auf einem Feldpostwagen zu verschaffen, der nach Zawadow fuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
