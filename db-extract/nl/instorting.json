                    }
                ],
                "senses": [
                    {
                        "sense_id": "2416162e-101d-3761-b378-e0321a959138",
                        "entry_id": "64e1a345-c177-3ce8-8d39-e03ada742bc6",
                        "glosses": [
                            "het kapot gaan van een constructie door naar beneden vallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d6625c-3a0b-43f7-969b-b8b5bceda8e9",
                                "sense_id": "2416162e-101d-3761-b378-e0321a959138",
                                "text": "Gelukkig was er niemand gewond geraakt tijdens de instorting van het kantoorgebouw."
                            },
                            {
                                "example_id": "9024fdef-ce60-40fd-abe6-d7f5cea993c0",
                                "sense_id": "2416162e-101d-3761-b378-e0321a959138",
                                "text": "In juli 2016 stortte een gletsjertong plotsklaps in, wat een lawine van ijs en stenen veroorzaakte in een vallei in Tibet over een gebied van tien vierkante kilometer. Negen inwoners van het afgelegen dorpje Dungru overleefden de lawine niet, net als honderden schapen en jaks. De oorzaak van de instorting is nog niet duidelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f9fe0ad-f1ad-3bab-ab52-022d0aab6762",
                        "entry_id": "64e1a345-c177-3ce8-8d39-e03ada742bc6",
                        "glosses": [
                            "psychisch of lichamelijk niet meer goed kunnen functioneren door uitputting"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "50445e07-6e9c-4f45-9d58-7452ee1655b8",
                                "sense_id": "5f9fe0ad-f1ad-3bab-ab52-022d0aab6762",
                                "text": "Na de dood van haar kind had de moeder een vreselijke instorting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac864610-c41b-4230-a754-3ca135900041",
                        "source_entry_id": "64e1a345-c177-3ce8-8d39-e03ada742bc6",
                        "source_sense_id": "2416162e-101d-3761-b378-e0321a959138",
                        "source_sense_description": "het kapot gaan van een constructie door naar beneden vallen",
                        "target_lang_word": "Einsturz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsturz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e36ceaa-9776-3ca9-ab3c-f766b649918d",
                                        "entry_id": "cea372fa-b268-307e-9f04-ccd6de9c341f",
                                        "glosses": [
                                            "das Zusammenbrechen, Einstürzen eines Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a744e93-897a-41b0-b58e-cfa028eca362",
                                                "sense_id": "4e36ceaa-9776-3ca9-ab3c-f766b649918d",
                                                "text": "„Nach dem Einsturz des Kölner Stadtarchivs ist noch unklar, wer für das Unglück verantwortlich ist.“"
                                            },
                                            {
                                                "example_id": "a61a52ff-ee6f-4255-9809-709687114dd8",
                                                "sense_id": "4e36ceaa-9776-3ca9-ab3c-f766b649918d",
                                                "text": "„Noch immer werden nach dem Einsturz einer Textilfabrik in Bangladesch Tote aus den Trümmern geborgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "666f88e4-910d-4006-bc48-a1f8b2d3aa1f",
                        "source_entry_id": "64e1a345-c177-3ce8-8d39-e03ada742bc6",
                        "source_sense_id": "2416162e-101d-3761-b378-e0321a959138",
