                "senses": [
                    {
                        "sense_id": "5f121cfe-7b70-3f76-86e5-a7325b14db14",
                        "entry_id": "97e5fb21-55a2-3048-a22c-9b9b57372382",
                        "glosses": [
                            "bedoeld om niet te hoeven spreken over een lastig onderwerp"
                        ],
                        "tags": [
                            "van een uitlating"
                        ],
                        "examples": [
                            {
                                "example_id": "fa84b533-691a-4d1b-8336-56b9fa31ee3b",
                                "sense_id": "5f121cfe-7b70-3f76-86e5-a7325b14db14",
                                "text": "Het gesprek met verdachte verliep moeizaam, omdat hij vaag en vermijdend antwoord op vragen gaf."
                            }
                        ]
                    },
                    {
                        "sense_id": "26ac1a38-7782-34ee-860b-2b1c7718c595",
                        "entry_id": "97e5fb21-55a2-3048-a22c-9b9b57372382",
                        "glosses": [
                            "gericht op het ontwijken van gespannen situaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34988c93-5f87-4650-bb52-9cd3919f9aa2",
                                "sense_id": "26ac1a38-7782-34ee-860b-2b1c7718c595",
                                "text": "De schuld van de slechte relatie wordt bij hem gelegd: hij vertoont vermijdend gedrag, hij vermijdt confrontaties en gesprekken die tot heftige emoties of tot ruzies kunnen leiden."
                            }
                        ]
                    }
