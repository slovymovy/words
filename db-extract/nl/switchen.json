        "nl-extract.jsonl": [
            {
                "entry_id": "b3dbca50-1df6-3b50-952c-c658ef355814",
                "word": "switchen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "964d3811-b29f-3cc4-ac50-c0ee328fef93",
                        "entry_id": "b3dbca50-1df6-3b50-952c-c658ef355814",
                        "glosses": [
                            "omschakelen van het ene naar iets (heel) anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ed55ad-210f-45e3-a974-889e6e6ab21f",
                                "sense_id": "964d3811-b29f-3cc4-ac50-c0ee328fef93",
                                "text": "Vier jaar later overleed ook moeder Mieke, aan baarmoederkanker. In een van de laatste gesprekken die Zegers met haar moeder voerde, kreeg ze haar zegen om van haar studie politicologie te switchen naar het conservatorium. Ze studeerde cum laude af als jazzzangeres, maar had een studiepauze nodig om alle psychische klappen van de jaren daarvoor enigszins te verwerken."
                            },
                            {
                                "example_id": "bf64d66e-45fb-40b7-8f0b-dd2849e8e099",
                                "sense_id": "964d3811-b29f-3cc4-ac50-c0ee328fef93",
                                "text": "Doordat England onlangs van schoenenmerk was geswitcht begon de wreef van zijn voet na een week gigantisch op te zwellen. Hierdoor moest hij al na een aantal dagen vroegtijdig de trail verlaten om te rusten en zijn voet te laten helen."
                            }
                        ]
                    },
                    {
                        "sense_id": "83aae8e5-0c2a-329e-b70c-8dae5757c4e1",
                        "entry_id": "b3dbca50-1df6-3b50-952c-c658ef355814",
                        "glosses": [
                            "van plaats verwisselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0bbba9-0076-4358-9ef2-011be71d5415",
                                "sense_id": "83aae8e5-0c2a-329e-b70c-8dae5757c4e1",
                                "text": "Maar ik had al snel in de gaten dat ze nog iets was: een pendulevrouw. Margot kon in een paar minuten tijd van de opperste vreugde naar de diepste depressie switchen; ze was de onvoorspelbaarheid in eigen persoon. Ze was altijd woedend op wat zij zag als 'de hypocrisie van de bourgeois levensstijl' en plaatste vraagtekens bij elk detail in het leven, ten strijde trekkend tegen de maatschappij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af4f530b-e209-4ad7-87b1-6a63e345674a",
                        "source_entry_id": "b3dbca50-1df6-3b50-952c-c658ef355814",
                        "source_sense_id": "964d3811-b29f-3cc4-ac50-c0ee328fef93",
                        "source_sense_description": "omschakelen",
                        "target_lang_word": "switch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "switch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c274e85-db6f-3c51-96f4-d514112580e5",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A device to turn electric current on and off or direct its flow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a74a7ceb-8bfa-31e6-9980-fc84c03f0e2c",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A change or exchange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7131e01c-4835-420f-baa1-66d5e5011e3c",
                                                "sense_id": "a74a7ceb-8bfa-31e6-9980-fc84c03f0e2c",
                                                "text": "After many complications and sudden switches of career and identity for all […] they end up selling out for fame and money, and leave the boardwalk for good."
                                            },
                                            {
                                                "example_id": "84018f72-ed1d-48fe-aff0-5d92313be697",
                                                "sense_id": "a74a7ceb-8bfa-31e6-9980-fc84c03f0e2c",
                                                "text": "Wenger sent on Cesc Fabregas and Van Persie to try to finish Leeds off and with 14 minutes left the switch paid off as the Spaniard sent Bendtner away down the right and his wonderful curling cross was headed in by Van Persie at the far post."
                                            },
                                            {
                                                "example_id": "40e39fdc-bd05-46e9-bf6d-6d7eee54514f",
                                                "sense_id": "a74a7ceb-8bfa-31e6-9980-fc84c03f0e2c",
                                                "text": "This is a result of a switch from High Street to online retailing, requiring consumer goods to be delivered to the door from large-scale distribution parks that have sufficient traffic to justify a rail terminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6e6c26-a4c1-3be1-bf1e-0b69dc2a3106",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A movable section of railroad track which allows the train to be directed down one of two destination tracks; (set of) points."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c67a568-7edb-342c-b128-e1611f064bda",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A slender woody plant stem used as a whip; a thin, flexible rod, associated with corporal punishment in the United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543701d6-1d10-4023-bb57-0be2fc2bcdcc",
                                                "sense_id": "5c67a568-7edb-342c-b128-e1611f064bda",
                                                "text": "Their mother would walk out into the yard and cut a switch from a tree and beat him—beat him, it seemed to Florence, until any other boy would have fallen down dead; […]"
                                            },
                                            {
                                                "example_id": "d846a2f6-712c-4f05-bfe9-2c9021522edb",
                                                "sense_id": "5c67a568-7edb-342c-b128-e1611f064bda",
                                                "text": "\"A proper switch is a slim, flexible branch off a tree or a bush. A switch applied to the buttocks stings fiercely. It may leave red marks or bruises, but it causes no lasting damage..\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aedf4cd-6403-32b9-ab2b-57354616c2d3",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "Synonym of rute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0740f8d2-c9f5-36f5-a2a3-7336d2dded5c",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "A command line notation allowing specification of optional behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea88ae99-c506-46e1-962a-b2b6ad7ac31c",
                                                "sense_id": "0740f8d2-c9f5-36f5-a2a3-7336d2dded5c",
                                                "text": "Use the /b switch to specify black-and-white printing."
                                            }
