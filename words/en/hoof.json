{
    "word_family": [
        "hoofed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a26c9fb2-2f2f-3ada-9e74-d631f71779b8",
                    "sense_definition": "The hard, protective covering on the foot of an animal like a horse or deer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse made a loud sound as its <w>hoof</w> hit the hard ground.",
                            "target_lang_translations": {
                                "cs": "Kůň vydal hlasitý zvuk, když jeho <w>kopyto</w> dopadlo na tvrdou zem."
                            }
                        },
                        {
                            "text": "The farmer checked the <w>hoof</w> of the cow for any signs of injury.",
                            "target_lang_translations": {
                                "cs": "Farmář zkontroloval <w>kopyto</w> krávy, zda nevykazuje známky zranění."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horse hoof",
                        "cloven hoof"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tvrdý, ochranný obal na noze zvířete, jako je kůň nebo jelen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kopyto",
                                "target_lang_sense_clarification": "anatomická část nohy kopytníků"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6aea929-2b98-318a-8b9a-98cf9284d0b6",
                    "sense_definition": "A human foot, often used in a humorous or derogatory way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get your big <w>hooves</w> off my clean carpet right now.",
                            "target_lang_translations": {
                                "cs": "Okamžitě sundej ta svá velká <w>kopyta</w> z mého čistého koberce."
                            }
                        },
                        {
                            "text": "He stood there on his bare <w>hoofs</w> waiting for the water to warm up.",
                            "target_lang_translations": {
                                "cs": "Stál tam na svých bosých <w>kopytech</w> a čekal, až se voda ohřeje."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally or humorously to refer to human feet."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Lidská noha, často používané v humorném nebo hanlivém smyslu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kopyto",
                                "target_lang_sense_clarification": "hanlivé označení pro neohrabanou nohu nebo nešikovného člověka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2bb5e0f-9267-330e-8098-99b880f9e963",
                    "sense_definition": "The end piece or heel of a loaf of bread.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people refuse to eat the <w>hoof</w> of the bread loaf.",
                            "target_lang_translations": {
                                "cs": "Někteří lidé odmítají jíst <w>patku</w> bochníku chleba."
                            }
                        },
                        {
                            "text": "She saved the <w>hoof</w> to use for making breadcrumbs later.",
                            "target_lang_translations": {
                                "cs": "Schovala si <w>patku</w>, aby ji později použila na strouhanku."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in specific dialects to refer to the end of a loaf."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Koncová část nebo patka bochníku chleba."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "patka",
                                "target_lang_sense_clarification": "krajní část bochníku chleba"
                            },
                            {
                                "target_lang_word": "krajíc",
                                "target_lang_sense_clarification": "krajní část chleba"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b8c8a56-b0d7-3670-9993-5751e805ba20",
                    "sense_definition": "To travel somewhere on foot.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>hoof</w> it all the way home after the bus broke down.",
                            "target_lang_translations": {
                                "cs": "Poté, co se autobus rozbil, jsme museli <w>jít</w> celou cestu domů <w>pěšky</w>."
                            }
                        },
                        {
                            "text": "They decided to <w>hoof</w> it across the city to save money on taxis.",
                            "target_lang_translations": {
                                "cs": "Rozhodli se <w>přejít</w> město <w>pěšky</w>, aby ušetřili za taxi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoof it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way of saying to walk."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Cestovat někam pěšky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jít pěšky",
                                "target_lang_sense_clarification": "pohybovat se chůzí"
                            },
                            {
                                "target_lang_word": "šlapat",
                                "target_lang_sense_clarification": "hovorový výraz pro chůzi na delší vzdálenost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef28125e-b861-33a5-bbd0-32e914f8b4b9",
                    "sense_definition": "To kick a ball forcefully, often without much aim.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defender had to <w>hoof</w> the ball away from the goal area.",
                            "target_lang_translations": {
                                "cs": "Obránce musel <w>odkopnout</w> míč pryč z pokutového území."
                            }
                        },
                        {
                            "text": "He <w>hoofed</w> the ball downfield to relieve pressure on the team.",
                            "target_lang_translations": {
                                "cs": "Míč <w>napálil</w> dopředu, aby ulevil tlaku na svůj tým."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in sports contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Silně kopnout do míče, často bez velkého míření."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odkopnout",
                                "target_lang_sense_clarification": "prudké vykopnutí míče pryč"
                            },
                            {
                                "target_lang_word": "napálit",
                                "target_lang_sense_clarification": "silně a neřízeně kopnout do míče"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27482b2-d901-321a-a60d-803073f41ed0",
                    "sense_definition": "To dance, particularly as a professional performer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old actor still loves to <w>hoof</w> on stage during the musical.",
                            "target_lang_translations": {
                                "cs": "Starý herec stále miluje <w>tanec</w> na jevišti během muzikálu."
                            }
                        },
                        {
                            "text": "She spent years <w>hoofing</w> in various Broadway shows.",
                            "target_lang_translations": {
                                "cs": "Strávila roky <w>tancováním</w> v různých broadwayských show."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to professional dancing, often in a theatrical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tančit, zejména jako profesionální umělec."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tančit",
                                "target_lang_sense_clarification": "provádět taneční pohyby"
                            },
                            {
                                "target_lang_word": "stepovat",
                                "target_lang_sense_clarification": "specifický druh tance často spojovaný s tímto výrazem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}