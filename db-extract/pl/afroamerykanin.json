                        ],
                        "examples": [
                            {
                                "example_id": "1a2137e8-a282-4a1d-85d6-2db4d7d56891",
                                "sense_id": "39679480-e395-3b41-9ebd-28759237f268",
                                "text": "„Jej historia to w pewnym sensie historia drogi, jaką przeszli w USA Afroamerykanie od lat 50. do dziś. Oprah urodziła się w 1954 r. w ubogiej, patologicznej rodzinie na Południu.“",
                                "translation": "Ihre Geschichte ist in gewissem Sinne die Geschichte des Weges, den die Afroamerikaner in den USA von den 50er Jahren bis heute durchschritten haben. Oprah wurde 1954 in einer armen, pathologischen Familie im Süden geboren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cf58aac-ad80-425a-ac68-956f05bd4cb3",
                        "source_entry_id": "c51683dd-4363-3dee-9dfc-ee31ea6c039d",
