                "senses": [
                    {
                        "sense_id": "b2fed024-1f1d-312e-b8c7-f0f19256832e",
                        "entry_id": "3965f8e5-86bd-32de-822a-cef39b707b01",
                        "glosses": [
                            "тщательно, обстоятельно думать над чем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a31d026c-aa80-4d70-add6-a30ac20e3fea",
                                "sense_id": "b2fed024-1f1d-312e-b8c7-f0f19256832e",
                                "text": "Ещё днём продумывал я, какие перемены надо произвести в журнале да сколько сил, времени на это уйдёт."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f861012-8f65-3b57-b161-1eb54ef5b5ec",
                        "entry_id": "3965f8e5-86bd-32de-822a-cef39b707b01",
                        "glosses": [
                            "редк. проводить определённое время, думая"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c61defe6-594c-432b-9134-09eb9eefcc79",
                        "source_entry_id": "3965f8e5-86bd-32de-822a-cef39b707b01",
                        "target_lang_word": "think over",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "think over",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5791adc-6135-3171-af0f-b75f661b0187",
                                        "entry_id": "c7e068f6-fbf2-3f57-a007-e61e85e53bc1",
                                        "glosses": [
                                            "To ponder or reflect on a subject."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f45972f-1bc7-4cd8-bb31-6d12545fbe79",
                                                "sense_id": "f5791adc-6135-3171-af0f-b75f661b0187",
                                                "text": "When he has time to think over what he did, he will regret it."
                                            },
                                            {
                                                "example_id": "e13f170a-4ff6-4b26-8654-92280e2faf12",
                                                "sense_id": "f5791adc-6135-3171-af0f-b75f661b0187",
                                                "text": "Go home, think it over and tell me your decision on Monday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fde73f2-d4a6-4ba6-ba60-e0cc06a39133",
                        "source_entry_id": "3965f8e5-86bd-32de-822a-cef39b707b01",
                        "target_lang_word": "think out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "think out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b87434-f4f8-3b34-b537-5e6897b50299",
                                        "entry_id": "98459788-bd6f-3d10-8eba-3d86580c1d2f",
                                        "glosses": [
                                            "To devise or solve by a process of thought."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb719985-38b9-4d0c-9853-41eb1b3b7265",
                                                "sense_id": "d4b87434-f4f8-3b34-b537-5e6897b50299",
                                                "text": "I wanted to try and think out how it was that rational or even half-rational men could ever have learned to wear armor, considering its inconveniences; and how they had managed to keep up such a fashion for generations when it was plain that what I had suffered to-day they had had to suffer all the days of their lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
