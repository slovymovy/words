                        "entry_id": "4ea61742-9811-30e2-a8a5-7d61ee769e05",
                        "glosses": [
                            "Mitglied einer Band, das eine herausragende Stellung bei öffentlichen Auftritten einnimmt und meist identisch mit dem Leadsänger ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc36408-f95a-4346-934a-5b0a7895f153",
                                "sense_id": "71517dbb-86fa-3785-943f-1209ddf89ac8",
                                "text": "Kurt Cobain war der Frontmann der Band Nirvana."
                            },
                            {
                                "example_id": "1602c9dc-b016-40a2-93be-cdbcbd0b3334",
                                "sense_id": "71517dbb-86fa-3785-943f-1209ddf89ac8",
                                "text": "Der Frontmann der Scorpions ist Klaus Meine."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
