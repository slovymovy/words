                ],
                "senses": [
                    {
                        "sense_id": "3681d01e-083b-36fc-a572-9473ec68265d",
                        "entry_id": "4c7d83c7-d395-358a-9599-136b78ce1999",
                        "glosses": [
                            "von Efeu umrankt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c478819-cf09-4152-96b8-55a10eab4c11",
                                "sense_id": "3681d01e-083b-36fc-a572-9473ec68265d",
                                "text": "„In dem ehrwürdigen, runden Turm aus efeuumranktem Gestein, der den höchsten Hügel Ulthars krönt, suchte er sofort nach dem Patriarchen Atal, der auf den verbotenen Gipfel Hatheg-Kla in der steinigen Wüste gestiegen und lebend wieder heruntergekommen war.“"
                            },
                            {
                                "example_id": "ba5051a4-1dec-4974-a6c9-d1b00b1d28a6",
                                "sense_id": "3681d01e-083b-36fc-a572-9473ec68265d",
                                "text": "„Weil Émile, Joseph Sabahs Hund, einen Spaziergang brauchte, verließen sie für eine Weile das efeuumrankte Haus in Waterloo.“"
                            },
                            {
                                "example_id": "9c522ded-7d17-4eb3-a19a-f267137d48fb",
                                "sense_id": "3681d01e-083b-36fc-a572-9473ec68265d",
                                "text": "„Er geht vom Büro ins erste Schlafzimmer, wo sich ihm der gleiche Anblick bietet - ein schmutziges Fenster, efeuumrankte Gitterstäbe, weiter unten die beiden Brüder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
