                    {
                        "sense_id": "7c4c2163-7a76-3aff-ac8e-03002198083e",
                        "entry_id": "69c865a3-36f0-3df0-9f14-a60b2c12b039",
                        "glosses": [
                            "met de kleur als die van resten verbrand materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4c1fe50-9d2f-455d-b511-50f4999d3467",
                                "sense_id": "7c4c2163-7a76-3aff-ac8e-03002198083e",
                                "text": "Dit type bos heeft een heel speciale charme: die van de eentonigheid. Er zijn niet meer dan drie kleuren in aanwezig. De naalden zijn lichtgroen, de stammetjes asgrijs, en de grond is bedekt met een volkomen effen kleed van zachtbruine naaldjes die iedere oneffenheid tot een glooiing verzachten."
                            },
                            {
                                "example_id": "6e8852d1-baf3-4413-9f99-3622ca428f6d",
                                "sense_id": "7c4c2163-7a76-3aff-ac8e-03002198083e",
                                "text": "En haar moeder - een belegen zeug. Met asgrijs haar en flink van gewicht."
                            }
                        ]
                    }
                ],
