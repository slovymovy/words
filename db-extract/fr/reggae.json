        "fr-extract.jsonl": [
            {
                "entry_id": "a1f60629-8937-325d-90de-b4ba7fea0b64",
                "word": "reggae",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8b75507-a65a-43c7-b99b-9a31fb5bda67",
                        "entry_id": "a1f60629-8937-325d-90de-b4ba7fea0b64",
                        "tags": [
                            "plural"
                        ],
                        "form": "reggaes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                        "entry_id": "a1f60629-8937-325d-90de-b4ba7fea0b64",
                        "glosses": [
                            "Style de musique jamaïcain apparu dans les années 1960."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cae1e8e-3f61-4d1f-bca2-dfb88fbdc916",
                                "sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                                "text": "J’écoutais le reggae chez moi. À cette époque, beaucoup de gens confondaient les rastamen, leur musique et la drogue. Le reggae, pour la plupart, c’est la drogue."
                            },
                            {
                                "example_id": "a588886d-1644-484b-8d47-1423b75156eb",
                                "sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                                "text": "L’intégration de langues autochtones dans la musique contemporaine participe de la fierté de jeunes Amérindiens. Dub kali’na, R’n’B teko, reggae wayana… comptent aujourd’hui parmi les tubes guyanais."
                            },
                            {
                                "example_id": "e8db770e-94f5-47f2-a5a4-0b593dde2115",
                                "sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                                "text": "Ali Assani, un Comorien surnommé Kaf’Bob en hommage à Bob Marley, mais surtout à cause de sa tignasse poussiéreuse de Rasta, et de son goût immodéré pour le reggae et le zamal – pas forcément dans cet ordre de prédilection, d’ailleurs – complétait le trio."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9020fc28-6c98-4114-b715-8199b678a44a",
                        "source_entry_id": "a1f60629-8937-325d-90de-b4ba7fea0b64",
                        "source_sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                        "target_lang_word": "Reggae",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reggae",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "709c4339-5522-3220-870e-6ab958f39f9e",
                                        "entry_id": "91d8f372-c931-37c5-b467-3b6320a2ffb9",
                                        "glosses": [
                                            "eine jamaikanische Musikform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845c007d-d2e6-40da-992d-55a210decad7",
                                                "sense_id": "709c4339-5522-3220-870e-6ab958f39f9e",
                                                "text": "„Doch hier soll es um Reggae gehen, jenen Sound, der die Landesfahne des Eilands bis in die entlegendsten Erdenwinkel trieb und als Markenzeichen etablierte.“"
                                            },
                                            {
                                                "example_id": "298b8cf2-6bf8-433a-b9a6-120c6e315aa3",
                                                "sense_id": "709c4339-5522-3220-870e-6ab958f39f9e",
                                                "text": "„Musikalisch setzt Reggae nach wie vor auf die Offbeat-Phrasierung, also die Betonung des 2. und 4. Takts, ist dabei aber langsamer und weniger basslastig als andere ähnliche Musikstile wie Punk oder Ska.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e913057-26d4-4a1a-8227-f54e00da9359",
                        "source_entry_id": "a1f60629-8937-325d-90de-b4ba7fea0b64",
                        "source_sense_id": "b541664e-865c-32f3-90df-c81a168974e5",
                        "target_lang_word": "reggae",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reggae",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1466dd3a-0bba-3152-905b-84b4c004a391",
                                        "entry_id": "fc6c01c0-165c-35c5-b9ca-e79a7f7f2021",
                                        "glosses": [
                                            "A music genre that originated in Jamaica in the late 1960s and is heavily associated with Rastafarianism, featuring a heavy bass line and percussive rhythm guitar on the offbeat, often with close vocal harmonies."
                                        ],
                                        "tags": [
                                            "Rastafari",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a121f33a-37a4-4b46-970f-1a3301102ef8",
                                                "sense_id": "1466dd3a-0bba-3152-905b-84b4c004a391",
                                                "text": "Near-synonym: (earlier) bluebeat"
                                            },
                                            {
                                                "example_id": "88baeae1-5efe-4d4b-a67d-9935b79bf5c8",
                                                "sense_id": "1466dd3a-0bba-3152-905b-84b4c004a391",
                                                "text": "I want to do the reggay with you / Come onto me, do the dance"
                                            },
                                            {
                                                "example_id": "d885f514-9769-487f-b8ad-cf59b20f5f17",
                                                "sense_id": "1466dd3a-0bba-3152-905b-84b4c004a391",
                                                "text": "I mean, the very name reggae. I mean, it wasn’t called reggae in the first place. It came from blue beat, just ska, you know? Ska and blue beat, the era, and then reggae. Because it was a dance, originally. And the DJs thought, “That’s a nice name,” and the kept saying “reggae music, reggae music” on the air all the time. “Reggae music, reggae music, the DJs on the radio. So everyone kept on saying “Reggae music”. They classed it as …(other Matumbi band members join in) Reggae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
