                        "source_entry_id": "e8265c86-1488-37ec-b493-293db8b899d6",
                        "source_sense_id": "cd9ad123-5ca0-38ba-94ec-65f453268067",
                        "source_sense_description": "een trostomaat zo groot als een kers",
                        "target_lang_word": "Kirschtomate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
