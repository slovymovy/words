                        "glosses": [
                            "een cultuurplant die binnenshuis ter decoratie - vaak in een bloempot - gehouden wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab442264-47cb-43e6-9fd1-cc22dbbcf93d",
                                "sense_id": "cfa60de4-455e-3377-a0d6-3c9d86dd0377",
                                "text": "Kamerplanten zijn vaak planten die het in de Nederlandse of Belgische buitenlucht niet zouden overleven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f92e0d5-0066-4e23-b8ff-c9ba92f4d6e9",
                        "source_entry_id": "2f5e8376-e690-380e-a32a-e0d7e5b80cf9",
                        "source_sense_id": "cfa60de4-455e-3377-a0d6-3c9d86dd0377",
                        "target_lang_word": "Zimmerpflanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmerpflanze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b947e78-e03d-3c7e-ac32-07ba2a8ddcc2",
                                        "entry_id": "ccc52992-3183-3f4f-94bd-e6a95d3e4bee",
                                        "glosses": [
                                            "Pflanze, die innerhalb des Hauses, innerhalb geschlossener Räume steht oder stehen sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f7ed72-0e12-4301-bf0e-87f4607159d7",
                                                "sense_id": "2b947e78-e03d-3c7e-ac32-07ba2a8ddcc2",
                                                "text": "„Kann ich einen Bambus auch als Zimmerpflanze halten?“ (Internet-Beleg)"
                                            },
                                            {
                                                "example_id": "6a98fa09-037a-43f9-947a-b28f9a777c6b",
                                                "sense_id": "2b947e78-e03d-3c7e-ac32-07ba2a8ddcc2",
                                                "text": "„Vor den Fenstern gibt es eine Zone von hohen Zimmerpflanzen, ein Wintergarten, durch den der Lärm der Straße nicht dringt und in dem sich bei Tag das Licht bricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5629ce5f-66be-38bb-87f0-696cb1b292c7",
                                        "entry_id": "ccc52992-3183-3f4f-94bd-e6a95d3e4bee",
                                        "glosses": [
                                            "Person, die sich am liebsten innerhalb des Hauses aufhält"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8922c6a5-84c5-4c0d-9cd1-fcae6ac23128",
                                                "sense_id": "5629ce5f-66be-38bb-87f0-696cb1b292c7",
                                                "text": "Als eingefleischte Zimmerpflanze täte dir etwas frische Luft hin und wieder auch gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
