                                                "example_id": "3cb928ca-4c7c-40a1-b987-52e8a7e19940",
                                                "sense_id": "788edfc3-1e61-37a2-8930-d5c287fbf45c",
                                                "text": "Despite all these precautions, however, severe storms sometimes caused drifts which brought traffic completely to a standstill."
                                            }
                                        ]
