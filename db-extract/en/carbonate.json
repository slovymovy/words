                    {
                        "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                        "entry_id": "c687da6b-bfc6-3395-ae5f-984f5c9db2e7",
                        "glosses": [
                            "Any salt or ester of carbonic acid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b57de30-088e-4b1a-bda3-94389dfd5d31",
                                "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                                "text": "A sample of carbon removed from the ocean in the solid form of calcium carbonate and magnesium hydroxide from UCLA's SeaChange program -- now known as Equatic -- in 2023."
                            },
                            {
                                "example_id": "971ae975-c375-46a5-a7ae-4c9217e0f0f1",
                                "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                            }
                        ]
                    }
                ],
