                        "tags": [
                            "plural"
                        ],
                        "form": "clientes"
                    },
                    {
                        "form_id": "57679851-dd2d-412c-adf0-5ee81375cf95",
                        "entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "tags": [
                            "masculine"
                        ],
                        "form": "client"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
                        "entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "glosses": [
                            "Femme qui achète (des produits ou des services), vis-à-vis de son fournisseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ec7683-daf6-4eee-a901-ee3d73d8ebd8",
                                "sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
                                "text": "Des caprices de pin-up, des croqueuses de diamants qui se déhanchent pour le milliardaire du jour, des vedettes américaines en villégiature à Cinecittà qui veulent en montrer aux jeunes Romains, des gigolos qui se lancent dans des kazatchoks pour impressionner la cliente, oui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9e93263-c3f5-4f55-83cf-596fafc33210",
                        "source_entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "source_sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
                        "target_lang_word": "Kundin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kundin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                        "entry_id": "b1ab7a85-6cf1-3638-af7b-000641a718d7",
                                        "glosses": [
                                            "weibliche Person oder Institution, die bei einem bestimmten Geschäft einkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7fbbe4a-dba9-4caf-8d9d-4226ad25b9f0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "Sie ist schon lange Kundin bei uns."
                                            },
                                            {
                                                "example_id": "4b4fa06b-b121-4b60-a3f3-6818b05d4e56",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Die treuesten Kundinnen sind die Mütter.“"
                                            },
                                            {
                                                "example_id": "84f94f98-ff73-4a71-a94d-44ecfab70ee0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Ich war Taxifahrer, im Fond saß eine Kundin, jung und blühend.“"
                                            },
                                            {
                                                "example_id": "48dbf371-2110-4043-a924-507d7b2974b9",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Die beiden Kundinnen nicken zustimmend.“"
                                            },
                                            {
                                                "example_id": "fadd9706-3301-4383-a6b2-4838e8fd3da0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Ich lächelte die Verkäuferin an. Wusste, dass es nicht stimmte, dass es auf der ganzen Welt keinen Laden gab, wo gewünscht wurde, dass die Kundinnen ihre Kleider bis an ihr Lebensende behielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b530d7ee-c61e-4ac7-86fc-a75fb392ef62",
                        "source_entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "source_sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
                        "target_lang_word": "clientess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clientess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37848835-7755-3248-8317-a615a6d398b5",
                                        "entry_id": "5f6e9648-0542-354a-9141-70659a8abc3f",
                                        "glosses": [
                                            "A female client."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d208b3-e692-4b6f-9ce9-ff4e0a75a37a",
                                                "sense_id": "37848835-7755-3248-8317-a615a6d398b5",
                                                "text": "Possible too to have a lawyer bribeless and without fee, if his clientess, or female client, please his eye well: […]"
                                            },
                                            {
                                                "example_id": "55f4bc33-0b6d-4c19-a9b7-9e838a7de6f5",
                                                "sense_id": "37848835-7755-3248-8317-a615a6d398b5",
                                                "text": "He holds his clientesses, not by a benefit, but by a temptation; by their folly and weakness, not by their wisdom."
                                            },
                                            {
                                                "example_id": "b699f4be-d78a-4cd0-a536-a1a6ca873a14",
                                                "sense_id": "37848835-7755-3248-8317-a615a6d398b5",
                                                "text": "The clientesses' skirts are short and daring, their stretch stocking-boots rise above their knees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c518f4c-3ed2-4486-8645-e0674c1133f8",
                        "source_entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "source_sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
                        "target_lang_word": "klientka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klientka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "236c4ed4-1763-3363-94de-56d997bb4234",
                                        "entry_id": "154393a5-2693-3277-b22c-62ec8ec1a069",
                                        "glosses": [
                                            "kobieta kupująca, nabywająca towary lub usługi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da71f7ac-7c64-4d7a-b1f6-fe5790ec4e84",
                                                "sense_id": "236c4ed4-1763-3363-94de-56d997bb4234",
                                                "text": "Pana mecenasa nie ma, jest na spotkaniu z klientką."
                                            },
                                            {
                                                "example_id": "97725632-720c-44f9-b30e-a0fb0fe31234",
                                                "sense_id": "236c4ed4-1763-3363-94de-56d997bb4234",
                                                "text": "Typowa bikejka jest zwykle stałą klientką solariów oraz bywalczynią dyskotek"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b405cbc5-7d97-4a29-b1ab-4cff5fe455a1",
                        "source_entry_id": "5b5a2eb1-4c2b-397e-b02b-8cf5f76bca64",
                        "source_sense_id": "039dfbc9-9e5b-3d1d-bd82-02e615acd297",
