                "senses": [
                    {
                        "sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                        "entry_id": "3bb1cf25-847b-365f-8de2-8456e30e2fad",
                        "glosses": [
                            "von sich eingenommene, eitle und arrogante Person"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f1c42536-8c1d-40e5-bce5-661353aa06c5",
                                "sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                                "text": "Weil er seinen Sportwagen und seine perfekt sitzende Frisur zur Schau stellte, hielt man ihn für einen Schnösel."
                            },
                            {
                                "example_id": "34e777a7-88d8-4194-9c33-9de02b7fbd4b",
                                "sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                                "text": "„Das Haar der Schnösel sah aus, als wäre es mit schwarzer Schuhwichse angeklatscht.“"
                            },
                            {
                                "example_id": "4d02cfde-1466-4504-9ac7-72bb9b9a26c0",
                                "sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                                "text": "„Außer dem Barmann gab es noch eine Ische und drei magere, schlappe, doofe Schnösel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a970f51d-8ac8-40b3-a22b-2e738c97b5d4",
                        "source_entry_id": "3bb1cf25-847b-365f-8de2-8456e30e2fad",
                        "source_sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                        "source_sense_description": "umgangssprachlich, abwertend: von sich eingenommene, eitle und arrogante Person",
                        "target_lang_word": "snob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A person who wishes to be seen as a member of the upper classes and who looks down on those perceived to have inferior or unrefined tastes."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e4278e-4cf4-4cb5-b0b9-53d04a53adf1",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "Proceed as a snob climbing the social ladder, namely, know the best people in the neighbourhood, then the best people they know. The end is not that of snobbery, but an eternal treasure."
                                            },
                                            {
                                                "example_id": "7184a856-b022-4099-bb50-2b6c7a56fdb3",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "Outside of his own set he was considered rather a snob, but as his set was the set, it never worried him."
                                            },
                                            {
                                                "example_id": "f5e1cd33-9948-47c7-ab50-75c2da1e6136",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "If wanting the best things in life means being a snob then glory hallelujah I'm a snob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c69bae15-4eed-37d2-9ce7-ca2c97f35f0b",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A cobbler or shoemaker."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7512023-2988-4d0a-b611-bced42f4711e",
                                                "sense_id": "c69bae15-4eed-37d2-9ce7-ca2c97f35f0b",
                                                "text": "The snobs were also kind to him, and gave him a pair of boots which they assured him were of a type and quality reserved entirely for officers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A member of the lower classes; a commoner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff387c0-e104-45c4-afa9-b5dcfa7c42cd",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "'D'ye know a slap-up sort of button, when you see it?' said the youth. 'Don't look at mine, if you ain't a judge, because these lions' heads was made for men of taste: not snobs.'"
                                            },
                                            {
                                                "example_id": "3567f307-3734-4eed-be4d-61226d60d920",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "I like better gin-and-water than claret. I like a sanded floor in Carnaby Market better than a chalked one in Mayfair. I prefer Snobs, I own it."
                                            },
                                            {
                                                "example_id": "250682cf-3544-4e55-ae0d-68260914c83b",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "I tell you, sir, that I have a brain of my own, and that I should feel myself to be a snob and a slave if I did not use it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa8097f-d9cf-34d3-8e9c-5e103f1f0633",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A workman who works for lower wages than his fellows, especially one who will not join a strike (a scab)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6805bded-0970-3ff6-b509-7052dc3bf768",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A townsman, as opposed to a gownsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e247f43-9033-4312-9220-22c22f142843",
                        "source_entry_id": "3bb1cf25-847b-365f-8de2-8456e30e2fad",
                        "source_sense_id": "e30c5722-4d0d-3281-bb10-7aaf7bfb45da",
                        "source_sense_description": "umgangssprachlich, abwertend: von sich eingenommene, eitle und arrogante Person",
                        "target_lang_word": "snob",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snob",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20de5762-00b9-33dd-badd-66d4c4d54f39",
                                        "entry_id": "5ec76a91-9f4c-3a7c-82b4-cbf7eaba78df",
                                        "glosses": [
                                            "Qui est hautain, atteint de snobisme."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed99524c-c6a0-47c7-b56c-5dae05aa9bd3",
                                                "sense_id": "20de5762-00b9-33dd-badd-66d4c4d54f39",
                                                "text": "Pas même le courage de porter une robe de quatre sous, des Galeries Lafayette, snobs jusqu’à la couleur des ongles, au sac, au bijou… Uniformes jusque dans leurs petites excentricités de rigueur !"
                                            },
                                            {
                                                "example_id": "8df7e8ff-b23d-4946-88aa-d584de88a0b8",
                                                "sense_id": "20de5762-00b9-33dd-badd-66d4c4d54f39",
                                                "text": "Les gens ne vont pas croire que je n'ai pas posé pour ces photos. Ils vont penser que je suis une vendue. Ils vont penser que je ne suis qu’une mannequin snob et prétentieuse."
                                            },
                                            {
                                                "example_id": "7346b3e2-f461-48e6-80b7-7e74047dc593",
                                                "sense_id": "20de5762-00b9-33dd-badd-66d4c4d54f39",
                                                "text": "J’suis snob… J’suis snob,\nj’suis ravagé par ce microbe.\nJ’ai des accidents en Jaguar,\nje passe le mois d’août au plumard,\nc’est dans les p’tits détails comme ça\nque l’on est snob, ou pas.\n[…]\net quand je serai mort,\nj’veux un suaire de chez Dior !"
                                            },
                                            {
                                                "example_id": "b328935c-9365-440c-9625-249fb7fa20fc",
                                                "sense_id": "20de5762-00b9-33dd-badd-66d4c4d54f39",
                                                "text": "Tellement snob, le matin, y passe devant le miroir et y se regarde même pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snob",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                        "entry_id": "c87eb978-ae49-3168-be22-0953edd046f4",
                                        "glosses": [
                                            "Personne qui veut faire croire, par ses manières, qu’elle connaît la haute société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb070e1b-52d2-46e7-b80b-f32853d1231b",
                                                "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                                "text": "[Charrigaud :] À peine eut-il senti passer les premières caresses du succès, que le snob qui était en lui —et c’est pour cela qu’il le peignait avec une telle force d’expression— se révéla, explosa, pourrait-on dire, comme un engin qui vient de recevoir la secousse électrique… Il commença par lâcher ses amis devenus encombrants ou compromettants, ne gardant que ceux qui, les uns par leur talent accepté, les autres, par leur situation dans la presse, pouvaient lui être utiles et entretenir de leurs persistantes réclames sa jeune renommée. En même temps, il fit de la toilette et de la mode une de ses préoccupations les plus acharnées."
                                            },
                                            {
                                                "example_id": "aa90c9af-bd72-4fe1-8694-4ba65572951c",
                                                "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                                "text": "Quand Bloch me parla de la crise de snobisme que je devais traverser et me demanda de lui avouer que j’étais snob, j’aurais pu lui répondre : « Si je l’étais, je ne te fréquenterais pas. »"
                                            },
                                            {
                                                "example_id": "6ef9f455-4b98-4d68-b64d-7039d59e48c5",
                                                "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                                "text": "Quand on parlait à Odette de Mme Verdurin comme d’une snob, Odette se mettait à rire et disait : « C’est tout le contraire […] » Et secrètement elle enviait à Mme Verdurin (bien qu’elle ne désespérât pas d’avoir elle-même à une si grande école fini par les apprendre) ces arts auxquels la Patronne attachait une si belle importance, bien qu’ils ne fassent que nuancer l’inexistant, sculpter le vide, et soient à proprement parler les Arts du Néant."
                                            },
                                            {
                                                "example_id": "e968acd2-6332-4d07-bd06-5c7fc9b0beb4",
                                                "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                                "text": "Autour d’eux, des intellectuels, des écrivains d’avant-garde, snobs gagnés à un bolchevisme moral et politique, arrivistes précocement aigris, les appuient et les encadrent."
                                            },
                                            {
                                                "example_id": "61544193-c7d2-40df-8569-6acb49cc6e22",
                                                "sense_id": "39b6aad3-c442-3331-9e05-a2e7cd06c79f",
                                                "text": "Avec Marjo, on s’est mis à chanter à tue-tête Chats sauvages. La poule mouillée s’est sauvée. On n’a rien contre la musique classique. Mais on a tout contre les snobs, les casseuses de party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
