                            },
                            {
                                "target_lang_word": "sluggishly",
                                "target_lang_sense_clarification": "moving in a slow, tired way"
                            },
                            {
                                "target_lang_word": "lazily",
                                "target_lang_sense_clarification": "without speed or effort"
                            }
                        ]
                    }
                }
            ]
        },
        {
