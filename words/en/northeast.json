            "senses": [
                {
                    "sense_id": "2d696249-cb26-3c8b-867f-f8c04755dd74",
                    "sense_definition": "The northeastern region of the United States.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "region_us",
                    "name_type": "place_name",
                    "examples": [
                        {
