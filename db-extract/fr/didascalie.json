        "fr-extract.jsonl": [
            {
                "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                "word": "didascalie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7e67b39-309f-429a-b34c-adbbd56479d4",
                        "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "tags": [
                            "plural"
                        ],
                        "form": "didascalies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3081c43d-9507-38e1-9035-bfcb4a8abef1",
                        "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "glosses": [
                            "Instruction que le poète dramatique donnait aux acteurs sur la manière dont ils devaient jouer ses pièces."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f8770d-b40a-4e3a-a812-27876a85497b",
                                "sense_id": "3081c43d-9507-38e1-9035-bfcb4a8abef1",
                                "text": "On n’a aucune ligne de dialogue dans nos scènes à deux, juste une didascalie \"le plus poliment possible\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "c17d0a52-784c-38a6-9fb7-a945c80b0a08",
                        "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "glosses": [
                            "Documents grecs sur les pièces jouées, l’époque de leur représentation, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c53cd2f8-c421-3a83-92ed-e7bca1df27d0",
                        "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "glosses": [
                            "Courte notice placée en tête des pièces de théâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07457c31-e926-4b91-840b-c01ea55ff032",
                                "sense_id": "c53cd2f8-c421-3a83-92ed-e7bca1df27d0",
                                "text": "Alfred Jarry écrit cette didascalie pour Ubu : « L’histoire se passe en Pologne, c’est-à-dire nulle part. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "7539d67b-c6cb-3186-b608-b2eb9b5be878",
                        "entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "glosses": [
                            "Dans les dialogues d’une pièce de théâtre ou d’un film, notes de l’auteur ne faisant pas partie de ce dialogue, donnant aux acteurs et aux metteurs en scène des indications sur le jeu, les personnages, les déplacements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f6f2a6-c054-41db-9004-3ab8b6d3daf1",
                                "sense_id": "7539d67b-c6cb-3186-b608-b2eb9b5be878",
                                "text": "Le texte de cette pièce contient beaucoup de didascalies."
                            },
                            {
                                "example_id": "e85ca9ba-b220-482d-9a46-32bddf16dcd3",
                                "sense_id": "7539d67b-c6cb-3186-b608-b2eb9b5be878",
                                "text": "Désiré Reniflard, régisseur et souffleur, accessoiriste et figurant, qui accompagne et guide les personnages en prononçant les didascalies à voix haute. Trouvaille irrésistible."
                            },
                            {
                                "example_id": "c1d0c8a9-8c57-4ae0-95de-16682afa0ea8",
                                "sense_id": "7539d67b-c6cb-3186-b608-b2eb9b5be878",
                                "text": "Enfant, dans la bibliothèque de théâtre de mon père, j’aimais lire les didascalies de Feydeau. Ma préférée : « les mêmes, au même endroit, un peu plus tard »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e69c82ae-9ad5-4033-98d0-ba719c241521",
                        "source_entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "source_sense_description": "Indication écrite par l’auteur",
                        "target_lang_word": "Regieanweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regieanweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b451a90-9ded-322c-bafd-8c375f541d21",
                                        "entry_id": "f39617fe-53f3-389f-92c5-706e08b5b0bb",
                                        "glosses": [
                                            "zusätzliche Erklärung im Drehbuch oder Stücktext an die Schauspieler, wie etwas gespielt werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97748791-9e5d-43ce-832e-2c379a52d321",
                                                "sense_id": "0b451a90-9ded-322c-bafd-8c375f541d21",
                                                "text": "Laut Regieanweisung sollst du traurig schauen."
                                            },
                                            {
                                                "example_id": "7c176184-054d-446d-a91c-d1a7ceda7ba8",
                                                "sense_id": "0b451a90-9ded-322c-bafd-8c375f541d21",
                                                "text": "Hier steht: ‚Mo und Friese lachen.‘ Soll ich das vorlesen?\" Nein, sagt Filmemacherin Sandra Schießl und erläutert Michaela Pfeifer, daß das eine Regieanweisung ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd432cbc-3036-468c-b300-5c6f2c8eb383",
                        "source_entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "source_sense_description": "Indication écrite par l’auteur",
                        "target_lang_word": "stage direction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stage direction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                        "entry_id": "ef4bfe0f-bc0c-360f-9942-c1dc8fbf629a",
                                        "glosses": [
                                            "An instruction given to an actor that tells the actor what should be done and in what manner to do it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c8a707-a476-48eb-a88c-17e1d208378a",
                                                "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                                "text": "The stage direction given in the script said to walk forward and speak the line loudly."
                                            },
                                            {
                                                "example_id": "7ddea9b1-ffaa-4477-bad7-6c764332cac3",
                                                "sense_id": "d8c07f6b-9a29-3417-a723-e5ba57f47c27",
                                                "text": "In a few spots, where we've felt it was particularly important, we added stage directions indicating things like quick glances between Helene and Erik."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2c761fa-3009-4a1a-9b7e-79f4d8c606f6",
                        "source_entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "source_sense_description": "Indication écrite par l’auteur",
