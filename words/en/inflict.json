                    "sense_id": "fbb8b003-3b57-36e6-9b4c-068b2c87e0a4",
                    "sense_definition": "To cause something unpleasant or harmful to be suffered by someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm managed to <w>inflict</w> severe damage on the coastal town during the night.",
                            "target_lang_translations": {
                                "ru": "Шторму удалось <w>нанести</w> серьезный ущерб прибрежному городу в течение ночи.",
                                "de": "Der Sturm konnte der Küstenstadt in der Nacht schweren Schaden <w>zufügen</w>."
                            }
                        },
                        {
                            "text": "The general did not want to <w>inflict</w> heavy casualties on his own troops during the mission.",
                            "target_lang_translations": {
                                "ru": "Генерал не хотел <w>наносить</w> тяжелые потери своим войскам во время выполнения задания.",
                                "de": "Der General wollte seinen eigenen Truppen während der Mission keine schweren Verluste <w>zufügen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wreak",
                        "visit"
                    ],
                    "common_phrases": [
                        "inflict heavy casualties",
                        "inflict severe damage",
                        "inflict pain",
                        "inflict a wound"
                    ],
                    "target_lang_definitions": {
