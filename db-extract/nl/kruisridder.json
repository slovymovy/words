                        "entry_id": "b3f56380-e550-390c-836e-96e8329276d7",
                        "glosses": [
                            "a crusader, a knight who participated in the crusades"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8ce5faba-eb98-4129-b2d2-9d64656fb42c",
                                "sense_id": "87ed2820-5aa4-3b65-85c4-17d01d9a0140",
                                "text": "Een kruisridder droeg vaak een rood kruis op zijn harnas.",
                                "translation": "A crusader often wore a red cross on his armor.",
                                "english": "A crusader often wore a red cross on his armor."
                            },
                            {
                                "example_id": "567daa6b-a8e0-4541-a311-e397b1eb4024",
                                "sense_id": "87ed2820-5aa4-3b65-85c4-17d01d9a0140",
                                "text": "De stad werd belegerd door de kruisridders.",
                                "translation": "The city was besieged by the crusaders.",
                                "english": "The city was besieged by the crusaders."
                            },
                            {
                                "example_id": "4d438119-b199-4901-91c6-f39fd8bd51c1",
                                "sense_id": "87ed2820-5aa4-3b65-85c4-17d01d9a0140",
                                "text": "De kruisridder nam deel aan vele veldslagen.",
                                "translation": "The crusader took part in many battles.",
                                "english": "The crusader took part in many battles."
                            }
                        ]
                    }
