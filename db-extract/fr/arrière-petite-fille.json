        "fr-extract.jsonl": [
            {
                "entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                "word": "arrière-petite-fille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "31be6b00-b731-4cbe-b3b4-d0085467a714",
                        "entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrière-petites-filles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                        "entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                        "glosses": [
                            "Fille du petit-fils ou de la petite-fille, par rapport au bisaïeul ou à la bisaïeule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1080765a-b862-46ec-89fc-1fc7c3bb4783",
                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                "text": "J'arrive à l'Espérance les Hauts, chez Marie-Ange, dite madame Gaston, qui marie aujourd'hui son arrière-petite-fille."
                            },
                            {
                                "example_id": "a9e8bc8c-b32f-4ec9-b8aa-de5de317cb14",
                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                "text": "Comment cette goton peut être l’arrière-petite-fille de la belle Ulianna, voilà encore une de ces énigmes de la filiation que je renonce à élucider."
                            },
                            {
                                "example_id": "ca01ece4-f203-44b3-af27-46ec7be2fb52",
                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                "text": "La tombe de Georges Méliès n’avait pas fière allure, au cimetière du Père-Lachaise (20ᵉ), en 2019, quand son arrière-petite-fille a entrepris de la faire restaurer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a558aec-d2aa-4c69-9b41-1a7aa8ed49f2",
                        "source_entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                        "source_sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                        "target_lang_word": "Urenkelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                        "entry_id": "936386e9-b56a-3da0-8e51-0fe3e6f74a44",
                                        "glosses": [
                                            "weibliches Kind von Enkel oder Enkelin oder weibliche Nachfahrin der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b35c08-c906-43e4-a914-3faf54cb8962",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "Unsere Urenkelin wird auch schon bald 6 Jahre alt."
                                            },
                                            {
                                                "example_id": "e37c4e70-8d05-435e-87c4-b31f7f8c23ee",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Im Laufe der Analysen kristallisierte sich allerdings heraus, dass auch unbearbeitete Themen aus der Familienvergangenheit bei den Enkelinnen und Urenkelinnen ihren Niederschlag fanden.“"
                                            },
                                            {
                                                "example_id": "03b0b3e3-7a76-491c-8876-4ba8ec359616",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Auch Helenes Mutter ist auf dem Bild zu sehen: Die mondän aussehende Dame hält die Hand ihrer kleinen Urenkelin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5412aadb-4bdd-4968-bc49-6614db96a90e",
                        "source_entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                        "source_sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
