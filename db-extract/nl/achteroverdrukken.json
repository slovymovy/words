                            {
                                "example_id": "2947978f-2d91-4a0f-adcd-e38b5342aa21",
                                "sense_id": "22911b1b-0b79-3209-bb88-0d7c241f3872",
                                "text": "De oneerlijke boekhouder drukte een heel kapitaal achterover."
                            },
                            {
                                "example_id": "7a6bd377-7b85-4a43-86df-a12ff064e690",
                                "sense_id": "22911b1b-0b79-3209-bb88-0d7c241f3872",
                                "text": "En er is nog een Sanderink-onderneming die zich benadeeld voelt. Zonnepanelenbedrijf DSS uit Goor, waar Van Egten directeur was, claimt nog zeker 1,3 miljoen euro van haar tegoed te hebben, onder meer omdat ze geld en zonnepanelen achterover zou hebben gedrukt. Het bewijs daarvoor ontbreekt overigens."
                            }
                        ]
                    }
                ],
