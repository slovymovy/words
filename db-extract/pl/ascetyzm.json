                                    {
                                        "sense_id": "db40c8f4-8bc5-3c8f-988c-073e461f03c9",
                                        "entry_id": "716dcdc2-88ab-3dce-a5b9-d2ba32827089",
                                        "glosses": [
                                            "The principles and practices of an ascetic; extreme self-denial and austerity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3294968-eb63-4794-8dd9-cc2fbf342347",
                        "source_entry_id": "8fd46b95-1719-35f7-ab9d-0b4930de083b",
                        "source_sense_id": "aca9fe3b-b4a3-3535-a11a-5249cbf85511",
                        "target_lang_word": "ascétisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascétisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                        "entry_id": "46d64973-ea5b-37d8-9f85-9353018ceb31",
                                        "glosses": [
                                            "Genre de vie des ascètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1279b6a8-a59a-4128-bed9-bafcd78d1886",
                                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                                "text": "Très souvent on a fait de l’ascétisme oriental la manifestation la plus remarquable du pessimisme."
                                            },
                                            {
                                                "example_id": "ee4670dc-83fb-4daf-bb7a-9d270e33d826",
                                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                                "text": "L’ascétisme de Pascal n’est pas la conséquence du christianisme de Pascal. Il en est la cause première."
                                            },
                                            {
                                                "example_id": "ce863693-6bac-40b7-aebf-380d5c53532d",
                                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                                "text": "Fantasmant sur Sparte, Rousseau développe une théorie de l’aliment qui n’est pas sans faire penser au contrat social : ascétisme et sobriété, absence de fantaisie et de hasard."
                                            },
                                            {
                                                "example_id": "86fce3b6-54da-4c39-9f00-b36495d26427",
                                                "sense_id": "2b043fb3-b373-3dd3-8050-2d956a6aa815",
                                                "text": "Rasé, en sabots et rêche tenue verdâtre, avec casquette de cuir coiffant sa calvitie, il passa de l’absinthe à l’abstinence, du péquet au piquet, de l’éthylisme à l’ascétisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02508db5-1491-4077-8042-289601f1eb72",
                        "source_entry_id": "8fd46b95-1719-35f7-ab9d-0b4930de083b",
                        "source_sense_id": "aca9fe3b-b4a3-3535-a11a-5249cbf85511",
                        "target_lang_word": "ascetismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascetismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8f892ee7-21b0-3def-89ab-4db2b34b724a",
                                        "entry_id": "ad309529-555c-34c6-a31b-3b7b00f4848b",
                                        "glosses": [
                                            "Hábito o doctrina de la abstinencia del placer sensual o corporal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae6bd5-f99d-417e-96cc-d1266cbcf2b9",
                                                "sense_id": "8f892ee7-21b0-3def-89ab-4db2b34b724a",
                                                "text": "Cuando Miguel de Santiago volvió a aspirar el aire libre de la ciudad natal, su espíritu era ya presa del ascetismo de su siglo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24f65718-68c8-4514-94ac-ec4bf0fe133f",
                        "source_entry_id": "8fd46b95-1719-35f7-ab9d-0b4930de083b",
                        "source_sense_id": "aca9fe3b-b4a3-3535-a11a-5249cbf85511",
                        "target_lang_word": "аскетизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аскетизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c569e6b6-a184-36e4-a61d-a35d1a8b9986",
                                        "entry_id": "51d9b4f2-fbcd-3980-8e91-040206ef9c12",
                                        "glosses": [
                                            "религ. религиозное учение, проповедующее крайнее воздержание, умерщвление плоти как путь к достижению нравственного совершенства, путь к общению с Богом; религиозное подвижничество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71454ae7-0ec7-4476-8e59-1e50ce52e344",
                                                "sense_id": "c569e6b6-a184-36e4-a61d-a35d1a8b9986",
                                                "text": "Аскетизм проповедует порабощение чувства. Новые течения прославляют самое могучее и самое ненавистное аскетам чувство — любовь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05c3501-fd47-3a02-8185-351a7eee30b3",
                                        "entry_id": "51d9b4f2-fbcd-3980-8e91-040206ef9c12",
                                        "glosses": [
                                            "отказ от жизненных благ и удовольствий; крайнее воздержание во всём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251435a3-8fa5-4cfa-8d7e-10f6a6d863cc",
                                                "sense_id": "a05c3501-fd47-3a02-8185-351a7eee30b3",
                                                "text": "Он был очень чистых нравов и вообще скорее склонялся к аскетизму, чем к наслаждениям; но его строгость ничего не отнимала от роскоши и богатства его артистической натуры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f60f8aa-03a6-3fc3-ba13-9f20281c1d14",
                                        "entry_id": "51d9b4f2-fbcd-3980-8e91-040206ef9c12",
                                        "glosses": [
                                            "перен. намеренная скупость в использовании изобразительных средств в искусстве"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0529c0cb-e0b6-4f94-b5bf-c0a7efd57b30",
                        "source_entry_id": "8fd46b95-1719-35f7-ab9d-0b4930de083b",
                        "source_sense_id": "aca9fe3b-b4a3-3535-a11a-5249cbf85511",
                        "target_lang_word": "ascetismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascetismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "f7fa231b-d72c-3d2b-b5af-1b9753a06530",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "meditazione e preghiera come “esercizio religioso” quale metodo per l’estasi mistico-religiosa"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0495552-adea-3b53-b3e8-2210030172dd",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "l'etica religiosa in tutte le sue corrette forme applicate, esercitata anche in merito ai comportamenti abituali comunemente intesi come appunto quotidiani o addirittura \\\"ripetitivi\\"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9c5ebb-b1b6-4e18-8268-285d9d75b173",
                                                "sense_id": "f0495552-adea-3b53-b3e8-2210030172dd",
                                                "text": "con i fondamenti veridici dell'ascetismo, le tre principali religioni cosiddette monoteiste possono interpretare quasi tutto il canone precettistico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f48a180-aa1e-34bf-bb31-1aa7aa953786",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "modo di vivere che, persino \\\"in raccolta\\\" di più persone più o meno comunque col benestare delle istituzioni, per esempio nel caso di congregazioni semi-religiose non illegali, stabilisce dell'esistenza appunto un equilibrio proprio dell'ascesi e raggiunto attraverso le stesse forme ascetiche"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2a6e8d-40e7-4c91-878b-1e8fce999b38",
                                                "sense_id": "7f48a180-aa1e-34bf-bb31-1aa7aa953786",
                                                "text": "di fatto l’ascetismo è l’abbandono delle passioni"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faafe9d2-6fda-3502-8371-ca51857d2025",
                                        "entry_id": "32145f31-86a9-303e-be97-daa44b2e662a",
                                        "glosses": [
                                            "ritiro in solitudine con digiuni, talvolta “castità”, “rigore estremo” ed “esistenza in una consapevole rinuncia”, questo per favorire l’attaccamento a Dio e maggiore coscienza di sé e della realtà spirituale religiosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9a5a02-5ee3-4076-b33c-b8c50d3d8f7d",
                                                "sense_id": "faafe9d2-6fda-3502-8371-ca51857d2025",
                                                "text": "senza principi come la verità, la pace, la gioia e la misericordia invero l’ascetismo si riduce a vana mortificazione dell’essere"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
