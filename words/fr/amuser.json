{
    "word_family": [
        "amusement",
        "amuseur",
        "amuse-bouche",
        "amuse-gueule",
        "amusoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bce68078-32a4-3e6e-bddf-2b2cefe8ac7e",
                    "sense_definition": "Prendre du plaisir, passer un moment agréable en se divertissant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "divertissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances, les enfants vont au parc pour s'<w>amuser</w> ensemble."
                        },
                        {
                            "text": "J'espère que vous allez bien vous <w>amuser</w> à cette fête ce soir."
                        }
                    ],
                    "common_phrases": [
                        "bien s'amuser"
                    ]
                },
                {
                    "sense_id": "cfccf329-02e6-33aa-a9e6-67a8ba280b84",
                    "sense_definition": "Divertir quelqu'un en lui faisant passer agréablement le temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "divertissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce comédien sait parfaitement comment <w>amuser</w> le public avec ses histoires."
                        },
                        {
                            "text": "Le magicien a fait plusieurs tours de cartes pour <w>amuser</w> les invités."
                        }
                    ],
                    "synonyms": [
                        "distraire",
                        "récréer"
                    ],
                    "common_phrases": [
                        "amuser la galerie",
                        "amuser le public"
                    ]
                },
                {
                    "sense_id": "601f06fc-19e2-39d5-8a90-2e8b8c98421f",
                    "sense_definition": "Se moquer de quelqu'un ou rire à ses dépens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas s'<w>amuser</w> de la naïveté des personnes plus âgées."
                        },
                        {
                            "text": "Je refuse qu'on s'<w>amuse</w> de mes erreurs devant toute l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "s'amuser de quelqu'un"
                    ]
                },
                {
                    "sense_id": "a3b6b4c4-980d-3e85-8264-e042c1e2920e",
                    "sense_definition": "Faire perdre son temps à quelqu'un ou s'attarder inutilement à des futilités.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perte_de_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêchez-vous et ne vous <w>amusez</w> pas en chemin car on vous attend."
                        },
                        {
                            "text": "Il passe des heures à s'<w>amuser</w> avec des détails au lieu de travailler."
                        }
                    ],
                    "common_phrases": [
                        "amuser le tapis"
                    ]
                },
                {
                    "sense_id": "542bcf99-5abb-3a8a-8de8-b251106fe8a7",
                    "sense_definition": "Tromper quelqu'un par de fausses promesses ou des ruses pour gagner du temps.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le négociateur tente d'<w>amuser</w> l'ennemi afin de permettre l'évacuation des civils."
                        },
                        {
                            "text": "Il l'<w>amuse</w> de belles paroles depuis des mois sans jamais signer le contrat."
                        }
                    ],
                    "common_phrases": [
                        "amuser l'ennemi"
                    ]
                }
            ]
        }
    ]
}