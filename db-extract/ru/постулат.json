                        ],
                        "form": "постула́те"
                    },
                    {
                        "form_id": "0511f7fb-0dbc-4db8-adee-7ab352af1de4",
                        "entry_id": "8fd7e9e9-dbd5-3eda-a987-90a2672065db",
                        "tags": [
                            "plural",
