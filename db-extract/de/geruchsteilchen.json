                ],
                "senses": [
                    {
                        "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                        "entry_id": "70c13fa2-17b9-34d1-9325-d608e6191521",
                        "glosses": [
                            "sehr kleine, elementare Teilchen die den Geruchssinn reizen"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "a5321174-0c87-4e69-aa7e-4ab186acf25d",
                                "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                                "text": "„Geruchsteilchen werden mit der Luft eingeatmet und gelangen so an die Riechzellen im oberen Bereich der Nasenschleimhaut.“"
                            },
                            {
                                "example_id": "5d836770-bf97-4722-85a5-a6c861ad97e8",
                                "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                                "text": "„Calen, der Leibarzt des römischen Kaisers Marc Aurel entdeckte die Riechnerven und Titus Lucretius Carus postulierte, dass Geruchsteilchen durch komplementär geformte Schlitze ins Sinnesorgan eintreten – eine frühe „Schlüssel-Schloss-Theorie“ wie sie 2000 Jahre später bestätigt wurde.“"
                            },
                            {
                                "example_id": "09dde980-419a-436d-b749-cf8bbf6016c6",
                                "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                                "text": "„Die Geruchsteilchen lösen sich in der wässrigen Schleimschicht und reizen die Riechzellen, wenn sie an die Härchen stoßen.“"
                            },
                            {
                                "example_id": "986f64a8-0a4b-46f0-a01a-fc3cd36032ec",
                                "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                                "text": "„Je älter die Spur ist, desto tiefer geht die Nase, weil sich mit der Zeit die Geruchsteilchen am Boden absetzen.“"
                            },
                            {
                                "example_id": "44769606-3611-4504-bb17-70a6f3b76ea4",
                                "sense_id": "91d49f82-b6ae-3966-9713-7f2bd63ac2eb",
                                "text": "„Es ist wichtig für den Geruchssinn; winzige Geruchsteilchen (Moleküle) werden über die Zunge zu diesem Organ transportiert und dort überprüft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
