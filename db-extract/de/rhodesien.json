                "senses": [
                    {
                        "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                        "entry_id": "87dd6ee3-f603-34ca-8e97-068d285a758f",
                        "glosses": [
                            "ehemalige britische Kolonie, heute Simbabwe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18aa74be-e1c6-4af5-bf25-eac459c9b9da",
                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                "text": "„Seit der Gründung der britischen Kolonie Rhodesien durch ihren Namensgeber Cecil Rhodes im 19. Jahrhundert wanderten weiße Händler und Farmer aus Europa und Südafrika ein, die um die Mitte des 20. Jahrhunderts knapp fünf Prozent der Bevölkerung stellten.“"
                            },
                            {
                                "example_id": "4c855eb3-81e5-4855-931e-02f5ea9503e9",
                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                "text": "„Nach der Unabhängigkeit wurde aus Rhodesien Simbabwe, Victoria wurde in Masvingo umbenannt, Pierres Eltern bearbeiteten weiter ihre Farm.“"
                            },
                            {
                                "example_id": "46932c9d-d53e-4452-b796-e609b90145b7",
                                "sense_id": "c0f31d33-c464-3240-955c-ceea6c2febce",
                                "text": "„Als am Abend des 4. März 1980 die weißen Bewohner der Kolonie Rhodesien ihre Fernsehapparate anschalteten, erwarteten sie nichts Gutes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fc1980d-dcc4-46f7-a917-a5dfe4ce8581",
