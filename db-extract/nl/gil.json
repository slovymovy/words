                                "target_senses": [
                                    {
                                        "sense_id": "daa8d9c6-7e23-3afd-ac76-e52218980b20",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A high-pitched strident or piercing sound, such as that between a moving object and any surface."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5f27d7-624a-3b19-b6f4-fa6d3b5707d9",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A harsh, shrill cry, as of one in acute pain or in fright; a shriek; a scream."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cde702a-27ff-3d3c-9513-61728c993354",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "Newfoundland rum."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a34c53-6253-3dab-994b-b9a120457101",
                                        "entry_id": "c02639e0-4ad2-33cc-b6f6-7eb9cb785f39",
                                        "glosses": [
                                            "A form of home-made rye whiskey made from used oak rye barrels from a distillery."
                                        ],
                                        "tags": [
