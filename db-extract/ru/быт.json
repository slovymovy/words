                            "locative"
                        ],
                        "form": "в быту́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec83f351-1dda-3b9e-8459-1555b1ebc739",
                        "entry_id": "3d83f5bd-d115-3d99-942b-cd600d1d5831",
                        "glosses": [
                            "общий уклад жизни народа, определённой социальной среды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a49a87-7ab6-4024-a728-a64f46e43701",
                                "sense_id": "ec83f351-1dda-3b9e-8459-1555b1ebc739",
                                "text": "Изумительна неподвижность азиатского быта в течение стольких веков."
                            },
                            {
                                "example_id": "8272fabd-bdf8-4506-b83f-f329b99153b8",
                                "sense_id": "ec83f351-1dda-3b9e-8459-1555b1ebc739",
                                "text": "Этот первостепенный знаток русского быта и уговорил его приняться за литературу."
                            },
                            {
                                "example_id": "e01cf586-8799-4e2d-adb9-03974182beee",
                                "sense_id": "ec83f351-1dda-3b9e-8459-1555b1ebc739",
                                "text": "Вспомним, что круговорот времён года, дня и ночи в крестьянском быту соотносился с жизненным циклом человека."
                            }
                        ]
                    },
                    {
                        "sense_id": "504cb0d8-fa23-31a8-9dc2-032470ba7244",
                        "entry_id": "3d83f5bd-d115-3d99-942b-cd600d1d5831",
                        "glosses": [
                            "повседневная жизнь человека, совокупность условий, в которых она проходит"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1813bf7-36bc-4e01-8f72-b41c4e580f06",
                                "sense_id": "504cb0d8-fa23-31a8-9dc2-032470ba7244",
                                "text": "Поэтому прежде чем приступить к его использованию в повседневном быту, внимательно ознакомьтесь с нижеследующей инструкцией."
                            },
                            {
                                "example_id": "976fd5fe-aa21-4ead-8f34-be9e34562599",
                                "sense_id": "504cb0d8-fa23-31a8-9dc2-032470ba7244",
                                "text": "Эти будничные вопросы армейского быта и строя — сухие по форме и глубоко драматичные по содержанию — никогда не составляли темы его выступлений."
                            },
                            {
                                "example_id": "633cc14b-5e8f-47aa-a7ec-812ba7df73f2",
                                "sense_id": "504cb0d8-fa23-31a8-9dc2-032470ba7244",
                                "text": "Плохо сначала было с мебелью, но постепенно быт наш устроился."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4c250dc-9388-435e-b5da-45239cee00dd",
                        "source_entry_id": "3d83f5bd-d115-3d99-942b-cd600d1d5831",
                        "source_sense_description": "общий уклад жизни, народа, определённой социальной среды",
                        "target_lang_word": "way of life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "way of life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a86d7c-8850-375c-8941-93da9d88d5d9",
                                        "entry_id": "1ec19465-fbdd-3584-9ffc-0ab2179078b8",
                                        "glosses": [
                                            "A style of living that reflects the attitudes of a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b601a92-6847-40c1-aa24-b78ed6e672dc",
                                                "sense_id": "d9a86d7c-8850-375c-8941-93da9d88d5d9",
                                                "text": "My fellow citizens: I want to talk to you about Korea, about why we are there, and what our objectives are. It is your liberty and mine which is involved. What is at stake is the free way of life- the right to worship as we please, the right to express our opinions, the right to raise our children in our own way, the right to choose our jobs, the right to plan our future and the right to live without fear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
