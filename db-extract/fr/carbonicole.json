                        "glosses": [
                            "Qualifie un champignon qui croît sur les débris carbonisés par le feu et sur les charbonnières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b4ff3b4-358a-4bbf-836c-02714f7199cc",
                                "sense_id": "f8d26611-58ce-3138-996b-5c68cde4ee71",
                                "text": "Nous distinguerons donc, dans la diagnose de Galactinia succosella une forme carbonicole et une forme terricole que nous décrirons séparément du seul point de vue macroscopique, étant entendu que les quelques caractères extérieurs qui différencient ces deux formes pourraient n’être après tout que purement accidentels."
                            }
                        ]
                    },
