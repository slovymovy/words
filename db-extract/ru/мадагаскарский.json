                                    {
                                        "sense_id": "2ad3b97b-91e2-3429-ae13-e8eb44ec23c4",
                                        "entry_id": "89705b13-e490-3244-88a5-044b4625781f",
                                        "glosses": [
                                            "zum Volk der Madagassen gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9f033a-c664-4111-a467-fcc62aeb9876",
                                                "sense_id": "2ad3b97b-91e2-3429-ae13-e8eb44ec23c4",
                                                "text": "Die kleine Holzskulptur zeigt zwei madagassische Frauen beim Haareflechten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05d845d0-b24a-368f-a07f-48050266bef6",
                                        "entry_id": "89705b13-e490-3244-88a5-044b4625781f",
                                        "glosses": [
                                            "zu Madagaskar gehörig, von Madagaskar kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80214f38-c6f3-4d15-80c1-7c68ef2a596f",
                                                "sense_id": "05d845d0-b24a-368f-a07f-48050266bef6",
                                                "text": "Die madagassische Währung heißt Ariary."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "46e8a0e3-0867-3719-8ede-a3aafc215440",
                                        "entry_id": "89705b13-e490-3244-88a5-044b4625781f",
                                        "glosses": [
                                            "zur Sprache Madagassisch (Malagasy) gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8989fab-0772-4328-a4ff-8e32b9f0f4ea",
                                                "sense_id": "46e8a0e3-0867-3719-8ede-a3aafc215440",
                                                "text": "Die meisten Madagassisch Sprechenden werden kein monolinguales madagassisches Wörterbuch oder eine madagassische Grammatik im Bücherschrank haben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be421eb3-5de0-48a8-b81e-ed9c560178e6",
                        "source_entry_id": "6e2b5f2e-19dd-3211-885c-d29c6e0b48a5",
                        "source_sense_id": "e18d28da-7d2a-3c8d-81ed-4187f7583880",
                        "target_lang_word": "madegassisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madegassisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f86fcfb9-0412-3134-9ee6-222a0c44c1c7",
                                        "entry_id": "67af91c5-759c-34f7-a33d-2c17e1ab88da",
                                        "glosses": [
                                            "Madagaskar betreffend, aus Madagaskar kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8f157f-ac2d-4bbc-baf4-74b6b8f428d6",
                                                "sense_id": "f86fcfb9-0412-3134-9ee6-222a0c44c1c7",
                                                "text": "[…] starke Anklänge an die Formenkreise zeigten, die wir seit DU PETIT-THOUARS' Zeiten als speciell madegassisch anzusehen gewohnt sind."
                                            },
                                            {
                                                "example_id": "20ad7709-7b00-427d-a4c3-3e8f4af19c60",
                                                "sense_id": "f86fcfb9-0412-3134-9ee6-222a0c44c1c7",
                                                "text": "Die Art, die ich für rein madegassisch halte, musste ich zur Vorsicht hier aufnehmen, da sie auch vom Festlande angeführt wurde, […]"
                                            },
                                            {
                                                "example_id": "b96647b0-1425-44d8-99ae-bcb94cbbf6de",
                                                "sense_id": "f86fcfb9-0412-3134-9ee6-222a0c44c1c7",
                                                "text": "Bemerkenswert ist, daß die beliebteste Musik- und Tanzform des Indischen Ozeans, die sega, möglicherweise in Zusammenhang mit der karibischen chica zu sehen ist, obgleich \"afrikanischere\" oder \"madegassischere\" Formen als jünger gelten."
                                            },
                                            {
                                                "example_id": "d2f8d4d1-3c75-4346-8fc8-f30fd9e128d1",
                                                "sense_id": "f86fcfb9-0412-3134-9ee6-222a0c44c1c7",
                                                "text": "Madegassische Wörter findet man nur in den FKS des I.O., denn auf den Inseln vor der Küste Madagaskars gab es frühzeitig und in großer Zahl madegassische Sklaven."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c661f81b-f547-3fdc-b752-75fc2738f47d",
                                        "entry_id": "67af91c5-759c-34f7-a33d-2c17e1ab88da",
                                        "glosses": [
                                            "zur Sprache Malagasy (Madagassisch) gehörig"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bba1003-d727-497b-9c74-a5f878095d80",
                                                "sense_id": "c661f81b-f547-3fdc-b752-75fc2738f47d",
                                                "text": "Madegassische Wörter findet man nur in den FKS des I.O., denn auf den Inseln vor der Küste Madagaskars gab es frühzeitig und in großer Zahl madegassische Sklaven."
                                            },
                                            {
                                                "example_id": "be476021-1517-4f7b-9ca8-edf7ac8c429a",
                                                "sense_id": "c661f81b-f547-3fdc-b752-75fc2738f47d",
                                                "text": "Ein madegassisch-englisches Wörterbuch gab Richardson (1886) heraus."
                                            },
                                            {
                                                "example_id": "d64e4063-aab4-410c-b890-f923b81978e8",
                                                "sense_id": "c661f81b-f547-3fdc-b752-75fc2738f47d",
                                                "text": "Die Wiedergabe der madegassischen Wörter bei verschiedenen Autoren des 19. Jahrhunderts erscheint weniger wertvoll, […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
