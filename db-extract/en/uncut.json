                        "sense_id": "99121dfc-8be3-30fe-9d85-f2658a63823c",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not cut."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f2f6e5aa-c8b9-3435-ab9b-c81c5b964b2e",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not cut or ground to the desired shape."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ab195bac-0c4f-4664-8f7c-ebfcf3fb6667",
                                "sense_id": "f2f6e5aa-c8b9-3435-ab9b-c81c5b964b2e",
                                "text": "But now a handful of houses are keen to master all stages of a stone’s journey from rough to final jewel. In September, for example, British luxury jewelers Graff Diamonds bought the uncut Lesedi La Rona, the world’s second largest diamond, for $53 million."
                            }
                        ]
                    },
                    {
                        "sense_id": "d954bc7d-61bd-3e90-a239-e17a841b6bf3",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not having the page edges trimmed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "84931cd7-4259-411e-8b30-cda5d14c0c2f",
                                "sense_id": "d954bc7d-61bd-3e90-a239-e17a841b6bf3",
                                "text": "Monroe had apparently not finished it, for the pages were uncut beyond the third chapter."
                            }
                        ]
                    },
                    {
                        "sense_id": "432e9cba-78f7-3cd7-8ab6-1611c3288c3d",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not edited or abridged by a censor."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a081447-5b36-3baf-b990-1c60c02c352f",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not diluted."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e08458-f552-4969-891c-929eb653e99e",
                                "sense_id": "6a081447-5b36-3baf-b990-1c60c02c352f",
                                "text": "You give them your requirements (or pick a model from the brochure) and await delivery of a massive plastic container filled with uncut gin."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3d2f825-726a-3169-8f30-b29bd803b20a",
                        "entry_id": "9930f2ef-d880-343c-93b3-90d56ff2d17b",
                        "glosses": [
                            "Not circumcised."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "aeba39ec-4f16-4b9f-9fa8-e9cfe3d53555",
                                "sense_id": "a3d2f825-726a-3169-8f30-b29bd803b20a",
                                "text": "All I'm saying is, uncut men are the best. They try harder. I should know. I've slept with five of them."
                            }
                        ]
                    }
                ],
