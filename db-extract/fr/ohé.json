                        "target_lang_word": "yoohoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoohoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59cd1a3b-6c96-32cc-9dc4-310e81c462eb",
                                        "entry_id": "77ce5b7c-db1a-308a-a665-0abecfd77898",
                                        "glosses": [
                                            "Used to get attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1abd225c-d423-4c7a-8b6e-60617b0a503d",
                                                "sense_id": "59cd1a3b-6c96-32cc-9dc4-310e81c462eb",
                                                "text": "Yoohoo! I think you dropped this."
                                            },
                                            {
                                                "example_id": "1fdac62d-8b7e-497f-afad-b1a9b9b280cd",
                                                "sense_id": "59cd1a3b-6c96-32cc-9dc4-310e81c462eb",
                                                "text": "Xavier's Father: Son, it was you who killed me.\nXavier (Vernon Chatman): What kind of stupid name is \"Yoohoo\"? Well, when I find that demon, I shall slay him -- to death! Yoohoo! Yoohoo!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoohoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fa4b209-6b3b-3ae5-acec-a5735c7dee27",
                                        "entry_id": "cedac58d-2251-3413-8266-c94ca0b0827e",
                                        "glosses": [
                                            "To give a cry of \\\"yoohoo\\\"."
                                        ],
