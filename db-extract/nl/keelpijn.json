                "translations": [
                    {
                        "translation_id": "4fc08dc2-8c3b-4b39-a902-09514de61861",
                        "source_entry_id": "4b9caf16-3146-31ed-ad05-0614de66680f",
                        "source_sense_id": "49aa8ca6-b934-31cd-989d-42167b3dc260",
                        "source_sense_description": "pijnlijke irritatie van het slijmvlies in de keelholte, meestal door een ontsteking ervan",
                        "target_lang_word": "Halsweh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halsweh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624e0387-d5bf-39bf-8b6a-b4670fe4b0c5",
                                        "entry_id": "94304b36-b53c-3936-92c9-c30f7696b07b",
                                        "glosses": [
                                            "Halsschmerz"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adeda224-16b0-490c-bcf4-a1a6e3d3b136",
                                                "sense_id": "624e0387-d5bf-39bf-8b6a-b4670fe4b0c5",
                                                "text": "Als ich Halsweh hatte, sagte ich mir nur immer wieder: „Zum Glück bin ich keine Giraffe!“"
                                            },
                                            {
                                                "example_id": "eae8ab5f-02b7-4235-a35b-b892e98d9d97",
                                                "sense_id": "624e0387-d5bf-39bf-8b6a-b4670fe4b0c5",
                                                "text": "„Die Eltern führten ihre Kinder zum Blasiussegen in die Kirche, damit sie keine Gräten verschluckten und kein Halsweh bekamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a46b0e95-7278-4784-b2af-6f954e9d8ea5",
                        "source_entry_id": "4b9caf16-3146-31ed-ad05-0614de66680f",
                        "source_sense_id": "49aa8ca6-b934-31cd-989d-42167b3dc260",
                        "source_sense_description": "pijnlijke irritatie van het slijmvlies in de keelholte, meestal door een ontsteking ervan",
                        "target_lang_word": "Halsschmerz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halsschmerz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                        "entry_id": "0a30961d-dcee-3820-9358-dcc66d7dcf50",
                                        "glosses": [
                                            "unangenehmes Gefühl (Schmerz) am Hals oder im Rachen aufgrund einer Entzündung"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785f5715-8aae-4ccb-b1ab-8265a92d48a3",
                                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                                "text": "In vielen Fällen verschwinden Halsschmerzen auch ohne Behandlung wieder ganz von selbst."
                                            },
                                            {
                                                "example_id": "af9d3053-2416-428f-90f9-78d92b2a03c3",
                                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                                "text": "„Dean hat Halsschmerzen, und sie hustet auch ein wenig.“"
                                            },
                                            {
                                                "example_id": "154f58a0-abe3-4c05-b405-465993181960",
                                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                                "text": "„Auch Allergien, trockene Luft, Luftverschmutzung und der Rückfluss von Magensäure verursachen Halsschmerzen.“"
                                            },
                                            {
                                                "example_id": "8870fa60-f839-4ba4-9db9-87ef987dd4c5",
                                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                                "text": "„Erkältungen beginnen oft mit einem Kratzen im Rachen bis hin zu Halsschmerzen und Schluckbeschwerden.“"
                                            },
                                            {
                                                "example_id": "484327a9-56ae-4e29-9ea7-c57d4588517d",
                                                "sense_id": "043bff5e-7294-3b2d-bda0-09df91ec2428",
                                                "text": "„Sie würde nicht weinend hier sitzen, wenn es eine Grippe oder Halsschmerzen wären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
