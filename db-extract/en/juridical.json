                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7fc3abb-21c4-3dce-8839-c473b01ea2c1",
                        "entry_id": "6226a705-f427-3390-8674-06be332ab6c3",
                        "glosses": [
                            "Pertaining to the law or rule of law, legal; judicial, related to the administration of justice (as to jurisprudence, or to the function of a judge or court)."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "20ce6f98-619f-4ce6-83cb-783f4f7827ef",
                                "sense_id": "e7fc3abb-21c4-3dce-8839-c473b01ea2c1",
                                "text": "The influence of customary law on juridical practices is itself an index of the degree of popular ‘participation’ in the drafting of laws."
                            },
                            {
                                "example_id": "17cb95f7-e9af-4360-8e1f-23fbab6f1815",
                                "sense_id": "e7fc3abb-21c4-3dce-8839-c473b01ea2c1",
                                "text": "...in any case one schematizes power in a juridical form, and one defines its effects as obedience."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66555ba8-7c33-46dc-a3fa-e59b412feff9",
                        "source_entry_id": "6226a705-f427-3390-8674-06be332ab6c3",
                        "source_sense_id": "e7fc3abb-21c4-3dce-8839-c473b01ea2c1",
                        "source_sense_description": "Pertaining to the law",
                        "target_lang_word": "juridisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juridisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "17457aab-585c-34cb-ad24-169cd3cfbdde",
                                        "entry_id": "b0b7b651-7e69-389c-b4cf-e1289948c753",
                                        "glosses": [
                                            "betrekking hebbend op het recht en de rechtsleer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9506bc-3a81-4b02-bd6e-7155d35090e4",
                                                "sense_id": "17457aab-585c-34cb-ad24-169cd3cfbdde",
                                                "text": "Hij is een juridisch expert."
                                            },
                                            {
                                                "example_id": "d5ea6467-d1d7-46a6-b9e9-a202f5ebd885",
                                                "sense_id": "17457aab-585c-34cb-ad24-169cd3cfbdde",
                                                "text": "De Jonge Socialisten (JS), de jongerenafdeling van de PvdA, is zo goed als failliet door financieel wanbeheer, meldt NRC. Meer dan een ton aan uitgaven door twee voormalige penningmeesters is niet verantwoord, zegt het huidige JS-bestuur. De twee penningmeesters worden mogelijk juridisch vervolgd omdat niet duidelijk is waar meer dan een ton aan is uitgegeven, aldus de krant."
                                            },
                                            {
                                                "example_id": "33ff331c-5cc8-488c-a9c2-90af9af93883",
                                                "sense_id": "17457aab-585c-34cb-ad24-169cd3cfbdde",
                                                "text": "\"Absoluut nodig\", noemde parlementslid Augusta Montaruli van Meloni's partij het voorstel in een interview met persbureau Reuters. \"Als iemand hoopt te profiteren van juridische onduidelijkheid, dan kan dat niet met ons.\" Op een verzoek van de NOS om die uitspraak te specificeren, wilde Montaruli niet ingaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b05d7f-5f78-4a1f-9d0c-76c08c8ae2b4",
                        "source_entry_id": "6226a705-f427-3390-8674-06be332ab6c3",
                        "source_sense_id": "e7fc3abb-21c4-3dce-8839-c473b01ea2c1",
                        "source_sense_description": "Pertaining to the law",
                        "target_lang_word": "juridique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juridique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f336a1e-b7c6-3f43-908a-a2cf368af764",
                                        "entry_id": "7f369c02-4bd6-33f2-8890-06d8adfcd03c",
                                        "glosses": [
                                            "Relatif au droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d3041e6-363b-4b27-a6a6-8a49fe4bcc3f",
                                                "sense_id": "4f336a1e-b7c6-3f43-908a-a2cf368af764",
                                                "text": "Longtemps pratiquée dans l’ombre de l’assurance de la responsabilité, l’assurance protection juridique doit son essor à une directive européenne du 22 juin 1987."
                                            },
                                            {
                                                "example_id": "f6bbc614-5655-4da1-8961-f546cba1f72e",
                                                "sense_id": "4f336a1e-b7c6-3f43-908a-a2cf368af764",
                                                "text": "Le congé est un acte unilatéral réceptice en ce sens qu'il produit des effets juridiques lorsqu'il est arrivé à la connaissance de celui qui le subit."
                                            },
                                            {
                                                "example_id": "1ad67c94-a388-4fc4-90d5-9b7d50807112",
                                                "sense_id": "4f336a1e-b7c6-3f43-908a-a2cf368af764",
                                                "text": "La déclaration effectuée aurait pour effet d'attribuer la personnalité juridique à l'enfant conçu, qui disposerait alors de droits subjectifs. La détermination du représentant légal de l'embryon pourrait alors être aisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbf20aad-52e7-3a44-aa02-17e6f04257b4",
                                        "entry_id": "7f369c02-4bd6-33f2-8890-06d8adfcd03c",
                                        "glosses": [
                                            "Qui concerne les diverses parties de la science du droit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f4382e-8c92-43b5-bc10-0c52bab71572",
                                                "sense_id": "cbf20aad-52e7-3a44-aa02-17e6f04257b4",
                                                "text": "Cet enseignement a notamment suivi l'évolution des supports de diffusion de la documentation juridique, passant du tout papier au toujours plus informatisé."
                                            },
                                            {
                                                "example_id": "10c6c6f9-a251-4864-8ff5-4b0b7abdbb42",
                                                "sense_id": "cbf20aad-52e7-3a44-aa02-17e6f04257b4",
                                                "text": "Les changements à répétition des règles débouchent sur des imbroglios administratifs et juridiques inextricables et l’illégalité ouvre la porte à tous les trafics, mafias et répressions policières."
                                            },
                                            {
                                                "example_id": "7142e6cb-41ce-464e-ab17-c0143b9ddb6e",
                                                "sense_id": "cbf20aad-52e7-3a44-aa02-17e6f04257b4",
                                                "text": "Dans cette structure bureaucratique, voire bureaupathologique (Thompson, 1969), la domination de la rationalité légale fait primer le formalisme juridique sur le contenu des productions ou services, autrement dit, systématiquement la forme sur le fond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75241ba5-1f2d-3eea-96aa-4b0a23124596",
                                        "entry_id": "7f369c02-4bd6-33f2-8890-06d8adfcd03c",
                                        "glosses": [
                                            "Qui se fait en justice ou suivant la manière de procéder en justice."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec157d0-f1a5-434e-ab6e-5bad1efa994e",
                                                "sense_id": "75241ba5-1f2d-3eea-96aa-4b0a23124596",
                                                "text": "Intenter une action juridique. - Acte juridique. - Formes juridiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48fe001c-83a3-4f37-9aed-dacc37036ca0",
                        "source_entry_id": "6226a705-f427-3390-8674-06be332ab6c3",
