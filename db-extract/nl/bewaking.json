                        "sense_id": "244a41ad-0b95-38fb-b44e-9eb944dbbedf",
                        "entry_id": "79845993-1cfa-3afa-b37e-6b223f54901b",
                        "glosses": [
                            "de mensen of de systemen die ergens op letten of op iemand letten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83b0729-1c75-4785-bef1-56f51a330900",
                                "sense_id": "244a41ad-0b95-38fb-b44e-9eb944dbbedf",
                                "text": "Kijk uit voor de bewaking, anders worden we gesnapt!"
                            },
                            {
                                "example_id": "02c4908a-9e28-41ca-8ced-51954c7f4ec5",
                                "sense_id": "244a41ad-0b95-38fb-b44e-9eb944dbbedf",
                                "text": "De door de barman gealarmeerde bewaking vindt hem op de bodem van het zwembad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8b7bf34-2768-42ba-ab2a-8e9024df0d6a",
                        "source_entry_id": "79845993-1cfa-3afa-b37e-6b223f54901b",
                        "target_lang_word": "Bewachung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
