                        "examples": [
                            {
                                "example_id": "9ffad9e0-6da1-4235-986a-33998a65636e",
                                "sense_id": "79dbbb71-67d8-3c35-bd56-dffc33a6ef72",
                                "text": "De hoofdinstructeur en toezichthouder werden verdacht van dood door schuld en het niet voldoen aan een dienstvoorschrift, met de dood tot gevolg. Maar het OM vindt nu op basis van het onderzoek dat beiden ervan uit mochten gaan dat de baan veilig kon worden gebruikt."
                            },
                            {
                                "example_id": "b1b968bc-9093-42b6-bce3-bff9481d5ab4",
                                "sense_id": "79dbbb71-67d8-3c35-bd56-dffc33a6ef72",
                                "text": "Een 33-jarige militair is veroordeeld tot een taakstraf van 60 uur omdat hij een dienstvoorschrift niet heeft nageleefd. Het OM had 160 uur dienstverlening geëist."
                            },
                            {
                                "example_id": "6e0b20bb-5a57-4467-af67-f67d852b195a",
                                "sense_id": "79dbbb71-67d8-3c35-bd56-dffc33a6ef72",
                                "text": "Groenbroek las bijvoorbeeld dat er dienstvoorschriften waren overtreden. Ze kwam verklaringen tegen van een militair die zei dat ‘onbruikbare munitie’ met een druk op de knop in ‘bruikbaar’ is veranderd zonder dat daar technisch onderzoek aan ten grondslag lag. Dat er militairen waren die mensen konden aanwijzen waarvan ze wisten dat ze hadden gelogen over informatie die is gegeven toen er onderzoek werd gedaan naar het fatale ongeval."
                            }
                        ]
                    }
