                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b4bf43-41cb-4b35-af43-4e9ae496a817",
                                "sense_id": "c5ea122d-ed1c-3959-a1cb-a51ee1f5466c",
                                "text": "Er konnte die fortwährende Gängelei durch seine Eltern nicht mehr länger ertragen."
                            },
                            {
                                "example_id": "fd1592a8-0109-4fff-836e-ef55849d6fc9",
                                "sense_id": "c5ea122d-ed1c-3959-a1cb-a51ee1f5466c",
                                "text": "„Doch bald schon wächst ihr Ärger über hohen Steuern und Gängeleien der britischen Verwaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
