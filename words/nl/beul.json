            "senses": [
                {
                    "sense_id": "fb8a8a0e-e4a8-3a22-bec9-801a36ef2a96",
                    "sense_definition": "Iemand die als beroep doodstraffen en lijfstraffen uitvoert.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>beul</w> voerde de straf uit volgens het vonnis van de rechter.",
                            "target_lang_translations": {
                                "it": "Il <w>boia</w> ha eseguito la pena secondo la sentenza del giudice."
                            }
                        },
                        {
                            "text": "In het museum hangt een middeleeuws schilderij van een gemaskerde <w>beul</w>.",
                            "target_lang_translations": {
                                "it": "Nel museo c'è un dipinto medievale di un <w>boia</w> mascherato."
                            }
                        }
                    ],
                    "synonyms": [
                        "scherprechter"
                    ],
                    "common_phrases": [
                        "de middeleeuwse beul",
                        "gemaskerde beul"
                    ],
                    "target_lang_definitions": {
                        "it": "Persona che esegue professionalmente pene di morte e punizioni corporali."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "boia",
                                "target_lang_sense_clarification": "chi esegue condanne a morte"
                            },
                            {
                                "target_lang_word": "carnefice",
                                "target_lang_sense_clarification": "chi esegue torture o condanne a morte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dae01768-fd99-3787-804b-e31ff8fd84d1",
                    "sense_definition": "Een heel wreed of zielloos persoon die anderen erg laat lijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dictator bleek een meedogenloze <w>beul</w> te zijn voor zijn eigen volk.",
                            "target_lang_translations": {
                                "it": "Il dittatore si è rivelato essere un spietato <w>carnefice</w> per il suo stesso popolo."
                            }
                        },
                        {
                            "text": "Die man is een echte <w>beul</w> die zijn dieren slecht behandelt.",
                            "target_lang_translations": {
                                "it": "Quell'uomo è un vero <w>aguzzino</w> che tratta male i suoi animali."
                            }
                        }
                    ],
                    "synonyms": [
                        "barbaar",
                        "beest",
                        "bruut",
                        "monster",
                        "onmens",
                        "sadist",
                        "wreedaard"
                    ],
                    "common_phrases": [
                        "een echte beul"
                    ],
                    "target_lang_definitions": {
                        "it": "Una persona molto crudele e senza scrupoli che fa soffrire gravemente gli altri."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "carnefice",
                                "target_lang_sense_clarification": "persona estremamente crudele"
                            },
                            {
                                "target_lang_word": "aguzzino",
                                "target_lang_sense_clarification": "persona che tormenta o maltratta gli altri"
                            },
                            {
                                "target_lang_word": "tiranno",
                                "target_lang_sense_clarification": "persona spietata e opprimente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec4579e6-eba6-3dcc-b152-d67a81472a44",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>beulen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>beul</w> elke dag op mijn werk om de deadline te halen.",
                            "target_lang_translations": {
                                "it": "<w>Sgobbo</w> ogni giorno al lavoro per rispettare la scadenza."
                            }
                        },
                        {
                            "text": "Als ik zo doorga en hard <w>beul</w>, is de tuin vanavond nog schoon.",
                            "target_lang_translations": {
                                "it": "Se continuo così e <w>sgobbo</w> duro, stasera il giardino sarà già pulito."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prima persona singolare del presente indicativo di 'beulen' (sgobbare, faticare duramente)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sgobbo",
                                "target_lang_sense_clarification": "lavoro con grande fatica"
                            },
                            {
                                "target_lang_word": "fatico",
                                "target_lang_sense_clarification": "mi affatico duramente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
