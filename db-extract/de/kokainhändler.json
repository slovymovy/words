                        "glosses": [
                            "Person, die mit Kokain handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab0c9a1-6458-4511-802a-e11d1bd13699",
                                "sense_id": "b940fbb0-b694-3748-9596-824c2975d572",
                                "text": "„Der Mann, von dem man wusste, dass er einer der größten Kokainhändler der Welt war, posierte mit seinem kleinen Sohn Juan Pablo vor dem Weißen Haus und kam erstmals in den Genuss der Villen, die er sich in Miami gekauft hatte (eine in Miami Beach und eine Acht-Millionen-Dollar-Ranch nördlich der Stadt in Plantation, Florida).“"
                            },
                            {
                                "example_id": "5ec628da-a41a-48b5-8ac5-e6376a26efed",
                                "sense_id": "b940fbb0-b694-3748-9596-824c2975d572",
                                "text": "„Oder Juan Almeida, einer der größten kolumbianischen Kokainhändler in Florida, der die Kontakte zu den kolumbianischen Kartellen über die Vermietung von Luxusautos in Miami und weitere Scheinfirmen hält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
