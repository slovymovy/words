    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ce56ebf2-f97e-352e-bcaf-5a1e856096de",
                    "sense_definition": "In a realistic, practical, and sensible manner rather than following theoretical or idealistic approaches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "practical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to approach the problem <w>pragmatically</w> by focusing on immediate solutions."
                        },
                        {
                            "text": "Instead of arguing about theory, we should act <w>pragmatically</w> to balance the budget."
                        }
                    ],
                    "synonyms": [
                        "practically",
                        "realistically",
                        "sensibly"
                    ],
                    "antonyms": [
                        "idealistically",
                        "impractically"
                    ],
                    "common_phrases": [
                        "act pragmatically",
                        "approach pragmatically"
                    ]
                },
                {
                    "sense_id": "4a31dc96-03ce-3339-9164-2b755f8e694d",
                    "sense_definition": "From the perspective of pragmatics, concerning how context influences the interpretation of meaning in language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phrase is grammatically correct but <w>pragmatically</w> inappropriate in this context."
                        },
                        {
                            "text": "Linguists analyzed how the statement functions <w>pragmatically</w> within natural conversation."
                        }
                    ],
