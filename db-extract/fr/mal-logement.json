                "senses": [
                    {
                        "sense_id": "1aa0859a-32af-3727-9d50-bbe776b74ba3",
                        "entry_id": "8a6dcbcc-96c7-3461-95d6-2d5b3c3b7a9e",
                        "glosses": [
                            "Situation des personnes défavorisées vivant dans de mauvaises conditions en raison d'un logement de mauvaise qualité ou inadapté à leurs besoins."
                        ],
                        "tags": [
                            "Habitat"
                        ],
                        "examples": [
                            {
                                "example_id": "1893ebfe-a204-461a-afac-c93bf602385c",
                                "sense_id": "1aa0859a-32af-3727-9d50-bbe776b74ba3",
                                "text": "Le mal-logement, tel que vous le nommez n’est pas qu’un problème d’habitat vétuste ou d’entassement de plusieurs personnes dans des surfaces ridiculement petites."
                            },
                            {
                                "example_id": "458bc593-8ca7-482d-93e1-932fdde2e941",
                                "sense_id": "1aa0859a-32af-3727-9d50-bbe776b74ba3",
                                "text": "Afin de renforcer la réponse de l'État et ses partenaires dans la lutte contre l'habitat indigne et le mal-logement, la plateforme « Histologe » ouvre en ligne au 1ᵉʳ mars 2023 dans le département de l'Yonne."
                            },
                            {
                                "example_id": "cd134666-1db1-44b8-b0d4-3a43d0ec2af4",
                                "sense_id": "1aa0859a-32af-3727-9d50-bbe776b74ba3",
                                "text": "Un chiffre fou au regard de la demande et du mal-logement actuel."
                            }
                        ]
                    }
                ],
