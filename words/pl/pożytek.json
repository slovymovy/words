            "senses": [
                {
                    "sense_id": "adb62004-9b71-39cc-a596-c63b5e80e95f",
                    "sense_definition": "korzyść lub wartość płynąca z czegoś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "korzyść",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Internet to duży <w>pożytek</w> dla współczesnej ludzkości.",
                            "target_lang_translations": {
                                "ru": "Интернет приносит большую <w>пользу</w> современному человечеству."
                            }
                        },
                        {
                            "text": "Z tej współpracy nie ma żadnego <w>pożytku</w> dla naszej firmy.",
                            "target_lang_translations": {
                                "ru": "От этого сотрудничества нет никакой <w>пользы</w> для нашей компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "korzyść",
                        "zysk",
                        "profit"
                    ],
                    "antonyms": [
                        "strata",
                        "niekorzyść"
                    ],
                    "common_phrases": [
                        "mieć pożytek",
                        "przynosić pożytek"
                    ],
                    "target_lang_definitions": {
                        "ru": "положительный результат, выгода или ценность, получаемые от чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́льза",
                                "target_lang_sense_clarification": "общее понятие выгоды или благотворного влияния"
                            },
                            {
                                "target_lang_word": "вы́года",
                                "target_lang_sense_clarification": "материальная или практическая прибыль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "105daba9-1b97-3fbb-ba57-f829004f070c",
                    "sense_definition": "użyteczność lub praktyczne zastosowanie czegoś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "korzyść",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Należy ocenić <w>pożytek</w> płynący z wprowadzenia nowych przepisów.",
                            "target_lang_translations": {
                                "ru": "Следует оценить <w>пользу</w> от введения новых правил."
                            }
                        },
                        {
                            "text": "Wątpię w <w>pożytek</w> z tak skomplikowanych rozwiązań technicznych.",
                            "target_lang_translations": {
                                "ru": "Я сомневаюсь в <w>пользе</w> таких сложных технических решений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "практическая применимость или целесообразность чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́льза",
                                "target_lang_sense_clarification": "практическая ценность или смысл"
                            },
                            {
                                "target_lang_word": "целесообра́зность",
                                "target_lang_sense_clarification": "обоснованность и практическая оправданность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36da2c3c-c408-34dc-a1c9-915b661ddc8f",
                    "sense_definition": "nektar, pyłek lub spadź zbierane przez pszczoły",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pszczelarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pszczoły intensywnie zbierają <w>pożytek</w> z kwitnących lip.",
                            "target_lang_translations": {
                                "ru": "Пчёлы интенсивно собирают <w>взяток</w> с цветущих лип."
                            }
                        },
                        {
                            "text": "Obfity <w>pożytek</w> pozwala rodzinom pszczelim na szybki rozwój.",
                            "target_lang_translations": {
                                "ru": "Обильный <w>взяток</w> позволяет пчелиным семьям быстро развиваться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zbierać pożytek"
                    ],
                    "target_lang_definitions": {
                        "ru": "нектар и пыльца, собираемые пчелами с растений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взя́ток",
                                "target_lang_sense_clarification": "специальный термин в пчеловодстве для обозначения собранного корма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
