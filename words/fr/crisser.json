{
    "word_family": [
        "crissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a79a6fb-2944-32b6-b9ad-fde0005bf99a",
                    "sense_definition": "Produire un grincement aigu ou un frottement sec, notamment en parlant de pneus, de pas sur la neige ou de dents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a freiné brusquement et a fait <w>crisser</w> les pneus sur la route mouillée."
                        },
                        {
                            "text": "La neige glacée commençait à <w>crisser</w> sous le poids de nos pas silencieux dans la forêt."
                        }
                    ],
                    "synonyms": [
                        "grincer"
                    ],
                    "common_phrases": [
                        "faire crisser les pneus",
                        "crisser des dents"
                    ]
                },
                {
                    "sense_id": "0cd43600-afbf-302c-aba4-a8911bd29de0",
                    "sense_definition": "Produire un cri strident et répété, en parlant du grillon ou d'autres insectes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au crépuscule, des centaines de grillons <w>crissaient</w> au milieu des herbes sauvages."
                        },
                        {
                            "text": "Dans le silence de la nuit campagnarde, un insecte invisible continuait de <w>crisser</w> sans relâche."
                        }
                    ],
                    "synonyms": [
                        "striduler"
                    ]
                },
                {
                    "sense_id": "90a3a66c-fe48-3e4e-b1ad-0a1f27e3e9f3",
                    "sense_definition": "Jeter, flanquer ou asséner violemment quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_violente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fou de rage, il a failli lui <w>crisser</w> une claque avant de se calmer."
                        },
                        {
                            "text": "Le patron a menacé de le <w>crisser</w> dehors s'il arrivait encore une fois en retard."
                        }
                    ],
                    "synonyms": [
                        "balancer",
                        "flanquer",
                        "foutre"
                    ],
                    "common_phrases": [
                        "crisser une claque",
                        "crisser dehors"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "familier ou vulgaire"
                        }
                    ]
                },
                {
                    "sense_id": "238bf0e3-dd61-3ec9-9d11-682470884bc2",
                    "sense_definition": "Se moquer complètement de quelque chose, n'y accorder aucune importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même si tout le monde s'inquiète, il affirme qu'il s'en <w>crisse</w> totalement."
                        },
                        {
                            "text": "Tu peux dire ce que tu veux, ils se <w>crissent</w> de nos avis depuis le début."
                        }
                    ],
                    "synonyms": [
                        "se balancer",
                        "se ficher",
                        "se foutre"
                    ],
                    "common_phrases": [
                        "s'en crisser"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "familier ou vulgaire"
                        }
                    ]
                }
            ]
        }
    ]
