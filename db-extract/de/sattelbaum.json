                                "example_id": "63c5dfe8-a7ec-4ae9-8f98-9e422442d079",
                                "sense_id": "ec200e59-43ff-34ce-9324-157c50d7981c",
                                "text": "„Unter dem Sattelbaume wird ein gepolstertes u. durchnähetes Kissen von Leinwand (Sattelkissen) angenagelt.“"
                            },
                            {
                                "example_id": "f7cb9cfd-30c7-44f4-9a1d-e0f23f42e02a",
                                "sense_id": "ec200e59-43ff-34ce-9324-157c50d7981c",
                                "text": "„Das Schulterblatt bewegt sich bei jedem Vorführen des Vorderbeines drei bis fünf Zentimeter nach hinten […]. Hier kann es an die Ortspitzen des Sattelbaumes stoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8716c74f-a7d9-4d09-a8d8-d0595f578512",
