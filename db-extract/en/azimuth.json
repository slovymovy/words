                        ]
                    },
                    {
                        "translation_id": "e9850bbe-3615-42d8-8a32-37954e22e00f",
                        "source_entry_id": "2a4b5f35-f836-3dc1-881b-a31ffe70fccc",
                        "source_sense_description": "arc of the horizon",
                        "target_lang_word": "azimut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
