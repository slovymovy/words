                {
                    "sense_id": "09a89bab-add1-3cd8-b44e-fb4402f642a5",
                    "sense_definition": "The three upright wooden posts forming the wicket in cricket; the stumps.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
