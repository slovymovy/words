                        "examples": [
                            {
                                "example_id": "7a2cb809-3644-4921-8c60-f46ff0154b0c",
                                "sense_id": "b7789e86-eb6c-3da2-a5f8-a4e2e0aa4690",
                                "text": "Прие́хав домо́й, преосвяще́нный Пётр напи́лся ча́ю, пото́м переоде́лся, лёг в посте́ль и приказа́л келе́йнику закры́ть ста́вни на о́кнах.",
                                "translation": "On reaching home his holiness drank some tea, then changed his clothes, lay down on his bed, and told the lay brother to close the shutters on the windows.",
                                "english": "On reaching home his holiness drank some tea, then changed his clothes, lay down on his bed, and told the lay brother to close the shutters on the windows."
                            }
                        ]
                    }
