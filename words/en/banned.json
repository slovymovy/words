                    "sense_id": "afe2d557-1d44-3cad-94c4-1725464039c3",
                    "sense_definition": "Forbidden; not allowed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was disqualified for using a <w>banned</w> substance during the competition.",
                            "target_lang_translations": {
                                "ru": "Спортсмен был дисквалифицирован за использование <w>запрещённого</w> вещества во время соревнований.",
                                "zh": "该运动员因在比赛中使用<w>违禁</w>药物而被取消了参赛资格。"
                            }
                        },
                        {
                            "text": "Smoking is strictly <w>banned</w> inside the restaurant.",
                            "target_lang_translations": {
                                "ru": "Курение внутри ресторана строго <w>запрещено</w>.",
                                "zh": "餐厅内严禁吸烟。"
                            }
                        }
                    ],
                    "synonyms": [
