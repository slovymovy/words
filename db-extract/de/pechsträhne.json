                        "examples": [
                            {
                                "example_id": "834cf6a5-b17f-4c29-bb19-cdea81364960",
                                "sense_id": "268cb0d0-345f-36d9-a661-dcbacef0b084",
                                "text": "„In den Wochen vor meiner Abreise hatte ich eine ungewöhnliche Pechsträhne durchlebt.“"
                            },
                            {
                                "example_id": "1a0ccb26-6e33-45d4-b8ec-b8cdeccc6a18",
                                "sense_id": "268cb0d0-345f-36d9-a661-dcbacef0b084",
                                "text": "„Man wich mir aus, als ob die Pechsträhne, die mich bedrückte, ansteckend gewesen wäre; und vielleicht hatte man recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
