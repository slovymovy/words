                "senses": [
                    {
                        "sense_id": "ea7f6779-e029-3d06-ae79-7ef897d98ea8",
                        "entry_id": "c9a2c096-73cc-3713-bb0a-d1802d0d8f92",
                        "glosses": [
                            "miasto i gmina we Włoszech, położone na zachodnim wybrzeżu Sycylii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4c52cb-d056-432c-a242-fbc41bc4ab5d",
                                "sense_id": "ea7f6779-e029-3d06-ae79-7ef897d98ea8",
                                "text": "Nazajutrz po wylądowaniu tysiąca garibaldczyków w Marsali na Sycylii, gdy rozpoczęła się decydująca walka o zjednoczenie Włoch, w sycylijskiej wiosce Bronte chłopi urządzili rzeź „panów”, w praktyce wszystkich mieszkańców „o białej skórze” i „w kapeluszach”"
                            },
                            {
                                "example_id": "4e6076ef-42be-432e-a30b-20b831bf517d",
                                "sense_id": "ea7f6779-e029-3d06-ae79-7ef897d98ea8",
                                "text": "W tym samym roku inna saraceńska wyprawa, składająca się z czterdziestu okrętów, złupiła sycylijskie miasta: Mazara del Vallo, Marsalę i Trapani. Po ich doszczętnym zniszczeniu i ograbieniu popłynęła na północ Morzem Tyrreńskim"
                            },
                            {
                                "example_id": "cbd20ec8-26fe-4845-ba31-a1ad93824388",
                                "sense_id": "ea7f6779-e029-3d06-ae79-7ef897d98ea8",
                                "text": "W XVI wieku znaczenie Marsali osłabło w konsekwencji rozmyślnego zasypania portu w celu lepszej obrony przed atakami korsarzy. Miasto odzyskało swój dawny splendor w XVIII wieku, gdy Anglicy rozwinęli produkcję i handel winem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
