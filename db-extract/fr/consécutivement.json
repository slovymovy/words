        "fr-extract.jsonl": [
            {
                "entry_id": "7dc2188b-33cd-30c6-ac07-838de60f3a7b",
                "word": "consécutivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                        "entry_id": "7dc2188b-33cd-30c6-ac07-838de60f3a7b",
                        "glosses": [
                            "D’une manière consécutive ; tout de suite ; immédiatement après ; selon l’ordre du temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c381ee3f-e0f1-42eb-9a11-e08017b4c2ca",
                                "sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                                "text": "Ainsi, défilèrent consécutivement les qualificatifs de dément, délirant, chouette, bath, et pas mal. On pouvait tout aussi bien dire d'une fille qu'elle était chouette et d'une capitale étrangère visitée à Pâques que c'était pas mal."
                            },
                            {
                                "example_id": "cd7546a4-e658-468f-be6f-fb1cf1b78a61",
                                "sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                                "text": "Il repérait ses proies à leur odeur, à leur tenue, à leur forme. Mais, jamais, il ne perpétrait deux fois consécutivement le même crime."
                            },
                            {
                                "example_id": "38d66980-cb18-434b-a70d-053bc5d48839",
                                "sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                                "text": "Il entrait d’autres personnes sur le théâtre, ensuite d’autres prenaient leur place, et ainsi consécutivement jusqu'à la fin de la cérémonie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c11a24b7-22af-4dfd-8c12-3b4aaea98d35",
                        "source_entry_id": "7dc2188b-33cd-30c6-ac07-838de60f3a7b",
                        "source_sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                        "target_lang_word": "consecutively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consecutively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3709d007-e6df-31ba-8a4b-52d5c234b417",
                                        "entry_id": "5253aba6-ea0f-30b6-8b28-3675daae4f5b",
                                        "glosses": [
                                            "In a consecutive manner; without interruption."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a913acc-eca2-48cb-94bf-bcb8b710cf0c",
                                                "sense_id": "3709d007-e6df-31ba-8a4b-52d5c234b417",
                                                "text": "They considered only proteins in the paranome (the set of all duplicate genes in the genome) and numbered them consecutively according to their positions on the chromosomes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ece3115-2d9c-4545-9111-ea901542b543",
                        "source_entry_id": "7dc2188b-33cd-30c6-ac07-838de60f3a7b",
                        "source_sense_id": "cced8eca-9c97-3c51-975d-ae6e41cb3773",
                        "target_lang_word": "successively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                        "entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                                        "glosses": [
                                            "In a serial or successive manner; one following another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6369fc-3f0c-4de6-a1a0-289dba6790e4",
                                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                                "text": "Allan was first William Buddicom's and then Trevithick's second-in-command, at Edge Hill and at Crewe successively, for the period of 13½ years from February, 1840, to September, 1853, when he left Crewe to become Superintendent of the Scottish Central Railway."
                                            },
                                            {
                                                "example_id": "7ae1ba82-13f9-4986-89d0-77d43bc9645e",
                                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                                "text": "My last to you was of Oct. 8 by the Count de Moustier. Yours of July 18. Sep. 6. & Oct. 24. have been successively received, yesterday, the day before & three or four days before that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
