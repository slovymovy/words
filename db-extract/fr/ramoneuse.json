                "senses": [
                    {
                        "sense_id": "29cfa521-063c-3c9e-b1ce-979a5d48e202",
                        "entry_id": "a5b9b1f6-131a-32ca-8eec-7f0d8b0eae62",
                        "glosses": [
                            "Celle dont le métier est de ramoner les cheminées."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "bd2549f3-1d92-45ab-a942-9be3c9c9ebdd",
                                "sense_id": "29cfa521-063c-3c9e-b1ce-979a5d48e202",
                                "text": "Audile Schaubel, ramoneuse de cheminées, est qualifiée aristocrate enragée ; son mari est émigré."
                            }
                        ]
                    },
                    {
                        "sense_id": "7058881c-f54f-3fee-acd0-a632ea000c76",
                        "entry_id": "a5b9b1f6-131a-32ca-8eec-7f0d8b0eae62",
                        "glosses": [
                            "Machine destinée à ramoner les cheminées, à récurer les tuyaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dad4ee3-c0b1-4d98-b876-34f26b22755e",
                                "sense_id": "7058881c-f54f-3fee-acd0-a632ea000c76",
                                "text": "Entre les regards, un filin est lancé à l’aide d’une ramoneuse hydraulique équipée d’une buse semi flottante."
                            },
                            {
                                "example_id": "621ca1e4-25d0-4d0c-81d0-afc5191badf7",
                                "sense_id": "7058881c-f54f-3fee-acd0-a632ea000c76",
                                "text": "Toutefois, l’achat d’une ramoneuse peut être coûteux, selon la hauteur ou la saleté de votre cheminée."
                            }
                        ]
                    },
                    {
                        "sense_id": "370fb846-5f2b-3c18-8206-26905a0d7cf0",
                        "entry_id": "a5b9b1f6-131a-32ca-8eec-7f0d8b0eae62",
                        "glosses": [
                            "Partisane de Jean-Philippe Rameau."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d56168-fdf2-4c11-9b9f-4fc806ed362e",
                                "sense_id": "370fb846-5f2b-3c18-8206-26905a0d7cf0",
                                "text": "J’arrive de la répétition de Dardanus. J’en suis enchantée et me voilà tout à fait ramoneuse […]"
                            }
                        ]
                    }
                ],
