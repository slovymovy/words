                "senses": [
                    {
                        "sense_id": "b866b755-8995-3d60-9a34-43ede3240c8c",
                        "entry_id": "9de61e97-4e0e-3584-8cfb-d2bf959a5acf",
                        "glosses": [
                            "The doctrine that living organisms have evolved from previously existing forms of living matter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf868d1e-b9d0-4d63-b178-6dffef8a4c45",
                                "sense_id": "b866b755-8995-3d60-9a34-43ede3240c8c",
                                "text": "In a word, the embryology and the taxinomy of the animal kinds, enlightened by the doctrine of transformism, show to us the slow acquisition of conscient life in the animal kingdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce278c45-73a6-3cb5-9b47-27d417088630",
                        "entry_id": "9de61e97-4e0e-3584-8cfb-d2bf959a5acf",
                        "glosses": [
                            "Synonym of trasformismo."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bcd58be-2c61-457a-8ebc-ce43d1a7abd1",
                        "source_entry_id": "9de61e97-4e0e-3584-8cfb-d2bf959a5acf",
                        "source_sense_description": "the doctrine that living organisms have evolved from previously existing forms of living matter",
                        "target_lang_word": "transformisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transformisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8184127e-e46c-3c47-ae62-b62f6358dee3",
                                        "entry_id": "1f8000de-7cb5-38f3-baa0-7c74e047cacb",
                                        "glosses": [
                                            "Théorie d’après laquelle les espèces vivantes ne sont pas fixes et sont arrivées à leur forme actuelle par évolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34cc9f7b-5c59-4e3b-a4fd-e711f991cda6",
                                                "sense_id": "8184127e-e46c-3c47-ae62-b62f6358dee3",
                                                "text": "Le rayonnement International du Muséum se mesure aussi à la manière dont certaines théories, comme celle du transformisme enseignée par Lamarck, vont se diffuser partout en Europe."
                                            },
                                            {
                                                "example_id": "ef21af0e-ee43-43dd-b076-18dad0140267",
                                                "sense_id": "8184127e-e46c-3c47-ae62-b62f6358dee3",
                                                "text": "Cuvier a bénéficié de la colonisation de l’Amérique, qui a permis de rapporter des squelettes en Europe. À partir d’une molaire d’un mastodonte américain et d’un squelette de megatherium retrouvé en Argentine, il en a ainsi conclu qu’il y avait un « monde antérieur au nôtre ». Cuvier était toutefois opposé à l’idée d’évolution, alors appelée transformisme."
                                            },
                                            {
                                                "example_id": "7a057b5c-8290-495e-bb02-9fda9b6de4d8",
                                                "sense_id": "8184127e-e46c-3c47-ae62-b62f6358dee3",
                                                "text": "Et lorsque, peu après, la Maison des Sciences organisa un cycle de conférences sur le transformisme, Jean Rostand, qui n’était pourtant pas le plus anti-darwinien des orateurs proposa, en terminant son exposé, de « dédarwiniser »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567c6963-5587-3e7c-bd40-405b1e35bfe5",
                                        "entry_id": "1f8000de-7cb5-38f3-baa0-7c74e047cacb",
                                        "glosses": [
                                            "Pratique politique, apparue en Italie, qui consiste à réaliser des coalitions à l’intérieur du parlement, regroupant des composantes de droite et de gauche appartenant à l’aile centriste de leur parti."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4dfbdaf-71e4-3dc9-b630-6694665cb66a",
                                        "entry_id": "1f8000de-7cb5-38f3-baa0-7c74e047cacb",
                                        "glosses": [
