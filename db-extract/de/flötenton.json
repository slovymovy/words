                "senses": [
                    {
                        "sense_id": "92c8a4f5-846f-33fc-aa4e-2dca7c61edd4",
                        "entry_id": "088b7d4f-9171-301c-bdee-b432b8baa53c",
                        "glosses": [
                            "mit einer Flöte erzeugter Ton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc2a8cb-59cc-4974-93ae-df4ef80d4dbf",
                                "sense_id": "92c8a4f5-846f-33fc-aa4e-2dca7c61edd4",
                                "text": "„Ich habe vor ein paar Monaten vor lauter Berufsmusikern einen Vortrag für einen Meisterkurs gehalten, über den Einfluss des Materials auf den Flötenton und habe anfangs die Frage gestellt, was sie denn glauben.“"
                            },
                            {
                                "example_id": "8578ed33-6968-4b8f-b8b4-f5d798b04215",
                                "sense_id": "92c8a4f5-846f-33fc-aa4e-2dca7c61edd4",
                                "text": "„Eröffnet wurde das Konzert mit der elfteiligen Orchestersuite C-Dur Nr. 1 BWV 1066 von Johann Sebastian Bach, in dem neben dem Cembalo als Continuoinstrument, die grosse Familie der Streicher, Fagott und vor allem zwei Oboen mit ihrem wie näselnd wirkenden Flötenton auch solistisch zu hören sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
