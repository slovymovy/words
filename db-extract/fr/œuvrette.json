                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9748077-9e1c-4fb1-ab19-25a072741b97",
                                "sense_id": "388cf04e-5d95-385b-af6b-6ef7b49d4996",
                                "text": "L’œuvrette parut un an plus tard et reçut un modeste prix littéraire, ce qui aurait amusé Michel, et qui, en même temps, lui aurait fait plaisir."
                            },
                            {
                                "example_id": "be66d19e-17ff-4dca-9963-939115b3f4f1",
                                "sense_id": "388cf04e-5d95-385b-af6b-6ef7b49d4996",
                                "text": "— Afin que vous cessiez de médire de mes livres.\n— Vous êtes d’une naïveté ! Vous semblez persuadée que vos œuvrettes me séduiraient."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fda9211-8e49-3ec6-a6bc-fcb7ffddb251",
                        "entry_id": "72cd0b4a-0ddf-337d-8d9c-15c51c9580fc",
                        "glosses": [
                            "Petite pièce de théâtre."
                        ],
