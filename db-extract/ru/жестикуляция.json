                    {
                        "translation_id": "fe76a78d-0ea8-431b-a664-cef7bbeb8936",
                        "source_entry_id": "4c83b65f-ea4f-3397-a63c-d5a9d337451c",
                        "target_lang_word": "elkol işaretleri",
                        "target_lang_code": "tr",
