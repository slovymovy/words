                        "examples": [
                            {
                                "example_id": "0db08c2a-6e35-4b68-8902-2f7340704acd",
                                "sense_id": "4d972422-53fb-3594-b14d-feb37700e827",
                                "text": "Cépage de maturité facile, un peu long à se mettre en fruit, le Côt est robuste, vigoureux et d'une longue durée ; il est, avec le Gamay, le plant le plus répandu dans les vignobles de France."
                            },
                            {
                                "example_id": "f1d4c06f-ec4c-48ce-9f61-2c99e0f3ccc5",
                                "sense_id": "4d972422-53fb-3594-b14d-feb37700e827",
                                "text": "Les greffes de Balzac, de Côt, de Folle blanche sur Riparia, à leur quatrième feuille, laissent un tant soit peu à désirer, surtout le Balzac."
                            }
                        ]
                    },
