                        "glosses": [
                            "Acronyme utilisé pour signifier que l’on est pas contre quelque chose, un projet, une action…, mais du moment que cela se passe loin de chez soi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38c5d97-4f16-4499-b692-21dabd366d8b",
                                "sense_id": "9f9cac43-ce66-383f-8d16-61335f482977",
                                "text": "On parle de \"syndrome NIMBY\" pour caractériser cette attitude, bien peu citoyenne, d’égoïsme local, social ou générationnel."
                            }
                        ]
                    }
                ],
                "translations": [],
