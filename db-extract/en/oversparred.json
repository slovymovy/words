                        "glosses": [
                            "Having spars larger than the usual dimension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73746b87-6fdb-47d2-8f1d-8cb83cf7d2ac",
                                "sense_id": "5731e353-ee38-31f3-93aa-05f6af565958",
                                "text": "According to the definitions of character adopted by the association of Lake underwriters at Buffalo, (see March number, vol. 3 page 440,) the “model” is to be taken into account—an important element in the calculation. They provide that “no vessel past six years old, however well rebuilt or repaired, shall be placed in class A, nor one that is oversparred, or hogged, strained from loading, launching, or other cause.”"
                            },
                            {
                                "example_id": "a41ed855-3e99-48f3-9084-0569f345773c",
                                "sense_id": "5731e353-ee38-31f3-93aa-05f6af565958",
                                "text": "When such a measurement is established, we may hope for the substitution of correctly modelled yachts, in lieu of the oversparred and overmanned vessels which are to be found at the starting buoys of every regatta."
                            },
                            {
                                "example_id": "677c54c3-4f3b-4bf9-8db5-4481646f9766",
                                "sense_id": "5731e353-ee38-31f3-93aa-05f6af565958",
                                "text": "The Rockland men believed the yacht oversparred for coasting and eight feet was taken off each of her masts."
                            }
                        ]
                    }
