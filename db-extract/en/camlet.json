                        "entry_id": "312cbcaf-2721-367c-9db5-51c2c919951e",
                        "glosses": [
                            "A fine fabric made from wool (originally camel, but later goat) and silk."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a99bb4bf-6bb2-4b02-8796-e2f3695d4062",
                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                "text": "She wore a sort of jacket of bright red camlet, richly braided with gold and silver lace; a fringe of which also hung from her gray petticoat, which was short enough to show her feet and ankles, whose small size was rendered more remarkable by the peculiar-shaped boot."
                            },
                            {
                                "example_id": "4adf3ed7-fb98-4f4e-a8fb-2f08fb911207",
                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                "text": "She was richly clad in a bodice of gold-coloured camlet and a skirt of gray silk trimmed with gold and silver lace."
                            }
                        ]
                    }
                ],
