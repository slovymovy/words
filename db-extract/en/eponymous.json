                        "entry_id": "77a0200d-8658-3a19-b532-968abed0cf54",
                        "glosses": [
                            "Of, relating to, or being the person or entity after which someone or something is named; serving as an eponym."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48a4ea4-6d2c-4b7f-a064-17f44dacf9d4",
                                "sense_id": "e13bab8b-d06c-32ec-af12-ee77d31a3e81",
                                "text": "Prince Hamlet is the eponymous protagonist of the Shakespearian tragedy Hamlet."
                            },
                            {
                                "example_id": "324ef796-b1e0-4fd9-af30-b99697e6d96e",
                                "sense_id": "e13bab8b-d06c-32ec-af12-ee77d31a3e81",
                                "text": "Robinson Crusoe is the eponymous hero of the book."
                            },
                            {
                                "example_id": "0515a4d4-c809-4c59-8108-9f4debd7c45e",
                                "sense_id": "e13bab8b-d06c-32ec-af12-ee77d31a3e81",
                                "text": "The language Limburgish is named after the eponymous provinces in Belgium and the Netherlands."
                            },
                            {
                                "example_id": "3818f9e2-73cf-4119-9b41-145e9080814f",
                                "sense_id": "e13bab8b-d06c-32ec-af12-ee77d31a3e81",
                                "text": "Hadadas roost in numbers among the trees in the leafier parts of Nairobi and their eponymous call is one of the more insistent elements of the dawn chorus in that part of the world, though they may be heard at any time of the day."
                            }
                        ]
                    },
