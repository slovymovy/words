{
    "word_family": [
        "dissipation",
        "dissipative",
        "dissipator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cab080d5-d494-365b-ad9e-1afc0bd2be7a",
                    "sense_definition": "To gradually disperse, fade away, or disappear completely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disperse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning mist began to <w>dissipate</w> as the sun rose higher in the sky.",
                            "target_lang_translations": {
                                "de": "Der Morgennebel begann <w>sich aufzulösen</w>, als die Sonne höher am Himmel stieg."
                            }
                        },
                        {
                            "text": "Her anger started to <w>dissipate</w> once she heard his sincere apology.",
                            "target_lang_translations": {
                                "de": "Ihr Zorn begann <w>sich zu verflüchtigen</w>, sobald sie seine aufrichtige Entschuldigung hörte."
                            }
                        }
                    ],
                    "synonyms": [
                        "disperse",
                        "vanish",
                        "evaporate",
                        "fade"
                    ],
                    "antonyms": [
                        "accumulate",
                        "gather"
                    ],
                    "common_phrases": [
                        "dissipate into thin air"
                    ],
                    "target_lang_definitions": {
                        "de": "sich allmählich auflösen, zerstreuen oder ganz und gar verschwinden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich auflösen",
                                "target_lang_sense_clarification": "von Nebel, Wolken, Gefühlen"
                            },
                            {
                                "target_lang_word": "sich verflüchtigen",
                                "target_lang_sense_clarification": "Dämpfe, Gerüche, Gefühle"
                            },
                            {
                                "target_lang_word": "sich zerstreuen",
                                "target_lang_sense_clarification": "Nebel, Wolken"
                            },
                            {
                                "target_lang_word": "verschwinden",
                                "target_lang_sense_clarification": "völlig vergehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0db327-ce81-3fb3-8ab3-220b8b333e86",
                    "sense_definition": "To drive away, scatter, or cause something to disappear.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disperse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A strong gust of wind helped to <w>dissipate</w> the thick clouds of smoke.",
                            "target_lang_translations": {
                                "de": "Ein starker Windstoß half dabei, die dichten Rauchwolken <w>zu zerstreuen</w>."
                            }
                        },
                        {
                            "text": "The manager attempted to <w>dissipate</w> their concerns by explaining the new policy clearly.",
                            "target_lang_translations": {
                                "de": "Der Manager versuchte, ihre Bedenken <w>zu zerstreuen</w>, indem er die neue Richtlinie klar erklärte."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispel",
                        "scatter",
                        "disperse"
                    ],
                    "common_phrases": [
                        "dissipate fear",
                        "dissipate doubt"
                    ],
                    "target_lang_definitions": {
                        "de": "etwas vertreiben, zerstreuen oder zum Verschwinden bringen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zerstreuen",
                                "target_lang_sense_clarification": "Zweifel, Sorgen, Rauch"
                            },
                            {
                                "target_lang_word": "vertreiben",
                                "target_lang_sense_clarification": "Wolken, Ängste"
                            },
                            {
                                "target_lang_word": "verscheuchen",
                                "target_lang_sense_clarification": "Gedanken, Sorgen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3f1086-ac13-3de9-98d1-53357840a2c2",
                    "sense_definition": "To waste or squander money, resources, or energy foolishly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>dissipate</w> his entire inheritance in just a few reckless years.",
                            "target_lang_translations": {
                                "de": "Er schaffte es, sein gesamtes Erbe in nur wenigen leichtsinnigen Jahren <w>zu verprassen</w>."
                            }
                        },
                        {
                            "text": "Do not <w>dissipate</w> your efforts on minor tasks when the deadline is approaching.",
                            "target_lang_translations": {
                                "de": "<w>Verzetteln Sie</w> Ihre Bemühungen nicht mit Nebensächlichkeiten, wenn die Frist näher rückt."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "waste",
                        "fritter away"
                    ],
                    "antonyms": [
                        "conserve",
                        "preserve"
                    ],
                    "common_phrases": [
                        "dissipate wealth",
                        "dissipate resources"
                    ],
                    "target_lang_definitions": {
                        "de": "Geld, Ressourcen oder Energie leichtfertig verschwenden oder vergeuden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschwenden",
                                "target_lang_sense_clarification": "Geld, Zeit, Energie"
                            },
                            {
                                "target_lang_word": "vergeuden",
                                "target_lang_sense_clarification": "Kräfte, Ressourcen"
                            },
                            {
                                "target_lang_word": "verprassen",
                                "target_lang_sense_clarification": "Vermögen, Erbe"
                            },
                            {
                                "target_lang_word": "verzetteln",
                                "target_lang_sense_clarification": "Kräfte, Bemühungen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ca87423-03a1-37a6-9f8a-4c65a4e39b03",
                    "sense_definition": "To cause energy, especially heat or electricity, to be lost or spread harmlessly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The special cooling fins are designed to <w>dissipate</w> heat away from the processor.",
                            "target_lang_translations": {
                                "de": "Die speziellen Kühlrippen sind darauf ausgelegt, Wärme vom Prozessor <w>abzuführen</w>."
                            }
                        },
                        {
                            "text": "During heavy braking, the car's discs <w>dissipate</w> kinetic energy as thermal energy.",
                            "target_lang_translations": {
                                "de": "Bei starkem Bremsen <w>geben</w> die Bremsscheiben des Autos kinetische Energie als Wärmeenergie <w>ab</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dissipate heat",
                        "dissipate energy"
                    ],
                    "target_lang_definitions": {
                        "de": "Energie (vor allem Wärme oder Strom) ableiten oder ungenutzt entweichen lassen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ableiten",
                                "target_lang_sense_clarification": "Wärme, Strom"
                            },
                            {
                                "target_lang_word": "abführen",
                                "target_lang_sense_clarification": "Wärme"
                            },
                            {
                                "target_lang_word": "dissipieren",
                                "target_lang_sense_clarification": "Physik: Energie umwandeln/zerstreuen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb3985a-ebfd-3d0c-89b8-a7f99256c023",
                    "sense_definition": "To engage in excessive pursuit of trivial or harmful pleasures; to be dissolute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>dissipate</w> in night clubs rather than focus on his university studies.",
                            "target_lang_translations": {
                                "de": "Er zog es vor, <w>ein ausschweifendes Leben</w> in Nachtclubs <w>zu führen</w>, anstatt sich auf sein Universitätsstudium zu konzentrieren."
                            }
                        },
                        {
                            "text": "The spoiled heir continued to <w>dissipate</w> without giving a thought to the future.",
                            "target_lang_translations": {
                                "de": "Der verwöhnte Erbe fuhr fort, <w>sein ausschweifendes Leben fortzusetzen</w>, ohne einen Gedanken an die Zukunft zu verschwenden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used rarely in modern English in the intransitive moral sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "ein ausschweifendes, liederliches Leben führen; sich vergnügungssüchtig verausgaben"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ein ausschweifendes Leben führen",
                                "target_lang_sense_clarification": "sittenlos leben"
                            },
                            {
                                "target_lang_word": "sich vergnügen",
                                "target_lang_sense_clarification": "ausschweifend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3519cce6-f1df-379f-b80e-cb6c70c4799e",
                    "sense_definition": "Showing the effects of a dissolute, unrestrained, or immoral lifestyle; dissipated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old portrait showed a <w>dissipate</w> man whose wasted youth was evident on his face.",
                            "target_lang_translations": {
                                "de": "Das alte Porträt zeigte einen <w>ausschweifenden</w> Mann, dessen vergeudete Jugend ihm ins Gesicht geschrieben stand."
                            }
                        },
                        {
                            "text": "They led a reckless, <w>dissipate</w> existence on the fringes of the capital.",
                            "target_lang_translations": {
                                "de": "Sie führten eine rücksichtslose, <w>liederliche</w> Existenz am Rande der Hauptstadt."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissolute",
                        "profligate"
                    ],
                    "antonyms": [
                        "temperate",
                        "moral"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare variant of dissipated"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "durch einen zügellosen, ausschweifenden Lebensstil gezeichnet; ausschweifend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ausschweifend",
                                "target_lang_sense_clarification": "Lebenswandel"
                            },
                            {
                                "target_lang_word": "liederlich",
                                "target_lang_sense_clarification": "moralisch verfallen"
                            },
                            {
                                "target_lang_word": "zerlumpt",
                                "target_lang_sense_clarification": "verkommen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}