                                "sense_id": "c200ea9e-1172-3602-b773-f187becb1eaa",
                                "text": "De boer gebruikt een maaier om zijn veld te oogsten.",
                                "translation": "The farmer uses a reaper to harvest his field.",
                                "english": "The farmer uses a reaper to harvest his field."
                            },
                            {
                                "example_id": "71262801-b646-4004-aead-a4843bbe2249",
                                "sense_id": "c200ea9e-1172-3602-b773-f187becb1eaa",
                                "text": "Ik heb een nieuwe maaier gekocht voor mijn gazon.",
                                "translation": "I bought a new mower for my lawn.",
                                "english": "I bought a new mower for my lawn."
                            },
                            {
                                "example_id": "c9ffb49f-f472-4c0f-ae3f-120353b43330",
                                "sense_id": "c200ea9e-1172-3602-b773-f187becb1eaa",
                                "text": "De maaier is kapot, dus we kunnen het gras niet maaien.",
                                "translation": "The mower is broken, so we can't mow the grass.",
                                "english": "The mower is broken, so we can't mow the grass."
                            }
                        ]
