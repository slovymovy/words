                                        "examples": [
                                            {
                                                "example_id": "05bea4f8-26c3-4348-8aea-2f147497d310",
                                                "sense_id": "5947b0cc-2975-3bb4-bed9-d71f167b2514",
                                                "text": "The carriage upset when the horse bolted."
                                            },
                                            {
                                                "example_id": "882543f2-83fe-4b80-a32f-30a08c9da9de",
                                                "sense_id": "5947b0cc-2975-3bb4-bed9-d71f167b2514",
                                                "text": "[T]he locomotive exploded and upset, and was completely wrecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06424229-da8f-3ff1-a356-0e0e1f3140d4",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To set up; to put upright."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d20fea0a-4b7e-4109-b964-0bd39cbd7039",
                                                "sense_id": "06424229-da8f-3ff1-a356-0e0e1f3140d4",
                                                "text": "R. of Brunne\nwith sail on mast upset"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a15db95-bf6f-30bc-a850-ada6bad28853",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To thicken and shorten, as a heated piece of iron, by hammering on the end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9bf20cd-3f61-3ef1-92fb-45910f363bb1",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To shorten (a tire) in the process of resetting, originally by cutting it and hammering on the ends."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b3a2ab7-fb8c-3459-8c28-52c9bb6104bc",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To support with an upset (type of woven row)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6517e78-9e7b-493d-a9b7-9d1591da1b4a",
                                                "sense_id": "8b3a2ab7-fb8c-3459-8c28-52c9bb6104bc",
                                                "text": "Very coarse work is sided up without an upsett, or is upsetted with a pair instead of a wale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
