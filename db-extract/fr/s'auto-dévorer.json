                "senses": [
                    {
                        "sense_id": "b227499e-37bd-3682-80c5-ab0f8ab29b28",
                        "entry_id": "d96455a8-cfc0-3cfd-b819-53be7ef2b9b8",
                        "glosses": [
                            "Se dévorer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2556d1-c1ef-44b4-934f-aab59da4b805",
                                "sense_id": "b227499e-37bd-3682-80c5-ab0f8ab29b28",
                                "text": "2) l'humanisme, tel que le critiquait Heidegger, entreprend désormais de s'auto-dévorer."
                            },
                            {
                                "example_id": "160dd060-a8c4-4394-9543-a6b1d58eb32a",
                                "sense_id": "b227499e-37bd-3682-80c5-ab0f8ab29b28",
                                "text": "Ces poissons ont presque anéanti la faune du lac au point qu'ils en arrivent à s'auto-dévorer."
                            },
                            {
                                "example_id": "1bcf0668-b185-47b3-a69a-d62bfb0bf601",
                                "sense_id": "b227499e-37bd-3682-80c5-ab0f8ab29b28",
                                "text": "Soyons clairs : si les pulsions phagocytantes du capitalisme ne concernaient que lui, on le laisserait s'auto-dévorer dans son coin."
                            }
                        ]
                    }
