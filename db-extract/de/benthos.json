                    {
                        "translation_id": "d714a44a-4513-4edb-83ff-0dcbed6fb6f0",
                        "source_entry_id": "814e316b-ac07-376a-94ad-ed93f2c777d2",
                        "source_sense_id": "49b952e5-9c6c-391a-b19c-66cd731db2e4",
                        "source_sense_description": "pflanzliche und tierische Organismen, die in, auf oder über dem Grund eines Gewässers (Benthal) leben",
                        "target_lang_word": "benthos",
                        "target_lang_code": "fr",
