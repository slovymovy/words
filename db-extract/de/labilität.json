                ],
                "senses": [
                    {
                        "sense_id": "432ded62-d51e-331d-8798-806e2d9cb7d7",
                        "entry_id": "fa9d16c9-1164-3a7c-b681-e2069a5d62a1",
                        "glosses": [
                            "Eigenschaft, in deutlichem Maße veränderliches (labiles) Verhalten zu zeigen; oftmals als Schwäche gedeutete Anfälligkeit, sich nicht gegen Einflüsse behaupten/wehren zu können"
                        ],
                        "tags": [
                            "selten im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "aac8dbd8-b41f-42ab-8d97-fd01c7909cfb",
                                "sense_id": "432ded62-d51e-331d-8798-806e2d9cb7d7",
                                "text": "„Als einige Zeit später der große Krieg kam, 1914, bemerkte ich mit Entsetzen, wie sich nun alles im Großen wiederholte, was ich schon 1909/10 im Kleinen erlebt hatte: die Beeinflussbarkeit der Menschen, ihre Labilität und Urteilslosigkeit, ihre Abhängigkeit von geschickter Propaganda.“"
                            },
                            {
                                "example_id": "e578d371-a401-431a-9ca7-21a6c98337d5",
                                "sense_id": "432ded62-d51e-331d-8798-806e2d9cb7d7",
                                "text": "„Was macht Kinder stark und widerstandsfähig? Wo liegen die Risiken für spätere psychische Labilität?“"
                            },
                            {
                                "example_id": "49605435-b494-4fee-a308-a74dab628856",
                                "sense_id": "432ded62-d51e-331d-8798-806e2d9cb7d7",
                                "text": "„Wie oben bemerkt, dürften neurotrophische Anomalien, Labilität der Neurotrophik, vor allem aber Labilität der Schilddrüsenfunktion etwa im Sinne einer „Instabilité thyréoidienne“ dabei von Belang sein.“"
                            },
                            {
                                "example_id": "7e6df126-0904-4d41-a2fd-981c0b684e10",
                                "sense_id": "432ded62-d51e-331d-8798-806e2d9cb7d7",
                                "text": "„Zu anderen Zeiten äußerte sich die Labilität des Kapitäns nicht in Zorn, sondern in Untätigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
