                "senses": [
                    {
                        "sense_id": "8cf5305c-3e4a-3b5a-b099-dd15626b88eb",
                        "entry_id": "fb2b56aa-a044-3a1d-94da-2316b05e02d4",
                        "glosses": [
                            "Se déterminer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a89fca-1183-40e5-896a-e87507a973b2",
                                "sense_id": "8cf5305c-3e4a-3b5a-b099-dd15626b88eb",
                                "text": "De l’agroécosystème au système commercial mondial, en passant par la ferme et la région, les différents niveaux s’emboîtent et s’entre-déterminent."
                            },
                            {
                                "example_id": "3b9513e6-7427-41e0-9d52-0c24fbc21829",
                                "sense_id": "8cf5305c-3e4a-3b5a-b099-dd15626b88eb",
                                "text": "En somme, avec la Hollande, comme avec l’Ecosse, la Bohême et le Danemark, l’Europe fait figure, sur fond marin, d'un seul corps (fantasmagorique), d’un corps où tous les organes correspondent et s’entre-déterminent."
                            }
                        ]
                    }
