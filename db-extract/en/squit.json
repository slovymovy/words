                    {
                        "sense_id": "8d2457e2-fde1-351b-b304-c2bb545b1285",
                        "entry_id": "e42a038a-f3fb-379d-bb7d-d55fbd9f13fe",
                        "glosses": [
                            "To disconnect (an IRC server) from a network."
                        ],
                        "tags": [
                            "Internet",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2df13da0-5991-42d0-a77d-36b1bf782853",
                                "sense_id": "8d2457e2-fde1-351b-b304-c2bb545b1285",
                                "text": "[…] these problems solved themselves atfter^([sic]) some 10 minutes or so, without an ircop interferring^([sic]) into channel affairs by squitting his/her server to gain chanop status."
                            },
                            {
                                "example_id": "b082f33d-437f-4906-b9f3-ff21e16e3e3b",
                                "sense_id": "8d2457e2-fde1-351b-b304-c2bb545b1285",
                                "text": "Today, I was awakened by a call from one of my IRC ops, telling me that my net had been 'taken over'. An ircop had squitted all the servers, and had a script that kept them disconnected from the net."
                            }
                        ]
                    }
