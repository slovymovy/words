                ],
                "senses": [
                    {
                        "sense_id": "733ef503-d848-391d-8d4a-e54305e44c28",
                        "entry_id": "1e5e7133-49d3-3d7d-b54f-881580ab2c1d",
                        "glosses": [
                            "Ausbildungsstätte, in der Musik unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e808a9-6411-4d9a-97c6-8f0c6de36ae4",
                                "sense_id": "733ef503-d848-391d-8d4a-e54305e44c28",
                                "text": "Auch Kleinkinder können eine Musikschule besuchen."
                            },
                            {
                                "example_id": "bdc461c8-8b16-41d5-8add-35f246b15393",
                                "sense_id": "733ef503-d848-391d-8d4a-e54305e44c28",
                                "text": "„Die Kleine Synagoge wurde zu einer Musikschule umgewandelt, später zum Sitz der Hitlerjugend.“"
                            },
                            {
                                "example_id": "7083e358-805f-4ffd-8292-24db1b86466d",
                                "sense_id": "733ef503-d848-391d-8d4a-e54305e44c28",
                                "text": "„Ich dachte zurück an eine Episode aus Milenas und meiner Jugend, als wir beide auf einer Holzbank in der Musikschule saßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9b0f7d0-26ca-4360-8229-8281a80338ee",
                        "source_entry_id": "1e5e7133-49d3-3d7d-b54f-881580ab2c1d",
                        "source_sense_id": "733ef503-d848-391d-8d4a-e54305e44c28",
                        "source_sense_description": "Ausbildungsstätte, in der Musik unterrichtet wird",
                        "target_lang_word": "école de musique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "école de musique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                        "entry_id": "1ec368c5-131e-363a-aac8-59929ce485ad",
                                        "glosses": [
                                            "Institution dispensant un enseignement de la pratique musicale, vocale, instrumentale, mais qui, en général, à la différence des conservatoires, ne s’adresse pas à des élèves sélectionnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e2693d-1adc-44d1-b901-72c0b42e9259",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "Il fonda, en 1862, avec Lamakin, une école de musique gratuite, puis fut nommé, en 1866, chef d’orchestre au théâtre tchèque de Prague, et, l’année suivante, directeur des concerts symphoniques de la Société impériale de musique à Saint-Pétersbourg."
                                            },
                                            {
                                                "example_id": "5cbcd3eb-5308-4cb3-8720-d5a0e7b242ea",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "À Brest, les instruments à vent vont avoir leur école de musique. À la rentrée de septembre 2025, « Zef Musïc » accueillera ses premiers élèves, débutants ou avancés, et recherche, pour l’heure, des salles pour les cours."
                                            },
                                            {
                                                "example_id": "88422e9a-02fb-48de-88c4-cdebd1068571",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "L’atelier jazz de l’école de musique du pays d’Allassac fête ses dix ans d’existence. Depuis cette année, une mutualisation avec l’école de musique d’Objat permet d’étoffer le groupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d05b4a-ce9f-3e34-abcc-dddc29b2c7e2",
                                        "entry_id": "1ec368c5-131e-363a-aac8-59929ce485ad",
                                        "glosses": [
                                            "Établissement public ou privé qui, comme les conservatoires, propose des formations diplômantes dans le domaine de la musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d15a0b1-a3d3-449b-af06-e82b201c8f57",
                                                "sense_id": "84d05b4a-ce9f-3e34-abcc-dddc29b2c7e2",
                                                "text": "Les écoles de musique proposent des formations diplômantes comme la licence en musique, le bachelor en musique ou encore le master en musique. Le corps enseignant est composé de musiciens ou des chanteurs professionnels ainsi que des professeurs de musique diplômés d’Etat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
