                "senses": [
                    {
                        "sense_id": "bc16f048-3b96-35e0-805a-c4ca9735b293",
                        "entry_id": "535ac9c4-e448-3dbc-9edf-1edd67d49c34",
                        "glosses": [
                            "Qui est tourné vers l'avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec9b5f5-6767-461f-a0a9-dfe504e53310",
                                "sense_id": "bc16f048-3b96-35e0-805a-c4ca9735b293",
                                "text": "L'Évangile n'est pas rétrospectif, il ne regarde pas en arrière, il est prospectif, il regarde en avant."
                            },
                            {
                                "example_id": "8699480f-d0de-4706-a608-9e447a9996a3",
                                "sense_id": "bc16f048-3b96-35e0-805a-c4ca9735b293",
                                "text": "Non que je sous-estimasse l’importance de cette évaluation, mais je ne la croyais compatible ni avec l’esprit prospectif, ni avec les moyens du Plan. En effet, l’évaluation des politiques publiques est un travail analytique et besogneux."
                            }
                        ]
                    },
                    {
                        "sense_id": "0382d3de-d1d9-3da8-99d8-d9fc11debe0d",
                        "entry_id": "535ac9c4-e448-3dbc-9edf-1edd67d49c34",
                        "glosses": [
                            "Prévisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ddc2ed9-b25c-4735-96c5-99b9396ff8d0",
                                "sense_id": "0382d3de-d1d9-3da8-99d8-d9fc11debe0d",
                                "text": "Enfin, s’est imposée au centre la famille démocrate chrétienne issue de la doctrine sociale de l’Église, convertie à la démocratie, à la République et à la laïcité, et qui est devenue la famille régnante pratiquement jusqu’à nos jours. Ce mélange familial, divers mais toujours prospectif, a fabriqué des centristes, et aujourd’hui encore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1d227f5-7472-4a4f-bdac-dc5699574782",
                        "source_entry_id": "535ac9c4-e448-3dbc-9edf-1edd67d49c34",
                        "target_lang_word": "prospective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prospective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e97c999a-13fc-3ef3-aefe-87ca03810e31",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Likely or expected to happen or become."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66ecc02d-1f6a-4df5-a917-4d1b3a94c610",
                                                "sense_id": "e97c999a-13fc-3ef3-aefe-87ca03810e31",
                                                "text": "Prospective students are those who have already applied to the university, but have yet to be admitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65921856-7aa1-3e17-96a5-d4ff91e86413",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Anticipated in the near or far future."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e43cfa9b-8911-4c10-a621-90b690f0fdec",
                                                "sense_id": "65921856-7aa1-3e17-96a5-d4ff91e86413",
                                                "text": "A short distance above I-ch’ang is the prospective site of a hydroelectric dam that has vast promise for the industrialization of central China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64325d3-9844-3972-bb8e-985ec613260b",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Of or relating to a prospect; furnishing a prospect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28d6a63-1f62-403f-9d82-3f55f55fd45f",
                                                "sense_id": "c64325d3-9844-3972-bb8e-985ec613260b",
                                                "text": "And in times long and dark Proſpective Glaſs / Fore-ſaw what future dayes ſhould bring to paſs,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46c1ef2-9e49-38d7-8467-f164810ee119",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Looking forward in time; acting with foresight."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9db9a6-11c5-403c-b3f7-5a51bab84366",
                                                "sense_id": "f46c1ef2-9e49-38d7-8467-f164810ee119",
                                                "text": "1668-1690, Josiah Child, A new discourse of trade\nThe French king, and the king of Sweden are […] circumspect, industrious, and prospective, too, in this affair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1413776-76b9-37f5-b719-00edae446e27",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Being a study that starts with the present situation and follows participants into the future"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ef1151e-1d75-3731-83a2-531c70d5f388",
                                        "entry_id": "b2f78b87-804a-3459-8a70-80b0cd2e1f85",
                                        "glosses": [
                                            "Indicating grammatically an activity about to begin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7b3ae8-0248-4320-b2ce-9f1314c40c4a",
                                                "sense_id": "0ef1151e-1d75-3731-83a2-531c70d5f388",
                                                "text": "What some other languages convey with prospective aspect, English conveys with expressions like going to drive the car home."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prospective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b82d3869-62fc-3343-8e0c-bbb50cf5cfbb",
