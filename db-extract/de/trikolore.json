                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drapeau tricolore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f36be7ef-e305-3e85-926d-bd4521aa2495",
                                        "entry_id": "9c357455-af37-3683-95f6-3e0f52e88155",
                                        "glosses": [
                                            "Drapeau comportant trois couleurs à bandes verticales ou horizontales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0821572e-4f47-3e5e-a25a-3bbc0e9669e8",
                                        "entry_id": "9c357455-af37-3683-95f6-3e0f52e88155",
                                        "glosses": [
                                            "Drapeau de son propre pays (en général au moins en partie francophone), lorsqu’il comporte trois bandes de couleur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "Pour les locuteurs, le sens de la locution est généralement considéré comme très clair alors que, selon le pays, elle désignera quelque chose de différent",
                                        "examples": [
                                            {
                                                "example_id": "41dc2eb3-4078-4d90-92c3-be731223e6af",
                                                "sense_id": "0821572e-4f47-3e5e-a25a-3bbc0e9669e8",
                                                "text": "Ainsi l’alliance du blanc, du rouge et du bleu, n’était pas nouvelle lorsque au commencement de la révolution française on adopta le drapeau tricolore."
                                            },
                                            {
                                                "example_id": "8bd3874b-5b63-4ca9-80d6-32f062a13c25",
                                                "sense_id": "0821572e-4f47-3e5e-a25a-3bbc0e9669e8",
                                                "text": "Pour la seconde nuit d’affilée, des inconnus ont accroché un drapeau belge à l’hôtel de ville de Lennik, commune de l’arrondissement de Bruxelles-Hal-Vilvorde dont le bourgmestre Willy De Waele (Open Vld) a récemment fait remplacer le drapeau tricolore par le lion flamand sur les bâtiments officiels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
