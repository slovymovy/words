                    "sense_id": "ba2c7a22-91ab-3df5-a4ed-5f03c5d7e7b8",
                    "sense_definition": "den Fernsehkanal, das Radioprogramm oder einen Sender wechseln",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn Werbung kommt, <w>schaltet</w> mein Vater sofort auf einen anderen Sender <w>um</w>."
                        },
                        {
                            "text": "Die Sendung ist total langweilig, kannst du bitte <w>umschalten</w>?"
                        }
                    ],
                    "synonyms": [
                        "wechseln",
                        "zappen"
                    ],
                    "common_phrases": [
                        "den Sender umschalten",
                        "das Fernsehprogramm umschalten"
                    ]
                },
                {
                    "sense_id": "384c9f3a-ba48-3c59-aa74-20e888b3868a",
                    "sense_definition": "ein technisches Gerät oder eine Anlage durch Betätigen eines Schalters in einen anderen Betriebszustand versetzen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ampel <w>schaltete</w> nach einer kurzen Gelbphase direkt auf Rot <w>um</w>."
                        },
                        {
                            "text": "Mit diesem Knopf kann man die Klimaanlage auf Sparbetrieb <w>umschalten</w>."
                        }
                    ],
                    "synonyms": [
