                "senses": [
                    {
                        "sense_id": "c960dec8-87ce-367d-8a1f-f38774e67f9c",
                        "entry_id": "019da46f-62ea-38ca-a702-e62b561b378b",
                        "glosses": [
                            "Agrume plus ou moins sphérique, à peau fine et contenant peu de pépins, de nom scientifique Citrus paradisi (ou Citrus x paradisi), c'est un hybride naturel entre l'oranger (Citrus sinensis) et le pamplemoussier (Citrus maxima) découvert à la fin du XIX^(ème) siècle dans les Caraïbes."
                        ],
                        "tags": [
                            "En botanique et usage courant en France et au Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "932e51d5-11cc-3b7f-90ac-7bed03d10659",
                        "entry_id": "019da46f-62ea-38ca-a702-e62b561b378b",
                        "glosses": [
                            "Très gros agrume plus ou moins en forme de poire, à nombreux pépins, fruit du pamplemoussier, de nom scientifique Citrus maxima."
                        ],
                        "tags": [
                            "Usage courant en Europe francophone"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c04b5087-86af-33a0-88db-ec3f8e845f16",
                        "entry_id": "019da46f-62ea-38ca-a702-e62b561b378b",
                        "glosses": [
                            "Arbre hybride Citrus paradisi qui produit le fruit sphérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e1e9fc-b2bc-41a5-8862-f881870894c6",
                                "sense_id": "c04b5087-86af-33a0-88db-ec3f8e845f16",
                                "text": "Le pomelo est issu d’un croisement naturel entre le pamplemoussier et l’oranger, apparu aux Antilles à la fin du XVIIIe siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dbc93d5-695e-41c3-9ecc-5a206f19ae68",
                        "source_entry_id": "019da46f-62ea-38ca-a702-e62b561b378b",
                        "source_sense_id": "c960dec8-87ce-367d-8a1f-f38774e67f9c",
                        "source_sense_description": "Agrume (fruit) sphérique, citrus paradisi",
                        "target_lang_word": "grapefruit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grapefruit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6c33eb-50e9-36f3-af9f-ed47fa939fc5",
                                        "entry_id": "66ddf884-92cb-3bc7-853b-611798a7cb1c",
                                        "glosses": [
                                            "The tree of the species Citrus paradisi, a hybrid of Citrus maxima and sweet orange."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a8e041-8161-41c7-8451-2940f8f61180",
                                                "sense_id": "1f6c33eb-50e9-36f3-af9f-ed47fa939fc5",
                                                "text": "Results have begun to come in and at Comfort Castle this month I spent a useful and happy half day carting round 8 children in my car to their homes where we all helped to fill in with good soil and manure, their excellently dug holes and planted the grapefruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62125827-f360-3f26-9459-c70fb1daa545",
                                        "entry_id": "66ddf884-92cb-3bc7-853b-611798a7cb1c",
                                        "glosses": [
                                            "The large spherical tart fruit produced by this tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ea2394-b346-4992-84a6-d046d3373fb5",
                                                "sense_id": "62125827-f360-3f26-9459-c70fb1daa545",
                                                "text": "Grapefruit is high in vitamin C. The pink and red varieties contain vitamin A (betacarotene) and lycopene, an antioxidant that may help prevent cancer. Grapefruit contains a chemical that can alter intestinal absorption of some medications and lead to higher than normal blood levels of some drugs and potential problems."
                                            },
                                            {
                                                "example_id": "c66b3663-ae35-401c-baec-34e33f4397bf",
                                                "sense_id": "62125827-f360-3f26-9459-c70fb1daa545",
                                                "text": "Once loaded by Canaveral, the grapefruit are transported to Japan, where the shipments are unloaded by employees of Japanese stevedoring companies. The grapefruit are then received by the Japanese importers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                        "entry_id": "66ddf884-92cb-3bc7-853b-611798a7cb1c",
                                        "glosses": [
                                            "Large breasts; by extension, a woman with large breasts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f69225-b4ed-4bf2-a904-e1ab45e420b4",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "Cupping her grapefruits in her hands, she closed her eyes and imagined her date grasping them, exploring their size, weight, and firmness."
                                            },
                                            {
                                                "example_id": "3be46cc1-6856-4c1a-9769-f1048e5b26e0",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "Dan hauled her to the carpet as she fell limp over him. She stretched out on her back, her grapefruits, fitted snugly into her sturdy cotton bra, rock hard under his nose."
                                            },
                                            {
                                                "example_id": "8feda7f7-37e4-4404-bad8-e902f331e379",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "In walked my supposedly dead niece Esmerelda wearing shorts that didn't exist and a top that made her grapefruits look like honeydews, if you get my drift."
                                            },
                                            {
                                                "example_id": "ab9b2ac6-312e-4e9c-9606-f85ace3de692",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "He raised his hand again. \"If you scratch my face and I give you a black eye—who's worse off? Because what've you got besides a pair of grapefruits and a pretty face? So let me show you something else I bought.\""
                                            },
                                            {
                                                "example_id": "a089261f-118a-4a08-afe3-7bd1986c0c1e",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "A new pair of grapefruits arrives with yet another tray of drinks. She says that they were sent by someone at another table and points a fingernail in the direction of our benefactor."
                                            },
                                            {
                                                "example_id": "d599d499-b657-468c-a35a-d676e8dd700c",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "I lay there for about twenty seconds trying to get my wind back, until slowly and painfully I picked myself up as best I could and with as much class as I could muster in the circumstances, but keeping my eyes on her grapefruits – the ones in the bag, I hasten to add."
                                            },
                                            {
                                                "example_id": "18339c44-d337-43f7-b1db-0d10722821b6",
                                                "sense_id": "508ff8e2-e154-35c6-bd99-c146aea08734",
                                                "text": "I walked up behind her and pushed my cucumber hard against her booty. Kissed her on the neck and felt those grapefruits. Our mouths met and our tongues also. Strong sexual desire consumed us. I pulled the straps of her outfit over her shoulders and I was soon flavoring her grapefruits, while she unzipped my pants and tasted my cucumber. Soon, we were both naked in the bed. My cucumber had found her orchard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
