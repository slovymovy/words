                ],
                "senses": [
                    {
                        "sense_id": "8f8df5f3-f020-3bbb-80aa-b7a37cc7438e",
                        "entry_id": "9f1ca60a-88ec-398f-8a7b-ae6e464d4a06",
                        "glosses": [
                            "Umgebung, welche die zur Laufzeit von Computerprogrammen verfügbaren und festgelegten Voraussetzungen eines bestimmten Laufzeitsystems beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a870c4f4-79b5-4082-b254-6bd7a740a187",
                                "sense_id": "8f8df5f3-f020-3bbb-80aa-b7a37cc7438e",
                                "text": "„Die Laufzeitumgebung wird ein solches Fehlschlagen in irgendeiner Form melden.“"
                            },
                            {
                                "example_id": "1d77423a-a8b5-47d0-969f-dcc87b6fd0f6",
                                "sense_id": "8f8df5f3-f020-3bbb-80aa-b7a37cc7438e",
                                "text": "„Eigene Funktionen, mit denen man sich für sein eigenes Programm der Laufzeitumgebung bedienen kann, kennt Cluster nicht.“"
                            },
                            {
                                "example_id": "31881ab2-8376-4e5f-8bd8-f6b0d51287c7",
                                "sense_id": "8f8df5f3-f020-3bbb-80aa-b7a37cc7438e",
                                "text": "„Eine Laufzeitumgebung lädt von Anwendungsprogrammierern entwickelte Programme und lässt diese auf einer Plattform ablaufen, für welche die Laufzeitumgebung gemacht worden ist. Damit stellt sie selbst eine kleine „Plattform“ dar, auf der Programme aufsetzen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
