                        "glosses": [
                            "Femme gourou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba6de50-ae9e-4e40-90a0-93a32f2e010b",
                                "sense_id": "0112f666-efa9-36aa-aec8-8bfd2c63def1",
                                "text": "L’argent versé était bien entendu remis en grande partie à notre gourelle."
                            },
                            {
                                "example_id": "2c7f2bad-9259-4f3d-891d-a5b66125fc83",
                                "sense_id": "0112f666-efa9-36aa-aec8-8bfd2c63def1",
                                "text": "On pourrait faire l’impasse sur la secte Horus auto-dissoute, dont la gourelle, Marie-Thérèse Castano, a été condamnée, à la prison ferme, pour non assistance à personne en danger."
                            },
                            {
                                "example_id": "3f02b25a-3db6-431f-98d2-84aae9d9f327",
                                "sense_id": "0112f666-efa9-36aa-aec8-8bfd2c63def1",
                                "text": "J’ai ainsi reçu, il y a trois jours, un monsieur, chef d'entreprise, totalement désemparé : ses quatre enfants et sa femme sont partis rejoindre une « gourelle »."
                            }
                        ]
                    }
