                "senses": [
                    {
                        "sense_id": "f98c54dc-82a9-3083-a7aa-144cd46b4b48",
                        "entry_id": "a5b0053e-500f-3316-bce2-43b5a6bc4d70",
                        "glosses": [
                            "One who renders judgement (e.g. a judge, magistrate, or arbiter); an umpire."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4c752459-582a-4b6f-9f66-f5cdd732361b",
                                "sense_id": "f98c54dc-82a9-3083-a7aa-144cd46b4b48",
                                "text": "The fire shall burn about the Doomsman."
                            },
                            {
                                "example_id": "7c132fa3-1487-4885-bfc6-2383e3724c0c",
                                "sense_id": "f98c54dc-82a9-3083-a7aa-144cd46b4b48",
                                "text": "And the King marveled at the wisdom of the doomsman, and said to him: \"Now I know that all I have heard is truth. […]\""
                            },
                            {
                                "example_id": "90c01fb0-a045-4346-b8d0-ecfcfe89c641",
                                "sense_id": "f98c54dc-82a9-3083-a7aa-144cd46b4b48",
                                "text": "A doomsman might even interrupt the proceedings and point out the law."
                            },
                            {
                                "example_id": "77c7cf48-0b2e-44f7-ada7-97b2e6b28945",
                                "sense_id": "f98c54dc-82a9-3083-a7aa-144cd46b4b48",
                                "text": "Finally, although the hundred did not send doomsmen or suitors to the county court, Macclesfield men attended the sessions and acted as jurors."
                            }
                        ]
                    },
                    {
                        "sense_id": "d270f485-0ea4-38e4-9870-5147dd5a0973",
                        "entry_id": "a5b0053e-500f-3316-bce2-43b5a6bc4d70",
                        "glosses": [
                            "One who carries out a judgement or sentencing; executioner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ac1113bc-4900-42a1-b966-689844e6a477",
                                "sense_id": "d270f485-0ea4-38e4-9870-5147dd5a0973",
                                "text": "At the place of execution, Dorothea begged the doomsman to tarry a little, and kneeling by the block, she raised her hands to heaven and prayed earnestly."
                            }
                        ]
                    }
