                                "target_senses": [
                                    {
                                        "sense_id": "2a1531b8-ecc6-3377-81b5-001ea0ec4a2a",
                                        "entry_id": "e32696ae-1fb0-3f2f-a068-f374017d2d10",
                                        "glosses": [
                                            "A gun which fires loads typically consisting of small metal balls, called shot, from a cartridge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d845c0f6-6d0f-4cab-bff6-6434d808711f",
                                                "sense_id": "2a1531b8-ecc6-3377-81b5-001ea0ec4a2a",
                                                "text": "Meat was cooked up within hours after the hunter killed the deer with his shotgun."
                                            },
                                            {
                                                "example_id": "9f12b87c-1d10-4d97-a001-ecd6be1751a7",
                                                "sense_id": "2a1531b8-ecc6-3377-81b5-001ea0ec4a2a",
                                                "text": "You can't talk to a man / With a shotgun in his hand"
                                            },
                                            {
                                                "example_id": "9c6f0659-384b-4e4e-b6c9-c4a65ca11df4",
                                                "sense_id": "2a1531b8-ecc6-3377-81b5-001ea0ec4a2a",
                                                "text": "An unusual custom is followed at Llangennith, when shotguns are fired at a wedding - to scare off evil spirits from the newlyweds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92e8931-0ba1-3771-8324-dc23d1ca4ccd",
                                        "entry_id": "e32696ae-1fb0-3f2f-a068-f374017d2d10",
                                        "glosses": [
                                            "The front passenger seat in a vehicle, next to the driver; so called because the position of the shotgun-armed guard on a horse-drawn stage-coach, wagon train, or gold transport was next to the driver on a forward-mounted bench seat. Can also be used in situations of claiming other resources such as bedrooms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff5ae16-f796-4e03-a5a7-040e6b02be34",
                                                "sense_id": "a92e8931-0ba1-3771-8324-dc23d1ca4ccd",
                                                "text": "I call shotgun!",
                                                "translation": "I claim the right to sit in the passenger seat.",
                                                "english": "I claim the right to sit in the passenger seat."
                                            },
                                            {
                                                "example_id": "62be4d8e-f465-40a4-b397-0504d3d3c5b7",
                                                "sense_id": "a92e8931-0ba1-3771-8324-dc23d1ca4ccd",
                                                "text": "I call shotgun!",
                                                "translation": "I claim the right to this bedroom etc.",
                                                "english": "I claim the right to this bedroom etc."
                                            },
                                            {
                                                "example_id": "271dda77-68a6-474b-a2eb-9fe59429a7a8",
                                                "sense_id": "a92e8931-0ba1-3771-8324-dc23d1ca4ccd",
                                                "text": "We rode our bikes to it this morning—me, two of my brothers, four other neighborhood kids who were ready to be baptized, plus my father and some other neighborhood adults riding shotgun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61dcf7e-1104-3ef1-b052-d3e58c0b4ad5",
                                        "entry_id": "e32696ae-1fb0-3f2f-a068-f374017d2d10",
                                        "glosses": [
                                            "A one-story dwelling with no hallways or corridors, with the rooms arranged in a straight line."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "US",
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5881e09d-e605-4fb6-adfc-05fdf9060aee",
                                                "sense_id": "a61dcf7e-1104-3ef1-b052-d3e58c0b4ad5",
                                                "text": "Elvis Presley was born in a two-bedroom shotgun in Tupelo, Mississippi."
                                            }
                                        ]
                                    },
                                    {
