                "senses": [
                    {
                        "sense_id": "805fdd91-1cd5-3f20-9e5d-8150a07cbb68",
                        "entry_id": "ea1ded7f-5cab-3dca-a83b-445206933077",
                        "glosses": [
                            "Flugzeug, das in der Lage ist schneller als der Schall zu fliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4a37e4-1b10-4976-ad62-7d28cc1f1318",
                                "sense_id": "805fdd91-1cd5-3f20-9e5d-8150a07cbb68",
                                "text": "„Ein halbes Jahrzehnt nach der Ausmusterung der Concorde gibt es mehrere Vorhaben, wieder ein Überschallflugzeug für die zivile Luftfahrt zu bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0417d1ca-a245-4ef9-bbfe-a621076bf83d",
                        "source_entry_id": "ea1ded7f-5cab-3dca-a83b-445206933077",
                        "source_sense_id": "805fdd91-1cd5-3f20-9e5d-8150a07cbb68",
                        "source_sense_description": "Technik: Flugzeug, das in der Lage ist schneller als der Schall zu fliegen",
                        "target_lang_word": "supersonic aircraft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e6b67681-cae8-417f-89fb-1e62a820565b",
                        "source_entry_id": "ea1ded7f-5cab-3dca-a83b-445206933077",
                        "source_sense_id": "805fdd91-1cd5-3f20-9e5d-8150a07cbb68",
                        "source_sense_description": "Technik: Flugzeug, das in der Lage ist schneller als der Schall zu fliegen",
                        "target_lang_word": "avion supersonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avion supersonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53ffe9b6-e6d7-3ba7-8ee8-eb3cb82c1edf",
                                        "entry_id": "176b9abf-8f83-3978-a62e-38284c6ce89d",
                                        "glosses": [
                                            "Avion capable de dépasser la vitesse du son dans l’air, ou Mach 1."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b672cb8d-d15c-4968-b173-89248de3f6e9",
                                                "sense_id": "53ffe9b6-e6d7-3ba7-8ee8-eb3cb82c1edf",
                                                "text": "La start-up américaine Boom Supersonic ne trouve aucun motoriste pour équiper son projet d’avion supersonique. Il faut dire qu’à l’heure où le transport aérien cherche à réduire son empreinte environnementale, l’appareil fleure bon l’anachronisme."
                                            },
                                            {
                                                "example_id": "aca247c6-9893-489a-9cd6-54b6ab83cb3b",
                                                "sense_id": "53ffe9b6-e6d7-3ba7-8ee8-eb3cb82c1edf",
                                                "text": "Cet avion supersonique permettait de rallier Paris à New York en un peu plus de 3h grâce à sa vitesse de croisière de Mach 2 (2 fois la vitesse du son)."
                                            },
                                            {
                                                "example_id": "512feb33-195e-4a32-8d23-245775c76767",
                                                "sense_id": "53ffe9b6-e6d7-3ba7-8ee8-eb3cb82c1edf",
                                                "text": "Développé par la NASA et Lockheed Martin, le X-59 QueSST (Quiet SuperSonic Technology) est un avion supersonique très spécial : comme son nom l’indique, il a été conçu de manière à briser le mur du son beaucoup plus silencieusement que les autres engins supersoniques existants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
