                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43dd3081-268a-4217-95aa-0055a5d92ee9",
                                "sense_id": "bcf449ab-8307-3545-9493-c2070390eff3",
                                "text": "Я уговори́лся с ней о встре́че.",
                                "translation": "I arranged to meet her.",
                                "english": "I arranged to meet her."
                            },
                            {
                                "example_id": "a258f801-47e9-49f1-ae23-93bea85dd079",
                                "sense_id": "bcf449ab-8307-3545-9493-c2070390eff3",
                                "text": "Они́ уговори́лись встре́титься в рестора́не.",
                                "translation": "They arranged/agreed to meet at the restaurant.",
                                "english": "They arranged/agreed to meet at the restaurant."
                            },
                            {
                                "example_id": "31f9abd7-966f-41c3-a4fd-5d932f0c76c8",
                                "sense_id": "bcf449ab-8307-3545-9493-c2070390eff3",
                                "text": "уговори́ться о цене́",
                                "translation": "to agree about the price",
