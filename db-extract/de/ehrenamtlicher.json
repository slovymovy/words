                "senses": [
                    {
                        "sense_id": "249ceba3-bebe-352c-b74e-b69ad87adff1",
                        "entry_id": "8704b5b6-10d6-3afd-a526-cf0937db9d20",
                        "glosses": [
                            "Person, die unentgeltlich ein Ehrenamt ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e84a3e-4fa9-4c71-929e-0f3407f8a99e",
                                "sense_id": "249ceba3-bebe-352c-b74e-b69ad87adff1",
                                "text": "„Tausende Ehrenamtliche in der ganzen Welt beweisen jeden Tag, dass die Idee des Freien Wissens funktioniert.“"
                            },
                            {
                                "example_id": "51b43337-eeea-43f6-ad77-49e3fa11b548",
                                "sense_id": "249ceba3-bebe-352c-b74e-b69ad87adff1",
                                "text": "[…] „ein schmaler, ausgehungerter Igel [darf] auf keinen Fall auf eigene Faust gefüttert werden. Stattdessen sollte stets die Hilfe von erfahrenen Ehrenamtlichen gesucht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
