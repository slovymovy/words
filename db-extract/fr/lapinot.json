                        "cross_references": [
                            {
                                "target_word": "bunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8eabf448-4882-37c9-bd19-67c8ca66bf71",
                                        "entry_id": "1ffb7454-4120-3e35-8ae1-5dd4d3fe52b1",
                                        "glosses": [
                                            "A rabbit, especially a juvenile one."
                                        ],
                                        "tags": [
                                            "childish",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8abdc9c-2b02-4fb4-b45a-c279c1e37130",
                                                "sense_id": "8eabf448-4882-37c9-bd19-67c8ca66bf71",
                                                "text": "Scary-looking rabbits were hopping around Fort Collins. These weren’t your standard cute, fluffy bunnies; they had horn-like growths protruding from their faces and bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f7181a0-3719-33d1-8c9c-785e8e1fe7e4",
                                        "entry_id": "1ffb7454-4120-3e35-8ae1-5dd4d3fe52b1",
                                        "glosses": [
                                            "A bunny girl: a nightclub waitress who wears a costume having rabbit ears and tail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633add33-9cd8-4990-add9-1e0a1e86ef8d",
                                                "sense_id": "4f7181a0-3719-33d1-8c9c-785e8e1fe7e4",
                                                "text": "‘Gwen has a job as a bunny because says she's sick of sex.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615a5569-b50d-3760-80e6-c5866a42da93",
                                        "entry_id": "1ffb7454-4120-3e35-8ae1-5dd4d3fe52b1",
                                        "glosses": [
                                            "In basketball, an easy shot (i.e., one right next to the bucket) that is missed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6ffa4cb-10e9-32bd-8821-b0003556ce88",
                                        "entry_id": "1ffb7454-4120-3e35-8ae1-5dd4d3fe52b1",
                                        "glosses": [
                                            "A menstrual pad."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15425fd1-17e0-416e-aa10-0a0c1b37fd08",
                                                "sense_id": "f6ffa4cb-10e9-32bd-8821-b0003556ce88",
                                                "text": "A local chemist remembers: My grandmother made home-made sanitary towels from a type of muslin. They were hand-knitted, washed and re-used. Other women used netting and cotton wool. Home-made towels were known as 'bunnies'."
                                            },
                                            {
                                                "example_id": "94d28c05-8b19-4828-84d3-391d0c1b457c",
                                                "sense_id": "f6ffa4cb-10e9-32bd-8821-b0003556ce88",
                                                "text": "Frustratingly for us, it appeared to be much less of a hassle to purchase an expensive fountain pen, than to find, let alone buy, the smallest bottle of deodorant or a packet of Bunnies (as sanitary towels were nicknamed)!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ee3186-e9c1-3dba-b524-3021f6c65461",
                                        "entry_id": "1ffb7454-4120-3e35-8ae1-5dd4d3fe52b1",
                                        "glosses": [
                                            "Synonym of rabbit (“batsman frequently dismissed by the same bowler”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78dc8659-99b7-31c6-8dc5-329f82eaf4cd",
