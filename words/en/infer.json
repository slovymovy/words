{
    "word_family": [
        "inference",
        "inferential",
        "inferable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bac55b11-583c-3aeb-ba43-3de17a3a3611",
                    "sense_definition": "To reach a conclusion based on evidence and reasoning rather than from explicit statements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the data provided, we can <w>infer</w> that the market is likely to recover next year.",
                            "target_lang_translations": {
                                "ru": "Из предоставленных данных мы можем <w>сделать вывод</w>, что рынок, скорее всего, восстановится в следующем году."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>infer</w> meaning from such a vague and confusing message.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>понять</w> смысл такого расплывчатого и запутанного сообщения."
                            }
                        }
                    ],
                    "synonyms": [
                        "conclude",
                        "deduce",
                        "educe",
                        "construe"
                    ],
                    "common_phrases": [
                        "infer meaning",
                        "infer from evidence",
                        "reasonably infer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать вывод на основе имеющихся фактов и рассуждений, а не из прямых утверждений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать вывод",
                                "target_lang_sense_clarification": "прийти к логическому заключению"
                            },
                            {
                                "target_lang_word": "заключить",
                                "target_lang_sense_clarification": "сделать умозаключение на основе данных"
                            },
                            {
                                "target_lang_word": "вывести",
                                "target_lang_sense_clarification": "логически обосновать результат"
                            },
                            {
                                "target_lang_word": "догадаться",
                                "target_lang_sense_clarification": "понять скрытый смысл по признакам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fa560e3-0cb4-3103-ad40-3367ffe2021f",
                    "sense_definition": "To suggest or lead to something as a necessary consequence; to imply.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "implication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presence of these specific symptoms may <w>infer</w> a more serious underlying condition.",
                            "target_lang_translations": {
                                "ru": "Наличие этих специфических симптомов может <w>указывать</w> на более серьезное основное заболевание."
                            }
                        },
                        {
                            "text": "Does this new evidence <w>infer</w> guilt on the part of the defendant?",
                            "target_lang_translations": {
                                "ru": "Означают ли эти новые улики <w>виновность</w> со стороны подсудимого?"
                            }
                        }
                    ],
                    "synonyms": [
                        "imply",
                        "suggest",
                        "entail"
                    ],
                    "common_phrases": [
                        "infer a consequence",
                        "logically infer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать на что-либо как на необходимое следствие; подразумевать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "иметь что-либо своим условием или следствием"
                            },
                            {
                                "target_lang_word": "означать",
                                "target_lang_sense_clarification": "свидетельствовать о чем-либо"
                            },
                            {
                                "target_lang_word": "подразумевать",
                                "target_lang_sense_clarification": "содержать в себе скрытый намек или следствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c949fc6-83d6-34a4-b3ad-bd7e1a5fff5c",
                    "sense_definition": "To bring forward or introduce an argument or subject in a discussion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer began <w>inferring</w> arguments of great importance to support his client's case.",
                            "target_lang_translations": {
                                "ru": "Адвокат начал <w>приводить</w> крайне важные аргументы в поддержку дела своего клиента."
                            }
                        },
                        {
                            "text": "He sought to <w>infer</w> a new topic into the debate to distract the audience.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>внести</w> новую тему в дебаты, чтобы отвлечь аудиторию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infer arguments"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдвигать или вводить аргумент или тему в ходе дискуссии (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "выдвигать аргументы"
                            },
                            {
                                "target_lang_word": "вносить",
                                "target_lang_sense_clarification": "предлагать тему для обсуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bda9149a-f649-31a2-9940-4c04c7d49d5d",
                    "sense_definition": "To cause or inflict something, such as damage or an insult, upon someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "infliction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight feared the many villainies that might be <w>inferred</w> upon his reputation.",
                            "target_lang_translations": {
                                "ru": "Рыцарь опасался множества подлостей, которые могли быть <w>нанесены</w> его репутации."
                            }
                        },
                        {
                            "text": "They were wary of any harm that could be <w>inferred</w> by their enemies.",
                            "target_lang_translations": {
                                "ru": "Они опасались любого вреда, который мог быть <w>причинен</w> их врагами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is obsolete and found only in historical texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять или наносить что-либо (ущерб, оскорбление) кому-либо (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "причинять вред или оскорбление"
                            },
                            {
                                "target_lang_word": "причинять",
                                "target_lang_sense_clarification": "быть причиной ущерба"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}