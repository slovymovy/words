                        "examples": [
                            {
                                "example_id": "11a15044-9fd3-4b1c-a65a-237d930eac94",
                                "sense_id": "c27be4c7-8daa-3ef5-b0af-bd906695ec74",
                                "text": "Родился Измаил; не песнью нежной // Он усыплён был в сумраке ночном: // Его баюкал бури вой мятежный!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c1b948f-bf08-4d4f-bae4-48f8b46f1b92",
                        "source_entry_id": "b0aa1b72-9b6b-3486-9517-489b30910a29",
                        "source_sense_id": "c27be4c7-8daa-3ef5-b0af-bd906695ec74",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Ishmael",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ishmael",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2524a43b-1f6d-3770-ae5c-fd6209fc38c9",
                                        "entry_id": "5fa651d5-dd98-3c44-9332-a9795ddf5a0a",
                                        "glosses": [
                                            "The eldest son of Abraham and his wife's handmaiden Hagar who were cast out after the birth of Isaac; traditionally the ancestor of the Arabs via the Ishmaelites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6963d6-35f0-4391-a0c3-5595c86ed5de",
                                                "sense_id": "2524a43b-1f6d-3770-ae5c-fd6209fc38c9",
                                                "text": "And Hagar bare Abram a ſonne: and Abram called his ſonnes name, which Hagar bare, Iſhmael."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed0dd4a-81ca-37b0-9d72-2f384a6ae4d4",
                                        "entry_id": "5fa651d5-dd98-3c44-9332-a9795ddf5a0a",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53b1c1b-2461-493f-867b-69e4a0842c7f",
                                                "sense_id": "9ed0dd4a-81ca-37b0-9d72-2f384a6ae4d4",
                                                "text": "Call me Ishmael."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ishmael",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba7bb91-d6d1-398d-85eb-891ef93bf6e6",
                                        "entry_id": "6b57cda7-3c5b-3982-8430-81cf727b90ae",
                                        "glosses": [
                                            "An outcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b76e80d7-6ca1-4199-9c66-f48b2816a4de",
                                                "sense_id": "0ba7bb91-d6d1-398d-85eb-891ef93bf6e6",
                                                "text": "His new friend was evidently a young Ishmael — his hand against every man and every man's hand against him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
