                "senses": [
                    {
                        "sense_id": "ed7afa9e-fda7-3bdc-a0bc-5f75add05353",
                        "entry_id": "baafecf8-94b5-3bfb-887c-08ba971df7d1",
                        "glosses": [
                            "zähe, farbige oder farblose Flüssigkeit, die man sich aus kosmetischen Gründen auf die Finger- oder Zehennägel aufträgt und die dann fest wird"
                        ],
                        "tags": [
                            "Kosmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "a6e89a6e-e147-4f5d-b4bf-1413ae4a26f9",
                                "sense_id": "ed7afa9e-fda7-3bdc-a0bc-5f75add05353",
                                "text": "Ältere Nagellacke mit zäherer Flüssigkeit können mit sogenannten „Nagellackverdünnern“ wieder verwendbar gemacht werden."
                            },
                            {
                                "example_id": "b3894661-aeab-41ca-bd6b-e8b29753d801",
                                "sense_id": "ed7afa9e-fda7-3bdc-a0bc-5f75add05353",
                                "text": "„Und weil neue Lacke wirklich sehr begehrenswert sind, lassen sich Damen vermehrt Nagellacke von weltreisenden Bekannten mitbringen, um in der Heimat wirklich die Erste zu sein. die diese ausführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a260f26-1545-34a0-8dbd-f338351d9a44",
                        "entry_id": "baafecf8-94b5-3bfb-887c-08ba971df7d1",
                        "glosses": [
                            "zähe Flüssigkeit, die man auf die Finger- oder Zehennägel aufträgt und die einen pharmazeutischen Wirkstoff enthält, um beispielsweise Nagelpilz zu behandeln oder den Benutzer vom Nägelkauen abzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ce662f-8898-4bb9-aced-d53ae1dacc29",
                                "sense_id": "8a260f26-1545-34a0-8dbd-f338351d9a44",
                                "text": "Um den hartnäckigen Nagelpilz los zu werden, muss der Patient alle zwei Tage den verschriebenen Nagellack auftragen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
