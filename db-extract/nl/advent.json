                                    {
                                        "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                        "entry_id": "3091f4a4-531d-3619-8d94-9d8b2e525741",
                                        "glosses": [
                                            "der Zeitraum von zirka vier Wochen vom 1. Advent bis Weihnachten, durch den das Kirchenjahr mit der Vorbereitung auf Weihnachten beginnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9bdb8f-5805-4113-80cb-d80f0d35fdd0",
                                                "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                                "text": "Der erste Advent ist am Sonntag zwischen dem 27. November und dem 3. Dezember."
                                            },
                                            {
                                                "example_id": "bd2f0534-a81d-45e7-892a-e7610f39d3fd",
                                                "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                                "text": "„Drei Tage vor dem ersten Advent ging der Direktor nach Schulschluss durchs Viertel, um im Auftrag seiner Frau einen Adventskranz zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a184bc33-c211-41fb-b67c-e06b891495c8",
                        "source_entry_id": "eef09bcf-3e52-3cec-bf24-363eeb5329b0",
                        "source_sense_id": "883f4195-7507-35c8-8cf8-034de527be8e",
                        "source_sense_description": "een periode van vier weken voor Kerstmis\n 2. de tijd waarin de komst en wederkomst van Jezus Christus worden verwacht",
                        "target_lang_word": "advent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19a91c53-a492-36f0-a611-b3faffdd7d51",
                                        "entry_id": "663203a0-589d-35ee-bfcf-ace960d9939b",
                                        "glosses": [
                                            "Arrival; onset; a time when something first comes or appears; the time when it is approaching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5258e6b-97a0-4ac2-928e-311ef226584e",
                                                "sense_id": "19a91c53-a492-36f0-a611-b3faffdd7d51",
                                                "text": "Death's dreadful advent"
                                            },
                                            {
                                                "example_id": "ca2fee9a-8b61-407c-b7c3-20f5a9dacd2f",
                                                "sense_id": "19a91c53-a492-36f0-a611-b3faffdd7d51",
                                                "text": "At the period just preceding the advent of Bartleby, I had two persons as copyists in my employment, and a promising lad as an office-boy."
                                            },
                                            {
                                                "example_id": "442621e8-40b9-4b75-91a5-69e5fefad3aa",
                                                "sense_id": "19a91c53-a492-36f0-a611-b3faffdd7d51",
                                                "text": "The car in which I had taken Olivia to dinner and then out to the cemetery — a historic vehicle, even a monument of sorts, in the history of fellatio's advent onto the Winesburg campus in the second half of the twentieth century — went careening off to the side..."
                                            },
                                            {
                                                "example_id": "52542291-8ec1-4bd4-a3d3-79081e14b0cf",
                                                "sense_id": "19a91c53-a492-36f0-a611-b3faffdd7d51",
                                                "text": "Berlin's six-decade career began before the advent of radio and ended during the height of Beatlemania."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74c75126-efa5-3ce6-a49a-a4faa846f4b9",
                                        "entry_id": "4b46486e-47ea-30bd-a1a9-c07d94dadaaa",
                                        "glosses": [
                                            "To arrive or begin, especially at the first coming or appearance of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df55cd4b-df93-4725-8ce7-b7c2863e129b",
                                                "sense_id": "74c75126-efa5-3ce6-a49a-a4faa846f4b9",
                                                "text": "1869 Grove Berry. Ritualism; Part II of An Enquiry. Pub: LONGMANS, GREEN et al.\nBut suppose we depart from the suggestion there made, and, leaving the idea of the status quo from which He advented to Earth, we rise with Solomon (Prov. viii), to some stasis which must be indefinite to us, are we not presumptuous if not even unpractical, Gnostical, and merely scholastic?"
                                            },
                                            {
                                                "example_id": "83b9558d-118f-400f-9706-1bdc7143f8b4",
                                                "sense_id": "74c75126-efa5-3ce6-a49a-a4faa846f4b9",
                                                "text": "The new Democratic war-horse from Calaveras has lately advented in the Legislature with a little bill to change the name of Tretherick to Starbottle."
                                            },
                                            {
                                                "example_id": "f7d9ede9-3c03-4413-9ed3-324fcc07bf12",
                                                "sense_id": "74c75126-efa5-3ce6-a49a-a4faa846f4b9",
                                                "text": "1978 Mohammed Ahmad Qureshi. Marriage and Matrimonial Remedies: A Uniform Civil Code for India\nMaulana Abdul Kalam Azad in Tarjuman-ul-Quran says that in the seventh century when Islam was advented males had uncontrolled rights."
                                            },
                                            {
                                                "example_id": "7f669ce2-f3b6-4d77-b122-cf192e13c1e0",
                                                "sense_id": "74c75126-efa5-3ce6-a49a-a4faa846f4b9",
                                                "text": "2014 Adam Pryor. The god who lives.\nIn the flesh, self and world are always coming-to-be, adventing, in an intimate reciprocity to one another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f559d7-d957-4ab6-941e-74d2be678aa3",
                        "source_entry_id": "eef09bcf-3e52-3cec-bf24-363eeb5329b0",
                        "source_sense_id": "883f4195-7507-35c8-8cf8-034de527be8e",
