                        "examples": [
                            {
                                "example_id": "fbf943dc-22bf-4020-a178-270322933d7d",
                                "sense_id": "43ece08b-d7be-39f5-801b-cf9495eea4d6",
                                "text": "Un catigot d’anguilles."
                            },
                            {
                                "example_id": "41098eba-85eb-49e2-9d4f-c902a40c0ea7",
                                "sense_id": "43ece08b-d7be-39f5-801b-cf9495eea4d6",
                                "text": "Je me demande si je n’ai pas fini, trente-cinq ans après, par connaître un genre de catigot avec ce « civet d’anguille » qui me fut servi à Plaisance, à 200 mètres du Pô, avec un rouge gutturgo dont l’âpreté s’arrangeait si bien du gras de ce mets et qui me permit de supporter les moustiques et la scie de l’autoroute.— (François Sentein, Minutes d’un libertin (1938-1941), Éditions Gallimard, collection Le promeneur, note du bas de la page 47.)"
                            }
                        ]
                    }
