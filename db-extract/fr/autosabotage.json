                "senses": [
                    {
                        "sense_id": "140ce848-94d3-3933-a3ff-41103eb56d22",
                        "entry_id": "e297598e-6e57-39f8-8f5a-3a69d3a24c98",
                        "glosses": [
                            "Personne agissant, consciemment ou non, contre son intérêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "badb5663-d7b5-4f31-bd32-52f5bf6adbae",
                                "sense_id": "140ce848-94d3-3933-a3ff-41103eb56d22",
                                "text": "Qu’est-ce que l’auto-sabotage ? Quelles sont ses caractéristiques ? Quelle est la racine de ces comportements que nous adoptons de façon inconsciente et qui viennent interférer dans la réussite de nos objectifs ? Et comment cesser le cercle vicieux ne plus être dans l’échec ?."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db1b5eb-eb49-4191-85db-409725ea9456",
                        "source_entry_id": "e297598e-6e57-39f8-8f5a-3a69d3a24c98",
                        "source_sense_id": "140ce848-94d3-3933-a3ff-41103eb56d22",
                        "target_lang_word": "self-sabotage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-sabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b908eee2-d0fb-3079-9555-09e47c5acfc9",
                                        "entry_id": "ef090a44-07f8-3d4d-9ba4-068dc3fbc134",
                                        "glosses": [
                                            "The sabotaging, whether consciously or subconsciously, of oneself, one's own interests, plans etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3993fd7b-1fdb-48f4-8d2f-e8666a8c2ccb",
                                                "sense_id": "b908eee2-d0fb-3079-9555-09e47c5acfc9",
                                                "text": "“The modern addiction to fossil fuels is not just an act of environmental vandalism. From the health perspective, it is an act of self-sabotage,” said the WHO president, Dr Tedros Adhanom Ghebreyesus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "self-sabotage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d01dcab-4b5f-3c0d-9351-f29e9820b972",
                                        "entry_id": "8a8843dd-4f5e-332b-836a-dfb2f3026f9b",
                                        "glosses": [
                                            "To sabotage oneself or one's own plans."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8aff98e-e04e-4750-be3d-129f22ed3462",
                                                "sense_id": "2d01dcab-4b5f-3c0d-9351-f29e9820b972",
                                                "text": "Before we even get started trying to explain this complicated concept of why we self-sabotage our own success, please understand that I am at best an “armchair doctor”."
                                            },
                                            {
                                                "example_id": "40dafecc-4346-4c0a-93aa-374dca9184e2",
                                                "sense_id": "2d01dcab-4b5f-3c0d-9351-f29e9820b972",
                                                "text": "If your Inner Child doesn't feel safe, worthy, it works within to self-sabotage you before you are even conscious of the pattern"
                                            },
                                            {
                                                "example_id": "e9f7b84f-396c-476d-b93e-efcd544bde6c",
                                                "sense_id": "2d01dcab-4b5f-3c0d-9351-f29e9820b972",
                                                "text": "“So many of us are shaming ourselves or hating on ourselves, and then that shame and hate makes us want to numb out, and then we go self-sabotage and engage in something that is maybe indulging in some way,” Johnson said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
