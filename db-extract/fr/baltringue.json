                                "sense_id": "f5d53e64-d95a-368d-8194-0426ad1e5445",
                                "text": "Didier, c’est un baltringue, il comprend rien à l’informatique.",
                                "translation": "Didier is een sufklep, hij begrijpt niks van informatica."
                            }
                        ]
                    },
                    {
                        "sense_id": "41215f98-7469-3ddb-9197-8bc179cd975a",
                        "entry_id": "d35cc51e-a3ae-348b-a432-71c730e69d5a",
                        "glosses": [
                            "schijtlijster, bangerik"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "efb40175-d174-400c-8ed5-9c5c58cc1db0",
                                "sense_id": "41215f98-7469-3ddb-9197-8bc179cd975a",
                                "text": "Mathieu, ce baltringue, il sort plus de chez lui.",
                                "translation": "Mathieu, die schijtlijster, gaat zijn huis niet meer uit."
