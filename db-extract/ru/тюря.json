                ],
                "senses": [
                    {
                        "sense_id": "fdd7acad-e4dd-396c-a5d0-8998dae8d723",
                        "entry_id": "ab181abc-85f5-30e5-a828-b543cd393d55",
                        "glosses": [
                            "простое кушанье из хлеба, накрошенного в квас, молоко или воду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534a9a36-2469-4da3-ba2d-17547fe70bd7",
                                "sense_id": "fdd7acad-e4dd-396c-a5d0-8998dae8d723",
                                "text": "Я ему квасу с маслом и с луком смешал, хлебца подсыпал. Ну, говорю: тюри покушай, авось будет лучше!"
                            },
                            {
                                "example_id": "d5c21562-1a79-46ad-b253-496dc9796f14",
                                "sense_id": "fdd7acad-e4dd-396c-a5d0-8998dae8d723",
                                "text": "И дети без молока целый год жили: один кисель и тюрю ели и стали худые и бледные."
                            },
                            {
                                "example_id": "92747f10-3563-4718-a0b3-b9f0d999ba6e",
                                "sense_id": "fdd7acad-e4dd-396c-a5d0-8998dae8d723",
                                "text": "Она держала в руке миску с тюрей из кислого молока, куда накрошила чурек и ломтики свежего огурца."
                            }
                        ]
                    },
                    {
                        "sense_id": "468b2524-7bf7-3433-90c7-6fe022a3a130",
                        "entry_id": "ab181abc-85f5-30e5-a828-b543cd393d55",
                        "glosses": [
                            "перен., разг. месиво"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd74bda-e140-453c-8160-e2f8f613c482",
                                "sense_id": "468b2524-7bf7-3433-90c7-6fe022a3a130",
                                "text": "Путь туда лежал разварной мглой. Фуркасовским и Кузнецким, тонувшими в ледяной тюре."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e2cf9de-b072-31e9-b357-01de35f27598",
                        "entry_id": "ab181abc-85f5-30e5-a828-b543cd393d55",
                        "glosses": [
                            "перен., разг., : нерасторопный, вялый человек, рохля"
                        ],
                        "tags": [
                            "общего рода"
                        ],
                        "examples": [
                            {
                                "example_id": "39b16216-584b-4d77-8188-9c8d84c3fb60",
                                "sense_id": "2e2cf9de-b072-31e9-b357-01de35f27598",
                                "text": "При разговорах с Иконниковым он раздражался, бывал груб, насмешлив, обзывал его тюрей, размазней, киселём, шляпой."
                            }
                        ]
                    }
