                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a433e0-272c-4657-a980-9d497bf16c23",
                                "sense_id": "eccb184f-42e8-3adc-a6b9-766b09499e92",
                                "text": "Pour ce qui du choix du lieu... là je vous laisse parisienner entre vous... (lieux corrigé en lieu)"
