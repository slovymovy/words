                ],
                "senses": [
                    {
                        "sense_id": "cfe06b6f-0104-3be5-80bd-c3bbce2d7dc1",
                        "entry_id": "7142232b-c203-3a4d-a215-1823990d4f27",
                        "glosses": [
                            "французская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14abe56d-d75c-4440-8a5a-2d89f608837c",
                                "sense_id": "cfe06b6f-0104-3be5-80bd-c3bbce2d7dc1",
                                "text": "Сей лес напоминает печальную смерть мрачного романиста Прево."
                            },
                            {
                                "example_id": "bc20d629-3565-4e33-a852-83e4b1befa56",
                                "sense_id": "cfe06b6f-0104-3be5-80bd-c3bbce2d7dc1",
                                "text": "Ей г-жа Прево насплетничала и не на шутку напугала."
                            },
                            {
                                "example_id": "4c20e062-cd91-409a-a903-1bd8be1f0ffa",
                                "sense_id": "cfe06b6f-0104-3be5-80bd-c3bbce2d7dc1",
                                "text": "В девятом номере жил Домье, а в номере тринадцатом — скульптор Шомье, художники Добиньи и Альфред Жерант, гравёр Прево."
                            }
                        ]
                    }
                ],
