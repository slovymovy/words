        "fr-extract.jsonl": [
            {
                "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                "word": "anomalie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd92380b-486c-4d2a-8083-a3f9053547b1",
                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                        "tags": [
                            "plural"
                        ],
                        "form": "anomalies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                        "glosses": [
                            "État de ce qui est anormal ou anomal."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "8561602d-8225-4075-a550-e242916bdbc1",
                                "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                                "text": "Parmi les peintres et graveurs avec qui il travaille, Wiener me voit comme une anomalie artistique, un des rares lithographes à s’intéresser d’aussi près et avec autant de curiosité au rendu des couleurs."
                            },
                            {
                                "example_id": "b8e30d46-b7e1-4d0c-9768-d4d075df79ed",
                                "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                                "text": "M. Lemot a dépensé des sommes énormes pour faire du pittoresque, et il n’a réussi qu’à faire de l’anomalie : elle était plus sensible encore par la présence du drapeau tricolore sur cette ruine du onzième siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "3da92170-887f-3716-b709-1dd8afb5d501",
                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                        "glosses": [
                            "Irrégularité des mouvements planétaires."
                        ],
                        "tags": [
                            "Mécanique céleste"
                        ],
                        "examples": [
                            {
                                "example_id": "4efac22e-f633-4dce-976c-c8a9aefa8e00",
                                "sense_id": "3da92170-887f-3716-b709-1dd8afb5d501",
                                "text": "S’il y a une différence appréciable, ce sera donc pour Mercure qu’elle sera la plus grande, Mercure ayant de toutes les planètes la plus grande vitesse. Or il arrive justement que Mercure présente une anomalie non encore expliquée : le mouvement de son périhélie est plus rapide que le mouvement calculé par la théorie classique. Sa vitesse angulaire est de 38\" plus grande qu’elle ne devrait être. Le Verrier attribua cette anomalie à une planète non encore découverte et un astronome amateur crut observer son passage sur le Soleil."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc05a53-5aff-39b1-92c7-ab3d39b6277a",
                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                        "glosses": [
                            "Angle qui mesure cette irrégularité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dc2648e-5fbb-4358-8545-cb448115d34f",
                        "source_entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                        "target_lang_word": "anomaly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anomaly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "A deviation from a rule or from what is regarded as normal; an outlier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254a5a76-482c-4d25-9fc2-2d04237d6980",
                                                "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                                "text": "This ardent exploration, absorbing all his energy and interest, made him forget for the moment the mystery of his heritage and the anomaly that cut him off from all his fellows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Something or someone that is strange or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38663990-7354-457a-928b-140cc5607e51",
                                                "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                                "text": "He is an anomaly among his friends in that he's the only one who's unmarried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Any event or measurement that is out of the ordinary regardless of whether it is exceptional or not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abaa15b5-cfa5-4054-90b7-cb84db2f1fcc",
                                                "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                                "text": "She disregarded some of the anomalies in the experiment, putting them down to miscalculation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed8484c-2c09-36d2-954c-ae2ffa4624a1",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
