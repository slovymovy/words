                "senses": [
                    {
                        "sense_id": "5d45f251-6fcd-3ba4-bc00-c1636f02b248",
                        "entry_id": "84154ce3-5684-38c7-b91f-f6f819674529",
                        "glosses": [
                            "Gebäude in einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d12acaa-dc84-466e-81cb-0e333fbf9833",
                                "sense_id": "5d45f251-6fcd-3ba4-bc00-c1636f02b248",
                                "text": "Sie mussten einen Kredit aufnehmen, um sich das Stadthaus kaufen zu können."
                            },
                            {
                                "example_id": "81e5b9e9-427e-4f51-b25e-9ccb5ae8d868",
                                "sense_id": "5d45f251-6fcd-3ba4-bc00-c1636f02b248",
                                "text": "„Signor Di Marco hält eine Euromünze hoch. Mehr musste er nicht für sein Stadthaus im sizilianischen Gangi bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69e82088-3a91-3d3a-a7fe-29954eddf278",
                        "entry_id": "84154ce3-5684-38c7-b91f-f6f819674529",
                        "glosses": [
                            "Gebäude, in dem städtische Verwaltungsbehörden untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81af660-7319-46da-8b9e-ab684d44b827",
                                "sense_id": "69e82088-3a91-3d3a-a7fe-29954eddf278",
                                "text": "Das Stadthaus in Bonn ist seit 1978 der Sitz der städtischen Verwaltung."
                            },
                            {
                                "example_id": "fd34fd83-6517-4a27-9d81-0d76081f1b39",
                                "sense_id": "69e82088-3a91-3d3a-a7fe-29954eddf278",
                                "text": "„Und er ließ sich in in kleines Restaurant gegenüber dem Stadthaus führen, wo man gut aufgehoben sei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
