                "senses": [
                    {
                        "sense_id": "ae83da81-429c-3194-bd3a-316f792d0af1",
                        "entry_id": "2a4b31b6-da7f-3e89-9b21-ac4468866dd0",
                        "glosses": [
                            "Vorrichtung (zum Beispiel bei einem Verbrennungsmotor oder Computer), mit der Wärme mithilfe von Wasser abgeführt wird; Vorgang dieser Kühlung"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "d9f0581f-eb80-4ce9-957d-acd496541eca",
                                "sense_id": "ae83da81-429c-3194-bd3a-316f792d0af1",
                                "text": "„Alternativ gibt es kleinere CPU-Lüfter oder Sie verwenden eine Wasserkühlung, die weniger Raum benötigt.“"
                            },
                            {
                                "example_id": "a3784a1a-df81-4351-874c-7735ccc50b68",
                                "sense_id": "ae83da81-429c-3194-bd3a-316f792d0af1",
                                "text": "„Wasserkühlungen etwa sind teuer und erfordern aufwendige Leitungssysteme, die sich flüssigkeitsgefüllt durch den PC schlängeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
