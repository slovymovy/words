                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7602a51e-6789-4327-a691-6a261ae51797",
                                                "sense_id": "3d34e090-7b29-3845-ba08-cf1bf45fe222",
                                                "text": "τὠληθές, Ιων. κράση αντί τὸ ἀληθές."
                                            },
                                            {
                                                "example_id": "a05c2e89-d23a-4864-bf56-0669f5a60c10",
                                                "sense_id": "3d34e090-7b29-3845-ba08-cf1bf45fe222",
                                                "text": "τὠπό, τὠποβαῖνον, Ιων. κράση αντί τὸ ἀπό, τὸ ἀποβαῖνον."
                                            },
                                            {
                                                "example_id": "82a609ee-2fc3-442f-a1de-9522666b7970",
                                                "sense_id": "3d34e090-7b29-3845-ba08-cf1bf45fe222",
                                                "text": "τὠργείου, Δωρ. κράση αντί Ἀργείου."
                                            },
                                            {
                                                "example_id": "b9cd31b1-9d85-4660-82d0-d54dc878a9cd",
                                                "sense_id": "3d34e090-7b29-3845-ba08-cf1bf45fe222",
                                                "text": "τὠρχαῖον, Ιων. κράση αντί τὸ ἀρχαῖον."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91264976-ab4e-3db6-a1ac-262fb94eb828",
