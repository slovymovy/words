                            {
                                "example_id": "e82dea83-c32e-486e-937a-514b00ce7046",
                                "sense_id": "40c38391-03bf-36f2-9b97-51cfb3839f06",
                                "text": "De kaartverkoop in de op een na grootste filmmarkt ter wereld was goed voor 295 miljoen euro aan recette. In de Verenigde Staten bracht het sluitstuk van de films over het superheldenteam zo'n 315 miljoen euro op, wat een record op zich is."
                            },
                            {
                                "example_id": "0ab5c93c-dc11-44aa-9237-b86d13b2eed6",
                                "sense_id": "40c38391-03bf-36f2-9b97-51cfb3839f06",
                                "text": "Star Wars: The Force Awakens draait sinds woensdag wereldwijd in de bioscopen. In totaal heeft de film nu ruim 575 miljoen euro opgebracht. Omdat hij pas vanaf 9 januari in China zal worden getoond, zal dat bedrag nog flink oplopen. China is na de VS de grootste filmmarkt ter wereld."
                            }
                        ]
