                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hautes collines verdoyantes <w>environnent</w> la petite ville tout au long de l'année."
                        },
                        {
                            "text": "Le vieux château était <w>environné</w> d'épaisses forêts difficiles d'accès."
                        }
                    ],
                    "synonyms": [
