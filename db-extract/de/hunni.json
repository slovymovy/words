                                "target_senses": [
                                    {
                                        "sense_id": "356df3d4-2c7d-3dc3-b74a-d8212259048d",
                                        "entry_id": "0f8e8ddc-4cb9-3449-b495-0b117660150c",
                                        "glosses": [
                                            "A diminutive of the male given name Benjamin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e45786d9-fac9-4d11-ad7d-ed77f9c3dae1",
                                                "sense_id": "356df3d4-2c7d-3dc3-b74a-d8212259048d",
                                                "text": "His full name is Benji Duncan Geoffrey Rigby-Monk. 'You're joking,' Kit said, when I first told him. 'Benji? Not even Benjamin?' Duncan and Geoffrey are his two granddads'names ― both unglamorous and old-dufferish, in Kit's view, and not worth inflicting on a new generation ― and Rigby-Monk is a fusion of Fran's surname and Anton's. 'As far as I'm concerned, he's Benjamin Rigby,' said Kit, after the first time we met him. 'He seems like a decent baby and he deserves a decent name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
