                                        "entry_id": "d873c19f-22ba-3ce2-bc88-da6c123802f4",
                                        "glosses": [
                                            "van een vloeistof dat ze hoewel kouder dan het smeltpunt toch nog vloeibaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66f5cd5c-d86e-4c4e-a761-3df08047a7d5",
                                                "sense_id": "1f8e0c50-3757-3b3b-b23f-62e99f622ddf",
                                                "text": "Toen de onderkoelde regen op het wegdek kwam ontstond er direct een dikke ijslaag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65fecbfd-b431-3f99-8524-7d79f7c0297a",
                                        "entry_id": "d873c19f-22ba-3ce2-bc88-da6c123802f4",
                                        "glosses": [
                                            "van iets of een persoon dat het te koud is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5222161-e6b7-4249-b125-31002e9f920c",
                                                "sense_id": "65fecbfd-b431-3f99-8524-7d79f7c0297a",
                                                "text": "De onderkoelde slachtoffers kregen direct een isolerende deken om zich heen."
                                            },
                                            {
                                                "example_id": "abc10600-217f-46e6-ace3-2adb6fd0472c",
                                                "sense_id": "65fecbfd-b431-3f99-8524-7d79f7c0297a",
                                                "text": "Oververhitting, onderkoeling, blikseminslag, poema’s en het oversteken van rivieren vormen een veel reëler gevaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
