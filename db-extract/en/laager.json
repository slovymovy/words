                "senses": [
                    {
                        "sense_id": "5706f01f-ea61-3e18-948b-ff17d2832461",
                        "entry_id": "b93ae2cf-3ec5-34f0-9162-ab6acd5d7a2c",
                        "glosses": [
                            "To arrange in a circular formation for defence."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f8232321-28d6-427d-945d-d394de92dd68",
                                "sense_id": "5706f01f-ea61-3e18-948b-ff17d2832461",
                                "text": "At the foot of this isolated mount, whereof the aspect somehow filled me with alarm, we camped on the night of January 21, taking no precautions against attack by way of laagering the wagons."
                            }
                        ]
                    },
                    {
                        "sense_id": "8311c50d-7d9f-32ee-9d87-23fed416aab9",
                        "entry_id": "b93ae2cf-3ec5-34f0-9162-ab6acd5d7a2c",
                        "glosses": [
                            "To camp in a circular formation."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa593ba7-f0ff-41cc-a7f4-3b38fb57be85",
                                "sense_id": "8311c50d-7d9f-32ee-9d87-23fed416aab9",
                                "text": "That evening, we laagered close to a large open area covered with elephant grass about six feet high."
                            }
                        ]
                    }
