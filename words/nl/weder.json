                            "comment": "Formeel of verouderd synoniem voor weer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Again, for a second or subsequent time; archaic or formal synonym for 'weer'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "once more"
                            },
                            {
                                "target_lang_word": "anew",
                                "target_lang_sense_clarification": "in a new or different way"
                            }
