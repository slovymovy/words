                                "target_senses": [
                                    {
                                        "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                        "entry_id": "8a96186a-4d7c-3206-bd12-d6f393fea43c",
                                        "glosses": [
                                            "Personne qui quitte volontairement ou non son lieu de vie original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06586091-4a9a-4d79-aeda-af541d38141c",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "Il a été un exilé, comme moi, puisqu’il a choisi l’exil à Crotone, pour fuir les abus du tyran Polycrate."
                                            },
                                            {
                                                "example_id": "7601e372-dcf8-4ead-afda-6f530a16b6b4",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "Nous vivons en exilés sans point de départ ni d’arrivée, avec pour seul appui cette ligne de diamants tendue au-dessus du vide, la route, que nous parcourons en acrobate."
                                            },
                                            {
                                                "example_id": "12965286-a3a6-4e70-9db9-a368bd963bf1",
                                                "sense_id": "a916f016-ba93-37c0-a031-10012ce87892",
                                                "text": "On rappela les exilés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5c2b2b-1092-310c-bd9f-ae2125c257e3",
                                        "entry_id": "7ccd34d8-a0cc-306b-bc94-181510933244",
                                        "glosses": [
                                            "Qui vit en exil, loin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "741781ea-4d4d-3636-946a-c8621f881aa7",
                                        "entry_id": "412f197c-f6ac-3231-bf28-c1dee594664d",
                                        "glosses": [
                                            "Participe passé masculin singulier de exiler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb89ad22-27d6-47fe-8a42-9d275e1dbf64",
                                                "sense_id": "741781ea-4d4d-3636-946a-c8621f881aa7",
                                                "text": "Désormais, la nature est dédivinisée et l’homme en est exilé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cccde300-d7ee-47a5-a5ec-4883fc438c9c",
                        "source_entry_id": "3b676b70-c604-3d80-907d-38045aa1da80",
                        "source_sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                        "source_sense_description": "Person, die gezwungen ist, sich außerhalb ihrer Heimat aufzuhalten",
                        "target_lang_word": "apatride",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apatride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                        "entry_id": "87d49bbb-f8e3-3953-aa56-cdd587be21b2",
                                        "glosses": [
                                            "Qui est sans patrie, sans nationalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55611131-f747-4988-b087-f507c4c75643",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "Tandis que le socialisme s’acharnait à secouer la tutelle d’un pouvoir économique apatride, une classe moyenne qui aspirait à se pavaner en classe dirigeante, décida de s’emparer du pouvoir culturel."
                                            },
                                            {
                                                "example_id": "3d71b7c6-0830-4e83-bc6b-fb4f748bc4f1",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "– Il n’est plus « apatride », mais désormais « d’origine indéterminée ».\n– Je vois. Être apatride, c’est être quelque chose. Être indéterminé, c‘est louche."
                                            },
                                            {
                                                "example_id": "1fd8b426-bff6-4520-b4cb-d209d38567ac",
                                                "sense_id": "47ffb9cf-64ff-35e8-935a-0721aff65217",
                                                "text": "Les 279 000 habitants qui vivent alors dans l’enclave deviennent apatrides, mais peuvent se rendre en Égypte, qui administre la région sans l’annexer, pour travailler et étudier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apatride",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                        "entry_id": "00e00c2e-3830-3b97-9610-a6347ade9c89",
                                        "glosses": [
                                            "Personne qui ne sent d’appartenance à aucune patrie ni nationalité ou qui en a été privée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73864ed-5de3-4921-a0d3-34642bdeb5d9",
                                                "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                                "text": "À cause de ce malentendu, son histoire personnelle changea: Wiesel resta en France de 1945 jusqu’en 1956, mais comme un apatride."
                                            },
                                            {
                                                "example_id": "bbbd4719-a8da-49a8-86f8-b474ca3d4f8d",
                                                "sense_id": "ffd9e923-b197-3169-99fa-618a3232494b",
                                                "text": "Apatride, il ne veut pas prendre la nationalité française. Pas question de faire son service militaire, il garde son passeport Nansen délivré par l’ONU aux réfugiés sans patrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
