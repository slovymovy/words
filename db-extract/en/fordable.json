                                        "sense_id": "3e4b64ed-01ad-3a7e-8b6b-3741ff5035c8",
                                        "entry_id": "a4f5f4cf-c52a-37b9-ab91-bc4ff109d0bb",
                                        "glosses": [
                                            "geschikt om doorheen te lopen"
                                        ],
                                        "tags": [
                                            "van een water"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e312114f-8fb8-4b7c-8ce6-40eff2e2d77b",
                                                "sense_id": "3e4b64ed-01ad-3a7e-8b6b-3741ff5035c8",
                                                "text": "Bij Tumen wordt aan Chinese zijde de grens nauwelijks bewaakt. De gelijknamige rivier is hier niet breder dan de Nederlandse Vecht en op sommige stukken zelfs doorwaadbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45087070-5f11-4ace-b5dc-30e8537120d3",
                        "source_entry_id": "bb411ac2-5ba3-364c-8c89-464d7f011889",
