                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen sailed the old <w>Norwegian</w> across the calm waters of the lake.",
                            "target_lang_translations": {
