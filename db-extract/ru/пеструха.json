                "senses": [
                    {
                        "sense_id": "c5bcdf76-a32d-3a30-9df3-d4265a6c0cd8",
                        "entry_id": "7f8be96d-5e38-3259-8dcf-26fca5cf5f94",
                        "glosses": [
                            "разг. кличка самки животного с пёстрой окраской (коровы, курицы и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a89bb9-38e0-40c8-bab6-5a766c84a5e1",
                                "sense_id": "c5bcdf76-a32d-3a30-9df3-d4265a6c0cd8",
                                "text": "Стоит Пеструха на зелёном лугу, траву жуёт-пережёвывает."
                            },
                            {
                                "example_id": "3882a4cf-f205-4cb5-a8af-fd055165b13a",
                                "sense_id": "c5bcdf76-a32d-3a30-9df3-d4265a6c0cd8",
                                "text": "Всё туманно, все так грустно сердцу и уму. «Му!» // Наклонись же ближе к уху, // Утешай меня, Пеструха, // Очень трудно без участья сердцу моему"
                            }
                        ]
                    }
