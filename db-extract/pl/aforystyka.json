                                    {
                                        "sense_id": "b02c9f38-2e6a-3f8b-a5de-9bb4bd01c7cb",
                                        "entry_id": "75228210-3226-367c-9603-7dd1518a47cd",
                                        "glosses": [
                                            "Kunst, Aphorismen zu formulieren oder zu schreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74dbc10-0012-4235-89ff-19c168f8449b",
                                                "sense_id": "b02c9f38-2e6a-3f8b-a5de-9bb4bd01c7cb",
                                                "text": "„Hier sprang Günter Pichler mit erklärenden Worten ein, der Konzertmeister des mit Kurtags viel sagender Aphoristik eng vertrauten Ensembles.“"
                                            },
                                            {
                                                "example_id": "97b29cf0-87fa-48a7-94a3-07647aab42a7",
                                                "sense_id": "b02c9f38-2e6a-3f8b-a5de-9bb4bd01c7cb",
                                                "text": "„Aber nichts spricht dagegen, diese Theorie der Verschwendungsangst etwa auch auf die Aphoristik oder sorgar das Vollschreiben von Notizhefen anzuwenden, bis zum heutigen Tag, sofern sie auf Veröffentlichung hin geschrieben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
