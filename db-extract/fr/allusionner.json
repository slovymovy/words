                ],
                "senses": [
                    {
                        "sense_id": "8f9b539c-9a50-38c2-889e-b428495924a6",
                        "entry_id": "c1f55f69-d13b-3024-8bd6-7729234cfc86",
                        "glosses": [
                            "Faire des allusions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd85de9-f1bb-48ec-a115-f7c2bc68bb28",
                                "sense_id": "8f9b539c-9a50-38c2-889e-b428495924a6",
                                "text": "J'allusionnai lors, et cela de très près,\nÀ la défense par ces mains de tel corsage,\nDe telle jupe ayant trop voulu rester sage,\nJe me suis à dessein mal exprimé."
                            },
                            {
                                "example_id": "eede8704-891c-47ed-aeba-7cae87f3ecef",
                                "sense_id": "8f9b539c-9a50-38c2-889e-b428495924a6",
                                "text": "Ne suis-je pas digne maintenant d'allusionner à mon compte ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0691eae6-8b42-3e99-8f9a-9a15121462fb",
                        "entry_id": "c1f55f69-d13b-3024-8bd6-7729234cfc86",
                        "glosses": [
                            "Faire allusion à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ecf2bbd-2389-43b2-a342-d7680f32b260",
                                "sense_id": "0691eae6-8b42-3e99-8f9a-9a15121462fb",
                                "text": "Aussi, tout ce qui pouvait allusionner non seulement le procès, mais encore les juges, fut religieusement retranché."
                            }
                        ]
                    }
                ],
