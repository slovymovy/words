                "translations": [
                    {
                        "translation_id": "e3ec701a-5501-4a15-add1-4a56f25043e4",
                        "source_entry_id": "21d5dd28-c4ed-3726-8fb1-13cf8c54ed86",
                        "source_sense_id": "d0d065d2-d89b-3f57-af8a-17299706f485",
                        "target_lang_word": "bother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b28a6ff-29c3-331f-a691-993c9b88068a",
                                        "entry_id": "0a036909-0b37-3a1f-a114-6406f6b8db1a",
                                        "glosses": [
                                            "To annoy, to disturb, to irritate; to be troublesome to, to make trouble for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aca9899-5e51-4db4-8be4-ce330b977ec6",
                                                "sense_id": "0b28a6ff-29c3-331f-a691-993c9b88068a",
                                                "text": "Would it bother you if I smoked?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11402083-5acf-3a77-8be0-ee38ab01ecd4",
                                        "entry_id": "0a036909-0b37-3a1f-a114-6406f6b8db1a",
                                        "glosses": [
                                            "To annoy, to disturb, to irritate; to be troublesome to, to make trouble for.",
                                            "Damn; curse."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "imperative",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de2340a8-fac5-3368-8fe5-7740e6d92e13",
                                        "entry_id": "0a036909-0b37-3a1f-a114-6406f6b8db1a",
                                        "glosses": [
                                            "To feel care or concern; to burden or inconvenience oneself out of concern."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541a9cb7-4870-4973-8247-f022ea5c3346",
                                                "sense_id": "de2340a8-fac5-3368-8fe5-7740e6d92e13",
                                                "text": "I never bother about such trivialities."
                                            },
                                            {
                                                "example_id": "d3902553-0fe7-44c0-a898-ac372fa2289f",
                                                "sense_id": "de2340a8-fac5-3368-8fe5-7740e6d92e13",
                                                "text": "I wouldn't bother with an umbrella if I were you."
                                            },
                                            {
                                                "example_id": "c27ace33-68c2-4be8-a268-919d0b32ef4f",
                                                "sense_id": "de2340a8-fac5-3368-8fe5-7740e6d92e13",
                                                "text": "To expand, without bothering about it—without shiftless timidity on one side, or loquacious eagerness on the other—to the full compass of what he would have called a \"pleasant\" experience, was Newman's most definite programme of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0622b90-b25a-3157-a580-a88519d6d351",
                                        "entry_id": "0a036909-0b37-3a1f-a114-6406f6b8db1a",
                                        "glosses": [
                                            "To take the trouble, to trouble oneself (to do something)."
                                        ],
                                        "tags": [
                                            "catenative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "899bd5cc-be9c-42b7-8965-fb2604b3db5e",
                                                "sense_id": "c0622b90-b25a-3157-a580-a88519d6d351",
                                                "text": "Why do I even bother to try?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b9d07b2-1bfb-32f3-b943-c5a2de6e2009",
                                        "entry_id": "0a036909-0b37-3a1f-a114-6406f6b8db1a",
                                        "glosses": [
                                            "To take the trouble, to trouble oneself (to do something).",
                                            "To do something which is of negligible inconvenience."
                                        ],
                                        "tags": [
                                            "catenative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d78fe4-2eb3-4e79-952a-68b46ff29462",
                                                "sense_id": "2b9d07b2-1bfb-32f3-b943-c5a2de6e2009",
                                                "text": "You didn’t even bother to close the door."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d492fb0-dbf9-331f-b6ae-54083811f550",
                                        "entry_id": "8e02faaf-059e-3bb3-baaa-ee2ecfaeac75",
                                        "glosses": [
                                            "Fuss, ado."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f32a28-5a03-4956-93ea-88203bd5d9df",
                                                "sense_id": "8d492fb0-dbf9-331f-b6ae-54083811f550",
                                                "text": "There was a bit of bother at the hairdresser's when they couldn't find my appointment in the book."
                                            },
                                            {
                                                "example_id": "762e2c41-16e1-4e9d-be3b-251d096b9d48",
                                                "sense_id": "8d492fb0-dbf9-331f-b6ae-54083811f550",
                                                "text": "It was a 15-minute return trip to walk back home to pick up my device, but I weighed it up and decided that it wasn’t worth the bother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36f81ac6-6e27-38c2-ab28-a8e746c5dd5b",
                                        "entry_id": "8e02faaf-059e-3bb3-baaa-ee2ecfaeac75",
                                        "glosses": [
                                            "Trouble, inconvenience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42dc58cf-5fb2-47cd-864b-d57a77ea869f",
                                                "sense_id": "36f81ac6-6e27-38c2-ab28-a8e746c5dd5b",
                                                "text": "Yes, I can do that for you—it’s no bother."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a25f9e14-d54a-3077-b39b-c43394040a39",
                                        "entry_id": "cdc9f376-3d16-3353-9418-f477dc6cf5f2",
                                        "glosses": [
                                            "A mild expression of annoyance."
                                        ],
                                        "tags": [
                                            "dated",
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d6f3b0-59dd-4c22-8ade-0b302b8cadc5",
                                                "sense_id": "a25f9e14-d54a-3077-b39b-c43394040a39",
                                                "text": "[H]e suddenly flung down his brush on the floor, said \"Bother!\" and \"Oh blow!\" and also \"Hang spring-cleaning!\" and bolted out of the house without even waiting to put on his coat."
                                            },
