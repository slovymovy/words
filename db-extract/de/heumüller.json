                ],
                "senses": [
                    {
                        "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                        "entry_id": "1c7058d0-b12f-33ad-82ec-bb83c607af1e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ddc803-660d-42d5-9121-17704d5bcf1a",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heumüller kommt, geht der Herr Heumüller.“"
                            },
                            {
                                "example_id": "5e9c08af-d5af-4113-a91a-98456fb49941",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Heumüller kommt und geht."
                            },
                            {
                                "example_id": "1a4c5356-91c8-4fff-96f2-2e30289f3431",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Heumüllers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "1400c415-0a7c-4745-af65-c0e80d433fe9",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "An verregneten Herbsttagen ist Familie Heumüllers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "37e908bb-9966-4a7b-affe-3de8f5eb5f41",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Heumüller das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "5b0128ee-24e5-46c2-885d-27c4f34545a1",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Frau Heumüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "89826ad8-bda2-478e-985c-a4cca806f5ac",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Herr Heumüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a73ab7ca-d190-4cff-9a11-d06db5677253",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Die Heumüllers kommen heute von Helgoland."
                            },
                            {
                                "example_id": "362ddcd4-f9c9-4600-91dc-d8d430176bb9",
                                "sense_id": "ec1d2005-0f6e-303c-9f0d-fdb57821495e",
                                "text": "Der Heumüller trägt nie die Schals, die die Heumüller ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
