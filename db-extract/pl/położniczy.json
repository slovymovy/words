                        "target_lang_word": "родильный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "родильный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d69e04-1bf0-30b2-948b-0d047db0ba7c",
                                        "entry_id": "ab918cd5-ef41-3731-9828-1a297f1732be",
                                        "glosses": [
                                            "предназначенный, приспособленный для родов, для оказания врачебной помощи при родах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef146fb3-647c-4725-979f-369774f60943",
                                                "sense_id": "d2d69e04-1bf0-30b2-948b-0d047db0ba7c",
                                                "text": "Он вёз жену из родильного отделения районной больницы, она держала на руках ребёнка, и ему казалось, что проживи он тысячу лет ― он не забудет этого дня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dff658c2-6938-3d9e-93fc-abcb1c96a6f8",
                                        "entry_id": "ab918cd5-ef41-3731-9828-1a297f1732be",
                                        "glosses": [
                                            "бывающий, случающийся при родах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02e047f-0d90-4955-acdf-5b1c0c21f2b0",
                                                "sense_id": "dff658c2-6938-3d9e-93fc-abcb1c96a6f8",
                                                "text": "Родильный сепсис."
                                            },
                                            {
                                                "example_id": "3a7c3fd8-d049-4acb-97cd-cf087b57f121",
                                                "sense_id": "dff658c2-6938-3d9e-93fc-abcb1c96a6f8",
                                                "text": "Но повитуха, принимавшая на деревне у больной женщины, заразила Катюшу родильной горячкой, и ребёнка, мальчика, отправили в воспитательный дом, где ребёнок, как рассказывала возившая его старуха, тотчас же по приезде умер."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccbec437-adbf-3095-918f-843ba5db5efe",
                                        "entry_id": "ab918cd5-ef41-3731-9828-1a297f1732be",
                                        "glosses": [
                                            "устар., прост. cвязанный с празднованием родин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5caa06-8cc9-45c8-a5ac-6ee83d79ef48",
                                                "sense_id": "ccbec437-adbf-3095-918f-843ba5db5efe",
                                                "text": "Принесла Прасковья Патаповна первого сыночка Захарушку, первого внучка Патапу Максимычу. ❬…❭ Много гостей наехало в Осиповку — много навезли они Прасковье Патаповне родильных пирогов и каравайчиков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
