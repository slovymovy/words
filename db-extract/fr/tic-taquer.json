                "senses": [
                    {
                        "sense_id": "ada0da72-be01-3f0f-85ac-451f23ec1dec",
                        "entry_id": "9dd20ba7-910a-33b2-8df5-3a2695ee36f8",
                        "glosses": [
                            "Variante orthographique de tictaquer (faire un bruit de tic-tac, comme une montre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d685249b-6f3a-4ba1-964f-56878b28249b",
                                "sense_id": "ada0da72-be01-3f0f-85ac-451f23ec1dec",
                                "text": "On aurait entendu tic-taquer leur montre."
                            },
                            {
                                "example_id": "9f2de095-3a8f-4eb6-af58-895e5c86c0eb",
                                "sense_id": "ada0da72-be01-3f0f-85ac-451f23ec1dec",
                                "text": "En fait, les narrateurs sont plus obsédés par la mort que la majorité des gens ; nous percevons le cours du temps avec une sensibilité ou une virulence particulière, je crois, comme si les minutes tic-taquaient à nos oreilles de façon assourdissante."
                            },
                            {
                                "example_id": "26e419d1-935f-418d-86ab-f2e22c10fe13",
                                "sense_id": "ada0da72-be01-3f0f-85ac-451f23ec1dec",
                                "text": "Tu fais toujours tic-taquer mon cœur."
                            }
                        ]
                    }
