                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "о фильме, передаче"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be on",
                                "target_lang_sense_clarification": "to be broadcast or shown"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "to be presented in a cinema or on TV"
                            }
                        ]
