                ],
                "senses": [
                    {
                        "sense_id": "26975f27-7b0c-39f3-8912-4d08cf5ef887",
                        "entry_id": "1ef8212e-0871-3392-8b90-29c7b751d5b1",
                        "glosses": [
                            "onderdeel van een bloem vaak een andere kleur hebbend dan de rest van de plant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9289bf5-c09e-4948-8b60-8daa79374f05",
                                "sense_id": "26975f27-7b0c-39f3-8912-4d08cf5ef887",
                                "text": "De servetring draait rond terwijl een stuk of dertig puntige, platte uitsteeksels zich langzaam in een krans uiteenvouwen, als de bloembladen van een reusachtige zonnebloem."
                            },
                            {
                                "example_id": "20acde50-577d-496c-9c19-c36577ca4308",
                                "sense_id": "26975f27-7b0c-39f3-8912-4d08cf5ef887",
                                "text": "De bijna abstract uitgewerkte bloembladen wekken de indruk van duidelijk onderscheidbare kleurvlakken, die ten opzichte van elkaar een vergelijkbare spanning produceren als tussen vlak en lijn in Mondriaans abstracte werken."
                            },
                            {
                                "example_id": "43330e35-2ee5-453f-93c0-ad70fa6aeb93",
                                "sense_id": "26975f27-7b0c-39f3-8912-4d08cf5ef887",
                                "text": "Verschillende plantengroepen ontwikkelden onafhankelijk van elkaar een soort blauwe gloed op hun bloembladeren, maar het resultaat is telkens hetzelfde: de kleur trekt bestuivers aan, zo ontdekten onderzoekers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a1e6a7f-576d-4478-9c06-cf623c772c53",
                        "source_entry_id": "1ef8212e-0871-3392-8b90-29c7b751d5b1",
                        "source_sense_id": "26975f27-7b0c-39f3-8912-4d08cf5ef887",
                        "source_sense_description": "deel van een bloed",
                        "target_lang_word": "petal",
