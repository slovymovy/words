                    {
                        "translation_id": "4e8e1de3-40f8-4c21-885d-71986d1c61b5",
                        "source_entry_id": "633cccee-ca76-3bdf-8e93-f669ebed6b66",
                        "source_sense_description": "elegant and fashionable",
                        "target_lang_word": "elegant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elegant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "33cd9af0-3476-309e-babd-78a7cee902f9",
                                        "entry_id": "a717f010-d01d-37d7-8144-4b3525321c4a",
                                        "glosses": [
                                            "een prettige uitstraling hebbend door de subtiele afwerking"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5660337d-dd88-4f5c-b833-e984d0b35411",
                                                "sense_id": "33cd9af0-3476-309e-babd-78a7cee902f9",
                                                "text": "Zij kan werkelijk zeer elegante bewegingen maken."
                                            },
                                            {
                                                "example_id": "5009b49b-c217-4c27-8527-8b2c1cc65775",
                                                "sense_id": "33cd9af0-3476-309e-babd-78a7cee902f9",
                                                "text": "Albert mocht hem niet. Misschien omdat hij knap was. Een lange, slanke, elegante vent met een bos golvend donkerbruin haar, een rechte neus en prachtig getekende smalle lippen. En donkerblauwe ogen."
                                            },
                                            {
                                                "example_id": "65ba8659-7af8-4c60-b0c9-c6bc490356d2",
                                                "sense_id": "33cd9af0-3476-309e-babd-78a7cee902f9",
                                                "text": "Toen ik zei dat ik helaas nog niet wist hoelang ik van plan was te blijven en dat ik hoopte dat dat geen probleem zou zijn, wuifde hij mijn zorgen weg met een elegant handgebaar en bezwoer hij mij dat het een eer was voor het etablissement en een persoonlijk genoegen voor hemzelf om mij als gast te mogen beschouwen en dat hij alleen maar kon wensen dat deze vreugde langdurig zou mogen zijn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elegant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9bfa6d23-89f1-3790-9870-4c8240ca5abe",
                                        "entry_id": "16000410-a18d-3b82-b0c3-a5bdbf228f3e",
                                        "glosses": [
                                            "op elegante wijze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e788bb71-3a3b-4704-bcf9-3b14875edf0a",
                                                "sense_id": "9bfa6d23-89f1-3790-9870-4c8240ca5abe",
                                                "text": "Het gebouw was elegant versierd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0adfb6bc-994e-4628-bb48-a814901500d5",
