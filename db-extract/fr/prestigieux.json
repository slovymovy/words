                    },
                    {
                        "form_id": "3449973d-afb8-42f5-9116-16ac6c5e9601",
                        "entry_id": "b67d06df-03c0-3169-bdae-ff1c8e4745ee",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "prestigieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "410fb66c-3e90-38a0-ad9b-10c9b33ec64d",
                        "entry_id": "b67d06df-03c0-3169-bdae-ff1c8e4745ee",
                        "glosses": [
                            "Qui opère des prestiges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12eccca9-b308-4c7e-b55f-928cc144238b",
                                "sense_id": "410fb66c-3e90-38a0-ad9b-10c9b33ec64d",
                                "text": "Un art prestigieux."
                            },
                            {
                                "example_id": "96f175f5-8c5a-4749-89c7-1baf4a008aae",
                                "sense_id": "410fb66c-3e90-38a0-ad9b-10c9b33ec64d",
                                "text": "Une éloquence prestigieuse."
                            },
                            {
                                "example_id": "537ceb7c-6fef-412e-abb8-6711d287d00c",
                                "sense_id": "410fb66c-3e90-38a0-ad9b-10c9b33ec64d",
                                "text": "Un début prestigieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "caed5a50-b5cb-31f1-b5d2-e4007be59eda",
                        "entry_id": "b67d06df-03c0-3169-bdae-ff1c8e4745ee",
                        "glosses": [
                            "Qui a du prestige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30515eee-39ca-42ff-913b-0d8732e890d7",
                                "sense_id": "caed5a50-b5cb-31f1-b5d2-e4007be59eda",
                                "text": "René Jean Le Mouton de Boisdeftre, héritier et perpétuateur d'une prestigieuse dynastie militaire du Pays d'Alençon ne semblait pas jouir d'une grande fortune."
                            },
                            {
                                "example_id": "299afac0-4010-411c-96e9-a0a739f24f0f",
                                "sense_id": "caed5a50-b5cb-31f1-b5d2-e4007be59eda",
                                "text": "Cette appétence et ses excellents résultats lui ouvrent la porte des classes préparatoires scientifiques – maths sup à la rentrée 1942, maths spé à la rentrée 1943 – dans le prestigieux lycée Louis-le-Grand."
                            },
                            {
                                "example_id": "932305d6-7eb4-442a-8f06-f1026c673ffd",
                                "sense_id": "caed5a50-b5cb-31f1-b5d2-e4007be59eda",
                                "text": "Le tournoi junior me semble tellement éloigné du prestigieux tournoi adulte. J'ai l'impression d'être une joueuse de sous-catégorie."
                            },
                            {
                                "example_id": "d53fba00-3959-44aa-90e6-bdf9e96ca3ea",
                                "sense_id": "caed5a50-b5cb-31f1-b5d2-e4007be59eda",
                                "text": "\"La magnifique teinte violette, le fait qu'elle ne décolore pas et la difficulté à produire ce colorant, que l'on trouve en minuscules quantités dans le corps de petits mollusques\", ont fait de la pourpre royale une teinture prestigieuse qui \"coûtait souvent plus cher que l'or\", souligne-t-elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19999406-b9f6-4eaf-846b-218abc130e60",
                        "source_entry_id": "b67d06df-03c0-3169-bdae-ff1c8e4745ee",
                        "source_sense_description": "Qui opère des prestiges.",
                        "target_lang_word": "anspruchsvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anspruchsvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                        "entry_id": "d28a1c58-1322-39fc-910e-de95a709ad63",
                                        "glosses": [
                                            "nicht leicht zufriedenzustellen, mit hohen Ansprüchen"
                                        ],
                                        "tags": [
                                            "eine Person betreffend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d9d2eb-1779-47c9-ab8d-b27b6a466ed3",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "Ihr Fazit lautet, dass die Erwartungen der Jugendlichen an ihre spätere Tätigkeit anspruchsvoller geworden seien."
                                            },
                                            {
                                                "example_id": "ae726556-40ba-46f1-9008-940754ccdd5c",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "Unsere Gäste sind sehr anspruchsvoll und wollen einen umfangreichen Service."
                                            },
                                            {
                                                "example_id": "8efb8a41-807e-4e5b-9dd7-fa33ee8ef973",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "„Der anspruchsvolle Grenzgänger am Scheideweg von Leben und Tod lebt in krassen Antinomien, die dem Durchschnittsbürger sein Verständnis erschweren.“"
                                            },
                                            {
                                                "example_id": "0c689e91-65fc-4e07-a036-adf6dd84b224",
                                                "sense_id": "b6141463-01bf-334e-85f4-20d445ce39d2",
                                                "text": "„Sowohl für Genusswanderer als auch für anspruchsvolle Gipfelsammler hält der Band eine große Auswahl an Zielen bereit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                        "entry_id": "d28a1c58-1322-39fc-910e-de95a709ad63",
                                        "glosses": [
                                            "viel Wissen/Können wird benötigt, um es zu verstehen oder zu leisten"
                                        ],
                                        "tags": [
                                            "ein Objekt, einen Sachverhalt betreffend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3d3fe2-4707-4b9f-991e-f88ba5acca45",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                                            },
                                            {
                                                "example_id": "83ad13ce-cb3e-465f-996e-f9e789d17439",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "Ich bevorzuge anspruchsvolle Filme."
                                            },
                                            {
                                                "example_id": "e7674300-45b3-4625-b063-487af3a38fc7",
                                                "sense_id": "32f80667-55f4-38a7-b64a-81a8c608baf0",
                                                "text": "Diese Aufgabe ist äußerst anspruchsvoll."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "298a1970-49a1-4314-b8f6-2770f5b54375",
                        "source_entry_id": "b67d06df-03c0-3169-bdae-ff1c8e4745ee",
                        "source_sense_description": "Qui opère des prestiges.",
                        "target_lang_word": "angesehen",
