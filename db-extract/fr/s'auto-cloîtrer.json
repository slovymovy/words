                ],
                "senses": [
                    {
                        "sense_id": "739de16b-5307-3b9a-89c5-f2fe75a5586b",
                        "entry_id": "b0797233-f066-3331-aca8-3ed6474e04db",
                        "glosses": [
                            "Se cloîtrer de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4d3ea5-5e92-430d-b1d8-b3201b9bb696",
                                "sense_id": "739de16b-5307-3b9a-89c5-f2fe75a5586b",
                                "text": "En s'abstenant, on s'enferme, on s'auto-cloître, on se auto-muselle, on s'auto-mutile!"
                            },
                            {
                                "example_id": "2a6beadd-d6a0-4292-a406-8198d55411f3",
                                "sense_id": "739de16b-5307-3b9a-89c5-f2fe75a5586b",
                                "text": "Je suis sur le point de devenir folle sauvage à force d'être cloîtrée chez nous, et ce, même si je m'auto-cloître consciemment et avec plaisir, charmé par ma nouvelle maison."
                            },
                            {
                                "example_id": "b773dd0b-2d2e-44ee-82d5-2beec869f2ce",
                                "sense_id": "739de16b-5307-3b9a-89c5-f2fe75a5586b",
                                "text": "Je m’auto-cloître comme on cloîtrait les lépreux au Moyen-Age."
                            }
                        ]
                    }
