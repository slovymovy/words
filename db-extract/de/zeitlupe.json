                                "target_senses": [
                                    {
                                        "sense_id": "5be037e7-4fa8-399b-8ac4-311d4d1f894c",
                                        "entry_id": "839cbc46-e4df-32fc-9cba-8739b3534ec7",
                                        "glosses": [
                                            "A technique of film, photography, and video to stretch time and allow visibility of things normally happening too fast to be conveniently examined."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "caeb3c3a-4142-3e3a-b550-c0a5a2dc5183",
                                        "entry_id": "839cbc46-e4df-32fc-9cba-8739b3534ec7",
                                        "glosses": [
                                            "Movement at a slow pace."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66accbfa-81f5-4105-a342-41b3d895f68e",
                                                "sense_id": "caeb3c3a-4142-3e3a-b550-c0a5a2dc5183",
                                                "text": "Without this foresight, many more structures would now be suffering the fate of the viaduct at Nuneham, which was literally collapsing in plain sight (albeit in extreme slow motion)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdba2167-9428-46c6-a437-3847ad7aa8a2",
                        "source_entry_id": "8d3f4893-e81a-3b67-b0be-8201fe69cbef",
                        "source_sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                        "source_sense_description": "verlangsamte Darstellung einer Filmsequenz",
                        "target_lang_word": "ralenti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ralenti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "772c84ee-2318-3a40-8232-3c79bc692ebe",
                                        "entry_id": "c3f9dc82-3795-30fc-8008-c19776992997",
                                        "glosses": [
                                            "Qui est devenu plus lent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487f1a70-3a8b-4696-a128-19fa064df173",
                                                "sense_id": "772c84ee-2318-3a40-8232-3c79bc692ebe",
                                                "text": "Elle s’occupa à tenir le verre très fort, devint ralentie dans ses gestes et dans sa voix."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ralenti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb68959-c65c-3ba5-b7e9-b61a9a698d43",
                                        "entry_id": "850d1f63-1c1f-391c-8624-330d0df14d5c",
                                        "glosses": [
                                            "Mouvement à vitesse plus basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c893bf7d-0ed2-4bbe-8e41-b3fcd9fa0b79",
                                                "sense_id": "6cb68959-c65c-3ba5-b7e9-b61a9a698d43",
                                                "text": "Et puis, si aucun cataclysme soudain n’a décisivement transformé l’aspect naturel des choses, d’un seul coup, depuis un siècle, il est cependant vrai qu’au ralenti une catastrophe inéluctable impose à cette partie de la France, cette fatale loi d’impermanence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c51c0d13-943d-3533-8423-b56b3ab97f32",
                                        "entry_id": "850d1f63-1c1f-391c-8624-330d0df14d5c",
                                        "glosses": [
                                            "Déroulement d’un film, à vitesse plus basse que la norme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f774fd1-9252-4216-ba78-5be4bfce8b85",
                                                "sense_id": "c51c0d13-943d-3533-8423-b56b3ab97f32",
                                                "text": "La scène de la chute est présentée au ralenti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc9c4bdd-bb60-3a31-968a-e5dd55f52ee4",
                                        "entry_id": "850d1f63-1c1f-391c-8624-330d0df14d5c",
                                        "glosses": [
                                            "Régime de ralenti d'un moteur à combustion interne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f2af8cb-0142-4751-8022-e450d96944af",
                                                "sense_id": "cc9c4bdd-bb60-3a31-968a-e5dd55f52ee4",
                                                "text": "Les gaz poussèrent des bulles dans le naphte, une sorte de glouglou régulier qui couvrait le bruit du moteur au ralenti."
                                            },
                                            {
                                                "example_id": "3d804981-501e-43bc-8c26-7ae439cb6738",
                                                "sense_id": "cc9c4bdd-bb60-3a31-968a-e5dd55f52ee4",
                                                "text": "Le moteur met du temps a trouver le ralenti. En virage, si je coupe les gaz, le moteur pousse encore, c'est zarbiment rigolo mais pas rassurant!"
                                            }
                                        ]
                                    }
                                ]
                            },
