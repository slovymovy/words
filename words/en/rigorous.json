            "senses": [
                {
                    "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                    "sense_definition": "Extremely thorough, exhaustive, or accurate; strictly adhering to rules or standards.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new drug went through <w>rigorous</w> testing before it was approved for sale.",
                            "target_lang_translations": {
                                "ru": "Новое лекарство прошло <w>тщательные</w> испытания, прежде чем было допущено к продаже.",
                                "zh": "这种新药在获准销售前经过了<w>严谨</w>的测试。"
                            }
                        },
                        {
                            "text": "Candidates must pass a <w>rigorous</w> selection process to join the special forces.",
                            "target_lang_translations": {
                                "ru": "Кандидаты должны пройти <w>строгий</w> отбор, чтобы попасть в спецназ.",
                                "zh": "候选人必须通过<w>严格</w>的选拔程序才能加入特种部队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "painstaking",
                        "scrupulous",
                        "meticulous",
                        "strict"
                    ],
                    "antonyms": [
                        "arbitrary",
                        "capricious",
                        "whimsical"
                    ],
                    "common_phrases": [
                        "rigorous testing",
                        "rigorous standards",
                        "rigorous analysis",
                        "rigorous training"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно тщательный, доскональный или точный; строго придерживающийся правил или стандартов.",
                        "zh": "极其彻底、详尽或准确；严格遵守规则或标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "о проверке, анализе или исследовании"
                            },
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "о стандартах, правилах или отборе"
