                        "entry_id": "adbe8127-93fc-3827-b4ce-d5644263fe9d",
                        "glosses": [
                            "Representing a sound produced by knocking on something hollow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52799b3-f367-4898-81dd-8dceb37262a0",
                                "sense_id": "6972986a-ec62-33b2-83e1-44987d383302",
                                "text": "In one of those stampings into the yard he suddenly rushed at the tank and tapped it. Tonk, tonk, tonk, tab. One rung left. Only one rung; about a week's supply of water."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
