    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "24e3c9c9-3fb2-3061-9673-dd2e103ef79d",
                "word": "muckamuck",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b750881-5b7a-4f78-949d-ad7021332a63",
                        "entry_id": "24e3c9c9-3fb2-3061-9673-dd2e103ef79d",
                        "tags": [
                            "plural"
                        ],
                        "form": "muckamucks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d11be01d-fbd5-3adb-9de4-72026fe24766",
                        "entry_id": "24e3c9c9-3fb2-3061-9673-dd2e103ef79d",
                        "glosses": [
                            "A person in a position of power or authority, or of high status."
                        ],
                        "tags": [
                            "colloquial",
                            "countable",
                            "derogatory",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "68464c4e-3930-4e9d-8438-c93ed39a8b46",
                                "sense_id": "d11be01d-fbd5-3adb-9de4-72026fe24766",
                                "text": "I think it was the Fourth of July when they took the chair from under my ass again. Not a word of warning. One of the big muck-a-mucks from the other side of the water had decided to make economies; […]"
                            },
                            {
                                "example_id": "53999dfa-4c19-4f6b-9f03-c2a712692b00",
                                "sense_id": "d11be01d-fbd5-3adb-9de4-72026fe24766",
                                "text": "Allen had the wit—God, I love that man when he's at his best—to invite all the new Kennedy muckamucks to an evening with a number of us at the Alibi Club."
                            }
                        ]
                    },
                    {
                        "sense_id": "d05f2e65-6ed7-38f5-9c85-2c7d9661c985",
                        "entry_id": "24e3c9c9-3fb2-3061-9673-dd2e103ef79d",
                        "glosses": [
                            "Food."
                        ],
                        "tags": [
                            "US",
                            "dated",
                            "dialectal",
                            "possibly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a7efaef5-1964-4eaf-a14a-483cea7f081b",
                                "sense_id": "d05f2e65-6ed7-38f5-9c85-2c7d9661c985",
                                "text": "She apparently has her own way in everything now, the old chief being quite satisfied to get his rations of muckamuck and tobacco without troubling himself as to how it is provided."
                            },
                            {
                                "example_id": "85e8166e-7faa-40e4-af7e-8128288d495c",
                                "sense_id": "d05f2e65-6ed7-38f5-9c85-2c7d9661c985",
                                "text": "But old Halascum once, under the mellowing influence of having sold some furs, and seeing the great quantities of muckamuck, or goodly things to eat, which his prize had furnished, was led to tell the mystery […]"
                            }
                        ]
                    }
                ],
