                                "target_senses": [
                                    {
                                        "sense_id": "6177f670-23b8-3182-9bf3-9f93f51bbbd7",
                                        "entry_id": "ba9ddfcd-a0cc-3806-a811-578344abc551",
                                        "glosses": [
                                            "zich ~: de manieren die iemand meest in de omgang met anderen aan de dag legt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab67925f-c2fb-4835-ae95-33eb051ddf1d",
                                                "sense_id": "6177f670-23b8-3182-9bf3-9f93f51bbbd7",
                                                "text": "Hij weet zich niet te gedragen."
                                            },
                                            {
                                                "example_id": "4b59bedc-3339-478f-8a1d-4c0667c19b85",
                                                "sense_id": "6177f670-23b8-3182-9bf3-9f93f51bbbd7",
                                                "text": "' 'Ik moet me gedragen?' 'Ga Teresa halen ' Olive ging naar boven, maar Teresa was nergens te bekennen."
                                            },
                                            {
                                                "example_id": "af2d952f-33da-41b8-9b5f-a3dff0b77b79",
                                                "sense_id": "6177f670-23b8-3182-9bf3-9f93f51bbbd7",
                                                "text": "Ze gedroegen zich in ieder geval alsof ze hier al weken bivakkeerden."
                                            },
                                            {
                                                "example_id": "86ce5581-2cfe-4167-8b46-1bbcfe46ea5f",
                                                "sense_id": "6177f670-23b8-3182-9bf3-9f93f51bbbd7",
                                                "text": "En ze wist hoe ze zich moest gedragen, zag er representatief uit en sprak vloeiend Duits, Engels en Frans. Ze wees naar de drie vlaggen op de revers van de blazer. Ik wist wat het betekende om 'je te gedragen', dat was simpelweg de opvoeding die je in deftige families kreeg."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gedragen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "895a10e1-13d9-3253-8505-3ccc979cee2d",
                                        "entry_id": "71552339-f255-3410-9ab1-8ca8bc957f54",
                                        "glosses": [
                                            "voltooid deelwoord van dragen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
