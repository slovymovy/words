                        "examples": [
                            {
                                "example_id": "817ee7f0-c58e-4715-a3dd-9ec1f9b5ee47",
                                "sense_id": "6e34723d-5a02-3548-9ef1-a5512a489745",
                                "text": "On assure que le kobez niche quelquefois dans les forêts des Hautes-Pyrénées et même sur des peupliers dans les prairies."
                            },
                            {
                                "example_id": "531bec76-c55c-4276-9c85-3dfe1347b463",
                                "sense_id": "6e34723d-5a02-3548-9ef1-a5512a489745",
                                "text": "Quelques faucons kobez de l’Amour, au plumage bleuté, faisaient la chasse aux insectes en tournoyant brutalement dans les airs. Certains d’entre eux, perchés sur des mottes, posaient un œil indifférent sur les gens qui passaient devant eux."
                            }
                        ]
