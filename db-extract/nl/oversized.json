                        "sense_id": "53a89866-4405-3460-9f4b-81095f19a788",
                        "entry_id": "69b472df-3227-35c7-9391-6d1bb0e099ed",
                        "glosses": [
                            "bewust een te grote maat hebbend met name van kleding maar ook van bijvoorbeeld auto's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2ff36e-d55e-4906-803a-d0ca401378b5",
                                "sense_id": "53a89866-4405-3460-9f4b-81095f19a788",
                                "text": "De bende van orkestleider Jack Stratton was kleurrijk: drummer/zanger/gitarist Theo Katzman daagde op in een oversized roze singlet, bassist Joe Dart stond Tom Cruise-gewijs de hele tijd achter zijn zonnebril te grijnzen, en Woody Goss zat charmant nerdy te wezen achter zijn toetsen."
                            },
                            {
                                "example_id": "6ae416a6-0c41-4771-8ff3-fe9a7f78ceba",
                                "sense_id": "53a89866-4405-3460-9f4b-81095f19a788",
                                "text": "Wie met de jaarwisseling een oversized melkbus op straat zet, kan er op [sic!] rekenen dat die snel is verdwenen. Enschede treedt dit jaar namelijk hard op tegen ‘groot carbidschieten’."
                            }
                        ]
                    }
