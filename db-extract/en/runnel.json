                    {
                        "translation_id": "84403932-433c-4ee4-8980-70a8dd603203",
                        "source_entry_id": "023cf15f-0198-3ec9-b26b-429975b48369",
                        "source_sense_id": "9c5a2a29-d165-3f51-ad0d-32a0dad968b0",
                        "source_sense_description": "(veraltet) Bach, Rinnsal, Rinne, Rinnstein",
                        "target_lang_word": "Rinnstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
