                "senses": [
                    {
                        "sense_id": "a0906312-ad01-33fa-87f7-08b4ad4e01ff",
                        "entry_id": "e38f6141-a8b4-30ce-b68d-d02d76724137",
                        "glosses": [
                            "Variante orthographique de Pâque."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "de9456a2-774f-4884-80fc-a50c19ede68c",
                                "sense_id": "a0906312-ad01-33fa-87f7-08b4ad4e01ff",
                                "text": "Jésus-Christ y fit la dernière pâque, et y institua le sacrement d’eucharistie."
                            },
                            {
                                "example_id": "54072d6c-8545-458b-b074-b7c3b66edd89",
                                "sense_id": "a0906312-ad01-33fa-87f7-08b4ad4e01ff",
                                "text": "Dans cette pâque j’engage toute ma personne, au-delà d’elle-même, dans un mouvement d’adhésion sans condition."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3048bcdf-1313-32e0-b802-d31d70144059",
                "word": "Pâque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "864b71cb-1c58-422d-9f4a-6b76cdd1183e",
                        "entry_id": "3048bcdf-1313-32e0-b802-d31d70144059",
                        "tags": [],
                        "form": "pâque"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4281b801-d6c9-3536-8bc1-8e7553177faf",
                        "entry_id": "3048bcdf-1313-32e0-b802-d31d70144059",
                        "glosses": [
                            "Fête solennelle que les juifs célèbrent tous les ans, le quatorzième jour lunaire après l’équinoxe du printemps, en mémoire de leur sortie d’Égypte."
                        ],
                        "tags": [
                            "Biblical",
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "5e95a5ce-f1d9-4495-bf07-7974f00f5ef0",
                                "sense_id": "4281b801-d6c9-3536-8bc1-8e7553177faf",
                                "text": "Veillée familiale de la Pâque avec la […] galette de pain azyme, et les herbes amères."
                            },
                            {
                                "example_id": "0fd7f005-603f-4ba8-b500-5e00e4a3ecae",
                                "sense_id": "4281b801-d6c9-3536-8bc1-8e7553177faf",
                                "text": "Ces heurts, à l'intérieur d'un des lieux de culte musulmans les plus emblématiques au monde, sont survenues alors que les musulmans arrivent au milieu du ramadan et les juifs célèbrent la Pâque à partir de mercredi soir, dans un climat particulièrement tendu entre Israéliens et Palestiniens depuis le début de l'année."
                            },
                            {
                                "example_id": "9a54df03-bcae-42f3-abb8-2dabd78f7381",
                                "sense_id": "4281b801-d6c9-3536-8bc1-8e7553177faf",
                                "text": "Célébrer la Pâque. Fêter la Pâque."
                            }
                        ]
                    },
                    {
                        "sense_id": "73f03b7a-6b89-3d0d-8f02-2b9d779fe6cc",
                        "entry_id": "3048bcdf-1313-32e0-b802-d31d70144059",
                        "glosses": [
                            "Agneau pascal."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "a63f70c9-d1f3-481e-b7b4-7747768d8df1",
                                "sense_id": "73f03b7a-6b89-3d0d-8f02-2b9d779fe6cc",
                                "text": "Manger la Pâque."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74f5104-4d2b-3c9c-8706-93e18a432ba4",
                        "entry_id": "3048bcdf-1313-32e0-b802-d31d70144059",
                        "glosses": [
                            "Fête chrétienne célébrant la résurrection du Christ."
                        ],
                        "tags": [],
                        "note": "Cette forme est essentiellement utilisée pour désigner la fête dans les églises qui célèbrent la fête en fonction du calendrier juif. Le terme consacré est autrement Pâques",
                        "examples": [
                            {
                                "example_id": "a3861b6c-8f48-4633-94e7-4a830138e00c",
                                "sense_id": "c74f5104-4d2b-3c9c-8706-93e18a432ba4",
                                "text": "Les gravats que paissaient, durant cette semaine de la Pâque grecque, d'innombrables agneaux pascals."
                            },
                            {
                                "example_id": "aa89a59f-857b-408b-be67-08112ad41f7d",
                                "sense_id": "c74f5104-4d2b-3c9c-8706-93e18a432ba4",
                                "text": "« La Grande Pâque russe » est une ouverture de concert écrite par le compositeur russe Nikolaï Rimski-Korsakov."
                            }
                        ]
                    }
                ],
