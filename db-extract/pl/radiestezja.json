                "senses": [
                    {
                        "sense_id": "c84f250c-482a-367a-bb87-0d1ecc383f0e",
                        "entry_id": "6f084461-4f6e-3517-92af-a1a9aec9646a",
                        "glosses": [
                            "pseudonaukowa metoda badawcza wykorzystująca wahadełko, którego zachowanie (odzwierciedlające ruchy rąk trzymającego wywołane „radiacją” badanego przedmiotu) ma być niezwykle dokładnym wskaźnikiem pomiarowym wartości wszelakich"
                        ],
                        "tags": [
                            "esoteric"
                        ],
                        "examples": [
                            {
                                "example_id": "24a2ad94-1450-47f7-a465-798380bf32f1",
                                "sense_id": "c84f250c-482a-367a-bb87-0d1ecc383f0e",
                                "text": "To, co dzisiaj nazywamy ekologią, aranżacją przestrzeni, profilaktyką ekologiczną, ochroną środowiska czy nawet radiestezją, było w starożytnych Chinach łączone w jedną całość i nazywane feng shui"
                            },
                            {
                                "example_id": "5cc47966-e033-4017-8a46-58c521fa17b2",
                                "sense_id": "c84f250c-482a-367a-bb87-0d1ecc383f0e",
                                "text": "Należy zawsze pamiętać, że wyrównany stan ducha i dobra fizyczna kondycja przy radiestezji są bardzo ważne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
