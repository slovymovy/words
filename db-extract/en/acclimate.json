                                                "sense_id": "c20b8c93-175d-38a5-8525-4cfc4cb9112b",
                                                "text": "Hij is al aardig ingeburgerd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dce7255d-b6ad-3cbc-86cb-af441ebc0c58",
                                        "entry_id": "0945bd46-3317-32dc-a12a-8e4e5ab5f926",
                                        "glosses": [
                                            "moeite doen zich aan te passen aan een nieuwe omgeving"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3e587b-945c-4b51-98d6-663da262e12e",
                                                "sense_id": "dce7255d-b6ad-3cbc-86cb-af441ebc0c58",
                                                "text": "Allochtonen wordt vaak gevraagd zich beter in te burgeren, maar hoe veel moeite doen we zelf voor onze taal?"
