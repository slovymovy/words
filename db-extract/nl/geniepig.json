                "senses": [
                    {
                        "sense_id": "421b8e6e-3fb0-36b5-a9af-b10e7eecc53f",
                        "entry_id": "8584c0ad-9cc0-3c78-9663-e3da97ea24b0",
                        "glosses": [
                            "op een achterbakse manier en gemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1264e2e2-d37e-4525-839a-6350c5741b13",
                                "sense_id": "421b8e6e-3fb0-36b5-a9af-b10e7eecc53f",
                                "text": "Hij zette hem op een geniepige manier buiten spel."
                            },
                            {
                                "example_id": "007d0d55-eefe-4610-a7cb-c475b9ef392f",
                                "sense_id": "421b8e6e-3fb0-36b5-a9af-b10e7eecc53f",
                                "text": "Omdat hij iets geniepigs had gedaan mocht hij niet meer meedoen met het spelletje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c470aaa0-742b-48ed-bd73-c9ef01fb0207",
                        "source_entry_id": "8584c0ad-9cc0-3c78-9663-e3da97ea24b0",
                        "source_sense_id": "421b8e6e-3fb0-36b5-a9af-b10e7eecc53f",
                        "source_sense_description": "op een achterbakse manier en gemeen",
                        "target_lang_word": "hinterhältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinterhältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                        "entry_id": "38345aa2-762e-3fc0-bb93-6c7ccd74c397",
                                        "glosses": [
                                            "die offene Auseinandersetzung scheuend, oftmals nach außen hin freundlich, aber mit bösen Absichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aab34fe9-3ab9-47b2-9299-d342307b8864",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Der Kerl ist ein hinterhältiger Betrüger!"
                                            },
                                            {
                                                "example_id": "4a6ce279-b34b-4201-abee-318d69cf0e04",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Bei dem hinterhältigen Angriff stach der Täter dem Opfer mit einem Messer in den Rücken."
                                            },
                                            {
                                                "example_id": "94ea658c-e4bc-45eb-9b7f-4a844eb92240",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Ihm jetzt in den Rücken zu fallen ist hinterhältig und gemein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89360f46-4bfb-4609-a037-b9414c69e09a",
                        "source_entry_id": "8584c0ad-9cc0-3c78-9663-e3da97ea24b0",
                        "source_sense_id": "421b8e6e-3fb0-36b5-a9af-b10e7eecc53f",
                        "source_sense_description": "op een achterbakse manier en gemeen",
                        "target_lang_word": "sneaky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneaky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                        "entry_id": "c9293a5c-12f5-34fc-968e-7d248cd1deb5",
                                        "glosses": [
                                            "Elusive; difficult to capture or observe due to constantly outwitting the adversaries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e58d7f-9834-450c-a98a-de252bfedc6b",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Catching those thieves will be hard: they're so sneaky!"
                                            },
                                            {
                                                "example_id": "adb65bcb-247e-403d-b1f6-a9d191b21070",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Be sneaky. Fish frighten easily."
                                            },
                                            {
                                                "example_id": "a84ade74-3355-4df4-a1e4-662a340ec4c4",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Some fans may have mistaken the album’s floatiness for aimlessness, but Mr. Mercer’s songs have never been sneakier, or prettier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                        "entry_id": "c9293a5c-12f5-34fc-968e-7d248cd1deb5",
                                        "glosses": [
                                            "Dishonest; deceitful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef99175-3c5a-4544-9226-18c09feb4239",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "They played a sneaky trick on us."
                                            },
                                            {
                                                "example_id": "972a4933-765f-4c0f-8482-bb3d8d1e9e15",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "A contribution to a wall newspaper of which I was an editor in our sector poked fun at the never-changing menu in the school cafeteria. It centred on the various and devious methods used in serving us hamburger. One time it would be called hamburger, another time bifshtek, then cutlet, and sneakiest of all, schnitzel—the only difference among them was usually only in their shape or whether bread crumbs had been used."
                                            },
                                            {
                                                "example_id": "94c9c1d9-65a6-4150-9747-0317ae056a83",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "Irish car bombs were a sneaky drink—they tasted like a chocolate milk shake, and more than once he'd been seduced into drinking several of them. It was only after he stood up that he realized how much of a wallop they packed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneaky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                        "entry_id": "5cb24c12-801f-330e-bb7d-aae4b202eb05",
                                        "glosses": [
                                            "Any device used for covert surveillance."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2c6397-e503-452a-bc87-d28c398890e1",
                                                "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                                "text": "[…] in cooperation with the National Security Agency, installs and maintains \"sneakies\" throughout the U.S.S.R. and Communist China — but increasingly, denied areas are surveyed more simply."
                                            },
                                            {
                                                "example_id": "0d7b748e-f95f-438a-8415-1cb8e8b0f1d0",
                                                "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                                "text": "[…] has used travellers to plant 'sneakies' - small electronic transmitting devices which form part of a surveillance network."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2ea6dc9-3ee5-4bb0-80e7-8888b0aa2500",
                        "source_entry_id": "8584c0ad-9cc0-3c78-9663-e3da97ea24b0",
