                        "glosses": [
                            "Prière par laquelle on recommande son âme à Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936f411e-e42a-40b0-b32e-59d2faaf20ec",
                                "sense_id": "048d6a67-74c2-3a45-b7ad-1b96316797fb",
                                "text": "Un in-manus fervent."
                            },
                            {
                                "example_id": "d4f05813-f7b3-442f-9f62-3a862473c266",
                                "sense_id": "048d6a67-74c2-3a45-b7ad-1b96316797fb",
                                "text": "Dire son in-manus, être ou se croire sur le point de mourir."
                            },
                            {
                                "example_id": "ed69be88-c37e-42ff-9348-54b22f193272",
                                "sense_id": "048d6a67-74c2-3a45-b7ad-1b96316797fb",
                                "text": "Une dame qui était tout émerveillée que je fusse assez fou pour faire encore des vers dans un âge où l'on ne doit dire que son in-manus."
                            },
                            {
                                "example_id": "9d15f020-d769-4c00-b8cf-51f395b1a7df",
                                "sense_id": "048d6a67-74c2-3a45-b7ad-1b96316797fb",
                                "text": "On lui dit [en Italie, à un homme qu'on assassine], avant de le tuer : recommande ton âme à Dieu, pardonne-moi, et fais un acte de contrition ; il dit son in-manus, pardonne, et on l'égorge ; il va en paradis."
                            }
                        ]
                    }
