                "senses": [
                    {
                        "sense_id": "1c29ab49-3ba6-3233-a5bd-3e32e44a4d98",
                        "entry_id": "1fb44fa1-1e75-3893-92bd-4e9d21878fab",
                        "glosses": [
                            "Gesamtheit der weniger schweren Straftaten, Bagatelldelikte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b2ada6-a5e4-40b1-9b69-db7ffe53b0cb",
                                "sense_id": "1c29ab49-3ba6-3233-a5bd-3e32e44a4d98",
                                "text": "„In touristisch frequentierten Orten und Städten hat sich die Polizeipräsenz erhöht, um der Kleinkriminalität Einhalt zu gebieten.“"
                            },
                            {
                                "example_id": "cf4f3cda-b03b-4d9d-b8a6-740b359eea65",
                                "sense_id": "1c29ab49-3ba6-3233-a5bd-3e32e44a4d98",
                                "text": "„Neben den beiden Gefährten, die ihren Weg in der Welt der Kleinkriminalität oder auf dem Feld religiösen Unternehmertums machen, endet das Engagement des Philanthropen in Verzweiflung, persönlichem Kummer und Frustration.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
