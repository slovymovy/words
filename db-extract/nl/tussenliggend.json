                    {
                        "translation_id": "99de066d-6858-42c5-8a46-b61cbc986c86",
                        "source_entry_id": "fdda3aa7-feaf-3c8a-a5a3-0a2454a5d833",
                        "source_sense_id": "bc211488-6f07-38a8-91fc-b1516cbff700",
                        "source_sense_description": "van iets dat het tussen twee zaken in is",
                        "target_lang_word": "intermediate",
