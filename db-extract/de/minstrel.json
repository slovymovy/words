                                    },
                                    {
                                        "sense_id": "c68a05a3-2ffe-31af-a006-d7fae781fe90",
                                        "entry_id": "3d1fad85-34ac-3d59-975d-3cf1f299a290",
                                        "glosses": [
                                            "Persona que crea y canta trovas y/o trovos, a menudo por improvisación."
                                        ],
