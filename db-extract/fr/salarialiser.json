                "senses": [
                    {
                        "sense_id": "d8e8f7da-204c-3284-bdc2-a5deb3700305",
                        "entry_id": "ee78cd58-7534-3236-8598-b8cb1a68edc0",
                        "glosses": [
                            "Donner le statut de salarié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dfedb22-226b-4e68-8f48-58ca42739738",
                                "sense_id": "d8e8f7da-204c-3284-bdc2-a5deb3700305",
                                "text": "Encadrer davantage le milieu associatif, fiscaliser, salarialiser les bénévoles, ou toutes autres formules, ne datent pas d'aujourd'hui, poursuit-il."
                            },
                            {
                                "example_id": "1a3ce150-8e4f-40f9-8df0-a521013a2377",
                                "sense_id": "d8e8f7da-204c-3284-bdc2-a5deb3700305",
                                "text": "Alors là, on est face à un modèle où l’habitation du territoire n’est pas une variable, nous sommes face à un modèle qui veut salarialiser les producteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "0522f3e7-e374-30da-8a83-c0826f880982",
                        "entry_id": "ee78cd58-7534-3236-8598-b8cb1a68edc0",
                        "glosses": [
                            "Confier aux salariés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b2e30bd-f7f0-4506-943b-72dee2277c0d",
                                "sense_id": "0522f3e7-e374-30da-8a83-c0826f880982",
                                "text": "Il ne faudrait pas nationaliser les entreprises, il faudrait les « salarialiser », c’est à dire les donner à tous les employés qui travaillent dans ces entreprises afin qu’ils puissent réellement bénéficier du fruit de leur travail."
                            }
                        ]
                    }
                ],
