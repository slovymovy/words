                                    },
                                    {
                                        "sense_id": "a237dd9b-d3d1-38d7-812d-098864f4641e",
                                        "entry_id": "252f0f26-bc74-3976-8c5c-ae3c042d1354",
                                        "glosses": [
                                            "dominująca rola mężczyzny, zwłaszcza ojca, w rodzinie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b59ce1-b14e-4607-9018-6ebcf8d1cb5b",
                                                "sense_id": "a237dd9b-d3d1-38d7-812d-098864f4641e",
                                                "text": "Panujący w polskiej kulturze patriarchat powoduje, że kobieta wciąż jest oceniana przez pryzmat macierzyństwa"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "bd3adab2-4f83-31d2-aace-ab1afcd4d01d",
                                        "entry_id": "252f0f26-bc74-3976-8c5c-ae3c042d1354",
                                        "glosses": [
                                            "ostatni okres w ustroju wspólnoty pierwotnej następujący po matriarchacie, w którym dominujące stanowisko zajmuje mężczyzna stojący na czele rodu"
