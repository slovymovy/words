                    {
                        "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                        "entry_id": "beea8b70-6a61-3f0c-b0be-90bbcdad634a",
                        "glosses": [
                            "Celle qui est de la même équipe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd20ea8-e2cf-4c9d-b9b5-d359b7d3ce6a",
                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                "text": "Il ne parvenait pas à accepter la réalité de la mort d’Agathe, la silhouette du tueur, le visage défiguré de sa coéquipière l’assaillaient…"
                            },
                            {
                                "example_id": "51335229-3f7b-4777-970f-ee55f767276a",
                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                "text": "Elle avait été touchée à ce même genou lors de l’entraînement de veille de match, après un choc avec une coéquipière."
                            },
                            {
                                "example_id": "c6367ac6-02a2-4da0-85d6-b57288a21d38",
                                "sense_id": "3c532e19-c95f-3583-af45-d24e73da6a54",
                                "text": "Sa coéquipière au PSG, Aminata Diallo, considérée par les enquêteurs comme la commanditaire des violences, a été mise en examen et placée sous contrôle judiciaire."
                            }
                        ]
                    }
