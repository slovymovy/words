                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0497c0f-07bf-3df7-a342-1be7c28812d9",
                        "entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "glosses": [
                            "samenhang"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3fe4d6fa-1f50-3fa4-9d8d-d65d3b0acc05",
                        "entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "glosses": [
                            "een onderlinge aantrekking van moleculen van een zelfde stof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8a2782-c202-469f-872f-3858b3a9294a",
                                "sense_id": "3fe4d6fa-1f50-3fa4-9d8d-d65d3b0acc05",
                                "text": "We spreken van cohesie als dezelfde soort moleculen elkaar vasthouden en van adhesie als verschillende soorten moleculen elkaar vasthouden."
                            }
                        ]
                    },
                    {
                        "sense_id": "58fe9eb6-2c90-3b61-a8bc-3184ec016957",
                        "entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "glosses": [
                            "de samenhang binnen een tekst zoals die tot uiting komt in de vorm van woordherhaling en verwijswoorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9808579e-85a3-4e08-92e9-e9b161d8c55b",
                                "sense_id": "58fe9eb6-2c90-3b61-a8bc-3184ec016957",
                                "text": "Er zijn aan de andere kant verschillende middelen om cohesie te bewerken, maar zoals het volgende fragment laat zien, garandeert de aanwezigheid van zo'n cohesieve band op zichzelf nog geen coherentie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d824d8d2-fc07-3219-9a57-01ae52dd54db",
                        "entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "glosses": [
                            "de onderlinge binding tussen de mensen binnen een maatschappij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ec8785-bd39-47d1-8eba-83ca494a33d0",
                                "sense_id": "d824d8d2-fc07-3219-9a57-01ae52dd54db",
                                "text": "Er is sprake van sociale cohesie als de mensen een wij-gevoel hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad162496-d9e6-4831-afcb-d02bf8b41e00",
                        "source_entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "source_sense_id": "3fe4d6fa-1f50-3fa4-9d8d-d65d3b0acc05",
                        "source_sense_description": "een onderlinge aantrekking van moleculen van een zelfde stof",
                        "target_lang_word": "Zusammenhalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenhalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                        "entry_id": "1465f36f-a21f-3e89-a6b9-e46b787024b0",
                                        "glosses": [
                                            "Verbundenheit zwischen den Mitgliedern einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba6a6dc-791e-4f75-8806-382ebc56359d",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "[In einem Dorf in Namibia hat sich] die Versorgung der HIV-Infizierten […] verbessert, die selbstständige Beschäftigung sowie der Zusammenhalt der Bevölkerung hat zugenommen."
                                            },
                                            {
                                                "example_id": "94a8499c-ebf0-46c8-a025-f29c19c0dca1",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Der Zusammenhalt in einer Familie zeigt sich erst richtig bei Problemen, Ärger und Streit."
                                            },
                                            {
                                                "example_id": "d19e00cc-6dd8-4432-80c6-a2a449756f6a",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Warum sich Eltern von Töchtern häufiger scheiden lassen - Destabilisieren Töchter etwa ihre Familie, oder fördern Söhne den Zusammenhalt? Nein, sagen Forscher […]"
                                            },
                                            {
                                                "example_id": "8b8bebac-0d40-4218-b2a3-7232272a3033",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Der Zusammenhalt innerhalb der Schulklasse meines Sohne ist großartig: die Schüler helfen sich gegenseitig bei den Hausaufgaben, erstellen zusammen Referate und bereiten sich gemeinsam auf die Klassenarbeiten vor."
                                            },
                                            {
                                                "example_id": "45a0631c-472c-44db-a668-4d474e1e07f1",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Ein gemeinnütziger Verein bietet Dienstleistungen für wenig Geld direkt am Kiosk an der Ecke an. Ob Heimwerkerarbeiten, Behördenkram oder mit dem Hund Gassi gehen - der Verein schafft neue Jobs und sorgt für mehr Zusammenhalt in der Nachbarschaft."
                                            },
                                            {
                                                "example_id": "d2cf94fa-7edb-4ef4-b880-c864ff4f101e",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Der Zusammenhalt von Dörfern auf dem Lande in Deutschland wird geprägt von der Infrastruktur: baut Schulen, organisiert Ärzte, Apotheken und einen Tante-Emma-Laden mit Post."
                                            },
                                            {
                                                "example_id": "000dc502-72e6-4e4b-92aa-8edc8571bc95",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Er [der französische Umweltminister Jean-Louis Borloo] forderte, die Politik müsse künftig verstärkt auf den sozialen Zusammenhalt achten und den schwächsten Mitgliedern der Gesellschaft die Hand reichen. Als Beispiele nannte er die Politikfelder Wohnungsnot und Berufsausbildung."
                                            },
                                            {
                                                "example_id": "3328aea8-f078-4908-b61d-f28d8c851452",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Man könnte die politische Kultur befrieden, den Zusammenhalt stärken, indem man dafür sorgt, dass die Leute, die sich ökonomisch abgehängt fühlen, sagen können: Die Linken vertreten meine Interessen."
                                            },
                                            {
                                                "example_id": "cf0a86bd-a7b8-4bae-a346-da269140382b",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Der Zusammenhalt zwischen den Staaten der Europäischen Union erodierte."
                                            },
                                            {
                                                "example_id": "e0d49814-4a62-4dbf-9d07-f0ee8e25351c",
                                                "sense_id": "82a007fd-3ae5-3d5c-bb42-ed0283c96930",
                                                "text": "Als zweiten Punkt nannte sie [Bundeskanzlerin A. Merkel] die Migration: „[…] ich halte dieses Thema für eines der entscheidenden für den Zusammenhalt Europas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0b1543a-5f0f-3dae-8b69-0273953301a7",
                                        "entry_id": "1465f36f-a21f-3e89-a6b9-e46b787024b0",
                                        "glosses": [
                                            "Grad der Verbindung von (chemischen) Elementen, Molekülen oder Teilen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad82bb1a-b3d5-4bde-a61b-5ec1737d004e",
                                                "sense_id": "d0b1543a-5f0f-3dae-8b69-0273953301a7",
                                                "text": "Durch diesen Leim ist der Zusammenhalt der Bretter gewährleistet."
                                            },
                                            {
                                                "example_id": "25bc20e0-c7e0-4a63-a4c2-48bb68ed636b",
                                                "sense_id": "d0b1543a-5f0f-3dae-8b69-0273953301a7",
                                                "text": "Die diesen mechanischen Zusammenhalt bewirkenden Kräfte sind nicht alle vollständig erforscht, weshalb es verschiedene Adhäsionstheorien gibt."
                                            },
                                            {
                                                "example_id": "6cb921b8-2da2-4dc1-bc39-d5157b02a9aa",
                                                "sense_id": "d0b1543a-5f0f-3dae-8b69-0273953301a7",
                                                "text": "Der Zusammenhalt wird entweder geschaffen (Urformen), beibehalten (Umformen, Umlagern von Stoffteilchen), vermindert (Trennen, Aussondern von Stoffteilchen) oder vermehrt (Fügen, Beschichten, Einbringen von Stoffteilchen)."
                                            },
                                            {
                                                "example_id": "3a95ef1a-7281-43a1-9b62-91e013735044",
                                                "sense_id": "d0b1543a-5f0f-3dae-8b69-0273953301a7",
                                                "text": "Der zwanghafte Zusammenhalt wird als Quarkeinschluss (englisch: confinement) bezeichnet und könnte mit bestimmten Eigenschaften – so genannten Farbladungen – der Quarks zusammenhängen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a608d7df-dd20-4482-ad28-bc4d106ba298",
                        "source_entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "source_sense_id": "3fe4d6fa-1f50-3fa4-9d8d-d65d3b0acc05",
                        "source_sense_description": "een onderlinge aantrekking van moleculen van een zelfde stof",
                        "target_lang_word": "cohesion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohesion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "State of cohering, or of working together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259a97b7-260e-4f20-a883-aecec30f8d16",
                                                "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                                "text": "Unit cohesion is important in the military."
                                            },
                                            {
                                                "example_id": "58847954-4fb0-4b2b-a0d2-5d6274ed64b6",
                                                "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                                "text": "For divers reasons, the capitalist class lacks this cohesion or solidarity, chief among which is the optimism bred of past success. And, again, the capitalist class is divided; it has within itself a class struggle of no mean proportions, which tends to irritate and harass it and to confuse the situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c724036-2476-3d29-8270-760526b0b594",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Various intermolecular forces that hold solids and liquids together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61bd1986-0529-3415-a7cb-c4fa8b726e96",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Growing together of normally distinct parts of a plant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ecf54ad-aa02-3a32-af2b-2e3bbe6f6580",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Degree to which functionally related elements in a system belong together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156d2406-b150-4aa3-a82b-e967fc88caf7",
                                                "sense_id": "8ecf54ad-aa02-3a32-af2b-2e3bbe6f6580",
                                                "text": "In general, it is neither advisable nor possible to create such maximally cohesive classes; on the other hand, we would like cohesion to be high. When cohesion is high, it means that the methods and variables of the class are co-dependent and hang together as a logical whole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdb4002-2d57-3889-8be6-e56d0271fd66",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Grammatical or lexical relationship between different parts of the same text."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81ad37b3-0bc7-4dde-a9c8-72de21296bd4",
                        "source_entry_id": "475e7c87-593b-3b04-805d-2cc86e3dcb02",
                        "source_sense_id": "3fe4d6fa-1f50-3fa4-9d8d-d65d3b0acc05",
                        "source_sense_description": "een onderlinge aantrekking van moleculen van een zelfde stof",
                        "target_lang_word": "cohésion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohésion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6e1ae0-6bca-3ab1-b7f7-644dcde6b0c6",
                                        "entry_id": "87f4e83a-57e6-3e4a-89f2-0ac989e7eb30",
                                        "glosses": [
                                            "Force par laquelle les parties d’un corps adhèrent entre elles."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d183ad-2652-4ba1-9899-ce6882bf55f6",
                                                "sense_id": "1e6e1ae0-6bca-3ab1-b7f7-644dcde6b0c6",
                                                "text": "La cohésion est plus forte dans les corps solides que dans les corps liquides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                        "entry_id": "87f4e83a-57e6-3e4a-89f2-0ac989e7eb30",
                                        "glosses": [
                                            "Fait de rester ensemble, unis."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7792c1d5-3c79-42cf-b936-9564fd620cf8",
                                                "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                                "text": "Mais ce territoire d’un demi-million de kilomètres carrés de surface, dont la population est estimée à une dizaine de millions d’habitants, est loin d’avoir la cohésion d’un État européen, et l’autorité effective des sultans ne s’est jamais étendue qu’à un tiers, tout au plus, du Maroc."
                                            },
                                            {
                                                "example_id": "c515a3bf-a96e-469f-8380-d0a31736caa3",
                                                "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                                "text": "La compréhension des liens entre la cohésion territoriale et la cohésion sociale est un défi majeur pour les politiques publiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
