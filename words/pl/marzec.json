                    "sense_definition": "trzeci miesiąc roku kalendarzowego, następujący po lutym i poprzedzający kwiecień",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "months",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>marcu</w> dni stają się coraz dłuższe i cieplejsze.",
                            "target_lang_translations": {
                                "ru": "В <w>марте</w> дни становятся всё длиннее и теплее.",
                                "en": "In <w>March</w>, the days become longer and warmer.",
                                "nl": "In <w>maart</w> worden de dagen steeds langer en warmer.",
                                "de": "Im <w>März</w> werden die Tage immer länger und wärmer.",
                                "fr": "En <w>mars</w>, les journées deviennent de plus en plus longues et plus chaudes.",
                                "it": "A <w>marzo</w> le giornate diventano sempre più lunghe e più calde.",
                                "cs": "V <w>březnu</w> se dny stávají čím dál delšími a teplejšími.",
                                "tr": "<w>Martta</w> günler giderek uzar ve ısınır.",
                                "es": "En <w>marzo</w> los días se vuelven cada vez más largos y más cálidos.",
                                "zh": "在<w>三月</w>，白天变得越来越长，也越来越温暖。"
                            }
                        },
                        {
                            "text": "Kalendarzowa wiosna zaczyna się dwudziestego pierwszego <w>marca</w>.",
                            "target_lang_translations": {
                                "ru": "Календарная весна начинается двадцать первого <w>марта</w>.",
                                "en": "Calendar spring begins on the twenty-first of <w>March</w>.",
                                "nl": "De astronomische lente begint op eenentwintig <w>maart</w>.",
                                "de": "Der kalendarische Frühling beginnt am einundzwanzigsten <w>März</w>.",
                                "fr": "Le printemps calendaire commence le vingt-et-un <w>mars</w>.",
                                "it": "La primavera astronomica inizia il ventuno <w>marzo</w>.",
                                "cs": "Kalendářní jaro začíná dvacátého prvního <w>března</w>.",
                                "tr": "Takvimsel ilkbahar yirmi bir <w>Mart'ta</w> başlar.",
                                "es": "La primavera astronómica comienza el veintiuno de <w>marzo</w>.",
                                "zh": "日历上的春天始于<w>三月</w>二十一日。"
                            }
                        }
                    ],
