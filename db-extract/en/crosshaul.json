    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a93b623a-16f9-3b1a-bfde-1a0afd04ff7e",
                "word": "crosshaul",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "46ff91f7-5272-4d18-abfc-b0e419fda787",
                        "entry_id": "a93b623a-16f9-3b1a-bfde-1a0afd04ff7e",
                        "tags": [
                            "plural"
                        ],
                        "form": "crosshauls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82cab034-a394-3950-9fb6-4498b6e1541d",
                        "entry_id": "a93b623a-16f9-3b1a-bfde-1a0afd04ff7e",
                        "glosses": [
                            "The transportation of goods away from a locality while similar goods are simultaneously transported into the same locality, often resulting in inefficiencies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "01aae1c1-817c-4d1a-ab90-56956b4245c7",
                                "sense_id": "82cab034-a394-3950-9fb6-4498b6e1541d",
                                "text": "In attempting both to define the nature of the crosshaul and to arrive at a quantitative measurement of its effects, comparison may be made of the freights actually paid with those that would be paid were the movement from mills freightwise nearest."
                            },
                            {
                                "example_id": "1943ae12-e0fd-4bed-800c-64fe9c7abb0f",
                                "sense_id": "82cab034-a394-3950-9fb6-4498b6e1541d",
                                "text": "Since June 1, 1935, however, applicant has curtailed his cross-haul operation, as indicated by the fact that during a similar 5-month period in 1936 he transported only about 35 cross-haul shipments out of a total of approximately 1,400 shipments, and during similar periods in 1937 and 1938 he transported only 7 cross-haul shipments out of approximately 1,100 shipments, and only 6 out of approximately 1,325 shipments respectively."
                            },
                            {
                                "example_id": "8bd6b945-abb9-4136-b4f4-d3c1d8c93074",
                                "sense_id": "82cab034-a394-3950-9fb6-4498b6e1541d",
                                "text": "Because the reverse was true with respect to the small proportion of large mills in these regions, the average degree of crosshaul would tend to decline sharply as the size of crush increased."
                            },
                            {
                                "example_id": "3146a27c-5bd7-45f1-894d-4e5556b775a3",
                                "sense_id": "82cab034-a394-3950-9fb6-4498b6e1541d",
                                "text": "It was explained that the report indicated that a total saving of 98 T-2's would be available if the identified crosshauls had been or were eliminated for the 3rd Quarter."
                            }
                        ]
                    },
                    {
                        "sense_id": "de017d56-b34e-30ff-8155-d66f89c3deee",
                        "entry_id": "a93b623a-16f9-3b1a-bfde-1a0afd04ff7e",
                        "glosses": [
                            "A method of shifting cargo or rigging by moving it across rather than along the length of a vessel."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "893548d4-5901-4aa8-b636-723e8f691a7c",
                                "sense_id": "de017d56-b34e-30ff-8155-d66f89c3deee",
                                "text": "If you don't have a second track for your headsail's lead, a second line, like a Barberhauler or crosshaul, can redirect a lead ourboard or inboard, respectively."
                            },
                            {
                                "example_id": "62a44de7-707b-4e64-86ff-965174ae6d1f",
                                "sense_id": "de017d56-b34e-30ff-8155-d66f89c3deee",
                                "text": "A crosshaul connects to the sheet or clew and pulls the lead inboard."
                            },
                            {
                                "example_id": "5e395e63-a060-41b9-8d17-fb14ad27487c",
                                "sense_id": "de017d56-b34e-30ff-8155-d66f89c3deee",
                                "text": "Mainsheet control is through a mainsheet traveller with roller bearing car and crosshaul tackle recessed into the bridge deck."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
