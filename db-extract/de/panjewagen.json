                ],
                "senses": [
                    {
                        "sense_id": "972f8652-4ad3-382d-906b-fab6c3c6e5ac",
                        "entry_id": "9e22baa1-3817-3c7a-8e14-41329f2f4088",
                        "glosses": [
                            "„kleiner, einfacher, von einem Pferd gezogener Wagen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68fea67-691b-4cb7-9423-73e31f5ef3a3",
                                "sense_id": "972f8652-4ad3-382d-906b-fab6c3c6e5ac",
                                "text": "„Die Panjewagen sind im Kreis aufgestellt, die Pferde ausgeschirrt an Kiefern gebunden, und in der Mitte sitzen sie ums Feuer herum, rauchen, trinken und kochen Suppe.“"
                            },
                            {
                                "example_id": "448929ee-7bdb-41e3-ad58-2bd8d6e55bca",
                                "sense_id": "972f8652-4ad3-382d-906b-fab6c3c6e5ac",
                                "text": "„Vor einen Panjewagen spannt er ein Pferd, lässt die kleinsten Kinder abwechselnd auf dem Wagen sitzen.“"
                            },
                            {
                                "example_id": "cf0e7906-8993-44b1-97b0-512e5ff7d054",
                                "sense_id": "972f8652-4ad3-382d-906b-fab6c3c6e5ac",
                                "text": "„Am 8. Mai kamen Soldaten in einem Panjewagen auch nach Müggenburg.“"
                            },
                            {
                                "example_id": "a5ae2c85-24a1-4392-9596-620d26cd1f16",
                                "sense_id": "972f8652-4ad3-382d-906b-fab6c3c6e5ac",
                                "text": "„Im brennenden Berlin wurde sie auf Panjewagen verladen, leichte, oft gummibereifte Pferdewagen ohne Verdecke, die damals allgegenwärtig waren, und dann mit dem Güterwagen nach Posen verfrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
