                ],
                "senses": [
                    {
                        "sense_id": "22cb576e-d66a-3237-bf10-d61589beaf5d",
                        "entry_id": "00b7b5cd-b10e-3e9d-af3a-a7272082663f",
                        "glosses": [
                            "Ronfler doucement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72a3c45-3430-48ed-8d38-abf32a5a8c83",
                                "sense_id": "22cb576e-d66a-3237-bf10-d61589beaf5d",
                                "text": "Camille ouvre ses yeux sur la nuit. François ronflote."
                            },
                            {
                                "example_id": "923c690f-bca7-43e9-8401-eef97dd0d323",
                                "sense_id": "22cb576e-d66a-3237-bf10-d61589beaf5d",
                                "text": "Dans une heure, cette neige toute mouillée aura disparu et Louis que j’entends ronfloter benoîtement dans notre chambre l’aura ratée."
                            },
                            {
                                "example_id": "80800c87-22b4-427b-95cf-cce777485d4e",
                                "sense_id": "22cb576e-d66a-3237-bf10-d61589beaf5d",
                                "text": "Vivement ! cria Claudine à Mme Jean qui, en attendant l’achèvement de la coiffure, s’était mise à ronfloter sur la banquette."
                            },
                            {
                                "example_id": "c1f0fb8e-1583-495f-8aa6-5ed4629dd87f",
                                "sense_id": "22cb576e-d66a-3237-bf10-d61589beaf5d",
                                "text": "À peine en boule, Hodor se mit à ronfloter."
                            }
                        ]
                    }
                ],
