                ],
                "senses": [
                    {
                        "sense_id": "14eb59e8-d4fe-3c85-a99a-0ef6e85e0fbe",
                        "entry_id": "f48bb933-2e5c-3858-b21c-e828908dbd17",
                        "glosses": [
                            "Qui traduit un sentiment de concupiscence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec07eb9-9e3e-4165-ad8d-7ef9c269c7e8",
                                "sense_id": "14eb59e8-d4fe-3c85-a99a-0ef6e85e0fbe",
                                "text": "Ma femme est, soit dit en passant\nD’un naturel concupiscent\nQui l’incite à se coucher nue\nSous le premier venu."
                            },
                            {
                                "example_id": "00fd63c5-dbf1-452e-b768-664b7be9ae2b",
                                "sense_id": "14eb59e8-d4fe-3c85-a99a-0ef6e85e0fbe",
                                "text": "Confondant plaisir charnel et désir de connaissance, tel un Actéon concupiscent, il se heurte à l’image du corps nu de Diane et ne sait pas voir plus loin."
                            },
                            {
                                "example_id": "c054c305-9d1a-4439-a1b6-3bd2669c2551",
                                "sense_id": "14eb59e8-d4fe-3c85-a99a-0ef6e85e0fbe",
                                "text": "Agressif ou flatteur, impromptu ou acharné, le dragueur égrène tout au long de son infructueuse quête sa concupiscente litanie. On presse alors le pas, tête baissée, découragée et battue, tristement ramenée à son humiliante condition de femme […]."
                            },
                            {
                                "example_id": "fbc2b61e-78f1-4f2a-a4f2-84d9cf086b75",
                                "sense_id": "14eb59e8-d4fe-3c85-a99a-0ef6e85e0fbe",
                                "text": "Et, désignant Henri, il l'accusa à son tour :\n– Incestueux, fornicateur, concupiscent! Qui es-tu pour plaider contre moi?"
                            }
                        ]
                    }
                ],
