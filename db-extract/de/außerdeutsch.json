                "senses": [
                    {
                        "sense_id": "7e749eb2-d3be-3e83-8c31-221f004401f2",
                        "entry_id": "121d764f-ac8a-30a5-ac09-4b743e1ef9c4",
                        "glosses": [
                            "nicht innerhalb der Grenzen Deutschlands; außerhalb des Sprachgebietes, in dem Deutsch gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24610e7-89c4-4926-a51c-3aa0ce7c6de4",
                                "sense_id": "7e749eb2-d3be-3e83-8c31-221f004401f2",
                                "text": "Bei der Frage, ob ein Wagen außerdeutsch ist, ist die Staatsangehörigkeit seines Halters egal, es kommt auf das Land an, in dem das Kfz zugelassen ist."
                            },
                            {
                                "example_id": "48d760ca-dfe7-4a35-9b58-1a3f7757ad9d",
                                "sense_id": "7e749eb2-d3be-3e83-8c31-221f004401f2",
                                "text": "Der Frachter verkehrt zwischen deutschen und außerdeutschen Häfen."
                            }
