                        "glosses": [
                            "Celui qui joue à la belote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166ace3e-9bbd-45d3-957a-dc385adf71c6",
                                "sense_id": "dae15f70-203a-3c40-b225-5f4d19b63ebb",
                                "text": "Pour la forme, je me suis laissé bousculer par des beloteurs à boutons d’argent, dont j’interrompais la partie sur la banquette arrière."
                            },
                            {
                                "example_id": "bb63422d-a20d-4038-90a7-cc2289111137",
                                "sense_id": "dae15f70-203a-3c40-b225-5f4d19b63ebb",
                                "text": "Je ressers le Muppets Show et je suis à toi, me confia-t-il à mi-voix en glissant le long du comptoir, une bouteille de blanc à la main, le carburant usuel des beloteurs."
                            },
                            {
                                "example_id": "9371235e-eccb-47f8-a790-473baab6dea9",
                                "sense_id": "dae15f70-203a-3c40-b225-5f4d19b63ebb",
                                "text": "Souvent, c’était le « rouge limé » (mélange de vin rouge et de limonade) qui avait la faveur des beloteurs."
                            }
                        ]
                    }
