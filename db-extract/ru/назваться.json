                                "target_senses": [
                                    {
                                        "sense_id": "3f9169aa-06c9-3937-ba47-682bde097073",
                                        "entry_id": "80d40ad9-5c22-3ea3-bc46-4aca21461e5e",
                                        "glosses": [
                                            "Paraître devant quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d653599-65ca-4a5f-8933-e990657b8df4",
                                                "sense_id": "3f9169aa-06c9-3937-ba47-682bde097073",
                                                "text": "En 1240, ce jeune vicomte Raymond de Trincavel, […] s’empare, sans se heurter à une sérieuse résistance, des châteaux de Montréal, des villes de Montolieu, de Saissac, de Limoux, d’Azillan, de Laurens et se présente devant Carcassonne."
                                            },
                                            {
                                                "example_id": "af1e6268-992e-4a1d-a408-18c3f7520131",
                                                "sense_id": "3f9169aa-06c9-3937-ba47-682bde097073",
                                                "text": "J’ai si souvent fait buisson creux, dans mes tentatives précédentes, que je n’ose plus me présenter au guichet de la gare. À quoi bon ?"
                                            },
                                            {
                                                "example_id": "a3421b20-e661-49f8-8ab3-807e9e69d04b",
                                                "sense_id": "3f9169aa-06c9-3937-ba47-682bde097073",
                                                "text": "Sur une invitation du commissaire, ils s’étaient présentés au poste de la rue de la Gaîté où on les avait longuement interrogés."
                                            },
                                            {
                                                "example_id": "da88216a-2b22-457e-96a3-5252c34edb0b",
                                                "sense_id": "3f9169aa-06c9-3937-ba47-682bde097073",
                                                "text": "Cette personne se présente bien, se présente avec grâce, Elle n’est pas embarrassée, elle a de l’aisance, de la grâce dans le maintien, dans les manières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46a0d82-5d05-3c23-8a0b-469cfb21bbf0",
                                        "entry_id": "80d40ad9-5c22-3ea3-bc46-4aca21461e5e",
                                        "glosses": [
                                            "Apparaître, en parlant d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738e0e62-e153-4241-9b93-0316727df338",
                                                "sense_id": "d46a0d82-5d05-3c23-8a0b-469cfb21bbf0",
                                                "text": "Un pareil crime, si près du commissariat, en bordure du passage où le meurtrier risquait à son insu d’être surpris, se présentait, de prime abord, comme l’acte d’un fou, […]."
                                            },
                                            {
                                                "example_id": "8bdfaa19-3bc3-4195-9aae-d80503ba33bb",
                                                "sense_id": "d46a0d82-5d05-3c23-8a0b-469cfb21bbf0",
                                                "text": "Le diaspore, de structure analogue (l'aluminium remplaçant le fer), se présente en cristaux lamellaires parfaitement clivables (parfois taillés pour la bijouterie, malgré leur fragilité) donnant des lamelles flexibles, et en agrégats écailleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bcb2f89-164c-3680-8cd1-5871f3996db5",
                                        "entry_id": "80d40ad9-5c22-3ea3-bc46-4aca21461e5e",
                                        "glosses": [
                                            "Se dit encore des occasions, des affaires, etc., qui surviennent; et, dans cette acception, il s’emploie souvent impersonnellement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f1a312-93e2-410f-9e35-1df7ec52fc31",
                                                "sense_id": "9bcb2f89-164c-3680-8cd1-5871f3996db5",
                                                "text": "Dès que l’occasion s’en présentera."
                                            },
                                            {
                                                "example_id": "802fc5a8-35c5-463e-9ef2-6659f1c2f82c",
                                                "sense_id": "9bcb2f89-164c-3680-8cd1-5871f3996db5",
                                                "text": "Il se présenta une difficulté, une question difficile à résoudre."
                                            },
                                            {
                                                "example_id": "ffa71d52-83b0-44be-815f-d09d880b3bff",
                                                "sense_id": "9bcb2f89-164c-3680-8cd1-5871f3996db5",
                                                "text": "Une affaire qui se présente bien, Une affaire dont le succès est vraisemblable."
                                            },
                                            {
                                                "example_id": "7ffc701d-5d74-4ded-9e77-89ec1712d7c7",
                                                "sense_id": "9bcb2f89-164c-3680-8cd1-5871f3996db5",
                                                "text": "Ce nom, cette date, etc., ne se présente pas maintenant à ma mémoire, Je ne puis me souvenir présentement de ce nom, de cette date, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732d24a2-fd69-3325-8d6a-5e34df70500a",
                                        "entry_id": "80d40ad9-5c22-3ea3-bc46-4aca21461e5e",
                                        "glosses": [
                                            "Postuler à une élection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
