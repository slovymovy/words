                {
                    "sense_id": "d5315291-688d-3f80-aca5-30195220c753",
                    "sense_definition": "z tego powodu; dlatego",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie było prądu, <w>stąd</w> to całe zamieszanie.",
                            "target_lang_translations": {
                                "ru": "Не было электричества, <w>отсюда</w> и вся эта неразбериха.",
                                "en": "There was no power, <w>hence</w> all this confusion.",
                                "nl": "Er was geen stroom, <w>daarom</w> was er al die verwarring.",
                                "de": "Es gab keinen Strom, <w>daher</w> die ganze Aufregung.",
                                "fr": "Il n'y avait pas d'électricité, <w>d'où</w> toute cette confusion.",
                                "it": "Non c'era corrente, <w>da qui</w> tutta questa confusione.",
                                "cs": "Nebyl proud, <w>odtud</w> ten všechen zmatek.",
                                "tr": "Elektrik yoktu, tüm bu karışıklık <w>bu yüzden</w>.",
                                "es": "No había electricidad, <w>de ahí</w> todo este alboroto.",
                                "zh": "当时停电了，<w>因此</w>才有了这一连串的混乱。"
                            }
                        },
                        {
                            "text": "<w>Stąd</w> wynika, że musimy zmienić nasze plany.",
                            "target_lang_translations": {
                                "ru": "<w>Отсюда</w> следует, что мы должны изменить наши планы.",
                                "en": "<w>From this</w> it follows that we must change our plans.",
                                "nl": "<w>Hieruit</w> volgt dat we onze plannen moeten wijzigen.",
                                "de": "<w>Daraus</w> ergibt sich, dass wir unsere Pläne ändern müssen.",
                                "fr": "<w>D'où</w> il résulte que nous devons changer nos plans.",
                                "it": "<w>Da qui</w> deriva che dobbiamo cambiare i nostri piani.",
                                "cs": "<w>Odtud</w> vyplývá, že musíme změnit naše plány.",
                                "tr": "<w>Buradan</w> çıkan sonuç, planlarımızı değiştirmemiz gerektiğidir.",
                                "es": "<w>De ahí</w> se deduce que debemos cambiar nuestros planes.",
                                "zh": "<w>由此</w>可见，我们必须改变计划。"
                            }
                        }
                    ],
