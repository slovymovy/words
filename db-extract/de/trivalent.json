                        "form": "es ist trivalent"
                    },
                    {
                        "form_id": "9180861b-6e33-4ffa-8ac5-11dc1667c6f1",
                        "entry_id": "c49289c6-7826-3733-a6bb-9689cc9efa59",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind trivalent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                        "entry_id": "c49289c6-7826-3733-a6bb-9689cc9efa59",
                        "glosses": [
                            "gleichzeitig gegen drei unterschiedliche Erreger immunisierend"
                        ],
                        "tags": [
                            "bei Impfstoffen"
                        ],
                        "examples": [
                            {
                                "example_id": "412da22f-31af-4285-a011-3a9ee7f07ae4",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„Doch auch in Europa befand sich Anfang dieses Jahres eine trivalente OspA-Vakzine schon in der zweiten klinischen Testphase und stand damit kurz vor der Zulassung.“"
                            },
                            {
                                "example_id": "7014727f-d041-4e47-8427-85dad7ec1244",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„Weltweit ist die Impfstoff-Industrie derzeit in der Lage, etwa 300 Millionen ‚trivalente‘ Impfstoffdosen pro Jahr zu produzieren.“"
                            },
                            {
                                "example_id": "2f2c4bc9-99e7-409b-a665-d5cf94f5ecd2",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„Bei beiden Verfahren wird nach Ablauf von 2 Jahren eine trivalente Ergänzungsimpfung empfohlen.“"
                            },
                            {
                                "example_id": "3f81ad27-a89b-4b54-844f-e55730eaa2e2",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„In diesem Jahr schützt der am häufigsten verwendete trivalente Impfstoff immerhin fast die Hälfte (46 Prozent) der Geimpften vor einer Infektion.“"
                            },
                            {
                                "example_id": "b3334ad6-377e-4dc6-ae53-9e4fdf8f2452",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„Bei allen dreien handelt es sich um sogenannte trivalente Impfstoffe, in denen drei verschiedene Subtypen des Influenza-Virus enthalten sind.“"
                            },
                            {
                                "example_id": "153eabf0-249d-4281-bf3a-cdc32007d5a7",
                                "sense_id": "478f1c8a-6c21-313e-8023-6441598d46e2",
                                "text": "„Die WHO hat inzwischen reagiert und empfiehlt seit 2013 nicht nur das gängige trivalente Serum H1N1 plus H3N2 plus einmal Influenza B, sondern zusätzlich ein tetravalentes Vierfach-Serum, das beide B-Stämme enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42f907fc-938d-397d-96bc-c6e2ff78e9eb",
                        "entry_id": "c49289c6-7826-3733-a6bb-9689cc9efa59",
                        "glosses": [
                            "zu einer chemischen Bindung mit drei Atomen fähig"
                        ],
                        "tags": [
                            "bei einem Atom"
                        ],
                        "examples": [
                            {
                                "example_id": "389bbe57-fb80-4a6c-895c-702949621633",
                                "sense_id": "42f907fc-938d-397d-96bc-c6e2ff78e9eb",
                                "text": "„Das trivalente Antimon wird innerhalb der ersten 2 Stunden nach der Einnahme zu 95 % in Erythrozyten aufgenommen und damit vorwiegend in stark durchbluteten Organen angereichert.“"
                            },
                            {
                                "example_id": "1c0d9416-ee1a-4b2b-93eb-75545bcf8ca2",
                                "sense_id": "42f907fc-938d-397d-96bc-c6e2ff78e9eb",
                                "text": "„Treponema wird schnell durch trivalente Arsenverbindungen, Quecksilber und Wismut immobilisiert und abgetötet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f3794ea1-bf5d-3f84-b50c-90f7868b1099",
                        "entry_id": "c49289c6-7826-3733-a6bb-9689cc9efa59",
                        "glosses": [
                            "drei obligatorische Aktanten habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "204ee912-46d1-416c-aa82-e748bff4e95b",
                                "sense_id": "f3794ea1-bf5d-3f84-b50c-90f7868b1099",
                                "text": "„Es gibt, grob gesprochen, avalente Verben ohne Aktanten (regnen), monovalente (schlafen, wandern), transitive (schlagen, töten) und trivalente Verben (geben, sagen).“"
                            },
                            {
                                "example_id": "f405a917-98d4-47db-973e-60c25aed669d",
                                "sense_id": "f3794ea1-bf5d-3f84-b50c-90f7868b1099",
                                "text": "„wéi verschriftet hier ein trivalentes Verb mit der Bedeutung 'X tut Y für Z'.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
