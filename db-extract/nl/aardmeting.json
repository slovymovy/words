                                            {
                                                "example_id": "08d049ff-866e-4f3e-8797-091fcaa6462d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Geodäsie sei weit mehr als Landvermessung und schließe die Geoinformatik, also zum Beispiel Satelliten-Navigation, mit ein."
                                            },
                                            {
                                                "example_id": "5ef07ca9-0492-443e-8e90-3714abee6fb4",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Zwischen 1816 und 1841 vermaß er das gesamte Königreich Hannover, trotz modernster Methoden der Geodäsie ein ermüdendes Tagwerk."
                                            },
                                            {
                                                "example_id": "37516519-fccd-42a9-8bf7-13c2aba63f7d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "In den letzten 20 Jahren stieg der Pegel mit etwa drei Millimeter pro Jahr doppelt so schnell wie im Durchschnitt. Das berichten Forscher vom Institut für Planetare Geodäsie in Dresden."
                                            }
