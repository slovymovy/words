                "entry_id": "a388328f-2224-39e6-bab4-badaa183688e",
                "word": "springald",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "40b88043-fb2a-47ca-88ac-3d3402ba8a0b",
                        "entry_id": "a388328f-2224-39e6-bab4-badaa183688e",
                        "tags": [
                            "plural"
                        ],
