            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b2b5d25-04ef-304a-b419-eef585a2973c",
                    "sense_definition": "Groupe fermé manipulant ou exploitant ses adeptes sous l'autorité d'un gourou ou de dirigeants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police surveille cette <w>secte</w> dangereuse soupçonnée de manipuler psychologiquement ses fidèles."
                        },
                        {
                            "text": "Après plusieurs années sous emprise, elle a enfin réussi à quitter une <w>secte</w> autoritaire."
                        }
                    ],
                    "common_phrases": [
                        "entrer dans une secte",
                        "quitter une secte"
                    ]
                },
                {
                    "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                    "sense_definition": "Groupe religieux minoritaire ou dissident qui s'est séparé d'une religion établie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite communauté s'est détachée de l'Église principale pour former une <w>secte</w> indépendante."
                        },
                        {
                            "text": "Au dix-septième siècle, plusieurs <w>sectes</w> dissidentes se sont développées en marge des religions établies."
                        }
                    ],
                    "common_phrases": [
                        "secte religieuse",
                        "sectes dissidentes"
                    ]
                },
                {
                    "sense_id": "c0df7eed-fc9f-3242-800a-28699f064eb1",
                    "sense_definition": "Ensemble de personnes qui partagent et suivent une même doctrine philosophique ou intellectuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'Antiquité, la <w>secte</w> des stoïciens rassemblait de nombreux disciples dévoués à leur maître."
                        },
                        {
                            "text": "Ce philosophe rejetait l'idée d'appartenir à une <w>secte</w> philosophique fermée aux idées nouvelles."
                        }
                    ],
                    "synonyms": [
                        "courant",
                        "école"
                    ],
                    "common_phrases": [
                        "secte philosophique"
                    ],
