                "senses": [
                    {
                        "sense_id": "f7de0e69-6a01-3011-9954-c168fb89b4ee",
                        "entry_id": "8acd4422-e727-319a-a0ce-4121f7966e24",
                        "glosses": [
                            "Not mirthful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab1b587-6acc-408a-a7ed-643766fb4347",
                                "sense_id": "f7de0e69-6a01-3011-9954-c168fb89b4ee",
                                "text": "Through the chinks of my fingers, dolorously spread over my face, I see that he has sat down on the other side of the table, just opposite me, and that he is smiling in the same unmirthful, gently sarcastic way, as he was when he left me."
                            },
                            {
                                "example_id": "83dabf3f-c9eb-4f39-9e09-7737a3611575",
                                "sense_id": "f7de0e69-6a01-3011-9954-c168fb89b4ee",
                                "text": "As she gazed, an unmirthful smile spread over her features, like sunshine that grows melancholy in some desolate spot."
                            }
                        ]
                    }
                ],
                "translations": [],
