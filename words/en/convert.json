{
    "word_family": [
        "conversion",
        "converter",
        "convertible",
        "reconvert"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5333037a-6ce6-3ba6-b6d1-2b18bd9e5ca3",
                    "sense_definition": "To transform or change something into another form, substance, state, or product.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plants use solar energy to <w>convert</w> carbon dioxide into oxygen.",
                            "target_lang_translations": {
                                "ru": "Растения используют солнечную энергию, чтобы <w>превращать</w> углекислый газ в кислород."
                            }
                        },
                        {
                            "text": "The new factory will <w>convert</w> raw materials into finished goods for export.",
                            "target_lang_translations": {
                                "ru": "Новый завод будет <w>перерабатывать</w> сырье в готовую продукцию для экспорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "develop",
                        "evolve",
                        "shift"
                    ],
                    "common_phrases": [
                        "convert into steam",
                        "convert into energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать или изменять что-либо в другую форму, вещество, состояние или продукт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превращать",
                                "target_lang_sense_clarification": "в другую форму или состояние"
                            },
                            {
                                "target_lang_word": "преобразовывать",
                                "target_lang_sense_clarification": "вносить изменения в структуру"
                            },
                            {
                                "target_lang_word": "трансформировать",
                                "target_lang_sense_clarification": "видоизменять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30359029-07b3-3f6f-b601-936c8133cb35",
                    "sense_definition": "To exchange money or assets for something of equal value, such as a different currency.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>convert</w> our pounds into euros before we leave for Paris.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>обменять</w> наши фунты на евро перед отъездом в Париж."
                            }
                        },
                        {
                            "text": "You can <w>convert</w> currency at the airport, but the rates are usually better at a bank.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>конвертировать</w> валюту в аэропорту, но в банке курсы обычно лучше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert pounds into euros",
                        "convert currency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обменивать деньги или активы на что-либо равной стоимости, например, на другую валюту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертировать",
                                "target_lang_sense_clarification": "валюту или форматы"
                            },
                            {
                                "target_lang_word": "обменивать",
                                "target_lang_sense_clarification": "деньги"
                            },
                            {
                                "target_lang_word": "переводить",
                                "target_lang_sense_clarification": "из одной валюты в другую"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "549a36d6-13ea-3082-83b8-061d82c7a6b2",
                    "sense_definition": "To change something from one use, function, or purpose to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to <w>convert</w> their garden into a tennis court.",
                            "target_lang_translations": {
                                "ru": "Семья решила <w>переделать</w> свой сад в теннисный корт."
                            }
                        },
                        {
                            "text": "They plan to <w>convert</w> the old warehouse into modern luxury apartments.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>переоборудовать</w> старый склад в современные роскошные апартаменты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert into apartments",
                        "convert for use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять назначение, функцию или цель использования чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переоборудовать",
                                "target_lang_sense_clarification": "помещение или устройство"
                            },
                            {
                                "target_lang_word": "переделывать",
                                "target_lang_sense_clarification": "под другие нужды"
                            },
                            {
                                "target_lang_word": "превращать",
                                "target_lang_sense_clarification": "один объект в другой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e448fe38-89c3-3f07-94d9-a9b41ffa854f",
                    "sense_definition": "To express a quantity or unit of measurement in terms of another unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you show me how to <w>convert</w> feet into metres?",
                            "target_lang_translations": {
                                "ru": "Можешь показать мне, как <w>переводить</w> футы в метры?"
                            }
                        },
                        {
                            "text": "The app helps you <w>convert</w> Celsius to Fahrenheit quickly.",
                            "target_lang_translations": {
                                "ru": "Приложение помогает быстро <w>пересчитывать</w> градусы Цельсия в Фаренгейты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert feet into metres",
                        "convert units"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать величину или единицу измерения в других единицах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переводить",
                                "target_lang_sense_clarification": "единицы измерения"
                            },
                            {
                                "target_lang_word": "пересчитывать",
                                "target_lang_sense_clarification": "в другие единицы"
                            },
                            {
                                "target_lang_word": "конвертировать",
                                "target_lang_sense_clarification": "значения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "513fdd2c-e7cf-3ea4-b76e-d73526c141b9",
                    "sense_definition": "To undergo a change of religion, faith, or belief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of study, he decided to <w>convert</w> to Buddhism.",
                            "target_lang_translations": {
                                "ru": "После многих лет изучения он решил <w>перейти</w> в буддизм."
                            }
                        },
                        {
                            "text": "Many people <w>convert</w> to a new religion after a significant life event.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>принимают</w> новую религию после значимого жизненного события."
                            }
                        }
                    ],
                    "antonyms": [
                        "deconvert"
                    ],
                    "common_phrases": [
                        "convert to Christianity",
                        "convert to Islam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать другую религию, веру или убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "в другую веру"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "в религию"
                            },
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "новую веру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b68747e-8c18-300c-b3ec-2b40e52ff0c1",
                    "sense_definition": "To persuade or induce someone to adopt a particular religion, ideology, or belief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The missionaries worked hard to <w>convert</w> the local population.",
                            "target_lang_translations": {
                                "ru": "Миссионеры усердно работали над тем, чтобы <w>обратить</w> местное население в свою веру."
                            }
                        },
                        {
                            "text": "It is difficult to <w>convert</w> someone who has very strong political views.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>переубедить</w> того, у кого очень сильные политические взгляды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert the masses",
                        "convert to a cause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убеждать или склонять кого-либо к принятию определенной религии, идеологии или веры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращать",
                                "target_lang_sense_clarification": "в свою веру"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "к убеждениям"
                            },
                            {
                                "target_lang_word": "вербовать",
                                "target_lang_sense_clarification": "сторонников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27715323-decb-32c1-948d-55826560e4b7",
                    "sense_definition": "To be able to be changed into another form or function.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This sofa <w>converts</w> into a bed for guests.",
                            "target_lang_translations": {
                                "ru": "Этот диван <w>раскладывается</w> в кровать для гостей."
                            }
                        },
                        {
                            "text": "The chair <w>converts</w> into a small table when needed.",
                            "target_lang_translations": {
                                "ru": "Стул <w>трансформируется</w> в маленький столик, когда это необходимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert into a bed",
                        "convert easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь возможность трансформироваться в другую форму или функцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превращаться",
                                "target_lang_sense_clarification": "становиться чем-то другим"
                            },
                            {
                                "target_lang_word": "раскладываться",
                                "target_lang_sense_clarification": "о мебели"
                            },
                            {
                                "target_lang_word": "трансформироваться",
                                "target_lang_sense_clarification": "менять форму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed37d01f-74a5-335f-9dbc-a32b33b2b074",
                    "sense_definition": "To successfully score, especially from a penalty kick or a specific opportunity in sports.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker managed to <w>convert</w> the penalty in the final minute of the game.",
                            "target_lang_translations": {
                                "ru": "Нападающему удалось <w>реализовать</w> пенальти на последней минуте игры."
                            }
                        },
                        {
                            "text": "He <w>converted</w> from close range after a perfect pass from his teammate.",
                            "target_lang_translations": {
                                "ru": "Он <w>забил</w> с близкого расстояния после идеальной передачи партнера по команде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert the penalty",
                        "convert a chance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно реализовать момент, особенно забить гол с пенальти или другой возможности в спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реализовать",
                                "target_lang_sense_clarification": "момент или пенальти"
                            },
                            {
                                "target_lang_word": "реализовывать",
                                "target_lang_sense_clarification": "шанс"
                            },
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "гол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74848e98-70a1-334a-aba7-88cb5fedcf18",
                    "sense_definition": "To transform a material or positional advantage into a victory in a game like chess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite having an extra pawn, he couldn't <w>convert</w> the advantage into a win.",
                            "target_lang_translations": {
                                "ru": "Несмотря на лишнюю пешку, он не смог <w>реализовать</w> преимущество и победить."
                            }
                        },
                        {
                            "text": "The grandmaster showed great skill to <w>convert</w> the endgame.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер проявил большое мастерство, чтобы <w>довести</w> эндшпиль до победы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert an advantage",
                        "convert the win"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать материальное или позиционное преимущество в победу в таких играх, как шахматы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реализовывать",
                                "target_lang_sense_clarification": "преимущество"
                            },
                            {
                                "target_lang_word": "доводить до победы",
                                "target_lang_sense_clarification": "партию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f9bbf2-87d2-3c1b-a079-205dd1f7446e",
                    "sense_definition": "To perform the action that an online advertisement is intended to induce, such as making a purchase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team is looking for ways to make more visitors <w>convert</w> on the website.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда ищет способы заставить больше посетителей <w>совершать покупки</w> на сайте."
                            }
                        },
                        {
                            "text": "We track how many users <w>convert</w> after clicking on the social media ad.",
                            "target_lang_translations": {
                                "ru": "Мы отслеживаем, сколько пользователей <w>конвертируется</w> после клика по рекламе в социальных сетях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert visitors",
                        "convert leads"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in digital marketing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять целевое действие, на которое направлена интернет-реклама, например, совершать покупку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертироваться",
                                "target_lang_sense_clarification": "о посетителе сайта"
                            },
                            {
                                "target_lang_word": "совершать целевое действие",
                                "target_lang_sense_clarification": "в маркетинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "798fe035-1f62-3e9c-8cdd-69a8fd16fc4c",
                    "sense_definition": "To appropriate property or funds wrongfully or unlawfully for one's own use.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official was accused of trying to <w>convert</w> public funds for personal gain.",
                            "target_lang_translations": {
                                "ru": "Чиновника обвинили в попытке <w>присвоить</w> государственные средства в личных целях."
                            }
                        },
                        {
                            "text": "It is a crime to <w>convert</w> someone else's property to your own use.",
                            "target_lang_translations": {
                                "ru": "Присвоение чужого имущества для собственного использования является <w>преступлением</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert funds",
                        "convert property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно присваивать чужое имущество или средства для собственного использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присваивать",
                                "target_lang_sense_clarification": "чужие средства"
                            },
                            {
                                "target_lang_word": "обращать в свою пользу",
                                "target_lang_sense_clarification": "имущество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35db6e38-818b-3a8a-8a47-03a1d00e15f7",
                    "sense_definition": "A person who has changed their religious faith or beliefs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a recent <w>convert</w> to Buddhism and attends meetings every week.",
                            "target_lang_translations": {
                                "ru": "Она недавно <w>приняла</w> буддизм и каждую неделю посещает собрания."
                            }
                        },
                        {
                            "text": "The community welcomed the new <w>converts</w> with a special ceremony.",
                            "target_lang_translations": {
                                "ru": "Община приветствовала <w>новообращённых</w> специальной церемонией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convert to Islam",
                        "recent convert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, сменивший свою религиозную веру или убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новообращённый",
                                "target_lang_sense_clarification": "принявший новую веру"
                            },
                            {
                                "target_lang_word": "неофит",
                                "target_lang_sense_clarification": "новый последователь"
                            },
                            {
                                "target_lang_word": "прозелит",
                                "target_lang_sense_clarification": "человек, принявший новую религию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79535cb8-cfaa-385b-8e40-104532a985f6",
                    "sense_definition": "A person who now supports or likes something they previously disliked or opposed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used to hate running, but now I am a total <w>convert</w>.",
                            "target_lang_translations": {
                                "ru": "Раньше я ненавидел бег, но теперь я его ярый <w>поклонник</w>."
                            }
                        },
                        {
                            "text": "After seeing the benefits of the new system, he became a <w>convert</w>.",
                            "target_lang_translations": {
                                "ru": "Увидев преимущества новой системы, он стал её <w>сторонником</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "total convert",
                        "convert to the cause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который стал поддерживать или любить то, что раньше ему не нравилось."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новоиспеченный сторонник",
                                "target_lang_sense_clarification": "нового увлечения"
                            },
                            {
                                "target_lang_word": "приверженец",
                                "target_lang_sense_clarification": "идеи или дела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}