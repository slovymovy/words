                    {
                        "translation_id": "c346d239-77a9-440f-82ef-12edd71b30fc",
                        "source_entry_id": "a85204c2-7b3f-32c9-883f-339e68474f3f",
                        "source_sense_id": "84fe46a8-3195-3c5f-b45e-526fc22a8185",
                        "source_sense_description": "oberer Teil eines Anschreibens, in dem Informationen zu Absender und Empfänger stehen",
                        "target_lang_word": "briefhoofd",
