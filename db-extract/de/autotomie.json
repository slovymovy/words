                        "source_sense_description": "Biologie, speziell Zoologie: Abwerfen von Körperteilen bei Bedrohung, die meist wieder nachwachsen",
                        "target_lang_word": "autotomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autotomy",
