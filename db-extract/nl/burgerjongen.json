                        "glosses": [
                            "jonge man uit de burgerlijke, en dus niet-adelijke, standx1"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5621be9c-a48c-49f4-933e-dd65bb36e36a",
                                "sense_id": "14804068-96b0-3360-8ced-5da7ed1592e4",
                                "text": "Hij was van Franse origine, een armoedzaaier, die blij was met een afgelegde jas, een stille verlegen burgerjongen ."
                            },
                            {
                                "example_id": "e54d2de3-ff66-4a06-ac12-b7c6c43a70c6",
                                "sense_id": "14804068-96b0-3360-8ced-5da7ed1592e4",
                                "text": "Morgen stapt de Japanse prinses Mako (30) in het huwelijksbootje met haar tienerliefde en verloofde Kei Komuro (30). Een burgerjongen die trouwt met een prinses klinkt als een sprookje, maar de Japanners vinden het maar niets dat de prinses haar titel opgeeft voor de liefde."
                            }
                        ]
                    }
