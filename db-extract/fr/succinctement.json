        "fr-extract.jsonl": [
            {
                "entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                "word": "succinctement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ead6da35-6609-4778-80b7-430fec133f3b",
                        "entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "tags": [],
                        "form": "succintement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2147d9c-ef45-3575-9fcd-50e7d12d1148",
                        "entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "glosses": [
                            "D’une manière succincte, en peu de mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72cb3710-e765-40b0-874d-be7b31d414e9",
                                "sense_id": "f2147d9c-ef45-3575-9fcd-50e7d12d1148",
                                "text": "Il ne me reste plus qu’à rapporter les principales vertus des Romains dans la guerre ; je le ferai le plus succinctement qu’il me sera possible,"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3d6dd11-cd79-3c02-a405-1c1076d6ead4",
                        "entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "glosses": [
                            "Pas copieusement."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5ce3faf0-f1a5-4264-9a44-adc361ec9c42",
                                "sense_id": "e3d6dd11-cd79-3c02-a405-1c1076d6ead4",
                                "text": "Déjeuner, dîner, souper succinctement."
                            },
                            {
                                "example_id": "ffa12176-bf1c-452a-8dc3-40f84f9d430f",
                                "sense_id": "e3d6dd11-cd79-3c02-a405-1c1076d6ead4",
                                "text": "[…] des défilés de jeunes filles succinctement vêtues égayaient les grands événements sociaux, et les hommes de pouvoir se présentaient en public au bras de courtisanes provocantes, entonnant des hymnes à la joie et au plaisir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0108846-e08a-42a5-921b-1a42e378a9cf",
                        "source_entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "target_lang_word": "succinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                        "entry_id": "41b3c950-fdc9-3557-8f8e-728b1d471d36",
                                        "glosses": [
                                            "In a succinct manner, concisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b92ebcf-bbdf-4d85-8b80-8172b5c510fc",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "With this preface, Sam related, as succinctly as he could, the last memorable conversation he had had with Mr. Pickwick."
                                            },
                                            {
                                                "example_id": "63dcb38c-6160-4aa8-8d43-b2b77b1e9e6a",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "My companion smiled approvingly. “You sum up the difficulties of the situation succinctly and well,” he said."
                                            },
                                            {
                                                "example_id": "9ac4576a-af77-44cd-9bd2-22c67645eee0",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "[\"]Who is he?\" \"He is Tom,\" replied Ajor succinctly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1a819a3-6fea-44a5-a353-dd205204210b",
                        "source_entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "target_lang_word": "briefly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "briefly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "In a brief manner, summarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3987ca-0857-464f-bccd-f7b1770fc945",
                                                "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                                "text": "He covered the subject briefly in his book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "For a brief period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a17e64b-159c-4242-9341-55bc729af470",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "He only worked here briefly."
                                            },
                                            {
                                                "example_id": "c2226221-32cb-4f2f-8ae3-168c425de687",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "Instead, ddakji was played for dramatic effect earlier in the season — pitting two men who had forged a sweet bond against each other, making one of them briefly believe he’d been eliminated by his friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "To be brief, in short."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d54d18-28e3-4bdc-a227-34d9111bdf7a",
                                                "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                                "text": "Briefly, I am not happy about what happened, but no one will be losing their job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c520f168-9ab4-40b7-b02e-4b66ea5dcc46",
                        "source_entry_id": "0c019f26-17c5-34f5-845d-abe204ac518e",
                        "target_lang_word": "concisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concisely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "422b4e49-1909-30c6-b25e-74a2befe5636",
                                        "entry_id": "440a32ac-a64c-37c7-931d-f78de4bed7fd",
                                        "glosses": [
                                            "In a concise manner, briefly, without excessive length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5633a966-e506-4909-8ab7-4d5bf169f4ea",
                                                "sense_id": "422b4e49-1909-30c6-b25e-74a2befe5636",
                                                "text": "He concisely explains that Whig histories tend to \"praise revolutions [for history of science, we could read novelties, ideas or individuals] provided they have been successful, emphasise certain principles of progress in the past and produce a story which is the ratification if not the glorification of the present\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
