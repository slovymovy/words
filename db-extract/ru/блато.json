                "senses": [
                    {
                        "sense_id": "75d33fb8-5183-384f-9191-3efa030c8fe7",
                        "entry_id": "4c8bab66-b823-3d8d-bfd3-adb09d672ea7",
                        "glosses": [
                            "церк.-слав., устар., нар.-поэт. то же, что болото"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9db0124-1426-4d80-a9b8-3da73b7b419c",
                                "sense_id": "75d33fb8-5183-384f-9191-3efa030c8fe7",
                                "text": "В сем месте было прежде блато, / Теперь сияет тамо злато / На башнях счастия творца; / Нева средь пышна града льется, / Отколе эхо раздается / О славе моего отца."
                            },
                            {
                                "example_id": "a6f2bf75-7d66-4352-a9d3-e378ee2f4570",
                                "sense_id": "75d33fb8-5183-384f-9191-3efa030c8fe7",
                                "text": "Прошло сто лет, и юный град, // Полнощных стран краса и диво, // Из тьмы лесов, из топи блат // Вознёсся пышно, горделиво…"
                            }
                        ]
                    },
                    {
                        "sense_id": "402054fe-4a31-3b38-af04-5b3ec52d955e",
                        "entry_id": "4c8bab66-b823-3d8d-bfd3-adb09d672ea7",
                        "glosses": [
                            "устар. грязь; грязное место"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
