                        "glosses": [
                            "zusätzlich Beigeschriebenes, schriftliche Ergänzung zu etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0d1938-203d-4797-a644-e5c05844756c",
                                "sense_id": "0a1af5d6-e9d8-3598-af0e-c684ec9844ff",
                                "text": "„Neben den schriftlich überlieferten Namen finden sich mykenische Gottheiten auch auf bildlichen Darstellungen, etwa auf Wandmalereien oder Siegeln. Allerdings wird deren Erkennung und Benennung durch fehlende Beischriften und häufig auch durch das Fehlen von Attributen erschwert.“"
                            },
                            {
                                "example_id": "2feae47f-a6c8-4742-bd1a-07e481f8be35",
                                "sense_id": "0a1af5d6-e9d8-3598-af0e-c684ec9844ff",
                                "text": "„Der dem König gegenüberstehende oder -sitzende Gott wird meist in einer Beischrift mit Namen genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
