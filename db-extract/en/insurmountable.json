                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                        "entry_id": "b8859d59-4007-3af5-8122-14e23ac9ff57",
                                        "glosses": [
                                            "so, dass es nicht überwunden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3773f85-3d3f-4451-953c-0d971250807c",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„Eva seufzte. Es war nur noch eine halbe Stunde bis zum Schluß der Nachtschicht, aber diese halbe Stunde schien vollkommen unüberwindlich. Sie dachte an das Bett, an das schöne, warme Bett, an Schlaf und Vergessenheit.“"
                                            },
                                            {
                                                "example_id": "9d7155e1-0e5e-44a5-a19e-ea5673983c0c",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„Immer nannte er den Verstand kalt, und nur das Herz wirkend und schaffend. Daher hatte er ein unüberwindliches Mißtrauen gegen jenen, und hingegen ein ebenso unerschütterliches Vertrauen zu diesem gefaßt.“"
                                            },
                                            {
                                                "example_id": "a64c04c9-b793-4bb5-9903-579774fc82e8",
                                                "sense_id": "051ee0cd-a5e1-3861-b2fd-b1d6ab3c4c96",
                                                "text": "„„O!“ rief einer aus der Gesellschaft lachend: „das war in dem finstern Zeitalter guter Ton, als die Fürsten noch böse wurden, wenn man sie nicht die allergnädigsten, großmächtigsten, unüberwindlichsten nannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
