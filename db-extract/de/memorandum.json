                                            "A brief diplomatic communication."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "046c836d-9c55-3df4-98ef-0d1f2330ff97",
                                        "entry_id": "d0fa8e3b-bdf1-31e1-9d80-6829d1a253c2",
