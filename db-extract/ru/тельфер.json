                "senses": [
                    {
                        "sense_id": "402cab59-54c6-37f0-9713-a87cf43a24c6",
                        "entry_id": "2c43cb9d-2924-3beb-aa49-c464fc9f17e3",
                        "glosses": [
                            "техн. подвесное грузоподъёмное устройство (таль) с электрическим приводом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b23e8f4-bb66-4515-9727-95f5f01fc9b8",
                                "sense_id": "402cab59-54c6-37f0-9713-a87cf43a24c6",
                                "text": "Бесчисленные подъёмные руки кранов сновали в воздухе, заслоняя свет. Лязгали и ворчали дерики и тельферы."
                            },
                            {
                                "example_id": "9e34a02c-0812-4fd6-8149-eb7037e70015",
                                "sense_id": "402cab59-54c6-37f0-9713-a87cf43a24c6",
                                "text": "Макет кабины подвешивался на кране-балке с тельфером, перемещающимся на огромной эстакаде .."
                            }
                        ]
                    }
                ],
