                "senses": [
                    {
                        "sense_id": "95c430af-f305-3333-b32d-e9d90440bbd9",
                        "entry_id": "5d16386b-6b83-351e-9cb3-ec5c7e85f89e",
                        "glosses": [
                            "Ausfüllung eines Hohlraums im Gestein durch mineralische Stoffe, die von außen nach innen wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ff1abc-692a-421f-af94-6ea601eea8ea",
                                "sense_id": "95c430af-f305-3333-b32d-e9d90440bbd9",
                                "text": "„Der Begriff Sekretion (von lat. secretio, zu secernere „abscheiden“) bezeichnet in der Geologie eine teilweise oder komplette Ausfüllung von Hohlräumen in Gesteinen durch Ausfällung von Stoffen aus Lösungen, die in den Hohlraum einwandern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70695d1e-19e1-3f10-b5cd-87d7907d3f84",
                        "entry_id": "5d16386b-6b83-351e-9cb3-ec5c7e85f89e",
                        "glosses": [
                            "Ausscheidung von Drüsen oder drüsenähnlichen Zellen, die eine bestimmte Funktion erfüllen"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "12d47046-b65d-414c-b10a-e8bb53d95fb6",
                                "sense_id": "70695d1e-19e1-3f10-b5cd-87d7907d3f84",
                                "text": "„Die Wissenschaftler gehen davon aus, dass die verringerte Sekretion des Hormons Melatonin von entscheidender Bedeutung sein könnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ca94b9c-0790-4c75-b020-e5a61df54435",
                        "source_entry_id": "5d16386b-6b83-351e-9cb3-ec5c7e85f89e",
                        "source_sense_id": "95c430af-f305-3333-b32d-e9d90440bbd9",
                        "source_sense_description": "Geologie: Ausfüllung eines Hohlraums durch mineralische Stoffe",
                        "target_lang_word": "sécrétion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sécrétion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e47b26c8-ba91-3306-a69a-29af5dac0c27",
                                        "entry_id": "4b3789eb-cba3-31d6-bade-a9693244aa95",
                                        "glosses": [
                                            "Fonction par laquelle certains tissus, certains organes produisent des substances liquides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1120461c-d425-4b8e-93cf-ab00c5e15af2",
                                                "sense_id": "e47b26c8-ba91-3306-a69a-29af5dac0c27",
                                                "text": "La fausse puberté précoce isosexuelle est secondaire à une sécrétion œstrogénique anormale par une tumeur de l’ovaire ou des surrénales sans maturation ovarienne."
                                            },
                                            {
                                                "example_id": "ea1c0b99-2a65-4f9c-a3e1-da2b58070b25",
                                                "sense_id": "e47b26c8-ba91-3306-a69a-29af5dac0c27",
                                                "text": "D’une manière générale, les femmes ménopausées sont les premières cibles de l’ostéoporose, en raison de la fin de la sécrétion des œstrogènes, hormones qui empêchent la destruction osseuse par leur action frénatrice sur les ostéoclastes (ces cellules des os dont le rôle est à la fois de détruire l’os ancien et de le renouveler)."
                                            },
                                            {
                                                "example_id": "514a70dd-fc21-4ab7-b224-8748a0a44c76",
                                                "sense_id": "e47b26c8-ba91-3306-a69a-29af5dac0c27",
                                                "text": "La scarlatine est une angine streptococcique accompagnée d’une éruption cutanée due à la sécrétion de toxine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa530892-9ea4-3c98-9f4f-14cc18a2948b",
                                        "entry_id": "4b3789eb-cba3-31d6-bade-a9693244aa95",
                                        "glosses": [
                                            "Produit de cette activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e1d1a4-5371-4621-a765-7939f4f08981",
                                                "sense_id": "fa530892-9ea4-3c98-9f4f-14cc18a2948b",
                                                "text": "Elles ont pour effet de défibroser le corps glandulaire, de relâcher et de faire circuler les sécrétions parotidiennes dans le canal de Sténon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
