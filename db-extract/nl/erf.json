                                            {
                                                "example_id": "e724dd64-a87a-45fe-bb45-76512d1d291e",
                                                "sense_id": "07a3d34a-96d8-3ccc-baf4-01b706d5b372",
                                                "text": "\"Where's Kipper?\" I asked, and was surprised to note that Bobbie was dancing round the room on the tips of her toes uttering animal cries, apparently ecstatic in their nature. \"Reggie?\" she said, suspending the farmyard imitations for a moment."
                                            }
