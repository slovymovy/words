                    },
                    {
                        "sense_id": "93497885-c209-325a-81ac-2a7ca77c4ceb",
                        "entry_id": "85a65dd3-e425-3bc9-858a-7c9634a5c55d",
                        "glosses": [
                            "Giving the impression of immersion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192372a1-986e-4d80-8257-c9e06e0ccf87",
                                "sense_id": "93497885-c209-325a-81ac-2a7ca77c4ceb",
                                "text": "An immersive system usually allows the user to move around physically so it is important that the real world allows sufficient space for this to happen safely."
                            },
                            {
                                "example_id": "d47a5fba-8058-4ec5-97cb-3028e96d20ae",
                                "sense_id": "93497885-c209-325a-81ac-2a7ca77c4ceb",
                                "text": "However, I maintain that many immersive theatre performances still tend to assign audiences to a scheme of production that is neoliberal in character and that affects the values and meanings that are attributable to that scheme of production."
                            }
                        ]
                    },
                    {
                        "sense_id": "b50e8f5d-f7e3-3013-ac31-dc243449f8d4",
                        "entry_id": "85a65dd3-e425-3bc9-858a-7c9634a5c55d",
                        "glosses": [
                            "Using or relating to the immersion technique of language teaching."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "467cfb73-11f3-4cea-805c-fc4c26707b55",
                        "source_entry_id": "85a65dd3-e425-3bc9-858a-7c9634a5c55d",
