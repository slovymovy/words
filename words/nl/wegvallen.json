    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc0ce004-03e8-353e-b10d-01a7f545e050",
                    "sense_definition": "opeens niet meer aanwezig zijn of verdwijnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verdwijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de nieuwe regels zal een groot deel van de subsidie <w>wegvallen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the new rules, a large part of the subsidy will <w>disappear</w>."
                            }
                        },
                        {
                            "text": "Als die inkomsten <w>wegvallen</w>, hebben we een groot financieel probleem.",
                            "target_lang_translations": {
                                "en": "If that income <w>is lost</w>, we will have a major financial problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdwijnen",
                        "vervallen"
                    ],
                    "antonyms": [
                        "verschijnen",
                        "ontstaan"
                    ],
                    "common_phrases": [
                        "inkomsten vallen weg",
                        "subsidie valt weg",
                        "steun valt weg"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly no longer be present or to disappear, especially regarding support or finances."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to disappear",
                                "target_lang_sense_clarification": "to cease to exist or be available"
                            },
                            {
                                "target_lang_word": "to be lost",
                                "target_lang_sense_clarification": "to no longer have something like income or support"
                            },
                            {
                                "target_lang_word": "to fall away",
                                "target_lang_sense_clarification": "to diminish or disappear gradually or suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8737cdee-d975-30d6-900b-46ce410576b4",
                    "sense_definition": "het plotseling stoppen met functioneren van een verbinding of signaal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technisch falen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zender was enige tijd <w>weggevallen</w>, maar hij is nu weer in de lucht.",
                            "target_lang_translations": {
                                "en": "The station had <w>dropped out</w> for some time, but it is now back on the air."
                            }
                        },
                        {
                            "text": "Toen de lijn definitief <w>wegviel</w>, konden we het gesprek niet meer afmaken.",
                            "target_lang_translations": {
                                "en": "When the line <w>was</w> finally <w>cut off</w>, we could no longer finish the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvallen",
                        "verbroken worden"
                    ],
                    "antonyms": [
                        "verbinding maken"
                    ],
                    "common_phrases": [
                        "verbinding valt weg",
                        "signaal valt weg",
                        "lijn valt weg"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden stopping of a connection or signal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drop out",
                                "target_lang_sense_clarification": "for a signal or connection to fail"
                            },
                            {
                                "target_lang_word": "to be cut off",
                                "target_lang_sense_clarification": "for a phone line or connection to be interrupted"
                            },
                            {
                                "target_lang_word": "to fail",
                                "target_lang_sense_clarification": "for a technical connection to stop working"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d32b175-3822-308a-b47a-8dfa9aae552a",
                    "sense_definition": "niet opgenomen worden in een geheel of weggelaten worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weglating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de definitieve versie van het boek is dat hoofdstuk <w>weggevallen</w>.",
                            "target_lang_translations": {
                                "en": "In the final version of the book, that chapter has been <w>omitted</w>."
                            }
                        },
                        {
                            "text": "Door een fout in de drukkerij zijn er enkele regels <w>weggevallen</w>.",
                            "target_lang_translations": {
                                "en": "Due to an error at the printer, a few lines are <w>missing</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontbreken",
                        "weglaten"
                    ],
                    "antonyms": [
                        "toegevoegd worden"
                    ],
                    "common_phrases": [
                        "tekst valt weg",
                        "hoofdstuk valt weg"
                    ],
                    "target_lang_definitions": {
                        "en": "To be omitted or left out of a whole, often by mistake."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be omitted",
                                "target_lang_sense_clarification": "to be left out of a text or document"
                            },
                            {
                                "target_lang_word": "to be missing",
                                "target_lang_sense_clarification": "to not be present where expected"
                            },
                            {
                                "target_lang_word": "to drop out",
                                "target_lang_sense_clarification": "to be accidentally excluded from a sequence or text"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a63cc064-aae0-3364-a81f-fbf5b0b9daf6",
                    "sense_definition": "het komen te overlijden van een persoon",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het <w>wegvallen</w> van hun vader moest de familie het bedrijf verkopen.",
                            "target_lang_translations": {
                                "en": "After the <w>passing</w> of their father, the family had to sell the business."
                            }
                        },
                        {
                            "text": "Het plotselinge <w>wegvallen</w> van de directeur was een grote schok voor het personeel.",
                            "target_lang_translations": {
                                "en": "The sudden <w>loss</w> of the director was a great shock to the staff."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlijden",
                        "sterven",
                        "ontvallen"
                    ],
                    "antonyms": [
                        "geboren worden"
                    ],
                    "common_phrases": [
                        "plotseling wegvallen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eufemistisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A euphemistic way to refer to the death of a person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passing",
                                "target_lang_sense_clarification": "a polite term for death"
                            },
                            {
                                "target_lang_word": "loss",
                                "target_lang_sense_clarification": "the death of a person in a social or professional context"
                            },
                            {
                                "target_lang_word": "to pass away",
                                "target_lang_sense_clarification": "to die (euphemistic)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}