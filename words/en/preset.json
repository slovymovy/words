{
    "word_family": [
        "set",
        "reset"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a73cf9d6-235c-37d3-9b86-c3998f65a955",
                    "sense_definition": "Set in advance, or established as a default.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preset_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oven turns off automatically after a <w>preset</w> period of time.",
                            "target_lang_translations": {
                                "ru": "Духовка выключается автоматически по истечении <w>заданного</w> периода времени."
                            }
                        },
                        {
                            "text": "You can change the camera settings instead of using the <w>preset</w> options.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить настройки камеры вместо использования <w>предустановленных</w> параметров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preset limit",
                        "preset level",
                        "preset temperature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленный заранее или заданный по умолчанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заданный",
                                "target_lang_sense_clarification": "определенный заранее"
                            },
                            {
                                "target_lang_word": "предустановленный",
                                "target_lang_sense_clarification": "установленный заранее или по умолчанию"
                            },
                            {
                                "target_lang_word": "предварительно установленный",
                                "target_lang_sense_clarification": "настроенный заранее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e68c8c75-77f3-3b1d-995b-f62f434de109",
                    "sense_definition": "A setting on an electronic device or application that is adjusted and saved in advance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preset_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press one of the buttons to choose a radio <w>preset</w>.",
                            "target_lang_translations": {
                                "ru": "Нажмите одну из кнопок, чтобы выбрать сохраненную <w>настройку</w> радио."
                            }
                        },
                        {
                            "text": "The photographer applied a custom <w>preset</w> to edit all the images quickly.",
                            "target_lang_translations": {
                                "ru": "Фотограф применил собственный <w>пресет</w>, чтобы быстро отредактировать все снимки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "radio preset",
                        "default preset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее сохраненная настройка или параметр в устройстве либо программе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пресет",
                                "target_lang_sense_clarification": "готовый набор настроек"
                            },
                            {
                                "target_lang_word": "предустановка",
                                "target_lang_sense_clarification": "сохраненная настройка"
                            },
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "сохраненный параметр радио, прибора и т.п."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2593641e-4912-35cc-9e3c-88c861925151",
                    "sense_definition": "An adjustable electronic component, such as a variable resistor, configured during production and not meant for regular adjustment by the user.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "preset_electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer tuned the small <w>preset</w> on the circuit board using a screwdriver.",
                            "target_lang_translations": {
                                "ru": "Инженер отрегулировал отверткой небольшой <w>подстроечный резистор</w> на печатной плате."
                            }
                        },
                        {
                            "text": "A tiny <w>preset</w> was installed to calibrate the circuit during manufacturing.",
                            "target_lang_translations": {
                                "ru": "Крошечный <w>подстроечный элемент</w> был установлен для калибровки схемы в процессе производства."
                            }
                        }
                    ],
                    "synonyms": [
                        "PR"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подстроечный радиоэлемент (например, резистор), настраиваемый при сборке и не предназначенный для регулярной регулировки пользователем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстроечный элемент",
                                "target_lang_sense_clarification": "электронный компонент для заводской калибровки"
                            },
                            {
                                "target_lang_word": "подстроечный резистор",
                                "target_lang_sense_clarification": "триммер или потенциометр"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d43e0425-9548-3890-bf00-5bad5729e8b2",
                    "sense_definition": "To set or determine something in advance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preset_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>preset</w> the coffee maker to start brewing at seven in the morning.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>запрограммировать</w> кофеварку, чтобы она начала варить кофе в семь утра."
                            }
                        },
                        {
                            "text": "The technician decided to <w>preset</w> the thermostat before leaving the house.",
                            "target_lang_translations": {
                                "ru": "Техник решил <w>предварительно настроить</w> термостат перед уходом из дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preset the timer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать или определять что-либо заранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задавать заранее",
                                "target_lang_sense_clarification": "устанавливать параметры предварительно"
                            },
                            {
                                "target_lang_word": "предустанавливать",
                                "target_lang_sense_clarification": "настраивать заблаговременно"
                            },
                            {
                                "target_lang_word": "предварительно настраивать",
                                "target_lang_sense_clarification": "устанавливать таймер, температуру и т.д."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}