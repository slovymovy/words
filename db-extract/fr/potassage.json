                        "glosses": [
                            "Bain de potasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11f8472-a755-4186-9966-1baa21634891",
                                "sense_id": "9389f9ff-5d73-3c9f-8683-2cf0a0087152",
                                "text": "Après la rouille ou bain de sulfo-nitrate de fer, qui marque également 30 degrés Baumé et qui dure de même trois heures environ, vient le potassage, qui est un nouveau bain double de la cuite et qui a lieu d’un seul coup."
                            }
                        ]
                    },
                    {
                        "sense_id": "524a3415-cab0-3e67-bd71-955536ccd39e",
                        "entry_id": "5f036a06-60f8-3cca-9dee-45370e68e4e3",
                        "glosses": [
                            "Bain de potasse.",
                            "Procédé de taxidermie, propre à l'entomologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49135d31-3feb-4198-8a41-7fb61e857f77",
                                "sense_id": "524a3415-cab0-3e67-bd71-955536ccd39e",
                                "text": "Un potassage ainsi ménagé, dont la durée dépend du spécimen, élimine le gros des tissus adipeux et des trachées, évite d'éclaircir et de déformer l'abdomen (qui sera replacé), et permet de reconnaître et de dégager les genitalia complets."
                            }
                        ]
                    },
                    {
                        "sense_id": "9238b145-5e73-34a2-af2e-cd3c7fd3d620",
                        "entry_id": "5f036a06-60f8-3cca-9dee-45370e68e4e3",
                        "glosses": [
                            "Action de potasser, révision intensive d'un examen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da1f38b-4430-4c03-8454-408aedfd0eb5",
                                "sense_id": "9238b145-5e73-34a2-af2e-cd3c7fd3d620",
                                "text": "Contentons-nous d'exécuter, pour aujourd'hui, la révision à outrance, le « potassage » aux veilles d'examen."
                            }
                        ]
                    }
