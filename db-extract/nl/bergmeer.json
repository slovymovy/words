                        "glosses": [
                            "een meer in de bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb481e3-e763-498f-9b88-c782ee0e945b",
                                "sense_id": "f48b4f79-f61d-366a-9d58-fc4b6592dc02",
                                "text": "Net als zijn drie medevluchters was ook Ariëns in de slotfase van de 200 kilometer lange schaatstocht op het Oostenrijkse bergmeer ten val gekomen. Dat belette hem er niet van om de wedstrijd uiteindelijk naar zijn hand te zetten."
                            },
                            {
                                "example_id": "ebaf5bd2-6d3c-426e-9df1-abae5612ee8c",
                                "sense_id": "f48b4f79-f61d-366a-9d58-fc4b6592dc02",
                                "text": "Tijdens een backpack-tripje bij een bergmeer merkte Jeremiah vorig jaar dat hij steeds buiten adem was en het niet lukte om zijn kinderen bij te houden. Dat was voor hem het omslagpunt om af te vallen en gezonder te gaan leven."
                            }
                        ]
                    }
