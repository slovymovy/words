                                            {
                                                "example_id": "6e2b1857-76bb-45dc-a812-e1251ac2823c",
                                                "sense_id": "5c57a037-9886-3b1b-9153-116514e44810",
                                                "text": "The Miſer earths his Treaſure; and the Thief, / Watching the Mole, half-beggars him ere Morn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6327b7dc-e055-31ec-925a-14771f696d34",
                                        "entry_id": "2e213520-5ca7-3953-bba6-7e1a7a8529ac",
                                        "glosses": [
                                            "To hide, or cause to hide, in the earth; to chase into a burrow or den."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef156829-5b70-422f-989c-d4e7b660f8f6",
                                                "sense_id": "6327b7dc-e055-31ec-925a-14771f696d34",
                                                "text": "[…]the Fox is earth’d,[…]"
                                            },
                                            {
                                                "example_id": "dac011f0-bb62-46bb-a9ef-00d683b21b12",
                                                "sense_id": "6327b7dc-e055-31ec-925a-14771f696d34",
                                                "text": "This is the time that the horseman are flung out, not having the cry to lead them to the death. When quadruped animals of the venery or hunting kind are at rest, the stag is said to be harboured, the buck lodged, the fox kennelled, the badger earthed, the otter vented or watched, the hare formed, and the rabbit set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6818d5ea-897e-3859-8c1d-0f4aa9b13a08",
