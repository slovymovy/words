                        "cross_references": []
                    },
                    {
                        "translation_id": "8465c428-f679-4f24-a48e-fa0de750658e",
                        "source_entry_id": "eea4836d-b1bb-3d9c-a59c-d8bbdebaad56",
                        "target_lang_word": "надстройка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "надстройка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41494a19-b635-39a4-aa76-93b10a25fd34",
                                        "entry_id": "dd7f62ad-e808-31be-8cd3-8e250476f90b",
                                        "glosses": [
                                            "действие по значению гл. надстроить; надстраивать; процесс достройки объекта (обычно здания) вверх"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba1564-5557-4b3c-87db-d783f09243a0",
                                                "sense_id": "41494a19-b635-39a4-aa76-93b10a25fd34",
                                                "text": "Ведь если эти средства направить на реконструкцию нескольких домов с надстройкой мансард и последующей реализацией квартир мансардного этажа, тогда капитал окажется не затратным, а оборотным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0a842b-386e-3d4c-9f6a-81519fabf857",
                                        "entry_id": "dd7f62ad-e808-31be-8cd3-8e250476f90b",
                                        "glosses": [
                                            "то, что надстроено над чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae6b1ca-ef52-4f82-8ec3-8b33563d31df",
                                                "sense_id": "ec0a842b-386e-3d4c-9f6a-81519fabf857",
                                                "text": "Вид был очень недурен, но вид сверху вниз, с надстройки дома на равнины и отдаленья, был еще лучше."
                                            },
