                    },
                    {
                        "form_id": "8d62491c-e62f-4957-9c66-ece0abe1fd11",
                        "entry_id": "f915c869-1980-3750-82cf-eef3684e823f",
                        "tags": [
                            "past"
                        ],
                        "form": "kerned"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d74c900-add3-3fb6-862d-1a128eb1017a",
                        "entry_id": "f915c869-1980-3750-82cf-eef3684e823f",
                        "glosses": [
                            "To adjust the horizontal space between selected pairs of letters (characters or glyphs); to perform such adjustments to a portion of text, according to preset rules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b69925d-acac-4b43-a31c-77b5ce529910",
                                "sense_id": "0d74c900-add3-3fb6-862d-1a128eb1017a",
                                "text": "If you need to kern anything beyond the most commonly used pairs, you can use applications software such as Adobe PageMaker to customize pairs."
                            },
                            {
                                "example_id": "666d0411-09ce-4415-a049-f4372c7c853b",
                                "sense_id": "0d74c900-add3-3fb6-862d-1a128eb1017a",
                                "text": "Especially consider kerning if you are printing on a relatively high-resolution printer, such as a 600-dpi (dots per inch) laser printer."
                            },
                            {
                                "example_id": "83674a7f-6112-499b-8603-6cd364280298",
                                "sense_id": "0d74c900-add3-3fb6-862d-1a128eb1017a",
                                "text": "Remember, the goal of kerning is to make letter pairs look natural, not necessarily to minimize letterspaces."
                            },
                            {
                                "example_id": "275596fa-65ed-4cfe-badc-e234a6978f5d",
                                "sense_id": "0d74c900-add3-3fb6-862d-1a128eb1017a",
                                "text": "You should kern letter pairs when spacing between characters is too wide or too narrow."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
