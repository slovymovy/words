                        ],
                        "examples": [
                            {
                                "example_id": "c86935a0-6f49-4de0-b444-3290f6d68a84",
                                "sense_id": "76ca8240-c8bb-3f51-b34a-0f11df936593",
                                "text": "God keep your ladyship still in that mind; so some gentleman or other shall 'scape a predestinate scratched face."
                            },
                            {
                                "example_id": "802f03a5-5f9b-4ce9-adfb-6e096f96a4fe",
                                "sense_id": "76ca8240-c8bb-3f51-b34a-0f11df936593",
                                "text": "There once was a man who said, “Damn!\nIt is borne in upon me I am\n An engine that moves\n In predestinate grooves,\nI’m not even a bus, I’m a tram.”"
                            }
                        ]
                    }
