            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a180d9ef-41c5-3196-89f0-a49144df68ae",
                    "sense_definition": "Offenser délibérément quelqu'un par des paroles méprisantes ou des actes blessants.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est mis en colère et a commencé à <w>insulter</w> les passants dans la rue."
                        },
                        {
                            "text": "Elle a préféré quitter la pièce pour ne pas se faire <w>insulter</w> davantage."
                        }
                    ],
                    "synonyms": [
                        "injurier",
                        "traiter"
                    ],
                    "common_phrases": [
                        "se faire insulter"
                    ]
                },
                {
                    "sense_id": "c896d58f-f57e-3a48-812a-a101177f42c1",
                    "sense_definition": "Constituer une offense ou un affront envers quelque chose, notamment par un comportement inapproprié (souvent suivi de « à »).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Afficher un tel luxe devant des gens démunis revient à <w>insulter</w> à leur misère."
                        },
                        {
                            "text": "Son éclat de rire déplacé <w>insultait</w> à la gravité de la cérémonie."
                        }
                    ],
                    "common_phrases": [
                        "insulter à la misère"
                    ]
                },
                {
                    "sense_id": "d3efa7f6-b1d0-3b4d-a7d2-18de401f104f",
                    "sense_definition": "Attaquer une troupe ou une place fortifiée vivement et à découvert.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avant-garde décida d'<w>insulter</w> les retranchements adverses avant la tombée de la nuit."
                        },
                        {
                            "text": "Le général préféra assiéger patiemment la citadelle plutôt que d'<w>insulter</w> ses remparts."
                        }
                    ],
                    "common_phrases": [
                        "insulter une place"
                    ],
