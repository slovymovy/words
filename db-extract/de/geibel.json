                ],
                "senses": [
                    {
                        "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                        "entry_id": "db1e0bbe-3777-3012-b626-fd96e7705d2b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87131594-a58f-4760-8ec6-e166b123b2f9",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Frau Geibel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3161db52-7df3-4463-b3cf-2b995eb32fd9",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Herr Geibel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "077f4d52-52e2-4fd5-8d23-17ef01c5b254",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Die Geibels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "21df6e13-37ff-49ae-bab7-243ab4a65096",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Der Geibel trägt nie die Schals, die die Geibel ihm strickt."
                            },
                            {
                                "example_id": "af06300e-03fa-496a-bdcc-7546716aac69",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geibel kommt, geht der Herr Geibel.“"
                            },
                            {
                                "example_id": "14f9a8d3-d1f7-4a3d-b99d-e55aacc75535",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Geibel kommt und geht."
                            },
                            {
                                "example_id": "1724b16e-82cb-4ec0-aa5c-259b5d555318",
                                "sense_id": "23c6ea2d-8218-332b-82a3-9efe31c32b22",
                                "text": "Geibels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
