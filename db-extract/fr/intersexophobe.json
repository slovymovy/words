                                        "glosses": [
                                            "Relating to, characteristic of, or exhibiting intersexphobia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8311540c-2fd6-43c5-88a7-334e429dc6fa",
                                                "sense_id": "51281292-88a8-33ea-a1a7-5d27db2e92c2",
                                                "text": "There is an urgent need to unpack the sexism underpinning these transphobic and intersexphobic views of sport; […]"
                                            },
                                            {
                                                "example_id": "11c90ce6-8658-4e38-a7ed-263a357e95f9",
                                                "sense_id": "51281292-88a8-33ea-a1a7-5d27db2e92c2",
                                                "text": "Sometimes participants can say or do things that reflect or highlight their heteronormative, gender[-]normative, or intersexphobic beliefs."
                                            },
                                            {
                                                "example_id": "4dcdc14b-c2b7-43ec-90b2-d4264e0bef52",
                                                "sense_id": "51281292-88a8-33ea-a1a7-5d27db2e92c2",
                                                "text": "Use language that is informed, positive, affirming and supportive when referring to people born with intersex variations, challenging any language that is intersexphobic and accurately educating students about the human body."
                                            }
