                    {
                        "translation_id": "fccfa627-5298-4fde-9843-8ff5cfa68ca2",
                        "source_entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "source_sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "source_sense_description": "een minachtende of vernederende opmerking",
                        "target_lang_word": "quolibet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quolibet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                        "entry_id": "d30f28cf-94a9-3f7f-b9dd-e96f8cfbedaf",
                                        "glosses": [
                                            "Plaisanterie vulgaire et injurieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f27fd76-096d-46d9-8c73-4a259afb2b17",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "D’ailleurs, ces filets miroitants qui dévalaient son menton, Wundrak n’aurait jamais pu les tolérer sans émettre un quolibet ou une insulte."
                                            },
                                            {
                                                "example_id": "d1d3260e-c272-4f4c-80e3-e23e5f75f424",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "La vraie raison, c’est que notre guide veut m’éviter à tout prix des sévices, des chalbaris ou quolibets qui m’humilieraient bien trop pour une faute involontaire."
                                            },
                                            {
                                                "example_id": "76e7ba55-81ca-4dd1-b948-e75b2428021d",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "Des chansons et des quolibets populaires, se joignant aux intrigues de la cour, ruinèrent auprès du roi le crédit d’un homme de bien."
                                            },
                                            {
                                                "example_id": "331bfb1d-22cb-4667-8651-858a88ca8e99",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "Rivaux comme tous bons chasseurs, c’était à qui raserait à l’autre le lièvre indiqué, et le roulé subissait naturellement les quolibets du vainqueur."
                                            },
                                            {
                                                "example_id": "14f530d0-2c3b-421a-9e5e-ce19b36093ad",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "Sa casquette à carreaux lui attirant des quolibets, il l'ôta timidement."
                                            },
                                            {
                                                "example_id": "c7586022-1d1e-41c4-a441-0ef5ba03eba1",
                                                "sense_id": "13ef1bca-b033-35d9-8ca1-37568247e3c3",
                                                "text": "Dans une réunion électorale à Bazeilles, les assistants ont abreuvé de quolibets un contradicteur qui affirmait : « si l'ouvrier est malheureux, c'est par rapport aux riches »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
