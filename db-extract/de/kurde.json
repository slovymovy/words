                        "form": "den Kurden"
                    },
                    {
                        "form_id": "4f5b036f-9e39-489d-8bb4-6ebc77ea2c19",
                        "entry_id": "9380e70e-6940-3837-8a78-8fdfa9fc8e37",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kurden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                        "entry_id": "9380e70e-6940-3837-8a78-8fdfa9fc8e37",
                        "glosses": [
                            "ein iranisches Volk"
                        ],
                        "tags": [
                            "nur im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "35aed5c9-d0d3-4f7a-8f13-94dcf00fc820",
                                "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                                "text": "Die Kurden, die einen nicht geringen Teil der türkischen Bevölkerung stellen, fühlen sich von der türkischen Mehrheit dominiert und wünschen einen eigenen Staat."
                            },
                            {
                                "example_id": "b933ac26-512b-40b4-a66f-f4826e5654a2",
                                "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                                "text": "„Trotz anders lautenden Bestimmungen im Vertrag von Lausanne (der Artikel 39/4 schrieb vor, dass der Gebrauch der Muttersprache nicht eingeschränkt werden darf) betrieb die Türkei eine Assimilierungspolitik gegenüber den Kurden und leugnete kulturelle und ethnische Unterschiede.“"
                            },
                            {
                                "example_id": "b26add03-097c-44bb-91b4-bfdfebaebc9d",
                                "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                                "text": "Die einzige autonome Republik der Kurden, die mit Unterstützung der Sowjetunion in den 40er Jahren im iranischen Mahabad ausgerufen worden war, wird bis heute in allen Teilen Kurdistans als Modell kurdischer Selbstverwaltung idealisiert."
                            },
                            {
                                "example_id": "eb25f38d-9c16-4e6e-bd6a-a1c85400b844",
                                "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                                "text": "„Die größte und bedeutendste christliche Gruppe (wie die Suryani sind sie Monophysiten), die bis zum Beginn dieses Jahrhundertes ihr Verbreitungsgebiet mit den Kurden teilte, sind die Armenier.“"
                            },
                            {
                                "example_id": "5de6129a-f06e-4682-a4cf-02142452ea60",
                                "sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                                "text": "„Durch Migration und Umsiedlung gelangten Kurden auch nach Jordanien, Libanon, Zentralanatolien, Ost-Iran, Georgien, Mittelasien, in die West-Türkei (Istanbul, Adana) sowie nach Europa (vor allem nach Deutschland).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "13bcb1b5-6a58-3611-9507-c7a616a8519c",
                        "entry_id": "9380e70e-6940-3837-8a78-8fdfa9fc8e37",
                        "glosses": [
                            "Angehöriger des gleichnamigen iranischen Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193c725e-9c37-4847-87ad-c0a1f4493a8b",
                                "sense_id": "13bcb1b5-6a58-3611-9507-c7a616a8519c",
                                "text": "In der Türkei leben die meisten Kurden."
                            },
                            {
                                "example_id": "b2f3b9d6-9c8d-40b1-b514-4141d5269abc",
                                "sense_id": "13bcb1b5-6a58-3611-9507-c7a616a8519c",
                                "text": "Mein neuer Nachbar ist ein Kurde."
                            },
                            {
                                "example_id": "5138079e-09b5-4b5a-b8fa-7014722d8b92",
                                "sense_id": "13bcb1b5-6a58-3611-9507-c7a616a8519c",
                                "text": "Der Schüler, der neu in unsere Klasse kam, war ein Kurde."
                            },
                            {
                                "example_id": "10145674-2661-4dd2-88f0-24d0046bbbdd",
                                "sense_id": "13bcb1b5-6a58-3611-9507-c7a616a8519c",
                                "text": "So wie die Kurden in den verschiedenen Ländern, wo sie ihren Wohnsitz haben, oftmals und bis in die Gegenwart gezielter Unterdrückung unterliegen, haben sich Angehörige des kurdischen Volkes so wie Vertreter anderer unterdrückter Völker durchaus auch an der Seite der Herrschenden an Zwangsmaßnahmen gegen andere Unterdrückte beteiligt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a8ecc9-121f-48ce-8f0b-8b03bdabdde4",
                        "source_entry_id": "9380e70e-6940-3837-8a78-8fdfa9fc8e37",
                        "source_sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
                        "source_sense_description": "nur im Plural: ein iranisches Volk",
                        "target_lang_word": "Kurd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa2155a5-7cfe-3527-876c-eab5fcea631c",
                                        "entry_id": "f6e9c381-5430-313b-88c8-38fcca2a867d",
                                        "glosses": [
                                            "A member of the linguistically and culturally distinct people who speak Kurdish and mainly inhabit those parts of Turkey, Iran, Iraq and Syria sometimes known as Kurdistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d173d0-ff57-4807-98c6-6cf1d4f78710",
                                                "sense_id": "aa2155a5-7cfe-3527-876c-eab5fcea631c",
                                                "text": "Curdi, B[arbarous]. a people which many think to be the Parthians, A[uncient]. But we cannot possiblie thinke them to be so. wherein we agree with Castaldo."
                                            },
                                            {
                                                "example_id": "b174272e-11e5-4934-a256-c1c8a4f92182",
                                                "sense_id": "aa2155a5-7cfe-3527-876c-eab5fcea631c",
                                                "text": "Mehemet took her for a man and said, “Good father, I am a Kurd: my story is very curious”"
                                            },
                                            {
                                                "example_id": "9a60601c-20b9-4940-9850-72abf259ddf6",
                                                "sense_id": "aa2155a5-7cfe-3527-876c-eab5fcea631c",
                                                "text": "After defeating IS in battle, Syria's Kurds are now eager to show they can bring justice against the group's members."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e496fa6-ee68-4f30-bd29-2cbe91f10b63",
                        "source_entry_id": "9380e70e-6940-3837-8a78-8fdfa9fc8e37",
                        "source_sense_id": "f3beada5-677a-3b31-b379-6f065191bec6",
