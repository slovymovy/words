                                        "glosses": [
                                            "Periode der Erdgeschichte, die vor 5,33 Millionen Jahren begann und vor 2,588 Millionen Jahren endete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d72a0b-35dd-40f7-ae1b-047930bee7ce",
                                                "sense_id": "71a6c5e5-1b5e-3b03-abe8-b677586903c1",
                                                "text": "„Vor dem Pliozän liegt das Miozän. Nach ihm folgt das Pleistozän, die Eiszeit, mit einem Wechsel von Warm- und Kaltzeiten bis ins Holozän, der geologischen Gegenwart.“"
                                            }
                                        ],
