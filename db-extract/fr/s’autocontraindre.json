                ],
                "senses": [
                    {
                        "sense_id": "82c07acc-31f4-34fb-9dd8-46f8442c84d7",
                        "entry_id": "6bb9ea0c-da30-3ada-87b7-0b9d6c87164e",
                        "glosses": [
                            "Se contraindre soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d835d95-1a2f-4e27-a883-135aecce3ff0",
                                "sense_id": "82c07acc-31f4-34fb-9dd8-46f8442c84d7",
                                "text": "Le seuil n’est plus un « minimum physiologique », mais un minimum de capacité à être responsable, à s’autocontraindre."
                            },
                            {
                                "example_id": "1c21a9a3-974f-465e-9266-c210cda95559",
                                "sense_id": "82c07acc-31f4-34fb-9dd8-46f8442c84d7",
                                "text": "Il faut s’autocontraindre pour pouvoir encore contraindre."
                            },
                            {
                                "example_id": "068a0ebc-3f9d-4fb6-9856-d2dd247a039f",
                                "sense_id": "82c07acc-31f4-34fb-9dd8-46f8442c84d7",
                                "text": "La dignité et le respect qui sont attachées à la personne, sa liberté par sa capacité à s’autocontraindre, lui sont étrangères."
                            }
                        ]
                    }
                ],
