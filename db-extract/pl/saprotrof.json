                            {
                                "example_id": "d09e05b0-48e6-4fd4-96a3-547567cbca42",
                                "sense_id": "8b30c682-a0f3-35c4-9004-49ec590cdcbe",
                                "text": "Będąc saprotrofem, grzyb ten przyczynia się do niszczenia drewnianych konstrukcji."
