                "senses": [
                    {
                        "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                        "entry_id": "a7c7b2e7-9412-3a34-b581-6e515f667628",
                        "glosses": [
                            "besonders bewunderter Läufer; Läufer, der als Vorbild angesehen wird"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "32bba7a3-2f4a-4d25-be7b-d367d173b484",
                                "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                                "text": "„Als erster Laufheld der französischen Geschichte holte Michel Théato die Goldmedaille im Marathonlauf.“"
                            },
                            {
                                "example_id": "e2c9b1b3-4934-46d5-b82c-de982756dcf9",
                                "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                                "text": "„Bei Meile vier oder fünf habe ich dann meinen persönlichen Laufhelden gesehen.“"
                            },
                            {
                                "example_id": "124d9ff6-bc91-42f1-abc2-d74ec96f626e",
                                "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                                "text": "„Kevins wahre Laufhelden sind vor allen anderen die langsamen Läufer, die trotz Defiziten oder Schamgefühlen an den Start gehen und etwas für sich und ihren Körper tun.“"
                            },
                            {
                                "example_id": "4c453816-3094-4fed-b42e-49d279dc46d1",
                                "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                                "text": "„Familien und Freunde der Läufer sind eingeladen, den Tag auf der Audi Piazza gemeinsam mit ihren ‚Laufhelden‘ zu verbringen und sie anzufeuern.“"
                            },
                            {
                                "example_id": "31ef50e1-e35e-42da-aa9e-80f10e2602b3",
                                "sense_id": "75596979-5350-34dd-b021-a974919a2351",
                                "text": "„Die Briten hoffen insbesondere auf ihren Laufheld Mo Farah, der ihnen bereits die Olympischen Spiele 2012 versüßt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
