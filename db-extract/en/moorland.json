                    },
                    {
                        "translation_id": "918dcb33-8540-4cf3-9d6f-55be8aeac1bb",
                        "source_entry_id": "fc275e96-bf1e-3337-bfa0-910f2c078fe7",
                        "source_sense_id": "97f0e605-fd82-31f4-b689-51ab5f78e9a1",
                        "source_sense_description": "land covered with heather or bracken",
                        "target_lang_word": "lande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "619850fd-7d67-3acf-a718-c22c6cca98c6",
                                        "entry_id": "fd58f9d7-e085-30f5-900f-320d0e08899b",
                                        "glosses": [
                                            "Étendue de terre inculte et stérile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0138aa20-eb43-4c98-b97e-c19c22ee016b",
                                                "sense_id": "619850fd-7d67-3acf-a718-c22c6cca98c6",
                                                "text": "Des landes et des coteaux calcaires ou marno-calcaires plus ou moins pâturés à flore xérothermique se rencontrent en différents points de la vallée de la Lanterne […]"
                                            },
                                            {
                                                "example_id": "6c7d3f33-ca73-4ef2-af65-279641a86177",
                                                "sense_id": "619850fd-7d67-3acf-a718-c22c6cca98c6",
                                                "text": "Ils paissent sur des landes granitiques ou dans les dépressions plus humides des plateaux caussenards."
                                            },
                                            {
                                                "example_id": "771a30bc-8720-4b2d-a432-38b057dff106",
                                                "sense_id": "619850fd-7d67-3acf-a718-c22c6cca98c6",
                                                "text": "Les landes siliceuses connaissent souvent une grande abondance de Fougères : au Pays basque la Fougère-aigle constitue d’importants pâturages qui rougeoient à l’automne."
                                            },
                                            {
                                                "example_id": "4d76c33b-41ec-47fc-a32a-b77c42f70553",
                                                "sense_id": "619850fd-7d67-3acf-a718-c22c6cca98c6",
                                                "text": "Les 20 à 30 millions de moutons pacageaient presque toute l'année sur les landes ; une faible part pacageait les jachères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541dd801-a763-3387-af29-b5acbe7f24f0",
                                        "entry_id": "fd58f9d7-e085-30f5-900f-320d0e08899b",
                                        "glosses": [
                                            "Végétation qui croît sur une telle terre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d6dc797-38db-4743-adb1-6050c1adfbfd",
                                                "sense_id": "541dd801-a763-3387-af29-b5acbe7f24f0",
                                                "text": "[…] Rabalan sortit de sa maison, misérable masure en torchis, croulante, à peine couverte de quelques paquets de lande sèche en guise de toit, […]."
                                            },
                                            {
                                                "example_id": "6d96259c-527c-48e3-ba3e-897a7908f396",
                                                "sense_id": "541dd801-a763-3387-af29-b5acbe7f24f0",
                                                "text": "En bordure de la route départementale, des pousses vertes de molinie bleue attestent de la capacité de résilience des landes atlantiques."
                                            },
                                            {
                                                "example_id": "b25476a2-4c02-4760-9024-ec75e7783c86",
                                                "sense_id": "541dd801-a763-3387-af29-b5acbe7f24f0",
                                                "text": "Tansley considérait les landes comme un bon exemple de végétation subclimacique: un stade faisant partie de la succession de végétation des sables et graviers acides et nus, succession qui menait à une forêt caducifoliée arrivée à maturité."
                                            },
                                            {
                                                "example_id": "6ae12e5b-d718-4f4a-99c8-087f959fbf7a",
                                                "sense_id": "541dd801-a763-3387-af29-b5acbe7f24f0",
                                                "text": "[…]; d’autre part, la nature d’un terrain non agricole, spontanément, ce n’est pas le bois, mais la broussaille, la friche, la lande, la ginestaie, la garrigue, la genévraie, le maquis, la pelouse rase… ou le désert !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c771513e-32f2-402c-bfad-8da4f4830d07",
                        "source_entry_id": "fc275e96-bf1e-3337-bfa0-910f2c078fe7",
                        "source_sense_id": "97f0e605-fd82-31f4-b689-51ab5f78e9a1",
                        "source_sense_description": "land covered with heather or bracken",
                        "target_lang_word": "bruyère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruyère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d17d7fa-409e-38b4-85d1-31ec4b9f1fcb",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Plante ligneuse du genre Erica, dont le feuillage est toujours vert et qui croît dans des terrains incultes et sablonneux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b9864a-3541-4089-9b2c-4ec248447a48",
                                                "sense_id": "0d17d7fa-409e-38b4-85d1-31ec4b9f1fcb",
                                                "text": "Le rucher se composait de 75 ruches avec 10 à 12 k. d'abeilles. La récolte se faisait sur une petite bruyère, dite la grelotteuse (Erica cinerea). Le miel récolté était si clair, que le fond du seau en était visible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Nom donné à plusieurs autres plantes de la famille des Éricacées appartenant aux genres Bruckenthalia, Calluna (les callunes), Daboecia et Pentapera entre autres."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8d204f-e84b-433c-84e6-aa9d3934bc50",
                                                "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                                "text": "On commence d'abord par nettoyer le sol en arrachant les ronces, les épines, les bruyères, etc., puis on procède à l'abatage du taillis."
                                            },
                                            {
                                                "example_id": "8683cfe2-9902-4935-8a36-d671eb7eb97a",
                                                "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                                "text": "Si cela a brûlé très fort, il peut y avoir de l’installation de mousse pendant quelques années, avec des tapis parfois denses qui vont empêcher des graines de bruyère, d’ajonc ou des graminées de venir recoloniser tout de suite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Lieu où croissent ces plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6f30d1-1cc9-47db-8adf-98c6980dbf7d",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "La bruyère spongieuse à Erica Tetralix est souvent en continuité avec des petits ilots de l'association à Schœnus établis dans la zone des marnes supra-gypseuses et l'on constate alors , à la marge des deux groupements un mélange de leurs éléments respectifs."
                                            },
                                            {
                                                "example_id": "323f7dfd-6b5c-410e-837e-11e545242391",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Hervé ne croyait pas aux fées, et du reste si, comme l’affirment les Cornouaillais, les fées se promènent au clair de lune sur les bruyères désertes, personne ne les a jamais vues naviguer."
                                            },
                                            {
                                                "example_id": "319a0cf3-a7cc-4059-8640-7be623bbee71",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Son casse-pierres sur l’épaule, le carnier de toile, bourré d’un morceau de pain bis, sur le dos, il dévala la bruyère, prit la route."
                                            },
                                            {
                                                "example_id": "3186110a-99f2-4952-ab86-ca7011ab8133",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "La plus grande métairie en superficie était Mauvy : 140 hectares environ, mais la surface labourable ne représentait que 18 % des terres (25 hectares), car l'essentiel était constitué de bruyères (72 hectares), de pâtures (24 hectares) et de taillis (14,3 hectares)."
                                            },
                                            {
                                                "example_id": "0fabf01f-5b7c-4611-ba94-23098d974c98",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Les petites filles se levaient à cinq heures, balayaient, surveillaient le déjeuner, prenaient une leçon d’anglais avec leur père et une leçon de couture avec leur tante ; le reste du temps, c’était la promenade sur la bruyère, la lente promenade toujours recommencée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd4354b0-23d5-472d-a5f7-496738c82fdd",
                        "source_entry_id": "fc275e96-bf1e-3337-bfa0-910f2c078fe7",
                        "source_sense_id": "97f0e605-fd82-31f4-b689-51ab5f78e9a1",
                        "source_sense_description": "land covered with heather or bracken",
                        "target_lang_word": "brande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                                        "glosses": [
                                            "Bruyère à balais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc713d5d-67ad-49a3-a6d1-590295e48b26",
                                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                                "text": "Un pays de brandes."
                                            },
                                            {
                                                "example_id": "39644c51-eba1-41f8-8c82-f0a96bee30b3",
                                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                                "text": "Chauffer le four avec des brandes."
                                            },
                                            {
                                                "example_id": "a81af132-3590-4e79-96b8-b9896b4bb3c0",
                                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                                "text": "[…] on voit partout de vastes étendues de brandes dans lesquelles ne croissent que des bruyères et des genêts. Là où les brandes cessent, les landes commencent ; et sur ces landes élevées les vents âpres rabougrissent les maigres bouquets d’arbres qui dressent çà et là leurs branches tordues et tourmentées."
                                            },
                                            {
                                                "example_id": "10f843ba-4d1b-4f67-9e99-d97e5868cab6",
                                                "sense_id": "52c89e60-7816-35b2-90d0-d9d17022320d",
                                                "text": "Au plus épais d’une famille, elle allait couver, pareille à un feu sournois qui rampe sous la brande, embrase un pin, puis l’autre, puis de proche en proche crée une forêt de torches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                                        "glosses": [
                                            "Lieux incultes où croissent çà et là ces sortes de petits arbustes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0346852-c388-42aa-8a16-1cf5ceb8dcd1",
                                                "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                                                "text": "Toutes ses plantes grillées, ses feuillages asphyxiés, ses racines bloquées dans un sous-sol aussi compact que la pierre, la terre brûlait, et craquelait, elle fumait, crépitait, grésillait. Des incendies s’allumaient spontanément dans les brandes."
                                            },
                                            {
                                                "example_id": "e6f83eed-7399-4dbc-9dd1-aed0b5fcfe23",
                                                "sense_id": "e91e5636-6097-307a-a623-602be15ba785",
                                                "text": "Dans ce cas, le préfet peut limiter l’étendue de la battue : en juin 1840, « une battue est nécessaire sur les communes de Bouesse et Mosnay, mais en raison de l’avancement de la saison, ces chasses doivent être restreintes aux bois qui sont entourés de brandes ou de chemins publics, afin de n’exposer les récoltes à aucun dommage. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb72713-8671-3f21-872e-31f7773dadb3",
                                        "entry_id": "06785773-b0a1-33a8-8f9b-516abce2658f",
                                        "glosses": [
                                            "Maladie de la vigne."
                                        ],
                                        "tags": [
                                            "Auvergne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ab4eeb-8942-48d6-81d0-0f80caa43753",
                                                "sense_id": "beb72713-8671-3f21-872e-31f7773dadb3",
                                                "text": "On dit que la vigne a la brande ou est brandée, lorsque ses feuilles rougissent, se dessèchent et tombent."
                                            }
                                        ]
                                    }
                                ]
                            },
