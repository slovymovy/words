                "senses": [
                    {
                        "sense_id": "9f933daf-2168-3ed4-9952-9497085a7692",
                        "entry_id": "89343cae-afc9-3bca-bc04-b6eb43d578f5",
                        "glosses": [
                            "französisches Überseedepartement in der Karibik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd66732-4bda-434f-a84c-3e813d06712b",
                                "sense_id": "9f933daf-2168-3ed4-9952-9497085a7692",
                                "text": "Martinique ist ein vollintegrierter Teil des französischen Staates und damit auch Teil der Europäischen Union."
                            },
                            {
                                "example_id": "f8d300f1-4c1d-4d78-a911-8f871d1f58e0",
                                "sense_id": "9f933daf-2168-3ed4-9952-9497085a7692",
                                "text": "„Auf Martinique besucht er die Pagerie, das Anwesen, dem die Kaiserin Joséphine entstammte, und erspürt noch im Verfall die Atmosphäre, die in ihren Kindertagen hier geherrscht haben müsse.“"
                            },
                            {
                                "example_id": "dbc6f788-f6ad-4fd5-a5a2-4ec249a7a85c",
                                "sense_id": "9f933daf-2168-3ed4-9952-9497085a7692",
                                "text": "„Ein anderes Schifflein war uns bestimmt, vermutlich der klapprige Kasten, den jeden Monat die Transports Maritimes nach Martinique schickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
