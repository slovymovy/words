                "senses": [
                    {
                        "sense_id": "52fd6ec8-b8e5-3bcc-9408-4de1f1b53a6d",
                        "entry_id": "facd22f5-2ea6-3b50-82ba-43f7468c9257",
                        "glosses": [
                            "Qui est rassemblé, entassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f3cba1-b3c0-4ce0-beb1-add58da3d445",
                                "sense_id": "52fd6ec8-b8e5-3bcc-9408-4de1f1b53a6d",
                                "text": "Un parfum de muguet vibrait délicieusement : elle chercha et finit par découvrir les clochettes blanches, amoncelées au bas d’une pente, parmi les feuilles sèches."
                            },
                            {
                                "example_id": "a5ed8d4e-13cc-4b84-81dc-f38f8eb6e981",
                                "sense_id": "52fd6ec8-b8e5-3bcc-9408-4de1f1b53a6d",
                                "text": "La philosophie est l’un des plus hauts sommets de cette culture que la bourgeoisie réserve à ses propres enfants. Une sagesse nourrie par tout les déchets amoncelés de l’histoire, une sagesse encombrée par toutes les éruditions de l’histoire, par toutes les branches mortes de l’histoire, une sagesse toujours soigneuse de s’abriter derrière le mouvement délicat des sciences, est affaire de longue haleine : elle exige ces loisirs, ces années de préparation à la fonction cléricale que le fils de la bourgeoisie seul est en position d’obtenir."
                            }
                        ]
                    }
