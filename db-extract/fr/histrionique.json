                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "histrioniques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ae08fd8-858d-39b8-90ed-e4a987fedf94",
                        "entry_id": "c0a6de40-4082-3bbb-bbfe-f203feb02b94",
                        "glosses": [
                            "Qui concerne les histrions, les comédiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514f4dbe-6452-4343-a955-e5d1d7277aea",
                                "sense_id": "6ae08fd8-858d-39b8-90ed-e4a987fedf94",
                                "text": "Je crois que l’aréopage histrionique n’est pas riche en comédies; tous les jeunes gens qui ont la rage des vers font des tragédies dès qu’ils sortent du collége."
                            },
                            {
                                "example_id": "5cc17369-2a7c-4833-bc36-e4633c6e696d",
                                "sense_id": "6ae08fd8-858d-39b8-90ed-e4a987fedf94",
                                "text": "Une critique subtile de certaines façons de jouer la passion est cachée dans cet épisode ; mais on y voit aussi l’équivoque entre l’accès histrionique et le jeu de l’acteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e89098ba-614a-30bc-a6f9-e36710c2aa30",
                        "entry_id": "c0a6de40-4082-3bbb-bbfe-f203feb02b94",
                        "glosses": [
                            "Qui a besoin d’être aimé, d’être au centre de l’attention des autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c23265-d39f-4cd4-9b52-1e1cfabbb8a6",
                                "sense_id": "e89098ba-614a-30bc-a6f9-e36710c2aa30",
                                "text": "Du coup, les femmes histrioniques se font souvent traiter d’« allumeuses ».\nAvec la libération des mœurs, certaines femmes histrioniques vont aller plus loin en utilisant le sexe pour attirer l’attention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4ad90b3-29c5-4398-9f7c-9b04d5024029",
                        "source_entry_id": "c0a6de40-4082-3bbb-bbfe-f203feb02b94",
                        "target_lang_word": "theatralisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theatralisch",
