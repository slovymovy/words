                    },
                    {
                        "translation_id": "50457d02-0045-44aa-8ff4-e09a920bd9ad",
                        "source_entry_id": "345f14ca-cdf9-3503-82ce-16822dc691d1",
                        "source_sense_id": "1a0a2070-746d-35d7-b4be-0f066393d419",
                        "source_sense_description": "een internationale sanctie waarbij een partij geen wapens kan aankopen",
                        "target_lang_word": "Waffenembargo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenembargo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e31813a0-b0cc-3f64-8168-2745b5841064",
                                        "entry_id": "3b5b5ed6-a6f3-39d4-8963-2616a746eb1e",
                                        "glosses": [
                                            "Embargo, das Waffenlieferungen verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374fc457-641a-4f51-8f8c-fe53150ac1ea",
                                                "sense_id": "e31813a0-b0cc-3f64-8168-2745b5841064",
                                                "text": "„Die Durchsetzung eines Waffenembargos scheiterte am hartnäckigen Festhalten Pakistans an den Taliban.“"
                                            },
                                            {
                                                "example_id": "59b453b3-0719-4fc7-8de6-f19c310c6549",
                                                "sense_id": "e31813a0-b0cc-3f64-8168-2745b5841064",
                                                "text": "„Waffen waren knapp, da die Hauptrüstungslieferanten der arabischen Armeen, Frankreich und Großbritannien, ein Waffenembargo gegen Palästina verhängt hatten.“"
                                            },
                                            {
                                                "example_id": "f6d67a27-91d6-4605-b04d-3c658a75bfe9",
                                                "sense_id": "e31813a0-b0cc-3f64-8168-2745b5841064",
                                                "text": "„Am 19. Januar 2001 hatte der UN-Sicherheitsrat die Resolution 1333 verabschiedet und Sanktionen gegen die Taliban verhängt, unter anderem ein striktes Waffenembargo, die Beschlagnahmung sämtlicher Vermögenswerte der Taliban im Ausland und ein Verbot aller internationalen Flüge der afghanischen Fluggesellschaft Ariana.“"
                                            },
                                            {
                                                "example_id": "7cc94bb5-2e70-402c-b5bb-3c8f8c4be0b5",
                                                "sense_id": "e31813a0-b0cc-3f64-8168-2745b5841064",
                                                "text": "„Hinzu kam die in den 1960er Jahren zunehmende Wahrscheinlichkeit, dass Sanktionen gegen Südafrika verhängt werden könnten, insbesondere ein Waffenembargo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
