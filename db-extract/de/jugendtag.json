                                "example_id": "d981e014-ca86-489e-9124-eae9b3cbd8b1",
                                "sense_id": "43fba27b-7320-367b-8f16-cf2bec5bef42",
                                "text": "„Hier hatte er seine frühen Jugendtage verbracht, und hier saß er, wenn er wieder einmal zu Hause war.“"
                            }
