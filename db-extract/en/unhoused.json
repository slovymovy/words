                    {
                        "sense_id": "49bfa1c0-ffa0-307d-910a-d9234cdef0c4",
                        "entry_id": "a8c38db6-87b3-34a8-bf50-bd5640a81ce9",
                        "glosses": [
                            "Driven from one's home."
                        ],
                        "tags": [
