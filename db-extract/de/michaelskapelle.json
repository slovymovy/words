                "senses": [
                    {
                        "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                        "entry_id": "84e26c57-021d-3b99-8254-99c9d516f229",
                        "glosses": [
                            "Gotteshaus zu Ehren des Erzengels Michael, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df908063-397b-43e1-912b-f3efbde9facb",
                                "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                                "text": "In einer Michaelskapelle finden alle Gottesdienste stets auch in Andacht an den Heiligen Michael statt."
                            },
                            {
                                "example_id": "3ae0bea5-fdb5-4f5e-bb7e-81a976c653e1",
                                "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                                "text": "„Um 1870 wurden die Altäre der Michaelskapelle geschenkt.“"
                            },
                            {
                                "example_id": "fb1ddb44-d9cc-46e3-83be-d63884af7170",
                                "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                                "text": "„Die ursprüngliche St. Michaelskapelle geht wohl zurück in die Zeit der Christianisierung dieser Gegend.“"
                            },
                            {
                                "example_id": "9274e462-7543-45fb-a084-6d2e776f13e8",
                                "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                                "text": "„Besonders phantasievolle Besucher der Michaelskapelle können heute noch auf dem äußersten Felsvorsprung die kraftvollen Abdrücke der Pferdehufe erkennen, als es zum Sprung in die Saar ansetzte.“"
                            },
                            {
                                "example_id": "7b99a38f-39eb-4c51-a010-1c3b2e450bf2",
                                "sense_id": "931faa67-21d7-3afe-8d05-bf84e6e38115",
                                "text": "„Die Michaelskapelle, am Rande des Haardtgebirges über dem wohlhabenden Weinort Deidesheim gelegen, ist einer der leicht erreichbaren Aussichtsplätze über der Deutschen Weinstraße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
