                "translations": [
                    {
                        "translation_id": "9c6403aa-a777-4ada-bb0c-d6081d39aa8a",
                        "source_entry_id": "b65d0d79-9db0-3274-b9af-cc892f1ea66e",
                        "source_sense_id": "afac0ae1-9160-3b42-beee-9764c8c36915",
                        "target_lang_word": "horticultural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horticultural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "429d0a47-0be9-35d3-8286-d3f538834870",
                                        "entry_id": "9da897cb-7e8d-3e06-bb7f-40fcfc6d0794",
                                        "glosses": [
                                            "Of or pertaining to horticulture; connected with gardening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7815d6e-f10e-4972-951a-ea8d1ba73dce",
                                                "sense_id": "429d0a47-0be9-35d3-8286-d3f538834870",
                                                "text": "Throughout the garden there was, indeed, much arrangement, and much art; from the water-jet, trained to fling its silvery cascade, to the yew trees shaped into peacocks; still it was arrangement prompted by taste, and art that loved the nature which it guided. And if the horticultural skill, on which Mrs Churchill piqued herself, might have escaped the stranger's observation, the little knot now gathered before her terrace would inevitably have caught his attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcf39d68-671e-463d-a92e-f87e7dc58159",
                        "source_entry_id": "b65d0d79-9db0-3274-b9af-cc892f1ea66e",
                        "source_sense_id": "afac0ae1-9160-3b42-beee-9764c8c36915",
                        "target_lang_word": "gardening",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
                                            "The process or action of cultivating the soil, particularly in a garden; the care of a garden; horticulture."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f7451d-cf07-4b9f-9f1c-eb19f19450fb",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "His hobby was gardening."
                                            },
                                            {
                                                "example_id": "c53eb914-ed53-4df3-a4df-184844341e19",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "Gardening, then, is a sort of refined farming upon a limited scale."
                                            },
                                            {
                                                "example_id": "88539c15-887f-4752-8c2a-23f4cda4a0e4",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "Warm ambient air, loiterings abroad, gardenings, flowers to take about, and preserves to make, soothed the wicked imp to slumber in the parish of Hollingford in summer-time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
                                            "Any process of care, maintenance, or curation, especially digitally."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4941ad-5c0f-47bc-826d-e94aea1b6058",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "wiki gardening"
                                            },
                                            {
                                                "example_id": "a52852a4-a000-41ea-a772-ae5ce417ca3f",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "digital gardening"
                                            },
                                            {
                                                "example_id": "7d9b323b-4781-4992-8c39-692a6108424d",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "Several special pages help with the wiki gardening task:¶ ❑ Uncategorized pages (Special:Uncategorizedpages): These are pages that do not have one or more categories assigned. Use this page to ensure that all pages are categorized."
                                            },
                                            {
                                                "example_id": "db98885e-72eb-44a2-8f0b-b51c5aee1100",
                                                "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                                "text": "Tom Critchlow, a consultant who has been cultivating his digital garden for years, spells out the main difference between old-school blogging and digital gardening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed2f14e-8cc9-3588-b121-e15408e5112f",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
                                            "The act of a batsman prodding at the pitch with their bat, typically in order to flatten any bumps."
                                        ],
