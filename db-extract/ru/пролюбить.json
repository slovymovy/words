                        "examples": [
                            {
                                "example_id": "d0816083-1c62-46a1-9d4b-a33b1c4f9ef6",
                                "sense_id": "6b3df396-313c-3cfc-a0be-a052a696e4ff",
                                "text": "У меня, кажется, достанет сил прожить и пролюбить всю жизнь…"
                            }
                        ]
                    },
                    {
                        "sense_id": "445174b4-59c3-3712-99d1-1b0236c6fd77",
