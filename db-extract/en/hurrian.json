                    },
                    {
                        "translation_id": "b2f1cf4b-44c9-4fa1-9d49-7e928d32b818",
                        "source_entry_id": "a4531aec-b9a8-32f0-ba86-e8b9a867d2e6",
                        "source_sense_id": "32028b25-e830-3cc1-a688-3b059a48259c",
                        "source_sense_description": "the language of Hurrians",
                        "target_lang_word": "Hurritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hurritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "462969e1-1832-31f1-b82e-847b0e9a6d0a",
                                        "entry_id": "bc9519b0-a348-3e70-89fe-305672ffb0e6",
                                        "glosses": [
                                            "eine im 3. und 2. Jahrtausend im Vorderen Orient verbreitete Sprache, welche mit dem Urartäischen verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a288ae6-aa09-4bb7-a5e1-f4743f167213",
                                                "sense_id": "462969e1-1832-31f1-b82e-847b0e9a6d0a",
                                                "text": "„Besonders fühlbar ist [die unzureichende Repräsentation in schriftlichen Quellen] für das Hurritische, das nicht nur die Hauptsprache während der 250 Jahre der hurritisch-mittanischen Selbständigkeit war, sondern vermutlich in Nordmesopotamien seit dem Ende des 3. vorchristlichen Jt. weit verbreitet war.“"
                                            },
                                            {
                                                "example_id": "3697ce33-42f2-4da7-826e-2dd24ca9c214",
                                                "sense_id": "462969e1-1832-31f1-b82e-847b0e9a6d0a",
                                                "text": "Hurritisch war die Amtssprache des Mitanni-Reichs."
                                            },
                                            {
                                                "example_id": "d15be5eb-6ff5-4821-a7ff-4e8407d010c5",
                                                "sense_id": "462969e1-1832-31f1-b82e-847b0e9a6d0a",
                                                "text": "Das Hurritisch aus Hattuscha unterschied sich deutlich vom Dialekt des Mitanni-Briefs."
                                            },
                                            {
                                                "example_id": "914cf5c0-3624-4931-9da2-3d66d0d32cf8",
                                                "sense_id": "462969e1-1832-31f1-b82e-847b0e9a6d0a",
                                                "text": "Das Hurritische verfügt über eine sehr komplexe Morphologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
