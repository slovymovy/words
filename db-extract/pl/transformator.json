                    {
                        "translation_id": "82cbdafd-80b4-4946-9425-03d4e171f5e5",
                        "source_entry_id": "a6a7279a-ea35-3613-aa29-c8a232d9d990",
                        "source_sense_id": "c4542766-ceda-36f7-8b78-813bc9611b0a",
