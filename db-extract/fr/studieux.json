                                                "example_id": "2d51bdd7-53f7-477a-965c-0bf226df86ff",
                                                "sense_id": "9f876c84-6ae9-3cfe-9655-938f8e85646c",
                                                "text": "Dit soort dingen vertelde hij aan Kleine Woord, in wie hij, behalve een goed zoon, ook een leergierig opvolger vond."
                                            },
                                            {
                                                "example_id": "35137dc5-092b-4454-84d6-af0fd7cfcf87",
                                                "sense_id": "9f876c84-6ae9-3cfe-9655-938f8e85646c",
                                                "text": "Blijf je hele leven lang leren, zo blijf je nederig, leergierig en niet arrogant."
                                            }
