{
    "word_family": [
        "unveil",
        "veiled",
        "unveiling",
        "veiling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c1d78c3-f368-35b7-aad4-6c37473b1e6a",
                    "sense_definition": "A piece of fine material worn by women to protect or conceal the face, or used to cover an object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "covering_cloth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride lifted her white <w>veil</w> to kiss the groom.",
                            "target_lang_translations": {
                                "ru": "Невеста приподняла свою белую <w>фату</w>, чтобы поцеловать жениха.",
                                "zh": "新娘掀起白色的<w>头纱</w>亲吻了新郎。"
                            }
                        },
                        {
                            "text": "She wore a heavy black <w>veil</w> during the funeral service.",
                            "target_lang_translations": {
                                "ru": "Во время похоронной службы на ней была плотная черная <w>вуаль</w>.",
                                "zh": "葬礼期间，她戴着一顶厚重的黑色<w>面纱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "head covering",
                        "covering"
                    ],
                    "common_phrases": [
                        "bridal veil",
                        "wear a veil",
                        "lift the veil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок тонкой ткани, который носят женщины, чтобы закрыть лицо, или используют для покрытия предметов",
                        "zh": "一种女性佩戴的薄纱，用于遮盖面部，或用于覆盖物体的布料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вуаль",
                                "target_lang_sense_clarification": "тонкая прозрачная ткань или сетка на лицо"
                            },
                            {
                                "target_lang_word": "фата",
                                "target_lang_sense_clarification": "свадебный головной убор невесты"
                            },
                            {
                                "target_lang_word": "покрывало",
                                "target_lang_sense_clarification": "ткань для укрывания предметов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面纱",
                                "target_lang_sense_clarification": "遮盖面部的薄纱"
                            },
                            {
                                "target_lang_word": "头纱",
                                "target_lang_sense_clarification": "新娘佩戴的头饰"
                            },
                            {
                                "target_lang_word": "遮盖物",
                                "target_lang_sense_clarification": "用于覆盖物体的布料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d91db2fa-7296-3953-9ff3-b473cc1eaee5",
                    "sense_definition": "Something that covers or hides something else, making it difficult to see clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obscuring_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick <w>veil</w> of fog covered the valley early in the morning.",
                            "target_lang_translations": {
                                "ru": "Густая <w>пелена</w> тумана накрыла долину рано утром.",
                                "zh": "清晨，一层浓厚的雾气<w>笼罩</w>了整个山谷。"
                            }
                        },
                        {
                            "text": "The sun was hidden behind a grey <w>veil</w> of clouds.",
                            "target_lang_translations": {
                                "ru": "Солнце скрылось за серой <w>вуалью</w> облаков.",
                                "zh": "太阳躲在灰色的云层<w>遮蔽</w>之下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curtain",
                        "shroud",
                        "cloak",
                        "blanket"
                    ],
                    "common_phrases": [
                        "veil of mist",
                        "veil of smoke",
                        "through a veil"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что покрывает или скрывает что-либо, мешая ясно видеть",
                        "zh": "遮盖或隐藏某物，使其难以看清的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "сплошной покров (тумана, слез), мешающий видеть"
                            },
                            {
                                "target_lang_word": "завеса",
                                "target_lang_sense_clarification": "преграда, скрывающая вид (дымовая, огненная)"
                            },
                            {
                                "target_lang_word": "вуаль",
                                "target_lang_sense_clarification": "легкая дымка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "像幕布一样遮盖住"
                            },
                            {
                                "target_lang_word": "遮蔽",
                                "target_lang_sense_clarification": "遮挡视线"
                            },
                            {
                                "target_lang_word": "迷雾",
                                "target_lang_sense_clarification": "指代模糊不清的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b02c92-3a51-39b4-9b05-bf9b51f62549",
                    "sense_definition": "A state of secrecy or something that hides the truth or reality of a situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obscuring_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to draw a <w>veil</w> over the scandal.",
                            "target_lang_translations": {
                                "ru": "Правительство попыталось скрыть скандал под <w>завесой</w> молчания.",
                                "zh": "政府试图用沉默的<w>面纱</w>掩盖这起丑闻。"
                            }
                        },
                        {
                            "text": "There is a <w>veil</w> of mystery surrounding his sudden disappearance.",
                            "target_lang_translations": {
                                "ru": "Его внезапное исчезновение окружено <w>завесой</w> тайны.",
                                "zh": "他突然失踪的原因被一层神秘的<w>面纱</w>所笼罩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disguise",
                        "mask",
                        "cover-up",
                        "pretense"
                    ],
                    "common_phrases": [
                        "veil of secrecy",
                        "veil of silence",
                        "draw a veil over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние секретности или нечто, скрывающее истину или реальность ситуации",
                        "zh": "一种保密状态，或掩盖事实真相的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завеса",
                                "target_lang_sense_clarification": "в переносном смысле: то, что скрывает истину"
                            },
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "то, что прячет, укрывает тайну"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面纱",
                                "target_lang_sense_clarification": "比喻掩盖真相的屏障"
                            },
                            {
                                "target_lang_word": "遮羞布",
                                "target_lang_sense_clarification": "比喻掩盖丑事的手段"
                            },
                            {
                                "target_lang_word": "掩盖",
                                "target_lang_sense_clarification": "隐藏真相的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a0c4d88-9292-3746-ba2d-fcfef59236cc",
                    "sense_definition": "A thin layer of tissue that covers parts of a mushroom during its development.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology_membrane",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the mushroom grows, the <w>veil</w> breaks to reveal the gills underneath.",
                            "target_lang_translations": {
                                "ru": "По мере роста гриба <w>покрывало</w> разрывается, открывая пластинки под ним.",
                                "zh": "随着蘑菇的生长，<w>菌幕</w>破裂，露出了下方的菌褶。"
                            }
                        },
                        {
                            "text": "You can identify the species by the remnants of the <w>veil</w> on the stem.",
                            "target_lang_translations": {
                                "ru": "Вид можно определить по остаткам <w>покрывала</w> на ножке.",
                                "zh": "你可以通过菌柄上残留的<w>菌幕</w>来识别该物种。"
                            }
                        }
                    ],
                    "synonyms": [
                        "velum",
                        "membrane"
                    ],
                    "common_phrases": [
                        "universal veil",
                        "partial veil"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mycology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий слой ткани, покрывающий части гриба в процессе его развития",
                        "zh": "真菌生长过程中覆盖其部分结构的薄膜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывало",
                                "target_lang_sense_clarification": "микологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菌幕",
                                "target_lang_sense_clarification": "真菌学专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95053376-5f28-395c-809d-bf6538176c60",
                    "sense_definition": "To hide or obscure something so it is not clearly seen or known.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obscuring_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a thinly <w>veiled</w> threat during the negotiation.",
                            "target_lang_translations": {
                                "ru": "Во время переговоров он высказал плохо <w>завуалированную</w> угрозу.",
                                "zh": "他在谈判中发出了一个含蓄的、几乎没怎么<w>掩盖</w>的威胁。"
                            }
                        },
                        {
                            "text": "The mountain peaks were <w>veiled</w> in a heavy mist.",
                            "target_lang_translations": {
                                "ru": "Горные вершины были <w>окутаны</w> густым туманом.",
                                "zh": "山峰被浓雾<w>笼罩</w>着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conceal",
                        "mask",
                        "obscure",
                        "cloak",
                        "shroud"
                    ],
                    "antonyms": [
                        "reveal",
                        "expose",
                        "uncover"
                    ],
                    "common_phrases": [
                        "thinly veiled",
                        "veiled threat",
                        "veiled reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать или затуманивать что-либо, чтобы это не было ясно видно или известно",
                        "zh": "隐藏或模糊某事，使其不被清楚地看到或了解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вуалировать",
                                "target_lang_sense_clarification": "маскировать, скрывать истинный смысл"
                            },
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "обволакивать со всех сторон (туманом, тайной)"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "прятать от взгляда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掩盖",
                                "target_lang_sense_clarification": "使某事不明显"
                            },
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "被某种东西覆盖"
                            },
                            {
                                "target_lang_word": "含蓄",
                                "target_lang_sense_clarification": "指表达不直接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec1b8c4-0e36-3c68-a62b-40152267a076",
                    "sense_definition": "To cover someone or something with a veil or similar material.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "covering_cloth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue was <w>veiled</w> with a cloth before the official ceremony.",
                            "target_lang_translations": {
                                "ru": "Перед официальной церемонией статую <w>накрыли</w> тканью.",
                                "zh": "在正式仪式开始前，雕像被一块布<w>遮盖</w>住了。"
                            }
                        },
                        {
                            "text": "Women in the procession were <w>veiled</w> in black lace.",
                            "target_lang_translations": {
                                "ru": "Женщины в процессии были <w>под вуалями</w> из черного кружева.",
                                "zh": "游行队伍中的女性都<w>蒙着</w>黑色蕾丝面纱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "drape"
                    ],
                    "antonyms": [
                        "unveil",
                        "uncover"
                    ],
                    "common_phrases": [
                        "veiled face",
                        "heavily veiled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать кого-либо или что-либо вуалью или подобным материалом",
                        "zh": "用面纱或类似材料覆盖某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать",
                                "target_lang_sense_clarification": "накрывать тканью"
                            },
                            {
                                "target_lang_word": "завешивать",
                                "target_lang_sense_clarification": "закрывать занавесом или тканью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遮盖",
                                "target_lang_sense_clarification": "用布料覆盖"
                            },
                            {
                                "target_lang_word": "蒙上",
                                "target_lang_sense_clarification": "覆盖住表面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}