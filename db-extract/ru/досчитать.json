                    {
                        "translation_id": "6eed6b46-d838-4c69-8a98-9f8b54f58e00",
                        "source_entry_id": "73dd5738-7c14-30f2-ba7c-49692b8105ba",
                        "source_sense_id": "6be61b5c-71aa-328c-b2b1-f6590f40000e",
                        "target_lang_word": "count",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "count",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e29d9a4-7885-38a6-87a4-986128df679b",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To recite numbers in sequence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e042146-b232-4184-91f9-4168d0071495",
                                                "sense_id": "0e29d9a4-7885-38a6-87a4-986128df679b",
                                                "text": "Can you count to a hundred?"
                                            },
                                            {
                                                "example_id": "db9a1e59-5206-4f0c-acd1-598cee4cdb74",
                                                "sense_id": "0e29d9a4-7885-38a6-87a4-986128df679b",
                                                "text": "The psychiatrist asked her to count down from a hundred by sevens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e8a5890-a292-362f-8522-3b687a766447",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To determine the number of (objects in a group)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b889c27-a2ec-4767-8d34-c60065798f51",
                                                "sense_id": "6e8a5890-a292-362f-8522-3b687a766447",
                                                "text": "Count the number of apples in the bag and write down the number on the spreadsheet."
                                            },
                                            {
                                                "example_id": "dd13eeb0-851a-4aae-90b9-f2f0c541bfcd",
                                                "sense_id": "6e8a5890-a292-362f-8522-3b687a766447",
                                                "text": "The President of the Senate shall, in the presence of the Senate and House of Representatives, open all the certificates and the votes shall then be counted;\nThe person having the greatest number of votes for President, shall be the President,[…]"
                                            },
                                            {
                                                "example_id": "830c6590-bbaf-4ff3-8539-dc78382aa557",
                                                "sense_id": "6e8a5890-a292-362f-8522-3b687a766447",
                                                "text": "How do I love thee? Let me count the ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7722db3-0974-37d6-97ad-fbda711555a3",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To amount to, to number in total."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ab5455-ae19-40c2-9d5d-a5d523b56a5f",
                                                "sense_id": "f7722db3-0974-37d6-97ad-fbda711555a3",
                                                "text": "They counted thirty, crowded in a space\nWhich left scarce room for motion or exertion; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f012e78-3a17-3cc6-b72f-271040f6a20a",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To be of significance; to matter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d022f7-5804-4fb5-82df-876f8fae5698",
                                                "sense_id": "4f012e78-3a17-3cc6-b72f-271040f6a20a",
                                                "text": "Your views don’t count here."
                                            },
                                            {
                                                "example_id": "feb6fa9c-f507-4f3f-b94f-1cdf160ac242",
                                                "sense_id": "4f012e78-3a17-3cc6-b72f-271040f6a20a",
                                                "text": "It does count if you cheat with someone when you’re drunk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cb7934-a0a0-3a7f-a164-042ef057e54d",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To be an example of something: often followed by as and an indefinite noun."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "937907bb-a58b-4be1-a566-ba3f2f53c4d3",
                                                "sense_id": "92cb7934-a0a0-3a7f-a164-042ef057e54d",
                                                "text": "Apples count as a type of fruit."
                                            },
                                            {
                                                "example_id": "2a006a03-9372-4168-871f-9dd9719dcd9b",
                                                "sense_id": "92cb7934-a0a0-3a7f-a164-042ef057e54d",
                                                "text": "This excellent man […] counted among the best and wisest of English statesmen."
                                            },
                                            {
                                                "example_id": "20bb63bd-119f-416d-874b-2fd8d0fe1f3e",
                                                "sense_id": "92cb7934-a0a0-3a7f-a164-042ef057e54d",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too.[…]But as a foundation for analysis it is highly subjective: it rests on difficult decisions about what counts as a territory, what counts as output and how to value it. Indeed, economists are still tweaking it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1950f5a9-0ffa-3f52-a85a-2056f5e0e301",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To consider something as an example of something or as having some quality; to account, to regard as."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba817318-82b9-4565-9b6f-066d4092152a",
                                                "sense_id": "1950f5a9-0ffa-3f52-a85a-2056f5e0e301",
                                                "text": "He counts himself a hero after saving the cat from the river."
                                            },
                                            {
                                                "example_id": "372fcdbd-52e0-4776-9c5e-97c07af0e373",
                                                "sense_id": "1950f5a9-0ffa-3f52-a85a-2056f5e0e301",
                                                "text": "I count you as more than a friend."
                                            },
                                            {
                                                "example_id": "c10d150e-bde7-4698-b0ca-b4bc99169a5b",
                                                "sense_id": "1950f5a9-0ffa-3f52-a85a-2056f5e0e301",
                                                "text": "The entertainment we haue had of him,\nIs far from villanie or ſeruitude,\nAnd might in noble mindes be counted princely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b43fd4f-10c5-329f-817b-e98657ade022",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To reckon in, to include in consideration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810778e4-79ef-49cb-a394-a34e53b9de76",
                                                "sense_id": "9b43fd4f-10c5-329f-817b-e98657ade022",
                                                "text": "They walked for three days, not counting the time spent resting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa181b95-3550-327b-9cd0-29c6d43a2d84",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To take account or note (of), to care (for)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c05e4d7-45f7-4df1-b82a-f0ed983af240",
                                                "sense_id": "aa181b95-3550-327b-9cd0-29c6d43a2d84",
                                                "text": "[…]to make her faire, that no man counts of her beauty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6caa165-b521-31a3-a247-e3fca718780f",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To recount, to tell."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ffe0e2-51e3-3fff-95f6-c8b2e47c01f1",
                                        "entry_id": "28016860-fd86-35e8-bcf1-628ee42524db",
                                        "glosses": [
                                            "To plead orally; to argue a matter in court; to recite a count."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
