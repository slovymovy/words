                ],
                "senses": [
                    {
                        "sense_id": "4ee2f594-8a70-3947-b861-cc33773110c6",
                        "entry_id": "c7c9d8bd-9ea2-34af-95ea-14fbeb918223",
                        "glosses": [
                            "Tuer un autre joueur dans un jeu vidéo de type jeu de tir subjectif."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "37985979-06a9-4ae5-9605-3bec39249948",
                                "sense_id": "4ee2f594-8a70-3947-b861-cc33773110c6",
                                "text": "C'est sous ce pseudo méchamment viril qu'il se branche avec sa console sur le Net pour y disputer quelques parties d'Unreal, un jeu de guerre futuriste où il doit tuer (le terme consacré est «fraguer») le maximum d'adversaires, eux aussi armés jusqu'aux dents."
                            },
                            {
                                "example_id": "0ba597c0-44f5-4ecf-adb3-325e7a9f5492",
                                "sense_id": "4ee2f594-8a70-3947-b861-cc33773110c6",
                                "text": "J'ai abordé Carnage Céleste avec une certaine appréhension. En effet les DLC type \"arènes\" sont rarement les plus passionnants, et fraguer pour fraguer, ce n'est pas vraiment dans l'esprit de Bioshock (la preuve : le multijoueur du 2 était complètement hors sujet)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46124248-b41e-4f64-aa3e-c49d91603e64",
                        "source_entry_id": "c7c9d8bd-9ea2-34af-95ea-14fbeb918223",
                        "source_sense_id": "4ee2f594-8a70-3947-b861-cc33773110c6",
                        "target_lang_word": "frag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81862c22-4259-3a2d-b2b8-f268ce269783",
                                        "entry_id": "808d1a6f-38c3-3319-843a-5e8a862441c4",
                                        "glosses": [
                                            "A fragmentation grenade."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215c020c-98d3-4766-8904-d83cdf926be3",
                                                "sense_id": "81862c22-4259-3a2d-b2b8-f268ce269783",
                                                "text": "Police up your extra ammo and frags, don't leave nothing for the dinks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f3e282-afaa-3fa3-863e-9d3efe9a4b77",
                                        "entry_id": "808d1a6f-38c3-3319-843a-5e8a862441c4",
                                        "glosses": [
                                            "A successful kill in a deathmatch game. A point or score (when considered collectively) gained by successfully killing opponents in a deathmatch game."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a84dca2-2b41-43e7-a434-4d3f95fcf140",
                                                "sense_id": "42f3e282-afaa-3fa3-863e-9d3efe9a4b77",
                                                "text": "I'd been fighting him for ages, and then you stole my frag!"
                                            },
                                            {
                                                "example_id": "45560acb-fa78-4e59-94f8-c4b56940751e",
                                                "sense_id": "42f3e282-afaa-3fa3-863e-9d3efe9a4b77",
                                                "text": "Oh, man. Did you play Online Gaming last night? No, yeah, no? I did. I got so many frags."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                                        "glosses": [
                                            "To deliberately kill (one's superior officer) with a fragmentation grenade."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987422ed-2af8-42de-9bca-efbc5440c8fd",
                                                "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                                                "text": "One guy? I fragged a couple of hundred in 'Nam."
                                            },
                                            {
                                                "example_id": "093479ef-cd1c-45ee-889e-fd27c7aefde4",
                                                "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                                                "text": "Cowboy says in a low voice: “Never turn your back on Mother. Never cut him any slack. He fragged Mr. Shortround.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76a8d99-5215-3f48-953b-9579891205c8",
                                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                                        "glosses": [
                                            "To hit with the explosion of a fragmentation grenade."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45acf14b-cec6-408b-a592-a8841128eea1",
                                                "sense_id": "f76a8d99-5215-3f48-953b-9579891205c8",
                                                "text": "I fragged him once and then meleed him for the kill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                                        "glosses": [
                                            "To kill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dff59db-1281-4252-b21c-5b391ec3d096",
                                                "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                                                "text": "I fragged him but he fell off the ledge afterwards."
                                            },
                                            {
                                                "example_id": "d8d5849b-f114-43c4-938f-37246304a16e",
                                                "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                                                "text": "I have pistol-fragged far superior players coming at me with a shotgun with 100% health."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
