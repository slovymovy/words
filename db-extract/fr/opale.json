            {
                "entry_id": "5d7a5c8a-2692-34ac-9620-e83e1f517550",
                "word": "opale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4b13c370-ea66-43d4-b2bf-99262e35a535",
                        "entry_id": "5d7a5c8a-2692-34ac-9620-e83e1f517550",
                        "tags": [
                            "plural"
                        ],
                        "form": "opales"
