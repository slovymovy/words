                                        "sense_id": "32fc64f4-80e4-308e-9667-ef8984f67cff",
                                        "entry_id": "fe4a4b4a-f071-3a86-b1f6-7fbb3f78f9fa",
                                        "glosses": [
                                            "der Erdteil, der traditionell in Europa und Asien eingeteilt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d6bad7-9520-421e-aca0-2f403c4df77b",
                                                "sense_id": "32fc64f4-80e4-308e-9667-ef8984f67cff",
                                                "text": "Das Eurasien der Eiszeit war unter anderem von der Huftierart Saiga geprägt."
                                            },
                                            {
                                                "example_id": "f54b51b7-2ff9-4e29-8372-d17549d8d34a",
                                                "sense_id": "32fc64f4-80e4-308e-9667-ef8984f67cff",
                                                "text": "Damit erlebt eine der schillerndsten Gestalten der Weltgeschichte [..] eine neue Würdigung. Zu Recht, denn Dschingis Khan schuf „Eurasien“ und brachte so zwei Welten erstmals und dauerhaft zusammen."
                                            },
                                            {
                                                "example_id": "15807250-f37f-4ab0-8424-eea5098b632d",
                                                "sense_id": "32fc64f4-80e4-308e-9667-ef8984f67cff",
                                                "text": "„Europa und Asien fasst man oft als Eurasien mit 54 Millionen km² zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
