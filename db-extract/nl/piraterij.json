                                "target_senses": [
                                    {
                                        "sense_id": "aeb80611-5d49-39d4-9b09-045efd15fa5a",
                                        "entry_id": "178f7032-3484-3abf-8619-aa9621a9e06f",
                                        "glosses": [
                                            "Attaque sournoise d'un système informatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d1699b-fc83-4dc3-a556-7158cc9f458e",
                                                "sense_id": "aeb80611-5d49-39d4-9b09-045efd15fa5a",
                                                "text": "Les techniques de piratage informatique."
                                            },
                                            {
                                                "example_id": "ef2f3aa8-bc63-4f71-9339-62e46ab8a928",
                                                "sense_id": "aeb80611-5d49-39d4-9b09-045efd15fa5a",
                                                "text": "Le gouvernement canadien a répondu en organisant un sommet national sur le sujet et en promettant d'interdire les importations de dispositifs de piratage, d'augmenter les peines pour les voleurs de voitures et de renforcer les moyens de l'agence des frontières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f59a823-12c7-3cdb-8d9b-af2a04feb6b6",
                                        "entry_id": "178f7032-3484-3abf-8619-aa9621a9e06f",
                                        "glosses": [
                                            "Téléchargement illégal de biens culturels en dépit du droit d’auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83e288c-65b4-48b6-8f19-9aa8f3fe2779",
                                                "sense_id": "5f59a823-12c7-3cdb-8d9b-af2a04feb6b6",
                                                "text": "On parle du piratage de la musique et des films, mais les jeux vidéos et livres sont aussi piratés."
                                            },
                                            {
                                                "example_id": "1fea5a2d-b2ef-42c6-b044-6f4965aab803",
                                                "sense_id": "5f59a823-12c7-3cdb-8d9b-af2a04feb6b6",
                                                "text": "Cette approche fait penser à l’époque où l’Internet a fait exploser le piratage des musiques et des films et où certains y voyaient un espace de liberté pour les consommateurs face à des géants s’en mettant plein les poches. On disait que le piratage, c’était fun, c’était libre, tendance, presque révolutionnaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
