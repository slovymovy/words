                        "zh": [
                            {
                                "target_lang_word": "联合金币",
                                "target_lang_sense_clarification": "十七世纪英国的一种金币"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "unite",
                                "target_lang_sense_clarification": "nombre histórico de la moneda de oro británica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
