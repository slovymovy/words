                                        "entry_id": "b7929b80-01d3-34b5-a192-1fbcb54b5a21",
                                        "glosses": [
                                            "saloppe, zum Teil fehlerhafte und derbe Umgangssprache"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff0a844-888c-43f9-8fc9-353c65a6c706",
                                                "sense_id": "180dad97-ceb2-302c-bda7-c8d7ba1e3064",
                                                "text": "In seinem englischen Slang hat er seinen Frust ausgedrückt."
                                            },
                                            {
                                                "example_id": "0e3d1899-cc0b-44d7-84e9-d63825ba84a7",
                                                "sense_id": "180dad97-ceb2-302c-bda7-c8d7ba1e3064",
                                                "text": "„Seine Stimme war scharf und trocken, aber zwischendurch ließ sich eine schwache Spur von texanischem Slang entdecken wie das Wunder einer sprudelnden Quelle in der Wüste.“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c31c075-d3a1-3033-b7f7-922171b04227",
                                        "entry_id": "b7929b80-01d3-34b5-a192-1fbcb54b5a21",
                                        "glosses": [
                                            "Ausdrucksweise einer bestimmten abgegrenzten Menschengruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f128f532-6750-406f-80e4-93ebc1a34926",
                                                "sense_id": "3c31c075-d3a1-3033-b7f7-922171b04227",
                                                "text": "„Der Slang wird meistens als eine Art der Sondersprache betrachtet.“"
                                            },
                                            {
                                                "example_id": "be68fd00-7638-4e54-91b8-b8a031132ed6",
                                                "sense_id": "3c31c075-d3a1-3033-b7f7-922171b04227",
                                                "text": "Als die beiden Ingenieure in ihren technischen Slang verfallen sind, habe ich nicht mehr zugehört."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
