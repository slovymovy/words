                        "entry_id": "e2cf5fc1-c90c-32bb-8637-797dd7582df4",
                        "glosses": [
                            "Verkaufsstand auf dem Markt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4fa4686-bc43-4e8e-bc28-577e9445c1f9",
                                "sense_id": "5d2b0e53-7f62-335c-ad7b-f4cd8599901d",
                                "text": "„Die Gassen sind voll von Buden und Marktständen.“"
                            },
                            {
                                "example_id": "b6e4fd32-47cd-401c-9f47-91652864ba68",
                                "sense_id": "5d2b0e53-7f62-335c-ad7b-f4cd8599901d",
                                "text": "„In Teguise fand ich einen Parkplatz ganz in der Nähe des Marktes und setzte mich gleich ins erste Straßencafé; Rudi ließ ich allein zwischen den Marktständen schlendern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
