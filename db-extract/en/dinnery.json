                        "glosses": [
                            "Of or relating to dinner; resembling dinner."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "00ab6ba6-46fb-4807-adc6-76ad5f3f76ad",
                                "sense_id": "c3be0784-1ff6-3fbf-b6ac-52252ddb379a",
                                "text": "“For with an invalid so much depends on tranquillity. In the drawing-room, for instance, she might constantly be disturbed by callers; and the dining-room is so—so what shall I call it? so dinnery,—the smell of meals never seems to leave it; it would have been different if dear papa had allowed me to throw out that window—”"
                            },
                            {
                                "example_id": "9fb74cfa-5820-4716-923f-5e078fcc7896",
                                "sense_id": "c3be0784-1ff6-3fbf-b6ac-52252ddb379a",
                                "text": "It was evening, the hour when warm dinnery smells pervaded the walls and whiffs of other people’s trays came a-visiting."
                            }
                        ]
                    }
