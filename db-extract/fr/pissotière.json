        "fr-extract.jsonl": [
            {
                "entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                "word": "pissotière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "28773a44-3e8d-4729-881d-8f73a537a228",
                        "entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "tags": [
                            "plural"
                        ],
                        "form": "pissotières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                        "entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "glosses": [
                            "Pissoir; édicule public permettant aux hommes d’uriner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e80602-be6d-44cc-9d6a-0089752342ba",
                                "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                                "text": "On y passe à trois,\nChacun en occupe un tiers,\nC'est pourquoi cet endroit\nS'appelle une pissotière !"
                            },
                            {
                                "example_id": "83db2b9b-a10e-4919-a5eb-0175ded4ba09",
                                "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                                "text": "Ne sucez pas les messieurs dans les pissotières avant une heure du matin."
                            },
                            {
                                "example_id": "4732a192-4d7b-4dc8-8c53-a9236e9d0bad",
                                "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                                "text": "Monsieur le sénateur, il vous arrive une histoire fâcheuse... Vous vous êtes permis quelques privautés sur la personne d'un petit marmiton qui stationnait dans une pissotière."
                            },
                            {
                                "example_id": "de7c97b5-f394-4624-824d-369dc4ebfbc4",
                                "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                                "text": "Il fouillait du regard cette chambre d’hôtel pour y découvrir un détail cocasse, sans doute navrant. Mais cette chambre de passe où défilait un bétail ininterrompu était plus commune qu’une pissotière, on n’y voyait même pas d’inscriptions. Il n’y avait que des taches, sur les murs, sur le tapis, sur les meubles. On devinait sur les draps d’autres taches, masquées par la chimie du blanchissage."
                            },
                            {
                                "example_id": "5ff9fef6-3551-495d-b157-03cf910a97c4",
                                "sense_id": "2e8dca71-337a-34ae-bcfc-cd4c16c1169e",
                                "text": "Un graffiti, ça se lit, ça attire l’attention, c’est insolite. Et je pense qu’en somme ma prose pissotière répond à ce besoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ff62915-eec5-394f-ae92-e4292d57c5fe",
                        "entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "glosses": [
                            "Jet d’eau ou fontaine qui jette peu d’eau."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6c058f2c-6149-4546-832c-8642e0754431",
                                "sense_id": "9ff62915-eec5-394f-ae92-e4292d57c5fe",
                                "text": "Ce n’est qu’une pissotière."
                            }
                        ]
                    },
                    {
                        "sense_id": "74568ef9-1cdb-3155-9b9d-571bcda8a654",
                        "entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "glosses": [
                            "Trou oblique percé dans la muraille du navire pour permettre l’écoulement des eaux."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb50cdf6-78b4-438f-be9e-ac724ba6899b",
                        "source_entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "target_lang_word": "Pinkelbude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8707e169-02c4-48f3-a9b8-8a2ee4d10d16",
                        "source_entry_id": "55314118-8213-359f-9bc0-eac5cc437aa8",
                        "target_lang_word": "Pissoir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pissoir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                        "entry_id": "0dbbaca2-ba41-3161-a40b-90c0661eecf0",
                                        "glosses": [
                                            "Toilette für Männer mit Becken zum Urinieren im Stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ad5ecc-9235-4260-ab39-72fcd52f62b8",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Im Pissoir des »Adler« hatte ein Unbekannter an die Wand geschrieben, »der Arbeiter, wo Hindenburg oder Hitler wählt, gehört mein Lebetag gequält«.“"
                                            },
                                            {
                                                "example_id": "7d6b78f7-50e4-4e19-a6b4-ee7caf755aac",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Die ersten öffentlichen Pissoirs wurden errichtet, die Anwohner allerdings protestierten gegen die neuen »Stinkbuden«.“"
                                            },
                                            {
                                                "example_id": "e9e6684a-4ecc-48d3-9e2e-709b427c1443",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Stuff stellt sich im Pissoir an das Becken neben Kalübbe.“"
                                            },
                                            {
                                                "example_id": "431d1441-fb6b-44b7-b621-eef63400543e",
                                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                                "text": "„Als zwei Männer hereinkamen, die sich am Pissoir weiter auf italienisch unterhielten, atmete er unwillkürlich ganz flach und rührte sich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
