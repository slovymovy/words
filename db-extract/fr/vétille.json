        "fr-extract.jsonl": [
            {
                "entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                "word": "vétille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8efe72cc-6f7e-4c63-b446-7b24f782b6fd",
                        "entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                        "tags": [
                            "plural"
                        ],
                        "form": "vétilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                        "entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                        "glosses": [
                            "Petite chose sans importance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d71e0c96-95f0-4b8f-841b-ebfad57462dd",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Le garçon est pour la fille,\nLa fille est pour le garçon;\nQuoi qu'on fasse et qu'on babille,\nCe n'est, ma foi, que vétille,\nQue mystère et que façon."
                            },
                            {
                                "example_id": "d34fcb2d-2c3c-4fd4-b18d-019b450b1e21",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Finalement, on vota une loi d’amnistie pour déclarer qu'on ne voulait plus entendre parler de toutes ces vétilles."
                            },
                            {
                                "example_id": "99aa4613-37f7-43b9-a4b6-17fdcb6d1ed5",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Je penche pour une vétille qui a pris, aux yeux du fou qu'était Dragomin, des proportions considérables."
                            },
                            {
                                "example_id": "b605a8b0-d94b-452c-8fa7-b79e80a52fef",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Je m’imaginais immédiatement être des leurs, ainsi que le héros de la pièce, garçon de bonne famille que son père met – à propos d’une vétille – dans ce bagne d’enfants et qui finit par se pendre."
                            },
                            {
                                "example_id": "bc5ec00d-0a05-40f8-bfd2-988503650c1d",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Rien du tout. Quel parti tirer de pareille vétille ?"
                            },
                            {
                                "example_id": "8e0358b8-3419-414b-9e19-72160cfed7a8",
                                "sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                                "text": "Je n'ai pas traversé le royaume pour une vétille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdeecb8b-13ac-4dfa-88b1-224696e22ca3",
                        "source_entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                        "source_sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                        "target_lang_word": "Nebensache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebensache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                        "entry_id": "a96e9de9-186d-3316-b0ea-cfd507665d33",
                                        "glosses": [
                                            "etwas, was unbedeutend oder nicht so wichtig ist"
                                        ],
                                        "tags": [
                                            "Plural ist selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd8e274-597d-4924-bf7f-25f33719b6d1",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "Chef zu den Mitarbeitern: „Wie müssen unsere Verluste abstellen. Alles andere ist Nebensache!“"
                                            },
                                            {
                                                "example_id": "9e4857fc-55f8-482f-b8c9-a0aaaf4b2804",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Alter und körperliche Fitness sind beim Tanzen Nebensache.“"
                                            },
                                            {
                                                "example_id": "b8a8b411-8d03-4e7c-9dc4-ac2402a76174",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "Wie die Maschine funktioniert, ist Nebensache. Hauptsache, sie läuft."
                                            },
                                            {
                                                "example_id": "38fef120-f87d-4fe8-9af5-5b97c4afb57e",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Im Zeitalter von Zentralheizungen und Doppelfenstern [sind] Heizungen einfach eine Nebensache geworden – sie müssen funktionieren und Wärme spenden.“"
                                            },
                                            {
                                                "example_id": "9924c55d-b463-429b-a49c-13f96c84dfae",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Lucas und Simon spielen eine Partie Tennis, aber das Match ist nur Nebensache.“ [Sie unterhalten sich lieber über eine Frau.]"
                                            },
                                            {
                                                "example_id": "f398fe86-2ea8-4d72-b8a3-5729c092a4b9",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Vermarktung und Wirtschaftlichkeit [der Wollschweine] sind für viele Halter Nebensache. Es macht einfach Freude, die intelligenten und sozialen Tiere in ihrem natürlichen Verhalten zu erleben.“"
                                            },
                                            {
                                                "example_id": "016dd634-ce3a-45c2-8bda-d24e16adc7bc",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Es brodelt in der Gerüchteküche rund um den FC Bayern. Seit dem Wochenende werden erste Nachfolger für Trainer Niko Kovac gehandelt und Gerüchte aus der Kabine gestreut. Dass ein entscheidendes Champions-League-Spiel ansteht, gerät zur Nebensache.“"
                                            },
                                            {
                                                "example_id": "3dc35836-08b6-4700-a601-dce7b99ea9aa",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„[Der Moderator] Willem […] war nah bei den Hörern. Seine Hitparade wurde schnell mal zur Nebensache, wenn eine Nadine ihm geschrieben hatte und wissen wollte, wie sie es anstellen könnte, Sängerin zu werden. Willem rief sie einfach an. Live auf Sendung.“"
                                            },
                                            {
                                                "example_id": "4e8e90ce-a5d7-451b-bb37-80a3816569a5",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Dieser Ausbilder hatte eine Wirkung auf mich. Der sagte: Geh du erst mal nach Leipzig und mache Buchkunst […], und wenn du das machst und die Bildnerei als Nebensache, und wenn du wirklich besondere Leistungen bringst, dann wird sich das andere sowieso lösen.“"
                                            },
                                            {
                                                "example_id": "963efe70-aab2-42b2-9aca-34404a449ef4",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Ein schlimmer Sturz von Mitfavorit Richie Porte bei Tempo 80 hat die Königsetappe der 104. Tour de France überschattet - und auch den hinterhältigen Angriff von Fabio Aru auf Topfavorit Chris Froome zur Nebensache werden lassen.“"
                                            },
                                            {
                                                "example_id": "227102a3-fc58-410c-bda1-964635389920",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Eigentlich geht es beim Parteitag der AfD in Magdeburg vor allem darum, die Kandidaten für den Europawahlkampf festzulegen. Doch das ist derzeit fast Nebensache, denn die AfD wird von einem handfesten Spendenskandal erschüttert.“"
                                            },
                                            {
                                                "example_id": "83653503-bf26-42b2-b249-afc3063015e1",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Der Fokus der Migrationsämter liegt nicht mehr auf Ausschaffungen. Ausschaffungen wurden zur Nebensache. Die Behörden haben vielmehr alle Hände voll damit zu tun, Unterkünfte zu organisieren für all die Menschen, die bleiben dürfen.“ [Anmerkung: 'Ausschaffung' ist ein Schweizer Wort für 'Abschiebung von Asylbewerbern']"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4218f715-b226-4811-8e72-c6212a358aed",
                        "source_entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                        "source_sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                        "target_lang_word": "Bagatelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagatelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                        "entry_id": "637d6acd-edaf-3139-a8f9-a859dc395e94",
                                        "glosses": [
                                            "kleine, unbedeutende Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd38fe9-90bb-4d28-9e3b-ec3402d9d829",
                                                "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                                "text": "Die Kosten sind im Vergleich zur Gesamtbestellung eine Bagatelle."
                                            },
                                            {
                                                "example_id": "73744e36-b54e-4890-827b-e5a03519f0b8",
                                                "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                                "text": "„Der Bruder, Mitte 20, und das noch minderjährige Mädchen hatten sich wegen einer Bagatelle lautstark in die Haare bekommen.“"
                                            },
                                            {
                                                "example_id": "9295be64-ebe0-49b4-b7c5-d405bc99b0f7",
                                                "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                                "text": "„Ach, die guten Iraner kannten unsere Weisheit in dieser Frage nicht, wir bringen eine solche Bagatelle ganz einfach in Ordnung durch eine Schlange und einen Apfel...“"
                                            },
                                            {
                                                "example_id": "4df0afa7-3b8c-48c3-b10f-6883082ba1ed",
                                                "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                                "text": "„Man sagte mir, ich dürfe dieser Bagatelle keinerlei Beachtung schenken, wenn ich meine Ehre nicht verlieren wolle.“"
                                            },
                                            {
                                                "example_id": "7d0cb4b3-b2f3-47eb-b88f-9802c31d6339",
                                                "sense_id": "be88ed36-783f-3461-b564-f070c47c84e0",
                                                "text": "„Er war auch ein Monomane der Bagatelle, vorausgesetzt daß sie sein Wohlbefinden anging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dc8b8f2-b451-36fd-9533-b5a4ecc95f23",
                                        "entry_id": "637d6acd-edaf-3139-a8f9-a859dc395e94",
                                        "glosses": [
                                            "kurzes Instrumentalstück"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64eaff3d-866d-4a52-871a-0a06ee85926c",
                                                "sense_id": "5dc8b8f2-b451-36fd-9533-b5a4ecc95f23",
                                                "text": "Als Zugabe bot der Pianist eine Bagatelle von Beethoven."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e4f2fe4-31d1-4017-a5fd-a0c3b3b95f8a",
                        "source_entry_id": "1aa5ec72-b306-34c3-945c-355cfa6f6ef1",
                        "source_sense_id": "a0ebc11b-107a-34b8-82de-dab829f7481a",
                        "target_lang_word": "trifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "An English dessert made from a mixture of thick custard, fruit, sponge cake, jelly and whipped cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c79891-8b81-4e10-965e-c82cfeea0232",
                                                "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                                "text": "It is interesting to watch the surface joviality on screen while racism is layered between courses like soggy trifles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c68516-c47b-4d02-89d9-6e2659ed57cf",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Trifles light as air / Are to the jealous confirmation strong / As proofs of holy writ."
                                            },
                                            {
                                                "example_id": "7a322d08-5d32-4bdf-ae4e-65156e9bb983",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Olde Chaucer doth of Topas tell, / Mad Rablais of Pantagruell, / A latter third of Dowsabell, / With such poore trifles playing:"
                                            },
                                            {
                                                "example_id": "6a71d67f-3840-4163-9984-2e1bb1705b17",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "[W]hen they had the Character and Honour of a VVoman at their Mercy, often times made it their Jest, and at least look’d upon it as a Trifle, and counted the Ruin of thoſe, they had had their VVill of, as a thing of no value."
                                            },
                                            {
                                                "example_id": "cc0830cd-ed41-4040-accd-6023fc7c1807",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "‘And all about a rattle!’ said Alice, still hoping to make them a little ashamed of fighting for such a trifle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth.",
                                            "An insignificant amount of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f54872-5640-4509-96de-a7698a1c41b3",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "A trifle, some eight-penny matter."
                                            },
                                            {
                                                "example_id": "bd603be3-d0d9-4754-b0a8-5084a51b2f27",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "He told her of horses which he had bought for a trifle and sold for incredible sums […]"
                                            },
                                            {
                                                "example_id": "8e271f1c-1a22-433f-9479-ec1c83112fde",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "What’s eighty dollars? A trifle. An insignificant sum."
                                            },
                                            {
                                                "example_id": "85951f32-6dda-42f7-aec1-972de8c23560",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "“It was bad of me then not to send the fifteen hundred dollars. I assumed it would be a trifle.” / “Well, until a few months ago it was a trifle.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A very small amount (of something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1634c6-8368-4253-8bff-c50aef9a1a95",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "This Line leaves out […] Poplar and Black-vvall, vvhich are indeed contiguous, a Trifle of Ground excepted, and very populous."
                                            },
                                            {
                                                "example_id": "204b9cd2-5780-403d-8608-6516694dd026",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "There was a good deal of rustling and whispering behind the curtain, a trifle of lamp smoke, and an occasional giggle from Amy […]"
                                            },
                                            {
                                                "example_id": "b3c1ac67-15a2-4679-8308-a8aab5d864ca",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "“Take just a trifle of French mustard […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8aabf77-061e-38c9-96be-9de1b426d461",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A particular kind of pewter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9bf760d-1973-3934-b633-aeb9b3929599",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Utensils made from this particular kind of pewter."
                                        ],
