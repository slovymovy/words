    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4788e68d-5a39-36d8-9b65-e497e6f7ee07",
                    "sense_definition": "The quality of being true, factual, or real, especially referring to a fundamental or enduring truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher spent his entire life searching for moral <w>verity</w> in a chaotic world.",
                            "target_lang_translations": {
                                "ru": "Философ посвятил всю свою жизнь поиску моральной <w>истины</w> в хаотичном мире."
                            }
                        },
                        {
                            "text": "Historical documents were examined carefully to establish the <w>verity</w> of the witness's claims.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были тщательно изучены, чтобы установить <w>достоверность</w> утверждений свидетеля."
                            }
                        }
                    ],
                    "synonyms": [
                        "truth",
                        "veracity",
                        "truthfulness"
                    ],
                    "antonyms": [
                        "falsity",
                        "falsehood"
                    ],
                    "common_phrases": [
                        "eternal verity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть истинным, достоверным или реальным; непреложная или фундаментальная истина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истина",
                                "target_lang_sense_clarification": "фундаментальная правда"
                            },
                            {
                                "target_lang_word": "достоверность",
                                "target_lang_sense_clarification": "соответствие фактам или действительности"
                            },
                            {
                                "target_lang_word": "правдивость",
                                "target_lang_sense_clarification": "свойство быть правдивым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74cb08bb-7ac8-3721-81b6-ac07417ecafb",
                    "sense_definition": "A fundamental truth, established principle, or widely accepted doctrine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The revolution swept away many of the political <w>verities</w> of the previous century.",
                            "target_lang_translations": {
                                "ru": "Революция смела многие политические <w>истины</w> предыдущего столетия."
                            }
                        },
                        {
                            "text": "Scientists began to question the long-accepted <w>verity</w> that the universe was static.",
                            "target_lang_translations": {
                                "ru": "Учёные начали сомневаться в давно признанной <w>аксиоме</w> о статичности Вселенной."
                            }
                        }
                    ],
                    "synonyms": [
                        "truism",
                        "axiom",
                        "tenet"
                    ],
                    "common_phrases": [
                        "ancient verities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальная истина, устоявшийся принцип или общепринятое положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истина",
                                "target_lang_sense_clarification": "непреложное утверждение или принцип"
                            },
                            {
                                "target_lang_word": "аксиома",
                                "target_lang_sense_clarification": "очевидная или принятая истина"
                            },
                            {
                                "target_lang_word": "догма",
                                "target_lang_sense_clarification": "утвердившееся положение или доктрина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e629d872-1c1c-32d2-84dd-13330e915a6d",
                    "sense_definition": "A female given name derived from the Latin word for truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents named her <w>Verity</w> in the hope that she would always speak the truth.",
                            "target_lang_translations": {
                                "ru": "Родители назвали её <w>Верити</w> в надежде, что она всегда будет говорить правду."
                            }
                        },
                        {
                            "text": "I received a letter yesterday from my old school friend <w>Verity</w>.",
                            "target_lang_translations": {
                                "ru": "Вчера я получил письмо от моей старой школьной подруги <w>Верити</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское личное имя латинского происхождения, означающее «истина»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Верити",
                                "target_lang_sense_clarification": "женское имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}