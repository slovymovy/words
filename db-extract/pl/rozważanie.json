                                                "sense_id": "63c8140d-7d46-3279-8f8a-ca9484c51296",
                                                "text": "ho alcune considerazioni da fare su quanto mi hai detto"
                                            },
                                            {
                                                "example_id": "472733f2-e596-4918-a828-a1c3d84fbe24",
                                                "sense_id": "63c8140d-7d46-3279-8f8a-ca9484c51296",
                                                "text": "da ciò che abbiamo visto possiamo trarre varie considerazioni"
                                            }
