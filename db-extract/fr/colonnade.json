        "fr-extract.jsonl": [
            {
                "entry_id": "0b6e2409-dbaa-3526-81ac-a03c5a153d26",
                "word": "colonnade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6bf9933e-411a-40ad-943e-3dc7b97406f0",
                        "entry_id": "0b6e2409-dbaa-3526-81ac-a03c5a153d26",
                        "tags": [
                            "plural"
                        ],
                        "form": "colonnades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                        "entry_id": "0b6e2409-dbaa-3526-81ac-a03c5a153d26",
                        "glosses": [
                            "Ensemble de colonnes disposées à intervalles réguliers sur une ou plusieurs rangées, le long de la façade d'un édifice, autour d'une place publique etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a52fa9b-73dc-4ffa-a53b-0e48e5da6741",
                                "sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                                "text": "[…] ; la façade de François Ier avec ses colonnades surchargées d’ornemens ; […]."
                            },
                            {
                                "example_id": "3ded18b2-d646-4294-86b2-1d2d6044f936",
                                "sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                                "text": "Ayant dit, M. de Bernage tourna les talons et se lança sur la longue esplanade plantée d’arbres qui borde la colonnade latérale de l’église."
                            },
                            {
                                "example_id": "fbdcb342-7bc5-42a0-bdf7-63e8bbd64b53",
                                "sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                                "text": "Les Grecs vivaient au grand air. […]. Leurs lieux de réunion, cela est assez connu, étaient des places publiques, généralement voisines des portiques ou colonnades où l’on se réfugiait en cas de pluie."
                            },
                            {
                                "example_id": "ac90d5a0-ce2c-4b9e-8128-0f642270a450",
                                "sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                                "text": "Parfois apparait une belle colonnade de cyprès, sombre évocatrice de l’Orient, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26d62778-ffae-4303-8223-f6fd45f76edf",
                        "source_entry_id": "0b6e2409-dbaa-3526-81ac-a03c5a153d26",
                        "source_sense_id": "903bfd6b-e343-32d3-b4f4-5bccd98aee8f",
                        "source_sense_description": "(Architecture) Alignement en file de colonnes",
                        "target_lang_word": "Kolonnade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolonnade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6103cb-086f-31e6-b39b-0247b358abba",
                                        "entry_id": "9978ec65-f60a-3f04-ab08-a52ffea2c767",
                                        "glosses": [
                                            "Säulengang mit einem geraden Gebälk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81353d5-1c3c-442a-a7ec-5a59b2dcfd94",
                                                "sense_id": "0d6103cb-086f-31e6-b39b-0247b358abba",
                                                "text": "„Kolonnaden waren bereits in archaischer Zeit bekannt und wurden in der zweiten Hälfte des 5. Jahrhunderts v. Chr. für die Agora von Athen übernommen.“"
                                            },
                                            {
                                                "example_id": "35c77fb0-82d4-4810-a403-32ee22ffd3bb",
                                                "sense_id": "0d6103cb-086f-31e6-b39b-0247b358abba",
                                                "text": "bildlich: „Das Laub, das bis dahin als eine smaragdgrüne Kolonnade gedient hatte, verschwand, und das Land öffnete sich zu einer weiten, flachen Ebene frei von Bäumen und übersät mit verrosteten Stahlhaufen – tote Maschinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
