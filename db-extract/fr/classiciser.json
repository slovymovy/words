                "senses": [
                    {
                        "sense_id": "e86eb9e1-a78a-36b1-9c20-e7bad38ec52a",
                        "entry_id": "edec0cf8-f0f7-3f53-b5ea-c30dc47731e7",
                        "glosses": [
                            "Donner un caractère classique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84e5fea-1ad3-4fb9-85d3-4e5b7f9b241b",
                                "sense_id": "e86eb9e1-a78a-36b1-9c20-e7bad38ec52a",
                                "text": "Tandis que la plupart des critiques utilisent la « retraite » pour classiciser le Corneille d’avant 1659, c’est seulement en 1676 que le dramaturge prétend à une stature d’auteur classique."
                            },
                            {
                                "example_id": "135c5e63-25eb-4beb-b9d5-3f5002e9ad64",
                                "sense_id": "e86eb9e1-a78a-36b1-9c20-e7bad38ec52a",
                                "text": "L'opération a sans doute pour but de \"classiciser\" Goubaïdoulina."
                            },
                            {
                                "example_id": "61e4330a-0212-4840-b392-f8a62aa4d7d4",
                                "sense_id": "e86eb9e1-a78a-36b1-9c20-e7bad38ec52a",
                                "text": "Un peu de zèbre vient funkyser l'ensemble et la veste charbon le classiciser."
                            }
                        ]
                    }
