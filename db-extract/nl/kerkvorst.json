                    {
                        "sense_id": "2507a876-662c-3ac7-889c-4a5df7e42a60",
                        "entry_id": "e68988e8-9d83-32a1-9f9d-049c5fbdadcc",
                        "glosses": [
                            "hooggeplaatste geestelijke in een kerk"
