                        "sense_id": "1f32d556-19f1-3cbc-9c7b-efb375fa66bf",
                        "entry_id": "1f46db2f-c901-3e1d-b2ec-f8c1a2f0b7b1",
                        "glosses": [
                            "Lupe, die zum Vergrößern von Texten dient, sie lesbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68d2f0e-91b5-4236-b28f-113f2cb79950",
                                "sense_id": "1f32d556-19f1-3cbc-9c7b-efb375fa66bf",
                                "text": "„Vor einem Seniorenheim hatten alte Männer auf Brettern Leselupen und geschmuggelte Zigaretten zum Verkauf ausgelegt.“"
                            },
                            {
                                "example_id": "3b7ea7b3-ee16-4f37-a1bc-00b9db1ea328",
                                "sense_id": "1f32d556-19f1-3cbc-9c7b-efb375fa66bf",
                                "text": "„Oder aber sie sitzt unten im Foyer in einem großen roten Ledersessel am Kamin und liest, mit der dicken Leselupe über das Buch auf dem Schoß gebeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
