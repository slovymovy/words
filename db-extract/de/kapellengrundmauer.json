                ],
                "senses": [
                    {
                        "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                        "entry_id": "49837ae3-2412-3522-9a1b-9e54b4569866",
                        "glosses": [
                            "das Fundament bildendes Mauerwerk, das sich in der Erde befindet und auf dem das Kapellengebäude steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78053907-8cc4-434e-9ce1-93b48bc488cb",
                                "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                                "text": "„Die Urkundenrolle, die historische Dokumente, zwei aktuelle Tageszeitungen, Zeichnungen der Kapelle, Münzen und eine Hövelhofer Rundschau beinhaltet, wurde anschließend hinter dem Grundstein in der Kapellengrundmauer eingemauert.“"
                            },
                            {
                                "example_id": "6b914e04-dcdc-4c9e-9a00-661b6b1243a9",
                                "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                                "text": "„Interessiert nahmen die Neuseser ein Schreiben des Landesamts für Denkmalpflege, Außenstelle Schloss Seehof zur Kenntnis, in dem mitgeteilt wird, dass es durchaus denkbar ist, dass unter der Kapellengrundmauer der Mutter-Gottes-Kapelle oberhalb von Poxstall Reste eines älteren Turmes sind.“"
                            },
                            {
                                "example_id": "a6fbc910-f299-4111-915f-3cfb6ab68bfd",
                                "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                                "text": "„Die Mauloffer hatten also auf alten Kapellengrundmauern ein neues Gotteshaus errichtet und einen Friedhof mit einer Mauer rundherum angelegt.“"
                            },
                            {
                                "example_id": "2d0cbf1c-b171-49d0-8f7a-a3fe4a9d6e1a",
                                "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                                "text": "„Hier gelangt man rechts auf einem Abstecher über den Wiesenstreifen hinweg zu den Kapellengrundmauern der Wüstung Holnstein, und links führt der Forstweg, auf dem wir an den Abzweigen stets rechts bleiben, nach gut einem Kilometer zurück zum Parkplatz.“"
                            },
                            {
                                "example_id": "cc1649ab-6035-4bdb-a8f6-b61a3976af03",
                                "sense_id": "4f888c4a-369d-33ef-be66-1365cd94995c",
                                "text": "„Hier gelangt man rechts auf einem Abstecher über den Wiesenstreifen hinweg zu den Kapellengrundmauern der Wüstung Holnstein, und links führt der Forstweg, auf dem wir an den Abzweigen stets rechts bleiben, nach gut einem Kilometer zurück zum Parkplatz.“"
                            }
                        ],
