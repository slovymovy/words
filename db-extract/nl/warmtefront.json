                    {
                        "sense_id": "f2231c64-8817-31a2-9b81-64bb30cf02c5",
                        "entry_id": "1669dcf9-91ce-34cc-a408-26bd5fe0af1b",
                        "glosses": [
                            "een front waar een luchtmassa met relatief warme lucht over een gebied schuift waar koude lucht ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653e9846-36e7-4f4a-be31-fdfbb0cafb98",
                                "sense_id": "f2231c64-8817-31a2-9b81-64bb30cf02c5",
                                "text": "Morgen wordt de zachte lucht even verdreven, maar morgenavond en in de nacht naar dinsdag zorgt een warmtefront ervoor dat we opnieuw met warme lucht te maken krijgen."
                            },
                            {
                                "example_id": "a815ac48-8b3d-4787-9031-1a8812840c20",
                                "sense_id": "f2231c64-8817-31a2-9b81-64bb30cf02c5",
                                "text": "Jammer die regen, maar het warmtefront is wel noodzakelijk om de temperatuur te laten stijgen zodat we vrijdag kunnen genieten van veel beter weer."
                            },
                            {
                                "example_id": "97959caf-1d16-4e4a-895d-b3752b6c4999",
                                "sense_id": "f2231c64-8817-31a2-9b81-64bb30cf02c5",
                                "text": "De temperatuur stijgt eerst bij het warmtefront, zoals een warmtefront betaamt, een aantal uren naar 9 tot 11 graden. Vervolgens passeert tussen 04.00 en 10.00 uur van west naar oost een scherp koufront, dat gepaard gaat met felle buien. Lokaal is veel regen mogelijk, 15 of 20 mm."
                            }
                        ]
                    }
