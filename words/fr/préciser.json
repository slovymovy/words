                        "préciser les détails"
                    ]
                },
                {
                    "sense_id": "4ca69c56-b2f2-3d6a-8833-b45787bf2a63",
                    "sense_definition": "Faire remarquer ou mentionner une information à titre de complément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indiquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tenu à <w>préciser</w> que la réunion commencerait à l'heure prévue."
                        },
                        {
                            "text": "Il convient de <w>préciser</w> que cette offre reste valable pendant deux semaines."
                        }
                    ],
                    "synonyms": [
