                        "glosses": [
                            "Donner un caractère canonial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b97622-e358-4e32-b8bb-c56349134252",
                                "sense_id": "ca9d9f01-29d8-3d5a-846d-901fe601b523",
                                "text": "Face à cette conjoncture, la vie monastique s'est adaptée. Elle a eu tendance à se canonialiser et à se séculariser."
                            },
                            {
                                "example_id": "44478c55-a7fd-43ef-82ed-3528e6beddbe",
                                "sense_id": "ca9d9f01-29d8-3d5a-846d-901fe601b523",
                                "text": "Toutefois, Philippe Racinet relativise la notion de décadence et estime que la vie monacale s’est adaptée en se canonialisant et se sécularisant."
                            }
                        ]
                    }
