            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e20038ef-4acd-31ea-bf8c-ae2769d1453e",
                    "sense_definition": "Conduire une personne vers un endroit précis ou l'accompagner pour lui montrer le chemin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous ne connaissez pas le chemin, je vais vous <w>mener</w> jusqu'au musée."
                        },
                        {
                            "text": "Le guide va <w>mener</w> le groupe de touristes à travers le centre historique."
                        }
                    ],
                    "synonyms": [
                        "conduire",
                        "emmener",
                        "guider"
                    ],
                    "antonyms": [
                        "suivre"
                    ],
                    "common_phrases": [
                        "mener la marche"
                    ]
                },
                {
                    "sense_id": "4e382795-b95a-37bf-ab4a-c2cb53f60f4b",
                    "sense_definition": "Aboutir quelque part ou permettre d'y accéder, en parlant d'un chemin ou d'une route.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit sentier boisé va nous <w>mener</w> directement au bord du lac."
                        },
                        {
                            "text": "Les randonneurs ont découvert que cette route étroite ne pouvait <w>mener</w> nulle part."
                        }
                    ],
                    "synonyms": [
                        "aboutir",
                        "conduire"
                    ],
                    "common_phrases": [
                        "mener nulle part"
                    ]
                },
                {
                    "sense_id": "bbfaf398-5d9e-3d26-85cc-e2aa6d99d97a",
                    "sense_definition": "Diriger, organiser ou gérer une activité, un projet ou des affaires.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inspecteur a commencé à <w>mener</w> une enquête minutieuse sur cet incident."
                        },
                        {
                            "text": "La directrice a su <w>mener</w> ce projet ambitieux jusqu'à son terme."
                        }
                    ],
                    "synonyms": [
                        "conduire",
                        "diriger",
                        "gérer",
                        "piloter"
                    ],
                    "common_phrases": [
                        "mener des négociations",
                        "mener un projet",
                        "mener une enquête"
                    ]
                },
                {
                    "sense_id": "f01312bd-6b9b-3a49-b5a8-9d1bb9d80a4b",
                    "sense_definition": "Avoir l'avantage ou être en avance au score au cours d'un match ou d'une compétition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe locale continue de <w>mener</w> au score après un premier but magnifique."
                        },
                        {
                            "text": "Les joueurs français <w>mènent</w> largement à quelques minutes de la fin du match."
                        }
                    ],
                    "synonyms": [
                        "dominer"
                    ],
                    "common_phrases": [
