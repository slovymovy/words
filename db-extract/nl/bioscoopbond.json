                        "examples": [
                            {
                                "example_id": "172a8a82-388b-44e0-bd4a-66df99337a19",
                                "sense_id": "365f3211-c43a-3d93-abec-1d892c98f90d",
                                "text": "De hoofdrolspelers uit The Interview, Seth Rogen en James Franco, hebben gisteren een aantal interviews afgezegd. De Amerikaanse bioscoopbond geeft geen commentaar."
                            },
                            {
                                "example_id": "6627ba76-c1f2-4d9f-a4de-2fc01157a70f",
                                "sense_id": "365f3211-c43a-3d93-abec-1d892c98f90d",
                                "text": "\"Het paleis is altijd een zomerpaleis geweest. Pas in 1937 werd het voor het eerst echt bewoond\", zegt De Gelder. \"Toen is er een heleboel gemoderniseerd en om het geschikt te maken voor bewoning in de twintigste eeuw. De nieuwe filmzaal hoorde daar ook bij. De projectoren, die het niet meer doen, werden aangeboden door de Nederlandse Bioscoopbond.\""
                            },
                            {
                                "example_id": "03cbe4a5-519d-4d41-bf4e-c3be00260b60",
                                "sense_id": "365f3211-c43a-3d93-abec-1d892c98f90d",
                                "text": "\"De Nederlandse Bioscoopbond beschouwt filmhuizen als concurrenten. Die draaien namelijk goed terwijl het bioscoopbezoek terugloopt. Daarom stelt de bioscoopbond bepaalde eisen aan filmhuizen waar wij nog niet aan voldoen."
                            }
                        ]
                    }
