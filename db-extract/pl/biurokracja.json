                    {
                        "sense_id": "805a8473-370b-3fe7-889a-a8aa5eb34cdd",
                        "entry_id": "eafb8919-d5b4-3743-8c08-1c165c233a76",
                        "glosses": [
                            "system zarządzania, w którym decydującą rolę odgrywa administracyjny aparat urzędniczy"
                        ],
                        "tags": [],
