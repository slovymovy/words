                "forms": [],
                "senses": [
                    {
                        "sense_id": "3319f345-6d0b-35c4-b382-e830209e2e03",
                        "entry_id": "4423d399-72bb-34f7-8235-5d4dd1dede4f",
                        "glosses": [
                            "op oneervolle manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a1bf4d-9fea-469d-be7e-7ee063b50133",
                                "sense_id": "3319f345-6d0b-35c4-b382-e830209e2e03",
                                "text": "Paardrijden was ook leerzaam.lk had een zeer deemoedigende experience toen Schilling me laatst op zijn paard liet rijden, hetwelk er stante pede van door ging tot ik smadelijk in het zand terecht kwam, zonder schadelijke gevolgen behalve t.a.v. het moreel want ik dacht al wat van de kunst te verstaan en het is minder dan niets.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f845bf84-9da8-4dee-acc8-5de0a98f57d2",
                        "source_entry_id": "4423d399-72bb-34f7-8235-5d4dd1dede4f",
                        "source_sense_id": "3319f345-6d0b-35c4-b382-e830209e2e03",
                        "source_sense_description": "oneervol",
                        "target_lang_word": "slanderous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slanderous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b76800-bff1-3cbc-bef0-2fcab6592e4e",
                                        "entry_id": "d7c2a66d-d9d3-3541-a71a-55ae0a369e1c",
                                        "glosses": [
                                            "Both untrue and harmful to a reputation."
                                        ],
                                        "tags": [
                                            "of something said"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b8967c-7cc6-4517-8388-576b0d0a104a",
                                                "sense_id": "b3b76800-bff1-3cbc-bef0-2fcab6592e4e",
                                                "text": "“Your lack of basic journalistic ethics in both the manner in which you ‘reported’ this uncredited nonsense, and the slanderous, unnecessary use of my picture without permission demands a response, and I am, of course, pursuing legal action.”"
                                            }
