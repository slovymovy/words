                    "sense_definition": "third-person singular simple present indicative of <w>hum</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always <w>hums</w> a happy tune while she is cooking dinner in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>напевает</w> веселую мелодию, когда готовит ужин на кухне."
                            }
                        },
                        {
                            "text": "The old refrigerator in the corner <w>hums</w> loudly throughout the night.",
                            "target_lang_translations": {
                                "ru": "Старый холодильник в углу громко <w>гудит</w> всю ночь."
                            }
