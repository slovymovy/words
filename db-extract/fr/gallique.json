                ],
                "senses": [
                    {
                        "sense_id": "a3db2f43-e2db-36ea-a819-f12854160790",
                        "entry_id": "6a7a83ab-d4b7-3d26-9a9e-4ddc503ed236",
                        "glosses": [
                            "Relatif à la Gaule, gaulois."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fda710fc-76a3-42c8-9d1e-db1077e61594",
                                "sense_id": "a3db2f43-e2db-36ea-a819-f12854160790",
                                "text": "Cette vallée a vu les invasions galliques descendre vers le midi et les légions romaines remonter ; elle a vu se ruer le torrent des Burgondes, des Vandales, des Visigoths et passer les légers escadrons arabes."
                            },
                            {
                                "example_id": "bf9d62e5-e88f-4890-9b02-97159a3a8e28",
                                "sense_id": "a3db2f43-e2db-36ea-a819-f12854160790",
                                "text": "En remontant vers les sources de Balesmes, j’ai eu parfois le sentiment d’être passé, en Haute-Marne, à côté de la partie la plus belle du voyage, cette « Gaule Chevelue » décrite par César, le pays gallique, la forêt sombre qui terrorisait les légions romaines, là où la Marne est la plus éveillée, la plus caracolante."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "855fd09c-1381-3c9f-89f9-713a8b97ea8b",
                "word": "gallique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
