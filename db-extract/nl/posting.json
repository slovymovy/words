                        "examples": [
                            {
                                "example_id": "2d67b5d4-335c-4920-a1f2-86e926ae6cac",
                                "sense_id": "c47ae4f0-a6f4-344d-a1cd-d69652d4f22f",
                                "text": "De extra beveiligingsmaatregelen worden pas anders als de persoon is gevonden die het bericht op internet plaatste of als op een andere manier duidelijk wordt wat voor verhaal er achter de posting schuilgaat. 'Maar we zetten natuurlijk in op het oppakken van degene die het bericht heeft geplaatst', aldus de burgemeester. Het onderzoek gaat volgens hem vooruit, maar of de politie inmiddels dichter op de huid van een verdachte is gekomen, kan hij niet zeggen."
                            },
                            {
                                "example_id": "9fd0e7dd-43cc-41f1-9fec-b20f1112278e",
                                "sense_id": "c47ae4f0-a6f4-344d-a1cd-d69652d4f22f",
                                "text": "Volgens een woordvoerder van het ministerie is Timmermans niet gestopt om de kritiek op zijn beleid. 'De Facebookpagina verwerd tot een podium van scheldpartijen tussen mensen die postings plaatsten op zijn pagina. Ze scholden niet op hem, maar op elkaar. Dat wilde hij niet langer.'"
                            }
                        ]
