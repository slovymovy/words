        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66772635-2dd9-34e9-b40f-cd787b2adadc",
                    "sense_definition": "Exerting control over a person or thing; having a strong desire to direct the behavior of others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mother is very <w>controlling</w> and tries to make all his decisions for him.",
                            "target_lang_translations": {
                                "ru": "Его мать очень <w>властная</w> и пытается принимать за него все решения.",
                                "zh": "他的母亲<w>控制欲很强</w>，试图替他做所有的决定。"
                            }
                        },
                        {
                            "text": "She decided to end the relationship because of his <w>controlling</w> behavior.",
                            "target_lang_translations": {
                                "ru": "Она решила разорвать отношения из-за его <w>контролирующего</w> поведения.",
                                "zh": "因为他那些<w>极具控制欲的</w>行为，她决定结束这段关系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bossy",
                        "domineering",
                        "overbearing"
                    ],
                    "antonyms": [
                        "submissive",
                        "yielding"
                    ],
                    "common_phrases": [
                        "controlling behavior",
                        "controlling nature",
                        "very controlling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремящийся контролировать других; властный, деспотичный.",
                        "zh": "控制欲强的，爱指手画脚的，专横霸道的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "властный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "деспотичный",
                                "target_lang_sense_clarification": "склонный к диктату"
                            },
                            {
                                "target_lang_word": "контролирующий",
                                "target_lang_sense_clarification": "ограничивающий свободу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控制欲强的",
                                "target_lang_sense_clarification": "形容极想左右他人言行的人或性格"
                            },
                            {
                                "target_lang_word": "专横的",
                                "target_lang_sense_clarification": "霸道独断、喜欢支配他人的"
                            },
                            {
                                "target_lang_word": "霸道的",
                                "target_lang_sense_clarification": "强硬专断的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55b59247-f962-3145-aab0-19842690859d",
                    "sense_definition": "The act of exerting control.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict <w>controllings</w> of the old regime were finally abolished by the new government.",
                            "target_lang_translations": {
                                "ru": "Строгие <w>меры контроля</w> старого режима были наконец отменены новым правительством.",
                                "zh": "旧政权严苛的各项<w>管制措施</w>最终被新政府废除了。"
                            }
                        },
                        {
                            "text": "He felt suffocated by the constant <w>controllings</w> of his daily schedule.",
                            "target_lang_translations": {
                                "ru": "Он задыхался от постоянного <w>контроля</w> своего расписания.",
                                "zh": "日常日程安排遭到的不断<w>管控</w>让他感到窒息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по осуществлению контроля.",
                        "zh": "控制行为，管制措施"
                    },
