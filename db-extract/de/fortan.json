                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b7275da-f54e-4249-becf-7de505610f52",
                        "source_entry_id": "a6a873ab-9e8f-3b30-b1b5-371948d8d468",
