                ],
                "senses": [
                    {
                        "sense_id": "51796b26-3292-33bd-a5d4-da10df3b435b",
                        "entry_id": "906a83e2-4355-3c66-a3fe-c1265748f3d0",
                        "glosses": [
                            "die von den Bauern für ihren Grundherrn zu leistende Arbeit"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4714387b-0c31-3a8a-9672-8e19d2dbbbdd",
                        "entry_id": "906a83e2-4355-3c66-a3fe-c1265748f3d0",
                        "glosses": [
                            "Arbeit, die man als Last empfindet"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "24141467-7ebb-4f1c-be41-255057ad2966",
                                "sense_id": "4714387b-0c31-3a8a-9672-8e19d2dbbbdd",
                                "text": "„Als die Leichter daran vorbeigerudert wurden, verlud man gerade zusammengekettete Arbeitstrupps auf ähnliche Boote, um sie zu ihrer täglichen Fron ans Ufer zu bringen.“"
                            },
                            {
                                "example_id": "92251008-942b-4f87-8eb6-33b25b0b4ba6",
                                "sense_id": "4714387b-0c31-3a8a-9672-8e19d2dbbbdd",
                                "text": "„Die Gesichter waren verschlafen, Unwille lag auf ihnen, der Unwille, aus dem wenigstens animalisch erwärmten Bett in den Frost der Straße, aus der Ruhe in harte Fron zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9008a800-f841-43b3-a9e4-6c58a2af3fb8",
                        "source_entry_id": "906a83e2-4355-3c66-a3fe-c1265748f3d0",
                        "source_sense_id": "51796b26-3292-33bd-a5d4-da10df3b435b",
                        "source_sense_description": "meist Singular, historisch: die von den Bauern für ihren Grundherrn zu leistende Arbeit",
                        "target_lang_word": "corvée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corvée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail et service gratuit qui était dû par le paysan à son seigneur."
                                        ],
                                        "tags": [
                                            "Histoire féodale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d9be9f-4104-47a0-870c-56d4a8ef7a54",
                                                "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                                "text": "Flétries dès leur enfance par la faim, écrasées par le travail dans leur adolescence, elles arrivent sans transition à la décrépitude, toujours fuyant devant les Turcs auxquels revient la meilleure part des sueurs de leurs pères, sous forme d’impôts, d’exactions et de corvées."
                                            },
                                            {
                                                "example_id": "793d9d2e-e505-4b76-87c6-4a55dd43f5e5",
                                                "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                                "text": "Les artisans ou les exploitants agricoles qui se désolent de devoir passer une journée par semaine en moyenne pour répondre à des exigences administratives, doivent, pour être exact, reformuler leurs doléances de cette manière : en sus de leur propre travail, ils sont contraints d'effectuer celui d'un fonctionnaire, à temps partiel et gratuitement. Ils effectuent, ce qu'on appelait, sous l'Ancien Régime, une corvée, c’est-à-dire un travail non rémunéré dû à la collectivité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8195b355-7914-3619-aeb6-cca4f1a891fd",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Prestation en nature ou travail exigible des habitants d’une commune pour l’entretien des chemins vicinaux."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Ensemble des travaux que font tour à tour les soldats d’une compagnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90b42ac-3163-4d5b-a6f2-fe699cebd890",
                                                "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                                "text": "Ils allumèrent des feux qu’ils entretinrent nuit et jour, et les hommes qu’on envoyait à la corvée du bois aux environs devaient tenir les loups en respect."
                                            },
                                            {
                                                "example_id": "c527d127-eed7-4530-8f79-f33fc68428bc",
                                                "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                                "text": "En trois mois, l'apprenti vit tomber dix-sept de ses camarades. Il résumait cette partie de son existence en ces mots : « Il y avait deux genres de corvée : les corvées de cailloux et les corvées d'enterrement. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail, soit du corps, soit de l’esprit, qu’on fait à regret, avec peine et sans profit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f30111-b831-44f4-bd17-b120641c7d37",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Depuis longtemps déjà il soupçonnait la chose, car de l’apprendre en confession il n’y fallait guère compter ; à partir de quinze ou seize ans tous s’émancipaient et se dispensaient de cette corvée ennuyeuse."
                                            },
                                            {
                                                "example_id": "3fe03541-1155-4641-a4a3-8c01c2ab7cc9",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Une autre corvée est la tournée des poubelles, des équevilles en patois de la Croix-Rousse."
                                            },
                                            {
                                                "example_id": "b2452eb0-8f00-4d97-a628-ac550ed1a4b6",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Pour lui, faire des achats représentait toujours une corvée, et même plus que cela, mais Emma et Lucy, elles, semblaient heureuses comme des poissons dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3854ade0-2774-3cc5-af94-07a5c5597e46",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail, soit du corps, soit de l’esprit, qu’on fait à regret, avec peine et sans profit.",
                                            "Travaux du ménage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89230122-3490-4399-aeed-475f4214798c",
                                                "sense_id": "3854ade0-2774-3cc5-af94-07a5c5597e46",
                                                "text": "Corvées domestiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba764f45-2e72-36cf-92e8-6f2aef6403d0",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Rassemblement volontaire et à titre gracieux de gens pour venir en aide ad hoc à quelqu'un dans le besoin (lever une grange, faire les foins, etc.)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28beec4e-eab0-40a9-80ce-ad8036a6195c",
                                                "sense_id": "ba764f45-2e72-36cf-92e8-6f2aef6403d0",
                                                "text": "Comme nos ancêtres défricheurs, qui se faisaient une fierté de participer aux grandes corvées, nous avons prouvé que ce n’est pas la distance qui empêcherait les Québécois de s’aimer et de s’entraider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
