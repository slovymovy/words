                ],
                "senses": [
                    {
                        "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                        "entry_id": "c690891f-65eb-3387-9d15-cf46cdc67f0c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b9f0f7e-5d9e-4933-b789-c878ef14084a",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Frau Engele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec7c5674-a096-4df5-9035-6fc0c6ce7b31",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Herr Engele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e8259587-91a0-40c0-9de4-926a23576d44",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Die Engeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "320ccca9-f6ad-4913-b4cd-a60e7dc44cc8",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Der Engele trägt nie die Pullover, die die Engele ihm strickt."
                            },
                            {
                                "example_id": "116a436a-7dd7-43d4-bf1b-765ffabdd525",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Engele kommt, geht der Herr Engele.“"
                            },
                            {
                                "example_id": "5b0fc7a3-c97d-450d-8313-eaeb0ecdc8aa",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Engele kommt und geht."
                            },
                            {
                                "example_id": "255d1d22-9271-4946-acde-33cf9ae121d7",
                                "sense_id": "b466a993-52fa-323d-9d1b-b2629c8162c3",
                                "text": "Engeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
