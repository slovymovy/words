                ],
                "senses": [
                    {
                        "sense_id": "32ebe5b0-d9e5-315a-bfec-ff18ee36b064",
                        "entry_id": "da2212a0-dc56-30fe-aca9-39369a3fae9a",
                        "glosses": [
                            "von Hand ausgeführte Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed5e42e-6f6d-4257-aea6-aac69a707a2b",
                                "sense_id": "32ebe5b0-d9e5-315a-bfec-ff18ee36b064",
                                "text": "„Im Handbetrieb kann die Markise über die Taste T1 ausgefahren und T2 eingefahren werden.“"
                            },
                            {
                                "example_id": "94459b37-920f-45c5-a59d-946469d9413d",
                                "sense_id": "32ebe5b0-d9e5-315a-bfec-ff18ee36b064",
                                "text": "„Die Eigenkonstruktion sollte die defekte Funktion des Scheibenwischers durch Handbetrieb ersetzen.“"
                            },
                            {
                                "example_id": "e73c8e4c-61d9-46ed-94be-018517aab60b",
                                "sense_id": "32ebe5b0-d9e5-315a-bfec-ff18ee36b064",
                                "text": "„So können Sie Ihr Fahrzeug auch ohne Probleme per Handbetrieb bedienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                        "entry_id": "da2212a0-dc56-30fe-aca9-39369a3fae9a",
                        "glosses": [
                            "manuelle sexuelle Befriedigung; Masturbation"
                        ],
                        "tags": [
                            "euphemistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "b613ad9d-d753-4bb1-8a83-a42099e43070",
                                "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                                "text": "Nach seiner Scheidung stellte er auf Handbetrieb um."
                            },
                            {
                                "example_id": "0a17025a-ac0e-4af9-8462-ad9830f59db0",
                                "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                                "text": "„Damit der Handbetrieb auch bei häufigem Gebrauch spannend bleibt, hat der Berater ein paar Tipps, die ganz ohne warmen Apfelkuchen oder Staubsauger-Unfälle auskommen.“"
                            },
                            {
                                "example_id": "373e33db-bd3b-4ee8-8a34-bd0eaa28f1a3",
                                "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                                "text": "„Zumindest einen prominenten Unterstützer hat die \"NoFap\"-Bewegung auch schon gefunden: Der Komödiant Greg Barris bekennt sich schon seit letztem August öffentlich zum Verzicht auf Handbetrieb.“"
                            },
                            {
                                "example_id": "3ebe7bfb-8792-466c-a172-978b363b6b14",
                                "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                                "text": "„Das , was ich bisher nie so recht glauben wollte: Theoriegewichse ist mindestens so befriedigend wie Handbetrieb.“"
                            },
                            {
                                "example_id": "aa440c8d-15d0-4fef-bea1-49931fce6af8",
                                "sense_id": "0439a3a0-2ea6-3b38-ab4d-7e3710a881fb",
                                "text": "„Die Partnerin wird das sexuelle Verlangen aufregender und liebevoller befriedigen, denn der eigene Handbetrieb bringt keine Überraschungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
