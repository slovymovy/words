                                        "glosses": [
                                            "das Handwerk des Schreiners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c614fa84-b131-466e-b1c3-e7c289165603",
                                                "sense_id": "2d69c069-7568-3f95-b0ea-0f7ecd6d2364",
                                                "text": "Die Schreinerei als Beruf bereitete ihm sehr viel Freude."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
