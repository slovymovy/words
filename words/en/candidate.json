{
    "word_family": [
        "candidacy",
        "candidature"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ca2ecd6-441c-3caa-a28f-bc37f334c4a7",
                    "sense_definition": "A person who applies for a job or competes in an election to win a position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "seeker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>candidate</w> gave a speech about his plans for the city.",
                            "target_lang_translations": {
                                "ru": "<w>Кандидат</w> произнес речь о своих планах относительно города.",
                                "pl": "<w>Kandydat</w> wygłosił przemówienie na temat swoich planów dla miasta."
                            }
                        },
                        {
                            "text": "She is the strongest <w>candidate</w> for the manager position.",
                            "target_lang_translations": {
                                "ru": "Она самый сильный <w>кандидат</w> на должность менеджера.",
                                "pl": "Ona jest najsilniejszą <w>kandydatką</w> na stanowisko menedżera."
                            }
                        }
                    ],
                    "synonyms": [
                        "applicant",
                        "nominee",
                        "contender",
                        "aspirant"
                    ],
                    "antonyms": [
                        "incumbent"
                    ],
                    "common_phrases": [
                        "presidential candidate",
                        "job candidate",
                        "political candidate",
                        "strong candidate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который претендует на работу или участвует в выборах, чтобы получить должность.",
                        "pl": "Osoba ubiegająca się o pracę lub startująca w wyborach na określone stanowisko."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "соискатель",
                                "target_lang_sense_clarification": "претендент на рабочее место"
                            },
                            {
                                "target_lang_word": "претендент",
                                "target_lang_sense_clarification": "участник конкурса или соревнования"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kandydat",
                                "target_lang_sense_clarification": "ogólne znaczenie"
                            },
                            {
                                "target_lang_word": "kandydatka",
                                "target_lang_sense_clarification": "forma żeńska"
                            },
                            {
                                "target_lang_word": "pretendent",
                                "target_lang_sense_clarification": "osoba ubiegająca się o tytuł lub pozycję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1f4511f-a210-3e17-b283-b8593b241bbe",
                    "sense_definition": "A person or thing regarded as suitable or likely to be chosen for a specific purpose or outcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seeker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This old building is a prime <w>candidate</w> for renovation.",
                            "target_lang_translations": {
                                "ru": "Это старое здание — главный <w>кандидат</w> на реставрацию.",
                                "pl": "Ten stary budynek jest głównym <w>kandydatem</w> do renowacji."
                            }
                        },
                        {
                            "text": "The doctor said my father is a good <w>candidate</w> for the new surgery.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что мой отец — подходящий <w>кандидат</w> для новой операции.",
                                "pl": "Lekarz powiedział, że mój ojciec jest dobrym <w>kandydatem</w> do nowej operacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "prospect",
                        "possibility"
                    ],
                    "common_phrases": [
                        "prime candidate",
                        "likely candidate",
                        "good candidate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, рассматриваемый как подходящий для определенной цели.",
                        "pl": "Osoba lub rzecz uważana za odpowiednią lub prawdopodobną do wybrania w konkretnym celu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "претендент",
                                "target_lang_sense_clarification": "подходящий объект"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kandydat",
                                "target_lang_sense_clarification": "w znaczeniu przenośnym"
                            },
                            {
                                "target_lang_word": "pretendent",
                                "target_lang_sense_clarification": "obiekt spełniający kryteria"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e136daf-0d6f-3312-966f-fbb61e5780ad",
                    "sense_definition": "A participant in an examination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>candidate</w> must bring two forms of identification to the testing center.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>экзаменуемый</w> должен принести два удостоверения личности в центр тестирования.",
                                "pl": "Każdy <w>zdający</w> musi przynieść dwa dokumenty tożsamości do centrum egzaminacyjnego."
                            }
                        },
                        {
                            "text": "The <w>candidate</w> waited nervously for the oral exam to begin.",
                            "target_lang_translations": {
                                "ru": "<w>Экзаменуемый</w> нервно ждал начала устного экзамена.",
                                "pl": "<w>Egzaminowany</w> czekał w napięciu na rozpoczęcie egzaminu ustnego."
                            }
                        }
                    ],
                    "synonyms": [
                        "examinee",
                        "test-taker"
                    ],
                    "common_phrases": [
                        "doctoral candidate",
                        "PhD candidate",
                        "exam candidate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник экзамена.",
                        "pl": "Osoba biorąca udział w egzaminie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экзаменуемый",
                                "target_lang_sense_clarification": "человек, сдающий экзамен"
                            },
                            {
                                "target_lang_word": "сдающий",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zdający",
                                "target_lang_sense_clarification": "osoba przystępująca do egzaminu"
                            },
                            {
                                "target_lang_word": "egzaminowany",
                                "target_lang_sense_clarification": "osoba poddawana egzaminowi"
                            },
                            {
                                "target_lang_word": "kandydat",
                                "target_lang_sense_clarification": "np. na studia lub stopień naukowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643e03ee-5c9f-3b6d-9de6-9c2e5700cab5",
                    "sense_definition": "A gene which may play a role in a given disease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists have identified a new <w>candidate</w> for the genetic disorder.",
                            "target_lang_translations": {
                                "ru": "Ученые выявили новый <w>ген-кандидат</w> для этого генетического заболевания.",
                                "pl": "Naukowcy zidentyfikowali nowy <w>gen kandydacki</w> dla tego zaburzenia genetycznego."
                            }
                        },
                        {
                            "text": "Testing the <w>candidate</w> proved it was linked to the disease.",
                            "target_lang_translations": {
                                "ru": "Тестирование <w>гена-кандидата</w> доказало его связь с болезнью.",
                                "pl": "Badanie <w>genu kandydackiego</w> udowodniło jego związek z chorobą."
                            }
                        }
                    ],
                    "common_phrases": [
                        "candidate gene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ген, который предположительно играет роль в развитии определенного заболевания.",
                        "pl": "Gen, który może odgrywać rolę w powstawaniu danej choroby."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ген-кандидат",
                                "target_lang_sense_clarification": "генетика"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gen kandydacki",
                                "target_lang_sense_clarification": "terminologia genetyczna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88b14ff8-617b-3390-a883-b5070ea29557",
                    "sense_definition": "To stand or apply as a candidate for a position, especially in a religious context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>candidating</w> for the role of minister at the local church.",
                            "target_lang_translations": {
                                "ru": "Он <w>выдвигает свою кандидатуру</w> на роль священника в местной церкви.",
                                "pl": "On <w>kandyduje</w> na rolę pastora w lokalnym kościele."
                            }
                        },
                        {
                            "text": "After <w>candidating</w> for several weeks, she was offered the position.",
                            "target_lang_translations": {
                                "ru": "После <w>прохождения испытаний</w> в течение нескольких недель ей предложили эту должность.",
                                "pl": "Po kilkutygodniowym <w>ubieganiu się</w> o stanowisko, zaoferowano jej tę posadę."
                            }
                        }
                    ],
                    "synonyms": [
                        "stand for",
                        "run for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдвигать свою кандидатуру на должность или проходить испытательный срок.",
                        "pl": "Ubiegać się o stanowisko lub kandydować, szczególnie w kontekście religijnym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдвигать кандидатуру",
                                "target_lang_sense_clarification": "предлагать себя на должность"
                            },
                            {
                                "target_lang_word": "баллотироваться",
                                "target_lang_sense_clarification": "участвовать в выборах"
                            },
                            {
                                "target_lang_word": "проходить испытание",
                                "target_lang_sense_clarification": "пробоваться на роль"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kandydować",
                                "target_lang_sense_clarification": "ubiegać się o urząd"
                            },
                            {
                                "target_lang_word": "wysuwać kandydaturę",
                                "target_lang_sense_clarification": "proponować siebie na stanowisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c16ddd-1261-3aae-82b7-9ad58ad1a8a4",
                    "sense_definition": "To make something white.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan used a special mixture to <w>candidate</w> the cloth.",
                            "target_lang_translations": {
                                "ru": "Ремесленник использовал специальную смесь, чтобы <w>отбелить</w> ткань.",
                                "pl": "Rzemieślnik użył specjalnej mieszanki, aby <w>wybielić</w> tkaninę."
                            }
                        },
                        {
                            "text": "In ancient times, they would <w>candidate</w> the walls with lime.",
                            "target_lang_translations": {
                                "ru": "В древние времена они <w>белили</w> стены известью.",
                                "pl": "W starożytności <w>bielono</w> ściany wapnem."
                            }
                        }
                    ],
                    "synonyms": [
                        "whiten",
                        "bleach"
                    ],
                    "antonyms": [
                        "blacken",
                        "darken"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "original meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо белым.",
                        "pl": "Wybielać coś lub czynić białym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбеливать",
                                "target_lang_sense_clarification": "делать белым"
                            },
                            {
                                "target_lang_word": "белить",
                                "target_lang_sense_clarification": "покрывать белым (например, известью)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wybielać",
                                "target_lang_sense_clarification": "czynić białym"
                            },
                            {
                                "target_lang_word": "bielić",
                                "target_lang_sense_clarification": "pokrywać białą substancją"
                            }
                        ]
                    }
                }
            ]
        }
    ]
