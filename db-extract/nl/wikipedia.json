                "senses": [
                    {
                        "sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                        "entry_id": "6289c73f-251e-3f70-96b9-335f00e7b993",
                        "glosses": [
                            "een door de Wikimedia Foundation gecreëerde rechtenvrije encyclopedie op het internet, die door iedereen te wijzigen en aan te vullen is"
                        ],
                        "tags": [
                            "wikitaal",
                            "Wikimedia"
                        ],
                        "examples": [
                            {
                                "example_id": "304930db-80de-46f6-914c-8877fd8eefc9",
                                "sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                                "text": "Ik heb het opgezocht op Wikipedia."
                            },
                            {
                                "example_id": "4341a3c1-c67d-40c9-8b04-7be723381c72",
                                "sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                                "text": "Turkije blokkeert toegang tot Wikipedia!"
                            },
                            {
                                "example_id": "322662a1-7875-4a40-8e15-be003c3139f3",
                                "sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                                "text": "Wikipedia mag rechtszaak tegen inlichtingendienst NSA voortzetten"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "660007f8-f6cd-4eee-b01b-9378ffc53c64",
                        "source_entry_id": "6289c73f-251e-3f70-96b9-335f00e7b993",
                        "source_sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                        "source_sense_description": "een door de Wikimedia Foundation gecreëerde rechtenvrije encyclopedie op het internet...",
                        "target_lang_word": "维基百科",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d2a167e-5d0f-4536-a006-35acd9afc74d",
                        "source_entry_id": "6289c73f-251e-3f70-96b9-335f00e7b993",
                        "source_sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
                        "source_sense_description": "een door de Wikimedia Foundation gecreëerde rechtenvrije encyclopedie op het internet...",
                        "target_lang_word": "Wikipédia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wikipédia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                        "entry_id": "8e9bc567-43df-3b57-84fe-6b61dd2fe895",
                                        "glosses": [
                                            "Encyclopédie multilingue sous licence de logiciel libre."
                                        ],
                                        "tags": [
                                            "Sans article",
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16377e53-9765-47ec-8111-bf5b1dd480e6",
                                                "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                                "text": "Avec le succès de l’encyclopédie collaborative en ligne Wikipédia, le wiki s’est popularisé. Si beaucoup de ceux qui fréquentent Wikipédia se contentent d’y puiser des informations, d’autres y participent en créant des entrées ou en modifiant des pages en les complétant ou les corrigeant."
                                            },
                                            {
                                                "example_id": "b5f55867-6714-4ce4-9699-a56095071c39",
                                                "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                                "text": "En fait, Wikipédia est bien moins proche d’une encyclopédie du genre Universalis que de ces almanachs dont se délectaient petits et grands il n’y a pas si longtemps, et qui consistaient en une collection de données de fait instructives et intéressantes telles que la hauteur du Mont-Blanc, des recettes de détachants miracles ou des remèdes de bonne femme, et d’anecdotes, listes ou records purement divertissants."
                                            },
                                            {
                                                "example_id": "014675f8-4c99-4971-b977-3fbdffd214fe",
                                                "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                                "text": "Pourquoi demander l’avis d’un vieux professeur quand l’on dispose de Wikipédia au bout des doigts?"
                                            },
                                            {
                                                "example_id": "535a369b-2305-4fca-9841-44739214b2e3",
                                                "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                                "text": "Je ne connais pas tous les chiffres par cœur, je ne suis pas Wikipédia."
                                            },
                                            {
                                                "example_id": "01129deb-6d8b-457c-8b64-b415a35c7afd",
                                                "sense_id": "39d960f1-512b-3fd9-89b2-ac2e6d540da6",
                                                "text": "Se prendre pour Wikipédia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a35937-6566-3198-99e0-90d7ac3b7380",
                                        "entry_id": "8e9bc567-43df-3b57-84fe-6b61dd2fe895",
                                        "glosses": [
                                            "Une des versions linguistiques de Wikipédia."
                                        ],
                                        "tags": [
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d381fb4-7425-4c54-91fa-8a20c6341e8e",
                                                "sense_id": "63a35937-6566-3198-99e0-90d7ac3b7380",
                                                "text": "Adapter des articles écrits dans une autre langue […] :\n* cela permet de créer plus facilement une masse critique pour peupler les Wikipédias délaissées et pauvres et inciter des contributeurs de cette langue à rejoindre le projet."
                                            },
                                            {
                                                "example_id": "b5892e1a-9977-4ff6-9f10-97a005d41a75",
                                                "sense_id": "63a35937-6566-3198-99e0-90d7ac3b7380",
                                                "text": "Ainsi les Wikipédias de langues suédoise et néerlandaise comportent plus du double d’articles que leur sœur en langue chinoise et plus du triple que l’édition en langue russe."
                                            },
                                            {
                                                "example_id": "7dc45e83-51a9-4a31-b549-f9d91042e502",
                                                "sense_id": "63a35937-6566-3198-99e0-90d7ac3b7380",
                                                "text": "En 2011, pour ses 10 ans, alors que le Wikipédia français a déjà annoncé son passage à plus d’un million d’articles, au niveau international Wikipédia revendique plus de 17 millions d’articles dans 272 langues et un milliard de contributions."
                                            },
                                            {
                                                "example_id": "609500dc-55b6-487c-83d0-044559f11949",
                                                "sense_id": "63a35937-6566-3198-99e0-90d7ac3b7380",
                                                "text": "Ce sont ainsi 62 826 et 50 650 couples (littéral anglais, littéral français) que nous avons extrait des Wiktionnaires anglais et français respectivement, et pas moins de 286 822 couples à partir de la Wikipedia anglaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62440c40-cfa3-3c24-aa86-9e057e0b34ee",
                                        "entry_id": "8e9bc567-43df-3b57-84fe-6b61dd2fe895",
                                        "glosses": [
                                            "Base de connaissances collaborative."
                                        ],
                                        "tags": [
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "159b677e-b918-4896-9104-e922f9a57f21",
                                                "sense_id": "62440c40-cfa3-3c24-aa86-9e057e0b34ee",
                                                "text": "Ce sont les consommateurs eux-mêmes — ils sont actuellement 7 000 contributeurs volontaires — qui enrichissent ce Wikipédia du bien-manger en décortiquant chaque jour de nouvelles étiquettes."
                                            },
                                            {
                                                "example_id": "dea5eaff-87f9-488d-be9c-0499a12037b7",
                                                "sense_id": "62440c40-cfa3-3c24-aa86-9e057e0b34ee",
                                                "text": "Une sorte de « Wikipédia des cellules », comme l’appellent Aviv Regev et Sarah Teichmann, les deux biologistes à l’origine du projet, qui pourrait révolutionner la médecine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "277f180e-ece2-477c-adb2-7247f4dba58d",
                        "source_entry_id": "6289c73f-251e-3f70-96b9-335f00e7b993",
                        "source_sense_id": "df99a89b-4990-35ca-becb-3f0cfaf92c95",
