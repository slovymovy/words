                "senses": [
                    {
                        "sense_id": "a1422f04-f439-3b1a-9861-5e1c4967031e",
                        "entry_id": "d7b76c7f-86c3-3cbd-a545-13765de40b5e",
                        "glosses": [
                            "kommunalpolitisch bedeutsamer Vorgang oder Gegenstand"
