        "fr-extract.jsonl": [
            {
                "entry_id": "8b2a5c64-5691-39cf-907d-ee64b30a0c78",
                "word": "stéthoscope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5817246d-0002-4bf6-ac02-fa6100dca853",
                        "entry_id": "8b2a5c64-5691-39cf-907d-ee64b30a0c78",
                        "tags": [
                            "plural"
                        ],
                        "form": "stéthoscopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                        "entry_id": "8b2a5c64-5691-39cf-907d-ee64b30a0c78",
                        "glosses": [
                            "Sorte de cornet acoustique pour l’auscultation médicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db6de52-b6d9-4c37-aba0-caf4b3cd2da6",
                                "sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                                "text": "On détermine assez facilement un bruit de souffle dans les artères crurales en les comprimant un peu avec le bord du stéthoscope."
                            },
                            {
                                "example_id": "6cd0edd3-da44-4821-ab95-b6665118db9b",
                                "sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                                "text": "Je vois son tablier, que dépasse le manche du stéthoscope, sa vareuse, le gros crayon bleu dont il dessinait sur les draps les courbes d`une fièvre ou la cadence d`un rythme cardiaque, l'appareil à l’aide duquel il enregistrait la mouvement du pouls, la tension artérielle."
                            },
                            {
                                "example_id": "e8b2c802-756a-45ff-805f-5597f91f668c",
                                "sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                                "text": "Cette fois, Pierre voulut écouter au stéthoscope battre le cœur de l’embryon. Il se penchait sur cette grande caverne habitée qu’était le corps d’Hedwige, appuyait son front contre elle, enfonçant aux oreilles les deux écouteurs, prêtant une attention auditive à ce ronron, à ce léger cliquetis qu’était le cœur de son enfant."
                            },
                            {
                                "example_id": "58f6ff7c-b810-49b6-9722-2fd2a4c1e7fb",
                                "sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                                "text": "Sur les murs, plusieurs dessins représentaient des petits malades en compagnie du docteur Lebillon, souvent équipé d’un stéthoscope qui ressemblait à un anaconda ou d’un otoscope en forme d’entonnoir géant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cae2e67d-51ae-4f93-b0b2-8b648e601e52",
                        "source_entry_id": "8b2a5c64-5691-39cf-907d-ee64b30a0c78",
                        "source_sense_id": "b3461992-e514-3652-8aaf-564c266ef3e8",
                        "source_sense_description": "Instrument utilisé pour l’auscultation médicale",
                        "target_lang_word": "Stethoskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stethoskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e19c85a-ff48-3652-a2ce-aec43398e14d",
                                        "entry_id": "9e3ce1d9-4fa8-3479-a132-8a7a6c692c1b",
                                        "glosses": [
                                            "Diagnosegerät zur Beurteilung von Geräuschen (vor allem in der Medizin)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d164efa-6d7e-4015-bf6f-a7e96e4e0368",
                                                "sense_id": "1e19c85a-ff48-3652-a2ce-aec43398e14d",
                                                "text": "Um ihre Herztöne hören zu können, legte der Arzt ihr das Stethoskop auf die Brust."
                                            },
                                            {
                                                "example_id": "2086e22c-d39d-4734-a138-653c2f0b4b28",
                                                "sense_id": "1e19c85a-ff48-3652-a2ce-aec43398e14d",
                                                "text": "Der Einbrecher lauschte mit dem Stethoskop an der Tür des Panzerschranks, um die richtige Zahlenkombination herauszubekommen."
                                            },
                                            {
                                                "example_id": "0f220ba3-eb52-4d05-9a77-b99e50f15d1d",
                                                "sense_id": "1e19c85a-ff48-3652-a2ce-aec43398e14d",
                                                "text": "„Ein Arzt kam herein, ein riesiges Stethoskop um den Hals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
