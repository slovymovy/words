                        "entry_id": "a11c77ab-7d6b-3026-8fe1-50fc40c4aa78",
                        "glosses": [
                            "Having an abstracting nature or tendency; tending to separate; tending to be withdrawn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c6693f-0324-4a0b-9183-323145e01653",
                                "sense_id": "868a9b5f-b309-350e-ae95-4d608e76c4dd",
                                "text": "The researcher proposed an abstractive model for text summarization."
                            },
                            {
                                "example_id": "0d63d96a-6611-4de0-81ef-1a866ad15c38",
                                "sense_id": "868a9b5f-b309-350e-ae95-4d608e76c4dd",
                                "text": "Unlike extractive methods, abstractive summarization generates new phrasing."
                            },
                            {
                                "example_id": "cf9d9eaa-5b4f-4fb2-80c7-1617057d8985",
                                "sense_id": "868a9b5f-b309-350e-ae95-4d608e76c4dd",
                                "text": "The essay was praised for its abstractive qualities, showing insight rather than repetition."
                            }
                        ]
                    },
