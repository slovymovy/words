                ],
                "translations": [
                    {
                        "translation_id": "c9d26a09-67f2-4176-8b70-8d091ebb9b27",
                        "source_entry_id": "e93f472a-3cfd-3b96-8b09-3a8c07adf5b1",
                        "source_sense_id": "ee1ec7f7-1eca-3a5c-b623-79d3f05e5b8b",
                        "target_lang_word": "nitrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf270c0b-c3dc-3572-8ba4-cd502576f83f",
                                        "entry_id": "83222b37-180f-3418-861d-69f5806f170a",
                                        "glosses": [
                                            "Pertaining to or composed of nitre; having the properties of nitre, bitter."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c266ea8a-1f35-4c28-b7f8-16b88a321ea3",
                                                "sense_id": "cf270c0b-c3dc-3572-8ba4-cd502576f83f",
                                                "text": "Whate'er the wintry Frost\n Nitrous prepar'd; the various-blossom'd Spring\n Put in white Promise forth; and Summer-Suns\n Concocted strong, rush boundless now to View […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb245acb-a948-3459-a57c-b4de985e3686",
                                        "entry_id": "83222b37-180f-3418-861d-69f5806f170a",
                                        "glosses": [
                                            "Of, relating to, or derived from nitrogen, especially in which the valence of the nitrogen is lower than that of a corresponding nitric species."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fce747-fa3a-4e1f-bca3-acb8ab9ee6dd",
                                                "sense_id": "eb245acb-a948-3459-a57c-b4de985e3686",
                                                "text": "In fact, nitric oxide (not to be confused with nitrous oxide, or laughing gas) is one of our primary signalling molecules."
                                            },
                                            {
                                                "example_id": "1429d72c-d2e8-4881-bced-a4df45ae9a7f",
                                                "sense_id": "eb245acb-a948-3459-a57c-b4de985e3686",
                                                "text": "On social media and beyond, many have taken to using the brand’s name in a more colloquial fashion, with “Galaxy Gas” being used as a catchall for nitrous oxide inhalants at large, regardless of whether they are actually Galaxy Gas products or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d69ea27-093e-3b0b-bf66-4e24e1fe5295",
                                        "entry_id": "83222b37-180f-3418-861d-69f5806f170a",
                                        "glosses": [
                                            "Of or relating to nitrous acid or its derivatives."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc7f6b30-968f-3c84-aa5b-ce37f1661cd3",
                                        "entry_id": "83222b37-180f-3418-861d-69f5806f170a",
                                        "glosses": [
                                            "Having a sharp odor like ammonia or nitric acid."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nitrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1955a643-824a-3d95-98d1-dba9dc29e9d2",
                                        "entry_id": "05479fc7-82d1-33f4-a3bd-6aca4c4d897d",
                                        "glosses": [
                                            "Nitrous oxide."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "901f58be-95fd-333c-a394-985df07976b1",
                                        "entry_id": "05479fc7-82d1-33f4-a3bd-6aca4c4d897d",
                                        "glosses": [
                                            "The system in some racing vehicles which pumps nitrous oxide into the engine to improve performance."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208d0702-6ab4-49c4-93e3-d3f16ce5e951",
                                                "sense_id": "901f58be-95fd-333c-a394-985df07976b1",
                                                "text": "When a shot this big is being run, it will also be necessary to pull 6-10 degrees of timing out when the nitrous is being run."
                                            },
                                            {
                                                "example_id": "000e9a87-3581-4b6d-82ab-2b1a4029783d",
                                                "sense_id": "901f58be-95fd-333c-a394-985df07976b1",
                                                "text": "To simulate nitrous, we will use a very simple approach: apply a large force to the back of the car when the nitrous is on."
                                            },
                                            {
                                                "example_id": "54e62fb3-f4d0-46c6-94ff-84c2332bb092",
                                                "sense_id": "901f58be-95fd-333c-a394-985df07976b1",
                                                "text": "When tested on a typical summer day, an engine with fuel fed by an annular discharge booster could be 10 hp less over a stepped dogleg booster, but 10 hp more when the nitrous is in operation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
