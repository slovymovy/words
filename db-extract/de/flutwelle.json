                                        "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden, and disastrous wave of water caused by a tremendous disturbance in the ocean; a tsunami. (See Usage notes below.)"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64682ce8-6949-4dae-b4c7-5399a8688cdd",
                                                "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                                "text": "The last tidal wave here killed twenty and left thousands homeless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden inundation of water from the storm surge, or waves of that surge; a sudden surge of river water."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c478e7fb-fe00-47e1-8121-fd0d8006ee39",
                                                "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A sudden and powerful surge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e45773-6533-44f6-a591-30084083f3ac",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "As the doors opened, a tidal wave of people flooded into the room."
                                            },
                                            {
                                                "example_id": "55ca3a81-52f6-41e1-a3fa-6eeef0a3edee",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "I was overcome by a tidal wave of emotions."
                                            },
                                            {
                                                "example_id": "53870bf8-e7ba-44ac-a5fd-b805eced5ceb",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "But this is no stream, folks. This will be a tidal wave that can swamp our democracy."
                                            }
                                        ]
                                    },
