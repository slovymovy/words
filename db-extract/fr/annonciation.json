        "fr-extract.jsonl": [
            {
                "entry_id": "53c25751-83c4-357d-a4fd-922aea72cd94",
                "word": "Annonciation",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                        "entry_id": "53c25751-83c4-357d-a4fd-922aea72cd94",
                        "glosses": [
                            "Fête de l’annonciation faite à Marie, le 25 mars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2589a223-23b4-4cf1-82a9-6ff882257bd8",
                                "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                                "text": "Lundi, c'était la grande fête de l’Annonciation, renvoyée du 25 mars, jour où, cette année, occurrait le Vendredi Saint, […]."
                            },
                            {
                                "example_id": "d9442c89-d911-4ca5-b895-7785321a6f47",
                                "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                                "text": "Parmi les douze grandes Fêtes de l’Église orthodoxe, quatre lui sont consacrées (sa Nativité, sa Présentation au Temple, l’Annonciation et sa Dormition), dont la première et la dernière des douze. Pareil symbolisme s'avère du plus haut intérêt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eac16a7b-33ab-49ac-a729-1115e1a03ac7",
                        "source_entry_id": "53c25751-83c4-357d-a4fd-922aea72cd94",
                        "source_sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                        "target_lang_word": "Verkündigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkündigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                        "entry_id": "378c3e93-1337-3754-860e-36fc302f3358",
                                        "glosses": [
                                            "öffentlich getätigte Aussage, die einer Tatsache entspricht oder auch eine religiöse Botschaft birgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a1f996-822b-4733-9926-8b245877773b",
                                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                                "text": "Der Mittwoch war der Tag der feierlichen Verkündigung des Gerichtsurteils."
                                            },
                                            {
                                                "example_id": "6e789946-5ad6-49e3-9f56-bbd21f1ffca4",
                                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                                "text": "Am 21. November 2014 jährte sich zum 50. Mal die feierliche Verkündigung des Ökumenismusdekretes „Unitatis redintegratio“ durch das Zweite Vatikanische Konzil."
                                            },
                                            {
                                                "example_id": "82d8ced2-6433-4010-b88a-71cb3eb587a3",
                                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                                "text": "Die Verkündigung an Maria war der Moment, in dem der Erzengel Gabriel den göttlichen Ratschluß der Erlösung mitteilte."
                                            },
                                            {
                                                "example_id": "81e395a1-a465-4031-9324-4d8ac8ec4c60",
                                                "sense_id": "bc05c945-9319-3ddd-a6c0-a2994b5bc4b9",
                                                "text": "„Jedes einzelne Wort des Predigers war eine Verkündigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ec91c04-f3c3-49e5-a887-34c7ff9fb7f7",
                        "source_entry_id": "53c25751-83c4-357d-a4fd-922aea72cd94",
