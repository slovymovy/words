                        "glosses": [
                            "een auto die aardgas als brandstof gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db9e69a-df2d-46c9-a3f6-fc9eec638ccf",
                                "sense_id": "01f3ad1e-b126-3028-9d94-1cc7a27495bc",
                                "text": "De nieuwe aardgasauto is 24 uur per dag en zeven dagen per week beschikbaar voor de storingsdienst van Almelo. Hij kan worden ingezet bij storingen aan bijvoorbeeld lichtmasten of vastgelopen rioolpompen."
                            },
                            {
                                "example_id": "e64dc839-0d3a-46e5-a583-ab1d0c435233",
                                "sense_id": "01f3ad1e-b126-3028-9d94-1cc7a27495bc",
                                "text": "De Vredense vrijwillige brandweer is zaterdagavond uitgerukt voor een voertuigbrand aan de Oldenkotter Strasse waarbij als bijzondere omstandigheid sprake was van een aardgas-auto. De gastank in de auto raakte bij de brand niet beschadigd."
                            }
                        ]
                    }
