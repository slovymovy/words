                        "glosses": [
                            "komórka służąca do bezpłciowego rozmnażania się roślin zarodnikowych i grzybów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725073e1-cede-4341-9cca-6f8a290e843d",
                                "sense_id": "f9b1899b-3bff-32d8-a8a2-f43e474e4ebe",
                                "text": "Sromotnik smrodliwy rozprzestrzenia swoje zarodniki za pośrednictwem much, przyciąganych przez jego cuchnącą i oślizgłą zieloną warstwę zarodnikową."
                            }
                        ],
