                    {
                        "sense_id": "59a6007c-1c65-3e32-8f55-57812ab3233e",
                        "entry_id": "493bcbdc-db47-365e-9849-5e9b03b9336d",
                        "glosses": [
                            "Maladie cardiovasculaire."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1c12194c-1a5b-4a57-8496-a55d89cffd39",
                                "sense_id": "59a6007c-1c65-3e32-8f55-57812ab3233e",
                                "text": "Von 873 Covid-19-Patienten mit Herz-Kreislauf-Erkrankungen starben 92 (10,5 Prozent).",
                                "translation": "Sur 873 patients Covid-19 atteints de maladies cardiovasculaires, 92 (10,5 %) sont décédés."
                            },
                            {
                                "example_id": "5d2f888a-d743-496f-83cc-5d1c0c152e95",
                                "sense_id": "59a6007c-1c65-3e32-8f55-57812ab3233e",
                                "text": "Der regelmäßige Verzehr (von Hülsenfrüchten) kann das Risiko für Herz-Kreislauf-Erkrankungen, Diabetes, bestimmte Krebserkrankungen sowie Adipositas reduzieren.",
                                "translation": "La consommation régulière (de légumineuses) peut réduire le risque de maladies cardiovasculaires, de diabète, de certains cancers ainsi que d'obésité."
                            },
                            {
                                "example_id": "79adb1a3-e7fd-4591-b992-60e522949f5c",
                                "sense_id": "59a6007c-1c65-3e32-8f55-57812ab3233e",
                                "text": "Kaffee soll auch das Risiko für chronische Erkrankungen wie Typ-2-Diabetes, Herz-Kreislauf-Erkrankungen und verschiedene Krebsarten reduzieren.",
                                "translation": "Le café est censé de réduire également le risque de maladies chroniques telles que le diabète de type 2, les maladies cardiovasculaires et divers types de cancer."
                            }
                        ]
                    }
