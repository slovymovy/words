                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f990e24-3df9-493a-9ae2-2530ddfccea5",
                                                "sense_id": "119f3910-7399-3ef6-8243-badfdeb1b0af",
                                                "text": "Es ist eigentlich paradox: In optischen Speichermedien wie CDs oder DVDs sind in einer höchst geordneter Struktur Bits eingeprägt, die zusammengenommen ein Musikstück oder einen Film ergeben."
                                            },
                                            {
                                                "example_id": "afdcd604-cb4b-491b-9fb0-4efbc7c80bcc",
                                                "sense_id": "119f3910-7399-3ef6-8243-badfdeb1b0af",
                                                "text": "Wie die Fahrgestellnummer des Original-Fahrzeuges wurde auch die Editionsnummer der Uhr von Hand in den Gehäuseboden eingeprägt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
