                ],
                "senses": [
                    {
                        "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                        "entry_id": "04a90573-dedc-3fe4-97b0-5254eca6709d",
                        "glosses": [
                            "ein in sich geschlossener Teil einer Laufstrecke/Laufaktivität oder eines sportlichen Mehrkampfs (zum Beispiel Triathlon, Biathlon), der laufend zurückgelegt wird"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "753ae864-feeb-470a-a7bb-a811354db8cb",
                                "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                                "text": "„Im Laufe der Zeit reduzieren sich die Gehpausen und die Laufabschnitte werden länger.“"
                            },
                            {
                                "example_id": "496e29e9-4784-4087-88cf-c7f9b9c5f8f9",
                                "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                                "text": "„Gut gestärkt geht es anschließend auf den längsten durchgehenden Laufabschnitt des Halbmarathons.“"
                            },
                            {
                                "example_id": "1470d952-c4c2-4b55-8142-3d6c92c1be58",
                                "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                                "text": "„So sind wir eng beieinander in den nächsten Schwimmabschnitt, der rüber nach Porthpean führte, um dort den längsten Laufabschnitt von ca. 5,2km zu laufen.“"
                            },
                            {
                                "example_id": "26e41d82-c22e-43e1-86d6-5c08f86e3641",
                                "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                                "text": "„Nach dem zweiten Laufabschnitt sind fünf Schuss stehend zu schießen.“"
                            },
                            {
                                "example_id": "9ecb29ad-446d-45a6-b2fc-e1e41d0a9f16",
                                "sense_id": "a4e2788c-31bf-372d-b0b6-91b1d28d8622",
                                "text": "„Der zweite Laufabschnitt war mit nur 400 Metern zwar kurz, aber keineswegs einfach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                        "entry_id": "04a90573-dedc-3fe4-97b0-5254eca6709d",
                        "glosses": [
                            "bestimmter Teilabschnitt eines Fließgewässers (Flusses oder Bachs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44652e06-82cd-48c7-a630-0ba1b64a3290",
                                "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                                "text": "„Die Längen von Flüssen selbst können variabel sein, besonders in den Laufabschnitten, in denen sie freie, sich verändernde Mäander bilden.“"
                            },
                            {
                                "example_id": "75121a85-6907-4229-959e-3273704d0d11",
                                "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                                "text": "„Die obersten Quellen und Laufabschnitte ganz im Osten gehören dessen Unterraum Leinbachgäu an, die danach um den Mittellauf dem Unterraum Neckarbischofsheimer Höhen, der Unterlauf und seine Umgebung dem Unterraum Schwarzbachgäu.“"
                            },
                            {
                                "example_id": "57e3494e-7465-41d9-8bfc-fd050d213124",
                                "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                                "text": "„In diesem Laufabschnitt mäandert die Geeste nur noch kurz vor der Mündung, in der ‚Taille‚ Bremerhavens zwischen Mitte, Lehe und Geestemünde.“"
                            },
                            {
                                "example_id": "b9eba12e-9191-438e-b692-7a2e58cb2c5a",
                                "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                                "text": "„Der erste Laufabschnitt des Schloßbachs beginnt auf der Hochebene östlich von Braunsbach, zwischen dem Dorf Orlach der Gemeinde im Norden und dessen Weiler Elzhausen im Süden, etwas westlich der die beiden Orte verbindenden K 2547 auf etwa 447 m.“"
                            },
                            {
                                "example_id": "98c9c153-a902-466f-8662-256d0790c6df",
                                "sense_id": "5518b8fc-7ba7-3e1d-ad7a-fdafe5a74ed7",
                                "text": "„Unterhalb von Hannover beginnt ein nach Nordwesten gerichteter Laufabschnitt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
