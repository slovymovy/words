                        "glosses": [
                            "In a way that is not mixed or adulterated; wholly, entirely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f22961e-00a8-4005-a025-12775ed19718",
                                "sense_id": "b04b2fea-cd2b-3640-89cd-bb56b70acbc9",
                                "text": "But there are, nevertheless, plenty of passages, both in Tristram Shandy and the Sentimental Journey, where the intention is wholly and unmixedly pathetic--where the smile is not for a moment meant to compete with the tear--which are, nevertheless, it must be owned, complete failures, and failures traceable with much certainty, or so it seems to me, to the artistic error above-mentioned."
                            },
                            {
                                "example_id": "6a8d7beb-e426-42f5-a2e1-07d4366a665d",
                                "sense_id": "b04b2fea-cd2b-3640-89cd-bb56b70acbc9",
                                "text": "Nor was ever any great writer's influence upon his fellows more utterly and unmixedly an influence for good."
                            }
                        ]
                    }
