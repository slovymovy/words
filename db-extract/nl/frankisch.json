                    }
                ],
                "translations": [
                    {
                        "translation_id": "4179ef29-d99c-4a3c-ba2e-885c7b9ddf4b",
                        "source_entry_id": "32527251-d871-3748-97e1-5943370ee305",
                        "target_lang_word": "fränkisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fränkisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7af03c-4477-3479-a648-5cb1a8507da5",
                                        "entry_id": "9a38222c-a7a5-3ef6-b1d7-da0b49880e64",
                                        "glosses": [
                                            "die Landschaft Franken oder ihre Bewohner betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5016d4-64f9-4d8d-9698-ac5ac8c1fbe6",
                                                "sense_id": "6f7af03c-4477-3479-a648-5cb1a8507da5",
                                                "text": "„Wenn sie dieses Foto fänden, wäre es für alle Welt ersichtlich, dass die Geschichte des Motorfluges, großzügig betrachtet, im fränkischen Leutershausen ihren Anfang nahm und nicht auf einer Sanddühne [sic !] in North Carolina.“"
                                            },
                                            {
                                                "example_id": "4ffc0031-88db-49c7-86bf-41cea84829eb",
                                                "sense_id": "6f7af03c-4477-3479-a648-5cb1a8507da5",
                                                "text": "Die fränkischen Bratwürste schmecken gut."
                                            },
                                            {
                                                "example_id": "1187c71b-1233-4ddb-a1fa-48467bee2930",
                                                "sense_id": "6f7af03c-4477-3479-a648-5cb1a8507da5",
                                                "text": "Er ist ein fränkischer Dichter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dab846e6-e458-33a4-97e2-d53adcd8191c",
                                        "entry_id": "9a38222c-a7a5-3ef6-b1d7-da0b49880e64",
                                        "glosses": [
                                            "den germanischen Volksstamm der Franken und dessen Angehörige betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5edf12-ad4d-466f-9a83-d070cff094bf",
                                                "sense_id": "dab846e6-e458-33a4-97e2-d53adcd8191c",
                                                "text": "„Das fränkische Stammesgebiet grenzte unmittelbar an die Siedlungsgebiete anderer westgermanischer Stämme und Völkerschaften.“"
                                            },
                                            {
                                                "example_id": "5d185cb9-27f6-48b1-af4b-6b77f3820ea0",
                                                "sense_id": "dab846e6-e458-33a4-97e2-d53adcd8191c",
                                                "text": "„Die Insellage verschonte die Bewohner Britanniens von Einfällen von außen, obwohl es bereits in dieser Zeit vereinzelte Angriffe fränkischer und sächsischer Verbände gab.“"
                                            },
                                            {
                                                "example_id": "d2bf6bc7-c7be-4d67-8786-ccb810f320d6",
                                                "sense_id": "dab846e6-e458-33a4-97e2-d53adcd8191c",
                                                "text": "„Unter den fränkischen und sächsischen Herrschern wuchs in der Folgezeit die Zahl der Münzstätten ebenso wie die Münzproduktion stark an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9b82995-a1df-3c5f-b485-61b4f8c37367",
                                        "entry_id": "9a38222c-a7a5-3ef6-b1d7-da0b49880e64",
                                        "glosses": [
                                            "die fränkischen Sprachen und Dialekte betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb056990-7f14-4007-8490-87aae34e9fae",
                                                "sense_id": "f9b82995-a1df-3c5f-b485-61b4f8c37367",
                                                "text": "Das ist ein fränkisches Wort."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
