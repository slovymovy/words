                    {
                        "sense_id": "6c62d5ee-9a76-30e3-aecf-4147ef4f25c1",
                        "entry_id": "c8fa0480-1b22-3281-a37c-f29b4bcda2ee",
                        "glosses": [
                            "Ensemble des barons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e4b1fe-9704-4d27-8264-df892752ca00",
                                "sense_id": "6c62d5ee-9a76-30e3-aecf-4147ef4f25c1",
                                "text": "Presque toute la chevalerie avait les mêmes sentiments ; le haut baronnage seul ne partageait pas franchement la joie commune, car c’était sa cause, celle de l’indépendance féodale, qui avait succombé à Bovines; c’était la royauté qui devait recueillir tous les fruits de la victoire nationale."
                            }
                        ]
                    },
                    {
                        "sense_id": "218b5b04-a6a9-387e-920b-887880e3ebf5",
                        "entry_id": "c8fa0480-1b22-3281-a37c-f29b4bcda2ee",
                        "glosses": [
                            "Dignité de baron."
                        ],
                        "tags": [
                            "dated",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "c7365369-b9ec-42dd-a91c-d5a8d060104d",
                                "sense_id": "218b5b04-a6a9-387e-920b-887880e3ebf5",
                                "text": "Ce bourgeois, en inaugurant son baronnage, offrit une Vierge ouvrante à l’église de sa baronnie, Alluye."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee82cdba-67ee-3af6-aa75-89462390324e",
                        "entry_id": "c8fa0480-1b22-3281-a37c-f29b4bcda2ee",
                        "glosses": [
                            "Entente illicite entre un employé d’un casino et un complice extérieur, destinée à flouer cet établissement de jeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf719a8-4b3a-4cc5-8272-a05a35a5855f",
                                "sense_id": "ee82cdba-67ee-3af6-aa75-89462390324e",
                                "text": "L’affaire de baronnage organisé au casino Palm-Beach de Cannes dans laquelle est inculpé Rolland Courbis, manager [sic] du SCT de Toulon, porterait sur 50 millions de francs en 1988 et pourrait déboucher sur des inculpations dans le milieu du grand banditisme."
                            }
                        ]
                    }
