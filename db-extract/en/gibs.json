                    {
                        "sense_id": "078eec8a-c1aa-3089-bd3a-031b1e460c61",
                        "entry_id": "c3fda0a9-22d5-3b69-9de1-77836d88213d",
                        "glosses": [
                            "Received money (e.g. charity, government benefits, or private gifts), regarded as undeserved."
                        ],
                        "tags": [
                            "offensive",
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c6132215-ec66-4bde-9539-a6e3c3fdc8cb",
                                "sense_id": "078eec8a-c1aa-3089-bd3a-031b1e460c61",
                                "text": "Wranglers said the gangs of teenaper nigger sows would sneak up behind\na lone shopper, grab at her purse and/or bags, and push the women down\nand punch and kick her before running off with the stolen gibs."
                            },
                            {
                                "example_id": "58079206-c359-4163-8cb3-8b33c9ea61a7",
                                "sense_id": "078eec8a-c1aa-3089-bd3a-031b1e460c61",
                                "text": "SAVAGE UNGRATEFUL NIGGERS beat a human after he offered to help pay for\ntheir food. The coons are always after gibs and when a human tries to\nbe nice to them, this is what happens."
                            },
                            {
                                "example_id": "50a4bcaa-5e18-4e8d-86a5-a3ade4f7b55e",
                                "sense_id": "078eec8a-c1aa-3089-bd3a-031b1e460c61",
                                "text": "Now what were they thinking? Everyone knows you can't get two niggers\ntogether with gibs on the line without it ending in a fight."
                            },
                            {
                                "example_id": "ac20e96a-aef5-4b6a-a7d5-6035c9a6d8cb",
                                "sense_id": "078eec8a-c1aa-3089-bd3a-031b1e460c61",
                                "text": "I expect it was stealing from the till, taking home free food and\ngiving 100% discounts to nigger mates in exchange for gibs."
                            }
                        ]
                    }
                ],
