                "senses": [
                    {
                        "sense_id": "2a54db57-a0ba-3cff-9d92-f7195a6c5fb4",
                        "entry_id": "371a4c33-d291-3c8e-b91c-8467a9975df8",
                        "glosses": [
                            "Erwerbstätigkeit (Beruf) im Umfeld der Heilung und Betreuung/Versorgung von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a0baf4a-bb14-4c94-9a5c-37c5e6026dd9",
                                "sense_id": "2a54db57-a0ba-3cff-9d92-f7195a6c5fb4",
                                "text": "„Die Ausbildung von Pflegefachkräften wird vereinheitlicht und moderner. Die Bundesregierung möchte, dass sie besser auf die heutige Berufspraxis vorbereitet. Der Weg ist nun frei: Auch der Bundesrat hat der neuen Ausbildungs- und Prüfungsverordnung für die Pflegeberufe zugestimmt.“"
                            },
                            {
                                "example_id": "175ee96c-d2fb-40cd-96a8-6283d99a15fb",
                                "sense_id": "2a54db57-a0ba-3cff-9d92-f7195a6c5fb4",
                                "text": "Die Motivation, einen Pflegeberuf zu erlernen, ist sehr unterschiedlich. Doch am Anfang steht meist die Freude, für Menschen und mit Menschen zu arbeiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
