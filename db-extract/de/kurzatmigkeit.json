                "senses": [
                    {
                        "sense_id": "2e8e7a7c-4e52-3dcc-ac68-bec1a368cb38",
                        "entry_id": "f90aef87-71b6-322d-86b1-457445f6ee99",
                        "glosses": [
                            "Umstand, dass man (bei Belastung) häufiger, in kürzeren Abständen, atmen muss und dabei das Gefühl hat, nicht leicht genug genügend Luft zu bekommen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3224c2a6-259b-4c9f-a08f-76f479b121b1",
                                "sense_id": "2e8e7a7c-4e52-3dcc-ac68-bec1a368cb38",
                                "text": "Mit fortschreitender Schwangerschaft hat die Lunge weniger Platz, sich beim Einatmen zu entfalten, und das führt zu Kurzatmigkeit oder sogar Atemnot."
                            }
                        ],
                        "sense_index_json": "\"1\""
