                        "entry_id": "7d6ffbd8-f576-302f-9991-7b867107bf0a",
                        "glosses": [
                            "staatliches oder privates Schutzgebiet, in dem Wildarten geschützt werden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dcfa66a-8f00-4cb0-b9d5-51b09a70440e",
                                "sense_id": "7948864d-6fbe-3dcb-b8df-136d81761cc1",
                                "text": "„Es gab geheime Treffen und Versammlungen, manchmal an seltsamen Orten: obskuren privaten Wildreservaten, einem kleinen Urlaubsort in den Sederbergen, einem abgelegenen, drittklassigen Hotel an der Westküste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
