                "senses": [
                    {
                        "sense_id": "5026b688-4488-35ae-b12f-f81f2f979837",
                        "entry_id": "a9d67cd3-12b5-36f7-be59-d9539b577575",
                        "glosses": [
                            "To detect the scent of (something) before it is present."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96122065-3341-41f8-a3e3-d8672f256111",
                                "sense_id": "5026b688-4488-35ae-b12f-f81f2f979837",
                                "text": "birds and wild animals forescent a storm, or an earthquake"
                            },
                            {
                                "example_id": "dda02da8-ba8e-4af2-a5b8-9c634cfa62f1",
                                "sense_id": "5026b688-4488-35ae-b12f-f81f2f979837",
                                "text": "[…] the white goose,\nThe saviour of the Roman citadel,\nForescents afar the odour of mankind."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea6b7610-2acf-36f4-9554-aa7a7aaf476c",
                        "entry_id": "a9d67cd3-12b5-36f7-be59-d9539b577575",
                        "glosses": [
                            "To detect or become aware of (something) in advance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dc641ef1-4613-4fe4-a9d7-05d253ca4719",
                                "sense_id": "ea6b7610-2acf-36f4-9554-aa7a7aaf476c",
                                "text": "1872, Henry Norman Hudson, Shakespeare: His Life, Art, and Characters, Boston: Ginn & Company, Othello, the Moor of Venice, p. 462,\nthe sagacity with which Iago feels and forescents his way into Roderigo"
                            },
                            {
                                "example_id": "9576386d-d946-47a0-8972-0117b19851f1",
                                "sense_id": "ea6b7610-2acf-36f4-9554-aa7a7aaf476c",
                                "text": "1915, Frederick Goodyear, letter to F.W. Leith Ross in Letters and Remains: 1887-1917, London: McBride, Nast, 1920, p. 94,\nPossibly we instinctively forescented the war."
                            }
                        ]
                    }
