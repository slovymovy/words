                        "examples": [
                            {
                                "example_id": "7a724c60-2efc-44ad-ab76-f186324b88cc",
                                "sense_id": "9a7702ff-09ac-328e-9343-50322f8b0683",
                                "text": "De twee lidstaten hebben de zendingen tegengehouden en de VN op de hoogte gesteld. Een derde lidstaat heeft aanwijzingen dat er een handelscontract over wapens is tussen de Noord-Koreaanse en de Syrische autoriteiten."
                            },
                            {
                                "example_id": "a0a87a9b-477b-428a-ba6c-8b16e3991a00",
                                "sense_id": "9a7702ff-09ac-328e-9343-50322f8b0683",
                                "text": "De kans is aanwezig dat de kwestie negatieve gevolgen zal hebben voor Ecuador. Het land heeft een handelscontract met de Verenigde Staten, waarbij goederen kunnen worden geëxporteerd zonder dat er in de VS belasting betaald hoeft te worden. Mogelijk dat de VS het handelscontract nu herziet."
                            }
                        ]
                    }
