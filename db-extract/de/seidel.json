                ],
                "senses": [
                    {
                        "sense_id": "7032a90e-432b-3ecb-80ce-77fb2c351865",
                        "entry_id": "59f62e92-d27d-3d75-b0ac-c98b88d865d5",
                        "glosses": [
                            "spezielle Form eines Trinkgefäßes: Bierglas oder Bierkrug in zylindrischer Form mit Henkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b8f31a-422d-46de-9d4d-36ca641cfbdd",
                                "sense_id": "7032a90e-432b-3ecb-80ce-77fb2c351865",
                                "text": "Große Biere werden meist im Seidel, kleine Biere in einer Tulpe ausgeschenkt."
                            },
                            {
                                "example_id": "eca8b6ad-716f-4bd6-8f2d-47bc9a4cb347",
                                "sense_id": "7032a90e-432b-3ecb-80ce-77fb2c351865",
                                "text": "Kölsch wird nie aus einem Seidel getrunken."
                            },
                            {
                                "example_id": "a017a869-0b2f-4fbc-87c5-489c546f8503",
                                "sense_id": "7032a90e-432b-3ecb-80ce-77fb2c351865",
                                "text": "„Kulmbacher Bier, wofür das Rathaus ein Renommee hatte, wurde bestellt, und Cécile war entzückt, als der Wirt die schäumenden und frisch beschlagenen Seidel brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f12ccb55-f422-32d9-8f4b-66cb67b48495",
                        "entry_id": "59f62e92-d27d-3d75-b0ac-c98b88d865d5",
                        "glosses": [
                            "Raummaß, bayerische und österreichische Maßeinheit für Flüssigkeiten, vor allem Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b3d8f5-7987-4f53-91a2-45eec2ed76d2",
                                "sense_id": "f12ccb55-f422-32d9-8f4b-66cb67b48495",
                                "text": "Früher waren noch nicht so viele verschiedene Glasgrößen üblich, daher benutzte man Seidel auch als Mengenangabe."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a0d549d1-5374-397d-bdb0-8b8918cd2d74",
                        "entry_id": "59f62e92-d27d-3d75-b0ac-c98b88d865d5",
                        "glosses": [
                            "historisch: in Bayern: 0,535 l; in Österreich: 0,354 l"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f6f2b7c7-b34e-3eb1-8697-822bdebc87b3",
                        "entry_id": "59f62e92-d27d-3d75-b0ac-c98b88d865d5",
                        "glosses": [
                            "in heutiger Zeit: in Österreich: 0,33 l"
                        ],
                        "tags": [],
                        "examples": []
                    }
