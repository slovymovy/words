{
    "word_family": [
        "confuse",
        "confused",
        "confusing",
        "confusedly",
        "confusable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08c81f51-1586-3637-8d16-22cd7bbcd9a0",
                    "sense_definition": "A state of being bewildered or a failure to understand something correctly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was some <w>confusion</w> about the start time of the meeting.",
                            "target_lang_translations": {
                                "ru": "Возникла некоторая <w>путаница</w> по поводу времени начала собрания."
                            }
                        },
                        {
                            "text": "The new rules caused a lot of <w>confusion</w> among the students.",
                            "target_lang_translations": {
                                "ru": "Новые правила вызвали много <w>недоразумений</w> среди студентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewilderment",
                        "misunderstanding",
                        "muddle",
                        "bafflement"
                    ],
                    "antonyms": [
                        "clarity"
                    ],
                    "common_phrases": [
                        "cause confusion",
                        "total confusion",
                        "look of confusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние растерянности или неспособность правильно понять что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоразумение",
                                "target_lang_sense_clarification": "ошибочное понимание ситуации"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "отсутствие ясности в мыслях или фактах"
                            },
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "состояние растерянности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94912499-d8eb-37d4-92db-28b8ed9aa089",
                    "sense_definition": "A situation that is disorganized, messy, or lacks a clear order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden power outage threw the entire airport into <w>confusion</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапное отключение электричества повергло весь аэропорт в <w>неразбериху</w>."
                            }
                        },
                        {
                            "text": "In the <w>confusion</w> of the crowd, I lost my car keys.",
                            "target_lang_translations": {
                                "ru": "В <w>суматохе</w> толпы я потерял ключи от машины."
                            }
                        }
                    ],
                    "synonyms": [
                        "disarray",
                        "mix-up",
                        "muddle"
                    ],
                    "antonyms": [
                        "clarity"
                    ],
                    "common_phrases": [
                        "scene of confusion",
                        "state of confusion",
                        "amidst the confusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, характеризующаяся беспорядком, хаосом или отсутствием четкой организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "беспорядочная ситуация"
                            },
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "отсутствие организованности"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "общая паника или переполох"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fec1f16-64f1-394e-b0e8-c11c299e7633",
                    "sense_definition": "The act of mistaking one person or thing for another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>confusion</w> of the two similar names led to a serious error.",
                            "target_lang_translations": {
                                "ru": "<w>Путаница</w> между двумя похожими именами привела к серьезной ошибке."
                            }
                        },
                        {
                            "text": "To avoid <w>confusion</w> between the twins, they wore different colored shirts.",
                            "target_lang_translations": {
                                "ru": "Чтобы избежать <w>смешения</w> близнецов, они носили рубашки разного цвета."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix-up"
                    ],
                    "antonyms": [
                        "distinction"
                    ],
                    "common_phrases": [
                        "avoid confusion",
                        "identity confusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибка, при которой одного человека или предмет принимают за другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "ошибка в идентификации"
                            },
                            {
                                "target_lang_word": "смешение",
                                "target_lang_sense_clarification": "ошибка из-за сходства понятий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6e0121-b58a-3072-8ad8-d9df3fae314a",
                    "sense_definition": "A feeling of shame, embarrassment, or being flustered.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked away in <w>confusion</w> when she realized her mistake.",
                            "target_lang_translations": {
                                "ru": "Она отвела взгляд в <w>смущении</w>, когда осознала свою ошибку."
                            }
                        },
                        {
                            "text": "His face was covered in blushes and <w>confusion</w> after the compliment.",
                            "target_lang_translations": {
                                "ru": "Его лицо залилось румянцем и выражало <w>замешательство</w> после комплимента."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemusement",
                        "discombobulation"
                    ],
                    "common_phrases": [
                        "blushes and confusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство стыда, смущения или сильного волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущение",
                                "target_lang_sense_clarification": "чувство неловкости"
                            },
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "эмоциональная растерянность"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "сильное душевное волнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6054115f-a3e7-3da4-8908-85c327edd99a",
                    "sense_definition": "A clinical symptom of impaired orientation or lack of understanding, often due to medical conditions like dementia.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient showed signs of mental <w>confusion</w> and memory loss.",
                            "target_lang_translations": {
                                "ru": "У пациента наблюдались признаки <w>спутанности</w> сознания и потеря памяти."
                            }
                        },
                        {
                            "text": "Acute <w>confusion</w> can be a side effect of certain medications.",
                            "target_lang_translations": {
                                "ru": "Острая <w>спутанность</w> сознания может быть побочным эффектом некоторых лекарств."
                            }
                        }
                    ],
                    "synonyms": [
                        "discombobulation"
                    ],
                    "common_phrases": [
                        "mental confusion",
                        "acute confusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Клинический симптом нарушения ориентации или понимания, часто вызванный медицинскими причинами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спутанность сознания",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "нарушение ориентации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f68a422-182b-346e-b143-3df1b4bead8f",
                    "sense_definition": "The collective noun for a group of wildebeest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a <w>confusion</w> of wildebeest crossing the river.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>стадо</w> антилоп гну пересекает реку."
                            }
                        },
                        {
                            "text": "A <w>confusion</w> of wildebeest is one of the more unusual collective nouns.",
                            "target_lang_translations": {
                                "ru": "«<w>Confusion</w>» в отношении антилоп гну — одно из самых необычных собирательных существительных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "confusion of wildebeest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для группы антилоп гну."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "общее название группы животных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}