                                        "entry_id": "90e8a54f-b983-399d-ab89-667597ccd5db",
                                        "glosses": [
                                            "In India or Tibet, a person thought to have great knowledge and love of humanity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22a5281-4f77-41e2-834d-0cb54f135c7b",
                                                "sense_id": "b129367b-37d4-3a6c-8943-e63802fe393e",
                                                "text": "Certain cults and individuals from the West look towards Tibet as the abode of mysterious Mahatmas and \"Masters\", and the home of the Great White Brotherhood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
