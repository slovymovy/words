                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bb1373f6-efde-4aa0-b1a6-4089cbd0a76a",
                                "sense_id": "4debfe51-f1b6-357b-bc9a-2da5eadf943d",
                                "text": "The US government seeks to incentivize home ownership through a favorable tax system."
                            },
                            {
                                "example_id": "adf4f2fa-f651-4dc6-aff6-02e64f8e7853",
                                "sense_id": "4debfe51-f1b6-357b-bc9a-2da5eadf943d",
                                "text": "City staff are recommending ways Toronto can incentivize the construction of 20,000 purpose-built rental homes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ac3801c-11a6-3d06-88ae-54d53df6ede9",
                        "entry_id": "d401452d-f0a5-3aa9-ba00-4c6e2e75d746",
                        "glosses": [
                            "To provide incentives to."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3880db25-2e8e-4fc1-bc4f-4a276cbd67c9",
                                "sense_id": "5ac3801c-11a6-3d06-88ae-54d53df6ede9",
                                "text": "They effectively incentivized people to overinvest in home ownership."
                            }
                        ]
                    }
                ],
                "translations": [
