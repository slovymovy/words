                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ed3653-dc12-4264-b8e1-1fee259dfb4d",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "Verwarring van namen.",
                                "translation": "Confusion de noms."
                            },
                            {
                                "example_id": "51a8614d-aade-4af1-8ee4-b08df3424b7e",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "In verwarring raken.",
                                "translation": "Se troubler."
                            },
                            {
                                "example_id": "bd441eb1-de69-4ae7-8d56-51e784eec532",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "Iem. in verwarring brengen.",
                                "translation": "Induire quelqu’un en erreur."
                            },
                            {
                                "example_id": "feb1e810-ef55-4980-893e-80c32d54da15",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "Verwarring stichten.",
                                "translation": "Jeter le trouble."
                            },
                            {
                                "example_id": "25081edd-2d36-4898-b98e-5f435131b3a3",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "Dit kan aanleiding geven tot verwarring.",
                                "translation": "Cela peut prêter à confusion."
                            },
                            {
                                "example_id": "a752415c-1822-44eb-b869-84041060f568",
                                "sense_id": "edf7387d-d5a1-3ef6-97ae-47798dd57953",
                                "text": "Verwarring zaaien.",
                                "translation": "Mettre l’embrouille."
                            }
                        ]
                    }
