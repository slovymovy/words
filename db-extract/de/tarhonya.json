                                "sense_id": "995acbf9-d381-312f-9f07-725bb44b0512",
                                "text": "„Dazu gibt es cremige Tarhonya mit Speckkrusteln und Bauerntopfen - und die ist, und zwar echt jetzt, zum Deppertwerden gut.“"
                            },
                            {
                                "example_id": "22f765ff-4635-494a-9144-26046aea1920",
                                "sense_id": "995acbf9-d381-312f-9f07-725bb44b0512",
                                "text": "„Die Hendlstücke wieder in die Sauce legen und mit Nockerln oder Tarhonya servieren.“"
                            }
                        ],
