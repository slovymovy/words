                "senses": [
                    {
                        "sense_id": "90ef7f7e-1209-34c5-a95a-f3fc5407c5fc",
                        "entry_id": "34a61ffc-c872-3cf5-9d68-80f52b71dcb0",
                        "glosses": [
                            "Kälte im Januar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76df325-adf5-4c84-9dd1-cbcb937cb827",
                                "sense_id": "90ef7f7e-1209-34c5-a95a-f3fc5407c5fc",
                                "text": "„Jetzt, wo wir mobil waren, mussten wir uns keine Sorgen mehr machen, in der eisigen Januarkälte überall hinlaufen zu müssen.“"
                            },
                            {
                                "example_id": "3131c175-716b-4a27-a545-cce6d577ee4f",
                                "sense_id": "90ef7f7e-1209-34c5-a95a-f3fc5407c5fc",
                                "text": "„Ich drehe mich ratlos im Kreis und überlege, was ich machen soll, da bemerke ich auf dem Trampelpfad vom Schuppen zur Straße einen hageren Weißen zwischen zwanzig und dreißig, dringend rasurbedürftig und gegen die Januarkälte mit einer kalten Khakihose und einem dicken Pullover bekleidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
