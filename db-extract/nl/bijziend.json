                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27104ad1-3129-4bf2-90c0-e6371f708bab",
                                "sense_id": "48f189ee-2bc2-3681-aeb3-d29c0f9e5a34",
                                "text": "Mijn bijziende oma moest de krant altijd op 10 centimeter houden om de tekst te kunnen lezen."
                            },
                            {
                                "example_id": "d45605ab-8a3c-412a-a9f3-96ddd93d4f6c",
                                "sense_id": "48f189ee-2bc2-3681-aeb3-d29c0f9e5a34",
                                "text": "Er zijn best evolutionaire redenen te verzinnen waarom bijziende mensen zoveel intelligenter zijn dan verziende mensen."
                            }
                        ]
                    }
                ],
