                                                "example_id": "fe1037cc-d613-43f6-b918-af65c01af48e",
                                                "sense_id": "1e090dbe-6b21-36b8-84d7-cd0f7633e037",
                                                "text": "There are some who advise taking the noxious herb savory; in my judgment it is poison."
                                            }
