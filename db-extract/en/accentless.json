                    {
                        "translation_id": "039a709d-afc8-48e0-ba86-9d3ec3e0f300",
                        "source_entry_id": "f272f90c-239c-30cf-b132-f8c283f578c9",
                        "source_sense_description": "speaking without an accent",
                        "target_lang_word": "akzentfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akzentfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                        "entry_id": "cb966d1f-8c79-33f3-98b5-c1a1d8d71852",
                                        "glosses": [
                                            "ohne erkennbare (fremdsprachige, mundartliche oder soziolektale) Färbung der Sprache (in Aussprache, Melodie oder Tonfall)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70f842c-38c1-466a-964e-668ba9dee356",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„[…]; sie sprachen es fließend und akzentfrei: Französisch und Englisch, Flämisch und Dänisch, und sprachen fließend und akzentfrei auch ihre Muttersprache: Deutsch; […]“"
                                            },
                                            {
                                                "example_id": "6353a1f4-2d10-4cd6-b4fe-5793a75d4d5f",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Bitte sehr, sagte er in akzentfreiem Deutsch.“"
                                            },
                                            {
                                                "example_id": "8edb48fa-a64a-4a6e-9980-67f580497088",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Einen bayerischen Zungenschlag hört man auch beim neuen Programmchef von Radio Energy, Hans Knobloch, heraus, und selbst Otto Altendörfer, bis vor kurzem noch 'in leitender Funktion' beim Berliner Heimatsender Hundert,6, spricht kein akzentfreies Hochdeutsch.“"
                                            },
                                            {
                                                "example_id": "e31094ef-3a5b-4e01-af4d-ac737830cf11",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Sie sprach akzentfrei, Ostberliner Melodie.“"
                                            },
                                            {
                                                "example_id": "ff756239-c84a-449f-bc46-85457a8b1f64",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Mit meinen hellen Haaren, der hellen Hautfarbe und meinem fast akzentfreien Deutsch war ich für niemanden als Italiener zu erkennen.“"
                                            },
                                            {
                                                "example_id": "2b379b15-dde5-4998-b4a9-9ad2c3470074",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Wir sprechen perfektes Deutsch, sie werden es nie akzentfrei beherrschen.“"
                                            },
                                            {
                                                "example_id": "fce83263-b179-408f-b624-4555d6ca1a77",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Sie sprach, wie er, akzentfrei Deutsch.“"
                                            },
                                            {
                                                "example_id": "016a010f-fad5-48be-9508-c126404ea8f1",
                                                "sense_id": "196c2158-e5d5-336b-b25b-87b9d5cff051",
                                                "text": "„Doch Vorsicht, das ist keine Verlegenheitswahl, er hätte egal was machen können, er hatte auch Spaß an Elektronik, am Programmieren, er war sprachbegabt, Englisch zum Beispiel, gerade einmal drei Monate bei Lang’s in London, und er sprach fast akzentfrei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
