{
    "word_family": [
        "amend",
        "amendable",
        "amender"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cb55495-e05d-320a-a409-40c5862f3f5d",
                    "sense_definition": "A formal addition or change to a constitution or a legal document.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The First <w>Amendment</w> protects the right to free speech for all citizens.",
                            "target_lang_translations": {
                                "ru": "Первая <w>поправка</w> защищает право на свободу слова для всех граждан.",
                                "tr": "Birinci <w>Anayasa Değişikliği</w> tüm vatandaşların ifade özgürlüğü hakkını korur."
                            }
                        },
                        {
                            "text": "The government proposed a constitutional <w>amendment</w> to change the voting age.",
                            "target_lang_translations": {
                                "ru": "Правительство предложило конституционную <w>поправку</w>, чтобы изменить возрастной ценз для голосования.",
                                "tr": "Hükümet, oy kullanma yaşını değiştirmek için bir anayasa <w>değişikliği</w> önerdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "constitutional amendment",
                        "propose an amendment",
                        "ratify an amendment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное дополнение или изменение в конституции или юридическом документе.",
                        "tr": "Bir anayasa veya yasal belgede yapılan resmi ekleme veya değişiklik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "к закону или конституции"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "в официальном документе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değişiklik",
                                "target_lang_sense_clarification": "yasa veya anayasada yapılan"
                            },
                            {
                                "target_lang_word": "yasa değişikliği",
                                "target_lang_sense_clarification": "resmi kanun maddesinde yapılan"
                            },
                            {
                                "target_lang_word": "ek madde",
                                "target_lang_sense_clarification": "yasal belgeye eklenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b81464c-1e83-398a-aa3f-ab1a5200cccd",
                    "sense_definition": "A change or addition to a legislative bill or motion during the lawmaking process.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee suggested a minor <w>amendment</w> to the proposed environmental bill.",
                            "target_lang_translations": {
                                "ru": "Комитет предложил незначительную <w>поправку</w> к предложенному законопроекту об охране окружающей среды.",
                                "tr": "Komite, önerilen çevre tasarısında küçük bir <w>değişiklik</w> yapılmasını önerdi."
                            }
                        },
                        {
                            "text": "The senator introduced a last-minute <w>amendment</w> to the budget proposal.",
                            "target_lang_translations": {
                                "ru": "Сенатор в последний момент внес <w>поправку</w> в проект бюджета.",
                                "tr": "Senatör, bütçe tasarısına son dakikada bir <w>değişiklik önergesi</w> sundu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass an amendment",
                        "table an amendment",
                        "legislative amendment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение или дополнение к законопроекту или предложению в процессе законотворчества.",
                        "tr": "Yasama sürecinde bir kanun tasarısı veya önergeye yapılan değişiklik veya ekleme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "к законопроекту"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "в текст документа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değişiklik önergesi",
                                "target_lang_sense_clarification": "kanun tasarısı için sunulan"
                            },
                            {
                                "target_lang_word": "tashih",
                                "target_lang_sense_clarification": "tasarı üzerinde yapılan düzeltme"
                            },
                            {
                                "target_lang_word": "düzeltme",
                                "target_lang_sense_clarification": "taslak metindeki değişiklik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03b109ea-88c6-34b2-98bd-0b2658ba69eb",
                    "sense_definition": "A change made to improve something or to correct a fault.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor suggested an <w>amendment</w> to the final chapter to improve the flow.",
                            "target_lang_translations": {
                                "ru": "Редактор предложил <w>исправление</w> в последнюю главу, чтобы улучшить повествование.",
                                "tr": "Editör, akışı iyileştirmek için son bölümde bir <w>düzeltme</w> yapılmasını önerdi."
                            }
                        },
                        {
                            "text": "He made an <w>amendment</w> to his lifestyle after the doctor warned him about his health.",
                            "target_lang_translations": {
                                "ru": "Он внес <w>изменения</w> в свой образ жизни после того, как врач предупредил его о здоровье.",
                                "tr": "Doktorun kendisini sağlığı konusunda uyarmasının ardından yaşam tarzında bir <w>değişiklik</w> yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "improvement",
                        "reformation"
                    ],
                    "common_phrases": [
                        "make an amendment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение, внесенное для улучшения чего-либо или исправления ошибки.",
                        "tr": "Bir şeyi geliştirmek veya bir hatayı düzeltmek için yapılan değişiklik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправление",
                                "target_lang_sense_clarification": "устранение ошибки"
                            },
                            {
                                "target_lang_word": "корректировка",
                                "target_lang_sense_clarification": "небольшое изменение"
                            },
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "повышение качества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düzeltme",
                                "target_lang_sense_clarification": "hata giderme veya iyileştirme"
                            },
                            {
                                "target_lang_word": "ıslah",
                                "target_lang_sense_clarification": "daha iyi duruma getirme"
                            },
                            {
                                "target_lang_word": "iyileştirme",
                                "target_lang_sense_clarification": "geliştirme amacıyla yapılan değişiklik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61c9e827-fc1d-3680-b1d5-cd16b8169936",
                    "sense_definition": "A substance or material added to something, such as soil, to improve its quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding organic compost is a common soil <w>amendment</w> for vegetable gardens.",
                            "target_lang_translations": {
                                "ru": "Добавление органического компоста — это распространенная почвенная <w>добавка</w> для огородов.",
                                "tr": "Organik kompost eklemek, sebze bahçeleri için yaygın bir toprak <w>iyileştirici katkısıdır</w>."
                            }
                        },
                        {
                            "text": "The farmer used a chemical <w>amendment</w> to balance the pH levels of the field.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал химическую <w>добавку</w>, чтобы сбалансировать уровень pH на поле.",
                                "tr": "Çiftçi, tarlanın pH seviyelerini dengelemek için kimyasal bir <w>ıslah maddesi</w> kullandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soil amendment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или материал, добавляемый во что-либо (например, в почву) для улучшения качества.",
                        "tr": "Toprak gibi bir şeyin kalitesini artırmak için eklenen madde veya malzeme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавка",
                                "target_lang_sense_clarification": "улучшающее вещество"
                            },
                            {
                                "target_lang_word": "мелиорант",
                                "target_lang_sense_clarification": "для улучшения почвы"
                            },
                            {
                                "target_lang_word": "присадка",
                                "target_lang_sense_clarification": "техническая добавка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ıslah maddesi",
                                "target_lang_sense_clarification": "toprak kalitesini artırıcı katkı"
                            },
                            {
                                "target_lang_word": "katkı maddesi",
                                "target_lang_sense_clarification": "toprağa eklenen besleyici malzeme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfa95918-8342-3813-aed2-415352b830ed",
                    "sense_definition": "The correction of an error in a legal writ or judicial process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer requested an <w>amendment</w> of the writ to correct the defendant's name.",
                            "target_lang_translations": {
                                "ru": "Адвокат запросил <w>исправление</w> судебного приказа, чтобы уточнить имя ответчика.",
                                "tr": "Avukat, davalının adını düzeltmek için mahkeme emrinde bir <w>tashih</w> talep etti."
                            }
                        },
                        {
                            "text": "A technical <w>amendment</w> was necessary to fix the clerical error in the court filing.",
                            "target_lang_translations": {
                                "ru": "Техническая <w>поправка</w> была необходима для устранения канцелярской ошибки в судебных документах.",
                                "tr": "Mahkeme dosyasındaki yazı hatasını gidermek için teknik bir <w>düzeltme</w> gerekiyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исправление ошибки в судебном приказе или судебном процессе.",
                        "tr": "Bir mahkeme emri veya adli süreçteki hatanın düzeltilmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправление",
                                "target_lang_sense_clarification": "процессуальной ошибки"
                            },
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "в судебном акте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tashih",
                                "target_lang_sense_clarification": "adli belgedeki hatanın düzeltilmesi"
                            },
                            {
                                "target_lang_word": "düzeltme",
                                "target_lang_sense_clarification": "mahkeme kararındaki maddi hata düzeltisi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}