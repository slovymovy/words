                        "entry_id": "6ad978dd-898f-3ca2-96f8-16d73e11481e",
                        "glosses": [
                            "umgangssprachliche Bezeichnung für die von 1948 bis Ende 2001 in der Bundesrepublik Deutschland existierende Währung Deutsche Mark"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b7d698-f150-4e0c-9d4a-b3e9a118498f",
                                "sense_id": "0f04ecf5-427c-36f3-beb2-7e6f303fd202",
                                "text": "„Die Einführung der D-Mark an sich wurde im ‚Ersten Gesetz zur Neuordnung des Geldwesens‘ vom 20. Juni 1948 geregelt – es hatte daher auch den Beinamen ‚Währungsgesetz‘.“"
                            }
