                        "entry_id": "982cac75-bef5-3acb-9d6e-1198d2ef7631",
                        "glosses": [
                            "Of, relating to, or in honour of Priapus or Priapos (Ancient Greek: Πρίαπος), a minor rustic fertility god, protector of livestock, fruit plants, gardens, and male genitalia."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "1aa15449-fc78-463c-b654-885860c40918",
                                "sense_id": "738bd503-ae0c-3897-85fb-0c42b4597261",
                                "text": "In sculpture and in the drama, in Aristophanic farce and in hieratic rituals, in pictorial art and in the stream of literature, the phallus is transcendent. Thus the Priapean poetry of the ancients, particularly of the Romans, hymned sexual potency."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d78168a-e1ec-34a7-a8bb-7ace69f29960",
                        "entry_id": "982cac75-bef5-3acb-9d6e-1198d2ef7631",
                        "glosses": [
                            "Of, or relating to, an erect penis; phallic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b8fcee-8a9e-468a-9f23-57764ce2ea51",
                                "sense_id": "4d78168a-e1ec-34a7-a8bb-7ace69f29960",
                                "text": "Ovid, the amatory poet, describes a professional dancing-girl, whose subtle bodily movements are such an excitant as to provoke, in an ascetic such as the ancient Hippolytus, a priapean condition."
                            }
                        ]
                    }
                ],
