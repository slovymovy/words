                "senses": [
                    {
                        "sense_id": "2d2fe455-dd99-3937-851f-ee7576c2e43a",
                        "entry_id": "c811e508-e830-36ff-93cd-9e1af8c12938",
                        "glosses": [
                            "Eigenschaft einer Krankheit, langsam und schleichend zu verlaufen, dauerhaft und unheilbar (chronisch) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d198e02-4a1a-4382-8a88-66b0640ecc2a",
                                "sense_id": "2d2fe455-dd99-3937-851f-ee7576c2e43a",
                                "text": "„Wir wollen uns hier aber darauf konzentrieren, dass akuter/subakuter Schmerz besser behandelt werden muss, damit Chronizität verhindert wird.“"
                            },
                            {
                                "example_id": "a6f3eb26-5c8d-4f94-9eb6-f3517af42e6e",
                                "sense_id": "2d2fe455-dd99-3937-851f-ee7576c2e43a",
                                "text": "„Mit der Bezeichnung der Chronizität einer Erkrankung, wie sie im Kapitel ‚Merkmale chronischer Krankheit‘ beschrieben wurde, ist unweigerlich die Gefahr der Hoffnungslosigkeit in Bezug auf potentielle Veränderungen und in Bezug auf Recovery verbunden, denn ‚chronisch ist retrospektiv lang dauernd und prospektiv unveränderbar.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
