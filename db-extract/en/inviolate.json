                                "sense_id": "9d4a42a0-82dd-3ec7-86a8-af6f0f0c42e7",
                                "text": "inviolate truth"
                            },
                            {
                                "example_id": "d2836b6f-a5be-4f49-814d-87ad9268610a",
                                "sense_id": "9d4a42a0-82dd-3ec7-86a8-af6f0f0c42e7",
                                "text": "There chaste Alceste lives inviolate."
                            }
                        ]
                    }
