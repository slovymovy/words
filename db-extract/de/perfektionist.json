                ],
                "senses": [
                    {
                        "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                        "entry_id": "1e40f728-2fef-34fd-a186-73e4f3f1860b",
                        "glosses": [
                            "Person, die ein Werk (beispielsweise ein handwerkliche Arbeit, einen Aufsatz) absolut fehlerfrei erstellen möchte; Person, die die Erfüllung höchster Standards fordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea30da8-fa47-4682-962d-40185d845768",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„[DW:] »Dustin Hoffman ist ja bekannt als furchtbarer Perfektionist. Wie war es, wenn zwei Perfektionisten zusammen arbeiten?« [Volker Schlöndorf:] »Alle großen Schauspieler sind Perfektionisten.«“"
                            },
                            {
                                "example_id": "f8f82195-3f47-464a-aa55-0df256014401",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "[Ennio Morricone] gilt als Perfektionist, der besessen an jeder Note feilt."
                            },
                            {
                                "example_id": "dd13de57-5889-4a96-8f40-418e06a20668",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„Beethoven war ein Perfektionist. Er komponierte nicht für seine Zeitgenossen, sondern für die Nachwelt. Immer wieder feilte er an seinen Werken, überarbeitete und korrigierte die Partituren bis spät in die Nacht.“"
                            },
                            {
                                "example_id": "b123d935-e1ef-44f6-abc9-a6360d345107",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„Stefan Soltész zählt zu den Perfektionisten seiner Zunft, ein Arbeitstier, das nach Mitternacht Empfänge verlässt, um eine Partitur durchzuarbeiten.“"
                            },
                            {
                                "example_id": "5ca73c99-a2e3-4fa3-a0ae-169ee53aa888",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„[Die französische Sportpresse] beschrieb Tuchel als gesundheitsbewussten Vegetarier und autoritären Perfektionisten, als detailverliebten Strategen und Ordnungsfanatiker […].“"
                            },
                            {
                                "example_id": "ea4d51dd-dccd-4605-b436-7c9aac5afedb",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„Kai Kazmirek feierte im vergangenen Jahr mit WM-Bronze seinen bisher größten Karriereerfolg. Bei der Heim-EM will der ruhige Perfektionist die nächste Medaille folgen lassen.“"
                            },
                            {
                                "example_id": "f69c13e0-3b8f-4a28-b6d1-796a54eda332",
                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                "text": "„Wer aufschiebt, ist weder faul noch bequem, sondern eher ein Perfektionist mit (zu) hohen Ansprüchen an sich selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7153320-8ce6-38ae-bde9-7cd68bc1d076",
