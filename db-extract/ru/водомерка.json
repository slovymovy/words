                                    },
                                    {
                                        "sense_id": "cdfa1401-2260-348a-90b0-d253c65cd8bd",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A loose-fitting one-piece dress, similar to a shift but with slightly more fitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6117e23c-d587-4f6a-acb4-bc3d2ebd206b",
                                                "sense_id": "cdfa1401-2260-348a-90b0-d253c65cd8bd",
                                                "text": "Classic, box-pleated skimmers and pantdresses stay crisp and fresh, won't wrinkle or wilt!"
                                            },
                                            {
                                                "example_id": "0a7d2d03-795e-4585-b7cb-a76fbc7b5fb6",
                                                "sense_id": "cdfa1401-2260-348a-90b0-d253c65cd8bd",
                                                "text": "The utilization of divided dart control—some stitched and some unstitched—is the basis of semifitted styles such as the shift or skimmer dress."
                                            },
                                            {
                                                "example_id": "c6955151-767b-4881-a9df-d5b86f9ca7b7",
                                                "sense_id": "cdfa1401-2260-348a-90b0-d253c65cd8bd",
                                                "text": "Slightly A-line, princess-cut “skimmers” were popular as dresses in summer and jumpers in winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cca202c-b6dd-35c9-a491-c2ce56cc003e",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "Any of the dragonflies in the family Libellulidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "229d5776-87e4-32e3-b51f-8ca49cd7be9e",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A sailor in the surface forces, as opposed to a submariner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b347cca0-1f57-3178-81ff-73ad4f1cdb3e",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A surface ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c4fca16-5f62-3c6c-a7d7-50c39e24c835",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A small, fast-moving spacecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4479de-2e1c-4af1-9e04-21ccccdccc5f",
                                                "sense_id": "0c4fca16-5f62-3c6c-a7d7-50c39e24c835",
                                                "text": "Kondric stood beside the skimmer for a moment, looking back at his warriors. They shouted and banged their swords on their shields. He raised his hand in farewell, and followed Violet into the cabin."
                                            },
                                            {
                                                "example_id": "183f61da-513f-424b-9897-2607a11d6f94",
                                                "sense_id": "0c4fca16-5f62-3c6c-a7d7-50c39e24c835",
                                                "text": "They said no one landed on other planets. They said there was no such thing as a skimmer. Rocky hadn't believed them. They didn't know everything. He wished they could see the skimmer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48fcb99-ae5f-3f88-ab3c-5e42c693c2a2",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "Synonym of water strider."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "skimmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de7b274-0abd-3cf4-9465-8aadab1e32ac",
                                        "entry_id": "67e1cbab-5dc3-3787-ba0e-f524166f3ce2",
                                        "glosses": [
                                            "To shimmer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ab79060-2f89-30c4-b8a9-419f57edb7d9",
                                        "entry_id": "67e1cbab-5dc3-3787-ba0e-f524166f3ce2",
                                        "glosses": [
                                            "To move quickly, to flutter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b711e1-b55a-4b4c-9d5f-0ae460c34811",
                                                "sense_id": "7ab79060-2f89-30c4-b8a9-419f57edb7d9",
                                                "text": "…he was bounding over the heads of the maidens, and making his feet skimmer against the ceiling, enjoying, the while, the most ecstatic emotions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
