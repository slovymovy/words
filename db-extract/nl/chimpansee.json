                                        "entry_id": "724ea4b5-9b5a-34fb-a6d7-38febf80bbc3",
                                        "glosses": [
                                            "nome comune per una specie di scimmie antropomorfe delle foreste dell'Africa occidentale, appartenente al genere, Pan dalla pelle scura che hanno un muso che sporge in fuori e che sono prive di coda; la sua classificazione scientifica è Pan troglodytes ( tassonomia)"
                                        ],
                                        "tags": [
                                            "primatologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b379a2-50a1-494a-883f-14eff3bf6ef1",
                                                "sense_id": "f98a8736-525d-39e7-bfb8-f6e31edd7e32",
                                                "text": "lo scimpanzé è un primate aplorrino, appartenente al parvordine delle catarrine, alla superfamiglia delle Hominoidea, alla famiglia degli Hominidae ed al genere Pan"
                                            },
                                            {
                                                "example_id": "484eba3c-2dd8-48c6-9b00-fd6947ba57c0",
                                                "sense_id": "f98a8736-525d-39e7-bfb8-f6e31edd7e32",
                                                "text": "il genoma umano e quello dello scimpanzé sono identici per più del 98 per cento: ciò dimostra la loro parentela biologica"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4054df2d-7b4c-3016-a7d7-933bb5f6b8c7",
