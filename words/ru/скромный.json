                        "скромный ужин",
                        "скромная обстановка",
                        "по моему скромному мнению"
                    ],
                    "target_lang_definitions": {
                        "en": "Simple, without luxury or excess; plain in appearance (regarding clothes, lifestyle, etc.).",
                        "pl": "Prosty, bez zbytków i luksusu, niewyróżniający się wyglądem (o ubraniu, stylu życia, otoczeniu)."
