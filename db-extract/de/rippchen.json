                                        "entry_id": "f3416dcc-3209-3601-bdd3-b77a81e42e6a",
                                        "glosses": [
                                            "έδεσμα που παρασκευάζεται από τα πλευρά του θώρακα του ζώου τα οποία είναι τεμαχισμένα εγκάρσια, κατά μήκος του διάκενου μεταξύ των οστών, ώστε στο κάθε οστό να αντιστοιχεί κι από ένα καμμάτι (παϊδάκι)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfce46e-f72d-4b77-8e3d-eb153df5e87e",
                                                "sense_id": "a67e790a-a481-3ab4-a8dd-2eabf5c6155b",
                                                "text": "ψήσαμε αρνίσια παϊδάκια στα κάρβουνα"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "306b84fb-53dc-4294-98b3-e98a92087cc5",
                        "source_entry_id": "c6a280cc-5178-3d62-8c4e-3ef4d08134ea",
                        "source_sense_id": "f5442fb7-6164-36fb-af2a-ef3e1205d228",
