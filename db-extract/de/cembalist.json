                        "examples": [
                            {
                                "example_id": "d9a6db85-921b-4459-9f7d-ef1006f8219b",
                                "sense_id": "fb304640-5345-3948-aacc-9227780a6475",
                                "text": "Sie suchen für ihr Orchester noch einen guten Cembalisten."
                            },
                            {
                                "example_id": "27fb5a68-b322-467c-a120-f7b8766cd63a",
                                "sense_id": "fb304640-5345-3948-aacc-9227780a6475",
                                "text": "„Der große niederländische Cembalist, Organist und Dirigent Gustav Leonhardt ist gestern, Montag, im Alter von 83 Jahren in Amsterdam gestorben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
