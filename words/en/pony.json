                            "comment": "academic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подстрочный перевод, используемый как шпаргалка.",
                        "zh": "用作学习辅助的翻译本；泛指小抄或作弊条。"
                    },
