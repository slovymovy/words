                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e806ba94-f152-4204-98ad-ea536454cc4b",
                                                "sense_id": "a65967ba-87cf-3cf6-ae25-ea68d4159240",
                                                "text": "But, sitting by the opening of Ismail's Muslim Eating Shop, Inder Singh was spooning in soup, tall, thin, saturnine, his beard cut, contrary to the laws of religion, trimmed in a Mephistophelian manner, his turban neat and starched[.]"
                                            },
                                            {
                                                "example_id": "5f275f18-ec6a-40ad-921f-12cee095f35f",
                                                "sense_id": "a65967ba-87cf-3cf6-ae25-ea68d4159240",
                                                "text": "And you can see from the Spockian ears and the raised eyebrows, he had a positive Mephistophelian look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
