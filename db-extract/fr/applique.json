                ],
                "senses": [
                    {
                        "sense_id": "f48ce7b8-45f0-3f16-b4ab-73545ec10b1d",
                        "entry_id": "a376d44d-ca1c-3a2a-b26a-14041fa4dfae",
                        "glosses": [
                            "Tout ce qui est appliqué, fixé sur un objet pour le décorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd22070-7558-466a-9956-30db1384f73b",
                                "sense_id": "f48ce7b8-45f0-3f16-b4ab-73545ec10b1d",
                                "text": "Pièces d’applique."
                            },
                            {
                                "example_id": "0777baac-16fc-4079-ad2d-9fc4026c9088",
                                "sense_id": "f48ce7b8-45f0-3f16-b4ab-73545ec10b1d",
                                "text": "L’or, l’argent et autres métaux laminés sont mis en applique sur les meubles, sur les moulures d’une corniche, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b238ddda-6cfd-3638-9520-8f84c5de0443",
                        "entry_id": "a376d44d-ca1c-3a2a-b26a-14041fa4dfae",
                        "glosses": [
                            "Luminaire appliqué au mur."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d0615323-a471-48be-9311-89a6a08999d9",
                                "sense_id": "b238ddda-6cfd-3638-9520-8f84c5de0443",
                                "text": "Le palier est long et étroit, le mur est tendu d’une imitation de tapisserie à ramages vert sombre où brille le cuivre d’une applique à gaz."
                            },
                            {
                                "example_id": "9a0ff04d-4787-426c-9340-2fff149d1b95",
                                "sense_id": "b238ddda-6cfd-3638-9520-8f84c5de0443",
                                "text": "Elle retourne sur la pointe des pieds border Lucien qui s’est découvert en dormant, puis se dirige à la lueur des appliques de la salle de bains jusqu’au semainier où elle range ses bijoux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2318e3df-4be3-40f9-a85c-eac04e9b6394",
                        "source_entry_id": "a376d44d-ca1c-3a2a-b26a-14041fa4dfae",
                        "source_sense_description": "Luminaire appliqué au mur",
                        "target_lang_word": "Wandleuchte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a42f3db7-0989-4786-a9c5-d0b06455cc48",
                        "source_entry_id": "a376d44d-ca1c-3a2a-b26a-14041fa4dfae",
                        "source_sense_description": "Luminaire appliqué au mur",
                        "target_lang_word": "sconce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sconce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ecf16a-39e3-3783-a0e1-414bf0ae2151",
                                        "entry_id": "f250135a-4a5d-3990-ad2e-b67302860d35",
                                        "glosses": [
                                            "A fixture for a light, which holds it and provides a screen against wind or against a naked flame or lightbulb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b425ed1-8689-4142-9746-013e156a7f86",
                                                "sense_id": "a0ecf16a-39e3-3783-a0e1-414bf0ae2151",
                                                "text": "[…]tapers put into lanterns or sconces of several-coloured, oiled paper, that the wind might not annoy them."
                                            },
                                            {
                                                "example_id": "865326cb-b248-4d4c-860e-e8d5725c2271",
                                                "sense_id": "a0ecf16a-39e3-3783-a0e1-414bf0ae2151",
                                                "text": "Golden sconces hang not on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea7469e-6170-31f7-b98b-af325cb8ce88",
                                        "entry_id": "f250135a-4a5d-3990-ad2e-b67302860d35",
                                        "glosses": [
                                            "A fixture for a light, which holds it and provides a screen against wind or against a naked flame or lightbulb.",
                                            "A candlestick (holder for a candle, especially a circular tube, with a brim, into which a candle is inserted), either with a handle for carrying, or with a bracket for attaching to a wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "648a5ecf-4bd9-4007-a046-f0e77b4667cf",
                                                "sense_id": "bea7469e-6170-31f7-b98b-af325cb8ce88",
                                                "text": "Taking the candle […] she stood with the little flat brass sconce in her hand."
                                            },
                                            {
                                                "example_id": "65bcd0bb-2caf-453d-9c6b-a433a32d8279",
                                                "sense_id": "bea7469e-6170-31f7-b98b-af325cb8ce88",
                                                "text": "This strange scene was lightd up by candles in high and havy brass sconces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sconce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                        "entry_id": "7fc38cac-a723-38b4-bc1b-bb5ac519cd84",
                                        "glosses": [
                                            "A head or a skull."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1eaf036-5a69-4f96-8265-05bb905e0467",
                                                "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                                "text": "Novv as I am a Chriſtian anſvver me, / In vvhat ſafe place you haue beſtovv'd my monie; / Or I ſhall breake that merrie ſconce of yours / That ſtands on tricks, vvhen I am vndiſpos'd: / VVhere is the thouſand Markes thou hadſt of me?"
                                            },
                                            {
                                                "example_id": "e6bae66e-6eb5-464e-929f-d2e46b37f691",
                                                "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                                "text": "Why does he suffer this rude knave now, to knock him about the sconce with a dirty shovel, and will not tell him of his action of battery?"
                                            },
                                            {
                                                "example_id": "91296623-4d32-4030-ba79-e4ecf05f8127",
                                                "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                                "text": "Long time this sconce a helmet wore, / But sickness smites the conscience sore; / He broke his sword, and hither bore / His gear and plunder, / Took to the cowl,—then rav’d and swore / At his damn’d blunder!"
                                            },
                                            {
                                                "example_id": "6a977c67-29f7-4589-b40b-1a971a532b24",
                                                "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                                "text": "[…] roll the rider and his horse in the dust, or endeavour to drive their lance through the bars of the visor into the bull's eye of their friend's sconce, […]"
                                            },
                                            {
                                                "example_id": "9fc08c4b-12a9-4490-b15d-53ebe72c9166",
                                                "sense_id": "d3c1f0d6-cb28-3ea7-81ea-e101cfec619b",
                                                "text": "[…]; an old blue jacket, that at one time had been a coat, looped over a red plush “singlet” of perhaps twenty or even forty years' wear : his almost hairless sconce bared to the sun, from which it had received an imperishable coating of tan, he was an object that few would pass without hailing with observations,[…] he wiped his shining sconce [...] and raised his visor […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fd4508-d207-3aa5-9aa9-27208d4b4db3",
                                        "entry_id": "7fc38cac-a723-38b4-bc1b-bb5ac519cd84",
                                        "glosses": [
                                            "A poll tax; a mulct or fine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c6d04bd-4b5f-47f0-9407-279a408f6f39",
                                                "sense_id": "a7fd4508-d207-3aa5-9aa9-27208d4b4db3",
                                                "text": "I'll gladly pay a sconce"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcfa5ef2-4ab3-3007-9adc-ebce3b13f0bc",
                                        "entry_id": "7fc38cac-a723-38b4-bc1b-bb5ac519cd84",
                                        "glosses": [
                                            "An act of sconcing; very similar to a fine at Cambridge University, though a sconce is the act of issuing a penalty rather than the penalty itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45f5051-454e-464a-8d02-df261199444a",
                                                "sense_id": "bcfa5ef2-4ab3-3007-9adc-ebce3b13f0bc",
                                                "text": "."
                                            },
                                            {
                                                "example_id": "1ae45d7a-76f8-4f3e-b726-e01e0866781e",
                                                "sense_id": "bcfa5ef2-4ab3-3007-9adc-ebce3b13f0bc",
                                                "text": "The table opposite started singing \"shit sconce, shit scone^([sic]), shit sconce, shit sconce\" […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sconce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40cf2968-6387-310b-a325-fdc9d6c59846",
                                        "entry_id": "c7e28581-aeac-380c-8427-84355dc1b6e2",
                                        "glosses": [
                                            "To impose a fine, a forfeit, or a mulct."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2093fb0-4376-4bed-9e47-fa7e3aeb19c5",
                                                "sense_id": "40cf2968-6387-310b-a325-fdc9d6c59846",
                                                "text": "The Rector sconced him in the buttery-book, but Webberly “wiped it off, with irreverent and unbeseeming language.” For this, he had to apologise, and go without his commons for three months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f9f7074-89b7-316e-b01e-8561dcfea512",
                                        "entry_id": "c7e28581-aeac-380c-8427-84355dc1b6e2",
                                        "glosses": [
                                            "During a meal or as part of a drinking game, to announce some (usually outrageous) deed such that anyone who has done it must drink; similar to I have never; commonly associated with crewdates; very similar to fining at Cambridge University."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac83100-e83e-40ae-83a5-3e31ad6885f3",
                                                "sense_id": "5f9f7074-89b7-316e-b01e-8561dcfea512",
                                                "text": "I sconce anyone who has ever…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sconce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa470b8f-3db9-3d2c-be3d-56721d66023f",
                                        "entry_id": "4cdbfbc2-8bf7-392d-933c-d6d50e38d358",
                                        "glosses": [
                                            "A type of small fort or other fortification, especially as built to defend a pass or ford."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc9dde14-866b-42c6-9629-2c90bac284d3",
                                                "sense_id": "fa470b8f-3db9-3d2c-be3d-56721d66023f",
                                                "text": "No sconce or fortress of his raising was ever known either to have been forced, or yielded up, or quitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0464f9e2-3464-3bc3-b3ed-d797b76d37b6",
                                        "entry_id": "4cdbfbc2-8bf7-392d-933c-d6d50e38d358",
                                        "glosses": [
                                            "A hut for protection and shelter; a stall."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7532d0d0-abf6-426a-9fba-85c07a8529dd",
                                                "sense_id": "0464f9e2-3464-3bc3-b3ed-d797b76d37b6",
                                                "text": "one that […] must raise a sconce by the highway and sell switches"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f3767ee-a10f-3ac5-81bf-c002c4dd61af",
                                        "entry_id": "4cdbfbc2-8bf7-392d-933c-d6d50e38d358",
                                        "glosses": [
                                            "A squinch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4078deab-eb15-3806-a844-2507bd9d7e5d",
                                        "entry_id": "4cdbfbc2-8bf7-392d-933c-d6d50e38d358",
                                        "glosses": [
                                            "A fragment of a floe of ice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432c45dc-76ed-4790-8116-bc06db89de53",
                                                "sense_id": "4078deab-eb15-3806-a844-2507bd9d7e5d",
                                                "text": "Just then, a broad sconce-piece or low water-washed berg came driving up from the southward. The thought flashed upon me of one of our escapes in Melville Bay; and as the sconce moved rapidly close alongside us, McGary managed to plant an anchor on its slope and hold on to it by a whale-line."
                                            }
                                        ]
                                    },
