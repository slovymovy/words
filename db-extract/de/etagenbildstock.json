                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7fe01a9-edaa-4ddb-b212-284724b72f6f",
                                "sense_id": "be6a97a6-3131-3671-9582-be327283c450",
                                "text": "„Hinter der Kirche führt der Weg, vorbei am Leikam-Kreuz, einem für Kärnten seltenen Etagenbildstock, weiter bergab bis in die erste Kurve.“"
                            },
                            {
                                "example_id": "8fcfee06-481a-48de-a81e-cf601744b8ab",
                                "sense_id": "be6a97a6-3131-3671-9582-be327283c450",
                                "text": "„An der Straße von Messern Richtung Rothweinsdorf befindet sich ein Etagenbildstock mit sechs Nischen, der nach Süden ausgerichtet ist“"
                            },
                            {
                                "example_id": "ff770910-ad5b-4c03-a559-1ace101bcc38",
                                "sense_id": "be6a97a6-3131-3671-9582-be327283c450",
                                "text": "„Es handelt sich um einen Etagenbildstock, im unteren Teil befinden sich drei Rundbogennischen.“"
                            },
                            {
                                "example_id": "ea2ded96-40f4-4d1e-8f93-8cfc776eacab",
