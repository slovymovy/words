    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d451f5ed-e69a-33ce-b616-4bbe96d2fcdf",
                    "sense_definition": "niewielki pojazd na płozach używany do zjeżdżania po śniegu w celach rekreacyjnych lub sportowych",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci zjeżdżały ze stromej górki na drewnianych <w>sankach</w> przez całe popołudnie.",
                            "target_lang_translations": {
                                "ru": "Дети весь день катались с крутой горки на деревянных <w>санках</w>."
                            }
                        },
                        {
                            "text": "Kiedy spadł pierwszy śnieg, od razu wyciągnąłem <w>sanki</w> ze starej piwnicy.",
                            "target_lang_translations": {
                                "ru": "Когда выпал первый снег, я сразу же достал <w>санки</w> из старого подвала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zjeżdżać na sankach",
                        "drewniane sanki"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое средство передвижения на полозьях, используемое для катания по снегу ради развлечения или в спорте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санки",
                                "target_lang_sense_clarification": "детские или спортивные"
                            },
                            {
                                "target_lang_word": "салазки",
                                "target_lang_sense_clarification": "небольшие ручные санки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5671efe6-4ac0-3262-9144-f186627e7985",
                    "sense_definition": "niewielkie sanie przeznaczone do zaprzęgu konnego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Para koni zaprzężona do prostych fornalskich <w>sanek</w> stała już przed niskimi drzwiami stajni.",
                            "target_lang_translations": {
                                "ru": "Пара лошадей, запряжённая в простые мужицкие <w>сани</w>, уже стояла перед низкой дверью конюшни."
                            }
                        },
                        {
                            "text": "Gospodarz jechał wąską leśną drogą, powożąc niewielkimi <w>sankami</w> zaprzężonymi w jednego konia.",
                            "target_lang_translations": {
                                "ru": "Хозяин ехал по узкой лесной дороге, правя небольшими <w>санками</w>, запряжёнными одной лошадью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшие сани для конной упряжки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санки",
                                "target_lang_sense_clarification": "лёгкие сани в конной упряжке"
                            },
                            {
                                "target_lang_word": "сани",
                                "target_lang_sense_clarification": "небольшая повозка на полозьях"
                            },
                            {
                                "target_lang_word": "кошевка",
                                "target_lang_sense_clarification": "лёгкие открытые выездные сани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d75d8012-3133-390e-96b8-5cbea250f269",
                    "sense_definition": "ruchoma część maszyny, przyrządu lub aparatu wykonująca ruch ślizgowy wzdłuż prowadnic",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przesuń <w>sanki</w> wzdłuż prowadnicy, aby precyzyjnie ustawić głowicę urządzenia.",
                            "target_lang_translations": {
                                "ru": "Сдвинь <w>салазки</w> вдоль направляющей, чтобы точно выставить головку устройства."
                            }
                        },
                        {
                            "text": "Mechanizm zablokował się, ponieważ <w>sanki</w> tokarki były zanieczyszczone opiłkami metalu.",
                            "target_lang_translations": {
                                "ru": "Механизм заклинило, так как <w>суппорт</w> токарного станка был загрязнён металлической стружкой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "подвижная деталь станка или прибора, совершающая скользящее движение по направляющим"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "салазки",
                                "target_lang_sense_clarification": "подвижная опора в станках"
                            },
                            {
                                "target_lang_word": "суппорт",
                                "target_lang_sense_clarification": "в токарных станках"
                            },
                            {
                                "target_lang_word": "каретка",
                                "target_lang_sense_clarification": "в механизмах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8e58d12-6de0-3350-bc38-be986eca04aa",
                    "sense_definition": "uchwyt na korpusie aparatu fotograficznego służący do mocowania zewnętrznej lampy błyskowej lub innych akcesoriów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fotograf zamocował nowoczesną lampę błyskową na metalowych <w>sankach</w> aparatu.",
                            "target_lang_translations": {
                                "ru": "Фотограф закрепил современную вспышку на металлическом <w>башмаке</w> фотоаппарата."
                            }
                        },
                        {
                            "text": "Zewnętrzny mikrofon podłącza się bezpośrednio pod <w>sanki</w> umieszczone na obudowie.",
                            "target_lang_translations": {
                                "ru": "Внешний микрофон подключается прямо в <w>башмак</w>, расположенный на корпусе."
                            }
                        }
                    ],
                    "synonyms": [
                        "gorąca stopka"
                    ],
                    "target_lang_definitions": {
                        "ru": "крепление на корпусе фотоаппарата для установки внешней вспышки или других аксессуаров"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "башмак",
                                "target_lang_sense_clarification": "разъём для вспышки"
                            },
                            {
                                "target_lang_word": "горячий башмак",
                                "target_lang_sense_clarification": "с электрическими контактами"
                            },
                            {
                                "target_lang_word": "холодный башмак",
                                "target_lang_sense_clarification": "без контактов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f89ac4ac-c684-3094-8c15-f098547b7838",
                    "sense_definition": "tymczasowy areszt stosowany wobec podejrzanego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podejrzany spędził trzy miesiące na <w>sankach</w>, czekając na rozpoczęcie procesu.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый провёл три месяца в <w>СИЗО</w>, ожидая начала процесса."
                            }
                        },
                        {
                            "text": "Prokurator złożył wniosek do sądu i załatwił mu trzymiesięczne <w>sanki</w>.",
                            "target_lang_translations": {
                                "ru": "Прокурор подал ходатайство в суд и оформил ему трёхмесячный <w>арест</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w żargonie więziennym i potocznym języku przestępczym"
                        }
                    ],
                    "target_lang_definitions": {
