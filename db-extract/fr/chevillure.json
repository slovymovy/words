                                        "sense_id": "1e5f3a53-e07a-38fc-ac8a-877c10c1d086",
                                        "entry_id": "5f628ca1-dbbd-31e8-b0c5-fe2bd775a532",
                                        "glosses": [
                                            "A small, typically rectangular or round, flat, and rigid object upon which things are carried."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3de6e6-cc9a-4444-9dd6-0b2a1de2ae39",
                                                "sense_id": "1e5f3a53-e07a-38fc-ac8a-877c10c1d086",
                                                "text": "I carefully arranged the dishes on the tray and brought it upstairs."
                                            },
                                            {
                                                "example_id": "1b56b92f-0248-452c-808d-8077c0eb878d",
                                                "sense_id": "1e5f3a53-e07a-38fc-ac8a-877c10c1d086",
                                                "text": "Make sure that tray of eggs is properly loaded."
                                            },
                                            {
                                                "example_id": "ef6ebf05-5ab6-4bbf-aeff-72eead489e90",
                                                "sense_id": "1e5f3a53-e07a-38fc-ac8a-877c10c1d086",
                                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16268b31-063e-31fb-bde8-fc166fdfa86c",
                                        "entry_id": "5f628ca1-dbbd-31e8-b0c5-fe2bd775a532",
                                        "glosses": [
                                            "The items on a full tray."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d70ccdaa-c2a9-4e4c-8815-897f89f32a90",
                                                "sense_id": "16268b31-063e-31fb-bde8-fc166fdfa86c",
                                                "text": "Before long they had consumed a whole tray of shrimp cocktails and sent for another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79924a05-5ed7-3115-b308-91ff083461cd",
                                        "entry_id": "5f628ca1-dbbd-31e8-b0c5-fe2bd775a532",
                                        "glosses": [
                                            "A component of a device into which an item is placed for use in the device's operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3badd0e3-442a-484c-ab1a-38dc7ac540c3",
                                                "sense_id": "79924a05-5ed7-3115-b308-91ff083461cd",
                                                "text": "The CD tray will not open."
                                            },
                                            {
                                                "example_id": "cb851dd6-a393-4c24-80fc-80c308dafb24",
                                                "sense_id": "79924a05-5ed7-3115-b308-91ff083461cd",
                                                "text": "The loader is responsible for placing the work on the trays for the plating machines."
                                            },
                                            {
                                                "example_id": "8d5ce236-5587-4f59-a367-91481a197535",
                                                "sense_id": "79924a05-5ed7-3115-b308-91ff083461cd",
