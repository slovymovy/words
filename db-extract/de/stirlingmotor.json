                "senses": [
                    {
                        "sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                        "entry_id": "7a0d0aa8-41c6-3e9a-ba54-f4a7c11dfe03",
                        "glosses": [
                            "Motor, der von außen zugeführte Wärmeenergie in mechanische Arbeit umsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417eee3a-b82b-4253-a8c0-b3ccf7dd0605",
                                "sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                                "text": "Der Stirlingmotor wurde von Robert Stirling erfunden."
                            },
                            {
                                "example_id": "6130f830-636d-49af-9dc1-8b732e4ad477",
                                "sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                                "text": "„Der Stirlingmotor, auch Heißgasmotor genannt, ist eine Wärmekraftmaschine, in der ein abgeschlossenes Arbeitsgas wie Luft, Helium oder Wasserstoff von außen an zwei verschiedenen Bereichen erhitzt und gekühlt wird, um mechanische Arbeit zu leisten.“"
                            },
                            {
                                "example_id": "f2ce8e61-b4f7-436b-a8e3-62fe642adb13",
                                "sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                                "text": "„Der Stirlingmotor, 200 Jahre alt, wird erneut entdeckt.“"
                            },
                            {
                                "example_id": "95e9acf9-4051-474c-aa7e-e93a6f14d8d8",
                                "sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                                "text": "„In einem Stirlingmotor wird üblicherweise ein Zylinder immer wieder erhitzt und abgekühlt, wodurch sich das darin befindliche Gas ausdehnt und zusammenzieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ace5c52b-f8bc-42fe-b944-7e4e1814374b",
                        "source_entry_id": "7a0d0aa8-41c6-3e9a-ba54-f4a7c11dfe03",
                        "source_sense_id": "47aca783-5ab5-356d-a796-9210ced4314e",
                        "source_sense_description": "Motor, der von außen zugeführte Wärmeenergie in mechanische Arbeit umsetzt",
                        "target_lang_word": "moteur Stirling",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moteur Stirling",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f935cd-1395-33ec-85ad-1a028d695421",
                                        "entry_id": "63da8167-e856-3e4c-a7cf-9799a0f78f60",
                                        "glosses": [
                                            "Moteur à combustion externe et à fluide de travail (un gaz) en circuit fermé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "788d628d-79b7-48d0-bbdc-04e172fcf90d",
                                                "sense_id": "c2f935cd-1395-33ec-85ad-1a028d695421",
                                                "text": "… or dans le moteur Stirling, T1 ne dépassait pas 370° centigrades, et dans celui de Lehmann on n’atteignait que 547° ; il fallait absolument arriver plus haut."
                                            },
                                            {
                                                "example_id": "cf2247be-bd17-4c51-9a60-433fcce60c35",
                                                "sense_id": "c2f935cd-1395-33ec-85ad-1a028d695421",
                                                "text": "Puis, refroidi dans un condenseur qui utilise l’eau de mer comme source froide, et réchauffé à nouveau dans le brûleur de gas-oil, le même gaz en circuit fermé actionne successivement les pistons du moteur Stirling."
                                            },
                                            {
                                                "example_id": "9a2c28fa-edc1-4e25-97ce-344406cb581d",
                                                "sense_id": "c2f935cd-1395-33ec-85ad-1a028d695421",
                                                "text": "Un autre moyen d’utiliser le bois pour la propulsion de véhicules est le moteur à combustion externe ou moteur Stirling (du nom de l’inventeur Robert Stirling, qui en déposa le brevet en 1816)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
