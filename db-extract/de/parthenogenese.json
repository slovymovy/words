                                "example_id": "ebd83336-d254-425b-bde8-fe1f484949ac",
                                "sense_id": "0efb9784-3939-340b-acdc-f1981d47e210",
                                "text": "Rädertierchen und Bärtierchen vermehren sich eingeschlechtlich durch Parthenogenese."
                            },
                            {
                                "example_id": "5ff1553d-f03e-446d-b2f5-eff20aaf34e5",
                                "sense_id": "0efb9784-3939-340b-acdc-f1981d47e210",
                                "text": "„In Artikeln verfocht er die These der Parthenogenese der Bienen, einer neuen Fortpflanzungslehre dieser Insekten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
