                "senses": [
                    {
                        "sense_id": "5df654ad-b0d2-3860-8c27-c320348691c8",
                        "entry_id": "30e8bbf4-9e8b-3d87-9673-bbc84078fad1",
                        "glosses": [
                            "den Heiligen Stephanus oder Stephan geweihtes Gotteshaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f54307f-9575-49a7-8124-49e921e429fe",
                                "sense_id": "5df654ad-b0d2-3860-8c27-c320348691c8",
                                "text": "„Rudolf beabsichtigte, die Stephanskirche zum Familienheiligtum und zur Grablege aller Habsburger zu machen.“"
                            },
                            {
                                "example_id": "604a4977-905b-4d12-a534-dde9272e5333",
                                "sense_id": "5df654ad-b0d2-3860-8c27-c320348691c8",
                                "text": "„Friedlich ragen die Glockentürme der beiden kirchlichen Bauten nebeneinander auf, mit spitzem Helm der der katholischen Marienkirche, mit barocker Kuppel der der protestantischen Stephanskirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
