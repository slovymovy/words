        "nl-extract.jsonl": [
            {
                "entry_id": "8d8f4e5c-522a-36b9-aa0b-cf8ee65b3ae3",
                "word": "petitie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "90c5b0ea-a219-4375-bfbf-01b51b204e93",
                        "entry_id": "8d8f4e5c-522a-36b9-aa0b-cf8ee65b3ae3",
                        "tags": [
                            "plural"
                        ],
                        "form": "petities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                        "entry_id": "8d8f4e5c-522a-36b9-aa0b-cf8ee65b3ae3",
                        "glosses": [
                            "een formeel verzoek ondertekend door een groep personen met een politiek of maatschappelijk doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57814c8d-28c4-4376-987e-3bb558eabb85",
                                "sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                                "text": "Onlangs is nog massaal een petitie ondertekend waarin werd opgeroepen zo snel mogelijk iets aan de situatie te doen."
                            },
                            {
                                "example_id": "6276b7eb-83d1-4f5d-89cc-39f3bb08d386",
                                "sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                                "text": "Ruim 100.000 mensen hebben een symbolische petitie getekend om multimiljardair Jeff Bezos niet te laten terugkeren naar de aarde. De Amazon-oprichter kondigde eerder aan op 20 juli deel te nemen aan de eerste toeristische ruimtevlucht van zijn ruimtevaartbedrijf."
                            },
                            {
                                "example_id": "41e19493-b751-49ab-9807-9958f2e1a64e",
                                "sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                                "text": "Tentamenweek of niet, studenten, promovendi en andere medewerkers van de afdeling Aardwetenschappen aan de Vrije Universiteit in Amsterdam voeren vandaag actie. Ze proberen het voorgenomen besluit om hun studie en banen weg te bezuinigen tegen te houden. En niet alleen zij maken zich zorgen: ook het werkveld luidt de noodklok. Een petitie tegen het plan is al meer dan 8000 keer getekend."
                            },
                            {
                                "example_id": "a53373a8-8b05-4b39-a14a-2a2a0898601e",
                                "sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                                "text": "Actievoerders van platform Noodalarm Geboortezorg hebben een petitie in de Tweede Kamer aangeboden. In de petitie, die bijna 190.000 keer is ondertekend, worden Kamerleden opgeroepen om het plan van minister Kuipers voor een integraal tarief voor geboortezorg te blokkeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6d31a79-7fd3-49b6-9a05-9301d586ea0c",
                        "source_entry_id": "8d8f4e5c-522a-36b9-aa0b-cf8ee65b3ae3",
                        "source_sense_id": "5e11bd25-2fbc-3d6c-a868-5f017231c53c",
                        "source_sense_description": "een formeel verzoek ondertekend door een groep personen met een politiek of maatschappelijk doel",
                        "target_lang_word": "petition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
