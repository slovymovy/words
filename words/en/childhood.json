            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8fb28b6-e25f-3779-b275-81fc678e1df7",
                    "sense_definition": "The period of time when a person is a child, usually from birth until puberty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent most of her <w>childhood</w> living in a small village near the mountains.",
                            "target_lang_translations": {
                                "ru": "Она провела большую часть своего <w>детства</w> в маленькой деревне недалеко от гор.",
                                "zh": "她大部分<w>童年</w>时光都是在山边的一个小村庄里度过的。"
                            }
                        },
                        {
                            "text": "He met his <w>childhood</w> friend at the reunion after twenty years apart.",
                            "target_lang_translations": {
                                "ru": "Он встретил своего друга <w>детства</w> на встрече выпускников после двадцати лет разлуки.",
                                "zh": "二十年后，他在聚会上见到了自己的<w>童年</w>好友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "youth",
                        "early years"
                    ],
                    "antonyms": [
                        "adulthood"
                    ],
                    "common_phrases": [
                        "happy childhood",
                        "early childhood",
                        "childhood friend",
                        "childhood memory",
                        "in one's childhood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, когда человек является ребенком, обычно от рождения до полового созревания",
                        "zh": "一个人从出生到青春期这段作为儿童的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детство",
                                "target_lang_sense_clarification": "период жизни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "童年",
                                "target_lang_sense_clarification": "指人的幼年时期"
                            },
                            {
                                "target_lang_word": "幼年",
                                "target_lang_sense_clarification": "指年纪幼小的时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c845bba-5bbc-3314-9436-cded28592008",
                    "sense_definition": "The early stages of the development or history of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Space travel is still in its <w>childhood</w> compared to what it might become in the future.",
                            "target_lang_translations": {
                                "ru": "Космические путешествия все еще находятся в <w>младенчестве</w> по сравнению с тем, чем они могут стать в будущем.",
                                "zh": "与未来可能达到的水平相比，太空旅行仍处于<w>初期</w>阶段。"
                            }
                        },
                        {
                            "text": "In the <w>childhood</w> of the internet, websites were very simple and text-based.",
                            "target_lang_translations": {
                                "ru": "В <w>младенчестве</w> интернета веб-сайты были очень простыми и состояли в основном из текста.",
                                "zh": "在互联网的<w>萌芽期</w>，网站非常简单，主要以文字为主。"
                            }
                        }
                    ],
                    "synonyms": [
                        "infancy"
                    ],
                    "antonyms": [
                        "maturity"
                    ],
                    "common_phrases": [
                        "in its childhood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранние стадии развития или истории чего-либо",
                        "zh": "某事物发展或历史的早期阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
