                                    {
                                        "sense_id": "2b9c53af-182b-393e-9a1f-8c538ccb9e79",
                                        "entry_id": "83260182-9376-36db-a04f-a4e2ddcb4d2f",
                                        "glosses": [
                                            "Infrutescence du jaquier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764eed51-88b0-4186-8476-8a3d7c2012f7",
                                                "sense_id": "2b9c53af-182b-393e-9a1f-8c538ccb9e79",
                                                "text": "Faire attention à la sève visqueuse et collante du jaque. Lorsqu'il n'est pas mûr, il est apprêté comme un légume. Comme fruit, le jaque est consommé cru ou cuit, coupé en morceau ou rapé. On le transforme également en confiture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de437268-2572-36cf-9e41-551875d07d75",
                                        "entry_id": "c3be6e9b-d504-387d-bcc2-f320b04475a6",
                                        "glosses": [
                                            "Variante de jacque."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d74220-963d-4c15-836f-e0996d3ffe78",
                                                "sense_id": "de437268-2572-36cf-9e41-551875d07d75",
                                                "text": "Quatre-vingt mille têtes armées; trente mille harnois blancs, jaques ou brigandines."
                                            },
                                            {
                                                "example_id": "729cb3d3-e98d-4cdb-b13e-0cf7fbbb39b3",
                                                "sense_id": "de437268-2572-36cf-9e41-551875d07d75",
                                                "text": "Le roi était à cheval, vêtu de l'habillement court et étroit qu'on nommait un jaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aac6e05f-eac5-413e-ae96-995252d15576",
                        "source_entry_id": "60d16e01-bc69-3e77-8266-4fb51de9b675",
                        "source_sense_description": "the fruit",
                        "target_lang_word": "jacque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jacque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                                        "entry_id": "35f6193a-4cb7-3372-9f17-6ccde9520aba",
                                        "glosses": [
                                            "Pourpoint à manches et rembourré, servant à la fois de vêtement et de protection, en usage au Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e033d72-70bc-44c5-aa1c-08a1162e7c09",
                                                "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                                                "text": "Le roi était à cheval, vêtu de l’habillement court et étroit qu’on nommait une jacque ; le sien était en velours noir."
                                            },
                                            {
                                                "example_id": "0d354432-52f6-46e2-a30a-af46e40a126d",
                                                "sense_id": "8fdca934-26a9-3d42-8db0-e2147aa303f4",
                                                "text": "Jeanne fut introduite (...). Robuste, le cou puissant et court, la poitrine ample, autant qu’il y pouvait paraître sous le jacque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jacque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e20e04-dac0-3270-b2d0-93ec99cea70d",
                                        "entry_id": "3021a638-70c0-3023-9a15-8d1c095dc32b",
                                        "glosses": [
                                            "Variante de jaque."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1a357cb-53cc-49e2-85d6-b140b410dd56",
                                                "sense_id": "b5e20e04-dac0-3270-b2d0-93ec99cea70d",
                                                "text": "En Asie, où le jacque est aussi populaire que la banane et la mangue, le fruit mûr s’apprécie nature ou cuit avec du lait de coco, en nectar, glace, confiture ou fruit confit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
