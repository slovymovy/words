                        "examples": [
                            {
                                "example_id": "e8e7f3c1-c8f4-4b8f-a718-33cc9c4c9e0d",
                                "sense_id": "0634d108-2d33-3b15-8e53-9b3b904651a8",
                                "text": "Der Jäger schoss sich mit seinem Schrotgewehr versehentlich in den linken Fuß."
                            },
                            {
                                "example_id": "afb500c3-80f3-48a5-b711-1b31c90434cf",
                                "sense_id": "0634d108-2d33-3b15-8e53-9b3b904651a8",
                                "text": "„Bei der Waffe soll es sich um ein Schrotgewehr gehandelt haben.“"
                            },
                            {
                                "example_id": "00839169-cd08-4aee-b0bf-0efbd40c8000",
                                "sense_id": "0634d108-2d33-3b15-8e53-9b3b904651a8",
                                "text": "„Im Landkreis Landshut ist ein streng geschützter Jung-Uhu tot gefunden worden - er wurde mit einem Schrotgewehr getötet.“"
                            }
                        ],
