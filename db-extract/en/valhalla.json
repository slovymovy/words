                                        "sense_id": "36302ea8-a725-38bd-a898-cc765df7dbf8",
                                        "entry_id": "bd34fd59-43c7-3dc7-9996-438ae9caf9ab",
                                        "glosses": [
                                            "een speciale hemel in de Noorse mythologie, voorbehouden voor de gesneuvelden in de strijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3025b83-237d-4f18-a8d5-39ebb58afe1a",
                                                "sense_id": "36302ea8-a725-38bd-a898-cc765df7dbf8",
                                                "text": "Wodans dochters, de Walkuren, brengen gevallen strijders naar het Walhalla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
