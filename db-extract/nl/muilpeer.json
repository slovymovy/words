                ],
                "senses": [
                    {
                        "sense_id": "f67c0d7b-44db-3761-83c8-74a763b0f432",
                        "entry_id": "76e1241c-ce21-3341-84c1-7ac2a60d192c",
                        "glosses": [
                            "klap in het gezicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d756abf-b872-4299-a285-8dfa916b1973",
                                "sense_id": "f67c0d7b-44db-3761-83c8-74a763b0f432",
                                "text": "Ik heb hem maar een muilpeer verkocht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f01a5ab-d394-4c31-93aa-dfa0c30b0428",
                        "source_entry_id": "76e1241c-ce21-3341-84c1-7ac2a60d192c",
                        "source_sense_id": "f67c0d7b-44db-3761-83c8-74a763b0f432",
                        "source_sense_description": "klap in het gezicht",
                        "target_lang_word": "Maulschelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maulschelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dca739e5-226e-34dc-8061-89170080bd91",
                                        "entry_id": "7effa66f-6b70-381e-b31f-6baeb0a50e1c",
                                        "glosses": [
                                            "Ohrfeige, ein von der Seite geführter Schlag mit der flachen Hand ins Gesicht einer anderen Person"
                                        ],
                                        "tags": [
                                            "regional umgangssprachlich für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ef332c-64bf-4620-9578-405d1ef05151",
                                                "sense_id": "dca739e5-226e-34dc-8061-89170080bd91",
                                                "text": "Er verpasste ihm eine Maulschelle."
                                            },
                                            {
                                                "example_id": "104fd449-e93a-4169-9466-a85f2388bf38",
                                                "sense_id": "dca739e5-226e-34dc-8061-89170080bd91",
                                                "text": "„Unten angekommen, erhielt er eine Maulschelle und wurde vom Vater bis Sonnenuntergang in die Knechtskammer gesperrt.“"
                                            },
                                            {
                                                "example_id": "b5779178-f98f-4bd3-b1e8-5b39a7c7d01b",
                                                "sense_id": "dca739e5-226e-34dc-8061-89170080bd91",
                                                "text": "„Dagegen waren die Knaben noch klein, so daß ihre Mutter keine Angst hatte, sich mit ihnen abzugeben, aber es verging kaum ein Tag, ohne daß Frau Thuridur ihnen Maulschellen verabreichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29f4d4ad-b299-4be8-b093-55e026892860",
                        "source_entry_id": "76e1241c-ce21-3341-84c1-7ac2a60d192c",
                        "source_sense_id": "f67c0d7b-44db-3761-83c8-74a763b0f432",
                        "source_sense_description": "klap in het gezicht",
                        "target_lang_word": "Ohrfeige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrfeige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                        "entry_id": "6f013902-d317-3ba3-9439-0e8e6dfc2574",
                                        "glosses": [
                                            "ein Schlag mit der flachen Hand ins Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615d6e20-5e2a-4e0b-831c-92d092bfd22c",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "Wegen seiner schlechten Noten verabreichte sein Vater ihm eine Ohrfeige."
                                            },
                                            {
                                                "example_id": "83c9e75c-089d-4dd4-a8f4-4729a2df4fb8",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Die Züchtigung, insbesondere die Ohrfeige, war noch bis in die 1950er Jahre hinein ein legales und probates Mittel an bayerischen Schulen.“"
                                            },
                                            {
                                                "example_id": "b0a838ba-cf8a-4be6-8855-5137de7210bf",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Die Ohrfeige hätte ihre Reize entwertet, und sie prahlte doch damit, daß die Gesellschaft von deren wahrem Wert überzeugt sei.“"
                                            },
                                            {
                                                "example_id": "dbfe9f57-7828-4583-a92b-1bfdc1b50b12",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Er verpaßte mir eine solche Ohrfeige, daß mein Bademantel verrutschte und das Sektglas sich in tausend Splitter auflöste.“"
                                            },
                                            {
                                                "example_id": "f83390d2-b223-4976-b5eb-f185906cde95",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Wir standen mit unseren Uniformen, unseren Mordwaffen und den Ohrfeigen draußen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
