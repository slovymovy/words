                        "examples": [
                            {
                                "example_id": "adf1570f-9fd6-4fc6-9378-9c5a7b82c7c5",
                                "sense_id": "b232f652-8dee-3bc0-b7c0-92a79095f854",
                                "text": "„Die Datierung lieferte auch Belege, dass die Erholung von Pflanzen und Tieren nach dem Asteroideneinschlag eng miteinander verbunden war.“"
                            },
                            {
                                "example_id": "4ce143ee-d093-4806-921e-558a0e1e2f93",
                                "sense_id": "b232f652-8dee-3bc0-b7c0-92a79095f854",
                                "text": "„Eine große Katastrophe wie ein Asteroideneinschlag könnte für viele Lebewesen auf der Erde das Ende bedeuten.“"
                            },
                            {
                                "example_id": "c01c80b5-7551-45ef-9590-ddfb5341b393",
                                "sense_id": "b232f652-8dee-3bc0-b7c0-92a79095f854",
                                "text": "„Was rottete die Dinosaurier aus? Der Asteroideneinschlag von Chicxulub gilt als Hauptverdächtiger.“"
                            }
                        ],
