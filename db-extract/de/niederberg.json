                ],
                "senses": [
                    {
                        "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                        "entry_id": "4f9c26c1-74d0-3a79-b8e0-3f2a3b7b72eb",
                        "glosses": [
                            "ein rechtsrheinischer Höhenstadtteil der Stadt Koblenz (bis 1937 selbständige Gemeinde)"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "20a290d5-ab51-4b99-bfbe-f0b6478feb7b",
                                "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                                "text": "Diejenigen Areale des Stadtteiles Niederberg, auf denen sich das römische Kastell befand, sind als Grabungsschutzgebiet der Stadt Koblenz und als Bestandteil des UNESCO-Weltkulturerbes „Römischer Limes“ ausgewiesen."
                            },
                            {
                                "example_id": "918fb780-5e3a-4581-bba1-9f52552732ec",
                                "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                                "text": "Im Rahmen der Bundesgartenschau 2011 in Koblenz werden große Flächen des Stadtteiles Niederberg in diese Veranstaltung einbezogen."
                            },
                            {
                                "example_id": "773c9e89-5db4-4722-840f-637300f3df1a",
                                "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                                "text": "\"… Gleichzeitig erhielten die Mönche vom Kurfürsten die Seelsorge im Tal Ehrenbreitstein, das noch in die Pfarrei Niederberg gehörte (bis 1707), erneut übertragen, die sie bereits 1636-1640 versehen hatten. …\""
                            },
                            {
                                "example_id": "722ceae3-07c0-4898-a5f9-da9584c8d571",
                                "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                                "text": "„Die Römer bauten beim heutigen Niederberg ein Kastell und im Jahre 49 nach Christus verband eine römische Brücke Ehrenbreitstein mit dem gegenüber liegenden Koblenzer Ufer.“"
                            },
                            {
                                "example_id": "b7c2318b-5db3-43d9-a773-d934b4884e99",
                                "sense_id": "70b9e8f3-5c0d-39df-bae7-6e1cd29181be",
                                "text": "„Ehrenbreitstein hatte von 1836 bis 1937 einen Stadtbürgermeister. Der Stadt waren angeschlossen die Gemeinden Pfaffendorf, Horchheim, Arzheim, Arenberg, Immendorf, Niederberg mit Neudorf und Urbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
