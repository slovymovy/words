                        "examples": [
                            {
                                "example_id": "e73833a3-0c6b-4b21-adc4-835697d27cff",
                                "sense_id": "8e461795-c1b2-3bb6-93ea-8df2256d655e",
                                "text": "Die Klassifizierung von Sprachen nicht hinsichtlich ihrer Verwandtschaft, sondern hinsichtlich der Ähnlichkeiten in ihrem Sprachbau als solchem ist hingegen Gegenstand der Sprachtypologie.",
                                "translation": "Классификация языков не по признаку их родства, а по признаку сходства их языковой структуры как таковой является предметом языковой типологии."
                            }
                        ]
                    }
                ],
