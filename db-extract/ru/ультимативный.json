                                                "sense_id": "ee4c30f9-e463-3daa-9010-7f6f0fa17b5c",
                                                "text": "Ich fordere dich hiermit ultimativ auf, dieses Haus zu verlassen."
                                            },
                                            {
                                                "example_id": "e9583862-1776-420c-bec3-c6f957664d28",
                                                "sense_id": "ee4c30f9-e463-3daa-9010-7f6f0fa17b5c",
                                                "text": "Die Rede des Ministers war gespickt mit ultimativen Forderungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db6af694-ef6e-3abb-9ca4-29a995fc3775",
                                        "entry_id": "b34d0e36-0bd5-3d58-84ab-d7285620dab5",
                                        "glosses": [
                                            "hervorragend passend, dem neuesten Standard entsprechend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af86d9a9-bafb-42c2-b7e1-3f01b71aed9e",
                                                "sense_id": "db6af694-ef6e-3abb-9ca4-29a995fc3775",
                                                "text": "Ja, wir kaufen ein zweites Auto, das ist die ultimative Lösung!"
                                            },
                                            {
                                                "example_id": "366b5afb-ba0f-4243-acac-6da3a5d7f731",
                                                "sense_id": "db6af694-ef6e-3abb-9ca4-29a995fc3775",
                                                "text": "Den ultimativen Computer gibt es nicht, weil jeder andere Anforderungen hat."
                                            },
                                            {
                                                "example_id": "dab3a020-aecd-4d12-a509-92641eb7b2d9",
                                                "sense_id": "db6af694-ef6e-3abb-9ca4-29a995fc3775",
                                                "text": "„Die sogenannten Pistengeher suchen nicht in erster Linie das ultimative Bergerlebnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
