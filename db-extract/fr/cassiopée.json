                                        "examples": [
                                            {
                                                "example_id": "b0c26a0a-5c20-4d4f-a160-2d3cf7655ed4",
                                                "sense_id": "d18a5e25-2c74-3cf3-a0bc-2d168c0f046e",
                                                "text": "Kasjopea chlubiła się, że jest piękniejsza od nereid"
                                            },
                                            {
                                                "example_id": "e1331954-5567-42a2-a9d6-318b7d47b615",
                                                "sense_id": "d18a5e25-2c74-3cf3-a0bc-2d168c0f046e",
                                                "text": "Perseusz pokonał potwora morskiego i uwolnił Andromedę, córkę Kasjopei i Cefeusza."
                                            },
                                            {
                                                "example_id": "16f914fd-0b8d-49df-9a8e-e43be29f300d",
                                                "sense_id": "d18a5e25-2c74-3cf3-a0bc-2d168c0f046e",
                                                "text": "Mityczna Kasjopea jest identyfikowana z gwiazdozbiorem Kasjopei"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "72ed366a-1801-30b1-ac1e-1373a96bbd3b",
                                        "entry_id": "1a20ad81-6560-3462-b296-25aef0da568c",
                                        "glosses": [
                                            "gwiazdozbiór nieba północnego, w Polsce widoczny cały rok; konstelacja, której 5 jasnych gwiazd tworzy charakterystyczny układ w kształcie litery W"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35267592-7858-4ad9-895b-dfd64671bc35",
                                                "sense_id": "72ed366a-1801-30b1-ac1e-1373a96bbd3b",
                                                "text": "Kasjopea widnieje na niebie niedaleko konstelacji, które są z nią mitologicznie powiązane."
