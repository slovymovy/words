                "senses": [
                    {
                        "sense_id": "ac4fa264-656a-3dc0-8403-21de6c9ba023",
                        "entry_id": "d91c6cb8-9cc7-384c-8479-857fc278396a",
                        "glosses": [
                            "geheimes Dokument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd14fa26-9dd0-4166-a7ac-e2bf97e59c76",
                                "sense_id": "ac4fa264-656a-3dc0-8403-21de6c9ba023",
                                "text": "„An meinem Ellbogen liegt ein weiteres, nur für mich bestimmtes, wichtiges Geheimdokument, das ich für Tyler abtippen und kopieren sollte.“"
                            },
                            {
                                "example_id": "f02e41f0-7891-41f5-8542-201d03eaf88b",
                                "sense_id": "ac4fa264-656a-3dc0-8403-21de6c9ba023",
                                "text": "„Damit hatte ich bestimmte Geheimdokumente fotografiert, zu denen ich Zugang hatte, und ich glaubte, dass sie mir vielleicht wieder nützlich sein konnte.“"
                            },
                            {
                                "example_id": "25168816-0495-4ad3-be0c-b7590a14c365",
                                "sense_id": "ac4fa264-656a-3dc0-8403-21de6c9ba023",
                                "text": "„Er warnt die Anführer davor, allesamt Muslime, Geheimdokumente an Kopten weiterzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
