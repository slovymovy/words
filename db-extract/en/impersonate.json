                                    {
                                        "sense_id": "88e5cbfe-8ae2-35ae-8774-7bf7d0c21775",
                                        "entry_id": "4378e449-b07e-31b1-8b50-21f36051512a",
                                        "glosses": [
                                            "eine Rolle in einem Werk der darstellenden Kunst spielen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40058ef-384f-4b8e-bc87-31e7199d5d1f",
                                                "sense_id": "88e5cbfe-8ae2-35ae-8774-7bf7d0c21775",
                                                "text": "„Er verkörpert, ebenso wie Kollege Christoph Waltz, eine[n] bestimmten Typus Mann - Kerle, die ihre raue Seite nach außen kehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00f13eae-a41a-3f75-98aa-38e95ab6baa9",
                                        "entry_id": "4378e449-b07e-31b1-8b50-21f36051512a",
                                        "glosses": [
                                            "als Person zum Ausdruck bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3bf043a-a06a-4b02-ac22-8ab156c040cf",
                                                "sense_id": "00f13eae-a41a-3f75-98aa-38e95ab6baa9",
                                                "text": "„Er verkörpert, ebenso wie Kollege Christoph Waltz, eine[n] bestimmten Typus Mann - Kerle, die ihre raue Seite nach außen kehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fc7f4a9b-08f3-33c8-b77e-664340a2fc8b",
                                        "entry_id": "4378e449-b07e-31b1-8b50-21f36051512a",
                                        "glosses": [
                                            "in (einem Teil) einer Person zum Ausdruck gebracht werden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb23f86-b851-430b-a5fa-9e8bf917547d",
                                                "sense_id": "fc7f4a9b-08f3-33c8-b77e-664340a2fc8b",
                                                "text": "„Roger Fouts zufolge war die Sprache also ursprünglich in der Gestik verkörpert und entwickelte sich aus ihr zusammen mit dem menschlichen Bewusstsein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
