                                "sense_id": "0f955b36-a8e6-3580-b8f8-4ee5d890bc3a",
                                "text": "We have a nice little weekender up in the mountains."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e10d0c1-07da-32b2-9219-60de47582448",
                        "entry_id": "3da15e80-683b-385e-808e-2bd41145b073",
                        "glosses": [
                            "An event that takes place over a weekend."
                        ],
                        "tags": [],
                        "examples": [
