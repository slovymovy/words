                        "glosses": [
                            "licht, eenassig, open, eenspannig rijtuig met grote spaakwielen, door een paard getrokken dat zowel met als zonder vouwkap werd gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506ac3a6-1534-471c-a279-3bafd8c7f354",
                                "sense_id": "40b79ee8-c4b9-3e5f-a10d-7320d24aa7f4",
                                "text": "Dan waren er de tochtjes naar de stad. Meerijden op zijn vaders tilbury zal Heike een feest gevonden hebben."
                            },
                            {
                                "example_id": "26bd28b2-b9c1-47ea-aa78-0e9662e15752",
                                "sense_id": "40b79ee8-c4b9-3e5f-a10d-7320d24aa7f4",
                                "text": "Tilbury's en sjezen zijn nog regelmatig overal in West-Friesland te zien, bijvoorbeeld bij de ringrijderijen."
                            },
                            {
                                "example_id": "7b108286-f121-4472-9936-3709d0b6d4c9",
                                "sense_id": "40b79ee8-c4b9-3e5f-a10d-7320d24aa7f4",
                                "text": "⧖ ‘Ik heb den Jonker Van Zonsveld voorbij zien rijden in zijne tilbury,’ zeide Maria."
                            }
                        ]
