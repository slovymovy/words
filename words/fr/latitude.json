{
    "word_family": [
        "latitudinal",
        "latitudinaire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "873457af-984e-39b2-b433-86b494ae3905",
                    "sense_definition": "Distance angulaire d'un point de la Terre par rapport à l'équateur, mesurée en degrés vers le nord ou le sud.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "géographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navire se trouve actuellement par quarante degrés de <w>latitude</w> nord."
                        },
                        {
                            "text": "Pour localiser précisément cette île sur la carte, il faut connaître sa <w>latitude</w> et sa longitude."
                        }
                    ],
                    "antonyms": [
                        "longitude"
                    ],
                    "common_phrases": [
                        "latitude nord",
                        "latitude sud",
                        "degrés de latitude"
                    ]
                },
                {
                    "sense_id": "f9a8289a-545e-37b3-bdec-8221f94a8bd8",
                    "sense_definition": "Liberté d'action ou marge de manœuvre accordée à quelqu'un dans l'exécution d'une tâche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction lui a laissé toute <w>latitude</w> pour réorganiser le service selon ses méthodes."
                        },
                        {
                            "text": "Les professeurs disposent d'une certaine <w>latitude</w> dans le choix des lectures obligatoires."
                        }
                    ],
                    "synonyms": [
                        "liberté"
                    ],
                    "common_phrases": [
                        "avoir toute latitude",
                        "laisser toute latitude",
                        "grande latitude"
                    ]
                },
                {
                    "sense_id": "8f5b17be-5a10-3077-bf84-2fa142bb7b4c",
                    "sense_definition": "Région du globe terrestre caractérisée par son climat en fonction de sa distance à l'équateur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "géographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les hivers sont particulièrement rudes et longs sous ces <w>latitudes</w> septentrionales."
                        },
                        {
                            "text": "Cette plante tropicale a beaucoup de mal à s'adapter sous nos <w>latitudes</w> tempérées."
                        }
                    ],
                    "synonyms": [
                        "contrée",
                        "région"
                    ],
                    "common_phrases": [
                        "sous nos latitudes",
                        "hautes latitudes",
                        "basses latitudes"
                    ]
                },
                {
                    "sense_id": "62e8276e-eb6d-3e91-8066-f735599f3d57",
                    "sense_definition": "Étendue, ampleur ou largeur donnée à l'application d'une règle, d'une loi ou d'un principe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce texte de loi donne une trop grande <w>latitude</w> à l'interprétation des juges."
                        },
                        {
                            "text": "L'accord signé hier laisse peu de <w>latitude</w> aux négociateurs pour modifier les termes."
                        }
                    ],
                    "synonyms": [
                        "ampleur",
                        "étendue"
                    ],
                    "common_phrases": [
                        "donner de la latitude"
                    ]
                },
                {
                    "sense_id": "cea55913-25b8-3d77-abff-347207f35a7a",
                    "sense_definition": "Distance angulaire d'un astre par rapport au plan de l'écliptique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'astronome a soigneusement mesuré la <w>latitude</w> écliptique de cette planète lointaine."
                        },
                        {
                            "text": "La trajectoire observée dépend directement de la <w>latitude</w> céleste calculée lors du passage."
                        }
                    ],
                    "common_phrases": [
                        "latitude écliptique",
                        "latitude géocentrique",
                        "latitude héliocentrique"
                    ]
                }
            ]
        }
    ]
}