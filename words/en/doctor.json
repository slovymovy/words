{
    "word_family": [
        "doctorate",
        "doctoral",
        "doctress",
        "doctorly",
        "doctor-fish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9e110ed-2d55-3d28-bd6a-951005f47a28",
                    "sense_definition": "A medical professional who is trained and licensed to treat people who are ill or injured.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "medical_practitioner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you still feel unwell tomorrow, you should go see your <w>doctor</w>.",
                            "target_lang_translations": {
                                "ru": "Если завтра вы все еще будете плохо себя чувствовать, вам следует обратиться к <w>врачу</w>."
                            }
                        },
                        {
                            "text": "The <w>family</w> <w>doctor</w> visited the house to check on the sick child.",
                            "target_lang_translations": {
                                "ru": "<w>Семейный</w> <w>врач</w> пришел домой, чтобы осмотреть больного ребенка."
                            }
                        }
                    ],
                    "synonyms": [
                        "physician",
                        "doc",
                        "family doctor",
                        "general practitioner",
                        "GP",
                        "medic"
                    ],
                    "common_phrases": [
                        "family doctor",
                        "see a doctor",
                        "call a doctor",
                        "medical doctor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский работник, имеющий образование и лицензию на лечение больных или травмированных людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врач",
                                "target_lang_sense_clarification": "специалист с высшим медицинским образованием"
                            },
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "разговорное обозначение врача"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef39560-fd3c-3c40-8281-4c1960590953",
                    "sense_definition": "A person who has earned the highest university degree, such as a Ph.D.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>doctor</w> of philosophy and teaches at the local university.",
                            "target_lang_translations": {
                                "ru": "Она — <w>доктор</w> философии и преподает в местном университете."
                            }
                        },
                        {
                            "text": "After years of research, he finally became a <w>doctor</w> in his field.",
                            "target_lang_translations": {
                                "ru": "После многих лет исследований он наконец стал <w>доктором</w> наук в своей области."
                            }
                        }
                    ],
                    "common_phrases": [
                        "doctor of philosophy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, получившее высшую университетскую степень, например, кандидат или доктор наук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "учёная степень"
                            },
                            {
                                "target_lang_word": "доктор наук",
                                "target_lang_sense_clarification": "высшая учёная степень в РФ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7a9f674-56f5-3258-a3f4-9bcef4b9ed67",
                    "sense_definition": "A medical practitioner who treats animals rather than humans.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_practitioner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took our dog to the <w>doctor</w> because he was not eating his food.",
                            "target_lang_translations": {
                                "ru": "Мы отвели собаку к <w>ветеринару</w>, потому что она ничего не ела."
                            }
                        },
                        {
                            "text": "The <w>veterinary</w> <w>surgeon</w> is the best <w>doctor</w> for your horse's injury.",
                            "target_lang_translations": {
                                "ru": "Ветеринарный хирург — лучший <w>врач</w> для лечения травмы вашей лошади."
                            }
                        }
                    ],
                    "synonyms": [
                        "vet",
                        "veterinarian",
                        "veterinary",
                        "veterinary surgeon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский работник, который лечит животных, а не людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветеринар",
                                "target_lang_sense_clarification": "врач для животных"
                            },
                            {
                                "target_lang_word": "ветеринарный врач",
                                "target_lang_sense_clarification": "официальное название профессии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abab7140-2d72-3c88-ae99-198e1ac6e338",
                    "sense_definition": "A traditional nickname for a cook on a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew called the ship's cook the <w>doctor</w> as he prepared their daily meals.",
                            "target_lang_translations": {
                                "ru": "Экипаж называл судового кока <w>доком</w>, пока тот готовил им ежедневную еду."
                            }
                        },
                        {
                            "text": "In many old maritime stories, the <w>doctor</w> is the one in charge of the galley.",
                            "target_lang_translations": {
                                "ru": "Во многих старых морских историях <w>док</w> — это тот, кто заведует камбузом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Nautical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное прозвище кока на корабле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "док",
                                "target_lang_sense_clarification": "морской жаргон, прозвище кока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82bed945-a580-33bd-a21a-1abe3af11082",
                    "sense_definition": "A mechanical device or auxiliary engine used to solve a specific technical problem or emergency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician used a disk <w>doctor</w> to recover the files after the system crashed.",
                            "target_lang_translations": {
                                "ru": "Техник использовал программу «disk <w>doctor</w>» для восстановления файлов после сбоя системы."
                            }
                        },
                        {
                            "text": "The auxiliary engine, often called a <w>doctor</w>, kept the pumps running during the power failure.",
                            "target_lang_translations": {
                                "ru": "Вспомогательный двигатель, часто называемый <w>доктором</w>, поддерживал работу насосов во время отключения электроэнергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disk doctor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство или вспомогательный двигатель, используемый для решения конкретной технической проблемы или в аварийной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспомогательный механизм",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "технический термин для вспомогательного насоса или двигателя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78191700-b340-3fee-826e-76e28b148954",
                    "sense_definition": "The title used before the name of a person who holds a doctorate or medical degree.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "academic_title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "The students waited in the hallway to speak with <w>Doctor</w> Jones.",
                            "target_lang_translations": {
                                "ru": "Студенты ждали в коридоре, чтобы поговорить с <w>доктором</w> Джонсом."
                            }
                        },
                        {
                            "text": "Excuse me, <w>Doctor</w>, do you have a moment to discuss the test results?",
                            "target_lang_translations": {
                                "ru": "Простите, <w>доктор</w>, у вас есть минутка, чтобы обсудить результаты анализов?"
                            }
                        }
                    ],
                    "synonyms": [
                        "Dr",
                        "Dr."
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый перед именем человека, имеющего докторскую или медицинскую степень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доктор",
                                "target_lang_sense_clarification": "обращение или титул перед фамилией"
                            },
                            {
                                "target_lang_word": "д-р",
                                "target_lang_sense_clarification": "сокращение титула"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dea2afae-1a12-3289-95b2-dcf766733847",
                    "sense_definition": "To change or manipulate something, such as a document or image, in order to deceive people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant was caught trying to <w>doctor</w> the financial records to hide the theft.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер был пойман на попытке <w>подделать</w> финансовую отчетность, чтобы скрыть кражу."
                            }
                        },
                        {
                            "text": "It was obvious that someone had tried to <w>doctor</w> the photo to make it look real.",
                            "target_lang_translations": {
                                "ru": "Было очевидно, что кто-то пытался <w>сфальсифицировать</w> фотографию, чтобы она выглядела настоящей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "doctor the evidence",
                        "doctor the books"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять или манипулировать чем-либо, например документом или изображением, с целью введения людей в заблуждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделывать",
                                "target_lang_sense_clarification": "изменять документы с целью обмана"
                            },
                            {
                                "target_lang_word": "фальсифицировать",
                                "target_lang_sense_clarification": "искажать данные или факты"
                            },
                            {
                                "target_lang_word": "подчищать",
                                "target_lang_sense_clarification": "вносить правки в отчетность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb477c9f-1b03-3b53-9179-27aa396e8b78",
                    "sense_definition": "To add a harmful substance, such as a drug or poison, to food or drink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy managed to <w>doctor</w> the drink with a powerful sedative.",
                            "target_lang_translations": {
                                "ru": "Шпиону удалось <w>подмешать</w> в напиток сильное успокоительное."
                            }
                        },
                        {
                            "text": "He realized too late that someone had tried to <w>doctor</w> his coffee.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что кто-то пытался что-то <w>подсыпать</w> в его кофе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "doctor a drink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять вредное вещество, например наркотик или яд, в еду или питье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмешивать",
                                "target_lang_sense_clarification": "добавлять что-то вредное в напиток или еду"
                            },
                            {
                                "target_lang_word": "отравлять",
                                "target_lang_sense_clarification": "добавлять яд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22d7317e-5eff-32cd-87a3-c70650cccac1",
                    "sense_definition": "To provide medical treatment to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole week trying to <w>doctor</w> her sick children back to health.",
                            "target_lang_translations": {
                                "ru": "Она всю неделю пыталась <w>вылечить</w> своих больных детей."
                            }
                        },
                        {
                            "text": "The medics had to <w>doctor</w> the wounded soldiers right there on the field.",
                            "target_lang_translations": {
                                "ru": "Медикам пришлось <w>оказывать помощь</w> раненым солдатам прямо на поле боя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать медицинскую помощь кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечить",
                                "target_lang_sense_clarification": "оказывать медицинскую помощь"
                            },
                            {
                                "target_lang_word": "врачевать",
                                "target_lang_sense_clarification": "книжный или устаревший вариант слова лечить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}