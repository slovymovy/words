                    {
                        "sense_id": "f0b38b47-bfe5-3c53-a657-48538670e68b",
                        "entry_id": "697f2083-04c6-3f8e-b6f3-6ba0117b1e4d",
                        "glosses": [
                            "short neuter singular of далёкий (daljókij)"
                        ],
                        "tags": [
                            "form-of",
                            "neuter",
