                    },
                    {
                        "translation_id": "e33130b3-7850-4e29-a465-61c77911a5d7",
                        "source_entry_id": "8ed18639-0029-339e-8e82-15d1ec888787",
                        "source_sense_id": "a4ef1ca2-d6b7-3ec5-a116-0129691b65fc",
