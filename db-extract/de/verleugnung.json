                "senses": [
                    {
                        "sense_id": "58c6cb9a-8b62-3d2a-a142-f689656d88b7",
                        "entry_id": "6dc0daec-6c0e-3b62-9bb5-e8e1b6e1db13",
                        "glosses": [
                            "Handlung/Aussage, die darin besteht, etwas Zutreffendes in Abrede zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1b3fdf-8c7e-4c81-8f17-b98297d577e2",
                                "sense_id": "58c6cb9a-8b62-3d2a-a142-f689656d88b7",
                                "text": "„Welch dreiste Verleugnung der Realität, die Mussa vor ihm so deutlich beim Namen genannt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93c0d407-d8ac-4e3a-84be-2520f446bca7",
                        "source_entry_id": "6dc0daec-6c0e-3b62-9bb5-e8e1b6e1db13",
                        "source_sense_id": "58c6cb9a-8b62-3d2a-a142-f689656d88b7",
                        "source_sense_description": "Handlung/Aussage, die darin besteht, etwas Zutreffendes in Abrede zu stellen",
                        "target_lang_word": "denial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5655792-40fc-3a38-bc7c-616ade3d4b96",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "An assertion of untruth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d960000-6a55-4e4b-af12-c2238c2dcb65",
                                                "sense_id": "c5655792-40fc-3a38-bc7c-616ade3d4b96",
                                                "text": "The singer has issued a sweeping denial of all the rumors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b59c881-ecec-3d96-8edf-4b0ef7d90a36",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "The negation in logic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effae584-9acc-447b-b8b2-8a593b4f495b",
                                                "sense_id": "4b59c881-ecec-3d96-8edf-4b0ef7d90a36",
                                                "text": "The denial of \"There might be X\" is the null, \"False, there is no X.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A refusal or failure to provide or grant something that is requested or desired."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9c4c4b-bf05-45c8-afa4-62ab79bae3dd",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "The denial of medical treatment to those who cannot afford to pay is scandalous."
                                            },
                                            {
                                                "example_id": "e895fc30-e00c-48cd-ae30-759fdae735fe",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "I cannot understand the bank's denial of my loan application."
                                            },
                                            {
                                                "example_id": "4848e4de-69c5-4149-b129-c765d0c553cf",
                                                "sense_id": "f509c554-63c3-396d-b724-2c70c1c4ffab",
                                                "text": "Every time we asked for an interview we got a denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Refusal to believe that a problem exists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e31feb7-f07e-45b5-9847-958edd9789d2",
                                                "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                                "text": "We couldn't break through his denial about being alcoholic."
                                            },
                                            {
                                                "example_id": "253ca942-1ebd-4259-8b69-2ca39649c1a7",
                                                "sense_id": "f26fa6cf-7d1f-31c9-9fad-1eec8682af6c",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c3a5a2-f856-383f-b35b-612e1b5c3826",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Refusal to admit responsibility for wrongdoing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80fedd95-65c9-4d8b-9f34-9419e8c75d17",
                                                "sense_id": "44c3a5a2-f856-383f-b35b-612e1b5c3826",
                                                "text": "Denial is the first act when the perpetrator refutes the very nature of the planned measures, explaining the steps as justified and legitimate actions to cope with the identified problem. The denial then lives on during the different stages of the genocide and is invoked continuously by the perpetrator whenever its actions are criticized or labeled as atrocities and unlawful. At the end, once the practical stages have had their course, all that remains and thrives is the denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "Negationism, denialism of historical facts or accepted interpretation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe43ce8d-d090-4703-8ed0-e412047b226e",
                                                "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                                "text": "However, just as genocide is understood by some—including Raphael Lemkin—as a kind of radical, perverse act of creation, so too, denial does not aim only at a negation of reality but also at the creation of a new reality."
                                            },
                                            {
                                                "example_id": "a0ef3812-2b64-4ab9-9676-cc314a738523",
                                                "sense_id": "a0ce3708-e398-3d73-8968-34452aed4419",
                                                "text": "The sheer length of the list demonstrates the hold denial wields over states and societies, a power that may be best understood empirically by delving further into the two best-documented cases of Holocaust and Armenian [genocide] denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A defense mechanism involving a refusal to accept the truth of a phenomenon or prospect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c422ad-5bbc-4e3f-b0e4-efda297adc3a",
                                                "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                                "text": "He is in denial that he has a drinking problem."
                                            },
                                            {
                                                "example_id": "f18fdbdb-8c55-4edb-b271-67b16a46c35f",
                                                "sense_id": "481b4f7e-2b15-3cf2-a555-9a6984891b52",
                                                "text": "\"Denial\" came out of the therapyspeak prevalent in the middle of the 20th century, especially as it was applied to confronting the reality of mortality. It was popularized as the first stage of grief, and quickly expanded to include refusal to confront any bad news or disturbing ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c167f6-d0e9-395e-a1d9-f5947971e418",
                                        "entry_id": "cdf3cdee-e222-3309-a95f-548e2ec5612e",
                                        "glosses": [
                                            "A disownment or disavowal"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d8a697-0ec4-4a4c-8d97-34b66aee9b87",
                                                "sense_id": "20c167f6-d0e9-395e-a1d9-f5947971e418",
                                                "text": "The denial of Jesus by Peter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
