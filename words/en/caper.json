                                "target_lang_word": "podskok",
                                "target_lang_sense_clarification": "energiczny ruch w górę"
                            },
                            {
                                "target_lang_word": "skok",
                                "target_lang_sense_clarification": "ruch wykonywany w zabawie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "924790b9-6720-3de0-83ce-0f62f8a617ab",
                    "sense_definition": "To jump or move about in a lively, playful way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children began to <w>caper</w> around the room when they heard the music.",
                            "target_lang_translations": {
                                "pl": "Dzieci zaczęły <w>brykać</w> po pokoju, gdy usłyszały muzykę."
                            }
                        },
                        {
                            "text": "We watched the kittens <w>caper</w> through the tall grass in the backyard.",
                            "target_lang_translations": {
