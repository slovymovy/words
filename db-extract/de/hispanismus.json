                            {
                                "target_word": "Hispanicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7baf51-060d-3f98-9996-a71e23f42be7",
                                        "entry_id": "03e156f1-4a4a-3514-b6e5-d39d9fbf2f7c",
                                        "glosses": [
                                            "A Spanish-language item as it appears in another language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b65f8176-6dbc-32fe-a3cb-5efa95738f49",
                                        "entry_id": "03e156f1-4a4a-3514-b6e5-d39d9fbf2f7c",
                                        "glosses": [
                                            "Support for hegemony of Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b34180f-29b1-4425-9baa-e28d65bf7add",
                                                "sense_id": "b65f8176-6dbc-32fe-a3cb-5efa95738f49",
                                                "text": "More recently there has burst forth an enthusiastic Hispanicism, no longer the Hispanicism of Columbus Day with its odes to the great navigator, nor the Hispanicism of the bull fighters and the cabaret singers, but a historical Hispanicism […]"
                                            },
                                            {
                                                "example_id": "e52879e1-77aa-4082-ac38-c10b8130761a",
                                                "sense_id": "b65f8176-6dbc-32fe-a3cb-5efa95738f49",
                                                "text": "One French writer argued that Hispanicism was a proper response to U.S. expansionism, provided Spain could assure its sister Latin states in Europe (France and Italy) that their interests were not endangered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
