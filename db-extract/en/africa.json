                                                "example_id": "edeecc45-e8c0-49e0-a2da-a142642ad4fa",
                                                "sense_id": "71dd1fc1-5a28-33ce-b542-b2f7f8ec713f",
                                                "text": "L'Africa è anche un grande produttore di cacao"
                                            }
