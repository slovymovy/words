                                        "entry_id": "d86f450e-a1ca-388f-8fc6-b5c5df0d1c42",
                                        "glosses": [
                                            "Ancienne commune luxembourgeoise intégrée à Wincrange en 1978."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95013368-0b5d-4a72-841d-9eb0dc2f315e",
                                                "sense_id": "c6aa2e4b-aa91-3403-9023-2b167957fe55",
                                                "text": "Les communes de Asselborn, Bœvange/Clervaux, Hachiville et Oberwampach sont fusionnées en une nouvelle commune qui porte la dénomination de «Commune de Wincrange»."
                                            }
