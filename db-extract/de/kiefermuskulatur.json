                "senses": [
                    {
                        "sense_id": "32eeae58-d3a6-30f8-9249-e3fd60624058",
                        "entry_id": "c9882896-cdca-3c4a-b5f1-92d1458784d2",
                        "glosses": [
                            "Gesamtheit der Muskeln im Kiefer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d307b347-a756-4881-b303-ddacbbe64f2b",
                                "sense_id": "32eeae58-d3a6-30f8-9249-e3fd60624058",
                                "text": "„Er schloss die Augen und spannte die Kiefermuskulatur an, als der Knüppel auch schon auf seinen Hinterkopf knallte.“"
                            },
                            {
                                "example_id": "2665db57-cb85-4133-94f6-103e653e2e97",
                                "sense_id": "32eeae58-d3a6-30f8-9249-e3fd60624058",
                                "text": "„Dann sah er, wie sich Colins angespannte Kiefermuskulatur weiter verkrampfte.“"
                            },
                            {
                                "example_id": "209bef57-780c-46e3-bd21-42e853cd3961",
                                "sense_id": "32eeae58-d3a6-30f8-9249-e3fd60624058",
                                "text": "„Sein sorgsam gepflegter grauer Bart konnte nicht verbergen, wie fest seine Kiefermuskulatur angespannt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
