                    {
                        "sense_id": "41321a53-33f1-37d9-a4f5-98a113816044",
                        "entry_id": "b98aa866-8016-3cd3-8cbb-bf783745dd57",
                        "glosses": [
                            "Pilote (femme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5e1a52-876a-456e-956f-e1fcc76610bc",
                                "sense_id": "41321a53-33f1-37d9-a4f5-98a113816044",
                                "text": "Pilotinnen und Piloten erklären den Reisenden auf Rollfeldern in Frankfurt, Zürich oder Wien, man müsse auf einen Slot, ein Zeitfenster für den Start, warten, weil der griechische Luftraum überlastet sei.",
                                "translation": "Sur les tarmacs de Francfort, Zurich ou Vienne, les pilotes expliquent aux voyageurs qu'il faut attendre un créneau horaire pour le décollage, car l’espace aérien grec est saturé."
                            }
                        ]
                    }
                ],
