                ],
                "senses": [
                    {
                        "sense_id": "5d601bb9-fbed-3b8a-af20-3b55e2e406b9",
                        "entry_id": "891ccf19-478b-37a0-bf53-7b6159025e5f",
                        "glosses": [
                            "veraltet (19. Jahrhundert) für Extremismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f224bed7-6707-4404-a97c-4751d6752e7f",
                                "sense_id": "5d601bb9-fbed-3b8a-af20-3b55e2e406b9",
                                "text": "Die deutsche Vormärzliberalen sprachen […] oft von den „Ultras“ beider Seiten. Deren Gemeinsamkeit wurde mit der superlativischen Wendung „Ultraismus“ auf den Begriff gebracht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "74889d47-2ffa-3cc3-a73d-8d0f05528c25",
                        "entry_id": "891ccf19-478b-37a0-bf53-7b6159025e5f",
                        "glosses": [
                            "spanische Kunstrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8583a2c2-b2a6-42ce-b8d6-431fa3e84676",
                                "sense_id": "74889d47-2ffa-3cc3-a73d-8d0f05528c25",
                                "text": "Das beweist er an den Gewaltphantasien und -manifesten des Futurismus, des Dadaismus, des Surrealismus und erstmals auch an denen des spanischen Ultraismus und des englischen Vortizismus. - (Die Welt, zitiert nach Wortschatz-Lexikon)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e16dbcf7-bfa6-41dc-8994-fa0e4d9cc171",
                        "source_entry_id": "891ccf19-478b-37a0-bf53-7b6159025e5f",
                        "source_sense_id": "5d601bb9-fbed-3b8a-af20-3b55e2e406b9",
                        "target_lang_word": "ultraism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                                        "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                                        "glosses": [
                                            "Radicalism or political extremism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8faf55fd-9a8f-4a26-aa1e-41cb642b63c0",
                                                "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                                                "text": "We glory in such ultraism—the ultraism which says that “all men are created equal—[…]the ultraism which treats man as an intelligent and immortal being, and not as an article of merchandize and traffic—[…]"
                                            },
                                            {
                                                "example_id": "2b2b9cd2-d57f-4374-82e8-79244507ee2b",
                                                "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                                                "text": "With all that tendency to ultraism said to prevail at present, it may be doubted whether evangelists might not even now be found who, though in health, would require no such license for such a liberty; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bede0c8-ab1c-31e4-9c06-362d99efca20",
                                        "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                                        "glosses": [
                                            "A Spanish poetic movement opposed to modernism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108feebc-06fd-433b-ba0b-09838d87b1a5",
                                                "sense_id": "8bede0c8-ab1c-31e4-9c06-362d99efca20",
                                                "text": "The eight young signers of this “Ultra manifesto” could not have known at the time how accurate and prescient their declaration was. Spanish ultraism, born as a movement with that document, would be distinguished, ironically, by its indiscriminate and eclectic borrowings from the other European vanguard tendencies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
