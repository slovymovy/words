                "senses": [
                    {
                        "sense_id": "b4734dea-93cf-3c0c-b3cb-e19da70cbbd1",
                        "entry_id": "d999edcd-09f0-3e9d-a698-914bfd763d16",
                        "glosses": [
                            "Se libérer d’un béguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1130f44-e380-4a05-83c1-72598c282f2a",
                                "sense_id": "b4734dea-93cf-3c0c-b3cb-e19da70cbbd1",
                                "text": "À peine Rizzio a-t-il mis le pied au palais qu’on voit la petite cour d’Holyrood se désembéguiner de sa morosité ordinaire et rabattre subitement le collet si haut monté de sa pruderie protestante."
                            },
                            {
                                "example_id": "9a6edf7b-7713-445c-bc70-8464d697fe02",
                                "sense_id": "b4734dea-93cf-3c0c-b3cb-e19da70cbbd1",
                                "text": "Je tiens à ce que chacun emporte un souvenir de la méthode Vologda pour éducation de demoiselles nobles, afin de vous désembéguiner de votre Maintenon, cette institutrice reine de France."
                            },
                            {
                                "example_id": "e239661f-4ce2-45c1-a3b5-61e9c14b3701",
                                "sense_id": "b4734dea-93cf-3c0c-b3cb-e19da70cbbd1",
                                "text": "Juliette a un fier béguin pour lui; mais, la pauvre, comme on dit dans le Midi, elle devrait se désembéguiner."
                            }
                        ]
                    }
                ],
