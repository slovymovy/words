                "entry_id": "ad7ec723-a86f-32b5-97ba-6f92f1e690f8",
                "word": "hopend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f0dbc87d-2a1e-3fea-9e7b-3818bf35c7ed",
                        "entry_id": "ad7ec723-a86f-32b5-97ba-6f92f1e690f8",
                        "glosses": [
                            "denkend dat iets wel goed zal komen zonder dat men dat zeker weet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd6ec3a-9908-4eea-9424-f28b8cc27956",
                                "sense_id": "f0dbc87d-2a1e-3fea-9e7b-3818bf35c7ed",
                                "text": "Een leerling had tijdens de les handboeien om gekregen van de juf als demonstratie. Later bleek het sleuteltje echter nergens te bekennen. Het bleken oude politiehandboeien te zijn. Met een hoofd als een boei belde de juf het alarmnummer, hopende op een sleutel."
                            },
                            {
                                "example_id": "2de0a9b8-8da6-4965-8f55-f1ed35240f23",
                                "sense_id": "f0dbc87d-2a1e-3fea-9e7b-3818bf35c7ed",
                                "text": "De eerste nacht konden ze bij de marine logeren en de tweede dag zijn ze naar het Franse gedeelte gelopen, hopende dat ze daar verder geholpen zouden worden."
                            }
                        ]
                    }
