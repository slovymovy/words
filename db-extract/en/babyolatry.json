                "senses": [
                    {
                        "sense_id": "9850290a-5ac5-35b9-bc18-199d6f16367b",
                        "entry_id": "01964b48-eb76-3001-9310-d63ce89a3341",
                        "glosses": [
                            "An obsession with babies or infants"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9cc08cc6-a844-4daa-822b-22f46d92c7a3",
                                "sense_id": "9850290a-5ac5-35b9-bc18-199d6f16367b",
                                "text": "I must say I prefer living breathing parents who communicate with their children, whatever the quality of the message delivered, to parents who have been converted to the stupid and harmful religion of babyolatry!"
                            },
                            {
                                "example_id": "20e7e248-b457-4263-afe0-5fa1d3008174",
                                "sense_id": "9850290a-5ac5-35b9-bc18-199d6f16367b",
                                "text": "There will be as there must be much baby talk in the nurseries of a people so far gone in “babyolatry” as are we Americans."
                            },
                            {
                                "example_id": "17292f8b-06e6-47c3-8ed8-91348955b50d",
                                "sense_id": "9850290a-5ac5-35b9-bc18-199d6f16367b",
                                "text": "To take one small example, Swinburne's famous celebration of Marian's baby in Aurora Leigh (mentioned on p. 141) stems not so much from a contemporary 'glorification' of maternity as his own much-documented and idiosyncratic 'babyolatry'."
                            }
                        ]
                    }
