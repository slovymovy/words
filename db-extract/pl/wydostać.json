                                "sense_id": "99f04c65-9e50-3513-be1f-d87572b559a8",
                                "text": "Dziecko wydostało lalkę spod łóżka.",
                                "translation": "The child took the doll from under the bed.",
                                "english": "The child took the doll from under the bed."
                            }
                        ]
