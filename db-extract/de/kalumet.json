                    {
                        "sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                        "entry_id": "04ab47d0-f6b6-3726-9c2d-034b3bb783d4",
                        "glosses": [
                            "verzierte Pfeife der Indianer, die anlässlich von Friedensschlüssen und Verträgen geraucht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208445fb-ff90-42e9-a043-ffa7c11f812e",
                                "sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                                "text": "Sie rauchten das Kalumet zum Zeichen des Friedensvertrages der Stämme."
                            },
                            {
                                "example_id": "9f009922-26e4-40ac-964d-0e084120b3f5",
                                "sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                                "text": "„Und last but not least essen die Eichsfelder - ähnlich wie die Sioux, die zum Abschluss ihrer Verhandlungen das Kalumet rauchen - zur Bekräftigung ihrer innerfamiliären Beschlüsse Unmengen von Feldgiekern und Stracke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d14dc648-b435-4315-a4d2-34cbcb60e831",
                        "source_entry_id": "04ab47d0-f6b6-3726-9c2d-034b3bb783d4",
                        "source_sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                        "source_sense_description": "verzierte Pfeife der Indianer, die anlässlich von Friedensschlüssen und Verträgen geraucht wurde",
                        "target_lang_word": "calumet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calumet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a81b3dd0-6887-3d72-b34c-ddf204ae9e20",
                                        "entry_id": "cd7304c6-d875-36db-b521-e63322204bbd",
                                        "glosses": [
                                            "A clay tobacco pipe used by Native Americans, especially as a symbol of truce or peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c4c918-4ae6-4c80-a4ea-bb7498e361fa",
                                                "sense_id": "a81b3dd0-6887-3d72-b34c-ddf204ae9e20",
                                                "text": "THE CALUMET OF PEACE. He offered a cigarette to the professor and took one himself."
                                            },
                                            {
                                                "example_id": "392c3a01-a243-46ec-842f-05273986ceaa",
                                                "sense_id": "a81b3dd0-6887-3d72-b34c-ddf204ae9e20",
                                                "text": "When the chief has directed them to approach, they advance; those who have the calumets, chant and dance with much agility, now turning around each other, and now presenting themselves in front, but always with violent movements and extraordinary contortions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c252986-9579-45c8-a15d-d6a32ac2ad10",
                        "source_entry_id": "04ab47d0-f6b6-3726-9c2d-034b3bb783d4",
                        "source_sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                        "source_sense_description": "verzierte Pfeife der Indianer, die anlässlich von Friedensschlüssen und Verträgen geraucht wurde",
                        "target_lang_word": "peace pipe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peace pipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d332ce0-9fde-358b-add4-6665138fc2a9",
                                        "entry_id": "627604dd-c6b1-3b67-93cf-898023eb436c",
                                        "glosses": [
                                            "A tobacco pipe smoked ceremonially in certain Native American cultures that symbolizes peace among those who smoke it, and among whom it is passed around from person to person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0753516d-6a22-4115-8a89-c38631911bcc",
                                                "sense_id": "8d332ce0-9fde-358b-add4-6665138fc2a9",
                                                "text": "to smoke the peace pipe"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02045a9d-1833-4c78-8d7a-db5a446e40fa",
                        "source_entry_id": "04ab47d0-f6b6-3726-9c2d-034b3bb783d4",
                        "source_sense_id": "70b7381c-f3fb-3b2b-b2b1-5c63222c5bfb",
                        "source_sense_description": "verzierte Pfeife der Indianer, die anlässlich von Friedensschlüssen und Verträgen geraucht wurde",
                        "target_lang_word": "calumet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calumet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93b8f6c0-5c98-318e-a9a4-dd3f3c46284d",
                                        "entry_id": "60cffc7b-877b-3828-ae7b-10259b789f76",
                                        "glosses": [
                                            "Pipe fumée par les Nord-Amérindiens, en particulier rituellement lors de certaines cérémonies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2acd5387-da6e-4421-b5f2-352e9dd27926",
                                                "sense_id": "93b8f6c0-5c98-318e-a9a4-dd3f3c46284d",
                                                "text": "Noz Sauvages font aussi grand labourage de Petun, chose tres pretieuse entre eux, et parmi tous ces peuples universellement. C'est une plante […] dont ils sucent la fumée avec un tuyau […] un calumet ou petunoir, qui est un cornet troué par le côté, et dans le trou ils fichent un long tuyau duquel ils tirent la fumée du petun qui est dans ledit cornet, après qu'ils l'ont allumé avec du charbon qu'ils mettent dessus."
                                            },
                                            {
                                                "example_id": "f27e426c-f6f9-4da5-b19a-2f27956b674d",
                                                "sense_id": "93b8f6c0-5c98-318e-a9a4-dd3f3c46284d",
                                                "text": "Le grand chef est assis au milieu d’eux, tenant à la main le calumet de paix à demi coloré pour la guerre."
                                            },
                                            {
                                                "example_id": "d411957b-4d03-4f35-b57d-a544eb6f5c96",
                                                "sense_id": "93b8f6c0-5c98-318e-a9a4-dd3f3c46284d",
                                                "text": "Caballero ! répondit évasivement le trappeur, vous savez ce que disent les Peaux-Rouges : entre chaque mot fume ton calumet, afin de bien peser tes paroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4276b5dc-4db3-3783-9943-b033eb9edd1c",
                                        "entry_id": "60cffc7b-877b-3828-ae7b-10259b789f76",
                                        "glosses": [
                                            "Symbole de paix."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc81aec-9976-4fe8-ba78-0817036e5ccf",
                                                "sense_id": "4276b5dc-4db3-3783-9943-b033eb9edd1c",
                                                "text": "Il nous offrit le calumet de la paix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7c64ec-43f1-399c-a4e6-1e47c337b426",
                                        "entry_id": "60cffc7b-877b-3828-ae7b-10259b789f76",
                                        "glosses": [
                                            "En Amérique, plante dont les tiges servent à faire des tuyaux de pipe."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d6f6bf9-8f3b-4130-a51c-afec012ec305",
                                                "sense_id": "7d7c64ec-43f1-399c-a4e6-1e47c337b426",
                                                "text": "Quoi qu’il en soit, ce nom de calumet, donné par d’ignorants créoles au nastus des botanistes, lui vient de ce qu’on fait des tuyaux de pipe avec les parties les plus déliées de l’extrémité de sa tige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c573d32-7117-34bb-b7a7-a2c31ba7567a",
                                        "entry_id": "60cffc7b-877b-3828-ae7b-10259b789f76",
                                        "glosses": [
                                            "Tuyau, paille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56d6949-3f70-4228-b2b0-d56915bf7f33",
                                                "sense_id": "1c573d32-7117-34bb-b7a7-a2c31ba7567a",
                                                "text": "Les matelots avaient tout [le rhum] bu à l'aide de calumets de paille ou de giggers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
