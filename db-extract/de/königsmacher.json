                    {
                        "translation_id": "5a58d248-cc21-47f8-9efb-1a47639abe5e",
                        "source_entry_id": "647e46d3-fb54-3f5f-82ca-a8bac1cfc8f1",
                        "source_sense_id": "afdee57b-c195-3e5f-b70a-e8434f998e20",
                        "source_sense_description": "Person oder Gruppe, die in der Lage ist, eine Person zum König zu machen/ihr in ein hohes Amt zu helfen",
                        "target_lang_word": "kingmaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kingmaker",
