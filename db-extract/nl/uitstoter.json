                        "entry_id": "f316ca16-5a5c-3b74-bca9-c96fcd27e4e5",
                        "glosses": [
                            "iets of iemand die bepaalde afvalstoffen in het milieu brengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e703548-285b-42a3-ba25-4606d1f1c1e2",
                                "sense_id": "cf39cbf9-393f-3d67-a80f-a65bc289e8b5",
                                "text": "China is de grootste uitstoter van broeikasgassen ter wereld. Tot dusver pleitte het vooral voor vrijwillige afspraken."
                            },
                            {
                                "example_id": "6794a406-0d44-47b3-bda7-41b0b1f12888",
                                "sense_id": "cf39cbf9-393f-3d67-a80f-a65bc289e8b5",
                                "text": "Ook medische apparatuur moet in de toekomst zo veel mogelijk kwikloos en de uitstoot door onder meer cementfabrieken en de metaalindustrie wordt teruggedrongen. Zuidoost-Azië is de grootste uitstoter, door de snelle industrialisatie in die regio. De Europese Unie was de grootste exporteur van kwik, maar die uitvoer is al enkele jaren geleden verboden."
                            }
                        ]
                    }
