                        "glosses": [
                            "obramowanie, obwódka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd35059-2525-4343-bff8-4b8c3e1c22fe",
                                "sense_id": "ef1c8f77-c2a2-3974-939f-9c7ef6df509c",
                                "text": "Nad drzwiami weselnymi ogromny obraz Matki Boskiej Ostrobramskiej z jej sukienką srebrną i złotym otokiem promieni na tle głębokiego szafiru"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1325a970-8614-3325-a00d-7f6669ac7db7",
                        "entry_id": "d730dcff-4a2c-3865-82f1-bc6cc3db6af6",
                        "glosses": [
                            "pasek służący do przytrzymywania psa myśliwskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6374fc1-0cc9-4126-965a-89624045aede",
                                "sense_id": "1325a970-8614-3325-a00d-7f6669ac7db7",
                                "text": "Innym razem należało psa wyprowadzać w pole na otoku i w koralach, aby go zmuszać do należytego dociągania po zwietrzeniu zwierzyny."
