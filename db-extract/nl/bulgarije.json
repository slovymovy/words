                    }
                ],
                "senses": [
                    {
                        "sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                        "entry_id": "0a6d825a-5ff4-31d8-bfd8-01407ae6e190",
                        "glosses": [
                            "een land in Zuidoost-Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f079d68-68b9-4de7-a787-4b9e6db04707",
                                "sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                                "text": "Bulgarije kent vele mooie tradities en oude rituelen."
                            },
                            {
                                "example_id": "0143fd7a-1845-405f-b022-532a64ff9374",
                                "sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                                "text": "De modellen die het grootste gedeelte van de show lopen zijn beroeps uit Bulgarije en Polen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e2bd987-4bc2-4597-b0ec-801ca681c5b0",
                        "source_entry_id": "0a6d825a-5ff4-31d8-bfd8-01407ae6e190",
                        "source_sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                        "source_sense_description": "een land in Zuidoost-Europa",
                        "target_lang_word": "Bulgarien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bulgarien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                        "entry_id": "dad0fe3f-d686-39e8-9b2b-3c043bc414ec",
                                        "glosses": [
                                            "Land in Südosteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b5c18a-6756-4640-807e-c255881a0fd2",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "Bei DDR-Bürgern war Bulgarien ein beliebtes Urlaubsland."
                                            },
                                            {
                                                "example_id": "e71ffcd8-6265-4adf-b5dc-6282389541c7",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "Sofia ist die Hauptstadt von Bulgarien."
                                            },
                                            {
                                                "example_id": "11eaaed6-ba6c-42b4-8b59-61641899ee40",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "„Bulgarien liegt im Osten der Balkanhalbinsel und ist eine Republik, die im Norden an Rumänien, im Westen an Serbien und Mazedonien, im Süden an Griechenland und die Türkei grenzt.“"
                                            },
                                            {
                                                "example_id": "71c692c8-4abe-4dee-9896-0016631ea9ce",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "„Die ursprünglich im Bereich des heutigen Bulgarien siedelnden Thraker kamen im 4.Jh. v. Chr.unter makedonische und im 1. Jh. n. Chr. unter römische Herrschaft.“"
                                            },
                                            {
                                                "example_id": "91653344-963d-4623-88dc-67dbc709d109",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "„Die verheerenden Waldbrände in Russland haben den russischen Fußball-Verband (RFS) dazu gezwungen, das Länderspiel gegen Bulgarien am kommenden Mittwoch von Moskau nach St. Petersburg zu verlegen.“"
                                            },
                                            {
                                                "example_id": "9b40424a-34ae-493b-af9b-a2c6bd9b75b3",
                                                "sense_id": "79ed7e00-fec1-31bb-92da-dd41c443fc84",
                                                "text": "„Mein Geschichtslehrer erklärte eines Tages, dass Bulgarien im 10. Jahrhundert das größte Königreich auf dem Balkan gewesen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e8f262b-175c-45f6-8c73-ab3f3b761897",
                        "source_entry_id": "0a6d825a-5ff4-31d8-bfd8-01407ae6e190",
                        "source_sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                        "source_sense_description": "een land in Zuidoost-Europa",
                        "target_lang_word": "Bulgaria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bulgaria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "586ade2f-6221-3e42-8959-ff99d6a95243",
                                        "entry_id": "9edf06c2-dc44-3f88-9404-e3d3baa41449",
                                        "glosses": [
                                            "A country in Southeast Europe. Official name: Republic of Bulgaria. Capital and largest city: Sofia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1363e31-3224-424c-bc65-74186ff5f0e7",
                                                "sense_id": "586ade2f-6221-3e42-8959-ff99d6a95243",
                                                "text": "Hungary, Austria and Poland are still refusing to participate in the resettlement plan, due to end in September. Other Eastern European countries, such as the Czech Republic, Bulgaria, Croatia and Slovakia, are only doing so on a limited basis, the commission said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c40ce31b-8d3c-4aaa-ad49-876a31069d17",
                        "source_entry_id": "0a6d825a-5ff4-31d8-bfd8-01407ae6e190",
                        "source_sense_id": "18a3d3a4-0330-3c6c-8105-20cb16b9f9d0",
                        "source_sense_description": "een land in Zuidoost-Europa",
                        "target_lang_word": "Bulgarie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bulgarie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1701146f-0361-3a15-8562-8961796d0801",
                                        "entry_id": "26450d10-cc09-3cfe-af0b-f4086c226df1",
                                        "glosses": [
                                            "Pays de l'Europe orientale, bordé à l’est par la mer Noire, au sud par la Turquie et la Grèce, à l’ouest par la Macédoine du Nord et la Serbie, et au nord par la Roumanie, et dont la capitale est Sofia."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c964a4f5-140f-4c59-859d-c2b1c35eccc3",
                                                "sense_id": "1701146f-0361-3a15-8562-8961796d0801",
                                                "text": "Quant à la Bulgarie, ce doit être un pays de bien vilaines gens, et l'Inquisition en a brûlé qui le méritaient moins."
                                            },
                                            {
                                                "example_id": "2b6b6218-47cb-4305-b282-9c4bd86d9f6f",
                                                "sense_id": "1701146f-0361-3a15-8562-8961796d0801",
                                                "text": "Il n’est pas de pays en Europe dont on parle plus que la Bulgarie ; il n’en est pas qu’on connaisse moins."
                                            },
                                            {
                                                "example_id": "54be8a4d-79e4-44d9-b69d-9bdc5d9f5433",
                                                "sense_id": "1701146f-0361-3a15-8562-8961796d0801",
                                                "text": "Avec ses deux filles, Bettina et Angelika, Else s’installa à Sofia, où elle resta sans être inquiétée pendant toute la guerre, la Bulgarie étant un des rares pays balkaniques alliés de l’Axe à ne pas avoir versé dans l’antisémitisme et, grâce au roi Boris, à protéger plutôt ses Juifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8166126e-b5de-46d7-90d0-88d569670f06",
                        "source_entry_id": "0a6d825a-5ff4-31d8-bfd8-01407ae6e190",
