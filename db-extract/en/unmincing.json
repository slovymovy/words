                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2997f9cb-2976-46da-aa71-6f5f31a626b2",
                                "sense_id": "31e10f17-1900-37a3-b7c4-c641a7731dd0",
                                "text": "\"If I don't have a care,\" reflected Lady Bell in alarm, and with the crude unmincing expression of opinion which belonged to her years and her generation, \"I'll soon be as great a brute as Trevor.\""
                            },
                            {
                                "example_id": "9e21e564-8ae9-46a1-8657-b02cdb5d54a0",
                                "sense_id": "31e10f17-1900-37a3-b7c4-c641a7731dd0",
                                "text": "He is a wonderful searcher of hearts and interpreter of motives, and in scathing, unmincing language he reveals the hidden folds of souls."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad630171-e1bb-3581-8d36-efdca23ec377",
                        "entry_id": "c4e27387-7f34-34d6-a3b9-6238db65ee3c",
                        "glosses": [
                            "Not walking with affectedly short steps."
                        ],
                        "tags": [],
                        "examples": [
                            {
