                ],
                "senses": [
                    {
                        "sense_id": "b9c365ad-9aeb-30b7-b15a-ff8bee412917",
                        "entry_id": "da1ae1fd-7879-3384-93cb-db9f315df5f5",
                        "glosses": [
                            "(En parlant du visage ou de parties du visage) Empreint de creux, émacié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c66182-ed50-443f-92e9-93d24a053832",
                                "sense_id": "b9c365ad-9aeb-30b7-b15a-ff8bee412917",
                                "text": "L’officier est grand et élancé, cheveux très blonds, teint hâlé, visage amaigri, des cernes et les traits creusés de quelqu’un qui a peu dormi et beaucoup enduré, cependant impéccablement rasé, Maman s’en souvenait, ça l’avait frappée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3d026d36-222c-3e4e-9fe6-ba860c7078dd",
                "word": "creusé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "281a7223-5ff6-3c50-9cb3-acdf703fdb08",
                        "entry_id": "3d026d36-222c-3e4e-9fe6-ba860c7078dd",
                        "glosses": [
                            "Participe passé masculin singulier de creuser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c338ff4e-93a6-417d-aac0-e03f4d3baab6",
                                "sense_id": "281a7223-5ff6-3c50-9cb3-acdf703fdb08",
                                "text": "Parallèlement à la rivière, afin de régulariser le cours de l’eau, les paysans ont d’abord creusé puis cimenté un canal de dérivation équipé de batardeaux, ouvrages permettant de régler le débit de l’eau."
                            },
                            {
                                "example_id": "cf1dfca1-a5f4-40ec-8140-1a184a74584e",
                                "sense_id": "281a7223-5ff6-3c50-9cb3-acdf703fdb08",
                                "text": "C’est ainsi que l’étang de Caronte, qui fait communiquer l’étang de Berre avec la mer s’est creusé en suivant la base des couches lacustres fortement relevées."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
