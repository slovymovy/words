{
    "word_family": [
        "hefty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72e6a20e-d56d-36c5-b895-0071f585f78f",
                    "sense_definition": "To lift or lift up, especially with considerable effort or physical strain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>heft</w> the heavy sack onto his shoulder.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>взвалить</w> тяжелый мешок себе на плечо."
                            }
                        },
                        {
                            "text": "They had to <w>heft</w> the fallen tree off the driveway together.",
                            "target_lang_translations": {
                                "ru": "Им пришлось вместе <w>поднимать</w> упавшее дерево, чтобы убрать его с подъездной дорожки."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoist"
                    ],
                    "common_phrases": [
                        "heft onto shoulder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать что-либо тяжелое с усилием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "тяжесть"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "тяжелый предмет"
                            },
                            {
                                "target_lang_word": "взваливать",
                                "target_lang_sense_clarification": "тяжесть на плечи или спину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a2c0717-db2a-398f-bff1-ab3b947faf53",
                    "sense_definition": "To test, judge, or estimate the weight of something by lifting or holding it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She picked up the stone and <w>hefted</w> it in her hand to gauge its weight.",
                            "target_lang_translations": {
                                "ru": "Она подняла камень и <w>взвесила его в руке</w>, чтобы оценить вес."
                            }
                        },
                        {
                            "text": "Before choosing an axe, take a moment to <w>heft</w> it and check its balance.",
                            "target_lang_translations": {
                                "ru": "Перед тем как выбрать топор, найдите минутку, чтобы <w>прикинуть его в руке</w> и проверить балансировку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heft in hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценивать или прикидывать вес предмета, держа или приподнимая его в руках"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взвешивать в руке",
                                "target_lang_sense_clarification": "определять вес на ощупь"
                            },
                            {
                                "target_lang_word": "прикидывать на вес",
                                "target_lang_sense_clarification": "оценивать тяжесть рукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "928e2b58-aceb-30ae-b8c9-039d2d7452da",
                    "sense_definition": "To assess, evaluate, or judge the quality or capability of someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once the committee began to <w>heft</w> the candidates, his lack of experience became obvious.",
                            "target_lang_translations": {
                                "ru": "Как только комиссия принялась <w>оценивать</w> кандидатов, недостаток его опыта стал очевиден."
                            }
                        },
                        {
                            "text": "Critics gathered to <w>heft</w> the new policy against earlier proposals.",
                            "target_lang_translations": {
                                "ru": "Критики собрались, чтобы <w>сопоставить</w> новую политику с предыдущими предложениями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative extension"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценивать способности, авторитет или значимость человека либо идеи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "качества, потенциал"
                            },
                            {
                                "target_lang_word": "взвешивать",
                                "target_lang_sense_clarification": "достоинства и недостатки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edeb1da4-0567-34f9-b0f4-1c6b3d7d0d80",
                    "sense_definition": "To have substantial weight; to weigh.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That iron kettle really <w>hefts</w> when it is full of water.",
                            "target_lang_translations": {
                                "ru": "Этот железный чайник действительно <w>тяжел</w>, когда полон воды."
                            }
                        },
                        {
                            "text": "The small gold coin seemed to <w>heft</w> far more than expected.",
                            "target_lang_translations": {
                                "ru": "Маленькая золотая монетка, казалось, <w>весила</w> куда больше, чем ожидалось."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or colloquial"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь значительный вес; весить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весить",
                                "target_lang_sense_clarification": "иметь значительный вес"
                            },
                            {
                                "target_lang_word": "оттягивать руку",
                                "target_lang_sense_clarification": "быть тяжелым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f813521-5238-3cef-b0d0-791705323ea5",
                    "sense_definition": "To accustom livestock, especially sheep or cattle, to a particular area of pasture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "livestock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers work hard to <w>heft</w> new sheep to the open hills so they will not wander away.",
                            "target_lang_translations": {
                                "ru": "Фермеры усердно трудятся, чтобы <w>приучить</w> новых овец <w>к пастбищу</w> на открытых холмах, дабы те не разбредались."
                            }
                        },
                        {
                            "text": "The lambs were successfully <w>hefted</w> to the high moor over the course of the spring.",
                            "target_lang_translations": {
                                "ru": "За весну ягнят успешно <w>приучили к выпасу</w> на высоких пустошах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приучать скот (особенно овец) к определенному пастбищу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приучать к пастбищу",
                                "target_lang_sense_clarification": "о скоте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01a50e79-aa82-3a8d-8ee5-6ae05558af63",
                    "sense_definition": "To establish or settle someone firmly in a place or occupation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "settle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took several months to become fully <w>hefted</w> in his new trade.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько месяцев, чтобы окончательно <w>освоиться</w> в новом ремесле."
                            }
                        },
                        {
                            "text": "The family was finally <w>hefted</w> in the quiet village after years of travel.",
                            "target_lang_translations": {
                                "ru": "Семья наконец <w>обосновалась</w> в тихой деревушке после долгих лет странствий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обосновывать, прочно укоренять человека на определенном месте или в профессии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укоренять",
                                "target_lang_sense_clarification": "на месте или в деле"
                            },
                            {
                                "target_lang_word": "обосновывать",
                                "target_lang_sense_clarification": "на новом месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17c54fb4-ea8f-3c44-912d-5decaec8415e",
                    "sense_definition": "To establish or fix something firmly in a place; to root.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "settle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional beliefs were deeply <w>hefted</w> in the culture of the mountain community.",
                            "target_lang_translations": {
                                "ru": "Традиционные верования глубоко <w>укоренились</w> в культуре этой горной общины."
                            }
                        },
                        {
                            "text": "The roots of the old oak tree were firmly <w>hefted</w> into the rocky soil.",
                            "target_lang_translations": {
                                "ru": "Корни старого дуба прочно <w>вцепились</w> в каменистую почву."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно закреплять или укоренять что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укоренять",
                                "target_lang_sense_clarification": "традиции, корни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad19fa09-28fe-311e-a83d-9c92d677a94d",
                    "sense_definition": "Of a thing: to establish or settle itself firmly in a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "settle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The custom seemed to <w>heft</w> naturally among the island residents over generations.",
                            "target_lang_translations": {
                                "ru": "Этот обычай, казалось, естественным образом <w>прижился</w> среди жителей острова за многие поколения."
                            }
                        },
                        {
                            "text": "New habits will gradually <w>heft</w> if practiced consistently every day.",
                            "target_lang_translations": {
                                "ru": "Новые привычки постепенно <w>укоренятся</w>, если следовать им каждый день."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О явлении, обычае: прочно приживаться, закрепляться где-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приживаться",
                                "target_lang_sense_clarification": "о традициях, обычаях"
                            },
                            {
                                "target_lang_word": "укореняться",
                                "target_lang_sense_clarification": "о привычках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f483ba7b-0a54-394f-9398-1b06d2c31030",
                    "sense_definition": "To cause milk to be retained in a cow's udder to make it swell, giving the appearance of higher milk yield.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dealers would often <w>heft</w> cows before bringing them to market to impress buyers.",
                            "target_lang_translations": {
                                "ru": "Торговцы часто <w>передерживали молоко в вымени</w> у коров перед продажей на рынке, чтобы произвести впечатление на покупателей."
                            }
                        },
                        {
                            "text": "The practice of <w>hefting</w> dairy cattle was widely condemned as cruel to the animals.",
                            "target_lang_translations": {
                                "ru": "Практика <w>передерживания молока</w> у дойных коров осуждалась как жестокое обращение с животными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задерживать молоко в вымени коровы перед продажей ради вида высокой удойности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передерживать молоко",
                                "target_lang_sense_clarification": "в вымени коровы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827d6dfd-8381-3791-ada7-2b245c6ff8dc",
                    "sense_definition": "To cause urine to be retained in the bladder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sitting for hours without a break can <w>heft</w> the bladder uncomfortably.",
                            "target_lang_translations": {
                                "ru": "Сидение часами без перерыва может неприятно <w>переполнить</w> мочевой пузырь."
                            }
                        },
                        {
                            "text": "He complained of pain after being forced to <w>heft</w> during the long carriage ride.",
                            "target_lang_translations": {
                                "ru": "Он пожаловался на боль, так как ему пришлось долго <w>терпеть</w> во время поездки в экипаже."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдерживать позывы к мочеиспусканию, удерживать мочу в мочевом пузыре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "сдерживать позыв"
                            },
                            {
                                "target_lang_word": "удерживать мочу",
                                "target_lang_sense_clarification": "в мочевом пузыре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "869fc212-307d-3bce-b450-ec442e072d66",
                    "sense_definition": "simple past and past participle of <w>heave</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor <w>heft</w> the cargo onto the deck with a single powerful motion.",
                            "target_lang_translations": {
                                "ru": "Моряк одним мощным движением <w>взвалил</w> груз на палубу."
                            }
                        },
                        {
                            "text": "Together they <w>heft</w> the heavy chest out of the flooded basement.",
                            "target_lang_translations": {
                                "ru": "Вместе они <w>вытащили</w> тяжелый сундук из затопленного подвала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic or dialectal form"
                        },
                        {
                            "trait_type": "form",
                            "comment": "inflectional form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола heave: поднимал, вздымал, бросал"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднял",
                                "target_lang_sense_clarification": "прош. вр. от heave"
                            },
                            {
                                "target_lang_word": "швырнул",
                                "target_lang_sense_clarification": "прош. вр. от heave"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6107a1-244d-3d46-b1ca-ffa9afec12c5",
                    "sense_definition": "The tangible feel or sensation of the weight and solidity of an object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really like the solid <w>heft</w> of this cast-iron pan.",
                            "target_lang_translations": {
                                "ru": "Мне очень нравится основательная <w>тяжесть</w> этой чугунной сковороды."
                            }
                        },
                        {
                            "text": "The antique brass key had a satisfying <w>heft</w> in the palm of her hand.",
                            "target_lang_translations": {
                                "ru": "Старинный латунный ключ приятно отдавал <w>увесистостью</w> на ее ладони."
                            }
                        }
                    ],
                    "synonyms": [
                        "heftiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощутимая тяжесть и основательность предмета в руке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "ощутимый вес предмета"
                            },
                            {
                                "target_lang_word": "увесистость",
                                "target_lang_sense_clarification": "ощущение солидного веса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61191c5d-801c-36c7-a638-b8e685f7dc0e",
                    "sense_definition": "Substantial importance, influence, or intellectual weight.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His endorsement gave considerable political <w>heft</w> to the campaign.",
                            "target_lang_translations": {
                                "ru": "Его поддержка придала кампании значительный политический <w>вес</w>."
                            }
                        },
                        {
                            "text": "The author's arguments lacked the intellectual <w>heft</w> needed to persuade academics.",
                            "target_lang_translations": {
                                "ru": "Доводам автора не хватило интеллектуальной <w>весомости</w>, необходимой для убеждения ученых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intellectual heft",
                        "political heft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влияние, значимость или интеллектуальная глубина"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "авторитет, значимость"
                            },
                            {
                                "target_lang_word": "влиятельность",
                                "target_lang_sense_clarification": "политическая или общественная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15ec041-e50f-34b9-80b0-7e80e4046f8e",
                    "sense_definition": "Physical heaviness or weight, especially of a person or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Due to his great <w>heft</w>, he struggled to climb the steep stairs.",
                            "target_lang_translations": {
                                "ru": "Из-за своей изрядной <w>грузности</w> он с трудом поднимался по крутой лестнице."
                            }
                        },
                        {
                            "text": "The sheer <w>heft</w> of the stone made it nearly impossible to move without equipment.",
                            "target_lang_translations": {
                                "ru": "Один лишь огромный <w>вес</w> камня делал его перемещение без оборудования практически невозможным."
                            }
                        }
                    ],
                    "synonyms": [
                        "heftiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая масса, грузность тела или предмета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжесть",
                                "target_lang_sense_clarification": "большой вес тела или груза"
                            },
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "физическая масса"
                            },
                            {
                                "target_lang_word": "массивность",
                                "target_lang_sense_clarification": "крупное телосложение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ac15807-f179-390a-bcde-a2cf49adcec9",
                    "sense_definition": "The greater or bulk part of something; the majority or mass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>heft</w> of the work was completed before the deadline arrived.",
