                ],
                "senses": [
                    {
                        "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                        "entry_id": "f62f1698-c019-3874-8b79-f4d8e44afa58",
                        "glosses": [
                            "einfaches und bequemes bis über die Knie reichendes Kleid, das zu Hause getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77b8c5a-db46-4878-b7b6-1a7c7b3ab271",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "Hinter der Küchentür hängt eine blaue Schürze und ein Hauskleid."
                            },
                            {
                                "example_id": "a303c08a-9ff5-4a57-b88d-f6ea0a05b554",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "Früher erledigte meine Oma die Hausarbeit in einem geblümten Hauskleid."
                            },
                            {
                                "example_id": "15940cfc-f96b-4fba-a447-8e37d22e84f0",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "Von meiner Uroma gibt es Schwarzweißfotos aus den 1930ern, wo sie im selbstgenähten Hauskleid in die Kamera lächelt."
                            },
                            {
                                "example_id": "baded1e3-b5b6-4ff0-92e3-be608b0d2510",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "„Im Badezimmer hängt noch das geblümte Hauskleid am Haken. Barbara Maria Bauer liebt Hauskleider.“"
                            },
                            {
                                "example_id": "84433b79-e5aa-40af-b11a-fb1ad61b0c9d",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "„Das Hauskleid beſteht aus Wollſtoff, Waschſtoff oder einfacher Seide. […] Auf jeden Fall muß das Hauskleid so beſchaffen sein, daß jederzeit Beſuche empfangen werden können.“"
                            },
                            {
                                "example_id": "9d50e9c5-dc48-42e7-9ccf-6a5d94109fec",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "„[…] es ist ein […] Kramladen, dunkel und vollgepackt mit Kisten und Kästen, und dahinter thront die Mama, Edit Kalisch, rotwangig und mit geblümtem Hauskleid, die Fremde erst einmal mißtrauisch beäugt.“"
                            },
                            {
                                "example_id": "23e6cd6a-3d26-4d86-8dd6-72c1cf39f967",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "„Am Samstag, den 13. Juli, stieg eine weibliche Person mit einem getüpfelten Hauskleid, mit einem hohen Hut und einem Fächer aus einem Mietwagen und verlangte den Bürger Marat.“"
                            },
                            {
                                "example_id": "b6b3390b-843a-47f9-b01a-cac08c4815ff",
                                "sense_id": "ad3fe074-60ad-3762-ae70-f2745befe85f",
                                "text": "„Es ist an der Zeit, die Renaissance eines aus der Mode gekommenen Kleidungsstückes einzuläuten: des Hauskleides. Es mag auf den ersten Blick spießig wirken, […] es mag an alte Jungfern und strenge Gouvernanten erinnern und optisch ein paar Lebensjahre draufpacken. Doch es zeigt Haltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
