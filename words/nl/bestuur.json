                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "operating a vehicle"
                            },
                            {
                                "target_lang_word": "steer",
                                "target_lang_sense_clarification": "guiding a vehicle or course"
                            },
                            {
                                "target_lang_word": "govern",
                                "target_lang_sense_clarification": "ruling or managing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4af94053-044b-33bf-a3b3-3586896ca1b8",
                    "sense_definition": "De gebiedende wijs van <w>besturen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bestuur</w> de drone voorzichtig zodat hij nergens tegenaan vliegt.",
                            "target_lang_translations": {
                                "en": "<w>Fly</w> the drone carefully so that it doesn't fly into anything."
                            }
                        },
                        {
                            "text": "<w>Bestuur</w> het schip naar de veilige haven!",
                            "target_lang_translations": {
                                "en": "<w>Steer</w> the ship to the safe harbor!"
                            }
                        }
                    ],
                    "traits": [
