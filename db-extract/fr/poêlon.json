                                        "glosses": [
                                            "A recess, or bed, for the leaf of a hinge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c98303b4-b94f-3e0b-a81f-89a89f9c736b",
