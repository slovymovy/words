                                            {
                                                "example_id": "16010722-712f-4f1f-a296-da7c05843000",
                                                "sense_id": "5f9e5094-60ac-39a5-8e4e-eae138328e9d",
                                                "text": "„Noch 24 Stunden, dann endet die Frist zur Mitzeich[n]ung einer öffentlichen Petition an den Deutschen Bundestag für mehr Wettbewerb auf dem Energiesektor.“"
                                            },
                                            {
                                                "example_id": "208b2351-8f3e-4903-9e8e-2730a819314b",
                                                "sense_id": "5f9e5094-60ac-39a5-8e4e-eae138328e9d",
                                                "text": "„Eine Petition im Sinne des Grundgesetzes muss schriftlich erfolgen und den Absender erkennen lassen.“"
                                            },
                                            {
                                                "example_id": "04fc40ef-8837-4b2f-b60e-5bde8d020850",
                                                "sense_id": "5f9e5094-60ac-39a5-8e4e-eae138328e9d",
                                                "text": "\"Wenn 7,5 Millionen Menschen unsere Petition unterschrieben haben, heißt das auch, dass 7,5 Millionen Menschen bereit sind, im Namen einer sicheren Zukunft ihren Stromverbrauch zu reduzieren\", sagt Fujimoto: \"Es geht darum, die ganze Energiepolitik zu überdenken.\""
                                            },
                                            {
                                                "example_id": "e216a697-6e36-4a8e-836b-aa962903724f",
                                                "sense_id": "5f9e5094-60ac-39a5-8e4e-eae138328e9d",
                                                "text": "„Seine Petitionen (oder die von Elizabeth in seinem Namen) schildern ihn als aufrechten, gebildeten Mann, einen Berufsmusiker, der durch widrige Umstände in Not geraten sei.“"
                                            },
                                            {
                                                "example_id": "09969878-cb91-4842-9f13-dbbfeae8008d",
                                                "sense_id": "5f9e5094-60ac-39a5-8e4e-eae138328e9d",
                                                "text": "[Februar 2022:] „Eine Petition gegen den russischen Angriff auf die Ukraine hatte bis Samstag mehr als 780.000 Unterzeichner, so viele wie kaum eine andere Online-Petition in Russland in den vergangenen Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
