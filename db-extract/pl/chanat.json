                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3396fb63-7ae8-405c-afa1-c735ff451118",
                        "source_entry_id": "8266bc11-d432-367b-a8d8-74dbb761f4de",
                        "source_sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
                        "target_lang_word": "khanate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                        "entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                                        "glosses": [
                                            "The polity ruled by a khan, comprising one or more tribes or clans; a state or dominion ruled by this polity; its territory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6353fc5-c59c-4d12-9c72-3dab4f781657",
                                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                                "text": "By the middle of the nineteenth century Central Asia was rarely out of the headlines, as one by one the ancient caravan towns and khanates of the former Silk Road fell to Russian arms."
                                            },
                                            {
                                                "example_id": "2200d210-d1d4-4648-83f1-b0f5a839ed46",
                                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                                "text": "Sviatoslav had his own imperial ambitions, which led him to take an aggressive interest in the Christian khanate of Bulgaria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a297730-58ce-43cf-aea0-260094042a52",
                        "source_entry_id": "8266bc11-d432-367b-a8d8-74dbb761f4de",
                        "source_sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
                        "target_lang_word": "chanate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eca54e53-6d82-3c3a-ab7d-407832605e13",
                                        "entry_id": "d9f041d1-0a39-3f9d-9fc0-bf0693737155",
                                        "glosses": [
                                            "a kind of bird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1744e7e9-ea00-445c-bda3-e2f5446fdda6",
                                                "sense_id": "eca54e53-6d82-3c3a-ab7d-407832605e13",
                                                "text": "The farmer will hardly have sowed his wheat and maize fields when whole flocks of hungry chanates descend upon the land, scratch out the seeds, and eat them."
                                            },
                                            {
                                                "example_id": "4eca5aba-fc88-423c-ad28-24ce3f171f91",
                                                "sense_id": "eca54e53-6d82-3c3a-ab7d-407832605e13",
                                                "text": "The black chanate birds were gathered, fluting their jangled morning songs under the pomegranates and figs as martin walked from the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f38c6645-05c3-3b9c-b816-3ee18174733f",
                                        "entry_id": "d9f041d1-0a39-3f9d-9fc0-bf0693737155",
                                        "glosses": [
                                            "a kind of bird",
                                            "great-tailed grackle (Quiscalus mexicanus)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7620d9be-1adf-31f4-a8a3-24cabe53f150",
                                        "entry_id": "d9f041d1-0a39-3f9d-9fc0-bf0693737155",
                                        "glosses": [
                                            "a kind of bird",
                                            "red-winged blackbird (Agelaius phoeniceus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d892b6-7241-449e-8c57-6b6166afd851",
                                                "sense_id": "7620d9be-1adf-31f4-a8a3-24cabe53f150",
                                                "text": "“A chanate has come to pay us a visit,” doña Gertrudis said. [...] “It’s a black bird with red shoulders,”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cacdad4-a244-3b80-afe9-697bcdf2280d",
                                        "entry_id": "d9f041d1-0a39-3f9d-9fc0-bf0693737155",
                                        "glosses": [
                                            "black person"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f81cd07d-7f13-4a82-95af-519ddf6844a2",
                                                "sense_id": "2cacdad4-a244-3b80-afe9-697bcdf2280d",
                                                "text": "Pelaquillo's older brother was there. We called him Chanate, the name of a little black bird, because he was so dark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3b7549-65bc-36b7-9c9b-a8db87a15c17",
                                        "entry_id": "d9f041d1-0a39-3f9d-9fc0-bf0693737155",
                                        "glosses": [
                                            "coffee"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a626c2d3-1818-4f3a-97e4-ccd6d91e3262",
                                                "sense_id": "5c3b7549-65bc-36b7-9c9b-a8db87a15c17",
                                                "text": "I’m sippin’ on some chanate [coffee] right now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72ba4797-0a9e-3db6-8c0b-5c1fb17f2446",
                                        "entry_id": "525fb719-416b-3ad9-8ccf-5fb100c3dbff",
                                        "glosses": [
                                            "a kind of tree (Colophospermum mopane)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39f466f-960e-471e-a01f-c6913e43a4a6",
                                                "sense_id": "72ba4797-0a9e-3db6-8c0b-5c1fb17f2446",
                                                "text": "The dominant tree, often to the exclusion of many others, is Colophospermum mopane, commonly known as mopane or chanate."
                                            },
                                            {
                                                "example_id": "a0e68af4-81c5-43b8-b565-6a2ea58a01a8",
                                                "sense_id": "72ba4797-0a9e-3db6-8c0b-5c1fb17f2446",
                                                "text": "The Chinese sell the rare exotic hardwood trees such as chanate, ebony, monzo (leadwood), panga panga, pau preto and wenge for a hundred times as much back in their home country"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c53a32-047c-3bcb-b001-e2bf0f5806b9",
                                        "entry_id": "c90811f5-fb73-33d1-8960-d873a2ec9ba8",
                                        "glosses": [
                                            "Obsolete spelling of khanate."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6eeef51-cdca-42a7-b680-78d374cc54cf",
                                                "sense_id": "c6c53a32-047c-3bcb-b001-e2bf0f5806b9",
                                                "text": "You are aware that almost all the Armenians residing in the different chanates of Azerbijan, and all the Greeks in the neighbourhood of the town of Ormi, a short time after our troops had occupied Tabreez, proclaimed their willingness to emigrate; that they terefore, during my stay at Deichagan, sent thither deputies, in order to receive permission to this effect."
                                            },
                                            {
                                                "example_id": "23ceb265-5b03-45e0-9804-808d15c9f478",
                                                "sense_id": "c6c53a32-047c-3bcb-b001-e2bf0f5806b9",
                                                "text": "Gengis-Chan and Batuj spread terror over Europe. At a subsequent period this people separated into several Chanates."
                                            },
                                            {
                                                "example_id": "4d5c2bbc-f35e-49f7-9755-dd18d64531ac",
                                                "sense_id": "c6c53a32-047c-3bcb-b001-e2bf0f5806b9",
                                                "text": "Slavery on the Pamir is flourishing: moreover, the principal contingents of slaves are obtained from Chatrar, Jasen, and Kanshoot, chanates under the protectorate of England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00b0dfe4-7057-4377-bfa6-431dada7e931",
                        "source_entry_id": "8266bc11-d432-367b-a8d8-74dbb761f4de",
                        "source_sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
