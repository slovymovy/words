                                "ru": "Поэт <w>грезил</w> о лучшем мире в своих стихах.",
                                "nl": "De dichter <w>droomde</w> in zijn gedichten van een betere wereld.",
                                "de": "Der Dichter <w>träumte</w> in seinen Gedichten von einer besseren Welt.",
                                "fr": "Le poète <w>rêvait</w> d'un monde meilleur dans ses vers.",
                                "it": "Il poeta <w>vagheggiava</w> un mondo migliore nelle sue poesie.",
                                "cs": "Básník ve svých básních <w>snil</w> o lepším světě.",
                                "tr": "Şair, şiirlerinde daha iyi bir dünyanın <w>hayalini kuruyordu</w>.",
                                "es": "El poeta <w>ensoñaba</w> con un mundo mejor en sus versos.",
                                "zh": "诗人在他的诗作中<w>遐想</w>着一个更美好的世界。"
                            }
                        },
                        {
                            "text": "Często <w>mży</w> przed zaśnięciem o dalekich podróżach.",
                            "target_lang_translations": {
                                "en": "She often <w>daydreams</w> of distant travels before falling asleep.",
                                "ru": "Перед сном он часто <w>грезит</w> о далёких путешествиях.",
                                "nl": "Hij <w>mijmert</w> voor het slapengaan vaak over verre reizen.",
                                "de": "Vor dem Einschlafen <w>träumt</w> sie oft von fernen Reisen.",
                                "fr": "Il <w>rêvasse</w> souvent de voyages lointains avant de s'endormir.",
                                "it": "Spesso prima di addormentarsi <w>fantastica</w> su viaggi lontani.",
                                "cs": "Často před usnutím <w>blouzní</w> o dalekých cestách.",
                                "tr": "Uyumadan önce sık sık uzak yolculukları <w>düşler</w>.",
                                "es": "A menudo <w>sueña despierto</w> con viajes lejanos antes de dormirse.",
                                "zh": "入睡前他经常<w>梦想</w>着去远方旅行。"
                            }
