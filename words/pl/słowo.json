                            }
                        },
                        {
                            "text": "Długość <w>słowa</w> ma kluczowe znaczenie dla wydajności obliczeniowej systemu.",
                            "target_lang_translations": {
                                "ru": "Длина <w>слова</w> имеет ключевое значение для вычислительной мощности системы."
                            }
