                "senses": [
                    {
                        "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                        "entry_id": "6db31d7d-7eef-3538-9d9b-cf00c919bbc7",
                        "glosses": [
                            "Angehörige eines keltischer Volksstamm, der im Nordosten Galliens siedelte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "77fee06d-9eef-4063-84ae-4cc3c2abc200",
                                "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                                "text": "„Dem Gott Jupiter hat Clamosa, die Treverin, ihr Gelübde gerne und dankbar erfüllt.“"
                            },
                            {
                                "example_id": "8f50974f-239d-4059-81de-2eb4dd3875df",
                                "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                                "text": "„Während die Vorderseite von den Manen spricht, also an den heidnischen Totenkult erinnert, deutet die Nebenseite durch den Ausdruck exanimen darauf hin, dass die Treverin als Christin gestorben ist.“"
                            },
                            {
                                "example_id": "42635132-85d9-4c55-9165-b0c82dc661b7",
                                "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                                "text": "„Den Vermutungen von J. Krier zufolge kann man in dem Mann der in Mainz verstorbenen Treverin Valentinia Avita einen Verwaltungsbeamten oder einen Geschäftsmann sehen.“"
                            },
                            {
                                "example_id": "237da6ca-3ac1-49d5-a707-b2a6bd5413bf",
                                "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                                "text": "„In Anbetracht der besonders engen personellen und wirtschaftlichen Kontakte zwischen dem Treverergebiet und Lyon und in abgeschwächter Form mit den anderen gallischen Gebieten ist es nicht ganz abwegig, auch in der in Vienne bzw. in Grenoble bezeugten Ingenuia Bellica eine Treverin zu sehen, die in die begüterte Familie der Vienner Attii eingeheiratet hat.“"
                            },
                            {
                                "example_id": "5f4636c2-d759-4ef1-8c57-e5d6435cbbce",
                                "sense_id": "2c6eece3-d6e2-3aa2-9c83-3ab8ba376e9d",
                                "text": "„Die Einfügung der Frau in die Totenmahlszene erklärt sich an dem Xantener Stein dadurch, daß die Schwester des Verstorbenen, eine Treverin, das Denkmal für sich und ihren Bruder hat machen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
