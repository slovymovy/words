                    },
                    {
                        "sense_id": "8aeb526d-9d90-3218-b3c5-05b4fbd7f14d",
                        "entry_id": "2cec1d0c-aec0-3ec9-8196-497a9710852d",
                        "glosses": [
                            "свойственный полимерам, характерный для них"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897b989e-70ce-409c-98aa-a08a71409503",
                                "sense_id": "8aeb526d-9d90-3218-b3c5-05b4fbd7f14d",
                                "text": "Зак горел в танке, запутавшись среди покорёженного металла, горели его волосы, кожа шла пузырями, а густой чёрный, удушающий дым заволакивал мир полимерной вонью."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5ca8eef-9570-396e-81ca-b2667213c8e5",
                        "entry_id": "2cec1d0c-aec0-3ec9-8196-497a9710852d",
                        "glosses": [
                            "являющийся полимером, состоящий из полимера, содержащий полимер, сделанный, изготовленный из полимеров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a04c35ba-f162-4f95-8022-09694c045a25",
                                "sense_id": "b5ca8eef-9570-396e-81ca-b2667213c8e5",
                                "text": "Мы будем применять трубы из высокопрочных марок сталей, защищая их от почвенной коррозии полимерными материалами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f17850ef-bf12-4d6f-be60-56b22b2bfc85",
                        "source_entry_id": "2cec1d0c-aec0-3ec9-8196-497a9710852d",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным «полимер»; свойственный, характерный для него",
                        "target_lang_word": "polymer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14a37812-59fc-38ae-8dc3-1c26c518bdeb",
                                        "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                                        "glosses": [
                                            "A long or larger molecule consisting of a chain or network of many repeating units, formed by chemically bonding together many identical or similar small molecules called monomers. A polymer is formed by polymerization, the joining of many monomer molecules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                                        "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                                        "glosses": [
                                            "A material consisting of such polymer molecules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f0a8551-9d8b-4baf-870c-66b13029326d",
                                                "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                                                "text": "The water absorbency of the anionically starch-grafted AA/AM absorbent is markedly affected by the pH of the buffer solution at different ionic strengths. The charge of the ionic monomer affects the pH sensitivity of the superabsorbent polymers. An acidic superabsorbent normally ionizes at high pH but unionizes at low pH."
                                            },
                                            {
                                                "example_id": "ac8b3009-d955-447b-924e-6a77083f86e7",
                                                "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
