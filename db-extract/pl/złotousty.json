                    },
                    {
                        "form_id": "e4580660-e418-46ad-b581-7c73d25df41e",
                        "entry_id": "dfa2de9f-a8b3-3173-b662-b061482752f6",
                        "tags": [
                            "vocative",
                            "plural",
                            "masculine"
                        ],
                        "form": "złotouści"
                    },
                    {
                        "form_id": "ccd271d7-12b5-45d3-95c7-3ff60adde6d7",
                        "entry_id": "dfa2de9f-a8b3-3173-b662-b061482752f6",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "złotouste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7dfb44ba-70fe-319c-8398-0b55e43bd79c",
                        "entry_id": "dfa2de9f-a8b3-3173-b662-b061482752f6",
                        "glosses": [
                            "posiadający talent oratorski, będący świetnym mówcą"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6645c8-8ad0-4aa0-98c1-1068529d0faf",
                                "sense_id": "7dfb44ba-70fe-319c-8398-0b55e43bd79c",
                                "text": "Marian to złotousty mówca, przemawianie przychodzi mu z wyjątkową łatwością."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb2790ca-425d-49b1-955e-5ceed6377f27",
                        "source_entry_id": "dfa2de9f-a8b3-3173-b662-b061482752f6",
                        "source_sense_id": "7dfb44ba-70fe-319c-8398-0b55e43bd79c",
                        "target_lang_word": "silver-tongued",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silver-tongued",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                        "entry_id": "83fc3186-d3c0-31c3-8349-0ad5bdd07ed0",
                                        "glosses": [
                                            "Articulate and charming in speech; eloquent; also, having a pleasant-sounding voice or way of speaking."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0952c3ac-b76c-4487-a40c-997e3c514a6b",
                                                "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                                "text": "silver-tongued devil"
                                            },
                                            {
                                                "example_id": "e7630696-941d-40ee-8e67-fa0e1837768d",
                                                "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                                "text": "Siluer tongu'd Smith whoſe well tun'd ſtile hath made thy death the generall teares of the Muſes, queintlie couldſt thou deuiſe heauenly Ditties to Apollos Lute, and teach ſtately verſe to trip it as ſmoothly, as if Ouid and thou had but one ſoule."
                                            },
                                            {
                                                "example_id": "24d64f1d-8372-42b6-b75c-cb160f746551",
                                                "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                                "text": "Mr. [Thomas] Parker ſoon became a pleader at the bar; travelled the Midland circuit; acquired additional eſteem, buſineſs, and property; vvas denominated the Silver-tongued Counſel; and found intereſt enough, in 1705, to cauſe himſelf to be returned a member for the borough, vvith Lord James Cavendiſh, ſon to the firſt Duke of Devonſhire."
                                            },
                                            {
                                                "example_id": "c3612a5e-f466-4c91-bd23-127357a8ebc6",
                                                "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                                "text": "[T]he statesman, whose inward feelings had at first so much impeded his efforts to make himself known, had now regained all the ease and fluency of a silver-tongued lawyer of the very highest order."
                                            },
                                            {
                                                "example_id": "21dd8142-943b-429b-91b1-9e4f7489fa4f",
                                                "sense_id": "546c4c91-5a30-3587-92c9-71f3632f5c0c",
                                                "text": "Philips—Sergeant Gerheim's black, silver-tongued House Mouse—is telling everybody about the one thousand cherries he has busted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "755ef964-1aae-4ee5-ad6e-62d4d119a33a",
                        "source_entry_id": "dfa2de9f-a8b3-3173-b662-b061482752f6",
                        "source_sense_id": "7dfb44ba-70fe-319c-8398-0b55e43bd79c",
                        "target_lang_word": "beredt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beredt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b598ef42-415c-3076-a9c9-76cd9519da1f",
                                        "entry_id": "e1d8c2bf-526b-3b89-bc5a-dcf71b121d61",
                                        "glosses": [
                                            "hervorragend in der sprachlichen Ausdrucksweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcae6d2-580f-479b-9993-7f4f20c73622",
                                                "sense_id": "b598ef42-415c-3076-a9c9-76cd9519da1f",
                                                "text": "„Er war beredt, ein vornehmer Spieler, der stets verlor, beliebt bei Damen, denen er zu gefallen suchte, und immer unerschrocken und gleichmütig, im Glück wie im Unglück.“"
                                            },
                                            {
                                                "example_id": "e98b1352-cf9a-4bf4-a0e8-33505fdb1487",
                                                "sense_id": "b598ef42-415c-3076-a9c9-76cd9519da1f",
                                                "text": "» … Schwaben besitzt Männer genug, die hinlänglich unterrichtet, wohlmeinend, tüchtig und beredt sind, um Mitglied der Stände zu sein, aber es hat nur einen Dichter der Art wie Uhland.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9a3c3de-9879-341e-b3e1-6277fba07023",
                                        "entry_id": "e1d8c2bf-526b-3b89-bc5a-dcf71b121d61",
                                        "glosses": [
                                            "bedeutungsschwer in der Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977281e1-926b-4ae6-beb1-242a8faeb887",
                                                "sense_id": "a9a3c3de-9879-341e-b3e1-6277fba07023",
                                                "text": "„Sie betrachtet ihren Sohn, wie er ahnungslos weiter schreibt, und nur ihre zitternden Hände geben von ihrer inneren Bewegung Zeugnis. Aber sie sind sehr beredt, sehr, sehr beredt.“"
                                            },
                                            {
                                                "example_id": "82db2a3e-4cc1-49b8-ad4d-e9beba44f03c",
                                                "sense_id": "a9a3c3de-9879-341e-b3e1-6277fba07023",
                                                "text": "Und was sich schon im Titel so beredt ausdrückt: die Unsicherheit, um was es hier eigentlich wirklich geht, ist auch Crux der ganzen Ausstellung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58f9dc61-fac0-3515-9a49-6434bf13f436",
                                        "entry_id": "e1d8c2bf-526b-3b89-bc5a-dcf71b121d61",
                                        "glosses": [
                                            "ausdrucksstark in der Mitteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c82101-127f-4a89-ab17-b8ce74d25611",
                                                "sense_id": "58f9dc61-fac0-3515-9a49-6434bf13f436",
                                                "text": "„Indes verhielt sich der junge Mann schweigend und unbeweglich. Nur sein Blick war beredt.“"
                                            },
                                            {
                                                "example_id": "d29ce34b-4bd4-48ca-93b7-2580ca67e6b2",
                                                "sense_id": "58f9dc61-fac0-3515-9a49-6434bf13f436",
                                                "text": "Da saß er schuldbewußt vor mir, mit beredter Körpersprache an mein Mitleid appellierend; da saß er — und ich empfand Erbarmen: mein Freund, ein Stasi-Spitzel, einer von vielen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
