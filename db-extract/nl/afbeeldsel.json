                            {
                                "example_id": "912bb147-b0fd-45fa-b8d3-6d3801fa70ec",
                                "sense_id": "da35c6f1-fa12-3beb-b1b9-689febc69e05",
                                "text": "Dit is een levend afbeeldsel van het volk van Christus dat het veeltijds ten deel valt te zuchten en te wenen, ja, te huilen vanwege de onrust van hun hart. Dat wordt veroorzaakt door hun zonden."
                            },
                            {
                                "example_id": "2d69d7f0-d658-49f3-8a72-dbd7dae8197c",
                                "sense_id": "da35c6f1-fa12-3beb-b1b9-689febc69e05",
                                "text": "Zij is volmaakt geschikt voor de natuur van de mens in zijn oorspronkelijke staat en is een afbeeldsel van goddelijke heiligheid."
                            }
                        ]
                    }
                ],
