                "senses": [
                    {
                        "sense_id": "9c6ec730-6078-338f-957b-ef3acf1d2c37",
                        "entry_id": "cfb03d05-f13f-3919-ad2c-b37b5cd394bb",
                        "glosses": [
                            "Person, die eine Lohnkutsche lenkt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "97dd5bcf-2558-4210-b7e5-a8546021b5b6",
                                "sense_id": "9c6ec730-6078-338f-957b-ef3acf1d2c37",
                                "text": "„Wenn man mit einem Vetturino reist, so bezahlt man nicht voraus, sondern bekommt sogar noch Handgeld von ihm, damit man sich auf seine Ehrlichkeit verlassen kann, und er sorgt auf der ganzen Reise für Speise und Nachtlager.“"
                            },
                            {
                                "example_id": "55da4238-8cae-4944-bc4e-f90fb89c99b6",
                                "sense_id": "9c6ec730-6078-338f-957b-ef3acf1d2c37",
                                "text": "„Ich finde einige Vetturini, die nach Cosenza fahren wollen. Als sie aber hören, daß ich keinen Koffer habe, wollen sie nichts von mir wissen, wenn ich nicht vorausbezahle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
