                "senses": [
                    {
                        "sense_id": "d46c548e-814f-3a0a-8343-0c21b150e659",
                        "entry_id": "82c43181-7923-308c-86f5-ac955909908f",
                        "glosses": [
                            "myśl, idea, przekonanie itp. uporczywie kogoś prześladujące, niemożność uwolnienia się od takich myśli lub od wykonywania powtarzających się czynności"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5c9302-bda4-4e45-9b9f-ccead6181887",
                                "sense_id": "d46c548e-814f-3a0a-8343-0c21b150e659",
                                "text": "Ty masz jakąś obsesję, wszędzie ją widzisz, zapomnij o niej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "001b3eca-8ae4-3cb1-8fe9-c5098682aec9",
                        "entry_id": "82c43181-7923-308c-86f5-ac955909908f",
                        "glosses": [
                            "objaw choroby (nerwicy lub psychonerwicy), polegający na uporczywych myślach i czynnościach i niemożności uwolnienia się od nich"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "0e195709-265b-4d18-b60d-ba610d2b8fa0",
                                "sense_id": "001b3eca-8ae4-3cb1-8fe9-c5098682aec9",
                                "text": "Chory ma obsesję na punkcie żywienia, liczenia kalorii, ćwiczeń fizycznych i wyglądu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
