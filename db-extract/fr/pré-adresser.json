                "senses": [
                    {
                        "sense_id": "751b53bd-0fce-38a3-ae17-0373d59c49ca",
                        "entry_id": "f22d7a60-bfec-3e40-a497-53c98220b1d4",
                        "glosses": [
                            "Inscrire à l’avance l’adresse sur (une enveloppe, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5443fa3a-6224-40d5-a65b-487bbbf04c2e",
                                "sense_id": "751b53bd-0fce-38a3-ae17-0373d59c49ca",
                                "text": "Il est possible de personnaliser et de pré-adresser en production mailings et encarts publicitaires, ce qui élimine le temps et les frais engendrés par une impression séparée."
                            },
                            {
                                "example_id": "9ef7bc0f-b54e-4d11-9313-47aeb6939526",
                                "sense_id": "751b53bd-0fce-38a3-ae17-0373d59c49ca",
                                "text": "Afin d'être certain que les cartes postales arrivent à bon port, nous demandons aux parents des minis et des middels de bien vouloir pré-adresser les enveloppes."
                            }
                        ]
                    }
