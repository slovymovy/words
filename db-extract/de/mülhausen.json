                "senses": [
                    {
                        "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                        "entry_id": "eeeb67a3-377a-3b85-917e-467793847c18",
                        "glosses": [
                            "französische Stadt im Oberelsass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8661d161-7a20-4761-a842-8204cf7e9fb2",
                                "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                                "text": "Von 1870 bis 1919 gehörte Mülhausen zu Deutschland respektive dem Deutschen Kaiserreich."
                            },
                            {
                                "example_id": "8b57d045-71f3-426f-91a8-a2fa265f3697",
                                "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                                "text": "Durch die deutsche Besetzung Frankreichs im zweiten Weltkrieg gehörte Mühlhausen für wenige Jahre wieder zu Deutschland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
