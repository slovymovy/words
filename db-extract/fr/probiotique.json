                "senses": [
                    {
                        "sense_id": "92112566-b6d7-3883-96ab-6fec086e5ed0",
                        "entry_id": "84dfe271-1e04-3f52-9423-8848f82f7b0e",
                        "glosses": [
                            "Qualifie des bactéries ou des levures vivantes ayant un effet bénéfique sur la santé, sans toutefois s’installer dans notre organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70590619-a40a-4224-9097-8cd5930a9cf4",
                                "sense_id": "92112566-b6d7-3883-96ab-6fec086e5ed0",
                                "text": "De fait, certaines études semblent démontrer l’existence de tels liens, laissant espérer la possibilité de traitements probiotiques visant à rééquilibrer le microbiote et la recherche de biomarqueurs précoces de certaines affections."
                            },
                            {
                                "example_id": "921ff3d4-f805-4996-bc75-51f6f8afc2cd",
                                "sense_id": "92112566-b6d7-3883-96ab-6fec086e5ed0",
                                "text": "Bactéries probiotiques."
                            }
                        ]
                    }
                ],
                "translations": [
