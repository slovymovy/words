                ],
                "senses": [
                    {
                        "sense_id": "ff46c80d-7edc-33e1-957d-e01d9f2a06eb",
                        "entry_id": "6c53159d-7a2a-349f-87b3-1eb1a35ade9d",
                        "glosses": [
                            "wierzchnie okrycie bez rękawów, zarzucone na ramiona, niekiedy krótsze, tylko do łokci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "830fa3b3-7379-4c0a-a483-acc6ef9152b6",
                                "sense_id": "ff46c80d-7edc-33e1-957d-e01d9f2a06eb",
                                "text": "W sztuczce magik zakrył chłopca peleryną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "59901701-f23a-3493-bec0-9a8394813464",
                        "entry_id": "6c53159d-7a2a-349f-87b3-1eb1a35ade9d",
                        "glosses": [
                            "część ubioru np. płaszcza, sukni, opadająca swobodnie z pleców"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac28aaf-c32d-4701-b70a-37ee987d7f79",
                                "sense_id": "59901701-f23a-3493-bec0-9a8394813464",
                                "text": "Do korytarza wparowała druga grupa szturmowców, eskortująca wysoką, ciemną postać w powłóczystej pelerynie i lśniącym czarnym hełmie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc5332fc-3036-460e-b8ce-7282f2c47a18",
                        "source_entry_id": "6c53159d-7a2a-349f-87b3-1eb1a35ade9d",
                        "source_sense_id": "ff46c80d-7edc-33e1-957d-e01d9f2a06eb",
                        "target_lang_word": "cloak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cabc68b-6245-3f8f-8789-9643c5e2a8f5",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A long outer garment worn over the shoulders covering the back; a cape, often with a hood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfa46e5-a800-4357-81c6-b38d36314e9c",
                                                "sense_id": "0cabc68b-6245-3f8f-8789-9643c5e2a8f5",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee674815-cc29-3cd8-9388-cee1cb65bdf8",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A blanket-like covering, often metaphorical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ec2a16-688c-4d6a-b6df-0c3a82736334",
                                                "sense_id": "ee674815-cc29-3cd8-9388-cee1cb65bdf8",
                                                "text": "Night hid her movements with its cloak of darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "That which conceals; a disguise or pretext."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd80a29f-0d66-459a-934f-8b332a6a0140",
                                                "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                                "text": "For neither at any time vſed wee flattering wordes, as yee knowe, nor a cloke of couetouſneſſe, God is witneſſe: […]"
                                            },
                                            {
                                                "example_id": "c47a3532-53ac-48ed-b14b-6927d9636933",
                                                "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                                "text": "And no Man is eſteemed any ways conſiderable for Policy, who wears Religion otherwiſe than as a Cloak; that is, as ſuch a Garment as may both cover and keep him warm, and yet hang looſe upon him too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652d8ab2-0582-3c7d-b585-2764f1026349",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A text replacement for an IRC user's hostname or IP address, making the user less identifiable."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cloak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f13fa39c-052b-3da3-acc1-d02df7bcdfdb",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To cover as with or like a cloak."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34d6adb-8512-45b9-beb0-698cd2b15d9c",
                                                "sense_id": "f13fa39c-052b-3da3-acc1-d02df7bcdfdb",
                                                "text": "He would hold her, just hold her, while his hands soothed the bare skin of her arms and the delicate fabric that cloaked her shoulders and her back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f9bf25-d8f8-3314-88b3-5f52bff26e95",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To cover up, hide or conceal."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f1c414-0b2b-4fae-bef0-a43a1db9b24e",
                                                "sense_id": "e2f9bf25-d8f8-3314-88b3-5f52bff26e95",
                                                "text": "It’s possible that some microbes don’t just take up residence in tumors but help them grow. They may cloak the tumor from the immune system, neutralize drugs or help tumors spread through the body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1ec633-9034-33eb-96bb-2305f3ffe407",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To render or become invisible via futuristic technology."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d02b98-c051-483e-aedd-dd6e45e5a92b",
                                                "sense_id": "5c1ec633-9034-33eb-96bb-2305f3ffe407",
                                                "text": "The ship cloaked before entering the enemy sector of space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e19a2386-d23e-438d-8bd2-bbb64d0efd7a",
                        "source_entry_id": "6c53159d-7a2a-349f-87b3-1eb1a35ade9d",
                        "source_sense_id": "ff46c80d-7edc-33e1-957d-e01d9f2a06eb",
                        "target_lang_word": "pèlerine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pèlerine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "599a2ef5-859c-3b7f-8dd1-ca865f3258d8",
                                        "entry_id": "45af92d7-eb21-35d5-b556-529e9d9ee3bc",
                                        "glosses": [
                                            "Celle qui, par piété, fait un voyage à un lieu de dévotion, un pèlerinage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7852b6f1-92b7-445e-bcff-81273be61f53",
                                                "sense_id": "599a2ef5-859c-3b7f-8dd1-ca865f3258d8",
                                                "text": "[…] la pèlerine qui s’avance pieds nus dans les montagnes de Jérusalem porte ainsi les présents sacrés qu’elle doit offrir au saint tombeau."
                                            },
                                            {
                                                "example_id": "3dc10009-7f1b-401e-ae47-ea8acf5d64f1",
                                                "sense_id": "599a2ef5-859c-3b7f-8dd1-ca865f3258d8",
                                                "text": "C’était une de ces pèlerines d’amour, comme on en trouve dans les anciennes histoires, qui avait suivi une étoile pour venir rendre la santé et la force à un vieux roi très puissant, couvert de gloire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "085d85b5-c8ce-38b7-90b9-01c094f6d47a",
                                        "entry_id": "45af92d7-eb21-35d5-b556-529e9d9ee3bc",
                                        "glosses": [
                                            "Large collet rajouté sur le manteau de pèlerin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                        "entry_id": "45af92d7-eb21-35d5-b556-529e9d9ee3bc",
                                        "glosses": [
                                            "Grand collet rabattu, qui couvre la poitrine et les épaules."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa356aa2-62d5-445a-adb2-71efdb02a0cd",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Il a le plumet au shako, le vaste manteau à pèlerine des nuits de pluie et de grands froids."
                                            },
                                            {
                                                "example_id": "4118a2e0-bf80-4ae7-a26f-bf37e9474a2a",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Très à son aise, il fit compliment à madame Martin des pèlerines de son carrick carmélite."
                                            },
                                            {
                                                "example_id": "efa03420-9b4b-4146-8203-62f2d28c95a2",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Elle le vit en long manteau gris à pèlerine, correct et calme, devant les omnibus des hôtels."
                                            },
                                            {
                                                "example_id": "efc0f98a-e047-447a-bd72-9818059c7c7a",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "La glace de l’armoire lui renvoya sa silhouette mince et noire, sa robe à petite pèlerine, le cercle de dentelle du col, ses mains croisées frileusement, blanches, sur l’étroite poitrine sombre."
                                            },
                                            {
                                                "example_id": "62bef168-569d-4df8-be45-7f83f273b639",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Elle était vêtue d’un manteau à pèlerine qui l’enveloppait, et coiffée d’une toque d’où pendait un voile à grosses fleurs brodées."
                                            },
                                            {
                                                "example_id": "f4a1ce91-eec8-4076-87ba-6ac94618b5b9",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Aussitôt l’intrus recula, baissa les yeux et, relevant les pans de sa pèlerine, affecta de se chauffer."
                                            },
                                            {
                                                "example_id": "9403e0c5-6d4f-4cf3-a1fb-2d60291e9adc",
                                                "sense_id": "52d8ec77-448c-3cae-9400-37d3d860b35c",
                                                "text": "Elle me montra sa tapisserie qui se décollait, les lames de son plancher qui se soulevaient. La pèlerine de laine à pendeloques qui emmaillotait ses épaules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pèlerine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d42e90d-b8b3-3df5-8469-4765366ee216",
                                        "entry_id": "c91f49d8-1b26-300d-b45f-2c9199e7a627",
                                        "glosses": [
                                            "Féminin singulier de pèlerin."
