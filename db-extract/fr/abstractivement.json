                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "68b09429-9d40-32ea-98b4-4663c3a61381",
                        "entry_id": "d50a046e-02ea-31ba-91aa-cab1f87e57b5",
                        "glosses": [
                            "En faisant abstraction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0737df1c-f045-42bd-b0d3-b6f26313f16b",
                                "sense_id": "68b09429-9d40-32ea-98b4-4663c3a61381",
                                "text": "On peut considérer abstractivement les qualités des corps."
                            },
                            {
                                "example_id": "30b0150f-3a83-4e43-b810-cb4f5f826282",
                                "sense_id": "68b09429-9d40-32ea-98b4-4663c3a61381",
                                "text": "Abstractivement parlant."
                            },
                            {
                                "example_id": "15f0e680-38b2-43c0-94c5-d9a9c7539677",
                                "sense_id": "68b09429-9d40-32ea-98b4-4663c3a61381",
                                "text": "Ces deux mots, employés abstractivement, n’ont point de synonyme exact, point d’équivalent dans les langues anciennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e5bf2ce-f633-3e0a-9f22-69d9a5d3cdc5",
                        "entry_id": "d50a046e-02ea-31ba-91aa-cab1f87e57b5",
                        "glosses": [
                            "De façon abstraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deefb6a2-85d9-4751-b84f-53873a61ca63",
                                "sense_id": "1e5bf2ce-f633-3e0a-9f22-69d9a5d3cdc5",
                                "text": "Pendant les derniers moments de mon séjour à Vendôme, Louis ne sentait plus l’aiguillon de la gloire, il avait, en quelque sorte, abstractivement joui de la renommée ; et après l’avoir ouverte, comme les anciens sacrificateurs qui cherchaient l’avenir au cœur des hommes, il n’avait rien trouvé dans les entrailles de cette Chimère."
                            }
                        ]
                    },
