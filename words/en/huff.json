{
    "word_family": [
        "huffy",
        "huffiness"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "59c4290b-3e19-3c1f-bdc2-7faa160cd879",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named Sarah <w>Huff</w>.",
                            "target_lang_translations": {
                                "ru": "Автора статьи зовут Сара <w>Хафф</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Huff</w> will be joining our meeting later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хафф</w> присоединится к нашему собранию сегодня во второй половине дня."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хафф",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2879100e-ef91-3ce4-8afd-54ae64a164d9",
                    "sense_definition": "A place name referring to various locations in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They are traveling through <w>Huff</w>, Indiana, on their way to the city.",
                            "target_lang_translations": {
                                "ru": "Они проезжают через <w>Хафф</w>, штат Индиана, по пути в город."
                            }
                        },
                        {
                            "text": "The small community of <w>Huff</w> is located in a rural part of the state.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Хафф</w> расположено в сельской части штата."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, относящееся к различным населенным пунктам в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хафф",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1c5fee5-0dd9-37a4-b015-54679b9f80a7",
                    "sense_definition": "A state of sudden anger or annoyance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left the room in a <w>huff</w> after the argument.",
                            "target_lang_translations": {
                                "ru": "Он вышел из комнаты <w>в сердцах</w> после спора."
                            }
                        },
                        {
                            "text": "She was in a <w>huff</w> because her plans were cancelled.",
                            "target_lang_translations": {
                                "ru": "Она <w>была в раздражении</w>, потому что ее планы отменились."
                            }
                        }
                    ],
                    "synonyms": [
                        "tantrum",
                        "fit"
                    ],
                    "common_phrases": [
                        "in a huff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние внезапного гнева или раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспышка гнева",
                                "target_lang_sense_clarification": "состояние раздражения"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "чувство досады"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0f39e41-df06-3516-acc5-357e2fc51d8d",
                    "sense_definition": "A short, heavy breath or puff of air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a <w>huff</w>, she finally reached the top of the stairs.",
                            "target_lang_translations": {
                                "ru": "С <w>тяжелым выдохом</w> она наконец добралась до вершины лестницы."
                            }
                        },
                        {
                            "text": "The runner let out a <w>huff</w> as he finished the race.",
                            "target_lang_translations": {
                                "ru": "Бегун <w>тяжело выдохнул</w>, закончив забег."
                            }
                        }
                    ],
                    "synonyms": [
                        "puff",
                        "gasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, тяжелый выдох или поток воздуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыхтение",
                                "target_lang_sense_clarification": "звук тяжелого дыхания"
                            },
                            {
                                "target_lang_word": "тяжелый выдох",
                                "target_lang_sense_clarification": "резкий выдох"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5dec9ba1-be84-3bc0-953d-22561ffb8200",
                    "sense_definition": "To breathe loudly and heavily, often due to physical exertion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>huffing</w> after running through the park.",
                            "target_lang_translations": {
                                "ru": "Собака <w>пыхтела</w> после бега по парку."
                            }
                        },
                        {
                            "text": "They were <w>huffing</w> and puffing while climbing the steep hill.",
                            "target_lang_translations": {
                                "ru": "Они <w>пыхтели</w>, взбираясь на крутой холм."
                            }
                        }
                    ],
                    "synonyms": [
                        "pant",
                        "gasp"
                    ],
                    "common_phrases": [
                        "huffing and puffing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дышать громко и тяжело, часто из-за физической нагрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыхтеть",
                                "target_lang_sense_clarification": "тяжело дышать при нагрузке"
                            },
                            {
                                "target_lang_word": "отдуваться",
                                "target_lang_sense_clarification": "тяжело дышать после усилий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52ca69c3-736c-33a1-a6f5-6217df9aba0f",
                    "sense_definition": "To express annoyance or anger in a loud or arrogant way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>huffed</w> that she did not want to help with the project.",
                            "target_lang_translations": {
                                "ru": "Она <w>фыркнула</w>, что не хочет помогать с проектом."
                            }
                        },
                        {
                            "text": "He <w>huffed</w> at the suggestion that he was wrong.",
                            "target_lang_translations": {
                                "ru": "Он <w>фыркнул</w> в ответ на предположение, что он неправ."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "grumble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать раздражение или гнев громким или высокомерным способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фыркать",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать раздражение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}