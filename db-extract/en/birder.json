                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694c9574-28d6-414b-9a1b-396d57809f01",
                                "sense_id": "e1d9548e-43b1-3e37-8c21-931521b7418d",
                                "text": "Many of the crofters on Fair Isle and Shetland know as much about the birds as the birders."
                            },
                            {
                                "example_id": "4c84a7bd-4160-4f6a-960c-cf077b1851e6",
                                "sense_id": "e1d9548e-43b1-3e37-8c21-931521b7418d",
                                "text": "It's good to be the king. Even if the kingdom is rather small. It is amazing how often really good birders are borderline megalomaniacs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8166df2-9ee7-36e9-8fab-f3c08a5fc9c6",
                        "entry_id": "6a706d33-d0bc-3e25-a661-452bf2d79f86",
                        "glosses": [
                            "A person who hunts birds."
