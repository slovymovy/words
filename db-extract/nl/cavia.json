                        "source_entry_id": "e4f4519d-669b-3fcb-9769-1eac70712a20",
                        "source_sense_id": "397fe385-fae1-328a-82ef-7022c715f39e",
                        "source_sense_description": "benaming voor knaagdieren uit het geslacht Cavia",
                        "target_lang_word": "cobaye",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cobaye",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8db3f47e-12ae-3641-b463-18bc8c5b190e",
                                        "entry_id": "14cb6926-c5a6-3b8d-861a-a743d6ab31e2",
                                        "glosses": [
                                            "Petit mammifère appelé aussi cochon d’Inde, rongeur d’origine sud-américaine."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68edb0c-8072-4747-9c95-0fe948a7f58f",
                                                "sense_id": "8db3f47e-12ae-3641-b463-18bc8c5b190e",
                                                "text": "Les cobayes ne sont pas des porcs et ne viennent pas d’Inde!"
                                            },
                                            {
                                                "example_id": "5e73faaa-607d-4778-b2a3-c4bc0f5bde02",
                                                "sense_id": "8db3f47e-12ae-3641-b463-18bc8c5b190e",
                                                "text": "Le cobaye, étant un mammifère « nidifuge », présente un cerveau presque entièrement mature dès la naissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6f3e56-ebad-3ae6-9e7a-d73feee674a1",
                                        "entry_id": "14cb6926-c5a6-3b8d-861a-a743d6ab31e2",
                                        "glosses": [
                                            "Animal servant à une expérience scientifique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84c7b49-3612-4a33-bc97-c713c63ccce4",
                                                "sense_id": "ea6f3e56-ebad-3ae6-9e7a-d73feee674a1",
                                                "text": "C’est également le cas des cobayes de laboratoire, lesquels ont été soumis à toutes sortes d'expériences cruelles à travers les siècles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603e2347-49ed-3180-ad01-a17c9912bf6e",
                                        "entry_id": "14cb6926-c5a6-3b8d-861a-a743d6ab31e2",
                                        "glosses": [
                                            "Sujet volontaire ou non d’expériences."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bed0700-fe63-42f4-872f-a74484dbcf1f",
                                                "sense_id": "603e2347-49ed-3180-ad01-a17c9912bf6e",
                                                "text": "Pendant tout ce temps, j’appris mon métier. Quelques clients, patients cobayes, acceptèrent mes erreurs; d’autres s’offusquèrent. La nature réparait les dégâts, dans l’ensemble je m’en sortais. Cela me valut une réputation."
                                            },
                                            {
                                                "example_id": "a13efe49-7c60-423c-b163-9daa9ed9d314",
                                                "sense_id": "603e2347-49ed-3180-ad01-a17c9912bf6e",
                                                "text": "On est effaré de constater que ceux et celles qui ont passé leur enfance à Ungemach ne savaient pas du tout qu’ils étaient des cobayes, qu'ils participaient à une expérience eugéniste."
                                            },
                                            {
                                                "example_id": "ebd3c6de-7532-4c8d-bd0d-e748779e9159",
                                                "sense_id": "603e2347-49ed-3180-ad01-a17c9912bf6e",
                                                "text": "Le communisme est une expérience et le peuple russe, un cobaye."
                                            },
                                            {
                                                "example_id": "a04757ce-45dd-4506-a5e8-8dbc97fde946",
                                                "sense_id": "603e2347-49ed-3180-ad01-a17c9912bf6e",
                                                "text": "Nos enfants ne sont pas les cobayes des réseaux sociaux (...) a déclaré Breton."
                                            }
                                        ]
                                    }
                                ]
                            },
