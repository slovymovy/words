                "senses": [
                    {
                        "sense_id": "fbe66bb1-05db-3ebf-a350-bec95ebbd418",
                        "entry_id": "fbe49be2-fb8f-32ef-87e4-c4acae74ee07",
                        "glosses": [
                            "Donner un caractère luxembourgeois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f2a6fb-3a2d-4923-b691-c6b3caf1c5cf",
                                "sense_id": "fbe66bb1-05db-3ebf-a350-bec95ebbd418",
                                "text": "D’ailleurs, il pousse les luxembourgismes à leur extrême, allant jusqu’à « luxembourgiser » certains patronymes des participants (par exemple Mike Butcher devenant Metzlesch Mike)."
                            },
                            {
                                "example_id": "d960d73e-9add-4b36-8797-31c561eb0095",
                                "sense_id": "fbe66bb1-05db-3ebf-a350-bec95ebbd418",
                                "text": "Quelle étape pour ce fidèle coureur suédois un peu «luxembourgisé», au fil des années, et sixième au général!"
                            },
                            {
                                "example_id": "c07cf5ff-d8d4-4484-8af8-b4ecc18f97b2",
                                "sense_id": "fbe66bb1-05db-3ebf-a350-bec95ebbd418",
                                "text": "Apprécie-t-il au moins la fortune sous des apparences plus... abstraites : réserve de stock options, portefeuilles boursiers, placements off shore, participations de hedge funds, produits immobiliers, surcapitalisés, défiscalisés, luxembourgisés, and so on, and so on ?"
                            }
                        ]
                    }
