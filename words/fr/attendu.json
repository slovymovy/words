{
    "word_family": [
        "attente",
        "inattendu"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7875428a-3a32-3057-bc30-11025473f33e",
                    "sense_definition": "Participe passé du verbe <w>attendre</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>attendu</w> mon ami pendant une demi-heure devant la gare."
                        },
                        {
                            "text": "Elle a <w>attendu</w> patiemment que le médecin vienne la chercher."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "20a587e5-dc0c-3bbc-ad26-5dbbca4f7c83",
                    "sense_definition": "Que l'on espère ou que l'on guette avec impatience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel album de ce groupe est très <w>attendu</w> par les fans."
                        },
                        {
                            "text": "Cette décision ministérielle était particulièrement <w>attendue</w> par les enseignants."
                        }
                    ],
                    "common_phrases": [
                        "très attendu",
                        "album très attendu"
                    ]
                },
                {
                    "sense_id": "de9a678e-8d9a-3594-810c-7c6d0c014e7e",
                    "sense_definition": "Que l'on a prévu à l'avance, auquel on s'attend.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament a produit le résultat <w>attendu</w> dès les premiers jours."
                        },
                        {
                            "text": "La défaite de cette équipe n'était pas le dénouement <w>attendu</w>."
                        }
                    ],
                    "synonyms": [
                        "prévu"
                    ],
                    "antonyms": [
                        "inattendu"
                    ],
                    "common_phrases": [
                        "résultat attendu",
                        "effet attendu"
                    ]
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "543346c6-559b-3bee-9578-c81050947050",
                    "sense_definition": "Étant donné, compte tenu de, en considération de.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Attendu</w> les circonstances exceptionnelles, la réunion de travail a été reportée."
                        },
                        {
                            "text": "Le juge a réduit l'amende, <w>attendu</w> la situation financière précaire du prévenu."
                        }
                    ],
                    "common_phrases": [
                        "attendu les circonstances",
                        "attendu son jeune âge"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e11c699-476d-35a8-a36d-930aa5b61e23",
                    "sense_definition": "Compétence, connaissance ou exigence requise dans un cursus ou un programme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les professeurs ont clairement expliqué les <w>attendus</w> du programme aux nouveaux élèves."
                        },
                        {
                            "text": "La maîtrise du calcul mental constitue l'un des principaux <w>attendus</w> de ce cours."
                        }
                    ],
                    "common_phrases": [
                        "attendus du programme",
                        "attendus de fin d'année"
                    ]
                },
                {
                    "sense_id": "a542dc43-0dc8-3cf8-bf0c-9cf8dd672612",
                    "sense_definition": "Motif ou raison de droit sur lequel un tribunal fonde sa décision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense a attentivement examiné les <w>attendus</w> du jugement."
                        },
                        {
                            "text": "La cour a précisé les motifs de sa décision dans les <w>attendus</w> de l'arrêt."
                        }
                    ],
                    "common_phrases": [
                        "attendus du jugement"
                    ]
                }
            ]
        }
    ]
}