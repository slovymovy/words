                        "glosses": [
                            "Vorgang der Ablagerung von Kalk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87e0394-400f-43fe-bf24-0dc8b34efdb0",
                                "sense_id": "f8658523-43db-399c-994e-e2b9e3d8fad5",
                                "text": "Die Ablagerung von Kalk ist der im Wasser gelöste Kalkanteil, der bei Verdunstung zurückbleibt und als weiße Verkalkung sichtbar ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8003b06b-386d-370a-bac9-82ae6d6fe630",
                        "entry_id": "b739ea47-45d4-3b03-b2bf-c902f493c0a9",
                        "glosses": [
                            "Verhärtung der Arterien mit zunehmendem Lebensalter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283000bc-1e83-4b69-9556-97573944de41",
                                "sense_id": "8003b06b-386d-370a-bac9-82ae6d6fe630",
                                "text": "Die Verkalkung der Artieren ist zurückzuführen auf eine ungute Ernährung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1fe92d04-3884-3761-be01-e18bef61c4ce",
                        "entry_id": "b739ea47-45d4-3b03-b2bf-c902f493c0a9",
                        "glosses": [
                            "der Verlust an Geisteskraft im Alter"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "48bf737d-cdd4-4059-868d-25ea77263f05",
                                "sense_id": "1fe92d04-3884-3761-be01-e18bef61c4ce",
                                "text": "Manch älterer Herr oder ältere Dame wird im Alter tüdelich und man spricht von Omas oder Opas Verkalkung."
                            }
                        ],
