                        "examples": [
                            {
                                "example_id": "0dd0941f-dd49-466f-9c77-98bf1e33b693",
                                "sense_id": "5e244160-721c-3565-b96e-577eb8bb07d5",
                                "text": "With the exception of deals, the quantity of goods left unshipped is very trifling."
                            },
                            {
                                "example_id": "bb1085cb-717a-4f10-a936-42836885aa06",
                                "sense_id": "5e244160-721c-3565-b96e-577eb8bb07d5",
                                "text": "If the invoice didn't match the sales order, the unshipped goods remain on the sales order."
                            },
                            {
                                "example_id": "365d6471-ae7b-47b7-9d8c-cb743a41f472",
                                "sense_id": "5e244160-721c-3565-b96e-577eb8bb07d5",
                                "text": "If you can't get consent, you must, without being asked, refund the money the customer paid you for the unshipped merchandise."
                            }
                        ]
                    }
