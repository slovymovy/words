                "senses": [
                    {
                        "sense_id": "a950cc68-124a-36d3-917e-51511d8849c2",
                        "entry_id": "2a3dafd4-43b0-318d-9532-ff75d221b623",
                        "glosses": [
                            "Champignon (lepiota) de la famille des agaricacées, écailleux, souvent comestible (hormis certaines variétés de petite taille)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc0f14c-e9a6-4a05-95a0-294955df736e",
                                "sense_id": "a950cc68-124a-36d3-917e-51511d8849c2",
                                "text": "Il s’agit pourtant d’un basidiomycète Lepiotaceae, c’est-à-dire d’un champignon supérieur à chapeau, et plus précisément d’une lépiote dont notre coulemelle fait partie."
                            },
                            {
                                "example_id": "79b68650-0753-4a5c-bd62-1a5116b7a1ac",
                                "sense_id": "a950cc68-124a-36d3-917e-51511d8849c2",
                                "text": "Mon père, don Deodato Nibal y Milcar, adorait cueillir des champignons. Dans la forêt de Fontainebleau, il avait ramassé un plein panier de lépiotes couronnées qu’il avait cuisinées lui-même."
                            },
                            {
                                "example_id": "1f8a85e6-5f2e-4735-8135-25cc391c2547",
                                "sense_id": "a950cc68-124a-36d3-917e-51511d8849c2",
                                "text": "Je peux citer l’exemple des agarics aux lamelles roses, qui ne sont pas forcément des rosés-des-prés, ou des lépiotes, dont les formes toxiques se confondent très facilement avec des coulemelles."
                            }
                        ]
                    }
                ],
