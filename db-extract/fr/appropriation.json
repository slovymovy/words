        "fr-extract.jsonl": [
            {
                "entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                "word": "appropriation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1af4d9c-ba2e-45f2-adb1-f88b73165e3a",
                        "entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "appropriations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                        "entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "glosses": [
                            "Action d’approprier ou de s’approprier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca2d38e9-7c7f-4002-adcf-af66acc92ee7",
                                "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                                "text": "Aussi les travaux d'appropriation et de défense du fort furent-ils continués."
                            },
                            {
                                "example_id": "ccf7aa3b-f476-479f-a0a6-e1401bd82e3e",
                                "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                                "text": "Bien qu’il fût meublé de fond en comble, prêt à recevoir son propriétaire, M. Donis, en s’y installant, avait fait entreprendre quelques travaux d’appropriation commandés par ses goûts et ses habitudes."
                            },
                            {
                                "example_id": "bd528fdc-19aa-4518-8bfb-a5bd9b4ecf50",
                                "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                                "text": "Lorsque l’homme a considéré son semblable comme une chose susceptible d’appropriation, la femme a été purement et simplement l’esclave de son mari."
                            },
                            {
                                "example_id": "2a0a072b-b7ea-43e9-a04f-54b14b7c3294",
                                "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                                "text": "En somme, il appartenait à la race qui avait fait l’Angleterre et l’Amérique ce qu’elles étaient. […] : sa personne constituait simplement un individu agressif, doué d’un sens aigu de l’appropriation, sans aucun sentiment de la cohésion de l’État, sans loyauté, sans dévouement, sans code d’honneur et même sans code de courage."
                            },
                            {
                                "example_id": "1d0281b0-b2ae-4334-8bf0-3418edcf4230",
                                "sense_id": "8c7ce68f-cc39-3d72-ba31-4eb89e06ab42",
                                "text": "Pourtant les raisons qui fondent l’exigence de l’appropriation sociale des principaux moyens de production, d’échange, de financement et de communication n’ont pas disparu et se sont au contraire renforcées."
                            }
                        ]
                    },
                    {
                        "sense_id": "30aa56ce-3f40-3ac9-9317-c6122ddde7e7",
                        "entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "glosses": [
                            "Participation active de la partie bénéficiaire à un projet de développement et volonté d'en assumer la responsabilité."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a6ae098f-6116-3db5-abe6-7e20479c22a8",
                        "entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "glosses": [
                            "Adhésion à une proposition et volonté de la reprendre à son compte."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11bda878-4702-46d1-af6c-d5ea40445244",
                        "source_entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "source_sense_description": "1",
                        "target_lang_word": "Einrichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einrichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c8857ad-b392-3aea-9f67-36f9bd1ba2ea",
                                        "entry_id": "9e415b67-2c7d-30c3-8fca-07b558f5ee50",
                                        "glosses": [
                                            "die Handlung, etwas zu gründen oder zu erstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a079c423-acbd-4ef2-8b28-34eed1250e12",
                                                "sense_id": "9c8857ad-b392-3aea-9f67-36f9bd1ba2ea",
                                                "text": "Die Einrichtung eines internationalen Sicherheitsrates wurde beschlossen."
                                            },
                                            {
                                                "example_id": "6ccc4311-d258-4b1e-b292-c1c88e73faf4",
                                                "sense_id": "9c8857ad-b392-3aea-9f67-36f9bd1ba2ea",
                                                "text": "„Nach Einrichtung des Weltpostvereins und seines Standardportos verzeichnet der überseeische Postverkehr ebenso wie die Postdienste der beteiligten Länder gänzlich unerwartete Zuwachsraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47a0832e-7f69-31b6-a94b-05f872eb86aa",
                                        "entry_id": "9e415b67-2c7d-30c3-8fca-07b558f5ee50",
                                        "glosses": [
                                            "(Wohnung) Möbel und Dekoration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c46d04-1777-4b54-9e00-8b1f2c76a3d0",
                                                "sense_id": "47a0832e-7f69-31b6-a94b-05f872eb86aa",
                                                "text": "Ich habe ihr die Einrichtung der Büros überlassen."
                                            },
                                            {
                                                "example_id": "810d16a4-5032-4ef4-9172-8a683692ea49",
                                                "sense_id": "47a0832e-7f69-31b6-a94b-05f872eb86aa",
                                                "text": "„Die Kellnerin war muffig, die Einrichtung strahlte den herben Charme des real existierenden Sozialismus aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f3617a8c-3e68-3758-af13-ac34c76145a9",
                                        "entry_id": "9e415b67-2c7d-30c3-8fca-07b558f5ee50",
                                        "glosses": [
                                            "Ort/Organisation, die zu einem bestimmten Zweck errichtet oder aufgebaut wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c7c6f0-2fbe-484f-9ecd-27ba2e4f9358",
                                                "sense_id": "f3617a8c-3e68-3758-af13-ac34c76145a9",
                                                "text": "Dort befinden sich unsere sanitären Einrichtungen."
                                            },
                                            {
                                                "example_id": "8e9a7306-5e89-4864-b999-ff96f534320d",
                                                "sense_id": "f3617a8c-3e68-3758-af13-ac34c76145a9",
                                                "text": "„Eingeladen waren rund 170 Leiterinnen und Leiter unterschiedlichster Einrichtungen wie etwa Stiftungen, Museen oder Gedenkstätten.“"
                                            },
                                            {
                                                "example_id": "236ec0af-6549-4c3a-a484-74265c85fffb",
                                                "sense_id": "f3617a8c-3e68-3758-af13-ac34c76145a9",
                                                "text": "„In Russland sind Drogensüchtige geächtet, es gibt kaum Einrichtungen, die sie behandeln.“"
                                            },
                                            {
                                                "example_id": "a3ba7e63-ad73-4cee-b2ec-618716dbf40b",
                                                "sense_id": "f3617a8c-3e68-3758-af13-ac34c76145a9",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Wohlhabende Juden engagierten sich häufig sozial und förderten kulturelle Einrichtungen wie Theater und Museen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1abf6673-903b-3dd6-8f0e-0929286c15a8",
                                        "entry_id": "9e415b67-2c7d-30c3-8fca-07b558f5ee50",
                                        "glosses": [
                                            "ein elektronisches oder technisches Gerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b7af93-49c2-4d70-a55c-cbd8e3d82023",
                                                "sense_id": "1abf6673-903b-3dd6-8f0e-0929286c15a8",
                                                "text": "Die mechanische Einrichtung wird auf den Zylinder festgeschraubt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f955d610-7438-371a-afc9-d87e3dd92c3c",
                                        "entry_id": "9e415b67-2c7d-30c3-8fca-07b558f5ee50",
                                        "glosses": [
                                            "Vorbereitung eines Computers, um mit ihm arbeiten zu können"
                                        ],
                                        "tags": [
                                            "Computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "733359cb-aae3-4df2-9aae-9296d04ee5f5",
                                                "sense_id": "f955d610-7438-371a-afc9-d87e3dd92c3c",
                                                "text": "Der Admin wird die Einrichtung der Software für sie übernehmen."
                                            },
                                            {
                                                "example_id": "e22f5311-0e14-4c87-a226-bc3e423bbc32",
                                                "sense_id": "f955d610-7438-371a-afc9-d87e3dd92c3c",
                                                "text": "„Die meisten Bauten in Yamoussoukro wurden aus der Kasse des Präsidenten, eines vermögenden Mannes, und aus französischen Entwicklungshilfe-Geldern finanziert. Dazu gehört auch die Universität, die mit ihren modernen Computereinrichtungen, Sportstadien und Schwimmbädern jeden europäischen Rektor vor Neid erblassen ließe. Knapp hundert meist französische Professoren wurden engagiert, um dort dreihundert Studenten zu unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fb7b5ed-48cc-482f-88af-97aacf600a83",
                        "source_entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "source_sense_description": "1",
                        "target_lang_word": "Zueignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zueignung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33ec93e1-dee1-3188-bb82-d5b633f93391",
                                        "entry_id": "dba7d2c9-02f3-3713-9e8b-017a5824172b",
                                        "glosses": [
                                            "eine Widmung an jemanden"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "154f76a9-a906-4b8d-a8ac-ab614d5ef27d",
                                                "sense_id": "33ec93e1-dee1-3188-bb82-d5b633f93391",
                                                "text": "Die Zueignung des Autors fand ich übertrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91d7ed52-1ad1-37a7-8379-53e4137456ff",
                                        "entry_id": "dba7d2c9-02f3-3713-9e8b-017a5824172b",
                                        "glosses": [
                                            "die unrechtmäßige Inbesitznahme von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23031259-7fbf-40b6-8235-a93ff9b4ef1c",
                                                "sense_id": "91d7ed52-1ad1-37a7-8379-53e4137456ff",
                                                "text": "Wegen der Zueignung eines MP3-Players musste Eugen eine Strafe zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "451fff17-7956-4bd7-9f1e-113bf38ba245",
                        "source_entry_id": "bf5a7c16-d4e8-3d6c-a91a-164cc33026ec",
                        "source_sense_description": "1",
                        "target_lang_word": "Aneignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aneignung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Inbesitznahme einer herrenlosen Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21153ecf-1dee-498e-835d-c678598bf082",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Mit der privaten Aneignung des Grund und Bodens, der sowohl als wichtigstes Produktionsmittel als auch als Produktionsgegenstand diente, war auch die private Aneignung des Viehs verbunden.“"
                                            },
                                            {
                                                "example_id": "ad1b9df3-1c23-460f-8326-9c1ddc86c28c",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Dazu wurde vertreten, dass sich die Aneignung von herrenlosem Land in Deutsch-Südwestafrika nicht als besonderes Vorrecht des Schutzgebietsfiskus darstelle, da es auch von Privaten ausgeübt werden könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "unrechtmäßige Inbesitznahme einer Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98dae93-56cc-484f-9095-3b5514eae51e",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Die englische Herrschaft über Irland ging in den folgenden 200 Jahren mit einer weitgehenden Aneignung des Grundbesitzes durch die Engländer und einer Lähmung der irischen Wirtschaft einher.“"
                                            },
                                            {
                                                "example_id": "5a085802-1310-4ae1-b285-c2dd0df010d4",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„So raubte der IS etwa beim Einmarsch in Mossul im vergangenen Jahr Millionen von Dollar aus den Tresoren der örtlichen Banken – ganz zu schweigen von der Aneignung des Militärgeräts der irakischen Armee, die Hals über Kopf aus der Stadt geflüchtet war und den Terroristen damit einiges an Ausgaben ersparte.“"
                                            },
                                            {
                                                "example_id": "a42dc293-9d2c-466b-ad56-ccc410d5f490",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Chinas historische Begründung für seine Expansion im Südchinesischen Meer ist nicht anerkannt und mit der Aneignung der Inseln verstößt China gegen das Seerechtsübereinkommen der Vereinten Nationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Erwerb von Wissen, Fähigkeiten, Verhaltensweisen, Ideologien oder Ähnlichem, beispielsweise durch Lernen, Üben oder Angewöhnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e014f35c-d498-41dc-9384-18612d9c07d6",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Die Aneignung einer Fremdsprache unterscheidet sich von der Aneignung einer Zweitsprache primär dadurch, dass der erste Prozess nur auf einige Stunden pro Woche reduziert ist.“"
                                            },
                                            {
                                                "example_id": "65f65ea2-2903-4842-b108-2f98df256d2e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Trotz der Aneignung von Traditionen bleibt Picasso immer er selbst.“"
                                            },
                                            {
                                                "example_id": "9bb334ba-5629-4556-9c75-719b4883e0a3",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Übersehen wird dabei, dass es beim Denglischen nicht um eine aktive, aufgeschlossene Aneignung des Fremden geht, sondern um eine wachsende sprachliche Monokultur auch unter den Intellektuellen.“"
                                            },
                                            {
                                                "example_id": "f5692867-042b-4ccb-a28e-95f8e23a280e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Der Traditionsbruch und die Öffnung zum Westen, zu dem ja auch die teilweise Aneignung des Leninismus gehört, hätten es tatsächlich geschafft, dass sich die Nation jetzt gegenüber dem Westen behaupten könne - was jedoch keineswegs heißt, dass historische Kontinuitäten als Legitimationsquelle für die Kommunisten nicht wichtig wären.“"
                                            },
                                            {
                                                "example_id": "a6f32482-30e2-43f5-a2a0-72ad68c163b4",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Zentral sei in der Wiener Lehrerausbildung nun die Aneignung von etwa 30 Kernkompetenzen wie zum Beispiel der Innovationskompetenz, der Reflexionskompetenz, der Prüfungskompetenz, des Durchhaltevermögens oder gar der Kompetenzorientierungskompetenz.“"
                                            },
                                            {
                                                "example_id": "1a5b930a-3ba3-4879-938f-3c866ee7640e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Musik sei entstanden durch Vermischung der Kulturen und Wanderung. Er mache die Musik, die er fühle. ‚Wenn jemand anders sagt, das ist kulturelle Aneignung, dann interessiert mich das einen Scheißdreck‘, so Schneider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
