                    {
                        "translation_id": "8c0afb77-80bc-4ab9-8b77-0c1fca02e76a",
                        "source_entry_id": "dc1eafe6-26f7-3d98-83fd-fd4657460f16",
                        "source_sense_id": "0312184d-a2ba-3c70-a670-70eed8215039",
                        "target_lang_word": "salzburgisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salzburgisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                        "entry_id": "56ff8344-70c3-3af2-b9b7-edd534de8734",
                                        "glosses": [
                                            "Salzburg oder die Salzburger betreffend; aus Salzburg oder von den Salzburgern stammend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de48ffcb-cffa-40c0-82c3-b84a49f1a79b",
                                                "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                                "text": "Die Produktion der DVDs und Blu-ray-Discs wird im zweiten salzburgischen Sony-Werk Thalgau gebündelt."
                                            },
                                            {
                                                "example_id": "f1062027-7dbe-4ff8-8597-c2aa4f5dfca0",
                                                "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                                "text": "So soll im salzburgischen Pinzgau ein Erschließungsprojekt mit der Begründung genehmigt worden sein, dass im Nachbarland Tirol der Seilbahnbau gerade boomen würde."
                                            },
                                            {
                                                "example_id": "16cd677b-ddc1-4c71-b977-bcb21247862c",
                                                "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                                "text": "Im salzburgischen Mattsee etwa können Lust und Leidenschaft beim sechsgängigen aphrodisischen Valentinsmenü samt Klavierbegleitung und Kerzenschein durchaus ein wenig zu Bauche schlagen."
                                            },
                                            {
                                                "example_id": "aa2de3d3-191f-4b88-8a15-929e346c02a4",
                                                "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                                "text": "Er kennt inzwischen alle seine Pappenheimer: Sein Publikum, seine Künstler, die salzburgischen und die philharmonischen Krämerseelen, seine Gönner weltweit und seine Mißgönner in Wien, und er weiß, was in Salzburg geht und was nicht."
                                            },
                                            {
                                                "example_id": "3f5664a0-791c-4b59-8415-d2333ae39bff",
                                                "sense_id": "898dc622-c603-3449-8712-32d37288bbb9",
                                                "text": "Vor hundert Jahren gelangte das erste Paar Skier ins salzburgische Saalbach-Hinterglemm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5fd2c0c-55fe-48c4-ab19-4afebc4ccc14",
                        "source_entry_id": "dc1eafe6-26f7-3d98-83fd-fd4657460f16",
                        "source_sense_id": "0312184d-a2ba-3c70-a670-70eed8215039",
                        "target_lang_word": "Salzburgian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salzburgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                        "entry_id": "3ae5a9ec-504d-3c83-9b47-52fff58ac750",
                                        "glosses": [
                                            "Of, from or relating to the Austrian state of Salzburg."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd840a61-f073-48f5-abdc-de39aaf15d48",
                                                "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                                "text": "There are few metals that do not occur in gueiss; in which are situated the greatest part of the Saxon, Bohemian, and Salzburgian mines."
                                            },
                                            {
                                                "example_id": "dee890f1-238b-48e9-9e9c-3d7a5efd3259",
                                                "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                                "text": "K 200 in C major is the second of these three symphonies: it is much more Salzburgian, and has its parallels in several sonata movements."
                                            },
                                            {
                                                "example_id": "60c57601-2d8e-4860-8ccf-53334be1eea0",
                                                "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                                "text": "Mozart presented this Mass, along with that in F and the Misericordias, to the prelate of the Holy Cross in Augsburg (as he informs his father on 20 November 1777)—which is surprising, for it is surely his weakest, his most Salzburgian, church work."
                                            },
                                            {
                                                "example_id": "9da2a52e-b8f7-4c67-8022-3aadab67ef4c",
                                                "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                                "text": "The Salzburgian petition reported that they were able to \"lead a quiet and peaceable life\" without slaves, causing them to \"laugh at such talking\" by proponents of slavery that it was \"impossible and dangerous for White People to plant and manufacture any rice. ...\""
                                            },
                                            {
                                                "example_id": "dc94a63b-e401-4f15-8a6e-1456e734e3dc",
                                                "sense_id": "59c5ca00-06d4-32f3-ba02-5bb2a4ac0789",
                                                "text": "Joseph Haydn and W. A. Mozart figure prominently, as do their more Salzburgian counterparts Michael Haydn and Leopold Mozart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Salzburgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "921c243f-66b7-3543-a902-4df30a582f69",
                                        "entry_id": "1cdfe535-ac91-3ab6-b4e8-c8038ab5b59a",
                                        "glosses": [
                                            "A native or inhabitant of the Austrian state of Salzburg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f9dff6-9453-41f6-b79c-d09ac64eb751",
                                                "sense_id": "921c243f-66b7-3543-a902-4df30a582f69",
                                                "text": "[…]one crosses over the Grand Place, on which stands the Cathedral, to the Mozart Place, so called from a statue of the celebrated composer, of whom the Salzburgians are so proud, and thence past the Government Palace to the Cajetan gate, and along the river to the new bridge."
                                            },
                                            {
                                                "example_id": "d4154d43-63cf-4f18-9056-8f1633aee362",
                                                "sense_id": "921c243f-66b7-3543-a902-4df30a582f69",
                                                "text": "Mozart often made merry over the Salzburgians; he called them stupid and envious."
                                            },
                                            {
                                                "example_id": "3ae4b55a-632b-414a-bb0a-05743ab1a511",
                                                "sense_id": "921c243f-66b7-3543-a902-4df30a582f69",
                                                "text": "Jackie and I strolled down the streets, each balancing a beverage and provoking many curious stares from passing Salzburgians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b68779a-bbe5-438f-b635-84270b66197d",
                        "source_entry_id": "dc1eafe6-26f7-3d98-83fd-fd4657460f16",
                        "source_sense_id": "0312184d-a2ba-3c70-a670-70eed8215039",
