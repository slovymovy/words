        "fr-extract.jsonl": [
            {
                "entry_id": "8ec06674-e492-37a2-b374-a6d8d9a4b545",
                "word": "insuline",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a97d465e-fc3e-4345-b25c-e5409ded7f03",
                        "entry_id": "8ec06674-e492-37a2-b374-a6d8d9a4b545",
                        "tags": [
                            "plural"
                        ],
                        "form": "insulines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                        "entry_id": "8ec06674-e492-37a2-b374-a6d8d9a4b545",
                        "glosses": [
                            "Protéine hormonale (polypeptide) hypoglycémiante produite par le pancréas, et dont le rôle est de permettre la mise en réserve, dans le foie ou les muscles, du sucre présent dans le sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8859514b-5f4e-44b0-9257-afcb50cfb8b2",
                                "sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                                "text": "Je me demandai soudain si avec la défaite et l’occupation l’insuline n’allait pas manquer en France."
                            },
                            {
                                "example_id": "6df810f2-825e-4846-99e6-3049e66023df",
                                "sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                                "text": "Des insulines pré-mélangées contenant insuline ordinaire et NPH existent."
                            },
                            {
                                "example_id": "33d49335-d3d7-48a3-8849-146e6ef8bd43",
                                "sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                                "text": "L’insuline de synthèse existe sous deux formes principales : l’insuline rapide (ou immédiate) et l’insuline lente (ou retard)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b35440f0-8f64-4d2b-bf85-73b58816e86d",
                        "source_entry_id": "8ec06674-e492-37a2-b374-a6d8d9a4b545",
                        "source_sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                        "target_lang_word": "Insulin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insulin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                        "entry_id": "d9d17ef8-c8e3-3cf7-8197-58c3129285dc",
                                        "glosses": [
                                            "Hormon, das den Blutzuckerspiegel im Körper senkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca68962-3e37-4301-bbf8-0e4083e5401f",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "Diabetiker müssen sich Insulin mit einer Spritze geben."
                                            },
                                            {
                                                "example_id": "923234b2-399a-4c90-b5cb-b9dde3e498c2",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "Die Hauptwirkung des Insulins für die rasche Senkung der Blutzuckerkonzentration ist seine „Schlüsselfunktion“ für den Transport von Glukose aus dem Blutplasma und aus der Gewebsflüssigkeit in das Zellinnere."
                                            },
                                            {
                                                "example_id": "862b3c30-9efd-45a6-a4ab-722b71bd8ace",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "„Die Nebennieren produzieren mehr Adrenalin und die Bauchspeicheldrüse mehr Insulin.“"
                                            },
                                            {
                                                "example_id": "dacd6809-e641-49be-92dc-daa379636a92",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "„Bei Morphinisten wurde Insulin gegen die Entziehungserscheinungen verwandt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c8e59e-4ab4-4604-8a4a-c4f9d0b32dc4",
                        "source_entry_id": "8ec06674-e492-37a2-b374-a6d8d9a4b545",
                        "source_sense_id": "f3be35d9-72a1-330c-8eda-977bfc1507c9",
                        "target_lang_word": "insulin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insulin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "A polypeptide hormone that regulates carbohydrate metabolism (in various animals including humans)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c6621ae-baf1-4814-915b-cd3ac2ca7edc",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Mommy said that Grandma's diabetes happened because her body stopped making its own insulin."
                                            },
                                            {
                                                "example_id": "cb29755b-e321-41c1-a065-8015da49289c",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Ask a dozen persons to tell you what they know about insulin and you will get some surprising and contradictory answers. The truth is this: Insulin is not a cure for diabetes, but it is helping to prolong and gladden lives."
                                            },
                                            {
                                                "example_id": "fe812126-6e53-48e8-8ccf-067daf93f7c8",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "Nationally the average insulin price nearly tripled from 2002 through 2013, and prices have risen 10% or more a year since then, forcing many diabetics to ration their insulin."
                                            },
                                            {
                                                "example_id": "6df88f62-815f-41ea-854b-cf8b22af0570",
                                                "sense_id": "3c33c9c9-aea8-355b-9553-34faeac66841",
                                                "text": "And that’s not all – EGCG in matcha can help improve insulin sensitivity, which aids in blood sugar control, and may help to reduce inflammation related to Alzheimer’s disease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80a55af9-5aa4-33ff-8c58-a5bcece60756",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "Any exogenous preparation of this hormone for use as a medication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "389b40ce-78b1-4b18-b067-4071b5c03e86",
                                                "sense_id": "80a55af9-5aa4-33ff-8c58-a5bcece60756",
                                                "text": "The advent of insulin in the mid-20th century changed the lives of millions of people with diabetes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a0c948-e5a1-30d4-9a00-79003f0fcd5b",
                                        "entry_id": "c6b6f75b-5929-3b2c-a0b3-bc6a1f9f9f6b",
                                        "glosses": [
                                            "Any exogenous preparation of this hormone or its analogues for use as a medication."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff988b5b-0dbf-4ff2-a1b4-63ed59ed596b",
                                                "sense_id": "f7a0c948-e5a1-30d4-9a00-79003f0fcd5b",
                                                "text": "A: What kind of insulin do you take? B: I use basal-bolus therapy, which in my case involves glargine and lispro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
