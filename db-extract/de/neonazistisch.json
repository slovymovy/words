                ],
                "senses": [
                    {
                        "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                        "entry_id": "d17156e2-bafd-35c5-85cb-7108767f2576",
                        "glosses": [
                            "auf dem Neonazismus beruhend, ihn betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77faf078-a320-45a5-a520-47ef22dd491c",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„In der Bundesrepublik Deutschland wies die 1949 gegründete Sozialistische Reichspartei stark neonazistische Züge auf.“"
                            },
                            {
                                "example_id": "627493d2-db2c-4d22-add6-826e283f71e4",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„In Spremberg drängt vor allem die neonazistische Kleinpartei \"Der Dritte Weg\" immer stärker in die Öffentlichkeit.“"
                            },
                            {
                                "example_id": "8c2da7c8-80e4-47ed-aa16-d3242d341ae9",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„[…] auf seinen Profilbildern auf einem Messengerdienst posiert er mit Sturmhaube, einer Gasmaske und mit dem Logo eines internationalen neonazistischen Netzwerks, […].“"
                            },
                            {
                                "example_id": "df0a71d9-cc49-41fb-ad21-bad4872eb70c",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Unter dem Motto \"Hamburg steht auf - gegen Rechtsextremismus und neonazistische Netzwerke\" haben am Freitagnachmittag Zehntausende Menschen auf dem Jungfernstieg demonstriert.“"
                            },
                            {
                                "example_id": "42827fe5-9747-4c45-91d0-8ccdb6019e96",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Zwischen 2000 und 2007 verübte die neonazistische Terrorgruppe \"Nationalsozialistischer Untergrund\" neun Morde an Migranten, den Mord an der Polizistin Michèle Kiesewetter und mehrere Bombenanschläge, darunter den Nagelbombenanschlag in Köln.“"
                            },
                            {
                                "example_id": "8829fb07-40a2-42f5-a642-15fd96bc4122",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Rechtsrock vermittelt rechtsextremes, neonazistisches und rassistisches Gedankengut auf unterschiedliche Art und Weise.“"
                            },
                            {
                                "example_id": "8d80b82d-7b20-4e01-86f9-e516593657f8",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Anfang der 1980er traten erstmals Bands auf, die neonazistische Botschaften über Lieder im Punk-Rock-Stil verbreiteten.“"
                            },
                            {
                                "example_id": "29d0d694-d886-43c7-b6ea-d7ae4d1605b4",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Die auch von den Nationalsozialisten verwendete Symbol der Wolfsangel ist in der neonazistischen Szene weltweit beliebt.“"
                            },
                            {
                                "example_id": "4284f7e9-d568-4b35-aed1-3266336dd115",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "[Polen:] „Doch immer mehr beeinträchtigen rechte Krawallmacher im Verbund mit neonazistischen Ideologen auch das gesellschaftliche Leben. Sie stören Veranstaltungen von feministischen oder homosexuellen Gruppen, diffamieren jüdische Mitbürger oder gehen gewalttätig gegen Minderheiten und Ausländer vor.“"
                            },
                            {
                                "example_id": "4e7af648-29ee-4046-92d4-52eddfa5204c",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Laurens Nothdurft war Ende der 90er Jahre Führungskader der Heimattreuen Deutschen Jugend, HDJ. Im Jahr 2009 wurde sie verboten - unter anderem wegen ihrer Wesensverwandtschaft zum Nationalsozialismus und zur Hitlerjugend. Eigentlich dürfte Nothdurft gar kein AfD-Mitglied sein, weil die Partei offiziell keine Mitglieder mit neonazistischer Vergangenheit aufnimmt.“"
                            },
                            {
                                "example_id": "d66ae68a-83d0-4c8a-aa38-f4ea99e5a606",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„2007 galt die HDJ bereits als eine der gefährlichsten rechtsextremen Organisationen, deren Ziel es war, neonazistische Ideen unter Kindern und Jugendlichen zu verbreiten.“"
                            },
                            {
                                "example_id": "35c23861-7b27-4db8-b4e7-f6fe2dc34dbf",
                                "sense_id": "631d319b-21dc-3662-bdc8-8987452211d5",
                                "text": "„Der Niedergang der bayerischen NPD ist eng verknüpft mit dem Namen Karl Richter. Der ist in München gerade wiedergewählt worden, als Stadtrat der neonazistischen Bürgerinitiative Ausländerstopp, einer Tarnliste der NPD.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
