                    {
                        "translation_id": "89935157-b8c2-49b5-ba16-02f932069598",
                        "source_entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                        "source_sense_description": "condition of being ugly",
                        "target_lang_word": "lelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
