                ],
                "senses": [
                    {
                        "sense_id": "5bdc9f97-5ac0-3010-9518-4286bd016ae5",
                        "entry_id": "d83a3239-ebee-3266-83bd-6c4c3956e297",
                        "glosses": [
                            "устар. то же, что гранёный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2724b49-6b78-4d3f-ba02-f7eef0fe1bae",
                                "sense_id": "5bdc9f97-5ac0-3010-9518-4286bd016ae5",
                                "text": "Сначала послы в грановитой палате представлялись царю, который сидел на троне в царском наряде и венце: по бокам трона стояли рынды в длинных белых одеждах, белых сапогах, в рысьих шапках, с топорами на плечах и золотыми цепями на груди."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e626e0c5-89b1-4f83-9432-0d50b66b717f",
                        "source_entry_id": "d83a3239-ebee-3266-83bd-6c4c3956e297",
                        "source_sense_id": "5bdc9f97-5ac0-3010-9518-4286bd016ae5",
                        "target_lang_word": "taillé à facettes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a9468cd8-1ca4-483c-b1b9-65c06eb8a191",
                        "source_entry_id": "d83a3239-ebee-3266-83bd-6c4c3956e297",
                        "source_sense_id": "5bdc9f97-5ac0-3010-9518-4286bd016ae5",
                        "target_lang_word": "anguleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anguleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f276c9af-d839-37b3-996d-d8d0fb91a043",
                                        "entry_id": "8c89b248-d030-3c67-9fc3-646ea13ae8ee",
                                        "glosses": [
                                            "Qui forme un ou plusieurs angles."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69c2369-e018-4b7f-b1a4-244d8ccf0967",
                                                "sense_id": "f276c9af-d839-37b3-996d-d8d0fb91a043",
                                                "text": "Fruit à maturité, long de 56 centimètres, légèrement anguleux ; peau presque lisse, d’un jaune orange."
                                            },
                                            {
                                                "example_id": "77680c0c-756c-45fd-b96d-41460cbcbb5e",
                                                "sense_id": "f276c9af-d839-37b3-996d-d8d0fb91a043",
                                                "text": "Puis tout se confondait, et les maisons, les toits aigus, les pignons formaient une seule masse, bizarrement découpée, dont la ligne anguleuse se détachait sur le couchant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1fdca3-ef24-382c-81b3-288fc32f8d97",
                                        "entry_id": "8c89b248-d030-3c67-9fc3-646ea13ae8ee",
                                        "glosses": [
                                            "Qualifie un visage dont les traits ont une saillie excessive."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd6c752-6fa1-46bc-95dd-842b51acd01c",
                                                "sense_id": "3b1fdca3-ef24-382c-81b3-288fc32f8d97",
                                                "text": "Anguleuse figure de la misère jalouse que l’on voit rôder sur le pavé de Paris, promenant son plan de fortune et le rêve de son assouvissement."
                                            },
                                            {
                                                "example_id": "1ebbe37a-0c35-4cc5-a7b3-182f23e0a3aa",
                                                "sense_id": "3b1fdca3-ef24-382c-81b3-288fc32f8d97",
                                                "text": "Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d’un fennec, souriait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b62fa9-d943-3a62-b6e2-9f026ccf2059",
                                        "entry_id": "8c89b248-d030-3c67-9fc3-646ea13ae8ee",
                                        "glosses": [
                                            "Qui est rude, difficile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1fe93f-21a7-4a4e-b51d-615d5be7cae4",
                                                "sense_id": "d2b62fa9-d943-3a62-b6e2-9f026ccf2059",
                                                "text": "Il n’y était pas parvenu et, brutalement, les apparences lisses comme des fonds sableux qui s’ouvrent laissaient surgir des colères, des sarcasmes, un caractère anguleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef9987c7-2f47-30d0-b532-663c3bd63cbb",
                                        "entry_id": "8c89b248-d030-3c67-9fc3-646ea13ae8ee",
                                        "glosses": [
                                            "En parlant d’un chiffre, qui n’est pas rond. → voir chiffre anguleux"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce158ee-c028-44bd-bbba-9c83c9422a9f",
                                                "sense_id": "ef9987c7-2f47-30d0-b532-663c3bd63cbb",
                                                "text": "Je me revois fixer les chiffres anguleux du radio-réveil de Rob, tandis que le sommeil me fuyait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
