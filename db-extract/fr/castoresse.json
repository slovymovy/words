                        "glosses": [
                            "Plus jeune catégorie de scoutes, entre 5 et 7 ans, ou entre 6 et 8 ans."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "8122e60c-d0b9-4428-ac4b-fd1f5997f0b1",
                                "sense_id": "963ab11a-23f7-3f09-a064-7e47edc70ffd",
                                "text": "Et plus tard le choix, un choix qui ressemblait fort, à vrai dire, à la complétion d’un destin, de rejoindre le corps des scoutesses. Là encore, elle avait été exemplaire : elle avait, un à un, gravi tous les échelons : de castoresse jusqu’à exploratrice, puis commissaire du conseil de patrouille, et bientôt guidénée ; et enfin — et majoresse de sa promotion, s’il vous plaît ! — cheftaine."
                            }
                        ]
                    }
