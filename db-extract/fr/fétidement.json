                        "glosses": [
                            "D’une façon malodorante, écœurante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82fa4e1-0ee3-4439-95ff-2bb0f9755812",
                                "sense_id": "ed784301-18f3-3732-8105-aad5b6b17c09",
                                "text": "Une maculature coiffait un rosier, en sorte que les fleurs de réthorique étaient embaumées par les fleurs avortées de ce jardin mal soigné, mais fétidement arrosé."
                            },
                            {
                                "example_id": "598ec3fa-82ea-43a8-9656-e80b0f65ea04",
                                "sense_id": "ed784301-18f3-3732-8105-aad5b6b17c09",
                                "text": "Et la main de Stephanescu, fétidement expirant avec un grand air désespéré, s’est crispée une dernière fois toute glacée dans la mienne."
                            },
                            {
                                "example_id": "a221cd81-4a0b-4890-b264-d60f1cb487e6",
                                "sense_id": "ed784301-18f3-3732-8105-aad5b6b17c09",
                                "text": "Performance, certes, quand on analyse son impatience à séduire. Il module la présence de l’énoncé de façon telle qu’on ne sent jamais qu’il la ramène fétidement."
                            }
                        ]
                    }
