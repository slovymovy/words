                    {
                        "sense_id": "fd44a80a-045c-33b4-a390-d22c811390e3",
                        "entry_id": "7aa59b91-2a71-35e6-9f51-9cf50d2eca13",
                        "glosses": [
                            "Qui concerne les chapelets, notamment leur fabrication et leur vente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d015fb3-e2e5-46f7-9d20-0219849bfd25",
                                "sense_id": "fd44a80a-045c-33b4-a390-d22c811390e3",
                                "text": "Depuis plus d’un siècle et demi, cette industrie, dite patenôtrière, a généré une multitude de savoir-faire, des créations d’usines et des milliers d’emplois."
                            },
                            {
                                "example_id": "a305e6f7-1ace-4c4d-804d-1b95578beaf8",
                                "sense_id": "fd44a80a-045c-33b4-a390-d22c811390e3",
                                "text": "Ce qui est amusant, c’est que deux reportages sur Ambert ont été diffusés le même jour sur cette même chaîne et voici le second sur l’industrie patenôtrière ambertoise !"
                            }
                        ]
                    }
                ],
