                                        "entry_id": "4ac53e7d-1591-3f9e-ae13-ae86f06494f9",
                                        "glosses": [
                                            "gwiazda, której jasność gwałtownie wzrosła na skutek wybuchowego odrzucenia przez nią swoich zewnętrznych warstw"
                                        ],
                                        "tags": [],
