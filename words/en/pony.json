                                "target_lang_word": "小抄",
                                "target_lang_sense_clarification": "作弊工具"
                            },
                            {
                                "target_lang_word": "翻译对照本",
                                "target_lang_sense_clarification": "学习辅助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89eef9bf-3a05-3ad5-995f-71e98bb42807",
                    "sense_definition": "A dance from the 1960s in which the dancer mimics the high-stepping prance of a pony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone at the party started to do the <w>pony</w> when the music changed.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке начали танцевать <w>пони</w>, когда сменилась музыка.",
                                "zh": "音乐一变，派对上的每个人都开始跳起<w>小马舞</w>。"
                            }
                        },
                        {
                            "text": "Can you teach me how to do the <w>pony</w>?",
                            "target_lang_translations": {
                                "ru": "Ты можешь научить меня танцевать <w>пони</w>?",
                                "zh": "你能教我怎么跳<w>小马舞</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
