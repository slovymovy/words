                ],
                "senses": [
                    {
                        "sense_id": "212f61a4-764f-3f20-87b5-a7aad1e04208",
                        "entry_id": "8a646807-f447-3b26-99d6-db6f7fd8b2ae",
                        "glosses": [
                            "Langue indo-aryenne (sous-famille des langues dardiques) parlée au Cachemire, c’est l’une des 22 langues nationales de l’Inde où vivent la plupart des locuteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0724d72f-b484-4a0d-9611-fdb2a2f0e055",
                                "sense_id": "212f61a4-764f-3f20-87b5-a7aad1e04208",
                                "text": "Le cachemiri s’écrit le plus souvent en caractères arabes, parfois en dévanagari."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8527042e-fdcd-4271-a917-589c3a3f27d3",
                        "source_entry_id": "8a646807-f447-3b26-99d6-db6f7fd8b2ae",
                        "source_sense_id": "212f61a4-764f-3f20-87b5-a7aad1e04208",
                        "target_lang_word": "Kashmiri",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kashmiri",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf1222e-b6c2-3de1-ac19-039a73344310",
                                        "entry_id": "eab87f16-fa1c-373a-99c8-29de70c2cc77",
                                        "glosses": [
                                            "indoarische Sprache (genauer: dardische Sprache), die vor allem in Indien gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5936df55-7fa1-4c5a-bffa-0b49edbb99c4",
                                                "sense_id": "6cf1222e-b6c2-3de1-ac19-039a73344310",
                                                "text": "„Kashmiri machte eine Sonderentwicklung durch. Es ist dem Hindi-Sprechenden nicht ohne weiteres verständlich.“"
                                            },
                                            {
                                                "example_id": "3d88d529-604e-4e41-a006-6b01bbfc21b8",
                                                "sense_id": "6cf1222e-b6c2-3de1-ac19-039a73344310",
                                                "text": "„Mit dem Kashmiri, einer dem Urdu verwandten Sprache, ist eine indio-europäische Mundart offizielle Amtssprache des Unionsstaates.“"
                                            },
                                            {
                                                "example_id": "20bab749-4b06-4a0c-81b7-7ff5b33fd8c4",
                                                "sense_id": "6cf1222e-b6c2-3de1-ac19-039a73344310",
                                                "text": "„Sie sprechen Kashmiri, in Jammu hauptsächlich Dogri, im Osten tibetisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
