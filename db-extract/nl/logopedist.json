                "translations": [
                    {
                        "translation_id": "14cd9734-9af2-47aa-9d3f-4f39bf6176e5",
                        "source_entry_id": "b5999afa-8a43-374f-970d-6e03661ac263",
                        "source_sense_id": "6d968b14-8753-3661-bfee-b299aa1994a4",
                        "target_lang_word": "Logopäde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Logopäde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                        "entry_id": "8c102fae-a9fa-33f1-b2d5-96c74300dc4f",
                                        "glosses": [
                                            "Person, die beruflich Logopädie betreibt, also Sprachstörungen/Sprachentwicklungsstörungen behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77a7c6d-973c-4790-b670-cc37ef5e2b45",
                                                "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                                "text": "„Und Therapeuten wie Logopäden und andere kommen dann in die Kitas und arbeiten dort mit den Kindern.“"
                                            },
                                            {
                                                "example_id": "e42715f1-9e04-4eac-afd3-9925a6cb923f",
                                                "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                                "text": "„Jeder Logopäde wird darüberhinaus aus der Beobachtung einzelner Stammler angeben können, mit welcher Häufigkeit einzelne Konsonanten ersetzt werden und welche insbesondere als Ersatzkonsonanten dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "847c772f-ba20-479b-aee3-451a55aaa0f2",
                        "source_entry_id": "b5999afa-8a43-374f-970d-6e03661ac263",
                        "source_sense_id": "6d968b14-8753-3661-bfee-b299aa1994a4",
                        "target_lang_word": "Sprachlehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachlehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6215e7ac-7ee5-339f-934c-8f7d03172a28",
                                        "entry_id": "0aa64e4d-af70-31c0-ac8f-064b6211fbaa",
                                        "glosses": [
                                            "Lehrer, der Unterricht in einer (oder mehreren) Sprachen erteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd891e5-96a0-4ecd-8bb4-13fa93faf159",
                                                "sense_id": "6215e7ac-7ee5-339f-934c-8f7d03172a28",
                                                "text": "„Müller (…) betont, dass der erhöhte Bedarf an Deutschunterricht im Grundschulbereich jedoch keineswegs mit einer vermehrten Einstellung qualifizierter Sprachlehrer einhergegangen sei.“"
                                            },
                                            {
                                                "example_id": "fe2dea99-44dc-4412-ac05-f2dd802fd574",
                                                "sense_id": "6215e7ac-7ee5-339f-934c-8f7d03172a28",
                                                "text": "„Er kann mithilfe eines Sprachlehrers von seinem Stottern befreit werden.“"
                                            },
                                            {
                                                "example_id": "060d45a9-f9f5-478c-8f21-a94030d50a39",
                                                "sense_id": "6215e7ac-7ee5-339f-934c-8f7d03172a28",
                                                "text": "„Dann nannte er mir die Adresse des Sprachlehrers, mit dem er bereits gesprochen hatte.“"
                                            },
                                            {
                                                "example_id": "dc5e3499-4654-4bbd-8f62-7c316207fee5",
                                                "sense_id": "6215e7ac-7ee5-339f-934c-8f7d03172a28",
                                                "text": "„Nicht wenige Hugenotten waren zudem als Sprachlehrer tätig und trugen so zusätzlich zur Verbreitung des Französischen in allen Schichten bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f11aad11-017f-40ad-a5bc-7fb2577789dc",
                        "source_entry_id": "b5999afa-8a43-374f-970d-6e03661ac263",
                        "source_sense_id": "6d968b14-8753-3661-bfee-b299aa1994a4",
