                    },
                    {
                        "translation_id": "649bfa29-50fe-4df3-bf78-211a3ae5cbc2",
                        "source_entry_id": "0e5f2e62-feb2-3412-ac13-800bc7d9eae7",
                        "source_sense_id": "acc5548d-24fe-36ed-9a45-1089b48a6a76",
                        "source_sense_description": "een persoon met gezag",
                        "target_lang_word": "Machthaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machthaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                        "entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                                        "glosses": [
                                            "Person, die Macht und/oder Regierungsgewalt innehat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdad82a9-be4e-49d4-86b8-b19d9d767bb9",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Doch statt für die braunen Machthaber zu werben, protzte der Korsar in eigener Sache.“"
                                            },
                                            {
                                                "example_id": "a62217e4-2c74-42d2-a632-00a34288f1b1",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Ein Militärgouverneur ist der Machthaber in einem von fremden Truppen besetzten, annektierten oder sonst wie nicht unter Eigen-, sondern fremder Militärregierung stehenden Land.“"
                                            },
                                            {
                                                "example_id": "9e455d7c-4551-4ff7-8f7d-daee2dad6477",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Für mehr als ein Jahr nach dem Ende der Kampfhandlungen blieben die Militärs die alleinigen Machthaber auf diesem Territorium.“"
                                            },
                                            {
                                                "example_id": "70446563-2eff-43ed-9fbc-5bf602780da3",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Als Machthaber der Insel gaben die Deutschen auch Briefmarken heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "831234b2-fab1-4488-b146-2696d4d9c474",
                        "source_entry_id": "0e5f2e62-feb2-3412-ac13-800bc7d9eae7",
                        "source_sense_id": "acc5548d-24fe-36ed-9a45-1089b48a6a76",
                        "source_sense_description": "een persoon met gezag",
                        "target_lang_word": "ruler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9830fe38-51fa-33e3-a838-3d7a4c17cfa3",
                                        "entry_id": "beb6b1dc-b4a4-33ad-ab0e-03e490ad1c48",
                                        "glosses": [
                                            "A (usually rigid), flat, rectangular measuring or drawing device with graduations in units of measurement; a straightedge with markings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                        "entry_id": "beb6b1dc-b4a4-33ad-ab0e-03e490ad1c48",
                                        "glosses": [
                                            "A person who rules or governs; someone or something that exercises dominion or controlling power over others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88701457-d984-4082-9a19-f881366d5b7f",
                                                "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                                "text": "The carcharhinids are unquestionably the rulers of the seas, because of their abundance, their strength and speed, and their unchallenged position as the number one predators in the marine ecosystem."
                                            },
                                            {
                                                "example_id": "3a41b167-e6cb-4f4d-bc46-dd5746c6e3a1",
                                                "sense_id": "f71e138c-83be-3a46-b6b3-79f053352c3b",
                                                "text": "LIKE THE MANDARINS of old, the rulers of China live behind high walls. When they emerge, which they rarely do, they travel in cars with rear windows curtained like sedan chairs.\nThey live in the Chung Nan Hai, a walled park adjacent to the Forbidden City from where ancient dynasties ruled the Celestial Empire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca777100-4eb8-3fdd-a176-aa3a975047a3",
                                        "entry_id": "8c54f52b-5cb1-34db-b62d-ff0a57e7e115",
                                        "glosses": [
                                            "To beat with a ruler (as a traditional school punishment)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae082f27-5cfc-4b10-9908-24cb58916edb",
                        "source_entry_id": "0e5f2e62-feb2-3412-ac13-800bc7d9eae7",
                        "source_sense_id": "acc5548d-24fe-36ed-9a45-1089b48a6a76",
                        "source_sense_description": "een persoon met gezag",
                        "target_lang_word": "puissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b76abfe-b45b-3677-9051-9d1b391c20e9",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Qui a beaucoup de pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36829e3f-5c96-4d07-9ac4-cd83566924c5",
                                                "sense_id": "5b76abfe-b45b-3677-9051-9d1b391c20e9",
                                                "text": "C’est une famille qui est puissante dans la région."
                                            },
                                            {
                                                "example_id": "bda0eef4-7964-493a-82b4-a1abd7f41fc2",
                                                "sense_id": "5b76abfe-b45b-3677-9051-9d1b391c20e9",
                                                "text": "Mais cette même classe allait accepter, au lendemain de la guerre du Pacifique, durant la même décennie 1880-1890, de se livrer à l’impérialisme britannique, plus puissant et doté d'une plus forte hégémonie : […]."
                                            },
                                            {
                                                "example_id": "e5c687b2-89dc-491e-980a-c04a382fab7d",
                                                "sense_id": "5b76abfe-b45b-3677-9051-9d1b391c20e9",
                                                "text": "Entre la petite Écosse, pauvre, calviniste et profrançaise, et la puissante Angleterre, épiscopalienne et traditionnellement hostile à la France, les relations n'ont jamais été de tout repos."
                                            },
                                            {
                                                "example_id": "17e27635-4d69-4f12-b0e2-22365f00109c",
                                                "sense_id": "5b76abfe-b45b-3677-9051-9d1b391c20e9",
                                                "text": "En d'autres mots, être puissant, c'est savoir qu'on a le pouvoir, mais sans sentir le besoin de l'utiliser. Seuls les faibles ont besoin d'user de tout le pouvoir dont ils disposent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6cab2d2-6aa4-3edd-8eb7-9ec932df7b90",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Qui est capable de produire un effet considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ece063a-e3e2-4f69-a0b9-d357cb48c4be",
                                                "sense_id": "e6cab2d2-6aa4-3edd-8eb7-9ec932df7b90",
                                                "text": "Il s'agit de ce que j'ai appris de plus puissant cette année."
                                            },
                                            {
                                                "example_id": "95ee7d85-97bb-4db2-92bb-2a99fc49ecde",
                                                "sense_id": "e6cab2d2-6aa4-3edd-8eb7-9ec932df7b90",
                                                "text": "Mais si la beauté impressionne les sens, elle ne saurait obtenir d’empire durable et puissant qu’autant qu’elle les subjugue."
                                            },
                                            {
                                                "example_id": "caef2d4f-98c7-4a87-9aef-a2d002d22ff6",
                                                "sense_id": "e6cab2d2-6aa4-3edd-8eb7-9ec932df7b90",
                                                "text": "En revanche, il est clair que les politiques monétaires ultra-accommodantes ont eu des effets très puissants sur le marché des changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e625d925-e9a8-3f37-8a81-3528084a577c",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Habile ; profond ; exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b4669d-f42a-475c-a01a-8f0b35fd45c9",
                                                "sense_id": "e625d925-e9a8-3f37-8a81-3528084a577c",
                                                "text": "Puissant calculateur. — puissant logicien. — puissant raisonneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5921bf0-59ca-38ee-b8cc-bbe842039ee4",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Riche ; richissime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91a2460-1779-47a5-8c76-4c3fb6fe17fc",
                                                "sense_id": "d5921bf0-59ca-38ee-b8cc-bbe842039ee4",
                                                "text": "Un puissant capitaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3b97d5-e682-3b3a-a3ee-34f38398b697",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c33e2e-d561-4e3f-bd2c-aaea8206610a",
                                                "sense_id": "1c3b97d5-e682-3b3a-a3ee-34f38398b697",
                                                "text": "Des muscles puissants. — Une voix puissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2067e85d-8327-3eb9-be9c-8ccb1dc3f378",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Corpulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9c2a83-f742-4e28-808c-8c460bf641b9",
                                                "sense_id": "2067e85d-8327-3eb9-be9c-8ccb1dc3f378",
                                                "text": "Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            },
                                            {
                                                "example_id": "b6ea8dd0-c120-42bb-9f41-6996b6a9d44d",
                                                "sense_id": "2067e85d-8327-3eb9-be9c-8ccb1dc3f378",
                                                "text": "Cet homme est devenu très puissant, faute de faire de l’exercice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46047640-34fa-3837-ade1-2aa1563d2c68",
                                        "entry_id": "7d007484-db64-3827-b6e4-7113eaba15c0",
                                        "glosses": [
                                            "Qualifie la grande épaisseur d'un gisement, d'un gîte, d'un filon, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cac04ea-2df5-42b4-8a2b-9d1ae4a43ec1",
                                                "sense_id": "46047640-34fa-3837-ade1-2aa1563d2c68",
                                                "text": "Elle se présente en couches d’épaisseur très-variable, qui quelquefois n’ont que 4 à 5 mètres de puissance, et d’autres fois dépassent 50 mètres ; mais il est à remarquer que les couches les plus puissantes sont rarement les plus avantageuses pour l’exploitation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d89feba-9a46-3143-a783-14963408a354",
                                        "entry_id": "d5cc8ed5-fa28-3eb3-830f-e7f9910c8be5",
                                        "glosses": [
                                            "Homme qui a du pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1222e071-671e-4e71-ad3a-9ecfcffe0dca",
                                                "sense_id": "3d89feba-9a46-3143-a783-14963408a354",
                                                "text": "Aussi n’est-il pas rare de voir une bicoque résister pendant des mois à une armée nombreuse. De là, souvent, cette audace et cette insolence du faible contre le fort et le puissant, cette habitude de la résistance individuelle qui faisait le fond du caractère de la féodalité, […]."
                                            },
                                            {
                                                "example_id": "387b7bd8-2337-4b31-aa5e-51ddc4ab9bf2",
                                                "sense_id": "3d89feba-9a46-3143-a783-14963408a354",
                                                "text": "Pour les radicaux, les multinationales sont des profiteuses de la faim qui jouent un rôle prépondérant dans l’exploitation des pauvres. L'aide et le commerce alimentaires sont « principalement des armes politiques dans les mains des puissants pour maintenir leur domination »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
