{
    "word_family": [
        "égarement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bfcdb38-ec18-337c-8397-7334c709d213",
                    "sense_definition": "Perdre temporairement un objet en oubliant l'endroit où on l'a mis ou rangé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore <w>égaré</w> mes clés de voiture et je suis en retard au travail."
                        },
                        {
                            "text": "Faites attention à ne pas <w>égarer</w> ce dossier important avant la réunion de demain."
                        }
                    ],
                    "common_phrases": [
                        "égarer ses clés",
                        "égarer un document",
                        "égarer des papiers"
                    ]
                },
                {
                    "sense_id": "e1860619-b12d-33c9-9a6a-7437c59022df",
                    "sense_definition": "Perdre son chemin ou s'éloigner de la bonne direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs se sont <w>égarés</w> dans la forêt épaisse pendant la nuit."
                        },
                        {
                            "text": "Sans carte ni repère visible, il est très facile de s'<w>égarer</w> en montagne."
                        }
                    ],
                    "synonyms": [
                        "se perdre",
                        "se paumer"
                    ],
                    "common_phrases": [
                        "s'égarer en chemin",
                        "s'égarer dans la forêt"
                    ]
                },
                {
                    "sense_id": "d4a7088d-0d16-3669-a0a8-1d81b52c466a",
                    "sense_definition": "Mettre dans l'erreur, troubler le bon sens ou fausser le jugement de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces fausses informations risquent d'<w>égarer</w> les électeurs avant le vote."
                        },
                        {
                            "text": "La colère et l'ambition finissent souvent par <w>égarer</w> les esprits les plus brillants."
                        }
                    ],
                    "synonyms": [
                        "fourvoyer",
                        "tromper"
                    ],
                    "common_phrases": [
                        "égarer l'opinion",
                        "égarer les soupçons",
                        "égarer les esprits"
                    ]
                }
            ]
        }
    ]
