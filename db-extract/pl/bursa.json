                                    },
                                    {
                                        "sense_id": "7cca4848-c755-37ec-aa41-32c6835491cb",
                                        "entry_id": "cd787543-fba2-321a-b83f-ea48a2e80831",
                                        "glosses": [
                                            "aus einer Stiftung errichtetes, genossenschaftlich verwaltetes Haus, in dem vor allem Studenten leben und Kost erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f57b3594-08ed-4be3-abe3-1281c2dadaad",
                                                "sense_id": "7cca4848-c755-37ec-aa41-32c6835491cb",
                                                "text": "Ich habe während des Studiums in einer Burse gewohnt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dba67f6c-eb57-4cfa-b3c9-1e7af085b8ad",
                        "source_entry_id": "e91f7393-1158-30d2-b424-48f27ecd1733",
                        "source_sense_id": "058ce7b6-4cc0-3f08-8041-e5240c057ba4",
                        "target_lang_word": "Internat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Internat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                        "entry_id": "3ab911e6-8e4b-3e69-97cc-f186913c0270",
                                        "glosses": [
                                            "(meist private) Schule, in der Schüler(innen) auch wohnen und verpflegt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1150a1-fc61-44cd-b5e2-1d1d17bab7dd",
                                                "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                                "text": "Ich verbrachte meine Schulzeit auf einem Internat."
                                            },
                                            {
                                                "example_id": "0dbfefff-55b7-43bd-82ea-8f082c84c622",
                                                "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                                "text": "„Einen solchen Mitschüler aber, dem auch ich selbst vertraut und mit dem ich meine Erfahrungen und Erlebnisse geteilt hätte, gab es im Internat nicht.“"
                                            },
                                            {
                                                "example_id": "72111426-7816-48ca-b289-fec9ba7b538c",
                                                "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                                "text": "„Die Söhne des Pastors bringt man in ein Internat nach Choćebuz.“"
                                            },
                                            {
                                                "example_id": "daf74b7c-9762-47c7-934d-49e841fcd36b",
                                                "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                                "text": "„Die Familie hatte für ihre wagemutigen Expeditionen wenig Verständnis, die elfjährige Tochter blieb in einem Internat zurück.“"
                                            },
                                            {
                                                "example_id": "b2dde4f1-40ee-4456-8b44-da60360831e1",
                                                "sense_id": "a3039a16-b6bd-3376-8773-65f78592238c",
                                                "text": "„Als sie ins Internat kam und als man sie später interviewte, hatte sie eine Biografie erfunden, weil sie so wenig über ihre eigene wusste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e9a566e-3e14-3cc2-a932-8465f20e6746",
                                        "entry_id": "3ab911e6-8e4b-3e69-97cc-f186913c0270",
                                        "glosses": [
                                            "an eine Schule angeschlossenes Heim, in dem Schüler(innen) wohnen und verpflegt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c9facd-191d-4216-8b35-9d99d962d551",
                                                "sense_id": "7e9a566e-3e14-3cc2-a932-8465f20e6746",
                                                "text": "„Die Familie hatte für ihre wagemutigen Expeditionen wenig Verständnis, die elfjährige Tochter blieb in einem Internat zurück.“"
                                            },
                                            {
                                                "example_id": "0ad9cb69-d867-432d-9ab4-a24a030f8ef1",
                                                "sense_id": "7e9a566e-3e14-3cc2-a932-8465f20e6746",
                                                "text": "„Als sie ins Internat kam und als man sie später interviewte, hatte sie eine Biografie erfunden, weil sie so wenig über ihre eigene wusste.“"
                                            },
                                            {
                                                "example_id": "8021457a-9c0f-47f7-af95-e58077908457",
                                                "sense_id": "7e9a566e-3e14-3cc2-a932-8465f20e6746",
                                                "text": "Ich lebte in einem Internat und besuchte das staatliche Gymnasium vor Ort."
                                            },
                                            {
                                                "example_id": "9cbbaaf9-4596-48c4-9f67-9023faf33d5a",
                                                "sense_id": "7e9a566e-3e14-3cc2-a932-8465f20e6746",
                                                "text": "„Mit fünfzehn Jahren hatte man ihn aus dem Internat genommen und bei einem Gerichtsvollzieher untergebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
