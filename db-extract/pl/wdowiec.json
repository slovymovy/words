                    },
                    {
                        "translation_id": "423d08cf-454c-41a8-b6f3-365bb360984d",
                        "source_entry_id": "de6530d7-bfee-3131-915e-884a66e8565c",
                        "source_sense_id": "34a8f6d2-f0a9-3ce2-b97d-584040af21be",
                        "target_lang_word": "Witwer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Witwer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                        "entry_id": "9b6b5c0e-61ad-37cc-ab3d-8bcc3a8780b8",
                                        "glosses": [
                                            "Mann, dessen Ehefrau verstorben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50fba102-f22f-489d-86d6-38ce179de74a",
                                                "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                                "text": "„Die Verwandten kamen, um der Toten die letzte Ehre zu erweisen, den kalten Mund zu küssen und gemeinsam mit dem Witwer zu trauern.“"
                                            },
                                            {
                                                "example_id": "7340147d-5513-47e0-b7a5-d29d7a0400bc",
                                                "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                                "text": "„Beide sind Witwer, denen die Witwe Goos, der das Haus zu eigen ist, die Wirtschaft führt.“"
                                            },
                                            {
                                                "example_id": "b71e2498-ec52-473b-b9d3-0e9f4238b5e0",
                                                "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                                "text": "„Ein nicht mehr junger, aber wohlhabender Witwer hält um ihre Hand an, sie jedoch verweigert sich der Tradition einer vermittelten Heirat und gibt einem völlig mittellosen Schneider den Vorzug, der ihr nur ein Leben an der Armutsgrenze bieten kann.“"
                                            },
                                            {
                                                "example_id": "11f66d85-6ded-4ff6-a834-096890761cba",
                                                "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                                "text": "„Er war Witwer, hatte nur Adele und fuhr jetzt nach Louviers, um in einer Manufaktur zu arbeiten.“"
                                            },
                                            {
                                                "example_id": "04f2c952-e97b-4bd9-8f10-589ea4c7b24e",
                                                "sense_id": "ddd394b9-74b0-361a-9646-6d7f25b2b531",
                                                "text": "„Zu Benazirs Tod strengte ihr Witwer, Asif Ali Zardari, zwar unabhängige Untersuchungen der UN und Scotland Yards an, untersagte aber die Veröffentlichung der Ergebnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
