                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3197079-60f3-449b-baa5-475a132c078e",
                                "sense_id": "12198fb7-6815-3690-b30c-85dcc646f4e7",
                                "text": "Die Eismasse am höchsten Gipfel der Dolomiten gehe täglich um sieben bis zehn Zentimeter zurück, hieß es zum Start einer Kampagne namens »Karawane der Gletscher« am Montag, wie der »Guardian« berichtet."
                            }
                        ]
                    }
