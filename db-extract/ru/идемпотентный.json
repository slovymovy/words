                                        "entry_id": "367ceac1-4998-3cb6-adc8-40dd378d5ed9",
                                        "glosses": [
                                            "so, dass es sich bei Verknüpfung mit sich wieder selbst ergibt (xdisplaystyle ∘x=x)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4698bd27-cc26-4181-a95d-7d927356c4f2",
                                                "sense_id": "68e91fda-ad88-303a-8f96-9af065560297",
                                                "text": "„Bei der Suche nach idempotenten Zahlen werden vielfältige algebraische und zahlentheoretische Zusammenhänge entdeckt.“"
                                            },
                                            {
                                                "example_id": "2d244977-1f25-4017-95fa-3e1c983e25f3",
                                                "sense_id": "68e91fda-ad88-303a-8f96-9af065560297",
                                                "text": "„Unipotente Gruppoide, freie Monoide und Gruppen besitzen jeweils genau ein idempotentes Element.“"
                                            }
                                        ],
