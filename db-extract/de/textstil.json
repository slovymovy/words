                "senses": [
                    {
                        "sense_id": "6a62e883-9f2d-362f-ba46-1830107d07a2",
                        "entry_id": "1a8c0528-1d9e-33c6-8e80-509d75c72023",
                        "glosses": [
                            "die besonderen sprachlichen Merkmale eines Textes in grammatischer und lexikalischer Hinsicht"
                        ],
                        "tags": [
                            "speziell Stilistik"
                        ],
                        "examples": [
                            {
                                "example_id": "905f6ecd-baaf-4d56-ab60-ebab24c55d3c",
                                "sense_id": "6a62e883-9f2d-362f-ba46-1830107d07a2",
                                "text": "„Es sei auch betont, daß es sich hier um Typisierungsaspekte im Hinblick aus den T e x t s t i l und nicht in erster Linie etwa im Hinblick auf die im Text behandelten Kommunikationsgegenstände handelt.“"
                            },
                            {
                                "example_id": "4d80e465-1cf8-4e8d-9fcf-9fcddde2ce81",
                                "sense_id": "6a62e883-9f2d-362f-ba46-1830107d07a2",
                                "text": "„Analysiert werden die lexikalischen und syntaktischen Charakteristika des Textes (z. B. konnotierte Lexik, Einsatz von Stilfiguren etc.), die in ihrer Gesamtheit den spezifischen Textstil und das pragmatische Wirkungspotenzial konstituieren.“"
                            },
                            {
                                "example_id": "d62469f5-450c-435d-9618-3c98e3a4f986",
                                "sense_id": "6a62e883-9f2d-362f-ba46-1830107d07a2",
                                "text": "„Herauszuarbeiten wäre folglich,…, was im Bezugsrahmen der Normensysteme konkret an einem Textstil als textsortentypisch und was als individualtypisch verifiziert werden kann;…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93a3537a-34c9-3900-8281-ac5af8228935",
                        "entry_id": "1a8c0528-1d9e-33c6-8e80-509d75c72023",
                        "glosses": [
                            "formale Gestaltungsmerkmale von Texten"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "2fa64a2d-295b-4522-85a5-c6a26e9e68a3",
                                "sense_id": "93a3537a-34c9-3900-8281-ac5af8228935",
                                "text": "„Während das Text-Modul hauptsächlich zur Eingabe, zum Ändern und Formatieren Ihrer Texte dient, können Sie mit dem Textstil-Modul das Erscheinungsbild einzelner Buchstaben oder ganzer Worte, Absätze, Rahmen oder Textflussketten ändern.“"
                            },
                            {
                                "example_id": "a07d76c9-20d1-4907-b1be-0f1740515311",
                                "sense_id": "93a3537a-34c9-3900-8281-ac5af8228935",
                                "text": "„Jeder Beschriftung ist ein Textstil zu geordnet. Ein Textstil fasst Layouteinstellungen zusammen, um diese zentral verwalten zu können. Vorteil: Verändert man z.B. die Schriftart eines Textstils, dann ändern sich auch alle Beschriftungen, die von diesem Textstil abhängen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
