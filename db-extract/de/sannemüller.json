                ],
                "senses": [
                    {
                        "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                        "entry_id": "0ed6b517-5d24-3d59-b7f6-124b3369ad0a",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492124de-ad45-4c40-951d-7bc884a5634a",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Frau Sannemüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "59b8f13f-9c30-455d-b085-4c631b9bfedb",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Herr Sannemüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "62f0ae42-9ca0-43c5-920f-a84364dec1d7",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Die Sannemüllers kommen heute aus Ludwigshafen."
                            },
                            {
                                "example_id": "b92ba7e3-b9ad-4a5a-826f-c9b21c5b9e3c",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Der Sannemüller trägt nie die Schals, die die Sannemüller ihm strickt."
                            },
                            {
                                "example_id": "bc438f57-3129-48f3-85fb-2cc9bd6ea071",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sannemüller kommt, geht der Herr Sannemüller.“"
                            },
                            {
                                "example_id": "6af802f2-60b6-4177-8b1c-796fa10b846f",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Sannemüller kommt und geht."
                            },
                            {
                                "example_id": "6edf32b0-465b-4cb8-a6e0-50b113f90369",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "Sannemüllers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a3c41cd0-0444-44ac-99e6-500f696729ba",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "An verregneten Herbsttagen ist Familie Sannemüllers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "59e4d70a-a74d-4270-9c20-e5a2281524aa",
                                "sense_id": "d838e813-e05b-3958-8a42-e72532629815",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Sannemüller das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
