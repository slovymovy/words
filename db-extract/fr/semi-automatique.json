                                    {
                                        "sense_id": "67dcadd3-e506-3b9e-a8c6-c669785cef69",
                                        "entry_id": "9be446eb-3fe0-3f64-8d6e-073002c39e32",
                                        "glosses": [
                                            "Partially automatic."
                                        ],
                                        "tags": [
                                            "not-comparable"
