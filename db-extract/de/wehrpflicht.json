                        ],
                        "form": "die Wehrpflicht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                        "entry_id": "02146ce4-e924-351b-8b2e-0017a28fbff5",
                        "glosses": [
                            "die Pflicht eines Staatsbürgers, einen zeitlich begrenzten Dienst in den Streitkräften des Landes zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6fabe32-3309-4911-bb23-771590c1e15d",
                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                "text": "1813 führte Preußen die allgemeine Wehrpflicht ein."
                            },
                            {
                                "example_id": "f3bc4ef6-f0ee-4ffc-8c70-5e5c819614b6",
                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                "text": "„Die Einführung der Wehrpflicht war nur ein Teil eines umfassenden Reformpakets.“"
                            },
                            {
                                "example_id": "13a57821-5466-4fa3-8a2a-a2674ac48d0a",
                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                "text": "„Also forderten Hindenburg und Ludendorff eine Ausdehnung der Wehrpflicht auf alle Männer von 16 Jahren bis zum Rentenalter, sie sollten notfalls zwangsweise in der Rüstungsproduktion eingesetzt werden.“"
                            },
                            {
                                "example_id": "e7a7dda9-d4a9-471f-ab33-a995994127ff",
                                "sense_id": "53f721d5-2e4a-3416-9e30-5f11aee96d90",
                                "text": "„Die »Reichswehr«, von der Benn spricht, heißt seit der Wiedereinführung der allgmeinen Wehrpflicht durch Hitler am 16. März 1935 »Wehrmacht« und soll mindestens auf Vorkriegsniveau aufgestockt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7498a7e6-0519-43fa-8a7d-c800cf25cd8d",
