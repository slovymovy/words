    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19f41f6d-0fbb-33e1-8463-b6e5e2f2da37",
                    "sense_definition": "Focalisation intense et soutenue de l'attention ou de la pensée sur une activité ou un objet précis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce travail complexe exige une grande <w>concentration</w> pendant plusieurs heures consécutives."
                        },
                        {
                            "text": "Le bruit soudain dans la bibliothèque lui a fait perdre toute sa <w>concentration</w>."
                        }
                    ],
                    "synonyms": [
                        "attention"
                    ],
                    "antonyms": [
                        "distraction",
                        "déconcentration",
                        "inattention"
                    ],
                    "common_phrases": [
                        "manque de concentration",
                        "effort de concentration",
                        "perdre sa concentration"
                    ]
                },
                {
                    "sense_id": "e50f42ff-dd1d-3c3f-bc3c-adcc7831e9a6",
                    "sense_definition": "Proportion ou quantité relative d'une substance dissoute ou présente dans un volume ou un milieu donné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analyses scientifiques ont révélé une forte <w>concentration</w> de sel dans l'eau du lac."
                        },
                        {
                            "text": "Une faible <w>concentration</w> de ce produit suffit généralement pour obtenir l'effet désiré."
                        }
                    ],
                    "synonyms": [
                        "teneur",
                        "dosage"
                    ],
                    "common_phrases": [
                        "forte concentration",
                        "faible concentration"
                    ]
                },
                {
                    "sense_id": "f7c005c5-fcca-306f-986b-49e589ca826f",
                    "sense_definition": "Présence d'un nombre élevé de personnes ou d'éléments réunis dans un espace géographique restreint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On observe une importante <w>concentration</w> d'entreprises technologiques dans cette banlieue moderne."
                        },
                        {
                            "text": "Cette forte <w>concentration</w> urbaine engendre régulièrement d'immenses embouteillages aux heures de pointe."
                        }
                    ],
                    "synonyms": [
                        "agglomération",
                        "accumulation",
                        "rassemblement"
                    ],
                    "antonyms": [
                        "dispersion"
                    ],
                    "common_phrases": [
                        "concentration urbaine",
                        "concentration de population"
                    ]
                },
                {
                    "sense_id": "37e220a4-f2f1-312b-a3e8-28939c1dace3",
                    "sense_definition": "Action de réunir ou d'orienter vers un point unique ce qui était auparavant dispersé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette lentille optique permet la <w>concentration</w> des rayons lumineux en un point précis."
                        },
                        {
                            "text": "Les citoyens critiquent la <w>concentration</w> excessive des pouvoirs au sein du gouvernement central."
                        }
                    ],
                    "synonyms": [
                        "centralisation",
                        "regroupement"
                    ],
                    "antonyms": [
                        "dispersion",
                        "décentralisation"
                    ],
                    "common_phrases": [
                        "concentration des pouvoirs"
                    ]
                },
                {
                    "sense_id": "6a83bc0c-ba27-31a5-9628-e078707c2bb8",
                    "sense_definition": "Processus de regroupement ou de fusion de plusieurs entreprises réduisant le nombre de concurrents dans un secteur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forte <w>concentration</w> du secteur bancaire limite le choix offert aux petits consommateurs."
                        },
                        {
                            "text": "Les autorités de régulation surveillent la <w>concentration</w> économique pour préserver la concurrence."
                        }
                    ],
                    "synonyms": [
                        "fusion",
                        "monopolisation"
                    ],
                    "common_phrases": [
                        "concentration économique",
                        "concentration industrielle"
                    ]
                }
            ]
        }
    ]
}