{
    "word_family": [
        "relieve",
        "relief",
        "reliever",
        "unrelieved"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33b8bef9-baf8-34d6-8f3c-44399028b9c9",
                    "sense_definition": "Feeling happy and relaxed because something unpleasant or difficult has stopped or did not happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt immensely <w>relieved</w> after passing the difficult exam.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала огромное <w>облегчение</w> после сдачи трудного экзамена.",
                                "tr": "Zor sınavı geçtikten sonra kendini çok <w>rahatlamış</w> hissetti."
                            }
                        },
                        {
                            "text": "We were <w>relieved</w> to hear that everyone was safe and sound.",
                            "target_lang_translations": {
                                "ru": "Мы <w>с облегчением</w> узнали, что все живы и здоровы.",
                                "tr": "Herkesin sağ salim olduğunu duyduğumuz için <w>rahatladık</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reassured",
                        "comforted",
                        "thankful",
                        "glad"
                    ],
                    "antonyms": [
                        "worried",
                        "anxious",
                        "stressed",
                        "concerned"
                    ],
                    "common_phrases": [
                        "feel relieved",
                        "greatly relieved",
                        "relieved to hear",
                        "relieved sigh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий радость и спокойствие, потому что что-то неприятное прекратилось или не случилось.",
                        "tr": "Hoş olmayan veya zor bir durumun sona ermesi ya da gerçekleşmemesi nedeniyle hissedilen rahatlama ve mutluluk duygusu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывающий облегчение",
                                "target_lang_sense_clarification": "о состоянии человека после окончания трудностей"
                            },
                            {
                                "target_lang_word": "успокоенный",
                                "target_lang_sense_clarification": "переставший волноваться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rahatlamış",
                                "target_lang_sense_clarification": "bir sıkıntının geçmesiyle duyulan huzur"
                            },
                            {
                                "target_lang_word": "içi rahatlamış",
                                "target_lang_sense_clarification": "endişeden kurtulmuş olma durumu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d2e575f-2c00-3bbd-a138-07629d247d45",
                    "sense_definition": "Simple past and past participle of <w>relieve</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gave him medicine that <w>relieved</w> the pain almost immediately.",
                            "target_lang_translations": {
                                "ru": "Врач дал ему лекарство, которое почти мгновенно <w>облегчило</w> боль.",
                                "tr": "Doktor ona ağrıyı neredeyse anında <w>hafifleten</w> bir ilaç verdi."
                            }
                        },
                        {
                            "text": "The guard was <w>relieved</w> of his duty at midnight by the night watchman.",
                            "target_lang_translations": {
                                "ru": "Охранник был <w>сменён</w> на посту в полночь ночным сторожем.",
                                "tr": "Muhafızın görevi gece yarısı gece bekçisi tarafından <w>devralındı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола relieve.",
                        "tr": "Relieve fiilinin geçmiş zaman ve geçmiş zaman ortacı hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчил",
                                "target_lang_sense_clarification": "уменьшил боль или страдание (прош. вр.)"
                            },
                            {
                                "target_lang_word": "освободил",
                                "target_lang_sense_clarification": "избавил от обязанности или ноши (прош. вр.)"
                            },
                            {
                                "target_lang_word": "сменил",
                                "target_lang_sense_clarification": "заменил кого-то на посту (прош. вр.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hafifletti",
