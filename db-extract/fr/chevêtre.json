                                            {
                                                "example_id": "a9996894-7e19-42c8-9d86-c6ea24c91eff",
                                                "sense_id": "c0baa98e-b7cb-39dd-aa7c-4848155e128d",
                                                "text": "The screws were crossheads and the screwdriver was slightly too large for them, so he had to hold it at an angle."
                                            }
