                                "target_senses": [
                                    {
                                        "sense_id": "38d8d42b-2d59-3a2a-8a28-51b210773e2f",
                                        "entry_id": "ae192dc2-8078-3229-8e19-df153c8b8f32",
                                        "glosses": [
                                            "iemand die bloemen kweekt of verkoopt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5034716d-bfe7-4f17-b893-2ca4649be654",
                                                "sense_id": "38d8d42b-2d59-3a2a-8a28-51b210773e2f",
                                                "text": "‘Een bloementuin!’ zei hij, met een snelle blik op Vink. ‘Zijn het tulpen?’ Hij boog zich naar voren. ‘Waarachtig, het zijn Duycken en niet zo weinig ook. Een florist had ik niet achter u gezocht!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67480417-7711-3d8d-80e4-264b99d203af",
                                        "entry_id": "ae192dc2-8078-3229-8e19-df153c8b8f32",
                                        "glosses": [
                                            "schilder die vooral bloemen schildert"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f00ca615-fe4c-3e43-8c47-f974ecd2be60",
                                        "entry_id": "ae192dc2-8078-3229-8e19-df153c8b8f32",
                                        "glosses": [
                                            "iemand die de wilde flora in een specifiek gebied bestudeert"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "489ce49e-7af4-4fa1-9ce2-b4580afec0e4",
                                                "sense_id": "f00ca615-fe4c-3e43-8c47-f974ecd2be60",
                                                "text": "Hoewel Hugo de Vries zijn studie als florist was begonnen, openden zich voor hem na het lezen van J. Sachs' ‘Lehrbuch der Botanik’ (1868) geheel nieuwe perspectieven. De Vries besloot zich voortaan aan de experimentele plantkunde te gaan wijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
