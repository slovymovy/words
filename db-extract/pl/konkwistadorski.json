                        "sense_id": "c2bfef92-31df-304c-9582-f25f8b34f950",
                        "entry_id": "e3ecd935-60da-3028-b1d4-9f556db79ae6",
                        "glosses": [
                            "odnoszący się do konkwistadora lub konkwistadorów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fd2257-637c-461e-b924-330c337e7367",
                                "sense_id": "c2bfef92-31df-304c-9582-f25f8b34f950",
                                "text": "W okresie konkwistadorskim najszybciej rozwijała się centralna część kraju, północ oraz południe rozwijały się wolniej."
                            },
                            {
                                "example_id": "796d9f9f-81b6-41c2-87ee-277ffe5b6d48",
                                "sense_id": "c2bfef92-31df-304c-9582-f25f8b34f950",
                                "text": "Część klas przeniesiono do budynku przy ulicy Konkwistadorskiej 1, pozostałe przekształcono na Liceum Ogólnokształcące im. Józefa Poniatowskiego, z siedzibą przy ulicy Szymanowskiej 1."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
