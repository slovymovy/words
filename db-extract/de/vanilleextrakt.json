                "senses": [
                    {
                        "sense_id": "bc1b1341-f404-3c21-aaef-84d270fa66c0",
                        "entry_id": "6434c529-dc2e-34dc-9bc3-afd5338f9714",
                        "glosses": [
                            "aus Vanilleschoten gewonnenes Extrakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1af5f0-a009-4872-8593-dfa4147ee2d2",
                                "sense_id": "bc1b1341-f404-3c21-aaef-84d270fa66c0",
                                "text": "„Sie streute Mehl. Hustete. Löffelte Zucker. Hustete. Zeigte mit all die schrecklichen Sachen, die man zum Essenmachen braucht: pflanzliches Öl, Hefe, Vanilleextrakt, sie stellte die Backofentemperatur ein, schöpfte Teig in Muffinförmchen und hustete: ›Als deine Mama so alt war wie du, hat sie dauernd Kopfläuse mit nach Hause gebracht...‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
