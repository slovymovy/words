                        "entry_id": "dd1fb4cf-e7da-3f6b-8893-6acbd9df489e",
                        "glosses": [
                            "Relatif aux hernies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ebc0fc-4be6-4628-bdab-e90e487a18db",
                                "sense_id": "8f42563a-b824-38cb-8f40-fe89a54675e8",
                                "text": "Sac herniaire."
                            },
                            {
                                "example_id": "1a98b3bb-adc5-42ef-8333-8fd0f2ef31f4",
                                "sense_id": "8f42563a-b824-38cb-8f40-fe89a54675e8",
                                "text": "Tumeur herniaire."
                            },
                            {
                                "example_id": "23e8e3e5-3305-44ad-89b4-91ec0fe13edd",
                                "sense_id": "8f42563a-b824-38cb-8f40-fe89a54675e8",
                                "text": "Bandage herniaire."
                            },
                            {
                                "example_id": "a0025c2c-b51c-40de-96a4-07d49e1d2bdb",
                                "sense_id": "8f42563a-b824-38cb-8f40-fe89a54675e8",
                                "text": "Image même de la maternité… après trente-cinq ans de grossesses continues, de rossées, d'avortements, d'hémorragies, d'ulcères, de tumeurs, de descentes herniaires, de varices et autres émoluments de l'existence maternelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f175611-4f46-310b-ac0b-a39e82d09476",
                        "entry_id": "dd1fb4cf-e7da-3f6b-8893-6acbd9df489e",
                        "glosses": [
                            "Qui fait comme une protrusion, qui dépasse."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d690f1d1-1aa3-476c-be9c-76007692ba69",
                                "sense_id": "7f175611-4f46-310b-ac0b-a39e82d09476",
                                "text": "Ma rencontre avec Angelika eut lieu dix-sept ans après le début de ma vie commune avec Simone de Beauvoir, à laquelle, si on me pardonne cette digression herniaire dans la chronologie, je reviens maintenant."
                            }
                        ]
                    }
