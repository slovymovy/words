                                    },
                                    {
                                        "sense_id": "1ae4df69-0d93-3bff-a7c0-38927ab33203",
                                        "entry_id": "5fa4d6c8-b526-335e-b891-21bdf38366e1",
                                        "glosses": [
                                            "Related to human speech, as distinct from the vocalisation of animals."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08d3c471-16ec-40ac-9a74-f367c3c51157",
                                                "sense_id": "1ae4df69-0d93-3bff-a7c0-38927ab33203",
                                                "text": "Brutes cannot form articulate Sounds, cannot articulate the Sounds of the Voice, excepting some few Birds, as the Parrot, Pye, &c."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864dc2d8-1b94-315c-8a05-7670200c9e51",
                                        "entry_id": "5fa4d6c8-b526-335e-b891-21bdf38366e1",
                                        "glosses": [
                                            "Articulated (all senses)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e922fc-eaeb-487c-b239-eddae58272c1",
                                                "sense_id": "864dc2d8-1b94-315c-8a05-7670200c9e51",
                                                "text": "Theſe things indeede you haue articulate(d),\nProclaim'd at Market Croſſes, read in Churches,\nTo face the Garment of Rebellion\nVVith ſome fine colour, that may pleaſe the eye\nOf fickle Changelings, and poore Diſcontents,\nWhich gape, and rub the Elbovv at the nevves\nOf hurly burly Innouation :\nAnd neuer yet did Inſurrection vvant\nSuch vvater-colours, to impaint his cauſe :\nNor moody Beggars, ſtaruing for a time\nOf pell-mell hauocke, and confuſion,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "articulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15f998a9-75e7-3ffa-90c1-371b987ece04",
                                        "entry_id": "9587f301-62e1-3c85-9cde-5d7ce9a82a35",
                                        "glosses": [
                                            "An animal of the subkingdom Articulata."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832df37f-ef35-44bc-9899-3267302dbc4f",
                                                "sense_id": "15f998a9-75e7-3ffa-90c1-371b987ece04",
                                                "text": "They considered articulates to be pre-adapted for an eleutherozoic existence because they possess muscular arms which are potentially of value in crawling and swimming, as in comatulids."
                                            }
                                        ]
                                    }
                                ]
                            }
