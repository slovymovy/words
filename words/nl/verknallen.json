{
    "word_family": [
        "knallen",
        "knal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3af32eb-f1f7-3f76-95b3-a8662a4b1afc",
                    "sense_definition": "Je kansen of een situatie plotseling en grondig bederven of verpesten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bederven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was zo zenuwachtig voor het examen dat hij het helemaal heeft <w>verknald</w>.",
                            "target_lang_translations": {
                                "en": "He was so nervous for the exam that he completely <w>screwed</w> it up."
                            }
                        },
                        {
                            "text": "Als je nu niet serieus gaat studeren, ga je je toekomst <w>verknallen</w>.",
                            "target_lang_translations": {
                                "en": "If you don't start studying seriously now, you are going to <w>ruin</w> your future."
                            }
                        }
                    ],
                    "synonyms": [
                        "verpesten",
                        "verpielen",
                        "verknoeien",
                        "verpesten",
                        "verprutsen"
                    ],
                    "antonyms": [
                        "redden",
                        "slagen"
                    ],
                    "common_phrases": [
                        "het examen verknallen",
                        "je kansen verknallen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly and thoroughly ruin or spoil your chances or a situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "screw up",
                                "target_lang_sense_clarification": "to ruin or spoil a situation"
                            },
                            {
                                "target_lang_word": "mess up",
                                "target_lang_sense_clarification": "to make a mistake or ruin something"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to spoil completely"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to waste an opportunity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88aaffb1-565e-35c8-bd73-41efff43839f",
                    "sense_definition": "Geld of kruit uitgeven aan het afsteken van vuurwerk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vuurwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met Oud en Nieuw hebben de buren honderden euro's aan vuurwerk <w>verknald</w>.",
                            "target_lang_translations": {
                                "en": "On New Year's Eve, the neighbors <w>blew</w> hundreds of euros on fireworks."
                            }
                        },
                        {
                            "text": "Het is zonde om al je zakgeld in één avond te <w>verknallen</w>.",
                            "target_lang_translations": {
                                "en": "It is a shame to <w>waste</w> all your pocket money in one evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschieten",
                        "opstoken"
                    ],
                    "common_phrases": [
                        "vuurwerk verknallen",
                        "geld verknallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To spend money or gunpowder on setting off fireworks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to waste money on fireworks"
                            },
                            {
                                "target_lang_word": "squander",
                                "target_lang_sense_clarification": "to waste money on fireworks"
                            }
                        ]
                    }
                }
            ]
        }
    ]
