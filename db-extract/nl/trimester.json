                                "target_senses": [
                                    {
                                        "sense_id": "b34cd6e1-235d-37e7-b758-1d3eb8d9c371",
                                        "entry_id": "abb3859d-da05-305b-9f84-b98467f22fd9",
                                        "glosses": [
                                            "Zeitabschnitt von drei Monaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aebd3928-bbc1-47d7-bb63-920069f01b51",
                                                "sense_id": "b34cd6e1-235d-37e7-b758-1d3eb8d9c371",
                                                "text": "Im ersten Trimester des Jahres sank die Arbeitslosigkeit stärker als erwartet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f2bb161-7a67-389d-8cbe-8f630ed9c80a",
                                        "entry_id": "abb3859d-da05-305b-9f84-b98467f22fd9",
                                        "glosses": [
                                            "drei Monate währender Abschnitt eines Schul- oder Studienjahres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea64653e-c5e3-48af-9073-34c660df996a",
                                                "sense_id": "8f2bb161-7a67-389d-8cbe-8f630ed9c80a",
                                                "text": "Jedes Trimester wird mit Klausuren und Prüfungen abgeschlossen."
                                            },
                                            {
                                                "example_id": "2bf856cb-35ed-4383-92f5-647cc5a75178",
                                                "sense_id": "8f2bb161-7a67-389d-8cbe-8f630ed9c80a",
                                                "text": "„Am Ende des Trimesters sagte ihm ein älterer Schüler, dem er seinen Widerwillen zu erklären versuchte, auf solche Empfindungen käme es gar nicht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "382643f4-cdda-343c-acf2-47a9df203d3f",
                                        "entry_id": "abb3859d-da05-305b-9f84-b98467f22fd9",
                                        "glosses": [
                                            "ein Drittel der Dauer einer Schwangerschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30dd1c01-889f-47c7-a95c-a9bc63e9cd0e",
                                                "sense_id": "382643f4-cdda-343c-acf2-47a9df203d3f",
                                                "text": "Viele Frauen finden das zweite Trimester der Schwangerschaft als das angenehmste."
                                            },
                                            {
                                                "example_id": "277f4fa6-33b7-4059-b78e-1714708d2dfd",
                                                "sense_id": "382643f4-cdda-343c-acf2-47a9df203d3f",
                                                "text": "„Milena war zu dem Zeitpunkt im letzten Trimester ihrer Schwangerschaft und ihr hohes Emotionslevel sicher auch mit ihrem schwankenden Hormonhaushalt zu erklären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88505904-7635-46bd-8f14-64b5c8a3ed5b",
