                            },
                            {
                                "target_lang_word": "дерзить",
                                "target_lang_sense_clarification": "вести себя вызывающе и дерзко на словах"
                            },
                            {
                                "target_lang_word": "грубить",
                                "target_lang_sense_clarification": "говорить дерзости, грубости"
                            },
                            {
                                "target_lang_word": "хамить",
                                "target_lang_sense_clarification": "вести себя нагло и невежливо"
                            }
