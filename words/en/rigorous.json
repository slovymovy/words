                },
                {
                    "sense_id": "1be1168d-35b2-37bc-999f-f72907908e47",
                    "sense_definition": "Severe, harsh, or intense, especially regarding weather or physical conditions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers were not prepared to survive such a <w>rigorous</w> winter.",
                            "target_lang_translations": {
                                "ru": "Исследователи не были готовы пережить столь <w>суровую</w> зиму.",
                                "zh": "探险家们没有准备好在如此<w>严酷</w>的冬天生存下来。"
                            }
                        },
                        {
                            "text": "Few plants can grow in the <w>rigorous</w> climate of the high desert.",
                            "target_lang_translations": {
                                "ru": "Лишь немногие растения могут расти в <w>суровом</w> климате высокогорной пустыни.",
                                "zh": "很少有植物能在高海拔沙漠<w>恶劣</w>的气候中生长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harsh",
                        "stern"
                    ],
                    "common_phrases": [
                        "rigorous winter",
                        "rigorous climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровый, резкий или тяжелый, особенно в отношении погоды или физических условий.",
