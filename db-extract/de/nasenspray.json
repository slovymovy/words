                    {
                        "sense_id": "68e4b1fa-7f26-317b-a723-0f3132a86c70",
                        "entry_id": "f982f8b6-ff4a-3bc6-98c9-a1633a19bff0",
                        "glosses": [
                            "Spray, mit dem eine Flüssigkeit als feinverteiltes Aerosol auf die Nasenschleimhaut aufgebracht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acff8d6-501a-4686-b559-4d7bec66f0f0",
                                "sense_id": "68e4b1fa-7f26-317b-a723-0f3132a86c70",
                                "text": "„Für die Studie erhielten 40 Patientinnen und 41 gesunde Vergleichspersonen per Nasenspray Oxytocin oder ein Placebo, also ein Präparat ohne Wirkstoff.“"
                            },
                            {
                                "example_id": "2b35abea-95f2-4fc0-b35a-8c6465493a56",
                                "sense_id": "68e4b1fa-7f26-317b-a723-0f3132a86c70",
                                "text": "„Triptane gibt es als Tabletten, Nasenspray und Zäpfchen, oder sie werden unter die Haut gespritzt.“"
                            },
                            {
                                "example_id": "4af0ae6f-1730-46c9-9548-b8943b720809",
                                "sense_id": "68e4b1fa-7f26-317b-a723-0f3132a86c70",
                                "text": "„Ein simpler Nasenspray soll die Beschwerden jetzt lindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
