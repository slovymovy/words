                                "sense_id": "31dc438e-37a7-3566-918b-13369af546fb",
                                "text": "\"Republican lawmakers indignantly criticized the government response to the arrival of Ebola on US shores in a tense hearing on Capitol Hill Thursday.\""
                            },
                            {
                                "example_id": "713e4dac-720d-45dd-8d84-8fcb88eb94d2",
                                "sense_id": "31dc438e-37a7-3566-918b-13369af546fb",
                                "text": "\"A Republican New Hampshire state lawmaker has called a Democratic congresswoman ‘‘ugly’’ and said the GOP opponent in her November re-election race is one of the most attractive women in politics.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
