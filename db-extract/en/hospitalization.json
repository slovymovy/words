                    },
                    {
                        "translation_id": "ad2b2d4f-8ecb-4b31-ad68-c73dfe1b972f",
                        "source_entry_id": "0216bcaf-ad49-3eac-a914-1ac7af267976",
                        "source_sense_description": "hospitalizing of a patient",
                        "target_lang_word": "Krankenhausaufenthalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenhausaufenthalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                        "entry_id": "f78c83c2-c6ab-3a74-942e-7e0ba9d00018",
                                        "glosses": [
                                            "Verbleib in einem Krankenhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243f4527-8bed-4c61-90fd-84516adb6360",
                                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                                "text": "„Ein Krankenhausaufenthalt folgte dem anderen.“"
                                            },
                                            {
                                                "example_id": "8718e3f5-2728-438a-a182-f4286cc57296",
                                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                                "text": "„Als er bei einem Unfall Verbrennungen erlitt, für deren Behandlung ein stationärer Krankenhausaufenthalt notwendig war, besuchte Sally ihn regelmäßig, und sie kamen sich näher.“"
                                            },
                                            {
                                                "example_id": "7540e480-f6dc-4ede-892d-03663891b486",
                                                "sense_id": "214d3ae4-fd65-33f5-8725-e947edce2d78",
                                                "text": "„Nach seinem zweiten Krankenhausaufenthalt erzählte der Mann den Ärzten, dass er einige Tage zuvor an einem Familientreffen in South Dakota teilgenommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "349392b2-5a9a-4647-a5fd-75801a275085",
                        "source_entry_id": "0216bcaf-ad49-3eac-a914-1ac7af267976",
                        "source_sense_description": "hospitalizing of a patient",
                        "target_lang_word": "Klinikaufenthalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klinikaufenthalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                        "entry_id": "7c303e0f-ebf5-3e1c-93ad-401df80e4332",
                                        "glosses": [
                                            "Verbleib in einer Klinik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cfefd5b-55e1-43cd-ba88-9d2530d9e15f",
                                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                                "text": "„Bereits nach ihrem ersten Kollaps und kurzem Klinikaufenthalt in Berlin sei sie hergekommen; Meixner sei eine Koryphäe auf dem Feld psychosomatisch bedingter Krankheiten.“"
                                            },
                                            {
                                                "example_id": "4eb0028d-2d0c-4e9a-92a1-f2feb1b388d0",
                                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                                "text": "„So hat er bei unzähligen Klinikaufenthalten auch immer seine beiden Schwestern angegeben, niemals Ehefrau und Kinder, das ist aktenkundig.“"
                                            },
                                            {
                                                "example_id": "189c9263-b923-4f17-819d-a5516d954122",
                                                "sense_id": "d67c0204-81ce-3824-ae38-495acd4ab999",
                                                "text": "„Als er diese Zeilen schreibt, liegt bereits ein weiterer Herzanfall hinter ihm, der ihn Anfang 1965 bei einem Besuch in Mailand getroffen und einen vierwöchigen Klinikaufenthalt nach sich gezogen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14c69919-c52c-4723-904f-29a541dfcc5a",
