                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a78842cd-9d7d-3061-b4a3-89be9f57c342",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "A circular band of coloured light, visible around the sun or moon etc., caused by reflection and refraction of light by ice crystals in the atmosphere."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c41d9a5f-5a85-3c2e-a877-c2878bb57018",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "A cloud of gas and other matter surrounding and captured by the gravitational field of a large diffuse astronomical object, such as a galaxy or cluster of galaxies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5139051-4bbd-3c39-947e-d183d4eb65ea",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "Anything resembling this band, such as an effect caused by imperfect developing of photographs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5e80e88-0576-37e3-83c2-b9c51e14dd67",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "nimbus, a luminous disc, often of gold, around or over the heads of saints, etc., in religious paintings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc5d7464-4d72-3b22-9b49-09efd9ee766b",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "The metaphorical aura of glory, veneration or sentiment which surrounds an idealized entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cfb1c50-9520-4d24-9a28-71ca7f8233d7",
                                                "sense_id": "bc5d7464-4d72-3b22-9b49-09efd9ee766b",
                                                "text": "her halo slipped"
                                            },
                                            {
                                                "example_id": "ef5ef422-11a3-43eb-8301-328614ee359e",
                                                "sense_id": "bc5d7464-4d72-3b22-9b49-09efd9ee766b",
                                                "text": "O! yearning heart! I did inherit\nThy withering portion with the fame,\nThe searing glory which hath shone\nAmid the jewels of my throne,\nHalo of Hell!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd975b7-41d7-3136-aa44-9f60e4c386c2",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "The bias caused by the halo effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c30b4b-c9a1-4cdd-b096-7c598a8c92cf",
                                                "sense_id": "8cd975b7-41d7-3136-aa44-9f60e4c386c2",
                                                "text": "In both cases, they found that […] there was a halo effect (e.g., when a \"low cholesterol\" claim was made, consumers perceived other nutrients, such as fat, also to be at low levels when they were actually high). Andrews reported that these misleading halos were reduced only when the claims were accompanied by an evaluative disclosure […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04d86ba-2c53-35e2-8cba-658e955f84a5",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "a circular annulus ring, frequently luminous, often golden, floating above the head"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "417fefa6-25c1-33e1-87e5-f513dbebd0e9",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "A circular brace used to keep the head and neck in position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654ace8a-bd82-3f10-9be5-58d2a62fcde1",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
                                        "glosses": [
                                            "A roll bar placed in front of the driver, used to protect the cockpit of an open cockpit racecar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18aaa58-a7ef-3b7c-b026-2f112a3cf474",
                                        "entry_id": "f83d1845-7fcb-31e3-89bc-b6d19be85fa9",
