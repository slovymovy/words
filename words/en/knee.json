                            },
                            {
                                "target_lang_word": "弯头",
                                "target_lang_sense_clarification": "管道等的转弯连接处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1de3eeee-16e0-337e-abac-c410b3638f2c",
                    "sense_definition": "The joint in the front leg of a horse or similar animal that corresponds to the human wrist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse injured its <w>knee</w> while jumping over the fence.",
                            "target_lang_translations": {
                                "ru": "Лошадь повредила <w>запястье</w> во время прыжка через забор.",
                                "zh": "那匹马跳过栅栏时伤到了前腿的<w>膝部</w>。"
                            }
                        },
                        {
                            "text": "You should check the animal's <w>knees</w> for swelling after the race.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить <w>запястья</w> животного на наличие отеков после скачек.",
                                "zh": "赛后你应该检查一下这只动物前腿的<w>膝部</w>有没有肿胀。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "zoology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сустав на передней ноге лошади или похожего животного, соответствующий человеческому запястью.",
                        "zh": "马或类似动物前腿上、相当于人类手腕的关节部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запястье",
                                "target_lang_sense_clarification": "у лошади"
                            },
                            {
                                "target_lang_word": "колено",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膝部",
                                "target_lang_sense_clarification": "马等动物前腿上对应人手腕的部位"
                            },
                            {
                                "target_lang_word": "前膝",
                                "target_lang_sense_clarification": "特指马等前肢该部位"
                            }
                        ]
