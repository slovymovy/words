                "senses": [
                    {
                        "sense_id": "ac4cecb7-57a7-3e9f-bd7b-32c4a8bd2a47",
                        "entry_id": "fe1586d4-247e-37cc-bf45-a8f98bcc1856",
                        "glosses": [
                            "eine Gattung aus der Familie der Hortensiengewächse (Hydrangeaceae)"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "8e51ce49-43c7-4c2a-b92e-17445ada099d",
                                "sense_id": "ac4cecb7-57a7-3e9f-bd7b-32c4a8bd2a47",
                                "text": "Die Gattung Pfeifenstrauch besteht aus meist sommergrünen Sträuchern mit ungeteilten, häufig gezähnten Blättern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd04d330-269d-3b99-a3b5-9989708284b2",
                        "entry_id": "fe1586d4-247e-37cc-bf45-a8f98bcc1856",
                        "glosses": [
                            "oft verwendete Kurzform für den Europäischen Pfeifenstrauch oder Falschen Jasmin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a3509d-23dd-4655-8946-a17bbe3a0d22",
                                "sense_id": "cd04d330-269d-3b99-a3b5-9989708284b2",
                                "text": "Aus ausgehöhlten Zweigen des Pfeifenstrauchs wurden früher Pfeifen (Musikinstrumente) hergestellt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c1c5d61-7bf7-400d-b819-1c880b2ff5ed",
                        "source_entry_id": "fe1586d4-247e-37cc-bf45-a8f98bcc1856",
                        "source_sense_id": "ac4cecb7-57a7-3e9f-bd7b-32c4a8bd2a47",
                        "target_lang_word": "seringa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seringa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                        "entry_id": "19c8dcd7-c719-383b-bed2-8066702cd7fb",
                                        "glosses": [
                                            "Arbrisseau de la famille des Hydrangeaceae, qui porte, au printemps, des fleurs blanches dont l’odeur est très forte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4cf1f5-1a87-4cb9-a598-aa4a22759772",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Soudain, au bord du bassin, nous vîmes un petit chat qui buvait. Nous nous dissimulâmes derrière une touffe de seringas."
                                            },
                                            {
                                                "example_id": "fd193657-f705-4ec5-8aa8-841060656b9b",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Nous fîmes quelques pas incertains hors de la zone du clair de lune, vers le bosquet de grenadiers et de seringas."
                                            },
                                            {
                                                "example_id": "880054a7-b038-4b40-a544-201056fe912c",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Vous ne me répondrez pas, j’en ai la certitude. Mais vous saurez que dans un coin de la France, au fond d’un jardin qui, ce matin, sent bon le seringa, une amie pense à vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "730629ca-c0ae-45d2-885b-8400aa50541a",
                        "source_entry_id": "fe1586d4-247e-37cc-bf45-a8f98bcc1856",
                        "source_sense_id": "ac4cecb7-57a7-3e9f-bd7b-32c4a8bd2a47",
                        "target_lang_word": "seringat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seringat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                                        "entry_id": "2515e2cf-c9d5-31d0-a3da-e0d1f27337e5",
                                        "glosses": [
                                            "Variante de seringa."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db97fa1-1d67-4b62-b5d3-a502b7a9ccf4",
                                                "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                                                "text": "J’aime ce parc romantique où s’élèvent majestueusement chênes, marronniers, cèdres et magnolias dont l’ancienneté témoigne qu’ils ne sont pas les caprices arboricoles de nouveaux riches. Sous leurs frondaisons, des bosquets de seringats se livrent à une sauvage exubérance."
                                            },
                                            {
                                                "example_id": "d2cf32dd-a388-4314-a41c-596731ac1126",
                                                "sense_id": "49ab3fc1-9cfc-386b-82ec-7bf49b83e11f",
                                                "text": "C’est une gamme parcourant tout le clavier de l’odorat, touchant aux entêtantes senteurs du seringat et du sureau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
