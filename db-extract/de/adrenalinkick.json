                "senses": [
                    {
                        "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                        "entry_id": "df849789-707b-34b0-ab52-7240365b3af3",
                        "glosses": [
                            "kurzzeitige, hohe nervliche und emotionale Erregung mit anschließender rauschhafter Entladung, die physiologisch durch eine Adrenalinausschüttung im Körper hervorgerufen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0735e67d-3d47-49af-aa3c-588479456672",
                                "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                                "text": "„Den Adrenalinkick, den ich früher bei einem Wettkampf hatte, habe ich jetzt im Einsatz.“"
                            },
                            {
                                "example_id": "a5324312-e03a-4637-a7fd-539d465326a0",
                                "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                                "text": "„Doch Coco durchfuhr ein Adrenalinkick, sie spürte, wie ihr Herz immer schneller schlug.“"
                            },
                            {
                                "example_id": "666097ac-b6e4-492e-b497-1ee515183a5b",
                                "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                                "text": "„Dank des Adrenalinkicks war nun auch der letzte Rest Müdigkeit verschwunden.“"
                            },
                            {
                                "example_id": "a05a3a4a-35e8-4439-8f26-547cc184dcc5",
                                "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                                "text": "„Die Folge war eine Zunahme aggressiven Verhaltens auf den Straßen, da diese jungen Männer auf der Suche nach einem flüchtigen Adrenalinkick ihre Fahrzeuge mit rücksichtsloser Geschwindigkeit fuhren.“"
                            },
                            {
                                "example_id": "31ca72d6-846d-4b88-9805-0f096ac5370b",
                                "sense_id": "0bb23066-31aa-3cdc-a8b9-a0ffed1ec2d1",
                                "text": "„Er liebte das Leben mit seinen vielfältigen Adrenalinkicks, er hungerte regelrecht danach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
