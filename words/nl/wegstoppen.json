    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9620514-0cb2-38bb-af40-c1bee953a74a",
                    "sense_definition": "iets op een veilige of vaste plek leggen om het te bewaren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je paspoort goed <w>wegstoppen</w> in je koffer.",
                            "target_lang_translations": {
                                "en": "You should <w>tuck</w> your passport <w>away</w> safely in your suitcase.",
                                "ru": "Тебе нужно хорошенько <w>спрятать</w> паспорт в чемодане."
                            }
                        },
                        {
                            "text": "Hij <w>stopte</w> het geld snel <w>weg</w> in zijn binnenzak.",
                            "target_lang_translations": {
                                "en": "He quickly <w>stashed</w> the money in his inside pocket.",
                                "ru": "Он быстро <w>засунул</w> деньги во внутренний карман."
                            }
                        }
                    ],
                    "synonyms": [
                        "opbergen",
                        "opruimen"
                    ],
                    "antonyms": [
                        "tevoorschijn halen"
                    ],
                    "common_phrases": [
                        "geld wegstoppen",
                        "veilig wegstoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put something in a safe or fixed place for safekeeping.",
                        "ru": "Положить что-то в надежное или определенное место для хранения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to tuck away",
                                "target_lang_sense_clarification": "to put in a safe or hidden place"
                            },
                            {
                                "target_lang_word": "to put away",
                                "target_lang_sense_clarification": "to store in a designated spot"
                            },
                            {
                                "target_lang_word": "to stow away",
                                "target_lang_sense_clarification": "to pack or store something neatly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "припрятать",
                                "target_lang_sense_clarification": "положить в надежное место"
                            },
                            {
                                "target_lang_word": "убрать",
                                "target_lang_sense_clarification": "положить на место для хранения"
                            },
                            {
                                "target_lang_word": "засунуть",
                                "target_lang_sense_clarification": "быстро положить куда-то вглубь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51b38407-f446-3072-820c-a8abe25ee08f",
                    "sense_definition": "iets of iemand verbergen zodat het niet gezien of gevonden wordt, of emoties negeren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeert haar verdriet diep <w>weg</w> te <w>stoppen</w> voor haar kinderen.",
                            "target_lang_translations": {
                                "en": "She tries to <w>bottle up</w> her sadness deep inside for her children.",
                                "ru": "Она старается <w>затаить</w> свою грусть глубоко внутри ради детей."
                            }
                        },
                        {
                            "text": "De dief <w>stopte</w> de gestolen juwelen <w>weg</w> onder een losse plank.",
                            "target_lang_translations": {
                                "en": "The thief <w>hid</w> the stolen jewelry <w>away</w> under a loose floorboard.",
                                "ru": "Вор <w>запрятал</w> украденные драгоценности под шатающуюся половицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbergen",
                        "verstoppen",
                        "wegmoffelen",
                        "verheimelijken"
                    ],
                    "antonyms": [
                        "onthullen",
                        "tonen"
                    ],
                    "common_phrases": [
                        "emoties wegstoppen",
                        "gevoelens wegstoppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hide something or someone so they are not seen, or to suppress/ignore emotions.",
                        "ru": "Спрятать что-то или кого-то, чтобы это не было найдено, или подавлять эмоции."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to hide away",
                                "target_lang_sense_clarification": "to conceal from view"
                            },
                            {
                                "target_lang_word": "to bottle up",
                                "target_lang_sense_clarification": "specifically for suppressing emotions"
                            },
                            {
                                "target_lang_word": "to bury",
                                "target_lang_sense_clarification": "to hide deep inside or suppress feelings"
                            },
                            {
                                "target_lang_word": "to stash",
                                "target_lang_sense_clarification": "to hide something quickly or secretly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спрятать",
                                "target_lang_sense_clarification": "скрыть от глаз"
                            },
                            {
                                "target_lang_word": "затаить",
                                "target_lang_sense_clarification": "скрыть чувства или эмоции"
                            },
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "игнорировать или сдерживать чувства"
                            },
                            {
                                "target_lang_word": "запрятать",
                                "target_lang_sense_clarification": "тщательно скрыть предмет"
                            }
                        ]
                    }
                }
            ]
        }
