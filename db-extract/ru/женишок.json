                "senses": [
                    {
                        "sense_id": "3a583ab4-d552-3377-8c99-978a389f944e",
                        "entry_id": "aca77df0-1b13-3be9-a7bf-aec2b0d8a59e",
                        "glosses": [
                            "уничиж. или ласк. то же, что жених"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0b35b0-a18d-4b6f-969c-52be624d8ea8",
                                "sense_id": "3a583ab4-d552-3377-8c99-978a389f944e",
                                "text": "Барышня на выданье, только женишка бы подыскать, ― да разве станет за ними дело?"
                            },
                            {
                                "example_id": "45e4952f-d0bd-45bf-be28-1ada7229fee5",
                                "sense_id": "3a583ab4-d552-3377-8c99-978a389f944e",
                                "text": "Дай вам Бог всего самолучшего, женишка бы хорошего да молодого, капитального."
                            },
                            {
                                "example_id": "d74cbcc7-cb42-4e4c-a9e7-f031591af9c9",
                                "sense_id": "3a583ab4-d552-3377-8c99-978a389f944e",
                                "text": "― Был у нее тут ухажёр, считай что женишок."
                            }
                        ]
                    }
                ],
