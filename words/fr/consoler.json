            "senses": [
                {
                    "sense_id": "e1a55d85-b8ff-3ff8-a4e6-938e0274e71c",
                    "sense_definition": "Soulager la peine ou le chagrin de quelqu'un par des paroles bienveillantes, de l'attention ou de la présence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand son ami a appris la mauvaise nouvelle, Paul est venu immédiatement pour le <w>consoler</w>."
                        },
                        {
                            "text": "Elle prend doucement son fils dans ses bras pour <w>consoler</w> l'enfant qui pleure."
                        }
                    ],
                    "synonyms": [
                        "réconforter",
                        "apaiser",
                        "soulager"
                    ],
                    "antonyms": [
                        "affliger",
                        "désoler"
                    ],
                    "common_phrases": [
                        "consoler un enfant",
                        "consoler un ami",
                        "chercher à consoler"
                    ]
                },
                {
                    "sense_id": "15450583-3752-3855-b44f-2e667a2e3099",
                    "sense_definition": "En parlant d'un événement, d'une pensée ou d'une chose, apporter un apaisement moral ou compenser une déception.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet espoir d'une réussite future le <w>console</w> un peu de son échec actuel."
                        },
                        {
                            "text": "La musique douce <w>consolait</w> son esprit tourmenté pendant les nuits d'insomnie."
                        }
                    ],
                    "synonyms": [
                        "adoucir",
                        "compenser"
                    ],
                    "antonyms": [
                        "aggraver"
                    ],
                    "common_phrases": [
                        "consoler de la perte"
                    ]
                }
            ]
        }
    ]
