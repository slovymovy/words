                        "sense_id": "efa29b90-5608-3ea7-8541-4a18b2c2d380",
                        "entry_id": "0743736c-a75e-3ef9-8ede-46fffd7da000",
                        "glosses": [
                            "Laziness; the mood or feeling of being lazy."
                        ],
                        "tags": [
                            "with the"
                        ],
                        "examples": [
                            {
                                "example_id": "f1eebdab-216f-43e0-b5b4-513a9894b1a1",
                                "sense_id": "efa29b90-5608-3ea7-8541-4a18b2c2d380",
                                "text": "Just so your idle vagrant, he would work for his living, but no body will hire him; he would work, but he wants clothes; clothes you give him, but then he wants tooles; you supply him with tooles, but the truth is, he hath an infirmity, he is lame in his limbs and sickly; nay, the truth is, he is lame in his will and sick of the lazies: were the will right, these excuses needed not."
                            },
                            {
                                "example_id": "cb2d48ed-f01d-49a3-a1d4-815c11964858",
                                "sense_id": "efa29b90-5608-3ea7-8541-4a18b2c2d380",
                                "text": "A picker beside him wiped his neck. “I sure wish I was in one of them trailers, laying back and letting the lazies git me.”"
                            },
                            {
                                "example_id": "79d5065e-8a64-42e4-8b41-6f08c61f475a",
                                "sense_id": "efa29b90-5608-3ea7-8541-4a18b2c2d380",
                                "text": "It’s the biggest and most important muscle you have, but your glutes can get a case of the lazies, forgetting to “activate” or “turn on” sufficiently during everyday tasks or workouts […]"
                            }
                        ]
                    }
