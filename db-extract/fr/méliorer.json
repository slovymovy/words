                            {
                                "example_id": "a44d1cb8-cdea-44b4-9617-d39d2e251507",
                                "sense_id": "1321cd6a-731f-3779-980a-450a2384dd0f",
                                "text": "Cela n’est pas contraire à ce qui a été dit ci-dessus, qu’un usufruitier peut méliorer l’héritage dont il jouit par usufruit, car cela doit s’entendre en ce sens, pourvu que cela se fasse sans en changer la somme."
                            },
                            {
                                "example_id": "51867262-e292-415c-bdf7-692ce5cb8aec",
                                "sense_id": "1321cd6a-731f-3779-980a-450a2384dd0f",
                                "text": "La clause de méliorer l’héritage tellement qu’il puisse valoir la rente et plus."
                            }
                        ]
