        "fr-extract.jsonl": [
            {
                "entry_id": "4dd0918f-a440-3b16-806e-54d631611490",
                "word": "piriforme",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eeb65481-cfa9-4bf6-bc21-cc3f2eaf58a6",
                        "entry_id": "4dd0918f-a440-3b16-806e-54d631611490",
                        "tags": [
