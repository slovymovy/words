                "senses": [
                    {
                        "sense_id": "20d512a0-4eeb-3ac1-bd7b-48acdc2fe5b9",
                        "entry_id": "4062ae64-8749-3fe4-9a29-ddcd9069881e",
                        "glosses": [
                            "jemand, der dem Achten folgt (und eventuell dem Zehnten vorausgeht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1451fb-728e-431c-93b5-5a0b2ce7e5ac",
                                "sense_id": "20d512a0-4eeb-3ac1-bd7b-48acdc2fe5b9",
                                "text": "Der Neunte konnte nicht seine gesamte Leistung abrufen."
                            },
                            {
                                "example_id": "2593a4e4-9cf4-498c-b149-a087625c7efc",
                                "sense_id": "20d512a0-4eeb-3ac1-bd7b-48acdc2fe5b9",
                                "text": "Der Teilnehmer aus Italiens Mannschaft wurde Neunter."
                            },
                            {
                                "example_id": "f8ba2085-7702-4a7f-b789-041d5046ad7a",
                                "sense_id": "20d512a0-4eeb-3ac1-bd7b-48acdc2fe5b9",
                                "text": "Sein Vater wurde einmal Neunter bei der Tour de France."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c48d785-493b-4d76-8803-7cfc04580d11",
                        "source_entry_id": "4062ae64-8749-3fe4-9a29-ddcd9069881e",
                        "source_sense_id": "20d512a0-4eeb-3ac1-bd7b-48acdc2fe5b9",
