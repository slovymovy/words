                    "frequency": "High",
                    "semantic_group_id": "bauwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sind gestern auf den hohen <w>Turm</w> gestiegen und haben die Aussicht genossen."
