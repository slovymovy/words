            {
                "entry_id": "c021e562-d8a2-379c-ae2a-1efd21da8700",
                "word": "Прусс",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0bba03d3-c8c0-35de-af61-923234a2b7c7",
                        "entry_id": "c021e562-d8a2-379c-ae2a-1efd21da8700",
                        "glosses": [
