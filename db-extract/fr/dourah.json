                        "examples": [
                            {
                                "example_id": "d74edc7b-179d-422e-97c0-8cfca37cc466",
                                "sense_id": "9c685f92-92ea-3eb0-92fa-1c2b4159d4b9",
                                "text": "Mais la seule partie qui soit entièrement consacrée à la culture, c’est le terrain qui s’est formé au pied du quai, et qui, chaque année, est couvert par l’inondation ce petit coin de terre est soigneusement ensemencé de dourah, de haricots ; c’est là le jardin de l’île."
                            },
                            {
                                "example_id": "b0b6a115-75df-488f-9f18-85c174f59da3",
                                "sense_id": "9c685f92-92ea-3eb0-92fa-1c2b4159d4b9",
                                "text": "Le dourah ou sorgo donne une graine dont la farine forme la base de la nourriture des indigènes."
                            },
                            {
                                "example_id": "c298f978-ddf4-4e1c-ab20-a1d706b8edab",
                                "sense_id": "9c685f92-92ea-3eb0-92fa-1c2b4159d4b9",
                                "text": "Il dit les ravages de la guerre. « Les Abyssins ont dévoré en quelques mois la provision de dourah laissée par les Égyptiens et qui pouvait suffire pour plusieurs années. La famine et la peste sont imminentes. »"
                            }
                        ]
                    }
