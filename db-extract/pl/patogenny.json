                                "target_senses": [
                                    {
                                        "sense_id": "18c22a48-eadc-3a1c-800d-d8716d09982a",
                                        "entry_id": "faa09fe9-e69b-3865-9ae0-378fec74892b",
                                        "glosses": [
                                            "Able to cause (harmful) disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445432a6-4f32-4522-ac8c-fd690271f6b0",
                                                "sense_id": "18c22a48-eadc-3a1c-800d-d8716d09982a",
                                                "text": "While the environment is teeming with bacteria and fungi, most are not pathogenic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fe29c3-0018-3f46-b684-1fd65b6b5a4e",
                                        "entry_id": "faa09fe9-e69b-3865-9ae0-378fec74892b",
                                        "glosses": [
                                            "Consisting of harsh, percussive, nonverbal sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ba1605-a50c-4c25-b000-44e444836fe1",
                                                "sense_id": "43fe29c3-0018-3f46-b684-1fd65b6b5a4e",
                                                "text": "Melogenic music represents the wide middle area between the extremes of logogenic and pathogenic music."
                                            }
