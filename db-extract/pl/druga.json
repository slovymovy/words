                                            "A child aged two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a2a8668-7a35-4693-a9b2-8daf69dec6c0",
                                                "sense_id": "a272b4e5-47a7-38af-b5c2-fc1f8f653ddf",
                                                "text": "This toy is suitable for the twos and threes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "347261f8-1e62-3623-8e4c-a2484e19cce3",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
                                        "glosses": [
                                            "A playing card featuring two pips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bb47b8b-0881-3ead-acb6-9e7dab43e2b9",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
                                        "glosses": [
                                            "Two o'clock, either a.m. or p.m."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c35b99-da1b-4f4a-ad7b-4a90ae9924bc",
                                                "sense_id": "7bb47b8b-0881-3ead-acb6-9e7dab43e2b9",
                                                "text": "It was a weary time. A carriage clock had been placed on the discoloured wooden mantelpiece, and slowly its hands crept on from one to two and from two to three."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee4440e-3f48-3583-bf1e-8d802e674751",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
