                        "entry_id": "54392ee6-2db1-3686-a8f2-608c4b562738",
                        "glosses": [
                            "Gesamtheit aller technischen Gerätschaften, die zur Beleuchtung notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b196d80-4cec-4eaf-8da5-3e2c76ab4f0b",
                                "sense_id": "ebcc6fc2-a298-3741-a941-4090a41adf53",
                                "text": "Der Garten ist sehr, sehr schön geworden. Wir haben uns aber auch von einem Landschaftsgärtner und dann auch besonders bei der Lichttechnik beraten lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
