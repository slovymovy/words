                        ]
                    },
                    {
                        "translation_id": "1584ad15-02b4-4a7b-b764-2d4b4abc20ed",
                        "source_entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                        "source_sense_description": "Art, commercer",
                        "target_lang_word": "jewellery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jewellery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b73d2c1-749c-3492-a091-36b94a08b8be",
                                        "entry_id": "5c9f94f4-2b26-3842-baed-61252a3be8c2",
                                        "glosses": [
                                            "Collectively, personal ornamentation such as rings, necklaces, brooches and bracelets, made of precious metals and sometimes set with gemstones."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffec23c2-6ba2-4090-b237-700ec5965999",
                                                "sense_id": "8b73d2c1-749c-3492-a091-36b94a08b8be",
                                                "text": "The jewellery was very expensive in that shop."
                                            },
                                            {
                                                "example_id": "62f36c6d-fb76-439b-aa4d-4347c89e4923",
                                                "sense_id": "8b73d2c1-749c-3492-a091-36b94a08b8be",
                                                "text": "She had more jewellery ornamented about her than any three ladies needed."
                                            },
                                            {
                                                "example_id": "7b40f140-48f9-48f1-82f8-08793bdf4185",
                                                "sense_id": "8b73d2c1-749c-3492-a091-36b94a08b8be",
                                                "text": "“[…] Captain Markam had been found lying half-insensible, gagged and bound, on the floor of the sitting-room, his hands and feet tightly pinioned, and a woollen comforter wound closely round his mouth and neck ; whilst Mrs. Markham's jewel-case, containing valuable jewellery and the secret plans of Port Arthur, had disappeared.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74de7041-04ec-3776-a333-b69210d39996",
                                        "entry_id": "5c9f94f4-2b26-3842-baed-61252a3be8c2",
                                        "glosses": [
                                            "Any tools, instruments, devices, etc., placed within a drill pipe."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d09425e-2234-47ca-9f60-0df5755d98c7",
                                                "sense_id": "74de7041-04ec-3776-a333-b69210d39996",
                                                "text": "The rig simply retrieves the old pipe and runs a new pipe back in the hole (the completion string). Any special items on the string other than the pipe itself are referred to as \"jewellery\". These can be any number of things, from down-hole motors to mandrels and radioactive sources for survey purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba9d1bf-6e21-3028-bd17-2843243a8d8c",
                                        "entry_id": "5c9f94f4-2b26-3842-baed-61252a3be8c2",
                                        "glosses": [
                                            "The shop from which a jeweller trades or makes jewellery"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0d9aabc-89d5-4c96-a8b6-e00825d6db4d",
                        "source_entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                        "source_sense_description": "Art, commercer",
                        "target_lang_word": "jewelry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jewelry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2742a03a-4ebd-3cb7-8d41-adb966a12268",
                                        "entry_id": "3ba39135-e396-3b22-9dae-6f66b5ccd2fa",
                                        "glosses": [
                                            "US standard spelling of jewellery."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "standard",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177e0d47-572a-4dd7-a039-a2e608cfd5dd",
                                                "sense_id": "2742a03a-4ebd-3cb7-8d41-adb966a12268",
                                                "text": "“The Global Africa Project” at the Museum of Arts & Design tries to survey this pervasiveness, in terms of contemporary visual endeavors of all kinds: jewelry, fashion, architecture, basketry, ceramics, painting, utilitarian design."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jewelry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                                        "entry_id": "38967802-e699-34a1-a59a-41f7a7fdeaf8",
                                        "glosses": [
                                            "To make jewelry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d325ec7c-ab4d-4826-9a0b-aa170fb72a2c",
                                                "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                                                "text": "He was using all the arts of barbering, livery stabling, jewelrying, oratorying, and tailoring."
                                            },
                                            {
                                                "example_id": "40e7c95a-3eac-4760-866d-54a22526045e",
                                                "sense_id": "3808986b-9ad0-326a-b353-cf31c9769bbd",
                                                "text": "The members of this family have an honest and honorable record in their dealings and relations in every way, preferring the peaceful calling of farming, poultrying, and jewelrying; with a home of many comforts and enjoyments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "235b419d-c0b2-3ae7-a740-5e920ea0d430",
                                        "entry_id": "38967802-e699-34a1-a59a-41f7a7fdeaf8",
                                        "glosses": [
                                            "To adorn with jewelry or make into jewelry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf6346b-27eb-4a2a-89dd-a12ea41fd82f",
                                                "sense_id": "235b419d-c0b2-3ae7-a740-5e920ea0d430",
                                                "text": "The large UNESCO hall, where she exhibited, held them all in full space and light — the early paintings, the hand-woven textures and colors in wool, the brilliance of enamels and glass, jewelried silver and gold, and the structured clay metal and stone pieces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e3b95a2-c6c6-4770-b352-a9a32357ae56",
                        "source_entry_id": "b08093fe-0e00-3861-b2e2-18ccf9233149",
                        "source_sense_description": "Art, commercer",
                        "target_lang_word": "ювелирство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ювелирство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "337b9e57-0e92-3478-9d07-f0c98fcba602",
                                        "entry_id": "c9bb4828-1f39-3ce0-aa69-2af9be52c6b1",
                                        "glosses": [
                                            "устар., разг. ювелирное дело, занятие ювелира"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12b23df-11ff-47f9-bee8-6e13fa6b87a5",
                                                "sense_id": "337b9e57-0e92-3478-9d07-f0c98fcba602",
                                                "text": "Так как я не особенный знаток и любитель в ювелирстве и в драгоценных камнях, то до сих пор не особенно внимательно рассматривал выставленные там в окнах вещи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
