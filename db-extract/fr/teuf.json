        "de-extract.jsonl": [
            {
                "entry_id": "9b7b82ae-767c-3225-b4fa-52711258ef80",
                "word": "teuf",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6e45f591-87b6-36f8-bdbd-6fdc040da25e",
                        "entry_id": "9b7b82ae-767c-3225-b4fa-52711258ef80",
                        "glosses": [
                            "Party, Feier, Fete"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "062b18ec-c7c4-45ad-a61c-c302faab39bc",
                                "sense_id": "6e45f591-87b6-36f8-bdbd-6fdc040da25e",
                                "text": "On va faire la teuf, ce soir ?",
                                "translation": "Machen wir heute Abend Party? / Machen wir heute Abend einen drauf?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94ac295e-45b3-45b5-9588-7243aed0d361",
                        "source_entry_id": "9b7b82ae-767c-3225-b4fa-52711258ef80",
                        "source_sense_id": "6e45f591-87b6-36f8-bdbd-6fdc040da25e",
                        "source_sense_description": "umgangssprachlich: Party, Feier, Fete",
                        "target_lang_word": "Party",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Party",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                        "entry_id": "92e5faab-9fd7-34bb-90c4-5a4e31c10b3e",
                                        "glosses": [
                                            "(privates oder öffentliches) geselliges, meist abendliches Treffen, (private oder öffentliche) zwanglose Feier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8fcb126-7442-488d-b388-0274c3052939",
                                                "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                                "text": "„Die DDR war immer noch harmlos genug, dass heute mit ihren Symbolen halbwegs unschuldig Party gemacht werden kann.“"
                                            },
                                            {
                                                "example_id": "2a190fad-de95-4453-bf62-8312d12fa08c",
                                                "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                                "text": "„Danach waren Fotos von Ali auf der Party im Internet veröffentlicht worden.“"
                                            },
                                            {
                                                "example_id": "0bc8de66-4df9-4fe9-8876-60565cc6282f",
                                                "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                                "text": "„Sie kam also zu meiner Party – ich hatte befürchtet, sie werde vielleicht nicht kommen – und war mir gegenüber zum ersten Mal aufgeschlossen.“"
                                            },
                                            {
                                                "example_id": "1d746ab5-27e4-4a44-9416-b23c16abd9ed",
                                                "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                                "text": "„Irgendwo in der Stadt fand eine Party statt.“"
                                            },
                                            {
                                                "example_id": "080a5ddf-6663-4720-9c9a-27f49bca50bb",
                                                "sense_id": "ee4eb38f-088c-3b3f-b07c-999248b637f4",
                                                "text": "„Die Party steigt in einer Dachwohnung im 6. Arrondissement.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94130950-e0f6-4c5f-8660-df0fffc01a57",
                        "source_entry_id": "9b7b82ae-767c-3225-b4fa-52711258ef80",
                        "source_sense_id": "6e45f591-87b6-36f8-bdbd-6fdc040da25e",
                        "source_sense_description": "umgangssprachlich: Party, Feier, Fete",
                        "target_lang_word": "Feier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                        "entry_id": "f2ab48d8-15f3-3862-b69c-957b2863bd08",
                                        "glosses": [
                                            "festliche Veranstaltung aus einem bestimmten Anlass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56813453-f623-4220-910e-2f19704a8a86",
                                                "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                                "text": "Im Dorf findet auf Grund des 100-jährigen Bestehens des Rathauses eine Feier statt."
                                            },
                                            {
                                                "example_id": "02113d7c-9cad-4e5d-a6cd-2408a3e874e1",
                                                "sense_id": "33465f51-4df5-3f0e-8127-6e232dc25057",
                                                "text": "In der Stadt, in der die Eltern unseres Direktors wohnen, gab es eine äußerst große Feier, bei der mehrere kleine Kinder sangen und tanzten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72e5eb76-9666-4188-8312-10d21b681b60",
                        "source_entry_id": "9b7b82ae-767c-3225-b4fa-52711258ef80",
                        "source_sense_id": "6e45f591-87b6-36f8-bdbd-6fdc040da25e",
                        "source_sense_description": "umgangssprachlich: Party, Feier, Fete",
                        "target_lang_word": "Fete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "288cd9ac-4d7a-3585-87a7-2f3ec2d200bf",
                                        "entry_id": "aa091afc-62cb-3962-9251-59676a5161e1",
                                        "glosses": [
                                            "lockere, ungezwungene Feier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739dc8d1-2b73-402f-a057-da09d97a9b00",
                                                "sense_id": "288cd9ac-4d7a-3585-87a7-2f3ec2d200bf",
                                                "text": "„Ja, das Tollste ist doch Lachen, wenn wir eine Fete machen.“"
                                            },
                                            {
                                                "example_id": "a43ebb16-6f25-4fdf-92ae-e44b7c71ab79",
                                                "sense_id": "288cd9ac-4d7a-3585-87a7-2f3ec2d200bf",
                                                "text": "„Meine Freunde hatten unser neues Haus noch nie gesehen, und ich erzählte in der Schule, dass wir eine kleine Fete machen könnten.“"
                                            },
                                            {
                                                "example_id": "42dc0941-ea71-4b10-abcb-3dade682737d",
                                                "sense_id": "288cd9ac-4d7a-3585-87a7-2f3ec2d200bf",
                                                "text": "Da sachte einer: „Ick jebe bei mir im Jarten ne Fete.“ (Nina Hagen) (Das Beispiel ist im Dialekt, kein Standarddeutsch.)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
