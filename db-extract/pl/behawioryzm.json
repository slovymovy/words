                "senses": [
                    {
                        "sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "glosses": [
                            "podejście do psychologii skupiające się na obserwowalnym zachowaniu, negujące poznawalność umysłu i przeważnie zakładające, że zachowanie jest określane przez środowisko"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "bb2e2aa8-92a3-47bd-beac-5e6492460c3b",
                                "sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                                "text": "W \"ortodoksyjnej\" wersji behawioryzmu najpierw występuje reakcja, następnie zaś bodziec"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f32f067-706a-4440-8a07-6d03e1e80a1d",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "behaviorism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behaviorism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dc61d1-ad65-3d3c-a9c4-c1f554e0ce14",
                                        "entry_id": "bfb164df-8217-3f69-ae0e-0e5e1a039b5c",
                                        "glosses": [
                                            "An approach to psychology focusing on observable behavior which, generally assuming that behavior is determined by the environment and denying any independent significance for mind, largely ignores any pathophysiological processes which may, or may not, underlie subjective, behavioral phenomena."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24db92d4-ae47-4b05-a3ef-ec5237f86e04",
                                                "sense_id": "f9dc61d1-ad65-3d3c-a9c4-c1f554e0ce14",
                                                "text": "Behaviorism is considered by most philosophers of medicine, to be an expression of the weaker, minimalist interpretation of the 'medical model' of clinical psychology because it focuses the study and classification of mental disorders upon a phenomenological, rather than a pathophysiological, approach to the subject."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44cab27b-a683-459a-a112-23e244356c90",
                        "source_entry_id": "554bc762-252e-3b3b-a2b0-c24cc8f2906d",
                        "source_sense_id": "a6fbe931-0f08-31ff-b0e5-12b84522083b",
                        "target_lang_word": "behaviorismus",
