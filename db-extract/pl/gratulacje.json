                        "entry_id": "c1aedd8c-5a5b-300d-86c4-ef33cf4ef993",
                        "glosses": [
                            "wyrazy uznania przekazywane komu z okazji szczęśliwego wydarzenia w życiu tej osoby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8258216-7c86-40d1-b143-c1e4ab4d89a6",
                                "sense_id": "90c04d9b-9a2b-3d3a-a531-4b4b2cf77b7c",
                                "text": "Serdeczne gratulacje z okazji 190000. słowa w Wikisłowniku!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c694886-2aae-495a-9f8a-adb94bc92606",
                        "source_entry_id": "c1aedd8c-5a5b-300d-86c4-ef33cf4ef993",
                        "source_sense_id": "90c04d9b-9a2b-3d3a-a531-4b4b2cf77b7c",
                        "target_lang_word": "congratulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congratulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1233d16e-d1a7-382c-8270-8b890cf0615b",
                                        "entry_id": "e695b7d9-dd93-34e4-896c-b1b8571184cb",
                                        "glosses": [
                                            "The act of congratulating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "359571dc-3bdf-4d16-95fb-5c39d0f212ae",
                                                "sense_id": "1233d16e-d1a7-382c-8270-8b890cf0615b",
                                                "text": "May I present my warmest congratulations?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32ece336-3856-435b-a75c-468c66643332",
                        "source_entry_id": "c1aedd8c-5a5b-300d-86c4-ef33cf4ef993",
                        "source_sense_id": "90c04d9b-9a2b-3d3a-a531-4b4b2cf77b7c",
                        "target_lang_word": "Gratulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gratulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb64048c-7be7-3218-ab91-34d3a6327360",
                                        "entry_id": "138bacfe-67ca-3b6c-8060-646031bfa734",
                                        "glosses": [
                                            "Äußerung der Anerkennung oder Freude über etwas Positives bei einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7e5511-0131-4048-a4fe-1db02699233a",
                                                "sense_id": "bb64048c-7be7-3218-ab91-34d3a6327360",
                                                "text": "Viele Gratulationen gingen ein."
                                            },
                                            {
                                                "example_id": "d3c36618-11ed-4dff-9d07-3b566444dc2a",
                                                "sense_id": "bb64048c-7be7-3218-ab91-34d3a6327360",
                                                "text": "„Inmitten der Gratulationen und Umarmungen kommt Charles etwas verlegen herein, und das löst eine weitere Welle von Glückwünschen aus.“"
                                            },
                                            {
                                                "example_id": "ea314df2-c0c5-4e86-9d2a-6c63ec0ae7e2",
                                                "sense_id": "bb64048c-7be7-3218-ab91-34d3a6327360",
                                                "text": "„Der Artikel wurde zwei volle Spalten lang, und als Simon, nach Entgegennahme der Gratulation seiner sämtlichen Kollegen, endlich den Hörer auflegte, war er zum erstenmal in seiner journalistischen Laufbahn mit seiner Leistung hundertprozentig zufrieden.“"
                                            },
                                            {
                                                "example_id": "8bad8ccf-0c3d-4fb0-b9ff-1dd83f7f70f0",
                                                "sense_id": "bb64048c-7be7-3218-ab91-34d3a6327360",
                                                "text": "„Der Professor schlug ihm einen Briefwechsel vor, in welchem er ihn in Fragen der Literatur auf dem laufenden halten wollte; und nach abermaliger Gratulation wünschte er ihm eine gute Gesundheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4386e798-0c41-46c9-b5be-763b9d9d1b96",
                        "source_entry_id": "c1aedd8c-5a5b-300d-86c4-ef33cf4ef993",
                        "source_sense_id": "90c04d9b-9a2b-3d3a-a531-4b4b2cf77b7c",
                        "target_lang_word": "Glückwunsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glückwunsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                        "entry_id": "5cca5e26-80ea-3f36-897a-4b0c6072f97f",
                                        "glosses": [
                                            "Gratulation zu einem besonderen Ereignis, zum Beispiel Geburtstag, Hochzeit oder Geburt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d79a9db-b5f1-4d41-a0fe-b29139247cba",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Die besten Glückwünsche zur Vermählung!"
                                            },
                                            {
                                                "example_id": "8f1559e0-a093-4cb9-915e-df7590cb87e5",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Herzlichen Glückwunsch! Das hast du ja wunderbar hinbekommen, jetzt ist der zweite Griff auch noch abgebrochen!"
                                            },
                                            {
                                                "example_id": "13c9e9b1-4bad-4fa0-af83-ac3bc460a0a6",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Darf ich Ihnen meine Glückwünsche zur bestandenen Prüfung aussprechen?"
                                            },
                                            {
                                                "example_id": "2a7e6344-8433-46f5-b9de-b12b70a30cf4",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Herzlichen Glückwunsch nachträglich zum Geburtstag!"
                                            },
                                            {
                                                "example_id": "9e2d71dc-94b5-4e1c-b11f-bb1fc724349c",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Herzlichen Glückwunsch zur Geburt eurer Tochter!"
                                            },
                                            {
                                                "example_id": "63ce09cf-3a49-48a0-886e-fdd9421053b3",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Er stand auf der Treppe und nahm die Glückwünsche der Belegschaft entgegen."
                                            },
                                            {
                                                "example_id": "64f508f6-2dcf-4e64-b6e5-bf2c3b37aa87",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "Vielen Dank für die Glückwünsche zu meinem Geburtstag."
                                            },
                                            {
                                                "example_id": "99fae837-e23f-4d46-a22a-833f50e17e98",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "„Ein Papier war dabei mit einem kurzen Glückwunsch vom Oberst.“"
                                            },
                                            {
                                                "example_id": "435b9f3a-1712-4a1a-a924-ce3d671d856c",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "„Inmitten der Gratulationen und Umarmungen kommt Charles etwas verlegen herein, und das löst eine weitere Welle von Glückwünschen aus.“"
                                            },
                                            {
                                                "example_id": "3ab42e51-60ee-4953-9d9f-1b6a26dfce36",
                                                "sense_id": "f4e968d3-8199-354d-8d06-750598f7bb58",
                                                "text": "„Die Glückwünsche wurden nochmals erwidert und die zurückgehenden Behältnisse mit viel handgearbeitetem Schuhwerk gefüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
