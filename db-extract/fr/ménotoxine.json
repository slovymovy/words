                        "glosses": [
                            "Substance toxique hypothétique créée par le corps des femmes pendant leur menstruation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f71344b-44e9-4387-a95b-0a7716cf910e",
                                "sense_id": "ecb3841c-4d6e-3a9a-83de-0f6858f9ddf4",
                                "text": "Le lait d’une nourrice qui a ses règles, provoque fréquemment des troubles chez le nourrisson, surtout le lait du premier jour des règles ; on l’a attribué à la présence d’une substance toxique, la ménotoxine."
                            },
                            {
                                "example_id": "a9f8cb5a-af50-4ccd-addd-535889bf2d76",
                                "sense_id": "ecb3841c-4d6e-3a9a-83de-0f6858f9ddf4",
                                "text": "C’est en 1920 à Vienne qu’est élaborée par le docteur Bela Schick la théorie des ménotoxines, qui vient donner une justification médicale au prétendu pouvoir néfaste de la femme indisposée."
                            }
                        ]
                    }
