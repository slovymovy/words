                                        "sense_id": "81698e96-8cd3-37f8-9b65-e55c5ebaaa99",
                                        "entry_id": "bc9879be-5321-327d-a6f1-b9b0b7012df8",
                                        "glosses": [
                                            "muž, který získává obživu tím, že se zbraní přepadává projíždějící povozy a obírá je násilně o zboží či peníze"
                                        ],
                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cce155f-882d-46b8-bf14-b3f680ff8b13",
                                                "sense_id": "81698e96-8cd3-37f8-9b65-e55c5ebaaa99",
                                                "text": "Nejslavnějším anglickým zbojníkem je patrně Robin Hood (pokud tedy vůbec kdy existoval). U Slováků na druhou stranu mezi zbojníky jednoznačně vede Jánošík, za doposud nejznámějšího ukrajinského či rusínského zbojníka můžeme považovat Nikolu Šuhaje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787518fe-b9f0-3d97-a151-5021a7981546",
                                        "entry_id": "bc9879be-5321-327d-a6f1-b9b0b7012df8",
                                        "glosses": [
                                            "divoký, temperamentní, neposlušný chlapec"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc52af78-16cd-4c1e-8a1c-a9ed782d469c",
                                                "sense_id": "787518fe-b9f0-3d97-a151-5021a7981546",
                                                "text": "O kus dál s neutrálním výrazem postává muž, kope si do míčku a po očku sleduje svého zbojníka s nudlí u nosu, který se pokouší do malé korby náklaďáku umístit aspoň deset kilo písku. Rozpravy o plenkách ho bytostně nezajímají a o obědu má dávno jasno."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
