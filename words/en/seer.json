{
    "word_family": [
        "see",
        "seeing",
        "seen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "931705a2-ef31-3eb2-b854-841f789e4d9e",
                    "sense_definition": "A person who claims to be able to predict the future or see supernatural events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prophet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>seer</w> warned the king about the coming storm.",
                            "target_lang_translations": {
                                "ru": "Древний <w>прорицатель</w> предупредил царя о надвигающейся буре."
                            }
                        },
                        {
                            "text": "Many people visited the <w>seer</w> to learn what their future held.",
                            "target_lang_translations": {
                                "ru": "Многие приходили к <w>провидцу</w>, чтобы узнать, что их ждет в будущем."
                            }
                        }
                    ],
                    "synonyms": [
                        "prophet",
                        "clairvoyant",
                        "soothsayer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, утверждающий, что может предсказывать будущее или видеть сверхъестественные события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "человек с даром предвидения"
                            },
                            {
                                "target_lang_word": "прорицатель",
                                "target_lang_sense_clarification": "предсказатель будущего"
                            },
                            {
                                "target_lang_word": "провидица",
                                "target_lang_sense_clarification": "женщина-прорицатель"
                            },
                            {
                                "target_lang_word": "ясновидящий",
                                "target_lang_sense_clarification": "обладающий экстрасенсорным видением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a019784-6834-34c7-af97-0f87d605a95b",
                    "sense_definition": "A person who observes or witnesses something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "observer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>seer</w> of great artistic beauty in the natural world.",
                            "target_lang_translations": {
                                "ru": "Он был тем редким <w>наблюдателем</w>, способным видеть великую художественную красоту в мире природы."
                            }
                        },
                        {
                            "text": "The <w>seer</w> described the event exactly as it had occurred.",
                            "target_lang_translations": {
                                "ru": "<w>Очевидец</w> описал происшествие в точности так, как оно случилось."
                            }
                        }
                    ],
                    "synonyms": [
                        "observer",
                        "witness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is literary and uncommon in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто наблюдает или становится свидетелем чего-либо (устаревшее или книжное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очевидец",
                                "target_lang_sense_clarification": "непосредственный свидетель событий"
                            },
                            {
                                "target_lang_word": "свидетель",
                                "target_lang_sense_clarification": "тот, кто лично что-либо видел"
                            },
                            {
                                "target_lang_word": "наблюдатель",
                                "target_lang_sense_clarification": "тот, кто созерцает или замечает"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a16841-bf47-3c26-88dc-b80eda8f6704",
                    "sense_definition": "A measure of the efficiency of cooling equipment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new air conditioner has a very high <w>seer</w> rating.",
                            "target_lang_translations": {
                                "ru": "У нового кондиционера очень высокий показатель <w>SEER</w>."
                            }
                        },
                        {
                            "text": "Check the <w>seer</w> to ensure the unit is energy efficient.",
                            "target_lang_translations": {
                                "ru": "Проверьте <w>коэффициент энергоэффективности</w>, чтобы убедиться в экономичности устройства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high seer",
                        "seer rating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коэффициент сезонной энергоэффективности систем кондиционирования и охлаждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SEER",
                                "target_lang_sense_clarification": "аббревиатура сезонного коэффициента энергоэффективности"
                            },
                            {
                                "target_lang_word": "коэффициент сезонной энергоэффективности",
                                "target_lang_sense_clarification": "полное техническое наименование показателя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}