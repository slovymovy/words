                ],
                "senses": [
                    {
                        "sense_id": "257bce2d-71f0-3dc0-b3d4-da79f93e53fb",
                        "entry_id": "611dc2a0-b300-3526-8726-e21fa44330a0",
                        "glosses": [
                            "eine von anderen in ihrem Verhalten eigenartig und seltsam erscheinende weibliche Person, die den Kontakt zu anderen meidet und lieber für sich bleibt sowie ihre Angelegenheiten auf eigene Weise und für sich allein erledigt"
                        ],
                        "tags": [
                            "oft abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "b1979008-cecf-4686-96a3-3dfdb2cea303",
                                "sense_id": "257bce2d-71f0-3dc0-b3d4-da79f93e53fb",
                                "text": "Oft sieht man sie in Rollen als Eigenbrötlerin und Neurotikerin: Sie hat Talent für komplizierte, etwas zerbrechliche Frauen, die man retten möchte, obwohl sie das womöglich gar nicht wollen."
                            },
                            {
                                "example_id": "1d2baf9f-45bb-4c1e-b62a-452263e9b543",
                                "sense_id": "257bce2d-71f0-3dc0-b3d4-da79f93e53fb",
                                "text": "Statt in ihr [Emily Dickinson] einfach eine romantische Künstlerin der Oberschicht zu sehen, die nun mal in eine Frau verliebt war, habe man sie immer als übergeschnappte Eigenbrötlerin abgetan."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
