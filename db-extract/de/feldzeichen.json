                ],
                "senses": [
                    {
                        "sense_id": "760e1b53-d02d-34ba-89bc-77f89664f222",
                        "entry_id": "bf5a0ec6-4fe9-3ccc-af74-81aa3bef592c",
                        "glosses": [
                            "militärisches Erkennungszeichen in Form einer Figur, Flagge, Standarte …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007c2c50-94f5-42cf-aa01-d894adef2644",
                                "sense_id": "760e1b53-d02d-34ba-89bc-77f89664f222",
                                "text": "„Als der Statthalter Marcus Lollius den Eindringlingen mit einer Legion entgegentritt, wird er vernichtend geschlagen und verliert sogar das Feldzeichen, den Legionsadler - ein Schock für die seit Cäsar wieder siegesgewohnten Römer.“"
                            },
                            {
                                "example_id": "71cfe12d-cbec-48fd-8a54-0c8e6914102d",
                                "sense_id": "760e1b53-d02d-34ba-89bc-77f89664f222",
                                "text": "„Daß die Kelten aber nicht nur wild und blindlings auf ihre Gegner einstürmten, wie ihre Feinde behaupteten, sondern auch geordnet angreifen und kämpfen konnten, zeigen Feldzeichen mit Tierdarstellungen, Fahnen an Lanzen mit verzierten Lanzenspitzen und lange Signalhörner mit Schalltrichtern in Form eines Tierkopfes.“"
                            },
                            {
                                "example_id": "710c7572-d0af-4870-ae5b-e396e8cdf5db",
                                "sense_id": "760e1b53-d02d-34ba-89bc-77f89664f222",
                                "text": "„Die Mannschaft hatte sich befehlsgemäß mit Feldzeichen geschmückt, bei der Verlautbarung des Sieges wurde ein Hurra ausgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
