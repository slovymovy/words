{
    "word_family": [
        "delude",
        "delusion",
        "delusive",
        "delusory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ff4ad3c-ba7b-337e-b76a-fe6854ca2db2",
                    "sense_definition": "Believing something that is not true or having false ideas about reality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>deluded</w> to think that she cared in the slightest.",
                            "target_lang_translations": {
                                "cs": "<w>Žil v iluzi</w>, když si myslel, že jí na něm alespoň trochu záleží."
                            }
                        },
                        {
                            "text": "The <w>deluded</w> man believed he could fly by jumping off the roof.",
                            "target_lang_translations": {
                                "cs": "Ten <w>bláhový</w> muž věřil, že může létat, když skočí ze střechy."
                            }
                        }
                    ],
                    "synonyms": [
                        "delusional"
                    ],
                    "target_lang_definitions": {
                        "cs": "Žijící v bludu nebo mající falešné představy o realitě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mající bludy",
                                "target_lang_sense_clarification": "trpící klamnou představou"
                            },
                            {
                                "target_lang_word": "naivní",
                                "target_lang_sense_clarification": "žijící v sebeklamu či iluzi"
                            },
                            {
                                "target_lang_word": "vedený sebeklamem",
                                "target_lang_sense_clarification": "podléhající klamu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad4098de-756a-3aba-9f56-44cb50ee13aa",
                    "sense_definition": "Simple past and past participle of <w>delude</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman <w>deluded</w> the customers into buying broken products.",
                            "target_lang_translations": {
                                "cs": "Prodavač zákazníky <w>obelhal</w>, aby si koupili rozbité zboží."
                            }
                        },
                        {
                            "text": "She felt <w>deluded</w> by his false promises of a promotion.",
                            "target_lang_translations": {
                                "cs": "Cítila se <w>oklamána</w> jeho falešnými sliby o povýšení."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a minulé příčestí od slovesa delude (oklamat, uvést v omyl)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "oklamal",
                                "target_lang_sense_clarification": "minulý čas slovesa oklamat"
                            },
                            {
                                "target_lang_word": "uvedl v omyl",
                                "target_lang_sense_clarification": "minulý čas od uvést v omyl"
                            },
                            {
                                "target_lang_word": "oklamaný",
                                "target_lang_sense_clarification": "trpné příčestí (podvedený)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}