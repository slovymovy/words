                "senses": [
                    {
                        "sense_id": "31f829af-bb83-372d-897b-948d3c8c18a7",
                        "entry_id": "4f83f9e1-1c10-3ce4-82a5-be817a102dcd",
                        "glosses": [
                            "osoba, która przygotowuje się na wypadek wojny, klęsk żywiołowych, katastrof itp. – gromadzi zapasy żywności, leków, materiałów, szkoli się z technik surwiwalowych, niekiedy również szykuje broń i buduje prywatny schron"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0449a216-ae57-40ad-b8a2-a1744cc802ad",
                                "sense_id": "31f829af-bb83-372d-897b-948d3c8c18a7",
                                "text": "Ruch preppersów wpisuje się w długą tradycję ruchu surwiwalistów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "729e0344-962f-47c8-8147-9e95432d809a",
                        "source_entry_id": "4f83f9e1-1c10-3ce4-82a5-be817a102dcd",
                        "source_sense_id": "31f829af-bb83-372d-897b-948d3c8c18a7",
