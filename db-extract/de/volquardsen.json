                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701f34f6-ea4e-4b70-aace-b75f5590e802",
                                "sense_id": "ccd8dea6-e6f8-3a6a-8d65-124763ddac58",
                                "text": "Der Hund des kleinen Volquardsen verrichtet seine Notdurft immer in meinem Blumenbeet."
                            },
                            {
                                "example_id": "a149505a-1e86-4852-93ad-c075cb864b2f",
                                "sense_id": "ccd8dea6-e6f8-3a6a-8d65-124763ddac58",
                                "text": "Nachdem seine Mutter gestorben war, verprasste Herr Volquardsen in Windeseile sein komplettes Erbe."
                            },
                            {
                                "example_id": "aeacc5e3-201e-42d1-95e8-8947d69b78be",
                                "sense_id": "ccd8dea6-e6f8-3a6a-8d65-124763ddac58",
                                "text": "Bauer Volquardsen hat kein Geld für eine neue Rundballenpresse."
                            },
                            {
                                "example_id": "ad0016a0-05b2-4a6c-93c2-d546abb8e4fd",
                                "sense_id": "ccd8dea6-e6f8-3a6a-8d65-124763ddac58",
                                "text": "Die Volquardsens sind sehr friedliebende Personen."
                            }
                        ],
