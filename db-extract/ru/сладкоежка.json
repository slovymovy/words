                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e744129-20e6-3242-8403-56abf9545282",
                        "entry_id": "eb303dbe-c6cd-32ff-a743-e1ae0451747e",
                        "glosses": [
                            "разг. тот, кто любит сладкое; сластёна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae94377b-5c96-41d6-ae02-6102c031987a",
                                "sense_id": "1e744129-20e6-3242-8403-56abf9545282",
                                "text": "Торт занимал почти весь прилавок, а покупатели-сладкоежки, став на цыпочки, с завистью поглядывали на его кремовые розы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e72afc6b-066d-484c-8980-614e375c3dda",
                        "source_entry_id": "eb303dbe-c6cd-32ff-a743-e1ae0451747e",
                        "source_sense_id": "1e744129-20e6-3242-8403-56abf9545282",
                        "target_lang_word": "foodie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foodie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                        "entry_id": "f3340e60-1de5-35db-b19d-142bb097a786",
                                        "glosses": [
                                            "A person with a special interest in or knowledge of food, a gourmet."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c46c64-fb53-47fb-b6c7-8085dec007a9",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "We self-professed foodies liked to meet in restaurants and talk like experts about what we were eating."
                                            },
                                            {
                                                "example_id": "f71d894e-3db7-4ee1-9a55-6c507e381150",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "She offers crayfish with white feet or red . . . three ways, tends stove in high heels, slips into the small Art Deco dining room of Restaurant d'Olympe—a funeral parlor of shiny black walls and red velvet—to graze cheeks with her devotees, serious foodies, and, from ten on, tout Paris, the men as flashily beautiful as their beautiful women."
                                            },
                                            {
                                                "example_id": "b392e62a-774e-4b5c-a9c9-eb0ada934fb5",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "Foodies are the ones talking about food in any gathering—salivating over restaurants, recipes, radicchio. They don't think they are being trivial–Foodies consider food to be an art, on a level with painting or drama."
                                            },
                                            {
                                                "example_id": "95042abf-5b38-4087-b30e-51c5c9aa425e",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "“Foodie” has now pretty much everywhere replaced “gourmet”, perhaps because the latter more strongly evokes privilege and a snobbish claim to uncommon sensory discrimination—even though those qualities are rampant among the “foodies” themselves."
                                            },
                                            {
                                                "example_id": "bb8e6be1-b0a2-4a47-8c15-230179a26608",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "While the Foodie Handbook is now decades old, its message strikes a chord with contemporary foodie discourse, touching on themes like the abysmal quality of mainstream food (e.g., “cheese in plastic-wrapped portions”), the appeal of foodie accoutrement like chefs' knives and gas stoves, as well as the importance of thinking and talking about food (as opposed to just eating well—“pigs can eat well”) (1984: 6–7)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a60c477-d78d-4770-b55b-f19aab6ff082",
                        "source_entry_id": "eb303dbe-c6cd-32ff-a743-e1ae0451747e",
                        "source_sense_id": "1e744129-20e6-3242-8403-56abf9545282",
                        "target_lang_word": "Leckermaul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leckermaul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                        "entry_id": "91f1a3c8-7566-3400-8275-11250bd189f1",
                                        "glosses": [
                                            "Person, die gerne isst, insbesondere Süßes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "708507db-ac0b-4fcd-bb70-fb582a364515",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "»Meine Leckermäuler zu Hause lieben meine Kirschtorte.«"
                                            },
                                            {
                                                "example_id": "099ec85c-57f7-4d5a-97f5-9f15b7cc2b8c",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "„Deutschen Backwaren wie Stollen kann sie [Oxana] als Leckermaul kaum widerstehen.“"
                                            },
                                            {
                                                "example_id": "9bfc2eef-af7d-4887-a6ef-21113aef115b",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "„Für das Leckermaul empfehle ich das \"Herpich's\" in Jean Pauls Wohnhaus (Friedrichstraße) - dabei empfiehlt es sich, unbedingt Heiner Herpich persönlich kennenzulernen.“"
                                            },
                                            {
                                                "example_id": "e7a090e4-c975-4a9f-8040-15cd9c8a5c44",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "„Wer sich Sorgen um Kalorien oder seine Gesundheit macht, der sollte auf Zartbittersorten umsteigen. Die sind nicht nur kalorienärmer, sondern verleiten das Leckermaul auch nicht so sehr zur Maßlosigkeit.“"
                                            },
                                            {
                                                "example_id": "edf26b75-f75a-4cdc-bb6f-5fc672fd8d45",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "„Und wir diskutieren darüber, welche Törtchen dort am leckersten sind, und er sagt, er sei das reinste Leckermaul, und ich sage: »Es gibt kein größeres Leckermaul als mich!« Und wir streiten ein Weilchen darüber, wer das größere Leckermaul ist, aber er besteht darauf, dass er es ist.“"
                                            },
                                            {
                                                "example_id": "f282856a-1f45-4bc8-bf25-44cc48f9b3a7",
                                                "sense_id": "3d7b6db6-2a64-3636-8e64-887b14a99b3d",
                                                "text": "„Sein Haushofmeister wünschte zu wissen, was sein Herr mit diesen Rebhühnern machen wollte, brachte sie ihm, wie sie vom Spieß kamen und einen aromatischen Duft verbreiteten, der allein schon genügte, einem Leckermaul das Wasser im Munde zusammenzutreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
