                                            {
                                                "example_id": "d7dec1f1-8fc3-4c63-8d53-32977ac97f4d",
                                                "sense_id": "5ce0aa05-b971-3263-9d24-583764fa4643",
                                                "text": "Derzeit sind meine Kurzmeldungen wahrscheinlich verwirrend."
                                            },
                                            {
                                                "example_id": "a4056e6f-a1b6-4cf6-8d9c-445ac5bfdfff",
                                                "sense_id": "5ce0aa05-b971-3263-9d24-583764fa4643",
                                                "text": "Nun verwirr mal deinen Großvater nicht!"
                                            },
                                            {
                                                "example_id": "18bd6b68-8be1-4083-8d2a-fc15ca633606",
                                                "sense_id": "5ce0aa05-b971-3263-9d24-583764fa4643",
                                                "text": "Jetzt hast du die Arme ganz verwirrt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd440268-dfad-3cbe-8289-ed8f21234b96",
                                        "entry_id": "bcfb15ed-195f-39b6-b5a8-6a44aaa024e6",
                                        "glosses": [
                                            "etwas durcheinander bringen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c67440-e326-4eed-b0b2-25ea3fd38490",
                                                "sense_id": "bd440268-dfad-3cbe-8289-ed8f21234b96",
                                                "text": "Achte bitte darauf, die Fäden nicht zu verwirren, wenn du das Arbeitsstück umdrehst."
                                            },
                                            {
                                                "example_id": "6f4c1210-e7a1-4079-8f42-5d0fdd5cc131",
                                                "sense_id": "bd440268-dfad-3cbe-8289-ed8f21234b96",
                                                "text": "Jetzt haben Sie die Begriffe verwirrt, die Methode ist effektiv aber nicht effizient."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
