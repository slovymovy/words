                "senses": [
                    {
                        "sense_id": "b44d4109-cb0d-3c59-9e73-632ce889fd8f",
                        "entry_id": "0c3611a4-9a3f-360a-98c8-76eda0ab40bd",
                        "glosses": [
                            "Person weiblichen Geschlechts, die leiblich von jemandem/Familie abstammt"
                        ],
                        "tags": [
                            "outdated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "55b580a7-cde4-476f-b62d-287a971ab566",
                                "sense_id": "b44d4109-cb0d-3c59-9e73-632ce889fd8f",
                                "text": "„Sie, die Abkömmlingin eines adligen Geschlechtes, […] die Erbin – sobald sie wollte – von Millionen, die Bürgerin des größten Freistaates der Welt – sie, die sich gerade so vornehm glaubte wie er, […] sie sollte ihm nur zur linken Hand angetraut werden dürfen!“"
                            },
                            {
                                "example_id": "37a83efe-4a5d-4d7e-86b2-7b102d445d47",
                                "sense_id": "b44d4109-cb0d-3c59-9e73-632ce889fd8f",
                                "text": "„Nun, das Vermögen und das Schloß sind nicht schlecht, aber, Junge! auf wie manchem Schloß hausen noch Abkömmlinginnen von ungetrübter, echter Abkunft, […]“"
                            },
                            {
                                "example_id": "60286c2c-6923-451f-82ea-f8c23a2a0362",
                                "sense_id": "b44d4109-cb0d-3c59-9e73-632ce889fd8f",
                                "text": "„Auf die Handarbeit per se ist wiederum Frau von Arnim, Abkömmlingin eines 800 Jahre alten Adelsgeschlechts (und tatsächlich entfernte Verwandte der romantischen Schrifstellerin Bettina), bestimmt gut zu sprechen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88ee53e1-6dce-4062-8af5-97590594ba1a",
                        "source_entry_id": "0c3611a4-9a3f-360a-98c8-76eda0ab40bd",
                        "source_sense_id": "b44d4109-cb0d-3c59-9e73-632ce889fd8f",
                        "source_sense_description": "weibliche Person, die leiblich von jemandem abstammt",
                        "target_lang_word": "descendante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descendante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e65f24b-2fb5-3106-855f-a54247476d1a",
                                        "entry_id": "3b1ef66a-bc21-3e1b-9be1-b2ef11916e2a",
                                        "glosses": [
                                            "Celle qui est de la même famille et d’une génération postérieure."
                                        ],
                                        "tags": [
                                            "Famille",
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15919538-0a4f-498c-be68-ed2bb5573de9",
                                                "sense_id": "6e65f24b-2fb5-3106-855f-a54247476d1a",
                                                "text": "Les charmes quelque peu fanés de la descendante des Pignon-Mouillet n’étaient plus tels qu’ils attirassent encore irrésistiblement le mâle impétueux qu’était resté le vieux militaire."
                                            },
                                            {
                                                "example_id": "8cd13416-77d2-4fad-aed4-e939e42965fe",
                                                "sense_id": "6e65f24b-2fb5-3106-855f-a54247476d1a",
                                                "text": "Issue du mariage de François de Brantes et d'Aymone de Faucigny-Lucinge, elle-même descendante du duc de Berry – fils du roi Charles X –, Anne-Aymone Giscard d'Estaing puisera dans ce haut lignage des codes qui lui faciliteront son rôle de représentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1ec9fab-5879-3c49-9033-0d173cc93a01",
                                        "entry_id": "3b1ef66a-bc21-3e1b-9be1-b2ef11916e2a",
                                        "glosses": [
                                            "Ce qui tire son origine de ce qui existait précédemment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4f18d24-7fcb-3a37-8972-598262a2e4f0",
                                        "entry_id": "3b1ef66a-bc21-3e1b-9be1-b2ef11916e2a",
                                        "glosses": [
                                            "Celle qui descend, qui tire son origine d’une personne ou groupe de personnes."
                                        ],
                                        "tags": [],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "329e7834-6de9-40af-a0dd-e65ed179c807",
                                                "sense_id": "b4f18d24-7fcb-3a37-8972-598262a2e4f0",
                                                "text": "Cette dame était une chérifa, ce qui signifie une descendante du Prophète lui-même. Il se trouve dans l'archipel abondance de tels descendants. Je n'ai jamais très bien compris comment les nombreux chérifs et chérifas que j'ai rencontrés au Sarawak faisaient remonter leurs familles au grand fondateur de l'islam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965baba8-e5fc-3181-b250-4d60dc0f6395",
                                        "entry_id": "3b1ef66a-bc21-3e1b-9be1-b2ef11916e2a",
                                        "glosses": [
                                            "Partie d’un glyphe sous la ligne de base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d9ffdf-e951-4a03-a27d-d93e25801974",
                                                "sense_id": "965baba8-e5fc-3181-b250-4d60dc0f6395",
                                                "text": "Le jambage ou la descendante est la partie du dessin de la lettre venant au dessous de son œil p et q ont des jambages."
                                            },
                                            {
                                                "example_id": "2c11cd05-c586-4c69-9827-8d7fbcb6731d",
                                                "sense_id": "965baba8-e5fc-3181-b250-4d60dc0f6395",
                                                "text": "C’est-à-dire la possibilité de faire déborder la forme imprimante d’un caractère sur celui qui le suit, par exemple la queue du Q, ou sur celui qui le précède et celui qu le suit, par exemple les ascendante et descendante obliques du f."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "descendante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f88c23-dda7-3c7a-a896-8c46bab6e962",
                                        "entry_id": "0c4c798a-cfaa-3d52-aa74-f0cd9de977c1",
                                        "glosses": [
                                            "Féminin singulier de descendant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89eb44aa-8985-46e1-9d96-88c34ebc87cf",
                                                "sense_id": "c4f88c23-dda7-3c7a-a896-8c46bab6e962",
                                                "text": "On débute par un bain de demi-heure à une heure, et on augmente tous les jours d’une heure environ, jusqu’à ce qu’on soit arrivé à ce qu’on appelle la haute baignée, qui se compose en général de quatre à cinq heures de bain le matin, et de une à deux heures l’après midi. La poussée survient du cinquième et treizième jour. On continue la haute baignée jusqu’à ce que cette éruption tende à diminuer, alors on débaigne en diminuant la durée des bains, et procédant à peu près pour cette marche descendante comme on l’a fait dans un ordre inverse en commençant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
