{
    "word_family": [
        "afdanken",
        "afdanker",
        "gedankt"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fa76e95-acc3-328c-8218-35322cb2272b",
                    "sense_definition": "een voorwerp dat door de oorspronkelijke eigenaar is weggedaan en door iemand anders als tweedehandsje wordt gebruikt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tweedehands",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn jongere broertje draagt altijd een <w>afdankertje</w> van mij omdat we kleding willen besparen.",
                            "target_lang_translations": {
                                "en": "My younger brother always wears a <w>hand-me-down</w> of mine because we want to save on clothing."
                            }
                        },
                        {
                            "text": "Deze oude computer is een <w>afdankertje</w> van kantoor dat ik nu thuis voor mijn studie gebruik.",
                            "target_lang_translations": {
                                "en": "This old computer is a <w>cast-off</w> from the office that I now use at home for my studies."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflegger",
                        "afleggertje"
                    ],
                    "common_phrases": [
                        "een oud afdankertje",
                        "afdankertje van kantoor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor kleding of kleine gebruiksvoorwerpen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An object that has been discarded by its original owner and is used by someone else as a second-hand item."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hand-me-down",
                                "target_lang_sense_clarification": "especially clothing passed from one person to another"
                            },
                            {
                                "target_lang_word": "cast-off",
                                "target_lang_sense_clarification": "something thrown away or no longer wanted by its owner"
                            },
                            {
                                "target_lang_word": "second-hand item",
                                "target_lang_sense_clarification": "general term for used goods"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0322e796-343b-3014-9da2-8ef035bc1445",
                    "sense_definition": "verkleinwoord van <w>afdanker</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord <w>afdankertje</w> wordt vaker gebruikt dan de grondvorm afdanker.",
                            "target_lang_translations": {
                                "en": "The word <w>afdankertje</w> is used more often than the root form afdanker."
                            }
                        },
                        {
                            "text": "In de zin fungeert het <w>afdankertje</w> als het lijdend voorwerp van de handeling.",
                            "target_lang_translations": {
                                "en": "In the sentence, the <w>diminutive</w> functions as the direct object of the action."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive form of 'afdanker'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "little cast-off",
                                "target_lang_sense_clarification": "diminutive reference to a discarded item"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}