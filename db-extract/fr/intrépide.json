        "fr-extract.jsonl": [
            {
                "entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                "word": "intrépide",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db81d507-30af-4a22-8abb-a4d40f03ae04",
                        "entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intrépides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c74f70e4-0140-36c1-b202-ab6734d3ae8b",
                        "entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "glosses": [
                            "Qui ne craint pas le péril et l’affronte volontiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ac03ece-7fd4-43f2-8b2b-79ffbff537ad",
                                "sense_id": "c74f70e4-0140-36c1-b202-ab6734d3ae8b",
                                "text": "Des clappements, des crissements et d’étranges grincements rythmiques s’éveillaient, aussitôt que l’intrépide pédaleur avait fait quelques tours de roue."
                            },
                            {
                                "example_id": "ab524c59-e87d-4961-920d-43ab1863624b",
                                "sense_id": "c74f70e4-0140-36c1-b202-ab6734d3ae8b",
                                "text": "[…] il y a le nageur intrépide qui, sourd aux appels du maître baigneur, dépasse les limites du bain surveillé, gagne la pleine mer et est emporté par une lame de fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ebc6f81-6f0c-3e6f-9884-ac89437df8dd",
                        "entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "glosses": [
                            "Qui s’obstine à quelque chose, qui n’est pas rebuté par les désagréments, par les obstacles."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "32f496a1-2439-4dae-be33-6f75091b7d7e",
                                "sense_id": "6ebc6f81-6f0c-3e6f-9884-ac89437df8dd",
                                "text": "Ils étaient là pourtant, nombreux, vieillis, fatigués, ces intrépides voyageurs que leur tempérament mobile promena dans les cinq parties du monde !"
                            },
                            {
                                "example_id": "835263c5-f32c-4a77-b1b7-8269f5f55539",
                                "sense_id": "6ebc6f81-6f0c-3e6f-9884-ac89437df8dd",
                                "text": "Le capitaine Mondelli part pour Bordeaux afin d’y chercher des ordres. Les Allemands ne lui donnant pas de sauf-conduit, l’intrépide officier est contraint de se déguiser […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8c1bd0-c303-4bbb-b858-0500cac57f4e",
                        "source_entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "source_sense_description": "qui ne craint pas le péril et l’affronte volontiers",
                        "target_lang_word": "kühn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kühn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                        "entry_id": "65a3be51-6f36-3696-87bf-c31938187e98",
                                        "glosses": [
                                            "der Gefahr trotzend und ihr entschlossen entgegentretend"
                                        ],
                                        "tags": [
                                            "über Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244b44b5-c091-4260-8474-40d9f03c9576",
                                                "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                                "text": "„… indem sie die Augen kurz aufriß, sie dann jedoch zwischen den wieder verengten Lidern traumhaft verschwimmen ließ, sprach sie das Wort: ‚Du entkleidest mich, kühner Knecht?‘“"
                                            },
                                            {
                                                "example_id": "cb1ae821-6b71-412e-9405-262fb46441f5",
                                                "sense_id": "276ce1b0-bb93-3059-b511-1c4fc7cad936",
                                                "text": "„Sie brachte aus ihren Reihen schließlich auch kühne Eroberer hervor, diese unterstanden jedoch der Kontrolle eines Direktoriums im fernen London, das immer den Rechenstift zur Hand hatte und auf «shareholder value» achtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                        "entry_id": "65a3be51-6f36-3696-87bf-c31938187e98",
                                        "glosses": [
                                            "über ein anerkanntes Maß hinausgehend, gewagt, ungesichert"
                                        ],
                                        "tags": [
                                            "über Handlungen",
                                            "Äußerungen",
                                            "Gedanken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85e353d-6e3f-4b15-a2bf-879b2dd69ef2",
                                                "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                                "text": "Unzählige erfolgversprechende Projekte, die sich die Träumer früherer Zeiten nicht in ihren kühnsten Träumen hätten vorstellen können!"
                                            },
                                            {
                                                "example_id": "2c6ea331-90f6-4154-ac79-92e844b42223",
                                                "sense_id": "79b0b383-efe3-3c67-b4b3-122bd8d62cd5",
                                                "text": "Jede kühne Tat ehrt ihren Täter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff57c4e3-4a04-4708-8011-45dac987a77f",
                        "source_entry_id": "68ea6e86-77ca-348f-819e-340631c972db",
                        "source_sense_description": "qui ne craint pas le péril et l’affronte volontiers",
