                        "sense_id": "12ab113a-08ae-3258-a7fe-3a91660db982",
                        "entry_id": "9a346ac8-4075-31d2-a164-253a057c3453",
                        "glosses": [
                            "To free (someone or something) from a yoke; to disjoin, to unyoke."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c5b2b90-52b8-4c8f-8ba0-bc66f7c63751",
                                "sense_id": "12ab113a-08ae-3258-a7fe-3a91660db982",
                                "text": "Deep, indeed, / Their debt of thanks to her who first had dared / To leap the rotten pales of prejudice, / Disyoke their necks from custom, and assert / None lordlier than themselves but that which made / Woman and man."
                            },
                            {
                                "example_id": "53f52117-02aa-4bfc-8fc3-204b739d2eac",
                                "sense_id": "12ab113a-08ae-3258-a7fe-3a91660db982",
                                "text": "O me, my wife, my boys— / And—O myself, how, miserably moved, / Am I disyoked now from both boys and wife!"
                            }
                        ]
                    }
                ],
