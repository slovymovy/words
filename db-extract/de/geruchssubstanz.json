                ],
                "senses": [
                    {
                        "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                        "entry_id": "9e9af3ef-2a44-3c4a-b02a-592dddc8ed41",
                        "glosses": [
                            "Stoff in fester oder flüssiger Form mit bestimmten Eigenschaften, auf die die Sinneszellen des Geruchsorgans ansprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fc67d68-4196-4a8c-8a1c-ff3dd94c6bde",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Geruchssubstanzen, die man in den zuvor erwähnten, anziehenden Blüten identifiziert hatte, im Geruch der Menschen wieder auf.“"
                            },
                            {
                                "example_id": "3ac9c029-e9ac-4a1b-9f0a-cb21d4fa5dc6",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Der Erfolg ist, daß der ganze Körper in Transpiration gerät, dadurch alle Poren geöffnet werden und die Dünste der verbrannten oder verkohlten Geruchssubstanzen von dem Körper gründlich aufgenommen werden.“"
                            },
                            {
                                "example_id": "5a2cf776-86e7-469f-8b8f-a057237bbaf4",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Die Fäulnisbakterien erzeugen neben den Eiweißspaltstücken die starken Giftstoffe und widerlichen Geruchssubstanzen.“"
                            },
                            {
                                "example_id": "d219f2d2-ebf4-401e-b757-35d975e07044",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Nicht nur wird der natürliche, positive Körpergeruch mit Hilfe von Duftstoffen überdeckt, die Geruchssubstanzen sind auch häufig sehr fragwürdig, da sie Allergien und Schlimmeres auslösen können.“"
                            },
                            {
                                "example_id": "9bf39096-14a7-4913-8a5f-0bf1284d8394",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Heute wird die Fähigkeit, Gutes zu erriechen, immer schwieriger, weil Kosmetik und Werbeindustrie Gerüche als Geschäftsfeld erkannt haben und unsere Nasen mit künstlichen Geruchssubstanzen überfordern.“"
                            },
                            {
                                "example_id": "37a89a5e-7e84-419d-9d3d-1a0dc822d29a",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„Diese Luft verhindert, daß Geruchssubstanzen aus dem Mund in die Nasenhöhle aufsteigen können.“"
                            },
                            {
                                "example_id": "0b95fa81-dcf0-45c6-9eea-a9960f3f2c61",
                                "sense_id": "703d3853-c596-3ae8-ab2f-6695651b5859",
                                "text": "„In langer Reihe standen Geruchssubstanzen wie Weihrauch, Ambra, Sandelholz, Kampher, Rosenblätter, aber auch Öle und Extrakte von schwarzem Jasmin, Lotus und weißem Moschus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
