                        {
                            "text": "Zij is een zeer <w>geziene</w> persoonlijkheid binnen de wetenschappelijke gemeenschap.",
                            "target_lang_translations": {
                                "en": "She is a very <w>esteemed</w> personality within the scientific community."
                            }
