                "word": "appellation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9722b31d-bf0a-4278-b649-bae094a75e8d",
                        "entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
