                ],
                "senses": [
                    {
                        "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                        "entry_id": "abbcb41c-25f7-3bf6-bfa6-f71e01f78371",
                        "glosses": [
                            "behördlich erteilte Berechtigung, für eine bestimmte Zeit im Land bleiben zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ac7730-b9eb-49e1-9700-da9267ee9d27",
                                "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                                "text": "Ausländer, die längere Zeit im Land bleiben wollen, benötigen dazu eine Aufenthaltsgenehmigung, wenn sie nicht Bürger eines Landes der Europäischen Union (EU) sind."
                            },
                            {
                                "example_id": "c6636ce9-814b-4232-b504-5f0a39f5d6e0",
                                "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                                "text": "„Denn nur leibliche Kinder erhielten eine Aufenthaltsagenehmigung für Kudenow.“"
                            },
                            {
                                "example_id": "dacf5aaa-abb3-46b4-b60d-75ecf399093b",
                                "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                                "text": "„Die Voraussetzung für die Verlängerung der Aufenthaltsgenehmigung aber war ein ausreichendes Auskommen.“"
                            },
                            {
                                "example_id": "1f5a93b9-21bd-4075-bfa3-3071a798243a",
                                "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                                "text": "„Die heißen so, weil sie Einwanderer ohne Aufenthaltsgenehmigung dulden.“"
                            },
                            {
                                "example_id": "792acbde-c35e-45cf-b81a-908b4f08659f",
                                "sense_id": "39159ebe-f6cf-3ed7-ad5d-fa47ac6601db",
                                "text": "„Er verbrachte gut zwanzig Minuten hinter der verschlossenen Tür und kam strahlend mit einer Aufenthaltsgenemigung und einer Einweisung ins Ausländerwohnheim wieder heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
