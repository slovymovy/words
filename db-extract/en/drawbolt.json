                        "entry_id": "a6e16008-0731-3c87-96a2-6c8e671c9889",
                        "glosses": [
                            "A type of bolt with a threaded end that can be tightened to pull connected parts closer together and to increase tension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e82352-362a-4c1b-bd77-5323cc0adbeb",
                                "sense_id": "5b8fb2e3-7f84-3803-9d35-9ab478d63a0c",
                                "text": "When changing from one diameter to another, it is necessary to change both the drawbolt and outer sleeve."
                            },
                            {
                                "example_id": "83161c3c-1ff8-4914-8140-af76b0902f63",
                                "sense_id": "5b8fb2e3-7f84-3803-9d35-9ab478d63a0c",
                                "text": "Then tighten the drawbolt one additional turn to make the punch bite into the metal."
                            },
                            {
                                "example_id": "1148c08b-0646-4845-b7ae-930c76073e64",
                                "sense_id": "5b8fb2e3-7f84-3803-9d35-9ab478d63a0c",
                                "text": "Tough joints for heavy jobs, such as workbenches are obtained by the use of drawbolts (Fig. 13-8)."
                            }
                        ]
                    }
