                "senses": [
                    {
                        "sense_id": "17cb1aea-4921-31ec-9ce8-c57d576671ab",
                        "entry_id": "91c68f25-58df-3523-9dbb-8ffae73ddc67",
                        "glosses": [
                            "Before a move."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e0cb337-b2f8-41b6-b3a1-6dcd89c2de9b",
                                "sense_id": "17cb1aea-4921-31ec-9ce8-c57d576671ab",
                                "text": "I agree to perform residence premove surveys on domestic shipments estimated at 4,700 pounds or more, and/or international shipments estimated at 3,200 pounds or more, at origin points within a 50-mile radius of my nearest agent facility."
                            },
                            {
                                "example_id": "0f39db41-7019-4589-a9fd-56b197f71114",
                                "sense_id": "17cb1aea-4921-31ec-9ce8-c57d576671ab",
                                "text": "A significant portion of the planning process was dedicated to premove testing, such as testing the new facility's air-conditioning capacity."
                            },
                            {
                                "example_id": "ce7a7080-b1ab-40ee-9d90-21aae537605e",
                                "sense_id": "17cb1aea-4921-31ec-9ce8-c57d576671ab",
                                "text": "Cost limits - usually estbalished as part of an initial appraisal or feasibility study and then progressively developed throughout the life of the project, e.g. initial estimate, premove cost check, tender receipt and report, comparison with estimate and reconciliation, interim cost reports and final account."
                            }
                        ]
                    }
