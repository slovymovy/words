                        "examples": [
                            {
                                "example_id": "9edd69c4-7de3-4257-bcde-ac8929e9f918",
                                "sense_id": "e395a620-497c-3ba1-930a-1a41e6eb486c",
                                "text": "„Er dachte an die paradoxen Sätze der einsteinschen Mathematik und an das Zeugnis seiner eigenen Sinne, als die Geometrie vor seinen Augen verrücktgespielt hatte und ein fester Körper zu einer Fläche geworden und – er zögerte bei dem Gedanken – einen Augenblick lang aus Zeit und Raum verschwunden war.“"
                            }
