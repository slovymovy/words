                    {
                        "form_id": "901cbb3c-d9c7-4098-8704-ff2c07bf57aa",
                        "entry_id": "930ff7a0-d342-3d64-a6b9-1a248a3472e0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Einwendungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdf40fc6-e073-3ae0-a793-0ff7309464ae",
                        "entry_id": "930ff7a0-d342-3d64-a6b9-1a248a3472e0",
                        "glosses": [
                            "Reaktion auf etwas, in der Bedenken ausgedrückt werden; Einwand"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "6acb2a7f-5fad-40e3-ad0e-ecac76e96d76",
                                "sense_id": "fdf40fc6-e073-3ae0-a793-0ff7309464ae",
                                "text": "„Kaum dass Boyen, wenn der Kaiser für einen Augenblick still blieb, eine vorsichtige Einwendung machen konnte, sofort fuhr Alexander ›mit Lebhaftigkeit im gleichen Stile‹ fort, so dass Boyen die Überzeugung gewann, ›weitere Einwendungen (würden) unpassend sein‹[.]“"
                            },
                            {
                                "example_id": "9a65c038-6091-4501-8bab-a3b0a97e95ef",
                                "sense_id": "fdf40fc6-e073-3ae0-a793-0ff7309464ae",
                                "text": "„Einmal debattieren sie eine Woche lang darüber, ob sie den General in ihr Haus einladen könnten, und beide bringen die spitzfindigsten Einwendungen vor.“"
                            },
                            {
                                "example_id": "933d3321-51b1-43ba-a113-51a45882fd08",
                                "sense_id": "fdf40fc6-e073-3ae0-a793-0ff7309464ae",
                                "text": "„Während dieser Zeit kann jeder Beteiligte im Umfange seines Interesses Einwendungen gegen den Plan erheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0650287c-a791-33a4-bbb5-cc6b61e06780",
                        "entry_id": "930ff7a0-d342-3d64-a6b9-1a248a3472e0",
                        "glosses": [
                            "materiell-rechtliches Verteidigungsmittel eines Schuldners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4146d805-3ac3-45fb-b3f7-743dfe1b3ea9",
                                "sense_id": "0650287c-a791-33a4-bbb5-cc6b61e06780",
                                "text": "„Rechtshindernde Einwendungen lassen einen Anspruch schon gar nicht entstehen, etwa weil der zu Grunde liegende Vertrag unwirksam ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4667d65c-09d7-4a89-9854-00b58a2c1345",
                        "source_entry_id": "930ff7a0-d342-3d64-a6b9-1a248a3472e0",
                        "source_sense_id": "fdf40fc6-e073-3ae0-a793-0ff7309464ae",
                        "source_sense_description": "veraltend: Reaktion auf etwas, in der Bedenken ausgedrückt werden; Einwand",
                        "target_lang_word": "objection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "The act of objecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b254b46-280f-45a2-9197-081eaa16233c",
                                                "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                                "text": "last-minute objection"
                                            },
                                            {
                                                "example_id": "da507632-9109-4a3d-8a21-20c3093b0534",
                                                "sense_id": "4797306a-1f1c-3b95-873a-48ef25a0bf19",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "A statement expressing opposition, or a reason or cause for expressing opposition (generally followed by the adposition to)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68a119a-b00e-4e0c-ab13-1703819eca99",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "I have no objection to any person's religion."
                                            },
                                            {
                                                "example_id": "6ac8a749-28cd-408c-acfa-d30e007e450d",
                                                "sense_id": "7274f29d-4d61-3b11-858c-b5ba71fb8e49",
                                                "text": "There are millions of Jews living in this country, who have known no other home than America, many of whom have strong objections to racism–and who vote, in a supermajority, for the Democratic Party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                        "entry_id": "9ec5984d-c4f1-3ea0-bcb3-d7504243bf64",
                                        "glosses": [
                                            "An official protest raised in a court of law during a legal trial over a violation of the rules of the court by the opposing party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8798a856-2415-4482-9df4-82a0b1738542",
                                                "sense_id": "95bde781-270c-38ac-b7d8-5c18ea96f283",
                                                "text": "Counsel for the property owner immediately raised an objection which was sustained following argument outside the presence of the jury."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "objection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                        "entry_id": "82393ceb-0fad-35f8-9ab5-7d4a36e357e1",
                                        "glosses": [
                                            "An assertion that a question or statement is in violation of the rules of the court."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ce6ae8-3c32-45a3-9265-36676127220d",
                                                "sense_id": "2e524ec9-f2dd-3518-91d9-588c85ecd1d0",
                                                "text": "Objection! That is irrelevant to this case, Your Honor!"
                                            }
                                        ]
                                    }
                                ]
                            }
