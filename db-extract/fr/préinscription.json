                                        "entry_id": "4051f22c-42a8-3a33-b9ed-d4a7f77462b8",
                                        "glosses": [
                                            "An early registration, before the normal or traditional time, as with early online check-in at hotels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e76df8-d49f-49ed-88e8-57febdbe8cbb",
                                                "sense_id": "5d1b0df8-3dba-3d7e-a752-15ad6ce0fd4d",
                                                "text": "There is no charge for participation but pre-registration is necessary since space is limited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6406666-e5ac-3cfd-be12-8065b6ee7048",
                                        "entry_id": "4051f22c-42a8-3a33-b9ed-d4a7f77462b8",
                                        "glosses": [
                                            "Registration (of a study design) before a clinical trial (or any other type of scientific experiment) begins, for methodologic and thus epistemologic rigor."
                                        ],
