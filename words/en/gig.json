{
    "word_family": [
        "gigabyte",
        "fishgig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92bef7ca-ee19-3217-a3e9-aec76462ce75",
                    "sense_definition": "A professional performance or engagement by a musician or a musical group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "performance_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played their first <w>gig</w> at a local bar.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла свой первый <w>концерт</w> в местном баре.",
                                "zh": "乐队在当地一家酒吧进行了他们的第一次<w>演出</w>。"
                            }
                        },
                        {
                            "text": "She is looking for a paying <w>gig</w> as a jazz singer.",
                            "target_lang_translations": {
                                "ru": "Она ищет оплачиваемое <w>выступление</w> в качестве джазовой певицы.",
                                "zh": "她正在找一份有报酬的爵士歌手<w>演出</w>机会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play a gig",
                        "land a gig",
                        "live gig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональное выступление музыканта или музыкальной группы.",
                        "zh": "音乐人或乐队的一次职业性演出或登台表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концерт",
                                "target_lang_sense_clarification": "публичное исполнение музыки"
                            },
                            {
                                "target_lang_word": "выступление",
                                "target_lang_sense_clarification": "выход артиста на сцену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演出",
                                "target_lang_sense_clarification": "音乐人或乐队的一场现场表演"
                            },
                            {
                                "target_lang_word": "现场演出",
                                "target_lang_sense_clarification": "强调公开演奏或登台表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "079eeeb4-cf3b-3450-be96-1d586c822ba3",
                    "sense_definition": "A temporary, freelance, or short-term job, often in the service sector.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "performance_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driving for a ride-share app is a popular side <w>gig</w> for students.",
                            "target_lang_translations": {
                                "ru": "Вождение в такси через приложение — популярная <w>подработка</w> для студентов.",
                                "zh": "给网约车平台开车是学生中很受欢迎的副业<w>兼职</w>。"
                            }
                        },
                        {
                            "text": "He picked up a <w>gig</w> designing websites for small businesses.",
                            "target_lang_translations": {
                                "ru": "Он нашел <w>подработку</w> по дизайну веб-сайтов для малого бизнеса.",
                                "zh": "他接到了一份为小企业设计网站的<w>零工</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gig economy",
                        "side gig",
                        "freelance gig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная, внештатная или краткосрочная работа, часто в сфере услуг.",
                        "zh": "临时的、自由职业性质的或短期工作，通常见于服务行业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подработка",
                                "target_lang_sense_clarification": "дополнительный заработок"
                            },
                            {
                                "target_lang_word": "халтура",
                                "target_lang_sense_clarification": "разговорное; временная работа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "零工",
                                "target_lang_sense_clarification": "短期、临时赚外快的工作"
                            },
                            {
                                "target_lang_word": "兼职",
                                "target_lang_sense_clarification": "额外做的工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06dd4ffe-cfb2-3338-a721-479ff717e90e",
                    "sense_definition": "A unit of digital storage capacity equal to one billion bytes; a short form of gigabyte.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My new phone has one hundred and twenty-eight <w>gigs</w> of storage.",
                            "target_lang_translations": {
                                "ru": "В моем новом телефоне сто двадцать восемь <w>гигов</w> памяти.",
                                "zh": "我的新手机有一百二十八<w>吉</w>存储空间。"
                            }
                        },
                        {
                            "text": "The file size is over two <w>gigs</w>, so it will take a while to download.",
                            "target_lang_translations": {
                                "ru": "Размер файла превышает два <w>гига</w>, поэтому скачивание займет некоторое время.",
                                "zh": "这个文件超过两<w>吉</w>，所以下载要花一会儿。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping of gigabyte"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения цифровой информации, равная одному миллиарду байт; сокращение от гигабайта.",
                        "zh": "数字存储容量单位，等于十亿字节；是“吉字节”的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гиг",
                                "target_lang_sense_clarification": "сленг; гигабайт"
                            },
                            {
                                "target_lang_word": "гигабайт",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吉",
                                "target_lang_sense_clarification": "口语，指一吉字节"
                            },
                            {
                                "target_lang_word": "吉字节",
                                "target_lang_sense_clarification": "数字存储容量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4d1657-67d7-3f95-b080-28df3efb2d63",
                    "sense_definition": "A light two-wheeled carriage drawn by a single horse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor arrived at the farmhouse in a horse-drawn <w>gig</w>.",
                            "target_lang_translations": {
                                "ru": "Доктор прибыл на ферму в запряженной лошадью <w>двуколке</w>.",
                                "zh": "医生乘着一辆马拉的<w>双轮轻便马车</w>来到农舍。"
                            }
                        },
                        {
                            "text": "They took a pleasant ride through the countryside in the <w>gig</w>.",
                            "target_lang_translations": {
                                "ru": "Они совершили приятную поездку по сельской местности в <w>двуколке</w>.",
                                "zh": "他们坐着这辆<w>双轮轻便马车</w>愉快地穿过乡间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий двухколесный экипаж, запряженный одной лошадью.",
                        "zh": "一种由一匹马拉的轻便双轮马车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двуколка",
                                "target_lang_sense_clarification": "повозка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双轮轻便马车",
                                "target_lang_sense_clarification": "旧时由一匹马拉的轻便双轮车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb2252c-770b-326c-8448-c7e5e9460338",
                    "sense_definition": "A light, narrow boat used for rowing or sailing, often reserved for a ship's captain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain was rowed ashore in his private <w>gig</w>.",
                            "target_lang_translations": {
                                "ru": "Капитана доставили на берег в его личной <w>гичке</w>.",
                                "zh": "船长乘坐他的私人<w>舰长小艇</w>被划到岸边。"
                            }
                        },
                        {
                            "text": "The sailors lowered the <w>gig</w> into the water to transport the officers.",
                            "target_lang_translations": {
                                "ru": "Матросы спустили <w>гичку</w> на воду для перевозки офицеров.",
                                "zh": "水手们把<w>舰长小艇</w>放下水，好运送军官们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "captain's gig"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая узкая гребная или парусная шлюпка, часто предназначенная для капитана корабля.",
                        "zh": "一种轻便而狭长的小船，可划可帆，常为船长专用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гичка",
                                "target_lang_sense_clarification": "вид шлюпки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舰长小艇",
                                "target_lang_sense_clarification": "航海用语，常供船长使用的小艇"
                            },
                            {
                                "target_lang_word": "轻型小艇",
                                "target_lang_sense_clarification": "轻型狭长的划艇或帆艇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3d802bd-6d60-363c-89e0-de3e940ccc2c",
                    "sense_definition": "A spear with a barb on the end, used for catching fish or frogs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a homemade <w>gig</w> to catch frogs in the pond.",
                            "target_lang_translations": {
                                "ru": "Он использовал самодельную <w>острогу</w>, чтобы ловить лягушек в пруду.",
                                "zh": "他用自制的<w>鱼叉</w>在池塘里叉青蛙。"
                            }
                        },
                        {
                            "text": "The fisherman sharpened the points of his <w>gig</w> before heading to the river.",
                            "target_lang_translations": {
                                "ru": "Рыбак заточил зубья своей <w>остроги</w> перед тем, как отправиться на реку.",
                                "zh": "渔夫去河边前把他的<w>鱼叉</w>尖头磨快了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fishgig",
                        "fizgig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Копье с зазубринами на конце, используемое для ловли рыбы или лягушек.",
                        "zh": "一种末端带倒钩的叉，用来捕捉鱼或青蛙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острога",
                                "target_lang_sense_clarification": "орудие лова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鱼叉",
                                "target_lang_sense_clarification": "带倒钩、用于叉鱼或叉蛙的叉具"
                            },
                            {
                                "target_lang_word": "多齿鱼叉",
                                "target_lang_sense_clarification": "有多个尖齿的鱼叉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40774f11-a566-35ee-b092-855fd1cbf7c1",
                    "sense_definition": "A demerit received for a minor infraction of military rules or dress code.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier received a <w>gig</w> for having unpolished boots.",
                            "target_lang_translations": {
                                "ru": "Солдат получил <w>взыскание</w> за нечищеные ботинки.",
                                "zh": "那名士兵因为靴子没擦亮而被记了一个<w>小过</w>。"
                            }
                        },
                        {
                            "text": "He tried to avoid getting a <w>gig</w> during the morning inspection.",
                            "target_lang_translations": {
                                "ru": "Он старался избежать <w>взыскания</w> во время утреннего осмотра.",
                                "zh": "他尽量避免在晨检时受到<w>处分</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взыскание за незначительное нарушение военных правил или формы одежды.",
                        "zh": "军队中因轻微违反规定或着装要求而受到的记过或处分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взыскание",
                                "target_lang_sense_clarification": "наказание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小过",
                                "target_lang_sense_clarification": "较轻的纪律处分"
                            },
                            {
                                "target_lang_word": "处分",
                                "target_lang_sense_clarification": "军事中因小过失受到的惩处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87b3aa86-7c45-34d3-8742-230289c194ac",
                    "sense_definition": "To perform music at a live engagement or venue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "performance_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band has been <w>gigging</w> around the country for years.",
                            "target_lang_translations": {
                                "ru": "Группа <w>гастролирует</w> по стране уже много лет.",
                                "zh": "这支乐队多年来一直在全国各地<w>演出</w>。"
                            }
                        },
                        {
                            "text": "We are <w>gigging</w> at a wedding this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы <w>выступаем</w> на свадьбе.",
                                "zh": "这个周末我们要在一场婚礼上<w>演出</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать с концертами или играть на живых мероприятиях.",
                        "zh": "在现场活动或演出场地表演音乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "на сцене"
                            },
                            {
                                "target_lang_word": "давать концерты",
                                "target_lang_sense_clarification": "играть музыку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演出",
                                "target_lang_sense_clarification": "在现场表演音乐"
                            },
                            {
                                "target_lang_word": "跑场演出",
                                "target_lang_sense_clarification": "口语，接场子进行表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07da1033-b3c3-36a0-bc3f-5b0ed35adaa8",
                    "sense_definition": "To work at a temporary or freelance job.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>gigging</w> as a graphic designer while looking for permanent work.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>поддрабатывает</w> графическим дизайнером в поисках постоянной работы.",
                                "zh": "他目前靠做平面设计师<w>打零工</w>，同时在找固定工作。"
                            }
                        },
                        {
                            "text": "Many young people are <w>gigging</w> in the tech industry to gain experience.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди <w>берут подработки</w> в технологической индустрии, чтобы набраться опыта.",
                                "zh": "许多年轻人为了积累经验，正在科技行业<w>接零活</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать на временной или внештатной работе.",
                        "zh": "从事临时性或自由职业性质的工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддрабатывать",
                                "target_lang_sense_clarification": "иметь дополнительный заработок"
                            },
                            {
                                "target_lang_word": "халтурить",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打零工",
                                "target_lang_sense_clarification": "做临时短工或接散活"
                            },
                            {
                                "target_lang_word": "接零活",
                                "target_lang_sense_clarification": "承接零散的短期工作"
                            },
                            {
                                "target_lang_word": "做兼职",
                                "target_lang_sense_clarification": "做额外的非固定工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79e3df0-09bb-39f3-b26e-ed921e1be478",
                    "sense_definition": "To catch fish or frogs using a pronged spear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went <w>gigging</w> for frogs in the marsh last night.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью они ходили <w>бить острогой</w> лягушек на болото.",
                                "zh": "昨晚他们去沼泽地<w>叉青蛙</w>了。"
                            }
                        },
                        {
                            "text": "He learned how to <w>gig</w> fish from his grandfather.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>бить</w> рыбу <w>острогой</w> у своего деда.",
                                "zh": "他跟祖父学会了怎么<w>用鱼叉捕鱼</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить рыбу или лягушек с помощью остроги.",
                        "zh": "用多齿叉捕捉鱼或青蛙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить острогой",
                                "target_lang_sense_clarification": "способ ловли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用鱼叉捕鱼",
                                "target_lang_sense_clarification": "用鱼叉捕捉鱼类"
                            },
                            {
                                "target_lang_word": "叉青蛙",
                                "target_lang_sense_clarification": "口语，也可指用叉捕蛙"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cbff096-7154-3bfa-a156-ce439dcb5ba1",
                    "sense_definition": "To give a demerit to a soldier for a minor infraction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer <w>gigged</w> the recruit for an unmade bed.",
                            "target_lang_translations": {
                                "ru": "Офицер <w>объявил взыскание</w> новобранцу за неубранную постель.",
                                "zh": "军官因为床铺没整理好而给新兵<w>记过</w>。"
                            }
                        },
                        {
                            "text": "You will get <w>gigged</w> if your uniform is not perfect.",
                            "target_lang_translations": {
