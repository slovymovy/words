                        "examples": [
                            {
                                "example_id": "4cd5f04b-9d10-4921-838e-3bcdd86f451f",
                                "sense_id": "8fc4fda2-3e2f-3610-a241-1407abc3595d",
                                "text": "Le mâchouillement du bâtonnet active naturellement la salivation qui, mêlée au suc antimicrobien de la plante, se répartit dans toute la sphère buccale et l’assainit."
                            },
                            {
                                "example_id": "a9df22ae-8122-4144-8d1c-5f6b72c8cdac",
                                "sense_id": "8fc4fda2-3e2f-3610-a241-1407abc3595d",
                                "text": "On avait droit, pour le même prix, à un mince chalumeau de réglisse, destiné à aspirer la substance mystérieuse. Mais quelques irrépressibles mâchouillements avaient bien vite raison de cette pompe savoureuse que le fabricant vouait sans doute à une consommation post-mistralienne – en fait, on le mangeait toujours avant."
                            }
                        ]
                    }
