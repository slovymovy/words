                                                "sense_id": "d93f0893-d38c-374f-9a04-2ed082f44c45",
                                                "text": "We ate the meal in reverse order, starting with dessert and ending with the starter."
                                            },
                                            {
                                                "example_id": "41f48e13-ab32-4887-a796-0ffa9845060f",
                                                "sense_id": "d93f0893-d38c-374f-9a04-2ed082f44c45",
