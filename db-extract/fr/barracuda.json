                "entry_id": "7f286456-60f7-3821-9a11-9dbda4042db9",
                "word": "barracuda",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e941a747-6437-4a8b-8010-0c03bd06add7",
                        "entry_id": "7f286456-60f7-3821-9a11-9dbda4042db9",
                        "tags": [
