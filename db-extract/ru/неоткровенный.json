                                        "sense_id": "10087f64-b124-318b-80bf-5a3d5b654286",
                                        "entry_id": "9461b716-b81f-3341-9747-d41be3cd3a9b",
                                        "glosses": [
                                            "nicht die Wahrheit von sich gebend, nicht der Wahrheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86734f30-fe0a-4c9f-b06d-295a52bdb9e2",
                                                "sense_id": "10087f64-b124-318b-80bf-5a3d5b654286",
                                                "text": "„Er war von seinem Charakter her kein unaufrichtiger Mensch, und es erleichterte ihn, ihr alles zu gestehen.“"
                                            },
                                            {
                                                "example_id": "602584f6-4350-4c47-90e6-3330c2228376",
                                                "sense_id": "10087f64-b124-318b-80bf-5a3d5b654286",
                                                "text": "„Um den Verfolgten zu schützen, gibt der Befragte eine unaufrichtige Auskunft, die aber zufällig zutrifft und es dem Verfolger ermöglicht, sein Opfer zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
