                        "target_lang_word": "шизоти́мик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шизоти́мик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "431ec057-4bae-3f94-bb0b-f5b58f365b6c",
                                        "entry_id": "c21b75a3-c9d1-3c7c-b768-9ccbacdcc3a9",
                                        "glosses": [
                                            "человек с шизотимией, шизотимическим характером и соответствующей телесной конституцией"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1245da-098b-4968-a2a7-7a862cf3fa09",
                                                "sense_id": "431ec057-4bae-3f94-bb0b-f5b58f365b6c",
                                                "text": "Шизотимик, по Э. Кречмеру, — здоровый человек с некоторым «шизофреническим налётом», «рудиментом»."
                                            },
                                            {
                                                "example_id": "40e6884f-6a4d-4f02-a43e-5d49ea8b0311",
                                                "sense_id": "431ec057-4bae-3f94-bb0b-f5b58f365b6c",
                                                "text": "Шизотимик имеет астеническое телосложение; характеризуется замкнутостью, склонностью к эмоциональным колебаниям, с трудом меняет свои взгляды, плохо переносит изменения привычного окружения, склонен к абстрактно-логическому мышлению .."
                                            },
                                            {
                                                "example_id": "0566fde3-c6c0-4930-b653-d460ca86d48b",
                                                "sense_id": "431ec057-4bae-3f94-bb0b-f5b58f365b6c",
                                                "text": "Астеническое телосложение имеет шизотимик. Он замкнут, склонен к размышлениям, к абстракции, с трудом приспосабливается к окружению, чувствителен, раним."
                                            },
                                            {
                                                "example_id": "422f052c-fd16-4302-a55d-bf20d4bba733",
                                                "sense_id": "431ec057-4bae-3f94-bb0b-f5b58f365b6c",
                                                "text": "У шизотимиков происходит колебание между чувствительностью и холодностью, между обострённостью и тупостью чувства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
