                            {
                                "example_id": "dc70416d-8528-473d-a1e5-c18232eca928",
                                "sense_id": "2abe78fd-da87-322d-94b0-ebd1b88e979d",
                                "text": "„In Berlin nannte man früher in gewissen Kreisen den Zylinderhut Silvesterpauke, was auf den üblen Silvesterscherz zurückging, anderen Leuten den Zylinder einzubeulen.“"
                            },
                            {
                                "example_id": "4519a57b-e56b-45b9-bc05-6990610d85e1",
                                "sense_id": "2abe78fd-da87-322d-94b0-ebd1b88e979d",
                                "text": "„Doch die rote Fahne, einst Banner der Revolution, ist nur noch ein Silvesterscherz.“"
                            }
                        ],
