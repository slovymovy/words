                                            "Authority to act in the name of God or the divine in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dec4b6f-b0be-4bb3-9539-07b2e314d560",
                        "source_entry_id": "530a9cc8-266c-3753-b333-d4735465c832",
