                    {
                        "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                        "entry_id": "b7743453-08d3-3bdb-bc23-05b50fce65a9",
                        "glosses": [
                            "Making a tinkling sound."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "65ac1bb6-45ff-434f-a078-f340e16ef61a",
                                "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                                "text": "The mountain vale, arousing Ocean, sings,\nAnd all the air’s a-tinkle as with strings;"
                            },
                            {
                                "example_id": "349e67ad-b95d-4977-982d-af409bee9092",
                                "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                                "text": "1894, Kenneth Grahame, “The Fairy Wicket” in Pagan Papers, London: Elkin Mathews and John Lane, p. 91,\n[…] every copse and hedge-row seems a-tinkle with faint elfish laughter."
                            },
                            {
                                "example_id": "25284e64-0b15-44dd-9e99-29c6992bd542",
                                "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                                "text": "O Love! were you the hooded hawk upon my hand that flutters,\nIts collar-band of gleaming bells atinkle as I ride,"
                            },
                            {
                                "example_id": "2fb23664-856c-4a0e-8f25-6dcc89bf8fc8",
                                "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                                "text": "Impossibles march gaily for Gay Pride,\nashaming any spectator a marcher would\nyearn to be matey with, mincing\natinkle with bangles and lavender marcel"
                            },
                            {
                                "example_id": "d90670d1-7bf4-42ee-83f0-f2087837354e",
                                "sense_id": "ff9b6ce8-55af-3281-b9d9-f6498e97f667",
                                "text": "Somewhere inside a full-mouthed bell tolled; its reverberations set the chandelier a-tinkle […]"
                            }
                        ]
                    }
                ],
