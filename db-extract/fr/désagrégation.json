        "fr-extract.jsonl": [
            {
                "entry_id": "8c5626b1-4ae5-3ca5-b4a4-56dd7de85e29",
                "word": "désagrégation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd6c50f5-5de2-4d4c-88d7-95f984124f06",
                        "entry_id": "8c5626b1-4ae5-3ca5-b4a4-56dd7de85e29",
                        "tags": [
                            "plural"
                        ],
                        "form": "désagrégations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                        "entry_id": "8c5626b1-4ae5-3ca5-b4a4-56dd7de85e29",
                        "glosses": [
                            "Action de désagréger, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d6a26e7-bc4a-4f4c-8303-0e6bb76c6195",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "Les déchirements et les fracas étaient fréquents à l’intérieur. Il se faisait là un travail de désagrégation formidable."
                            },
                            {
                                "example_id": "268be25d-c9b9-478c-b056-5f58660d03ce",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "L’altérabilité des roches se manifeste soit par simple désagrégation, soit par décomposition, soit par une haute température naturelle."
                            },
                            {
                                "example_id": "78a9e859-7663-45a6-9528-2936a19e1154",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "[…] la désagrégation des grès donne naissance à un sable fin mélangé d’argile […]"
                            },
                            {
                                "example_id": "2a048bea-de9c-4aab-820a-5d54016d3cdf",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "Les appartements étaient bien plafonnés, sans fentes ni lézardes ; impossible de supposer que des débris quelconques chutassent par suite de vétusté ou de désagrégation."
                            },
                            {
                                "example_id": "2b92d2ed-1026-458b-a902-edfaa064904a",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "En deçà de cet enfer, il y a ma première jeunesse vers laquelle, depuis quelques années, je me tourne comme vers l’époque de ma vie qui fut la seule heureuse, bien que contenant déjà les éléments de sa propre désagrégation et tous les traits qui, peu à peu creusés en rides, donnent sa ressemblance au portrait."
                            },
                            {
                                "example_id": "f08f7521-c6b2-4686-befb-81495be29269",
                                "sense_id": "afddc7b9-76bc-3cfb-8c07-d84bca9d8667",
                                "text": "En définitive, la prospérité est acquise aux prix d’une désagrégation du système traditionnel de relations sociales et d’une accélération du rythme de la vie."
                            }
                        ]
                    }
                ],
