                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7d1a50-8aaf-4d58-8edf-202052017f50",
                                "sense_id": "ef12b296-37d2-3ed0-ac38-871b71305fe8",
                                "text": "Ik wou dat ik mijn regenjas meegebracht had!"
                            },
                            {
                                "example_id": "d5c33ef0-6c37-4fda-8b18-8d4df7d30f18",
                                "sense_id": "ef12b296-37d2-3ed0-ac38-871b71305fe8",
                                "text": "Bezorgd en koud wikkelde ik mijn regenjas om mijn voeten in de hoop droog te blijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ceead7a-2bb5-3bec-b9d2-d4e33c043b2a",
