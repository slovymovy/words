                "senses": [
                    {
                        "sense_id": "cd5ef521-51e6-3c69-be15-d869c8654b82",
                        "entry_id": "006218e7-112f-3edd-8236-66a43c88d982",
                        "glosses": [
                            "das Ableisten eines Eides"
