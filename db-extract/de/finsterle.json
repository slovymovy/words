                ],
                "senses": [
                    {
                        "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                        "entry_id": "868bbf91-a4bf-34b6-bd95-2475eb675173",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1128cfd7-e591-4783-ad63-b74a66569138",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Frau Finsterle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d89d58d9-231a-4e9d-b11f-9f3de39c4c1e",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Herr Finsterle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fdda18c6-15b0-42ea-a16f-48e9fbe029b8",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Die Finsterles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "51e08660-cd7b-497f-9104-bb47983cbcba",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Der Finsterle trägt nie die Pullover, die die Finsterle ihm strickt."
                            },
                            {
                                "example_id": "7577ea0b-780a-4202-b025-67e9db8fb870",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finsterle kommt, geht der Herr Finsterle.“"
                            },
                            {
                                "example_id": "153e589b-b833-4a47-ab40-f2781c8b04e4",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Finsterle kommt und geht."
                            },
                            {
                                "example_id": "bfc1a2d3-4f62-43f7-9a2e-43fcfc9fe017",
                                "sense_id": "9d7b18e7-fd21-36bc-b390-d742d0561847",
                                "text": "Finsterles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
