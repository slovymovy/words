            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9bffebe-643f-3ad6-a1de-2b01bf08a203",
                    "sense_definition": "Faciliter, encourager ou aider le développement ou la réalisation de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aider",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une alimentation équilibrée <w>favorise</w> une bonne santé chez les jeunes comme chez les adultes."
                        },
                        {
                            "text": "Le professeur utilise des méthodes modernes pour <w>favoriser</w> l'apprentissage des langues étrangères."
                        }
                    ],
                    "common_phrases": [
                        "favoriser le développement",
                        "favoriser l'apprentissage",
                        "favoriser la croissance"
                    ],
                    "synonyms": [
                        "encourager",
                        "faciliter"
                    ]
                },
                {
                    "sense_id": "0ad93063-dc45-3459-8eff-44d8f5bf04a6",
                    "sense_definition": "Accorder un avantage ou une préférence particulière à quelqu'un, souvent au détriment d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a été vivement critiqué pour avoir voulu <w>favoriser</w> un membre de sa famille."
                        },
                        {
                            "text": "Les parents essaient toujours de ne pas <w>favoriser</w> un enfant par rapport aux autres."
                        }
                    ],
                    "synonyms": [
                        "avantager",
                        "préférer"
                    ],
                    "antonyms": [
                        "défavoriser"
                    ],
                    "common_phrases": [
                        "favoriser un candidat"
                    ]
                },
                {
                    "sense_id": "5b344fea-28e3-35ba-a42b-cb46aa333a67",
                    "sense_definition": "Être propice ou bienveillant envers quelqu'un, en parlant des circonstances ou du sort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "propice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins espéraient ardemment que le vent <w>favoriserait</w> leur traversée difficile."
                        },
                        {
                            "text": "Cette région agricole a été particulièrement <w>favorisée</w> par un climat doux tout au long de l'année."
                        }
                    ],
                    "common_phrases": [
                        "favorisé par le sort"
                    ]
                }
            ]
        }
