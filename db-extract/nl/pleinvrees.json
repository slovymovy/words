                    {
                        "translation_id": "a3f85db3-8271-40ba-9a58-33c0f0dd2231",
                        "source_entry_id": "56b7998f-beeb-3a46-9204-4db0b2573722",
                        "source_sense_id": "c7aa6c1f-38fe-363c-85df-fbe093329319",
                        "target_lang_word": "Agoraphobie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agoraphobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70044711-0c29-3c2c-97c8-da078ec8130c",
                                        "entry_id": "5e1a1e50-24ec-36ad-9666-194198862f85",
                                        "glosses": [
                                            "krankhafte Angst vor weiten Plätzen, Menschenmengen oder Reisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e2be51-a9c7-464e-aa97-8a76e357e73d",
                                                "sense_id": "70044711-0c29-3c2c-97c8-da078ec8130c",
                                                "text": "In der überwiegenden Zahl der Fälle tritt die Agoraphobie gemeinsam mit einer Panikstörung auf, wobei die Angst vor dem Auftreten von Panikattacken in der Folge zur Vermeidung bestimmter Orte führt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3d8cb66-6dcc-44f5-90f8-556ae9bec571",
                        "source_entry_id": "56b7998f-beeb-3a46-9204-4db0b2573722",
                        "source_sense_id": "c7aa6c1f-38fe-363c-85df-fbe093329319",
                        "target_lang_word": "Platzangst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzangst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fde56b54-e67a-3c9d-bf5d-41c24eea43cd",
                                        "entry_id": "2cf43c22-9d34-3849-946a-2b53789de0a2",
                                        "glosses": [
                                            "krankhafte Angst vor weiten Plätzen, Menschenmengen oder Reisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bafebe4-0d96-42cd-9a21-60270f7edb2e",
                                                "sense_id": "fde56b54-e67a-3c9d-bf5d-41c24eea43cd",
                                                "text": "Wegen seiner Platzangst geht Karl auf kein Festival."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                        "entry_id": "2cf43c22-9d34-3849-946a-2b53789de0a2",
                                        "glosses": [
                                            "krankhafte Angst bei wenig Platz (engen Räumen und Ähnlichem)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712a08c0-869d-426d-b664-000da3074e56",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "Er leidet unter Platzangst, selbst Aufzüge bereiten ihm Angst."
                                            },
                                            {
                                                "example_id": "675b3ded-db5d-4d9a-9c6d-dc615119cfbe",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Er kroch durch die niedrigsten Schächte, bis er sich an seine Platzangst gewöhnt hatte wie an einen nicht nachlassenden, allmählich jedoch erträglichen Schmerz.“"
                                            },
                                            {
                                                "example_id": "d57e8895-4aa1-46f2-9f99-040c34331157",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Ich versuchte, durch gedankliche Ablenkungsmanöver der sich heranpirschenden Platzangst zu entgehen.“"
                                            },
                                            {
                                                "example_id": "7c8ceca1-060b-4882-9619-6a8d7dd8b72a",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Er denkt an nichts, aber diesmal empfindet er die Leere als lastend, eine Platzangst in seinem Innern, die ihn verstört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28ac1763-5a0a-4cfe-86a5-e42536fdf886",
                        "source_entry_id": "56b7998f-beeb-3a46-9204-4db0b2573722",
                        "source_sense_id": "c7aa6c1f-38fe-363c-85df-fbe093329319",
                        "target_lang_word": "agoraphobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agoraphobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2202de3f-74b0-3723-a0bc-bad0ebe5fece",
                                        "entry_id": "ca2ff81e-419f-38f1-b972-0bb680510d46",
                                        "glosses": [
                                            "The fear of wide open spaces, crowds, or uncontrolled social conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850f9b7d-6baa-4ee6-8365-9b90dd244231",
                                                "sense_id": "2202de3f-74b0-3723-a0bc-bad0ebe5fece",
                                                "text": "Now, you know that the classical analytical explanation of agoraphobia of the early 1900s was that it represented a street phobia because the patient equated streetwalking with prostitutional activity[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c69e465-4a01-3127-89ed-a100cfd9e8c2",
                                        "entry_id": "ca2ff81e-419f-38f1-b972-0bb680510d46",
                                        "glosses": [
                                            "An aversion to markets."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25478c97-4af7-4647-b4f2-243522bb0f62",
                                                "sense_id": "5c69e465-4a01-3127-89ed-a100cfd9e8c2",
                                                "text": "For quotations using this term, see Citations:agoraphobia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45db01eb-3746-426e-9f59-d103fc782d77",
                        "source_entry_id": "56b7998f-beeb-3a46-9204-4db0b2573722",
                        "source_sense_id": "c7aa6c1f-38fe-363c-85df-fbe093329319",
                        "target_lang_word": "agoraphobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agoraphobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c82b723c-9f41-30e5-8ac2-ae7369b11801",
                                        "entry_id": "1ab37be8-e828-30b7-afe7-f7cf327d73ec",
                                        "glosses": [
                                            "Peur irraisonnée des espaces libres et des lieux publics, de se retrouver dans une situation embarrassante dans de tels lieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7611b43a-62f0-4aae-ae1d-5313535ea8e1",
                                                "sense_id": "c82b723c-9f41-30e5-8ac2-ae7369b11801",
                                                "text": "En général, la vue se heurte à des rochers serrés, à des amoncellements de prisons. Cette concentration trahit un désespoir paralysant comme une crampe : une sorte d’agoraphobie caractérise ces gravures."
                                            },
                                            {
                                                "example_id": "1da333ad-7cc8-4028-b647-6fc818b964d2",
                                                "sense_id": "c82b723c-9f41-30e5-8ac2-ae7369b11801",
                                                "text": "Les attaques de panique et l’agoraphobie sont des syndromes anxieux fréquemment rencontrés en pratique clinique : la souffrance et le handicap qu’ils entraînent en font un réel problème de santé publique."
                                            },
                                            {
                                                "example_id": "de563e47-2bab-44cb-ba19-769d08720112",
                                                "sense_id": "c82b723c-9f41-30e5-8ac2-ae7369b11801",
                                                "text": "Ce B.A-BA des phobies dresse un inventaire assez vaste des quelque six cents phobies répertoriées dans le monde. Il les sectionne en trois grandes parties distinctes : les phobies physiques (la claustrophobie, la thalassophobie, l’anémophobie...), les phobies mentales (l’agoraphobie, la bacillophobie, l’anorgasmophobie, la cafféapullophobie...) et les phobies animales (l'arachnophobie, la batracophobie, la musophobie...)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
