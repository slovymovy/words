                "senses": [
                    {
                        "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                        "entry_id": "aa4ea727-38d7-32bf-9f2f-cad9bc3b2f9d",
                        "glosses": [
                            "Gruppe von Unternehmen, die nah verwandte Produkte, Güter, Waren und Dienstleistungen herstellen und anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7b2ce4-214d-4eb0-b25c-dd9e17f04a12",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Der Tourismus ist die wichtigste Wirtschaftsbranche Griechenlands.“"
                            },
                            {
                                "example_id": "fa9cd5f6-8742-4b45-8ed7-8fc52f827a77",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Ohne abgesicherte IT-Systeme funktioniert so gut wie nichts mehr, jede einzelne Wirtschaftsbranche in Deutschland verlässt sich darauf, ebenso die Verwaltung und Millionen Privatanwender.“"
                            },
                            {
                                "example_id": "42a3b1d6-ae00-4382-a9b8-59ad6203b110",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Die Medien erhalten als einzige Wirtschaftsbranche eine Sonderförderung.“"
                            },
                            {
                                "example_id": "6de45448-8ae8-4472-9eef-edb04be58335",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Derzeit ist die wichtigste libysche Wirtschaftsbranche dagegen fast vollständig zum Stillstand gekommen.“"
                            },
                            {
                                "example_id": "ab885669-2002-4d30-960a-9588110b334e",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Eine ganz eigene Wirtschaftsbranche Seit Sommer 2005, als die deutschen Deponien geschlossen wurden, investieren nun auch Entsorgungsunternehmen in den Bau von Anlagen.“"
                            },
                            {
                                "example_id": "6458eb87-61b2-4375-9238-6c76daee6c0e",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Fußball begann sich als Teil der zukunftsträchtigsten Wirtschaftsbranche zu verstehen, der Unterhaltungsindustrie.“"
                            },
                            {
                                "example_id": "545e6295-b92d-422e-a2d7-86f6e847dc86",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„In Großbritannien wachsen angesichts der ausländischen Begehrlichkeiten die Sorgen um die Zukunft der wichtigsten Wirtschaftsbranche des Landes.“"
                            },
                            {
                                "example_id": "4f9b3e60-3454-45f7-b5f7-5aeeac86c794",
                                "sense_id": "54a9f180-f44e-3d9e-b07b-8fdf108b59f1",
                                "text": "„Schließlich droht auch der größten Wirtschaftsbranche, dem Tourismus, ein Rückschlag - wegen der europäischen Rezession und Fernsehbildern von flammenden Protesten in Athen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
