                        "entry_id": "a56a8594-e662-336c-bb39-2458e9400851",
                        "glosses": [
                            "een vlakke kuststrook die vrijwel geheel uit zand bestaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc17a6f2-5b26-46bb-985e-afbc76d9f443",
                                "sense_id": "c22146a1-7a56-31ff-b95e-0cc2c1421210",
                                "text": "Er zijn prachtige brede zandstranden aan de kust van Zuid-Afrika die naar Europese begrippen vrijwel leeg zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2294ef09-0ef8-4a97-94f8-a15fcad05692",
                        "source_entry_id": "a56a8594-e662-336c-bb39-2458e9400851",
                        "source_sense_id": "c22146a1-7a56-31ff-b95e-0cc2c1421210",
                        "source_sense_description": "een vlakke kuststrook die vrijwel geheel uit zand bestaat",
                        "target_lang_word": "Sandstrand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandstrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97ab068f-940f-3cc8-a208-d00f4500008b",
                                        "entry_id": "a562d6da-1523-3874-afca-9a70f1cf2d70",
                                        "glosses": [
                                            "aus Sand bestehender Strand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3dcaea-c544-4972-96de-4e92cf049a24",
                                                "sense_id": "97ab068f-940f-3cc8-a208-d00f4500008b",
                                                "text": "„Kleinere Sandstrände und Felsbuchten sind dem Ortszentrum vorgelagert. Ein besonders ansehnlicher Sandstrand, auf dem teilweise Tamarisken natürlichen Schatten spenden, ist der Kalógria-Strand am nördlichen Ortsrand.“"
                                            },
                                            {
                                                "example_id": "64edcff2-7554-468e-85e5-5a15ba693104",
                                                "sense_id": "97ab068f-940f-3cc8-a208-d00f4500008b",
                                                "text": "„Hier liegt der größte Sandstrand der Insel, der fast den gesamten Westen einnimmt und sich bei Ebbe bis zum Horizont erstreckt.“"
                                            },
                                            {
                                                "example_id": "47630164-aacb-4700-a71c-2dd4226d5492",
                                                "sense_id": "97ab068f-940f-3cc8-a208-d00f4500008b",
                                                "text": "„Am Fluß in Südfrankreich hat sie einen Lieblingsbadeplatz mit Sandstrand, der ihr das Einsteigen erleichtert.“"
                                            },
                                            {
                                                "example_id": "e6758e2b-832b-44f2-b5fb-7390d0438aaa",
                                                "sense_id": "97ab068f-940f-3cc8-a208-d00f4500008b",
                                                "text": "„Der Sandstrand war mit Steinen übersät, von Vegetation keine Spur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
