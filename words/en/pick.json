{
    "word_family": [
        "picker",
        "picky",
        "pickaxe",
        "pickpocket",
        "pickup",
        "handpick",
        "nitpick",
        "cherry-pick"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78f03bca-bd04-3ec9-9bee-2d3328cf8df1",
                    "sense_definition": "To choose or select one or more options from a group.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>pick</w> a number between one and ten.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выберите</w> число от одного до десяти.",
                                "zh": "请<w>挑选</w>一个一到十之间的数字。"
                            }
                        },
                        {
                            "text": "I will <w>pick</w> the red dress for the party.",
                            "target_lang_translations": {
                                "ru": "Я <w>выберу</w> красное платье для вечеринки.",
                                "zh": "我会为派对<w>选择</w>那件红色的裙子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "choose",
                        "select",
                        "opt for"
                    ],
                    "antonyms": [
                        "reject",
                        "refuse"
                    ],
                    "common_phrases": [
                        "pick a winner",
                        "pick and choose",
                        "take your pick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрать или отобрать один или несколько вариантов из группы.",
                        "zh": "从一组选项中挑选或选择一个或多个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбирать",
                                "target_lang_sense_clarification": "из вариантов"
                            },
                            {
                                "target_lang_word": "выбрать",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑选",
                                "target_lang_sense_clarification": "从多个中选出"
                            },
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "做出决定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "248fa269-e8a1-300a-9921-253c04a468cf",
                    "sense_definition": "To harvest fruit, vegetables, or flowers by removing them from the plant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the orchard to <w>pick</w> fresh apples.",
                            "target_lang_translations": {
                                "ru": "Мы пошли во фруктовый сад <w>собирать</w> свежие яблоки.",
                                "zh": "我们去果园<w>采摘</w>新鲜的苹果。"
                            }
                        },
                        {
                            "text": "She likes to <w>pick</w> wild flowers in the spring.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>рвать</w> полевые цветы весной.",
                                "zh": "她喜欢在春天<w>摘</w>野花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harvest",
                        "gather",
                        "collect"
                    ],
                    "antonyms": [
                        "plant"
                    ],
                    "common_phrases": [
                        "pick fruit",
                        "pick flowers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать фрукты, овощи или цветы, срывая их с растений.",
                        "zh": "从植物上采摘水果、蔬菜或花朵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "урожай"
                            },
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "цветы"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "плоды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "采摘",
                                "target_lang_sense_clarification": "摘取果实或花朵"
                            },
                            {
                                "target_lang_word": "摘",
                                "target_lang_sense_clarification": "采摘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04c0eba7-428f-37c1-98d1-92bf11444b67",
                    "sense_definition": "To remove something small or unwanted from a surface or space, often using fingers or a pointed instrument.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a toothpick to <w>pick</w> the food from his teeth.",
                            "target_lang_translations": {
                                "ru": "Он использовал зубочистку, чтобы <w>выковырять</w> еду из зубов.",
                                "zh": "他用牙签把牙缝里的食物<w>剔</w>出来。"
                            }
                        },
                        {
                            "text": "The child was told not to <w>pick</w> his nose in public.",
                            "target_lang_translations": {
                                "ru": "Ребенку сказали не <w>ковырять</w> в носу на людях.",
                                "zh": "孩子被告知不要在公共场合<w>抠</w>鼻子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remove",
                        "pluck",
                        "extract"
                    ],
                    "common_phrases": [
                        "pick one's nose",
                        "pick one's teeth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять что-то мелкое или нежелательное с поверхности или из отверстия, часто пальцами или острым инструментом.",
                        "zh": "用手指或尖锐工具从表面或缝隙中剔除细小或不想要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковырять",
                                "target_lang_sense_clarification": "в носу, в зубах"
                            },
                            {
                                "target_lang_word": "выковыривать",
                                "target_lang_sense_clarification": "удалять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剔",
                                "target_lang_sense_clarification": "剔除异物"
                            },
                            {
                                "target_lang_word": "抠",
                                "target_lang_sense_clarification": "用手指挖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf656655-2c17-3142-be78-d06aedbecca3",
                    "sense_definition": "To intentionally provoke or start a quarrel or fight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "provocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>pick</w> a fight with the bouncer at the club.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>затеять</w> драку с вышибалой в клубе.",
                                "zh": "他试图在俱乐部里跟保安<w>挑起</w>争端。"
                            }
                        },
                        {
                            "text": "Don't <w>pick</w> an argument when you know you are wrong.",
                            "target_lang_translations": {
                                "ru": "Не <w>затевай</w> спор, когда знаешь, что неправ.",
                                "zh": "当你明知自己错了的时候，就不要<w>找茬</w>吵架。"
                            }
                        }
                    ],
                    "synonyms": [
                        "provoke",
                        "instigate",
                        "start"
                    ],
                    "antonyms": [
                        "avoid"
                    ],
                    "common_phrases": [
                        "pick a fight",
                        "pick a quarrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно провоцировать или начинать ссору или драку.",
                        "zh": "故意挑衅或引发争吵、打架。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затевать",
                                "target_lang_sense_clarification": "ссору, драку"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "конфликт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑起",
                                "target_lang_sense_clarification": "引发争端"
                            },
                            {
                                "target_lang_word": "找茬",
                                "target_lang_sense_clarification": "故意寻衅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c53d5af-68d4-3bf6-9807-5550b301ef9d",
                    "sense_definition": "To open a lock without using the key, typically by using a wire or special tool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unlocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief managed to <w>pick</w> the lock on the back door.",
                            "target_lang_translations": {
                                "ru": "Вору удалось <w>вскрыть</w> замок на задней двери.",
                                "zh": "小偷设法<w>撬</w>开了后门的锁。"
                            }
                        },
                        {
                            "text": "I lost my keys and had to learn how to <w>pick</w> the padlock.",
                            "target_lang_translations": {
                                "ru": "Я потерял ключи и мне пришлось научиться <w>вскрывать</w> навесной замок.",
                                "zh": "我丢了钥匙，不得不学习如何<w>撬</w>挂锁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick a lock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открывать замок без ключа, обычно с помощью проволоки или специального инструмента.",
                        "zh": "在没有钥匙的情况下，使用金属丝或特殊工具打开锁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскрывать",
                                "target_lang_sense_clarification": "замок"
                            },
                            {
                                "target_lang_word": "открывать отмычкой",
                                "target_lang_sense_clarification": "инструментом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撬",
                                "target_lang_sense_clarification": "撬锁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b9ded91-b381-340a-a9b1-389784bda055",
                    "sense_definition": "To play a stringed musical instrument by plucking the strings individually.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat on the porch and began to <w>pick</w> a tune on his banjo.",
                            "target_lang_translations": {
                                "ru": "Он сел на крыльцо и начал <w>наигрывать</w> мелодию на своем банджо.",
                                "zh": "他坐在门廊上，开始用班卓琴<w>拨弄</w>出一首曲子。"
                            }
                        },
                        {
                            "text": "She learned to <w>pick</w> the guitar strings with great speed.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>перебирать</w> гитарные струны с большой скоростью.",
                                "zh": "她学会了快速地<w>拨弄</w>吉他弦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pluck",
                        "strum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на струнном музыкальном инструменте, перебирая струны по отдельности.",
                        "zh": "通过拨动琴弦来演奏弦乐器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перебирать",
                                "target_lang_sense_clarification": "струны"
                            },
                            {
                                "target_lang_word": "наигрывать",
                                "target_lang_sense_clarification": "мелодию"
                            },
                            {
                                "target_lang_word": "щипать",
                                "target_lang_sense_clarification": "струны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拨弄",
                                "target_lang_sense_clarification": "弹奏弦乐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b52d972f-652b-3e81-a777-f86af1638ee2",
                    "sense_definition": "To eat food slowly, sparingly, or without appetite.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wasn't hungry, so she just <w>picked</w> at her dinner.",
                            "target_lang_translations": {
                                "ru": "Она не была голодна, поэтому просто <w>ковырялась</w> в своем ужине.",
                                "zh": "她不饿，所以只是随便<w>挑食</w>地吃了几口晚餐。"
                            }
                        },
                        {
                            "text": "The bird <w>picked</w> at the crumbs left on the table.",
                            "target_lang_translations": {
                                "ru": "Птица <w>клевала</w> крошки, оставленные на столе.",
                                "zh": "鸟儿在桌上<w>啄</w>食留下的面包屑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nibble"
                    ],
                    "antonyms": [
                        "gorge",
                        "devour"
                    ],
                    "common_phrases": [
                        "pick at food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть медленно, неохотно или без аппетита.",
                        "zh": "吃得很少、很慢，或者没有胃口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковыряться",
                                "target_lang_sense_clarification": "в еде"
                            },
                            {
                                "target_lang_word": "клевать",
                                "target_lang_sense_clarification": "о птицах или людях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑食",
                                "target_lang_sense_clarification": "对食物没胃口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af912340-566f-31c6-9daa-7afab8b12631",
                    "sense_definition": "To move carefully and slowly through a difficult place, selecting the best footing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>pick</w> our way through the muddy field.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>пробираться</w> через грязное поле.",
                                "zh": "我们不得不<w>小心地走</w>过那片泥泞的田地。"
                            }
                        },
                        {
                            "text": "The hikers <w>picked</w> their way down the steep, rocky slope.",
                            "target_lang_translations": {
                                "ru": "Туристы <w>пробирались</w> вниз по крутому каменистому склону.",
                                "zh": "徒步旅行者<w>小心地走</w>下陡峭的岩石坡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно и медленно пробираться через трудное место, выбирая, куда наступить.",
                        "zh": "在困难的地形中小心缓慢地行走，选择落脚点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробираться",
                                "target_lang_sense_clarification": "через препятствия"
                            },
                            {
                                "target_lang_word": "осторожно ступать",
                                "target_lang_sense_clarification": "выбирать дорогу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小心地走",
                                "target_lang_sense_clarification": "谨慎前行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30d33a3a-c347-32fc-ad84-4d3dd0f1bf8d",
                    "sense_definition": "An act of choosing or the ability to choose from a range of options.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can have your <w>pick</w> of any cake on the tray.",
                            "target_lang_translations": {
                                "ru": "Вы можете сделать свой <w>выбор</w> из любого пирожного на подносе.",
                                "zh": "托盘上的蛋糕你可以任选一个<w>选择</w>。"
                            }
                        },
                        {
                            "text": "The store offers a wide <w>pick</w> of fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает широкий <w>выбор</w> свежих овощей.",
                                "zh": "这家店提供多种新鲜蔬菜供你<w>选择</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "choice",
                        "selection",
                        "option"
                    ],
                    "common_phrases": [
                        "take your pick",
                        "have the pick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт выбора или возможность выбрать из ряда вариантов.",
                        "zh": "选择的行为或从一系列选项中进行选择的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбор",
                                "target_lang_sense_clarification": "возможность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "挑选的权利或行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe997a8-3f3d-30c4-8c6c-d871e7513ca0",
                    "sense_definition": "A heavy tool with a curved metal head pointed at one or both ends, mounted on a handle, used for breaking up hard ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool_digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners used a <w>pick</w> and shovel to dig the tunnel.",
                            "target_lang_translations": {
                                "ru": "Шахтеры использовали <w>кирку</w> и лопату, чтобы рыть туннель.",
                                "zh": "矿工们用<w>镐</w>和铲子挖掘隧道。"
                            }
                        },
                        {
                            "text": "He swung the <w>pick</w> into the hard earth to loosen the soil.",
                            "target_lang_translations": {
                                "ru": "Он вонзил <w>кирку</w> в твердую землю, чтобы разрыхлить почву.",
                                "zh": "他把<w>镐</w>挥向坚硬的土地以松土。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pickaxe",
                        "mattock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый инструмент с изогнутой металлической головкой, заостренной с одного или обоих концов, насаженной на рукоятку, используемый для разрыхления твердой земли.",
                        "zh": "一种重型工具，带有弯曲的金属头，一端或两端尖锐，安装在手柄上，用于破碎坚硬的地面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кирка",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "кайло",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镐",
                                "target_lang_sense_clarification": "挖掘工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40bccddc-b4d8-3a0d-9eb6-d49212cb65d2",
                    "sense_definition": "A small, thin piece of plastic or metal used to strum or pluck the strings of a guitar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I dropped my <w>pick</w> inside the sound hole of the guitar.",
                            "target_lang_translations": {
                                "ru": "Я уронил свой <w>медиатор</w> внутрь резонаторного отверстия гитары.",
                                "zh": "我不小心把<w>拨片</w>掉进了吉他的音孔里。"
                            }
                        },
                        {
                            "text": "He prefers a heavy <w>pick</w> for playing electric guitar.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает толстый <w>медиатор</w> для игры на электрогитаре.",
                                "zh": "他弹电吉他时更喜欢用厚重的<w>拨片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plectrum"
                    ],
                    "common_phrases": [
                        "guitar pick"
                    ],
