                ],
                "senses": [
                    {
                        "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                        "entry_id": "24f00d85-b206-395a-aaee-817348cb64a5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a865873f-ea12-4744-95f7-06ac49893bb9",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Frau Schmalzgruber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c47a63bc-01c0-48fc-a5a2-c9d7c05515a3",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Herr Schmalzgruber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a66dadc3-5c6a-4e46-aed9-28d204501b2b",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Die Schmalzgrubers kommen heute von der Schwäbischen Alb."
                            },
                            {
                                "example_id": "d2674a30-ff67-49ec-b0c9-981db793f27a",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Der Schmalzgruber trägt nie die Schals, die die Schmalzgruber ihm strickt."
                            },
                            {
                                "example_id": "d686b2d6-6e82-4fc9-9783-70fa16c3f507",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmalzgruber kommt, geht der Herr Schmalzgruber.“"
                            },
                            {
                                "example_id": "47797b3e-c62d-479a-9bce-bb707bf5d844",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Schmalzgruber kommt und geht."
                            },
                            {
                                "example_id": "50fae36a-623b-4cd0-ac69-49d26c15d432",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "Schmalzgrubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3ee50862-2082-48ff-88d8-bb6bdefd2c08",
                                "sense_id": "81cd6f3a-4a22-389b-85e9-4e5fe2eb7e8a",
                                "text": "„Der Schmalzgruber ist recht gemüthlich heute, nur fragt er Jeden um den Beichtzettel, denn diese Scheine muß er einsammeln und sie zum Schlusse der österlichen Zeit wieder an den Pfarrer abliefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
