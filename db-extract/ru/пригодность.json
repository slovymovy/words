                ],
                "translations": [
                    {
                        "translation_id": "9edb654f-2f66-49f5-9a02-abf2787f1a10",
                        "source_entry_id": "a5412b30-6157-35f0-b81d-b529036c0c86",
                        "source_sense_id": "e59cde30-aff7-33e0-bf49-f1e37df774f8",
                        "target_lang_word": "aptitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aptitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                        "entry_id": "98e0282e-1ece-3047-96c9-dd33ab8e5e3c",
                                        "glosses": [
                                            "Capacité, compétence, disposition naturelle à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63420503-e781-4596-9443-659ce089ec50",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Le grand jeune homme dégingandé, qui s’appelait Laurier, s’était apparemment institué chef en raison de sa position sociale et de ses aptitudes naturelles."
                                            },
                                            {
                                                "example_id": "edbf3f13-fcb7-4a74-a7e1-f6f7ce760086",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l'engraissement. Il est aussi le plus répandu."
                                            },
                                            {
                                                "example_id": "0d1a7288-cab9-4284-ac5b-b29282e46d7a",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Assez docilement se laissa-t-il convaincre : l’aptitude pour le dessin qu'il s'était découverte en croquant, au ministère, les binettes de ses voisins de pupitre, achevait de lui supprimer toute perplexité de vocation."
                                            },
                                            {
                                                "example_id": "f9ca8508-a0de-4517-ad1c-41ed5e2f9138",
                                                "sense_id": "99773c62-73e4-36fa-9905-a7f4676ae378",
                                                "text": "Mon père dit toujours que mon sens de l’orientation en forêt est troublant – tout comme mon aptitude à retrouver mon chemin jusqu'au point de départ – mais je ne m'y fiais pas à cet instant. Je m'arrêtai sous un arbre gigantesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe4b2df-cf02-379c-9b78-b4b4adc3140d",
                                        "entry_id": "98e0282e-1ece-3047-96c9-dd33ab8e5e3c",
                                        "glosses": [
                                            "Compétence à recevoir un legs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2278ce90-eb01-44ef-a679-19d6bdc49388",
                        "source_entry_id": "a5412b30-6157-35f0-b81d-b529036c0c86",
                        "source_sense_id": "e59cde30-aff7-33e0-bf49-f1e37df774f8",
                        "target_lang_word": "capacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Pouvoir de réaliser ou de produire quelque chose, en parlant de personnes ou de choses ; aptitude ; faculté ; force ; habileté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "830cf8aa-e583-4845-bedd-439eec05b502",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Et il y avait du travail pour tous : bonnetiers, mécaniciens, rebrousseurs, formeuses, remailleuses, visiteuses, chacun, homme ou femme, pouvant y trouver un poste correspondant à sa condition et à ses capacités."
                                            },
                                            {
                                                "example_id": "417e005c-f452-4cf2-8b7a-7e28f2fa0cf8",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                                            },
                                            {
                                                "example_id": "eb3dba38-ca96-423c-b7d5-179bea37da65",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Entraînées par l’enthousiasme démesuré de l’adolescence, elles surestimèrent leurs capacités physiologiques."
                                            },
                                            {
                                                "example_id": "354f36d5-0441-46e0-aad5-519e45aea5f5",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Le manichéisme quasi infantile d’Éric Zemmour obère sa capacité future à unir les Français, décrédibilisant résolument sa candidature à la magistrature suprême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7c7140-d533-3458-ba52-448325cccbea",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Quantité d’un contenant, volume, contenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976ffeb8-ee9e-4301-b89c-9ff6ef178241",
                                                "sense_id": "8c7c7140-d533-3458-ba52-448325cccbea",
                                                "text": "Cette bouteille a une capacité de 1,5 litres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68824fb2-04f3-30ad-899f-15357d82f4a5",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Production maximale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6446551f-810d-42e9-b7f8-488cf8b2b006",
                                                "sense_id": "68824fb2-04f3-30ad-899f-15357d82f4a5",
                                                "text": "Les Salins du midi exploitent: […]\n— dans l'est, à Varangéville (Meurthe-et-Moselle), une importante saline d’une capacité annuelle de 625 000 tonnes de sel ignigène, ainsi qu’une mine de sel gemme dont la capacité annuelle d’extraction est de 600 000 tonnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7076edc2-f99d-312e-8e25-4b660e15f80a",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Pouvoirs reconnus par la loi à une catégorie d’individus de s’engager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baead617-0bc1-473e-965b-f47cc8d98f2e",
                                                "sense_id": "7076edc2-f99d-312e-8e25-4b660e15f80a",
                                                "text": "Les capacités des femmes mariées ont été largement accrues récemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61805375-8c8d-34d1-82de-b51ed63bbb9b",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Capacité électrique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c94d4c-a566-4c27-9284-18c615f32850",
                                                "sense_id": "61805375-8c8d-34d1-82de-b51ed63bbb9b",
                                                "text": "Ce condensateur a une capacité de 500 microfarads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1ccc32-5f30-366c-80ad-3165cecc3b88",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Capacité électrique.",
                                            "Le condensateur lui-même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "649d0566-2b3a-3529-96dd-1fbe214c58f2",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Diplôme, attestation, certificat."
                                        ],
                                        "tags": [
                                            "Formation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "142f6f4e-c2dd-4cd1-a322-88cc68c3cda9",
                                                "sense_id": "649d0566-2b3a-3529-96dd-1fbe214c58f2",
                                                "text": "Il a obtenu sa capacité d’ambulancier, avant de préparer sa capacité de médecine d’urgence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeed9348-3e3c-3885-a78a-ba360e42177b",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Personnes qui, par leurs compétences, leurs connaissances ou leur position sociale sont en situation d’exercer des fonctions politiques."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb2f391-97f8-4ef8-84ca-a83701b0e913",
                                                "sense_id": "eeed9348-3e3c-3885-a78a-ba360e42177b",
                                                "text": "Il y a eu des personnalités, Champlain, Montcalm, comme aux Indes Lally-Tollendal, ou Dupleix. Mais la masse ne s’y intéressait guère. Et quand nous sommes partis, les capacités sont rentrées en France. Seul le populo est resté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "320b8858-d7e3-45f5-acec-d9d9e8904cb4",
                        "source_entry_id": "a5412b30-6157-35f0-b81d-b529036c0c86",
                        "source_sense_id": "e59cde30-aff7-33e0-bf49-f1e37df774f8",
                        "target_lang_word": "validité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "validité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                        "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                                        "glosses": [
                                            "Caractère de ce qui est valide ou valable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea23ff6-f8a7-4f42-9ad8-7c1fd6529442",
                                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                                "text": "Les députés se demandèrent donc si la sanction royale étaient indispensable à la validité des textes constituants. […]. Les lois constitutionnelles ne devaient donc pas être sanctionnées par le roi."
                                            },
                                            {
                                                "example_id": "3e820be6-b59d-4a01-a4ce-a54200db181d",
                                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                                "text": "Cette nomenclature binomiale a été introduite, en botanique d'abord puis en zoologie, par le célèbre naturaliste suédois Cari von Linné (1707- 1778); elle est devenue une règle internationale non sans donner lieu à d’interminables querelles de spécialistes sur sa validité lorsqu'on l'applique aux animaux domestiques."
                                            },
                                            {
                                                "example_id": "b41be005-002b-41d2-9aaf-8cf1680e4955",
                                                "sense_id": "5c4c69e5-0eda-3dfe-8cfe-8c8d281c330a",
                                                "text": "Les sources d’information appuyant la version alternative se trouvent surtout sur Internet. La validité des faits et des arguments rapportés dans de nombreux sites Web « amateurs » se révèle souvent douteuse ou carrément nulle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                        "entry_id": "9054de74-c4c6-3f34-a8bf-d2cf12b3fcde",
                                        "glosses": [
                                            "Force, vertu que certaines choses reçoivent de l’accomplissement des formalités et des conditions qui leur sont nécessaires."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9bf6807-8ab4-4217-a38f-16b4f3ee8afb",
                                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                                "text": "On lui conteste la validité de son titre."
                                            },
                                            {
                                                "example_id": "8a4aef58-0ac5-4985-8584-07566fa8f398",
                                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                                "text": "La validité d’un acte."
                                            },
                                            {
                                                "example_id": "cb13603e-9c54-40ab-9c2d-ce62dc264fad",
                                                "sense_id": "7b1d06e0-1298-374e-9675-835548d6580c",
                                                "text": "La durée de validité d’un billet de chemin de fer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be511756-26a7-4b28-a67d-32560193ec09",
                        "source_entry_id": "a5412b30-6157-35f0-b81d-b529036c0c86",
                        "source_sense_id": "e59cde30-aff7-33e0-bf49-f1e37df774f8",
                        "target_lang_word": "utilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                        "entry_id": "d3d0788c-3a15-344d-8d0a-de2986f70947",
                                        "glosses": [
                                            "Aptitude d’une chose, d’une action ou d’une connaissance à répondre à un besoin ou à procurer un avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f108538-27b5-4d7d-beac-57fe6d3ab0b9",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "La lutte des intérêts matériels et des principes moraux, de l’utilité et du devoir, du matérialisme et du spiritualisme, se représente ici avec une nouvelle force, et sous un point de vue encore plus important."
                                            },
                                            {
                                                "example_id": "c1ed4bcb-c40e-42ad-a196-e165957e44d6",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "Le seigneur viscontier qui ne trouvait pas d’endroit convenable pour établir la fourche patibulaire, pouvait même contraindre le propriétaire d’un champ à lui céder l’emplacement dont il avait besoin : c’était une application anticipée de la loi d’expropriation pour cause d’utilité publique."
                                            },
                                            {
                                                "example_id": "955a51b2-4910-4d85-a2d9-5ae67c951023",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "Il était vêtu un peu dans le genre boy-scout, avec pendu à sa ceinture un couteau à nombreuses lames et probablement peu d’utilité, une boussole, un sifflet, etc. […]"
                                            },
                                            {
                                                "example_id": "676f558c-fab1-4498-be6d-43ca083c271d",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "J’essayais de leur faire voir que l’utilité est un concept plus vaste qu’ils ne le croyaient, qu’une connaissance, obligatoire ou pas, peut bien sûr avoir une utilité directe (savoir construire une maison, retirer une tumeur d’un cerveau, éviscérer un orignal), mais aussi indirecte (développer une compétence qui nous aide à en acquérir d’autres, par exemple)."
                                            },
                                            {
                                                "example_id": "3b8d94bc-bd4c-4e61-9c59-9d63f0f5ad10",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "Demain, nous nous pencherons sur une autre forme de conversion, celle qui consisterait à indexer l’échelle des salaires sur “l’utilité commune”, selon l’hypothèse émise le président Macron dans sa dernière allocution télévisée."
                                            },
                                            {
                                                "example_id": "8c49c219-c83a-432b-a7d6-13876ca509e1",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "\"L' univers crypto est (...) désormais attendu sur sa capacité à respecter la règlementation et j'y ajouterai sa capacité à démontrer son utilité économique et sociale\", a déclaré Marie-Anne Barbat-Layani à l'occasion du troisième forum Fintech, une journée d'échanges organisée dans les locaux de la Banque de France par l'AMF et l'Autorité de contrôle prudentiel et de résolution (ACPR)."
                                            },
                                            {
                                                "example_id": "d319a67a-635e-4075-bf01-6d7a2cf9ca5e",
                                                "sense_id": "8541d7b6-4ed3-3ee4-9b83-f1a547ee40e4",
                                                "text": "Si la facilité d’utilisation et l’ utilité perçue des objets connectés ont un impact sur l’acceptabilité de ces objets pour une grande partie de la population, les interruptions numériques qui y sont souvent attachées entravent notre cognition, c’est-à-dire l’ensemble des processus liés à la perception, l’attention, la mémoire, la compréhension, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5470a6-0dd8-37d2-b5dd-adfbc93d4502",
                                        "entry_id": "d3d0788c-3a15-344d-8d0a-de2986f70947",
                                        "glosses": [
                                            "Ce qui est utile à la collectivité, en particulier dans le cadre de l’utilité publique ou de l’utilité générale."
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30322ffc-729c-499c-8587-99b81a1d40b3",
                                                "sense_id": "5f5470a6-0dd8-37d2-b5dd-adfbc93d4502",
                                                "text": "Les physiocrates paraissaient disposés à sacrifier les individus à l’utilité générale ; ils tenaient fort peu à la liberté et trouvaient absurde l’idée d’une pondération des pouvoirs ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0d236d-49a7-354d-8030-d2c9d6e56a44",
                                        "entry_id": "d3d0788c-3a15-344d-8d0a-de2986f70947",
                                        "glosses": [
                                            "Valeur subjective attribuée par un individu à un bien ou à un service, mesurée par la satisfaction ou le bien-être qu’il en retire ; notion centrale de l’utilité marginale."
                                        ],
                                        "tags": [
                                            "Économie néoclassique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5743b5-bca6-45b5-b402-dc457b48c34a",
                                                "sense_id": "bd0d236d-49a7-354d-8030-d2c9d6e56a44",
                                                "text": "L’environnement est une externalité, positive ou négative, c’est-à-dire une composante extérieure au raisonnement économique ; pour la réintégrer au raisonnement il faut passer par l’utilité. Les questions qu’il se pose sont les suivantes : quelle est l’utilité (= la valeur) pour le consommateur d’un environnement sain ou équilibré (versus un état où il est pollué ou détruit, partiellement ou totalement) ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31eaac79-0998-3c97-88bf-bd815de7e79f",
                                        "entry_id": "d3d0788c-3a15-344d-8d0a-de2986f70947",
                                        "glosses": [
                                            "Interprète chargé·e de rôles secondaires ou de figuration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be4d42ca-4bbd-44d8-ab8b-36c5d5a3964d",
                                                "sense_id": "31eaac79-0998-3c97-88bf-bd815de7e79f",
                                                "text": "Elle joue les utilités."
                                            },
                                            {
                                                "example_id": "247d10ea-20ac-41d9-b631-f46dacc6ef13",
                                                "sense_id": "31eaac79-0998-3c97-88bf-bd815de7e79f",
                                                "text": "Ils n’avaient peut-être donné qu’une réplique, peut-être même n’avaient-ils fait que traverser du côté cour au côté jardin, ou étaient-ils des utilités, ou faisaient-ils partie des figurants ou du chœur ?"
                                            },
                                            {
                                                "example_id": "2a0edcee-f2d3-4c18-a301-e5e95982f991",
                                                "sense_id": "31eaac79-0998-3c97-88bf-bd815de7e79f",
                                                "text": "Certains auteurs poussent des « utilités » sur le devant de la scène et présentent leur héros fugitivement en profil perdu. Le lecteur ne s’y trompe pas : il a feuilleté le dernier chapitre pour voir si le roman finissait bien, il sait que le jeune homme pâle, contre la cheminée, a trois cent cinquante pages dans le ventre."
                                            },
                                            {
                                                "example_id": "8a2d14ca-d3d3-4e6d-91db-b284946113e2",
                                                "sense_id": "31eaac79-0998-3c97-88bf-bd815de7e79f",
                                                "text": "Un bonheur ne venant pas seul, Robert est reçu à l’entrée au Conservatoire (1942), classe de Béatrix Dussane : « Je n’étais pas dupe, j’étais une utilité »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9279f44-7c3c-3f29-8f50-438e2dcc017d",
                                        "entry_id": "d3d0788c-3a15-344d-8d0a-de2986f70947",
                                        "glosses": [
                                            "Ensemble des fluides, énergies et services auxiliaires nécessaires au fonctionnement d’une installation (vapeur, air comprimé, électricité, eau, froid, etc.)."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35676c5c-fd08-4ff1-a270-65161cd23475",
                                                "sense_id": "a9279f44-7c3c-3f29-8f50-438e2dcc017d",
                                                "text": "Les utilités industrielles comme la vapeur, l'air comprimé, le froid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
