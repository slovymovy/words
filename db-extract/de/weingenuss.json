                                "example_id": "3a992a24-119d-4a1b-b379-c8b555377db1",
                                "sense_id": "606b4848-ad85-382d-96a5-2c6fd9907be1",
                                "text": "„Wer Meerurlaub und Weingenuss kombinieren möchte, der ist in Celino San Marco richtig.“"
                            },
                            {
                                "example_id": "629ab77e-2e8f-4dc7-8175-3f664365d6f1",
                                "sense_id": "606b4848-ad85-382d-96a5-2c6fd9907be1",
                                "text": "„Er schildert, wie er nach heftigem Weingenuss einschläft und einen Traum hat.“"
                            },
                            {
                                "example_id": "c8d3cb1a-d678-453e-a230-b50d433500e0",
                                "sense_id": "606b4848-ad85-382d-96a5-2c6fd9907be1",
                                "text": "„Effenbergers These: ‚Das Risiko von Infarkt und Arteriosklerose wird bei mäßigem Weingenuss abgesenkt‘.“"
                            }
