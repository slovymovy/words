{
    "word_family": [
        "grave",
        "gravity",
        "gravitation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ccedb821-798f-3794-aab0-44a032d5a3cf",
                    "sense_definition": "A dignified, solemn, and serious manner or bearing that commands respect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dignity_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran actor brought great <w>gravitas</w> to the role of the troubled king.",
                            "target_lang_translations": {
                                "zh": "这位资深演员为这位饱受困扰的国王角色赋予了极大的<w>庄重威严</w>。"
                            }
                        },
                        {
                            "text": "Many commentators felt that the young politician lacked the necessary <w>gravitas</w> for high office.",
                            "target_lang_translations": {
                                "zh": "许多评论员认为，这位年轻政客缺乏担任高级职位所必需的<w>沉稳庄重</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dignity",
                        "seriousness",
                        "solemnity"
                    ],
                    "antonyms": [
                        "frivolity",
                        "levity"
                    ],
                    "common_phrases": [
                        "bring gravitas",
                        "lack gravitas",
                        "air of gravitas"
                    ],
                    "target_lang_definitions": {
                        "zh": "庄重、严肃且令人肃然起敬的风度或举止"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "庄重",
                                "target_lang_sense_clarification": "指风度、言行举止沉着严肃"
                            },
                            {
                                "target_lang_word": "威严",
                                "target_lang_sense_clarification": "指令人敬畏的庄重气派"
                            },
                            {
                                "target_lang_word": "沉稳",
                                "target_lang_sense_clarification": "指稳重深沉的气质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3b243be-3f06-3c1a-9e7f-189a9e7f0bb2",
                    "sense_definition": "Substantial importance, weight, or depth in substance or intellectual authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dignity_weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her academic research gave intellectual <w>gravitas</w> to the government's economic policy.",
                            "target_lang_translations": {
                                "zh": "她的学术研究为政府的经济政策增添了知识上的<w>分量</w>。"
                            }
                        },
                        {
                            "text": "The light entertainment program lacked the <w>gravitas</w> of a traditional news broadcast.",
                            "target_lang_translations": {
                                "zh": "这档轻娱乐节目缺乏传统新闻广播那种<w>严肃厚重感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "substance",
                        "weight"
                    ],
                    "antonyms": [
                        "shallowness",
                        "superficiality"
                    ],
                    "common_phrases": [
                        "intellectual gravitas"
                    ],
                    "target_lang_definitions": {
                        "zh": "内容或学术权威上的分量、重要性或深刻深度"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分量",
                                "target_lang_sense_clarification": "指内容、学术或言论的重要性与影响力"
                            },
                            {
                                "target_lang_word": "深度",
                                "target_lang_sense_clarification": "指内容或思想深刻、不肤浅"
                            },
                            {
                                "target_lang_word": "厚重感",
                                "target_lang_sense_clarification": "指内容或思想富有内涵与严肃分量"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}