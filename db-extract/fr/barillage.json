                        ],
                        "examples": [
                            {
                                "example_id": "1fed4684-08de-4575-9e5e-c964791b065a",
                                "sense_id": "1bdad46d-8033-3f0f-8d0f-751b611fe2ee",
                                "text": "L’ordonnance des aides du mois de juin 1680, titre 4 des entrepôts & du barillage, art. 3 & 4, défend expressément de faire le barillage, c’est-à-dire, de faire arriver du vin en bouteilles, cruches ou barils, ni vaisseaux moindres que muids, demi-muids, quarts & huitièmes ; à l’exception des vins de liqueur, qui viennent en caissè ; comme aussi d’en vendre en gros dans des vaisseaux moindres que demi -muids ou quarts de muids."
                            }
                        ]
