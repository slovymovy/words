            {
                "entry_id": "e65e27fa-addf-37b7-844d-2d5f6f8a83fa",
                "word": "rando",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d07b748b-855b-44d2-aa4a-8e1bad42d637",
                        "entry_id": "e65e27fa-addf-37b7-844d-2d5f6f8a83fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "randos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb12bdec-5ab8-31d5-b34c-1db26ac97d9b",
                        "entry_id": "e65e27fa-addf-37b7-844d-2d5f6f8a83fa",
                        "glosses": [
                            "An arbitrary person with whom one has no shared social connection."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "mildly"
                        ],
                        "examples": [
                            {
                                "example_id": "7aaa993b-0910-4ee2-8a36-d9fecdc9af6d",
                                "sense_id": "fb12bdec-5ab8-31d5-b34c-1db26ac97d9b",
                                "text": "I accidentally took some rando's luggage from the airport carousel."
                            },
                            {
                                "example_id": "1ce9b7ee-f903-4bad-a1bd-5a5e424ec9e1",
                                "sense_id": "fb12bdec-5ab8-31d5-b34c-1db26ac97d9b",
                                "text": "The very idea that a bunch of randos on the internet could create a better encyclopedia than a team of professionals was mildly ludicrous, and yet the project went on, […]."
                            },
                            {
                                "example_id": "af4e603f-e537-4d66-b0cd-41ce1c934cdc",
                                "sense_id": "fb12bdec-5ab8-31d5-b34c-1db26ac97d9b",
                                "text": "You don't have to go finding randos to battle!"
                            },
                            {
                                "example_id": "c34d9f19-ef5c-4d5b-a7d1-117f0bb051d9",
                                "sense_id": "fb12bdec-5ab8-31d5-b34c-1db26ac97d9b",
                                "text": "“[mockingly]: \"Be a hero, Peanut Hamper. The needs of many, Peanut Hamper.\" Kill yourself for a bunch of randos you met three hours ago, Peanut Hamper! It was my first day. They expect me to sacrifice myself on day one? No way! Ugh! I hate Starfleet. What about the needs of the me?”"
                            }
                        ]
                    },
                    {
                        "sense_id": "d9e87665-1769-3abb-9664-3caac908c93c",
                        "entry_id": "e65e27fa-addf-37b7-844d-2d5f6f8a83fa",
                        "glosses": [
                            "An arbitrary person with whom one has no shared social connection.",
                            "A person going to a party without being invited."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "mildly"
                        ],
                        "examples": [
                            {
                                "example_id": "9d7cdf0d-632a-498a-84c3-2a5cc5835754",
                                "sense_id": "d9e87665-1769-3abb-9664-3caac908c93c",
                                "text": "“We gathered all the people that love you into this one room. And then when we saw all the empty chairs, we decided to drag some randos in off the street to fill them!” [drum plays rim shot] [laughter] “So many illustrious guests here on the dais tonight. And also Colin Robinson.” [rim shot] [laughter] “He got me, I got got.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "56d86bb5-59dc-3a49-b984-db23071dcb81",
                        "entry_id": "e65e27fa-addf-37b7-844d-2d5f6f8a83fa",
                        "glosses": [
                            "Anything selected at random."
                        ],
