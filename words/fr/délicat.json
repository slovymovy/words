    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee743e9a-de1a-3c29-9421-1d725bd83a33",
                    "sense_definition": "Qui est fragile, qui risque de se briser, de s'abîmer ou de tomber malade facilement.",
