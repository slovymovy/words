                "senses": [
                    {
                        "sense_id": "11977611-954c-337f-8215-4b45a111dcbc",
                        "entry_id": "ec2fcb10-2e9f-3ff3-8d28-edfa85ff9ae2",
                        "glosses": [
                            "To perform a headspring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d99885-edc3-4532-a3fd-3e7982e5a5f8",
                                "sense_id": "11977611-954c-337f-8215-4b45a111dcbc",
                                "text": "Cartwheel with quarter-turn (Arabian Spring) ; roll back with closed feet into momentary handstand (back extension) ; front standing balance and with a leap, change the position of the feet; place hands on floor and do a momentary handstand; lie down on the front and rock backwards and forward, and do a cross-scissors with the legs on the forward movement; sit up with half-turn, bend forward twice, then roll back into sitting kneeling split position; change this position and lie on the front with hands under the shoulders and push up into front leaning rest position; raise body up steadily into headstand position without bending the legs; from this position lean forward with hips bent; then headspring into knee bending position; stand up, and with a few running steps do a handspring into knee bent position."
                            },
                            {
                                "example_id": "46f2028a-1961-4fb4-9b8e-7721ddf9a0a8",
                                "sense_id": "11977611-954c-337f-8215-4b45a111dcbc",
                                "text": "From there I would walk on my head to the far end of the box and then headspring to the floor, landing on my feet."
                            }
                        ]
                    }
