                ],
                "senses": [
                    {
                        "sense_id": "4dae1653-cd01-3876-9b7d-85dc500872d0",
                        "entry_id": "59773700-d1f1-3f4d-bb3e-0805828b5576",
                        "glosses": [
                            "рег., устар. древко, жердь, шест, кол"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e444f3cb-014b-4c51-847c-4b1d77f8f115",
                                "sense_id": "4dae1653-cd01-3876-9b7d-85dc500872d0",
                                "text": "А ослоп в лесах на севере и доселе означает дубину, стяг."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cadf228-1a8f-3318-bf7f-a9e17456abd8",
                        "entry_id": "59773700-d1f1-3f4d-bb3e-0805828b5576",
                        "glosses": [
                            "высок. то же, что знамя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe9b0f9c-bce1-4144-86cd-39adef462c18",
                                "sense_id": "1cadf228-1a8f-3318-bf7f-a9e17456abd8",
                                "text": "Просто разбивали шатер для каждого из воевод, тут же ставили воз с полковым стягом, близ него, на возах, огнестрельный снаряд, состоящий из пищалей, и пушки, если случались."
                            }
                        ]
                    }
                ],
