                "senses": [
                    {
                        "sense_id": "8f01f6a3-3a60-3b6d-9835-ebdcaf7b4325",
                        "entry_id": "0b1321c5-02e7-3d17-8927-bf1fd7809c09",
                        "glosses": [
                            "Écrit par le poète latin Virgile, ou dans un style proche du sien."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "744dfb19-1f78-3cbc-af85-38024009bcf9",
                        "entry_id": "0b1321c5-02e7-3d17-8927-bf1fd7809c09",
                        "glosses": [
                            "Se dit d’un auteur dont le style s’inspire de celui de Virgile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a962464-e51b-4eff-8048-0c6e256510a8",
                                "sense_id": "744dfb19-1f78-3cbc-af85-38024009bcf9",
                                "text": "[…] enfin l’ultime chalumeau virgilien, l’aphone poète Venantius Fortunatus […]"
                            },
                            {
                                "example_id": "7b88d465-c565-4a8b-82e0-bc67acc7157c",
                                "sense_id": "744dfb19-1f78-3cbc-af85-38024009bcf9",
                                "text": "[…] elle évoqua avec une éloquence virgilienne, l'image d'une belle famille française réunie autour du samovar familial […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b2c4514-1a9c-356b-80d7-2d40d1121624",
                        "entry_id": "0b1321c5-02e7-3d17-8927-bf1fd7809c09",
                        "glosses": [
                            "Qui aurait pu être relaté par Virgile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a34591f-d17a-4fcf-93da-1707ab208b62",
                                "sense_id": "7b2c4514-1a9c-356b-80d7-2d40d1121624",
                                "text": "Elle forme des projets virgiliens et délicieux… Nous devons nous en aller loin, bien loin, dans une petite maison entourée de grands arbres… elle élèvera des poules qui pondront des œufs qu’elle-même dénichera, tous les matins ; […]"
                            },
                            {
                                "example_id": "282bcd94-ddc1-45e0-8a15-b26f2a8f700a",
                                "sense_id": "7b2c4514-1a9c-356b-80d7-2d40d1121624",
                                "text": "Mais ce soir, c’était encore la paix. Une paix virgilienne, avec des toits brouillés de fumée bleue, une chèvre tirant en bêlant sur sa longe et la fille décoiffée qui ramenait à bras tendus un seau tout giclant de l’abreuvoir."
                            },
                            {
                                "example_id": "acfe7c73-e5d0-4dd9-8966-a0cc8d423253",
                                "sense_id": "7b2c4514-1a9c-356b-80d7-2d40d1121624",
                                "text": "Cette églogue virgilienne ainsi surprise au cœur mème du printemps s’interrompit à notre vue."
                            }
                        ]
                    }
                ],
