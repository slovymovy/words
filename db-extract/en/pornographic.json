                    {
                        "translation_id": "01fe5ea3-94f6-437a-9a6c-adc1dc08f1c7",
                        "source_entry_id": "b5cca059-ed83-3b48-b213-dfdea1ba9dfe",
                        "source_sense_id": "c5b37a86-e35f-361b-8a09-a49383a60a5a",
                        "source_sense_description": "containing an explicit depiction of sexual activity",
                        "target_lang_word": "pornographique",
