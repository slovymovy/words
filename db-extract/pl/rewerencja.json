                                    {
                                        "sense_id": "07cc062b-9e14-37b5-b26e-b14456b90054",
                                        "entry_id": "9dc799d2-dfdb-357c-8b1f-1e674df8ed8b",
                                        "glosses": [
                                            "Veneration; profound awe and respect, normally in a sacred context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "295705ce-068f-332c-ad5b-7af2100d036b",
                                        "entry_id": "9dc799d2-dfdb-357c-8b1f-1e674df8ed8b",
                                        "glosses": [
                                            "An act of showing respect, such as a bow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c3f490a-59df-4925-8313-6b9ad00e67ec",
                                                "sense_id": "295705ce-068f-332c-ad5b-7af2100d036b",
                                                "text": "August 2, 1758, Oliver Goldsmith, A Letter from a Traveller\nMake twenty reverences upon receiving […] about twopence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9b9c716-84c4-3733-a9a3-da13bb8dbb06",
                                        "entry_id": "9dc799d2-dfdb-357c-8b1f-1e674df8ed8b",
                                        "glosses": [
                                            "The state of being revered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c3c117-ca59-4fe7-9d03-7d50808a18d6",
                                                "sense_id": "b9b9c716-84c4-3733-a9a3-da13bb8dbb06",
                                                "text": "When discords, and quarrels, and factions, are carried openly and audaciously, it is a sign the reverence of government is lost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5862727-69f9-31fe-b50c-d90e14a5cc1e",
                                        "entry_id": "9dc799d2-dfdb-357c-8b1f-1e674df8ed8b",
                                        "glosses": [
                                            "A form of address for some members of the clergy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0aba87-eef8-445f-8cf4-589286486de6",
                                                "sense_id": "a5862727-69f9-31fe-b50c-d90e14a5cc1e",
                                                "text": "Your Reverence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55698cd9-eeb6-3c90-94fa-40b3557a7b73",
                                        "entry_id": "9dc799d2-dfdb-357c-8b1f-1e674df8ed8b",
                                        "glosses": [
                                            "That which deserves or exacts manifestations of reverence; reverend character; dignity; state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a352ab26-316e-491b-9d57-93904f6be3a8",
                                                "sense_id": "55698cd9-eeb6-3c90-94fa-40b3557a7b73",
                                                "text": "Thou hast so wrong'd mine innocent child and me\n That I am forced to lay my reverence by."
                                            }
                                        ]
                                    }
                                ]
                            },
