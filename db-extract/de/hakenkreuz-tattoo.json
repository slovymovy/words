                                "example_id": "da143655-622f-48a8-b5df-618fa6d80d2a",
                                "sense_id": "2a449825-2671-382b-b8ee-c331157f5290",
                                "text": "„LaManly hatte einen breiten Südstaatenakzent und ein Hakenkreuz-Tattoo an der Seite seines dicken Halses.“"
                            },
                            {
                                "example_id": "c8c5efcc-b60e-4986-9485-cfae6497e59f",
                                "sense_id": "2a449825-2671-382b-b8ee-c331157f5290",
                                "text": "„Am Farmtor zeigte ich den dort postierten Rednecks mit Hakenkreuz-Tattoos auf den Armen und Kalaschnikows über den Schultern meine Dienstmarke.“"
                            }
