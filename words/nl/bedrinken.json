                            },
                            {
                                "target_lang_word": "напоить",
                                "target_lang_sense_clarification": "допьяна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "086ef7bb-0a35-30be-b836-f1080816254e",
                    "sense_definition": "drinken op de gezondheid of ter ere van iemand of iets",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laten we het jonge paar <w>bedrinken</w> met een glas champagne.",
                            "target_lang_translations": {
                                "ru": "Давайте <w>выпьем за здоровье</w> молодой пары по бокалу шампанского."
                            }
                        },
                        {
                            "text": "Zij kwamen samen om de goede afloop van de reis te <w>bedrinken</w>.",
                            "target_lang_translations": {
                                "ru": "Они собрались вместе, чтобы <w>обмыть</w> благополучное завершение поездки."
                            }
                        }
                    ],
                    "traits": [
