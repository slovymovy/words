                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edu_uk_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>juniors</w> have their lunch break at noon, while the infants eat earlier.",
