                    }
                ],
                "senses": [
                    {
                        "sense_id": "295888f3-2701-3eb4-80e4-81fe1ec77db2",
                        "entry_id": "08bc08d8-be96-3484-9ad7-70c61fa7c9a3",
                        "glosses": [
                            "половина царства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfcae8a7-2d48-4c40-84aa-2a190574f613",
                                "sense_id": "295888f3-2701-3eb4-80e4-81fe1ec77db2",
                                "text": "И сказал царь Есфири при питье вина: какое желание твое? оно будет удовлетворено; и какая просьба твоя? хотя бы до полуцарства, она будет исполнена."
                            },
                            {
                                "example_id": "fdec13df-bb0c-494a-b5f0-33c9b7b5f6a1",
                                "sense_id": "295888f3-2701-3eb4-80e4-81fe1ec77db2",
                                "text": "— Полцарства за стакан чаю! — проговорила она глухим голосом, закрывая рот муфтой, чтобы не простудиться."
                            },
                            {
                                "example_id": "ad47a57d-ab93-4d4f-8290-68d7f834c950",
                                "sense_id": "295888f3-2701-3eb4-80e4-81fe1ec77db2",
                                "text": "Любые деньги предлагал, полцарства сулил, но не соглашался старик."
                            },
                            {
                                "example_id": "0115581b-cc27-470b-9388-1615983d273d",
                                "sense_id": "295888f3-2701-3eb4-80e4-81fe1ec77db2",
                                "text": "Полцарства сейчас бы отдал, чтобы в жаркую баню, на полок."
                            }
                        ]
                    }
                ],
