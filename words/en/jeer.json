            "senses": [
                {
                    "sense_id": "84e23316-eb45-3721-b417-fd0fd27ce0d6",
                    "sense_definition": "A rude and mocking remark intended to insult or show derision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician ignored the <w>jeer</w> from the back of the room and continued his speech.",
                            "target_lang_translations": {
                                "ru": "Политик проигнорировал <w>насмешку</w> из глубины зала и продолжил свою речь.",
                                "nl": "De politicus negeerde de <w>hoon</w> achter uit de zaal en zette zijn toespraak voort."
                            }
                        },
                        {
                            "text": "He responded to every <w>jeer</w> with a calm smile, refusing to be intimidated.",
                            "target_lang_translations": {
