                                ]
                            },
                            {
                                "target_word": "kokend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1743fa-c235-3d72-9c1b-82269587ab8c",
                                        "entry_id": "c06f672c-1ae7-3888-8de0-0fd58e832826",
                                        "glosses": [
                                            "van een vloeistof dat deze de temperatuur heeft van het kookpunt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bb55e12-bea6-4643-b185-fb3d78bab2bf",
                                                "sense_id": "7d1743fa-c235-3d72-9c1b-82269587ab8c",
                                                "text": "Als de oven op temperatuur is, zet je onderin de schaal met kokend water."
                                            },
                                            {
                                                "example_id": "a3e7e458-80d4-4a33-a687-c3345bced6a8",
                                                "sense_id": "7d1743fa-c235-3d72-9c1b-82269587ab8c",
                                                "text": "Als ze de stammen te veel verwarmden, zodat er kokend sap en hars naar buiten begon te dringen, werden de houtvezels te zacht en konden ze de bouten niet meer vastzetten, het was alsof je schroeven in een spons drukte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc1064c-c95f-3fb3-8f5e-7f6d6e41d656",
                                        "entry_id": "c06f672c-1ae7-3888-8de0-0fd58e832826",
                                        "glosses": [
                                            "voeding klaarmakend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f18c65e-6251-4281-a420-061234c59da1",
                                                "sense_id": "0dc1064c-c95f-3fb3-8f5e-7f6d6e41d656",
                                                "text": "Jet, de kokende en voedselvloggende dochter van DWDD-presentator Matthijs van Nieuwkerk, viert vandaag op haar aanrecht haar 29ste verjaardag."
                                            },
                                            {
                                                "example_id": "8c43dcf9-9885-4892-95e6-d92331a29749",
                                                "sense_id": "0dc1064c-c95f-3fb3-8f5e-7f6d6e41d656",
                                                "text": "Roman, een jongetje van twee jaar, is een hit op internet met kookvideo's die zijn moeder van hem maakt. Op sociale media reageren talloze kijkers ontroerd en vertederd op de video's van het Amerikaanse kokende knulletje, dat ze ‘zo schattig’ en ‘zo beleefd’ noemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa02a6d7-4fc8-3262-aef3-eb31440f48eb",
                                        "entry_id": "c06f672c-1ae7-3888-8de0-0fd58e832826",
                                        "glosses": [
                                            "zeer wild en woest"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98c112d7-0fc7-49f2-a2a3-13acf531b905",
                        "source_entry_id": "194961f6-1634-3245-84f2-f5b1f3be76a4",
