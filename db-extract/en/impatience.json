                "translations": [
                    {
                        "translation_id": "c934265f-4db5-4862-aec5-a6a977c5ba2a",
                        "source_entry_id": "b9c9f915-19e1-3b04-8cac-72315cc5fe0f",
                        "source_sense_id": "a6fdb84a-6d29-3c5f-9e6c-fc631a20f723",
                        "source_sense_description": "Ungeduld",
                        "target_lang_word": "Ungeduld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungeduld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                        "entry_id": "05c04a11-073a-3d5c-8d72-5e41dd8b8035",
                                        "glosses": [
                                            "Mangel an Ausdauer, auf etwas zu warten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab7880c-9b39-47ea-b0c4-c02d097158a9",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "Sie wartete mit großer Ungeduld, bis sie endlich an der Reihe war."
                                            },
                                            {
                                                "example_id": "bc5294fc-de1a-47fe-8796-ea3741adc69f",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Hagen versuchte seine Ungeduld zu verbergen.“"
                                            },
                                            {
                                                "example_id": "271392c5-791c-4e17-905d-8a7b834d00bd",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Er wandte sich ab und wartete mit Ungeduld auf die Rückkehr des Fürsten Andrej.“"
                                            },
                                            {
                                                "example_id": "d9c221cc-b896-4eb4-85f4-85e410d2ddcf",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Die Liebe wird nur in der Ungedult des Verlangens unvorsichtig; aber wenn es darum geht, die Wiederkehr eines Glücks zu betreiben, dem widrige Umstände Hindernisse in den Weg legen, wird die Liebe alles mit größtem Scharfsinn sehen und voraussehen.“"
                                            },
                                            {
                                                "example_id": "4d8f9d81-1e0f-4db9-aab2-fbd9c3fe7fc2",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Der Pflanzer hatte beide mit Ungeduld angehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b7b143-2005-4ec5-b036-acb2ac48f991",
                        "source_entry_id": "b9c9f915-19e1-3b04-8cac-72315cc5fe0f",
                        "source_sense_id": "d3deb5a1-4d20-3474-80a2-e2a1da9e2191",
                        "source_sense_description": "Abneigung",
                        "target_lang_word": "Abneigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abneigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                        "entry_id": "6bc95e84-9464-31ba-b609-95a693d2ee47",
                                        "glosses": [
                                            "leichter Widerwille gegen etwas oder eine Person, oft ohne das genau begründen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007e3645-b387-4017-8f48-a553e18fcbc3",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung der Polen gegen ihre Neureichen steht der der Westeuropäer in nichts nach.“"
                                            },
                                            {
                                                "example_id": "9e908d4a-da7f-44fc-92d3-6dc694654ec1",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "Ich hatte sofort eine Abneigung gegen den neuen Mitschüler, obwohl er mir angeboten hatte, mir bei den Hausaufgaben zu helfen."
                                            },
                                            {
                                                "example_id": "1e632a8c-d46a-4e41-93fd-f561aec769d6",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Daher waren Christenfeinde in der frühen Kaiserzeit weniger von Hass gegen die neue Lehre erfüllt; ihre Abneigung entsprang vielmehr ihrer affirmativen Haltung zum Imperium.“"
                                            },
                                            {
                                                "example_id": "ae6664e8-23bf-4e40-9bf1-6dfe833af7af",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Die Abneigung gegen alles Nützliche verdichtete sich von Tag zu Tag.“"
                                            },
                                            {
                                                "example_id": "2222c42d-22a3-4082-80dc-1e21e8fa2f1e",
                                                "sense_id": "8360a552-bd3b-3fcc-9028-208eb6f893a1",
                                                "text": "„Vom ersten Augenblick des Kennenlernens an faßte er gegen diesen glatten Hübschling Abneigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
