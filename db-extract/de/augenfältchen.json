                                "target_senses": [
                                    {
                                        "sense_id": "5adb5dd1-e995-3591-9dde-df8129446a9f",
                                        "entry_id": "6bfa8465-c0da-3a4d-aed0-8ab42daa8be9",
                                        "glosses": [
                                            "A small wrinkle in the corner of an eye, emblematic of aging."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40cbbb23-8ab6-471f-b325-ddc09ef6378c",
                                                "sense_id": "5adb5dd1-e995-3591-9dde-df8129446a9f",
                                                "text": "You must get a brown gown, and a white apron, and a mob cap, and we must make you a few wrinkles, and a little of the crowsfoot at the corner of your eyes, and you will be a very proper, little old woman."
                                            },
                                            {
                                                "example_id": "ba80b9a7-c703-492f-abbf-a3a632830669",
                                                "sense_id": "5adb5dd1-e995-3591-9dde-df8129446a9f",
                                                "text": "The Food and Drug Administration says it's an effective temporary treatment for crow's feet, the wrinkles that form next to aging eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137bb1cd-aaff-3eff-8ef9-431e116cd3cf",
                                        "entry_id": "6bfa8465-c0da-3a4d-aed0-8ab42daa8be9",
                                        "glosses": [
                                            "A triangular embroidery stitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bf5de65-fcd8-3726-af02-4a52495bc0e0",
                                        "entry_id": "6bfa8465-c0da-3a4d-aed0-8ab42daa8be9",
                                        "glosses": [
                                            "A symbol, resembling a bisected equilateral triangle, used in database diagrams to indicate plurality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b23b25f-2b2b-4458-a0de-9ca464a7e41e",
                                                "sense_id": "9bf5de65-fcd8-3726-af02-4a52495bc0e0",
                                                "text": "The crow's-foot notation similarly represents relationships."
                                            },
                                            {
                                                "example_id": "2242d1bd-eb55-417b-97d3-3da523ba9395",
                                                "sense_id": "9bf5de65-fcd8-3726-af02-4a52495bc0e0",
                                                "text": "Each crow's foot in your ER diagram indicates the need for a foreign key."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5874d75b-9e81-3d39-aef0-ecee7ae8f081",
                                        "entry_id": "6bfa8465-c0da-3a4d-aed0-8ab42daa8be9",
                                        "glosses": [
                                            "A number of lines rove through a long wooden block, supporting the backbone of an awning horizontally."
