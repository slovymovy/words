                                        "glosses": [
                                            "Pertaining to clay; made of, containing, or resembling clay; clayey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcea7f9-358b-4365-ba63-19241f813591",
                                                "sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                                                "text": "[…] natural colossi from two to five hundred feet high, done in argillaceous sandstone or a singular species of conglomerate, all of which owe their existence almost entirely to the agency of wind."
                                            },
                                            {
                                                "example_id": "0703ddd1-2feb-4d92-85ad-b140669f1b6b",
                                                "sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                                                "text": "The gleam of the land is in its rocks, the fine-grained argillaceous rocks, here, not purple or grey, but green of living stone."
                                            }
                                        ]
                                    }
