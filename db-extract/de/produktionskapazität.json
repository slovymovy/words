                "senses": [
                    {
                        "sense_id": "f51f8d01-9e4d-3e45-87a6-bce0067492f4",
                        "entry_id": "acae5a7c-2e48-35d1-b2c0-5236f25fb7c2",
                        "glosses": [
                            "Möglichkeit der Herstellung (einer bestimmten Menge eines Produktes von bestimmter Qualität in bestimmter Zeit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece5f56c-e65c-4c85-bc43-4da48a35c278",
                                "sense_id": "f51f8d01-9e4d-3e45-87a6-bce0067492f4",
                                "text": "Das Unternehmen will die Produktionskapazität in Deutschland kürzen und so auf die sinkende Nachfrage reagieren."
                            },
                            {
                                "example_id": "24906c9e-019b-4a0c-9fc8-20bac6fe918c",
                                "sense_id": "f51f8d01-9e4d-3e45-87a6-bce0067492f4",
                                "text": "Koreanische Werften sind besonders rezessionsanfällig, denn sie müssen enorme Produktionskapazitäten gewinnbringend auslasten."
                            },
                            {
                                "example_id": "9ac6f996-78a2-4d04-89da-d17c4d10deeb",
                                "sense_id": "f51f8d01-9e4d-3e45-87a6-bce0067492f4",
                                "text": "„Das Unternehmen rechnet mit einer Produktionskapazität von bis zu 750 Millionen Dosen pro Jahr.“"
                            },
                            {
                                "example_id": "155b55de-309a-44ec-8894-1be5ebdd67de",
                                "sense_id": "f51f8d01-9e4d-3e45-87a6-bce0067492f4",
                                "text": "„China kontrolliert weltweit rund 75 Prozent aller Produktionskapazitäten für Lithium-Ionen-Batterien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
