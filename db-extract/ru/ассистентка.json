                    {
                        "translation_id": "62855103-30b4-49aa-abe0-236eba180e50",
                        "source_entry_id": "336e2dc6-3580-38d3-8781-c2571f7317fe",
                        "source_sense_id": "1ad1b3cc-e9d2-3f2c-8f00-66880f02d76a",
                        "target_lang_word": "Assistentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Assistentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                        "entry_id": "34b87d67-8af0-3003-8e31-835e530ab6e0",
                                        "glosses": [
                                            "weibliche, meist akademisch vorgebildete Hilfskraft"
                                        ],
                                        "tags": [
                                            "Berufe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecb2af3-6500-4a26-8cfb-ab88bbde1d38",
                                                "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                                "text": "Dem Hochschulprofessor wurden zwei Assistentinnen zur Seite gestellt."
                                            },
                                            {
                                                "example_id": "fa947241-f2c2-4a2c-a0af-4a06e5728fb3",
                                                "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                                "text": "„Natürlich haut Dall vor allem Dall - und lädt beredt dazu ein. Warum er so viele hübsche Assistentinnen und Musikantinnen um sich versammle? Paar junge Pflanzen rund um den Komposthaufen sollten schon sein, und zu den Höhepunkten des Talks mit weiblichen Gästen zählt jedesmal deren schrille Zurückweisung seiner Avancen.“"
                                            },
                                            {
                                                "example_id": "39badfee-8354-44d0-97fa-ff9e0d5757ac",
                                                "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                                "text": "„Die Sidekicks in Gestalt von Georges Assistentin oder dem Portier von Mattys Apartmentgebäude werten viele Situationen komödiantisch auf.“"
                                            },
                                            {
                                                "example_id": "86d6453f-0d6d-430f-8eb0-3d7910fa7183",
                                                "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                                "text": "„Ihre Assistentin lässt am Flughafen Le Bourget einen Privatjet bereitstellen.“"
                                            },
                                            {
                                                "example_id": "1c351e20-f81e-433f-8d7f-a6030ce5dfd0",
                                                "sense_id": "3176af37-dbc4-302a-869b-52cf244e1a67",
                                                "text": "„Bereits um neun Uhr steht Thomas vor dem Schreibtisch der jungen Assistentin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
