                                                "sense_id": "a79132b4-0b12-3419-a50d-bfca65c63af0",
                                                "text": "Ve fakultní nemocnici je výborná neurologie."
                                            },
                                            {
                                                "example_id": "02250698-47b5-4857-955e-cc7f6f538c82",
                                                "sense_id": "a79132b4-0b12-3419-a50d-bfca65c63af0",
