                "senses": [
                    {
                        "sense_id": "d6ddeee4-de67-3044-bb23-a79364661d06",
                        "entry_id": "56bbb781-d20a-300e-b35d-8b8ebe73c639",
                        "glosses": [
                            "je heel erg afhankelijk voelen van de mening van anderen en geen eigen beslissingen durven nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10914a2-9c55-4398-b02d-133e9f3d96e3",
                                "sense_id": "d6ddeee4-de67-3044-bb23-a79364661d06",
                                "text": "Albert geloofde dat vrouwen niet gemaakt waren om te regeren en betuttelde haar: zij moest zich ‘verbeteren’, haar passionele karakter in toom houden en zo veel mogelijk op hem steunen. Florence Nightingale vond Victoria tijdens een privébezoek ‘de meest onzelfstandige vrouw’ die ze ooit gezien had."
                            }
                        ]
                    },
                    {
                        "sense_id": "e16f3497-6448-372a-a4ee-e7407d339394",
                        "entry_id": "56bbb781-d20a-300e-b35d-8b8ebe73c639",
                        "glosses": [
                            "niet in staat zijn om volledig voor jezelf te zorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd129784-c81a-46da-bbf8-42459f61bd38",
                                "sense_id": "e16f3497-6448-372a-a4ee-e7407d339394",
                                "text": "Volgens B en W past het plan in de nieuwe woonvisie 2017-2020. 'Daarin staat dat er ruimte is voor innovatieve woon- en zorgvormen', aldus het college. 'Daarbij wordt gedacht aan onzelfstandige wooneenheden met een gezamenlijke dagbesteding en zorg op maat. Ook echtparen, waarbij de partner de verzorging van de andere partner niet meer op kan brengen, kunnen hier worden gehuisvest'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a2c3dc-282e-469f-aa69-0ac87bbd0902",
                        "source_entry_id": "56bbb781-d20a-300e-b35d-8b8ebe73c639",
                        "source_sense_id": "d6ddeee4-de67-3044-bb23-a79364661d06",
                        "source_sense_description": "je heel erg afhankelijk voelen van de mening van anderen en geen eigen beslissingen durven nemen",
                        "target_lang_word": "dependent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dependent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d1571a-adae-3f52-8788-901dee4c685d",
                                        "entry_id": "644362a8-125f-3db4-b9db-a6879cac36c9",
                                        "glosses": [
                                            "Relying upon; depending upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02d75a16-3d54-41c6-9634-72ae3947858d",
                                                "sense_id": "d8d1571a-adae-3f52-8788-901dee4c685d",
                                                "text": "At that point I was dependent on financial aid for my tuition."
                                            },
                                            {
                                                "example_id": "2878c54d-a5be-48f7-848d-32a22824ba7f",
                                                "sense_id": "d8d1571a-adae-3f52-8788-901dee4c685d",
                                                "text": "It is time the international community faced the reality: we have an unmanageable, unfair, distortionary global tax regime. […] It is the starving of the public sector which has been pivotal in America no longer being the land of opportunity – with a child's life prospects more dependent on the income and education of its parents than in other advanced countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53fff749-462a-3c42-ad66-5bbe4319d877",
                                        "entry_id": "644362a8-125f-3db4-b9db-a6879cac36c9",
                                        "glosses": [
                                            "Having a probability that is affected by the outcome of a separate event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ec5a73-8948-4c69-b51a-beded631caf1",
                                                "sense_id": "53fff749-462a-3c42-ad66-5bbe4319d877",
                                                "text": "The formula for finding the probability of one event followed by a dependent event is written P(A, B) = P(A) × P(B/A) where P(B/A) is read “the probability of B given A.”"
                                            },
                                            {
                                                "example_id": "0c3d2c9d-54c2-41f5-9f14-59770283649e",
                                                "sense_id": "53fff749-462a-3c42-ad66-5bbe4319d877",
                                                "text": "Within the GMM framework, the distribution of returns conditional on the market return can be both serially dependent and conditionally heteroscedastic."
                                            },
                                            {
                                                "example_id": "ff958ffc-fee2-493d-b2ac-2b489e6f1ee3",
                                                "sense_id": "53fff749-462a-3c42-ad66-5bbe4319d877",
                                                "text": "Is it possible to find events A, B of Ω so that A and B are independent? The answer to this simple and interesting problem is no. A probability space (Ω,Σ,P) is called a “dependent probability space” if there are no nontrivial independent events in Ω, (Ω,Σ,P) is called an independent space otherwise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3826e26-9a37-3c3b-a773-d77a65595864",
                                        "entry_id": "644362a8-125f-3db4-b9db-a6879cac36c9",
                                        "glosses": [
                                            "Used after a particle (with one or two exceptions), such as those which express questions, subordinate clauses, and negative sentences."
                                        ],
                                        "tags": [
                                            "of Irish/Manx/Scottish (Gaelic) verb forms"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7caa6949-43b6-340f-8aa7-2d7b9a8b599b",
                                        "entry_id": "644362a8-125f-3db4-b9db-a6879cac36c9",
                                        "glosses": [
                                            "Of part of the body: positioned lower than the heart, like the legs while standing up, or the back while supine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73e708be-4421-442e-8dbf-a327b5dbead3",
                                                "sense_id": "7caa6949-43b6-340f-8aa7-2d7b9a8b599b",
                                                "text": "Several groups have shown that the gravitational distribution of pleural pressure is much more uniform when animals are in a prone rather than in a supine position, […] After volume-infusion-induced pulmonary oedema, Ppl was positive in the dependent lung regions in supine animals but much less positive in those in the prone position."
                                            },
                                            {
                                                "example_id": "d5eb58aa-0ea3-4cc6-a9e7-95a740d7c243",
                                                "sense_id": "7caa6949-43b6-340f-8aa7-2d7b9a8b599b",
                                                "text": "The limbs should not assume a dependent position and may be supported; for example, the upper arm and leg may be flexed and supported on pillows[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0245a0af-fbc1-3ab2-809c-4142a914a6c6",
                                        "entry_id": "644362a8-125f-3db4-b9db-a6879cac36c9",
                                        "glosses": [
                                            "Hanging down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694c491c-8f73-47cb-b11c-611cfc514c0d",
                                                "sense_id": "0245a0af-fbc1-3ab2-809c-4142a914a6c6",
                                                "text": "a dependent bough or leaf"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dependent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6e98900-1138-3c81-80b5-8cefaa60c8ea",
                                        "entry_id": "9530c1ca-4b64-37b8-81b4-9eaade76a119",
                                        "glosses": [
                                            "A person who relies on another for support or sustenance, particularly financial support."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a1004d-6af3-42ee-8a89-ef4994708131",
                                                "sense_id": "f6e98900-1138-3c81-80b5-8cefaa60c8ea",
                                                "text": "With two children and an ailing mother, she had three dependents in all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5adf53d1-75d9-3a78-b33f-3424531203e1",
                                        "entry_id": "9530c1ca-4b64-37b8-81b4-9eaade76a119",
                                        "glosses": [
                                            "An element in phrase or clause structure that is not the head. Includes complements, modifiers and determiners."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9375c826-ec03-3d4f-b8ce-0854125dd4bc",
                                        "entry_id": "9530c1ca-4b64-37b8-81b4-9eaade76a119",
                                        "glosses": [
                                            "The aorist subjunctive or subjunctive perfective: a form of a verb not used independently but preceded by a particle to form the negative or a tense form. Found in Greek and in the Gaelic languages."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d286ff4-0e26-3b67-a836-ec2eaa14f381",
                                        "entry_id": "9530c1ca-4b64-37b8-81b4-9eaade76a119",
                                        "glosses": [
                                            "dependent (origination), in Buddhism, the idea that the existence of everything is conditional and dependent on a cause, and that nothing happens fortuitously or by chance."
