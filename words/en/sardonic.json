            "senses": [
                {
                    "sense_id": "64e4db88-1c9d-3043-80ab-1dbcbb8b9da7",
                    "sense_definition": "Scornfully mocking or cynical",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He distances himself from people with his nasty <w>sardonic</w> laughter.",
                            "target_lang_translations": {
                                "nl": "Hij neemt afstand van mensen met zijn nare, <w>sardonische</w> lach."
                            }
                        },
                        {
                            "text": "Her <w>sardonic</w> remark about his sudden promotion made everyone at the table uncomfortable.",
                            "target_lang_translations": {
                                "nl": "Haar <w>sardonische</w> opmerking over zijn plotselinge promotie bezorgde iedereen aan tafel een ongemakkelijk gevoel."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneering",
                        "sarcastic"
                    ],
                    "common_phrases": [
                        "sardonic smile",
                        "sardonic grin",
                        "sardonic laughter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Spottend, bitter of cynisch van aard"
                    },
                    "translations": {
