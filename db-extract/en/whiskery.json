                    {
                        "sense_id": "a24962b6-28d2-359a-8a7f-eee799538a03",
                        "entry_id": "992a2673-f62d-3480-9d1e-a21982fb1ca4",
                        "glosses": [
                            "A whiskey distillery."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b3346a89-45b6-4e3c-b00d-e78b544b2493",
                                "sense_id": "a24962b6-28d2-359a-8a7f-eee799538a03",
                                "text": "[…]where the house of God was hidden by whiskeries, wineries, and breweries that were built against it."
                            },
                            {
                                "example_id": "244fe4e3-9397-4132-8e80-2ec4ab6fd92b",
                                "sense_id": "a24962b6-28d2-359a-8a7f-eee799538a03",
                                "text": "Even today, Devin’s story is told and retold in the local whiskeries and his critics secretly wish he would come swaggering back with another bombastic plan to enhance their wealth."
                            },
                            {
                                "example_id": "596de00e-88a4-49a4-b088-ee1c56ff3b45",
                                "sense_id": "a24962b6-28d2-359a-8a7f-eee799538a03",
                                "text": "Long synonomous^([sic]) with top-drawer talent, first-rate eateries, top-shelf whiskeries, Our Town has worn the crunchy fruit like a medal."
                            },
                            {
                                "example_id": "03ddf857-9964-4cf2-8799-572634cc715f",
                                "sense_id": "a24962b6-28d2-359a-8a7f-eee799538a03",
                                "text": "Honda still has the reputation of being overrun by whiskeries and brothels."
                            }
                        ]
                    }
                ],
