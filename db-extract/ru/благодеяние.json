                ],
                "senses": [
                    {
                        "sense_id": "675fc1c1-58f0-3f78-81f2-0575b564861d",
                        "entry_id": "cb409d32-0040-3d85-a4d4-c2248a975349",
                        "glosses": [
                            "доброе дело, услуга, помощь, покровительство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8205f2d5-687f-49cf-9a54-e46873434df7",
                                "sense_id": "675fc1c1-58f0-3f78-81f2-0575b564861d",
                                "text": "Увещевая Захара, он глубоко проникся в эту минуту сознанием благодеяний, оказанных им крестьянам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ca9ddf6-2cb1-4f71-b3da-a786348def10",
                        "source_entry_id": "cb409d32-0040-3d85-a4d4-c2248a975349",
                        "source_sense_id": "675fc1c1-58f0-3f78-81f2-0575b564861d",
                        "target_lang_word": "benefit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benefit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "An advantage; help or aid from something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e91a193f-0baa-416b-a6f0-a50246d8a5b3",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "For the trip over the grass-covered sleepers and between the cow-parsley and briars, an open wagon was added to the usual combination of locomotive and coach, for the benefit of those who wanted to take photographs."
                                            },
                                            {
                                                "example_id": "09ec4b97-5943-4cdc-81a9-5650247f8387",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "She can't read, so the voice recording was made for her benefit."
                                            },
                                            {
                                                "example_id": "2ad04023-f38b-424d-9190-56061dab347c",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "Exposure to cutting-edge technologies is one of the benefits of the job."
                                            },
                                            {
                                                "example_id": "5194d7aa-0b5f-4388-9e2b-14c08c3020fd",
                                                "sense_id": "858008d0-ca0a-39bb-af71-0840101c8517",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f10882f-09b1-33aa-9103-73d0e9ec4762",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "A payment made in accordance with an insurance policy or a public assistance scheme."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccd8618e-19b3-39c1-9e12-8643c7755d89",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "An event, such as a theatrical performance, given to raise funds for some cause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baa122c9-7f73-48bf-9b96-3daae8f89c12",
                                                "sense_id": "ccd8618e-19b3-39c1-9e12-8643c7755d89",
                                                "text": "Gore Vidal […] will be sharing his wit and wisdom at the Arlington Street Church on Wednesday, April 5th at 7:00. The appearance is a benefit for the Boston/Boise Committee and the tickets are priced at $5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc184fc-224b-3c8e-8307-b68f3216a827",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "beneficence; liberality"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0650f1e5-c287-463a-a03c-b110d4745b57",
                                                "sense_id": "fcc184fc-224b-3c8e-8307-b68f3216a827",
                                                "text": "The Birds, that liue i'th field / On the vvilde Benefit of nature, liue / Happier then vve; for they may chooſe their Mates, / And carroll their ſvveet pleaſures to the Spring: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                        "entry_id": "7f5d137d-6638-3719-a9d0-06ff8890afdd",
                                        "glosses": [
                                            "Intended audience (as for the benefit of)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754b1e02-1ffe-40a3-8660-c50506af9a4d",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "The whole scene was staged for his benefit, and it completely fooled him."
                                            },
                                            {
                                                "example_id": "b465affb-3c01-4fc0-b6d0-9fe3c587ef73",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "Since my wife is Canadian, whenever we have dinner with my family, they keep bringing up anything they've heard about Canada lately for her benefit."
                                            },
                                            {
                                                "example_id": "672ca6ca-9c22-41c1-95bc-e873936778c9",
                                                "sense_id": "0946c7e5-c340-34a8-8941-54195d38d74b",
                                                "text": "So, if Obodzinski is correct in saying that Mrs. Piela actually signed a document in the coffee shop, in front of witnesses, she staged a scene, pretending that it was the alleged Mandate. The other explanation is that none of this ever took place, and the staging was only a fictitious creation for the benefit of the Court."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "benefit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                        "entry_id": "c2637482-66f1-328a-b2de-ea7c3b15a2fa",
                                        "glosses": [
                                            "To be or to provide a benefit to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cac4c75-3618-4cd4-b6e1-a2f6475badb7",
                                                "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                                "text": "[…] I will repent of the good; wherewith I saide I would benefite them."
                                            },
                                            {
                                                "example_id": "f534a2a2-f742-40bf-8746-2039ab913da0",
                                                "sense_id": "a571d714-c29d-32b8-87a4-cdb48e2a20db",
                                                "text": "The spending in and around local stations is creating micro-economies that are benefiting Great Britain's high streets, independent businesses and economic growth, both locally and on a national level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                        "entry_id": "c2637482-66f1-328a-b2de-ea7c3b15a2fa",
                                        "glosses": [
                                            "To receive a benefit (from); to be a beneficiary."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f08014-2ca4-4f79-8746-f958dcd717b2",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Diesel maintenance schedules are benefiting from work done on the magnificent Hilger & Watts electronic spectrograph for oil analysis, which detects minute quantities of metals in samples of used lubricating oil; [...]."
                                            },
                                            {
                                                "example_id": "d97a7b64-c383-42ee-b7b8-31e4d332d5eb",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Although some apeirophobics have benefitted from treatments like medication and cognitive behavioral therapy, others have found no way to mitigate the existential terror."
                                            },
                                            {
                                                "example_id": "d397c8f9-2255-482c-a246-fa9d5087f257",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Instead, the grime of the steam years which still discoloured many of the best architectural features Betjeman loved has been cleared away, and several of the stations have benefited from major refurbishments which have greatly improved them."
                                            },
                                            {
                                                "example_id": "b59e23cf-a4e4-4453-ba3f-80e700c2b4f3",
                                                "sense_id": "63662f0d-828a-3241-a2a3-ec364fecdd6d",
                                                "text": "Although Katy has admitted to being bi-curious in the past, the reason a lot of fans wanted clarity on her sexuality was to ensure she wasn't queer-baiting and benefiting from a culture she isn't actually part of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e82bfc0-2f0f-47a6-8900-6e60275f164c",
                        "source_entry_id": "cb409d32-0040-3d85-a4d4-c2248a975349",
                        "source_sense_id": "675fc1c1-58f0-3f78-81f2-0575b564861d",
                        "target_lang_word": "boon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                        "entry_id": "5b063750-d290-3004-8e05-948c693301d7",
                                        "glosses": [
                                            "A good thing; a thing to be thankful for or to appreciate duly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c188b51-98a0-4431-a248-1f5ccf7476d7",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "Near-synonyms: gift; blessing, benefit; see also Thesaurus:gift"
                                            },
                                            {
                                                "example_id": "07f35e12-1ef8-4e1d-bc99-1f6db0a26c47",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "Finding the dry cave was a boon to the weary travellers."
                                            },
                                            {
                                                "example_id": "503e9d85-6626-4c70-aa37-b8957fc49787",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "Anaesthetics are a great boon to modern surgery."
                                            },
                                            {
                                                "example_id": "48e51b87-b445-4546-a62c-531f97199018",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. […] A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            },
                                            {
                                                "example_id": "96cdb1eb-d1c0-490a-9c85-424997515bc3",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "Supporters of the measure, which Parliament is expected to vote on next Monday, present it as a boon for democracy: a modest limit on the ways in which an elected government can be stymied by unelected judges, who will in any case still have other tools to overrule ministers."
                                            },
                                            {
                                                "example_id": "e68d2dae-10b6-4d0a-970e-91f885db579f",
                                                "sense_id": "5b1dcd3b-415e-3541-aa3e-b684a98c8aa5",
                                                "text": "President Joe Biden has declared - approvingly - that a “long war” is ahead between Israel and Hamas. Washington seems to relish long wars, which always prove a boon to its arms industries and a distraction from domestic troubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a333f119-f623-3f3b-8a4c-5dede0a5147b",
                                        "entry_id": "5b063750-d290-3004-8e05-948c693301d7",
                                        "glosses": [
                                            "That which is asked or granted as a benefit or favor; a gift or benefaction."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403b7d7f-3aa4-4b69-ac74-557ef7c4a2f4",
                                                "sense_id": "a333f119-f623-3f3b-8a4c-5dede0a5147b",
                                                "text": "I gave you life. Can you not return the boon by giving me death, my lord?"
                                            },
                                            {
                                                "example_id": "2bef8b88-8212-4724-bf0f-89cbe80c8290",
                                                "sense_id": "a333f119-f623-3f3b-8a4c-5dede0a5147b",
                                                "text": "Every good gift and every perfect boon is from above, coming down from the Father of lights, with whom can be no variation, neither shadow that is cast by turning."
                                            },
                                            {
                                                "example_id": "f6a81c45-9c63-49ba-afc8-ac032032fa76",
                                                "sense_id": "a333f119-f623-3f3b-8a4c-5dede0a5147b",
                                                "text": "[T]he hero comes back from this mysterious adventure with the power to bestow boons on his fellow man[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3597e10e-0aed-3751-8565-4b9dc045be3e",
                                        "entry_id": "5b063750-d290-3004-8e05-948c693301d7",
                                        "glosses": [
                                            "A prayer; petition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b2907cd-6045-4e07-a6c4-7a5947dbcb1e",
                                                "sense_id": "3597e10e-0aed-3751-8565-4b9dc045be3e",
                                                "text": "The wofull husbandman doth lowd complaine, / To ſee his whole yeares labor loſt ſo ſoone, / For which to God he made ſo many an idle boone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0744debe-81b6-3aea-9ecd-1cc49634e689",
                                        "entry_id": "5b063750-d290-3004-8e05-948c693301d7",
                                        "glosses": [
                                            "An unpaid service due by a tenant to his lord."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf7ca72b-e0dd-3077-9c2c-94239297f92c",
                                        "entry_id": "5b063750-d290-3004-8e05-948c693301d7",
                                        "glosses": [
                                            "A blessing, typically a supernatural power, granted to an ascetic by a god or goddess."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cbb24b-b5ab-4130-8dff-74b0c6e55f28",
                                                "sense_id": "bf7ca72b-e0dd-3077-9c2c-94239297f92c",
                                                "text": "A telling story is that of Vikra, who, after practicing severe tapas for many years, called on Śiva, asking him to grant the boon that whosoever's head he would touch, that person would die instantly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                        "entry_id": "df0cbdd3-20e3-3093-bf54-fa24c8b02ea0",
                                        "glosses": [
                                            "Gay; merry; jovial; convivial."
                                        ],
                                        "tags": [
                                            "in boon companion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b51e44a-0ccc-4284-b33a-c7f813c38b56",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "Greedily ſhe ingorg’d without restraint, / And knew not eating Death: Satiate at length, / And hight’nd as with Wine, jocond and boon, / Thus to herſelf ſhe pleaſingly began."
                                            },
                                            {
                                                "example_id": "661c0594-da9f-448c-ab30-f08f089d365d",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "I knovv the Infirmity of our Family; vve are apt to play the Boon-Companion, and throvv avvay our Money in our Cups: […]"
                                            },
                                            {
                                                "example_id": "f22752fb-864d-4bf1-a36e-bf1e6b6dd9d7",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "I’m a lonely old man; I lead a life that I don’t like, among boon companions, who make me melancholy."
                                            },
                                            {
                                                "example_id": "7c346137-0d37-476c-a98e-c2dee6baf8b3",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "―No, Mr Bloom repeated again, I wouldn’t personally repose much trust in that boon companion of yours who contributes the humorous element, Dr Mulligan, as a guide, philosopher, and friend, if I were in your shoes."
                                            },
                                            {
                                                "example_id": "0664ade0-a4f0-4b8c-a383-b4c39ea589ec",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "[T]he boon twins Art and Con aged thirty-seven years […]"
                                            },
                                            {
                                                "example_id": "c6310b69-c0fc-454f-bded-514833e17870",
                                                "sense_id": "a18c9047-6b4d-35dc-a651-b98724e5d113",
                                                "text": "(2) \"Everybody's boon companion, / Everybody's chaperon\"; (3) \"Everybody's boon companion: / Give[s] 'em everything he's got\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c608f25-9332-3d7e-9ecb-8f8612ac5552",
                                        "entry_id": "df0cbdd3-20e3-3093-bf54-fa24c8b02ea0",
                                        "glosses": [
                                            "Kind; bountiful; benign."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6893f1-6de7-44ea-b0f5-7f52e46dcfbd",
                                                "sense_id": "6c608f25-9332-3d7e-9ecb-8f8612ac5552",
                                                "text": "With mazie error under pendant ſhades / Ran Nectar, viſiting each plant, and fed /Flours worthy of Paradiſe which not nice Art / In Beds and curious Knots, but Nature boon / Powrd forth profuſe on Hill and Dale and Plaine, / […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1f17031-946f-3e5d-9865-20e2b8b3312f",
                                        "entry_id": "df0cbdd3-20e3-3093-bf54-fa24c8b02ea0",
                                        "glosses": [
                                            "Good; prosperous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d378175a-5435-4c36-a262-3506166d8827",
                                                "sense_id": "f1f17031-946f-3e5d-9865-20e2b8b3312f",
                                                "text": "boon voyage"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c21a25-5749-3b33-9b87-0d5701e2e76d",
                                        "entry_id": "d727aed6-9d26-3e48-aba3-4f05b96af2c9",
                                        "glosses": [
                                            "The woody portion of flax, separated from the fiber as refuse matter by retting, braking, and scutching."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
