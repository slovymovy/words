                        "examples": [
                            {
                                "example_id": "c16f1774-d96f-4d2f-9207-de5178940458",
                                "sense_id": "8be3f905-e271-3d71-bdbc-c44f8a216b50",
                                "text": "St. Hugh's immediate successor in the prioracy was Bovo, who at the Chartreuse had had a prophetic vision of him as a bishop."
                            },
                            {
                                "example_id": "e514f744-81a0-46f0-81e6-d32010dd16d1",
                                "sense_id": "8be3f905-e271-3d71-bdbc-c44f8a216b50",
                                "text": "Whenever a prior of that place should die, another prior, who should be appointed in succession from Marmoutier (de majori Monasteri) by the abbot of that place to the dignity of that prioracy, should come and dwell there ..."
                            },
                            {
                                "example_id": "7410afb2-eb8c-45e2-8b1b-7d79648014e6",
                                "sense_id": "8be3f905-e271-3d71-bdbc-c44f8a216b50",
                                "text": "... livestock and crop output between the beginning and end of Semeno's prioracy."
                            },
                            {
                                "example_id": "89187448-e637-4f29-965d-e7652283e5ef",
                                "sense_id": "8be3f905-e271-3d71-bdbc-c44f8a216b50",
                                "text": "... that he may be able to get himself a prioracy or abbacy, where he can first introduce a numerous retinue of his relatives."
                            }
                        ]
                    }
