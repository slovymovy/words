        "fr-extract.jsonl": [
            {
                "entry_id": "104a069f-1621-3c99-bec0-295ba9972163",
                "word": "pluviométrie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83a60a1d-981c-4f19-974e-8e152b1de7dc",
                        "entry_id": "104a069f-1621-3c99-bec0-295ba9972163",
                        "tags": [
                            "plural"
                        ],
                        "form": "pluviométries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07cc9f02-1481-3fa4-aad2-d35bde36ff93",
                        "entry_id": "104a069f-1621-3c99-bec0-295ba9972163",
                        "glosses": [
                            "Mesure de la pluviosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1791c5-fdb3-418c-8ace-e9e2531ea46c",
                                "sense_id": "07cc9f02-1481-3fa4-aad2-d35bde36ff93",
                                "text": "Pour mesurer les précipitations (pluie, neige, grésil, grêle), on utilise un pluviomètre placé \"hors éclaboussures\" et un pluviographe qui donne accès à la pluviométrie en continu."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7702e88-ca1b-36b4-a11d-79b4fbe02f6e",
                        "entry_id": "104a069f-1621-3c99-bec0-295ba9972163",
                        "glosses": [
                            "La pluviosité elle-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "83669228-eaf9-47cc-9d9f-5d198f715dcc",
                                "sense_id": "f7702e88-ca1b-36b4-a11d-79b4fbe02f6e",
                                "text": "Il me fallait, selon les jours, l’heure de déplacement et la pluviométrie, entre vingt et trente-cinq minutes pour me rendre sur mon lieu de travail où un parc de stationnement réservé au personnel m’évitait la fastidieuse et exaspérante recherche d’une place."
                            },
                            {
                                "example_id": "c3ebb44a-8440-4292-b3e0-a27f8c2e4bf4",
                                "sense_id": "f7702e88-ca1b-36b4-a11d-79b4fbe02f6e",
                                "text": "Une sécheresse sévère a persisté de février à septembre. Elle a été partiellement compensée par une pluviométrie importante en janvier puis d’octobre à décembre."
                            }
                        ]
                    }
                ],
