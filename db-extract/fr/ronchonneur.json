                "senses": [
                    {
                        "sense_id": "0f37143e-d41a-3179-a2af-757f1d5fdabb",
                        "entry_id": "d1f2954b-64ef-34c4-b5a6-2f3d55870126",
                        "glosses": [
                            "Qui ronchonne, ronchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67eae258-0155-4355-82a8-725992f6a84f",
                                "sense_id": "0f37143e-d41a-3179-a2af-757f1d5fdabb",
                                "text": "Son épouse devenait de plus en plus irascible et ronchonneuse, mais les nouvelles règles de vie, élaborées par Ivan Illitch dans le domaine familial, le protégeaient mieux qu’une cuirasse."
                            }
                        ]
                    }
                ],
