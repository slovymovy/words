                ],
                "senses": [
                    {
                        "sense_id": "95638388-6cad-302e-8363-b2c5a4eb1d7c",
                        "entry_id": "14333ec6-03db-3f84-a670-eeeeef6fd44a",
                        "glosses": [
                            "Entrouvrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79da371e-0fdd-4076-9eec-f26af69ccd7b",
                                "sense_id": "95638388-6cad-302e-8363-b2c5a4eb1d7c",
                                "text": "Cet Être suprême, un peu roide, reste toujours impersonnel, même lorsque le Consulat a déjà rentrouvert les églises."
                            },
                            {
                                "example_id": "0db4d91d-1e62-46b0-86a2-1d4d3b0fe8ec",
                                "sense_id": "95638388-6cad-302e-8363-b2c5a4eb1d7c",
                                "text": "Il fermait les yeux puis, les rentrouvrant, distinguait comme dans un rêve, en face de lui, sur le mur, une femme aux cheveux défaits, issue de la mer napolitaine et rapportant au fond des flots, avec une voluptueuse sensation de fraîcheur, un étincelant flacon de lotion philocapillaire."
                            },
                            {
                                "example_id": "61a60dae-c1b9-4170-9fff-3b0241fe92f3",
                                "sense_id": "95638388-6cad-302e-8363-b2c5a4eb1d7c",
                                "text": "La lame plantée au fond de moi a rentrouvert les portes de ce récent et douloureux passé."
                            }
                        ]
                    }
                ],
