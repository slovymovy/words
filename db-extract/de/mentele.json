                ],
                "senses": [
                    {
                        "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                        "entry_id": "8f5cfad5-71ed-303a-9b04-0677e274736b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833c1bfe-55ca-4849-8922-2e3124c8f46c",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Frau Mentele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cca78c72-7a3b-4078-8757-457e2e3cefbb",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Herr Mentele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b4315106-39f2-4e8a-aa6a-3aa678d1e6a4",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Die Menteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6dedf3c6-f391-4e34-88e9-177720439611",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Der Mentele trägt nie die Schals, die die Mentele ihm strickt."
                            },
                            {
                                "example_id": "d10444f4-a790-420c-999e-abbebf66c41a",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mentele kommt, geht der Herr Mentele.“"
                            },
                            {
                                "example_id": "495dfbcc-5100-4199-b4e6-9cebebb30208",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Mentele kommt und geht."
                            },
                            {
                                "example_id": "4ba8458d-9168-4a78-86e2-852cb01d965f",
                                "sense_id": "98514d81-1c7d-33c5-a4df-90ea0e59a2ec",
                                "text": "Menteles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
