                "senses": [
                    {
                        "sense_id": "10ee545d-6979-3152-84bd-ceb19cf68bc9",
                        "entry_id": "a97f2cb6-7ae8-3d4b-a19b-843ff3b6b3dd",
                        "glosses": [
                            "fein verästelter Fortsatz einer Nervenzelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9fa82a-290c-4ed5-a3d8-8bc639344930",
                                "sense_id": "10ee545d-6979-3152-84bd-ceb19cf68bc9",
                                "text": "Jede einzelne Nervenzelle besitzt tausende von Dendriten."
                            },
                            {
                                "example_id": "cddfd47d-e536-48a2-ab25-9dfaa3f96b6e",
                                "sense_id": "10ee545d-6979-3152-84bd-ceb19cf68bc9",
                                "text": "Dendriten stellen die Verbindung zu anderen Nervenzellen her und empfangen deren Signale."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08dd848c-0624-3f63-871a-341fa918bcd1",
                        "entry_id": "a97f2cb6-7ae8-3d4b-a19b-843ff3b6b3dd",
                        "glosses": [
                            "verästelte, moos-, strauch- oder baumförmige Kristallstrukturen"
                        ],
                        "tags": [
                            "Kristallographie"
                        ],
                        "examples": [
                            {
                                "example_id": "62ce35be-3e89-457c-87bc-261be4a2d013",
                                "sense_id": "08dd848c-0624-3f63-871a-341fa918bcd1",
                                "text": "Oftmals sind die feinen Strukturen der Dendriten auf dem Stein aus Manganablagerungen entstanden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e97e0b3-40ee-4004-913d-445a24c2a076",
                        "source_entry_id": "a97f2cb6-7ae8-3d4b-a19b-843ff3b6b3dd",
                        "source_sense_id": "10ee545d-6979-3152-84bd-ceb19cf68bc9",
                        "source_sense_description": "Anatomie: fein verästelter Fortsatz einer Nervenzelle",
                        "target_lang_word": "dendrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dendrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                                        "glosses": [
                                            "A slender projection of a nerve cell which conducts nerve impulses from a synapse to the body of the cell; a dendron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f930da93-00ad-4e94-9671-08e1b977997b",
                                                "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                                                "text": "Little copses of television antennas. Whiplike, graceful thrilling metal dendrites drawing images from the air, bringing brotherhood, communion to immured apartment people."
                                            },
                                            {
                                                "example_id": "7ec43a37-865f-46a6-ad27-8fc78d7e9a2e",
                                                "sense_id": "d3529d6b-dc78-399f-a4e2-6f2e5f87aaaf",
                                                "text": "A typical brain neuron has perhaps a thousand little wires, called dendrites, which connect it with its fellows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b066dc1d-4e9c-3b03-9f94-26a98ea19b4c",
                                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                                        "glosses": [
                                            "Slender cell process emanating from the cell bodies of dendritic cells and follicular dendritic cells of the immune system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8071f71-4fb4-3711-84f4-0c93c4fe6450",
                                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                                        "glosses": [
                                            "Tree-like structure of crystals growing as material crystallizes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e377487-b892-3fdb-b51f-4bdbf39c22b5",
                                        "entry_id": "5e3af935-99bc-364e-b774-3a7ebd1dc9a3",
                                        "glosses": [
                                            "A hermit who lived in a tree."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
