                {
                    "sense_id": "ba04ee8c-b855-3523-b009-bd12d8eeeb6e",
                    "sense_definition": "Jadalny owoc o twardej, zdrewniałej skorupie, rosnący na niektórych drzewach i krzewach.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nut_plant_wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci zbierały jesienią <w>orzechy</w> w parku.",
                            "target_lang_translations": {
                                "ru": "Осенью дети собирали <w>орехи</w> в парке.",
                                "en": "In autumn, the children were gathering <w>nuts</w> in the park."
                            }
                        },
                        {
                            "text": "Na święta babcia zawsze piecze ciasto z <w>orzechami</w> włoskimi.",
                            "target_lang_translations": {
