                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09bc9c61-977a-4397-8a77-438bc31ef564",
                                                "sense_id": "b4e97e58-f30a-36ca-a98b-6d4a9ca7f317",
                                                "text": "\"Chris?\" he repeated after her very softly, his eyes upon her, tenderly indulgent. \"Ah! let it be Christine. I may call you that?\"\n\"My actual name is Christina, but that's a detail. You can call me Christine if you like it best.\""
                                            }
                                        ]
                                    },
