                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b8c99b1-55f0-430a-b37c-f69ba9b0c138",
                        "source_entry_id": "96e21624-2c7e-3f95-aa37-da6557c629bb",
                        "source_sense_id": "e01f92df-8e5d-35d7-8821-93aa4d7ae85c",
                        "source_sense_description": "Wohneinrichtung für Frauen (sowie auch deren Kinder), die Gewalt in ihrer Ehe erlebt haben",
                        "target_lang_word": "refuge pour femmes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a09c8011-127c-4db2-b4f9-314f079829dd",
                        "source_entry_id": "96e21624-2c7e-3f95-aa37-da6557c629bb",
                        "source_sense_id": "e01f92df-8e5d-35d7-8821-93aa4d7ae85c",
                        "source_sense_description": "Wohneinrichtung für Frauen (sowie auch deren Kinder), die Gewalt in ihrer Ehe erlebt haben",
                        "target_lang_word": "blijf-van-mijn-lijfhuis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blijf-van-mijn-lijfhuis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f837429f-fe45-3b11-87e5-890d3e7f6204",
                                        "entry_id": "6380b8ab-4fc6-3fce-9998-6c0630423083",
                                        "glosses": [
                                            "opvanghuizen voor vrouwen, kinderen en tegenwoordig ook mannen die slachtoffer zijn van of bedreigd worden met huiselijk geweld, eergerelateerd geweld of om andere redenen in een knelsituatie menen te zitten"
                                        ],
                                        "tags": [
                                            "Nederland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5317cd24-d7f9-40cc-8d7b-23a2a30ad8eb",
                                                "sense_id": "f837429f-fe45-3b11-87e5-890d3e7f6204",
                                                "text": "Na uren mishandeling en bedreiging kan de vriendin ontkomen. Ze rent naar buiten, en belt vanuit een cafetaria 112. Haar vriend wordt „binnen tien minuten” gearresteerd, maar zijn hond wordt niet in beslag genomen. Tijdens het door hem georganiseerde evenement zit hij vast. Zijn vriendin wordt naar een Blijf-van-mijn-lijfhuis gebracht. Maar wat het werk van hulpverleners soms zo ingewikkeld maakt: de vrouw verbreekt de relatie met M. niet. Ze modderen nog enkele maanden door. Aan-uit, aan-uit, uit. „Liefde is niet van de ene op de andere dag over”, zegt de vrouw daarover. Ze vordert 2.000 euro immateriële schade van M. en nog wat geld voor kapotte kleding en ziekenhuiskosten."
                                            },
                                            {
                                                "example_id": "689d3ec4-a1fc-4b89-9943-f653592579a3",
                                                "sense_id": "f837429f-fe45-3b11-87e5-890d3e7f6204",
                                                "text": "Ze heeft een fijne jeugd gehad, maar „wel anders dan anderen” door de pijnlijke scheiding van haar ouders. „Laten we het er op houden dat mijn moeder een hele dappere vrouw is. Ze verliet mijn vader toen ik acht jaar was. Had geen baan, stond er alleen voor. Met z’n vijven woonden we in een blijf-van-mijn-lijfhuis.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
