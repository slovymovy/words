                    "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                    "sense_definition": "eine sehr kurze Zeitspanne",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Können Sie bitte einen <w>Augenblick</w> warten?",
                            "target_lang_translations": {
                                "en": "Could you please wait a <w>moment</w>?",
                                "ru": "Не могли бы вы подождать <w>минутку</w>?",
                                "nl": "Kunt u alstublieft een <w>ogenblik</w> wachten?",
                                "pl": "Czy może Pan poczekać <w>chwilę</w>?",
                                "fr": "Pourriez-vous attendre un <w>instant</w>, s'il vous plaît ?",
                                "it": "Può attendere un <w>momento</w>, per favore?",
                                "cs": "Můžete prosím <w>okamžik</w> počkat?",
                                "tr": "Lütfen bir <w>an</w> bekleyebilir misiniz?",
                                "es": "¿Podría esperar un <w>momento</w>, por favor?",
                                "zh": "请您稍等<w>片刻</w>好吗？"
                            }
                        },
                        {
                            "text": "Sie erreichte im letzten <w>Augenblick</w> noch ihren Zug.",
                            "target_lang_translations": {
                                "en": "She still managed to catch her train at the last <w>moment</w>.",
                                "ru": "Она в последний <w>момент</w> всё-таки успела на свой поезд.",
                                "nl": "Ze haalde op het laatste <w>ogenblik</w> nog net haar trein.",
                                "pl": "W ostatniej <w>chwili</w> zdążyła jeszcze na swój pociąg.",
                                "fr": "Elle a encore réussi à attraper son train au dernier <w>moment</w>.",
                                "it": "È riuscita a prendere il suo treno all'ultimo <w>momento</w>.",
                                "cs": "V posledním <w>okamžiku</w> ještě stihla svůj vlak.",
                                "tr": "Trenine son <w>anda</w> yetişebildi.",
                                "es": "Alcanzó su tren en el último <w>momento</w>.",
                                "zh": "她在最后<w>一刻</w>还是赶上了火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Moment"
                    ],
                    "antonyms": [
                        "Ewigkeit"
                    ],
                    "common_phrases": [
                        "im letzten Augenblick",
                        "in diesem Augenblick"
                    ],
