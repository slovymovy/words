                        "glosses": [
                            "Qui se rattache au stéréotype caractérisant le féminin ou la femme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "750a1125-c43a-4fde-8352-8a8a5a3bf17c",
                                "sense_id": "a39242a4-9421-3dcf-a22b-4542ce3ae6bb",
                                "text": "Les tribades, ainsi nommées frictrices, du Grec, je frotte, sont des femmes chez qui cette partie de la nature mulièbre, appelée le clitoris, atteint de telles proportions qu'elles peuvent s'en servir comme d'une mentule, soit pour enfiler, soit pour pédiquer."
                            }
                        ]
                    },
                    {
                        "sense_id": "27425d1c-0e16-3888-b345-d799144ba43c",
                        "entry_id": "aae631a7-9a37-3f96-b0c0-367e8330d0dd",
                        "glosses": [
                            "Féminin."
