                ],
                "senses": [
                    {
                        "sense_id": "d9e89870-ffa9-3f7d-a8e1-f06e8d925ac0",
                        "entry_id": "681eecfc-3136-3605-b53d-ea275bec22a6",
                        "glosses": [
                            "Se représenter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf810f9a-4c5e-46b5-ad70-c0d1c766e745",
                                "sense_id": "d9e89870-ffa9-3f7d-a8e1-f06e8d925ac0",
                                "text": "La poésie avait déjà pour habitude de s’autoreprésenter, mais la multiplication de ce thème dans la fiction est nouvelle."
                            },
                            {
                                "example_id": "01902de7-43b9-4224-8962-1d92e24801fb",
                                "sense_id": "d9e89870-ffa9-3f7d-a8e1-f06e8d925ac0",
                                "text": "pourtant, l’individualité continue souvent de s’autoreprésenter comme un îlot inaccessible aux flots de la technologie ou de la société technicisée."
                            },
                            {
                                "example_id": "0c8097b9-51a8-4fc6-a0d0-cce3faaffe8c",
                                "sense_id": "d9e89870-ffa9-3f7d-a8e1-f06e8d925ac0",
                                "text": "L'artiste de Sainte-Martine a choisi, en guise de première œuvre taillée dans le verre, de s'autoreprésenter."
                            }
                        ]
                    }
