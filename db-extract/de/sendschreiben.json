                "senses": [
                    {
                        "sense_id": "01e71c86-a89e-3664-a2b8-7d7d74e6d974",
                        "entry_id": "6f3fc371-f374-3082-b957-a37ddfd82812",
                        "glosses": [
                            "an einen größeren Personenkreis oder auch an die Öffentlichkeit gerichtetes Schreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea65f795-f820-456a-bed6-0eb233b4c07b",
                                "sense_id": "01e71c86-a89e-3664-a2b8-7d7d74e6d974",
                                "text": "Als die Sieben Sendschreiben werden sieben Briefe bezeichnet … um verschiedene frühchristliche Gemeinden zu ermutigen und zu ermahnen."
                            },
                            {
                                "example_id": "43643797-85a7-4fe2-89cc-335833c641d2",
                                "sense_id": "01e71c86-a89e-3664-a2b8-7d7d74e6d974",
                                "text": "In einem Sendschreiben an Politiker machte ein Anwohner, dem die Enteignung droht, auf seine Lage aufmerksam."
                            },
                            {
                                "example_id": "6d6f08bf-8c55-4e89-929a-5394e6e39f58",
                                "sense_id": "01e71c86-a89e-3664-a2b8-7d7d74e6d974",
                                "text": "Ohne auf die Formulierung zu achten, ging das Sendschreiben versehentlich auch an Literaturwissenschaftler."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
