                    {
                        "sense_id": "14854238-8c52-36a7-806e-a5d64f6c9cb1",
                        "entry_id": "151e8533-b4d2-35c5-acfd-4d4527f0b72d",
                        "glosses": [
                            "In bed, or on the bed; confined to bed."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0c8d744-3db8-4536-9365-4ba7c16337ab",
                                "sense_id": "14854238-8c52-36a7-806e-a5d64f6c9cb1",
                                "text": "Not to be abed after midnight"
                            },
                            {
                                "example_id": "87b1d416-05e8-49df-9189-a205c5ce6bf5",
                                "sense_id": "14854238-8c52-36a7-806e-a5d64f6c9cb1",
                                "text": "[She] is sick abed."
                            },
                            {
                                "example_id": "cd3e78f1-15cd-4915-b7cc-c0295a610f9b",
                                "sense_id": "14854238-8c52-36a7-806e-a5d64f6c9cb1",
                                "text": "The world was awake to the 2nd of May, but Mayfair is not the world, and even the menials of Mayfair lie long abed."
                            },
                            {
                                "example_id": "7b57cb7d-0206-4573-9088-276f3873b5fd",
                                "sense_id": "14854238-8c52-36a7-806e-a5d64f6c9cb1",
                                "text": "Who can lie peacefully abed, while the darkness holds some secret?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7108c1cc-59a4-30cf-b2e3-46e2d21d0bd0",
                        "entry_id": "151e8533-b4d2-35c5-acfd-4d4527f0b72d",
