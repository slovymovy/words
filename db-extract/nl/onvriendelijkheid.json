                "senses": [
                    {
                        "sense_id": "5dcb0ba7-b87a-3107-9511-acd562a6ca1c",
                        "entry_id": "e4e10449-af16-393e-82c0-b4775180efe4",
                        "glosses": [
                            "de mate waarin iemand onaardig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba36425b-8cb9-421e-be17-fc6b8886a107",
                                "sense_id": "5dcb0ba7-b87a-3107-9511-acd562a6ca1c",
                                "text": "En zijn onvriendelijkheid, zijn hardheid, zijn zwelgen in die zogenaamde rechtvaardigheid die alleen maar ellende voor anderen tot gevolg heeft, is een grotere zonde dan die welke Daisy op het kerkhof heeft begaan."
                            },
                            {
                                "example_id": "a4f1d4dd-4bbf-4d29-90b6-661da08c5c92",
                                "sense_id": "5dcb0ba7-b87a-3107-9511-acd562a6ca1c",
                                "text": "Bij de toenemende onvriendelijkheid binnen en buiten de lijnen eiste Gennaro Gattuso een bepalende rol op. De routinier, bij wie de wijsheid ondanks de jaren blijkbaar niet groeit, kreeg het met name aan de stok met assistent-trainer Joe Jordan van de Spurs. De Italiaan greep de Schot eerst naar zijn nek en even later deelde hij een kopstoot uit."
                            }
                        ]
