        "el-extract.jsonl": [
            {
                "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                "word": "seine",
                "pos": "pron",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "f775df62-b3e1-4ecf-a03d-71baeb44257a",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "tags": [],
                        "form": "seine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a58a00f7-d490-31b4-94d8-976c6345e261",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "του (μορφή του sein)",
                            "ονομαστική ενικού θηλυκού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a826e0-f235-4ed2-b6a3-00e1f41a9a5f",
                                "sense_id": "a58a00f7-d490-31b4-94d8-976c6345e261",
                                "text": "Seine Frau kommt gleich vorbei.\n Η γυναίκα του θα περάσει σε λίγο."
                            }
                        ]
                    },
                    {
                        "sense_id": "29d99a17-5003-3811-90fb-e6f0199153e3",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "του (μορφή του sein)",
                            "αιτιατική ενικού θηλυκού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74792108-b093-4daf-b69a-1914f944fefe",
                                "sense_id": "29d99a17-5003-3811-90fb-e6f0199153e3",
                                "text": "Ralf hat seine Tasche im Hotel vergessen.\n Ο Ραλφ ξέχασε την τσάντα του στο ξενοδοχείο."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa1dac95-f243-3961-ae58-30a90ad3bab1",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "του (μορφή του sein)",
                            "ονομαστική πληθυντικού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066cb266-2636-416d-93f4-e67c1b07902a",
                                "sense_id": "fa1dac95-f243-3961-ae58-30a90ad3bab1",
                                "text": "Warum weint Olaf? Seine Bauklötze sind umgefallen.\n Γιατί κλαίει ο Όλαφ; Τα τουβλάκια του έπεσαν."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c11d693-3165-34fb-8cac-c34194a70e1b",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "του (μορφή του sein)",
                            "αιτιατική πληθυντικού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4e6bf7-c10a-4702-9b3e-3a28ffcf8580",
                                "sense_id": "5c11d693-3165-34fb-8cac-c34194a70e1b",
                                "text": "Er bringt seine Kinder in den Kindergarten.\n Πηγαίνει τα παιδιά του στον παιδικό σταθμό."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aa29ffa-d0d2-3d6f-bd3b-2ea16aa62e41",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "δικός / δική / δικό / δικά του (μορφή του seiner)",
                            "ενικού θηλυκού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30161dd-ba80-4d65-9a63-50899812c37a",
                                "sense_id": "7aa29ffa-d0d2-3d6f-bd3b-2ea16aa62e41",
                                "text": "Die Hütte dort, ist das seine?\n Εκείνο το καλύβι, είναι δικό του;"
                            }
                        ]
                    },
                    {
                        "sense_id": "483c2388-be87-3497-a90c-45c23a93cb72",
                        "entry_id": "e56cc5be-8aba-36bb-b6aa-4cd1c7bf78ad",
                        "glosses": [
                            "δικός / δική / δικό / δικά του (μορφή του seiner)",
                            "πληθυντικού"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849a9ac7-0507-47a4-8262-c9f5c0b821ba",
                                "sense_id": "483c2388-be87-3497-a90c-45c23a93cb72",
                                "text": "Ich würde die Steine nicht berühren, das sind seine.\n Δεν θα άγγιζα τις πέτρες, είναι δικές του."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
