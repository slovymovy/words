            "senses": [
                {
                    "sense_id": "c771dd37-ec72-3e37-8018-ab6aaddd4fa1",
                    "sense_definition": "Comme on pouvait s'y attendre ; bien sûr, évidemment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu viendras <w>naturellement</w> avec nous pour fêter son anniversaire ce soir."
                        },
                        {
                            "text": "Elle a <w>naturellement</w> accepté l'invitation sans hésiter une seule seconde."
                        }
                    ],
                    "synonyms": [
                        "bien entendu",
                        "bien sûr",
                        "cela s'entend",
                        "évidemment"
                    ]
                },
                {
                    "sense_id": "fa19aadf-4b93-3b48-838f-e21d610a0b91",
                    "sense_definition": "En accord avec la nature ou produit spontanément par elle, sans intervention artificielle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_propriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante pousse <w>naturellement</w> le long des chemins et dans les forêts tempérées."
                        },
                        {
                            "text": "Certains animaux s'adaptent <w>naturellement</w> aux changements de saison dans leur habitat."
                        }
                    ],
                    "synonyms": [
                        "d'instinct"
                    ]
                },
                {
                    "sense_id": "0d592274-5f4c-3253-93df-5de57f067af3",
                    "sense_definition": "D'une manière simple et aisée, sans affectation ni contrainte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "simplicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'exprime très <w>naturellement</w> devant un public sans montrer de timidité."
                        },
                        {
                            "text": "Le comédien bougeait si <w>naturellement</w> sur scène que tout le monde croyait à son personnage."
                        }
                    ],
                    "synonyms": [
                        "sans façon",
                        "sans façons",
                        "simplement"
                    ]
                },
                {
                    "sense_id": "a520bad2-fa28-3695-bb8c-93c589792a04",
                    "sense_definition": "Par une suite logique ou prévisible d'événements ; inévitablement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le manque de sommeil conduit <w>naturellement</w> à une baisse de concentration pendant la journée."
                        },
                        {
                            "text": "Ce succès mérité a <w>naturellement</w> entraîné de nouvelles propositions d'emploi."
                        }
                    ],
                    "synonyms": [
                        "inévitablement"
                    ]
                },
                {
                    "sense_id": "ef9855e6-23e4-362e-9e92-0ff2219a1f4c",
                    "sense_definition": "En parlant avec franchise, en toute sincérité et sans déguisement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "franchise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dites-moi <w>naturellement</w> ce que vous pensez de cette proposition."
                        },
                        {
                            "text": "Il m'a répondu très <w>naturellement</w> sans chercher à cacher ses erreurs."
                        }
                    ],
                    "synonyms": [
                        "franchement"
                    ]
                }
            ]
        }
