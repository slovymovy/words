{
    "word_family": [
        "kaalheid",
        "kaalkop",
        "kaalslag"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c0abcce-91d4-3d03-b1d8-467a21b32216",
                    "sense_definition": "Verbogen vorm van <w>kaal</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buurman is een <w>kale</w> man die altijd een hoed draagt.",
                            "target_lang_translations": {
                                "en": "My neighbor is a <w>bald</w> man who always wears a hat.",
                                "ru": "Мой сосед — <w>лысый</w> мужчина, который всегда носит шляпу.",
                                "zh": "我的邻居是一个总戴着帽子的<w>秃顶</w>男人。"
                            }
                        },
                        {
                            "text": "Van een <w>kale</w> kip kun je niet plukken.",
                            "target_lang_translations": {
                                "en": "You cannot pluck a <w>bald</w> chicken.",
                                "ru": "С <w>голой</w> курицы перьев не нащиплешь.",
                                "zh": "从一只<w>光秃秃的</w>鸡身上拔不出毛来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kale kip",
                        "kale plek",
                        "kale vlakte"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inflection"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of 'kaal' (bald, bare).",
                        "ru": "Склоняемая форма прилагательного 'kaal' (лысый, голый).",
                        "zh": "形容词 kaal（秃的、光秃的、赤裸的）的屈折形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bald",
                                "target_lang_sense_clarification": "lacking hair"
                            },
                            {
                                "target_lang_word": "bare",
                                "target_lang_sense_clarification": "uncovered or empty"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лысый",
                                "target_lang_sense_clarification": "не имеющий волос"
                            },
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "непокрытый, пустой (о местности или предметах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秃的",
                                "target_lang_sense_clarification": "指没有头发或羽毛"
                            },
                            {
                                "target_lang_word": "光秃秃的",
                                "target_lang_sense_clarification": "指草木不生或没有覆盖物"
                            },
                            {
                                "target_lang_word": "光秃的",
                                "target_lang_sense_clarification": "形容树木没有叶子或地面没有植被"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36fde5d2-abc6-39c3-8303-e0585b964ef0",
                    "sense_definition": "Iemand die een kaal hoofd heeft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>kale</w> daar aan de bar is mijn oom.",
                            "target_lang_translations": {
                                "en": "That <w>baldy</w> over there at the bar is my uncle.",
                                "ru": "Тот <w>лысый</w> у барной стойки — мой дядя.",
                                "zh": "吧台那边的那个<w>光头</w>是我叔叔。"
                            }
                        },
                        {
                            "text": "De <w>kale</w> werd boos toen iemand een grap over zijn haar maakte.",
                            "target_lang_translations": {
                                "en": "The <w>baldy</w> got angry when someone made a joke about his hair.",
                                "ru": "<w>Лысый</w> разозлился, когда кто-то пошутил по поводу его волос.",
                                "zh": "有人拿他的头发开玩笑时，那个<w>秃子</w>生气了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kaalkop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person with a bald head.",
                        "ru": "Человек с лысой головой.",
                        "zh": "秃头的人（常带戏谑或口语色彩）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baldy",
                                "target_lang_sense_clarification": "informal, often derogatory"
                            },
                            {
                                "target_lang_word": "baldhead",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лысый",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            },
                            {
                                "target_lang_word": "лысак",
                                "target_lang_sense_clarification": "разговорное, иногда пренебрежительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秃子",
                                "target_lang_sense_clarification": "口语，指秃头的人"
                            },
                            {
                                "target_lang_word": "光头",
                                "target_lang_sense_clarification": "指光头或秃顶的人"
                            },
                            {
                                "target_lang_word": "秃头",
                                "target_lang_sense_clarification": "指秃头的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d55c67bc-6f86-38d5-85d0-356c6ca9edff",
                    "sense_definition": "Aanvoegende wijs van <w>kalen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men hoopte dat het dier niet verder <w>kale</w> door de ziekte.",
                            "target_lang_translations": {
                                "en": "One hoped that the animal would not <w>lose hair</w> further due to the disease.",
                                "ru": "Надеялись, что животное не будет дальше <w>лысеть</w> из-за болезни.",
                                "zh": "人们希望这只动物不会因疾病而继续<w>脱毛</w>。"
                            }
                        },
                        {
                            "text": "Moge de oude boom niet volledig <w>kale</w> in de winter.",
                            "target_lang_translations": {
                                "en": "May the old tree not completely <w>become bare</w> in the winter.",
                                "ru": "Пусть старое дерево не <w>оголится</w> полностью зимой.",
                                "zh": "愿这棵老树在冬天不会彻底<w>变光秃</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "subjunctive"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Subjunctive form of 'kalen' (to become bald or bare).",
                        "ru": "Сослагательное наклонение глагола 'kalen' (лысеть, оголяться).",
                        "zh": "动词 kalen（变秃、脱落、变光秃）的虚拟语气形式（古旧）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become bald",
                                "target_lang_sense_clarification": "to lose hair"
                            },
                            {
                                "target_lang_word": "become bare",
                                "target_lang_sense_clarification": "to lose leaves or covering"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лысеть",
                                "target_lang_sense_clarification": "терять волосы"
                            },
                            {
                                "target_lang_word": "оголяться",
                                "target_lang_sense_clarification": "терять листву или покрытие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变秃",
                                "target_lang_sense_clarification": "脱发或脱落毛发"
                            },
                            {
                                "target_lang_word": "变光秃",
                                "target_lang_sense_clarification": "落叶或脱去覆盖物"
                            },
                            {
                                "target_lang_word": "脱毛",
                                "target_lang_sense_clarification": "动物掉毛"
                            }
                        ]
                    }
                }
            ]
        }
    ]
