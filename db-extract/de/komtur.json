                "senses": [
                    {
                        "sense_id": "c4a25c8d-b537-34f7-a049-9b914d8daa13",
                        "entry_id": "021e8bca-c3c5-365b-b567-d1f4abc4f20c",
                        "glosses": [
                            "der Leiter einer Komturei oder Ballei der Ordensritter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ba73c7-adf1-4c1b-9e3d-ce9f410e9e3d",
                                "sense_id": "c4a25c8d-b537-34f7-a049-9b914d8daa13",
                                "text": "Dem Komtur unterstanden die Güter der Kommende oder Komturei."
                            },
                            {
                                "example_id": "939bd80f-8530-42d2-9971-0e1e6f498241",
                                "sense_id": "c4a25c8d-b537-34f7-a049-9b914d8daa13",
                                "text": "„Neben der Leitern der Provinzen Aquitanien und Normandie traten auch die Komture einzelner Häuser in Erscheinung.“"
                            },
                            {
                                "example_id": "4a76c4b3-9cd2-4ade-bbb0-a842c3ea66af",
                                "sense_id": "c4a25c8d-b537-34f7-a049-9b914d8daa13",
                                "text": "„Um ein Uhr kam ein edler Venetianer, Herr Farsetti, Komtur des Malteserordens, ein Gelehrter, der im Wahne der abstrakten Wissenschaften befangen war und ziemlich gute lateinische Verse schrieb.“"
                            }
                        ],
