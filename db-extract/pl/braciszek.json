                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "44bf318b-48c5-4e01-9f2e-37b9649df981",
                                "sense_id": "42161a4f-f1ba-3c61-96a5-b5a402a8d67f",
                                "text": "Ubodzy podziękowali braciszkowi, który ich obdarował talerzem zupy i pajdą chleba."
