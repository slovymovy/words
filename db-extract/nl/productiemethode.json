                "senses": [
                    {
                        "sense_id": "bef07dc0-6de2-3f1d-acd5-02316d1e458a",
                        "entry_id": "08c40701-d211-3781-9aa4-b37c8e627be3",
                        "glosses": [
                            "de manier waarop men dingen maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89659cd7-7256-4da6-94b7-32ebadceea72",
                                "sense_id": "bef07dc0-6de2-3f1d-acd5-02316d1e458a",
                                "text": "Maar de producent heeft nu een nieuwe productiemethode aangekondigd: met vacuüminjectie. Zo worden snelle zeiljachten ook gebouwd, maar in de caravanwereld is de methode niet minder dan een revolutie."
                            },
                            {
                                "example_id": "62aadcae-2ece-4c21-ac2f-fedf03676195",
                                "sense_id": "bef07dc0-6de2-3f1d-acd5-02316d1e458a",
                                "text": "Volgens de politie betekent de toegenomen hoeveelheid drugsafval niet dat er meer drugslaboratoria zijn gekomen. De politie denkt dat de drugscriminelen zijn overgestapt op een andere productiemethode die meer afval veroorzaakt."
                            },
                            {
                                "example_id": "8e7f2ad4-59c1-4f5a-b55d-569c7f7cdf35",
                                "sense_id": "bef07dc0-6de2-3f1d-acd5-02316d1e458a",
                                "text": "De productiemethode is toepasbaar voor textiel, maar ook voor materialen als glas, keramiek, metaal, papier en hout. Van bedrijven uit die sectoren bestaat veel belangstelling. Daardoor kan rond deze technologie een nieuwe maakindustrie in Twente ontstaan, aldus De Vries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc56d791-7dbf-41fa-840f-be579261b669",
                        "source_entry_id": "08c40701-d211-3781-9aa4-b37c8e627be3",
                        "source_sense_id": "bef07dc0-6de2-3f1d-acd5-02316d1e458a",
                        "target_lang_word": "mode of production",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mode of production",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0ce317-f550-3d21-8fa5-ca84e3d577cb",
                                        "entry_id": "7b74e3df-0720-308d-a302-d429be3abd73",
                                        "glosses": [
                                            "A combination of productive forces such as labour power and means of production, and social and technical relations of production such as property, power, laws and regulations, etc."
                                        ],
                                        "tags": [
                                            "Marxism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9326577b-191c-40f3-84eb-27748e223f16",
                                                "sense_id": "eb0ce317-f550-3d21-8fa5-ca84e3d577cb",
                                                "text": "But once you understand what a “mode of production” is the meaning becomes clear. What you are watching is the collapse of feudalism and the emergence of early capitalism."
                                            },
                                            {
                                                "example_id": "857cbad3-abf1-498d-ab71-fa8763e2aa31",
                                                "sense_id": "eb0ce317-f550-3d21-8fa5-ca84e3d577cb",
                                                "text": "The wealth of those societies in which the capitalist mode of production prevails, presents itself as “an immense accumulation of commodities,” its unit being a single commodity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
