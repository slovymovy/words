                "senses": [
                    {
                        "sense_id": "d05b27fd-bc25-33d1-a202-15f370f766d3",
                        "entry_id": "cc6da607-3f6c-3dd9-aff8-175e4e5010bc",
                        "glosses": [
                            "устар., разг. завиться, сделать кудри, кудряшки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020ff807-afb9-43c9-953a-fecc5b78ffa4",
                                "sense_id": "d05b27fd-bc25-33d1-a202-15f370f766d3",
                                "text": "― А ты накали на свечке старые ножницы да и закудрявься ими!"
                            }
                        ]
                    },
                    {
                        "sense_id": "3478b577-e43d-396c-aa6a-c414147e054e",
                        "entry_id": "cc6da607-3f6c-3dd9-aff8-175e4e5010bc",
                        "glosses": [
                            "начать кудрявиться; стать кудрявым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead45903-5067-4c63-a769-ebc21b955142",
                                "sense_id": "3478b577-e43d-396c-aa6a-c414147e054e",
                                "text": "Закудрявились гребни волн белой пеною, словно сама матушка седою головой покачала: ― Пусть не плачет, не горюет вихрастая."
                            },
                            {
                                "example_id": "69b9889d-c608-4b96-b8da-15b2246ff03d",
                                "sense_id": "3478b577-e43d-396c-aa6a-c414147e054e",
                                "text": "Подстриг садик, и он закудрявился, зазеленел весь, и от этого радостно."
                            }
                        ]
                    }
                ],
