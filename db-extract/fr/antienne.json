                    },
                    {
                        "translation_id": "314dc2b0-a512-4834-adad-8e6a641e8910",
                        "source_entry_id": "a875cdbf-8326-30a7-b32a-d4efd0ef4426",
                        "source_sense_id": "c9d52adc-c4a6-3306-9f07-40880fa5709b",
                        "source_sense_description": "(Liturgie catholique) Sorte de verset que le prêtre ou le chantre dit et qui se répète après tout entier",
                        "target_lang_word": "антифон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антифон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1b64b79b-df83-3799-9a08-e05078b70a68",
                                        "entry_id": "c026b4f4-0627-346d-8654-54cb5ad82069",
                                        "glosses": [
                                            "церк. песнопение или стихи из псалма, которые поются попеременно, двумя хорами или клиросами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7887fb-dca0-491c-b122-74587fad77d4",
                                                "sense_id": "1b64b79b-df83-3799-9a08-e05078b70a68",
                                                "text": "Антифоны ― противугласники, песни, выбранные из псалмов, пророчески изобразующие пришествие в мир Сына Божия, ― поются попеременно обоими ликами на обоих крылосах; они заменили сокращенно прежние псаломские, более продолжительные."
                                            },
                                            {
                                                "example_id": "9982dfaa-2409-48db-9f14-f4d698b16c3a",
                                                "sense_id": "1b64b79b-df83-3799-9a08-e05078b70a68",
                                                "text": "Каждый антифон (кроме антифона 8-го гласа) состоит из трех разделов, содержащих в свою очередь по три тропаря, последний из которых посвящен славословию Святого Духа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1306ebf2-0cb8-446b-b4de-85938bfb60ae",
                        "source_entry_id": "a875cdbf-8326-30a7-b32a-d4efd0ef4426",
                        "source_sense_id": "c9d52adc-c4a6-3306-9f07-40880fa5709b",
                        "source_sense_description": "(Liturgie catholique) Sorte de verset que le prêtre ou le chantre dit et qui se répète après tout entier",
                        "target_lang_word": "antifona",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1fb152ea-4d33-486b-9eb8-23e62a7b281f",
                        "source_entry_id": "a875cdbf-8326-30a7-b32a-d4efd0ef4426",
                        "source_sense_id": "9ff9db9b-4850-3bdb-bf7d-fba599c067ee",
                        "source_sense_description": "(Sens figuré) (Familier) Propos que l’on répète sans cesse, refrain",
                        "target_lang_word": "Litanei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Litanei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81c3b1e1-0d48-3e22-81f4-77441216aa73",
                                        "entry_id": "5cf11548-e435-3018-a9bf-35ce5a973011",
                                        "glosses": [
                                            "eine Form gemeinschaftlichen Betens, bei der ein Vorbeter oder Vorsänger Anrufungen Gottes oder der Heiligen vorträgt; diese Anrufungen werden von der Gemeinde mit einem gleichbleibenden Ruf (beispielsweise „Erbarme dich unser!“ oder „Bitte für uns!“) beantwortet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d2e588-5587-4dd4-b8ce-488278645e96",
                                                "sense_id": "81c3b1e1-0d48-3e22-81f4-77441216aa73",
                                                "text": "Von Papst Clemens VIII., der 1601 die Verwendung von Litaneien in der Liturgie stark beschränkte, wurde die Lauretanische Litanei neben der Allerheiligenlitanei ausdrücklich für den gottesdienstlichen Gebrauch zugelassen."
                                            },
                                            {
                                                "example_id": "155b19b1-518b-499c-a31d-27dc24ef2968",
                                                "sense_id": "81c3b1e1-0d48-3e22-81f4-77441216aa73",
                                                "text": "„Um mich heil ins Tageslicht zu geleiten, brauchte es jetzt Bannsprüche und Beschwörungsformeln, Gebetsmühlen, Rosenkränze und Litaneien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d08c687f-7274-3b80-b199-d1533c3b7d52",
                                        "entry_id": "5cf11548-e435-3018-a9bf-35ce5a973011",
                                        "glosses": [
                                            "eine immer wieder vorgebrachte Klage, Ermahnung oder Forderung"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d32f89-cac7-492e-ae5a-87e8fae0a77e",
                                                "sense_id": "d08c687f-7274-3b80-b199-d1533c3b7d52",
                                                "text": "Kannst du nicht endlich diese Litanei einstellen?"
                                            },
                                            {
                                                "example_id": "d3e28270-3f68-4bfc-a27e-7f8fc4dc3656",
                                                "sense_id": "d08c687f-7274-3b80-b199-d1533c3b7d52",
                                                "text": "„Die Litanei der Anschuldigungen ist uns inzwischen vertraut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a30e01ee-0127-33a7-ab4a-4957863aad63",
                                        "entry_id": "5cf11548-e435-3018-a9bf-35ce5a973011",
                                        "glosses": [
                                            "ein lange, monotone Aufzählung von Dingen oder Zusammenhängen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84043112-1061-44c3-8132-3e7c392e5391",
                                                "sense_id": "a30e01ee-0127-33a7-ab4a-4957863aad63",
                                                "text": "So klingen die Sätze des neuen Außenministers Guido Westerwelle ein bisschen wie die Litanei, die man schon von seinen Vorgängern kannte."
                                            },
                                            {
                                                "example_id": "cb2cf2cd-0505-4dc6-a474-15e6bb509a34",
                                                "sense_id": "a30e01ee-0127-33a7-ab4a-4957863aad63",
                                                "text": "Was folgte, war eine Litanei von Lobreden auf den \"Meister\", die jeden, der Saddams Irak noch kannte, wie ein Déjà vu ereilte: vorn der Chef, links und rechts Reihen von Unterlingen, die dankbar und pflichtschuldig jedes Wort mitschrieben, das er in seiner Huld von sich gab."
                                            },
                                            {
                                                "example_id": "ae96e111-12b8-4eb8-9030-f1353fb6b4d9",
                                                "sense_id": "a30e01ee-0127-33a7-ab4a-4957863aad63",
                                                "text": "„Staszek sagte auf Französisch, wir würden wahrscheinlich nichts anderes von ihm zu hören bekommen, als die Litanei vom Suff, er kenne diese Leute.“"
                                            },
                                            {
                                                "example_id": "e81bf72e-c1bb-4859-92d5-c5ab103008f3",
                                                "sense_id": "a30e01ee-0127-33a7-ab4a-4957863aad63",
                                                "text": "„Jeder Berliner kann die Litanei herunterbeten: ewige Schulmisere – immer weniger Kinder lernen lesen, schreiben und rechnen –, dramatischer Wohnungsmangel, eine irrlichternde Verkehrspolitik, akuter Personalmangel bei Polizei, Justiz, Feuerwehr und Krankenversorgung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
