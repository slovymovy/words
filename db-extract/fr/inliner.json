                ],
                "senses": [
                    {
                        "sense_id": "27b22ea1-5f0e-3d33-a121-0651a58e3283",
                        "entry_id": "846b07ac-274d-3b52-8cb9-02fe45cdc3cb",
                        "glosses": [
                            "Optimiser un programme en utilisant l’extension inline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "681c002b-e617-46f8-b5b5-57997ab2cec7",
                                "sense_id": "27b22ea1-5f0e-3d33-a121-0651a58e3283",
                                "text": "Le mot-clé inline permet d'indiquer notre souhait au compilateur d’inliner la fonction min dans la fonction appelée : cela signifie que le corps de la fonction est intégrée sans avoir à réaliser un coûteux appel de fonction (qui nécessite d’initialiser une stack frame dans la pile d’appel, de sauter vers l’instruction de début de fonction…)."
                            },
                            {
                                "example_id": "f329bb63-3b97-49b6-a9a2-86ca6521a752",
                                "sense_id": "27b22ea1-5f0e-3d33-a121-0651a58e3283",
                                "text": "A titre personnel, je n’inline moi-même que les accesseurs sur les membres privés et autres fonctions qui ne font vraiment qu’une ou deux instructions…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f71d0f84-0b04-4f57-b73b-6844ae331196",
                        "source_entry_id": "846b07ac-274d-3b52-8cb9-02fe45cdc3cb",
                        "source_sense_id": "27b22ea1-5f0e-3d33-a121-0651a58e3283",
                        "target_lang_word": "inline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "833b518b-70e8-3d87-858d-e73267345960",
                                        "entry_id": "952ae010-d20e-3fe4-9993-be509575a465",
                                        "glosses": [
                                            "An element that occurs within the flow of the text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efa2153-f1e0-4067-8c8a-01e5f7220cae",
                                                "sense_id": "833b518b-70e8-3d87-858d-e73267345960",
                                                "text": "Bold and italic tags are inline elements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d472cca1-c3b8-3b1f-b69a-56d2e516c61d",
                                        "entry_id": "1cdef9f7-a1e5-36e1-aaa8-2080a52acc8e",
                                        "glosses": [
                                            "Alternative spelling of in-line."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "inline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe415ace-6974-35f8-b555-33c59a367321",
                                        "entry_id": "8e3dc4bb-6f15-3120-89a9-ab87a5c69b2c",
                                        "glosses": [
                                            "To optimize using in-line expansion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eca6436-6f6d-49d8-8746-6dfa6166f583",
                                                "sense_id": "fe415ace-6974-35f8-b555-33c59a367321",
                                                "text": "Some compilers will allow statics to be inlined, but then incorrectly create multiple instances of the inlined variable at run-time."
                                            },
                                            {
                                                "example_id": "381150dd-2bba-4f33-93bb-4893c7230d5d",
                                                "sense_id": "fe415ace-6974-35f8-b555-33c59a367321",
                                                "text": "Because functions that contain references to this cannot be inlined, the Compiler's ability to devirtualize prototype methods is even more important in terms of reducing the size of compiled code. By devirtualizing methods and removing references to this, more methods become functions that are candidates for inlining."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
