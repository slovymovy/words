                                                "text": "Cet homme est futé."
                                            },
                                            {
                                                "example_id": "47f707b4-c140-4c03-b518-49436ac98479",
                                                "sense_id": "37e3d18f-c14e-373b-b1ba-8e2f106ce4a8",
                                                "text": "Elle est bien futée."
                                            },
