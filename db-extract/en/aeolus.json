                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Éole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                                        "entry_id": "ca4fca21-1f46-3024-857a-0a5310e70a88",
                                        "glosses": [
                                            "Maître et régisseur des vents dans la mythologie grecque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03df584e-599b-4ddb-99ee-7719fbd55379",
                                                "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                                                "text": "Dans une vaste caverne, Éole tient enchaînés et emprisonnés les vents, qui s’efforcent de fuir, ainsi que les tempêtes bruyantes."
                                            },
                                            {
                                                "example_id": "97e6de85-bc60-4847-8930-18c8ee858cc2",
                                                "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                                                "text": "Aussi Rodolphe s’emporta en imprécations furibondes contre Éole et toute sa famille le brise-tout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Éole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcc8ab98-da09-3062-b144-353d4ab3b1a4",
                                        "entry_id": "aca36fe9-17ee-3f07-b7a7-3a4d3aed2f6c",
                                        "glosses": [
                                            "Meuble représentant un visage soufflant dans les armoiries. À rapprocher de aquilon et borée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd3e796-0b30-4ed9-9dc1-1eec73ad4874",
                                                "sense_id": "bcc8ab98-da09-3062-b144-353d4ab3b1a4",
                                                "text": "Parti : au 1ᵉʳ d’argent à la feuille de frêne de sinople posée en pal, au 2ᵉ de gueules à la tête de loup arrachée d’or soutenue d’une tête d’Éole soufflant du même ; au mont de sinople mouvant de la pointe et brochant sur le tout, qui est de la commune de Fresne-au-Mont de la Meuse"
                                            },
                                            {
                                                "example_id": "873ceeeb-fa9b-43c0-9395-3b9cf146cedf",
                                                "sense_id": "bcc8ab98-da09-3062-b144-353d4ab3b1a4",
                                                "text": "Son cadet, couché sur le ventre, posa son menton sur ses bras croisés. Il clignait par mépris et gonflait sa bouche, qu’il avait ronde et renflée comme les petits Éoles des vieilles cartes marines…"
                                            }
                                        ]
                                    }
                                ]
                            },
