                "senses": [
                    {
                        "sense_id": "ffbea821-f38c-3dd0-bcef-8bb7e8b43d28",
                        "entry_id": "e5471ae5-8748-3e5b-b1a5-6ae00a34e3f1",
                        "glosses": [
                            "Rendre plus pimpant."
                        ],
