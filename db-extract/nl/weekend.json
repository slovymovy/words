                "senses": [
                    {
                        "sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
                        "entry_id": "c9cc3ae7-3ad1-38e0-a996-a6ee018e7471",
                        "glosses": [
                            "periode van vrijdagavond tot en met zondagnacht"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "e56ec332-d122-4606-a0b4-164acb973fa9",
                                "sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
                                "text": "Koning Willem-Alexander en koningin Máxima waren afgelopen weekend in Terneuzen. De koning gaf het startschot voor de viering van 75 jaar vrijheid. Want dit jaar is het 75 jaar geleden dat Nederland bevrijd werd."
                            },
                            {
                                "example_id": "b1ba6401-f4e6-40bb-9946-89b28ef232b0",
                                "sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
                                "text": "‘Ik ben op weg naar een huisje op een vakantiepark in Venlo, een weekendje weg met ons gezin, mijn ouders en mijn zus. Dat doen wij een keer per jaar, en dit was al een half jaar van tevoren gepland. We hebben ervoor gekozen om het toch door te laten gaan. Er is daar ruimte en groen, het is geen massale mensenmassa waarin we ons begeven. We zien wel wat er daar nog open is. En dit weekend is belangrijk voor ons, er worden al zo veel leuke dingen afgelast."
                            },
                            {
                                "example_id": "8b7bc620-17de-4d5b-9f27-8343348f6ae0",
                                "sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
                                "text": "Ik heb nooit alleen gewoond, ik ben altijd met anderen op pad en ik ga met mijn gezin op vakantie of met vrienden een weekendje weg."
                            }
                        ]
                    }
                ],
                "translations": [
