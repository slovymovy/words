{
    "word_family": [
        "envol",
        "survol",
        "vol",
        "voler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "585088a8-e610-3cab-a6c5-3e9d2a1e6874",
                    "sense_definition": "Voler au-dessus d'un lieu ou d'un espace géographique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion a commencé à <w>survoler</w> la ville juste avant le coucher du soleil."
                        },
                        {
                            "text": "Plusieurs hélicoptères <w>survolent</w> la forêt pour repérer les départs d'incendie."
                        }
                    ],
                    "common_phrases": [
                        "survoler la ville",
                        "survoler une zone"
                    ]
                },
                {
                    "sense_id": "8583ada9-9df3-3240-885c-18bdcd84fa91",
                    "sense_definition": "Lire un texte rapidement et de manière superficielle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai seulement eu le temps de <w>survoler</w> un article avant de partir travailler."
                        },
                        {
                            "text": "Elle préfère <w>survoler</w> le journal le matin plutôt que de tout lire attentivement."
                        }
                    ],
                    "synonyms": [
                        "lire en diagonale"
                    ],
                    "common_phrases": [
                        "survoler un article",
                        "survoler le journal",
                        "survoler les titres"
                    ]
                },
                {
                    "sense_id": "71632b5c-2925-3779-af08-55fe192ebc4e",
                    "sense_definition": "Traiter ou aborder un sujet sommairement, sans entrer dans les détails.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a dû <w>survoler</w> le sujet par manque de temps pendant le cours."
                        },
                        {
                            "text": "Cette brève présentation ne fait que <w>survoler</w> les aspects principaux du problème."
                        }
                    ],
                    "common_phrases": [
                        "survoler le sujet",
                        "survoler la question"
                    ]
                },
                {
                    "sense_id": "d2fa4797-f880-3297-957d-ce22ebf52973",
                    "sense_definition": "Dominer nettement ses adversaires dans une épreuve ou une compétition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune athlète a complètement <w>survolé</w> la compétition grâce à son entraînement rigoureux."
                        },
                        {
                            "text": "L'équipe locale a <w>survolé</w> les débats lors de la grande finale du tournoi."
                        }
                    ],
                    "common_phrases": [
                        "survoler la compétition",
                        "survoler les débats"
                    ]
                }
            ]
        }
    ]
}