        "fr-extract.jsonl": [
            {
                "entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                "word": "exécrable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3a151f3-0dd1-4b3b-8fe3-0893110848ab",
                        "entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "exécrables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                        "entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                        "glosses": [
                            "Qu’on doit exécrer, dont on doit avoir horreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb7332e-041b-4ea8-9534-e96c801b0fdf",
                                "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                                "text": "Forfait exécrable."
                            },
                            {
                                "example_id": "1344d304-bc14-4ba2-b24b-507ab31abf1e",
                                "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                                "text": "C’est un homme exécrable."
                            },
                            {
                                "example_id": "a1cf4c6b-c054-443e-99d8-821cf735779c",
                                "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                                "text": "Il a des mœurs et des opinions exécrables."
                            },
                            {
                                "example_id": "88b7dd67-ffec-4621-a685-a20efeeea656",
                                "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                                "text": "Que venait-on faire sur la terre ? quel était le sens de cette existence exécrable, sans égalité, sans justice, qui lui apparaissait comme le cauchemar d’une nuit de délire ?"
                            },
                            {
                                "example_id": "55bb904e-e705-486f-a453-7ad189ae151d",
                                "sense_id": "3ae174e2-6e44-33a5-8941-48b26eb74314",
                                "text": "Sur cette période, tout juste exprimerait-elle à l’avenir que, de douteux, son beau-frère est devenu franchement exécrable. Le mari de Betty séduit les femmes pour mieux les prendre au piège. Il boit. Quand il rentre ivre du pub, on se barricade dans la maison. Il tambourine à la porte, fait scandale, terrorise tout le monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbba92bc-fd3d-35b1-95c8-29302e92a0a8",
                        "entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                        "glosses": [
                            "Qui est extrêmement mauvais."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a38a0fd2-955f-48ca-b956-c18f05a8a50c",
                                "sense_id": "dbba92bc-fd3d-35b1-95c8-29302e92a0a8",
                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins ; il est sans lumières ; les conditions d’habitation y sont exécrables."
                            },
                            {
                                "example_id": "8275effd-1416-4011-9607-6a08674436ed",
                                "sense_id": "dbba92bc-fd3d-35b1-95c8-29302e92a0a8",
                                "text": "La circulation à Paris lui avait paru exécrable, dangereuse, des maniaques au volant qui avaient l’œil fixé sur le bout du capot comme des gosses dans des autos-tamponnantes."
                            },
                            {
                                "example_id": "daa979cc-73ea-4a6b-88d3-046d37854252",
                                "sense_id": "dbba92bc-fd3d-35b1-95c8-29302e92a0a8",
                                "text": "Il a fallu « déflotter » les morceaux de la carlingue par une météo exécrable et sous une pression médiatique formidable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8b6eba9-82cc-417d-a4d6-ee8f7d35a246",
                        "source_entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                        "source_sense_description": "Qu’on doit exécrer",
                        "target_lang_word": "execrable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "execrable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669b77dc-b71e-30be-9d2b-d319bacf616f",
                                        "entry_id": "338682dc-e2a0-36cc-8044-73fa39159a99",
                                        "glosses": [
                                            "Of the poorest quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b20bb9d-2402-4a57-9bb5-17bf11e28a5d",
                                                "sense_id": "669b77dc-b71e-30be-9d2b-d319bacf616f",
                                                "text": "As execrable as the Supreme Court’s decisions have been, they are of a piece with the conservative rulings from lower court judges who see no issue with laundering a revanchist policy agenda through contorted rulings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3cb0521-245a-3653-9849-f05b9b1e2657",
                                        "entry_id": "338682dc-e2a0-36cc-8044-73fa39159a99",
                                        "glosses": [
                                            "Hateful, disgusting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca4eddff-0f68-493a-83cc-c98802dfeb15",
                                                "sense_id": "b3cb0521-245a-3653-9849-f05b9b1e2657",
                                                "text": "But is an enemy so execrable, that, though in captivity, his wishes and comforts are to be disregarded and even crossed? I think not. It is for the benefit of mankind to mitigate the horrors of war as much as possible."
                                            },
                                            {
                                                "example_id": "895c2eb7-d067-467c-88c9-6d9fa357ed71",
                                                "sense_id": "b3cb0521-245a-3653-9849-f05b9b1e2657",
                                                "text": "The arcanely evil words of that despicable, loathsome, suppressed, vile, pululating ^([sic]), odious, nictating, repellent, repugnant, noxious, abhorrent, abominable, tory, execrable, nauseous work, Ye Boke of Guts, moved as if on a conveyor belt before his eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9f119af-20e8-42f1-9d25-8d5703029bb1",
                        "source_entry_id": "f5ed04a9-3de8-31f6-98a3-19dfa67de9ff",
                        "source_sense_description": "Qu’on doit exécrer",
                        "target_lang_word": "esecrabile",
