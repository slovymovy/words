                        "glosses": [
                            "Schlagwort des früheren sowjetischen Staatschefs Michael Gorbatschow, die auf die Reform des Staats- und Wirtschaftssystems der damaligen UdSSR abzielte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472df8d4-361e-4979-a007-e4feea70602b",
                                "sense_id": "ad79c320-fdf3-34f6-8289-9e8d88c3fe23",
                                "text": "„Und es waren aufregende Zeiten: Glasnost und Perestrojka prägten die Weltpolitik.“"
                            },
                            {
                                "example_id": "68d9f702-0fcf-4176-924b-0aada6662298",
                                "sense_id": "ad79c320-fdf3-34f6-8289-9e8d88c3fe23",
                                "text": "„Dann kam die Perestrojka, die Preise wuchsen wie die Riesen in unseren Märchen, und Rosas Ersparnisse wurden zunichte.“"
                            }
                        ],
