                "senses": [
                    {
                        "sense_id": "2d7dac22-71d6-30be-93f9-02275c8de20a",
                        "entry_id": "73b8bc84-eeef-36b3-b625-b4665c86d214",
                        "glosses": [
                            "Polster/Matratze, in das/die Metallfedern für die Federung eingearbeitet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b86f74-9426-47fb-9820-f2cc3cc61e36",
                                "sense_id": "2d7dac22-71d6-30be-93f9-02275c8de20a",
                                "text": "„Sein Bett, genauso stümperhaft zusammengeschraubt, steht in der Ecke und besteht nur aus einer billigen Sprungfedermatratze auf einem noch billigeren Gestell mit Kopfteil.“"
                            },
                            {
                                "example_id": "8cc0af1b-5b49-46a6-a3d0-192c99a0a031",
                                "sense_id": "2d7dac22-71d6-30be-93f9-02275c8de20a",
                                "text": "„Ohne es zu merken, ließ Emilia sich seufzend auf die harte Sprungfedermatratze des schmalen Bettkastens niedersinken, den Kopf gedankenvoll gegen das harte Brett lehnend.“"
                            },
                            {
                                "example_id": "f80b7621-dc5e-4bcd-8865-8e38bf1a4948",
                                "sense_id": "2d7dac22-71d6-30be-93f9-02275c8de20a",
                                "text": "„Ich habe endlich wieder einmal in einem richtigen Bette mit Sprungfedermatratze, aber ohne Übermatratze, die durch unsere Decken ersetzt wurde, geschlafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
