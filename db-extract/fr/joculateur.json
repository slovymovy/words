                        "entry_id": "50cdb61d-886c-3b87-ad53-6033bfc05925",
                        "glosses": [
                            "Celui qui amuse le public par des facéties, des bouffonneries, des tours de passe-passe ; amuseur public en général."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "811267ef-e0a3-4d30-b5f0-2c346a9674d6",
                                "sense_id": "01f69a4f-a42a-3245-a5ba-19c3971a5be8",
                                "text": "Le marchand qui apportera un singe pour le vendre paiera quatre deniers ; si le singe appartient à un joculateur, cet homme, en le laissant jouer et danser devant le péager, sera quitte du péage."
                            },
                            {
                                "example_id": "cfead8d1-1b0f-4c23-94ce-d29e286048de",
                                "sense_id": "01f69a4f-a42a-3245-a5ba-19c3971a5be8",
                                "text": "Les acteurs, les mimes, les joculateurs de tous genres, toute la race précieuse des esclaves publics, ne sont point encore honorés comme il faut."
                            }
                        ]
                    }
