                            },
                            {
                                "target_lang_word": "unternehmerisch",
                                "target_lang_sense_clarification": "bezieht sich auf geschäftlichen Mut und Initiative"
                            },
                            {
                                "target_lang_word": "initiativreich",
                                "target_lang_sense_clarification": "betont die Fähigkeit, von sich aus aktiv zu werden"
                            }
                        ]
                    }
                }
            ]
        },
