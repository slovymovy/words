                                        "entry_id": "1fbb019b-9847-351d-b4b5-dc96d457b1f9",
                                        "glosses": [
                                            "A chance for advancement, progress or profit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "227fb8cd-e876-4bd4-8ff5-c661e8c59840",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "seize the opportunity"
                                            },
                                            {
                                                "example_id": "5322c85f-56f4-497b-bcea-9caa4e6abf95",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "take an opportunity"
                                            },
                                            {
                                                "example_id": "85fb590b-e39d-42db-89f2-0c85ad619033",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "missed opportunity"
                                            },
                                            {
                                                "example_id": "780ab74d-4bb5-4012-81e5-31e52eaeb3ec",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "The world is full of opportunities and it's up to me to see them and pursue them."
                                            },
                                            {
                                                "example_id": "02abc013-15f7-43c7-9fb8-eb2b6a8c5458",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "the opportunity came and went"
                                            },
                                            {
                                                "example_id": "4633b291-87a9-41ac-ab1b-8f8d068b1298",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "You'll get a second opportunity if you miss this one."
                                            },
                                            {
                                                "example_id": "113905c9-f5e0-4538-9274-1994a371914a",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "The chairman of the committee will be very glad to give you the opportunity to express your views, whether of proponency or opponency."
                                            },
                                            {
                                                "example_id": "5929a53d-00f4-4741-ab78-0198cf79235f",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "Unfortunately, the job opportunities they are seeking are often more hoped for than real, […]"
                                            },
                                            {
                                                "example_id": "35cb7d18-2c1f-413a-b063-9dd866a0a171",
                                                "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                                                "text": "Chelsea also struggled to keep possession as QPR harried and chased at every opportunity, giving their opponents no time on the ball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea29ebd-127d-391e-90f9-cda427d8b5cb",
                                        "entry_id": "1fbb019b-9847-351d-b4b5-dc96d457b1f9",
                                        "glosses": [
                                            "A favorable circumstance or occasion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af3a53e-f472-498e-b37b-206f73b2fe5e",
                                                "sense_id": "bea29ebd-127d-391e-90f9-cda427d8b5cb",
                                                "text": "Having a holiday is a great opportunity to relax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc4f1ad-2848-3fce-b6ab-c2c3a3da48fd",
                                        "entry_id": "1fbb019b-9847-351d-b4b5-dc96d457b1f9",
                                        "glosses": [
                                            "Opportuneness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d29b65-b32d-425a-bcda-ceca6580666b",
                                                "sense_id": "6fc4f1ad-2848-3fce-b6ab-c2c3a3da48fd",
                                                "text": "The Court questioned the opportunity of introducing these measures in such an uncertain economic climate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0a23528-5495-435a-a589-0c9404fdd4dc",
                        "source_entry_id": "d67a7e5c-2eb5-325c-baa9-379721b7051a",
