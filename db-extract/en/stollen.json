                    {
                        "translation_id": "7c7bd3be-c6d9-4559-9da6-b90c8b3a6697",
                        "source_entry_id": "7592811a-a21e-3b68-8fa3-2e3a8618f3e3",
                        "source_sense_id": "da7b60f5-8ec9-32bf-ba63-e7ec4e9840e9",
                        "source_sense_description": "a traditional German cake eaten at Christmas time",
                        "target_lang_word": "Christstollen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christstollen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                        "entry_id": "55e15aca-7981-316d-8ea7-6202d84f5e2a",
                                        "glosses": [
                                            "traditionell in der Weihnachtszeit gebackener länglicher, brotförmiger Weihnachtskuchen aus Hefeteig, Rosinen, Mandeln sowie Zitronat und verschiedenen Gewürzen"
                                        ],
                                        "tags": [
                                            "Backkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000359c5-26f6-48e9-9e12-1ca5af8af602",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "Auf dem festlichen Tisch stand der Christstollen."
                                            },
                                            {
                                                "example_id": "9cc7d6fd-453f-4408-9bee-192f66f85d14",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Den Christstollen auf das vorbereitete Backblech legen und im heißen Ofen etwa 50 Minuten backen.“"
                                            },
                                            {
                                                "example_id": "e8fdeb3d-5104-4c87-b8fa-9c58fe7e3e3c",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Was gibt es in der Weihnachtszeit Traditionelleres, als einen schönen saftigen Christstollen?“"
                                            },
                                            {
                                                "example_id": "5d6ead03-362c-415c-9dc8-2ef0df6e3428",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Jonas und Troll seufzten gleichzeitig, und dann nahm Jonas einen Christstollen, eine Flasche Saft und eine Gitarre aus seinem grünen Rucksack.“"
                                            },
                                            {
                                                "example_id": "8b3d3dc8-4b33-4904-8ca3-d16c8ec37001",
                                                "sense_id": "4f206a9c-3844-37c8-a784-a2b208a46c58",
                                                "text": "„Weihnachten ohne den »Dresdner Christstollen« konnte sich niemand in der Familie vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
