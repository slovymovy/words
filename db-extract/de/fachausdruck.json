                        ],
                        "form": "die Fachausdrücke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                        "entry_id": "ad7f5acb-cfd9-32cc-b844-601c2d01dc54",
                        "glosses": [
                            "Terminus, ein spezieller Ausdruck in einem Fach, Fachgebiet, Wissenschaftsdisziplin, Branche, Handwerk oder Gewerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "562f9470-7a00-4e91-8f88-b207176d5042",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "Manch Fachausdruck ist unverständlich."
                            },
                            {
                                "example_id": "14a29bd4-89ac-4995-ba06-594115bd639a",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "„Oft bleibt er stecken, und aus dem beabsichtigten geologischen Fachausdruck ist ein deutscher Fluch mit griechischem Prä- oder Suffix geworden.“"
                            },
                            {
                                "example_id": "08f75c8d-d1ef-46b0-8e39-9f206db8aada",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "„Die Linguistik hat da eigene Fachausdrücke eingeführt:…“"
                            },
                            {
                                "example_id": "24a438ca-9071-40cd-a0e4-d3c28584eadf",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "„So gehen zum Beispiel Redensarten und Sprichwörter häufig auf alte Fachausdrücke zurück, nicht selten aus alten Handwerken.“"
                            },
                            {
                                "example_id": "d3f43bef-c37e-47a6-b19e-0741f1069a15",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "„Aufgelistet sind hier auch die Abkürzungen, die wir im Wörterbuch verwenden, und die wichtigsten grammatischen Fachausdrücke mit einer kurzen Erklärung.“"
                            },
                            {
                                "example_id": "f5ef7455-3196-4560-a335-d1e2bfe14c2b",
                                "sense_id": "2b676b2f-0b73-3268-9a1e-d656a0ec99e4",
                                "text": "„Noch weniger darf man einen Edelmann nach seinem Wappen fragen, denn wenn er die heraldischen Fachausdrücke nicht beherrscht, bringt man ihn in Verlegenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
