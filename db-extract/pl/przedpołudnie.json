                                                "sense_id": "b917c007-eeeb-3bbe-9f9c-4fe2d9ee9529",
                                                "text": "上午我來的時候，你恰巧不在。"
                                            },
                                            {
                                                "example_id": "17e68371-8c60-43a0-b101-3d7fcf600670",
                                                "sense_id": "b917c007-eeeb-3bbe-9f9c-4fe2d9ee9529",
                                                "text": "上午我来的时候，你恰巧不在。"
                                            },
                                            {
                                                "example_id": "d7b41cc4-5952-4528-8690-a0ccf396944e",
                                                "sense_id": "b917c007-eeeb-3bbe-9f9c-4fe2d9ee9529",
                                                "text": "老師給大家講了一上午的進化論。"
                                            },
                                            {
                                                "example_id": "59ecce01-90ac-4a32-b89b-1f3be832f9e1",
                                                "sense_id": "b917c007-eeeb-3bbe-9f9c-4fe2d9ee9529",
                                                "text": "老师给大家讲了一上午的进化论。"
                                            }
