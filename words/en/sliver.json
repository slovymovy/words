{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f270b9ca-055a-3f5e-9c8e-83cb10e16960",
                    "sense_definition": "A small, thin, and often sharp piece cut or broken off from a larger whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny <w>sliver</w> of glass pierced through the sole of his shoe.",
                            "target_lang_translations": {
                                "ru": "Крошечный <w>осколок</w> стекла проткнул подошву его ботинка."
                            }
                        },
                        {
                            "text": "She cut a small <w>sliver</w> of cake because she was on a diet.",
                            "target_lang_translations": {
                                "ru": "Она отрезала себе тоненький <w>кусочек</w> торта, так как сидела на диете."
                            }
                        }
                    ],
                    "synonyms": [
                        "shard",
                        "splinter",
                        "slice"
                    ],
                    "common_phrases": [
                        "sliver of glass",
                        "sliver of wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, тонкий и зачастую острый кусочек, отколотый или отрезанный от целого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "мелкая острая частица стекла, камня или льда"
                            },
                            {
                                "target_lang_word": "щепка",
                                "target_lang_sense_clarification": "тонкий кусочек дерева"
                            },
                            {
                                "target_lang_word": "тонкий ломтик",
                                "target_lang_sense_clarification": "узкий, тонко отрезанный кусочек пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e9a5681-79fc-3a18-9603-a46fd37da9c9",
                    "sense_definition": "A very small amount or degree of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was only a <w>sliver</w> of hope left for finding the missing dog.",
                            "target_lang_translations": {
                                "ru": "Оставалась лишь слабая <w>крупица</w> надежды найти пропавшую собаку."
                            }
                        },
                        {
                            "text": "A <w>sliver</w> of moonlight shone through the narrow gap in the curtains.",
                            "target_lang_translations": {
                                "ru": "Узкая <w>полоска</w> лунного света пробивалась сквозь узкую щель в шторах."
                            }
                        }
                    ],
                    "synonyms": [
                        "shred",
                        "trace",
                        "glimmer",
                        "crumb",
                        "bit"
                    ],
                    "common_phrases": [
                        "sliver of hope",
                        "sliver of light",
                        "sliver of moon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень малое количество, крупица или тонкая полоска чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "малая толика, капля надежды, правды и т. п."
                            },
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкая часть света или луны"
                            },
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "слабое проявление чувства или явления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b3d2a48-cdcf-3622-81de-b0d801bfda60",
                    "sense_definition": "A sharp splinter of wood or metal embedded under the skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a pair of tweezers to remove the <w>sliver</w> from his thumb.",
                            "target_lang_translations": {
                                "ru": "Он воспользовался пинцетом, чтобы вытащить <w>занозу</w> из большого пальца."
                            }
                        },
                        {
                            "text": "Touching the rough timber fence left a painful <w>sliver</w> deep in her palm.",
                            "target_lang_translations": {
                                "ru": "Прикосновение к необработанному деревянному забору оставило болезненную <w>занозу</w> глубоко в её ладони."
                            }
                        }
                    ],
                    "synonyms": [
                        "splinter"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Острая щепка дерева или кусочек металла, вонзившийся под кожу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заноза",
                                "target_lang_sense_clarification": "острый фрагмент дерева или металла в теле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa24658-2cb6-389e-8830-abe4b6e4299f",
                    "sense_definition": "A loose, untwisted strand or continuous ribbon of fiber produced by carding or combing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine drew the wool into a uniform <w>sliver</w> before the spinning process began.",
                            "target_lang_translations": {
                                "ru": "Машина вытянула шерсть в однородную <w>ленту</w> перед началом процесса прядения."
                            }
                        },
                        {
                            "text": "Workers checked each cotton <w>sliver</w> for impurities before feeding it into the spinning frame.",
                            "target_lang_translations": {
                                "ru": "Рабочие проверяли каждую хлопчатобумажную <w>ленту</w> на наличие примесей перед подачей в прядильную машину."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободная, нескрученная лента из волокон, получаемая при чесании перед прядением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесальная лента",
                                "target_lang_sense_clarification": "полуфабрикат в прядении"
                            },
                            {
                                "target_lang_word": "лента",
                                "target_lang_sense_clarification": "текстильное волокно после чесания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ea9b7f5-be6e-36f3-a8df-d8132cd2112b",
                    "sense_definition": "An unusually narrow high-rise apartment building constructed on a small lot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer replaced the old brownstone with a modern <w>sliver</w> rising thirty stories.",
                            "target_lang_translations": {
                                "ru": "Застройщик заменил старинный особняк на современный <w>дом-карандаш</w> высотой в тридцать этажей."
                            }
                        },
                        {
                            "text": "Zoning laws were changed to prevent another tall <w>sliver</w> from blocking sunlight on the block.",
                            "target_lang_translations": {
                                "ru": "Правила зонирования изменили, чтобы предотвратить появление очередной узкой <w>высотки</w>, закрывающей солнечный свет в квартале."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sliver building"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычайно узкое высотное жилое здание, построенное на маленьком участке земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дом-карандаш",
                                "target_lang_sense_clarification": "очень узкий высотный дом"
                            },
                            {
                                "target_lang_word": "дом-точка",
                                "target_lang_sense_clarification": "точечная узкая многоэтажная застройка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57122ba1-1762-32bb-9187-360ae1fe497a",
                    "sense_definition": "Fishing bait prepared from small, sliced pieces of fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman placed a fresh <w>sliver</w> on the hook to attract bass.",
                            "target_lang_translations": {
                                "ru": "Рыбак насадил свежую <w>полоску рыбы</w> на крючок, чтобы привлечь окуня."
                            }
                        },
                        {
                            "text": "A bucket of oily <w>sliver</w> was prepared on the boat before sunrise.",
                            "target_lang_translations": {
                                "ru": "Ведро жирной <w>рыбной нарезки</w> для наживки приготовили на лодке ещё до восхода солнца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыболовная наживка из тонко нарезанных кусочков рыбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбная нарезка",
                                "target_lang_sense_clarification": "кусочки рыбы в качестве наживки"
                            },
                            {
                                "target_lang_word": "полоска рыбы",
                                "target_lang_sense_clarification": "наживка на крючок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4cec2b8-4083-3704-be8c-a1288242641e",
                    "sense_definition": "To cut, split, or rend something lengthwise into long, thin pieces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter carefully <w>slivered</w> the pine board into slender decorative strips.",
                            "target_lang_translations": {
                                "ru": "Плотник аккуратно <w>расщепил</w> сосновую доску на тонкие декоративные планки."
                            }
                        },
                        {
                            "text": "She took a sharp knife to <w>sliver</w> the almonds for the pastry topping.",
                            "target_lang_translations": {
                                "ru": "Она взяла острый нож, чтобы <w>нарезать лепестками</w> миндаль для украшения выпечки."
                            }
                        }
                    ],
                    "synonyms": [
                        "slice",
                        "slit",
                        "split"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резать, расщеплять или раскалывать что-либо вдоль на тонкие длинные полоски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарезать тонкими полосками",
                                "target_lang_sense_clarification": "шинковать или резать тонкими ломтиками"
                            },
                            {
                                "target_lang_word": "расщеплять вдоль",
                                "target_lang_sense_clarification": "колоть на тонкие щепки или полоски"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}