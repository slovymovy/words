                                "target_senses": [
                                    {
                                        "sense_id": "8a0219c7-5ac0-3bb6-8c15-692de168bd9e",
                                        "entry_id": "fbd93494-280b-3017-8cc6-bedc8cc4c5c9",
                                        "glosses": [
                                            "A person who owns or operates a mill, especially a flourmill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b0845e-c268-4501-ba77-44bca4a76c39",
                                                "sense_id": "8a0219c7-5ac0-3bb6-8c15-692de168bd9e",
                                                "text": "Constable's father, a wealthy miller, operated the mill at Flatford, which still stands 1 mile south of the village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c575ded-e7a7-3a65-b98b-821a7796309b",
                                        "entry_id": "fbd93494-280b-3017-8cc6-bedc8cc4c5c9",
                                        "glosses": [
                                            "A milling machine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac818bb-c77b-46f2-8e19-60450d5935ff",
                                                "sense_id": "1c575ded-e7a7-3a65-b98b-821a7796309b",
                                                "text": "Besides the usual run of machines, planers, millers, automatics, centre lathes, cranes, etc., there were several power stations, the rolling mills for strip material and for 60 ft. rails, and all the steel furnaces with their complicated systems of flues. If variety is the spice of life, then there was plenty here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90566b1-7bda-3e60-ab8d-5980d8a7326a",
                                        "entry_id": "fbd93494-280b-3017-8cc6-bedc8cc4c5c9",
                                        "glosses": [
                                            "Any of several moths that have powdery wings, especially Acronicta leporina and moths of the genus Agrotis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1797216e-006f-314b-8e97-893beb1b2e5b",
                                        "entry_id": "fbd93494-280b-3017-8cc6-bedc8cc4c5c9",
                                        "glosses": [
                                            "A floury-smelling mushroom, Clitopilus prunulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
