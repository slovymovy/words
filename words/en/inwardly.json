{
    "word_family": [
        "inward",
        "inwardness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "021038de-7448-3750-8def-1e1e1eb8d778",
                    "sense_definition": "In the mind or spirit; secretly or privately, without showing it externally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She smiled politely, but <w>inwardly</w> she was furious with his rude behavior.",
                            "target_lang_translations": {
                                "ru": "Она вежливо улыбнулась, но <w>в душе</w> была в ярости от его грубого поведения."
                            }
                        },
                        {
                            "text": "Jacob groaned <w>inwardly</w> when he was called on to answer the difficult question.",
                            "target_lang_translations": {
                                "ru": "Джейкоб <w>про себя</w> застонал, когда его вызвали отвечать на трудный вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "internally",
                        "privately",
                        "secretly"
                    ],
                    "antonyms": [
                        "outwardly",
                        "openly",
                        "externally"
                    ],
                    "common_phrases": [
                        "groan inwardly",
                        "cringe inwardly",
                        "smile inwardly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В мыслях или в душе; про себя, не показывая внешне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про себя",
                                "target_lang_sense_clarification": "мысленно, не вслух"
                            },
                            {
                                "target_lang_word": "в душе",
                                "target_lang_sense_clarification": "внутренне, не показывая чувств"
                            },
                            {
                                "target_lang_word": "внутренне",
                                "target_lang_sense_clarification": "скрыто от окружающих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "714b61d2-961c-30c3-8ad2-dd1bb4455a4d",
                    "sense_definition": "Completely, thoroughly, or deeply.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noble knight was <w>inwardly</w> glad to find his lost sister after years of searching.",
                            "target_lang_translations": {
                                "ru": "Благородный рыцарь был <w>всем сердцем</w> рад найти свою потерянную сестру после долгих лет поисков."
                            }
                        },
                        {
                            "text": "He felt <w>inwardly</w> grateful for the unexpected kindness shown to him.",
                            "target_lang_translations": {
                                "ru": "Он был <w>глубоко</w> благодарен за проявленную к нему неожиданную доброту."
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "fully",
                        "thoroughly",
                        "deeply"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to mean fully or deeply"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью, глубоко или искренне (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глубоко",
                                "target_lang_sense_clarification": "всей душой, искренне"
                            },
                            {
                                "target_lang_word": "всем сердцем",
                                "target_lang_sense_clarification": "полностью, беззаветно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}