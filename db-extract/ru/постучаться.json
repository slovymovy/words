                ],
                "senses": [
                    {
                        "sense_id": "5cec251a-073f-3d72-a89a-65d1f15d4f7d",
                        "entry_id": "3d02fcff-841d-329e-9196-3b7f1bf99587",
                        "glosses": [
                            "стучаться некоторое время"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa11414-08d6-4b83-89ac-9e8c0f350f41",
                                "sense_id": "5cec251a-073f-3d72-a89a-65d1f15d4f7d",
                                "text": "Он постучался головой о стол: «Как я мог забыть!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "96c47bac-d967-34cc-ace9-8c060f05113b",
                        "entry_id": "3d02fcff-841d-329e-9196-3b7f1bf99587",
                        "glosses": [
                            "стуком дать знак о своём приходе, попросить разрешения войти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073fe6b1-cfe3-42ff-8970-0c2ac2587f21",
                                "sense_id": "96c47bac-d967-34cc-ace9-8c060f05113b",
                                "text": "Через несколько дней, поборов стеснительность, я с волнением постучался и вошёл в его гардеробную."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2f8114b-ebae-3c81-b1c2-0273f6da5ca7",
                        "entry_id": "3d02fcff-841d-329e-9196-3b7f1bf99587",
                        "glosses": [
                            "стуком дать знак о своём приходе, попросить разрешения войти",
                            "также безлич."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1b8ee4-df9e-4705-a1d4-b8b8dbfa796b",
                                "sense_id": "f2f8114b-ebae-3c81-b1c2-0273f6da5ca7",
                                "text": "Через несколько дней, поборов стеснительность, я с волнением постучался и вошёл в его гардеробную."
                            },
                            {
                                "example_id": "5bc0ba39-d623-4bc9-9b2c-f0580b428fbc",
                                "sense_id": "f2f8114b-ebae-3c81-b1c2-0273f6da5ca7",
                                "text": "В дверь постучались."
                            }
                        ]
                    },
                    {
                        "sense_id": "582ea643-aea2-3e1b-a34b-d4e46bf3773c",
                        "entry_id": "3d02fcff-841d-329e-9196-3b7f1bf99587",
                        "glosses": [
                            "перен. прийти, наступить, настать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5351d92a-b85c-4190-b6e5-97d72e73a2f6",
                                "sense_id": "582ea643-aea2-3e1b-a34b-d4e46bf3773c",
                                "text": "Однако судьбе было угодно постучаться и к самому Будённому."
                            }
                        ]
                    }
                ],
