                "senses": [
                    {
                        "sense_id": "48cb995c-84b9-3aed-8f50-696df59ac8a2",
                        "entry_id": "cc4694b8-0d26-3b50-b811-302afd34f54c",
                        "glosses": [
                            "eine Kultur betreffend, gemäß einer Kultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ba186d-4ef5-469d-b4d4-6bf2afe00853",
                                "sense_id": "48cb995c-84b9-3aed-8f50-696df59ac8a2",
                                "text": "„Eine erste und vorläufige Unterscheidung zwischen natürlich und kultürlich orientiert sich am Vorschlag von Aristoteles: Natürlich ist, was von selbst, das heißt ohne Zutun des Menschen geschieht und, weil Entstehen und Vergehen auch ein Geschehen ist, was von Natur aus existiert.“"
                            }
                        ],
