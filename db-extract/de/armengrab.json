                        "source_sense_id": "3a9c6774-c658-3ac1-823a-4dbc87f9074a",
                        "source_sense_description": "einfacher Bestattungsort für mittellose oder arme Verstorbene",
                        "target_lang_word": "fosse commune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fosse commune",
