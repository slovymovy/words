        "fr-extract.jsonl": [
            {
                "entry_id": "ec487199-bc4d-37b5-a524-37acf6ba2caa",
                "word": "snack-bar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                        "entry_id": "ec487199-bc4d-37b5-a524-37acf6ba2caa",
                        "glosses": [
                            "Petit établissement de restauration bas de gamme où l’on ne sert que des mets vite faits : sandwichs, frites, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c239aa85-a3bd-4e2a-ba94-ac915fdab8eb",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "Ouvrir un snack-bar, être serveuse dans un snack-bar."
                            },
                            {
                                "example_id": "16503be5-05f6-4f89-a4d4-d98365470a77",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "Il expliqua l’avantage des snack-bars. Que les automobilistes d’aujourd’hui n’aiment pas perdre de temps dans les auberges. Qu’ils préfèrent manger sur le pouce, pendant qu’on leur fait le plein d’essence ; et que, s’ils ne veulent pas quitter leur siège, on leur porte un sandwich, avec du vin dans un gobelet de carton. Que le snack-bar, c’est l’avenir. Qu’en dix ans, avec leurs économies de gérants, ils deviendront propriétaires."
                            },
                            {
                                "example_id": "2b1248c1-f744-4ef9-b184-f2d03428651f",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "Il arrive les mains dans les poches, jean délavé et cigarette au bec, pour siroter une bière dans un modeste snack-bar de Washington DC, à deux pas du Capitole."
                            },
                            {
                                "example_id": "ae7c4745-ecff-4cba-88cb-82720f8c542c",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "J'avais mangé mes premiers hamburgers, grilled-cheese, doughnuts et banana split au snack-bar du camp militaire où je travaillais. — (Le Devoir, 3 août 2006)"
                            },
                            {
                                "example_id": "4a356e53-63eb-4ea6-9c3b-7c1b03904cc3",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "[…] un décor ascétique qui semble hésiter entre le bistro chic et le snack bar […]."
                            },
                            {
                                "example_id": "de8f52c5-6722-4ab9-8439-30c93c781f10",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "Le scénario de ce film, intelligent, fin, complexe et dense, n’a visiblement pas été écrit sur un coin de table de snack-bar (on le retrouve d’ailleurs en nomination pour l’Oscar du meilleur scénario adapté)."
                            },
                            {
                                "example_id": "86b473ba-368a-46dc-bd6d-5f36bbf8b57b",
                                "sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                                "text": "Aménagé dans le milieu de nulle part\nDans un' moitié d’autobus […]\nLa serveuse est joufflue\nPis ell' fait des fautes su' son menu […]\n Tout l’monde au snack-bar Chez Raymond — (Snack-bar chez Raymond, chanson de François Pérusse)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f87f8d0-3b47-4003-8993-33f0abcd639e",
                        "source_entry_id": "ec487199-bc4d-37b5-a524-37acf6ba2caa",
                        "source_sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                        "target_lang_word": "Imbiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imbiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "eine kurze Mahlzeit außerhalb der Hauptmahlzeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d250b401-dbb9-49fc-91dc-f7583e5a4155",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "Auf der Veranda nahmen sie einen kleinen Imbiss ein."
                                            },
                                            {
                                                "example_id": "b3bf4bb2-2534-4e02-9b9b-280a6384e1f4",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "„Tischchen mit Imbissen wurden aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "Stand, Kantine, Kiosk oder Stube, wo man eine kleine Zwischenmahlzeit^([1]) kaufen und einnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647b0840-2df2-449c-9043-b2e9907143f7",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "Lass uns mal eben zum Imbiss gehen!"
                                            },
                                            {
                                                "example_id": "dea258a5-452c-4135-b849-763b970cf03d",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Die Tür von Henrys Imbiss ging auf, und zwei Männer kamen herein.“"
                                            },
                                            {
                                                "example_id": "34e98f89-7ce7-460c-96d6-39e268d1bc50",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Gegenüber ihrer Stammkneipe gab es einen kleinen vietnamesischen Imbiss.“"
                                            },
                                            {
                                                "example_id": "7ebe4cd9-eb3d-4b1b-99b8-52775373e2f6",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Aldís zog die Nase hoch, schnäuzte sich, suchte Zuflucht im Imbiss des Ladens, wo sie einen Hotdog bestellte, aber gar keinen Hunger verspürte und das Würstchen nach dem ersten Bissen in die Tonne warf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba3d92ac-fa01-4120-835a-35d314a279cd",
                        "source_entry_id": "ec487199-bc4d-37b5-a524-37acf6ba2caa",
                        "source_sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
                        "target_lang_word": "Imbissbude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imbissbude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d49ea6-17ef-3a63-9ab6-552de66ddc27",
                                        "entry_id": "4ab348fd-aa06-37ad-9678-6fae231c9429",
                                        "glosses": [
                                            "Kiosk/Stand, an dem man einen Imbiss bekommen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47de045f-ca65-46db-bbaf-990fa2fd23be",
                                                "sense_id": "e3d49ea6-17ef-3a63-9ab6-552de66ddc27",
                                                "text": "Es sind nur ein paar Meter bis zur nächsten Imbissbude."
                                            },
                                            {
                                                "example_id": "cb391591-db25-488d-852f-40d510be7e7c",
                                                "sense_id": "e3d49ea6-17ef-3a63-9ab6-552de66ddc27",
                                                "text": "„Bis zum Beginn des Wintersemesters nahm ich noch einen Job in einer Imbissbude an, konnte nach zwei Tagen keine Bratwürste, egal, welche, vor allem aber keine halben Hähnchen mehr sehen.“"
                                            },
                                            {
                                                "example_id": "849ab165-df93-4d84-bc0b-636ce4d7a94f",
                                                "sense_id": "e3d49ea6-17ef-3a63-9ab6-552de66ddc27",
                                                "text": "„Die Bedienung in der Imbissbude scheint direkt einem flämischen Gemälde entstiegen zu sein.“"
                                            },
                                            {
                                                "example_id": "03aa2e5e-1fcd-488b-884e-5e31ab00ab8d",
                                                "sense_id": "e3d49ea6-17ef-3a63-9ab6-552de66ddc27",
                                                "text": "„Deshalb muss man bei der Eröffnung einer Imbissbude behördliche Auflagen erfüllen, als wolle man eine Wiederaufbereitungsanlage in Betrieb nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4d08f63-34e5-4f2e-a310-a3a703f4421f",
                        "source_entry_id": "ec487199-bc4d-37b5-a524-37acf6ba2caa",
                        "source_sense_id": "c38a9bf4-8eb5-3a99-8b3f-171fe0c36b24",
