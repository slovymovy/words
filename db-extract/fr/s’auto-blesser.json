                ],
                "senses": [
                    {
                        "sense_id": "f1e28e9a-f1fc-3eff-9ba7-62815646e160",
                        "entry_id": "3e5aa2a4-73b9-304d-a6f5-e08e70c77163",
                        "glosses": [
                            "Se blesser de soi-même, volontairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4c9f57-47cc-4e75-b1a3-f14d0901d5eb",
                                "sense_id": "f1e28e9a-f1fc-3eff-9ba7-62815646e160",
                                "text": "Ce juge avait également estimé dans son rapport que la version de la police qui affirmait que le sans-papiers, se serait auto-blessé pour éviter son expulsion, était la plus cohérente."
                            },
                            {
                                "example_id": "57a30804-c341-41b5-a0a8-a44fd3bcd497",
                                "sense_id": "f1e28e9a-f1fc-3eff-9ba7-62815646e160",
                                "text": "Et puis en plongeant dans mon imagination, je le voyais déjà montrer à Kaboré comment on fait un coup du foulard. Histoire qu'il s'auto-blesse."
                            },
                            {
                                "example_id": "2db7dc0b-a1b4-4b98-ae65-25ea31da62c6",
                                "sense_id": "f1e28e9a-f1fc-3eff-9ba7-62815646e160",
                                "text": "Pour ne pas vous prendre vous-même au piège et ne pas vous auto-blesser par la suite, faites appel à une personne objective."
                            }
                        ]
                    }
                ],
