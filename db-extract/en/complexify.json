                        "entry_id": "ee77f976-5e63-34f9-97db-ffd17b67ad96",
                        "glosses": [
                            "To make more complex; to complicate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "77385100-094e-41d3-b798-f90ff82c7b6e",
                                "sense_id": "102c0f99-b954-3b0c-8b24-0a57f90ad9bf",
                                "text": "A surveilled target using properly encrypted VOIP can greatly complexify the task of wire-tapping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f33d5561-2391-465d-a405-4b7d636e239f",
                        "source_entry_id": "ee77f976-5e63-34f9-97db-ffd17b67ad96",
                        "source_sense_id": "102c0f99-b954-3b0c-8b24-0a57f90ad9bf",
                        "source_sense_description": "make something more complex",
                        "target_lang_word": "complexifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complexifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b0f94b-5764-3522-9b8a-a3fc16e5a0a1",
                                        "entry_id": "35d37ee6-a47c-3063-b6ba-22d6b8a65eb5",
                                        "glosses": [
                                            "Rendre complexe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3abf74-f820-4dad-a281-7cb07a8f4d80",
                                                "sense_id": "e6b0f94b-5764-3522-9b8a-a3fc16e5a0a1",
                                                "text": "La géographie actuelle des péages en Europe complexifie considérablement cette quête du transport durable."
                                            },
                                            {
                                                "example_id": "560715f3-07b3-400f-bec7-7c47458437f8",
                                                "sense_id": "e6b0f94b-5764-3522-9b8a-a3fc16e5a0a1",
                                                "text": "Il viendra d’une part complexifier à l’extrême des réalités sociolinguistiques qui l’étaient déjà et d’autre part bouleverser les configurations fonctionnelles des langues vernaculaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429a5754-9480-3292-aeed-d1b0f1f867f5",
                                        "entry_id": "35d37ee6-a47c-3063-b6ba-22d6b8a65eb5",
                                        "glosses": [
                                            "Devenir plus complexe."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa611f9d-b947-4771-8b4b-3f4aa6980f52",
                                                "sense_id": "429a5754-9480-3292-aeed-d1b0f1f867f5",
                                                "text": "L'histoire de la découverte des astres du Système solaire se complexifie considérablement lorsqu’on prend en compte les « non-planètes » qui se sont ajoutées au cours des deux derniers siècles. Il y a notamment plus de 3 450 astéroïdes qui sont pour la plupart situés dans la Ceinture d'astéroïdes."
                                            },
                                            {
                                                "example_id": "1b867a06-caf7-467c-af05-ec52687611a2",
                                                "sense_id": "429a5754-9480-3292-aeed-d1b0f1f867f5",
                                                "text": "Ensuite, l'objet paysage, sous l'effet des transformations de la société, s'est complexifié et cela légitime que les efforts de recherche soient poursuivis."
                                            },
                                            {
                                                "example_id": "67201d35-117c-4267-ae61-d64b79a05d90",
                                                "sense_id": "429a5754-9480-3292-aeed-d1b0f1f867f5",
                                                "text": "Durant deux heures l’équation, à la base si simple, s’est complexifiée pour finir par devenir incompréhensible, pour nous, sombres néophytes de la justice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
