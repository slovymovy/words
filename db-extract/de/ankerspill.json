                                    {
                                        "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                        "entry_id": "a20e5596-fa46-3c6f-8c45-fd9165e26090",
                                        "glosses": [
                                            "A vertical cylindrical machine that revolves on a spindle, typically surmounted by a drumhead with sockets for levers for turning it; used to apply force to cables, ropes, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42faf908-20ce-4781-b399-c695dd51e944",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "to pawl the capstan",
                                                "translation": "to prevent the capstan from turning back",
                                                "english": "to prevent the capstan from turning back"
                                            },
                                            {
                                                "example_id": "639f3754-baa9-41da-b80a-788dd261072e",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "to rig the capstan",
                                                "translation": "to prepare the capstan for use",
                                                "english": "to prepare the capstan for use"
                                            },
                                            {
                                                "example_id": "2da5ea2f-b398-4c1c-93af-527e24958412",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "to surge the capstan",
                                                "translation": "to slack the tension of the rope or cable",
                                                "english": "to slack the tension of the rope or cable"
                                            },
                                            {
                                                "example_id": "8422f75d-fa9c-4a9a-a778-47cac3e874ee",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "\"Man the capstan! Blood and thunder!—jump!\"—was the next command, and the crew sprang for the handspikes."
                                            },
                                            {
                                                "example_id": "ef53191e-ebd8-4890-a883-a7da14739be2",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "We toiled over the capstan, and late in the afternoon slipped out of the harbour."
                                            },
                                            {
                                                "example_id": "9d1a6e8b-27be-42aa-9419-da671cab74f4",
                                                "sense_id": "6cc29ad1-f85d-342d-aba6-19c9992c2439",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef21eb3b-a054-34cc-9864-145fc119190c",
                                        "entry_id": "a20e5596-fa46-3c6f-8c45-fd9165e26090",
                                        "glosses": [
                                            "A rotating spindle used to move recording tape through the mechanism of a tape recorder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
