                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have been arguing on Twitter all day; go touch <w>grass</w>.",
                            "target_lang_translations": {
                                "ru": "Ты весь день споришь в Твиттере; иди потрогай <w>траву</w>.",
                                "zh": "你在推特上吵了一整天了，去接触一下<w>现实</w>吧。"
                            }
