                "senses": [
                    {
                        "sense_id": "79cb5555-e5d3-37df-b54c-f50c222c111e",
                        "entry_id": "36a22080-e270-3a3a-bcc9-2a47c4cb0c67",
                        "glosses": [
                            "Bus mit zwei Stockwerken, doppelstöckiger Bus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b079d7c-92e9-4bf5-b717-e639f6e1a436",
                                "sense_id": "79cb5555-e5d3-37df-b54c-f50c222c111e",
                                "text": "„Ein Doppeldeckerbus voller Touristen dröhnte vorüber.“"
                            },
                            {
                                "example_id": "bee7941e-66de-4e7f-9ba2-b45d040fa565",
                                "sense_id": "79cb5555-e5d3-37df-b54c-f50c222c111e",
                                "text": "„Katekar kratzte sich zwischen den Beinen, knurrte ›He, Bhenchod‹ und zwang den Fahrer eines Doppeldeckerbusses mit gebieterischem Blick anzuhalten.“"
                            },
                            {
                                "example_id": "e50c8a4e-a4e0-4afe-8901-c6614c144c45",
                                "sense_id": "79cb5555-e5d3-37df-b54c-f50c222c111e",
                                "text": "„Der stetige Strom von hupenden Autos, Taxen und roten Doppeldeckerbussen an der Kreuzung Brompton Road und Sloane Street bewegte sich stockend auf Sloan Square und Chelsea zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
