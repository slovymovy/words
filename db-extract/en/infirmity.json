                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "35e9b4f1-51a3-4d4b-ae35-ef47eda75cf1",
                                "sense_id": "950849f5-3243-3c91-93c1-7b4b882aff14",
                                "text": "physical infirmity"
                            },
                            {
                                "example_id": "c2680241-34dc-4ac3-8aee-84b2e114ce11",
                                "sense_id": "950849f5-3243-3c91-93c1-7b4b882aff14",
                                "text": "mental infirmity"
                            },
                            {
                                "example_id": "c5b1af78-03a9-4549-b709-7aa98150dbc3",
                                "sense_id": "950849f5-3243-3c91-93c1-7b4b882aff14",
                                "text": "suffer from an infirmity"
                            },
                            {
                                "example_id": "96dcb4d9-001c-4ff8-b188-ce933b334a55",
                                "sense_id": "950849f5-3243-3c91-93c1-7b4b882aff14",
                                "text": "He bore the weight of old age and physical infirmity."
                            },
                            {
                                "example_id": "9af1b79e-9ae6-421a-ac8f-72e8c8317706",
                                "sense_id": "950849f5-3243-3c91-93c1-7b4b882aff14",
                                "text": "Despite her infirmity, she remained mentally sharp."
                            }
                        ]
                    },
