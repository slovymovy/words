                ],
                "senses": [
                    {
                        "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                        "entry_id": "4e32280a-4463-30e9-bb12-db6f638de59a",
                        "glosses": [
                            "Froschlurch aus der Gattung der Epidalea innerhalb der Familie der Kröten"
                        ],
                        "tags": [
                            "Bufonidae"
                        ],
                        "examples": [
                            {
                                "example_id": "21f1a2cd-a110-4bca-a4b7-a05663630bc3",
                                "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                                "text": "„In den letzten Jahrzenten waren Materialabbaugebiete die wichtigsten Sekundärbiotope für die Kreuzkröte.“"
                            },
                            {
                                "example_id": "7d839c67-ef68-48ee-99d4-c75202018a08",
                                "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                                "text": "„Neben überschwemmten Äckern nutzte die Kreuzkröte auch Teile überfluteter Wiesenflächen in der ehemaligen Rheinaue zum Ablaichen.“"
                            },
                            {
                                "example_id": "6513b8ca-4aa8-4508-b40f-f1b107779ad1",
                                "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                                "text": "„Als Pionierart ist die Kreuzkröte an Lebensräume mit hoher Dynamik gebunden, die durch menschlichen Einfluss schnell in ein unbewohnbaren Zustand übergehen.“"
                            },
                            {
                                "example_id": "19918f73-a823-4872-867b-77ab1e819277",
                                "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                                "text": "„Auf der Brache am Pankower Tor lebt das größte und einzige Berliner Vorkommen der streng geschützten Kreuzkröte.“"
                            },
                            {
                                "example_id": "4b6f6590-0c1b-43e0-8ffc-802488395459",
                                "sense_id": "cc43f91e-8ef6-34a7-be7d-23066e3d4cca",
                                "text": "„Die Kreuzkröte ist eine Pionierart, die ursprünglich in offenen Auenlandschaften auf vegetationsarmen, trocken-warmen Standorten mit lockeren, meist sandigen Böden vorkam.“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
