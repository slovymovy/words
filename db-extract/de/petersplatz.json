                    {
                        "form_id": "c0f133fd-f260-4b99-b2ad-a9a2663cfaa9",
                        "entry_id": "4986e6ad-3e0b-32ac-b399-dc307b96f176",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Petersplätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                        "entry_id": "4986e6ad-3e0b-32ac-b399-dc307b96f176",
                        "glosses": [
                            "nach der Lage an einem dem Heiligen Simon Petrus ^(→ WP) geweihten Sakralbau benannter Platz, in Rom, Basel, Wien, München und anderen Orten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96aae01c-19ae-4ff9-a533-6f9f2a1611b3",
                                "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                                "text": "Wir waren an Heiligabend auf dem Petersplatz und haben ein Selfie gemacht."
                            },
                            {
                                "example_id": "f8190af0-270e-49db-b679-ec0889c60cd0",
                                "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                                "text": "„Weißt du, sagte Hugo gedehnt, als wir den Petersplatz durchquerten, all die steinernen Zeichen dieser kirchlichen und weltlichen Macht sind ja nicht entstanden ohne die Ausbeutung der sogenannten kleinen Leute.“"
                            },
                            {
                                "example_id": "5f6b1529-850b-443b-a496-fd485f019c1b",
                                "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                                "text": "„Ich glaube, ich hätte sogar auf dem Petersplatz stundenlang gewartet, in die Hände geklatscht und Evviva gerufen, wenn er ans Fenster gekommen wäre.“"
                            },
                            {
                                "example_id": "efdde13d-b3da-4a76-9625-2b7638e6896e",
                                "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                                "text": "„Und dann sagte ich noch, dass eigentlich jeder zu Fuß über den Petersplatz gehen könne, das könne schließlich jeder, und weil es schließlich jeder könne, brauche es der Papst nicht zu tun.“"
                            },
                            {
                                "example_id": "67a81997-6f34-49cd-b74d-7e25062d61c8",
                                "sense_id": "454043eb-2901-3326-b3de-27623fe5c9c7",
                                "text": "„Während die Petersplätze in Rom, Wien und Basel als geschichtliche, spirituelle und kulturelle Zentren bekannt sind, erweist sich jener Petersplatz in Sankt Peter am Ottersbach als sozialer Treffpunkt für Musikliebhaber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fca7ddca-6b6c-3c55-9149-00517daa4148",
                        "entry_id": "4986e6ad-3e0b-32ac-b399-dc307b96f176",
                        "glosses": [
                            "nach einer anderen historischen Persönlichkeit namens Peter benannter Platz, zum Beispiel ehemals in Sankt Petersburg nach Zar Peter dem Großen ^(→ WP)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd054ac-f5a1-4e38-9529-88165cca08b9",
                                "sense_id": "fca7ddca-6b6c-3c55-9149-00517daa4148",
                                "text": "„Der Englische Quai mündet östlich an der Isaaksbrücke in den Petersplatz, auf welchem sich seitwärts dieser Brücke die kolossale metallene Bildsäule Peters des Großen erhebt; […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
