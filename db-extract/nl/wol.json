                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8db4dd9-edd7-39fa-b772-5b119c20915f",
                                        "entry_id": "a26f2f2d-4908-3e9a-9077-d7bb5766e2fb",
                                        "glosses": [
                                            "Poil long, assez fin et doux, qui croît sur la peau des moutons et de quelques autres mammifères herbivores comme les lapins angora, les chèvres mohair ou cachemire et les lamas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9a1060-b7fb-4f0e-aaf3-7d8dbf45b96d",
                                                "sense_id": "e8db4dd9-edd7-39fa-b772-5b119c20915f",
                                                "text": "Les moutons transhumants portent, attachés leur laine, de nombreuses graines de la plaine vers la montagne et surtout de la montagne vers la plaine ; […]."
                                            },
                                            {
                                                "example_id": "a31ca162-7fe5-4d46-b29d-3c269466636d",
                                                "sense_id": "e8db4dd9-edd7-39fa-b772-5b119c20915f",
                                                "text": "La laine est le poil de différents animaux : majoritairement mouton, mais aussi chèvre (races Angora ou Mohair, Kashmir), petits camélidés (alpaga, vigogne et lama) et grands camélidés (dromadaire et chameau)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20d526f-8bac-30dd-9967-d53062216cab",
                                        "entry_id": "a26f2f2d-4908-3e9a-9077-d7bb5766e2fb",
                                        "glosses": [
                                            "Fil obtenu à partir de ce poil pour être tissé, tricoté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86330992-343e-4785-b949-65671dd92e4e",
                                                "sense_id": "a20d526f-8bac-30dd-9967-d53062216cab",
                                                "text": "La laine est un des principaux articles d’exportation. Une certaine quantité en reste dans le pays, où elle sert à rembourrer les matelas qui tiennent une place prépondérante dans l'ameublement des maisons marocaines, et à la confection de couvertures, de tapis et de certains vêtements indigènes : du haïk, de la jellaba, du selham."
                                            },
                                            {
                                                "example_id": "443af19d-1b74-4bf8-8ff9-fa017d07dd7a",
                                                "sense_id": "a20d526f-8bac-30dd-9967-d53062216cab",
                                                "text": "La laine est une fibre animale constituée à base de kératine qui rétrécit par feutrage, ce qui signifie que ses petites écailles s'entrelacent sous l'effet de la chaleur et du frottement, rendant les vêtements bien plus denses et visiblement plus petits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f4072d5-f20f-33bd-bc31-33284a335463",
                                        "entry_id": "a26f2f2d-4908-3e9a-9077-d7bb5766e2fb",
                                        "glosses": [
                                            "Vêtement obtenu à partir de ce fil et qui tient chaud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b70a06-a588-4182-9fd7-87424acc28cc",
                                                "sense_id": "7f4072d5-f20f-33bd-bc31-33284a335463",
                                                "text": "J’aurais dû apporter une petite laine, il fait frisquet !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e8316a-f1a9-3f79-930f-270216c437f2",
                                        "entry_id": "a26f2f2d-4908-3e9a-9077-d7bb5766e2fb",
                                        "glosses": [
                                            "Poil long qui recouvre certaines parties de plantes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5030bc21-a4c3-37f8-bb2f-b32a016a2ac0",
                                        "entry_id": "a26f2f2d-4908-3e9a-9077-d7bb5766e2fb",
                                        "glosses": [
                                            "Cheveux épais et crépus."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
