                ],
                "senses": [
                    {
                        "sense_id": "9139830d-d45a-3b78-b352-3685096a1349",
                        "entry_id": "179f3b5b-dc46-3f75-8fa0-072fa320a0ed",
                        "glosses": [
                            "nicht dem Konzept der Zeit unterworfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "422e7a9e-aded-4c94-8481-940cc77f83a1",
                                "sense_id": "9139830d-d45a-3b78-b352-3685096a1349",
                                "text": "„Die Dinge an sich und ihre Beziehungen sind nicht bloß wegen ihrer Allgemeingültigkeit für alle Denkenden oder wegen ihrer Objektivität überzeitlich, sondern im strengen Sinne außerzeitlich.“"
                            },
                            {
                                "example_id": "4fab7ae8-75ba-45a2-8ebd-c9ee68aebe86",
                                "sense_id": "9139830d-d45a-3b78-b352-3685096a1349",
                                "text": "„Die rechtlichen Gebilde, die REINACH im Auge hat, existieren zwar im Verhältnis bestimmter Personen, zu einer bestimmten Zeit; ihre Strukturformen aber haben ein außerzeitliches Sein […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
