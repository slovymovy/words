                                "target_senses": [
                                    {
                                        "sense_id": "04ebe0f4-0a4a-3a24-afee-43500ab3102b",
                                        "entry_id": "0413827f-3433-3030-b5d0-3ce2e9d2acae",
                                        "glosses": [
                                            "Person, die einem Radioprogramm oder sonstigen Sprechern zuhört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0fa44b-2ec3-4a02-bab5-cad3288c06d7",
                                                "sense_id": "04ebe0f4-0a4a-3a24-afee-43500ab3102b",
                                                "text": "Das Programm ist bei den Hörern sehr beliebt."
                                            },
                                            {
                                                "example_id": "cffd99bc-cda5-4f36-b8dc-ec2267397607",
                                                "sense_id": "04ebe0f4-0a4a-3a24-afee-43500ab3102b",
                                                "text": "„Bis hierher hat die Hörerin oder der Hörer dieses Witzes vielleicht gelächelt, weil sie oder er für sich die fehlende Verbindung schon hergestellt hat, ja herstellen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09fae198-87c8-3403-b6de-92386267c263",
                                        "entry_id": "0413827f-3433-3030-b5d0-3ce2e9d2acae",
                                        "glosses": [
                                            "jemand, der eine Vorlesung besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7765f9f7-ce6a-4971-aac8-2c98876c3ffd",
                                                "sense_id": "09fae198-87c8-3403-b6de-92386267c263",
                                                "text": "Professor Puvogel war bei den Hörern seiner Vorlesung sehr beliebt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                        "entry_id": "0413827f-3433-3030-b5d0-3ce2e9d2acae",
                                        "glosses": [
                                            "kurz für Geräte, mit denen man hören kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cda8e4-f1be-4513-ae9c-87179d1d26ee",
                                                "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                                "text": "Nimm den Hörer ab!"
                                            },
                                            {
                                                "example_id": "033730ad-a0d7-4bfe-a6fd-7fbbce9ef07f",
                                                "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                                "text": "„Sie legte den Hörer auf.“"
                                            },
                                            {
                                                "example_id": "d0b0af5f-e2a2-495c-8ce9-f7c700142244",
                                                "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                                "text": "„Ich ließ den Hörer auf die Gabel fallen.“"
                                            },
                                            {
                                                "example_id": "a972addf-cc8d-4a07-bcbe-e0577edfd292",
                                                "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                                "text": "„Dann piept es im Hörer.“"
                                            },
                                            {
                                                "example_id": "378d98a7-f287-4c30-aadb-6c820ba3198c",
                                                "sense_id": "5af9762a-e7be-374d-bd4c-545eac7e659d",
                                                "text": "„Er legte den Hörer auf die Gabel und ging im Zimmer mehrere Male auf und ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
