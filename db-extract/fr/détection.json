                                    {
                                        "sense_id": "5918729a-fb1a-3d51-94ef-7dbcfda3de62",
                                        "entry_id": "2d2af5b3-1e13-3d60-940b-12ab2f81f6e3",
                                        "glosses": [
                                            "das Finden, nach einer gezielten Suche nach etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902bfb73-37ff-4a34-b66c-220049fff542",
                                                "sense_id": "5918729a-fb1a-3d51-94ef-7dbcfda3de62",
                                                "text": "„Mit dem Aufspüren und Vernichten bösartig veränderten Gewebes ist unser Immunsystem offenbar zuweilen überfordert.“"
                                            },
                                            {
                                                "example_id": "db504059-44e5-48c9-b867-318df3ed31cf",
                                                "sense_id": "5918729a-fb1a-3d51-94ef-7dbcfda3de62",
                                                "text": "„Charakteristisch sind die Grubenorgane, beidseitige Vertiefungen zwischen Nasenloch und Auge, die als Temperatursinnesorgane auch im Dunkeln ein räumliches Bild warmblütiger Tiere liefern und zum Aufspüren der Beute dienen.“"
                                            },
                                            {
                                                "example_id": "25491860-6da7-4271-9fe0-69f46c18e746",
                                                "sense_id": "5918729a-fb1a-3d51-94ef-7dbcfda3de62",
                                                "text": "„Angesichts der langwierigen Suche nach dem Flugzeug der Malaysia Airlines will der Weltluftfahrtverband IATA die Chancen eines Aufspürens in solchen Fällen verbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
