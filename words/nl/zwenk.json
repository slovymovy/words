                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "change of direction"
                            },
                            {
                                "target_lang_word": "veetering",
                                "target_lang_sense_clarification": "sudden deviation or shift"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "sweeping turn or movement"
                            }
                        ]
                    }
                }
            ]
        },
        {
