                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horseman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd2446c-1cb9-3575-9e50-c3d85391df09",
                                        "entry_id": "4ba58da5-21dc-38b0-888d-fa331ceea0da",
                                        "glosses": [
                                            "A man who rides a horse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70e8088c-2dee-308b-a38e-9d06b31d67b6",
                                        "entry_id": "4ba58da5-21dc-38b0-888d-fa331ceea0da",
                                        "glosses": [
                                            "A soldier on horseback, especially a cavalryman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca08aaba-7ab6-4acb-93a7-0d22d4bc079b",
                                                "sense_id": "70e8088c-2dee-308b-a38e-9d06b31d67b6",
                                                "text": "A thouſand Perſean horſemen are at hand,\nSent from the King to ouercome vs all."
                                            },
                                            {
                                                "example_id": "829e5a34-738b-4e67-87ec-5582291bd5cc",
                                                "sense_id": "70e8088c-2dee-308b-a38e-9d06b31d67b6",
                                                "text": "A royal grave (dated seventh century B.C.) still shows vital details of the conditions of warrior horsemen in their formative phase. This is the grave at Arzan in Tuwa, opened under the guidance of the Nestor of Siberian archeology, M. P. Grjaznov."
                                            },
                                            {
                                                "example_id": "d659af75-3af9-4938-96d6-412418758da6",
                                                "sense_id": "70e8088c-2dee-308b-a38e-9d06b31d67b6",
                                                "text": "At this, the Shan-yü, leading over 100,000 horsemen through the fortifications, entered at the fortification of Wu-chou 武州."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9092f93c-10ed-3f40-8452-618644bf7a28",
                                        "entry_id": "4ba58da5-21dc-38b0-888d-fa331ceea0da",
                                        "glosses": [
                                            "A man skilled in horsemanship, especially an equestrian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "586a9e7a-d680-3ad1-93d6-ae2fc776ce80",
                                        "entry_id": "4ba58da5-21dc-38b0-888d-fa331ceea0da",
                                        "glosses": [
                                            "A man in charge of work horses; a teamster."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6291368b-7153-39e4-9f38-cecfe5318e0f",
                                        "entry_id": "4ba58da5-21dc-38b0-888d-fa331ceea0da",
                                        "glosses": [
                                            "A man in charge of transport horses; a hostler (ostler)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
