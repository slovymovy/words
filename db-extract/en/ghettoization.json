                "senses": [
                    {
                        "sense_id": "bfbe74c9-bd76-3c62-8352-32bbd3cd88ea",
                        "entry_id": "30f9d9a5-732c-31aa-8c99-7fc8e8ebe0cc",
                        "glosses": [
                            "The process of becoming a ghetto, an isolated and underprivileged urban area."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9371dc7b-2c67-4136-afa5-9cd159ed697d",
                                "sense_id": "bfbe74c9-bd76-3c62-8352-32bbd3cd88ea",
                                "text": "It's all part of a move toward ghettoization, they charge, an attempt to make the poor feel so shamefully unwanted that they will leave the area."
                            }
                        ]
                    },
                    {
                        "sense_id": "35121929-e871-30de-bb6e-6df05b847f71",
                        "entry_id": "30f9d9a5-732c-31aa-8c99-7fc8e8ebe0cc",
                        "glosses": [
                            "The process of ghettoizing (a group): the segregation/isolation of a group and placement of that group into a figurative or literal position of little power."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c32ada51-880c-4be6-8b0c-ab9eb6c74c3a",
                        "source_entry_id": "30f9d9a5-732c-31aa-8c99-7fc8e8ebe0cc",
                        "source_sense_description": "Translations",
                        "target_lang_word": "ghettoïsation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ghettoïsation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7edcf11-f918-3ff3-b8e9-78b2995793b5",
                                        "entry_id": "1cef23c9-b11a-3af5-b1a6-64e11c7aede7",
                                        "glosses": [
                                            "Structuration de l'espace en divers ghettos ou en divers groupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35c8a0b9-324f-4106-9a31-2ec0dbe6a720",
                                                "sense_id": "e7edcf11-f918-3ff3-b8e9-78b2995793b5",
                                                "text": "Les liens avec la parentèle sont maintenus et servent de relais aux nouveaux venus – et l’on n’oubliera pas les phénomènes connexes de ghettoïsation qui peuvent alors les accompagner, y compris dans les villes occidentales, où ils peuvent justement servir de base au développement de rapports de production très éloignés du salariat proprement dit, en fait plus proches de l’esclavage…"
                                            },
                                            {
                                                "example_id": "530aa7eb-0312-48f7-a727-32d9e17ca7ca",
                                                "sense_id": "e7edcf11-f918-3ff3-b8e9-78b2995793b5",
                                                "text": "Et c’est ainsi que notre République glisse vers le communautarisme, vers la « ghettoïsation » pour user d’un horrible néologisme."
                                            },
                                            {
                                                "example_id": "e89acd08-221f-48c0-81d6-f38769dbe565",
                                                "sense_id": "e7edcf11-f918-3ff3-b8e9-78b2995793b5",
                                                "text": "Toutefois, cela ne suffira pas à endiguer la violence si on ne s’attaque pas aux inégalités sociales, au communautarisme et à la ghettoïsation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62325a7a-3dc9-4768-b403-66fc070f26a9",
                        "source_entry_id": "30f9d9a5-732c-31aa-8c99-7fc8e8ebe0cc",
                        "source_sense_description": "Translations",
