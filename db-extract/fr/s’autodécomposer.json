                ],
                "senses": [
                    {
                        "sense_id": "b3c3367c-aee5-3212-92d0-35e861a42255",
                        "entry_id": "4be8f588-a7bb-37ee-a349-39e496492bb4",
                        "glosses": [
                            "Se décomposer de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "224705d9-3c17-41dc-bbbe-a45d86cab0ec",
                                "sense_id": "b3c3367c-aee5-3212-92d0-35e861a42255",
                                "text": "C'est un gaz inflammable, même sans être mélangé à l'air, qui peut s'autodécomposer en explosant."
                            },
                            {
                                "example_id": "7a1a4f9d-f739-47e8-8167-d94558fb4e94",
                                "sense_id": "b3c3367c-aee5-3212-92d0-35e861a42255",
                                "text": "Alors on choisit de laisser le temps avancer, de laisser les choses s'autodécomposer."
                            },
                            {
                                "example_id": "67c3b186-9077-4e76-adf5-25d9ce572861",
                                "sense_id": "b3c3367c-aee5-3212-92d0-35e861a42255",
                                "text": "arrête-flammes utilisés pour des mélanges explosifs de vapeurs et de gaz qui ont tendance à s'autodécomposer (par exemple l'acétylène) ou qui sont chimiquement instables;"
                            }
                        ]
                    }
