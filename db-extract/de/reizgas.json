                "senses": [
                    {
                        "sense_id": "2e78c4f8-8968-360a-9580-f746b35857d5",
                        "entry_id": "c989dbc7-8e09-324b-a4e5-6cb2349585b3",
                        "glosses": [
                            "Gas, das bei Kontakt den Körper, insbesondere das Atemsystem und Augenbindehaut, zu einer Reaktion veranlasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a6bf15-e75f-4a06-a9dc-fc865fe75bb9",
                                "sense_id": "2e78c4f8-8968-360a-9580-f746b35857d5",
                                "text": "„Während ihres Fitnesstrainings sah gelegentlich ein muskelbepackter, kahlköpfiger Mann in Windjacke und Cargohose zu ihr herein, der ansonsten draußen in der Zufahrt blieb; er trug eine Beretta im Holster an einem taktischen Gürtel, ebenso ein Paar Handschellen, Reizgas und ein Funkgerät.“"
                            },
                            {
                                "example_id": "a495409e-ad18-4288-ba48-d146af81fd6b",
                                "sense_id": "2e78c4f8-8968-360a-9580-f746b35857d5",
                                "text": "„Er hielt einen Schlagstock in der Hand und führte einen Behälter Reizgas am Gürtel mit sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
