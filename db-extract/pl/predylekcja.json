                                                "example_id": "9ee604e6-1b58-488b-ac1f-4949a82476f2",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "Ich habe eine Vorliebe für Sachbücher über Physik."
                                            },
                                            {
                                                "example_id": "5dea4d2a-baab-4cf2-8ebf-fe3a3a9d0987",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "Ihre persönlichen Vorlieben interessieren mich nicht."
                                            },
                                            {
                                                "example_id": "8769cf9d-7874-4e12-861e-e523dbdabc5e",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "Sie isst mit Vorliebe Schokoladeneis."
                                            },
                                            {
                                                "example_id": "bb843b6c-68d4-487e-85a2-f882a99e6a05",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "Meine Großmutter hört mit Vorliebe Rockmusik."
                                            },
                                            {
                                                "example_id": "3ca78203-1059-43a8-8b2f-688a8ad2ffb2",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "„Die neugierige Vorliebe für das andere Geschlecht teilten die Brüder.“"
                                            },
                                            {
                                                "example_id": "e9768ba5-05ca-4dd3-a414-ee3a64288d5b",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "„Wie Johann hatte Hildegard eine hohe Meinung von sich selbst und eine Vorliebe für die sogenannte Eleganz.“"
                                            },
                                            {
                                                "example_id": "eb6c281e-905e-45ba-b21e-6af86843c4f5",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "„Es ist längst keine Frage der privaten Vorliebe mehr, ob man die Musik von Miles Davis schätzt oder nicht.“"
                                            },
                                            {
                                                "example_id": "5458dc94-0fb4-46f3-90ca-53178702752c",
                                                "sense_id": "c8218fc6-6db0-377a-a3a3-fd7c66374cc3",
                                                "text": "„Mit besonderer Vorliebe nimmt die Kritik indes mitmenschliche Schwächen und Fehler jedweder Art aufs Korn, und hier gewinnt der Begriff seinen negativen Beiklang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
