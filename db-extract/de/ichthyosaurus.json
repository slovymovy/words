                "senses": [
                    {
                        "sense_id": "e5d51ea3-b8d3-3020-92c9-ec90c119fe8e",
                        "entry_id": "4d6163b0-6c23-3d16-b18a-8d7204c6547d",
                        "glosses": [
                            "ausgestorbenes, im Meer lebendes Lebewesen vom Typ Reptil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a730862e-f1f8-47e5-81c8-adb18827e3c2",
                                "sense_id": "e5d51ea3-b8d3-3020-92c9-ec90c119fe8e",
                                "text": "„Es flog mit den krallenbewehrten Schwingen des Pterodaktylus, es schwamm in den lauen Meeren mit der gewaltigen, sich windenden Masse eines Ichthyosaurus, es brüllte plump mit der gepanzerten Kehle eines vergessenen Behemoths den riesigen Mond an, der durch liassische Nebel brannte.“"
                            },
                            {
                                "example_id": "08309ec1-698b-4d4b-bcc8-73c66d3e88fa",
                                "sense_id": "e5d51ea3-b8d3-3020-92c9-ec90c119fe8e",
                                "text": "„Statt dessen hofften sie, den Wirbelknochen eines Hippopotamus oder Ichthyosaurus zu finden, jedenfalls irgendeinen Knochen aus der Zeit der Sintflut, als sie in Mannshöhe an der Klippe Umrisse entdeckten, welche die geschweifte Form eines riesenhaften Fisches hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
