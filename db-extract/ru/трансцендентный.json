                        "sense_id": "679f806c-b495-3d9b-8144-e8b8a6f00e47",
                        "entry_id": "76876ccb-a779-3346-9938-36b92296bf40",
                        "glosses": [
                            "transcendent (lying beyond the limits of experience)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc81f1f-f976-404e-8c64-52c521ffc5bc",
                                "sense_id": "679f806c-b495-3d9b-8144-e8b8a6f00e47",
                                "text": "трансценде́нтная и́стина",
                                "translation": "transcendent truth",
                                "english": "transcendent truth"
                            },
                            {
                                "example_id": "00127c89-70bc-4e4c-8582-14df3f228502",
                                "sense_id": "679f806c-b495-3d9b-8144-e8b8a6f00e47",
                                "text": "— Я всегда удивляюсь ясности и точности выражений вашего мужа, — сказала она. — Самые трансцендентные понятия становятся мне доступны, когда он говорит.",
                                "translation": "\"I'm always amazed at the clearness and precision of your husband's language,\" she said. \"The most transcendental ideas seem to be within my grasp when he's speaking.\"",
                                "english": "\"I'm always amazed at the clearness and precision of your husband's language,\" she said. \"The most transcendental ideas seem to be within my grasp when he's speaking.\""
                            }
                        ]
