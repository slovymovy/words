                "senses": [
                    {
                        "sense_id": "d5764072-773c-3baa-9451-d0a3e6fd8421",
                        "entry_id": "0e2eb863-cc55-3a34-84b8-db1e76fa69de",
                        "glosses": [
                            "Konzept/Plan für die Durchführung eines bestimmten Geschäfts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82f6a80-74f9-46eb-9fb5-ce0c2f976670",
                                "sense_id": "d5764072-773c-3baa-9451-d0a3e6fd8421",
                                "text": "„Für die soziale Frage hat Düsterdick ein anderes Geschäftsmodell im Angebot.“"
                            },
                            {
                                "example_id": "ce61e994-4a2b-4b65-92d8-32fec4504fb4",
                                "sense_id": "d5764072-773c-3baa-9451-d0a3e6fd8421",
                                "text": "„Der erneute Drehstopp ist nicht die einzige Widrigkeit für die Sexfilmer: Neben der Kostenlos-Kultur im Internet bedroht auch noch eine Neuregelung im Bezirk Los Angeles ihr Geschäftsmodell. Dort sind Pornodarsteller nun gesetzlich verpflichtet, sich beim Dreh mit Kondomen zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1995a04f-6747-47e3-b6bf-34465d5eea0c",
                        "source_entry_id": "0e2eb863-cc55-3a34-84b8-db1e76fa69de",
                        "source_sense_id": "d5764072-773c-3baa-9451-d0a3e6fd8421",
                        "source_sense_description": "Konzept/Plan für die Durchführung eines bestimmten Geschäfts",
                        "target_lang_word": "business model",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "business model",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbadae83-9a9b-3be5-b6d1-7de78d2b066b",
                                        "entry_id": "1b89ce7e-3c60-3acf-ac6b-c46cf4f39313",
                                        "glosses": [
                                            "The particular way in which a business ensures that it generates income, one that includes the choice of offerings, strategies, infrastructure, organizational structures, trading practices, and operational processes and policies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b033f913-60f9-4f35-923e-63423ddff8f3",
                                                "sense_id": "cbadae83-9a9b-3be5-b6d1-7de78d2b066b",
                                                "text": "The venture capitalist Chris Dixon told me, “They [YC] created the greatest business model of all time. For basically no money[…]they get seven per cent of a lot of the best startups in Silicon Valley!”"
                                            },
                                            {
                                                "example_id": "03d310a2-3ce0-4416-bc40-b847896d2d7b",
                                                "sense_id": "cbadae83-9a9b-3be5-b6d1-7de78d2b066b",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            },
                                            {
                                                "example_id": "14a7cdc3-aee3-45f8-9856-ef25c64035ab",
                                                "sense_id": "cbadae83-9a9b-3be5-b6d1-7de78d2b066b",
                                                "text": "Between 1997 and 2006, ownership of Glenfeshie passed between three Danish businessmen – and with it a self-destructive business model. Only by maintaining very high numbers of livestock could the flow of fee-paying deerstalkers armed with rifles be ensured, but because of the rising cost of gamekeepers and estate upkeep, Glenfeshie’s sporting operations were still making a loss."
                                            },
                                            {
                                                "example_id": "7014ff41-959e-4e46-b414-e17f79f013cb",
                                                "sense_id": "cbadae83-9a9b-3be5-b6d1-7de78d2b066b",
                                                "text": "The typical business model relies on a line operating intensively from March or April through to September or October, before shutting down during the winter months - at which point essential repairs and maintenance can take place using income accrued during the busy summer months, ahead of the cycle starting over again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
