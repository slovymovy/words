                "senses": [
                    {
                        "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                        "entry_id": "2fb82b2b-8ec0-3fd3-b487-832f9681ac9b",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaff561-e9ba-4b68-9dbe-a092ef12de23",
                                "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                                "text": "„Entsprechend wurden die Messen in der Altenheimkapelle auch von Kapuzinerpatres gelesen.“"
                            },
                            {
                                "example_id": "74563de0-79f1-4437-82f2-a4354b8aeb6b",
                                "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                                "text": "„Am Freitag, 27. Februar, um 14 Uhr wird nun in einem Requiem in der Altenheimkapelle des Toten gedacht.“"
                            },
                            {
                                "example_id": "740e3631-d79a-4d6a-96f6-050b1f4df5a4",
                                "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                                "text": "„Nachdem ihr Geburtstag in diesem Jahr auf einen Sonntag fiel und sie sonntags ohnehin am Gottesdienst in der Altenheimkapelle teilzunehmen pflegt, bot es sich an, beides miteinander zu verbinden.“"
                            },
                            {
                                "example_id": "b38e66b4-ed41-4523-94dc-96dabc49d041",
                                "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                                "text": "„Seit vielen Jahren bereits gehört es zur Aufgabe der Kreativen Gruppe den Adventskranz für die Altenheimkapelle zu binden.“"
                            },
                            {
                                "example_id": "c0ade177-1b9e-4ad3-a02f-75d73d40cfcb",
                                "sense_id": "de803958-a17b-3ef6-87e4-710cd261c9f6",
                                "text": "„In der Altenheimkapelle werden regelmäßig Messen gelesen und Rosenkranzandachten und Anbetung gehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
