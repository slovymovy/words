                ],
                "senses": [
                    {
                        "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                        "entry_id": "4d9ada17-ae76-3b95-bd3c-392d6a663aa8",
                        "glosses": [
                            "ein an der Handwurzel palmar liegender Durchgang für Nerven und Sehnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1abc8881-d571-4ccb-b890-66cf852f1575",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Bei Karpaltunnel handelt es sich um einen osteofibrösen Kanal, dessen posteriorer Anteil von den Handwurzelknochen gebildet wird."
                            },
                            {
                                "example_id": "6470e743-5d2f-465c-a5b5-ef378bc5aaaf",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Im transversalen Schnitt ist der Karpaltunnel oval."
                            },
                            {
                                "example_id": "0d89497b-123f-4407-86bb-3ffab34cc48c",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Im Karpaltunnel finden sich die 9 Beugesehnen der Finger und ihre synovialen Hüllen."
                            },
                            {
                                "example_id": "e6c6a4cc-7d63-4340-984e-186e1be2cbb8",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Am Handgelenk laufen die Fingerbeugesehnen durch den Karpaltunnel, der von den Handgelenkknochen und einem bindegewebigen Band, einem Ligament, begrenzt wird."
                            },
                            {
                                "example_id": "f5532b92-8726-4ca4-b27f-1d6881d3f162",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Der N. medianus wirkt hier auch bei normalen Verhältnissen im Vergleich zum proximalen Karpaltunnel abgeflacht."
                            },
                            {
                                "example_id": "193cab49-f82d-470e-ab99-273df6888b22",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Bei ausgeprägter Symptomatik kann durch Beklopfen des Nervenstammes an seinem Eintritt in den Karpaltunnel eine elektrisierende Missempfindung […] ausgelöst werden."
                            },
                            {
                                "example_id": "c28b4eed-6935-4149-8026-ec6df786a845",
                                "sense_id": "d699b67c-59c5-32c5-8ac7-dac8f1ea46ba",
                                "text": "Durch die fortgesetzte Reizung verdickt sich das Retinaculum flexorum, was zu einer noch stärkeren Kompression des Weichteilgewebes im Karpaltunnel führt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
