                        "sense_id": "4cf6a5f8-37b7-3df3-90eb-5f58487cc771",
                        "entry_id": "18c1591a-c116-330c-a294-bf1758395883",
                        "glosses": [
                            "Traumatiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228ab829-6984-40aa-846c-466ad4aff3a5",
                                "sense_id": "4cf6a5f8-37b7-3df3-90eb-5f58487cc771",
                                "text": "La répétition vient retraumatiser le sujet mais il a l'avantage de créer un écart avec le trauma."
                            },
                            {
                                "example_id": "fa1c1ed7-a53d-4af5-ace3-16ecdafa96dc",
                                "sense_id": "4cf6a5f8-37b7-3df3-90eb-5f58487cc771",
                                "text": "Pour LaCapra, la grandeur de ce film n’enlève rien au risque qu'il représente : celui de retraumatiser les victimes et, par un puissant transfert, de transformer en victimes les spectateurs et, plus généralement, toute la génération d’après-guerre."
                            }
                        ]
                    }
