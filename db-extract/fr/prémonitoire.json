                                    {
                                        "sense_id": "d9b99968-5978-3a44-885e-0f0d39b625ed",
                                        "entry_id": "3a8da2bd-08df-396c-bf4b-248fd1a2c2ad",
                                        "glosses": [
                                            "Serving as a warning or premonition."
                                        ],
