                "senses": [
                    {
                        "sense_id": "5e875b9e-626d-3648-8a28-38c032f20e8b",
                        "entry_id": "2d6c1946-8c8e-33f6-aaff-8f22c584fc72",
                        "glosses": [
                            "Petit de l’autruche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90427e44-4471-486c-8e5c-88c05ebc1445",
                                "sense_id": "5e875b9e-626d-3648-8a28-38c032f20e8b",
                                "text": "Ce plumage n’est pas le même à toutes les périodes, car l’apparence de l’oiseau varie considérablement entre sa condition d’autruchon et celle d’adulte, par suite de différences dans la couleur et dans d’autres caractères des plumes."
                            },
                            {
                                "example_id": "960caab5-b020-469b-acd4-cae19080e91e",
                                "sense_id": "5e875b9e-626d-3648-8a28-38c032f20e8b",
                                "text": "Le palan Artibaud se répandit jusqu’en Turquie. Et un amiral ottoman, couvert de plumes comme une autruchon, en félicite encore le vieux monsieur Artibaud sur un quai du port de Salonique, dans une photographie jaunie."
                            }
                        ]
                    }
