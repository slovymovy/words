                    {
                        "translation_id": "62796d83-c9ee-4469-a6b3-b8e81b040836",
                        "source_entry_id": "037b7d70-009c-39a6-b7cd-cbce32050d7c",
                        "source_sense_id": "3c7f1408-c250-33e2-8959-baf18fa8181e",
                        "target_lang_word": "waterline",
