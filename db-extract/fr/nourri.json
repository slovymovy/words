                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qui reçoit, qui a reçu de la nourriture."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0551fda-a9f5-3f84-82a7-0d00eff0da6d",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qualifie un grain qui est bien plein, bien rempli."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0670aedc-d5db-4195-90be-c5e26fac8bee",
                                "sense_id": "e0551fda-a9f5-3f84-82a7-0d00eff0da6d",
                                "text": "Ce blé, ce grain est bien nourri."
                            }
                        ]
                    },
                    {
                        "sense_id": "33c67ee2-9c07-3a7d-ad46-073619e09c8b",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qualifie un style riche, plein, abondant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a8e5d25c-7b5c-3dc4-951a-449c0012c6d8",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Où abondent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2189fb4-2076-440b-b188-015219e60404",
                                "sense_id": "a8e5d25c-7b5c-3dc4-951a-449c0012c6d8",
                                "text": "Un ouvrage nourri de pensées, de réflexions. - Un écrivain nourri des bons auteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ca86b86-3caa-3d47-9716-063b22db197d",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qualifie une couleur bien empâtée, un trait qui n’est pas trop fin."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "33dbdf34-b526-36e3-83c0-ad376f847f3d",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qualifie une lettre dont les traits qui la forment ont beaucoup de corps."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a1c535f5-0947-39ef-b943-7cf05821845e",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Qualifie une fusillade, une canonnade violente, des applaudissements importants, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5ae55b-b049-454a-b87c-684ccccab44b",
                                "sense_id": "a1c535f5-0947-39ef-b943-7cf05821845e",
                                "text": "Être pris sous le feu nourri des canons ennemis."
                            },
                            {
                                "example_id": "e7de9657-ef42-491b-904a-fe60848235cf",
                                "sense_id": "a1c535f5-0947-39ef-b943-7cf05821845e",
                                "text": "Cette approche, l’électrochimiothérapie, a été saluée par les applaudissements nourris de la communauté des cancérologues venus des quatre coins de la planète."
                            }
                        ]
                    },
                    {
                        "sense_id": "23c04a88-930b-38c5-b9bb-165a3f1173dd",
                        "entry_id": "3633d12d-f0d7-3166-a9cb-d3e5ca0e4b53",
                        "glosses": [
                            "Se dit d’une plante sans pied. Voir au pied nourri."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
