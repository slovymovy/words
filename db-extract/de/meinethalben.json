                "senses": [
                    {
                        "sense_id": "447159b7-e8f9-3e0b-8b64-4bc6dcd8060e",
                        "entry_id": "86437f76-6a6a-3644-a278-1158b2a13a54",
                        "glosses": [
                            "aus einem mich betreffenden Grunde"
                        ],
                        "tags": [
                            "bezieht den Grund auf die erste Person Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "23cabc53-4164-4a83-84fb-164d08313fa4",
                                "sense_id": "447159b7-e8f9-3e0b-8b64-4bc6dcd8060e",
                                "text": "Er sitzt meinethalben im Gefängnis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f9331d9-d5f5-3a74-a852-a9ff7308e90b",
                        "entry_id": "86437f76-6a6a-3644-a278-1158b2a13a54",
                        "glosses": [
                            "um mir gut zu tun, für mich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace6c6c6-3926-4593-9107-f57932e549a1",
                                "sense_id": "7f9331d9-d5f5-3a74-a852-a9ff7308e90b",
                                "text": "„Vielleicht führt dich dann Gott, der Herr, ins Paradies zurück, / ist Gott, der Herr, doch meinethalben über dich in Zorn geraten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc3532f3-a892-3dd8-a968-9db2b1b3ad03",
                        "entry_id": "86437f76-6a6a-3644-a278-1158b2a13a54",
                        "glosses": [
                            "weil ich es erlaube, nichts dagegen habe; oft als Interjektion"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d92650b8-e728-488e-9fac-8c777ad53fc6",
                                "sense_id": "dc3532f3-a892-3dd8-a968-9db2b1b3ad03",
                                "text": "Ich würde dir raten, dort nicht hinzugehen, aber meinethalben kannst du auch gehen, wenn du meinst, es wäre besser für dich."
                            },
                            {
                                "example_id": "aeb18a69-3ee8-4b05-91f6-9e7fd291cc55",
                                "sense_id": "dc3532f3-a892-3dd8-a968-9db2b1b3ad03",
                                "text": "Für mich wäre es am besten, wenn wir uns nächsten Sonntag wieder treffen können, meinethalben auch erst am späten Abend."
                            },
                            {
                                "example_id": "93a3d8fa-2de9-443e-b8fa-2061b16cae03",
                                "sense_id": "dc3532f3-a892-3dd8-a968-9db2b1b3ad03",
                                "text": "‚Sei doch bitte schon um sechs Uhr da, wir müssen noch das Essen bereiten.‘ – ‚Meinethalben‘."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
