        "fr-extract.jsonl": [
            {
                "entry_id": "f31fec1c-e8f4-35e7-a0ca-935bb7351683",
                "word": "transversalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                        "entry_id": "f31fec1c-e8f4-35e7-a0ca-935bb7351683",
                        "glosses": [
                            "D’une manière transversale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d20ac3a5-d418-49f7-9c5f-4f75948af814",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "On a donné à cet oiseau le nom de roi des gobe-mouches, à cause de la belle couronne qu’il porte sur la tête et qui est posée transversalement,"
                            },
                            {
                                "example_id": "ec23442e-5fd0-4d83-8535-76a5f67d212b",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "Quand on coupe le polype transversalement, c’est à peu près comme si l’on coupait un sac ou un boyau transversalement,"
                            },
                            {
                                "example_id": "e4f3bfce-3cdd-46db-ae3d-c07208bdf917",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "… ; son crâne chauve et transversalement sillonné de rides nombreuses retombait en quart de cercle sur son visage et le rapetissait ; …."
                            },
                            {
                                "example_id": "41b23ae0-5676-419b-a77e-b527943359fe",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "Le chasseur et l’astronome, chargeant la bête au moyen d’un bâton transversalement placé sur leurs épaules, quittèrent les sommets de la cataracte, …."
                            },
                            {
                                "example_id": "6cd12416-aa3e-4945-a9a8-658fa7d2e140",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "Chaque bâtonnet est une cellule capable de s'allonger, puis de se diviser transversalement par le milieu en deux bâtonnets qui se séparent et se divisent à leur tour en peu de temps."
                            },
                            {
                                "example_id": "d5c5a7b2-163d-4ee8-a150-f717f68686c4",
                                "sense_id": "0b34cff4-59dd-3d36-818c-84fff0c75082",
                                "text": "Pour la fabrication des ressorts de forme en feuillard, l'idéal est d'utiliser des feuillards d'épaisseur uniforme, aussi bien longitudinalement que transversalement. De plus, les feuillards doivent avoir une parfaite planéité."
                            }
                        ]
                    }
                ],
