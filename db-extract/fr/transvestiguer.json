                "senses": [
                    {
                        "sense_id": "47424f51-9452-3743-8808-0d63a1cf2054",
                        "entry_id": "77e725e5-79f2-3001-bded-ae0fd1c7aeeb",
                        "glosses": [
                            "Pratiquer la transvestigation, essayer de prouver que les personnalités seraient secrètement transgenres."
                        ],
                        "tags": [
                            "Conspirationnisme",
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "ac8c182b-ae3a-433c-b0e8-d8711f5176a6",
                                "sense_id": "47424f51-9452-3743-8808-0d63a1cf2054",
                                "text": "Les droitardés ont découvert le lolita et leur premier réflexe c'est de nous transvestiguer"
                            },
                            {
                                "example_id": "86a02949-8c58-47e9-a654-52729d93f946",
                                "sense_id": "47424f51-9452-3743-8808-0d63a1cf2054",
                                "text": "j'ai pas besoin de le lire pour savoir qu'elles ont des biais gros comme des pastèques mais bon.. quand on passe sa journée à traquer les moindres méfaits imaginés des personnes trans ou à les transvestiguer hein"
                            },
                            {
                                "example_id": "d767dfef-2f9c-4893-8fcd-48c7e284177d",
                                "sense_id": "47424f51-9452-3743-8808-0d63a1cf2054",
                                "text": "oui, ils l'ont fait pour transvestiguer amanda lear, à tel point que la mairie de décès de sa mère leur a dit d'aller voir ailleurs (aux dernières nouvelles ils ont saisi la CADA pour contester...)"
                            }
                        ]
                    }
                ],
