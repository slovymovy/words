                "senses": [
                    {
                        "sense_id": "733b3484-e212-3fed-9a44-280c7b7231db",
                        "entry_id": "1fa4f0d8-fa00-362c-bcd2-564c8c3022a7",
                        "glosses": [
                            "Celui à qui a été appliquée la peine de la transportation."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f52945b4-78ab-406f-91e2-bd5322e25b3d",
                                "sense_id": "733b3484-e212-3fed-9a44-280c7b7231db",
                                "text": "Trois années après le débarquement des transportés en Algérie, ceux qui justifieront de leur bonne conduite pourront obtenir, à titre provisoire, la concession d’une habitation et d’un lot de terre sur l’établissement."
                            },
                            {
                                "example_id": "b5faabab-a627-4482-b1ca-09a64776d507",
                                "sense_id": "733b3484-e212-3fed-9a44-280c7b7231db",
                                "text": "Globalement, les convois de transportés ont amené pendant huit années, de 1864 à 1872 environ 400 forçats par an, ce que nous avons vu plus haut représenter au moins 5.000 condamnés jugés politiques."
                            }
                        ]
                    }
