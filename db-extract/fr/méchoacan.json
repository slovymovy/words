                "senses": [
                    {
                        "sense_id": "55c46552-22d6-3547-a754-3cce926891a1",
                        "entry_id": "ca5ea086-321d-3181-9502-1376b96664dd",
                        "glosses": [
                            "Ipomée dont la racine nous est apportée du Mexique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5137bc39-84c2-4731-98d6-cf04a6d7819a",
                                "sense_id": "55c46552-22d6-3547-a754-3cce926891a1",
                                "text": "Méchoacan blanc : Rhubarbe blanche (Convolvulus mechoacanna), méchoacanne, scammonée ou bryone d’Amérique, qui a des propriétés analogues à celles du jalap."
                            },
                            {
                                "example_id": "c894598c-4d22-4083-b4c5-e8001f78dba7",
                                "sense_id": "55c46552-22d6-3547-a754-3cce926891a1",
                                "text": "Méchoacan noir : Nom vulgaire du jalap (Mirabilis jalapa, Convolvulus jalapa), aussi appelé belle-de-nuit et merveille du Pérou."
                            },
                            {
                                "example_id": "f3f34db5-e805-4d3a-9dfb-9e713a72d33e",
                                "sense_id": "55c46552-22d6-3547-a754-3cce926891a1",
                                "text": "Méchoacan du Canada : Un des noms vulgaires du Phytolacca decandra (chénopodiacées), dit aussi raisin d’Amérique."
                            }
                        ]
                    }
                ],
