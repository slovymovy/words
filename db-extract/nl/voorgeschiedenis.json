                                "target_senses": [
                                    {
                                        "sense_id": "19ab0acc-eef6-33d2-8292-adcf6361b059",
                                        "entry_id": "5c14efa5-1568-3caf-b374-56b63f982fbc",
                                        "glosses": [
                                            "Pluriel de origine."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffbd6baa-343c-4652-b663-ef35d66c66c4",
                                                "sense_id": "19ab0acc-eef6-33d2-8292-adcf6361b059",
                                                "text": "Cet ouvrage s’adresse à toutes celles et tous ceux qui veulent s’initier au grec ancien (ou y revenir) et découvrir le plaisir de mieux connaître le français en retrouvant ses origines et ses racines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "origines",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a575e34f-4d95-3b05-8c71-687422771938",
                                        "entry_id": "964402ed-8602-3b8e-b2de-c87e5853a320",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’indicatif présent du verbe originer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
