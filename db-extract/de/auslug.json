                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c17be9d5-27c1-4ceb-88a7-2b2b35a803a2",
                                                "sense_id": "8d4b0f01-4676-3fc3-9b7b-8da2f32f78c4",
                                                "text": "¡Qué va! ¡Vamos a joder a esos carajos!"
                                            },
                                            {
                                                "example_id": "9dbbab87-a2f4-473d-819c-84ae012fdf17",
                                                "sense_id": "8d4b0f01-4676-3fc3-9b7b-8da2f32f78c4",
                                                "text": "Y a la caraja ésa en la recepción de la embajada, ¿acaso no la tocaste ni besaste?"
                                            }
                                        ],
