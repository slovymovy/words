                        "tr": "Geniş, çoğunlukla etrafı çevrilmemiş otlatma arazisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пастбище",
                                "target_lang_sense_clarification": "место выпаса"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mera",
                                "target_lang_sense_clarification": "otlatma alanı"
                            },
                            {
                                "target_lang_word": "otlak",
                                "target_lang_sense_clarification": "hayvan otlatılan yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec3a2d50-428f-386e-a5df-06a9b7091053",
                    "sense_definition": "The set of output values that a function can produce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calculate the domain and <w>range</w> of the function.",
                            "target_lang_translations": {
                                "ru": "Вычислите область определения и <w>область значений</w> функции.",
                                "tr": "Fonksiyonun tanım ve <w>değer kümesini</w> hesaplayın."
                            }
                        },
                        {
                            "text": "The <w>range</w> of this data set is quite small.",
                            "target_lang_translations": {
                                "ru": "<w>Разброс</w> этого набора данных довольно мал.",
                                "tr": "Bu veri setinin <w>genişliği</w> oldukça küçüktür."
                            }
                        }
                    ],
                    "antonyms": [
                        "domain"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество выходных значений, которые может принимать функция.",
                        "tr": "Bir fonksiyonun üretebileceği çıktı değerlerinin kümesi."
