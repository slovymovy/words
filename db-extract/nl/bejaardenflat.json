                        "sense_id": "0fbe4539-c556-3acc-92e5-42695a82409b",
                        "entry_id": "1f01052f-8af5-3304-9a88-ff562b85811b",
                        "glosses": [
                            "woning voor mensen met hogere leeftijd die deel uitmaakt van een woongebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34949a00-5620-47b1-bd08-8a3b3a17e432",
                                "sense_id": "0fbe4539-c556-3acc-92e5-42695a82409b",
                                "text": "De vergeten episode van het Russische collectief komt aan het licht in het archief van het Nederlandse CPN-Kamerlid David Wijnkoop (1876-1941). Zijn papieren verhuisden begin jaren zestig uit de Amsterdamse bejaardenflat van zijn weduwe naar het Instituut voor Marxisme-Leninisme in Moskou."
                            }
                        ]
                    }
