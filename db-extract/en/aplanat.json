                    {
                        "sense_id": "1dbcd00f-a52b-393b-befb-b955e9993166",
                        "entry_id": "187e63d3-19e8-3065-a43b-ca18b0f549a1",
                        "glosses": [
                            "A lens that has been corrected for spherical aberration and coma in order to produce a rectilinear image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a2df73-260c-464d-8bc9-8b8d72f2534e",
                                "sense_id": "1dbcd00f-a52b-393b-befb-b955e9993166",
                                "text": "For comparison, an aplanat of a focus catalogued at 16 inches, actually found by experiment to have a focus of 16 11-16 inches, was used."
                            },
                            {
                                "example_id": "1019d597-6e49-4042-b4b2-88b8d261e685",
                                "sense_id": "1dbcd00f-a52b-393b-befb-b955e9993166",
                                "text": "2009, Gérard René Lemaitre, Astronomical Optics and Elasticity Theory, Springer, Astronomy and Astrophysics Library, Corrected 3rd printing, page 11,\n[…] which is totally false since he established the algebraic conditions for thin-lens achromatic aplanats;"
                            },
                            {
                                "example_id": "735c6442-8c9c-4620-86fb-9217cda8f2f9",
                                "sense_id": "1dbcd00f-a52b-393b-befb-b955e9993166",
                                "text": "Some infra-red detectors are sold already embedded in a plastic aplanat."
                            }
                        ]
                    }
                ],
