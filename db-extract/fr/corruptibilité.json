                                "example_id": "42828313-6bce-4130-9ede-3c1784c1caea",
                                "sense_id": "ab217440-8445-31fa-ae95-ce7efc48b80e",
                                "text": "La corruptibilité porte non sur les corruptions d’un régime et de ses expressions, mais sur la nécessité qu’il soit conduit par elles à sa perte et à sa disparition."
                            }
                        ]
