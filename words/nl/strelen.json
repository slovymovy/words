{
    "word_family": [
        "strelend",
        "streling",
        "gestreeld"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5581937-3007-3f90-8d7c-cbbda5822c8d",
                    "sense_definition": "zachtjes met de hand over iets of iemand strijken om genegenheid te tonen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moeder <w>streelde</w> zachtjes de wang van haar slapende kind.",
                            "target_lang_translations": {
                                "en": "The mother gently <w>stroked</w> the cheek of her sleeping child."
                            }
                        },
                        {
                            "text": "Hij hield ervan om over haar zachte haar te <w>strelen</w>.",
                            "target_lang_translations": {
                                "en": "He loved to <w>caress</w> her soft hair."
                            }
                        }
                    ],
                    "synonyms": [
                        "aaien",
                        "liefkozen"
                    ],
                    "common_phrases": [
                        "over de wang strelen",
                        "iemands haar strelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To gently stroke something or someone with the hand to show affection."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to move the hand gently over a surface"
                            },
                            {
                                "target_lang_word": "caress",
                                "target_lang_sense_clarification": "to touch or stroke lovingly or gently"
                            },
                            {
                                "target_lang_word": "pet",
                                "target_lang_sense_clarification": "to stroke an animal or person affectionately"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fbd2a3b-c5d7-3b30-a5ce-cba9859d1dae",
                    "sense_definition": "iets op een aangename manier prikkelen of iemands ego bevestigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn ijdelheid werd met die complimenteuze opmerking enorm <w>gestreeld</w>.",
                            "target_lang_translations": {
                                "en": "His vanity was greatly <w>flattered</w> by that complimentary remark."
                            }
                        },
                        {
                            "text": "De zachte muziek <w>streelde</w> zijn oren na een lange dag werken.",
                            "target_lang_translations": {
                                "en": "The soft music <w>soothed</w> his ears after a long day of work."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefkozen"
                    ],
                    "common_phrases": [
                        "de ijdelheid strelen",
                        "de oren strelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To stimulate something in a pleasant way or to flatter someone's ego."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flatter",
                                "target_lang_sense_clarification": "to praise someone to make them feel good"
                            },
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to encourage or praise someone's ego"
                            },
                            {
                                "target_lang_word": "soothe",
                                "target_lang_sense_clarification": "to provide a pleasant sensation to the senses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58aaf967-0bfb-3eaa-b7a7-f31eb661ae33",
                    "sense_definition": "zichzelf op een zachte manier aanraken of aaien",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In gedachten verzonken <w>streelde</w> zij zich over haar eigen arm.",
                            "target_lang_translations": {
                                "en": "Lost in thought, she <w>stroked</w> her own arm."
                            }
                        },
                        {
                            "text": "Hij begon zich peinzend over de kin te <w>strelen</w>.",
                            "target_lang_translations": {
                                "en": "He began to <w>stroke</w> his chin pensively."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich over de kin strelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To touch or stroke oneself in a gentle manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to move one's hand over one's own body"
                            },
                            {
                                "target_lang_word": "rub",
                                "target_lang_sense_clarification": "to move one's hand back and forth over oneself"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}