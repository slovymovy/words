                {
                    "sense_id": "fcf5e6f0-bb82-33f9-8afd-a15753911101",
                    "sense_definition": "Een levend organisme dat kooldioxide opneemt en zuurstof afgeeft, zoals een bloem, boom of struik.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik geef de <w>plant</w> elke week een beetje water.",
                            "target_lang_translations": {
                                "ru": "Я каждую неделю немного поливаю <w>растение</w>.",
                                "en": "I give the <w>plant</w> a little water every week.",
                                "pl": "Co tydzień daję <w>roślinie</w> trochę wody.",
                                "de": "Ich gebe der <w>Pflanze</w> jede Woche ein bisschen Wasser.",
                                "fr": "Je donne un peu d'eau à la <w>plante</w> chaque semaine.",
                                "it": "Do un po' d'acqua alla <w>pianta</w> ogni settimana.",
                                "cs": "Dávám té <w>rostlině</w> každý týden trochu vody.",
                                "tr": "<w>Bitkiye</w> her hafta biraz su veriyorum.",
                                "es": "Le doy un poco de agua a la <w>planta</w> cada semana."
                            }
                        },
                        {
                            "text": "Deze <w>plant</w> heeft veel zonlicht nodig om te groeien.",
                            "target_lang_translations": {
                                "ru": "Этому <w>растению</w> нужно много солнечного света для роста.",
                                "en": "This <w>plant</w> needs a lot of sunlight to grow.",
                                "pl": "Ta <w>roślina</w> potrzebuje dużo światła słonecznego, aby rosnąć.",
                                "de": "Diese <w>Pflanze</w> braucht viel Sonnenlicht, um zu wachsen.",
                                "fr": "Cette <w>plante</w> a besoin de beaucoup de lumière du soleil pour pousser.",
                                "it": "Questa <w>pianta</w> ha bisogno di molta luce solare per crescere.",
                                "cs": "Tato <w>rostlina</w> potřebuje k růstu hodně slunečního světla.",
                                "tr": "Bu <w>bitkinin</w> büyümek için çok fazla güneş ışığına ihtiyacı var.",
                                "es": "Esta <w>planta</w> necesita mucha luz solar para crecer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groene plant",
                        "plant water geven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живой организм, который поглощает углекислый газ и выделяет кислород, например, цветок, дерево или кустарник.",
                        "en": "A living organism that absorbs carbon dioxide and releases oxygen, such as a flower, tree, or shrub.",
                        "pl": "Żywy organizm, który pochłania dwutlenek węgla i wydziela tlen, taki jak kwiat, drzewo lub krzew.",
                        "de": "Ein lebender Organismus, der Kohlendioxid aufnimmt und Sauerstoff abgibt, wie eine Blume, ein Baum oder ein Strauch.",
                        "fr": "Un organisme vivant qui absorbe le dioxyde de carbone et rejette de l'oxygène, comme une fleur, un arbre ou un arbuste.",
                        "it": "Un organismo vivente che assorbe anidride carbonica e rilascia ossigeno, come un fiore, un albero o un arbusto.",
                        "cs": "Živý organismus, který pohlcuje oxid uhličitý a uvolňuje kyslík, jako je květina, strom nebo keř.",
                        "tr": "Karbondioksit emen ve oksijen salgılayan çiçek, ağaç veya çalı gibi canlı bir organizma.",
                        "es": "Un organismo vivo que absorbe dióxido de carbono y libera oxígeno, como una flor, un árbol o un arbusto."
