                                        "entry_id": "54192ea0-7c65-3f99-a9f4-a308b0cabde8",
                                        "glosses": [
                                            "Person, die (gerade) isst, die gerne/viel isst oder die bestimmte Essgewohnheiten hat"
                                        ],
                                        "tags": [],
