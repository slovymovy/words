                                    {
                                        "sense_id": "5c3b4414-a1aa-3e79-bc96-a4a11b06682c",
                                        "entry_id": "ec274b16-3d7e-3325-a2a4-b8e0a2dd7002",
                                        "glosses": [
                                            "lang meegaand, met een uitwerking die ook op de lange termijn aanhoudt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39987522-e0b9-47a2-bc1c-50e63dcd814e",
                                                "sense_id": "5c3b4414-a1aa-3e79-bc96-a4a11b06682c",
                                                "text": "Ons bankstel kostte een hoop geld maar is zo duurzaam dat waarschijnlijk onze kleinkinderen er nog op kunnen zitten."
                                            },
                                            {
                                                "example_id": "6e82603a-1467-4069-b5c2-346b5afe0bd8",
                                                "sense_id": "5c3b4414-a1aa-3e79-bc96-a4a11b06682c",
                                                "text": "Wethouder Scholtes besluit zijn raadsbrief met het temperen van verwachtingen. Hij stelt dat de gemeente \"streeft naar een duurzame vermindering van het aantal meldingen van overlast\", maar zegt ook dat \"de aantallen ratten niet van vandaag op morgen kleiner zullen worden\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "625fb43c-34a6-3e9c-9c73-3700f795fec3",
                                        "entry_id": "ec274b16-3d7e-3325-a2a4-b8e0a2dd7002",
                                        "glosses": [
                                            "aansluitend op de behoeften van het heden zonder in de toekomst tot complicaties te leiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702e28d6-8fb0-4304-9ec8-c554c5606109",
                                                "sense_id": "625fb43c-34a6-3e9c-9c73-3700f795fec3",
                                                "text": "De lakse aanpak om het virus in bedwang te houden heeft zowel lof als verontwaardiging gekregen. Critici beschuldigen de Zweedse autoriteiten van het gokken met het leven van burgers door geen strenge maatregelen op te leggen. Maar de gezondheidsautoriteit hield lange tijd vol dat haar aanpak op de lange termijn duurzaam is."
                                            },
                                            {
                                                "example_id": "a8f29048-71ec-4e13-89d3-226bcd393b62",
                                                "sense_id": "625fb43c-34a6-3e9c-9c73-3700f795fec3",
                                                "text": "Collega-topmodel Emily Ratajkowski verscheen in een Versace-jurk die in 1992 de catwalk sierde. Een duurzaam statement kwam ook van zangeres Billie Eilish met haar Victoriaans ogende jurk van Gucci, gemaakt van stoffen die het modehuis eerder gebruikte of over had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af8029e3-308b-35bf-8b62-ba20ed062271",
                                        "entry_id": "ec274b16-3d7e-3325-a2a4-b8e0a2dd7002",
                                        "glosses": [
                                            "met zo min mogelijk impact op klimaat en milieu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3291bffe-e8d4-4069-8805-168de1a7b706",
                                                "sense_id": "af8029e3-308b-35bf-8b62-ba20ed062271",
                                                "text": "Zon, wind en warmte zijn duurzame energiebronnen."
                                            },
                                            {
                                                "example_id": "417188fb-f0af-4d39-9425-48b8e048c829",
                                                "sense_id": "af8029e3-308b-35bf-8b62-ba20ed062271",
                                                "text": "Groene energie is duurzaam omdat het niet bijdraagt aan de opwarming van de aarde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
