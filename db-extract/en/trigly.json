                        "examples": [
                            {
                                "example_id": "125c5b6a-4acc-4751-b7b9-09561a52af8a",
                                "sense_id": "dcc214ec-0758-3d1f-beb0-d6f6260f749d",
                                "text": "Ah! there in deepest solitude Sometimes I have wild nature wooed, When nought of living thing was nigh Except the Water-wag-tail shy, By nature's hand so trigly dight In speckled feathers, black and white, Which flew before from stone to stone, And hopped and bobbed thereupon;"
                            },
                            {
                                "example_id": "6bbb74c9-999a-484f-b969-c6232311259e",
                                "sense_id": "dcc214ec-0758-3d1f-beb0-d6f6260f749d",
                                "text": "Meeting him one day when trigly dressed, the doctor broke out with, “Joe, can you tell me the difference between you and the devil? ”"
                            },
                            {
                                "example_id": "23fa1990-b1bf-4f50-a502-58bdbf0fd112",
                                "sense_id": "dcc214ec-0758-3d1f-beb0-d6f6260f749d",
                                "text": "Coralie was the delight of the audience, who clasped in fancy that pretty waist so trigly tightened in her basque, or followed with their eyes the undulations of the skirt as it betrayed every movement of the hips."
                            },
                            {
                                "example_id": "e1904e81-062a-4248-8f3e-aaea12bc308f",
                                "sense_id": "dcc214ec-0758-3d1f-beb0-d6f6260f749d",
                                "text": "His head was still fine and trigly mustached, although grizzled, with the square bold cut of the man of adventure, tempered by the painter's considering eye."
                            }
                        ]
                    }
