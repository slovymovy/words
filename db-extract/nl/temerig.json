                "senses": [
                    {
                        "sense_id": "362ec039-573c-35ed-b972-54b00d6c7beb",
                        "entry_id": "2c145504-2b2c-38a9-95a1-df15a7a50b69",
                        "glosses": [
                            "op een zeurende, zanikende, klagende wijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89672a01-c4f6-4197-b9a4-eed7262858a0",
                                "sense_id": "362ec039-573c-35ed-b972-54b00d6c7beb",
                                "text": "Hij zette Klaver weg als een arrogant joch en omdat- ie het er zelf naar gemaakt had, de GroenLinks-leider, moesten we Asscher gelijk geven. Elke seconde dat Klaver over tafel met die hand bleef zwaaien, vergezeld van een temerig 'meneer Asscher, meneer Asscher', elke seconde die dat langer duurde maakte hem meer een dreinend ventje."
                            },
                            {
                                "example_id": "d2e436ce-18fb-44a7-9e7a-dd8b5ad78d1a",
                                "sense_id": "362ec039-573c-35ed-b972-54b00d6c7beb",
                                "text": "„Als een beetje nasaal en krakerig. Ook wel een beetje temerig. Soms denk ik wel eens: Joh, schiet toch eens wat op.”"
                            }
                        ]
                    }
