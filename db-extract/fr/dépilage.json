                                "sense_id": "52ccce14-7175-3016-8463-5f9602b1babc",
                                "text": "Le dépilage des peaux avant la tannerie."
                            },
                            {
                                "example_id": "81019ef4-4d17-4a50-b6a4-208efcb29c67",
                                "sense_id": "52ccce14-7175-3016-8463-5f9602b1babc",
                                "text": "Le dépilage est effectué par des produits qui détruisent la kératine (constituant du poil) et l’épiderme de surface."
                            }
                        ]
                    }
