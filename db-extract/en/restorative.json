                    {
                        "translation_id": "5c6b4eda-e05b-4e94-88fb-8a1618dd6cc4",
                        "source_entry_id": "137f9e68-e650-3c01-8a54-c8e00f906508",
                        "source_sense_id": "dd2504a2-76c9-321c-94aa-5c24ddf89893",
