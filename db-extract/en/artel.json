                                "target_senses": [
                                    {
                                        "sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                                        "entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                                        "glosses": [
                                            "freiwilliger Zusammenschluss von Arbeitern im zaristischen Russland"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98762dbe-a1db-471f-89ad-b3ffd72babd5",
                                                "sense_id": "a512bb60-45d1-3e5e-98a6-3bf836ae8f88",
                                                "text": "„Auch die Ausbildung fand innerhalb des Artels statt: Der Schüler erlernte so nur die Arbeiten, die in seinem Artel benötigt wurden, blieb also den Traditionen stark verhaftet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa69d60d-ec6b-3367-871d-a4e0369f85d8",
                                        "entry_id": "e6027acc-51de-3daf-8757-ac8eee3835b4",
                                        "glosses": [
                                            "einfache Form der landwirtschaftlichen Kollektivwirtschaft in der Sowjetunion"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbccc038-d318-43e5-b0bd-cef727535b2d",
                                                "sense_id": "aa69d60d-ec6b-3367-871d-a4e0369f85d8",
                                                "text": "„Drei Arten von Kollektivbetrieben hatten die Bolschewisten vorgesehen: Toz, Artel und Kommune.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
