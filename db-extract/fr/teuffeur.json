                    {
                        "sense_id": "eb44aeef-5d05-31a5-b799-3301ae9b5355",
                        "entry_id": "a0c08a38-d968-348b-9624-feeb268c45b2",
                        "glosses": [
                            "Personne qui participe aux fêtes, surtout en parlant des personnes qui fréquentent les free parties (manifestations techno aussi appelées rave parties)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6662d4db-afe8-4fc0-8647-5129f5043277",
                                "sense_id": "eb44aeef-5d05-31a5-b799-3301ae9b5355",
                                "text": "C’est pas un combat entre vieux cons de français (pourquoi pas racistes tant que t’y es !!!) et jeunes teuffeurs cools et ultratolérants…"
                            },
                            {
                                "example_id": "1a5bc018-684b-43f8-958d-42a71cb73896",
                                "sense_id": "eb44aeef-5d05-31a5-b799-3301ae9b5355",
                                "text": "Teuffeurs bannis du centre de Nantes lors de la fête de la Musique : les coulisses d’une bataille."
                            },
                            {
                                "example_id": "ae1944c0-233d-4617-b955-421fcb92f7b3",
                                "sense_id": "eb44aeef-5d05-31a5-b799-3301ae9b5355",
                                "text": "Le préfet met en garde les teuffeurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e3e171a-3b1e-4a87-9fd0-f9d9af633106",
                        "source_entry_id": "a0c08a38-d968-348b-9624-feeb268c45b2",
                        "source_sense_id": "eb44aeef-5d05-31a5-b799-3301ae9b5355",
                        "target_lang_word": "raver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4330c61-5d55-34fe-91d2-76d8c162632b",
                                        "entry_id": "61a3b5ca-e703-34ea-90b2-9f9e1bb0b73f",
                                        "glosses": [
                                            "A person who attends rave parties, or who belongs to that subculture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7a7d5d-fe3d-4edb-bbdb-82322157ab08",
                                                "sense_id": "a4330c61-5d55-34fe-91d2-76d8c162632b",
                                                "text": "The life of a superstar DJ sounds like one endless party. You get to travel the world, perform for thousands of scantily clad ravers, and earn a stack of money."
                                            },
                                            {
                                                "example_id": "564d9dd2-6437-4828-8907-cfbb5735d41f",
                                                "sense_id": "a4330c61-5d55-34fe-91d2-76d8c162632b",
                                                "text": "Ravers listen to technomusic at home, and some have commented that certain tracks of music can elicit ASC similar to the ones experienced at raves."
                                            },
                                            {
                                                "example_id": "caef880a-89b4-4750-8aa4-c7df11e499ac",
                                                "sense_id": "a4330c61-5d55-34fe-91d2-76d8c162632b",
                                                "text": "In large part, happycore was the result of an exodus of white ravers from the jungle scene, in reaction to the influx of black youth and the attendant mood change from bonhomie to surliness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a0078e-2800-3d04-baeb-30bda1769f99",
                                        "entry_id": "61a3b5ca-e703-34ea-90b2-9f9e1bb0b73f",
                                        "glosses": [
                                            "A person who raves or rants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d960acad-488d-4c9a-be82-8948261fb784",
                                                "sense_id": "d3a0078e-2800-3d04-baeb-30bda1769f99",
                                                "text": "Wouldn't it be nice to get on with me neighbours / But they make it very clear they've got no room for ravers"
                                            },
                                            {
                                                "example_id": "be4e59f0-b3a0-445c-bcbb-b36a760e21ad",
                                                "sense_id": "d3a0078e-2800-3d04-baeb-30bda1769f99",
                                                "text": "Well, you wore out your welcome with random precision / Rode on the steel breeze / Come on, you raver, you seer of visions / Come on, you painter, you piper, you prisoner, and shine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
