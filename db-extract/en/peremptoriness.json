                        "examples": [
                            {
                                "example_id": "20893818-1acf-427f-8ab9-95bcc66e1dd0",
                                "sense_id": "546d020e-ea8e-3a98-9e01-30b6b2c5b8da",
                                "text": "Mrs. Stannidge thereupon said with a considerate peremptoriness that she and her mother had better take their own suppers if they meant to have any."
                            },
                            {
                                "example_id": "eb8b0946-b976-4891-badf-37171222bfd3",
                                "sense_id": "546d020e-ea8e-3a98-9e01-30b6b2c5b8da",
                                "text": "For suddenly the drum beat to quarters, which familiar sound happening at least twice every day, had upon the present occasion a signal peremptoriness in it."
                            }
                        ]
                    }
