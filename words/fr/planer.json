    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc970401-8f14-3d6f-8322-0f4969fd47b9",
                    "sense_definition": "Voler sans battre des ailes ou sans moteur en se maintenant dans l'air grâce aux courants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un grand aigle <w>plane</w> majestueusement au-dessus de la vallée à la recherche d'une proie."
                        },
                        {
                            "text": "Après avoir coupé le moteur, l'aéronef a réussi à <w>planer</w> sur plusieurs kilomètres."
                        }
                    ],
                    "synonyms": [
                        "voler"
                    ],
                    "common_phrases": [
                        "planer dans les airs",
                        "planer au-dessus"
                    ]
                },
                {
                    "sense_id": "0b6fc979-1c5c-3c1f-aa94-6902db8b750e",
                    "sense_definition": "Être distrait, rêvasser ou se trouver complètement déconnecté de la réalité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat_mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne m'écoutes pas du tout depuis ce matin, tu <w>planes</w> complètement."
                        },
                        {
                            "text": "Il est difficile de travailler avec lui lorsqu'il se met à <w>planer</w> ainsi."
                        }
                    ],
                    "synonyms": [
                        "rêvasser"
                    ],
                    "common_phrases": [
                        "complètement planer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "25bb3b73-dbb6-3be7-b6d2-3e0be6ca8c16",
                    "sense_definition": "Peser de manière diffuse et persistante, en parlant d'un doute, d'une menace ou d'une atmosphère.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "menace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un lourd silence a commencé à <w>planer</w> sur la salle dès l'annonce des résultats."
                        },
                        {
                            "text": "Une grande incertitude continue de <w>planer</w> sur l'avenir de cette entreprise."
                        }
                    ],
                    "synonyms": [
                        "peser",
                        "flotter"
                    ],
                    "common_phrases": [
                        "laisser planer le doute",
                        "faire planer une menace",
                        "un silence plane"
                    ]
                },
                {
                    "sense_id": "88ad8223-5912-3272-8ec3-4cf2a6773163",
                    "sense_definition": "Ressentir une sensation d'euphorie ou d'engourdissement sous l'effet d'une drogue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir consommé cette substance illicite, il a passé la nuit à <w>planer</w> sur son canapé."
                        },
                        {
                            "text": "Certains adolescents pensent pouvoir <w>planer</w> sans risque lors des soirées festives."
                        }
                    ],
                    "common_phrases": [
                        "faire planer quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme d'argot lié aux stupéfiants"
                        }
                    ]
                },
                {
                    "sense_id": "8e6ce04e-cb84-3629-bca5-486a9c22d000",
                    "sense_definition": "Rendre plate et parfaitement lisse une surface de bois ou de métal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier prend soin de <w>planer</w> chaque planche avant de monter le meuble."
                        },
                        {
                            "text": "Il faut d'abord <w>planer</w> la tôle avec un marteau approprié pour corriger ses bosses."
                        }
                    ],
                    "synonyms": [
                        "aplanir",
                        "lisser"
                    ],
                    "common_phrases": [
                        "planer une planche"
                    ]
                }
            ]
        }
    ]
}