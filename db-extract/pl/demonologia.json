                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad413eb-a431-497c-9ed3-32a8fa3dea97",
                                "sense_id": "666af21a-eea5-3a1a-9c18-7217347bb6b0",
                                "text": "Ten znany demonolog zajmował się demonologią od wielu lat."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8fdfca61-35ab-34b2-a3d2-85a09b1146b1",
