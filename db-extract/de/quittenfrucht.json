                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8079df3-ead3-49bb-9366-d9820bc78314",
                                "sense_id": "5d64e8a2-2312-34a6-af9c-6ef064c37a67",
                                "text": "„Bei hohem Speichelausfluss hilft die Quittenfrucht. Genossen wird sie gekocht, gebraten oder gedörrt.“"
                            },
                            {
                                "example_id": "e0b13992-df2c-4ad8-8c2d-d9f674cdaf77",
                                "sense_id": "5d64e8a2-2312-34a6-af9c-6ef064c37a67",
                                "text": "„Wer vergichtet ist (genau dies deutsche Wort steht mitten im lateinischen Text), esse fleißig die Quittenfrucht, gekocht oder gedörrt, und sie räumt mit dem Gichtstoff so gründlich in ihm auf, dass die Gicht sich weder auf sein Nervensystem schlägt noch seine Gelenke zerstört oder auch angreift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
