{
    "word_family": [
        "wagger",
        "waggy",
        "wagtail"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "83b0c35b-e878-3f92-9d42-4f71fea39ba6",
                    "sense_definition": "To move or swing from side to side or up and down, especially of an animal's tail or a person's finger or head.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The happy puppy began to <w>wag</w> its tail as soon as its owner walked through the door.",
                            "target_lang_translations": {
                                "ru": "Счастливый щенок начал <w>вилять</w> хвостом, как только хозяин вошел в дверь."
                            }
                        },
                        {
                            "text": "She would <w>wag</w> her finger at the children whenever they tried to sneak a cookie before dinner.",
                            "target_lang_translations": {
                                "ru": "Она <w>грозила</w> детям пальцем всякий раз, когда они пытались стащить печенье перед ужином."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wag a finger",
                        "wag its tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или качать из стороны в сторону или вверх-вниз, особенно хвостом животного, пальцем или головой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "хвостом"
                            },
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "хвостом или рукой"
                            },
                            {
                                "target_lang_word": "покачивать",
                                "target_lang_sense_clarification": "пальцем или головой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "936c2fcb-53a9-37c2-825c-f3f5ff5e20ba",
                    "sense_definition": "To be constantly active in spreading gossip or rumors, usually referring to tongues.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you stay out too late with him, the neighbors' tongues will <w>wag</w> for weeks.",
                            "target_lang_translations": {
                                "ru": "Если ты задержишься с ним допоздна, соседи будут <w>чесать языками</w> еще несколько недель."
                            }
                        },
                        {
                            "text": "The scandal caused many tongues to <w>wag</w> throughout the small, quiet village.",
                            "target_lang_translations": {
                                "ru": "Этот скандал заставил многих <w>сплетничать</w> во всей маленькой тихой деревушке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tongues will wag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно распространять сплетни или слухи (обычно о языках)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесать языками",
                                "target_lang_sense_clarification": "сплетничать"
                            },
                            {
                                "target_lang_word": "злословить",
                                "target_lang_sense_clarification": "распускать слухи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34d8539-e94f-30eb-b3d1-90b6240d3a9d",
                    "sense_definition": "To stay away from school or work without permission; to play truant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "truancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys decided to <w>wag</w> school and spend the sunny afternoon at the local beach instead.",
                            "target_lang_translations": {
                                "ru": "Мальчики решили <w>прогулять</w> школу и вместо этого провести солнечный день на местном пляже."
                            }
                        },
                        {
                            "text": "He was caught after he tried to <w>wag</w> it from his morning classes.",
                            "target_lang_translations": {
                                "ru": "Его поймали после того, как он попытался <w>сачкануть</w> с утренних занятий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wag school",
                        "wag it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствовать в школе или на работе без разрешения; прогуливать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогуливать",
                                "target_lang_sense_clarification": "занятия или работу"
                            },
                            {
                                "target_lang_word": "сачковать",
                                "target_lang_sense_clarification": "уклоняться от обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a76c31b-8e06-31fb-93f9-7c81788dde22",
                    "sense_definition": "In cricket, for the lower-order batsmen to score a significant or unexpected number of runs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was in trouble until the tail started to <w>wag</w>, adding fifty crucial runs.",
                            "target_lang_translations": {
                                "ru": "Команда была в беде, пока «хвост» не начал <w>набирать очки</w>, добавив пятьдесят решающих пробежек."
                            }
                        },
                        {
                            "text": "It is always frustrating for bowlers when the tail begins to <w>wag</w> late in the innings.",
                            "target_lang_translations": {
                                "ru": "Боулерам всегда обидно, когда «хвост» начинает <w>огрызаться</w> в конце иннинга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the tail wagged"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in cricket-playing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: ситуация, когда игроки нижней части списка бьющих набирают значительное количество очков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огрызаться",
                                "target_lang_sense_clarification": "о хвосте команды в крикете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c0d1b03-d2dd-39d2-a89f-47b052309834",
                    "sense_definition": "A single swinging or oscillating movement from side to side.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a friendly <w>wag</w> of its tail, the dog greeted every visitor at the gate.",
                            "target_lang_translations": {
                                "ru": "Дружелюбным <w>вилянием</w> хвоста собака приветствовала каждого посетителя у ворот."
                            }
                        },
                        {
                            "text": "A quick <w>wag</w> of her head indicated that she did not agree with the proposal.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>покачивание</w> головы означало, что она не согласна с предложением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wag of the tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночное качающееся или колебательное движение из стороны в сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виляние",
                                "target_lang_sense_clarification": "движение хвостом"
                            },
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "одиночное движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "578183dd-cb14-3542-98ac-b03c8fdf7ae5",
                    "sense_definition": "A person who likes to make jokes and has a witty sense of humor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office <w>wag</w> couldn't resist making a joke about the manager's new bright yellow tie.",
                            "target_lang_translations": {
                                "ru": "Офисный <w>остряк</w> не удержался от шутки по поводу нового ярко-желтого галстука менеджера."
                            }
                        },
                        {
                            "text": "He was known as a bit of a <w>wag</w> who always had a clever remark ready for any occasion.",
                            "target_lang_translations": {
                                "ru": "Он был известен как своего рода <w>шутник</w>, у которого всегда была наготове остроумная реплика на любой случай."
                            }
                        }
                    ],
                    "synonyms": [
                        "see Thesaurus:play truant"
                    ],
                    "common_phrases": [
                        "a bit of a wag"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Somewhat old-fashioned usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который любит шутить и обладает остроумным чувством юмора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутник",
                                "target_lang_sense_clarification": "любитель шутить"
                            },
                            {
                                "target_lang_word": "остряк",
                                "target_lang_sense_clarification": "остроумный человек"
                            },
                            {
                                "target_lang_word": "балагур",
                                "target_lang_sense_clarification": "весельчак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54201afd-6fcc-35ca-ad9a-4caba36d985d",
                    "sense_definition": "An acronym for 'Wives And Girlfriends', referring to the female partners of famous sportsmen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "celebrity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media followed the <w>WAGs</w> to the luxury hotel where they stayed during the tournament.",
                            "target_lang_translations": {
                                "ru": "СМИ следовали за <w>женами футболистов</w> до роскошного отеля, где они остановились во время турнира."
                            }
                        },
                        {
                            "text": "She became a famous <w>WAG</w> after her marriage to the star football player was announced.",
                            "target_lang_translations": {
                                "ru": "Она стала знаменитой <w>спутницей спортсмена</w> после того, как было объявлено о ее браке со звездным футболистом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football WAGs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in tabloid journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним от 'Wives And Girlfriends', относящийся к женам и подругам знаменитых спортсменов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жены и подруги спортсменов",
                                "target_lang_sense_clarification": "спутницы знаменитостей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97256298-3927-36d0-b9d7-fc84cbc8adf8",
                    "sense_definition": "An acronym for 'wild-assed guess'; a very rough or uneducated estimate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without any real data, the number he gave was just a <w>WAG</w> to keep the meeting moving.",
                            "target_lang_translations": {
                                "ru": "Без каких-либо реальных данных число, которое он назвал, было просто <w>взято с потолка</w>, чтобы собрание продолжалось."
                            }
                        },
                        {
                            "text": "I can give you a <w>WAG</w> on the cost, but I need more details for a real quote.",
                            "target_lang_translations": {
                                "ru": "Я могу дать вам <w>приблизительную оценку</w> стоимости, но для точного расчета мне нужно больше деталей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal business or technical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним от 'wild-assed guess'; очень грубая или необоснованная оценка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пальцем в небо",
                                "target_lang_sense_clarification": "грубая догадка"
                            },
                            {
                                "target_lang_word": "приблизительная оценка",
                                "target_lang_sense_clarification": "навскидку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}