                    "sense_id": "bbb99a77-fccd-3709-a94b-86547ad207fc",
                    "sense_definition": "Парный орган зрения, находящийся на лице человека или на передней части головы животного",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё были большие и красивые голубые <глаза>.",
                            "target_lang_translations": {
                                "en": "She had big and beautiful blue <eyes>.",
                                "zh": "她有一双又大又漂亮的蓝色<w>眼睛</w>。"
                            }
                        },
                        {
                            "text": "Ребёнок широко открыл <глаза> от удивления.",
                            "target_lang_translations": {
                                "en": "The child opened his <eyes> wide in surprise.",
                                "zh": "孩子惊讶地瞪大了<w>眼睛</w>。"
                            }
