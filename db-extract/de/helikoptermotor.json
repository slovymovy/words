                ],
                "senses": [
                    {
                        "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                        "entry_id": "7f22c1e6-5ee3-327a-bdd3-ca796c52cef1",
                        "glosses": [
                            "Motor eines Luftfahrzeugs, das durch einen oder mehrere waagerechte Rotoren in der Luft gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c714086-ee39-4f35-94f4-624870239fd2",
                                "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                                "text": "„Man hatte ihm Medikamente intravenös verabreicht, so viel stand fest, denn er spürte keinen Schmerz, nur die Kälte der dünnen Luft und das Vibrieren des Helikoptermotors.“"
                            },
                            {
                                "example_id": "8961ccc3-a925-43d3-976f-b171640be5fe",
                                "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                                "text": "„Die Anspannung war omnipräsent - in den Gesichtern der anwesenden Polizisten und im Dröhnen von Helikoptermotoren.“"
                            },
                            {
                                "example_id": "bbf88e1c-fcbc-428e-938a-58bfc29d3673",
                                "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                                "text": "„Eine Verrippung der Motoroberfläche, sowie (bei Auto- und Helikoptermotoren) große Kühlkörper, die auf den Zylinderkopf montiert werden, sind die Voraussetzungen für eine effiziente Kühlung.“"
                            },
                            {
                                "example_id": "49dba135-d0c4-41a7-98b4-52f9bb456a2d",
                                "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                                "text": "„Wie viele Umdrehungen dreht der Helikoptermotor?“"
                            },
                            {
                                "example_id": "9ba151df-2250-4184-9ade-9c3e6a93651a",
                                "sense_id": "7b48b4f6-6984-3ff5-8933-a5c7f119a5e9",
                                "text": "„U-Boot-Raketen, Helikoptermotoren, Unterwasserexplosionen und Minen können bei Walen akustische Traumata verursachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
