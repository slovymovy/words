                    },
                    {
                        "translation_id": "072657b0-8bd3-4572-9363-b7b325cd4efb",
                        "source_entry_id": "758cd7c8-36f9-315e-9b8f-988d9d9a0fcd",
                        "source_sense_id": "32c2dd45-caae-3392-b130-8bafb3b86cce",
                        "target_lang_word": "débarquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débarquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                        "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                                        "glosses": [
                                            "Action de débarquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31401396-4ecb-4485-83e0-372b74bfa401",
                                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                                "text": "L’embarquement et le débarquement s'opèrent à l'aide de barcasses d'un faible tirant d’eau, pouvant pénétrer dans une petite anse où les vagues viennent mourir au pied même des murs de la ville."
                                            },
                                            {
                                                "example_id": "d3f9a62e-2808-4a6c-8953-a0e2c3492291",
                                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                                "text": "Lorsque nous arrivâmes à destination, la mer trop houleuse nous interdisait toute nouvelle tentative de débarquement."
                                            },
                                            {
                                                "example_id": "52cd8168-df9b-4ce8-a594-b6272363e893",
                                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                                "text": "Le débarquement d'une automobile à quai était une manœuvre peu familière aux employés de la petite station, et le train s'attardait, et Psyché devenait impatiente."
                                            },
                                            {
                                                "example_id": "31eacf5f-4490-4b6b-9de1-56629a4b5c2c",
                                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                                "text": "La période qui s'étend entre le débarquement japonais à l’embouchure du Wang-poo et le bombardement de Nagasaki tut pour la Chine particulièrement fertile en catastrophes."
                                            },
                                            {
                                                "example_id": "6c21ac96-18f2-490c-a5c9-0d7dbb81515f",
                                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                                "text": "Les voisins continuaient d’acheter quelques légumes et apportaient aussi des nouvelles de la guerre. Mais la guerre ne les tira vraiment de leur solitude que le jour où ils eurent la certitude que le débarquement des Alliés en Normandie avait réussi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c86840f-f85a-3e93-8910-775f5de99121",
                                        "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                                        "glosses": [
                                            "Action d’une personne qui débarque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ba73ca-439d-49ef-8ecb-8b7c0ba79573",
                                                "sense_id": "9c86840f-f85a-3e93-8910-775f5de99121",
                                                "text": "Quand Napoléon III fut empoigné à Boulogne pour avoir donné une seconde représentation du débarquement à Cannes, on le jeta au cachot et on l'emmena à Paris sans lui donner le temps de changer de chemise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc4b005-c792-46d2-88b2-5297100d2956",
                        "source_entry_id": "758cd7c8-36f9-315e-9b8f-988d9d9a0fcd",
                        "source_sense_id": "32c2dd45-caae-3392-b130-8bafb3b86cce",
                        "target_lang_word": "transplantation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transplantation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de transplanter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440d9253-8a05-44a2-8aa8-64f6c6c08e07",
                                                "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                                "text": "MM. E. Burnouf et Lassen […] ont démontré que, du sixième siècle avant notre ère, datait la transplantation du bouddhisme à Ceylan ; …."
                                            },
                                            {
                                                "example_id": "61e471af-1693-46e6-97f5-69df43370649",
                                                "sense_id": "3d19878b-d469-3dee-92db-d28da31ba807",
                                                "text": "Mais, dans le Puy-de-Dôme tout au moins, il n'y a point que des inconvénients à cette transplantation de tant de ruraux en ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de déplanter, pour replanter dans un lieu différent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f7b08f-13d1-4c2b-9198-bbbcfacbe670",
                                                "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                                "text": "On opère de préférence la transplantation par un temps humide ou couvert, où l’évaporation est peu active."
                                            },
                                            {
                                                "example_id": "79d16a4b-a91a-42e5-a7e8-f7dd39559cf8",
                                                "sense_id": "037455f0-b7d5-31f2-84a7-4fed2462ae09",
                                                "text": "Le grand avantage du D.D. dans les cultures maraîchères semble être que l’on peut traiter à des doses élevées qui permettent d’obtenir des pépinières bien désinfectées, ce qui empêche une infestation des planches saines par transplantation de plantules déjà infectées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e46341b-4ce9-3580-a6af-b4a8c7988d54",
                                        "entry_id": "d0c26ca1-2b93-35de-b851-87479b71f93f",
                                        "glosses": [
                                            "Action de prélever un organe sur un individu, et de le greffer ensuite sur un autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
