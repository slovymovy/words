                "senses": [
                    {
                        "sense_id": "33e010a7-c3b5-318a-afaf-641a42b7c042",
                        "entry_id": "b49574b3-a71c-325f-966e-0eb778b3c339",
                        "glosses": [
                            "Vertreter einer Art der Nagetiere aus der Gattung der Mäuse (Mus), ehemals als Unterart der Hausmaus betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8e12de-8c05-4427-b935-dd302e35e428",
                                "sense_id": "33e010a7-c3b5-318a-afaf-641a42b7c042",
                                "text": "„Die Nördliche Hausmaus oder Feld-Hausmaus (Mus musculus musculus) sucht nur zeitweise (witterungsabhängig) das Gebäudeinnere auf; sie ist östlich der Elbe, in Nord-, Ost- und Südeuropa verbreitet; ihre Stammform, die in Südosteuropa beheimatete Ährenmaus (Mus musculus spicilegus), lebt ganzjährig im Freien.“"
                            },
                            {
                                "example_id": "614ea229-97ad-4e8b-b853-ee91b1fa904f",
                                "sense_id": "33e010a7-c3b5-318a-afaf-641a42b7c042",
                                "text": "„Die dämmerungs- und nachtaktive Ährenmaus ist eine gute Läuferin und Kletterin und nutzt dabei ihren Schwanz zum balancien. Während sich die motorische Aktivität bei der Hausmaus überwiegend in Erkundungsverhalten äußert, zeigt die Ährenmaus eine unermüdliche Grabtätigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
