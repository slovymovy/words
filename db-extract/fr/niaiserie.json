                                                "sense_id": "3331c442-01c2-30e4-bea2-eca575db618c",
                                                "text": "Dat is de dwaasheid gekroond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                        "entry_id": "c8b1ff9b-3e05-3587-b742-5599c77b1091",
                                        "glosses": [
                                            "een dwaze handeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32fd4a6-7b3e-4a5f-a046-bf85d14c7054",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Hij beging opnieuw dwaasheden, waarvoor hij zwaar gestraft werd."
                                            },
                                            {
                                                "example_id": "3185e904-8bf6-4c0d-bea0-0f5559cef445",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Dit boek helpt ons om een kalmere, authentiekere, soms luchtigere relatie aan te gaan met de dwaasheden en obsessies van onze tijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e40808f-9d7f-4c84-8ebb-0491ec751f3d",
                        "source_entry_id": "ef7d5692-cdd7-3ac2-ae7c-fdcf3a10ae1b",
                        "source_sense_description": "Bagatelle,chose frivole",
                        "target_lang_word": "drivel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drivel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                                        "entry_id": "502e9eb3-e5ef-347a-b960-04ba195d8926",
                                        "glosses": [
                                            "Nonsense; senseless talk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d3a32b-294a-4931-b30e-2b04041ebfcc",
                                                "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                                                "text": "“You pay too much attention to such insipid drivel in even mentioning it.”"
                                            },
                                            {
                                                "example_id": "19e01ca9-7cf7-48f9-b133-3d0113a9b3c3",
                                                "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                                                "text": "But what drivel I am writing! It is just an attempt to pass the weary time."
                                            },
                                            {
                                                "example_id": "9f3d22bd-0faf-4f00-9f8f-52cdd73715e4",
                                                "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                                                "text": "A ray of light amid all this nonsense was Gwyn Topham's piece in the Guardian, which was timely, measured, accurate and of appropriate tone. That this single report stood out so clearly as an exemplar is a scathing comment in itself on the volumes of drivel surrounding it."
                                            },
                                            {
                                                "example_id": "c97cd4a6-8ef5-414e-8ad1-db98ba482346",
                                                "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                                                "text": "“Yeah, wading down into the comments. \"Winsomely compelling cop-aganda,\" says C-Rob-69. Oh, wait, that was me.” “Drivel for the unwashed. The Bard, how he weeps.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b2c46a-3a4d-3f3d-853a-e8379cbacae7",
                                        "entry_id": "502e9eb3-e5ef-347a-b960-04ba195d8926",
                                        "glosses": [
                                            "Saliva, drool."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3d677f-10de-498b-93f0-21f796fb3f1a",
                                                "sense_id": "00b2c46a-3a4d-3f3d-853a-e8379cbacae7",
                                                "text": "He pauses as I wipe the drivel from his chin."
                                            },
                                            {
                                                "example_id": "2febbf37-0601-45fd-8d1a-1527e3e33392",
                                                "sense_id": "00b2c46a-3a4d-3f3d-853a-e8379cbacae7",
                                                "text": "He wiped drivel from his chin with a stubby forearm."
                                            },
                                            {
                                                "example_id": "a6637479-df62-4683-9dce-8593e682440c",
                                                "sense_id": "00b2c46a-3a4d-3f3d-853a-e8379cbacae7",
                                                "text": "She wipes some drivel from his chin with a Kleenex, which she throws away in the bin, then sits and clasps his hand in hers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
