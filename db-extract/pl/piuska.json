                        ]
                    },
                    {
                        "translation_id": "15b79698-47b6-43e4-9371-a1faf4a30388",
                        "source_entry_id": "5b4e7d3a-7fca-3240-abab-9fbe46a0fec1",
                        "source_sense_id": "9b305e89-7e6a-3fa8-b9ee-7681b047f470",
                        "target_lang_word": "calotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Espèce de petit bonnet qui ne couvre ordinairement que le haut de la tête et qui est surtout en usage parmi les gens d’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301261a5-f1dc-4251-901c-b090b2cd23ca",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Le curé, n'est-ce pas ? le curé de cette grande église ? Tiens ! c'est vrai, que je suis bête ! je n'avais pas vu votre calotte !"
                                            },
                                            {
                                                "example_id": "9131f611-062f-4142-aa4f-5cbb5860c66d",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Alors seulement, un peu remis de ma frayeur, je remarquai que notre maître avait sa belle redingote verte, son jabot plissé fin et la calotte de soie noire brodée qu’il ne mettait que les jours d’inspection ou de distribution de prix."
                                            },
                                            {
                                                "example_id": "6f21c1be-2d5b-4805-94d8-d42535a20e14",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Il négligeait la propreté à un degré tout à fait choquant. Dans son cours, son vieux manteau et les manches de sa soutane servaient à essuyer les instruments et en général à tous les usages du torchon ; sa calotte, rembourrée pour préserver son vieux crâne des névralgies, formait autour de sa tête un bourrelet hideux."
                                            },
                                            {
                                                "example_id": "73e06705-2796-4959-bbdf-3fa37c5acbfa",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Derrière lui, un petit homme noir coiffé d'une calotte grecque surgit, minuscule et grotesque."
                                            },
                                            {
                                                "example_id": "f4197711-539f-4077-88e8-be91b920355d",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Un petit garçon s’est présenté mercredi à l’improviste devant le pape François au cours de son audience générale hebdomadaire au Vatican, cherchant à prendre sa calotte, puis s’est assis à sa droite sur une chaise libérée par un cardinal."
                                            },
                                            {
                                                "example_id": "5e5849b7-7def-401f-8944-f9a204f91c18",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "La calotte rouge d’un cardinal, d’un enfant de chœur."
                                            },
                                            {
                                                "example_id": "701da7c0-bf56-487e-a6d4-dbe7b0ed0746",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Porter la calotte."
                                            },
                                            {
                                                "example_id": "e4eba042-a9d0-459e-9392-ec6165d8b6c8",
                                                "sense_id": "f76d1991-13e9-3460-9a1c-41fd59a043e7",
                                                "text": "Le Pape a donné la calotte à un tel, il l’a élevé à la dignité de cardinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Le clergé catholique."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a51738e1-6f9a-4aeb-b9e8-3cf572b6f469",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "À bas la calotte !"
                                            },
                                            {
                                                "example_id": "fe4d03a2-542d-49d7-9ce6-f7448f5e6944",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "Je ne voudrais choquer personne, mais j’ai souvent soupçonné Marthe d’une certaine irréligion ; du moins a-t-elle cette habitude, avant de commencer une partie amoureuse et sitôt mise au lit, de s’exclamer, en s’adressant en riant à son partenaire : « Et maintenant, à bas la calotte ! »"
                                            },
                                            {
                                                "example_id": "25599e14-2846-4ec8-9acf-5fe6ab07f9ef",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "– On pourrait y aller en bande, suggéra Mme Verdurin malgré son horreur de la calotte."
                                            },
                                            {
                                                "example_id": "736f290c-58bd-4863-8c62-c73ed2bbc792",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "– À bas la calotte !\n– À bas la calotte ! » répéta Zèphe Maloret emporté par son élan."
                                            },
                                            {
                                                "example_id": "74bb5ac5-2040-4fc8-b116-2932ff12bd8a",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "Le ciel en soit loué, je vis en bonne entente\nAvec le Père Duval, la calotte chantante"
                                            },
                                            {
                                                "example_id": "9b98ff43-a99b-43ba-bed7-ea67e15e11b8",
                                                "sense_id": "880bb2a8-69fb-366b-99ec-c19946808941",
                                                "text": "Un petit groupe, d’un radicalisme farouche, et soucieux de plaire aux autorités, est au contraire pour le départ de la calotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17aba8c-0a35-3f73-97e5-95ccc3b04eff",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Tape sur la tête."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3915eaf5-d4e1-47a2-a26b-cbd740cf4239",
                                                "sense_id": "f17aba8c-0a35-3f73-97e5-95ccc3b04eff",
                                                "text": "Donner, recevoir une calotte."
                                            },
                                            {
                                                "example_id": "a4942f47-e81b-41f0-aec7-c4532b3968d6",
                                                "sense_id": "f17aba8c-0a35-3f73-97e5-95ccc3b04eff",
                                                "text": "Je t’ai donné une calotte, tu m’as rendu un coup de ciseaux, c’était de jeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "373e9d22-7aa5-34b8-9e46-a7cd85349776",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Bonnet traditionnel des étudiants des universités catholiques par opposition avec la penne des étudiants des institutions non confessionnelles."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb80adc-3c82-48f4-ac4b-570e1eae82ee",
                                                "sense_id": "373e9d22-7aa5-34b8-9e46-a7cd85349776",
                                                "text": "Nadine et Max ont porté la calotte durant toutes leurs études."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b744c3-50d9-3268-a15f-6ee169beecdc",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Chose qui a quelque rapport de forme ou de destination avec une calotte. → voir calotte polaire"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c3688d-fbda-411b-ba10-fe00f8740a00",
                                                "sense_id": "49b744c3-50d9-3268-a15f-6ee169beecdc",
                                                "text": "Tout à coup le reflet sortit de la glace, descendit dans la chambre, vint droit à lui, le força à s’asseoir, et, malgré sa résistance, lui enleva le dessus de la tête comme on ferait de la calotte d’un pâté."
                                            },
                                            {
                                                "example_id": "d36d9210-dbc3-4dc9-a1b4-9aa27727e33f",
                                                "sense_id": "49b744c3-50d9-3268-a15f-6ee169beecdc",
                                                "text": "Déjà, depuis le matin du premier janvier, la lourde calotte d’humidité qui écrasait la ville avait disparu et on avait cessé de vivre dans du gluant, furtivement, en rasant les maisons qui s’égouttaient, dans un monde noir sur blanc et délavé comme une eau-forte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed89798-da77-3a22-a5c1-d9801ffa19af",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Petite voûte sphérique peu élevée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92971b15-98ae-3e94-b30f-415e10f7ca86",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Partie supérieure du crâne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096cb1ed-11db-4d13-95c8-fa9ea076f1f5",
                                                "sense_id": "92971b15-98ae-3e94-b30f-415e10f7ca86",
                                                "text": "La calotte crânienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "790ef8f3-ba74-31c5-b9dc-0398698c54f1",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Sphère coupée par un plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791a6662-1876-456b-aed9-be907081ba8b",
                                                "sense_id": "790ef8f3-ba74-31c5-b9dc-0398698c54f1",
                                                "text": "Calotte sphérique."
                                            },
                                            {
                                                "example_id": "7996e532-9319-4344-98c5-1222139f09f0",
                                                "sense_id": "790ef8f3-ba74-31c5-b9dc-0398698c54f1",
                                                "text": "La calotte des cieux, la voûte du ciel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6bc0fff-9fa7-3dc0-bdb0-64cffd10bc60",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Sorte de récipient hémisphérique, aussi appelé cul-de-poule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82354e50-42de-48b2-980e-8d8b51c9a597",
                                                "sense_id": "d6bc0fff-9fa7-3dc0-bdb0-64cffd10bc60",
                                                "text": "Après avoir raclé le fond de mousseline de saumon, Victor emporta la calotte vide vers les éviers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855d6b1a-18fd-3d69-8bd2-3a2fb2832708",
                                        "entry_id": "4cad193a-ac3d-3660-b459-ab6014c86aab",
                                        "glosses": [
                                            "Couche de glace qui recouvre les pôles."
                                        ],
                                        "tags": [
                                            "Calotte glaciaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9b7fd8-0422-4f53-a8bb-f94cc8928b29",
                                                "sense_id": "855d6b1a-18fd-3d69-8bd2-3a2fb2832708",
                                                "text": "La calotte glaciaire de l’Europe s’est réfugiée en Scandinavie avec son cortège de plantes boréales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edc2f9e-0f36-3709-8a1b-b850a0af8e2d",
