                "senses": [
                    {
                        "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                        "entry_id": "736a9e81-526f-35a3-bd24-0750fc575821",
                        "glosses": [
                            "Theorie über Auslöse- und Einflussfaktoren und Verlauf von Sprachwandel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff3d676-1558-4886-ae87-5674e6352b90",
                                "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                                "text": "Es gibt mehrere Sprachwandeltheorien, die unterschiedliche Annahmen über Auslösung, Ausbreitung, Verlauf und Ergebnis von Sprachwandel darstellen."
                            },
                            {
                                "example_id": "85bd4681-ddeb-4e41-8610-6305642f515c",
                                "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                                "text": "„Auch Keller, dessen Theorie in dieser Arbeit vorgestellt und diskutiert wird, schafft in seiner Sprachwandeltheorie einen eigenen Sprachbegriff.“"
                            },
                            {
                                "example_id": "c5148cb9-5bc1-4e46-a86e-e7eb0def6559",
                                "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                                "text": "„Seine Forschungsschwerpunkte sind: Dialektologie, Soziolinguistik des Deutschen, Sprachgeschichte und Sprachwandeltheorie.“"
                            },
                            {
                                "example_id": "766f1342-4c0a-4329-a5e8-0292e2f9ae05",
                                "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                                "text": "„Die Studierenden sollen aktuelle Sprachwandeltheorien verstehen, ihre theoretischen Prämissen und Implikationen erkennen und lernen, die in ihnen enthaltenen Erklärungspotenziale zu bestimmen und zu beschreiben.“"
                            },
                            {
                                "example_id": "02ff80c4-332b-4488-b083-8158dc0fbe02",
                                "sense_id": "da76abf1-fb6e-3569-ae91-0999eb0a2117",
                                "text": "Einen kurzen Überblick über einige Sprachwandeltheorien gibt Wolff."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
