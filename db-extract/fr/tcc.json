                        "examples": [
                            {
                                "example_id": "37474650-a704-4ce8-bf3b-a3889ffb91cb",
                                "sense_id": "8087ae9c-499f-3796-85c7-072d5c77db56",
                                "text": "Des thérapies cognitivo-comportementales (TCC) pourraient également être mises à contribution pour pacifier les flics ayant la matraque un peu trop lourde ou la gâchette trop facile. Elles pourraient notamment s’inspirer des TCC dispensées à l’endroit d’hommes faisant preuve de violence conjugale."
                            },
                            {
                                "example_id": "5f77e44d-570b-4091-9a35-3144d15c5c49",
                                "sense_id": "8087ae9c-499f-3796-85c7-072d5c77db56",
                                "text": "Chaque jour, une infirmière lui avait fait ingurgiter de l’ipéca, elle avait vomi et elle en avait à chaque fois discuté avec son thérapeute pour « décatastrophiser », comme disent les tenants des TCC."
                            },
                            {
                                "example_id": "5ef277e9-eb71-44fd-bd05-f4e81f7d91cc",
                                "sense_id": "8087ae9c-499f-3796-85c7-072d5c77db56",
                                "text": "En tête, les thérapies cognitivo-comportementales (TCC) qui s’avèrent efficaces pour retrouver un fonctionnement nocturne normal."
                            }
                        ]
                    }
