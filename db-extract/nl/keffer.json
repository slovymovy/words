                                "target_senses": [
                                    {
                                        "sense_id": "69159bba-d8b3-30d7-8004-5babd69207f4",
                                        "entry_id": "2bd6fb02-421c-3b9e-929d-3ef5d6427810",
                                        "glosses": [
                                            "The high-pitched bark of a small dog, or similar."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b8417d1-90f1-3076-83f3-f01aec0214dd",
                                        "entry_id": "2bd6fb02-421c-3b9e-929d-3ef5d6427810",
                                        "glosses": [
                                            "Casual talk; chatter."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a50c99-5059-4184-a98e-d61570395d61",
                                                "sense_id": "1b8417d1-90f1-3076-83f3-f01aec0214dd",
                                                "text": "Had I taken his accusations seriously I might have recommended a change in my under-managership, but I never could translate our jammy products into gas or explosives or even poison. Still yap, at least as concerned Beldite's."
                                            },
                                            {
                                                "example_id": "49c15e89-862c-49b8-9895-452af22a42a3",
                                                "sense_id": "1b8417d1-90f1-3076-83f3-f01aec0214dd",
                                                "text": "They couldn’t rise above their calls for peace. Those who weren’t “defenders of the fatherland” were incapable of anything except yap and blather about “stopping the war.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a13ed5-d534-3f5f-89fd-acc8b5d2be27",
                                        "entry_id": "2bd6fb02-421c-3b9e-929d-3ef5d6427810",
                                        "glosses": [
                                            "The mouth, which produces speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4da3d5-c3fe-4f9b-a7d4-9dc060ed8ace",
                                                "sense_id": "a8a13ed5-d534-3f5f-89fd-acc8b5d2be27",
                                                "text": "Shut your yap!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c73a471-237a-364f-bb57-4454a57965e3",
                                        "entry_id": "2bd6fb02-421c-3b9e-929d-3ef5d6427810",
                                        "glosses": [
                                            "A badly behaved person, especially a child."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f730744e-e38a-3405-86e6-82059ed3fa00",
                                        "entry_id": "2bd6fb02-421c-3b9e-929d-3ef5d6427810",
                                        "glosses": [
                                            "A fool."
                                        ],
