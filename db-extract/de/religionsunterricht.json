                ],
                "senses": [
                    {
                        "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                        "entry_id": "46ccc9fb-58b2-39e0-ad51-3cad31ae4737",
                        "glosses": [
                            "Unterricht im Fach Religion, der vor allem die Inhalte einer bestimmten Religion zum Gegenstand hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ef340d-85d8-402b-8d3f-5f59e8aecf4c",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Freilich hielten sich die Lateinschulen vielerorts für berechtigt, den Religionsunterricht dem Lateinunterricht nutzbar zu machen.“"
                            },
                            {
                                "example_id": "d4326459-9633-4b97-871e-89d6bd2d7b73",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Der Religionsunterricht ist in den öffentlichen Schulen mit Ausnahme der bekenntnisfreien Schulen ordentliches Lehrfach. Unbeschadet des staatlichen Aufsichtsrechtes wird der Religionsunterricht in Übereinstimmung mit den Grundsätzen der Religionsgemeinschaften erteilt. Kein Lehrer darf gegen seinen Willen verpflichtet werden, Religionsunterricht zu erteilen.“ (Art. 7 Abs. 4 Grundgesetz)"
                            },
                            {
                                "example_id": "174de5c7-51d6-4c65-aae2-0b8ebd18cb8b",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "In Deutschland ist der konfessionelle Religionsunterricht (als einziges Unterrichtsfach) im Grundgesetz als ordentliches Lehrfach für öffentliche Schulen abgesichert."
                            },
                            {
                                "example_id": "314f7a3e-b548-47fb-b470-a50db6a3f700",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "Der evangelische Religionsunterricht bei Herrn Maier langweilte die Schüler immer."
                            },
                            {
                                "example_id": "7835a199-395d-422a-9eb1-ed64b04ced42",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Die Aufsicht über den Religionsunterricht wurde den staatlichen Behörden überschrieben.“"
                            },
                            {
                                "example_id": "e9a449bd-28c5-4eae-9f1f-308271bb4320",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Der konfessionelle Religionsunterricht in Ossingen im Zürcher Weinland kommt bei den Kindern gut an.“"
                            },
                            {
                                "example_id": "093d5bf9-8922-4681-9f87-039e5b5425fd",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Dann ging es los: zweimal die Woche Religionsunterricht in der Schule, über dem Lehrerpult hing Christus erbärmlich blutend.“"
                            },
                            {
                                "example_id": "b6ba9b8a-abdf-44cb-97dd-fa4b87bda123",
                                "sense_id": "34614c15-b9f8-3ae8-b678-1423f59a2509",
                                "text": "„Sie sagte immer, es würde in der Vorhölle bleiben, und ich erfuhr in dieser Nacht zum erstenmal, welche scheußlichen Sachen die Katholiken im Religionsunterricht lernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
