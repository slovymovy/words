    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d82a5a3d-9786-3e8b-a0af-dc7ba60a228e",
                    "sense_definition": "A tool or machine with a rotating cutting tip used for making holes in hard materials.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used an electric <w>drill</w> to hang the picture on the wall.",
                            "target_lang_translations": {
                                "ru": "Он использовал электрическую <w>дрель</w>, чтобы повесить картину на стену.",
                                "tr": "Resmi duvara asmak için elektrikli bir <w>matkap</w> kullandı."
                            }
                        },
                        {
                            "text": "You need a special bit for your <w>drill</w> to go through concrete.",
                            "target_lang_translations": {
                                "ru": "Вам нужно специальное сверло для вашей <w>дрели</w>, чтобы просверлить бетон.",
                                "tr": "Betonu delmek için <w>matkabınız</w> için özel bir uca ihtiyacınız var."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric drill",
                        "cordless drill",
                        "drill bit",
                        "pneumatic drill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент или станок с вращающимся режущим наконечником для проделывания отверстий в твердых материалах.",
                        "tr": "Sert malzemelerde delik açmak için kullanılan döner kesici uca sahip bir alet veya makine."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрель",
                                "target_lang_sense_clarification": "электрический или ручной инструмент"
                            },
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "для бетона, земли или камня"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "matkap",
                                "target_lang_sense_clarification": "el aleti veya elektrikli delme cihazı"
                            },
                            {
                                "target_lang_word": "delgi",
                                "target_lang_sense_clarification": "delik açmaya yarayan alet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8649cda5-90fb-3ab7-80c8-9a46d3ac4fe0",
                    "sense_definition": "A disciplined repetition of an activity or a practice session, often used in military or emergency training.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "training_exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school holds a fire <w>drill</w> once every month to ensure safety.",
                            "target_lang_translations": {
                                "ru": "Школа проводит пожарные <w>учения</w> раз в месяц для обеспечения безопасности.",
                                "tr": "Okul, güvenliği sağlamak için ayda bir kez yangın <w>tatbikatı</w> düzenler."
                            }
                        },
                        {
                            "text": "Soldiers performed a marching <w>drill</w> on the parade ground.",
                            "target_lang_translations": {
                                "ru": "Солдаты выполняли строевую <w>подготовку</w> на плацу.",
                                "tr": "Askerler tören alanında yürüyüş <w>eğitimi</w> gerçekleştirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "exercise",
                        "practice",
                        "training",
                        "rehearsal"
                    ],
                    "common_phrases": [
                        "fire drill",
                        "military drill",
                        "emergency drill",
                        "evacuation drill"
