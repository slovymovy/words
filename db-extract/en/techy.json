                        "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                        "entry_id": "ddefb16d-b12a-3f9e-83b4-0a894e531ebe",
                        "glosses": [
                            "Technical, of or related to technology."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e6569eb6-be26-4a9a-8a71-3ef898cb0749",
                                "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                                "text": "Are there any techy types around? My computer has stopped working."
                            },
                            {
                                "example_id": "7d046c95-5c18-4d57-ab66-b4d10a6625e9",
                                "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                                "text": "Understanding its significance requires reading four of the techiest paragraphs you'll read all day, but it's worth the slog."
                            },
                            {
                                "example_id": "dd836320-a213-48b2-aa50-2aa37e4d9138",
                                "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                                "text": "I still regret uploading all my CDs at the behest of my husband, who is far techier than I am."
                            },
                            {
                                "example_id": "e1100ca5-c4fb-4dcc-8497-70fab1b11c1c",
                                "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                                "text": "We promise it will be easy — no web-lingo, techy software or long hours spent staring into the internet void."
                            },
                            {
                                "example_id": "97304a90-c53c-47de-8cb4-99f65263bd2d",
                                "sense_id": "2f485c02-86a9-3dd1-b2d7-ae4e2a4039e7",
                                "text": "For the tech-y friend that's impossible to buy for, pick up this cute and compact Amazon Echo Spot—it's a customizable smart clock that lets you set alarms, play music, preview the weather, control other smart home devices, and so much more."
                            }
                        ]
                    }
