                    {
                        "translation_id": "a7119a02-e89f-41d8-a180-71891f889e2b",
                        "source_entry_id": "a6ec9144-3e1d-3749-bb44-66d9f8c20403",
                        "source_sense_id": "b1b63914-b6e0-3ae6-a7e1-26d1ecb83e18",
                        "target_lang_word": "baathistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baathistisch",
