                "senses": [
                    {
                        "sense_id": "53c9451e-862c-30e2-b3b2-abbbf06b52e2",
                        "entry_id": "a1d1a40a-e801-3e43-a8dc-e4937c983b37",
                        "glosses": [
                            "auf dem amerikanischen Kontinent verbreitete Schweineart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f23ab9-5e15-43cc-b341-db26fdb48251",
                                "sense_id": "53c9451e-862c-30e2-b3b2-abbbf06b52e2",
                                "text": "„Kleine Waisenkinder, zornigen Zwergen gleich, waren unterwegs, Verrückte und Säufer wankten sabbernd und mit den Armen fuchtelnd durch die winzigen Marktbuden der Metropole; die Gefangenen zogen vorbei an den in Blut gebadeten Fleischständen, am Wachsgeruch, an Gedärmen, die schwarz vor Fliegen, an Gestellen baumelten, vorbei an großen roten Streifen von abgehäutetem Fleisch, das nun, zu vorgerückter Stunde, dunkler wurde, an den abgespeckten, nackten Schädeln von Kühen und Schafen mit stumpfblauen, stier blickenden Augen, an den steifen Leibern von Hirschen, Nabelschweinen, Enten, Wachteln und Papageien, alles einheimische Wild hing kopfunter am Haken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9ddd114-31e1-479c-a1cd-0b9c315cf7c6",
