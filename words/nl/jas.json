                {
                    "sense_id": "42cbb0be-040a-3063-aba3-f2f0b7fe4b47",
                    "sense_definition": "Iemand die niet in Volendam geboren en getogen is.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regional_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat dorp wordt een buitenstaander vaak een <w>jas</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In that village, an outsider is often called a <w>jas</w>.",
                                "ru": "В этой деревне постороннего часто называют <w>чужаком</w>.",
                                "zh": "在那个村子里，外来者常被称为<w>外地人</w>。",
                                "pl": "W tej wiosce przyjezdnego często nazywa się <w>obcym</w>.",
                                "de": "In diesem Dorf wird ein Außenstehender oft als <w>Fremder</w> bezeichnet.",
                                "fr": "Dans ce village, un étranger est souvent appelé un <w>outsider</w>.",
                                "it": "In quel villaggio, un estraneo viene spesso chiamato <w>forestiero</w>.",
                                "cs": "V té vesnici se cizinci často říká <w>přespolní</w>.",
                                "tr": "O köyde dışarıdan gelen birine genellikle <w>yabancı</w> denir.",
                                "es": "En ese pueblo, a un forastero a menudo se le llama <w>forastero</w>."
                            }
                        },
                        {
                            "text": "Hoewel hij er al jaren woont, beschouwen ze hem nog steeds als een <w>jas</w>.",
                            "target_lang_translations": {
                                "en": "Although he has lived there for years, they still consider him an <w>outsider</w>.",
                                "ru": "Хотя он живет там уже много лет, они все еще считают его <w>чужаком</w>.",
                                "zh": "尽管他已经在那里住了多年，他们仍把他视为<w>外地人</w>。",
                                "pl": "Mimo że mieszka tam od lat, wciąż uważają go za <w>obcego</w>.",
                                "de": "Obwohl er schon seit Jahren dort wohnt, betrachten sie ihn immer noch als <w>Außenseiter</w>.",
                                "fr": "Bien qu'il y habite depuis des années, ils le considèrent toujours comme un <w>étranger</w>.",
                                "it": "Anche se vive lì da anni, lo considerano ancora un <w>forestiero</w>.",
                                "cs": "I když tam bydlí už roky, stále ho považují za <w>cizince</w>.",
                                "tr": "Yıllardır orada yaşamasına rağmen, onu hala <w>yabancı</w> olarak görüyorlar.",
                                "es": "Aunque vive allí desde hace años, todavía lo consideran un <w>forastero</w>."
                            }
                        }
