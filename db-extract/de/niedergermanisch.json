                "senses": [
                    {
                        "sense_id": "a771a619-30bc-3d1d-9031-c7ac2e3fa3db",
                        "entry_id": "48e0987e-27ff-3a5d-b23a-a4fa1ef25a22",
                        "glosses": [
                            "zu Niedergermanien/Germania inferior gehörend (Teil von Gallien, ab 85 n. Chr. römische Provinz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0581b10d-9a66-42b5-b63f-944b00ee47d4",
                                "sense_id": "a771a619-30bc-3d1d-9031-c7ac2e3fa3db",
                                "text": "„Im Bündnis mit den niedergermanischen Batavern probten die aus Treverern bestehenden römischen Hilfstruppen der Gallia Belgica im Jahr 70 den Aufstand […].“"
                            },
                            {
                                "example_id": "710d701b-8fbe-4700-8bb6-025959d55be6",
                                "sense_id": "a771a619-30bc-3d1d-9031-c7ac2e3fa3db",
                                "text": "„In seinem Schacht lagen ein Bronzeeimer und das Henkelstück eines zweiten Eimers evtl. vom Hemmoorer Typus, also vermutlich ein niedergermanisches Erzeugnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
