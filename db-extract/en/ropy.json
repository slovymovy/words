                        "entry_id": "256e93ad-902e-3faa-bee4-b6afa3d19e3c",
                        "glosses": [
                            "Slimy, as after the action of Enterobacter aerogenes in syrup."
                        ],
                        "tags": [
                            "of milk or another liquid"
                        ],
                        "examples": [
                            {
                                "example_id": "9c4b9ff1-b375-452c-ba96-a33ea7d3744d",
                                "sense_id": "95db92b0-fdda-3fb8-8fe9-c66732c68e87",
                                "text": "The Hoary Froſts, and Northern Blaſts take care / Thy muddy Bev'rage to ſerene, and drive / Præcipitant the baſer, ropy Lees."
                            }
                        ]
                    }
