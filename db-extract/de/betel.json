                    {
                        "sense_id": "94b45358-28fa-3340-ac76-2501b7f0a9b0",
                        "entry_id": "9d9bc342-c8e3-3c3d-a921-c4e1ab74f0ec",
                        "glosses": [
                            "Genussmittel, das aus Betelpfeffer, Betelnuss und einigen Gewürzen hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3614d796-1bbe-46a8-b9dd-6f098e9771b8",
                                "sense_id": "94b45358-28fa-3340-ac76-2501b7f0a9b0",
                                "text": "Betel besteht aus einem Blatt des Betelpfeffers, in das Scheiben der Betelnuss und Gewürze gewickelt sind und das zusammen mit Kalk gekaut wird."
                            },
                            {
                                "example_id": "4017667c-4c1f-41c2-9782-781b3fb61dc8",
                                "sense_id": "94b45358-28fa-3340-ac76-2501b7f0a9b0",
                                "text": "„Auf dem kurzen Weg zum Friseursalon bemerkte ich ein paar Betel kauende alte Männer, deren Lippen ganz rot gefärbt waren, und hörte die Rufe der Verkäufer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f8f093a-19ce-360b-9997-e9da5884db6f",
                        "entry_id": "9d9bc342-c8e3-3c3d-a921-c4e1ab74f0ec",
                        "glosses": [
                            "kurz für Betelpfeffer"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7107588d-c286-464c-be3b-4b1549c467ab",
                        "source_entry_id": "9d9bc342-c8e3-3c3d-a921-c4e1ab74f0ec",
