    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8750be10-5678-3e5e-b62e-70565344dce2",
                    "sense_definition": "A female pig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer moved the <w>sow</w> into a separate pen before she gave birth.",
                            "target_lang_translations": {
                                "de": "Der Bauer brachte die <w>Sau</w> in einen separaten Stall, bevor sie ihre Ferkel bekam."
                            }
                        },
                        {
                            "text": "A healthy <w>sow</w> can produce a large litter of piglets every year.",
                            "target_lang_translations": {
                                "de": "Eine gesunde <w>Sau</w> kann jedes Jahr einen großen Wurf Ferkel produzieren."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein weibliches Schwein, das bereits Ferkel geboren hat."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sau",
                                "target_lang_sense_clarification": "Weibliches Schwein ab dem ersten Ferkeln."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef37183b-2819-3c19-bf84-05cada75f4a1",
                    "sense_definition": "A female bear.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sow</w> protected her cubs fiercely from any potential danger in the forest.",
                            "target_lang_translations": {
                                "de": "Die <w>Bärin</w> beschützte ihre Jungen im Wald erbittert vor jeder potenziellen Gefahr."
                            }
                        },
                        {
                            "text": "Hikers were warned to stay away from the <w>sow</w> and her young cubs.",
                            "target_lang_translations": {
                                "de": "Wanderer wurden gewarnt, sich von der <w>Bärin</w> und ihren Jungen fernzuhalten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein weiblicher Bär."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bärin",
                                "target_lang_sense_clarification": "Weiblicher Bär."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a665937-c4bb-3411-8850-7717c70bdc84",
                    "sense_definition": "A mass of metal solidified in a mold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The molten iron was poured into the mold to form a heavy <w>sow</w>.",
                            "target_lang_translations": {
                                "de": "Das geschmolzene Eisen wurde in die Form gegossen, um einen schweren <w>Block</w> zu bilden."
                            }
                        },
                        {
                            "text": "Each <w>sow</w> of metal was carefully inspected for impurities before being shipped.",
                            "target_lang_translations": {
                                "de": "Jeder Metall<w>block</w> wurde vor dem Versand sorgfältig auf Verunreinigungen geprüft."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingot"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein in einer Form erstarrter Metallblock."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Block",
                                "target_lang_sense_clarification": "Metallblock aus einer Gussform."
                            },
                            {
                                "target_lang_word": "Massel",
                                "target_lang_sense_clarification": "Fachbegriff für einen Metallblock aus dem Guss."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bccc89e-25ca-3be0-b5e9-0ddec2a4add5",
                    "sense_definition": "A contemptible, often fat woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the play was portrayed as a greedy <w>sow</w> who cared for no one.",
                            "target_lang_translations": {
                                "de": "Die Figur im Theaterstück wurde als gierige <w>Sau</w> dargestellt, der niemand etwas bedeutete."
                            }
                        },
                        {
                            "text": "He used the offensive term <w>sow</w> to describe his neighbor during the argument.",
                            "target_lang_translations": {
                                "de": "Er benutzte während des Streits das beleidigende Wort <w>Sau</w>, um seine Nachbarin zu beschreiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch",
                        "cow"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly offensive and derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine verachtenswerte, oft dicke Frau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sau",
                                "target_lang_sense_clarification": "Sehr beleidigendes Schimpfwort für eine Frau."
                            },
                            {
                                "target_lang_word": "Miststück",
                                "target_lang_sense_clarification": "Beleidigende Bezeichnung für eine Frau."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "736f44da-a520-37db-84d4-193a7348b209",
                    "sense_definition": "To scatter, disperse, or plant seeds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "farming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers usually <w>sow</w> their crops in the early spring.",
                            "target_lang_translations": {
                                "de": "Landwirte <w>säen</w> ihre Feldfrüchte normalerweise im frühen Frühjahr."
                            }
                        },
                        {
                            "text": "It is time to <w>sow</w> the seeds in the garden beds.",
                            "target_lang_translations": {
                                "de": "Es ist Zeit, die Samen in die Gartenbeete zu <w>säen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plant"
                    ],
                    "antonyms": [
                        "reap"
                    ],
                    "common_phrases": [
                        "sow seeds"
                    ],
                    "target_lang_definitions": {
                        "de": "Samen ausstreuen, um Pflanzen anzubauen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "säen",
                                "target_lang_sense_clarification": "Saatgut in den Boden bringen."
                            }
