                    {
                        "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                        "entry_id": "30e5d7c6-580d-30a5-bb3a-0944681b515b",
                        "glosses": [
                            "Féminin singulier de régulier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f5d7bc60-d42c-43e7-a94b-03251dc6d7ac",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "C’est l’esprit doux du grec placé dans la ligne, qui servira à rendre l’élif hamzé ou le hamzah arabe, de même que l’élif des autres langues sémitiques, lorsque leur orthographe demande qu’on les exprime dans une transcription régulière."
                            },
                            {
                                "example_id": "c258fde0-e91f-4c3b-b66f-b84d5d63858c",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "Une femme très pieuse et très régulière."
                            },
                            {
                                "example_id": "aed3d764-f938-475f-8521-0b9bd81e8369",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "Sa conduite a toujours été fort régulière."
                            },
                            {
                                "example_id": "8cc63100-d19a-4ed2-b7f8-7cb64c853b83",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "Sa vie n’est pas trop régulière."
                            },
                            {
                                "example_id": "fa66b355-9646-497c-a884-32e2a60b00a4",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "Figure géométrique régulière."
                            },
                            {
                                "example_id": "e04771db-544e-467e-a370-323c04941729",
                                "sense_id": "2aa0f404-3c01-343a-a2a6-549e7bd86525",
                                "text": "Pyramide régulière."
                            }
                        ]
                    }
                ],
