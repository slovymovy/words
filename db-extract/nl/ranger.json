                        "examples": [
                            {
                                "example_id": "264b5d4d-14c9-4cef-bfbb-0db696a27412",
                                "sense_id": "c579e407-a273-3ce8-9ee7-528a9545c1b3",
                                "text": "Parkmanager de Wildt van de Beekse Bergen legt uit wat de procedures zijn en hoe bezoekers worden gewaarschuwd die het safaripark ingaan met de auto. En ranger Leinenga neemt een cameraploeg mee in het park."
                            },
                            {
                                "example_id": "532975fd-891d-4f73-836c-5f89bc06767c",
                                "sense_id": "c579e407-a273-3ce8-9ee7-528a9545c1b3",
                                "text": "Global Witness licht ook het Roemeense slachtoffer Liviu Pop eruit. De ranger werd doodgeschoten nadat hij zich had ingezet voor de bescherming van bossen. In het land worden die massaal gekapt door criminele bendes, zegt de ngo."
                            }
                        ]
