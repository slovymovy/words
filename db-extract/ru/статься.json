                "senses": [
                    {
                        "sense_id": "e43a7e47-53d2-35a2-a702-4239e91fbaa1",
                        "entry_id": "45f6d8ca-5082-38af-b6a6-04aa65bef37d",
                        "glosses": [
                            "to become, to happen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd80b533-198f-4947-9b65-85832d51fcfd",
                                "sense_id": "e43a7e47-53d2-35a2-a702-4239e91fbaa1",
                                "text": "что с ним ста́лось?",
                                "translation": "what has become of him?",
                                "english": "what has become of him?"
                            },
                            {
                                "example_id": "d8f40bea-9fde-44a2-967d-a66ff775f58d",
                                "sense_id": "e43a7e47-53d2-35a2-a702-4239e91fbaa1",
                                "text": "мо́жет ста́ться, что",
                                "translation": "it may happen that",
                                "english": "it may happen that"
                            },
                            {
                                "example_id": "b4fc54e8-83f0-4d5a-83f8-23ed22bbba7e",
                                "sense_id": "e43a7e47-53d2-35a2-a702-4239e91fbaa1",
                                "text": "(вполне́) мо́жет ста́ться",
                                "translation": "it is (quite) possible/probable",
                                "english": "it is (quite) possible/probable"
                            },
                            {
                                "example_id": "2e941d14-a4d9-4e8d-8927-43004f214209",
                                "sense_id": "e43a7e47-53d2-35a2-a702-4239e91fbaa1",
                                "text": "с тебя́ ста́нется!",
                                "translation": "one can well expect that from you!",
                                "english": "one can well expect that from you!"
                            }
                        ]
                    }
