                            {
                                "example_id": "2d1887f8-730b-4178-ba0a-6968c4c80feb",
                                "sense_id": "16a94d8f-e17e-3c37-991e-14d4b3dcbe0f",
                                "text": "„Während also Cabriofahrer noch einmal vor der Einwinterung zum finalen Oben-ohne-Erlebnis für diese Saison kommen, wird die Marktsituation für Cabriolets in nächster Zukunft eher schwierig gesehen.“"
                            },
                            {
                                "example_id": "176cfe17-4abc-4851-88ef-4090511c6330",
                                "sense_id": "16a94d8f-e17e-3c37-991e-14d4b3dcbe0f",
                                "text": "„Besonders Cabriofahrer, deren Fahrzeuge ein Stoffdach haben, sollten die Reinigung in SB-Anlagen bevorzugen.“"
                            }
                        ],
