                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "navršit",
                                "target_lang_sense_clarification": "dát věci na hromadu"
                            },
                            {
                                "target_lang_word": "nakupit",
                                "target_lang_sense_clarification": "naskládat nebo nakupit dohromady"
                            },
                            {
                                "target_lang_word": "naházet",
                                "target_lang_sense_clarification": "naházet na jedno místo, méně přesně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26f11a65-7f53-383f-a2db-b5efb065cc0c",
                    "sense_definition": "To give or provide something in a large quantity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>heaped</w> praise upon the young actor for his performance.",
                            "target_lang_translations": {
                                "cs": "Kritici mladého herce za jeho výkon <w>zasypali</w> chválou."
                            }
                        },
                        {
                            "text": "The bad news <w>heaped</w> more stress on the already tired team.",
                            "target_lang_translations": {
                                "cs": "Špatná zpráva <w>přidala</w> další stres už tak unavenému týmu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dát, poskytnout nebo způsobit něco ve velkém množství."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zasypat",
                                "target_lang_sense_clarification": "dát něčeho velmi mnoho, často abstraktně"
                            },
                            {
                                "target_lang_word": "naložit",
                                "target_lang_sense_clarification": "ve spojení s další zátěží či problémy"
                            },
                            {
                                "target_lang_word": "přidat",
                                "target_lang_sense_clarification": "způsobit nebo přidat ve velké míře"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e6498df-5a0d-3694-acaf-953af42bfb72",
                    "sense_definition": "To form or round something into a heap.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>heaped</w> the flour into a mound before adding the eggs.",
                            "target_lang_translations": {
                                "cs": "Před přidáním vajec <w>navršila</w> mouku do kopečku."
                            }
                        },
                        {
                            "text": "The chef <w>heaped</w> the salad onto the plate.",
                            "target_lang_translations": {
                                "cs": "Kuchař <w>navršil</w> salát na talíř."
                            }
                        }
                    ],
                    "synonyms": [
                        "pile up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit z něčeho hromadu nebo zaoblený kopeček."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "navršit",
                                "target_lang_sense_clarification": "utvořit z něčeho hromádku nebo kopeček"
                            },
                            {
                                "target_lang_word": "nakupit",
                                "target_lang_sense_clarification": "nasypat či dát do tvaru hromady"
                            }
                        ]
                    }
                }
            ]
        },
        {
