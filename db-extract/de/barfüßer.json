                "senses": [
                    {
                        "sense_id": "e6568374-aa00-3669-9674-9bbde8400c2d",
                        "entry_id": "7c9682ad-766d-3b12-bef1-c9035a21224d",
                        "glosses": [
                            "Mitglied einer Ordensgemeinschaft, deren Angehörige ursprünglich barfuß gingen"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0b7cc262-a461-44b5-abef-25b5cde58acf",
                                "sense_id": "e6568374-aa00-3669-9674-9bbde8400c2d",
                                "text": "„Viele Leute gingen an ihm vorüber […] Der demütige Barfüßer in der Kutte, der Bettler mit dem Sack, die fremden Gesichter der Juden und ihre Weiber in grellem Putz, so fuhr das Leben vorüber.“"
                            },
                            {
                                "example_id": "2cd0859e-cc1a-4918-a06c-45d300f6cda1",
                                "sense_id": "e6568374-aa00-3669-9674-9bbde8400c2d",
                                "text": "„Herr Heinz Pfauentritt war wenig erbaut, als ihm der Besuch eines jungen Barfüßers gemeldet ward.“"
                            },
                            {
                                "example_id": "2a29fab1-e1ed-4414-8dfd-b12e36d7a8db",
                                "sense_id": "e6568374-aa00-3669-9674-9bbde8400c2d",
                                "text": "„Da hat in meiner Stadt ein Barfüßer, ein wahrer Teufelskerl, eine neue Waffe erfunden, die Feuer speit, und mit der er Mann und Roß, Mauern und Türme niederschlägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
