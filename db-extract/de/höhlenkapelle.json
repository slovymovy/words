                "senses": [
                    {
                        "sense_id": "88510f72-31d2-3967-8a53-6c28b71e83fa",
                        "entry_id": "849910a0-f33d-3b4a-a8b6-cbef84cf6168",
                        "glosses": [
                            "einfach gestalteter Andachtsraum, der in einer Höhle errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6c1be7-e126-4d8b-8182-375329d515d7",
                                "sense_id": "88510f72-31d2-3967-8a53-6c28b71e83fa",
                                "text": "„In einer halbstündigen Wanderung gelangt man von hier aus zur Höhlenkapelle Agios Efthimios, deren Wandmalereien ebenfalls aus dem 14. Jh. stammen.“"
                            },
                            {
                                "example_id": "79ac2cf9-9073-4304-9cd0-76afd2391ce8",
                                "sense_id": "88510f72-31d2-3967-8a53-6c28b71e83fa",
                                "text": "„Gegründet wurde die Höhlenkapelle 1621.“"
                            },
                            {
                                "example_id": "4b4fa004-2dcf-4bd0-be59-a44ce689bfde",
                                "sense_id": "88510f72-31d2-3967-8a53-6c28b71e83fa",
                                "text": "Die Höhlen von Portals Vells am Ausgangspunkt der Tour entstanden durch den Abbau von Sandstein, seit dem ausgehenden Mittelalter befindet sich in den geräumigen Grotten eine Höhlenkapelle."
                            },
                            {
                                "example_id": "e7c87e1b-baac-4e7a-b22b-11fc97328f2b",
                                "sense_id": "88510f72-31d2-3967-8a53-6c28b71e83fa",
                                "text": "Viele Stufen und einen langen Gang führt der Weg hinab in die Tiefe zur Höhlenkapelle unterhalb der (neobarock umgestalteten) Klosterkirche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
