                        "glosses": [
                            "Qui clapote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac347b0-7d7f-48ba-8b71-cf3b3ceefa16",
                                "sense_id": "89738fb9-921a-31fc-8114-c2c6dabbc246",
                                "text": "La mer était courte, clapoteuse, et d’une dureté effroyable."
                            },
                            {
                                "example_id": "7bf24469-d982-4fd2-99a0-785d40b5a8f9",
                                "sense_id": "89738fb9-921a-31fc-8114-c2c6dabbc246",
                                "text": "[…] ; le soleil incline vers la mer son globe de cuivre enflammé qui trace, sur l’étendue immense, une route de lumière clapoteuse et sanglante."
                            },
                            {
                                "example_id": "0c9a593f-82b8-4116-b9f0-1f749140978c",
                                "sense_id": "89738fb9-921a-31fc-8114-c2c6dabbc246",
                                "text": "[…] et le vent fraîchissant du S.-W. la mer devint hachée et clapoteuse comme sur un grand lac."
                            }
                        ]
                    }
