                ],
                "senses": [
                    {
                        "sense_id": "121543f2-fb14-342f-95ed-8c8e987b9c70",
                        "entry_id": "53ba4208-1d3e-376b-82ea-0a22271d8ec4",
                        "glosses": [
                            "relativ kleines Kriegsschiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fba278-ae02-4066-b580-703d17955074",
                                "sense_id": "121543f2-fb14-342f-95ed-8c8e987b9c70",
                                "text": "„Den Mittelpunkt des Marinebetriebes bildete das flußabwärts und ziemlich weit von der Stadt gelegene Gladstone Dock: es war schon mit Zerstörern und Schaluppen und mit den Korvetten, die jetzt in beträchtlicher Zahl von den Werften abliefen, überfüllt.“"
                            },
                            {
                                "example_id": "29ee3b31-f333-4bea-b677-f9a4893d2913",
                                "sense_id": "121543f2-fb14-342f-95ed-8c8e987b9c70",
                                "text": "„Die beiden Korvetten warfen noch einige Wasserbomben blindlings in die Gegend und verzogen sich dann, es schien ihnen nicht geheuer zu sein.“"
                            },
                            {
                                "example_id": "da2e9cbd-c95d-4911-ba6a-247f7a85c451",
                                "sense_id": "121543f2-fb14-342f-95ed-8c8e987b9c70",
                                "text": "„Wir verbrannten eine große Korvette, die schon fast für den Stapellauf bereit war, und fügten dem Feind auch anderweitig ziemlich großen Schaden zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
