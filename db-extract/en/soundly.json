                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3ed447-187f-4fd9-bf90-8bc2fdc6d2bc",
                                                "sense_id": "53dba654-b6fb-384b-8fe6-c5cbdb5443ab",
                                                "text": "Als je de karpers een tijd in een bak schoon water houdt verliezen ze hun grondige smaak wat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6baa2cc8-2329-43d0-b4d2-555ea2fd18c7",
                        "source_entry_id": "83d202df-edb4-336e-b737-76e9f0b52f56",
                        "source_sense_id": "d353f91b-4363-326a-81a5-18ac21f3a93f",
