                    {
                        "sense_id": "ae427e00-b877-3d9f-90a9-643c6b04f1e7",
                        "entry_id": "58116909-16b5-3412-a55a-c5e9d353301a",
                        "glosses": [
                            "Inexplicable; unable to be accounted for or explained."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1deb9fef-f956-4f0b-8db1-cc68746ffb8a",
                                "sense_id": "ae427e00-b877-3d9f-90a9-643c6b04f1e7",
                                "text": "And the having individually entertained four such resolves, without perceiving that once brought together, they all mutually expire; this, this ineffable folly, Pierre, brands thee in the forehead for an unaccountable infatuate!"
                            },
                            {
                                "example_id": "ec5f1b30-ee5f-4e6f-af10-896194ecc0ae",
                                "sense_id": "ae427e00-b877-3d9f-90a9-643c6b04f1e7",
                                "text": "If only Poirot had been accessible, I could have asked his advice. What possessed him to go posting off to London in this unaccountable way?"
                            },
                            {
                                "example_id": "f9be9110-e51a-4d63-b00b-8bc91bd13def",
                                "sense_id": "ae427e00-b877-3d9f-90a9-643c6b04f1e7",
                                "text": "However, for some unaccountable reason, these trains used the small terminus which can still be seen at Oxford Road, thus tending to isolate the line from its parent companies' systems."
                            }
                        ]
                    },
                    {
                        "sense_id": "664b0aa0-11cb-3a90-9fed-f08cc2bb4faf",
                        "entry_id": "58116909-16b5-3412-a55a-c5e9d353301a",
                        "glosses": [
                            "Not responsible; free from accountability or control."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0a9810-795d-4e06-ab54-b321e8bc4e8d",
                                "sense_id": "664b0aa0-11cb-3a90-9fed-f08cc2bb4faf",
                                "text": "Thailand has dropped legislation to criminalise torture and disappearances after years of working on the bill, the United Nations human rights office said on Tuesday, leaving state employees unaccountable for serious crimes."
                            },
                            {
                                "example_id": "ad99771d-7153-4fc4-8914-600e2f046fda",
                                "sense_id": "664b0aa0-11cb-3a90-9fed-f08cc2bb4faf",
                                "text": "Graeme Bickerdike, a member of campaign organisation The HRE Group, told RAIL: \"This infilling and demolition programme - costing much more than repair - has been conceived with no thought for its impact beyond the silos where distant, unaccountable officials manage their spreadsheets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e53978-3862-4ce6-8a8a-25bc5dd3fd3d",
                        "source_entry_id": "58116909-16b5-3412-a55a-c5e9d353301a",
                        "source_sense_description": "Inexplicable",
                        "target_lang_word": "onverklaarbaar",
