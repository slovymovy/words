        "ru-extract.jsonl": [
            {
                "entry_id": "3beb4df5-655a-36ff-9fd6-43c431a8cfdc",
                "word": "чуточку",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                        "entry_id": "3beb4df5-655a-36ff-9fd6-43c431a8cfdc",
                        "glosses": [
                            "разг. совсем немного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0c99fb-c9d3-43a6-b484-40cc03208925",
                                "sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                                "text": "― Дядюшка, пойдемте хоть чуточку дальше, вон к овчарням, либо хоть к тому вон колодцу дойдем!"
                            },
                            {
                                "example_id": "6db410ce-7528-4e97-b447-68f85baedbf0",
                                "sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                                "text": "Глазки у него живые, чуточку косые, нос птичий, и, несмотря на то что он стянут в рюмочку, у щеголя намечается брюшко."
                            },
                            {
                                "example_id": "415a3f5e-f5e6-471e-aeb7-7e09f9c719ab",
                                "sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                                "text": "Учти: если моя монета заденет твою, хоть чуточку, краешком, ― я выигрываю вдвойне."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5414a98-1e28-4e1b-857c-0f6443dc8511",
                        "source_entry_id": "3beb4df5-655a-36ff-9fd6-43c431a8cfdc",
                        "source_sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                        "target_lang_word": "a bit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae4e85e-490c-3d92-916a-6018b570fff9",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "To a small extent; in a small amount."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9f68f1-9e06-4116-b58a-324d43b1c6f8",
                                                "sense_id": "5ae4e85e-490c-3d92-916a-6018b570fff9",
                                                "text": "Could you move that up a bit?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "431ffd48-f205-3c2f-a1b3-17d6dfc712cd",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "Slightly; rather."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee1f098-d274-4beb-a364-16344a1f1aef",
                                                "sense_id": "431ffd48-f205-3c2f-a1b3-17d6dfc712cd",
                                                "text": "Isn't that hat a bit small for him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7fcbca4-a659-3bc7-b16f-43b85782d5e9",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc2282b-b735-4c5f-a59e-e0fe847084c6",
                                                "sense_id": "d7fcbca4-a659-3bc7-b16f-43b85782d5e9",
                                                "text": "That hat seems a bit small for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbc00a0-4ffe-3a3b-9ba4-815f37cbfc58",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "A lot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c11aad9-23d5-4f25-97b4-f9fbd03109a7",
                                                "sense_id": "3dbc00a0-4ffe-3a3b-9ba4-815f37cbfc58",
                                                "text": "It rained a bit last night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "a bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae9c806-60c5-3dde-bc5c-45f235a8b65d",
                                        "entry_id": "3f7b454f-85ff-3705-84ae-69c156834926",
                                        "glosses": [
                                            "A small amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93aa43e9-817e-4f64-a7a3-630513f4e763",
                                                "sense_id": "3ae9c806-60c5-3dde-bc5c-45f235a8b65d",
                                                "text": "Q: Care for some cake? A: Argh, you've twisted my arm — I'll have just a bit, thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abe9d29-1bbb-328b-96c8-3caa0fe3c9ca",
                                        "entry_id": "3f7b454f-85ff-3705-84ae-69c156834926",
                                        "glosses": [
                                            "A large amount."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31130739-afe3-41b9-a391-00f661daf792",
                                                "sense_id": "3abe9d29-1bbb-328b-96c8-3caa0fe3c9ca",
                                                "text": "Q: How much trouble did you stir up last night? A: Just a bit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4329322f-53d8-4cae-b637-571b33aef8ef",
                        "source_entry_id": "3beb4df5-655a-36ff-9fd6-43c431a8cfdc",
                        "source_sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
