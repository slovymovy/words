                "senses": [
                    {
                        "sense_id": "7ce50671-9472-3323-9ea9-bf2cf8c44806",
                        "entry_id": "ef7ef5e1-69ac-3145-93be-7e7685ae4278",
                        "glosses": [
                            "узорчатый, украшенный рельефным узором"
                        ],
                        "tags": [
                            "о ткани"
                        ],
                        "examples": [
                            {
                                "example_id": "62333a36-fb54-4c71-b5a4-fe16192e9125",
                                "sense_id": "7ce50671-9472-3323-9ea9-bf2cf8c44806",
                                "text": "Браный утиральник, обшитый тонкими кружевами, рукоделье Анастасии, висел на гвозде, всегда к услугам хозяина."
                            },
                            {
                                "example_id": "bebf8562-af6d-4307-a8d3-d9f84127a3f8",
                                "sense_id": "7ce50671-9472-3323-9ea9-bf2cf8c44806",
                                "text": "Его столы были не браные, яства не сахарные, питья не медвяные."
                            }
                        ]
                    }
