                                "target_lang_sense_clarification": "玩家用语，指反复积累经验值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7ceead4-1829-3652-8247-9f64eca613a7",
                    "sense_definition": "To annoy or irritate someone intensely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It really tends to <w>grind</w> my gears when people are rude to waiters.",
                            "target_lang_translations": {
                                "ru": "Мне действительно <w>действует на нервы</w>, когда люди грубят официантам.",
                                "zh": "别人对服务员很粗鲁这件事真的很<w>让我火大</w>。"
                            }
                        },
                        {
                            "text": "Loud chewing is the one thing that will always <w>grind</w> on my nerves.",
                            "target_lang_translations": {
                                "ru": "Громкое чавканье — это то, что всегда будет <w>действовать</w> мне на нервы.",
                                "zh": "大声咀嚼总是最<w>让</w>我心烦的一件事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind one's gears"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually in the phrase 'grind one's gears'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно раздражать или надоедать кому-либо.",
                        "zh": "使某人非常烦躁或恼火。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действовать на нервы",
                                "target_lang_sense_clarification": "раздражать"
                            },
                            {
                                "target_lang_word": "бесить",
                                "target_lang_sense_clarification": "выводить из себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "让人火大",
                                "target_lang_sense_clarification": "口语，指使人非常恼火"
                            },
                            {
                                "target_lang_word": "让人心烦",
                                "target_lang_sense_clarification": "指刺激、惹恼某人的神经"
                            },
                            {
                                "target_lang_word": "惹毛",
                                "target_lang_sense_clarification": "很口语，表示把人惹毛了"
                            }
                        ]
