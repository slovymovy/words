                "senses": [
                    {
                        "sense_id": "2a99d9b2-a233-357a-ae11-ede765120a41",
                        "entry_id": "c9007955-0de2-309c-8939-c54e09f83a2d",
                        "glosses": [
                            "сгорать до конца; уничтожаться огнём, пожаром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8848f6d5-1688-49bd-b378-85fe11d08604",
                                "sense_id": "2a99d9b2-a233-357a-ae11-ede765120a41",
                                "text": "Всё селение выгорало несколько дней."
                            }
                        ]
                    },
                    {
                        "sense_id": "777b61f2-bf50-32ad-8d6c-92262dc3392e",
                        "entry_id": "c9007955-0de2-309c-8939-c54e09f83a2d",
                        "glosses": [
                            "полностью расходоваться в процессе горения"
                        ],
                        "tags": [
                            "о горючих веществах, предметах"
                        ],
                        "examples": [
                            {
                                "example_id": "e65e690c-923d-456c-b480-d488bd6bdd49",
                                "sense_id": "777b61f2-bf50-32ad-8d6c-92262dc3392e",
                                "text": "Свеча выгорала два часа."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff39599e-099d-3ec0-84c7-041acba52c0f",
                        "entry_id": "c9007955-0de2-309c-8939-c54e09f83a2d",
                        "glosses": [
                            "перен. терять цвет, окраску под действием солнечных лучей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec6ba80-f6ff-46b2-abe8-d55bc340b008",
                                "sense_id": "ff39599e-099d-3ec0-84c7-041acba52c0f",
                                "text": "Волосы долго выгорали на таком неярком солнце."
                            }
                        ]
                    },
                    {
                        "sense_id": "18c2dd1a-5315-3a08-bd8f-ffcaaacab5d9",
                        "entry_id": "c9007955-0de2-309c-8939-c54e09f83a2d",
                        "glosses": [
                            "психол. выгорание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4568f38f-0685-41fe-a511-c1b48a84d8b5",
                                "sense_id": "18c2dd1a-5315-3a08-bd8f-ffcaaacab5d9",
                                "text": "Ключевой признак выгорания — затяжной характер. Это не плохое настроение и негативные эмоции на один день, а интенсивное, растянутое по времени переживание, из которого сложно выбраться. Это суммарный эффект того, что мы длительное время шли «не туда» и сигнал, что надо срочно что-то менять."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
