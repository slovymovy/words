                        "translation_id": "66191645-b32d-4963-b231-09ec62dffe99",
                        "source_entry_id": "49c3c7be-effa-3403-8100-c6e7baa83fe9",
                        "source_sense_id": "91f3102b-0d1b-3b25-a6a8-d920b795ad06",
                        "target_lang_word": "merdia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merdia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c43b0b-b50a-3680-8fd7-9a2b80300af9",
                                        "entry_id": "a34af274-e244-3179-b72c-b596f3833e11",
                                        "glosses": [
                                            "Médias considérés comme serviles, partiaux et soumis au pouvoir politique ou au pouvoir de ses propriétaires."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b9c84ac-606f-4351-86a1-97efc1c6a1d0",
                                                "sense_id": "c3c43b0b-b50a-3680-8fd7-9a2b80300af9",
                                                "text": "Mais les dirigeants de la pensée humaine, et j’en accuse les médias, (le mot de merdias serait préférable) ne veulent à aucun prix que l’Amour soit l’homme, car ils perdraient alors leur terrible pouvoir de manipulation qui réduit leurs semblables à une indigence de cœur propice à toutes les exploitations utilitaires et cyniques."
                                            },
                                            {
                                                "example_id": "1decce17-162e-4762-92eb-23cb1c24bc5d",
                                                "sense_id": "c3c43b0b-b50a-3680-8fd7-9a2b80300af9",
                                                "text": "Les merdias occidentaux encore pris en flagrant délit de propagande."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
