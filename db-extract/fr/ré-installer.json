                "senses": [
                    {
                        "sense_id": "e178413f-c295-3118-9574-3fe2694f6813",
                        "entry_id": "c9eeb05e-4972-3669-b2c9-51c4d6470836",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, pour réencadrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d34e7f8-6125-4bc5-875d-17307305a7b4",
                                "sense_id": "e178413f-c295-3118-9574-3fe2694f6813",
                                "text": "Il faut d'autre part « ré-encadrer », « ré-installer » le poème à un niveau qui corresponde à l'époque : (...)"
                            },
                            {
                                "example_id": "edfe095f-1537-42b1-b9fd-b472c4a2008c",
                                "sense_id": "e178413f-c295-3118-9574-3fe2694f6813",
                                "text": "J'ai été du nombre qui s'est fait expliquer à toute vitesse et en langage très technique comment ré-installer des pilotes sur mon ordinateur."
                            },
                            {
                                "example_id": "9ec625a7-d4c0-45bc-826b-45a4b87e45d2",
                                "sense_id": "e178413f-c295-3118-9574-3fe2694f6813",
                                "text": "Puis, avant de poursuivre, il pourra proposer de ré-installer une situation «convenable pour nous deux »."
                            }
                        ]
                    }
