                    "sense_definition": "tekeergaan of de controle verliezen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "controle_verliezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte begon te <w>hollen</w> toen de politie probeerde in te grijpen.",
                            "target_lang_translations": {
                                "en": "The crowd began to <w>run wild</w> when the police tried to intervene."
                            }
                        },
                        {
                            "text": "De emoties kunnen soms flink <w>hollen</w> tijdens een verhit debat.",
                            "target_lang_translations": {
                                "en": "Emotions can sometimes <w>run high</w> during a heated debate."
                            }
                        }
                    ],
                    "antonyms": [
                        "beheersen"
                    ],
                    "target_lang_definitions": {
                        "en": "to act out, go wild, or lose control"
                    },
                    "translations": {
