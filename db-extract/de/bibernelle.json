                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb4c1f2-567d-361f-a3a2-94cfb555450f",
                                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                                        "glosses": [
