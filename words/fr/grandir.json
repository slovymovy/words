                    "frequency": "High",
                    "semantic_group_id": "enfance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>grandi</w> dans un petit village à la campagne.",
                            "target_lang_translations": {
                                "en": "I <w>grew up</w> in a small village in the countryside.",
                                "ru": "Я <w>вырос</w> в маленькой деревне за городом.",
                                "nl": "Ik ben <w>opgegroeid</w> in een klein dorp op het platteland.",
                                "de": "Ich bin in einem kleinen Dorf auf dem Land <w>aufgewachsen</w>.",
                                "pl": "<w>Dorastałem</w> w małej wiosce na wsi.",
                                "it": "Sono <w>cresciuto</w> in un piccolo paese di campagna.",
                                "cs": "<w>Vyrůstal jsem</w> v malé vesnici na venkově.",
                                "tr": "Kırsalda küçük bir köyde <w>büyüdüm</w>.",
                                "es": "<w>Crecí</w> en un pueblo pequeño del campo.",
                                "zh": "我是在乡下的一个小村子里<w>长大</w>的。"
                            }
                        },
                        {
                            "text": "Ils ont <w>grandi</w> ensemble dans le même quartier de Paris.",
                            "target_lang_translations": {
                                "en": "They <w>grew up</w> together in the same neighbourhood of Paris.",
                                "ru": "Они <w>росли</w> вместе в одном районе Парижа.",
                                "nl": "Ze zijn samen <w>opgegroeid</w> in dezelfde wijk in Parijs.",
                                "de": "Sie sind zusammen im selben Viertel von Paris <w>aufgewachsen</w>.",
                                "pl": "Razem <w>dorastali</w> w tej samej dzielnicy Paryża.",
                                "it": "Sono <w>cresciuti</w> insieme nello stesso quartiere di Parigi.",
                                "cs": "<w>Vyrůstali</w> spolu ve stejné pařížské čtvrti.",
                                "tr": "Aynı Paris semtinde birlikte <w>büyüdüler</w>.",
                                "es": "<w>Crecieron</w> juntos en el mismo barrio de París.",
                                "zh": "他们在巴黎的同一个街区一起<w>长大</w>。"
                            }
                        }
