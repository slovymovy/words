                ],
                "senses": [
                    {
                        "sense_id": "0ccfef86-948d-3d21-8f91-cfe59d83b340",
                        "entry_id": "2bcc5369-c9d6-3dbd-9a80-91de0c440cdc",
                        "glosses": [
                            "Genre d’arbres à feuilles coriaces, de la famille des annonacées, dont plusieurs espèces produisent des fruits utilisés comme épice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e9cb81-719e-4656-90c3-c17e7e3043b8",
                                "sense_id": "0ccfef86-948d-3d21-8f91-cfe59d83b340",
                                "text": "D'autres arbustes de la même famille donnent des produits similaires, comme l'habzeli et le zelim d'Ethiopie ou la xylopie sud-américaine."
                            },
                            {
                                "example_id": "5c61f029-6b10-4d43-b11b-0e88d980f601",
                                "sense_id": "0ccfef86-948d-3d21-8f91-cfe59d83b340",
                                "text": "Les Glyptospermes sont aussi des arbres ou arbrisseaux étrangers, qui ont reçu ce nom parce que leurs semences sont sillonnées en travers. … tels sont les trois genres \"annone\", \"uvaire\" et \"xylopie\"."
                            },
                            {
                                "example_id": "cfdafddf-59c2-44af-a2b2-5f36b250e46b",
                                "sense_id": "0ccfef86-948d-3d21-8f91-cfe59d83b340",
                                "text": "Les principaux genres de cette famille sont les suivants : corossol, monodore, canang, habzéli, asiminier, porcélie, xylopie, guattérie, etc."
                            }
                        ]
                    }
                ],
