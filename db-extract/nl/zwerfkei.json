                        "glosses": [
                            "een stuk rots dat in de ijstijd door de gletsjers vervoerd is naar een ander gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0121f65a-8f82-4069-bdc0-d97b8eb426fc",
                                "sense_id": "fe4ec641-1123-33f5-8fcb-f1126505d1c0",
                                "text": "Hunebedden zijn van zwerfkeien gebouwd."
                            },
                            {
                                "example_id": "b139ab46-4d10-4fc9-a6ec-1cbf8a615d06",
                                "sense_id": "fe4ec641-1123-33f5-8fcb-f1126505d1c0",
                                "text": "Net voor het begin van de duiker lag een omgekiept winkelwagentje, dat was blijven hangen tegen een bemoste zwerfkei."
                            },
                            {
                                "example_id": "ded013b7-acf8-4637-8922-4b7a33f3cda6",
                                "sense_id": "fe4ec641-1123-33f5-8fcb-f1126505d1c0",
                                "text": "In het gras stond een herdenkingsmonument in de vorm van een zwerfkei met daarop de namen van veertien Joden die in 1942 werden weggevoerd en vermoord, de jongste nog geen drie jaar oud."
                            }
                        ]
                    }
