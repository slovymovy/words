                        "glosses": [
                            "Transformer en semoule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9de0835-a3c5-4685-b639-d894b052afbc",
                                "sense_id": "2bd68afc-1064-33ea-88f0-8d82ad7ec8c3",
                                "text": "Semouler les mottes en réalisant les granules à la main dans une large cuvette, et conférer aux particules une forme lisse plus ou moins sphérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "62e3b326-3ae9-3a70-93e0-021a271106dc",
                        "entry_id": "2780bab6-a0b5-33d2-9f68-37d70e7c9357",
                        "glosses": [
                            "Parsemer de semoule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c992bf68-e269-4bd4-87df-d85864f0d975",
                                "sense_id": "62e3b326-3ae9-3a70-93e0-021a271106dc",
                                "text": "La pâte se décolle des parois, bouler en ayant pris soin de la “semouler” légèrement."
                            },
                            {
                                "example_id": "a7ad2fc2-69de-4447-8249-c409889acfe3",
                                "sense_id": "62e3b326-3ae9-3a70-93e0-021a271106dc",
                                "text": "Étale ta pâte grossièrement sur une épaisseur d'1cm (pas besoin de semouler ton plan de travail)."
                            }
                        ]
                    },
                    {
                        "sense_id": "71164998-285f-37ff-96c4-0d47bff8a143",
