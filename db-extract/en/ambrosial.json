                                        "entry_id": "54c4948b-bfcf-3974-b960-8584f19bca6e",
                                        "glosses": [
                                            "Qui a une odeur d’ambroisie, une odeur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8865a3e8-6ffa-429e-a006-6fca4747eed5",
                                                "sense_id": "963cae7d-eaa2-392d-afb0-d9894bf35b9c",
                                                "text": "En puisant à ses racines ancestrales, elle régalera Tambu dʼun breuvage ambrosiaque, la promouvant ainsi porte-parole de la communauté."
                                            }
                                        ]
                                    }
