                                                "example_id": "eb9380f5-b2e0-46fb-87f5-a1e6ae87211a",
                                                "sense_id": "d2e79a3d-35ca-3260-a288-a648de6d3218",
                                                "text": "Степанов поставил левый локоть на стол и закрыл пальцами глаза, сильно переживая."
                                            }
                                        ]
                                    },
