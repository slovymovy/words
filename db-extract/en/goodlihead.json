                        ],
                        "examples": [
                            {
                                "example_id": "96a7131a-7db8-4090-ab6d-953a0517d77e",
                                "sense_id": "a4e022c5-9b62-3a51-b2aa-646c478c3224",
                                "text": "The lilies, of great goodlihead, divinely tall, sway with a stately, languid grace; the Canterbury bells are all ringing."
                            },
                            {
                                "example_id": "fb62b878-0945-4e39-a06d-a5f1a9bc4b6a",
                                "sense_id": "a4e022c5-9b62-3a51-b2aa-646c478c3224",
                                "text": "Now, by the strength and fury of Hercules -- To whom in stature, might, and goodlihead Most like thou art I pray thee, have in mind Him, and resolve to match his deeds with thine."
                            },
                            {
                                "example_id": "b9a3072a-778d-45e2-95fd-39352365cae7",
                                "sense_id": "a4e022c5-9b62-3a51-b2aa-646c478c3224",
                                "text": "Let me but have my tea and sugar, my well-fed ass and my good wife at hand, and let my children wax in stature and goodlihead — then my cup is full, I crave nothing more."
                            }
                        ]
                    }
