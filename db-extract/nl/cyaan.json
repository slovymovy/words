                    {
                        "translation_id": "5bf0cdc4-ad54-4928-a0f2-37addb0bc22a",
                        "source_entry_id": "c6b270bc-8e56-3e21-aee5-ed0455af2af8",
                        "source_sense_id": "e44730d3-ce83-3ab7-b05b-a2613b0d3976",
