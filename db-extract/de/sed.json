        "de-extract.jsonl": [
            {
                "entry_id": "6217c82f-7512-3e9e-9c16-7abe603ba9b9",
                "word": "SED",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd0eaab9-1f72-355c-804b-2808423ad786",
                        "entry_id": "6217c82f-7512-3e9e-9c16-7abe603ba9b9",
                        "glosses": [
                            "Sozialistische Einheitspartei Deutschlands – die größte Partei der DDR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee2e29f-5295-4d37-bdec-f82c23b29b0b",
                                "sense_id": "fd0eaab9-1f72-355c-804b-2808423ad786",
                                "text": "„Die Arbeiter-und-Bauern-Inspektion der DDR wurde mit dem Beschluß des Zentralkomitees der SED und des Ministerrates der DDR vom 26. Mai 1970 verpflichtet, zur Erhöhung der Wirksamkeit der gesellschaftlichen und staatlichen Kontrolle beizutragen.“"
                            },
                            {
                                "example_id": "f0c0a90d-e05d-4a49-8316-2506ee9325df",
                                "sense_id": "fd0eaab9-1f72-355c-804b-2808423ad786",
                                "text": "„Der besondere Entwicklungsweg, den Ostdeutschland seit 1990 zurückgelegt hat, erklärt sich aus der Hinterlassenschaft des gescheiterten Systems der SED.“"
                            },
                            {
                                "example_id": "612a2dc7-e07d-4bc5-9f4a-b4ba08b33352",
                                "sense_id": "fd0eaab9-1f72-355c-804b-2808423ad786",
                                "text": "„Trotzdem wurde im April 1946 die SED gegründet.“"
                            },
                            {
                                "example_id": "dc68ec46-2f40-45f4-a166-00a8656b844d",
                                "sense_id": "fd0eaab9-1f72-355c-804b-2808423ad786",
                                "text": "„Die Entscheidung der SED zum Bau der Berliner Mauer stand schon längst fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7bee8cf2-e6e7-3364-9060-9a97a9577088",
                        "entry_id": "6217c82f-7512-3e9e-9c16-7abe603ba9b9",
                        "glosses": [
                            "Schweizerischer Erdbebendienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30b0e6a8-54a7-4171-aac3-c2a64a1b450d",
                                "sense_id": "7bee8cf2-e6e7-3364-9060-9a97a9577088",
                                "text": "„Im Falle eines Erdbebens informiert der SED Öffentlichkeit, Behörden und Medien über den Ort, die Stärke und mögliche Auswirkungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
