                                    {
                                        "sense_id": "7640c898-577e-3ad8-8758-966d38f014b1",
                                        "entry_id": "16c436c4-6f9c-3243-a158-e98e18d13f71",
                                        "glosses": [
                                            "Que sobrevive."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a222f389-8d44-3648-a640-bb9ec0fa5b4d",
                                        "entry_id": "16c436c4-6f9c-3243-a158-e98e18d13f71",
                                        "glosses": [
                                            "Referido a un ser vivo, que sale con vida de una situación de extremo peligro en que otros han muerto (que supervive)."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48868484-6d18-4d78-a8c8-60284c9d4a1d",
                                                "sense_id": "a222f389-8d44-3648-a640-bb9ec0fa5b4d",
                                                "text": "No hubo sobrevivientes en el accidente de avión."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
