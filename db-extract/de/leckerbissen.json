                "senses": [
                    {
                        "sense_id": "f375de7d-6fed-39c7-9231-b0750eb0b6d8",
                        "entry_id": "17611009-8dc1-37e0-be37-bcf63bf959b5",
                        "glosses": [
                            "Gourmandise, délicatesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdae633c-aaaf-459c-b7c3-a8c6e42e5eb6",
                                "sense_id": "f375de7d-6fed-39c7-9231-b0750eb0b6d8",
                                "text": "Ein ausgesuchter, begehrter, besonderer Leckerbissen, une gourmandise choisie, recherchée, particulière."
                            },
                            {
                                "example_id": "2151b934-ed4a-449e-bd34-4eb1a383aba0",
                                "sense_id": "f375de7d-6fed-39c7-9231-b0750eb0b6d8",
                                "text": "Eine Platte mit pikanten Leckerbissen : une assiette de gourmandises piquantes."
                            },
                            {
                                "example_id": "eb21c9f1-2e12-4373-bcd0-ae58ba21c3e0",
                                "sense_id": "f375de7d-6fed-39c7-9231-b0750eb0b6d8",
                                "text": "mit den erlesensten Leckerbissen bewirten : régaler quelqu’un de gourmandises choisies."
                            },
                            {
                                "example_id": "d9439d55-8453-4ee0-a7b2-7f9dd583be67",
                                "sense_id": "f375de7d-6fed-39c7-9231-b0750eb0b6d8",
                                "text": "Das Konzert war ein köstlicher Leckerbissen für uns : le concert était un vrai régal."
                            }
                        ]
                    }
                ],
