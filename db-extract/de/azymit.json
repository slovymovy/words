                "senses": [
                    {
                        "sense_id": "ebc0ef40-3f2f-3e28-82c3-e3df7e4ae7ac",
                        "entry_id": "b89eff8f-9d36-3254-aae4-ae760e5f8db2",
                        "glosses": [
                            "Bezeichnung der orthodoxen Kirche für einen Christen der römisch-katholischen Konfession, der die Eucharistie mit ungesäuertem Brot (Azymon) feiert"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "813928a2-d740-4bd9-a674-bf98dc5214c8",
                                "sense_id": "ebc0ef40-3f2f-3e28-82c3-e3df7e4ae7ac",
                                "text": "Azymit im Spottname, den die orthodoxen Griechen den Lateinern gaben, da diese sich des ungesäuerten Brotes beim Abendmahl bedienten."
                            },
                            {
                                "example_id": "703c021e-9bda-4dd4-bbf1-db71347d25e5",
                                "sense_id": "ebc0ef40-3f2f-3e28-82c3-e3df7e4ae7ac",
                                "text": "Auch die Armenier und Maroniten wurden von den orthodoxen Griechen (selbst noch in neuern Zeiten) Azymiten genannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
