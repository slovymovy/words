                                        "entry_id": "9767d504-7508-382c-8214-19440c0abf88",
                                        "glosses": [
                                            "A female water spirit that leads handsome men to their deaths underwater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "436f9cd3-d832-4d24-a0f8-6590d4aeaced",
                                                "sense_id": "fd6bd5e4-bacf-3a6a-bf27-0290c4c9775d",
                                                "text": "She is now a rusalka, a water spirit; in revenge she sends their daughter, a rusalochka, to lure him into the water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
