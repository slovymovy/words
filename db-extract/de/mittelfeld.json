                        "examples": [
                            {
                                "example_id": "60fa66cd-15f3-4812-af08-6e83869a236f",
                                "sense_id": "82bc9eeb-6593-3ca3-8de0-c06815a3494e",
                                "text": "Sie verharren zu lange im Mittelfeld und gehen zu wenig nach vorne."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2e4e306-0e28-3bf0-9bde-5ea0a78a440a",
                        "entry_id": "5ee845ae-19ff-3974-aa6b-d0e6de5b46ad",
                        "glosses": [
                            "der Teil der Wettkämpfer, der hinter der Spitze platziert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e573b38e-f608-4df1-be8a-8340be189c58",
                                "sense_id": "a2e4e306-0e28-3bf0-9bde-5ea0a78a440a",
                                "text": "Das Mittelfeld hat den Anschluss an die Spitze schon verloren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "111f9390-4b4c-3b9c-89f4-633814170a36",
                        "entry_id": "5ee845ae-19ff-3974-aa6b-d0e6de5b46ad",
                        "glosses": [
