                "senses": [
                    {
                        "sense_id": "c7ee6077-5d8b-3b79-b431-2ad72633b746",
                        "entry_id": "9fd14497-b7c1-3971-8a4b-78cc74d17f83",
                        "glosses": [
                            "aus Stahl gefertigter Nagel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a63816-cfb8-4b06-a9fe-2c9f21e0d34c",
                                "sense_id": "c7ee6077-5d8b-3b79-b431-2ad72633b746",
                                "text": "„Aus geringer Entfernung hat sich ein ein Arbeiter in Tirol am Montag in der Früh einen Stahlnagel ins Auge geschossen.“"
                            },
                            {
                                "example_id": "dbf6edde-2d78-44ca-9475-8ae81d7be293",
                                "sense_id": "c7ee6077-5d8b-3b79-b431-2ad72633b746",
                                "text": "„Plötzlich sah er unmittelbar vor dem linken Vorderrad einen Teppich glitzernder Stahlnägel, und fast im gleichen Augenblick war er schon darüber hinweg.“"
                            },
                            {
                                "example_id": "766c5dfb-bb24-46fd-80aa-c8ea4ed57555",
                                "sense_id": "c7ee6077-5d8b-3b79-b431-2ad72633b746",
                                "text": "„Und jetzt, zehn Jahre später, lag er mit einem Stahlnagel im Bein in einem Krankenhausbett und bettelte darum, wieder zurück an die Front geschickt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
