                "senses": [
                    {
                        "sense_id": "e737c035-d200-32ab-8541-fe52dc74a7bc",
                        "entry_id": "69ab6179-4cb9-3eb4-a69a-0fc37b481b5a",
                        "glosses": [
                            "hinüberschauen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "66ea70b8-1347-416f-9c3d-c061a528d64c",
                                "sense_id": "e737c035-d200-32ab-8541-fe52dc74a7bc",
                                "text": "„An insan Goscht’n woxt a Himbeerstaud - do wo ma zun Nachbarn ummischaut.“"
                            },
                            {
                                "example_id": "1159d9f4-eeb8-43f3-8715-66afc57bc365",
                                "sense_id": "e737c035-d200-32ab-8541-fe52dc74a7bc",
                                "text": "„Da rief Herr Schill im Ummeschaun: ‚Die Säbel aus der Scheide!‘“"
                            },
                            {
                                "example_id": "5919ca0d-814a-466a-9490-84a526eace4b",
                                "sense_id": "e737c035-d200-32ab-8541-fe52dc74a7bc",
                                "text": "„Na laß mi a mal umischaun bei dir — da schauts recht sauba aus, du haltst halt dein Sach’n allaweil z’sammg’wixt auf’n Glanz!“"
                            },
                            {
                                "example_id": "d5f0b509-0675-471e-a8f9-5cfd6a8ab446",
                                "sense_id": "e737c035-d200-32ab-8541-fe52dc74a7bc",
                                "text": "„»Na na! Jetzt hab ich mei’ Zuversicht in die Füß. Auf Enzdorf schau ich ummi, und auf Mitterwang, und auf Hirschbichl eini!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69d2a288-cc46-32b5-9391-974ed6b31ad2",
                        "entry_id": "69ab6179-4cb9-3eb4-a69a-0fc37b481b5a",
                        "glosses": [
                            "einen kurzen Besuch abstatten"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "2abad986-78ad-4d3f-9b66-998c5280f8c1",
                                "sense_id": "69d2a288-cc46-32b5-9391-974ed6b31ad2",
                                "text": "Zur Nachbarin müssen wir auch mal wieder umhinschauen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
