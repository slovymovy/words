            "pos": "verb",
            "senses": [
                {
                    "sense_id": "489b0c95-23bc-32f6-89fa-e101e58717c0",
                    "sense_definition": "Стать слегка или частично видимым, проявиться на поверхности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После ремонта на потолке снова <w>проступило</w> жёлтое пятно.",
                            "target_lang_translations": {
                                "en": "After the renovation, the yellow stain <w>showed through</w> on the ceiling again."
                            }
                        },
                        {
                            "text": "От напряжения у него на лбу <w>проступили</w> капли пота.",
                            "target_lang_translations": {
                                "en": "From the strain, beads of sweat <w>appeared</w> on his forehead."
                            }
                        }
                    ],
                    "synonyms": [
                        "проявиться",
                        "показаться"
                    ],
                    "common_phrases": [
                        "проступать сквозь"
                    ],
                    "target_lang_definitions": {
                        "en": "To become slightly or partially visible; to emerge or show through on a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show through",
                                "target_lang_sense_clarification": "to be visible through a covering or layer"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "to become apparent or visible"
                            },
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to come into sight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edf8b342-5e5a-3e47-b1ad-6efa5a430947",
                    "sense_definition": "Выступить изнутри на поверхность в виде капель или влаги.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exudation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От сильного волнения на лбу у него <w>проступили</w> капли пота.",
                            "target_lang_translations": {
                                "en": "From intense agitation, drops of sweat <w>beaded</w> on his forehead."
                            }
                        },
                        {
                            "text": "После затяжных дождей на стенах подвала <w>проступила</w> влага.",
                            "target_lang_translations": {
                                "en": "After the prolonged rains, damp <w>seeped through</w> the basement walls."
                            }
                        }
                    ],
                    "synonyms": [
                        "выступить",
                        "просочиться"
                    ],
                    "common_phrases": [
                        "проступил пот"
                    ],
                    "target_lang_definitions": {
                        "en": "To exude or come out onto a surface from within, typically in the form of drops or moisture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bead",
                                "target_lang_sense_clarification": "to form into small drops of liquid on a surface"
                            },
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "to appear suddenly on the skin, often referring to sweat"
                            },
                            {
                                "target_lang_word": "seep through",
                                "target_lang_sense_clarification": "to leak or ooze slowly through a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
