                                "target_senses": [
                                    {
                                        "sense_id": "eb6d9073-b5b6-36c9-8cc2-cec1591350f7",
                                        "entry_id": "0cc22a4a-eb32-3182-ba2c-75a86fa3194f",
                                        "glosses": [
                                            "относящийся к меди, свойственный меди или сделанный из этого металла"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4af7ff1-e902-3078-97bb-da8eaab7d1f1",
                                        "entry_id": "0cc22a4a-eb32-3182-ba2c-75a86fa3194f",
                                        "glosses": [
                                            "перен. красновато-жёлтый, по цвету похожий на медь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49b132a3-c079-35fd-a6a5-baf22a4a49a7",
                                        "entry_id": "0cc22a4a-eb32-3182-ba2c-75a86fa3194f",
                                        "glosses": [
                                            "непробиваемый, невозмутимый, равнодушный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a84615-5e99-4075-9db0-8765e2c2edcb",
                                                "sense_id": "49b132a3-c079-35fd-a6a5-baf22a4a49a7",
                                                "text": "девушки с медными лицами, в разноцветных пончо не признают его за своего и удивлённо смотрят на восторженно кричащего вместе с ними маленького альбиноса."
                                            },
                                            {
                                                "example_id": "36b68c4d-6ec7-4f80-928c-d91a2b4ad46f",
                                                "sense_id": "49b132a3-c079-35fd-a6a5-baf22a4a49a7",
                                                "text": "Солдаты готовили очередной выстрел под наблюдением ведущего инженера ― тощего верзилы с медным равнодушным лицом."
                                            },
                                            {
                                                "example_id": "3e8b93fe-beee-4776-a30f-de6c3089f4bd",
                                                "sense_id": "49b132a3-c079-35fd-a6a5-baf22a4a49a7",
                                                "text": "Вы гляньте когда-нибудь на его рожу: ведь он поперёк себя шире. Вор с медной мордой. Ах, люди, люди."
                                            },
                                            {
                                                "example_id": "768a7f3a-0e69-485d-98f5-b2403b659197",
                                                "sense_id": "49b132a3-c079-35fd-a6a5-baf22a4a49a7",
                                                "text": "Тот, кто носит медный щит , тот имеет медный лоб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
