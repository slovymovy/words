                "senses": [
                    {
                        "sense_id": "1361152f-1283-379c-971e-0241054bae86",
                        "entry_id": "26159599-35f8-3578-aba6-e15f2c70c3d3",
                        "glosses": [
                            "nördlicher Landesteil von Deutschland, der unscharf abgegrenzt ist. Dazu zählen: Bremen, Hamburg, Mecklenburg-Vorpommern, Niedersachsen, Schleswig-Holstein sowie nach anderer Auffassung auch nördliche Teile von Brandenburg, Nordrhein-Westfalen und Sachsen-Anhalt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "9ac222e2-27a5-4c98-80f2-89e756b782e4",
                                "sense_id": "1361152f-1283-379c-971e-0241054bae86",
                                "text": "Meine Frau ist in Norddeutschland geboren."
                            },
                            {
                                "example_id": "367c8e80-b0e3-485e-8d30-4b3da0c6c470",
                                "sense_id": "1361152f-1283-379c-971e-0241054bae86",
                                "text": "„[…] in Norddeutschland [werden] an Tagen mit guten Bedingungen für grüne Stromproduktion oft auch Windräder abgeschaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "780b9d4c-488d-3eee-9895-d6a9183330d7",
                        "entry_id": "26159599-35f8-3578-aba6-e15f2c70c3d3",
                        "glosses": [
                            "eine Landschaft, die große Teile der Norddeutschen Tiefebene umfasst und von der Weichsel-Eiszeit geprägt worden ist"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "b422ecef-6dce-4072-a144-d41d51718d09",
                                "sense_id": "780b9d4c-488d-3eee-9895-d6a9183330d7",
                                "text": "Die Mecklenburgische Seenplatte wird zu Norddeutschland gezählt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "99b90a96-a16c-333e-b819-e486db6a2dfd",
                        "entry_id": "26159599-35f8-3578-aba6-e15f2c70c3d3",
                        "glosses": [
                            "ein Gebiet nördlich der Benrather Linie, das überwiegend von der niedersächsischen, norddeutschen bzw. plattdeutschen Sprache bzw. deren Dialekten geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e6f206-b5dd-41af-978b-399906f6c851",
                                "sense_id": "99b90a96-a16c-333e-b819-e486db6a2dfd",
                                "text": "Hier spricht man wie in Norddeutschland."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
