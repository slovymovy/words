                },
                {
                    "sense_id": "cf69ee8f-c1c4-3d68-a80d-72e0d389abc8",
                    "sense_definition": "The quality of being transparent, sharp, or easy to see through.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photograph captures the mountain landscape with amazing <w>clarity</w>.",
