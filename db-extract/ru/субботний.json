                    }
                ],
                "senses": [
                    {
                        "sense_id": "fce94772-4fa7-3254-944c-57ead7fe6ad5",
                        "entry_id": "4ec4f75c-2b9b-3fbb-a939-6d2d9345db08",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным суббота; свойственный, характерный для субботы; происходящий в этот день"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2eccd8-066b-42f1-b421-aafa4fbd3582",
                                "sense_id": "fce94772-4fa7-3254-944c-57ead7fe6ad5",
                                "text": "Но всё-таки, что же было дальше-то в Москве после того, как в субботний вечер на закате Воланд покинул столицу, исчезнув вместе со своей свитой с Воробьёвых гор?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6034783-c100-480c-abe9-afdd91f3f19c",
                        "source_entry_id": "4ec4f75c-2b9b-3fbb-a939-6d2d9345db08",
                        "source_sense_id": "fce94772-4fa7-3254-944c-57ead7fe6ad5",
                        "target_lang_word": "Saturday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saturday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                        "entry_id": "e45773bf-5fed-30ed-a8a2-552b2c1da303",
                                        "glosses": [
                                            "The seventh day of the week in many religious traditions, and the sixth day of the week in systems using the ISO 8601 norm; the Jewish Sabbath; it follows Friday and precedes Sunday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ccf3b6-00c6-4864-91d8-ae6cb6a8e4fc",
                                                "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                                "text": "The Beijing-based firm — one of four funds created by the Chinese government in 1999 to process the bad loans of state-owned banks — announced Saturday that it would send a group of 50 experts to the province to help it “prevent and defuse risks” and “bail out” the real estate industry."
                                            },
                                            {
                                                "example_id": "caed5acd-6625-451f-8ed4-d6afbf49e17c",
                                                "sense_id": "fa6d2c13-f093-33c8-bf6b-48589ed83d57",
                                                "text": "Saturday’s tariffs are unlikely to be Trump’s last. The president said himself said in the Oval Office that additional tariffs could come by mid-February on chips, pharmaceuticals, steel, aluminum, copper, oil and gas imports – along with tariffs on the European Union – all threats that few would discount given his willingness to follow through on the North American and China tariffs on Saturday."
                                            }
                                        ]
                                    }
                                ]
                            },
