                                                "sense_id": "5100e2a8-a006-3f94-837f-34b9ef49b353",
                                                "text": "Die Textur entwickelte sich zur Zeit der Gotik in Frankreich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82897855-a343-346d-be53-a532aa4add1e",
                                        "entry_id": "15068ff5-747e-34c6-b9df-f4a6c2f95fb7",
                                        "glosses": [
                                            "Oberflächenstruktur von 3D-Objekten"
                                        ],
                                        "tags": [
                                            "Computergrafik",
                                            "Materialwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6853f831-4d9f-454e-aea0-463d0bbb46e1",
                                                "sense_id": "82897855-a343-346d-be53-a532aa4add1e",
                                                "text": "Je moderner die Videospiele werden, umso detailreicher wirken die Texturen."
                                            },
                                            {
                                                "example_id": "1300d2a2-6cb5-4cc4-ab2c-d2ccb461b949",
                                                "sense_id": "82897855-a343-346d-be53-a532aa4add1e",
                                                "text": "„Es war auch nicht gefärbt, wie ich anfangs vermutet hatte, und hatte keine strohartige Textur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
