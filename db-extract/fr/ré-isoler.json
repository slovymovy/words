                ],
                "senses": [
                    {
                        "sense_id": "4fc7012a-06d9-30b7-9618-49f2c2ac38a5",
                        "entry_id": "1c77c098-d31c-3bbd-95a9-6f33504f8978",
                        "glosses": [
                            "Isoler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ad064b-eddc-4af6-8019-3e30a91043c9",
                                "sense_id": "4fc7012a-06d9-30b7-9618-49f2c2ac38a5",
                                "text": "Il faudrait les ré-isoler par l’extérieur, ce qui permettrait aussi de les relooker."
                            },
                            {
                                "example_id": "f033a26e-c4c2-4824-9fdd-9c7de5e9cafa",
                                "sense_id": "4fc7012a-06d9-30b7-9618-49f2c2ac38a5",
                                "text": "Bien les ré-isoler avec du scotch électrique, câble par câble."
                            },
                            {
                                "example_id": "3af1ec27-0cd7-4ef4-867c-26d4a6b1cdc0",
                                "sense_id": "4fc7012a-06d9-30b7-9618-49f2c2ac38a5",
                                "text": "Il y deux murs de la chambre d'amis ou l'on doit enlever le gypse et la laine isolante pour ensuite les ré-isoler avec des panneaux de mousse, un coupe-vapeur et refaire le gypse et les joints;"
                            }
                        ]
                    }
