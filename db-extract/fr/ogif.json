                        "glosses": [
                            "En forme d’ogive ; ogival."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd52bd46-4369-451e-a894-44d808f1c094",
                                "sense_id": "1c278bfa-0768-3837-a7c1-360388ad0c2c",
                                "text": "Traversant la nef médiane, un grand arc ogif de 6 mètres de hauteur, s'amortit des deux côtés sur les blocs de maçonnerie qui portent les arcades. Là, se voyait autrefois, l'ambon. Les entailles de réception des poutres transversales ont disparu sous un vulgaire mortier de chaux bâtarde de ciment."
                            },
                            {
                                "example_id": "70ca9650-4fc3-4e6d-9d33-da38d29c189b",
                                "sense_id": "1c278bfa-0768-3837-a7c1-360388ad0c2c",
                                "text": "Qu'on m'ouvre le castel, ses tours, sa porte ogive !"
                            }
                        ]
                    }
