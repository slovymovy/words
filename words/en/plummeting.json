{
    "word_family": [
        "plummet"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f61505c-70ee-3047-a326-dec321607ff3",
                    "sense_definition": "Present participle and gerund of <w>plummet</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market saw share values <w>plummeting</w> throughout the afternoon.",
                            "target_lang_translations": {
                                "it": "Il mercato azionario ha visto il valore delle azioni <w>crollare</w> per tutto il pomeriggio."
                            }
                        },
                        {
                            "text": "Temperatures are <w>plummeting</w> rapidly as the arctic cold front arrives.",
                            "target_lang_translations": {
                                "it": "Le temperature stanno <w>precipitando</w> rapidamente con l'arrivo del fronte freddo artico."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunging",
                        "dropping"
                    ],
                    "antonyms": [
                        "soaring",
                        "skyrocketing"
                    ],
                    "common_phrases": [
                        "plummeting temperatures"
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio di 'plummet': che precipita, che crolla o scende a picco vertiginosamente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "precipitare",
                                "target_lang_sense_clarification": "cadere rapidamente e bruscamente"
                            },
                            {
                                "target_lang_word": "crollare",
                                "target_lang_sense_clarification": "subire un calo repentino e forte"
                            },
                            {
                                "target_lang_word": "in caduta libera",
                                "target_lang_sense_clarification": "usato in senso figurato per valori o temperature"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04778a56-fccc-31d5-a991-b13e224f317c",
                    "sense_definition": "A violent, sudden, or dramatic fall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>plummeting</w> of house prices left many homeowners in serious debt.",
                            "target_lang_translations": {
                                "it": "L'improvviso <w>crollo</w> dei prezzi delle case ha lasciato molti proprietari gravemente indebitati."
                            }
                        },
                        {
                            "text": "Analysts were shocked by the continuous <w>plummeting</w> of consumer confidence.",
                            "target_lang_translations": {
                                "it": "Gli analisti sono rimasti scioccati dalla continua <w>caduta a picco</w> della fiducia dei consumatori."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunge",
                        "drop"
                    ],
                    "antonyms": [
                        "soar",
                        "surge"
                    ],
                    "target_lang_definitions": {
                        "it": "Una caduta o un calo violento, improvviso o drammatico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "crollo",
                                "target_lang_sense_clarification": "brusco e drastico calo di prezzi o fiducia"
                            },
                            {
                                "target_lang_word": "caduta a picco",
                                "target_lang_sense_clarification": "discesa rapida e verticale"
                            },
                            {
                                "target_lang_word": "tracollo",
                                "target_lang_sense_clarification": "grave e improvviso declino"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}