                        "source_sense_id": "2502e900-fbc6-3a59-b907-c0c678bd9e9a",
                        "target_lang_word": "jésuitisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jésuitisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "625d6261-03b3-38a4-9325-e2eed11631b7",
                                        "entry_id": "fc312cf1-2b99-3df5-8702-33f5aea7f5ab",
                                        "glosses": [
                                            "Doctrine, système de religion et de conduite attribués aux jésuites."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90889de8-ac64-32c1-b42b-6594a170e419",
                                        "entry_id": "fc312cf1-2b99-3df5-8702-33f5aea7f5ab",
                                        "glosses": [
                                            "Escobarderie, acte qui semble manquer de franchise et de sincérité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1de4e1-4b61-4dfa-a283-d4d3abb7da28",
                                                "sense_id": "90889de8-ac64-32c1-b42b-6594a170e419",
                                                "text": "Le docteur, comme tous les gens qui font profession de jésuitisme, s’exagérait Paris ; il le voyait peuplé d’athées furibonds comme Diderot, ou ironiques comme Voltaire, et de pères jésuites fort puissants faisant bâtir des séminaires plus grands que des casernes."
                                            },
                                            {
                                                "example_id": "5e7d03f2-2e57-4b10-81fe-ee9337267448",
                                                "sense_id": "90889de8-ac64-32c1-b42b-6594a170e419",
                                                "text": "Faites attention : ici il faudra choisir votre camp, il n’y a pas de place pour le double jeu. Ce qu’il me reprochait, en somme, c’était du jésuitisme."
                                            },
                                            {
                                                "example_id": "de13c2a2-dc51-4a2b-b82e-9e07c87cf479",
                                                "sense_id": "90889de8-ac64-32c1-b42b-6594a170e419",
                                                "text": "Cette conception des rapports avec un adversaire politique, ce jésuitisme détestable, a fait davantage pour détruire le mouvement ouvrier dans son ensemble qu’aucune des tactiques « sacrées » du bolchevisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
