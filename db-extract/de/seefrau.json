                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa4e23c9-798b-4e6b-8d2a-06d847c86a38",
                        "source_entry_id": "cd36fa4a-a89a-3bdc-baac-2d8761d7ead4",
                        "source_sense_id": "c7bc309a-c4ec-3fc7-9af8-2378ce7734c5",
                        "source_sense_description": "eine in der Seeschiffahrt tätige Frau",
                        "target_lang_word": "sailor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sailor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d951843-a999-3c05-b678-0c54b8a55684",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "A person who sails; one whose occupation is sailing or navigating ships or other waterborne craft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69736686-aa75-493e-8cb6-4e7048068170",
                                                "sense_id": "3d951843-a999-3c05-b678-0c54b8a55684",
                                                "text": "He's a talented sailor and has spent many years at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e5a267-ba85-3fd4-9427-324ba35e2e0f",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "A person who sails; one whose occupation is sailing or navigating ships or other waterborne craft.",
                                            "In particular, a member of the crew of a (civilian or military) vessel, as opposed to a captain, admiral, etc.; a mariner; a common seaman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb3147b-e411-43d4-bc51-5d7ff4890a36",
                                                "sense_id": "30e5a267-ba85-3fd4-9427-324ba35e2e0f",
                                                "text": "Merchants, common sailors, captains of vessels, skippers, […] naval officers of all countries, and the Governments of several states on the two continents, were deeply interested in the matter."
                                            },
                                            {
                                                "example_id": "5fb2ae34-2082-4f83-b3bc-921313329577",
                                                "sense_id": "30e5a267-ba85-3fd4-9427-324ba35e2e0f",
                                                "text": "Mary is a sailor\ndreaming of northern shores\nlost galleons on the sea\nMary ever on her way"
                                            },
                                            {
                                                "example_id": "7e868662-8c30-4854-b286-7e0bd69f6e41",
                                                "sense_id": "30e5a267-ba85-3fd4-9427-324ba35e2e0f",
                                                "text": "Another sailor was taken into custody."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b949118-ac4e-39dc-85b7-a8badcd6b0c0",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "A person who sails; one whose occupation is sailing or navigating ships or other waterborne craft.",
                                            "A person who sails sailing boats (as opposed to boats powered by other means) as a sport or recreation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c3dc4d5-0953-3aaa-9821-dc1c4f59f6b8",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genera Neptis, Pseudoneptis and Phaedyma, having white markings on a dark base and commonly flying by gliding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfa8e16f-a65f-3768-8463-56d5fc165439",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "A stiff straw hat with a flat, circular brim and a low, flat crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b18e7b-8969-400e-8453-eb0cec07a4d8",
                                                "sense_id": "dfa8e16f-a65f-3768-8463-56d5fc165439",
                                                "text": "Straw Sailors. Children's large-leaf straw sailors, in new shapes, smooth or rough straw . Sizes 6 to 64. 80c, $1.00, $1.50 and $2.00. Milan sailors in new, large shapes, with white or cream ribbon."
                                            },
                                            {
                                                "example_id": "cfd8e434-63a2-455e-8e54-e861e4fe5881",
                                                "sense_id": "dfa8e16f-a65f-3768-8463-56d5fc165439",
                                                "text": "[…]the trade that was done for some year in sailors for ladies. […] Developments of a fancifu nature in the brim formation in the direction of what is known as a \"Breton\" sailor, of which the characteristic is a slightly upturned edge, were the first to be made, […] But to-day, with the exception of straw sailors for girls and young ladies at school, there is very little demand for hats of this description."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fa8abd-2dfa-39b9-98eb-48c62d3416f1",
                                        "entry_id": "228f3088-f14c-3ee6-bdeb-cfb6e01c57bb",
                                        "glosses": [
                                            "A brick, for example in a course of brickwork, that is laid vertically on its shortest end (smallest face), with its widest face facing the outside of the wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4ad943e-9648-406c-bea4-33e97246e8c5",
                        "source_entry_id": "cd36fa4a-a89a-3bdc-baac-2d8761d7ead4",
                        "source_sense_id": "c7bc309a-c4ec-3fc7-9af8-2378ce7734c5",
                        "source_sense_description": "eine in der Seeschiffahrt tätige Frau",
                        "target_lang_word": "marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui appartient à la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a01e26-f91f-46bd-b437-62fe317ef403",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Si tout le tableau donnait cette impression des ports où la mer entre dans la terre, où la terre est déjà marine et la population amphibie, la force de l'élément marin éclatait partout ; […]"
                                            },
                                            {
                                                "example_id": "b2047151-4e12-4190-9c17-58978e60067e",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Enfin, comme à dessein de le rendre plus complexe, des odeurs de caroube, de denrées coloniales, de goudron, d'air marin arrivaient puissamment du port et se mêlaient à celles qui montaient des pavés et des caves."
                                            },
                                            {
                                                "example_id": "539e67e9-9bd8-4839-93e9-0fd8efdf4f31",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Il plongea ensuite entre ses cuisses, là où la matrice avait le goût salé des embruns marins."
                                            },
                                            {
                                                "example_id": "3c96012e-4100-4daa-b3cf-1a6eb1a5de12",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Veau, loup, cheval marin."
                                            },
                                            {
                                                "example_id": "a3c6bc61-a7ca-4e71-95f0-4d5f1cc7863f",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Terrains marins : Couches du sol qui ont été formées par des alluvions de la mer."
                                            },
                                            {
                                                "example_id": "0e09f7b2-88c9-4af7-9d74-2bdad4c249ea",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Les dieux marins : les dieux de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui est spécialement destiné à la marine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d33cc86-b48f-4a7c-ae8f-e9829d2c26b9",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Carte, aiguille marine."
                                            },
                                            {
                                                "example_id": "53982699-a369-436a-a72b-3f22b58f5a73",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Lieue marine : Lieue d’un vingtième de degré de latitude et qui vaut environ 5 555 mètres."
                                            },
                                            {
                                                "example_id": "1b4cf139-2276-4db7-87e5-3e7c7e93498e",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Trompette marine : → voir trompette"
                                            },
                                            {
                                                "example_id": "780190ed-e278-411a-8383-2efdc0a35069",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Avoir le pied marin : Savoir marcher sans difficulté à bord d’un vaisseau agité par le mouvement de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c94746-60f2-3785-a8db-a7ced9f67a5a",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui évoque un marin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387ed456-bab8-4992-a7c9-f2a2b45d7a77",
                                                "sense_id": "08c94746-60f2-3785-a8db-a7ced9f67a5a",
                                                "text": "Un jardinier persan vint à ma rencontre, pour me conduire au bureau du pasteur, un grand homme barbu et roux aux allures marines, à la poignée ferme et hospitalière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b03937b-1577-3422-a3fe-a55912a578e4",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Celui qui est habile dans l’art de la navigation sur mer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Celui qui sert à bord d’un bâtiment de l’État ou de la marine marchande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35df0b11-b095-40c8-8cda-242e833a9585",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Les marins, vois-tu, ne ressemblent pas au reste du monde. J’en ai vu qui, au début de leur engagement, avaient entre les mains des sommes assez fortes. Ils imaginaient un divertissement singulier. Ils faisaient chauffer les écus dans un poêlon, puis les jetaient dans la rue, riant aux éclats des efforts de la canaille pour s’en saisir. C’était une façon de marquer qu’on ne se fait pas tuer pour des pièces de six francs, et que le courage et le devoir ne se payent pas."
                                            },
                                            {
                                                "example_id": "986e90f1-ae16-4f7e-981f-00f5dec20096",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Jean Donnard allait répondre, quand les sept marins et le mousse, qui formaient le reste de son équipage, apparurent sur la cale, portant leurs capotes de toile cirée et leurs paniers d’osier."
                                            },
                                            {
                                                "example_id": "a2291ae4-e3a4-434d-b454-d95305092c6d",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "[…] et, quand il y pousserait de la graine d'épinard, un marin qui se respecte ne se résignera jamais à endosser la capote d'un fantassin..."
                                            },
                                            {
                                                "example_id": "e88522e1-c75c-4e57-9eba-75ac6fca80f2",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Le 4 octobre 1911, le Premier ministre Giolitti donne le coup d’envoi au départ d'un corps expéditionnaire. Il va vite atteindre les 100 000 hommes, marins et bersagliers, transportés par des centaines de navires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa15a284-28de-3818-96e8-02df16ca2000",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Vent tiède, accompagné de pluie, soufflant du sud sur les côtes du golfe du Lion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af0eb9fc-2d9a-37d4-8a32-d27f9d81cce3",
                                        "entry_id": "e8fb406e-cd3c-39c3-ba0f-5c9e36ccdbd2",
                                        "glosses": [
                                            "Nom des déblais lors de la foration d’un tunnel."
                                        ],
                                        "tags": [
                                            "Génie civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ddeeb8-f88f-44ca-ab0f-688b49f2f188",
                                                "sense_id": "af0eb9fc-2d9a-37d4-8a32-d27f9d81cce3",
                                                "text": "Le tunnelier laisse derrière lui une quantité importante de marin qu’il faut évacuer très rapidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851639c0-eb31-343b-bfe9-f5f2d19b2f27",
                                        "entry_id": "e8fb406e-cd3c-39c3-ba0f-5c9e36ccdbd2",
                                        "glosses": [
                                            "Matériau de remplissage servant à la constitution de l’aire sous un parquet sur lambourdes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cbeb97-b660-4da3-a99a-0559a3ebd28f",
                                                "sense_id": "851639c0-eb31-343b-bfe9-f5f2d19b2f27",
                                                "text": "Sur la partie supérieure, un lattis est utilisé puis recouvert d’une aire faîte de chaux et de plâtre, que l’on nomme également le marin. Sur cette aire, on forme ensuite des augets en plâtre qui servent à placer à niveau bien horizontal des lambourdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
