                    {
                        "sense_id": "8e69bec4-4b31-3a24-b884-b029854e7101",
                        "entry_id": "659ee580-843a-3030-b350-38609ba65245",
                        "glosses": [
                            "Having a coiled or twisted structure, involving a helical pattern."
