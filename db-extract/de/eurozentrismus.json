                                    {
                                        "sense_id": "8e048ed3-b0be-3e96-9548-fa6c7a1b4d83",
                                        "entry_id": "b4d29f59-3a32-3b98-b2a3-5a2a7576e947",
                                        "glosses": [
                                            "The practice of viewing the world from a European perspective, with an implied belief, either consciously or subconsciously, in the preeminence of European culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3fa81d8-b6ca-4c3f-983d-6981ccc95076",
                                                "sense_id": "8e048ed3-b0be-3e96-9548-fa6c7a1b4d83",
                                                "text": "The rather philistine assertion of Eurocentrism and Westernness on the part of conservative educators […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7880ac6-c10a-3f41-8d56-035191b5a950",
