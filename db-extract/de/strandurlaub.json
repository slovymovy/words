                ],
                "senses": [
                    {
                        "sense_id": "69073f8e-acf0-3dfb-a03f-83076ee92ef8",
                        "entry_id": "132197f0-2908-3acb-bbe3-d30a5599cbc1",
                        "glosses": [
                            "Urlaubsreise, bei der man die meiste Zeit am Strand (liegend) verbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c42488-1119-4f58-a72e-964aa407790e",
                                "sense_id": "69073f8e-acf0-3dfb-a03f-83076ee92ef8",
                                "text": "„Ob Strandurlaub in Sardinien, Fjord-Wanderungen in Norwegen oder Rafting in Laos – Chaotentouristen sind auf nichts wirklich vorbereitet und deshalb für alles gleichermaßen offen.“"
                            },
                            {
                                "example_id": "b4cfaa33-b9fb-4a29-a756-6ebae7d27cb0",
                                "sense_id": "69073f8e-acf0-3dfb-a03f-83076ee92ef8",
                                "text": "„Nicht Muscheln, sondern Steine sind das beste Erinnerungsstück an den jüngsten Strandurlaub. Sie haben eine besondere Magie.“"
                            },
                            {
                                "example_id": "4bb0a561-ba1d-450a-b70b-5fff84516e2e",
                                "sense_id": "69073f8e-acf0-3dfb-a03f-83076ee92ef8",
                                "text": "„Die antike Stadt Pergamon, erst Mitte des 19. Jahrhunderts von einem deutschen Forscher entdeckt, ist die Heimat bedeutender Funde. Für geschichtlich interessierte Touristen ein spannendes Ziel abseits der üblichen Strandurlaube.“"
                            },
                            {
                                "example_id": "5d9ef07f-3a11-44d6-8756-6fc843c2d206",
                                "sense_id": "69073f8e-acf0-3dfb-a03f-83076ee92ef8",
                                "text": "„Eigentlich hätte sie mal wieder einen Strandurlaub nötig, die weiße Haut war fast durchsichtig und so empfindlich, dass sie schon beim geringsten Reiz rot wurde oder einen Ausschlag bekam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
