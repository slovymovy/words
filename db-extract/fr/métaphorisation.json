                        "sense_id": "f4744268-4ab1-3f23-ae51-bff723ea1563",
                        "entry_id": "aac9fc58-c632-3974-ba43-cdff704001ca",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
