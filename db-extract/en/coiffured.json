                        "entry_id": "c9547143-911b-3c54-ab72-df353aa4c1f3",
                        "glosses": [
                            "Styled; Having been arranged and cut, especially when in an elaborate style."
                        ],
                        "tags": [
                            "of a person or animal's hair"
                        ],
                        "examples": [
                            {
                                "example_id": "2f7d4fb0-dfeb-4ec2-990b-5bd9470de437",
                                "sense_id": "898294fc-eb9d-3ff6-975c-31336ed8f494",
                                "text": "The elderly, snow-white-coiffured lady bolted before the group's self-appointed leader could perform his opening statement."
                            },
                            {
                                "example_id": "0ee414e2-3abd-4d95-b46c-2b17bdda2aa7",
                                "sense_id": "898294fc-eb9d-3ff6-975c-31336ed8f494",
                                "text": "He thought she looked like some coiffured dog, with her foreign hair and the bright red beads at her neck, her jowls hanging down."
                            },
                            {
                                "example_id": "93e0a4c0-cd7f-4e50-a488-7f0e400d65eb",
                                "sense_id": "898294fc-eb9d-3ff6-975c-31336ed8f494",
                                "text": "Inside the pavilion, identically clad, identically coiffured young ladies sport small green feathers in Tyrolean hats and a fairy with pointed ears made out of laser beams explains what we are about to see."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d88dc31-9230-3c04-a36c-c473f0cfde1d",
                        "entry_id": "c9547143-911b-3c54-ab72-df353aa4c1f3",
                        "glosses": [
                            "Resulting from elaborate training or construction."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b728c634-9ea4-4663-97b4-a139cd84979b",
                                "sense_id": "3d88dc31-9230-3c04-a36c-c473f0cfde1d",
                                "text": "Liz Dalton Interiors called for spectacular treatments like crown moldings and coiffured overheads which Rybovich built from solid teak."
                            },
                            {
                                "example_id": "f056e3d3-1587-481e-91e4-6689f133d0ae",
                                "sense_id": "3d88dc31-9230-3c04-a36c-c473f0cfde1d",
                                "text": "One aesthetic feature of the interior prominently displayed in Zhongguo jianzhu was the coiffured ceiling ."
                            },
                            {
                                "example_id": "d0d509cb-c0a1-4654-8b8d-e9d76a891f13",
                                "sense_id": "3d88dc31-9230-3c04-a36c-c473f0cfde1d",
                                "text": "Interrogating coiffured musical learnings is much less about uncovering particular truth than generating multiplicities of thinking and enacting by observing learning experiences of a young child, while reflecting on the realities of my own lived and living pathways."
                            }
                        ]
                    }
