                    "semantic_group_id": "tuinieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer was de hele middag bezig met het <w>ruchten</w> van zijn akker.",
                            "target_lang_translations": {
                                "en": "The farmer spent the whole afternoon <w>weeding</w> his field."
