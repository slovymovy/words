                                    {
                                        "sense_id": "b1e6fc02-b7cb-345f-bb56-cd5094e60c83",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Groupe de quatre éléments solidaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Nombre quatre, symbole de justice chez Pythagore ; série ou somme des quatre premiers nombres, combinaison numérique dans laquelle interviennent quatre nombres ou quatre opérations particulières."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ae4294-8635-49fe-86e7-b75281cea1a0",
                                                "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                                "text": "Tu t’appelleras Hermès, et tes disciples, quand tu les auras trouvés s’appelleront Tat, Asclèpios et Ammon. Puisse se compléter bientôt la tétrade hiératique qui doit transmettre, d’une génération à l’autre, le dépôt de la science sacrée."
                                            },
                                            {
                                                "example_id": "c1653427-0c24-4545-8591-55e66f5f73aa",
                                                "sense_id": "9e71a1e9-3b46-3b3b-b924-41454a9fd5ac",
                                                "text": "L’homme, dans l’antique doctrine, comme dans la vérité, est une tétrade, un quaternaire : il est sensation, sentiment, connaissance ; et il est ces trois choses unies, et formant par leur réunion une unité, une monade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f557128-b854-3e11-8a92-312247d0a8e7",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Nombre quatre, symbole de justice chez Pythagore ; série ou somme des quatre premiers nombres, combinaison numérique dans laquelle interviennent quatre nombres ou quatre opérations particulières.",
                                            "Ensemble de quatre éléments tels que ceux qui forment ou qui définissent l’âme, l’Homme ou la Divinité."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "759fedde-8620-3df4-b025-88a7b07dbd60",
                                        "entry_id": "f89d20db-c1f6-34fd-92fa-9eb114d2a07b",
                                        "glosses": [
                                            "Ensemble des quatre chromatides associées au sein d’un bivalent."
                                        ],
