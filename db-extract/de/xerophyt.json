                        "sense_id": "1ed5a8f1-aaea-3523-9369-f5febe0e04a0",
                        "entry_id": "a8eb81ec-b887-3cea-aec8-f8591d5ce1f5",
                        "glosses": [
                            "Pflanze, die an Trockenheit angepasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acea967-8571-44b8-914c-ca7acf660116",
                                "sense_id": "1ed5a8f1-aaea-3523-9369-f5febe0e04a0",
                                "text": "Zu dieser Gruppe der Xerophyten gehören Vertreter der verschiedensten Familien, und es ist deshalb nicht merkwürdig, daß sie im einzelnen morphologisch und anatomisch sehr verschiedene Züge aufweisen können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6349f204-080c-4b3d-b68c-e599ae0e73d4",
