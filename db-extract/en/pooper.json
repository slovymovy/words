                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e91de99b-c8a1-3eaa-b4a3-8fef26792eca",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
                            "A toilet."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8fb77763-9128-4f85-bdaa-d084abaa3d05",
                                "sense_id": "e91de99b-c8a1-3eaa-b4a3-8fef26792eca",
                                "text": "\"Here I sit, on the pooper, giving birth to a Maine state trooper.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "30240329-b77a-3c5c-aee5-f6be0ae4cd02",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
                            "Clipping of YouTube Pooper."
                        ],
                        "tags": [
                            "Internet",
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": [
                            {
                                "example_id": "57c5376b-4338-45c6-91a6-751195099481",
                                "sense_id": "30240329-b77a-3c5c-aee5-f6be0ae4cd02",
                                "text": "For whatever reason – the terrible animation or the absurd dialogue, most likely – these cutscenes are popular among poopers."
                            },
                            {
                                "example_id": "f3b7d79d-c242-4a60-b8a4-9e8b55a2fa9d",
                                "sense_id": "30240329-b77a-3c5c-aee5-f6be0ae4cd02",
                                "text": "Many who disregard the medium are oblivious to the absurd amount of effort that some Poopers put into their projects."
                            },
                            {
                                "example_id": "f6e8dc7e-22f7-4e13-afae-4cb1e266b65e",
                                "sense_id": "30240329-b77a-3c5c-aee5-f6be0ae4cd02",
                                "text": "But each individual YTP features something different, and different YTP creators (often called \"poopers\") use their own styles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5ec8467-68a9-4959-9a3b-d1acd537b435",
                        "source_entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "source_sense_description": "party pooper",
                        "target_lang_word": "Spielverderber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielverderber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                        "entry_id": "d867753d-c0a2-38b7-8982-3c810cb69d2d",
                                        "glosses": [
                                            "ursprünglich: Person, die Regeln des Spiels und des Spielens bewusst missachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6c3e80-2aae-49a3-8ef9-84209dc12919",
                                                "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                                "text": "„Spielverderber José Mourinho verhagelte Jürgen Klopp mit seiner Defensivtaktik die gute Laune.“"
                                            },
                                            {
                                                "example_id": "0c1ca4be-fc80-47c9-9717-c3cecddc7054",
                                                "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                                "text": "„Spielverderber kennzeichnen sich dadurch, dass sie sich nicht an Regeln halten.“"
                                            },
                                            {
                                                "example_id": "cb7089d3-d7d4-4b1c-a38a-40fd6eef77b4",
                                                "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                                "text": "„Auch unter Jugendlichen und Erwachsenen trifft man immer wieder auf Spielunwillige und Spielverderber, die sich über Regeln hinwegsetzen oder sie nicht ernst nehmen und damit das Spiel zerstören.“"
                                            },
                                            {
                                                "example_id": "6e90f87d-7e26-48d2-92e9-d35db24d7b07",
                                                "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                                "text": "„Herbert ist ein Spielverderber.“"
                                            },
                                            {
                                                "example_id": "33a7b5db-e3eb-47bb-bd21-b0ff017aaf31",
                                                "sense_id": "3d0b0da8-d408-3dfb-bc2f-77c3147e5610",
                                                "text": "„Beim Großen Preis von Japan will der Ferrari-Pilot wie am vorigen Wochenende bei seinem Triumph in Singapur den Spielverderber geben und Weltmeister Lewis Hamilton sowie dessen Stallrivalen Nico Rosberg im Titelkampf ärgern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                        "entry_id": "d867753d-c0a2-38b7-8982-3c810cb69d2d",
                                        "glosses": [
                                            "bildlich/übertragen: Person, die aus einer allgemeinen Erwartungshaltung ausbricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be18dd2-a798-46e3-b328-55e79d2df36f",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "„Herbert ist ein Spielverderber.“"
                                            },
                                            {
                                                "example_id": "fbc82442-ccda-42c0-bbda-a0c0f4d1c087",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "„Beim Großen Preis von Japan will der Ferrari-Pilot wie am vorigen Wochenende bei seinem Triumph in Singapur den Spielverderber geben und Weltmeister Lewis Hamilton sowie dessen Stallrivalen Nico Rosberg im Titelkampf ärgern.“"
                                            },
                                            {
                                                "example_id": "2d02265b-5380-4e70-b799-47eb5285d97c",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "„Er war ein famoser Junge, ich kam mir schändlich neben ihm vor, schändlich wie ein Spielverderber.“"
                                            },
                                            {
                                                "example_id": "fd3b58d7-0676-46f7-b6c4-d75ed8df4678",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "„Bei der Betrachtung dieser wundersamen Kapitalvermehrung auf dem Warenmarkt gebärdet sich Marx nun als ein ausgesprochener Spielverderber.“"
                                            },
                                            {
                                                "example_id": "88848505-1984-4a70-8bf5-e8715eef0032",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "Vorgesetzten, Lehrern, Ärzten gegenüber regen sich häufig Hassgedanken. Sie sind meist Spielverderber in der Gesellschaft, sobald ihre Überlegenheit nicht deutlich hervortritt, und sie brechen jede Freundschafts- und Liebesbeziehung nach kurzer Zeit oft ab, wenn sich der Andere nicht willenlos unterordnet."
                                            },
                                            {
                                                "example_id": "873365a3-da01-4747-b56f-bebf11d48fbf",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "Ach komm, sei kein Spielverderber, komm mit!"
                                            },
                                            {
                                                "example_id": "9bba9f56-58e8-4ad9-a26a-3db1b5efec7c",
                                                "sense_id": "b1e719fd-fc41-3da0-82f7-11f149256774",
                                                "text": "„Der Spielverderber mäßigte, gab zu bedenken, kassierte Sätze und Anekdoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
