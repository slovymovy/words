                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige mensen zijn nu <w>eenmaal</w> niet zo vriendelijk.",
                            "target_lang_translations": {
                                "en": "Some people are <w>simply</w> not that friendly.",
                                "ru": "Некоторые люди <w>просто</w> не так дружелюбны.",
                                "pl": "Niektórzy ludzie <w>po prostu</w> nie są zbyt mili.",
                                "de": "Manche Menschen sind <w>nun einmal</w> nicht so freundlich.",
                                "fr": "Certaines personnes ne sont <w>tout simplement</w> pas très aimables.",
                                "it": "Alcune persone sono <w>semplicemente</w> non così amichevoli.",
                                "cs": "Někteří lidé jsou <w>zkrátka</w> méně přátelští.",
                                "tr": "Bazı insanlar <w>sonuçta</w> o kadar da arkadaş canlısı değiller.",
                                "es": "Algunas personas <w>simplemente</w> no son tan amables.",
                                "zh": "有些人<w>毕竟</w>没那么友善。"
                            }
                        },
                        {
                            "text": "We hebben nu <w>eenmaal</w> minder tijd dan vroeger.",
                            "target_lang_translations": {
                                "en": "We <w>simply</w> have less time than before.",
                                "ru": "У нас <w>просто</w> меньше времени, чем раньше.",
                                "pl": "Mamy <w>po prostu</w> mniej czasu niż kiedyś.",
                                "de": "Wir haben <w>nun einmal</w> weniger Zeit als früher.",
                                "fr": "Nous avons <w>tout simplement</w> moins de temps qu'avant.",
                                "it": "Abbiamo <w>semplicemente</w> meno tempo di prima.",
                                "cs": "Máme <w>prostě</w> méně času než dřív.",
                                "tr": "<w>Ne de olsa</w> eskiye göre daha az zamanımız var.",
                                "es": "<w>Simplemente</w> tenemos menos tiempo que antes.",
                                "zh": "我们<w>就是</w>比以前时间少了。"
                            }
                        }
