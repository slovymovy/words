                                            {
                                                "example_id": "3fd23219-bd38-40e2-be1a-753ab79df299",
                                                "sense_id": "be16634a-e77a-37ef-876d-58c4ddf2a2cb",
                                                "text": "Sie denkt sehr analytisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                        "entry_id": "f04a41fb-9e39-3816-b7c6-cc4afa1bb1dd",
                                        "glosses": [
                                            "Eigenschaft grammatischer Formen oder ganzer Sprachen, die sich durch die folgenden Eigenschaften auszeichnen"
                                        ],
                                        "tags": [
                                            "speziell Sprachtypologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbabf268-fdfa-4114-a6a9-bfec52925056",
                                                "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                                "text": "Das Perfekt wird im Deutschen analytisch gebildet."
                                            },
                                            {
                                                "example_id": "2295c204-4462-4c7f-a50c-7731d3f4b10d",
                                                "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                                "text": "Das Prädikat in dem Satz \"Ich würde gerne kommen\" ist analytisch gebildet; in \"Ich käme gerne\" dagegen synthetisch. Der Begriff analytisch wird vor allem in der Sprachtypologie verwendet."
                                            },
                                            {
                                                "example_id": "435d0d2d-b2a0-4798-8026-3e95c7ffb551",
                                                "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                                "text": "„Grammatiktheoretisch wird diese Veränderung als Wandel vom synthetischen zum analytischen Sprachbau klassifiziert…“"
                                            },
                                            {
                                                "example_id": "905a5047-6cc9-410e-87ce-b91af6644046",
                                                "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                                "text": "„Es ist vielfach konstatiert worden, daß sich das Deutsche in den letzten tausend Jahren vom flektierenden zum analytischen Sprachtypus hin entwickelt habe.“"
                                            },
                                            {
                                                "example_id": "7d9ce5b9-fe3d-4cf2-ae9a-0f9e883fe76d",
                                                "sense_id": "e608725e-0512-39a6-8546-1a3631bf4df3",
                                                "text": "„Der Wandel vom synthetischen zum analytischen Sprachbau setzt sich im Neuhochdeutschen fort und ist auch am veränderten Kasusgebrauch abzulesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
