                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Генрих <w>Ягода</w> был известным советским государственным деятелем.",
                            "target_lang_translations": {
                                "de": "Genrich <w>Jagoda</w> war ein bekannter sowjetischer Staatsmann."
                            }
                        },
                        {
                            "text": "В списке пассажиров значилась фамилия <w>Ягода</w>.",
                            "target_lang_translations": {
                                "de": "Auf der Passagierliste stand der Nachname <w>Jagoda</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "фамилия"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Familienname jüdischer oder slawischer Herkunft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Jagoda",
                                "target_lang_sense_clarification": "Familienname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11379911-01f7-31e4-8217-b2154f47b137",
                    "sense_definition": "Село в Старозагорской области Болгарии.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Туристы остановились в неболшом болгарском селе <w>Ягода</w>.",
                            "target_lang_translations": {
                                "de": "Die Touristen machten Halt in dem kleinen bulgarischen Dorf <w>Jagoda</w>."
                            }
                        },
                        {
                            "text": "Дорога в село <w>Ягода</w> проходила через живописные холмы.",
                            "target_lang_translations": {
                                "de": "Der Weg in das Dorf <w>Jagoda</w> führte durch malerische Hügel."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Dorf in der Oblast Stara Sagora in Bulgarien."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Jagoda",
                                "target_lang_sense_clarification": "Ortsname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
