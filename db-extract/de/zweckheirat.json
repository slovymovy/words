                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6711bd-dc2d-4e31-b710-6d61b3331cce",
                                "sense_id": "971dddc4-081d-3ad4-8999-1d531c3da767",
                                "text": "„Cyprian war eher willens, sich an einen Mann zu binden, als Sylvia, die eine Heirat kategorisch ablehnte, selbst eine Zweckheirat zum Schein.“"
                            },
                            {
                                "example_id": "50288bfa-5e8c-4eb9-8937-c4bf15993e70",
                                "sense_id": "971dddc4-081d-3ad4-8999-1d531c3da767",
                                "text": "„Die Ehe ist für beide eine Zweckheirat, aber eine kluge Entscheidung.“"
                            }
                        ],
