                                "target_senses": [
                                    {
                                        "sense_id": "05aadb78-8815-3860-af27-43ced775b837",
                                        "entry_id": "f17e3942-edbb-30cb-9bec-49c657a24d8a",
                                        "glosses": [
                                            "Partisane d’Adolf Hitler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16301a2-69d2-4934-9e26-52c95395bfbd",
                                                "sense_id": "05aadb78-8815-3860-af27-43ced775b837",
                                                "text": "La jeune infirmière souriante peut se révéler une hitlérienne convaincue."
                                            },
                                            {
                                                "example_id": "d0a763ca-6677-4cd2-a20c-ad700aa34797",
                                                "sense_id": "05aadb78-8815-3860-af27-43ced775b837",
                                                "text": "Presque toutes les femmes et les jeunes filles allemandes étaient des hitlériennes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hitlérienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f41adc9-97ae-3e4d-b977-57d4d8477f2f",
                                        "entry_id": "47706aad-516c-34a7-bfb9-aaaa84d47458",
                                        "glosses": [
                                            "Féminin singulier de hitlérien."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acda89c1-5f12-4af8-a6ed-b67010146c64",
                                                "sense_id": "0f41adc9-97ae-3e4d-b977-57d4d8477f2f",
                                                "text": "Mais tous les membres de la coalition des forces antihitlériennes du pays étaient d’accord à ce qu’une ferme riposte soit donnée à tout essai des troupes allemandes d’empêcher la Roumanie de sortir de la guerre hitlérienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
