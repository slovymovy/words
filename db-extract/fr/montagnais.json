                    {
                        "sense_id": "08e907dd-1c4a-3ad6-8479-31c256b65606",
                        "entry_id": "dc45f2ba-6770-3482-be71-912750daa7c1",
                        "glosses": [
                            "Langue parlée par les Innus, peuple autochtone de l’Est du Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40928373-b375-4b7d-964f-37c757d86fa2",
                                "sense_id": "08e907dd-1c4a-3ad6-8479-31c256b65606",
                                "text": "Amishk signifie « castor » en montagnais."
                            },
                            {
                                "example_id": "c44bdbfd-c9db-44a0-80cb-ef07a35f50df",
                                "sense_id": "08e907dd-1c4a-3ad6-8479-31c256b65606",
                                "text": "Le nom de l’île Manowin vient du montagnais manouane, qui signifie « là où on ramasse les oeufs »."
                            },
                            {
                                "example_id": "bbe7ddf1-cb93-4950-97ee-7a120b47f238",
                                "sense_id": "08e907dd-1c4a-3ad6-8479-31c256b65606",
                                "text": "Le sympathique gaillard vous apprendra que le mot chicoutai vient du montagnais et qu’en français, le terme original est plat-de-bière, devenu au fil des générations plaquebière. — (La Presse, 17 août 2006)"
                            }
                        ]
                    }
