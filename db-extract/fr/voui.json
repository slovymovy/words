        "fr-extract.jsonl": [
            {
                "entry_id": "06976554-f11c-3c0f-9c4c-12add328e6c9",
                "word": "voui",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08e7e0a5-0f29-485e-bcda-91cbfc171304",
                        "entry_id": "06976554-f11c-3c0f-9c4c-12add328e6c9",
                        "tags": [],
                        "form": "woui"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                        "entry_id": "06976554-f11c-3c0f-9c4c-12add328e6c9",
                        "glosses": [
                            "Oui."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "941eed8b-9d60-46ca-a635-d191bafa5649",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "« Voui, aillet, pas de problème, on s'en occupe. »"
                            },
                            {
                                "example_id": "7dbc6602-fb2e-45bd-ba83-21ab59d69965",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "— Voui, jolie Madame, voui ! Et vous faites bougrement honneur, si j’ose ainsi m’exprimer, à votre professeur de leitmotiv."
                            },
                            {
                                "example_id": "e66151bc-72db-4d4a-bfda-03df7135f308",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "« Voui ! Voui ! Je souis une vieille tante, voui ! Et toi tu es un gentil gigolo, si tu veux venir chez moi nous ferons la chose… voui ! »"
                            },
                            {
                                "example_id": "c24e6872-c00f-49a6-8c57-02c7c07a7968",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "19 mars 42 – Il ne sait pas que je suis une dame en sa tour, un cœur pris, une sœur de tendresse et de charité et il m’invite à aller au théâtre. Prise de court, je dis voui."
                            },
                            {
                                "example_id": "16961e0e-7f03-40dd-9ea5-10750bce19a7",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "– Voulez-vous une tasse de thé ?\n– Ah…, dit-il avec un zeste de l’hésitation d’antan, mais voui, bien volontiers."
                            },
                            {
                                "example_id": "a87cab9a-d088-4699-bc5e-aa55de3b829c",
                                "sense_id": "bf28c799-0fca-36b7-8999-cc58653d2b37",
                                "text": "« J'y crois pas…, qu'elle a dit. Tu te maquilles, maintenant ?\n— Voui. »"
                            }
                        ]
                    }
                ],
