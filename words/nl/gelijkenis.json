{
    "word_family": [
        "gelijk",
        "gelijken",
        "gelijkaardig",
        "vergelijken",
        "vergelijking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f313a713-11f1-3094-8d3e-be805d8cee7a",
                    "sense_definition": "De mate waarin iets of iemand op een ander lijkt of aan een ander doet denken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gelijkenis</w> tussen de twee broers is inderdaad opvallend.",
                            "target_lang_translations": {
                                "en": "The <w>resemblance</w> between the two brothers is indeed striking."
                            }
                        },
                        {
                            "text": "Er is een sterke <w>gelijkenis</w> tussen deze twee schilderijen.",
                            "target_lang_translations": {
                                "en": "There is a strong <w>similarity</w> between these two paintings."
                            }
                        }
                    ],
                    "synonyms": [
                        "overeenkomst"
                    ],
                    "antonyms": [
                        "verschil"
                    ],
                    "common_phrases": [
                        "sterke gelijkenis",
                        "opvallende gelijkenis",
                        "uiterlijke gelijkenis"
                    ],
                    "target_lang_definitions": {
                        "en": "The degree to which something or someone resembles or reminds one of another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resemblance",
                                "target_lang_sense_clarification": "the quality of being similar in appearance or nature"
                            },
                            {
                                "target_lang_word": "similarity",
                                "target_lang_sense_clarification": "the state of sharing features or properties"
                            },
                            {
                                "target_lang_word": "likeness",
                                "target_lang_sense_clarification": "the fact of being similar in appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b718b658-74c6-3b41-85ce-820b61ae2d43",
                    "sense_definition": "Een symbolisch verhaal dat een religieuze of morele les overbrengt door middel van een vergelijking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verhaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gelijkenis</w> van de verloren zoon is een bekend verhaal uit de Bijbel.",
                            "target_lang_translations": {
                                "en": "The <w>parable</w> of the prodigal son is a well-known story from the Bible."
                            }
                        },
                        {
                            "text": "De priester vertelde een <w>gelijkenis</w> om de morele les te verduidelijken.",
                            "target_lang_translations": {
                                "en": "The priest told a <w>parable</w> to clarify the moral lesson."
                            }
                        }
                    ],
                    "synonyms": [
                        "parabel"
                    ],
                    "common_phrases": [
                        "bijbelse gelijkenis",
                        "een gelijkenis vertellen"
                    ],
                    "target_lang_definitions": {
                        "en": "A symbolic story that conveys a religious or moral lesson through a comparison."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parable",
                                "target_lang_sense_clarification": "a short story used to illustrate a moral or spiritual lesson"
                            },
                            {
                                "target_lang_word": "allegory",
                                "target_lang_sense_clarification": "a story that can be interpreted to reveal a hidden meaning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}