                "senses": [
                    {
                        "sense_id": "be28e70f-9244-341b-aed0-c343bfb384a0",
                        "entry_id": "22db078d-d3cc-370b-a25b-a19903ed67fe",
                        "glosses": [
                            "kleiner Wagen mit geschlossenen Seitenteilen, den eine Person hinter sich herziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca7d80a-381f-40e2-9b1e-d52c1248bcd4",
                                "sense_id": "be28e70f-9244-341b-aed0-c343bfb384a0",
                                "text": "„Zu mehr als dem notwendigsten Austausch kam es nicht, denn Grete, an der rechten Hand die Deichsel eines auf dem Hofe der Molkereibesitzerin ungefragt requirierten Blockwagens, an der linken die Tochter, schritt sogleich zur Tat.“"
                            },
                            {
                                "example_id": "5800b736-3a35-43ee-971b-eed1f8bab984",
                                "sense_id": "be28e70f-9244-341b-aed0-c343bfb384a0",
                                "text": "„Weil zu jeder Ferienwohnung ein Blockwagen gehört, können Familien mit Kindern den Strand problemlos \"mit Sack und Pack\" erobern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a305a101-8a8a-3d4e-80a9-57d905a12dda",
                        "entry_id": "22db078d-d3cc-370b-a25b-a19903ed67fe",
                        "glosses": [
                            "Sägetechnik: Wagen, mit dem der Gegenstand, der gesägt werden soll, der Säge zugeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca964f57-2d61-4ea4-8b6d-1d5bee00de6f",
                                "sense_id": "a305a101-8a8a-3d4e-80a9-57d905a12dda",
                                "text": "„Als die Reinigung im hinteren Bereich der Anlage abgeschlossen war, wurde der so genannte Blockwagen, auf dem die Stämme zur eigentlichen Säge herangefahren werden, von der Regiekanzel aus nach hinten gefahren, um so auch den vorderen Bereich der Anlage reinigen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
