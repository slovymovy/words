                ],
                "senses": [
                    {
                        "sense_id": "aa93f63a-a7ef-38d1-94c7-87f7ac3cc8b9",
                        "entry_id": "1457bea9-af58-38ea-8507-1cde8132ad84",
                        "glosses": [
                            "Écrivain qui a un besoin irrésistible d’écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f9ad6d-2b12-496e-bd16-9741c37ed503",
                                "sense_id": "aa93f63a-a7ef-38d1-94c7-87f7ac3cc8b9",
                                "text": "Un lecteur d’un esprit plus susceptible que le mien, et plus attaché au merveilleux risque en le lisant de devenir visionaire^([sic : visionnaire]), et graphomane comme cette vierge."
                            },
                            {
                                "example_id": "c8c85a2e-bde4-4449-ba27-6c8993901c8a",
                                "sense_id": "aa93f63a-a7ef-38d1-94c7-87f7ac3cc8b9",
                                "text": "A la fin du XIXᵉ siècle, de nombreux graphomanes socialisants faisaient en outre circuler dans la presse des poncifs qui essaimaient dans le discours social et contaminaient une partie de l’extrême gauche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0c6b116-af6a-41ec-b183-3e43f0c5379e",
                        "source_entry_id": "1457bea9-af58-38ea-8507-1cde8132ad84",
                        "source_sense_id": "aa93f63a-a7ef-38d1-94c7-87f7ac3cc8b9",
                        "target_lang_word": "graphomaniac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphomaniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3912402c-175d-3f9f-a88a-ab158b36054c",
                                        "entry_id": "a214f0b9-5bd2-37bc-936e-88486cc2b6e2",
                                        "glosses": [
                                            "A compulsive writer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24674300-7477-4276-ba57-4a12b067d2d6",
                                                "sense_id": "3912402c-175d-3f9f-a88a-ab158b36054c",
                                                "text": "Both delighted in eccentricities of costume and modes of life, and Barbey had the habit of graphomaniacs, which we know already, of writing his letters and his literary works with different coloured inks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98c8acbb-977a-4723-865e-86a5cf017979",
                        "source_entry_id": "1457bea9-af58-38ea-8507-1cde8132ad84",
                        "source_sense_id": "aa93f63a-a7ef-38d1-94c7-87f7ac3cc8b9",
                        "target_lang_word": "veelschrijver",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veelschrijver",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                        "entry_id": "a5709487-b575-371e-ad0c-337d7c51aff6",
                                        "glosses": [
                                            "iemand die heel veel teksten maakt, soms gebruikt als minachtende benaming voor een auteur die meer kwantiteit dan kwaliteit produceert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88cede2a-5e39-448b-82d1-13633a130aef",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "De Dordtse huisjesmelker en veelschrijver Mustafa Karasahin maakt misbruik van zijn recht door de gemeente Dordrecht honderden brieven per jaar te schrijven. Dat kostte de gemeente al enkele tonnen aan het afhandelen van de brieven."
                                            },
                                            {
                                                "example_id": "cd48d9a8-bfcd-41d3-9144-4e7cb4ce05ec",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "Hij was een veelschrijver. Tot zijn bekendste werken behoort de roman Gateway uit 1977, het verhaal van een ruimtestation dat verborgen is in een asteroïde. Het boek heeft later een computerspel geïnspireerd."
                                            },
                                            {
                                                "example_id": "d70cb4b1-c820-40c3-ab9c-0aa93ff64519",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "Sir Pratchett was een veelschrijver. Toen hij in 2015 op 66-jarige leeftijd overleed aan de gevolgen van de ziekte van Alzheimer, had hij zeventig boeken geschreven waarvan een slordige zeventig miljoen exemplaren waren verkocht. Vooral zijn licht humoristische fantasy over de Schijfwereld (Discworld) sloegen wereldwijd aan: zijn boeken zijn tot nog toe in 37 talen verschenen. Volgens curator Richard Henry wilde de auteur niet dat na zijn dood iemand anders zijn werk zou afmaken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a5fe63-f24c-3e52-886b-01125aa6481a",
                                        "entry_id": "a5709487-b575-371e-ad0c-337d7c51aff6",
                                        "glosses": [
                                            "instrument waarmee meerdere fysiologische reacties tegelijkertijd kunnen worden geregistreerd"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
