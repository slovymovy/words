                    {
                        "translation_id": "82fb2968-7d5a-425c-b380-1be41e6b6cc9",
                        "source_entry_id": "a89d6833-a01a-3b83-a21d-003221af352f",
                        "source_sense_id": "6a4cb69b-fade-36ce-b09f-f28edf88b327",
