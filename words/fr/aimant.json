                        "puissant aimant"
                    ]
                },
                {
                    "sense_id": "019c749e-f999-3d4b-8148-1b0e8be0b7c4",
                    "sense_definition": "Objet décoratif ou utilitaire aimanté que l'on fixe sur une surface métallique.",
