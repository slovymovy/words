{
    "word_family": [
        "condominium"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9406e2ee-7635-35fa-8d8d-d19438466046",
                    "sense_definition": "A private apartment or unit within a building or complex that is individually owned.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to buy a <w>condo</w> near the beach for their summer vacations.",
                            "target_lang_translations": {
                                "fr": "Ils ont décidé d'acheter un <w>appartement en copropriété</w> près de la plage pour leurs vacances d'été.",
                                "zh": "他们决定在海边买一套<w>公寓</w>，以便暑假度假时居住。"
                            }
                        },
                        {
                            "text": "The monthly maintenance fee for the <w>condo</w> covers security and pool cleaning.",
                            "target_lang_translations": {
                                "fr": "Les charges mensuelles de la <w>copropriété</w> couvrent la sécurité et l'entretien de la piscine.",
                                "zh": "这套<w>公寓</w>的每月物业费包含了安保和泳池清洁费用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apartment",
                        "flat"
                    ],
                    "common_phrases": [
                        "luxury condo",
                        "condo building"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un appartement ou une unité privée au sein d'un immeuble ou d'un complexe, détenu individuellement en copropriété.",
                        "zh": "一种私人拥有的公寓单元，通常位于大型住宅楼或社区内。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "copropriété",
                                "target_lang_sense_clarification": "Désigne le statut juridique et le bien immobilier lui-même."
                            },
                            {
                                "target_lang_word": "appartement en copropriété",
                                "target_lang_sense_clarification": "Désigne spécifiquement l'unité d'habitation."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公寓",
                                "target_lang_sense_clarification": "指个人拥有的公寓单元，强调产权归属。"
                            },
                            {
                                "target_lang_word": "私有公寓",
                                "target_lang_sense_clarification": "明确区分于租赁公寓的私有房产。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "19ed056a-6b4a-3fc3-b70d-c27df0cfb36f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by Dr. <w>Condo</w> and his colleagues.",
                            "target_lang_translations": {
                                "fr": "Le document de recherche a été rédigé par le Dr <w>Condo</w> et ses collègues.",
                                "zh": "这份研究报告是由<w>孔多</w>博士和他的同事们撰写的。"
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Condo</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "fr": "J'ai rencontré un homme nommé M. <w>Condo</w> à la conférence hier.",
                                "zh": "我昨天在会议上遇到了一位名叫<w>孔多</w>先生的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un nom de famille.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "Condo",
                                "target_lang_sense_clarification": "Nom de famille propre, invariable."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孔多",
                                "target_lang_sense_clarification": "用于音译该姓氏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}