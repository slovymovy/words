                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9a646b-cd33-4cdb-b28a-d92e042ce1e4",
                                "sense_id": "e13589f6-3c2f-30b8-9bbb-a863d7875d40",
                                "text": "Да двенадцать человек хворые, простыли, все в воде да в воде, а Громов обутки не дает. Жадина!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
