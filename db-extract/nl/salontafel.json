                "senses": [
                    {
                        "sense_id": "d74cbe7e-ac93-3f9d-9042-da823cac5329",
                        "entry_id": "45a92fe2-5dc7-3a98-a1f9-fc5e7bd72a22",
                        "glosses": [
                            "een lage tafel die in een woonkamer staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9621ec7c-c14c-40dd-9bc7-c87e7335bead",
                                "sense_id": "d74cbe7e-ac93-3f9d-9042-da823cac5329",
                                "text": "Midden tussen de banken van de zithoek staat de salontafel waarop koffie en taart geserveerd kan worden."
                            },
                            {
                                "example_id": "526870ed-bba7-482f-9971-6e154040cb59",
                                "sense_id": "d74cbe7e-ac93-3f9d-9042-da823cac5329",
                                "text": "In de voorkamer stond een antiekrode leren chesterfieldfauteuil zij aan zij met een Louis xv -zetel die was voorzien van een oudroze fluwelen bekleding met een rozenmotief, en een voetbankje in ongeveer dezelfde kleur naast een prachtige achttiende-eeuwse salontafel met elegant houtsnijwerk."
                            },
                            {
                                "example_id": "ab20bcde-a9c9-44f8-ae5d-a55043ffef05",
                                "sense_id": "d74cbe7e-ac93-3f9d-9042-da823cac5329",
                                "text": "Daar op de salontafel lagen vier foto's van mijn vader Antoine Henri Letang, ik probeerde de uitspraak precies zo te denken als mama me had geleerd."
                            }
                        ]
                    }
                ],
