                                "target_senses": [
                                    {
                                        "sense_id": "6edaca34-2e4c-3ae6-a7a3-18e687435e49",
                                        "entry_id": "8bf683e1-4178-359a-80d2-7d43c261987f",
                                        "glosses": [
                                            "Briefly; concisely; using a few words to summarize."
                                        ],
