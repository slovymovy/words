                "senses": [
                    {
                        "sense_id": "9e9498a5-d4cf-3998-aa63-45e3dbc5ab6a",
                        "entry_id": "3f36d4fc-d0e7-3734-b210-9e20e21e3995",
                        "glosses": [
                            "eine Abfolge von physikalischen Größen, die zum Teil in sich geschlossen ist"
                        ],
                        "tags": [
                            "Regelungstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "d02a069b-a901-4a5f-86fc-e11f70a29a22",
                                "sense_id": "9e9498a5-d4cf-3998-aa63-45e3dbc5ab6a",
                                "text": "„Auch interne und externe Faktoren beeinflussen die Nahrungsaufnahme, ohne direkt zum Regelkreis von Hunger und Sättigung in unserem Körper zu gehören.“"
                            },
                            {
                                "example_id": "0553e89c-d4bf-43b6-9705-24e476f25b14",
                                "sense_id": "9e9498a5-d4cf-3998-aa63-45e3dbc5ab6a",
                                "text": "„Eine Kaskadenregelung besteht aus zwei oder mehr verschachtelten Regelkreisen.“"
                            },
                            {
                                "example_id": "cb0b890c-e150-4dba-8a55-76f7f11f6f9d",
                                "sense_id": "9e9498a5-d4cf-3998-aa63-45e3dbc5ab6a",
                                "text": "„Ein Regelkreis besteht […] aus folgenden 4 Hauptbestandteilen: Regelstrecke, Messglied, Regler und Stellglied.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
