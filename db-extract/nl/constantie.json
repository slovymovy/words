                "translations": [
                    {
                        "translation_id": "cc53a88e-e443-42d1-8fff-56b0e7c90477",
                        "source_entry_id": "d21c2294-5ae2-3eed-8bf0-ac66646c2184",
                        "source_sense_id": "150fb43f-edbb-3dd8-8a8f-74a083d1155d",
                        "target_lang_word": "constance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60a5ca5a-a953-32e6-af23-d615c8a64fd0",
                                        "entry_id": "7c424964-ee90-3b62-bb04-c3a2d71e5719",
                                        "glosses": [
                                            "Fermeté de l’âme qui lui permet de résister aux choses capables de l’ébranler, telles que la douleur, l’adversité, les tourments, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae43cdec-221a-4215-a776-5ff280c991d8",
                                                "sense_id": "60a5ca5a-a953-32e6-af23-d615c8a64fd0",
                                                "text": "Et la brigade demeura en Belgique. […]. Les plus frénétiques arrosages de shrapnells et de marmites n’ébranlaient pas sa constance."
                                            },
                                            {
                                                "example_id": "f1d3bc6c-cc31-4694-be30-f384838b823b",
                                                "sense_id": "60a5ca5a-a953-32e6-af23-d615c8a64fd0",
                                                "text": "Non, non, la constance n’est bonne que pour des ridicules ; toutes les belles ont droit de nous charmer, et l’avantage d'être rencontrée la première ne doit pas dérober aux autres les justes prétentions qu’elles ont toutes sur nos cœurs."
                                            },
                                            {
                                                "example_id": "d1876884-3ebf-4996-bb87-15890678e9d5",
                                                "sense_id": "60a5ca5a-a953-32e6-af23-d615c8a64fd0",
                                                "text": "Montrer, témoigner de la constance contre la douleur."
                                            },
                                            {
                                                "example_id": "c3b7552c-e9c2-4ee2-8da1-722fd561a9dd",
                                                "sense_id": "60a5ca5a-a953-32e6-af23-d615c8a64fd0",
                                                "text": "La fortune a exercé, a éprouvé la constance de ce philosophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                        "entry_id": "7c424964-ee90-3b62-bb04-c3a2d71e5719",
                                        "glosses": [
                                            "Persévérance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a33015-2dab-4dce-8a66-03a4de6a2489",
                                                "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                                "text": "Cerise sur le gâteau, les soldes venaient de lui être confiées. Les budgets étaient colossaux et il y puisait avec constance et rapacité pour redistribuer une grande partie aux gradés qui vivaient sur la bête."
                                            },
                                            {
                                                "example_id": "da650062-ed4c-475b-86ef-55f40812acdd",
                                                "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                                "text": "Il a poursuivi ce dessein avec beaucoup de constance."
                                            },
                                            {
                                                "example_id": "3fa6273a-7ff4-45ed-8c09-a59bab6346f1",
                                                "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                                "text": "Il faut qu’il ait eu bien de la constance pour ne point se lasser pendant un si long temps."
                                            },
                                            {
                                                "example_id": "7485c3e9-7ba9-4ade-a498-3ec339fae832",
                                                "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                                "text": "— Il faut que vous ayez bien de la constance pour supporter tant de caprices."
                                            },
                                            {
                                                "example_id": "0288993e-af39-4a98-9230-eb9821ca15f7",
                                                "sense_id": "4c3a17c2-2d9f-387c-8271-4ba2b2f0dd36",
                                                "text": "Depuis une heure que vous attendez, vous avez de la constance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                        "entry_id": "0c7add9d-11e0-3930-b109-c181603d4e4b",
                                        "glosses": [
                                            "Vin muscat anciennement produit en Afrique du Sud."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cce36892-2fa8-4ea3-9191-4d55f74ae97d",
                                                "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                                "text": "Tout l'espace compris entre la baie Falso & celle de la Table est orné de maisons de plaisance & de belles habitations où l'on se borne à la culture des légumes, des fruits, & sur-tout du vin. Les plus estimés , & qui approchent le plus du Constance , sont ceux de Becker & de Hendrick. Les Marchands de vin du Cap savent les apprêter & les vendre pour du vrai Constance."
                                            },
                                            {
                                                "example_id": "9afd8da7-0c2f-47ee-a149-5df9cfc21936",
                                                "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                                "text": "On croit généralement que ce dernier se recueille seulement dans deux fermes de ce nom ; on se trompe : le raisin qui le donne, la muscadelle, est dans toutes les vignes; dans plusieurs de celles du Drakenstein il produit même un vin égal , sinon supérieur, au Constance, dont le seul avantage est de se vendre six fois plus cher : tant le nom a de pouvoir en toutes choses !"
                                            },
                                            {
                                                "example_id": "0b19b7ae-608a-4df3-abcf-24365a063fad",
                                                "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                                "text": "Quant au constance rouge et blanc, il a tant de rapport avec les vins de Malvoisie et même avec ceux de la bonne ville de Cette, que je ne sais, en vérité, si on pourrait toujours le distinguer de ces derniers."
                                            },
                                            {
                                                "example_id": "4edcb928-1c0f-4fda-9b3e-25c71e86ecde",
                                                "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                                "text": "Il m'a indiqué souvent que sa promotion fut la dernière à « importer » du constance, les vignes ayant été détruites par le phylloxéra l'année suivante, soit vers 1874-75. C'était un vin de goût très muscat, sirupeux, très sucré, de couleur ambrée foncée, se présentant en bouteilles de forme et de contenance tout à fait comparables à nos petites bordelaises actuelles."
                                            },
                                            {
                                                "example_id": "a9ee28be-fb90-463b-bdae-20319579fbaa",
                                                "sense_id": "6a18c4c6-2446-3fb5-b11d-518ddb7c83b0",
                                                "text": "Mais, on le sait, Jules Mouquet est d'avis qu'il s'agit du Constance, sorte de muscat réputé et provenant de la colonie du Cap, où Baudelaire s'arrêta à son retour d'Orient. Il se peut..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
