                "senses": [
                    {
                        "sense_id": "e66e2228-43e0-3980-8880-6d7284a38dc4",
                        "entry_id": "3cc7d72a-6038-3afa-9159-0e0b4bec86aa",
                        "glosses": [
                            "Bestandteil von Comics, der einem gezeichneten Kreis ähnelt und der gesprochenen Text enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef92cbc-6dcd-4aba-b25f-3d7d570a2620",
                                "sense_id": "e66e2228-43e0-3980-8880-6d7284a38dc4",
                                "text": "Während Paul für die künstlerische Gestaltung des Comics zuständig war, kümmerte sich Peter um die Inhalte der Sprechblasen."
                            },
                            {
                                "example_id": "53ca9b98-aa6f-45cb-95bd-0d57e66a51b0",
                                "sense_id": "e66e2228-43e0-3980-8880-6d7284a38dc4",
                                "text": "„Die bunten Bildergeschichten mit den Sprechblasen wurden als »anspruchslose Hefte für Analphabeten« geschmäht, die zur »Verblödung« und »Gefühlsverrohung« führen würden.“"
                            },
                            {
                                "example_id": "a9c65daa-ca6d-485c-b07d-a9a9750dfd78",
                                "sense_id": "e66e2228-43e0-3980-8880-6d7284a38dc4",
                                "text": "Manche Rede besteht nur aus Sprechblasen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a55c1d8-ac94-3b9a-ba92-2729955f3faf",
                        "entry_id": "3cc7d72a-6038-3afa-9159-0e0b4bec86aa",
                        "glosses": [
                            "inhaltsleeres Gerede"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "f49372fa-033b-454d-b66c-58844675b179",
                                "sense_id": "4a55c1d8-ac94-3b9a-ba92-2729955f3faf",
                                "text": "„Allen dreien gehen dieselben Fragen durch den Kopf, dieselben Sprechblasen schweben über den drei Köpfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
