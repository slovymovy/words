                    "frequency": "Middle",
                    "semantic_group_id": "anciennete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>antique</w> muraille de pierre entoure encore le cœur historique du village."
                        },
                        {
                            "text": "Le vieil homme conservait ses souvenirs dans une <w>antique</w> armoire en chêne."
