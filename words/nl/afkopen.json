                            {
                                "target_lang_word": "ablösen",
                                "target_lang_sense_clarification": "Schulden oder Verpflichtungen tilgen"
                            },
                            {
                                "target_lang_word": "abgelten",
                                "target_lang_sense_clarification": "Ansprüche finanzielle regeln"
                            },
                            {
                                "target_lang_word": "abkaufen",
                                "target_lang_sense_clarification": "sich von einer Verpflichtung freikaufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee3e62cb-aacb-3997-ba0b-71e4420188f1",
                    "sense_definition": "een verzekering, pensioen of contract voortijdig beëindigen tegen een eenmalige uitkering",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financiele_verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij overweegt haar kleine pensioen vervroegd <w>af</w> te <w>kopen</w>.",
                            "target_lang_translations": {
                                "de": "Sie erwägt, sich ihre kleine Rente vorzeitig <w>abfinden zu lassen</w>."
                            }
                        },
                        {
                            "text": "Als je een levensverzekering <w>afkoopt</w>, moet je vaak extra belasting betalen.",
                            "target_lang_translations": {
                                "de": "Wenn man eine Lebensversicherung <w>rückkauft</w>, muss man oft zusätzliche Steuern zahlen."
                            }
