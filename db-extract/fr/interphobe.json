                                        "glosses": [
                                            "Relating to, characteristic of, or exhibiting interphobia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45de6dda-59ed-40a6-8b9a-d4aea55cf49f",
                                                "sense_id": "d462ea9e-ba5c-3755-88b5-7fbda265269e",
                                                "text": "[…] or the use of preimplantation genetic diagnosis (PGD) to prevent the development of intersex foetuses, considered by some to be an example of interphobic eugenics (Orr, 2016)."
                                            },
                                            {
                                                "example_id": "8b59cb91-f2dc-4630-a67f-36ffdc161ba9",
                                                "sense_id": "d462ea9e-ba5c-3755-88b5-7fbda265269e",
                                                "text": "As recent attacks on the transgender community have demonstrated, excluding the natural existence of sex and gender diversity supports interphobic and transphobic beliefs and policies."
                                            },
                                            {
                                                "example_id": "0c61b2c8-8659-46b5-8660-8e1439026ca2",
                                                "sense_id": "d462ea9e-ba5c-3755-88b5-7fbda265269e",
                                                "text": "Conversely, homophobic, transphobic, and interphobic environments lead to violence against students and educational staff."
                                            }
                                        ]
                                    }
                                ]
