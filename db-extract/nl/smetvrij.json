                                "target_senses": [
                                    {
                                        "sense_id": "8aa28ba6-8266-3268-8d6a-e7c72f06ee48",
                                        "entry_id": "9bdf4cd5-8f75-3e32-92c4-a61cd3c786b7",
                                        "glosses": [
                                            "One who is innocent, especially a young child."
