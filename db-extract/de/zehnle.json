                ],
                "senses": [
                    {
                        "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                        "entry_id": "3fe8d73f-6843-366a-ad27-9430318db90c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c78e868-526b-42ac-ac17-23227581b0d0",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Frau Zehnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "643b3210-7264-4431-9924-0cf00b8ca3de",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Herr Zehnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8866937a-4c95-437f-a8ae-8d632a5a687d",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Die Zehnles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3192bd8e-81b3-4c22-86b2-4cc1ff0bf692",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Der Zehnle trägt nie die Schals, die die Zehnle ihm strickt."
                            },
                            {
                                "example_id": "e81732d0-9e9c-4e8a-a9e2-ee032bd1ad5c",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zehnle kommt, geht der Herr Zehnle.“"
                            },
                            {
                                "example_id": "63fb6762-bf6b-472f-8a57-ee79214925ce",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Zehnle kommt und geht."
                            },
                            {
                                "example_id": "196c3904-c3f5-4629-8c1f-6b549d5a9a29",
                                "sense_id": "0fc7c8dc-df7b-3b29-b06b-96e48238659b",
                                "text": "Zehnles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
