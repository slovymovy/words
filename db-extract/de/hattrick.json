                                "example_id": "fe954ff7-745b-4cf4-8198-fce308b343b7",
                                "sense_id": "25daae0a-2a86-3799-bbbb-38ac6a127213",
                                "text": "„Schafft Tres Rock Danon den Hattrick bei der Hoppegartener Premiere des Oleander-Rennens?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07e40ad9-7f70-33f2-99ac-631b5503d94c",
                        "entry_id": "decf108d-15cc-3f92-9bbc-11c30932f824",
                        "glosses": [
                            "das Erzielen von drei aufeinanderfolgenden Toren durch denselben Spieler in einer Halbzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a40e6c-650e-4c2d-a27d-0b1d5229bb4e",
                                "sense_id": "07e40ad9-7f70-33f2-99ac-631b5503d94c",
                                "text": "Bianca schoss am Sonntag gegen ihren ehemaligen Verein einen Hattrick."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "687a1dc7-9039-4740-a6a5-1ef29df6c835",
                        "source_entry_id": "decf108d-15cc-3f92-9bbc-11c30932f824",
                        "source_sense_id": "25daae0a-2a86-3799-bbbb-38ac6a127213",
                        "source_sense_description": "Sport: drei aufeinanderfolgende Siege durch denselben Sportler",
                        "target_lang_word": "hat trick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hat trick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "851762c7-2ecb-39ea-8963-ff9acf048be0",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "Any magic trick performed with a hat, especially one involving pulling an object (traditionally a rabbit) out of an apparently empty hat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58f6f97f-d4c4-322c-a384-2972b97beb7d",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "An achievement of a bowler taking three wickets in three consecutive balls.",
                                            "Three achievements in a single game, competition, season, etc., such as three consecutive wins."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403b052f-e54c-4773-858a-46239493edd6",
                                                "sense_id": "58f6f97f-d4c4-322c-a384-2972b97beb7d",
                                                "text": "Ever heard of a Gordie Howe hat trick? It comprises a goal, an assist, and a fighting major penalty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "791abc23-327a-3bc7-87e5-687b07449429",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "An achievement of a bowler taking three wickets in three consecutive balls.",
                                            "Three achievements in a single game, competition, season, etc., such as three consecutive wins.",
                                            "The act of striking out three times in a game."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "ironic",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e92247e-bd2f-4993-870e-b6fa8fa169f4",
                                                "sense_id": "791abc23-327a-3bc7-87e5-687b07449429",
                                                "text": "Jones got a hat trick yesterday. Let’s see if he can do better today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4072196e-d997-3f04-b971-be23e78c9bf5",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "An achievement of a bowler taking three wickets in three consecutive balls.",
                                            "Three achievements in a single game, competition, season, etc., such as three consecutive wins.",
                                            "Three goals scored by one player in a game."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa0e8ae2-efb8-4c56-84dc-c2bd3b401353",
                                                "sense_id": "4072196e-d997-3f04-b971-be23e78c9bf5",
                                                "text": "In ice hockey, it’s customary for fans to throw their hats on to the rink after a player scores a hat trick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a90e39-0468-327d-aced-09ca9b923f0b",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "An achievement of a bowler taking three wickets in three consecutive balls.",
                                            "Three achievements in a single game, competition, season, etc., such as three consecutive wins.",
                                            "Three tries scored by one player in a game."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "An achievement of a bowler taking three wickets in three consecutive balls.",
                                            "Three achievements or incidents that occur together, usually within a certain period of time."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c914144-1048-49d4-9427-a77f5b800b97",
                                                "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                                "text": "The car salesman came home with front-row seats to the weekend game after achieving a hat trick by selling three cars that day."
                                            },
                                            {
                                                "example_id": "ffa505bc-be8d-4ba9-88a0-d79c708f2149",
                                                "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                                "text": "And with the debut of his new series Hyperion Bay in 1998, [Joseph] Dougherty accomplished the rare \"hat trick\" in television: the pilot was written, executive-produced, and codirected by Dougherty."
                                            },
                                            {
                                                "example_id": "4d7528d5-1c7c-4615-baca-cf115730a722",
                                                "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                                "text": "Three murders in less than two weeks. That's a hat trick."
                                            },
                                            {
                                                "example_id": "fdba994f-c7cd-4c59-9d72-e7720a571242",
                                                "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                                "text": "In these modern cities, anti-infection measures had to be imposed from the top down, by a central authority. To pull this off, the authority required three things: the ability to identify cases in a timely fashion, and so determine the infection's direction of travel; an understanding of how the disease spread (by water? air? insect vector?), and hence the measures that were likely to block it; and some means of ensuring compliance with those measures. When all three of these ingredients – which we'll describe in more detail in the following sections – were in place, containment could be extremely effective, but a hat-trick was rare."
                                            },
                                            {
                                                "example_id": "4592ed83-b3cf-4cb8-ab49-01fb93c90d0c",
                                                "sense_id": "42d46e21-5158-388f-a0b2-4fa34b3c5a91",
                                                "text": "Keir Starmer has heralded a “hat-trick of deals” with India, the US and the EU, telling MPs they will protect thousands of jobs and save businesses hundreds of millions of pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4be5f96-d465-3e51-9e8e-ca5b0664948f",
                                        "entry_id": "4f1ab723-5322-3d90-b658-2e4eb029ffe8",
                                        "glosses": [
                                            "A means of securing a seat in the House of Commons by a Member of Parliament placing their hat upon it during an absence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
