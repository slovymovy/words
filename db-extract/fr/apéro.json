        "fr-extract.jsonl": [
            {
                "entry_id": "2902ebe2-55db-32eb-b972-fb4b6f7c490e",
                "word": "apéro",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4a4813f9-5236-4211-804a-592b28736c49",
                        "entry_id": "2902ebe2-55db-32eb-b972-fb4b6f7c490e",
                        "tags": [
                            "plural"
                        ],
                        "form": "apéros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
                        "entry_id": "2902ebe2-55db-32eb-b972-fb4b6f7c490e",
                        "glosses": [
                            "Apéritif."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "aecc1b8b-c6ba-41a5-88e4-f7bd7957f23b",
                                "sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
                                "text": "Elles se craquelaient dangereusement, et tout le temps que je restai là je craignis qu’un morceau de fesse de la divinité aussi callipyge que mythologique qui planait sur nos têtes ne tombât dans mon apéro en guise de zeste supplémentaire."
                            },
                            {
                                "example_id": "126a44b9-a084-48f1-a658-b76fab9d2c55",
                                "sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
                                "text": "Il avait repéré une guinguette le long du canal Saint-Martin et nous invitait à boire l’apéro."
                            },
                            {
                                "example_id": "cb701e62-aba7-484f-99e4-14f2ab6eb319",
                                "sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
                                "text": "Parce que partout sur les réseaux, on stigmatise les gens qui postent des photos de leur jardin en fleurs, les chanteuses qui récitent de la poésie en français et en anglais dans leur sublime appartement ou les écrivaines qui poètisent leur confinement, les collectionneur.ses de pâtes et de PQ, les gens qui blaguent, ceux qui promènent leur chien deux fois par jour, ceux qui ont une grande maison, ceux qui commandent encore des trucs sur internet, ceux qui portent des masques pour aller au Super U, ceux qui saturent le réseau avec leurs apéros FaceTime… ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1591d6f0-2838-4686-9331-6d9105ec5819",
                        "source_entry_id": "2902ebe2-55db-32eb-b972-fb4b6f7c490e",
                        "source_sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
                        "target_lang_word": "Apéro",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apéro",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17bd7d37-c5f9-32ab-8854-61e6906a65c9",
                                        "entry_id": "d521b901-724d-3a22-a61e-690f625c3168",
                                        "glosses": [
                                            "Aperitif"
                                        ],
                                        "tags": [
                                            "besonders schweizerisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ba8e06-d212-4b2d-99af-ed93703d7788",
                                                "sense_id": "17bd7d37-c5f9-32ab-8854-61e6906a65c9",
                                                "text": "Wir schenken Ihnen gerne noch einen weiteren Apéro ein."
                                            },
                                            {
                                                "example_id": "bea8b6eb-9004-4e7f-b65d-1dc421d07580",
                                                "sense_id": "17bd7d37-c5f9-32ab-8854-61e6906a65c9",
                                                "text": "Unsere Generalversammlung beginnen wir jeweils mit einem Apéro."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cdddc8a1-07cd-379f-9943-3eeb9467c0f2",
                                        "entry_id": "d521b901-724d-3a22-a61e-690f625c3168",
                                        "glosses": [
                                            "schweizerisch, ein gesellschaftlicher Brauch in Frankreich und der Schweiz, der Genuss und Geselligkeit verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e17e618a-11d9-4758-9221-bfaedc4f484e",
                                                "sense_id": "cdddc8a1-07cd-379f-9943-3eeb9467c0f2",
                                                "text": "Die Apérokultur lebt vom Spannungsverhältnis zwischen professioneller und persönlicher Interaktion. Der Apéro dient meist als geselliger Abschluss professioneller Zusammenkünfte wie Fachtagungen, Verbandstreffen oder Geschäftsanlässen. Visitenkarten werden ausgetauscht, das Duzis wird angeboten, gutes Essen und Alkohol lösen die Zunge. Die gemeinsame Entspannung nach verrichteter Arbeit schafft persönliche Verbundenheit.)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "808b40d9-17dc-47ca-bafe-a557cbe525d6",
                        "source_entry_id": "2902ebe2-55db-32eb-b972-fb4b6f7c490e",
                        "source_sense_id": "9343be6b-92d9-3879-9408-22291bcdf490",
