                    "sense_definition": "A person's family background or descent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is proud of her Irish <w>origin</w> and visits often.",
