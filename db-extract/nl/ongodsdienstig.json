                        "sense_id": "ed11a933-52e4-327b-afc8-0b5c6bc70620",
                        "entry_id": "37af871a-8d80-3b37-87f3-df039ac6e38b",
                        "glosses": [
                            "irreligious"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2274464-5180-4f2e-ad5d-92902c7d02b6",
                                "sense_id": "ed11a933-52e4-327b-afc8-0b5c6bc70620",
                                "text": "Ze groeide op in een ongodsdienstig huishouden.",
                                "translation": "She grew up in an irreligious household.",
                                "english": "She grew up in an irreligious household."
                            },
                            {
                                "example_id": "3f065c55-0782-4aa5-8984-86673ee891f9",
                                "sense_id": "ed11a933-52e4-327b-afc8-0b5c6bc70620",
                                "text": "De samenleving wordt steeds ongodsdienstiger.",
                                "translation": "Society is becoming increasingly irreligious.",
                                "english": "Society is becoming increasingly irreligious."
                            },
                            {
                                "example_id": "dc03ba10-64b7-4dd0-89b1-cb052782c559",
                                "sense_id": "ed11a933-52e4-327b-afc8-0b5c6bc70620",
                                "text": "Van alle steden in het land is deze het ongodsdienstigst.",
                                "translation": "Of all the cities in the country, this is the most irreligious.",
                                "english": "Of all the cities in the country, this is the most irreligious."
                            }
                        ]
                    }
