                                    {
                                        "sense_id": "b8f8c69f-b002-3a19-86fa-3bd0257244b1",
                                        "entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
                                        "glosses": [
                                            "A coin used since ancient times in Greece, serving in modern times as one hundredth of a phoenix, a drachma, and a euro (as the Greek form of the Eurocent)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b10355ee-6ef1-37b8-ab1d-f79b6761c8c8",
                                        "entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
                                        "glosses": [
                                            "A small, bronze Judean coin from the 1st century BCE, considered by some to be the widow's mite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lepton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2601eee-62a2-3066-b9aa-5ba97b8b6ea8",
                                        "entry_id": "97602145-1337-316c-81e0-2a26bd816398",
                                        "glosses": [
                                            "An elementary particle that has a spin of 1/2 (i.e., is a fermion) and does not interact via the strong nuclear force; examples include the electron, the muon, the neutrino and the tauon."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd9b2ff9-24a6-4ef5-977c-f0ad5e327327",
                                                "sense_id": "f2601eee-62a2-3066-b9aa-5ba97b8b6ea8",
                                                "text": "In the present paper we deal with the second order radiative correction to the beta disintegration of nucleon, assuming the Fermi's interaction between necleon and lepton fields, and show that there appears such an ultraviolet divergence as can not be removed by the procedure of renormalization of mass and coupling constant, so far as a single type of coupling is assumed for the decay Hamiltonian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
