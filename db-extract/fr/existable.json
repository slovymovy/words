                        "examples": [
                            {
                                "example_id": "56cd1fbb-4398-4eca-a2d2-204df5e4e77b",
                                "sense_id": "49f52447-8d98-3847-8819-7bcc913fbe1e",
                                "text": "C’est quand il est séparé que l’enfant se sent potentiellement « existable ». Trop de maternage est néfaste. L’enfant doit être incité à l’exploration de l’espace environnant."
                            },
                            {
                                "example_id": "9b881e30-9d8c-4626-b0c5-26271d17292e",
                                "sense_id": "49f52447-8d98-3847-8819-7bcc913fbe1e",
                                "text": "Inspirées par l’histoire ou le mythe, ses conceptions sont toujours peuplées par des personnages géométriquement établis et d’une indéniable vérité ; pour être marqués au sceau de sa vision, ils n’en sont pas moins existables et n’en portent pas moins, accusé par une indication de contour ou quelque mouvement, leur caractère de race voire même de modernité !"
                            }
                        ]
                    }
