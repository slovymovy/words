                                        "examples": [
                                            {
                                                "example_id": "db77bac5-67c8-4062-be10-4ca3a2f5a81c",
                                                "sense_id": "7f010c85-609c-32ce-856d-6f1c8381e136",
                                                "text": "Hij stond nog niet overeind of hij hoorde het fluitsignaal al."
                                            },
                                            {
                                                "example_id": "3c074b36-5ff4-4096-92ef-448e4a69a0d8",
                                                "sense_id": "7f010c85-609c-32ce-856d-6f1c8381e136",
                                                "text": "Hij stapt over het lijk heen, nog steeds gebukt, je weet eigenlijk niet waarom je dat doet, want kogels vang je overeind net zo goed op als gebogen, maar het is een reflex om ze zo min mogelijk houvast te bieden, alsof je de hele tijd bang bent voor de hemel als je oorlog voert."
                                            },
                                            {
                                                "example_id": "e4224c87-e324-4f23-ad0f-cbdb303d9e74",
                                                "sense_id": "7f010c85-609c-32ce-856d-6f1c8381e136",
                                                "text": "Roerloos lag ik in mijn slaapzak en schrok bij elk geluid overeind."
                                            },
                                            {
                                                "example_id": "6614e1da-d43b-4881-839d-727de162d410",
                                                "sense_id": "7f010c85-609c-32ce-856d-6f1c8381e136",
                                                "text": "En zoals hij had verwacht, kwam ze direct overeind, kuste hem op zijn voorhoofd, bedankte voor de onderhoudende avond en trok zich terug naar de slaapkamerverdieping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
