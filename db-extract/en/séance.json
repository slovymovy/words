                ],
                "senses": [
                    {
                        "sense_id": "3f3de347-ebd7-3702-b4c7-a517f2f69ea6",
                        "entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "glosses": [
                            "A ceremony where people try to communicate with the spirits of dead people, usually led by a medium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438faa76-9589-4bd7-a407-6de9d6b4f6c9",
                                "sense_id": "3f3de347-ebd7-3702-b4c7-a517f2f69ea6",
                                "text": "[B]ut only too often séances degenerate into pure sorcery or necromancy, attracting all kinds of undeveloped and earth-bound entities."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aa6db3d-b6f3-38dc-919a-3fb4620d1f42",
                        "entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "glosses": [
                            "The sitting of an assembly to discuss a matter."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9314567-0b88-42e1-b647-5932c163557a",
                        "source_entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "source_sense_description": "a ceremony where people try to communicate with the spirits",
                        "target_lang_word": "降神会",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a9bdf12-9030-4e3c-aae8-c67af243182b",
                        "source_entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "source_sense_description": "a ceremony where people try to communicate with the spirits",
                        "target_lang_word": "seance",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seance",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9bf2b0-35cc-3654-aab2-9d255c9d3ea2",
                                        "entry_id": "6c024fc0-7492-378b-add6-e6aee7d05d31",
                                        "glosses": [
                                            "een bijeenkomst met publiek waarop geprobeerd wordt om te communiceren met geesten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8492bde-068a-41cd-b4e7-71b33c6e5ca9",
                                                "sense_id": "ec9bf2b0-35cc-3654-aab2-9d255c9d3ea2",
                                                "text": "Assayas neemt het spiritisme serieus, getuige het filmfragment over de esoterische Zweedse schilderes Hilma af Klint dat hij incorporeert en de overtuigende enscenering van een seance onder leiding van schrijver Victor Hugo. Maureen gelooft echt in het bestaan van parallelle werelden. Tegelijkertijd suggereert Assayas dat het verlangen om contact te leggen met haar gestorven broer een projectie is van een rouwende, labiele geest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a55c3871-284d-4626-889b-11151103e28d",
                        "source_entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "source_sense_description": "a ceremony where people try to communicate with the spirits",
                        "target_lang_word": "séance de spiritisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "442bdaf8-a588-4df9-8be5-ea048dd8bc46",
                        "source_entry_id": "4f48868b-3d8e-3862-a709-0dfb560c8c32",
                        "source_sense_description": "a ceremony where people try to communicate with the spirits",
                        "target_lang_word": "Séance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Séance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                        "entry_id": "38bcbbd7-c6b4-3704-a1d5-afe39552af69",
                                        "glosses": [
                                            "spiritistische Sitzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13fb0524-cbaa-48cd-a5d9-bac0e3112843",
                                                "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                                "text": "„Sie war auch Oberhaupt einer Vereinigung in Berlin, die sich »Verband weiser Frauen« nannte, und hielt heimliche Séancen mit anderen, vor allem lesbischen Frauen.“"
                                            },
                                            {
                                                "example_id": "f7962e6b-0681-4fed-bb88-bd4b8d618c54",
                                                "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                                "text": "„Als Max sich von Zirele verabschiedet hatte, kämpfte er mit sich, ob er zu der Séance gehen sollte oder nicht.“"
                                            },
                                            {
                                                "example_id": "27cf94b8-217f-44e0-9ce1-e2bf49ea5f13",
                                                "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                                "text": "„Zu den interessantesten Houdini-Anekdoten zählt eine 1914 auf einer Ozeanüberquerung abgehaltene Séance, bei der Houdini Ex-Präsident Teddy Roosevelt davon überzeugte, ein Geist berichte ihm in Trance Einzelheiten über Roosevelts gerade absolvierte Weltreise.“"
                                            },
                                            {
                                                "example_id": "f716e749-2f38-4885-ad83-2509d69239b2",
                                                "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                                "text": "„Eine Möglichkeit, mit »Der Macht« zu kommunizieren, bot sich ihm mit Séancen und all dem Drum und Dran wie Tischrücken, Tarotkarten, unerklärliche Laute und Befehle aus dem Nirgendwo.“"
                                            },
                                            {
                                                "example_id": "69911329-baf4-4084-960e-347b669e8804",
                                                "sense_id": "784e3d88-76bc-30bd-ab01-09f8db8cf559",
                                                "text": "„Die Séance findet statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
