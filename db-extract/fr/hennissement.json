                                        "entry_id": "29ce779b-8c02-31e2-a540-184343ad40ee",
                                        "glosses": [
                                            "aanhoudend tijdens het lachen een hinnikend geluid voortbrengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
