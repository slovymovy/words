                "senses": [
                    {
                        "sense_id": "17d5b791-2c4a-3425-94de-78fcb1c370b8",
                        "entry_id": "68e4da5b-ede6-3b71-9646-81b5ae2d9aa0",
                        "glosses": [
                            "Text, der in der Bibel zu finden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd054897-2631-45ab-bd85-de8bffdbcda2",
                                "sense_id": "17d5b791-2c4a-3425-94de-78fcb1c370b8",
                                "text": "„Das Schriftwort ist der literarische Ausgangspunkt der Predigt, enthält aber gerade bei Eckhart das Thema der Predigt höchstens in literarisch-metaphorischer Form […].“"
                            },
                            {
                                "example_id": "ba5cefe5-5e55-465f-97b3-e36135d761b0",
                                "sense_id": "17d5b791-2c4a-3425-94de-78fcb1c370b8",
                                "text": "Heute hat sich das Schriftwort, das ihr eben gehört habt, erfüllt. (Lukas 4,21)"
                            },
                            {
                                "example_id": "eda46600-54d0-4eff-bfde-75edfceaa967",
                                "sense_id": "17d5b791-2c4a-3425-94de-78fcb1c370b8",
                                "text": "„Ohne Frage hat die hebräische Uebersetzung sich nach dem griechischen Wortlaut in solchen Stellen zu richten, wo der Apostel alttestamentliche Schriftworte nicht eigentlich citirt, sondern nur seiner eigenen Rede einflicht […].“ (1870)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
