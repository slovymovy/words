                "senses": [
                    {
                        "sense_id": "5d6d7732-40ed-3019-ae38-de398299af0a",
                        "entry_id": "cdee2d44-6606-3197-a0b8-e66aab1d38a8",
                        "glosses": [
                            "Vasouiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf59e642-f7cc-4b90-a578-a46fcfc354f9",
                                "sense_id": "5d6d7732-40ed-3019-ae38-de398299af0a",
                                "text": "Te coucher le soir : dormir quel bonheur ! et puis j'adore me glisser entre les draps, revasouiller et puis enfin dormir comme un ptit loir. — (sic)"
                            },
                            {
                                "example_id": "c7e23e1e-ab41-4d72-9db5-b8e38c398300",
                                "sense_id": "5d6d7732-40ed-3019-ae38-de398299af0a",
                                "text": "J'ai fait ce que j'ai pu pour dévasouiller tout ça, en espérant que personne ne le revasouille… mais revoyez quand même l'étymologie…"
                            }
                        ]
                    }
