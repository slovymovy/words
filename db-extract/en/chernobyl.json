                "senses": [
                    {
                        "sense_id": "46c4772a-e0a2-3c8a-9c34-b48d880e92be",
                        "entry_id": "51d9e506-de24-3f61-a509-005ce4ed3238",
                        "glosses": [
                            "較大的核事故"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6a4a0280-9e59-431c-9a7a-a00ce6358d4b",
                                "sense_id": "46c4772a-e0a2-3c8a-9c34-b48d880e92be",
                                "text": "Many secret cities were Chernobyls in slow motion."
                            },
                            {
                                "example_id": "dc85ba43-b41b-4a3c-bab8-c0087c9da1e5",
                                "sense_id": "46c4772a-e0a2-3c8a-9c34-b48d880e92be",
                                "text": "The effects of a Chernobyl disaster in my community would probably be barely noticeable.",
                                "translation": "切尔诺贝利式的灾难对我的社区的影响可能几乎难以察觉。"
                            },
                            {
                                "example_id": "b02d8484-7ae1-4fad-bac4-9e4182bc18ea",
                                "sense_id": "46c4772a-e0a2-3c8a-9c34-b48d880e92be",
                                "text": "So those would be a lot of Chernobyls that the ecosystem would have to deal with.",
                                "translation": "因此，生态系统必须应对许多类似切尔诺贝利事故的灾害。"
                            },
                            {
                                "example_id": "3cbcab92-6c2d-4172-89f0-574f2fe2d55b",
                                "sense_id": "46c4772a-e0a2-3c8a-9c34-b48d880e92be",
                                "text": "It has to be handled properly with great accuracy and no room for mistakes, because if we do have like a Chernobyl catastrophe, God forbid, it could wipe out our entire people.",
                                "translation": "必须非常准确、妥善地处理此事，不容有任何差错，因为如果我们真的遭遇像切尔诺贝利事故那样的灾难（但愿不会发生），它可能会消灭我们全体人民。"
                            }
                        ]
                    }
                ],
