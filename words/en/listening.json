{
    "word_family": [
        "listener",
        "listenable",
        "unlistenable",
        "relisten",
        "outlisten",
        "overlisten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21f1a014-3073-3bf3-8f31-96c5ed1c1693",
                    "sense_definition": "Present participle and gerund of <w>listen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>listening</w> to her favorite song on the radio.",
                            "target_lang_translations": {
                                "ru": "Она <w>слушает</w> свою любимую песню по радио.",
                                "zh": "她正在收音机里<w>听</w>她最喜欢的歌。"
                            }
                        },
                        {
                            "text": "Please stop talking and start <w>listening</w> to the instructions.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прекратите разговаривать и начните <w>слушать</w> инструкции.",
                                "zh": "请停止交谈，开始<w>听</w>说明。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listening to",
                        "worth listening to",
                        "listening in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола listen (слушать).",
                        "zh": "动词 listen 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "слушание",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "听",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "聆听",
                                "target_lang_sense_clarification": "专注地听"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9cce0b3a-639f-3de4-876a-5f5781146600",
                    "sense_definition": "The skill or ability to perceive and understand spoken language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skill_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>listening</w> has improved significantly since she moved to London.",
                            "target_lang_translations": {
                                "ru": "Её <w>восприятие на слух</w> значительно улучшилось с тех пор, как она переехала в Лондон.",
                                "zh": "自从搬到伦敦后，她的<w>听力</w>有了显著提高。"
                            }
                        },
                        {
                            "text": "The course focuses on reading, writing, speaking, and <w>listening</w>.",
                            "target_lang_translations": {
                                "ru": "Курс сосредоточен на чтении, письме, говорении и <w>аудировании</w>.",
                                "zh": "这门课程侧重于读、写、说和<w>听力</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listening skills",
                        "listening comprehension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Навык или способность воспринимать и понимать устную речь.",
                        "zh": "感知和理解口语的技能或能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аудирование",
                                "target_lang_sense_clarification": "в обучении языкам"
                            },
                            {
                                "target_lang_word": "восприятие на слух",
                                "target_lang_sense_clarification": "общая способность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "听力",
                                "target_lang_sense_clarification": "语言技能"
                            },
                            {
                                "target_lang_word": "听解",
                                "target_lang_sense_clarification": "理解能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8adc604-363f-3783-b5aa-21aab83c2d59",
                    "sense_definition": "An educational exercise involving the comprehension of spoken text.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "skill_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher assigned two short <w>listenings</w> for homework.",
                            "target_lang_translations": {
                                "ru": "Учитель задал два коротких упражнения на <w>аудирование</w> в качестве домашнего задания.",
                                "zh": "老师布置了两段简短的<w>听力练习</w>作为家庭作业。"
                            }
                        },
                        {
                            "text": "We did a difficult <w>listening</w> about environmental issues today.",
                            "target_lang_translations": {
                                "ru": "Сегодня мы делали сложное <w>аудирование</w> по экологическим вопросам.",
                                "zh": "我们今天做了一篇关于环境问题的困难<w>听力题</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listening test",
                        "listening exercise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учебное упражнение на понимание устного текста.",
                        "zh": "涉及理解口语文本的教育练习。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аудирование",
                                "target_lang_sense_clarification": "упражнение"
                            },
                            {
                                "target_lang_word": "задание по аудированию",
                                "target_lang_sense_clarification": "учебное задание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "听力练习",
                                "target_lang_sense_clarification": "教学活动"
                            },
                            {
                                "target_lang_word": "听力题",
                                "target_lang_sense_clarification": "考试或作业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68500559-7ac6-3140-aff6-4b9da6b30b71",
                    "sense_definition": "An act of paying attention to something heard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skill_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This complex album rewards multiple <w>listenings</w> to fully appreciate it.",
                            "target_lang_translations": {
                                "ru": "Этот сложный альбом стоит многократного <w>прослушивания</w>, чтобы оценить его по достоинству.",
                                "zh": "这张复杂的专辑值得多<w>聆听</w>几次才能完全领会。"
                            }
                        },
                        {
                            "text": "Upon a second <w>listening</w>, I noticed several details I had missed before.",
                            "target_lang_translations": {
                                "ru": "При втором <w>прослушивании</w> я заметил несколько деталей, которые упустил ранее.",
                                "zh": "在第二次<w>聆听</w>时，我注意到了之前忽略的几个细节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "worth a listening",
                        "first listening"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс внимательного прослушивания чего-либо.",
                        "zh": "专注倾听某事物的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослушивание",
                                "target_lang_sense_clarification": "музыки, записей"
                            },
                            {
                                "target_lang_word": "слушание",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聆听",
                                "target_lang_sense_clarification": "专注的听"
                            },
                            {
                                "target_lang_word": "收听",
                                "target_lang_sense_clarification": "针对广播或录音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f845e2ea-c946-3d75-8b48-4f338342b30d",
                    "sense_definition": "Of something that is designed or used to capture, monitor, or amplify sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy planted a tiny <w>listening</w> device under the conference table.",
                            "target_lang_translations": {
                                "ru": "Шпион установил крошечное <w>подслушивающее</w> устройство под столом для совещаний.",
                                "zh": "间谍在会议桌下安装了一个微小的<w>窃听</w>装置。"
                            }
                        },
                        {
                            "text": "This station serves as a remote <w>listening</w> post for radio signals.",
                            "target_lang_translations": {
                                "ru": "Эта станция служит удаленным постом <w>прослушивания</w> радиосигналов.",
                                "zh": "该站作为无线电信号的远程<w>监听</w>站。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "listening device",
                        "listening post"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к устройствам, предназначенным для перехвата или контроля звука.",
                        "zh": "指设计用于捕捉、监控或放大声音的设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подслушивающий",
                                "target_lang_sense_clarification": "об устройствах"
                            },
                            {
                                "target_lang_word": "для прослушивания",
                                "target_lang_sense_clarification": "функциональное назначение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窃听",
                                "target_lang_sense_clarification": "用于监控"
                            },
                            {
                                "target_lang_word": "监听",
                                "target_lang_sense_clarification": "用于捕捉信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7715feaf-c900-3e65-a73d-bf6d12dae162",
                    "sense_definition": "Describing a person or animal that is paying attention to sounds.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sometimes all a friend needs is a sympathetic <w>listening</w> ear.",
                            "target_lang_translations": {
                                "ru": "Иногда всё, что нужно другу — это сочувствие и <w>готовность выслушать</w>.",
                                "zh": "有时候，朋友需要的仅仅是一个愿意<w>倾听</w>的耳朵。"
                            }
                        },
                        {
                            "text": "The <w>listening</w> crowd fell silent as the music began.",
                            "target_lang_translations": {
                                "ru": "<w>Слушающая</w> толпа затихла, когда заиграла музыка.",
                                "zh": "当音乐响起时，<w>倾听</w>的人群安静了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attentive",
                        "alert"
                    ],
                    "antonyms": [
                        "inattentive"
                    ],
                    "common_phrases": [
                        "listening ear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает человека или животное, которые внимательно прислушиваются.",
                        "zh": "描述正在注意听声音的人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушающий",
                                "target_lang_sense_clarification": "внимающий"
                            },
                            {
                                "target_lang_word": "готовый выслушать",
                                "target_lang_sense_clarification": "идиоматическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾听的",
                                "target_lang_sense_clarification": "专注的"
                            },
                            {
                                "target_lang_word": "愿意倾听的",
                                "target_lang_sense_clarification": "形容态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a84e1c-4464-3322-9300-8bd3a08287f5",
                    "sense_definition": "Of an action performed with caution and intent to detect sounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He froze in a <w>listening</w> posture when he heard the twig snap.",
                            "target_lang_translations": {
                                "ru": "Он замер в <w>настороженной</w> позе, когда услышал хруст ветки.",
                                "zh": "当他听到树枝折断的声音时，他保持着<w>侧耳倾听</w>的姿势僵住了。"
                            }
                        },
                        {
                            "text": "The deer made a slow, <w>listening</w> turn of its head toward the forest.",
                            "target_lang_translations": {
                                "ru": "Олень сделал медленный, <w>настороженный</w> поворот головы в сторону леса.",
                                "zh": "鹿缓慢地转过头，<w>警觉地</w>朝森林方向听去。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О действии, совершаемом с осторожностью и намерением уловить звуки.",
                        "zh": "指带着谨慎和意图去探测声音的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настороженный",
                                "target_lang_sense_clarification": "внимательный к звукам"
                            },
                            {
                                "target_lang_word": "прислушивающийся",
                                "target_lang_sense_clarification": "пытающийся услышать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警觉的",
                                "target_lang_sense_clarification": "形容状态"
                            },
                            {
                                "target_lang_word": "侧耳倾听的",
                                "target_lang_sense_clarification": "形容动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}