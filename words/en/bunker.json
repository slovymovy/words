{
    "word_family": [
        "bunk",
        "bunkering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cea5919c-7e0d-354e-b49a-5035f116eb4f",
                    "sense_definition": "A hardened shelter, often partly buried or fully underground, designed to protect people from bombs, war, or natural disasters.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "shelter_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers hid in the concrete <w>bunker</w> during the air raid.",
                            "target_lang_translations": {
                                "ru": "Солдаты спрятались в бетонном <w>бункере</w> во время авианалета.",
                                "tr": "Askerler hava saldırısı sırasında beton <w>sığınakta</w> saklandılar."
                            }
                        },
                        {
                            "text": "The family built a survival <w>bunker</w> in their backyard to store food and water.",
                            "target_lang_translations": {
                                "ru": "Семья построила <w>бункер</w> для выживания на заднем дворе, чтобы хранить еду и воду.",
                                "tr": "Aile, yiyecek ve su depolamak için arka bahçelerine bir hayatta kalma <w>sığınağı</w> inşa etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelter",
                        "dugout",
                        "fortification"
                    ],
                    "common_phrases": [
                        "underground bunker",
                        "nuclear bunker",
                        "military bunker",
                        "concrete bunker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепленное укрытие, часто частично или полностью подземное, предназначенное для защиты людей от бомб, войны или стихийных бедствий.",
                        "tr": "Bombalardan, savaştan veya doğal afetlerden korunmak için tasarlanmış, genellikle kısmen veya tamamen yer altında bulunan güçlendirilmiş sığınak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "укрепленное укрытие"
                            },
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "безопасное место"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sığınak",
                                "target_lang_sense_clarification": "genel korunaklı yer"
                            },
                            {
                                "target_lang_word": "bunker",
                                "target_lang_sense_clarification": "askeri terminolojide"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a022f558-d01a-33ad-8f91-b9b8044409e9",
                    "sense_definition": "A hazard on a golf course consisting of a hollow filled with sand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "golf_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hit the ball straight into a <w>bunker</w> near the green.",
                            "target_lang_translations": {
                                "ru": "Он ударил по мячу прямо в <w>бункер</w> рядом с грином.",
                                "tr": "Topu doğrudan yeşil alanın yanındaki <w>kum engelinin</w> içine vurdu."
                            }
                        },
                        {
                            "text": "It can be very difficult to hit a golf ball out of a deep sand <w>bunker</w>.",
                            "target_lang_translations": {
                                "ru": "Выбить мяч для гольфа из глубокого песчаного <w>бункера</w> может быть очень трудно.",
                                "tr": "Derin bir kum <w>engelinden</w> golf topuna vurup çıkarmak çok zor olabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "sand trap",
                        "trap"
                    ],
                    "common_phrases": [
                        "sand bunker",
                        "hit into a bunker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствие на поле для гольфа в виде углубления, заполненного песком.",
                        "tr": "Golf sahasında kumla dolu çukurdan oluşan bir engel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "в гольфе"
                            },
                            {
                                "target_lang_word": "песчаная ловушка",
                                "target_lang_sense_clarification": "элемент поля для гольфа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kum engeli",
                                "target_lang_sense_clarification": "golf terimi"
                            },
                            {
                                "target_lang_word": "bunker",
                                "target_lang_sense_clarification": "golf terimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5828a6-609d-3e58-9b5b-baf7242e6774",
                    "sense_definition": "A large container or compartment for storing fuel, such as coal or oil, on a ship or train, or historically in a house.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fuel_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's <w>bunker</w> was filled with enough coal for the long voyage.",
                            "target_lang_translations": {
                                "ru": "Судовой <w>бункер</w> был заполнен углем, достаточным для долгого плавания.",
                                "tr": "Geminin <w>yakıt deposu</w> uzun yolculuk için yeterli kömürle doldurulmuştu."
                            }
                        },
                        {
                            "text": "In the past, many homes had a coal <w>bunker</w> outside the kitchen door.",
                            "target_lang_translations": {
                                "ru": "В прошлом во многих домах был угольный <w>бункер</w> у кухонной двери.",
                                "tr": "Geçmişte birçok evin mutfak kapısının dışında bir <w>kömürlüğü</w> vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "bin",
                        "container",
                        "compartment"
                    ],
                    "common_phrases": [
                        "coal bunker",
                        "fuel bunker"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "regarding household coal storage"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "technical or nautical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой контейнер или отсек для хранения топлива (угля, мазута) на судне, поезде или в доме.",
                        "tr": "Bir gemide, trende veya evde kömür ya da petrol gibi yakıtları depolamak için kullanılan büyük konteyner veya bölme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "резервуар для топлива"
                            },
                            {
                                "target_lang_word": "угольная яма",
                                "target_lang_sense_clarification": "хранилище угля"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yakıt deposu",
                                "target_lang_sense_clarification": "genel kullanım"
                            },
                            {
                                "target_lang_word": "kömürlük",
                                "target_lang_sense_clarification": "evlerdeki kömür depolama alanı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7ed89a5-248f-336b-a6f8-2944d1fd5eab",
                    "sense_definition": "A type of fish, specifically the menhaden, found in coastal waters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen used a net to catch a large school of <w>bunker</w> for bait.",
                            "target_lang_translations": {
                                "ru": "Рыбаки использовали сеть, чтобы поймать большой косяк <w>менхэден</w> для наживки.",
                                "tr": "Balıkçılar yem olarak büyük bir menhaden sürüsü yakalamak için ağ kullandılar."
                            }
                        },
                        {
                            "text": "Striped bass often feed on <w>bunker</w> near the surface of the water.",
                            "target_lang_translations": {
                                "ru": "Полосатый окунь часто кормится <w>менхэден</w> у поверхности воды.",
                                "tr": "Çizgili levrekler genellikle suyun yüzeyine yakın yerlerde <w>menhaden</w> ile beslenirler."
                            }
                        }
                    ],
                    "synonyms": [
                        "menhaden",
                        "pogy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид рыбы (менхэден), обитающий в прибрежных водах.",
                        "tr": "Kıyı sularında bulunan bir balık türü (menhaden)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "менхэден",
                                "target_lang_sense_clarification": "вид рыбы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "menhaden balığı",
                                "target_lang_sense_clarification": "balık türü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bfec320-ade3-3121-9832-bdfc6a444d23",
                    "sense_definition": "A student who stays away from school without permission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "truancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher marked him as a <w>bunker</w> because he missed class again.",
                            "target_lang_translations": {
                                "ru": "Учитель отметил его как <w>прогульщика</w>, потому что он снова пропустил урок.",
                                "tr": "Dersi yine astığı için öğretmen onu <w>okul kırıcı</w> olarak işaretledi."
                            }
                        },
                        {
                            "text": "He was a known <w>bunker</w> during his teenage years and rarely attended lessons.",
                            "target_lang_translations": {
                                "ru": "В подростковом возрасте он был известным <w>прогульщиком</w> и редко посещал занятия.",
                                "tr": "Gençlik yıllarında bilinen bir <w>okul kırıcıydı</w> ve derslere nadiren katılırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "truant"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ученик, который пропускает занятия в школе без разрешения.",
                        "tr": "İzinsiz olarak okuldan uzak duran öğrenci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогульщик",
                                "target_lang_sense_clarification": "ученик, пропускающий уроки"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "okul kırıcı",
                                "target_lang_sense_clarification": "okula gitmeyen öğrenci"
                            },
                            {
                                "target_lang_word": "asık",
                                "target_lang_sense_clarification": "dersi asan kişi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac79d816-37ef-3094-93d9-bb3a0a271d75",
                    "sense_definition": "To take shelter in a protected place, usually followed by 'down'.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shelter_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The residents decided to <w>bunker</w> down in the basement until the tornado passed.",
                            "target_lang_translations": {
                                "ru": "Жители решили <w>укрыться</w> в подвале, пока не пройдет торнадо.",
                                "tr": "Sakinler hortum geçene kadar bodrum katına <w>sığınmaya</w> karar verdiler."
                            }
                        },
                        {
                            "text": "We had to <w>bunker</w> in the office while the protests continued outside.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>запереться</w> в офисе, пока на улице продолжались протесты.",
                                "tr": "Dışarıda protestolar devam ederken ofise <w>sığınmak</w> zorunda kaldık."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelter",
                        "hunker down"
                    ],
                    "common_phrases": [
                        "bunker down",
                        "bunker in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрыться в защищенном месте, переждать опасность.",
                        "tr": "Korunaklı bir yere sığınmak, genellikle tehlike geçene kadar beklemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрыться",
                                "target_lang_sense_clarification": "спрятаться в безопасном месте"
                            },
                            {
                                "target_lang_word": "затаиться",
                                "target_lang_sense_clarification": "спрятаться и ждать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sığınmak",
                                "target_lang_sense_clarification": "güvenli bir yere girmek"
                            },
                            {
                                "target_lang_word": "saklanmak",
                                "target_lang_sense_clarification": "gizlenmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8100e712-667d-3b99-890f-684872eb7a13",
                    "sense_definition": "To load a ship or vessel with fuel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fuel_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vessel stopped at the port to <w>bunker</w> before crossing the ocean.",
                            "target_lang_translations": {
                                "ru": "Судно остановилось в порту, чтобы <w>забункероваться</w> перед пересечением океана.",
                                "tr": "Gemi okyanusu geçmeden önce <w>yakıt ikmali yapmak</w> için limanda durdu."
                            }
                        },
                        {
                            "text": "It took several hours to <w>bunker</w> the large cargo ship with oil.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько часов, чтобы <w>заправить</w> большое грузовое судно топливом.",
                                "tr": "Büyük kargo gemisine petrol <w>ikmali yapmak</w> birkaç saat sürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuel",
                        "refuel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загружать судно топливом.",
                        "tr": "Bir gemiye veya tekneye yakıt yüklemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бункероваться",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "заправляться",
                                "target_lang_sense_clarification": "пополнять запасы топлива"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yakıt ikmali yapmak",
                                "target_lang_sense_clarification": "denizcilik terimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a440b1e2-3c61-344b-9922-40b5bd608f00",
                    "sense_definition": "To hit a golf ball into a sand trap.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "golf_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>bunker</w> his shot on the final hole of the tournament.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>попасть в бункер</w> на последней лунке турнира.",
                                "tr": "Turnuvanın son deliğinde vuruşuyla <w>kum engelinde kalmayı</w> başardı."
                            }
                        },
                        {
                            "text": "I was <w>bunkered</w> near the green and lost the match.",
                            "target_lang_translations": {
                                "ru": "Я <w>попал в бункер</w> рядом с грином и проиграл матч.",
                                "tr": "Yeşil alanın yakınında <w>kum engelinde kaldım</w> ve maçı kaybettim."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попасть мячом для гольфа в песчаную ловушку.",
                        "tr": "Golf topunu kum engelinin içine vurmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попасть в бункер",
                                "target_lang_sense_clarification": "в гольфе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kum engelinde kalmak",
                                "target_lang_sense_clarification": "golf terimi"
                            }
                        ]
                    }
                }
            ]
        },
        {
