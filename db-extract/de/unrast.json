                            {
                                "example_id": "4891ac02-fac0-44bc-86d6-20e8d9e47868",
                                "sense_id": "ae07daf0-9188-3626-8bed-da14ca06c547",
                                "text": "Er war schon seit Tagen von einer besonderen Unrast gepackt."
                            },
                            {
                                "example_id": "d9d95459-f803-4246-9fc1-06005a6c949e",
                                "sense_id": "ae07daf0-9188-3626-8bed-da14ca06c547",
                                "text": "„Wilhelm Ostwald, der in wissenschaftlichen Fragen voller Unrast war, führte ein stilles und harmonisches Familienleben.“"
                            },
                            {
                                "example_id": "3bbf2745-33ce-4bb7-9eef-c96882f1f57e",
                                "sense_id": "ae07daf0-9188-3626-8bed-da14ca06c547",
                                "text": "„Dies ist nach den Studien eines Tierarztes die beschämende Folge der Unrast unserer Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
