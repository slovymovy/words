                ],
                "senses": [
                    {
                        "sense_id": "b713013d-64f8-342a-a7e2-44670d36ee20",
                        "entry_id": "93c2b895-ff8f-377b-877e-23b9e2f9a394",
                        "glosses": [
                            "Fähigkeit, große geistige oder körperliche Anstrengungen meistern zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbcb56f-2bd8-4b90-b835-bb5a6ea9b300",
                                "sense_id": "b713013d-64f8-342a-a7e2-44670d36ee20",
                                "text": "Er hat die nötige geistige Spannkraft für den Job."
                            },
                            {
                                "example_id": "ea5d6cc0-f69b-4af6-b387-122dd063ba5b",
                                "sense_id": "b713013d-64f8-342a-a7e2-44670d36ee20",
                                "text": "Meine Mutter hat in den letzten Jahren an Spannkraft verloren."
                            },
                            {
                                "example_id": "a7774afa-b410-4d18-9a02-6c4643c08123",
                                "sense_id": "b713013d-64f8-342a-a7e2-44670d36ee20",
                                "text": "Der Prinz mit einer starken Phantasie begabt, neigte anfänglich zu einer gewissen Zerstreutheit; es zeigte sich damals, wie Godet erzählt, bei ihm weniger Energie und Spannkraft als bei seinem Kameraden, was an einer gewissen physischen Schlaffheit liegen konnte, die aus seinem schnellen Wachsthum hervorging."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                        "entry_id": "93c2b895-ff8f-377b-877e-23b9e2f9a394",
                        "glosses": [
                            "Kraft der Spannung, zum Beispiel die einer Feder oder eines Gases"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "afe67efe-aaeb-4466-a521-dc0421c38f8a",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "In der sich drehenden Bremstrommel werden von innen die beiden auf der Bremsankerplatte beweglich gelagerten Bremsbacken durch eine entsprechende Vorrichtung mit der Spannkraft Fs angepresst."
                            },
                            {
                                "example_id": "4f568c59-c5dc-4a60-8134-51d9ed4a0bb0",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "Das Konstruktionsprinzip setzt eine dauerhafte Federeigenschaft voraus. Bei manchen Materialien lässt die Spannkraft mit der Zeit nach."
                            },
                            {
                                "example_id": "5b756e74-4ff3-4269-a8b8-32508f2a3ff8",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "Ein maßvolles Erhöhen der Temperatur erhöht erheblich die Spannkraft des Elastomers, da es ihm Energie zuführt, wodurch es Arbeit verrichten kann."
                            },
                            {
                                "example_id": "4b00eb50-f8ef-4c7d-8f9e-f7f4722b9b2b",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "Der Versuch ward fortgesetzt, bis die Spannkraft des Dampfes von 75 Pfund auf 40 Pfund pro Quadratzoll herabgesunken war."
                            },
                            {
                                "example_id": "b8370d39-ffad-4995-ad42-505b18fc121f",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "Die Ursache des Druckes ist die Wärme, welche durch einen chemischen Process, d. h. durch Verbrennung von Brennmaterialien unter dem Dampfkessel erzeugt wird, und die das Wasser aufnimmt; durch diese Wärme wird das Wasser zu Wasserdampf und dieser empfängt durch sie die zur Bewegung des Kolbens nöthige Spannkraft; in letzter Form ist es die Wärme, welche den Druck und Hub bedingt und welche die mechanische Arbeit der Maschine verrichtet."
                            },
                            {
                                "example_id": "29c83da4-cabd-4454-a3d7-45dd00b44a6e",
                                "sense_id": "8c44eaa4-65c5-33ae-84ab-4acc1d41d208",
                                "text": "Die Spannkraft wird in den häufigsten Fällen durch kräftiges Anziehen einer Mutter aufgebracht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
