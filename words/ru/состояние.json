                {
                    "sense_id": "97673608-2b03-391f-81b1-fce7c9a3ed83",
                    "sense_definition": "Положение или совокупность обстоятельств, в которых находится кто-либо или что-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач сказал, что физическое <w>состояние</w> пациента быстро улучшается.",
                            "target_lang_translations": {
                                "en": "The doctor said that the patient's physical <w>condition</w> is improving rapidly.",
                                "zh": "医生说病人的身体<w>状况</w>正在迅速好转。"
                            }
                        },
                        {
                            "text": "В <w>состоянии</w> стресса человек часто делает необдуманные поступки.",
                            "target_lang_translations": {
                                "en": "In a <w>state</w> of stress, a person often makes rash decisions.",
                                "zh": "人在压力<w>状态</w>下经常会做出草率的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "положение"
                    ],
                    "common_phrases": [
                        "состояние здоровья",
                        "в хорошем состоянии"
                    ],
                    "target_lang_definitions": {
