                                    {
                                        "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                        "entry_id": "b4361ff0-afea-3263-ae6c-e1b09dfe8280",
                                        "glosses": [
                                            "Menge von Fahrzeugen, besonders von Schiffen oder Autos, die sich mit etwa gleicher Geschwindigkeit hintereinanderfahrend fortbewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5884984d-4877-4935-bb6c-69b95842b099",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "Die Kriegsschiffe fuhren im Konvoi, damit sie weniger Verluste hätten, falls sie angegriffen würden."
                                            },
                                            {
                                                "example_id": "c87feef3-d5f0-41c8-a5ee-4292966a11d9",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "„Sechs Tage nach den unerklärlichen Torpedofehlschüssen verfolgte U 188 einen Geleitzug vor der arabischen Küste, dampfte ihn mit aller Kraft aus und setzte sich zur Vorbereitung eines Nachtangriffs vor den Konvoi.“"
                                            },
                                            {
                                                "example_id": "ae552e9f-39cd-4e48-8fca-c3e53339e91e",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "„Und Schweigen herrschte auf der Brücke, als Lockhart den Signalspruch von dem großen Frachtdampfer, der den Konvoi geführt hatte, annahm und bestätigte.“"
                                            },
                                            {
                                                "example_id": "c7dea1a8-3fa3-4413-9c6f-713b092c39c9",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "„Am 15. Juli, als sie noch in der Höhe von Bordeaux vor der französischen Küste standen, entschloss Durand sich, aus dem Konvoi auszuscheren.“"
                                            },
                                            {
                                                "example_id": "dde4b637-3ead-46ec-90de-6ebf987b5776",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "„Von den Atlantikhäfen aus konnten sie die bewährte Rudeltaktik gegen alliierte Konvois anwenden.“"
                                            },
                                            {
                                                "example_id": "0af3af77-6e29-4bab-b5ba-d2624a7eb10c",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "Sie fuhren in einem Konvoi zum Einsatzort."
                                            },
                                            {
                                                "example_id": "a19209c6-d204-4037-b048-6670f937c149",
                                                "sense_id": "010738b7-34cc-3c5e-8457-3965dd7f6003",
                                                "text": "„Jedes Mal säumen Hunderttausende die Straßen, über die der Konvoi der Leichenwagen fährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5cc76ba-97f9-39a1-830a-65ad605ac453",
                                        "entry_id": "b4361ff0-afea-3263-ae6c-e1b09dfe8280",
                                        "glosses": [
                                            "Begleitmannschaft, die zum Schutz eingesetzt ist; speziell im die Begleitmannschaft, die bei einem Radrennen zur Unterstützung der Wettkämpfer mitfährt"
                                        ],
                                        "tags": [
                                            "Radrennsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d837da0f-3476-4d21-97b7-f07e139b913d",
                                                "sense_id": "f5cc76ba-97f9-39a1-830a-65ad605ac453",
                                                "text": "Der Präsident wurde von einem Konvoi von Polizeifahrzeugen geschützt."
                                            },
                                            {
                                                "example_id": "2b26af1b-2504-4586-817a-eed69a3af518",
                                                "sense_id": "f5cc76ba-97f9-39a1-830a-65ad605ac453",
                                                "text": "Sie fuhren so schnell, dass der Konvoi kaum mitkam."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
