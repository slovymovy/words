                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66e90b3d-7d25-354c-bd6d-680837c884da",
                                        "entry_id": "1faf1d17-edf4-3e43-9edf-40a1077b924e",
                                        "glosses": [
                                            "Prohibition; a prohibitory ordinance."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
