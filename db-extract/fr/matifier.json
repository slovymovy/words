                "translations": [
                    {
                        "translation_id": "dc7e1808-e38f-4969-9175-4fd76c33c4c6",
                        "source_entry_id": "4a986c97-ec50-3dd1-839e-42e7eb9c5d06",
                        "source_sense_id": "ee292605-9f01-3815-b2d5-696389224eef",
                        "source_sense_description": "transitiv, Kosmetik: mattieren",
                        "target_lang_word": "mattieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mattieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                        "entry_id": "95f7db28-36ad-3dc3-abb7-ae9f3ae53634",
                                        "glosses": [
                                            "etwas glanzlos, matt, stumpf, undurchsichtig machen; den Glanz von etwas entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1d8718-a5c4-4e3a-bb09-105c9be01154",
                                                "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                                "text": "Will man die Zinkoberfläche mattieren, so taucht man den zuerst blank gebeizten Gegenstand in eine Beize von salpetersaurem Zink."
                                            },
                                            {
                                                "example_id": "a2af64ae-1fdd-4a39-a288-7159485edcf5",
                                                "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                                "text": "Eisenhaltiges Aluminiumblech lässt sich mit Natronlauge und Salpetersäure gut mattieren; die Lauge löst hierbei das Aluminium, die Salpetersäure das Eisen auf."
                                            },
                                            {
                                                "example_id": "33b66ddd-cd01-4626-bd08-c72f4cda5a07",
                                                "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                                "text": "Lacke auf Basis unterschiedlicher Bindemitteltypen lassen sich aufgrund ihres Benetzungsverhaltens unterschiedlich gut mattieren."
                                            },
                                            {
                                                "example_id": "a5765e29-1306-40e4-8ec7-4ed85c054f8a",
                                                "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                                "text": "Gebeizte oder auch naturbelassene Holzoberflächen sind zuerst zu grundieren, bevor sie mattiert oder lackiert werden."
                                            },
                                            {
                                                "example_id": "b61de6f8-97bc-4625-9cb9-834e29acca8d",
                                                "sense_id": "fe26f0fa-5a3a-3a9a-80d6-ba13c3cad684",
                                                "text": "Glas ganzflächig oder partiell zu mattieren, gehört seit Jahrhunderten zu den beliebtesten kreativen Techniken, um klares, durchsichtiges Glas zu gestalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
