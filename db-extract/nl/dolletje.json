                    {
                        "sense_id": "c9e30f96-b168-391c-addf-a8cefdf6adbf",
                        "entry_id": "cc7113f3-214e-398e-8dff-64eb757600e4",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord dol",
                            "een klein U-vormig steunpunt waarin een roeispaan rust"
