                ],
                "senses": [
                    {
                        "sense_id": "6625f4e8-a34f-32f1-9ec7-b9c59d068afb",
                        "entry_id": "a9cb0877-3abe-3094-81bf-5a3441fafe80",
                        "glosses": [
                            "Vorrichtung, die prüft und verhindert, dass der Handlauf einer Rolltreppe sich löst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f54a48-5b8b-4a9e-975e-f0a6311744d8",
                                "sense_id": "6625f4e8-a34f-32f1-9ec7-b9c59d068afb",
                                "text": "„Übrigens darf der Handlauf auch nicht so locker sein, dass man ihn durch kräftiges Ziehen zum Verrutschen bringen kann. Bei modernen Rolltreppen wird das elektronisch überwacht – durch einen so genannten Handleistenschlupfkontakt.“"
                            },
                            {
                                "example_id": "963ee026-454a-48a8-926b-29f9b13acb27",
                                "sense_id": "6625f4e8-a34f-32f1-9ec7-b9c59d068afb",
                                "text": "„Der Handleistenschlupfkontakt, der dafür sorgt, das wankelmütige Menschen auf Rolltreppen nicht den Handlauf abreißen, sich mangels Halt lotrecht in die Tiefe stürzen und dabei noch dominomisch einen Kindergartenausflug mit abräumen.“"
                            },
                            {
                                "example_id": "a39b5e95-8d72-43ee-a33a-5456a693bfc8",
                                "sense_id": "6625f4e8-a34f-32f1-9ec7-b9c59d068afb",
                                "text": "„Die Geschichte vom kleinen Handleistenschlupfkontakt“"
                            },
                            {
                                "example_id": "d31c60d1-8e0a-4d29-b078-890c164c4ab5",
                                "sense_id": "6625f4e8-a34f-32f1-9ec7-b9c59d068afb",
                                "text": "„Dass der kleine Handleistenschlupfkontakt in eine Sinnkrise gerät, weil ihn niemand kennt, wird dank Richter nicht mehr vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
