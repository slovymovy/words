                                "example_id": "c9549ae4-f413-4536-878a-28f3414c444c",
                                "sense_id": "51ecbffd-6ba4-3423-bb86-0012042233e2",
                                "text": "Nach diesen Präliminarien folgte dann das Hauptstück der ganzen Deklaration, der Passus über die Meerengen."
                            },
                            {
                                "example_id": "d56abfc2-55c4-468d-8be2-ee10141599b0",
                                "sense_id": "51ecbffd-6ba4-3423-bb86-0012042233e2",
                                "text": "Dann lassen wir jetzt mal die Präliminarien beiseite und konzentrieren uns auf das Wesentliche."
                            }
