                                        "sense_id": "9c506ac4-0fa6-3f1b-8712-eabda4ba5555",
                                        "entry_id": "0f2cfa72-bb77-3da4-bf08-01a73b9173b4",
                                        "glosses": [
                                            "Maschine, die vorwiegend Getreide, Ölfrüchte oder Gras mäht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8de120-eeea-4454-989d-90293be7896a",
                                                "sense_id": "9c506ac4-0fa6-3f1b-8712-eabda4ba5555",
                                                "text": "„In breiten Streifen fiel das wogende Gold unter dem Ochsenschritt der Mähmaschine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09bf4b17-8609-479d-8ea5-c0bf480b8ede",
                        "source_entry_id": "40d9f338-8725-349b-9694-3a15501246f9",
                        "source_sense_id": "f59c71a5-26b1-3318-b81b-e493965b27cd",
                        "target_lang_word": "Rasenmäher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rasenmäher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                        "entry_id": "62bffe78-3c24-3570-b131-061384bcf54e",
                                        "glosses": [
                                            "(meist motorgetriebenes) Gerät, das mit rotierenden Messern den Rasen kürzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5352799e-6aff-4d5e-97e4-065e38f574cb",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "Neben den Rasenmähern mit Motor gibt es auch solche mit einer rotierenden Messerwalze, die mechanisch in Rotation versetzt wird. Diese heißen Spindelmäher."
                                            },
                                            {
                                                "example_id": "625b5443-c190-4e8c-9e43-61d17454afee",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Warum sie sich keinen Rasenmäher, dafür aber eine Scheibtruhe leisten konnte, erfuhr Wojciech Czaja.“"
                                            },
                                            {
                                                "example_id": "258b9b52-e291-4ec4-93c7-de1780578c05",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Du bist stolz auf deinen eigenen Rasenmäher.“"
                                            },
                                            {
                                                "example_id": "e832c1df-f78d-4865-9da1-bf2c5cf892e5",
                                                "sense_id": "8cdfa458-48f6-3499-8cc5-d2a9a930fef0",
                                                "text": "„Wegen seiner maßlosen Langeweile mähte Bundschuh jedes Wochenende mit dem gemeindeeigenen Rasenmäher die Schulwiese vor dem Haus, die als Wäschetrockenplatz benutzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6917dd04-f81e-4353-bf77-fd785079abef",
                        "source_entry_id": "40d9f338-8725-349b-9694-3a15501246f9",
                        "source_sense_id": "f59c71a5-26b1-3318-b81b-e493965b27cd",
                        "target_lang_word": "косилка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "косилка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba8fb5c-1966-3d33-a161-aa9ced8dd239",
                                        "entry_id": "cd9fa681-e0ea-3184-b0cb-68baa06711ab",
                                        "glosses": [
                                            "с.-х. машина или навесное оборудование для скашивания злаков, травы и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92dd77ce-1592-4114-9dda-c1cfa907d54b",
                                                "sense_id": "1ba8fb5c-1966-3d33-a161-aa9ced8dd239",
                                                "text": "Дом фермера был чистый и приятный для глаз, как и подобает дому с двумя или тремястами акров приличной пахотной земли, возделываемой заботливым хозяином, который хотя и обрабатывал её по старинке, не употребляя ни косилок, ни паровых плугов и не занимаясь химическими опытами, но всё же вкладывал в неё порядочные деньги и получал неплохой доход."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
