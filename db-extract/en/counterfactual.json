    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                "word": "counterfactual",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                        "glosses": [
                            "Contrary to known or agreed facts; untrue."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f3eb29f6-5ddf-4a1e-8c1b-c651fec60c84",
                                "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                                "text": "a leaderless disinformation campaign, with claims leaping from conspiracy theorists to state propagandists to alternative-media outlets and back—an ecosystem I call the Counterfactual Community."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                        "glosses": [
                            "Of or in comparison to a hypothetical state of the world."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "424f94e2-6dfe-4eeb-8aea-cceae51db38c",
                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                "text": "What would have happened if those great Chinese voyages [by Zheng He] had continued? It's one of those questions in counter-factual history about which it is impossible to be sure."
                            },
                            {
                                "example_id": "afe35f51-6dbf-4011-936f-f470c4376359",
                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                "text": "The counterfactual 1982 of the novel plays variations on our historical record and contains clear allusions to the present."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11c5d0d-efdf-4729-bef7-617a538441ab",
                        "source_entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                        "source_sense_description": "contrary to the facts",
                        "target_lang_word": "contrefactuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrefactuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                        "entry_id": "1aa8de66-1d3c-326c-9d7d-19a90c108d67",
                                        "glosses": [
                                            "Qui renvoie à la réflexion sur les événements qui ne se sont pas réalisés mais auraient pu le faire sous certaines conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9717f5-a4db-40a9-aed8-3692919e1a06",
                                                "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                                "text": "N'êtes-vous pas le logo de cette nouvelle Histoire mêlant rétroactivement toutes les utopies contrefactuelles, machine à démonter les temps? Mais voyons-y de plus près."
                                            },
                                            {
                                                "example_id": "62f71c50-af4b-4ba1-920a-58afc53adb3d",
                                                "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                                "text": "Le loyer contrefactuel correspond au loyer moyen qui aurait été observé sans encadrement des loyers"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
