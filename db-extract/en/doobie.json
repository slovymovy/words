                "senses": [
                    {
                        "sense_id": "672922c9-fc85-352c-b7e3-6a02f06bd436",
                        "entry_id": "c7525cfa-91c1-3016-81a5-1e7e3f7971b1",
                        "glosses": [
                            "A marijuana cigarette."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "911985c5-c935-46ce-99c3-617232da495e",
                                "sense_id": "672922c9-fc85-352c-b7e3-6a02f06bd436",
                                "text": "YO! Youse guys need to turn those frowns upside down, and I got just the thing for that… we call it… DOOBIE SNACKS!"
                            },
                            {
                                "example_id": "1f85c956-72f9-4a14-a9c0-68dead6644d2",
                                "sense_id": "672922c9-fc85-352c-b7e3-6a02f06bd436",
                                "text": "In parts of the state, enjoying an occasional doobie is nowadays considered little different from sipping a Pinot Noir."
                            },
                            {
                                "example_id": "8ed50d5e-438f-4d8d-bde1-54a45aea1a3e",
                                "sense_id": "672922c9-fc85-352c-b7e3-6a02f06bd436",
                                "text": "[The] atmosphere […] was one part oxygen, four parts nitrogen, and seventeen parts doobie vapor."
                            }
                        ]
                    },
