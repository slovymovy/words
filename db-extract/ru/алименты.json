                                "target_senses": [
                                    {
                                        "sense_id": "976f0cf2-2f9e-3cdb-a73c-1e41f2914022",
                                        "entry_id": "eed060c7-8e3c-396e-a2f7-c49c3f28879e",
                                        "glosses": [
                                            "Actions performed to keep some machine or system functioning or in service."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8437203-1184-4bfd-8d23-ed646e9c7e9f",
                                                "sense_id": "976f0cf2-2f9e-3cdb-a73c-1e41f2914022",
                                                "text": "They are all preventable by proper maintenance, but non-safety critical maintenance has to be evaluated, so failures are an accepted penalty for keeping maintenance costs down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667013bd-dc93-3be6-af46-691794ecaf84",
                                        "entry_id": "eed060c7-8e3c-396e-a2f7-c49c3f28879e",
                                        "glosses": [
                                            "A tort and (in some jurisdictions) an offence committed when a third party who does not have a bona fide interest in a lawsuit provides help or acquires an interest to a litigant's lawsuit."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e748bd-02be-39f0-8e91-34c5c0a60e2b",
                                        "entry_id": "eed060c7-8e3c-396e-a2f7-c49c3f28879e",
                                        "glosses": [
                                            "Alimony, a periodical payment or a lump sum made or ordered to be made to a spouse after a divorce."
                                        ],
