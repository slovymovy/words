                                        "sense_id": "4f66a4a2-88c2-3595-8b23-aba385d063d8",
                                        "entry_id": "959bd8d8-34f2-3768-88fc-a0e043f3f8ae",
                                        "glosses": [
                                            "Teilnahme an einer Fahrt auf einem Kreuzfahrtschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b91c99-a86f-496f-9182-25b98fd5a91c",
                                                "sense_id": "4f66a4a2-88c2-3595-8b23-aba385d063d8",
                                                "text": "Man unterscheidet Kreuzfahrten nach ihrem Fahrtgebiet in Hochsee- oder Flusskreuzfahrten."
                                            },
                                            {
                                                "example_id": "ce57e839-f551-4ae0-b6bf-22b4c3abe100",
                                                "sense_id": "4f66a4a2-88c2-3595-8b23-aba385d063d8",
                                                "text": "„Dann kam Mamas Mutter aus Oslo, um auf uns aufzupassen, sie schleppte große Koffer, die Papa die Treppe hochwuchtete, gab uns Kampferdrops und höllisch starke Lakritzbonbons, die sie auf Kreuzfahrten gekauft hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f79f05d2-04a6-3847-81c0-8dcd40e62cf9",
                                        "entry_id": "959bd8d8-34f2-3768-88fc-a0e043f3f8ae",
                                        "glosses": [
                                            "Teilnahme an einem Kreuzzug (über die See)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fa1a51-f4f9-497f-9293-0635cc0acb8b",
                                                "sense_id": "f79f05d2-04a6-3847-81c0-8dcd40e62cf9",
                                                "text": "Friedrich betrieb nun, obwol gebannt, mit größtem Eifer die Kreuzfahrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
