    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de80c42b-00f1-3206-8077-452815b84406",
                    "sense_definition": "Mettre fin à quelque chose ou déclarer officiellement une action terminée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terminer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a décidé de <w>clore</w> la séance après trois heures de discussions intenses."
                        },
                        {
                            "text": "Avant de partir vivre à l'étranger, elle doit <w>clore</w> son compte bancaire."
                        }
                    ],
                    "synonyms": [
                        "terminer",
                        "achever",
                        "conclure"
                    ],
                    "antonyms": [
                        "ouvrir",
                        "commencer",
                        "débuter"
                    ],
                    "common_phrases": [
                        "clore le débat",
                        "clore la séance",
                        "clore un compte",
                        "clore l'incident"
                    ]
                },
                {
                    "sense_id": "695e7ab7-565f-305a-bec1-296ac94cff48",
                    "sense_definition": "Fermer ce qui était ouvert, en particulier les yeux ou un passage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fermer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Épuisé par cette longue journée de travail, il a fini par <w>clore</w> les yeux."
                        },
                        {
                            "text": "Il était si fatigué qu'il peinait à ne pas <w>clore</w> les yeux pendant le film."
                        }
                    ],
                    "synonyms": [
                        "fermer"
                    ],
                    "antonyms": [
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "clore les yeux",
                        "clore les paupières"
                    ]
                },
                {
                    "sense_id": "2a9260b9-fc8f-3fc5-8dd0-690468326fc4",
                    "sense_definition": "Enfermer un espace en l'entourant d'une clôture, d'un mur ou d'une haie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fermer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a décidé de <w>clore</w> son jardin avec un grand mur en pierre."
                        },
                        {
                            "text": "Pour empêcher les bêtes d'entrer, il convient de <w>clore</w> ce vaste terrain sans tarder."
                        }
                    ],
                    "synonyms": [
                        "enclore",
                        "clôturer",
                        "entourer"
                    ],
                    "common_phrases": [
                        "clore un jardin",
                        "clore une propriété"
                    ]
                },
                {
                    "sense_id": "fbfb8412-f325-3aa8-bd5f-2c28b5d6ad31",
                    "sense_definition": "Se fermer convenablement, en parlant d'une porte, d'une fenêtre ou d'une ouverture.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fermer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cause de l'humidité en hiver, la fenêtre du salon ne <w>clôt</w> plus correctement."
                        },
                        {
                            "text": "Cette ancienne porte en bois ne <w>clôt</w> pas bien et laisse passer les courants d'air."
                        }
                    ],
                    "synonyms": [
                        "fermer"
                    ]
                }
            ]
        }
    ]
