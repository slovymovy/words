                "senses": [
                    {
                        "sense_id": "a331dabd-288f-35e3-b7ab-1d3e2a998a4d",
                        "entry_id": "7588fe98-df87-34c8-be55-9254d5b30106",
                        "glosses": [
                            "die spezielle Sprache, Fachsprache des Weidmannes bzw. des Jägers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2018452-94e1-434e-9da9-d5770568f5e3",
                                "sense_id": "a331dabd-288f-35e3-b7ab-1d3e2a998a4d",
                                "text": "Die Jäger- oder Weidmannssprache weist ein sehr bildhaftes Vokabular auf."
                            },
                            {
                                "example_id": "8737dea8-977a-462e-9dda-b53f4baf8051",
                                "sense_id": "a331dabd-288f-35e3-b7ab-1d3e2a998a4d",
                                "text": "„Daß die Sonder- oder die Fachsprachen der verschiedenen Stände und Berufe den Reichtum ihres Wortschatzes nicht einfach auf ihre besondere, dem Außenstehenden unbekannte Begriffswelt gründen, sondern daß vielfach auch für ganz allgemein geläufige Vorstellungen in einem bestimmten Stande besondere Bezeichnungen entwickelt werden, zeigt zum Beispiel die Weidmannssprache...“"
                            },
                            {
                                "example_id": "748c13eb-f941-481b-81a4-ac7e7cb2ce82",
                                "sense_id": "a331dabd-288f-35e3-b7ab-1d3e2a998a4d",
                                "text": "„Auch altdeutsches Wortgut hat die Weidmannssprache bis heute erhalten…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
