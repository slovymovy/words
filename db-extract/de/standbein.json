                    {
                        "form_id": "18c9a1e8-79ec-410b-85b8-9a44f9146442",
                        "entry_id": "6bbbdf85-f120-33a3-a02e-482908affa14",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Standbein"
                    },
                    {
                        "form_id": "1bdfc5a0-5af9-4f41-bfde-0e1dcd7d2bdc",
                        "entry_id": "6bbbdf85-f120-33a3-a02e-482908affa14",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Standbeine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fd82b3b-904e-316a-a526-adbe0120ec56",
                        "entry_id": "6bbbdf85-f120-33a3-a02e-482908affa14",
                        "glosses": [
                            "das Bein, auf dem ein Sportler steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcec20c0-4d43-4e28-b812-eb449779eb00",
                                "sense_id": "7fd82b3b-904e-316a-a526-adbe0120ec56",
                                "text": "Also ein Rechtshänder hat in der Regel – wenn nie etwas gebrochen war, das linke Bein als Standbein und das rechte spielt rum. Ein Linkshänder hat dann entsprechend das rechte Bein als Standbein und das linke spielt."
                            },
                            {
                                "example_id": "f88dacf9-cd70-4546-947f-9ef26116236b",
                                "sense_id": "7fd82b3b-904e-316a-a526-adbe0120ec56",
                                "text": "„14) Der Erste, der das Bein gehoben hält, kehrt aus dem Standbeine mit ½ Drh., ohne daß der Zweite das gehobene Bein sinken läßt, welches sich in seinen Händen halb um seine Längenaxe dreht.“"
                            },
                            {
                                "example_id": "bfd17ce5-c031-47df-9ae4-6680352e0036",
                                "sense_id": "7fd82b3b-904e-316a-a526-adbe0120ec56",
                                "text": "„Er hatte das linke Bein vorgestreckt und benutzte das rechte als Standbein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b9eb1af-2aa4-333a-a74b-48164e9dac82",
                        "entry_id": "6bbbdf85-f120-33a3-a02e-482908affa14",
                        "glosses": [
                            "dasjenige Bein bei Skulpturen, das die Hauptlast des Körpers trägt"
                        ],
                        "tags": [
                            "Bildende Kunst",
                            "Bildhauerei"
                        ],
                        "examples": [
                            {
                                "example_id": "e8c74ed9-e671-40fc-82ba-4b134c6f2b4b",
                                "sense_id": "7b9eb1af-2aa4-333a-a74b-48164e9dac82",
                                "text": "„Auch im übrigen ist die Körperhaltung echt polykletisch; ausser dem Schreitmotiv ist namentlich der lose an der Seite des Standbeins herabhängende Arm mit den unthätig geöffneten Fingern zu beachten; er schliesst sich ganz ebenso dem Umriss des Körpers an wie am Doryphoros, und auch hierin erweisen sich beide Statuen als aus einer gemeinsamen Wurzel entsprossen. Mit dem Standbeine zusammen bildet dieser Arm hier wie dort das Gegengewicht gegen die bewegte andere Seite.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f8877abc-603d-3dd1-8a7b-78c59ebac744",
                        "entry_id": "6bbbdf85-f120-33a3-a02e-482908affa14",
                        "glosses": [
                            "dasjenige Geschäftsfeld eines Unternehmens, das eine fundamentale Einnahmequelle darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5258bbd5-21a2-4b2f-b646-d2105df618bd",
                                "sense_id": "f8877abc-603d-3dd1-8a7b-78c59ebac744",
                                "text": "„Als Politiker, der in vier Jahren abgewählt werden kann, erhalte ich mir ein Standbein außerhalb der Politik: meine Anwaltskanzlei wird von einem Partner solange weitergeführt.“"
                            },
                            {
                                "example_id": "117fe4a4-4ae8-4ff0-a1c1-e9975a86c1f5",
                                "sense_id": "f8877abc-603d-3dd1-8a7b-78c59ebac744",
                                "text": "Viele Bauern begrüßen […] dieses Gesetz, sehen in der Erzeugung von Bioenergie ein zweites Standbein. Sie sind jetzt Land- und Energiewirte […]."
                            },
                            {
                                "example_id": "52b938db-2530-4e85-a7ff-a45e289dc7fd",
                                "sense_id": "f8877abc-603d-3dd1-8a7b-78c59ebac744",
                                "text": "„Eines der wichtigsten finanziellen Standbeine der Miliz dürften aber die Immobilien im Besitz der Geschäftsabteilung BAC der Organisation für Auslandssicherheit der Hisbollah sein.“"
                            },
                            {
                                "example_id": "6b2202d8-7824-4037-92d0-fe9cc382b478",
                                "sense_id": "f8877abc-603d-3dd1-8a7b-78c59ebac744",
                                "text": "„Parallel zum Gewürzexport entwickelte sich der Sklavenhandel mit Arabien und Asien zum lukrativen Standbein der arabischen Oberschicht Sansibars.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
