                ],
                "senses": [
                    {
                        "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                        "entry_id": "d3fa1398-d43d-32e2-8b5d-64259055f752",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e79cd687-9e09-47f3-b523-65a51b4342bf",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Frau Gatzweiler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ea14fb7d-8da4-43da-b1fe-fc154b9c1ccf",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Herr Gatzweiler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c7e55d06-53f3-462c-af1b-f41cf4c2b840",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Die Gatzweilers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d56cecbd-75a2-4a08-9188-188a457a0011",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Der Gatzweiler trägt nie die Schals, die die Gatzweiler ihm strickt."
                            },
                            {
                                "example_id": "18fd3794-270e-418d-a958-16d7be8d4eac",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gatzweiler kommt, geht der Herr Gatzweiler.“"
                            },
                            {
                                "example_id": "070f70c0-afb9-4017-8265-c5c584d48c02",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Gatzweiler kommt und geht."
                            },
                            {
                                "example_id": "69ca61be-254a-4f10-b8ff-002a5e387bc8",
                                "sense_id": "ab3e33e8-2676-3043-95f8-a09f1c562b21",
                                "text": "Gatzweilers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
