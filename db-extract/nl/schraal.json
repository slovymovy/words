                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cea37cb-790d-3e04-a312-a6261433398b",
                        "entry_id": "1e757cf7-6682-3e4a-a63c-735d8c58577e",
                        "glosses": [
                            "armzalig, minimaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0cd36d-193a-4cf0-b741-d9b79203137d",
                                "sense_id": "7cea37cb-790d-3e04-a312-a6261433398b",
                                "text": "Door de droogte was er maar een schrale oogst."
                            },
                            {
                                "example_id": "5e70d120-19da-4a0c-82eb-ee961866eaa4",
                                "sense_id": "7cea37cb-790d-3e04-a312-a6261433398b",
                                "text": "Ik rol een afgebrande lucifer tussen duim en wijsvinger en prik bijwijlen met de geblakerde spits in mijn vlees, een schraal substituut voor het roken. Alles voelt trouwens schraal."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4ec1bfe-3e02-3861-a0c1-364524d1e2c5",
                        "entry_id": "1e757cf7-6682-3e4a-a63c-735d8c58577e",
                        "glosses": [
                            "onaangenaam uitdrogend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ce7326-dc50-4c05-a5ac-942b5c8234a0",
                                "sense_id": "e4ec1bfe-3e02-3861-a0c1-364524d1e2c5",
                                "text": "Hij zocht beschutting van de schrale wind."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e38e83a-69bf-3a29-ab60-afabd31838be",
                        "entry_id": "1e757cf7-6682-3e4a-a63c-735d8c58577e",
                        "glosses": [
                            "uitgedroogd, geïrriteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607926b8-d27a-43fa-9e31-d9bbd95da64f",
                                "sense_id": "6e38e83a-69bf-3a29-ab60-afabd31838be",
                                "text": "Zij smeerde wat balsem op de schrale plekken op haar handen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b672f50-1084-4613-9a92-32277a815984",
                        "source_entry_id": "1e757cf7-6682-3e4a-a63c-735d8c58577e",
                        "source_sense_id": "7cea37cb-790d-3e04-a312-a6261433398b",
                        "source_sense_description": "armzalig, minimaal",
                        "target_lang_word": "miserly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                        "entry_id": "5b32250b-0425-35f0-a3bc-ae329005f30b",
                                        "glosses": [
                                            "Like a miser, very or objectionably cautious with money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885e4d83-d434-4b77-88ba-7d67bb72b96f",
                                                "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                                "text": "It's something that worries me about the book I'm doing about him... In some ways he's just like the racist caricature of the miserly old Jew."
                                            },
                                            {
                                                "example_id": "4838c1c3-2e2e-46bf-884f-19d0a151f36e",
                                                "sense_id": "1231507d-acf7-37cc-aaca-1309ae7e939a",
                                                "text": "What could be more selfish, more miserly—this in specific is what gnaws at him—than dying childless, terminating the line, subtracting oneself from the great work of generation? Worse than miserly, in fact: unnatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
