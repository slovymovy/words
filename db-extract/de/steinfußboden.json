                            {
                                "example_id": "7d244fa0-d318-4a6b-aa9d-0dda7def4489",
                                "sense_id": "543400ee-6c41-36c9-aeb4-e8076491bc54",
                                "text": "„Vielleicht ist es der Steinfußboden, denkt er, oder die Wände – er ist sich nicht sicher.“"
                            },
                            {
                                "example_id": "a2aab083-408a-4e88-bc2a-66953a63a3e2",
                                "sense_id": "543400ee-6c41-36c9-aeb4-e8076491bc54",
                                "text": "„Der kalte Steinfußboden und die Fesseln waren verschwunden, und er lag wieder ruhig in der Dunkelheit.“"
                            }
                        ],
