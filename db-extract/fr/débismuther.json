                        "glosses": [
                            "Faire disparaître le bismuth dans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed5a4b2-1c2c-41d4-809d-7b64a7a68ce3",
                                "sense_id": "2632ae20-2106-3ecd-bd51-1e7c698d7b3f",
                                "text": "Par contre, si le plomb d’œuvre contient du bismuth, il faut le débismuther."
                            },
                            {
                                "example_id": "3fcdbebe-04d1-46b9-9c4f-396e433d992b",
                                "sense_id": "2632ae20-2106-3ecd-bd51-1e7c698d7b3f",
                                "text": "Le plomb débismuthé subit alors différents traitements afin d’éliminer les réactifs résiduels (traitement au chlore gazeux suivi d’un lavage à la soude et/ou aux nitrates)."
                            }
                        ]
                    }
