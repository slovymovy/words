    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2a48ba9-33d6-3a5f-984d-1d2dc8c274da",
                    "sense_definition": "A hard, dense, deep black wood from various tropical trees.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan carved a beautiful statue out of solid <w>ebony</w>.",
                            "target_lang_translations": {
                                "de": "Der Kunsthandwerker schnitzte eine wunderschöne Statue aus massivem <w>Ebenholz</w>."
                            }
                        },
                        {
                            "text": "Fine furniture is often crafted from rare <w>ebony</w> wood.",
                            "target_lang_translations": {
                                "de": "Edle Möbel werden oft aus seltenem <w>Ebenholz</w> gefertigt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solid ebony"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein hartes, dichtes, tiefschwarzes Holz von verschiedenen tropischen Bäumen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ebenholz",
                                "target_lang_sense_clarification": "Bezeichnung für das wertvolle, dunkle Holz."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09b82e80-123b-32e2-a40a-a0300fb3f4ec",
                    "sense_definition": "A deep, dark black colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hair was the <w>ebony</w> of a moonless night.",
                            "target_lang_translations": {
                                "de": "Ihr Haar hatte das <w>Ebenholzschwarz</w> einer mondlosen Nacht."
                            }
                        },
                        {
                            "text": "The artist used a shade of <w>ebony</w> to paint the shadows.",
                            "target_lang_translations": {
                                "de": "Der Künstler verwendete einen <w>Ebenholzton</w>, um die Schatten zu malen."
                            }
