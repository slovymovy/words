{
    "word_family": [
        "collaboration",
        "collaborator",
        "collaborative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b20da343-df9c-3024-b84d-43c1d66e8f13",
                    "sense_definition": "To work together with others to achieve a common goal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two departments decided to <w>collaborate</w> on the new marketing campaign to save costs.",
                            "target_lang_translations": {
                                "ru": "Два отдела решили <w>сотрудничать</w> в рамках новой маркетинговой кампании, чтобы сократить расходы."
                            }
                        },
                        {
                            "text": "It is much easier to <w>collaborate</w> on a project when everyone uses the same software.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>работать вместе</w> над проектом, когда все используют одно и то же программное обеспечение."
                            }
                        }
                    ],
                    "synonyms": [
                        "liaise"
                    ],
                    "common_phrases": [
                        "collaborate on a project",
                        "collaborate with others",
                        "closely collaborate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать вместе с другими для достижения общей цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрудничать",
                                "target_lang_sense_clarification": "совместно заниматься деятельностью"
                            },
                            {
                                "target_lang_word": "взаимодействовать",
                                "target_lang_sense_clarification": "осуществлять совместные действия"
                            },
                            {
                                "target_lang_word": "работать вместе",
                                "target_lang_sense_clarification": "объединять усилия над проектом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214bb980-b933-3caa-af18-a325b509e4c9",
                    "sense_definition": "To voluntarily cooperate treasonably, as with an enemy occupation force in one's country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the war, some citizens chose to <w>collaborate</w> with the enemy to protect their own interests.",
                            "target_lang_translations": {
                                "ru": "Во время войны некоторые граждане предпочли <w>сотрудничать</w> с врагом, чтобы защитить свои собственные интересы."
                            }
                        },
                        {
                            "text": "He was later accused of having <w>collaborated</w> with the occupying forces during the conflict.",
                            "target_lang_translations": {
                                "ru": "Позже его обвинили в том, что он <w>коллаборировал</w> с оккупационными войсками во время конфликта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "collaborate with the enemy",
                        "collaborate with occupying forces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добровольно и предательски сотрудничать с вражескими оккупационными силами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрудничать с врагом",
                                "target_lang_sense_clarification": "в контексте измены или оккупации"
                            },
                            {
                                "target_lang_word": "коллаборировать",
                                "target_lang_sense_clarification": "идти на сделку с оккупантами"
                            },
                            {
                                "target_lang_word": "пособничать",
                                "target_lang_sense_clarification": "оказывать содействие врагу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}