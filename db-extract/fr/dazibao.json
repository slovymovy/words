                    {
                        "sense_id": "8c404055-9c36-3236-a92b-56075dad01af",
                        "entry_id": "e22afc3d-4408-3fb7-9d40-fa82c3224d4f",
                        "glosses": [
                            "Affiche illégale et spontanée qui véhicule l’information non officielle réapparue en Chine, en 1966."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70bd5be0-0da6-4070-8623-087d3308aeeb",
                                "sense_id": "8c404055-9c36-3236-a92b-56075dad01af",
                                "text": "Dans toutes les usines ou universités qui étaient à notre programme, les murs se couvraient, des sols aux plafonds, de dazibaos, grands placards manuscrits, exposés d’amertumes ou de haines qui suintaient la terreur, auxquels personne n’échappait, n’échapperait."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b5c7bea-152d-3540-9746-20cd82072a3c",
                        "entry_id": "e22afc3d-4408-3fb7-9d40-fa82c3224d4f",
                        "glosses": [
                            "Toute publication non officielle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "92a008b6-8d86-4420-bfdd-5444b604fc25",
                                "sense_id": "2b5c7bea-152d-3540-9746-20cd82072a3c",
                                "text": "Entre 1977 et 1978, alors qu’une certaine libéralisation du régime est amorcée après la mort de Mao, les Chinois furent autorisés à critiquer ouvertement le régime, en particulier au moyen de dazibao."
                            }
                        ]
                    }
                ],
