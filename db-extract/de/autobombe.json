                    {
                        "sense_id": "c1e19e07-0cf8-306e-a36a-9d2cc23245b1",
                        "entry_id": "0f610be7-fb91-39d6-a8b8-7b64188d8ce9",
                        "glosses": [
                            "in einem Fahrzeug angebrachter Sprengstoff (Bombe), der ein bestimmtes Ziel – das Fahrzeug eingeschlossen – zerstören oder beschädigen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23f3dd7-9bef-4a58-af68-2dc2406c07d6",
                                "sense_id": "c1e19e07-0cf8-306e-a36a-9d2cc23245b1",
                                "text": "„Autobomben richten sich gegen Einrichtungen und gegen Menschen, häufig werden mit ihnen Terroranschläge auf Zivilisten verübt.“"
                            },
                            {
                                "example_id": "a0d73472-28df-4d70-acb7-1f3096492451",
                                "sense_id": "c1e19e07-0cf8-306e-a36a-9d2cc23245b1",
                                "text": "„Ein Selbstmordattentäter hat zahlreiche Menschen in der Nordwest-Grenzprovinz mit einer Autobombe getötet. Der Anschlag ist eine Reaktion auf eine Offensive der Armee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
