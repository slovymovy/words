    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                "word": "Kashmir",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                        "entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                        "glosses": [
                            "A contested geographic region of South Asia in the northern part of the Indian subcontinent, located between (and de facto divided between) India, Pakistan and China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "265db145-68a0-4ec3-a760-99c471226bff",
                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                "text": "The picturesque Himalayan region of Kashmir is dangerously contested territory, parts of it claimed by India, Pakistan and China. While the three nuclear armed nations have gone to war over territorial disputes over the past seven decades, the rights of Kashmiris and their dreams of self-determination have been systematically sacrificed, like lambs to slaughter for the Muslim festival."
                            },
                            {
                                "example_id": "6898075d-4058-489f-9fbc-97ce220743b0",
                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                "text": "Pakistan has claimed Kashmir since the partition of India in 1947 and the countries have fought two wars over the region, which is also partially claimed by China."
                            },
                            {
                                "example_id": "5d57388a-f3a2-45fa-8260-1dda0fa7429b",
                                "sense_id": "83ea1484-6cc7-394b-b2af-73dab21ee647",
                                "text": "The biggest rivalry in cricket reflects bilateral ties outside the ground, as India and Pakistan have fought several wars since the subcontinent was divided into two nations upon its independence from the British empire in 1947.\nThe two neighboring countries are involved in a territorial dispute over the Kashmir region, and New Delhi has accused Islamabad of sponsoring cross-border terrorism, a charge that the latter denies."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73076fa-7a65-36c8-96f9-8b82fa358eff",
                        "entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                        "glosses": [
                            "An intermontane valley situated between Pir Panjal Range and Himadri."
                        ],
                        "tags": [],
                        "examples": []
                    }
