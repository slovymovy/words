                "senses": [
                    {
                        "sense_id": "c2d430ea-481a-3522-a4f2-1eed41a22d24",
                        "entry_id": "81eb3d05-a453-3bc2-bd68-4831f042c228",
                        "glosses": [
                            "Donner un caractère cruche à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583dfacb-8d24-43a3-ad06-fee527284ccb",
                                "sense_id": "c2d430ea-481a-3522-a4f2-1eed41a22d24",
                                "text": "On rajoute une princesse bien cruche avec son petit pois dans la cervelle et ses frous frous de jupons pour la cruchiser encore un peu !"
                            },
                            {
                                "example_id": "be3b656f-c590-480b-a65b-c80455963bc2",
                                "sense_id": "c2d430ea-481a-3522-a4f2-1eed41a22d24",
                                "text": "Personne ne tente de cruchiser Ségolène Royal, elle le fait très bien toute seule."
                            },
                            {
                                "example_id": "a6a5b977-28cd-40bd-bcfa-b4273043856f",
                                "sense_id": "c2d430ea-481a-3522-a4f2-1eed41a22d24",
                                "text": "Pour passer une journée avec Sachiko, Kaon ou Chikane est-ce que je serais prête à me \"cruchiser\" ?"
                            }
                        ]
                    }
