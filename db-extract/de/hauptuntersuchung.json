                                "target_senses": [
                                    {
                                        "sense_id": "41236304-1101-3b97-b3e6-1faa9833294a",
                                        "entry_id": "4bfce6a2-488a-3dfc-8212-a119f13ea756",
                                        "glosses": [
                                            "Contrôle périodique du bon fonctionnement d’un appareil, d’une installation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe7d96f-96b3-4651-936e-da6f0d91cdbc",
                                                "sense_id": "41236304-1101-3b97-b3e6-1faa9833294a",
                                                "text": "Le contrôle technique des ascenseurs est une obligation légale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29399c2-d871-38cf-ac6e-61eae6f508f3",
                                        "entry_id": "4bfce6a2-488a-3dfc-8212-a119f13ea756",
                                        "glosses": [
                                            "Contrôle technique obligatoire des véhicules automobiles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513812b1-24fe-4651-b3d7-4f89e019b07f",
                                                "sense_id": "d29399c2-d871-38cf-ac6e-61eae6f508f3",
                                                "text": "Un véhicule décatalysé passe-t-il au contrôle technique ?"
                                            },
                                            {
                                                "example_id": "29bd6662-199a-4b18-a519-128fcab4fee1",
                                                "sense_id": "d29399c2-d871-38cf-ac6e-61eae6f508f3",
                                                "text": "Une directive européenne de 2014 impose un contrôle technique des deux-roues, trois-roues et quadricycles à moteur, au nom de la sécurité des conducteurs et de la protection de l’environnement."
                                            },
                                            {
                                                "example_id": "0b50b191-5bef-4f0d-829c-ab4b5467af0b",
                                                "sense_id": "d29399c2-d871-38cf-ac6e-61eae6f508f3",
                                                "text": "Alors même si des voix se sont élevées contre l’obligation de contrôle technique des deux-roues, les membres de Mobilians rappellent que «le contrôle technique est un outil de maintien en l'état d'un parc roulant."
                                            }
                                        ]
                                    }
