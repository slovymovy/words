                        "source_sense_id": "99d32ea3-5349-3c69-9c14-d43072cc730d",
                        "source_sense_description": "Physik: Maßeinheit der Energie",
                        "target_lang_word": "joule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
