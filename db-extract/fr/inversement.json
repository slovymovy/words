                                    {
                                        "sense_id": "4e117f74-9d34-3dbc-bc95-627f2d9f4e14",
                                        "entry_id": "916a9e17-c9de-3aa1-8389-87adcfb31e68",
                                        "glosses": [
                                            "Facing, or across from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d356d2a-9a8d-41d4-aec6-4a612b644f4f",
                                                "sense_id": "4e117f74-9d34-3dbc-bc95-627f2d9f4e14",
                                                "text": "There’s a bus stop opposite the faculty entrance, right on the other side of the road."
                                            },
                                            {
                                                "example_id": "0aaab0a0-407c-46f5-b50f-ddbb685e8a8a",
                                                "sense_id": "4e117f74-9d34-3dbc-bc95-627f2d9f4e14",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street.[…]. He halted opposite the Privy Gardens, and, with his face turned skywards, listened until the sound of the Tower guns smote again on the ear and dispelled his doubts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a3c8704-eeca-3c97-b68c-733606d2afa2",
