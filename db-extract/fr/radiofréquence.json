                        "sense_id": "00277cb9-0069-39ae-b07d-a8764bf055a4",
                        "entry_id": "049a5bf6-734c-3275-8b26-eb898d7798e1",
                        "glosses": [
                            "Élément du spectre électromagnétique compris entre 3 kHz et 300 MHz, permettant la transmission d'ondes radio."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd6b6f7-ea2d-4209-84c1-ed65645ea644",
                                "sense_id": "00277cb9-0069-39ae-b07d-a8764bf055a4",
                                "text": "Avec la radiofréquence (RF), on quitte le monde de la lumière pour celui des ondes électromagnétiques."
                            },
                            {
                                "example_id": "afa1dcf5-1a9c-48b7-ac99-953fd0d6fbea",
                                "sense_id": "00277cb9-0069-39ae-b07d-a8764bf055a4",
                                "text": "Toutefois, d’autres recherches validées par l’OMS et des tests réalisés par les autorités sanitaires dans plusieurs pays, dont Santé Canada, le centre de recherche sur les communications Canada et l’Institut national de santé publique du Québec au Canada concluent pour le moment que la 5G ne représente pas de danger pour la santé humaine, compte tenu des normes nationales et internationales qui limitent l’exposition aux radiofréquences."
                            }
                        ]
                    }
