    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "614eb065-fe15-35c9-89ef-2722a459a72d",
                    "sense_definition": "Aptitude particulière, don naturel ou habileté remarquable dans un domaine artistique, intellectuel ou pratique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aptitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune musicienne a un véritable <w>talent</w> pour jouer du violon."
                        },
                        {
                            "text": "Il faut beaucoup de travail pour développer un <w>talent</w> naturel."
                        }
                    ],
                    "synonyms": [
                        "aptitude",
                        "capacité",
                        "don",
                        "faculté"
                    ],
                    "antonyms": [
                        "incompétence",
                        "maladresse"
                    ],
                    "common_phrases": [
                        "avoir du talent",
                        "homme de talent",
                        "plein de talent"
                    ]
                },
                {
                    "sense_id": "42d06b59-2abe-3b9d-9889-459bda38b9d0",
                    "sense_definition": "Salarié ou groupe de salariés possédant des compétences clés ou un fort potentiel pour une organisation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
