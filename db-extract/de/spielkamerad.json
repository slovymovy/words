                ],
                "senses": [
                    {
                        "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                        "entry_id": "fdcce72e-1a98-3530-8f50-cc8ae4093c99",
                        "glosses": [
                            "Kind, das mit einem anderen Kind häufig zusammen spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8defe90-05fc-41fc-b146-bdcc16a38d9f",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "Der Spielkamerad von ihrem Sohn hatte am Wochenende keine Zeit."
                            },
                            {
                                "example_id": "90b45a0a-ceb2-4ec8-b76c-7fe497bc4ac3",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "„Die vollständige Szene auf der Oinochoe in Berlin […] weist außerdem auf die Anwesenheit eines dritten Spielkameraden hin, der hockend seinem Freund Anweisungen zu geben scheint, um ihn so zu besagtem Stein zu führen.“"
                            },
                            {
                                "example_id": "02b345c9-5f22-40c4-b751-7c56adc9c608",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "„Das Gegenüber ist nicht mehr objekthafter Gegner, sondern Spielkamerad, einer, den ich benötige, um auszudrücken, was in mir ist, und den ich auch im heißesten Gefecht nicht ernsthaft verletzen darf.“"
                            },
                            {
                                "example_id": "a93f2b21-8a43-4972-9612-99dec49006aa",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "„Trotz der neuen väterlichen Beaufsichtigung muß der Junge in einer so angenehmen Umgebung eine glückliche Zeit gehabt haben, denn er hatte keinen Mangel an Spielkameraden aus der Nachbarschaft.“"
                            },
                            {
                                "example_id": "ea874269-ea43-4623-91db-72efe7328aa7",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "„Ich kannte keinen von ihnen, obwohl an jenem Tag ein junger Mann unter ihnen war, in dem ich einen Spielkameraden zu erkennen glaubte.“"
                            },
                            {
                                "example_id": "163d2928-88bd-44bb-bb25-b46c7a044a94",
                                "sense_id": "85c8bdaf-a838-3033-9fa6-0d40c80de5df",
                                "text": "„Die Katze war mein bevorzugter Freund und Spielkamerad. Ich selbst fütterte sie, und wo ich im Hause stand und ging, war sie bei mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
