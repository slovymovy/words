                        "entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                        "glosses": [
                            "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "1fce8642-c18a-4cb3-a125-3994330c154c",
                                "sense_id": "32c4a4de-795c-325a-9da0-ee6ceb89b1cf",
                                "text": "want naar de brieven te oordeelen was de schrijfster eene autrice van den eersten rang, en toch kende hij geen enkel werk uit vrouwelijke pen verdienstelijk genoeg om aan haar te worden toegeschreven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddfd0951-bd1d-496c-b5ca-ff35d096067e",
                        "source_entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                        "source_sense_id": "32c4a4de-795c-325a-9da0-ee6ceb89b1cf",
                        "source_sense_description": "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft",
                        "target_lang_word": "Schriftstellerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftstellerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                        "entry_id": "efb78149-62bc-369e-904d-1f7961cbf1d2",
                                        "glosses": [
                                            "weibliche Person, die schriftliche Werke verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8235201-8e4c-4222-9df7-fcd2c22a4b2b",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "Agatha Christie war eine sehr bekannte Schriftstellerin."
                                            },
                                            {
                                                "example_id": "2ec63e46-2d67-49f6-9b31-5eee1bee7e14",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Die Schriftstellerin Germaine de Staël, die den gesellschaftlichen Rückschritt in ihrem Roman »Delphine« kritisierte, wird des Landes verwiesen und muss ihren literarischen Salon aufgeben.“"
                                            },
                                            {
                                                "example_id": "0c77b3de-771f-4be1-a398-336e56fa8348",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Konsequent hat die Schriftstellerin bei der Publikation des Textes an seiner authentischen Struktur festgehalten, auch bei den Namen.“"
                                            },
                                            {
                                                "example_id": "8fbd00ce-b5a8-4c09-aea8-b702a6febf03",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Nach einer Weile sagt Efe, dass sie immer Schriftstellerin werden wollte.“"
                                            },
                                            {
                                                "example_id": "2f7207e2-cf06-40fc-a5c1-492a94fd5641",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Hella Wuolijoki war eine linke Schriftstellerin und Geschäftsfrau im Holzhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad299376-e8ad-4d3f-ac9e-81eef747ebe2",
                        "source_entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                        "source_sense_id": "32c4a4de-795c-325a-9da0-ee6ceb89b1cf",
                        "source_sense_description": "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft",
                        "target_lang_word": "Autorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                        "entry_id": "25db41c0-bc88-3688-8731-b4b5ec761c73",
                                        "glosses": [
                                            "Verfasserin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d819d28-1089-42fd-b5e1-a1ad744699d5",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "Aha, das ist also die Autorin dieses Machwerks!"
                                            },
                                            {
                                                "example_id": "ea64e94a-afd9-4fbf-8a14-fe2baeeb7a0e",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Sollte man Menschen verurteilen, die ihre Träume ausleben?, fragt die Autorin – und hilft mit vielen praktischen Exkursen zum Thema Höhenbergsteigen.“"
                                            },
                                            {
                                                "example_id": "96c47c14-56b4-4f63-ab83-c43543e6d294",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Die Autorin dieser Erklärung ist eine Dame im Alter von etwa fünfzig Jahren aus einer der besten deutschen Familien.“"
                                            },
                                            {
                                                "example_id": "77bd2e6f-d6d9-4cfa-8b97-0568263a8d4c",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                        "entry_id": "25db41c0-bc88-3688-8731-b4b5ec761c73",
                                        "glosses": [
                                            "Schriftstellerin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15788eba-92c3-48c3-9762-897f5a5cfd6f",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "Sie ist eine berühmte Autorin."
                                            },
                                            {
                                                "example_id": "cfe41796-fb56-4850-8a6f-b9e94a94eafe",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Die Münsterer Autorin Sofie Capasso bringt mit dem Fantasy-Roman „Ozeanaugen“ ihr mittlerweile drittes Buch auf den Markt.“"
                                            },
                                            {
                                                "example_id": "c5fd4de7-7f52-4067-a8bb-6636e1252249",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Ich muss die Autorin kennenlernen.“"
                                            },
                                            {
                                                "example_id": "5460ab54-b851-4e1a-bf23-c93f548993f4",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Doch Jane Austen hat man die atemlose Zeichensetzung und Spontaneität herausredigiert, vielleicht weil ein solcher Eindruck von ihr den stereotypischen Vorstellungen einer sittsamen und zurückhaltenden Autorin widersprochen hätte.“"
                                            },
                                            {
                                                "example_id": "9a40c3be-9adc-4db3-87d7-8152e419402a",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Wer über hiergebliebene Autorinnen und Autoren schreibt, darf die literarische Emigration nicht außer Acht lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01b8c56c-49f4-4334-a647-dc77458cdc63",
                        "source_entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                        "source_sense_id": "32c4a4de-795c-325a-9da0-ee6ceb89b1cf",
                        "source_sense_description": "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft",
                        "target_lang_word": "écrivaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écrivaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc1dd845-3925-3972-8787-4174a1251f4f",
                                        "entry_id": "541c9e99-5b7f-3ef1-af7e-f2807f07a24f",
                                        "glosses": [
                                            "Femme dont l’occupation ou le métier consiste à écrire des ouvrages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175dfc86-bf5b-4626-a898-cbfa8a8c2000",
                                                "sense_id": "fc1dd845-3925-3972-8787-4174a1251f4f",
                                                "text": "Quelques années plus tard, faisant de même avec l’écrivaine et amie Kristien Hemmerechts, anversoise elle aussi, j’eus le sentiment de découvrir une autre ville."
                                            },
                                            {
                                                "example_id": "eff56e63-507c-45e7-811b-2ab95ec8fd6f",
                                                "sense_id": "fc1dd845-3925-3972-8787-4174a1251f4f",
                                                "text": "Ne parlons pas d’« écrivaine », dans lequel on entend « vaine » : beaucoup trouvent ce mot « laid », quoique personne n’ait remarqué « vain » dans écrivain."
                                            },
                                            {
                                                "example_id": "0af1a7cf-3fff-475f-859d-3fd80d820a33",
                                                "sense_id": "fc1dd845-3925-3972-8787-4174a1251f4f",
                                                "text": "Par décret du Président de la République en date du 30 décembre 2017, pris sur le rapport du Premier ministre et des ministres et visé pour son exécution par le grand chancelier de la Légion d’honneur, [est promue ou nommée au grade d’officier] Mme Bona, née Conte (Dominique, Henriette, Marie), écrivaine, membre de l’Académie française."
                                            },
                                            {
                                                "example_id": "8bea8d57-1093-4241-a2b8-dd3934ed52d4",
                                                "sense_id": "fc1dd845-3925-3972-8787-4174a1251f4f",
                                                "text": "Du côté de l’Union des écrivaines et des écrivains québécois, qui compte 58 % de femmes parmi ses 1631 membres, on nous dit que le mot n’a pas encore fait l’objet de débats, mais que les deux, tant «auteure» qu’«autrice», sont également employés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "760186fe-0d11-3822-9d37-a074e89cc543",
                                        "entry_id": "541c9e99-5b7f-3ef1-af7e-f2807f07a24f",
                                        "glosses": [
                                            "Celle dont le métier est d’écrire pour autrui (souvent sous la forme de la locution « écrivaine publique »)."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a209b59d-1426-4c75-852c-8c5b63d26d56",
                                                "sense_id": "760186fe-0d11-3822-9d37-a074e89cc543",
                                                "text": "Installés à Bretteville-sur-Laize (Calvados), Clara Simon et Ludovic Schuver, respectivement écrivaine publique et photographe professionnel, proposent de révolutionner le traditionnel album de photos, chargé d’immortaliser votre mariage, les noces d’or de vos parents ou la communion du petit dernier…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b846be57-1e39-4b3e-98b0-3b46afad76c0",
                        "source_entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                        "source_sense_id": "32c4a4de-795c-325a-9da0-ee6ceb89b1cf",
                        "source_sense_description": "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft",
                        "target_lang_word": "autrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbf48ca-2a99-3cf1-b558-1e10d1d57e50",
                                        "entry_id": "ce4968bd-1bc5-3b49-9207-a5a8dbec0f4f",
                                        "glosses": [
                                            "Celle qui est à l’origine de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64dd0ef7-bbfd-470e-8a47-ea9fa65e0bbf",
                                                "sense_id": "1cbf48ca-2a99-3cf1-b558-1e10d1d57e50",
                                                "text": "Cette situation familiale, prise en compte dans le processus de personnalisation des peines au même titre que la personnalité de l’auteur ou de l’autrice, la gravité et les circonstances de l’infraction, fait que, dans bien des cas, la criminelle n’est pas seule à la barre"
                                            },
                                            {
                                                "example_id": "5fd4e94c-7409-4dc6-98e1-128e910e7c77",
                                                "sense_id": "1cbf48ca-2a99-3cf1-b558-1e10d1d57e50",
                                                "text": "L’autrice présumée de l’attaque a été arrêtée à Seattle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                        "entry_id": "ce4968bd-1bc5-3b49-9207-a5a8dbec0f4f",
                                        "glosses": [
                                            "Femme qui a rédigé un ouvrage de littérature, de science ou d’art. Écrivaine."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11f8ac6-cb86-4072-8d2d-7c934ea745ed",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Au Carouzel de nôtre Roy\nLa jeune Autrice de Torquate\nPiéce charmante et délicate\nA fait, en ſtile net & fin,\nVn Carouzel pour le Daufin",
                                                "translation": "Au carrousel de notre roi\nLa jeune autrice de Torquate\nPièce charmante et délicate\nA fait, en style net et fin,\nUn carrousel pour le dauphin"
                                            },
                                            {
                                                "example_id": "a500a335-7681-4801-8ee2-d485469dc835",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Corrigez le mot dont vous uſez.\nEn fait de bel Eſprit vous parlez en Novice.\nUn Homme eſt un Autheur, une Femme eſt Autrice.\nAppelez-donc Madame Autrice, & non Autheur,\nEt parlons d’autre choſe.",
                                                "translation": "Corrigez le mot dont vous usez.\nEn fait de bel esprit vous parlez en novice.\nUn homme est un auteur, une femme est autrice.\nAppelez-donc Madame autrice, et non auteur,\nEt parlons d’autre chose."
                                            },
                                            {
                                                "example_id": "4bed024a-1f89-44a2-9527-1564c496e4a6",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Si l’on ne dit pas une femme Autrice, c’est qu’une femme qui fait un livre est une femme extraordinaire ; mais il est dans l’ordre qu’une femme aime les spectacles, la poésie, etc. comme il est dans l’ordre qu’elle soit Spectatrice."
                                            },
                                            {
                                                "example_id": "eca4afd7-6b9a-42a6-bb6d-bb844b7fe03e",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Un journal discourait naguère sur authoresse, et, le proscrivant avec raison, le voulait exprimer par auteur. Pourquoi cette réserve, cette peur d’user des forces linguistiques ? Nous avons fait actrice, cantatrice, bienfaitrice, et nous reculons devant autrice, et nous allons chercher le même mot latin grossièrement anglicisé et orné, comme d’un anneau dans le nez, d’un grotesque th. Autant avouer que nous ne savons plus nous servir de notre langue et qu’à force d’apprendre celles des autres peuples nous avons laissé la nôtre vieillir et dessécher."
                                            },
                                            {
                                                "example_id": "e9c48227-ac11-423e-8ebb-cb41d38b4306",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Exemple de vocable de la liste précédente employé par une autrice contemporaine : […]"
                                            },
                                            {
                                                "example_id": "247a6a0f-3fec-47aa-84df-b8325d1017a6",
                                                "sense_id": "f71eb7f4-7c3e-3d08-9be6-aaf6953fab25",
                                                "text": "Parce que le mot sonne clair, affirme sa féminité, s’appuie sur l’histoire et la proximité d’actrice, les Livres du Soir diront, dorénavant, autrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2e5e04-32e5-39f8-a235-02de8efe5161",
                                        "entry_id": "ce4968bd-1bc5-3b49-9207-a5a8dbec0f4f",
                                        "glosses": [
                                            "Génitrice ; ascendante"
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "note": "ce sens n’est plus guère utilisé que sous la forme de la locution « autrice de mes jours »",
                                        "examples": [
                                            {
                                                "example_id": "83ef5b6d-6be9-4642-a8b2-0048b44fd999",
                                                "sense_id": "8a2e5e04-32e5-39f8-a235-02de8efe5161",
                                                "text": "Au commencement de cette lettre l’Autrice de l’Impetrant a taché de capter la bienveillance de ſa belle Sœur, en lui voulant procurer un Docteur pour la guerir de ſon chancre, dont elle eſt morte peu de tems après.",
                                                "translation": "Au commencement de cette lettre l’autrice de l’impétrant a tâché de capter la bienveillance de sa belle-sœur, en lui voulant procurer un docteur pour la guérir de son chancre, dont elle est morte peu de temps après."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
