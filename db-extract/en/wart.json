                                        "entry_id": "9b2cb1bc-56f3-37af-80e0-1dfb8c676b27",
                                        "glosses": [
                                            "výrůstek na povrchu kůže, tvořený buňkami rohoviny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96625c9a-f883-4299-a298-dacf843cd2ae",
                                                "sense_id": "adecd528-381f-31e7-ac63-9105023db168",
                                                "text": "Kvapným krokem, aby nezmeškala, přiběhla i žebračka Cihlářka. Tak se jí bradavice na plné tváři třásla a dech skřípal jí v tom listopadovém vlhku jak provrtaný někde měch."
                                            }
                                        ]
