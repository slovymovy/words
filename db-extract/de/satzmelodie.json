                ],
                "senses": [
                    {
                        "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                        "entry_id": "73cca76d-b9a2-33c8-b595-5966e659e777",
                        "glosses": [
                            "spezifische Tonhöhenkontur eines Satzes oder Satztyps"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "a0106678-e52c-4537-8ee8-56fdb48f14b8",
                                "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                                "text": "„Vom linguistischen Standpunkt aus handelt es sich um den Wortton (wie im Schwedischen) oder um die Satzmelodie bzw. die Intonation.“"
                            },
                            {
                                "example_id": "3a5fcce0-bd9f-4c36-8882-9180f9cb24f4",
                                "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                                "text": "„Für Glück ist Intonation „[i]m engeren Sinn der Stimmtonverlauf (…) unter dem Aspekt der Satzmelodie, d.h. der um die Einflüsse des Tons (…) sowie des Akzents bereinigte Verlauf der Grundfrequenz (…) bzw. der Verlauf der wahrgenommenen Tonhöhe.“"
                            },
                            {
                                "example_id": "6a1d2663-c5e0-4bb9-9035-f87f53e6a08f",
                                "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                                "text": "„Die schwedische Satzmelodie ist speziell; die Sprache wird als singend aufgefasst.“"
                            },
                            {
                                "example_id": "2c14997c-1f6c-451c-9a43-7078757aeee7",
                                "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                                "text": "„So haben wir mit der Satzmelodie den Bereich der distinktiven Merkmale, der superlinearen Phoneme vermutlich schon verlassen.“"
                            },
                            {
                                "example_id": "d3b75ff6-d02c-489d-91ed-31efb07adf79",
                                "sense_id": "22a5e648-1787-39f9-a473-15c7b4e5a1f3",
                                "text": "„Schon die bloße Verschiebung der Satzmelodie kann bewerkstelligen, daß aus einer wirklichen eine bloß rhetorische Frage wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
