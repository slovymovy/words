                "senses": [
                    {
                        "sense_id": "0a70f675-5661-3dde-a491-a78a3c4c589f",
                        "entry_id": "20d1bc26-a1a2-3e13-971e-dede31af7611",
                        "glosses": [
                            "Vermessungsingenieur für bergmännische Anlagen"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "fc47adfb-82db-4c10-9edc-8e4be5c3938a",
                                "sense_id": "0a70f675-5661-3dde-a491-a78a3c4c589f",
                                "text": "„Ehe er aber gemeinsam mit dem Markscheider (ein im Bergwerk tätiger Vermessungsingenieur) Martin Skacel alle notwendigen Unterlagen der Behörde vorlegen kann, muss er die Bevölkerung von diesem Projekt überzeugen und vorhandene Widerstände abbauen.“"
                            },
                            {
                                "example_id": "c2289bbd-12f1-4d4b-a60d-a4faafcda139",
                                "sense_id": "0a70f675-5661-3dde-a491-a78a3c4c589f",
                                "text": "„Nach Angaben der auf Bergrecht spezialisierten Juristen sollen die RAG und ihre Markscheider entgegen gesetzlicher Vorgaben sogenannte Unstetigkeiten an der Erdoberfläche nur unzureichend in offizielle Dokumente eingetragen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
