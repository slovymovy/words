                        ],
                        "form": "broilings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7442562d-84f3-3620-8ddc-7932bbe65062",
                        "entry_id": "06f818a2-7b36-3c57-a42f-ad361f75a870",
                        "glosses": [
                            "A food prepared by broiling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b021b0d3-ee0f-48d7-9251-2b4ae148d3e1",
                                "sense_id": "7442562d-84f3-3620-8ddc-7932bbe65062",
                                "text": "Likewise, when mixed broilings or skewered meats are offered, they can be kept warm or finished on a modest-sized table-top grill."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e97e05c-b008-3330-a120-659877f15d7a",
                        "entry_id": "06f818a2-7b36-3c57-a42f-ad361f75a870",
                        "glosses": [
                            "gerund of broil: the act of broiling."
                        ],
                        "tags": [
                            "form-of",
                            "gerund"
                        ],
                        "examples": [
                            {
                                "example_id": "9d136c17-46de-4259-9dc0-4ab404816834",
                                "sense_id": "5e97e05c-b008-3330-a120-659877f15d7a",
                                "text": "Broiling is but another way of roasting those cuts of meat which have a broad, flat surface such as steaks, chops, or cutlets. And in broiling them the heat must be so intense that the meat surface is quickly seared, the pores sealed and every particle of flavor and rich juices imprisoned."
                            },
                            {
                                "example_id": "715918e9-91a7-4429-ae80-d4ac2e633fb0",
                                "sense_id": "5e97e05c-b008-3330-a120-659877f15d7a",
                                "text": "Broiling is the most perfect way of cooking meat and fish. There are three ways of broiling,—what is known as broiling proper, pan broiling and oven broiling. Broiling proper is to broil directly over the coals; the fire must be hot, clear and free from smoke."
                            }
                        ]
                    }
