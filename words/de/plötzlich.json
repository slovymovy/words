                    ],
                    "target_lang_definitions": {
                        "en": "occurring unexpectedly and without warning; all at once",
                        "ru": "происходящий неожиданно и без предупреждения; сразу, в один момент",
                        "nl": "zonder waarschuwing en onverwacht gebeurend; in één keer",
                        "pl": "dziejący się lub następujący bez uprzedzenia i nieoczekiwanie; nagle, w jednej chwili",
                        "fr": "qui se produit de manière inattendue et sans avertissement préalable ; tout à coup",
                        "it": "in modo inaspettato e senza preavviso; tutt'a un tratto",
                        "cs": "nastávající či probíhající bez varování a neočekávaně; v jednom okamžiku",
                        "tr": "önceden uyarı olmadan ve beklenmedik bir şekilde gerçekleşen; birdenbire, bir anda",
                        "es": "que ocurre de forma inesperada y sin aviso previo; de golpe",
                        "zh": "毫无预警、出乎意料地发生；一下子，忽然"
                    },
