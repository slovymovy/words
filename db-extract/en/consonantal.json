                    {
                        "translation_id": "9a4107fa-8bd1-4616-ba97-b766e3e3c9ba",
                        "source_entry_id": "2a72e98b-808c-3213-9740-92a631ca5ca3",
                        "source_sense_description": "of, relating to, or functioning as a consonant",
                        "target_lang_word": "konsonantisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konsonantisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55a77d16-df5a-3804-b869-60145fe82817",
                                        "entry_id": "d8d15b71-0c88-316d-9959-5583657b380c",
                                        "glosses": [
                                            "aus einem oder mehreren Konsonanten bestehend, nach Art von Konsonanten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "357690b7-7afd-4602-a244-1885c865eec5",
                                                "sense_id": "55a77d16-df5a-3804-b869-60145fe82817",
                                                "text": "„Was shit betrifft, ist dieses Wort möglicherweise drastischer als seine deutsche Entsprechung, und in seiner Einsilbigkeit mit dem kurzen Vokal und dem harten konsonantischen Ausgang ist es wohl auch expressiver und vielleicht schon deshalb schärfer (…).“"
                                            },
                                            {
                                                "example_id": "7b5ceade-da47-4c0f-90c3-b139d7cb2ecb",
                                                "sense_id": "55a77d16-df5a-3804-b869-60145fe82817",
                                                "text": "„Der Stoßton, ein Fast-Kehlkopfverschluss in langvokalischer und stimmhaft konsonantischer Umgebung (…), ist Deutschen weniger von der phonetischen Substanz, sondern eher von der Distribution her fremd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe75d546-9ed9-36db-91bd-ce31cb4dfb3b",
                                        "entry_id": "d8d15b71-0c88-316d-9959-5583657b380c",
                                        "glosses": [
                                            "mit einer Behinderung des Luftstroms beim Sprechen produziert"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913dde0f-78b6-4d58-9564-6ea344dc24c4",
                                                "sense_id": "fe75d546-9ed9-36db-91bd-ce31cb4dfb3b",
                                                "text": "Im Deutschen ist der Hauchlaut [h] der Konsonant, der die konsonantische Eigenschaft in der geringsten Ausprägung aufweist."
                                            },
                                            {
                                                "example_id": "d3e6b263-4c2e-4cac-9172-cf6f96d1454f",
                                                "sense_id": "fe75d546-9ed9-36db-91bd-ce31cb4dfb3b",
                                                "text": "„Innerhalb dieser Hauptklassen stellen die Obstruenten das eine Extrem dar, indem sie als die konsonantischsten Laute gelten, die Vokale als die 'vokalischsten' das andere Extrem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41748ba3-3e16-3110-a7cf-ba0209d6e94d",
                                        "entry_id": "d8d15b71-0c88-316d-9959-5583657b380c",
                                        "glosses": [
                                            "Bezeichnung für eines der distinktiven Merkmale"
                                        ],
                                        "tags": [
                                            "Phonologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ac3d6c-362f-4a05-aec0-89e9fffdae27",
                                                "sense_id": "41748ba3-3e16-3110-a7cf-ba0209d6e94d",
                                                "text": "Alle Konsonanten haben das distinktive Merkmal [+ konsonantisch] und unterscheiden sich dadurch von den Vokalen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
