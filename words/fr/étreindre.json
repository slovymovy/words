{
    "word_family": [
        "étreinte"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22ceef51-d22f-302d-a1cb-81e9fe56d283",
                    "sense_definition": "Serrer étroitement quelqu'un dans ses bras avec tendresse, passion ou émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'avança vers son ami et l'<w>étreignit</w> longuement pour lui dire adieu."
                        },
                        {
                            "text": "Les deux frères s'<w>étreignent</w> avec émotion après de nombreuses années de séparation."
                        }
                    ],
                    "synonyms": [
                        "embrasser",
                        "enlacer"
                    ],
                    "common_phrases": [
                        "étreindre dans ses bras"
                    ]
                },
                {
                    "sense_id": "3a9b7081-7b01-326f-ad41-f16d38d56133",
                    "sense_definition": "En parlant d'un sentiment pénible, oppresser ou saisir violemment l'esprit, le cœur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une angoisse soudaine m'<w>étreignit</w> au moment où j'entendis cette mauvaise nouvelle."
                        },
                        {
                            "text": "Le doute <w>étreint</w> son cœur chaque fois qu'il doit prendre une décision difficile."
                        }
                    ],
                    "synonyms": [
                        "oppresser",
                        "tenailler"
                    ],
                    "antonyms": [
                        "délivrer",
                        "apaiser"
                    ],
                    "common_phrases": [
                        "étreint par l'angoisse",
                        "étreint par le doute"
                    ]
                },
                {
                    "sense_id": "4e661df5-f6e6-313e-acbc-1700192efd30",
                    "sense_definition": "Serrer ou comprimer très fortement un objet ou un corps physique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serpent géant <w>étreignait</w> sa proie afin de l'étouffer complètement."
                        },
                        {
                            "text": "La glace épaisse <w>étreint</w> la coque du bateau immobilisé dans le port polaire."
                        }
                    ],
                    "synonyms": [
                        "enserrer",
                        "serrer"
                    ],
                    "antonyms": [
                        "desserrer",
                        "relâcher"
                    ]
                }
            ]
        }
    ]
}