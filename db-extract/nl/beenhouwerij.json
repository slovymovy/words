                                    {
                                        "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                        "entry_id": "ca33aa90-93df-3a39-b031-d2fc4a8074d5",
                                        "glosses": [
                                            "Betrieb, in dem Fleisch- und Wurstwaren hergestellt und verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867492b4-d4ff-4399-bb84-e5f1f759dc62",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "Fleisch und Wurst kauft man am besten in der Metzgerei."
                                            },
                                            {
                                                "example_id": "27020961-77d2-4164-925a-64cadf43268b",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„In die Metzgerei Blonski auf der anderen Seite des Platzes muss sie auch.“"
                                            },
                                            {
                                                "example_id": "bd56f47f-ddcb-4f58-9971-7f67fcfca5be",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Bisweilen haben es die Deutschen untereinander schwer genug, sich auf ihren Speisekarten richtig zu verständigen und ihre Provinzialismen in Bäckerläden und Metzgereien zu entflechten.“"
                                            },
                                            {
                                                "example_id": "0f589662-5c20-4239-a043-27ca1d2ff4c6",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Er sah aus wie eine hygienische Metzgerei.“"
                                            },
                                            {
                                                "example_id": "3807ef42-37ba-41f3-aff1-3c485e85e254",
                                                "sense_id": "ab045096-7071-308f-8f93-fa6abf853149",
                                                "text": "„Zu jener Zeit besaß ihr Vater ein Lebensmittelgeschäft und eine Metzgerei und war wohlhabend genug, um eine russische Einwanderin namens Anna als Hausmädchen zu beschäftigen, das unter einem Dach mit der Familie wohnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
