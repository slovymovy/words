                ],
                "senses": [
                    {
                        "sense_id": "c1027d52-e67a-33fb-bb83-1fec93727e11",
                        "entry_id": "7876ca4a-04e9-3d32-8cb6-166429524f46",
                        "glosses": [
                            "Besoin, nécessité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1ea5a4-9861-4ef1-b91b-6d4df00b637f",
                                "sense_id": "c1027d52-e67a-33fb-bb83-1fec93727e11",
                                "text": "Comme tirés d’un rêve, nous nous regardons agir et, glacés de constater la dépense vitale que requiert la maintenance de nos réquisits primitifs, nous demandons avec ahurissement ce qu’il en est de l’Art."
                            }
                        ]
                    },
                    {
                        "sense_id": "90fbc45d-2bfc-3a15-bb46-1bd3f49eb8fe",
                        "entry_id": "7876ca4a-04e9-3d32-8cb6-166429524f46",
                        "glosses": [
                            "Obligation, exigence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4c558e-6501-4c5e-a460-026a2d9de2ec",
                                "sense_id": "90fbc45d-2bfc-3a15-bb46-1bd3f49eb8fe",
                                "text": "Ma secrétaire trouva près de chez moi un hôtel répondant aux réquisits de Lew."
                            }
                        ]
                    },
                    {
                        "sense_id": "7755838d-52ed-3110-8131-05e5c9bf6806",
                        "entry_id": "7876ca4a-04e9-3d32-8cb6-166429524f46",
                        "glosses": [
                            "Accessoire de piste pour le cirque."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f75125ed-183d-3ab4-9890-c0b8ca5d1624",
                        "entry_id": "7876ca4a-04e9-3d32-8cb6-166429524f46",
                        "glosses": [
                            "Matériel pour le travail des fauves dans la cage centrale d'un cirque."
                        ],
