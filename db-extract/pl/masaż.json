                                    {
                                        "sense_id": "943a2c7d-3193-329a-9640-a64c02513c9f",
                                        "entry_id": "3422b86f-fab2-383c-af0c-c5d518d5ea74",
                                        "glosses": [
                                            "tření, hnětení a tepání svalů za účelem jejich uvolnění, lepšího prokrvení a rychlejší regenerace"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dace064e-1224-4ef2-86cd-0b9bc2abc42f",
                                                "sense_id": "943a2c7d-3193-329a-9640-a64c02513c9f",
                                                "text": "Při dlouhém sezení u počítače pomůže jednoduchá masáž."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2399a41d-041f-368f-804e-9d6c127b6e56",
                                        "entry_id": "3422b86f-fab2-383c-af0c-c5d518d5ea74",
                                        "glosses": [
                                            "intenzivní přesvědčování"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acad0f8d-ff78-44ba-9be5-c786165099d1",
                                                "sense_id": "2399a41d-041f-368f-804e-9d6c127b6e56",
                                                "text": "V celé velké Číně se snad nenašel nikdo, kdo by nevěděl, že rok 2010 bude zasvěcen světové výstavě. Mediální masáž začala bezprostředně po ukončení pekingské paralympiády v září 2008."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22efda55-ff55-4011-b985-87420e0daec8",
                        "source_entry_id": "ea9012de-0de1-31ce-bbf7-0dad66c79aa5",
                        "source_sense_id": "4561dea3-0715-3722-aceb-98b46087dd81",
                        "target_lang_word": "massage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e089701-26bd-3ac0-9539-5c278eb44860",
                                        "entry_id": "09dc1d30-3c6c-3fbc-a529-7b74b373fcf0",
                                        "glosses": [
                                            "Pétrissage des muscles pour les assouplir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eda0e6a-8ff2-487f-bc78-8bfa938396f8",
                                                "sense_id": "3e089701-26bd-3ac0-9539-5c278eb44860",
                                                "text": "Le massage fut pratiqué de bas en haut en refoulant les liquides ; peu à peu les membres s’assouplirent, l’enfant commença à crier de plus en plus fort, la coloration devint rosée, la respiration était plus forte, les mouvements plus libres."
                                            },
                                            {
                                                "example_id": "041d3edf-4b6f-4eae-88d1-633795c88bb0",
                                                "sense_id": "3e089701-26bd-3ac0-9539-5c278eb44860",
                                                "text": "Ce n’était point une linition douce, une fomentation onctueuse, mais un massage vigoureux, pratiqué à bras raccourcis, et qui rappelait plutôt les éraillures de l’étrille que les caresses de la main."
                                            },
                                            {
                                                "example_id": "d1fc8b71-291e-4913-82ca-d2cc3b6e67ae",
                                                "sense_id": "3e089701-26bd-3ac0-9539-5c278eb44860",
                                                "text": "Son imperméable fripé détonnait avec sa nouvelle élégance : il en fit une boule et la jeta dans la corbeille à papiers. Qu’on le rasât de près, qu’on lui fît un massage facial, et une manucure : il serait d’attaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e648c0bd-95d4-4b13-aaae-443041e277b7",
                        "source_entry_id": "ea9012de-0de1-31ce-bbf7-0dad66c79aa5",
