                        "examples": [
                            {
                                "example_id": "eb2c6cb3-28ce-4f11-9f24-1161652af679",
                                "sense_id": "07c65df3-1971-3a92-b90d-b3d4f73923ff",
                                "text": "I dare say you have never heard of a growlery. It's a funny word, but it is a very useful, helpful sort of a place."
                            },
                            {
                                "example_id": "773e82c2-9ef9-4613-b263-73335b5e9b17",
                                "sense_id": "07c65df3-1971-3a92-b90d-b3d4f73923ff",
                                "text": "Tussy wrote to Lizzy, knowing that Engels would read her the letters in his growlery – as he described his study-sitting room – presided over by the stuffed Right Honourable in his glass case."
                            },
                            {
                                "example_id": "6529ba82-9f6a-4376-bdf3-87bf81c8cc76",
                                "sense_id": "07c65df3-1971-3a92-b90d-b3d4f73923ff",
                                "text": "'Bearing up, I suppose, Teddy said, although I didn't actually see her. We're at war then? 'I'm afraid so. Come into the growlery, Ted, and have a drink with me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8a7b1285-5440-3a82-91f7-7cdef817490b",
                "word": "Growlery",
