                "senses": [
                    {
                        "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                        "entry_id": "6aeccbd6-da73-3e9c-9b46-aec202e100a0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a304525d-c06e-4352-b193-ad68d16d3e44",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Frau Öttle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "098b9f76-1906-4446-b2dd-dfb967085b00",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Herr Öttle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "75c6cd1f-fd40-40f4-b091-fb1284c6715f",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Die Öttles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8233ed57-1c48-48b4-b7be-c45c3f559ff2",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Der Öttle trägt nie die Schals, die die Öttle ihm strickt."
                            },
                            {
                                "example_id": "9b0595fd-766b-4b3a-908d-b88c6a2c00e9",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Öttle kommt, geht der Herr Öttle.“"
                            },
                            {
                                "example_id": "57e7067d-c223-4241-b8ee-23c327bc61f2",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Öttle kommt und geht."
                            },
                            {
                                "example_id": "eb44624d-06c5-4d32-aa26-4f675cafc79c",
                                "sense_id": "974b1deb-3830-3586-9a30-523a915c43ed",
                                "text": "Öttles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
