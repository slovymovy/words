                "senses": [
                    {
                        "sense_id": "4309379a-149c-3942-a812-e2683a290d88",
                        "entry_id": "a32243fd-2098-32b4-86b5-37ac04064e14",
                        "glosses": [
                            "Gruppe von Menschen, die gemeinsam Diebstahl begehen, meist wiederholt und organisiert"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "dab59cb2-1e16-4c4d-be2f-c3c5ec7b758b",
                                "sense_id": "4309379a-149c-3942-a812-e2683a290d88",
                                "text": "Die Polizei stellte nach kurzer Verfolgungsjagd die Diebesbande in ihrem Versteck."
                            },
                            {
                                "example_id": "9f42f25b-c026-473a-9eae-7185e24d623b",
                                "sense_id": "4309379a-149c-3942-a812-e2683a290d88",
                                "text": "In seiner Jugend war der heute so ehrenwerte Bürgermeister Mitglied einer Diebesbande."
                            },
                            {
                                "example_id": "413a8f9b-6ccb-4167-8780-6fc57bd63af0",
                                "sense_id": "4309379a-149c-3942-a812-e2683a290d88",
                                "text": "„Seine [Fagins] Schützlinge bilden eine Diebesbande, die hauptsächlich aus Straßenjungen besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
