                "senses": [
                    {
                        "sense_id": "4c7653ac-bfd8-3edb-9864-a1dfbcaeb056",
                        "entry_id": "53854929-c8c7-32eb-9f0c-3d97db50f13e",
                        "glosses": [
                            "door afkoeling in vaste toestand gekomen; volledig met ijs bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75cecf5-be2e-49df-a065-3913b5cae399",
                                "sense_id": "4c7653ac-bfd8-3edb-9864-a1dfbcaeb056",
                                "text": "De rivier was helemaal bevroren."
                            },
                            {
                                "example_id": "021932bf-7581-4beb-82b5-930d786b62fe",
                                "sense_id": "4c7653ac-bfd8-3edb-9864-a1dfbcaeb056",
                                "text": "Aan de ene kant wilde ik in de late middag zo snel mogelijk de pas over, maar aan de andere kant zou het de volgende ochtend veel veiliger zijn doordat de sneeuw ’s ochtends vroeg nog bevroren zou zijn, waardoor er minder kans op wegglijden was."
                            },
                            {
                                "example_id": "fbf189be-330f-42e2-a21e-b23dcb4ed285",
                                "sense_id": "4c7653ac-bfd8-3edb-9864-a1dfbcaeb056",
                                "text": "De gemeente beschrijft de mammoet als \"de compleetste gemummificeerde mammoetvondst ooit\". Volgens BBC News is het pas de tweede keer dat een bevroren wolharige mammoet is gevonden. Het eerste exemplaar werd in 2007 opgegraven in Siberië. Die vondst was zeker 42.000 jaar oud."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd2f7e8-6612-3cc0-b2ba-1114f3a2a695",
                        "entry_id": "53854929-c8c7-32eb-9f0c-3d97db50f13e",
                        "glosses": [
                            "geblokkeerd, vastgezet, stilgelegd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0aea951c-97e8-482b-b56d-05bc161f1eda",
                                "sense_id": "bdd2f7e8-6612-3cc0-b2ba-1114f3a2a695",
                                "text": "Alle diplomatieke contacten zijn bevroren."
                            },
                            {
                                "example_id": "478aefe8-9840-470c-afaf-975d1ea9c9ab",
                                "sense_id": "bdd2f7e8-6612-3cc0-b2ba-1114f3a2a695",
                                "text": "Een bevroren account, bevroren tegoeden."
                            }
                        ]
                    }
