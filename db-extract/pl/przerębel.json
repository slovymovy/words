                        ]
                    },
                    {
                        "translation_id": "0d3392e6-e300-4aab-ad88-541e55860e33",
                        "source_entry_id": "cca0effb-10ee-3bc7-bc8a-4740fd4fdf3f",
                        "source_sense_id": "7aea47b4-0651-3b21-b695-034f4985e2ad",
                        "target_lang_word": "прорубь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прорубь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed0983a-3fb7-315c-9685-8a1e26fdd1be",
                                        "entry_id": "19ecb5cb-3a63-3de7-978f-4786df39cc04",
                                        "glosses": [
                                            "отверстие, прорубленное во льду замёрзшего водоёма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c5321e-47de-42a7-98c8-9f3844955acf",
                                                "sense_id": "6ed0983a-3fb7-315c-9685-8a1e26fdd1be",
                                                "text": "И угодили сани с седоками и кучером ― прямо в весеннюю прорубь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d20e5c2-f9f0-4505-9e0f-337757ae1452",
