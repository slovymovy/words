                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8ee8d89-0a9f-49a1-987c-f62fb11e94ae",
                        "source_entry_id": "085aef5f-474b-3912-a5e7-91e5e5dbfbd6",
                        "source_sense_id": "8e48d7f8-6ce2-343b-8c1f-a51535c34a23",
                        "source_sense_description": "wetenschap die taal als onderzoeksobject heeft",
                        "target_lang_word": "Linguistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linguistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                        "entry_id": "6a7979d9-c3af-36cf-b931-09b3f5ae0f7a",
                                        "glosses": [
                                            "wissenschaftliche Forschung/Disziplin, deren Ziel und Aufgabe in der Beschreibung und Erklärung der menschlichen Sprache, ihrer inneren Zusammenhänge, ihrer Funktion und Rolle in der Gesellschaft liegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9e3720-8e8c-402a-8e9b-2f6aa28c7531",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "Die Linguistik dient der Erforschung der menschlichen Sprache."
                                            },
                                            {
                                                "example_id": "d5dc5b3a-4d1d-45cb-9865-ac206aac0992",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "Die Linguistik ist dem Linguisten Beruf und/oder Berufung."
                                            },
                                            {
                                                "example_id": "f28c8a7b-3c13-4a65-be48-dcf6e8ff1d90",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "„Die Linguistik hat eine Bringschuld und eine Verantwortung der Sprachgemeinschaft gegenüber, deren Sprache sie erforscht.“"
                                            },
                                            {
                                                "example_id": "81128c94-a2d7-434c-b85f-4c9685153e47",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "„Bis 1960 war Noam Chomskys Herrschaft in der Linguistik so absolut geworden, dass andere Sprachforscher nur noch dazu dienten, Lücken zu füllen und ihn mit Fußnoten zu versorgen.“"
                                            },
                                            {
                                                "example_id": "a19550d8-e4da-4b3c-b422-4dd53fff44a0",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "„Dies um so mehr, als auch die Linguistik heute eine ihrer wichtigsten Aufgaben darin sieht, durch Einsicht in die Strukturen und Funktionen der einzelnen Sprachen zum Verständnis der Sprache als menschliches Kommunikationsmittel vorzudringen.“"
                                            },
                                            {
                                                "example_id": "10b3830f-db16-4b84-b341-4c72ab89d827",
                                                "sense_id": "a2a90172-63ff-3d03-93fb-6b45388b75be",
                                                "text": "„Auf Wunsch ihres Verlobten Marc hat dessen Freund Percy, Privatdozent für Linguistik am selben Seminar, ihr eine Stelle in der Abteilung Neuere Deutsche Literatur vermittelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72488b3c-42fc-4452-895f-57fa8d5026d0",
                        "source_entry_id": "085aef5f-474b-3912-a5e7-91e5e5dbfbd6",
                        "source_sense_id": "8e48d7f8-6ce2-343b-8c1f-a51535c34a23",
                        "source_sense_description": "wetenschap die taal als onderzoeksobject heeft",
                        "target_lang_word": "linguistics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguistics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ff6e19-4206-3189-ace0-e79fc9a1854f",
                                        "entry_id": "35a549aa-b845-32db-95bd-060659391a75",
                                        "glosses": [
                                            "The systematic and scholarly study of language."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c5061a-1e6e-4475-8bd4-35508c6040e9",
                                                "sense_id": "16ff6e19-4206-3189-ace0-e79fc9a1854f",
                                                "text": "to study linguistics"
                                            },
                                            {
                                                "example_id": "d89a5587-87ed-4f83-bc8b-e1e6df0d3ff2",
                                                "sense_id": "16ff6e19-4206-3189-ace0-e79fc9a1854f",
                                                "text": "a branch of linguistics"
                                            },
                                            {
                                                "example_id": "0cb7831c-d15c-4b08-a59b-754ff2c605bd",
                                                "sense_id": "16ff6e19-4206-3189-ace0-e79fc9a1854f",
                                                "text": "By the end of the century, the APS’s membership included the leaders of the American anthropological establishment, whose primary investigative interests were the ethnography, linguistics, archeology, and physical anthropology of the American Indian, within a theoretical structure that was essentially historical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fcea0ac-2b7b-45a6-b784-15407797cd57",
                        "source_entry_id": "085aef5f-474b-3912-a5e7-91e5e5dbfbd6",
                        "source_sense_id": "8e48d7f8-6ce2-343b-8c1f-a51535c34a23",
                        "source_sense_description": "wetenschap die taal als onderzoeksobject heeft",
                        "target_lang_word": "linguistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                        "entry_id": "446ac11a-79d2-3921-a8c4-f905fc29b1ee",
                                        "glosses": [
                                            "Qui se rapporte au langage, à la langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7b26a6-a80e-4b2d-b6e8-9636c76e6757",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "De nos jours, on commet une erreur plus grave : on confond la race avec la nation, et l’on attribue à des groupes ethnographiques ou plutôt linguistiques une souveraineté analogue à celle des peuples réellement existants."
                                            },
                                            {
                                                "example_id": "fcf67e30-b0a0-4565-b074-51c0647f789f",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "À ce point de vue le peuplement d’une partie de l’Amérique par les Malayo-Polynésiens est démontré par des preuves anthropologiques, ethnologiques et surtout linguistiques absolument indéniables."
                                            },
                                            {
                                                "example_id": "3cd79115-d9d9-4a05-9b0b-24471adadb1d",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Ce que l’on retient surtout de ces évolutions, en dehors des enjeux linguistiques (suprématie de l’anglais dans le numérique) et économiques (apparition de nouveaux acteurs dans l’édition issus de l’informatique), c’est que désormais les livres et leur contenu sont déclinables et personnalisables en fonction des choix du lecteur."
                                            },
                                            {
                                                "example_id": "68265ca9-f35e-4e8a-83f1-68879badfb31",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Le gouvernement belge dirigé par Yves Leterme a décidé jeudi de présenter sa démission suite à un conflit linguistique entre francophones et Flamands, alors que le pays doit prendre dans deux mois la présidence tournante de l’UE."
                                            },
                                            {
                                                "example_id": "ced6a409-26bf-4a97-821c-f81354db72c4",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "Les consonnes subissent dans les langues celtiques divers traitements linguistiques dont la lénition interne. Ainsi les noms Péron, Pédron, Pezdron et Pezron sont tous des variantes d’un nom latin initial Petronem. Hormis le premier nom, les autres sont des archaïsmes."
                                            },
                                            {
                                                "example_id": "411e4d1a-64dd-4abb-954d-9edd1096740d",
                                                "sense_id": "15a93934-297a-39ce-9f6a-d96387ef7e60",
                                                "text": "S’il s’agit de changements linguistiques, ceux-ci sont inarrêtables et ce n’est pas utile, d’autant plus que leur première réaction sera d’être à contre-courant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "linguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                        "entry_id": "416f981f-0c0c-32be-9f3a-498481fca3ce",
                                        "glosses": [
                                            "Science qui étudie le langage humain, l’organisation des différentes langues, la grammaire générale appliquée aux diverses langues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c361064-8d4c-4cbe-a224-29bb166c2f32",
                                                "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                                "text": "Des entraves, ils en ont créé des centaines, maniant à tout va les outils de la récurrence, de la géométrie, de la linguistique, plus récemment de l’informatique."
                                            },
                                            {
                                                "example_id": "a6c428bb-bd42-49d7-8169-71b4d126c009",
                                                "sense_id": "cbf12ec5-8333-35d3-ae21-9aebe9750222",
                                                "text": "Il se spécialise en linguistique à l'université de Leipzig (1895-1896) et, de retour à Groningue, rédige un travail universitaire sous la direction du sanskriste Speiger, Le Vidûsaka dans le théâtre indien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4103a634-6253-4d84-9aad-9bf1133a5bcc",
                        "source_entry_id": "085aef5f-474b-3912-a5e7-91e5e5dbfbd6",
