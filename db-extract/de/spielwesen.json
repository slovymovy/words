                ],
                "senses": [
                    {
                        "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                        "entry_id": "57773f15-b16d-31ed-a267-8ac6e3f7658a",
                        "glosses": [
                            "Charakterisierung eines menschlichen oder tierischen Individuums nach der Bedeutung des Spiels für sein Leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1083e650-e0d8-49b9-b523-c0398b8b2a6f",
                                "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                                "text": "„Allerdings führt in der ersten Hälfte des 20. Jahrhunderts der Weg zurück zu einer holistischeren Perspektive, die in der ersten kulturwissenschaftlich-anthropologischen Bestimmung des Menschen als Spielwesen von Johan Huizinga […] kulminiert.“"
                            },
                            {
                                "example_id": "2a3fc564-6efb-4675-bef6-42f6c750b3c1",
                                "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                                "text": "„Der Mensch ist das bedeutendste Lernwesen und das anspruchsvollste Spielwesen.“"
                            },
                            {
                                "example_id": "945b45d4-7e74-4227-9c96-a9f3b013a713",
                                "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                                "text": "„Der junge Mensch ist noch arm an höherer geistiger Leistungsfähigkeit, er ist weitgehend ein triebbestimmtes Spielwesen.“"
                            },
                            {
                                "example_id": "104f8e56-7161-4c30-a8c8-30bed7c4acb4",
                                "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                                "text": "„Und wir sind Spielwesen, nicht erst seit der niederländische Kulturhistotiker Johan Huizinga […] den Ausdruck Homo ludens als Titel seiner bekannten kulturanthropologischen Monografie ins Spiel brachte.“"
                            },
                            {
                                "example_id": "26370be3-46c6-4454-8178-4efb27009c2d",
                                "sense_id": "47f25ca8-08ff-3322-8095-b9a95a0d3785",
                                "text": "„Auch höhere Tierarten können spielen, aber das Spielwesen reinster Prägung ist der Mensch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                        "entry_id": "57773f15-b16d-31ed-a267-8ac6e3f7658a",
                        "glosses": [
                            "Gesamtheit aller das Spiel und das Spielen betreffenden Gegebenheiten wie Aktivitäten, Einrichtungen, Initiativen, Regelungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a9d43e-5b1d-48a3-b794-cf3c52d328d5",
                                "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                                "text": "„Geht man denn auß der Mittag Predigt/ so ist alles frey/ und wird das meiste Spielwesen von männiglich ohne Scheu/ auf den Sonntag und an anderen Feyrtagen verricht/ welche H. Tag wir doch gäntzlich mit Anhörung deß Göttlichen Worts/ mit lesen/ betten/ singen/ und anderen H. Wercken zu Gottes Ehre zubringen solten.“"
                            },
                            {
                                "example_id": "22ab2016-e441-4489-ad32-63a6e51f707d",
                                "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                                "text": "„Wie Thales Milesius, einer aus den sieben Weisen in Griechen-Land/ der auf dem Theatro oder Spiel-Plan gesessen/ und dem Spielwesen zugesehen/ und unter dem Zusehen plötzlich gestorben.“"
                            },
                            {
                                "example_id": "1b57541c-97f2-48e9-bff2-c376e6744eaf",
                                "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                                "text": "„Diese wiederum übergab den Fall an die zuständige, Spielwesen und Spiellust überwachende Körperschaft, die auch für die Vergabe von Lizenzen zur Aufstellung von einarmigen Banditen zuständig ist.“"
                            },
                            {
                                "example_id": "b9c05267-749c-47fc-8c07-f9a917a4d404",
                                "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                                "text": "„In den Viten von Vespasian und Domitian wird das Spielwesen ebenfalls sehr knapp dargestellt, aber bei ihnen ist es trotzdem möglich, sich ein Bild zu machen.“"
                            },
                            {
                                "example_id": "3c9d6256-0076-4108-b514-b4366171eb6a",
                                "sense_id": "4542012a-3ab3-37ca-a1fa-838d40b848c0",
                                "text": "„Auch die Ausbildung einer Aufsicht des Senats über das öffentliche Spielwesen war ein Ergebnis jener bedeutsamen Einigung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
