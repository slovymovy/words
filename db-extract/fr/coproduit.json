                        "glosses": [
                            "Produit annexe d’un processus industriel, dont la fabrication n'est pas directement recherchée, mais qui est valorisé économiquement."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
