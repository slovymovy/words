                        "glosses": [
                            "Personnalité pathologique se manifestant essentiellement par des comportements antisociaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4613558b-4574-4b3e-aef3-a8e9a7ce09a6",
                                "sense_id": "718a8176-eb34-35d9-a163-05c6a516ea3f",
                                "text": "Notion difficile à cerner, la psychopathie cherche sa place dans la nosographie psychiatrique, un peu comme le psychopathe cherche sa place dans l’existence."
                            }
                        ]
                    }
                ],
