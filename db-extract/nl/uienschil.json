                        "glosses": [
                            "een van de buitenste lagen van een ui die meestal niet gegeten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c50d3d2-1cd5-4441-9b8d-4145d4a7593c",
                                "sense_id": "4d636333-24d3-34a4-96bd-5ad706f978b3",
                                "text": "Voor de soepkeuken rijdt een schillenkar elke ochtend door het winkelcentrum. Van onder andere botten, visgraten en -koppen en uienschillen wordt bouillon getrokken. Resten rijst, brood en pasta zijn voor de kippen op het dak."
                            },
                            {
                                "example_id": "86e2acea-e433-414c-88c1-0fd09dfdc182",
                                "sense_id": "4d636333-24d3-34a4-96bd-5ad706f978b3",
                                "text": "Azize maakt in een fabriek uien schoon en hakt die in stukjes. Bij het schoonmaken van de machine aan het eind van de werkdag blijft één uienschil in de machine vastzitten. Azize probeert die met haar hand te verwijderen. Juist op dat moment komt de machine onverwacht weer op gang. De vingers van Azize worden in de machine getrokken. Ze schreeuwt het uit."
                            }
                        ]
                    }
