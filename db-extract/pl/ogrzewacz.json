                ],
                "senses": [
                    {
                        "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                        "entry_id": "929ce5df-0bae-304b-bf8a-1a177ec30876",
                        "glosses": [
                            "to, co ogrzewa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36058699-61d7-4a95-be5b-b4cdaa87850a",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "Wielki piec wytwarza oprócz surówki wielkie ilości żużla, a poza tym gazy, które, jako palne, chwytamy, opalając nimi ogrzewacze powietrza"
                            },
                            {
                                "example_id": "3d2d0a93-973c-4b0a-971d-308d611eb8a5",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "Tak pomyślał Retlich i przyłożył do brzucha elektryczny ogrzewacz, bo znowu nagle chwyciły go boleści"
                            },
                            {
                                "example_id": "65deddc7-d51d-4841-acb4-61474dd23ea6",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "zbudował w r. 1869 małą maszynę parową, której jedynym ogrzewaczem było słońce"
                            },
                            {
                                "example_id": "13191c5a-fee2-40c8-8d77-c8b7acd50044",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "Ze wstępnych ustaleń strażaków wynika, że zabójczy czad wydobywał się z przepływowego ogrzewacza wody, który zainstalowany był w łazience"
                            },
                            {
                                "example_id": "d862797f-92f0-47e1-8c0a-c8b6c7e269e6",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "W okresie jesienno-zimowym często włączamy gazowe ogrzewacze powietrza, ale i one — źle użytkowane — mogą stać się przyczyną tragedii"
                            },
                            {
                                "example_id": "3ddacd30-fe6f-4789-a78e-4cd5a58264a7",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "Na mroźną zimę przyda się jednorazowy ogrzewacz do rąk"
                            },
                            {
                                "example_id": "12a74c07-de14-44f2-b23d-4277b4444436",
                                "sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                                "text": "Butla gazowa umieszczona jest wewnątrz obudowy ogrzewacza, dzięki czemu nie zajmuje miejsca i nie szpeci pomieszczenia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1830dcdb-4607-4930-98cc-65df18cb925c",
                        "source_entry_id": "929ce5df-0bae-304b-bf8a-1a177ec30876",
                        "source_sense_id": "ec5f90a1-3489-392a-92b4-6011da21b78d",
                        "target_lang_word": "heater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08df293e-e8f9-3204-bb70-708d2eb52c68",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A device that produces and radiates heat, typically to raise the temperature of a room or building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5462d58-f90d-4b13-b356-1523ed27985e",
                                                "sense_id": "08df293e-e8f9-3204-bb70-708d2eb52c68",
                                                "text": "Turn on the heater; I'm cold."
                                            },
                                            {
                                                "example_id": "e28b3d99-b2b3-4341-8576-10d608ad5e6d",
                                                "sense_id": "08df293e-e8f9-3204-bb70-708d2eb52c68",
                                                "text": "“First you've got to sit up and go into the tackroom, because you are soaking wet. And shivering.” […] The tackroom was cold, so Sam turned on the kerosene heater and found a wool cooler and wrapped her in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b02e79-aa0d-37e5-8253-2c92df4e2b63",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A person who heats something, for example in metalworking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64b4e77a-01b9-372b-bf4a-7e2e1d75a4a7",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A gun."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3fbf411-427b-46b8-870c-b318819699fc",
                                                "sense_id": "64b4e77a-01b9-372b-bf4a-7e2e1d75a4a7",
                                                "text": "The thug pumped two rounds from his heater into her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "329eaf1a-2679-3df9-97f9-30ae4c2a68c3",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A fastball, especially one thrown at high velocity."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da54b753-356f-4f2f-b519-9b845356a2b7",
                                                "sense_id": "329eaf1a-2679-3df9-97f9-30ae4c2a68c3",
                                                "text": "Jones threw a heater under his chin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd7bae8-b5d8-3e83-a9ba-e2e99ccf5275",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "An extended winning streak."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "870c4e2f-b128-4cf2-8def-57622d57aa6a",
                                                "sense_id": "9dd7bae8-b5d8-3e83-a9ba-e2e99ccf5275",
                                                "text": "Emmy went on a heater in Las Vegas and came back six thousand dollars richer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e7b11a-41eb-31e6-9b01-12f48aef2ec8",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A medieval European shield having a rounded triangle shape like a clothes iron."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a98314-aa65-415e-9fe1-f35880ed80bb",
                                                "sense_id": "35e7b11a-41eb-31e6-9b01-12f48aef2ec8",
                                                "text": "It can be assumed that as the earlier kite shield transformed into the heater shape, there must have been versions in between the two styles. Indeed, in artwork of the Medieval period, shields are rarely present after 1450 and even then are quite small. The development of flattop heaters from larger kite shields is likely the result of increased fighting on horseback and the use of improved armor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1540c029-7a97-33c7-a077-a14225154805",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
                                        "glosses": [
                                            "A dead heat; a race in which two or more competitors reach the finish line simultaneously."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cba2128-618f-3077-a374-2d5cf23e79e0",
                                        "entry_id": "30a8b1d2-da88-3702-aefb-1633ea4bc702",
