                        "entry_id": "e362b514-35f6-37ac-94d0-f95b768376cf",
                        "glosses": [
                            "een laagte tussen bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fbaacd-5601-4661-baeb-4b80ff14da85",
                                "sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                                "text": "In bergachtige gebieden wonen de meeste mensen in een vallei.'"
                            },
                            {
                                "example_id": "d61e6af0-4d93-4e93-aeb8-e2ae5eb5f1ed",
                                "sense_id": "c474b64b-46b1-36d3-bbe2-4e799e553586",
                                "text": "Het pad slingerde langs rotsige heuvels en uitgestrekte valleien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
