    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d131797-c3c3-3807-81ee-a5a141696c9d",
                    "sense_definition": "An illustration or artwork done with the use of paint.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Mona Lisa is one of the most famous <w>paintings</w> in the world.",
                            "target_lang_translations": {
                                "ru": "Мона Лиза — одна из самых известных <w>картин</w> в мире.",
                                "zh": "《蒙娜丽莎》是世界上最著名的<w>画</w>之一。"
                            }
                        },
                        {
                            "text": "I bought a colorful oil <w>painting</w> to hang in the living room.",
                            "target_lang_translations": {
                                "ru": "Я купил красочную <w>картину</w> маслом, чтобы повесить её в гостиной.",
                                "zh": "我买了一幅色彩鲜艳的<w>油画</w>挂在客厅里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oil painting",
                        "abstract painting",
                        "landscape painting",
                        "wall painting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иллюстрация или произведение искусства, выполненное красками.",
                        "zh": "用颜料创作的艺术作品或图画。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "произведение живописи"
                            },
                            {
                                "target_lang_word": "полотно",
                                "target_lang_sense_clarification": "художественное произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画",
                                "target_lang_sense_clarification": "艺术作品"
                            },
                            {
                                "target_lang_word": "油画",
                                "target_lang_sense_clarification": "特指油画作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77cbe2ad-a0c3-30fd-b518-cc04671993ac",
                    "sense_definition": "The activity or skill of creating art using paint.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some artists, like Michelangelo, excel in both <w>painting</w> and sculpture.",
                            "target_lang_translations": {
                                "ru": "Некоторые художники, как Микеланджело, преуспевают как в <w>живописи</w>, так и в скульптуре.",
                                "zh": "像米开朗基罗这样的一些艺术家，在<w>绘画</w>和雕塑方面都很擅长。"
                            }
                        },
                        {
                            "text": "She has been studying <w>painting</w> at the art academy for three years.",
                            "target_lang_translations": {
                                "ru": "Она изучает <w>живопись</w> в художественной академии уже три года.",
                                "zh": "她在艺术学院学习<w>绘画</w>已经三年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "art",
                        "fine art"
                    ],
                    "common_phrases": [
                        "painting class",
                        "painting technique",
                        "portrait painting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или искусство создания художественных произведений красками.",
                        "zh": "使用颜料进行艺术创作的活动或技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живопись",
                                "target_lang_sense_clarification": "вид изобразительного искусства"
                            },
                            {
                                "target_lang_word": "рисование",
                                "target_lang_sense_clarification": "процесс создания изображения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绘画",
                                "target_lang_sense_clarification": "艺术创作活动"
                            },
                            {
                                "target_lang_word": "油画",
                                "target_lang_sense_clarification": "作为学科或技法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e706aeea-7fa7-3d24-a6de-81ac226eb9df",
                    "sense_definition": "The action of applying paint to a surface, often for maintenance or decoration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outside of the old house would benefit from some <w>painting</w>.",
                            "target_lang_translations": {
                                "ru": "Фасаду старого дома не помешала бы <w>покраска</w>.",
                                "zh": "这座老房子的外墙如果能重新<w>粉刷</w>一下会更好。"
                            }
                        },
                        {
                            "text": "Proper <w>painting</w> requires cleaning and preparing the walls first.",
                            "target_lang_translations": {
                                "ru": "Качественная <w>покраска</w> требует предварительной очистки и подготовки стен.",
                                "zh": "正确的<w>粉刷</w>需要先清洁并处理墙面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "house painting",
                        "spray painting",
                        "face painting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанесение краски на поверхность, часто для ремонта или декорирования.",
                        "zh": "在物体表面涂抹颜料的行为，通常用于维护或装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покраска",
                                "target_lang_sense_clarification": "процесс нанесения краски"
                            },
                            {
                                "target_lang_word": "окрашивание",
                                "target_lang_sense_clarification": "действие по изменению цвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粉刷",
                                "target_lang_sense_clarification": "用于墙壁或建筑表面"
                            },
                            {
                                "target_lang_word": "涂漆",
                                "target_lang_sense_clarification": "用于物体表面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d1bac7e-8afd-3e6b-82ef-0329dca8e13e",
