                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f36d67e0-17f4-43c5-a56a-901fccdb209b",
                                                "sense_id": "97e8f8c5-d479-3308-917d-1c32d8547079",
                                                "text": "Het gratis concert werd door duizenden mensen bezocht."
                                            },
                                            {
                                                "example_id": "63233e2d-a896-40ec-b68a-931500070ebc",
                                                "sense_id": "97e8f8c5-d479-3308-917d-1c32d8547079",
                                                "text": "'Monsieur Point was erg goed in marketing. In die tijd lieten veel mensen zich vervoeren door een chauffeur. Hij beloofde de chauffeurs een gratis maaltijd als ze hun baas naar zijn restaurant zouden brengen', zegt Henriroux."
                                            },
                                            {
                                                "example_id": "27c38e14-d05a-4e5d-9d9d-763ddc82ae5a",
                                                "sense_id": "97e8f8c5-d479-3308-917d-1c32d8547079",
                                                "text": "Er stond in elk hostel en postkantoor langs de trail altijd een hiker box waaruit je gratis dingen kon meenemen die andere hikers hadden achtergelaten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
