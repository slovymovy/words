                ],
                "senses": [
                    {
                        "sense_id": "ba340bdc-39ef-3310-a834-a17c1b524ca7",
                        "entry_id": "3619fbbc-9f87-35c6-9423-0664efebf38c",
                        "glosses": [
                            "Téter pour le plaisir, sans être motivé par la soif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942efac3-1454-4b9c-86f0-03c522e940c2",
                                "sense_id": "ba340bdc-39ef-3310-a834-a17c1b524ca7",
                                "text": "Et donc, tu restes assis dans ton coin, pendant toutes ces sombres soirées d’hiver, à têtouiller ton litron et à pleurnicher sur ta propre solitude, n’est-ce pas ?"
                            },
                            {
                                "example_id": "d864d904-43c0-4484-8b8f-b842a25ce56f",
                                "sense_id": "ba340bdc-39ef-3310-a834-a17c1b524ca7",
                                "text": "Tu envoies quotidiennement la « photo du jour », montrant ton bébé en train de dormir, en train de manger, ou en train de têtouiller ton téton."
                            },
                            {
                                "example_id": "e551dfc4-6dcf-4e9f-b144-a15644743305",
                                "sense_id": "ba340bdc-39ef-3310-a834-a17c1b524ca7",
                                "text": "Elle adore venir s'installer sur mes genoux, se nicher dans le creux de mon bras, pour pattouner et têtouiller en ronronnant bien fort."
                            }
                        ]
                    }
                ],
