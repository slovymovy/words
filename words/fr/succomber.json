{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5fb1924-44c3-322b-85c2-3ac02933ad52",
                    "sense_definition": "Céder, ne plus être capable de résister à une force morale, une fatigue ou une tentation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "defaite_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré toutes ses bonnes résolutions, il a fini par <w>succomber</w> à la tentation de manger ce dessert."
                        },
                        {
                            "text": "Épuisée par une longue journée de marche, elle a craint de <w>succomber</w> à la fatigue."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "capituler",
                        "fléchir"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "succomber à la tentation",
                        "succomber au charme"
                    ]
                },
                {
                    "sense_id": "efa287cd-a2b4-30ed-8bad-12819a0a47f0",
                    "sense_definition": "Mourir, cesser de vivre sous le coup d'une maladie, d'une blessure ou d'une rude épreuve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Transporté d'urgence à l'hôpital, le motard a malheureusement fini par <w>succomber</w> à ses blessures."
                        },
                        {
                            "text": "Le patient a lutté avec courage avant de <w>succomber</w> à cette infection foudroyante."
                        }
                    ],
                    "synonyms": [
                        "mourir",
                        "périr",
                        "trépasser"
                    ],
                    "antonyms": [
                        "survivre"
                    ],
                    "common_phrases": [
                        "succomber à ses blessures",
                        "succomber à la maladie"
                    ]
                },
                {
                    "sense_id": "aca3b153-e4bf-3c43-ba87-bc78a93ffd2f",
                    "sense_definition": "S'affaisser, plier ou s'écrouler sous l'effort d'une charge matérielle excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ecrasement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux plancher en bois menaçait de <w>succomber</w> sous le poids des meubles empilés."
                        },
                        {
                            "text": "Le cheval de trait semblait prêt à <w>succomber</w> sous un fardeau bien trop lourd pour lui."
                        }
                    ],
                    "synonyms": [
                        "s'affaisser",
                        "crouler",
                        "plier"
                    ],
                    "antonyms": [
                        "supporter",
                        "soutenir"
                    ],
                    "common_phrases": [
                        "succomber sous le poids",
                        "succomber sous le faix"
                    ]
                },
                {
                    "sense_id": "50f2f927-bed5-37b8-ac16-2eb2de522ff8",
                    "sense_definition": "Être vaincu, échouer ou perdre l'avantage dans une lutte ou une compétition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defaite_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une résistance acharnée, l'armée a fini par <w>succomber</w> face au grand nombre d'ennemis."
                        },
                        {
                            "text": "Plusieurs candidats ont fini par <w>succomber</w> lors de cette redoutable épreuve éliminatoire."
                        }
                    ],
                    "synonyms": [
                        "échouer",
                        "perdre"
                    ],
                    "antonyms": [
                        "triompher",
                        "vaincre"
                    ],
                    "common_phrases": [
                        "succomber à la tâche"
                    ]
                }
            ]
        }
    ]
}