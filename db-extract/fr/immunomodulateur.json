                        "glosses": [
                            "Synonyme de immunomodulant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a550203-8ead-4d27-b0cb-b52049436b1e",
                                "sense_id": "bb0fd9a4-6323-3979-a0df-c08423f45580",
                                "text": "Il s’agit d’un immunomodulateur mais son mécanisme diffère de celui des interférons."
                            },
                            {
                                "example_id": "2abc9ae4-95ca-457f-85bf-5940103b0199",
                                "sense_id": "bb0fd9a4-6323-3979-a0df-c08423f45580",
                                "text": "Pour les lésions qui couvrent de grandes surfaces, on a recours à des immunomodulateurs sous forme de crèmes topiques — comme imiquimod (nom commercial Aldara) —, qui stimulent le système immunitaire."
                            }
                        ]
                    }
