    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81f5a500-7f81-3527-b8d1-294b7f6a4d65",
                    "sense_definition": "Performance on a test or other evaluation, expressed by a number, letter, or other symbol; a score.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got a good <w>grade</w> on the test.",
                            "target_lang_translations": {
                                "ru": "Он получил хорошую <w>оценку</w> за тест."
                            }
                        },
                        {
                            "text": "You need a passing <w>grade</w> of at least 80% in calculus to be admitted to the program.",
                            "target_lang_translations": {
                                "ru": "Вам нужен проходной <w>балл</w> не менее 80% по математическому анализу, чтобы быть зачисленным на программу."
                            }
                        }
                    ],
                    "synonyms": [
                        "mark"
                    ],
                    "common_phrases": [
                        "passing grade",
                        "final grade",
                        "good grade",
                        "letter grade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат выполнения теста или другой оценки, выраженный числом, буквой или другим символом; балл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оце́нка",
                                "target_lang_sense_clarification": "отметка в учебном заведении"
                            },
                            {
                                "target_lang_word": "отме́тка",
                                "target_lang_sense_clarification": "условное обозначение знаний"
                            },
                            {
                                "target_lang_word": "балл",
                                "target_lang_sense_clarification": "цифровая оценка успеваемости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "178fd5b4-acfa-33ed-819b-1cf085e834fc",
                    "sense_definition": "A level of primary and secondary education.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clancy is entering the fifth <w>grade</w> this year.",
                            "target_lang_translations": {
                                "ru": "Клэнси в этом году идет в пятый <w>класс</w>."
                            }
                        },
                        {
                            "text": "Most children start first <w>grade</w> when they are six years old.",
                            "target_lang_translations": {
                                "ru": "Большинство детей идут в первый <w>класс</w> в возрасте шести лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "first grade",
                        "fifth grade",
                        "grade school"
                    ],
                    "target_lang_definitions": {
