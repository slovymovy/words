            "senses": [
                {
                    "sense_id": "e8b5cfa8-83d8-389e-bfd9-3d98278a54a5",
                    "sense_definition": "A diplomatic mission, especially one ranking lower than an embassy, or the official staff serving it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatic_mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before full embassies became the standard, smaller nations often maintained a <w>legation</w> abroad."
                        },
                        {
                            "text": "Members of the foreign <w>legation</w> gathered to review the new diplomatic terms."
                        }
                    ],
                    "synonyms": [
                        "embassy",
                        "mission"
                    ],
                    "common_phrases": [
                        "diplomatic legation",
                        "foreign legation"
                    ]
                },
                {
                    "sense_id": "b03da98a-36df-3e29-b7f2-6e1a747d095c",
                    "sense_definition": "The official residence or headquarters of a diplomatic envoy or minister.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatic_mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Protesters gathered outside the gates of the <w>legation</w> to demand the release of prisoners."
                        },
                        {
                            "text": "The minister hosted an evening reception at the <w>legation</w> for visiting dignitaries."
                        }
                    ],
                    "common_phrases": [
                        "legation building",
                        "legation quarter"
                    ]
                },
                {
                    "sense_id": "fb9122ec-a5c2-3877-9aa8-f84f6ec313f4",
                    "sense_definition": "The official post, title, or office held by a legate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "office_or_mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cardinal was appointed to the papal <w>legation</w> to oversee ecclesiastical matters."
                        },
                        {
                            "text": "His years of service in the <w>legation</w> earned him high respect within the church hierarchy."
                        }
                    ],
                    "synonyms": [
                        "legateship"
                    ],
                    "common_phrases": [
                        "papal legation"
                    ]
                },
                {
                    "sense_id": "7ba2768e-960d-3388-be4c-10ee0aec2f90",
                    "sense_definition": "The specific purpose, mission, or commission for which an envoy or legate is dispatched.",
