                        "glosses": [
                            "manier waarop men direct belanghebbenden betrekt bij de besluitvorming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6051b3bf-39cd-4165-bf40-e2721a3485a5",
                                "sense_id": "78beab2c-e96d-3b56-853c-2d7e644f385e",
                                "text": "De verordening verstaat onder: a. inspraak: het betrekken van ingezetenen en belanghebbenden bij de voorbereiding van gemeentelijk beleid; b. inspraakprocedure: de wijze waarop de inspraak gestalte wordt gegeven; c. beleidsvoornemen: het voornemen van het bestuursorgaan tot het vaststellen of wijzigen van beleid."
                            },
                            {
                                "example_id": "aebe6ecd-75a4-4bb4-9a08-81d1bacfe706",
                                "sense_id": "78beab2c-e96d-3b56-853c-2d7e644f385e",
                                "text": "Eindhoven geeft daarmee gehoor aan de oproep van staatssecretaris Teeven om zoveel mogelijk mensen op te vangen. De gemeente zegt dat een inspraakprocedure niet verplicht is en dat snel behoefte was aan extra opvangplekken."
                            },
                            {
                                "example_id": "03d5fe86-55c7-462f-881d-d713a6be2dab",
                                "sense_id": "78beab2c-e96d-3b56-853c-2d7e644f385e",
                                "text": "De inspraakprocedure voor het milieuonderzoek naar de winning van schaliegas is begonnen. Minister Kamp stuurde vandaag zijn voorstel voor de onderzoeken naar de mogelijkheden voor schaliegas naar de Kamer."
                            }
                        ]
                    }
