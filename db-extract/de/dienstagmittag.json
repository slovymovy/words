                                                "sense_id": "3915c46a-e153-3884-bdc7-b45c24061412",
                                                "text": "We hebben die hele dinsdagmiddag in het ziekenhuis doorgebracht."
                                            },
                                            {
                                                "example_id": "b591d24a-8d9d-409d-9232-2bdcaf535601",
                                                "sense_id": "3915c46a-e153-3884-bdc7-b45c24061412",
                                                "text": "Door snel ingrijpen van de brandweer is een grote bosbrand in het Almelose Nijreesbos dinsdagmiddag voorkomen."
                                            }
                                        ]
