                "senses": [
                    {
                        "sense_id": "4083c1de-5ea7-377c-890c-15226e1ac73d",
                        "entry_id": "b3ac4675-46fb-33d8-a67f-ac7059a26673",
                        "glosses": [
                            "Entscheidung, die maßgeblich das künftige Leben bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "282a8534-fbb2-463e-84d0-579df5b62646",
                                "sense_id": "4083c1de-5ea7-377c-890c-15226e1ac73d",
                                "text": "„Ich habe mich damals ein für allemal verbindlich für die Ehelosigkeit entschieden, und Lebensentscheidungen sollte man nicht ändern!“"
                            },
                            {
                                "example_id": "60a42052-d874-4285-a7ad-78350d2fe71f",
                                "sense_id": "4083c1de-5ea7-377c-890c-15226e1ac73d",
                                "text": "„Der Verkauf eines Familienunternehmens ist nach unseren Erfahrungen immer eine Lebensentscheidung.“"
                            },
                            {
                                "example_id": "dcd42a8f-f1b7-43db-b294-16e310821d59",
                                "sense_id": "4083c1de-5ea7-377c-890c-15226e1ac73d",
                                "text": "„Wir finden dieses vor allem bei der Lebensentscheidung vor, wie sie zuerst von der christlichen Religion vom Menschen verlangt wurde.“"
                            },
                            {
                                "example_id": "7d056ba0-29ca-4b58-be36-0bed956cbea2",
                                "sense_id": "4083c1de-5ea7-377c-890c-15226e1ac73d",
                                "text": "„Für Priester sollte die gewählte Lebensform Ausdruck einer Lebensentscheidung sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
