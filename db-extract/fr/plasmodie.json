                        "glosses": [
                            "Parasite du genre Plasmodium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b53feb0-0aa0-40dc-aa14-3f07a0bedcc7",
                                "sense_id": "628c4335-4129-3994-91bd-aca1e0616394",
                                "text": "Les opérations froides nous donnent donc, avant l’accès, ces deux résultats : elles favorisent la destruction des globules rouges qui ont précédemment servi d’habitat à la plasmodie, elles facilitent l’élimination des déchets provenant du parasite et des hématies, en augmentant les oxydations et les excrétions et en empêchant la rétention du calorique."
                            },
                            {
                                "example_id": "a5e9d822-0948-4905-9572-2393fcdee4ad",
                                "sense_id": "628c4335-4129-3994-91bd-aca1e0616394",
                                "text": "Les plasmodies changent sans cesse d'aspect et de taille, par suite de l'alternance de phases de croissance et de phases de division (nucléaire et cytoplasmique)."
                            }
                        ]
                    }
