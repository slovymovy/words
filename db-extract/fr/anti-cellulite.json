                        "glosses": [
                            "Qui lutte contre la cellulite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fafb2d6-dd2c-4b76-9e45-45d4e81c573f",
                                "sense_id": "d53e37d0-072c-33ae-bb32-e1ef38f22765",
                                "text": "23 pots de crème pour le corps, le visage, les mains, les pieds, spéciale contour des yeux, spéciale cuticules, anti-cellulite, amincissante, repulpante, à l’acide hyaluronique, aux tenseurs actifs."
                            },
                            {
                                "example_id": "87c3d620-6570-43e4-b7c6-09847a39f2ed",
                                "sense_id": "d53e37d0-072c-33ae-bb32-e1ef38f22765",
                                "text": "Les bons plans anti-cellulite des paresseuses"
                            },
                            {
                                "example_id": "09dacbf1-d637-4d61-b900-77e598564d26",
                                "sense_id": "d53e37d0-072c-33ae-bb32-e1ef38f22765",
                                "text": "Même si vous êtes jeune, le régime anti-cellulite est assez proche de celui que nous avons appelé « anti-coup de vieux » (p. 180) et conseillé aux plus de cinquante-cinq ans."
                            }
                        ]
