                                "sense_id": "acb737d7-17da-33bc-a348-f1249750f411",
                                "text": "Wir werden für dieses Projekt unser Commitment geben."
                            },
                            {
                                "example_id": "938c6377-a7f3-44da-a0c4-a4da12898037",
                                "sense_id": "acb737d7-17da-33bc-a348-f1249750f411",
                                "text": "\"Der Vorstand der ThyssenKrupp AG hat für die Bereiche Korruption und Kartellrecht das folgende ThyssenKrupp Compliance Commitment abgegeben, das seine Einstellung zur Einhaltung der entsprechenden Gesetze und Richtlinien im Konzern unmissverständlich zum Ausdruck bringt: …\""
                            }
                        ],
                        "sense_index_json": "\"2\""
