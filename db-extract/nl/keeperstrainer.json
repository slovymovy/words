                        "examples": [
                            {
                                "example_id": "0bcc3bdf-8afc-4b94-b3e2-64213fed2dab",
                                "sense_id": "12c078b4-efd8-3723-ba54-c07a7078d6b5",
                                "text": "De keeperstrainer van Bart Verbruggen bij Brighton & Hove Albion, Jack Stern, wacht vanavond een moeilijke avond. Hij hoopt natuurlijk dat zijn vaderland doorgaat, maar hij wenst Verbruggen ook een topwedstrijd toe."
                            },
                            {
                                "example_id": "11571132-fb32-4ce1-a871-0c71d0741479",
                                "sense_id": "12c078b4-efd8-3723-ba54-c07a7078d6b5",
                                "text": "Rein van Duijnhoven is al een leven lang doelman. Namens Helmond Sport, MVV en bij Bochum in de Duitse Bundesliga keepte hij ruim vijfhonderd duels in het betaald voetbal. En zoals het een keeper betaamt, rolde hij daarna automatisch in het vak van keeperstrainer. Alweer zeventien jaar geleden."
                            }
                        ]
                    }
