    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "760678b0-9fbf-3797-9a28-1b39aa0c4bea",
                    "sense_definition": "op een eenvoudige en knusse manier gezellig, vaak met een ondertoon van kleinschaligheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezelligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We brachten een <w>kneuterig</w> avondje door met bordspelletjes en warme chocolademelk bij de open haard.",
                            "target_lang_translations": {
                                "en": "We spent a <w>cozy</w> little evening with board games and hot chocolate by the fireplace."
                            }
                        },
                        {
                            "text": "Het vakantiehuisje was een beetje <w>kneuterig</w> ingericht met oude meubels en gebloemde gordijnen.",
                            "target_lang_translations": {
                                "en": "The holiday cottage was furnished in a slightly <w>quaint</w> way with old furniture and floral curtains."
                            }
                        }
                    ],
                    "synonyms": [
                        "gezellig",
                        "gezapig"
                    ],
                    "antonyms": [
                        "grootschalig",
                        "modern",
                        "kil"
                    ],
                    "common_phrases": [
                        "kneuterig avondje",
                        "lekker kneuterig"
                    ],
                    "target_lang_definitions": {
                        "en": "Cozy and pleasant in a simple, small-scale way, often with a touch of old-fashioned charm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cozy",
                                "target_lang_sense_clarification": "warm and comfortable"
                            },
                            {
                                "target_lang_word": "homely",
                                "target_lang_sense_clarification": "simple and comfortable in a domestic way"
                            },
                            {
                                "target_lang_word": "quaint",
                                "target_lang_sense_clarification": "attractively unusual or old-fashioned"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc0b791-0dbd-3024-8293-1116a997472f",
                    "sense_definition": "beperkt van opvatting of visie; burgerlijk en weinig uitdagend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bekrompenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige mensen vinden het leven in een klein dorp veel te <w>kneuterig</w> en benauwend.",
                            "target_lang_translations": {
                                "en": "Some people find life in a small village far too <w>parochial</w> and stifling."
                            }
                        },
                        {
                            "text": "Zijn <w>kneuterige</w> instelling weerhield hem ervan om grote risico's te nemen in zijn carrière.",
                            "target_lang_translations": {
                                "en": "His <w>narrow-minded</w> attitude prevented him from taking big risks in his career."
                            }
                        }
                    ],
                    "synonyms": [
                        "burgerlijk",
                        "kleinburgerlijk",
                        "burgermannetjesachtig",
                        "bourgeois"
                    ],
                    "antonyms": [
                        "werelds",
                        "ruimdenkend",
                        "progressief"
                    ],
                    "common_phrases": [
                        "kneuterige instelling",
                        "kneuterige mentaliteit"
                    ],
                    "target_lang_definitions": {
                        "en": "Limited in outlook or vision; provincial, bourgeois, and lacking challenge or ambition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parochial",
                                "target_lang_sense_clarification": "having a limited or narrow outlook"
                            },
                            {
                                "target_lang_word": "stuffy",
                                "target_lang_sense_clarification": "conventional and narrow-minded"
                            },
                            {
                                "target_lang_word": "provincial",
                                "target_lang_sense_clarification": "unsophisticated or narrow-minded"
                            },
                            {
                                "target_lang_word": "small-town",
                                "target_lang_sense_clarification": "limited in scope or spirit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "524fda03-1799-3158-a39f-8c21eb9c70c4",
                    "sense_definition": "op een knusse, eenvoudige of ietwat burgerlijke wijze",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gezelligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze zaten <w>kneuterig</w> samen op de bank naar een oude film te kijken.",
                            "target_lang_translations": {
                                "en": "They sat <w>cozily</w> together on the couch watching an old movie."
                            }
                        },
                        {
                            "text": "De kamer was <w>kneuterig</w> gedecoreerd met allerlei kleine snuisterijen en kaarsjes.",
                            "target_lang_translations": {
                                "en": "The room was <w>homely</w> decorated with all sorts of small trinkets and candles."
                            }
