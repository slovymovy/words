                ],
                "senses": [
                    {
                        "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                        "entry_id": "b6c4679a-c9f8-3802-b0d2-5a046d66291e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6077a7fe-c743-4fb0-8895-aefd29a3c4a6",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Frau Heffele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "321feddb-c580-4790-a5bb-37852d5d14c5",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Herr Heffele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "251b5851-4570-4db0-9750-28893c494c2e",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Die Heffeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "131fcaf5-5f47-4c61-b09d-1b6474945695",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Der Heffele trägt nie die Schals, die die Heffele ihm strickt."
                            },
                            {
                                "example_id": "a6e12f6b-bfab-423e-beb5-6a64e005a53a",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heffele kommt, geht der Herr Heffele.“"
                            },
                            {
                                "example_id": "d960a7dc-8d82-48d3-a878-0b74313fcbde",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Heffele kommt und geht."
                            },
                            {
                                "example_id": "14212ace-1ba5-4224-984d-a3e51e807a52",
                                "sense_id": "bcd48ee5-fc37-351b-8bc9-ed15d1c7a13f",
                                "text": "Heffeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
