                    {
                        "translation_id": "1ee236c6-3e7b-42e6-b6c8-0427e67b285b",
                        "source_entry_id": "c49f21ab-1660-32a6-9037-66f0e313356c",
                        "source_sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                        "source_sense_description": "een Scandinavisch land in Noord-Europa",
                        "target_lang_word": "Dänemark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dänemark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                        "entry_id": "b56008b7-2813-37b2-b686-790ec8034948",
                                        "glosses": [
                                            "Staat mit 5,7 Mio. Einwohnern; einschließlich Grönland und Färöer das Königreich Dänemark, nur das dänische Kernland in Nordeuropa"
                                        ],
                                        "tags": [
                                            "aber auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad7fb526-55d7-4b19-9a01-6f93a1360d34",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "Der höchste Punkt Dänemarks erreicht gerade 173 Meter."
                                            },
                                            {
                                                "example_id": "a69596a8-1898-44ee-9022-bd84f54245fd",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "Kopenhagen ist die Hauptstadt von Dänemark."
                                            },
                                            {
                                                "example_id": "cca3b165-b9d7-4f94-8df2-41628c1dc4ab",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Das Dänemark des 9. Jahrhunderts ist geprägt von den Wikingern, die einen Eroberungsfeldzug in Richtung England unternehmen.“"
                                            },
                                            {
                                                "example_id": "bdf84429-441d-4046-a08a-5d55ee56ea2d",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Wer aktuell nach Dänemark ein- oder ausreisen möchte, muss gelegentlich mit Wartezeiten an den Grenzübergängen rechnen.“"
                                            },
                                            {
                                                "example_id": "703801a2-3620-4e47-8c9a-20bf6afdef39",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Hier wird Dänemark zum erstenmal als Land genannt. TANMARKAR lautet das Runenwort.“"
                                            },
                                            {
                                                "example_id": "69977dde-0e3c-406a-8912-40a979c61692",
                                                "sense_id": "8a3d5eaa-2329-3bc7-9f0a-b1c6ac59a16c",
                                                "text": "„Island und Grönland haben eines gemeinsam: Beide waren Kolonien Dänemarks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffc1c097-7966-4638-a44e-f914b1b8cb65",
