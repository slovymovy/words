                "senses": [
                    {
                        "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                        "entry_id": "22a9b38a-e300-3116-ac0c-b0b575efaf25",
                        "glosses": [
                            "das Ordnungssystem der verschiedenen Pflanzengesellschaften nach abgestufter floristischer Ähnlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1be5d5-50ef-40ff-be7d-28fa785bd5ba",
                                "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                                "text": "Die Synsystematik bietet ein System der Gliederung von Pflanzengesellschaften."
                            },
                            {
                                "example_id": "e7dbe2a0-dfd5-4f73-91d5-d6544a19e9ef",
                                "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                                "text": "„In der Syntaxonomie (Synsystematik) wird die Ordnung der Pflanzengesellschaften vorwiegend nach der abgestuften floristischen Ähnlichkeit durchgeführt.“"
                            },
                            {
                                "example_id": "12ae0d51-727b-4146-9be1-3ef87b0283d9",
                                "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                                "text": "„Eine Darstellung zur geschichtlichen Entwicklung der Syntaxonomie und der Synsystematik der Buchenwälder Mitteleuropas geben Jahn (1980), Dierschke (1985a, 1989a), Härdtle (1995a) und Möseler (1998) “"
                            },
                            {
                                "example_id": "008d3fb6-d5ec-4e97-a12d-0067f7d2985a",
                                "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                                "text": "„Nomenklatur und Synsystematik: Die wissenschaftlichen Pflanzennamen der Gefäßpflanzen richten sich nach Oberdorfer (1983b) […] Die Angaben zur Synsystematik und zum soziologischen Verhalten der Arten (in den Vegetationstabellen) folgen in der Regel Oberdorfer (1977) […]"
                            },
                            {
                                "example_id": "422d3f8d-59f0-44e8-a3bd-09442e43ba66",
                                "sense_id": "a4a00c02-1f0b-304d-9b74-9bb2e16c3f64",
                                "text": "„Die Assoziationen bilden die Grundeinheiten der pflanzensoziologischen Systematik (Synsystematik).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
