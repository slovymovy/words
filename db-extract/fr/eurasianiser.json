                "senses": [
                    {
                        "sense_id": "5de871a9-107d-31d7-aef0-54ecf153ac16",
                        "entry_id": "aca3654b-8dde-313e-9266-c2280509ac94",
                        "glosses": [
                            "Donner un caractère eurasien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d982e9fc-8364-4cf0-a748-9caf118b0360",
                                "sense_id": "5de871a9-107d-31d7-aef0-54ecf153ac16",
                                "text": "Nous pourrions dire très justement qu'aujourd'hui l'Europe aussi en arrive à s'« eurasianiser » elle-même – qu’une fois de plus prend de l’importance la dimension universelle de la doctrine eurasiste."
                            },
                            {
                                "example_id": "8d04d844-c76d-46e6-9771-9c02b8d57272",
                                "sense_id": "5de871a9-107d-31d7-aef0-54ecf153ac16",
                                "text": "La première se continentalise et s'eurasianise tandis que la seconde s’atlantise et s’occidentalise et ces deux tendances sont totalement contradictoires, il faut bien en être conscient."
                            }
                        ]
                    }
