{
    "word_family": [
        "title",
        "titulate",
        "titulation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54d0c9ff-fd3e-3c03-97e2-5fed6c1f4bc4",
                    "sense_definition": "Named or referred to in the title of a work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "title_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>titular</w> character appears in every scene of the movie.",
                            "target_lang_translations": {
                                "zh": "这部电影的<w>同名</w>角色在每一幕中都有出现。"
                            }
                        },
                        {
                            "text": "The <w>titular</w> hero faces many challenges throughout the novel.",
                            "target_lang_translations": {
                                "zh": "小说中的<w>同名</w>主人公在整个故事中面临着许多挑战。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "titular character",
                        "titular hero"
                    ],
                    "target_lang_definitions": {
                        "zh": "指作品标题中提到的角色或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同名",
                                "target_lang_sense_clarification": "指与作品标题名称相同的角色或事物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85fc6ef7-a0ea-3979-9d6e-a86fa294ab87",
                    "sense_definition": "Existing in name only without actual power or authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was merely a <w>titular</w> head of state with no real power.",
                            "target_lang_translations": {
                                "zh": "国王只是一个<w>有名无实</w>的国家元首，没有任何实权。"
                            }
                        },
                        {
                            "text": "He held a <w>titular</w> position but made none of the important decisions.",
                            "target_lang_translations": {
                                "zh": "他担任了一个<w>挂名</w>职位，但从未做出过任何重要决策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nominal"
                    ],
                    "common_phrases": [
                        "titular head",
                        "titular leader"
                    ],
                    "target_lang_definitions": {
                        "zh": "有名无实的；仅有头衔而无实权的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有名无实",
                                "target_lang_sense_clarification": "形容只有名义，没有实际权力或内容。"
                            },
                            {
                                "target_lang_word": "挂名",
                                "target_lang_sense_clarification": "指仅挂个名义，不担任实际职务。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b5003da-dd96-34d9-abe2-72a8bc07af0f",
                    "sense_definition": "Relating to or derived from a title.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "title_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>titular</w> duties were clearly defined in the ancient contract.",
                            "target_lang_translations": {
                                "zh": "古老的合同中明确规定了这些<w>头衔的</w>职责。"
                            }
                        },
                        {
                            "text": "She accepted the <w>titular</w> honor with great humility.",
                            "target_lang_translations": {
                                "zh": "她非常谦逊地接受了这份<w>头衔的</w>荣誉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "titular duties",
                        "titular honor"
                    ],
                    "target_lang_definitions": {
                        "zh": "与头衔有关的或源于头衔的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "头衔的",
                                "target_lang_sense_clarification": "与特定职位或荣誉称号相关的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4a3c18c-ed22-3544-befa-585ea5cd9ebf",
                    "sense_definition": "A person who holds a title.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>titular</w> attended the ceremony to receive his formal recognition.",
                            "target_lang_translations": {
                                "zh": "这位<w>受封者</w>出席了仪式以接受正式表彰。"
                            }
                        },
                        {
                            "text": "Many <w>titulars</w> gathered at the palace for the annual meeting.",
                            "target_lang_translations": {
                                "zh": "许多<w>受封者</w>聚集在宫殿参加年度会议。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "拥有头衔的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "受封者",
                                "target_lang_sense_clarification": "指被授予特定头衔或爵位的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "597a1559-6a61-31fc-bcc4-51d8deb93d4e",
                    "sense_definition": "The person or saint from whom a church takes its specific name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Saint Peter is the <w>titular</w> of the famous cathedral in Rome.",
                            "target_lang_translations": {
                                "zh": "圣彼得是罗马那座著名大教堂的<w>主保圣人</w>。"
                            }
                        },
                        {
                            "text": "The local church honors its <w>titular</w> every year on the feast day.",
                            "target_lang_translations": {
                                "zh": "当地教堂每年在瞻礼日都会纪念其<w>主保圣人</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "教堂所供奉的圣徒或以此命名的守护者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "主保圣人",
                                "target_lang_sense_clarification": "指教堂或机构所供奉的守护圣徒。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}