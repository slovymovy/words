                    "frequency": "Middle",
                    "semantic_group_id": "wisselwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wetenschappers bestuderen de <w>interactie</w> tussen verschillende chemische stoffen in het laboratorium.",
                            "target_lang_translations": {
