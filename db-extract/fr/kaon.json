                ],
                "senses": [
                    {
                        "sense_id": "3417c613-ddc7-3bd0-80f4-90d3a61c6fa1",
                        "entry_id": "7c825668-99dd-34eb-b893-34efddac0db4",
                        "glosses": [
                            "Particule de la famille des mésons, composé d’un quark et d’un antiquark."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "bd43656c-f7bb-4470-90ae-bae97924012f",
                                "sense_id": "3417c613-ddc7-3bd0-80f4-90d3a61c6fa1",
                                "text": "Il existe quatre sortes de kaons, en fonction de la charge : le kaon positif, le kaon neutre, le kaon négatif, l’antikaon neutre."
                            },
                            {
                                "example_id": "fa912228-0116-427f-b309-be618462e45a",
                                "sense_id": "3417c613-ddc7-3bd0-80f4-90d3a61c6fa1",
                                "text": "Pourquoi de si grosses machines pour déceler de si petites particules, aux noms pour moi enchanteurs — électrons, muons, neutrinos, quarks, fermions, pions, bosons, hypérons ou kaons ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c628219d-0fd8-4cf5-bb50-e58480d92fd1",
                        "source_entry_id": "7c825668-99dd-34eb-b893-34efddac0db4",
                        "source_sense_id": "3417c613-ddc7-3bd0-80f4-90d3a61c6fa1",
                        "target_lang_word": "Kaon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70f181c9-83ff-32be-aeb7-975a4a348693",
                                        "entry_id": "531b93ed-ecfd-3871-b9eb-9ac34464b414",
                                        "glosses": [
                                            "Elementarteilchen, das den Mesonen zugeordnet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
