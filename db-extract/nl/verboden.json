                        ],
                        "examples": [
                            {
                                "example_id": "8ad831ff-28b5-433c-bf75-512e733400f4",
                                "sense_id": "0658f526-b282-3df4-997d-cf2d7b7a6b3d",
                                "text": "Wij verboden."
                            },
                            {
                                "example_id": "a9281928-756c-43f3-bfef-afabd29b1783",
                                "sense_id": "0658f526-b282-3df4-997d-cf2d7b7a6b3d",
                                "text": "Jullie verboden."
                            },
                            {
                                "example_id": "01238ccf-0d46-427b-87ab-4cc8bc270c38",
                                "sense_id": "0658f526-b282-3df4-997d-cf2d7b7a6b3d",
                                "text": "Zij verboden."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d4bc575-e7a6-3587-972a-6da8923828ad",
                        "entry_id": "9e3bf856-2b26-3e34-b863-e3ef4822c01f",
                        "glosses": [
                            "voltooid deelwoord van verbieden"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a82cfbc3-e5be-4b33-8dad-2fadc3e928a6",
                                "sense_id": "4d4bc575-e7a6-3587-972a-6da8923828ad",
                                "text": "Maar dit gevoel duurde niet lang want na een kort praatje schreef hij opeens een officiële boete uit voor de hele groep omdat het blijkbaar verboden was om boven op Mount Whitney te overnachten."
                            },
                            {
                                "example_id": "ba1a62c5-b1c2-4aaf-9e9f-98a775d649d6",
                                "sense_id": "4d4bc575-e7a6-3587-972a-6da8923828ad",
                                "text": "Het geheim bleef bijna veertien dagen bewaard, dus ik begon te denken dat het gevaar geweken was en dat die garage misschien niet eens verboden terrein was."
                            }
                        ]
                    }
