                "senses": [
                    {
                        "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                        "entry_id": "ac7612d7-f80a-3700-94f1-e3600f5173a8",
                        "glosses": [
                            "ein Werk (als Theateraufführung, als Film, als Hörspiel, als Buch), bei dem es um die Begehung und/oder Aufklärung eines Verbrechens geht"
                        ],
                        "tags": [
                            "Theater",
                            "Film",
                            "Radio",
                            "Bücher"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9314c3-01ca-4a2e-9b70-c6742bd23a11",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "'Arsen und Spitzenhäubchen' ist ein oft gespieltes Kriminalstück von Joseph Kesselring."
                            },
                            {
                                "example_id": "bd161050-1c8a-4888-83d0-c5aafbcd2ce8",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "[John Boynton Priestley (1894-1984)] „schrieb Dramen, Kriminalstücke, Komödien und insgesamt 25 Romane.“"
                            },
                            {
                                "example_id": "ddcb751b-88be-473b-9d67-1b6fcf6bf53d",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Nach über 70 Romanen und zahlreichen Kriminalstücken für das Theater gilt Agatha Christie, die „Queen of Crime“, heute als meistgelesene Autorin der Welt.“"
                            },
                            {
                                "example_id": "638d53e3-d108-458c-8033-39a0dd5b1424",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "[Alfred Hitchcock über seinen Film 'Marnie':] „»Unser Held wendet die Mund-zu-Mund Wiederbelebungsmethode an. Das hinterlässt jetzt vielleicht den Eindruck, dieser Film handelt nur vom Sex und zeigt kein Kriminalstück. Doch das stimmt nicht.«“"
                            },
                            {
                                "example_id": "e5eb7a6c-8b45-4210-935c-e09ee731f76d",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "[Filmkritik:] „Der Name der Rose ist ein in sich stimmiges, spannendes Kriminalstück“ […]."
                            },
                            {
                                "example_id": "7037f003-2660-42cc-b5f0-8b1b8eb3a135",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Sicher, \"Der dritte Mann\" war in erster Linie ein Kriminalstück, doch Film war schon immer die Kunst, die am tiefsten in die unteren Schichten des Bewusstseins vordrang.“"
                            },
                            {
                                "example_id": "270c234f-e5c1-43ce-bdd4-256fb654c23a",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Am Berliner Kriminal Theater spielte sie unter der Regie von Kaspar Eichel im Kriminalstück Mord um Mord von Wolfgang Binder“ […]."
                            },
                            {
                                "example_id": "ec63f065-1693-4284-8089-46eed87e7771",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Heidi Kabel selbst, die große alte Dame des plattdeutschen Theaters, ist 1997 in dem Kriminalstück \"\"Allens echt, Fro Sperling?\" ein letztes Mal auf der Bühne des Ohnsorg-Theaters zu sehen.“"
                            },
                            {
                                "example_id": "6ea9aa32-e4f6-4821-8d63-f36a1cc3d8fc",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Seine erste Inszenierung ebendort wurde das Kriminalstück Parkstraße 13 von Axel Ivers.“"
                            },
                            {
                                "example_id": "f5849591-94dd-420f-9292-63a2c684b876",
                                "sense_id": "34384df2-1474-3889-9fae-5bc759842f59",
                                "text": "„Weil die Dinge schließlich außer Kontrolle geraten, wird aus dem Beziehungsroman in letzter Konsequenz ein Kriminalstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
