                "senses": [
                    {
                        "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                        "entry_id": "3fdab171-6d8c-3cb8-85ad-f10ac0cf35bf",
                        "glosses": [
                            "Eigenschaft bzw. Güte oder Wertigkeit eines Spiels, Spielgeländes oder Spielgeräts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f00009-a198-4a11-819f-0231701f6e3c",
                                "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                                "text": "„Darin liegt die unübertreffliche Spielqualität eines Balls, übrigens mehr für die 5- bis 12-jährigen Kinder als für die kleineren, für die der normale Gummiball schneller reagiert als ihr eigenes Bewegungssystem.“"
                            },
                            {
                                "example_id": "7dd41177-6564-4693-8dff-d3152bd4b53a",
                                "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                                "text": "„Weiterführende Studien sind wohl darauf angewiesen, die unterschiedlichen Regionen in ihrer spezifischen Spielqualität noch konkreter zu berücksichtigen.“"
                            },
                            {
                                "example_id": "bc42ab13-3184-406c-a279-7bec1efdf0dd",
                                "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                                "text": "„Wenn die Mannschaft die Leistungen umsetzt, die sie in den vergangenen Jahren gezeigt hat, und die Spielfreude sowie diese Spielqualität an den Tag legt, dann sollte die schwere Gruppe B zu überstehen sein.“"
                            },
                            {
                                "example_id": "f45ed6c9-260b-4288-bfd1-fe811a98f7f9",
                                "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                                "text": "„Allein Kloses Anwesenheit genügt, damit Lazio das Selbstvertrauen und die verlorene Spielqualität zurückgewinnt, schrieb die Gazzetta dello Sport.“"
                            },
                            {
                                "example_id": "7dc3d2d5-79e4-4e8b-8712-bd485a473be3",
                                "sense_id": "f5cf52e7-d8f5-37fd-9396-4bf8c6b1caf4",
                                "text": "„Durch Sammeln von Erfahrungen – wie der menschliche Spieler – könnte also die Spielqualität der Schachcomputer verbessert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
