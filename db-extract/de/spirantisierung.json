                        "entry_id": "982db0b8-ba02-3f77-af0e-7bfd22db1c00",
                        "glosses": [
                            "Aufweichen der Aussprache von Plosiven zu Frikativen"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "5fcc14bd-2d51-4cfb-8e06-7ccc7b891b7e",
                                "sense_id": "735718f0-caf4-3d65-9f3d-859ca3c4312e",
                                "text": "Die Spirantisierung des /g/ in Form von palatal-stimmlosem und velar-stimmlosem bzw. -stimmhaftem Reibelaut gilt für niederdeutsche Mundarten als charakteristisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
