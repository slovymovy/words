                ],
                "senses": [
                    {
                        "sense_id": "1b0d5354-a5fc-339f-a432-87deda18af91",
                        "entry_id": "e5690cf0-fe8c-329b-8ffe-e1c806cfa587",
                        "glosses": [
                            "шотландская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be29a0b2-cd03-4e2a-8624-8092ae13c634",
                                "sense_id": "1b0d5354-a5fc-339f-a432-87deda18af91",
                                "text": "Особо следует отметить, что исследовательская и преподавательская работа профессора Оскара Андерсона в Болгарии недостаточно полно отражена его биографами."
                            },
                            {
                                "example_id": "4da533d7-d6b3-443f-9ccb-91b2fedfa123",
                                "sense_id": "1b0d5354-a5fc-339f-a432-87deda18af91",
                                "text": "Бывший главный редактор журнала Wired, Крис Андерсон, живописует образы нового миропорядка ― «децентрализованный мир», в котором множество мелких, независимых фирм будет на равных конкурировать с крупными промышленными компаниями."
                            }
                        ]
                    }
