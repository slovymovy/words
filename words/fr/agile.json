                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat est un animal particulièrement <w>agile</w> qui grimpe facilement partout."
                        },
                        {
                            "text": "Grâce à ses doigts <w>agiles</w>, la musicienne enchaîne les notes sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "adroit",
                        "alerte",
                        "leste",
                        "rapide",
                        "vif"
                    ],
                    "antonyms": [
                        "maladroit",
                        "lourd"
                    ],
                    "common_phrases": [
                        "doigts agiles",
                        "esprit agile"
                    ]
                },
                {
                    "sense_id": "72d65260-281f-386e-a989-0e8a18ac6723",
                    "sense_definition": "Relatif à un mode de gestion de projet itératif, incrémental et collaboratif, notamment en informatique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre entreprise applique une méthode <w>agile</w> pour concevoir cette application."
                        },
                        {
                            "text": "Le management <w>agile</w> favorise les réunions courtes et les ajustements continus."
                        }
                    ],
                    "common_phrases": [
                        "méthode agile",
                        "management agile"
                    ]
                },
                {
                    "sense_id": "28c79265-9c42-331d-bd4a-e22c8a5b9dcb",
                    "sense_definition": "Capable de s'adapter rapidement aux évolutions et aux imprévus, en parlant d'une organisation ou d'un groupe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une administration plus <w>agile</w> répondrait mieux aux crises soudaines."
                        },
                        {
                            "text": "Pour rester compétitives, les grandes entreprises doivent devenir beaucoup plus <w>agiles</w>."
