                                "target_senses": [
                                    {
                                        "sense_id": "5efb8a64-9773-3f07-abc2-9b25c06f46cf",
                                        "entry_id": "f216b06a-4fa4-3194-8aa2-42ddac1f551f",
                                        "glosses": [
                                            "Air de danse espagnol joué à la guitare sur un rythme à trois temps, qui accompagne un couple de danseurs jouant des castagnettes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83dbca7d-2305-3320-be5f-bc25212054f8",
