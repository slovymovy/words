                        "target_lang_word": "Bénin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bénin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86b7ceb7-404f-31c2-8185-4525a2967877",
                                        "entry_id": "20d8ad55-e71f-310e-b532-ebbd5131e23a",
                                        "glosses": [
                                            "Pays d’Afrique, bordé par le Niger et le Burkina Faso au nord, le Nigeria à l’est, le golfe du Bénin au sud, et le Togo à l’ouest. Sa capitale est Porto-Novo."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dc03d2-613a-4c7e-a07d-0257ad8b5fe4",
                                                "sense_id": "86b7ceb7-404f-31c2-8185-4525a2967877",
                                                "text": "Au Bénin, trois strates ont été retenues : le milieu urbain, le milieu semi-urbain et le milieu rural."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60446459-3fa8-3c37-a7e1-5926d8be32c2",
                                        "entry_id": "20d8ad55-e71f-310e-b532-ebbd5131e23a",
                                        "glosses": [
                                            "Royaume disparu situé au Nigéria actuel."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e986630e-49ba-4ef1-9fc2-7d7137275753",
                                                "sense_id": "60446459-3fa8-3c37-a7e1-5926d8be32c2",
                                                "text": "Le royaume de Benin, dont les bornes ne sont pas déterminées avec beaucoup de certitude, paraît situé entre le 8ᵉ degré nord et l’équateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e30f6f1d-8d05-4689-9a32-9df33e063add",
                        "source_entry_id": "8020c0ab-2410-39a3-8d90-4697204d873f",
                        "source_sense_description": "country",
                        "target_lang_word": "Benin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                        "entry_id": "9bb378f7-9e93-33ff-a908-f656b8ab4d44",
                                        "glosses": [
                                            "Staat in Westafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11c212e-7e33-4d2a-84a6-acabcd9f8afb",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Thea besucht im Juni den Nationalpark W im Norden Benins."
                                            },
                                            {
                                                "example_id": "a26b014b-e2d0-4663-9224-b8c6ecdd57c1",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Porto Novo ist die Hauptstadt und Cotonou ist der Regierungssitz von Benin."
                                            },
                                            {
                                                "example_id": "1ecc6aa6-727f-4f81-8a22-a774c9513151",
                                                "sense_id": "b5760828-c971-3aff-94bc-71beabaa5a02",
                                                "text": "Aufgrund der hohen Auslandsverschuldung ist Benin nicht in der Lage, an den größeren internationalen Programmen der Entwicklungszusammenarbeit teilzunehmen, die eine gewisse Eigenbeteiligung erfordern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                        "entry_id": "9bb378f7-9e93-33ff-a908-f656b8ab4d44",
                                        "glosses": [
                                            "von Edo-Völkern gegründetes und bis 1897 bestehendes Königreich im Südwesten des heutigen Nigeria"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c91ce8-4fae-46bb-8e5f-c1b8b51e8d26",
                                                "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                                "text": "„Woher aber kam dieses Volk der Bini, wie ist das Reich Benin entstanden?“"
                                            },
                                            {
                                                "example_id": "3b22f34a-8fd7-4489-844f-939e911731ae",
                                                "sense_id": "481538bc-a659-32fc-aabc-3a15b5d5e814",
                                                "text": "„Am 2. Januar hatte er sich zusammen mit neun anderen Weißen und zweihundert afrikanischen Trägern auf eine Höflichkeitsvisite beim König von Benin begeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
