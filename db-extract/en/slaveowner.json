                                        "sense_id": "d260bbe4-5ad5-3924-be7a-ef6a4179e6f2",
                                        "entry_id": "22bba65d-7297-3874-ab20-a17dbb3b8578",
                                        "glosses": [
                                            "weibliche Person, die Sklaven besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a383e1-26a5-4567-bb5a-9774f5ccf61f",
                                                "sense_id": "d260bbe4-5ad5-3924-be7a-ef6a4179e6f2",
                                                "text": "„Zum Teil nutzten sie [weiße Frauen der Oberschicht] ihre Stellung genauso wie die weißen Männer aus: als Sklavenhändlerinnen, als Sklavenhalterinnen, die aus der Prostitution ihrer Sklavinnen persönlichen Nutzen zogen, oder als Großgrundbesitzerinnen, die ihre Lehnspflichtigen ausbeuteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
