                                                "sense_id": "082b86c4-b0e7-3f41-87b0-c8701b1fb5e9",
                                                "text": "De Koppenberg bleek alweer dodelijk in de Ronde van Vlaanderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fbaacc5-282d-3667-9e6c-d7ce59efb7db",
