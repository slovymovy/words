                                "target_senses": [
                                    {
                                        "sense_id": "dda124b5-aefb-335d-ac7c-096ad32c9384",
                                        "entry_id": "c35d1f45-a569-33a6-833b-4748f38f07df",
                                        "glosses": [
                                            "etwas zu einem Klumpen zusammenknautschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d67b458-d472-4357-8a3b-c12ccf2ab378",
                                                "sense_id": "dda124b5-aefb-335d-ac7c-096ad32c9384",
                                                "text": "„Er knüllt den Schriftsatz zusammen und haut ihn auf den Tisch, daß die Tassen fliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b559627-d999-4580-9d0d-36efae456df9",
                        "source_entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "source_sense_description": "crumple",
                        "target_lang_word": "zerknautschen",
                        "target_lang_code": "de",
