{
    "word_family": [
        "secrètement",
        "secrétaire",
        "secrétariat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bce3846-82aa-306e-a268-ab019c752913",
                    "sense_definition": "Information confidentielle qui ne doit pas être divulguée ou connue du public.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information_cachee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui a confié un <w>secret</w> important qu'il a promis de ne répéter à personne."
                        },
                        {
                            "text": "Il est difficile de garder un <w>secret</w> quand tout le monde pose des questions."
                        }
                    ],
                    "common_phrases": [
                        "garder un secret",
                        "secret professionnel",
                        "révéler un secret",
                        "partager un secret"
                    ]
                },
                {
                    "sense_id": "2cf5fd87-cbcb-3333-82b5-8197d3a0f21f",
                    "sense_definition": "Obligation de discrétion ou de silence imposée au sujet d'une affaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discretion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les négociations diplomatiques se sont déroulées dans le plus grand <w>secret</w>."
                        },
                        {
                            "text": "L'avocat est tenu au <w>secret</w> par les règles strictes de sa profession."
                        }
                    ],
                    "common_phrases": [
                        "garder le secret",
                        "dans le plus grand secret"
                    ]
                },
                {
                    "sense_id": "619e5556-7bbb-3e08-ae58-f15e9816fc5c",
                    "sense_definition": "Méthode, recette ou moyen particulier pour réussir dans un domaine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "methode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef cuisinier refuse de donner le <w>secret</w> de sa fameuse sauce."
                        },
                        {
                            "text": "La persévérance est souvent le seul véritable <w>secret</w> du succès."
                        }
                    ],
                    "common_phrases": [
                        "secret de fabrication",
                        "secret de la réussite"
                    ]
                },
                {
                    "sense_id": "37ca3a13-bb9d-3632-b6ce-e2f184080e64",
                    "sense_definition": "Régime d'isolement complet imposé à un prisonnier sans communication avec l'extérieur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a ordonné de mettre le suspect au <w>secret</w> pendant l'enquête."
                        },
                        {
                            "text": "Le prisonnier a été maintenu au <w>secret</w> pendant plusieurs semaines sans voir son avocat."
                        }
                    ],
                    "common_phrases": [
                        "mettre au secret",
                        "tenir au secret"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd926a63-48fc-34a0-9ae4-a78f506a29ec",
                    "sense_definition": "Qui est dissimulé, tenu à l'écart du regard ou de la connaissance d'autrui.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dissimule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent <w>secret</w> a reçu des instructions précises pour sa nouvelle mission."
                        },
                        {
                            "text": "Elle a noté son mot de passe dans un carnet <w>secret</w> rangé sous son lit."
                        }
                    ],
                    "synonyms": [
                        "caché",
                        "dissimulé"
                    ],
                    "common_phrases": [
                        "agent secret",
                        "code secret",
                        "jardin secret",
                        "service secret"
                    ]
                },
                {
                    "sense_id": "ab5394de-bc86-377b-a498-171247162c5b",
                    "sense_definition": "Qui est dérobé à la vue, invisible ou masqué, en parlant d'un passage ou d'une ouverture.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "dissimule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château possède un escalier <w>secret</w> reliant la tour au sous-sol."
                        },
                        {
                            "text": "Ils ont trouvé une porte <w>secrète</w> dissimulée derrière une grande bibliothèque."
                        }
                    ],
                    "synonyms": [
                        "caché",
                        "dissimulé"
                    ],
                    "common_phrases": [
                        "porte secrète",
                        "escalier secret",
                        "passage secret"
                    ]
                },
                {
                    "sense_id": "d58254db-cf9e-3757-9fe0-35d40c49d7c7",
                    "sense_definition": "Qui sait se taire, garder la confidence et faire preuve de discrétion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discretion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez tout lui raconter sans crainte car c'est un homme très <w>secret</w>."
                        },
                        {
                            "text": "Elle est restée très <w>secrète</w> sur ses projets d'avenir et n'en a rien dit."
