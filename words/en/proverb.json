{
    "word_family": [
        "proverbial",
        "proverbially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e809d4a7-5eef-355c-b68e-864cebe4afab",
                    "sense_definition": "A short, traditional saying that expresses a common truth, piece of advice, or moral lesson.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>proverb</w> says that actions speak louder than words.",
                            "target_lang_translations": {
                                "cs": "Staré <w>přísloví</w> říká, že činy mluví hlasitěji než slova."
                            }
                        },
                        {
                            "text": "She often uses a <w>proverb</w> to explain her life philosophy.",
                            "target_lang_translations": {
                                "cs": "Často používá <w>přísloví</w>, aby vysvětlila svou životní filozofii."
                            }
                        }
                    ],
                    "synonyms": [
                        "adage",
                        "maxim",
                        "saying",
                        "aphorism"
                    ],
                    "common_phrases": [
                        "old proverb",
                        "wise proverb"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátké tradiční rčení, které vyjadřuje obecnou pravdu, radu nebo mravní ponaučení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přísloví",
                                "target_lang_sense_clarification": "tradiční krátké rčení vyjadřující obecnou pravdu nebo ponaučení"
                            },
                            {
                                "target_lang_word": "pořekadlo",
                                "target_lang_sense_clarification": "ustálené lidové rčení s poučením"
                            },
                            {
                                "target_lang_word": "rčení",
                                "target_lang_sense_clarification": "obecně kratší ustálené rčení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21d8cd44-9c34-3580-81bc-b6801a6f4e76",
                    "sense_definition": "An obscure or paradoxical statement that requires interpretation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "saying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher spoke in a <w>proverb</w> that left the students confused.",
                            "target_lang_translations": {
                                "cs": "Učitel mluvil v <w>záhadném výroku</w>, který studenty zmátl."
                            }
                        },
                        {
                            "text": "He answered the question with a cryptic <w>proverb</w>.",
                            "target_lang_translations": {
                                "cs": "Na otázku odpověděl kryptickým <w>rčením</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "parable",
                        "enigma"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary or biblical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nejasný nebo paradoxní výrok, který vyžaduje výklad."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "záhadný výrok",
                                "target_lang_sense_clarification": "archaicky: nejasný nebo záhadný výrok vyžadující výklad"
                            },
                            {
                                "target_lang_word": "temné rčení",
                                "target_lang_sense_clarification": "temné, paradoxní rčení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3127b6f1-68f3-387a-86af-b0e02ab28958",
                    "sense_definition": "A person or thing that is widely known as a subject of mockery or contempt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His failure became a <w>proverb</w> among his former colleagues.",
                            "target_lang_translations": {
                                "cs": "Jeho neúspěch se mezi bývalými kolegy stal <w>odstrašujícím příkladem</w>."
                            }
                        },
                        {
                            "text": "The fallen king became a <w>proverb</w> of misfortune throughout the land.",
                            "target_lang_translations": {
                                "cs": "Padlý král se v celé zemi stal <w>symbolem neštěstí</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "byword"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in formal or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba nebo věc, která je všeobecně známá jako předmět posměchu nebo opovržení."
                    },
                    "translations": {
                        "cs": [
                            {
