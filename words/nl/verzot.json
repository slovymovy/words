                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fond of",
                                "target_lang_sense_clarification": "having a strong liking for something"
                            },
                            {
                                "target_lang_word": "crazy about",
                                "target_lang_sense_clarification": "extremely enthusiastic about something"
                            },
                            {
                                "target_lang_word": "mad for",
                                "target_lang_sense_clarification": "having an intense desire or liking for something"
                            },
                            {
                                "target_lang_word": "besotted with",
                                "target_lang_sense_clarification": "infatuated or extremely fond of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b218b81-6950-3b22-9e26-27acf470ee4e",
                    "sense_definition": "geestelijk verward of buiten zinnen zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwarring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man dwaalde <w>verzot</w> door de straten na het horen van het vreselijke nieuws.",
                            "target_lang_translations": {
                                "en": "The man wandered <w>madly</w> through the streets after hearing the terrible news."
                            }
