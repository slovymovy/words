                ],
                "senses": [
                    {
                        "sense_id": "2ed8e068-9586-3e3e-87b0-4693cdfc897e",
                        "entry_id": "c4a2c4a3-0b03-36b5-856d-1d149d05fe65",
                        "glosses": [
                            "bulbous, bulb-shaped, tuber-shaped"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02ed71f5-d022-4ec3-a84a-b7f758f6c723",
                                "sense_id": "2ed8e068-9586-3e3e-87b0-4693cdfc897e",
                                "text": "Nos był nowy. Bardziej bulwiasty niż mój własny...",
                                "translation": "The nose was new. [It was] more bulbous than my own...",
                                "english": "The nose was new. [It was] more bulbous than my own..."
                            }
                        ]
                    },
                    {
                        "sense_id": "e614238a-58f2-3bc1-848e-8e3595bd2509",
                        "entry_id": "c4a2c4a3-0b03-36b5-856d-1d149d05fe65",
                        "glosses": [
                            "bulbaceous, tuberous (having or growing from bulbs or tubers)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0799f02c-c5c1-46d2-9dd1-a69b6213fe78",
                                "sense_id": "e614238a-58f2-3bc1-848e-8e3595bd2509",
                                "text": "Poziomem zawartości suchej masy, sumy cukrów i cukrów redukujących przewyższała uprawiane dotąd w Polsce rośliny bulwiaste, takie jak ziemniak, czy słonecznik bulwiasty.",
                                "translation": "In the level of its content of dry matter and of the amount of sugars and reducing sugars, it exceeded the plants with bulbs or tubers cultivated in Poland until now, such as the potato or tuberous sunflower.",
                                "english": "In the level of its content of dry matter and of the amount of sugars and reducing sugars, it exceeded the plants with bulbs or tubers cultivated in Poland until now, such as the potato or tuberous sunflower."
                            }
                        ]
                    }
