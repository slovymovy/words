            "senses": [
                {
                    "sense_id": "7b90bd89-f913-32ca-9d8c-c704683b94b2",
                    "sense_definition": "Canne munie d'un appui sous l'aisselle ou l'avant-bras qui sert à aider la marche d'une personne blessée ou handicapée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son accident de ski, il a dû marcher avec une <w>béquille</w> pendant plusieurs semaines."
                        },
                        {
                            "text": "Elle s'est tordu la cheville et ne peut plus avancer sans ses deux <w>béquilles</w>."
                        }
                    ],
                    "common_phrases": [
                        "marcher avec des béquilles"
                    ]
                },
                {
                    "sense_id": "e4be4604-c746-3d6c-a0e0-716ed99cf4ba",
                    "sense_definition": "Tige métallique rabattable fixée à un vélo ou à une moto pour le maintenir debout à l'arrêt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à poser ton vélo sur sa <w>béquille</w> avant d'entrer dans la boulangerie."
                        },
                        {
                            "text": "Le motard a replié la <w>béquille</w> de son engin avant de démarrer sur la route."
