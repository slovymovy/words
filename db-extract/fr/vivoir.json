                                        "entry_id": "9742fc93-584c-3ee3-b356-591ac0c37d29",
                                        "glosses": [
                                            "A room in a house where people (residents or guests) pass the time in leisure."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57910140-2b56-4652-a42e-b4c2debf9ebd",
                                                "sense_id": "327ce011-06d1-36d0-81a7-654a38badc9f",
                                                "text": "Near-synonyms: living room, living-room, lounge, parlor, parlour, front room"
                                            },
                                            {
                                                "example_id": "3f10abb4-8d6f-4714-b5a2-8344f384a28a",
                                                "sense_id": "327ce011-06d1-36d0-81a7-654a38badc9f",
                                                "text": "“[…] Captain Markam had been found lying half-insensible, gagged and bound, on the floor of the sitting-room, his hands and feet tightly pinioned, and a woollen comforter wound closely round his mouth and neck ; whilst Mrs. Markham's jewel-case, containing valuable jewellery and the secret plans of Port Arthur, had disappeared.[…]”"
                                            }
                                        ]
