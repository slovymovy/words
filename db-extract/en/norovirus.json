                        "entry_id": "cfe27899-cbe7-307b-86ec-807d8b746f57",
                        "glosses": [
                            "Norovirus, the genus of Norwalk virus, which causes gastric distress in humans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e58f96e8-9a59-4eaf-ba09-30e98f241f44",
                                "sense_id": "763c9c36-3d50-3d9a-898b-8483f4506a82",
                                "text": "The norovirus causes nausea, vomiting, diarrhea and stomach cramping."
                            }
                        ]
                    }
                ],
