                "senses": [
                    {
                        "sense_id": "099cd2e3-d988-3e89-a262-6411e9eb2e43",
                        "entry_id": "6360caf9-e365-3028-9407-568c8d5cf291",
                        "glosses": [
                            "Tromper en se montrant roublard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c367de33-26e3-4750-886e-b19784c11a8d",
                                "sense_id": "099cd2e3-d988-3e89-a262-6411e9eb2e43",
                                "text": "Soit les prix ont flambé soit Kumilly est deux fois plus cher que Madikéri (tourisme et affluence oblige = A Goa c'était exactement 7 fois plus cher !) Soit on t'a gentiment roublardisé."
                            },
                            {
                                "example_id": "c414f5db-e279-4144-9786-db1543cf149c",
                                "sense_id": "099cd2e3-d988-3e89-a262-6411e9eb2e43",
                                "text": "Kobie van Rensburg prend un malin plaisir à roublardiser son moralisateur « Semplicetto ! a donna credi » sans ignorer une fine bouffonnerie (cette voyelle enflée sur « mira » et « sospira », ces « vedi » au sourire carnassier) et toujours un amour du texte qui lui fait déguster chaque syllabe."
                            },
                            {
                                "example_id": "82dbc282-00f0-4713-af22-4c77591273a0",
                                "sense_id": "099cd2e3-d988-3e89-a262-6411e9eb2e43",
                                "text": "Sur les quelques parties qu'on a faites, la chance a moins joué que la capacité à roublardiser et à entourlouper."
                            }
                        ]
                    }
                ],
