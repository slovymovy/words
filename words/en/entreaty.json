    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa16adcf-5520-3ca4-9c4c-6a83686f53ec",
                    "sense_definition": "An earnest, humble, or urgent request or plea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family made an emotional <w>entreaty</w> to the kidnappers for their daughter's safe return.",
                            "target_lang_translations": {
                                "ru": "Семья обратилась к похитителям с эмоциональной <w>мольбой</w> о безопасном возвращении дочери."
                            }
                        },
                        {
                            "text": "Despite her desperate <w>entreaties</w>, the landlord refused to extend the deadline for paying the rent.",
                            "target_lang_translations": {
                                "ru": "Несмотря на её отчаянные <w>мольбы</w>, арендодатель отказался продлить срок внесения арендной платы."
                            }
                        }
                    ],
                    "synonyms": [
                        "appeal",
                        "plea",
                        "petition",
                        "supplication"
                    ],
                    "antonyms": [
                        "command",
                        "demand"
                    ],
                    "common_phrases": [
                        "desperate entreaties",
                        "urgent entreaty",
                        "turn a deaf ear to entreaties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренняя, смиренная или настойчивая просьба, мольба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "страстная или отчаянная просьба"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "настойчивое обращение с просьбой"
                            },
                            {
                                "target_lang_word": "умоление",
                                "target_lang_sense_clarification": "действие по значению глагола умолять; мольба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6e3a113-feb6-3d49-8525-273b5db5a3fc",
                    "sense_definition": "Treatment, reception, or entertainment of a guest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers were grateful for the kind <w>entreaty</w> they received from the village elder.",
                            "target_lang_translations": {
                                "ru": "Путешественники были благодарны за добрый <w>приём</w>, оказанный им старейшиной деревни."
                            }
                        },
                        {
                            "text": "Such harsh <w>entreaty</w> of an honored guest was completely unheard of in the royal court.",
                            "target_lang_translations": {
                                "ru": "Столь суровое <w>обращение</w> с почётным гостем было неслыханным делом при королевском дворе."
                            }
                        }
                    ],
                    "synonyms": [
                        "treatment",
                        "reception",
                        "entertainment"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "sense no longer in standard modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение с кем-либо, прием или оказание гостеприимства (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "оказание гостеприимства, встреча гостя"
                            },
                            {
                                "target_lang_word": "обращение",
                                "target_lang_sense_clarification": "отношение к кому-либо, обхождение"
                            }
                        ]
                    }
                }
            ]
        }
