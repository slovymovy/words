                    },
                    {
                        "sense_id": "ba73ebb3-d241-314e-a1a8-07a1bf08492e",
                        "entry_id": "4a7d2666-2a71-3f2c-963c-17b951aa3704",
                        "glosses": [
                            "一位俄羅斯人"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "61294cb2-070f-48ee-a4e5-497990c817df",
                                "sense_id": "ba73ebb3-d241-314e-a1a8-07a1bf08492e",
                                "text": "Ivan is yelling curses at his friends.",
                                "translation": "俄國人正在大聲咒罵他的朋友。"
                            }
                        ]
                    },
                    {
                        "sense_id": "ae9d5975-609a-39b8-bde8-d3d69cb12a10",
                        "entry_id": "4a7d2666-2a71-3f2c-963c-17b951aa3704",
                        "glosses": [
                            "俄羅斯人（集體、人格化）"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9af67f93-5b0c-4152-b1b6-6b29eff4540a",
                                "sense_id": "ae9d5975-609a-39b8-bde8-d3d69cb12a10",
                                "text": "Ivan is planning an attack on our flank.",
                                "translation": "俄國人正打算攻擊我們的側翼。"
                            }
                        ]
                    },
                    {
                        "sense_id": "8b2511ee-bfca-3c6c-9503-d62209d0ad10",
                        "entry_id": "4a7d2666-2a71-3f2c-963c-17b951aa3704",
                        "glosses": [
                            "一位蘇聯人"
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4ed01264-cfc5-3679-86a4-20a282d441c3",
                        "entry_id": "4a7d2666-2a71-3f2c-963c-17b951aa3704",
                        "glosses": [
                            "蘇聯人（集體、人格化）"
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c310e5a8-6c64-4cdc-96ed-b6f86023a57d",
                                "sense_id": "4ed01264-cfc5-3679-86a4-20a282d441c3",
                                "text": "I’m sure whoever was in charge must have been one of the last of the Fulda Fucktards, you know, those generals who spent their nard-drop years training to defend West Germany from Ivan.",
                                "translation": "我敢說，當時負責的傢伙一定是「富爾達蠢蛋幫」的最後餘孽。你懂的，就是那群把整個青春期到睪丸縮水的歲月，全花在訓練怎麼防衛西德、對抗蘇聯佬的將軍們。"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c7fafe1-6ec2-363a-badc-f376ad840d22",
                        "entry_id": "4a7d2666-2a71-3f2c-963c-17b951aa3704",
                        "glosses": [
                            "支持俄羅斯民族主義或 2022 年入侵烏克蘭的網軍；黃俄、精俄"
                        ],
                        "tags": [
                            "Internet",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "817e873b-27f6-428c-a3c4-1c5a9c5b62f9",
                                "sense_id": "0c7fafe1-6ec2-363a-badc-f376ad840d22",
                                "text": "Ivan, stop repeating Kremlin propaganda.",
                                "translation": "你個精俄，別再散佈克里姆林宮的大外宣了。"
                            }
                        ]
                    }
                ],
