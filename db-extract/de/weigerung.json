                    {
                        "sense_id": "b97b794b-d610-3560-8b3a-1b6490ef3535",
                        "entry_id": "1110866d-53d6-340e-922c-8b46033f7301",
                        "glosses": [
                            "Handlung, etwas abzulehnen"
