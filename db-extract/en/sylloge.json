                "senses": [
                    {
                        "sense_id": "f91a798d-007f-3881-a0de-d5c7e6e6eccf",
                        "entry_id": "89603dad-39ad-3351-a2d8-e2d82218376d",
                        "glosses": [
                            "A collection or compendium, especially of coins or antiquarian objects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb0b907-5f81-4d78-bb8d-1344f3022824",
                                "sense_id": "f91a798d-007f-3881-a0de-d5c7e6e6eccf",
                                "text": "Milred's Sylloge might have included some of the poems of the so-called Alcuiniana (A and B):⁶⁷ Milred himself might even have taken a copy of his sylloge to Germany, where Alcuin and other Carolingian poets later used it as a model."
                            },
                            {
                                "example_id": "f8ec700c-1020-4613-8e85-2eb702693d5c",
                                "sense_id": "f91a798d-007f-3881-a0de-d5c7e6e6eccf",
                                "text": "Ciriaco's epigraphic collections on paper, known as sylloges, are his most famous contribution."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1a161ee-73e6-3267-9132-9b0286b077e0",
                        "entry_id": "89603dad-39ad-3351-a2d8-e2d82218376d",
                        "glosses": [
                            "A summary or digest of such a collection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a7b7482-d42d-4e37-8ba3-2a406806f4ad",
                                "sense_id": "b1a161ee-73e6-3267-9132-9b0286b077e0",
                                "text": "Another major development is the publication of sylloges. A sylloge presents images and descriptions of all the coins of a certain collection, subject to defined parameters of mint and time, and is usually organised by mint series."
                            }
                        ]
                    }
                ],
