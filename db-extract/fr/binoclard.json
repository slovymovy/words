                                        "sense_id": "7cf1fb7b-9afc-3b58-b7ba-bf7580101ee7",
                                        "entry_id": "dcad6780-9f65-3212-af42-9a9bf708f2fe",
                                        "glosses": [
                                            "iemand die een bril draagt"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13fe881-cec3-4170-806d-f1198cd995d7",
                                                "sense_id": "7cf1fb7b-9afc-3b58-b7ba-bf7580101ee7",
                                                "text": "Ik had een bril en dat waren in die tijd van die lullige ziekenfondsbrilletjes. Ik werd daarmee gepest, “schele” en “brillenjood” zeiden ze dan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c115b0d8-e39b-333b-b1e2-cca3c4156a19",
                                        "entry_id": "dcad6780-9f65-3212-af42-9a9bf708f2fe",
                                        "glosses": [
                                            "verkoper van monturen met lenzen waarmee mensen beter kunnen zien"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c30890-ee92-4bbf-8472-94a75d3d4c97",
                                                "sense_id": "c115b0d8-e39b-333b-b1e2-cca3c4156a19",
                                                "text": "Immers door als consequent fysioloog in het oog een optisch werktuig te zien, had hij het oude toverkunstje van de ‘brillenjood’ op markten en kermissen binnen de medische wetenschap getrokken: de bij- of verzienden pasten voortaan niet meer op goed geluk een bril op, de afwijking van het oog liet zich wetenschappelijk meten en corrigeren."
                                            }
                                        ]
                                    }
