                "forms": [],
                "senses": [
                    {
                        "sense_id": "1af050ba-c21e-3fb8-989b-aefb0029be5d",
                        "entry_id": "276b2e8c-b7af-30d3-ae19-bec762660412",
                        "glosses": [
                            "nummer veertien in een rij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ee16ef-651f-407f-abb8-de4de65839a3",
                                "sense_id": "1af050ba-c21e-3fb8-989b-aefb0029be5d",
                                "text": "Het is vandaag de veertiende Maart."
                            },
                            {
                                "example_id": "491ee3bc-5b03-4214-a069-a360ec241a95",
                                "sense_id": "1af050ba-c21e-3fb8-989b-aefb0029be5d",
                                "text": "De aanhoudende stakingen in Frankrijk hebben de toeristensector in het land hard getroffen. Vandaag werd er voor de veertiende dag op rij gedemonstreerd en dat leidde wederom tot flinke verstoringen op de weg en in het openbaar vervoer. Vooral de hotels en restaurants lijken klappen te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a48590a-513d-367c-9754-56b435ab48cb",
                        "entry_id": "276b2e8c-b7af-30d3-ae19-bec762660412",
                        "glosses": [
                            "gedeeld door veertien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf314b1-f4df-4029-b998-3bc81e3e663d",
                                "sense_id": "7a48590a-513d-367c-9754-56b435ab48cb",
                                "text": "Een veertiende deel is iets meer dan zeven procent."
                            }
                        ]
                    }
                ],
