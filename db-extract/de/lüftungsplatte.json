                ],
                "senses": [
                    {
                        "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                        "entry_id": "b9331066-d4c4-39ad-a916-447df00e51ce",
                        "glosses": [
                            "spezieller, relativ dünner, flacher und ebener fester Gegenstand, aus oder durch den Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cc1326-6322-4e4f-a8fa-c32281da6da0",
                                "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                                "text": "„In den Bereichen der Lüftungsdecke, wo keine Durchströmung der Platten notwendig ist, wie Gänge etc. empfehlen wir eine Dampfsperre zwischen Mineral wolleauflage und Oberkante der Holzlattung, an der die Lüftungsplatten befestigt sind, einzulegen“"
                            },
                            {
                                "example_id": "a22df4f7-5e1a-4ba5-8c63-48c08cce0070",
                                "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                                "text": "„Die Lüftungsplatten unserer DB-Serie können nicht nur in Produktionsstätten und Lagern verwendet werden, sondern erfüllen auch die hohen Anforderungen in Reinräumen und Rechenzentren.“"
                            },
                            {
                                "example_id": "666a3f76-e3be-4087-a692-f132cb114436",
                                "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                                "text": "„Die Lüftungsplatten sorgen durch eingefügte Lüftungseinsätze für eine gezielte Raumbelüftung.“"
                            },
                            {
                                "example_id": "eadf4eca-9851-45b9-8bd7-470aaf7b79ae",
                                "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                                "text": "„Die Conlit Lüftungsplatte 90 wird mit Schweißpins auf der Stahlblech Lüftungsleitung befestigt und die Stoßkanten mit dem Brandschutzkleber Conlit Fix verklebt. Plattenstöße, Anschlüsse, Abhänger und sonstige Durchdringungen sind dabei diffusionsdicht mit dem Aluminiumklebeband ROCKWOOL Alufix abzukleben.“"
                            },
                            {
                                "example_id": "621c5f2d-ff8b-4222-9266-5f193c12faf1",
                                "sense_id": "5dc2defd-ece0-3197-94d8-d9f20b64b748",
                                "text": "„Die hohe Passgenauigkeit der Lüftungsplatten in Kombination mit dem äußerst geringen Gewicht gewährleistet spielend leichtes Handling bei Installation und Wartung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
