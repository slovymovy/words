                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6c7a337-2e20-494a-b60c-4f3b1b256548",
                        "source_entry_id": "eac3241e-fbaa-3d30-8c42-103f7f590bd0",
                        "source_sense_id": "d79bb5c1-8029-3d6a-991a-ef72a9da992c",
                        "target_lang_word": "person",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "person",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c520e54-4cc7-3cb6-a3c8-786b9c39a444",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e117aa49-911c-4010-a0d9-f017efcdd95a",
                                                "sense_id": "8c520e54-4cc7-3cb6-a3c8-786b9c39a444",
                                                "text": "1784, William Jones, The Description and Use of a New Portable Orrery, &c., PREFACE\nTHE favourable reception the Orrery has met with from Perſons of the firſt diſtinction, and from Gentlemen and Ladies in general, has induced me to add to it ſeveral new improvements in order to give it a degree of Perfection; and diſtinguiſh it from others; which by Piracy, or Imitation, may be introduced to the Public."
                                            },
                                            {
                                                "example_id": "b35fd0f8-97d3-422c-b687-661b83f006cf",
                                                "sense_id": "8c520e54-4cc7-3cb6-a3c8-786b9c39a444",
                                                "text": "“A very welcome, kind, useful present, that means to the parish. By the way, Hopkins, let this go no further. We don't want the tale running round that a rich person has arrived. Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing.[…]”"
                                            },
                                            {
                                                "example_id": "a297aac8-bf56-4e60-a581-bfa5dcbeeed1",
                                                "sense_id": "8c520e54-4cc7-3cb6-a3c8-786b9c39a444",
                                                "text": "Each person is unique, both mentally and physically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070ba17a-5150-3b78-af99-f0b21b6080fe",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "A character or part, as in a play; a specific kind or manifestation of individual character, whether in real life, or in literary or dramatic representation; an assumed character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2317707-62b2-41a3-a042-9566ca376507",
                                                "sense_id": "070ba17a-5150-3b78-af99-f0b21b6080fe",
                                                "text": "[…]his firſt appearance vpon the Stage, in his new perſon of a Sycophant or Iugler[…]"
                                            },
                                            {
                                                "example_id": "b12c9e83-77c1-47e3-bdb0-c04f25924546",
                                                "sense_id": "070ba17a-5150-3b78-af99-f0b21b6080fe",
                                                "text": "How different […]is the same man from himself, as he sustains the person of a magistrate, and […]that of a friend!"
                                            },
                                            {
                                                "example_id": "e258c645-a27b-4b15-9f84-6c6edeaa562c",
                                                "sense_id": "070ba17a-5150-3b78-af99-f0b21b6080fe",
                                                "text": "[…]to beare rule, which was thy part / And perſon, had’ſt thou known thy ſelf aright."
                                            },
                                            {
                                                "example_id": "ffd8e4e5-9d66-4bfb-a0d0-f169244a7845",
                                                "sense_id": "070ba17a-5150-3b78-af99-f0b21b6080fe",
                                                "text": "No man can long put on a person and act a part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc7ebb9-04e9-3a73-b894-8f4d00428c2b",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "Any one of the three hypostases of the Holy Trinity: the Father, Son, or Holy Spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079d8e87-ac99-46ac-a65e-778b41e97265",
                                                "sense_id": "9fc7ebb9-04e9-3a73-b894-8f4d00428c2b",
                                                "text": "three persons and one God"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee7ed13-c676-3e6b-b01c-5993d0bdd415",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "Any sapient or socially intelligent being."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62c2bb84-7b5a-3472-aa7a-e338b030f93b",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "Someone who likes or has an affinity for (a specified thing)."
                                        ],
                                        "tags": [
                                            "in a compound noun or noun phrase"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae75146-874c-4937-bc4a-7328f572aed1",
                                                "sense_id": "62c2bb84-7b5a-3472-aa7a-e338b030f93b",
                                                "text": "Jack's always been a dog person, but I prefer cats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb193c3b-58fb-3b42-bdb0-4fd5f09c204b",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "A human of unspecified gender (in terms usually constructed with man or woman)."
                                        ],
                                        "tags": [
                                            "in a compound noun or noun phrase"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7883fb2b-90e3-33b2-82a7-bc7167a486d0",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "An individual who has been granted personhood; usually a human being.",
                                            "A worker in a specified function or specialty."
                                        ],
                                        "tags": [
                                            "in a compound noun or noun phrase"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebdbfb4-e4b2-4932-8bae-0a50519a051c",
                                                "sense_id": "7883fb2b-90e3-33b2-82a7-bc7167a486d0",
                                                "text": "I was able to speak to a technical support person and get the problem solved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a58e70-750a-3c46-b0ff-63c3e22b89c1",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "The physical body of a being seen as distinct from the mind, character, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb94516b-8fab-40cc-b283-daf212edc841",
                                                "sense_id": "69a58e70-750a-3c46-b0ff-63c3e22b89c1",
                                                "text": "[…]when the young Ladies laughed at her for it, ſhe replied that it was not his perſon that ſhe did embrace and reverence, but the divine beauty of his Soule."
                                            },
                                            {
                                                "example_id": "55c448e5-77be-4ea4-ae5b-9eadcadd737d",
                                                "sense_id": "69a58e70-750a-3c46-b0ff-63c3e22b89c1",
                                                "text": "The Captain, inclining his military person, sat sideways to be closer and kinder[…]."
                                            },
                                            {
                                                "example_id": "e413f3f6-3889-4e6f-b0ce-0f1845801a88",
                                                "sense_id": "69a58e70-750a-3c46-b0ff-63c3e22b89c1",
                                                "text": "At first blush it seemed that what was striking about him rested on the fact that his dress was exotic, his person foreign."
                                            },
                                            {
                                                "example_id": "0926a6b1-1a54-46d6-bdb7-de2e00a9e973",
                                                "sense_id": "69a58e70-750a-3c46-b0ff-63c3e22b89c1",
                                                "text": "Meanwhile, the dazed Sullivan, dressed like a bum with no identification on his person, is arrested and put to work on a brutal Southern chain gang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200b0348-55c2-3f5a-a4ae-45356faa0778",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "Any individual or formal organization with standing before the courts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3963017-2fd0-46ba-b5ae-0db9c76a999e",
                                                "sense_id": "200b0348-55c2-3f5a-a4ae-45356faa0778",
                                                "text": "At common law a corporation or a trust is legally a person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56744b91-1d78-349f-aea8-21bfca89885b",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "The human genitalia; specifically, the penis."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bed0bcf-0916-41fa-99ad-a8556c99ddc0",
                                                "sense_id": "56744b91-1d78-349f-aea8-21bfca89885b",
                                                "text": "[E]very Person wilfully, openly, lewdly, and obscenely exposing his Person in any Street, Road, or public Highway, or in the View thereof, or in any Place of public Resort, with Intent to insult any Female ... and being subsequently convicted of the Offence for which he or she shall have been so apprehended, shall be deemed a Rogue and Vagabond, within the true Intent and Meaning of this Act ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362c14dd-3161-3da8-8614-969362c5a19e",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "A linguistic category used to distinguish between the speaker of an utterance and those to whom or about whom they are speaking. See grammatical person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95f9a215-0e51-33a9-8fff-daee85cf0b80",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "A shoot or bud of a plant; a polyp or zooid of the compound Hydrozoa, Anthozoa, etc.; also, an individual, in the narrowest sense, among the higher animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09842ade-5a8e-46e1-b2e6-32e8b529fa27",
                                                "sense_id": "95f9a215-0e51-33a9-8fff-daee85cf0b80",
                                                "text": "True corms, composed of united personae […] usually arise by gemmation, […] yet in sponges and corals occasionally by fusion of several originally distinct persons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029ade6d-f0ce-36b0-9702-5846c94bcc10",
                                        "entry_id": "1a0bd8c6-2e28-381b-bf5a-fd2c1aaf718e",
                                        "glosses": [
                                            "A soulmate; someone, especially a romantic partner, with whom one is exceptionally compatible and connected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1452416-a92a-4658-8f2c-7971ccf4ec85",
                                                "sense_id": "029ade6d-f0ce-36b0-9702-5846c94bcc10",
                                                "text": "'I still miss her. Every day,' she said. 'She was my person. […] [And when she died,] I'd lost my person. I was eight years old and I'd lost my person. Willow and I even had our own language, as lots of twins do, but I stopped talking after she died.'"
                                            },
                                            {
                                                "example_id": "a2dddcaa-3fde-4d6e-bbce-0a8977162cf4",
                                                "sense_id": "029ade6d-f0ce-36b0-9702-5846c94bcc10",
                                                "text": "Standing in the rain, she looked at me and said, \"I have lost my person. Cal was my person. What am I going to do? I lost my person.\" The words didn't make sense to me. […] She lost her person? What does that even mean? Cal was more than a person. He was this great man and legendary basketball coach. I get if you have lost your dog or cat [...] But I lost my person? […] I finally understood [...] Because I realized that you are my person. It means that in a world of eight billion people, if I lost you, there would still be seven billion, nine-hundred and ninety-nine million, nine-hundred and ninety-nine thousand, nine-hundred and ninety-nine people [...] But none of those people matter. None of them are you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "person",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "730af85c-160a-393c-af0c-79ca95446149",
                                        "entry_id": "95ad1df1-6b5d-3267-8f2b-627df8a751de",
                                        "glosses": [
                                            "To represent as a person; to personify; to impersonate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53ac9e7-f7ac-4d3a-9f96-e8d36fc529b4",
                                                "sense_id": "730af85c-160a-393c-af0c-79ca95446149",
                                                "text": "Or let us perſon him like ſome wretched itinerary Judge, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                        "entry_id": "95ad1df1-6b5d-3267-8f2b-627df8a751de",
                                        "glosses": [
                                            "To man, to supply with staff or crew."
                                        ],
                                        "tags": [
                                            "gender-neutral",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8582957b-b670-49d4-b48a-7d0ace3d8c58",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "“Okay. Soon as Natalie heard, and while she was flailing around trying to turn up a Valium, she decided she had better call Scott Harrison and ask his opinion on what sort of advice, re legal moves, she ought to call back to Iréné, or Rama, or Wilkerson, or whoever’s personning the fort back there.” / “Whoever’s whatening the fort?” / “Please.[…]”"
                                            },
                                            {
                                                "example_id": "ae918bb9-e651-48e8-8c15-0d2b496b72f5",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "Thank you to the many who helped the festival succeed (and apologies to anyone omitted): […] Kevin and Mary Jannsen, for tireless work including the initial survey, soliciting raffle donations, selling tickets, personning the raffle booth during the festival, etc."
                                            },
                                            {
                                                "example_id": "71831f8e-a857-43b0-826f-dd9cf750e6f2",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "And I sat at the counter and watched the cooker cat personning the griddle with one hand and the grill with the other."
                                            },
                                            {
                                                "example_id": "54e1825a-da61-43a3-9732-15624f9c6507",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "We had hit the iceberg, and it was time to person the lifeboats."
                                            },
                                            {
                                                "example_id": "79987273-a1ba-493f-9874-952882f03a81",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "I was just mulling over the merits of working the fryer at McDonald’s versus personning the complaints desk at Wal-Mart when I took a right onto the dirt road leading to New Millennium Bible Camp."
                                            },
                                            {
                                                "example_id": "41a2c8b1-7e28-477a-bcf8-b61eb1a77e70",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "We went so far as to stop in a hotel on the way out of Speyer — to ask for directions — but the teenaged girl personing the desk there seemed to be such an idiot[…]"
                                            },
                                            {
                                                "example_id": "55539844-8816-4938-bec7-728e00070a87",
                                                "sense_id": "bf0f6c9d-d635-38de-9f2f-140c55027d64",
                                                "text": "In fact, so inebriated were they that they could barely move, and, neither nest nor wheel being personned, the ship was as usual careening wildly across the main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "901e367e-5ff6-4a73-b4af-9d8cb46e857e",
                        "source_entry_id": "eac3241e-fbaa-3d30-8c42-103f7f590bd0",
                        "source_sense_id": "d79bb5c1-8029-3d6a-991a-ef72a9da992c",
                        "target_lang_word": "presbyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presbyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                                        "entry_id": "fceded11-acc1-3956-b750-421369694379",
                                        "glosses": [
                                            "Hypermétrope, qui ne distingue bien que les objets éloignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207db578-396e-4ff2-ad94-6d7a7dba16f7",
                                                "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                                                "text": "Les vieillards sont le plus souvent presbytes."
                                            },
                                            {
                                                "example_id": "81005f53-b5e9-443c-a3b8-532be59756ab",
                                                "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                                                "text": "Je le vois soudain en personne en face de moi, posant son binocle devant ses yeux presbytes, sursautant dès les premiers mots, puis, avec sa façon colérique, frappant brusquement du poing sur la table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6129df53-adea-3f29-97ee-59f54dfe3cf1",
                                        "entry_id": "fceded11-acc1-3956-b750-421369694379",
                                        "glosses": [
                                            "Qui a une vision générale des êtres et des choses, qui ne discerne pas leurs aspects immédiats, partiels."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ecbd90-2163-42f5-b5dd-c3004a547cb9",
                                                "sense_id": "6129df53-adea-3f29-97ee-59f54dfe3cf1",
                                                "text": "Il était de ces esprits presbytes, qui sont gênés, de près. Ils ont parfois du génie, et butent à chaque pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "presbyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3aa9bec-a45d-30a6-952e-a43e096631ce",
                                        "entry_id": "acf5d894-d7f4-3bd1-9f90-5a8f71e8b110",
                                        "glosses": [
                                            "Personne qui voit mieux de loin que de près, à cause de la moindre accommodation de l’œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476dad5c-70eb-4c23-bc1b-dbf1b5f25d75",
                                                "sense_id": "f3aa9bec-a45d-30a6-952e-a43e096631ce",
                                                "text": "Les presbytes ne peuvent lire qu’avec un verre convexe."
                                            },
                                            {
                                                "example_id": "35cc5bbc-02a5-478c-86c0-dde2e8caecb7",
                                                "sense_id": "f3aa9bec-a45d-30a6-952e-a43e096631ce",
                                                "text": "Un jour, j'avais demandé à un ophtalmologiste s'il était possible de ne pas devenir presbyte en vieillissant. Il avait ri et m'avait répondu : « Je ne connais personne dans ce cas. ». — (Haruki Murakami, Autoportrait de l'auteur en coureur de fond traduit du japonais par Hélène Morita, 2007.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
