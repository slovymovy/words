                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4cfa8eee-1768-43ae-8f7f-e84fc5fd6703",
                        "entry_id": "f07e78ed-5d3d-3838-9395-d641b3f61530",
                        "tags": [
                            "plural"
                        ],
