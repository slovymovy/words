                        "examples": [
                            {
                                "example_id": "b1f38659-7186-401b-8102-ae914a830c34",
                                "sense_id": "6e31180a-1bd8-397e-ab2b-21e1434624c8",
                                "text": "Для прочности крыши необходимо прокрыть берестой между двух рядов тёса."
                            }
                        ]
