                        "examples": [
                            {
                                "example_id": "e5981c65-974b-426c-a953-7768dcedbd64",
                                "sense_id": "fabd43df-fbb3-33cb-88b3-dd4b5f0dc0df",
                                "text": "De buikoperatie duurde vijf uur en vanaf dat moment was het weer heel langzaam beginnen met herstellen, bewegen. Dinsdag kreeg ze van de dokter te horen dat ze het water in mocht, drie weken sneller dan een normale patiënt, maar Dekker is dan ook topsporter."
                            },
                            {
                                "example_id": "a0d5a1a7-dd7e-4516-aae3-68f149a94bc4",
                                "sense_id": "fabd43df-fbb3-33cb-88b3-dd4b5f0dc0df",
                                "text": "Castro schrijft dat hij verwachtte dat hij een zware buikoperatie in 2006 niet zou overleven. Castro droeg destijds daarom de macht over aan zijn broer Raúl, die het land nog altijd leidt."
                            }
                        ]
                    }
