                                                "sense_id": "e967f017-bd7e-3e95-bb89-3b16513421f9",
                                                "text": "Das Allerheiligste durfte nur am Versöhnungsfest betreten werden."
                                            },
                                            {
                                                "example_id": "d03937d8-9e21-44fa-bbf5-63351ccdd0c6",
                                                "sense_id": "e967f017-bd7e-3e95-bb89-3b16513421f9",
                                                "text": "„Der Überlieferung nach stand das Allerheiligste im Inneren des Tempels auf dem Felsen selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
