                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5c8da4-87e7-47f4-aacb-0280e49c6cbb",
                                                "sense_id": "12720c45-5b03-3c72-84e4-ebbbd7ff25f9",
                                                "text": "Figured wood is especially sought after for its distinctive texture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12da7a04-bf2d-3e77-b10f-4f4df6fb6e7f",
                                        "entry_id": "b82b40eb-9d96-3a12-a4a0-94884b6542c6",
                                        "glosses": [
                                            "Adorned with a figure or figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ad9457-2d46-4f91-b7cc-01de4e101d5f",
                                                "sense_id": "12da7a04-bf2d-3e77-b10f-4f4df6fb6e7f",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            },
                                            {
                                                "example_id": "672b8da2-5c4c-45d2-982d-705048557d21",
                                                "sense_id": "12da7a04-bf2d-3e77-b10f-4f4df6fb6e7f",
                                                "text": "Some of these mosaics have been carefully altered to replaced figured by non-figured designs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
