                                    {
                                        "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                        "entry_id": "dc962aad-be06-3449-a310-f15641c1d040",
                                        "glosses": [
                                            "Générateur de courant alternatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05734080-1b9d-4fde-b9a1-b1ee4a25141b",
                                                "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                                "text": "Un alternateur synchrone doit souvent mettre sous tension une ligne à haute tension lorsque cette dernière nʼest pas branchée au point dʼinterconnexion avec le réseau."
                                            },
                                            {
                                                "example_id": "fbcbfbef-af03-40ff-bdb4-355b1b0281e2",
                                                "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                                "text": "Les turbines convertissent la force motrice de l’eau en énergie mécanique, puis les alternateurs transforment cette énergie mécanique en électricité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "573089d3-50f1-43f2-b090-4840525d06cb",
                        "source_entry_id": "876c3b32-1e37-31c8-9317-59ae0545a434",
                        "source_sense_id": "2f2a49b8-ea0d-3058-a9f7-3eef3655bfb1",
                        "source_sense_description": "an electric generator which produces alternating current",
                        "target_lang_word": "Lichtmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lichtmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                        "entry_id": "afc0f4ce-a989-304c-a304-7e11be22d761",
                                        "glosses": [
                                            "ein Generator zur Umwandlung von Bewegungsenergie in elektrische Energie, die hauptsächlich zur Lichterzeugung benutzt wird, aber auch andere elektrische Komponenten mit Strom versorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c169c284-e9aa-43b9-92be-59656129792a",
                                                "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                                "text": "Der Anlasser im Auto startet den Motor und zieht den Gleichstrom dafür von der Batterie, hiernach übernimmt die Lichtmaschine die Stromversorgung der Zündspulen im Verbrennungsmotor."
                                            },
                                            {
                                                "example_id": "a0515d52-ffc7-472b-8d27-8738bf9d9696",
                                                "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                                "text": "Wenn die Lichtmaschine im Auto defekt ist, fährt man noch einige Kilometer auf Batterie weiter und bleibt irgendwann stehen."
                                            },
                                            {
                                                "example_id": "426c46be-20e9-4738-8994-8ef80d97cbb3",
                                                "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                                "text": "Die Lichtmaschine sorgt im Motorbetrieb nicht nur für Licht, sondern lädt auch die Autobatterie immer wieder auf."
                                            },
                                            {
                                                "example_id": "e4e04b3a-5505-4b0b-8d50-7263d3ede78e",
                                                "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                                "text": "Defekte Lichtmaschinen werden im Austauschverfahren erneuert, und stets recyclet."
                                            },
                                            {
                                                "example_id": "24f15494-2a33-45bd-bcf7-2b64368afc18",
                                                "sense_id": "b427a19d-7cd6-37f9-b4da-8ba67cec4923",
                                                "text": "Auch andere Fahrzeuge, wie Busse, Bahnen und Fahrräder haben eine Lichtmaschine."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
