                                        "sense_id": "198b905d-2cfc-3583-9466-7d15c91f9e73",
                                        "entry_id": "5e1d7185-1e0c-31f2-bbf6-f9e4c8e3baef",
                                        "glosses": [
                                            "US-Bundesstaat im Nordwesten des amerikanischen Kontinents"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3f7f51-bf12-4ab4-8561-c066a1bd1997",
                                                "sense_id": "198b905d-2cfc-3583-9466-7d15c91f9e73",
                                                "text": "Alaska wurde am 3. Januar 1959 als 49. Bundesstaat Teil der Vereinigten Staaten von Amerika."
                                            },
                                            {
                                                "example_id": "8708ddb5-e247-412c-8041-57e28ba9eb5e",
                                                "sense_id": "198b905d-2cfc-3583-9466-7d15c91f9e73",
                                                "text": "Im Süden von Alaska regnet oder schneit es fast jeden Tag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c7f40ce-7f41-36f2-a42b-7a6f92f6fc34",
                                        "entry_id": "5e1d7185-1e0c-31f2-bbf6-f9e4c8e3baef",
                                        "glosses": [
                                            "nordamerikanische Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e091b62-7792-4907-95cd-424004125857",
                                                "sense_id": "6c7f40ce-7f41-36f2-a42b-7a6f92f6fc34",
                                                "text": "Die Halbinsel Alaska grenzt im Norden an das nordamerikanische Festland und erstreckt sich in südwestlicher Richtung bis zu den Aleuten."
                                            },
                                            {
                                                "example_id": "60439ebc-9ff9-4929-aac1-9d51e58ca7a8",
                                                "sense_id": "6c7f40ce-7f41-36f2-a42b-7a6f92f6fc34",
                                                "text": "Auf der Halbinsel Alaska befinden sich zahlreiche Vulkane und Nationalparks."
                                            },
                                            {
                                                "example_id": "03f9cf5b-8f2b-4aa4-a8fc-1f0455b88ef6",
                                                "sense_id": "6c7f40ce-7f41-36f2-a42b-7a6f92f6fc34",
                                                "text": "„Wenn sich der russische Zar auch nicht viel um die Tschuktschenhalbinsel gekümmert hat, war seine Regierung doch klug genug, Fehler, wie sie in Alaska gemacht wurden, zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
