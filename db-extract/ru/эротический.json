                                        "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                        "entry_id": "54efa50f-4ba1-3a1c-bd22-805b78b503e3",
                                        "glosses": [
                                            "Relating to or tending to arouse sexual desire or excitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072089fe-41cd-4fd6-b06b-fa0a31cbe873",
                                                "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                                "text": "erotic entertainment and services"
                                            },
                                            {
                                                "example_id": "5a8d76ef-b05f-4ef4-a7bb-3fe5ca7576ec",
                                                "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                                "text": "I had an erotic dream last night."
                                            },
                                            {
                                                "example_id": "cec3a55d-9816-4c49-b5b1-1f931aba3aba",
                                                "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                                "text": "There's a local cinema that only shows erotic movies."
                                            },
                                            {
                                                "example_id": "4b249203-6b19-4c55-a845-f1a0b8001761",
                                                "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                                "text": "The brain of a calf, sheep, and pig, young and served fresh, is reputedly erotic in its effects."
                                            },
                                            {
                                                "example_id": "d456faf3-dc5b-4e62-b64e-ba2045721a64",
                                                "sense_id": "357ebf6f-2ac8-356e-81a9-07c75550f522",
                                                "text": "Later ages contributed their own epichorial and distinctive manner to these universal delights in the erotic. In China, The Golden Lotus is an amazing sustained achievement."
                                            }
                                        ]
                                    }
