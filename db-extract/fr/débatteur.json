                "senses": [
                    {
                        "sense_id": "db967294-a35f-3ad2-8887-58af70cadc80",
                        "entry_id": "7958168f-b2c7-3028-882e-ce0ac4c4a2ef",
                        "glosses": [
                            "Celui qui débat, qui participe à un ou plusieurs débats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e6bf4b-8402-4398-911e-4b7201af0add",
                                "sense_id": "db967294-a35f-3ad2-8887-58af70cadc80",
                                "text": "Blain s'y révèle le penseur par excellence de la laïcité, un débatteur cohérent."
                            },
                            {
                                "example_id": "56f0366b-ecf3-416f-a87c-59732caa484f",
                                "sense_id": "db967294-a35f-3ad2-8887-58af70cadc80",
                                "text": "Un problème ? Vite, un débat ! Avec un débatteur pour et un débatteur contre, dont la mission n'est pas d’échanger mais de s’opposer. L’invective est souhaitée, la nuance malvenue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "922265d0-f750-4917-a1c8-5f7529cde44d",
                        "source_entry_id": "7958168f-b2c7-3028-882e-ce0ac4c4a2ef",
                        "source_sense_id": "db967294-a35f-3ad2-8887-58af70cadc80",
