                    "sense_id": "d0cc6fae-584c-39a5-b2ce-8f290310b494",
                    "sense_definition": "Qui manque de netteté, de précision ou de fermeté dans sa forme ou son allure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flou_instable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme avançait dans la neige d'un pas lent et <w>incertain</w>.",
                            "target_lang_translations": {
                                "en": "The old man walked through the snow with a slow, <w>unsteady</w> step.",
                                "ru": "Старик шёл по снегу медленным и <w>нетвёрдым</w> шагом.",
                                "de": "Der alte Mann stapfte mit langsamen, <w>unsicheren</w> Schritten durch den Schnee.",
                                "es": "El anciano avanzaba por la nieve con paso lento y <w>vacilante</w>.",
                                "zh": "老人在雪地里慢慢走着，步履<w>蹒跚</w>。"
                            }
                        },
                        {
                            "text": "Une lueur <w>incertaine</w> éclairait faiblement le couloir au milieu de la nuit.",
                            "target_lang_translations": {
