                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b673d9-cf82-478e-a4e3-a7fa907c4054",
                        "source_entry_id": "18a5b042-43c7-3da3-8f53-16443cd066cf",
                        "source_sense_id": "acc7d559-cc5f-39c6-80df-0c46483a9a9c",
                        "target_lang_word": "infelicitous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infelicitous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9811a698-1627-3c9f-8d5b-c8c2ca8ef7be",
                                        "entry_id": "0ec750fb-4839-3e3f-8329-5cce2a60b873",
                                        "glosses": [
                                            "Unhappy or unfortunate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de16b13e-77dc-419c-9e02-ee3733715520",
                                                "sense_id": "9811a698-1627-3c9f-8d5b-c8c2ca8ef7be",
                                                "text": "My last run this month is an amazing performance of an \"A2/3\" Pacific, No. 60524, Herringbone (could there possibly be a more infelicitous name for a locomotive than this, let alone for the unhappy horse which first had to bear it?), […]."
                                            },
                                            {
                                                "example_id": "c73c15cc-94a5-4ef3-a8f5-c99de0178700",
                                                "sense_id": "9811a698-1627-3c9f-8d5b-c8c2ca8ef7be",
                                                "text": "If leading a \"dog's life\" be considered a peculiar phase of human misery, the life of a Boys' Dog is still more infelicitous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa41f6f-333d-3346-abba-73755d2742dc",
                                        "entry_id": "0ec750fb-4839-3e3f-8329-5cce2a60b873",
                                        "glosses": [
                                            "Inappropriate or awkward; not well said, expressed, or done."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b6050c-c89b-47bd-98c4-96c50e35adff",
                                                "sense_id": "8fa41f6f-333d-3346-abba-73755d2742dc",
                                                "text": "\"Now, you've got just grounds for shooting me,\" he said gaily, and instantly regretted his infelicitous remark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dabcd3f-c15a-30a7-91da-345dc6706619",
