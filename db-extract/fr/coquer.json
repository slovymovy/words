                ],
                "senses": [
                    {
                        "sense_id": "cd5918fd-2e6e-3c0a-80a1-09e3b28a72a5",
                        "entry_id": "d31fa705-05a4-3ef9-95ab-0e765eb48498",
                        "glosses": [
                            "Embrasser ; faire une bise, un bisou ou un baiser."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4d28a558-8c5f-48d1-a0f9-2d1b444b7481",
                                "sense_id": "cd5918fd-2e6e-3c0a-80a1-09e3b28a72a5",
                                "text": "Guignol - Ah ! maître ; faites vite... mes yeux n'y voient plus.. Si quelqu'un m'apportait une bonne soupe mitonnée, je le coquerais sur les deux joues."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8613fa5-f3c4-3ea1-ad16-3c78eb4225ed",
                        "entry_id": "d31fa705-05a4-3ef9-95ab-0e765eb48498",
                        "glosses": [
                            "Dénoncer, en parlant de quelqu’un."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "aafb1766-31cd-4388-826a-ad6ac900164a",
                                "sense_id": "a8613fa5-f3c4-3ea1-ad16-3c78eb4225ed",
                                "text": "— Que veux-tu, mon ami ? je ne suis pas sorcier, si l'on ne t’avait pas coqué (dénoncé), je ne viendrais pas interrompre ton sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4fc9de0-36a7-3706-be4a-dd96091b7874",
                        "entry_id": "d31fa705-05a4-3ef9-95ab-0e765eb48498",
                        "glosses": [
                            "Arnaquer, en parlant de quelqu’un."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "74745138-4fa9-3386-83de-ad0e86eefdf9",
                        "entry_id": "d31fa705-05a4-3ef9-95ab-0e765eb48498",
                        "glosses": [
                            "(Louisiane) Baiser ; sauter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "02fd0f9a-b784-40e4-b9e6-26da8f1636a6",
                                "sense_id": "74745138-4fa9-3386-83de-ad0e86eefdf9",
                                "text": "Parce que, moi, je sens avant Emmanuel quand il y a une poule dans le quartier prête à se laisser coquer par lui."
                            },
                            {
                                "example_id": "babebdaa-3eaa-4d6f-b05e-b28fa8cec648",
                                "sense_id": "74745138-4fa9-3386-83de-ad0e86eefdf9",
                                "text": "Il la coquait sans arrêt comme s'il avait hâte de rattraper des années d’abstinence forcée et elle s'amusait plus de ce qu'elle tenait pour des gamineries de bougre trop savant, qu'elle ne jouissait vraiment."
                            },
                            {
                                "example_id": "87a3734b-1ba0-4a42-a6a2-e8172c0c28c5",
                                "sense_id": "74745138-4fa9-3386-83de-ad0e86eefdf9",
                                "text": "On note aussi la différence de vocabulaire utilisée en fonction de la signification profonde de l'acte : “ Mais je ne veux pas la coquer ! J'ai envie de lui faire l'amour : nuance ! ” (Dracius 159)."
                            }
                        ]
                    }
                ],
