                            {
                                "example_id": "a9843e56-50a7-44ff-8f4f-1665579becd6",
                                "sense_id": "f1e1254a-9fd2-3d4a-91e5-9d87123ec2e3",
                                "text": "„Die auf die Aufhebung der Erbengemeinschaft gerichtete Erbteilungsklage ist ein Fall der Teilungsklage nach § 830 ABGB.“"
