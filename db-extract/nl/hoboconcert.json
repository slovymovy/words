                        "examples": [
                            {
                                "example_id": "5d64ed6a-caf8-42f1-9037-51260b089b52",
                                "sense_id": "dee6b204-a6f8-3dde-9642-c90968d07a17",
                                "text": "Met de enkele weken oude baby hurkte ik neer bij een van mijn luidsprekerboxen, waaruit Bachs hoboconcert snerpte. Het volume stond hoog, maar het leek de kleine niet te deren."
                            },
                            {
                                "example_id": "c6385154-92b7-4db7-b5d8-a5b1a20722c5",
                                "sense_id": "dee6b204-a6f8-3dde-9642-c90968d07a17",
                                "text": "De kandidaten dirigeerden, uit hun hoofd, symfoniedelen van Beethoven, Mendelssohn en Brahms. Volgens Anne Knappstein ging het om 'toegankelijk maar moeilijk' repertoire. Coach-dirigent Verbeek liet zien en horen hoe het moest in Mozarts hoboconcert. De zaal was niet uitverkocht."
                            }
                        ]
                    }
