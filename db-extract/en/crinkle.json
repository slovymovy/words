                        "glosses": [
                            "To fold, crease, crumple, or wad."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c3eccd3a-0fb6-4f44-bb58-4c281a53a3c4",
                                "sense_id": "a4b592c7-639c-33a0-bc0c-1fd4129f7973",
                                "text": "He crinkled the wrapper and threw it out."
                            },
                            {
                                "example_id": "0c792d4f-2d55-4aa1-829b-c6d90c2af955",
                                "sense_id": "a4b592c7-639c-33a0-bc0c-1fd4129f7973",
                                "text": "The old man's lined face crinkled into a smile."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ca8b30-04d8-3b85-8b4b-6aeba89f21bc",
                        "entry_id": "8b52eef4-5f28-349a-9981-e43f1795b0c1",
                        "glosses": [
                            "To rustle, as stiff cloth when moved."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "722f9742-2b50-4271-a133-266bdb9906b0",
                                "sense_id": "87ca8b30-04d8-3b85-8b4b-6aeba89f21bc",
                                "text": "The green wheat crinkles like a lake."
                            },
                            {
                                "example_id": "d552c030-85b6-44fb-9d76-40fe8413310f",
                                "sense_id": "87ca8b30-04d8-3b85-8b4b-6aeba89f21bc",
                                "text": "All the rooms were full of crinkling silks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "764220ca-727b-4b87-a3b6-ef9cdbd5c285",
                        "source_entry_id": "8b52eef4-5f28-349a-9981-e43f1795b0c1",
                        "source_sense_description": "to fold, crease, crumple, or wad",
                        "target_lang_word": "froisser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e242b5f1-51b1-3911-8dde-4ecf361a398d",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Frotter fortement, meurtrir par une pression violente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6348b8ac-363b-4b41-9147-cebd03e9060b",
                                                "sense_id": "e242b5f1-51b1-3911-8dde-4ecf361a398d",
                                                "text": "Il s’est froissé un nerf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba021078-08e7-3880-9668-2877526f3acb",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Comprimer fortement une artère, pour arrêter une hémorragie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f904c91d-3f74-303b-bfc5-c524642d7a88",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Exercer une brusque pression contre le fleuret de l’adversaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0b36fb-b89d-3908-abf1-a118856ee2d9",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Chiffonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddc65cf-ae24-4757-973b-aa574f26fb75",
                                                "sense_id": "ef0b36fb-b89d-3908-abf1-a118856ee2d9",
                                                "text": "Je froissai le PV en boule avant de le jeter dans le caniveau."
                                            },
                                            {
                                                "example_id": "ebcc395f-2afa-4011-94e4-7fec754598c4",
                                                "sense_id": "ef0b36fb-b89d-3908-abf1-a118856ee2d9",
                                                "text": "Voici les signes avant-coureurs de la mort : dans les accès de folie, la phase du rire, fatale ; dans la démence, le geste répétitif d'effranger et de froisser les draps du lit, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Fâcher, blesser, heurter, choquer, surtout en parlant d’intérêts, d’opinions, de sentiments, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e9dddd-ef1f-4dbb-b15c-1a24b547625e",
                                                "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                                "text": "Et j’avouerai à Votre Majesté que je suis souvent froissé par la franchise de ses conseils."
                                            },
                                            {
                                                "example_id": "93b35aff-a2df-4537-83b5-ce031172ef60",
                                                "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                                "text": "Les spectateurs de cette scène, où tout froissait les sentiments vulgaires de la vie sociale, n'osaient se regarder."
                                            },
                                            {
                                                "example_id": "28801b3f-5f29-49ba-bdb4-6bf824cb5160",
                                                "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                                "text": "Je comprends que ce mythe de la grève générale froisse beaucoup de gens sages à cause de son caractère d'infinité ; […]."
                                            },
                                            {
                                                "example_id": "38be3936-43a9-424c-8888-8de216f7d80e",
                                                "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                                "text": "Son « tu » me froissa un peu. Mais je lui répondis gaminement : « Tu trouves que j'ai engraissé ! » Il partit d'un fou rire. Et, à partir de ce jour, nous nous tutoyâmes et nous devînmes les meilleurs amis du monde."
                                            },
                                            {
                                                "example_id": "82064aaf-19bc-423e-b824-3cf5c0c760be",
                                                "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                                                "text": "— Et c’est pourquoi je voudrais te dire ceci… ne t’en froisse pas surtout… je serais désolé de te froisser… mais il faut que je te le dise…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e284cf26-2363-341d-9222-6348486d89dc",
                                        "entry_id": "16b01dba-0d77-308f-b694-b915d20fea06",
                                        "glosses": [
                                            "Se piquer, se fâcher."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a65e3fbf-215d-4f24-9ed5-7526a203ca50",
                                                "sense_id": "e284cf26-2363-341d-9222-6348486d89dc",
                                                "text": "Il s’est froissé de peu de chose."
                                            },
                                            {
                                                "example_id": "537e093e-d641-4768-afbd-338c3d246e10",
                                                "sense_id": "e284cf26-2363-341d-9222-6348486d89dc",
                                                "text": "Il se froisse d’un rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf129f2-87cc-4e65-bf79-14163fdd0116",
                        "source_entry_id": "8b52eef4-5f28-349a-9981-e43f1795b0c1",
                        "source_sense_description": "to fold, crease, crumple, or wad",
                        "target_lang_word": "knittern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knittern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a648f5c-c4bb-39f8-962d-c023ea2c30a1",
                                        "entry_id": "9c662826-7045-3da5-a8d2-6e690e855310",
                                        "glosses": [
                                            "etwas in Falten legen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c4d7f6-0f51-4a9e-8da0-f4da200186fc",
                                                "sense_id": "9a648f5c-c4bb-39f8-962d-c023ea2c30a1",
                                                "text": "Kohlhof zupft an den Hosenbeinen, krempelt, zerrt, reibt, knittert, bis das gute Stück aussieht wie tagelang getragen."
                                            },
                                            {
                                                "example_id": "be57d555-58f1-48a9-a5b6-eff53d8aad47",
                                                "sense_id": "9a648f5c-c4bb-39f8-962d-c023ea2c30a1",
                                                "text": "Für andere Arbeiten legte er Schnüre unter nasses Papier und erzeugte so eine Art Blinddruck; er knitterte Papierbögen, die – anschließend mit Farbe getränkt – fein verästelte Gewebe erzeugten."
                                            },
                                            {
                                                "example_id": "e0a79d7e-cc39-4f57-9d4a-b9df0ca89e18",
                                                "sense_id": "9a648f5c-c4bb-39f8-962d-c023ea2c30a1",
                                                "text": "Nun überlas er das Billett zum zweitenmal, knitterte es wütend zusammen und warf es gegen die Wand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "416cfcd4-6760-33c2-98ee-824c20d69311",
                                        "entry_id": "9c662826-7045-3da5-a8d2-6e690e855310",
                                        "glosses": [
                                            "sich zusammendrücken, etwas legt sich in Falten"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187cf5f7-90c9-45ea-ab2b-9cc2787dcfa3",
                                                "sense_id": "416cfcd4-6760-33c2-98ee-824c20d69311",
                                                "text": "Jede Textilfaser knittert beim Waschen und richtet sich nach dem Anfeuchten wieder gerade aus."
                                            },
                                            {
                                                "example_id": "befd18e8-5576-467a-9aa1-af1ced46d2f0",
                                                "sense_id": "416cfcd4-6760-33c2-98ee-824c20d69311",
                                                "text": "Zur Anprobe ihrer an die großen Linden-Zeiten erinnernden Garderobe aus weißem Linnen (plus untergewebter Chemie, damit's nicht knittert) schritten die jungen Frauen schon mal unter den grünen Linden entlang."
                                            },
                                            {
                                                "example_id": "41074f8c-bb37-4d92-aec0-6beabb0f8651",
                                                "sense_id": "416cfcd4-6760-33c2-98ee-824c20d69311",
                                                "text": "Immer duftete es hier nach Blumen, selbst zur Winterzeit, und dann brannte hier ein großes Feuer im Kamin; es war so amüsant, davor zu sitzen, hineinzusehen und zu hören, wie es knitterte und knatterte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb745d0d-321f-4959-a9ca-7de63cc731fb",
                        "source_entry_id": "8b52eef4-5f28-349a-9981-e43f1795b0c1",
