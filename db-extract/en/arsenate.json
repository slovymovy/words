                    {
                        "translation_id": "cd918654-5fdb-4f2b-8a49-15e0552ab197",
                        "source_entry_id": "f75e01e7-47e9-3f02-92b7-bcd0432a74cd",
                        "source_sense_description": "salt or ester of arsenic acid",
                        "target_lang_word": "arséniate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arséniate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82f22d68-4dfb-3f6c-86c4-514e02df35a3",
                                        "entry_id": "c779485f-5e7f-37f9-b15c-4ea4f12b6f49",
                                        "glosses": [
                                            "Nom générique des sels composés d’acide arsénique et d’une base, ou de l'anion trivalent obtenu par dissociation de cet acide en solution aqueuse (AsO₄³⁻)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53bc1cf4-b9be-4c1a-9777-b32b94f427d8",
                                                "sense_id": "82f22d68-4dfb-3f6c-86c4-514e02df35a3",
                                                "text": "L'ion arséniate a pour formule brute AsO₄³⁻."
                                            },
                                            {
                                                "example_id": "0fa5b250-62d7-45a1-8fe9-055334b90e79",
                                                "sense_id": "82f22d68-4dfb-3f6c-86c4-514e02df35a3",
                                                "text": "Je l’ai employée avec beaucoup de succès dans le traitement d’une mine de cobalt arsénicale ; j’en ai séparé tout le cobalt et l’arsenic, et en ne traitant que par l’acide nitrique et les alcalis, la majeure partie de ces deux métaux restant unis ensemble à l’état d’arséniate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc8e94b0-6e8c-3ed4-820a-1563584c2b16",
                                        "entry_id": "c779485f-5e7f-37f9-b15c-4ea4f12b6f49",
                                        "glosses": [
                                            "Arséniate de plomb, qui était utilisé comme insecticide."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac22a5cd-24e2-4a8f-9f6d-eb5823e5ceeb",
                                                "sense_id": "dc8e94b0-6e8c-3ed4-820a-1563584c2b16",
                                                "text": "Ils en donnent pour preuve des expériences montrant l’innocuité de l’arséniate sur les perdrix, mais, répliquent les chasseurs, ces tests sont menés sur des perdrix adultes, granivores ; or ce sont les jeunes perdreaux, plus insectivores, qui s’intoxiquent en mangeant des coléoptères."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
