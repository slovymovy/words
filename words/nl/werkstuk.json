{
    "word_family": [
        "werk",
        "werken",
        "werker",
        "werkvloer",
        "werkzaam"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53866f11-bd9d-3b25-a9cd-52394132c4b3",
                    "sense_definition": "Een schriftelijk verslag of project dat door een leerling wordt gemaakt als onderdeel van het schoolwerk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoolwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet voor geschiedenis een <w>werkstuk</w> maken over de Tweede Wereldoorlog.",
                            "target_lang_translations": {
                                "it": "Devo fare una <w>tesina</w> di storia sulla Seconda Guerra Mondiale."
                            }
                        },
                        {
                            "text": "De leraar beoordeelde het <w>werkstuk</w> met een goed cijfer.",
                            "target_lang_translations": {
                                "it": "L'insegnante ha valutato l'<w>elaborato</w> con un buon voto."
                            }
                        }
                    ],
                    "synonyms": [
                        "opstel",
                        "spreekbeurt"
                    ],
                    "common_phrases": [
                        "werkstuk maken",
                        "werkstuk inleveren"
                    ],
                    "target_lang_definitions": {
                        "it": "Un elaborato scritto o un progetto realizzato da uno studente come parte del lavoro scolastico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tesina",
                                "target_lang_sense_clarification": "progetto scritto o ricerca scolastica"
                            },
                            {
                                "target_lang_word": "elaborato",
                                "target_lang_sense_clarification": "lavoro scritto formale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf1657d3-065f-3eb1-96e2-4ee9f38882ba",
                    "sense_definition": "Een object dat met de hand is vervaardigd, vaak als kunstwerk of creatieve uiting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de les handvaardigheid maakte zij een prachtig <w>werkstuk</w> van klei.",
                            "target_lang_translations": {
                                "it": "Durante la lezione di educazione tecnica ha realizzato un bellissimo <w>manufatto</w> di argilla."
                            }
                        },
                        {
                            "text": "Het <w>werkstuk</w> van hout staat nu trots op de schoorsteenmantel.",
                            "target_lang_translations": {
                                "it": "Il <w>manufatto</w> in legno ora fa bella mostra di sé sul caminetto."
                            }
                        }
                    ],
                    "synonyms": [
                        "handwerk",
                        "kunstwerk"
                    ],
                    "common_phrases": [
                        "mooi werkstuk"
                    ],
                    "target_lang_definitions": {
                        "it": "Un oggetto realizzato a mano, spesso come opera d'arte o espressione creativa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "manufatto",
                                "target_lang_sense_clarification": "oggetto prodotto artigianalmente"
                            },
                            {
                                "target_lang_word": "lavoro manuale",
                                "target_lang_sense_clarification": "oggetto creato durante attività manuali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4ed5bcd-ab9a-3993-aa01-ca34216d567b",
                    "sense_definition": "Een object of onderdeel dat in een productieproces wordt bewerkt of vervaardigd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machine klemt het <w>werkstuk</w> stevig vast tijdens het frezen.",
                            "target_lang_translations": {
                                "it": "La macchina blocca saldamente il <w>pezzo</w> durante la fresatura."
                            }
                        },
                        {
                            "text": "Controleer altijd of het <w>werkstuk</w> goed is uitgelijnd voor de bewerking.",
                            "target_lang_translations": {
                                "it": "Controlla sempre che il <w>pezzo</w> sia ben allineato prima della lavorazione."
                            }
                        }
                    ],
                    "synonyms": [
                        "product",
                        "onderdeel"
                    ],
                    "common_phrases": [
                        "werkstuk bewerken"
                    ],
                    "target_lang_definitions": {
                        "it": "Un oggetto o componente che viene lavorato o prodotto in un processo industriale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pezzo",
                                "target_lang_sense_clarification": "componente in lavorazione meccanica"
                            },
                            {
                                "target_lang_word": "pezzo da lavorare",
                                "target_lang_sense_clarification": "termine tecnico per oggetto in fase di lavorazione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d42a5cf-7261-3a5c-a49a-28d780fa0667",
                    "sense_definition": "Een tastbaar resultaat van arbeid, hobby of studie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleuters maakten mooie <w>werkstukjes</w> voor Moederdag.",
                            "target_lang_translations": {
                                "it": "I bambini dell'asilo hanno realizzato dei bei <w>lavoretti</w> per la Festa della Mamma."
                            }
                        },
                        {
                            "text": "Na maanden van hobbyen was het <w>werkstuk</w> eindelijk helemaal af.",
                            "target_lang_translations": {
                                "it": "Dopo mesi di hobby, il <w>lavoro</w> era finalmente finito."
                            }
                        }
                    ],
                    "synonyms": [
                        "resultaat",
                        "creatie"
                    ],
                    "target_lang_definitions": {
                        "it": "Un risultato tangibile di lavoro, hobby o studio."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lavoro",
                                "target_lang_sense_clarification": "risultato di un'attività creativa"
                            },
                            {
                                "target_lang_word": "creazione",
                                "target_lang_sense_clarification": "prodotto finale di un'attività"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}