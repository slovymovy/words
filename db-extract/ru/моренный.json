                    {
                        "translation_id": "557effe6-d28b-4de7-abbf-6104dce0d25b",
                        "source_entry_id": "66e61f54-007e-399b-9ed7-8cff92be0c49",
                        "source_sense_id": "3e8f6223-4ce1-33d9-b220-e2c919b53cb1",
                        "target_lang_word": "morenowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f44aba6d-9b4c-4aed-8d35-95e2071fe582",
                        "source_entry_id": "66e61f54-007e-399b-9ed7-8cff92be0c49",
                        "source_sense_id": "3e8f6223-4ce1-33d9-b220-e2c919b53cb1",
                        "target_lang_word": "morainique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morainique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8001a7-6276-3833-97a6-74934b7b8c1a",
                                        "entry_id": "e6146907-f286-3451-beda-7ff16733baae",
                                        "glosses": [
                                            "Relatif à une moraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a635a0a6-084e-4042-afaf-e628a542939b",
                                                "sense_id": "4d8001a7-6276-3833-97a6-74934b7b8c1a",
                                                "text": "Des comblements très fréquents, dont la nature indiscutablement morainique est attestée par la présence de galets striés, occupent le plus souvent le confluent des vallons latéraux […]"
                                            },
                                            {
                                                "example_id": "f24aa742-f625-4474-88a8-32e5e75f71df",
                                                "sense_id": "4d8001a7-6276-3833-97a6-74934b7b8c1a",
                                                "text": "Quinze cents mètres sous le sol, au fond de l’énorme entonnoir où s’effondrent les pentes, gît un alpage misérable, semé de débris morainiques."
                                            },
                                            {
                                                "example_id": "4dabde9d-1ccb-449f-8157-c1fbef27cfd9",
                                                "sense_id": "4d8001a7-6276-3833-97a6-74934b7b8c1a",
                                                "text": "La description de Ch. Depéret touchant le cône d'alluvions préglaciaires se soudant vers l'amont aux dépôts morainiques de Vancia et se dirigeant à l'aval vers la vallée de Tassin doit être complétée […]."
                                            },
                                            {
                                                "example_id": "f4015d5e-f9a0-4275-a745-75edc5c741c5",
                                                "sense_id": "4d8001a7-6276-3833-97a6-74934b7b8c1a",
                                                "text": "De nombreux cordons morainiques recensés entre les isohypses 1050 m et 520 m, attestent de plusieurs niveaux de stationnement et, peut-être, de faibles récurrences du glacier."
                                            }
                                        ]
                                    }
                                ]
