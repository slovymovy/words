                "senses": [
                    {
                        "sense_id": "ad462ecf-e969-3fc4-9a39-9d0c1f4a3319",
                        "entry_id": "d7dfdbfe-2cfc-3676-ab39-2a16dfb8ddaa",
                        "glosses": [
                            "Nom familier de l’ictère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c17d56f-3dd9-4b2f-8184-41d2abd4e920",
                                "sense_id": "ad462ecf-e969-3fc4-9a39-9d0c1f4a3319",
                                "text": "Cette jeune fille a la jaunisse."
                            },
                            {
                                "example_id": "346faadf-a80b-4164-bb11-b9192813f41e",
                                "sense_id": "ad462ecf-e969-3fc4-9a39-9d0c1f4a3319",
                                "text": "Deslignières crèvera d’un coup de sang, Piot et Rivoire ont eu la jaunisse."
                            },
                            {
                                "example_id": "ea28f241-0333-45cb-a92b-a29f79f45532",
                                "sense_id": "ad462ecf-e969-3fc4-9a39-9d0c1f4a3319",
                                "text": "M. Picaud la trouva très malade, déclara qu’une jaunisse s’était greffée sur l’anémie et donna l’ordre de lui enlever tout de suite son bébé."
                            },
                            {
                                "example_id": "f12a5fb8-000b-4895-a472-7bb477862b6f",
                                "sense_id": "ad462ecf-e969-3fc4-9a39-9d0c1f4a3319",
                                "text": "On murmure devant moi : Si ton frère te voyait, il en ferait une jaunisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a03ff7-62c2-3f34-b2fb-2a059fa67c6a",
                        "entry_id": "d7dfdbfe-2cfc-3676-ab39-2a16dfb8ddaa",
                        "glosses": [
                            "Nom de diverses maladies d’origine virale de certaines plantes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d844f9d-dc8e-4326-9086-e0d31961ad5d",
                        "source_entry_id": "d7dfdbfe-2cfc-3676-ab39-2a16dfb8ddaa",
                        "source_sense_description": "nom courant de l’ictère",
                        "target_lang_word": "Gelbsucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelbsucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                        "entry_id": "9f9abe52-8951-3e97-bc08-1df58dcb1b3d",
                                        "glosses": [
                                            "Gelbfärbung von Haut, Schleim- und Bindehaut infolge Erkrankung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e5e910-42e5-4be0-9608-33ec9370e012",
                                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                                "text": "„Gelbsucht und Typhus sind aus der Mode gekommen.“"
                                            },
                                            {
                                                "example_id": "d008d1aa-7bc8-4b7e-86e7-8a379b68a19e",
                                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                                "text": "„Sie hat Gelbsucht gehabt, sie hat vier Monate im Bett gelegen.“"
                                            },
                                            {
                                                "example_id": "7938e407-11a0-4125-842b-9aeb4198aabe",
                                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                                "text": "„Am Leben war ich, auch wenn ich infolge von Hunger und Gram Gelbsucht bekam.“"
                                            },
                                            {
                                                "example_id": "89572cf2-5d29-4326-8610-98ca081f7efc",
                                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                                "text": "„Man könnte an Gelbsucht denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ce8fdfc-f705-48d5-a4e2-a9c21fbd4fd1",
                        "source_entry_id": "d7dfdbfe-2cfc-3676-ab39-2a16dfb8ddaa",
                        "source_sense_description": "nom courant de l’ictère",
                        "target_lang_word": "jaundice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaundice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                        "entry_id": "4e5960b7-7a5b-3180-8085-e09a7949ca57",
                                        "glosses": [
                                            "A morbid condition, characterized by yellowness of the eyes, skin, and urine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ee85cf-aad5-4fc1-866b-1f1813b0fff2",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "Why ſhould a man whoſe bloud is warme within, / Sit like his Grandſire, cut in Alabaſter? / Sleepe when he wakes? and creep into the Iaundies / By being peeuiſh?"
                                            },
                                            {
                                                "example_id": "b3080ead-776b-44c2-a311-3c3fdf17ce18",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "But look in this new mirror, lovely friend. / Both gods and fairies wait on lovers' wills. / That jaundices be changed to daffodils!"
                                            },
                                            {
                                                "example_id": "b231bf57-fbed-4a29-aae1-2e24538efb05",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "In British folk medicine there are some unusual remedies for jaundice. A bizarre superstition from Staffordshire is that if a bladder is filled with the patient's urine and placed near the fire, as it dries out, the patient will recover (Black 1883: 56)."
                                            },
                                            {
                                                "example_id": "47b9fe5e-6f9a-4704-b5d6-2ff0fd7780f6",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "Just ask the doctors how many cases of infantile jaundice in newborn babies have this scene that particular week?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b021dae-0154-3532-91a1-f15a3d2f1bdb",
                                        "entry_id": "4e5960b7-7a5b-3180-8085-e09a7949ca57",
                                        "glosses": [
                                            "A feeling of bitterness, resentment or jealousy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d3874a-e4ad-49ad-8937-51dddc2995ea",
                                                "sense_id": "7b021dae-0154-3532-91a1-f15a3d2f1bdb",
                                                "text": "No, sir, he, / Vex'd with a morbid devil in his blood / That veil'd the world with jaundice, hid his face / From all men, and commercing with himself, / He lost the sense that handles daily life— […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaundice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05caf614-ad93-3b3c-8775-999ee2ee2ebe",
                                        "entry_id": "dd6007d2-5ee0-3bd5-9800-9a9dd4aa69ed",
                                        "glosses": [
                                            "To affect with jaundice; to color by prejudice or envy; to prejudice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b6bd08a-fc7d-44c1-a340-fb77c78f9a81",
                                                "sense_id": "05caf614-ad93-3b3c-8775-999ee2ee2ebe",
                                                "text": "The envy of wealth jaundiced his soul."
                                            }
                                        ]
