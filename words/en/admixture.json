                        "conglomeration"
                    ]
                },
                {
                    "sense_id": "91552d1c-7bcb-352e-8dbc-238b5385be56",
                    "sense_definition": "The introduction or mixing of genetic material from a distinct population into an existing gene pool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers found evidence of archaic genetic <w>admixture</w> in modern populations."
