                "senses": [
                    {
                        "sense_id": "f6108d5a-484c-3c74-8cee-f0e2361a79df",
                        "entry_id": "bd0db267-8b41-30ff-91ca-64a0ea0d7863",
                        "glosses": [
                            "vooral van mensen dieren en hun lichaamsdelen: een mooie vorm hebbende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5859dc2-1be5-45c9-8f8d-d827ad38067a",
                                "sense_id": "f6108d5a-484c-3c74-8cee-f0e2361a79df",
                                "text": "Bart Ceulemans, tot vorig jaar leraar economie op een middelbare school in Zeeuws-Vlaanderen, begrijpt er weinig van. Bloot en seksualiteit zijn prominenter aanwezig dan ooit en tegelijkertijd neemt de preutsheid toe. Niet als het ideale lichamen betreft, „modieus bloot” zoals hij het noemt. Het sixpack, de welgevormde borst. Daarover halen jongeren hun schouders op. Maar juist over „gewoon bloot”, een normaal lijf met normale borsten, hun eigen lichaam vaak, doen ze steeds onverdraagzamer. „Alsof de verboden vrucht van weleer is teruggekomen.”"
                            }
                        ]
                    }
