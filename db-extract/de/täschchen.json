                "senses": [
                    {
                        "sense_id": "7725db24-6d24-3408-a30f-cecb90f33dfd",
                        "entry_id": "2f67ae27-4562-3b8c-b15d-10a751fd4c74",
                        "glosses": [
                            "(kleine) Tasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fe5d9b-21ca-4d73-8f0e-6f0b06c20868",
                                "sense_id": "7725db24-6d24-3408-a30f-cecb90f33dfd",
                                "text": "„Das Mädchen kramte in seinem Täschchen und hielt mir einen Fünfzigmarkschein hin.“"
                            },
                            {
                                "example_id": "6e374bc2-b56a-4265-9a45-3ef1477d4192",
                                "sense_id": "7725db24-6d24-3408-a30f-cecb90f33dfd",
                                "text": "„Gleich einem Flummi prallte das Täschchen graziös von der Halbglatze ab.“"
                            },
                            {
                                "example_id": "2a5c8fd7-4066-4dd1-8e1f-90cf54cc014f",
                                "sense_id": "7725db24-6d24-3408-a30f-cecb90f33dfd",
                                "text": "„Die schwarzhaarige, hübsche Mimi verstand zwar nicht, aber erriet, was er wollte, öffnete ein Täschchen und produzierte das Verlangte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "139ab11b-1014-47f2-add4-dface037dd7d",
                        "source_entry_id": "2f67ae27-4562-3b8c-b15d-10a751fd4c74",
                        "source_sense_id": "7725db24-6d24-3408-a30f-cecb90f33dfd",
