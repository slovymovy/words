                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da542985-c68c-40c5-84ea-0c403686688a",
                                "sense_id": "2ca30496-e7f0-3fc9-8793-83ff87a8c20e",
                                "text": "Die Rohrwand wurde dann meist mit Kalk verputzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be75e266-2632-3bb6-926e-32397e8c75ac",
                        "entry_id": "939b9e9f-5c72-3f81-af0e-b7becb230e12",
                        "glosses": [
                            "äußere Hülle (Wand/Wandung) einer Röhre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ce1664-4cfb-4a8c-b795-81142c36ab1c",
                                "sense_id": "be75e266-2632-3bb6-926e-32397e8c75ac",
                                "text": "„Punkt 1 ist darauf zurückzuführen, daß es an der dem Sensor abgewandten Rohrwand zu Rückstreuung des Ultraschalls kommt, die dann dem eigentlichen Echo überlagert wird und dieses verfälscht.“"
                            },
                            {
                                "example_id": "09836d6e-d887-4cce-bc70-5698492ad083",
                                "sense_id": "be75e266-2632-3bb6-926e-32397e8c75ac",
                                "text": "„Die rauchgasdichten Rohrwände dagegen lassen durch die einfache konstruktive Anordnung leichte Kesselgerüste mit einer besseren Zugänglichkeit bei Reparaturen am Rohrsystem zu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
