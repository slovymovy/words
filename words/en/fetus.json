{
    "word_family": [
        "fetal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2f32ff5-6daf-3ec0-9d5e-94b44d013d50",
                    "sense_definition": "A human embryo after the eighth week of gestation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "developmental_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors monitor the health of the <w>fetus</w> during regular prenatal checkups.",
                            "target_lang_translations": {
                                "zh": "医生在常规产前检查中监测<w>胎儿</w>的健康状况。"
                            }
                        },
                        {
                            "text": "The development of the <w>fetus</w> is a complex process that occurs over many months.",
                            "target_lang_translations": {
                                "zh": "<w>胎儿</w>的发育是一个历时数月的复杂过程。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "developing fetus",
                        "human fetus"
                    ],
                    "target_lang_definitions": {
                        "zh": "妊娠第八周后发育中的人类胚胎，即胎儿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胎儿",
                                "target_lang_sense_clarification": "人类母体中发育后期的幼体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfa0938a-3def-34ff-ae91-bbbe03bcf106",
                    "sense_definition": "An unborn or unhatched vertebrate showing signs of the mature animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "developmental_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fetus</w> of the mammal grows inside the mother until it is ready to be born.",
                            "target_lang_translations": {
                                "zh": "哺乳动物的<w>胎儿</w>在母体内生长，直到准备好出生。"
                            }
                        },
                        {
                            "text": "Researchers studied the <w>fetus</w> of various species to understand early biological growth.",
                            "target_lang_translations": {
                                "zh": "研究人员研究了不同物种的<w>胚胎</w>，以了解早期的生物生长过程。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "animal fetus"
                    ],
                    "target_lang_definitions": {
                        "zh": "已显现成熟动物特征、尚未出生或孵化的脊椎动物幼体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胎儿",
                                "target_lang_sense_clarification": "未出生的脊椎动物"
                            },
                            {
                                "target_lang_word": "胚胎",
                                "target_lang_sense_clarification": "尚未孵化或出生的动物初期发育体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "771a8717-a644-36a6-9271-93cf97767a0a",
                    "sense_definition": "A newborn infant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical texts sometimes used the term <w>fetus</w> to describe a child immediately after birth.",
                            "target_lang_translations": {
                                "zh": "历史文献中有时会使用fetus一词来形容刚出生不久的<w>新生儿</w>。"
                            }
                        },
                        {
                            "text": "The medical report described the <w>fetus</w> as a healthy infant shortly after delivery.",
                            "target_lang_translations": {
                                "zh": "医疗报告将分娩后不久的这名<w>婴儿</w>描述为健康状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neonate",
                        "infant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical and no longer standard in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "刚出生的婴儿（旧用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "新生儿",
                                "target_lang_sense_clarification": "刚出生的婴儿"
                            },
                            {
                                "target_lang_word": "婴儿",
                                "target_lang_sense_clarification": "幼小的孩童"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}