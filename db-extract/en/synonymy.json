                                "text": "sink into synonymy"
                            },
                            {
                                "example_id": "1586328c-8e5f-4dee-9900-aa0818ee7dbe",
                                "sense_id": "45a9a365-6478-32bb-bd68-56a13b126117",
                                "text": "In 1924 this name was reduced to synonymy."
                            }
                        ]
                    },
                    {
                        "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                        "glosses": [
                            "A group or list of synonyms."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fd1de42-1759-4cf7-9204-fd29f41e1bed",
                                "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                                "text": "The synonymy of Tachina is extensive."
                            },
                            {
                                "example_id": "e6a7ff7e-58b2-4da4-9b3d-d07729b013f6",
                                "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                                "text": "Descriptions are followed by a synonymy of the names that have been applied in the literature ."
                            }
                        ]
