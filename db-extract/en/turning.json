                    }
                ],
                "senses": [
                    {
                        "sense_id": "c61adb6b-b2a9-3ff2-a332-ee5fa0026545",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "A turn or deviation from a straight course."
                        ],
                        "tags": [
                            "Ireland",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "09892d4a-8d37-4682-b6a2-ec8898466e87",
                                "sense_id": "c61adb6b-b2a9-3ff2-a332-ee5fa0026545",
                                "text": "Take the second turning on the left."
                            },
                            {
                                "example_id": "7e410aaf-5aff-4d2f-8f76-18c6b896b5d6",
                                "sense_id": "c61adb6b-b2a9-3ff2-a332-ee5fa0026545",
                                "text": "Except for turnings with a deflated rear tire as an outerside tire, difference in the performance is small between fixed control and manual control."
                            }
                        ]
                    },
                    {
                        "sense_id": "44b547cc-e8dc-3cc0-b93f-7db0fbe6450e",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "At hockey, a foul committed by a player attempting to hit the ball who interposes their body between the ball and an opposing player trying to do the same."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c64dfcf3-0393-3735-945c-79990b6ec1e9",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "The cutting of wood or metal on a lathe to shape it as needed."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6f0367ba-bd70-3569-a0ee-19970db2d398",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "The act of one who turns (rotates or twists)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99ce434-5cbb-42a1-a89c-3ca4b5cfb6b0",
                                "sense_id": "6f0367ba-bd70-3569-a0ee-19970db2d398",
                                "text": "Still talking—more to herself than to the children—she swam into a majestical dance of the stateliest balancings, the haughtiest wheelings and turnings aside, the most dignified sinkings, the gravest risings, all joined together by the elaboratest interlacing steps and circles."
                            },
                            {
                                "example_id": "3d44415b-ed23-48f8-ab79-d18087a9a8b1",
                                "sense_id": "6f0367ba-bd70-3569-a0ee-19970db2d398",
                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                            }
                        ]
                    },
                    {
                        "sense_id": "073ea8af-f5cd-3f02-b54a-e80c4b67e510",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "One of the four eras, each lasting for about 21 years, that make up a saeculum according to the Strauss-Howe generational theory."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cafe8b24-749c-4b43-82a0-c3d19a49ea48",
                                "sense_id": "073ea8af-f5cd-3f02-b54a-e80c4b67e510",
                                "text": "Howe and Strauss predicted that in the Fourth Turning, Millennials would unite behind their president."
                            }
                        ]
                    },
                    {
                        "sense_id": "45d8262b-594a-3062-a35e-2c08325636c9",
                        "entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "glosses": [
                            "Shavings produced by turning something on a lathe."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "ae763131-590b-41ca-88b8-157782555fa8",
                                "sense_id": "45d8262b-594a-3062-a35e-2c08325636c9",
                                "text": "The turnings get into your trouser turnups!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b30914c7-278f-4a00-9914-825036d4be50",
                        "source_entry_id": "5900d911-a64d-3d2d-8627-96bf2e8f00d3",
                        "source_sense_description": "A turn or deviation from a straight course",
                        "target_lang_word": "virage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37f178a8-c24e-3e0e-92ac-0d9b719f0243",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Action de faire tourner un véhicule, un avion, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88763f7-5f8c-4d24-b7a7-1a9d5d322fe0",
                                                "sense_id": "37f178a8-c24e-3e0e-92ac-0d9b719f0243",
                                                "text": "Prendre un bon, un mauvais virage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Endroit où l’on tourne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf0dd0a-39ea-4172-81f7-3602e92c72df",
                                                "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                                "text": "Le gamin de 15 ans qui m’a renversé m’a dit qu’il ne l’avait pas fait exprès mais, lorsqu’on manie ce genre d’engin, on évite de rouler sur la voie de gauche dans un virage."
                                            },
                                            {
                                                "example_id": "73edce4d-2202-413e-abe8-b984d90d5514",
                                                "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                                                "text": "Entre Rouvroy-sur-Audry et l'embranchement de Rémilly-les-Pothées, la route a été rectifiée à la fin de 1979, mais elle faisait auparavant un virage brusque, qui dominait l'abrupt d'un ravin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4622514c-e9e6-302a-9ea5-b69a3fcbfe12",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Changement de politique, de dessein, de ligne de pensée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825a3ce7-4814-4a5e-870d-1223119105b1",
                                                "sense_id": "4622514c-e9e6-302a-9ea5-b69a3fcbfe12",
                                                "text": "Elle amorce toutefois un virage pour le PLQ, notamment sur la langue. Son ton est juste, et elle trouve ses marques en tant que cheffe de l’opposition officielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0d2cec7-538b-3d5e-869c-cf8265ef9822",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Action de virer de bord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff099be-833e-3ec4-ac24-93ed2397c570",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Opération par laquelle on trempe une épreuve dans une dissolution de sels d’or, de platine, etc., pour lui donner sa couleur et son intensité définitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa057731-600f-4001-8b9a-9442c8539bcc",
                                                "sense_id": "5ff099be-833e-3ec4-ac24-93ed2397c570",
                                                "text": "Le traitement des papiers à image apparente comporte un virage et un fixage. Ces deux opérations peuvent être effectuées séparément ou, au contraire, être réunies en une seule opération de virage et fixage combinés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2491aa95-0ed7-31dd-902b-cdbad9d72ddc",
                                        "entry_id": "62b038af-9c6a-3be3-8145-ecefb8785813",
                                        "glosses": [
                                            "Partie des tribunes d’un stade en arc de cercle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c590d0-fbc2-4ec9-880d-cc869c9365d6",
                                                "sense_id": "2491aa95-0ed7-31dd-902b-cdbad9d72ddc",
                                                "text": "D’énormes fumigènes rouges et une bombe agricole illuminèrent le virage de Boulogne, et différents projectiles fusèrent en direction du terrain sous les cris de : « CRS marseillais ! » Des agents de sécurité couraient dans tous les sens, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
