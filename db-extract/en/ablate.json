                    {
                        "translation_id": "b0566833-4c11-4f4c-91ea-11bc31a709ab",
                        "source_entry_id": "4dbb231e-ee0f-37c4-b6b8-e7ca51ce28fe",
                        "source_sense_id": "2aa88a38-fc32-36ca-aa85-69ce752ed7be",
                        "source_sense_description": "die Oberfläche eines Steines oder Glaciers entfernen",
                        "target_lang_word": "abtragen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
