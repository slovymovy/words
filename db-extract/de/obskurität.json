                ],
                "senses": [
                    {
                        "sense_id": "7b3385b1-8380-38b8-b2af-efa3a10a793e",
                        "entry_id": "5376de82-86ea-32cf-877a-0d6b3f000aa6",
                        "glosses": [
                            "Eigenschaft, in deutlichem Maße fragwürdig, verdächtig (obskur) zu sein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "18607b8c-ae31-4e92-8128-e8ee59738d0a",
                                "sense_id": "7b3385b1-8380-38b8-b2af-efa3a10a793e",
                                "text": "„Eine gewisse, eingangs erwähnte Aura der Obskurität bleibt trotz der von mir beigebrachten Zeugnisse des Lebens und Wirkens von Hermann Feodor Kvergic bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa7a402e-dba0-3c43-800b-a334f4141ef0",
                        "entry_id": "5376de82-86ea-32cf-877a-0d6b3f000aa6",
                        "glosses": [
                            "Eigenschaft/Handlungsweise, die kaum/nicht nachzuvollziehen und deshalb dunkel (obskur) ist"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "5ce36701-7d78-4ec8-a099-0060aa133257",
                                "sense_id": "fa7a402e-dba0-3c43-800b-a334f4141ef0",
                                "text": "„Noch mehr Verwicklungen und Verwirrungen; Obskuritäten, wie nicht einmal dieser Fall sie bisher gekannt hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
