                        "examples": [
                            {
                                "example_id": "5a443fd3-2d47-4b63-82ed-56d6279a7287",
                                "sense_id": "8827a850-817e-3aa8-b8a2-a559ce1f9a27",
                                "text": "Its supporters are the Southern gentry, — fine fellows, no doubt, but not republicans exactly, as we understand the term, — a few Northern millionnaires more or less thoroughly millioned, who do not represent the real people"
                            },
                            {
                                "example_id": "a8cc30c3-e464-4a94-a4b3-60c053ff1507",
                                "sense_id": "8827a850-817e-3aa8-b8a2-a559ce1f9a27",
                                "text": "The other was a modestly millioned rich man who was then only beginning to amass the moneys afterward heaped so high, and was still in the condition to be flattered by the condescension of a yet greater millionaire."
                            },
                            {
                                "example_id": "2946a705-24ef-4cd6-ae97-eb04ca3ec807",
                                "sense_id": "8827a850-817e-3aa8-b8a2-a559ce1f9a27",
                                "text": "So go with me on a short timed, multi-millioned mile journey with the earth as it spins neatly on its axis and revolves lazily in its elliptical sweep about the Sun."
                            }
                        ]
                    }
