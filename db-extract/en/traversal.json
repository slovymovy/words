                        ]
                    },
                    {
                        "translation_id": "67ddc727-d9b1-4b94-954e-723ecf202bc5",
                        "source_entry_id": "ee5bf573-1b8a-3736-8c77-31d1ba2e42e4",
                        "source_sense_id": "929ea167-7d37-3da3-9a5d-53e3e331acae",
                        "source_sense_description": "Akt oder Instanz des Querens",
                        "target_lang_word": "Überquerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überquerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                        "entry_id": "dc095ea7-ae9f-3f99-88e6-d712f6ea1deb",
                                        "glosses": [
                                            "Wechsel von einer Seite auf die andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bef964e-a0b0-4186-892f-d3f4aadc0bd3",
                                                "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                                "text": "„Der Wettlauf um die erste Überquerung des Atlantiks war schließlich auch eine Frage des nationalen Prestiges.“"
                                            },
                                            {
                                                "example_id": "397f4439-7fed-41aa-9978-37abb57daba8",
                                                "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                                "text": "„Unter einem neuen Kapitän lief das Schiff zu seiner ersten Überquerung des Atlantiks aus.“"
                                            },
                                            {
                                                "example_id": "41a42496-4886-441c-a9d3-f13336e9ccd1",
                                                "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                                "text": "„Der berühmte Pilot, seit seiner Überquerung des Atlantiks 1927 in den Vereinigten Staaten von Amerika ein Nationalheld ist, findet ein Kuvert mit einer Lösegeldforderung.“"
                                            },
                                            {
                                                "example_id": "7ff9eb0e-4996-4ac0-9706-57e692a9303b",
                                                "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                                "text": "„Die sicherste Überquerung dieser Straße seien nun mal die zwei Fußgängerampeln, die nach Prüfung des Landratsamts bereits aufgestellt wurden.“"
                                            },
                                            {
                                                "example_id": "b3824183-115a-490f-8a72-d10cad3c083d",
                                                "sense_id": "9582ce57-2564-3e99-8ae4-070e6d08b54d",
                                                "text": "„Während der Überquerung der USA hatte die Maschine mit 1541 Kilometern einen neuen Streckenrekord für Solarflugzeuge aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
