                        "sense_id": "d968d36f-6cae-32bd-947a-21e52b47c41f",
                        "entry_id": "56691df6-43f7-30c6-a3e2-327706f6f7b3",
                        "glosses": [
                            "Qui se situe au-dessus du niveau de la commune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd27d85-7d7a-47f2-b26e-eaee9e7445ae",
                                "sense_id": "d968d36f-6cae-32bd-947a-21e52b47c41f",
                                "text": "Le Scot n’entre pas dans le détail des politiques locales mais il exprime des prévisions, des orientations et des prescriptions de niveau supra-communal."
                            },
                            {
                                "example_id": "c538da9e-33cc-4983-9d65-1c40a7f224a3",
                                "sense_id": "d968d36f-6cae-32bd-947a-21e52b47c41f",
                                "text": "Les attributions les plus importantes seraient transférées à une entité supra-communale groupant les communes d’un même canton."
                            },
                            {
                                "example_id": "e8e5f12c-e4d4-44a7-b7c3-bcf9eebcc7e2",
                                "sense_id": "d968d36f-6cae-32bd-947a-21e52b47c41f",
                                "text": "La finalité première de ces dispositions consiste à garantir une cohérence et une cohésion supra-communales et à éviter que les intérêts particuliers soient un frein à un développement harmonieux de l’aménagement du territoire."
                            }
                        ]
                    }
