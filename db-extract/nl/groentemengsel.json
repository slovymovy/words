                        "examples": [
                            {
                                "example_id": "500a1222-1b2c-41ce-823f-db8138d362a7",
                                "sense_id": "e77798f4-fd5d-3b0a-b7b3-02c325ca4972",
                                "text": "Kook de rijst volgens de aanwijzingen op de verpakking. Giet de gekookte rijst eventueel af en bak het even mee met het groentemengsel."
                            },
                            {
                                "example_id": "caca1e1b-f692-4be7-81b3-2c80fd8a2d97",
                                "sense_id": "e77798f4-fd5d-3b0a-b7b3-02c325ca4972",
                                "text": "Fruit de gesnipperde ui in olie, met de geperste knoflook en Provençaalse kruiden. Snijd de paprika’s, courgettes en aubergines in blokjes. Voeg de paprika en courgette bij de ui. Bak 5 minuten aan. Voeg de aubergine bij het groentemengsel. Bak die nog 5 minuten mee."
                            }
                        ]
                    }
