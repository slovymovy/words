                "senses": [
                    {
                        "sense_id": "f8c8ef23-7ab9-34be-be8d-5ec278db6ba2",
                        "entry_id": "93d845c9-881c-344d-81ef-c1056b649832",
                        "glosses": [
                            "Libérer de l’asphyxie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3118d480-66f4-47d4-9941-fb5e804d1010",
                                "sense_id": "f8c8ef23-7ab9-34be-be8d-5ec278db6ba2",
                                "text": "Est-on venu vous chercher à cheval, bride abattue, pour guérir une tête cassée, désasphyxier un noyé, ou recevoir le testament d'un malade?"
                            },
                            {
                                "example_id": "49662340-a24a-4e95-98e4-42c593af2b35",
                                "sense_id": "f8c8ef23-7ab9-34be-be8d-5ec278db6ba2",
                                "text": "En fait la circulation clandestine des concepts a quand même permis aux disciplines de se désasphyxier, de se désembouteiller; la science serait totalement embouteillée si les concepts ne migraient pas clandestinement."
                            }
                        ]
                    }
