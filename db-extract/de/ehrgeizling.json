                "senses": [
                    {
                        "sense_id": "ee23f823-b22b-38fe-9061-7281c7f059e0",
                        "entry_id": "dcd1b7f7-9f0c-3dba-81e8-749052ce34a9",
                        "glosses": [
                            "Person, die in übersteigerter Art und Weise nach etwas strebt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "697f383f-0989-4ee4-9a72-25a8b5999fc3",
                                "sense_id": "ee23f823-b22b-38fe-9061-7281c7f059e0",
                                "text": "„Der Politiker, dem immer noch das Image des aggressiven Ehrgeizlings anhängt und der parteiintern lange als \"Bulldozer\" gefürchtet war, macht jetzt auf Schmusekurs.“"
                            },
                            {
                                "example_id": "97f4da98-d8c6-4bc4-bf38-47f0f35a68de",
                                "sense_id": "ee23f823-b22b-38fe-9061-7281c7f059e0",
                                "text": "„Der Daker erwies sich als mit allen Wassern gewaschener Taktiker, ein Ehrgeizling, der nichts Geringeres anstrebte als die Errichtung eines Großreiches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
