                                    }
                                ]
                            },
                            {
                                "target_word": "Georgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b861ad16-f814-3c9a-ba68-75d73a9b68ba",
                                        "entry_id": "d4692450-1d58-3931-bb3d-1548d0bef97b",
                                        "glosses": [
                                            "Of, from, or pertaining to the Eastern European country of Georgia, the Georgian people or the Georgian language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1ef7290-36a6-47be-98c2-8886860fe6d0",
                                                "sense_id": "b861ad16-f814-3c9a-ba68-75d73a9b68ba",
                                                "text": "As in their narrow defeat of Argentina last week, England were indisciplined at the breakdown, and if Georgian fly-half Merab Kvirikashvili had remembered his kicking boots, Johnson's side might have been behind at half-time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ae5b5f-c95f-3ddc-b986-3eeb4d42815d",
                                        "entry_id": "d4692450-1d58-3931-bb3d-1548d0bef97b",
                                        "glosses": [
                                            "Of, from, or pertaining to the U.S. State of Georgia or its Georgian English dialect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Georgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0ff5ba-2296-3397-9c7d-1cab261abde0",
                                        "entry_id": "426bc6e8-5ec5-366f-90f1-69f40fbcb4a7",
                                        "glosses": [
                                            "A British citizen during the reign of a king named George."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba69adec-0a6a-4f16-8154-a4e330f9a393",
                                                "sense_id": "6e0ff5ba-2296-3397-9c7d-1cab261abde0",
                                                "text": "Such, I think, was the predicament in which the young Georgians found themselves about the year 1910. Many of them—I am thinking of Mr. Forster and Mr. Lawrence in particular—spoilt their early work because, instead of throwing away those tools, they tried to use them. They tried to compromise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Georgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eb69e15-d543-3eb9-b3a6-7e04d8db8d87",
                                        "entry_id": "494a68d5-6b65-3cf1-a827-0849a5a755cb",
                                        "glosses": [
                                            "Of, from, or characteristic of the reigns of Kings George I and George II of Great Britain, and George III and George IV of the United Kingdom (1714–1830), sometimes also including the brief reign of William IV (1830–1837)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09608c34-a02a-3f32-be22-eb92404eb228",
                                        "entry_id": "494a68d5-6b65-3cf1-a827-0849a5a755cb",
                                        "glosses": [
                                            "Pertaining to a movement in lyric poetry during the reign of King George V of the United Kingdom (1910–1936)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df5cc0f8-f97b-46e3-a7fb-d1a5d47a8472",
                                                "sense_id": "09608c34-a02a-3f32-be22-eb92404eb228",
                                                "text": "Georgian Poetry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bd5a4b1-9807-33bf-a8a0-93a566cab86d",
                                        "entry_id": "494a68d5-6b65-3cf1-a827-0849a5a755cb",
                                        "glosses": [
                                            "Of or relating to an architectural style of the period, marked by symmetry and proportion based on the classical architecture of Greece and Rome."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80c026bb-e583-3173-9921-bfeaf06bfd08",
                                        "entry_id": "494a68d5-6b65-3cf1-a827-0849a5a755cb",
                                        "glosses": [
                                            "Pertaining to or characteristic of German poet Stefan George (1868–1933)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5222b4-5abf-4688-bc60-66f7c66271bc",
                                                "sense_id": "80c026bb-e583-3173-9921-bfeaf06bfd08",
                                                "text": "Another example of this sterile Georgian orthodoxy is to be found in the case of Ernst Morwitz […]"
                                            },
                                            {
                                                "example_id": "82f66c1a-b61d-4f92-be8f-2b3d53182b3f",
                                                "sense_id": "80c026bb-e583-3173-9921-bfeaf06bfd08",
                                                "text": "The same Georgian persona, leonine and sacerdotal (that of the aristocratic priest) appears throughout the reminiscences of all his disciples."
                                            },
                                            {
                                                "example_id": "378331a8-7e40-4bbd-a321-7082e9d47897",
                                                "sense_id": "80c026bb-e583-3173-9921-bfeaf06bfd08",
                                                "text": "Kantorowicz […] warns against confusing a Georgian aesthetic “secret Germany,” which still slumbered in concealment, with contemporary, ‘awakened’ Nazi Germany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a77bf9-65a1-3fa4-8e30-371695e7216b",
                                        "entry_id": "494a68d5-6b65-3cf1-a827-0849a5a755cb",
                                        "glosses": [
                                            "Of or pertaining to Saint George."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
