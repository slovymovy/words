    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "053fcfcb-d7ef-37aa-babb-a7c1a115df8f",
                "word": "flavoring",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "192f540d-471d-4555-90ba-6f3b6bf28e82",
                        "entry_id": "053fcfcb-d7ef-37aa-babb-a7c1a115df8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "flavorings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9308c260-ffb7-3a81-988e-d2047d0f49a7",
                        "entry_id": "053fcfcb-d7ef-37aa-babb-a7c1a115df8f",
                        "glosses": [
                            "Something that gives flavor, usually a food ingredient."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "057baca0-fb06-4deb-96dd-8f9f03adeb76",
                                "sense_id": "9308c260-ffb7-3a81-988e-d2047d0f49a7",
                                "text": "This soda has an artificial flavoring, I can taste the after taste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "918bf34c-5765-4728-9148-d9aad4319014",
                        "source_entry_id": "053fcfcb-d7ef-37aa-babb-a7c1a115df8f",
                        "source_sense_id": "9308c260-ffb7-3a81-988e-d2047d0f49a7",
                        "source_sense_description": "something that gives flavor",
                        "target_lang_word": "Geschmacksstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschmacksstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                        "entry_id": "7cd7efbc-9caa-3235-bede-1ab3065bb2e1",
                                        "glosses": [
                                            "Stoff oder ein ausgeprägter angenehmer, kräftiger intensiver würziger Duft, der den Geschmackssinn anspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9c1804-c9da-49d4-8f7a-5c1ba8e967cd",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Die Kombination der wasserlöslichen Geschmacksstoffe und der fettlöslichen Aromen ergeben den typischen Charakter einer Bouillon.“"
                                            },
                                            {
                                                "example_id": "f74a2898-3b3b-466c-9f30-f4868e84fcda",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Speichel besteht vor allem aus Wasser; die Geschmacksstoffe lösen sich darin gut.“"
                                            },
                                            {
                                                "example_id": "0ee2a995-fd67-483a-9ca9-b8644a642aa4",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Die Geschmacksstoffe können nur über die Oberfläche des Kaffeepulvers in das Wasser übergehen.“"
                                            },
                                            {
                                                "example_id": "d36ab598-8a53-4abf-91ea-62eb3c36d7cd",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Portulak wird frisch in Salaten verwendet, kann in Ragouts aber auch kurz mitgekocht werden, denn die Geschmacksstoffe sind nicht sehr flüchtig.“"
                                            },
                                            {
                                                "example_id": "aee34043-8999-4d1b-8a7b-74e694c5f5c6",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Da alle Geschmacksstoffe wasserlöslich sind, können sie sich während des Köchelns (im Gegensatz zu den Aromen) nicht verflüchtigen und verbleiben im Wasser.“"
                                            },
                                            {
                                                "example_id": "09e31544-0033-485f-a5cc-ce334365805d",
                                                "sense_id": "b4dd29cf-ffea-36d3-bc5d-9f1e96881e52",
                                                "text": "„Jüngere Studien zeigen, dass auch Geschmacksstoffe in der Nahrung die Immunabwehr über die Zusammensetzung des Speichels beeinflussen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e33ee9-7ce6-4880-883d-adda68036f30",
                        "source_entry_id": "053fcfcb-d7ef-37aa-babb-a7c1a115df8f",
                        "source_sense_id": "9308c260-ffb7-3a81-988e-d2047d0f49a7",
                        "source_sense_description": "something that gives flavor",
                        "target_lang_word": "przyprawa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "przyprawa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9193155a-6f65-3504-a02c-d70927c3e000",
                                        "entry_id": "2cbea39c-7a56-3189-a613-2c5c94d97893",
                                        "glosses": [
                                            "składnik dodawany do potrawy w celu poprawienia jej smaku lub zapachu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bedf2c6-cb18-45f2-b893-90fc15ec05c7",
                                                "sense_id": "9193155a-6f65-3504-a02c-d70927c3e000",
                                                "text": "W mojej kuchni używam wielu orientalnych przypraw."
                                            },
                                            {
                                                "example_id": "505e98a7-f0f4-415f-990d-edf3567c3906",
                                                "sense_id": "9193155a-6f65-3504-a02c-d70927c3e000",
                                                "text": "Sanepid wykrył w przyprawach dwukrotne przekroczenie dopuszczalnych norm substancji konserwujących."
                                            },
                                            {
                                                "example_id": "61036026-f71a-4ec7-8ebc-d65a4043f91f",
                                                "sense_id": "9193155a-6f65-3504-a02c-d70927c3e000",
                                                "text": "Zupa ma ostry smak dzięki przyprawom."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1a918fe5-3460-3b02-b302-165f8d0b69b8",
                                        "entry_id": "2cbea39c-7a56-3189-a613-2c5c94d97893",
                                        "glosses": [
                                            "sprzęt, przybory, wyposażenie"
                                        ],
                                        "tags": [
                                            "Old-Polish"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "c2e6426c-c61f-373f-8c2d-138853422d76",
                                        "entry_id": "2cbea39c-7a56-3189-a613-2c5c94d97893",
                                        "glosses": [
                                            "przestępcze herbata"
                                        ],
