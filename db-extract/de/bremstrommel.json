                                    {
                                        "sense_id": "b35b9c3a-dca3-3ca0-9474-9f206709cd4e",
                                        "entry_id": "9b272193-a5e4-3434-9303-0806364a0c72",
                                        "glosses": [
                                            "A hollow metal cylinder, attached to a wheel of a vehicle, to which pressure is applied when braking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8998cca7-0794-4be7-beb8-43d2333aa6cf",
                                                "sense_id": "b35b9c3a-dca3-3ca0-9474-9f206709cd4e",
                                                "text": "As it is not practicable to use the wheel tyres of resilient wheels for braking purposes, brake drums with internally expanding shoes are fitted inside the wheels."
                                            }
                                        ]
                                    }
                                ]
