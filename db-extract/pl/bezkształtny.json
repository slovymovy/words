        "pl-extract.jsonl": [
            {
                "entry_id": "02037f19-43d5-3ca9-a73a-117803f821d5",
                "word": "bezkształtny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0f573e8-2e98-35db-be0c-6040fd9648a8",
                        "entry_id": "02037f19-43d5-3ca9-a73a-117803f821d5",
                        "glosses": [
                            "o niewyraźnym, nieregularnym kszatłcie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d420c0e-a8d9-4011-ab0a-9b0f81c47475",
                                "sense_id": "c0f573e8-2e98-35db-be0c-6040fd9648a8",
                                "text": "Daria poznała Franza po tatuażu na ramieniu, podobno okropnie wyglądał, był kawałkiem bezkształtnego, spopielonego mięsa"
                            },
                            {
                                "example_id": "84d0b6e5-4749-4a6d-8135-e278391f6aea",
                                "sense_id": "c0f573e8-2e98-35db-be0c-6040fd9648a8",
                                "text": "Między dwoma odłupkami filarów dostrzegłem zaklinowaną, bezkształtną bryłę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3b91941e-37d6-35a4-8b89-80b8978d294a",
                        "entry_id": "02037f19-43d5-3ca9-a73a-117803f821d5",
                        "glosses": [
                            "niesprecyzowany, niemal nieuchwytny"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ace64b1-e9e9-4a73-bf8c-658464dce433",
                        "source_entry_id": "02037f19-43d5-3ca9-a73a-117803f821d5",
                        "source_sense_id": "c0f573e8-2e98-35db-be0c-6040fd9648a8",
                        "target_lang_word": "formless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                        "entry_id": "7d08f871-1c08-39fc-9a12-605a7711c01a",
                                        "glosses": [
                                            "Without form; shapeless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9262dba0-671b-404c-b048-fd2780ecb976",
                                                "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                                "text": "It spread slowly up from the sea-rim, a welling upwards of pure white light, ghosting the beach with silver and drawing the grey bastions of sandstone out of formless space."
                                            },
                                            {
                                                "example_id": "148e85a1-dc92-490d-b89e-3e8cc7329dbd",
                                                "sense_id": "7539b1a3-5b0a-33a3-b2d7-e9ddd1463b4a",
                                                "text": "1985: Now the earth was a formless void, there was darkness over the deep, with a divine wind sweeping over the waters. — Genesis 1:2 (New Jerusalem Bible)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8532515f-4322-387f-b998-c8d5404222f1",
                                        "entry_id": "7d08f871-1c08-39fc-9a12-605a7711c01a",
                                        "glosses": [
                                            "Without the use of forms or templates."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d471fa70-2d03-4718-b749-76be89c347af",
                                                "sense_id": "8532515f-4322-387f-b998-c8d5404222f1",
                                                "text": "You'll be prompted with the New Project dialog (see Figure 1.11) from which you'll have at least two types of projects from which to choose: Windows CE for the Pocket PC Project and Windows CE Formless project."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eb88da5-0dc5-4b4e-8d91-fccedcd8b8da",
                        "source_entry_id": "02037f19-43d5-3ca9-a73a-117803f821d5",
                        "source_sense_id": "c0f573e8-2e98-35db-be0c-6040fd9648a8",
