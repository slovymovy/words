                        "sense_id": "a1109830-11b9-35bc-b292-8adacdb6177c",
                        "entry_id": "1a79f6e9-1f89-3efb-a89b-5f2b64c6a936",
                        "glosses": [
                            "Verarbeitungsform/Bearbeitungsmöglichkeit (Operation), die zu den am einfachsten strukturierten gehört, zum Beispiel beim Rechnen eine Grundrechenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b7701c-dab9-4b34-bb5f-92867a1ab21e",
                                "sense_id": "a1109830-11b9-35bc-b292-8adacdb6177c",
                                "text": "„In einem anderen Algorithmus könnte es beispielsweise eine Grundoperation sein, die Wurzel aus einer Zahl zu ziehen (oder präzise ausgedrückt: eine gegebene Ziffer so umzuwandeln, daß die neue Ziffer die Wurzel der Zahl repräsentiert, die durch die erste Ziffer repräsentiert wurde.)“"
                            },
                            {
                                "example_id": "891119dc-95b5-4209-b8aa-5ffcaa7ab92b",
                                "sense_id": "a1109830-11b9-35bc-b292-8adacdb6177c",
                                "text": "„Zur Abscheidung von Gasen und Dämpfen eignen sich die Grundoperationen Kondensation, Adsorption, physikalische Absorption.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
