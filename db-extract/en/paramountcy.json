                        "glosses": [
                            "The condition or fact of being paramount; precedence, supremacy; (countable) an instance of this."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30e44122-b020-4f0f-895d-02ed643870a0",
                                "sense_id": "9482e53c-7987-372d-9764-a9b299d1aebb",
                                "text": "[W]e saw this permanence to be true of the general paramountcy of the higher insight, even though in the ebbs of emotional excitement meaner motives might temporarily prevail and backsliding might occur."
                            },
                            {
                                "example_id": "903f1af4-f337-44fa-86b4-7ea31bdca4a3",
                                "sense_id": "9482e53c-7987-372d-9764-a9b299d1aebb",
                                "text": "Both, they claim, were British spies, sent into Central Asia as part of a grand design for paramountcy there at the expense of Russia, whose influence they aimed to destroy."
                            },
                            {
                                "example_id": "84d8c75e-e3e7-4b55-898d-e3e64c324cc2",
                                "sense_id": "9482e53c-7987-372d-9764-a9b299d1aebb",
                                "text": "Portuguese Church authorities often made things more difficult for non-Portuguese European missionaries by insisting on the paramountcy of their own culture and ecclesiastical jurisdiction […]"
                            }
                        ]
                    }
