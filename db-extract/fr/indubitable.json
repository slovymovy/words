                                    {
                                        "sense_id": "2b97ec3c-1a72-3621-b102-5af4b41a6d73",
                                        "entry_id": "4854eddb-ee4d-32e6-a638-001e6d24f059",
                                        "glosses": [
                                            "Not doubtful."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845e3278-b40d-4e22-9c9f-2f60839d340a",
                                                "sense_id": "2b97ec3c-1a72-3621-b102-5af4b41a6d73",
                                                "text": "I was utterly unconscious of this irregularity, and might have remained so, had not a friend the next day asked me the reason of it. Indeed I should have disbelieved that it had taken place, had not the testimony of several persons rendered it undoubtful."
                                            }
