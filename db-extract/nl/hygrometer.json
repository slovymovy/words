                                        "glosses": [
                                            "Instrument servant à mesurer le degré d’humidité relative ou absolue de l'air"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e049b1-1079-4d46-a404-303582e01785",
                                                "sense_id": "7cb89f01-8e48-3455-a10a-293e0029f829",
                                                "text": "Plus tard, anémomètres et hygromètres compléteront la panoplie des outils de mesure."
                                            },
                                            {
                                                "example_id": "f6e6b5ea-6416-46dc-92e8-fbcb5fb7d494",
                                                "sense_id": "7cb89f01-8e48-3455-a10a-293e0029f829",
                                                "text": "L’hygromètre à fibres fonctionne grâce à la variation de la longueur de certaines fibres en fonction de l’humidité."
                                            }
                                        ]
                                    }
