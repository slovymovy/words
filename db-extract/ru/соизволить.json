                                        "sense_id": "1aff877c-f277-3fa6-9559-2fdec5ac8e1e",
                                        "entry_id": "0d99b7d0-ec68-3378-860c-2cf3a2f5faae",
                                        "glosses": [
                                            "Obtempérer ; accepter quelque chose, y consentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e205481d-878c-4117-8bae-ff6c56be7cd3",
                                                "sense_id": "1aff877c-f277-3fa6-9559-2fdec5ac8e1e",
                                                "text": "Je vous prie de vouloir bien réaliser les travaux que je vous ai réglés il y a plus de six mois."
                                            },
                                            {
                                                "example_id": "742a59db-ea5e-4b16-a7b5-b5240612abd6",
                                                "sense_id": "1aff877c-f277-3fa6-9559-2fdec5ac8e1e",
                                                "text": "— Qui veut bien monter les cartons au premier étage ?\n— Je veux bien m’en charger."
                                            },
                                            {
                                                "example_id": "1f528445-c1a5-4e0a-84c8-19c632adce6f",
                                                "sense_id": "1aff877c-f277-3fa6-9559-2fdec5ac8e1e",
                                                "text": "Allons donc, mon bon ami, ajournons la plaisanterie, si vous le voulez bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e5df7e-3d04-3b9a-aa56-7c8d127c6cff",
                                        "entry_id": "0d99b7d0-ec68-3378-860c-2cf3a2f5faae",
                                        "glosses": [
                                            "Injonction familière adressée à un animal de compagnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620324b1-c6dd-4ba1-9534-8be994b01d69",
                                                "sense_id": "30e5df7e-3d04-3b9a-aa56-7c8d127c6cff",
                                                "text": "— C’est bien, Spy… Donnez la patte, maintenant… voulez-vous bien donner la patte… Spy, voulez-vous bien… ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
