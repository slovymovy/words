                                                "sense_id": "2506cb13-c622-330b-bbfe-8f000916fa6e",
                                                "text": "Vojsko provádělo obranné manévry."
                                            },
                                            {
                                                "example_id": "a42f6c62-9967-4b1e-b6c1-54adb63f5820",
                                                "sense_id": "2506cb13-c622-330b-bbfe-8f000916fa6e",
                                                "text": "Zkřížené nohy jsou jednoznačně obranným gestem, nohy zasunuté hluboko pod židli znamením, že se přímo bojíte a vůbec si nejste jisti sami sebou."
                                            }
