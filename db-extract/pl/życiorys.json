                                "target_senses": [
                                    {
                                        "sense_id": "cf1e45df-f467-3816-b569-5350beedd2ab",
                                        "entry_id": "b2c976be-d725-3998-81aa-419ac9285da1",
                                        "glosses": [
                                            "An autobiography; a book describing the personal experiences of an author."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abdd57c-e28f-4609-ac76-ffd75e3fb180",
                                                "sense_id": "cf1e45df-f467-3816-b569-5350beedd2ab",
                                                "text": "When I retire, I'm going to write my memoirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596ce9c4-2ab6-3d21-a8cf-61b0a16861b7",
                                        "entry_id": "b2c976be-d725-3998-81aa-419ac9285da1",
                                        "glosses": [
                                            "A biography; a book describing the experiences of a subject from personal knowledge of the subject or from sources with personal knowledge of the subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4c81a8-eba6-42d5-8dc2-7333e95eae5f",
                                                "sense_id": "596ce9c4-2ab6-3d21-a8cf-61b0a16861b7",
                                                "text": "James wrote a memoir of his grandmother shortly after she passed away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "045ef8ad-f663-3e40-b49c-d7f01a68ad01",
                                        "entry_id": "b2c976be-d725-3998-81aa-419ac9285da1",
                                        "glosses": [
                                            "Any form of narrative describing the personal experiences of a writer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "020f2185-0af5-4ae1-8dfd-d1c063fd2117",
                        "source_entry_id": "3c221b0a-d2ee-32f2-b60d-72db6638ed4e",
                        "source_sense_id": "904892af-e49a-3995-9962-66face35d9c9",
                        "target_lang_word": "Lebenslauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebenslauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                        "entry_id": "e6f9c653-2b6a-331a-ab54-93c441434983",
                                        "glosses": [
                                            "Abfolge dessen, was sich im Verlauf des Lebens von jemandem ereignet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e870ed76-5b84-45c3-899f-78550e4ddfd5",
                                                "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                                "text": "In meinem bisherigen Lebenslauf hat es manche unvorhergesehenen Ereignisse gegeben."
                                            },
                                            {
                                                "example_id": "da4d724e-5974-4c9e-90a3-6e855598de93",
                                                "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                                "text": "„Psychologie und Fingerspitzengefühl sind beim Ausfüllen von Lücken im Lebenslauf von Vorteil.“"
                                            },
                                            {
                                                "example_id": "2b1485ef-72a5-4e73-ac92-27b84dd00ebb",
                                                "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                                "text": "„Unsere Lebensläufe verlaufen im Zickzack, in aneinandergereihten Stationen: Hier arbeiten wir, dort studierten wir, und drüben sind wir mit dem Freund zusammen.“"
                                            },
                                            {
                                                "example_id": "3fe138ba-04c4-4fa5-b18d-cd33e02590c9",
                                                "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                                "text": "„Wenn Joswig mich nicht zur Strafarbeit eingeschlossen hätte, wären sie jetzt wohl auch hinter mir her, würden meinen Lebenslauf unter ihr wissenschaftliches Brennglas halten und sich bemühen, ein Bild von mir zu gewinnen.“"
                                            },
                                            {
                                                "example_id": "46870000-0642-4723-950f-28afe21c8da6",
                                                "sense_id": "a02a9085-58b6-3796-978f-04a926b86c64",
                                                "text": "„So konnte ich mir bald seinen Lebenslauf zusammenreimen, der durch ein alltägliches und geringfügiges Versäumnis eine außergewöhnliche Wendung genommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c83e348-5188-3885-87ac-6f5584d0d51e",
                                        "entry_id": "e6f9c653-2b6a-331a-ab54-93c441434983",
                                        "glosses": [
                                            "schriftliche Übersicht wesentlicher Aspekte von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5034e90a-988e-48de-95e6-f21e739302fd",
                                                "sense_id": "9c83e348-5188-3885-87ac-6f5584d0d51e",
                                                "text": "Der Lebenslauf für Bewerbungen soll kurz und übersichtlich sein."
                                            },
                                            {
                                                "example_id": "d69a0426-0ed7-44e4-835a-f92a1aaf98b7",
                                                "sense_id": "9c83e348-5188-3885-87ac-6f5584d0d51e",
                                                "text": "„Ein ganzes Leben auf einer Din A 4-Seite: Der Lebenslauf, der sogenannte CV, ist die wichtigste Visitenkarte jedes Bewerbers.“"
                                            },
                                            {
                                                "example_id": "fa3faac2-fb5c-4493-8d0f-39318a15ef02",
                                                "sense_id": "9c83e348-5188-3885-87ac-6f5584d0d51e",
                                                "text": "„Nicht in allen EU-Ländern sind die Anforderungen und Erwartungen an einen formal korrekten Lebenslauf gleich.“"
                                            },
                                            {
                                                "example_id": "80881b5a-993c-46bb-9872-e44225f91857",
                                                "sense_id": "9c83e348-5188-3885-87ac-6f5584d0d51e",
                                                "text": "„Er musste es in ihrem Lebenslauf gesehen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
