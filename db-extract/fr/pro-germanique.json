                        "glosses": [
                            "Favorable aux Allemands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c05627f-df1b-460d-88a0-465f1e709872",
                                "sense_id": "35a1b064-4225-3549-8a76-e4d45afca7c3",
                                "text": "Finalement, ils défendent l’idée de l’inexistence d’un parti anti-germanique, vu qu’il n’existait pas non plus de parti pro-germanique."
                            },
                            {
                                "example_id": "643eea27-25bd-4ff2-8f01-82b11dc434a6",
                                "sense_id": "35a1b064-4225-3549-8a76-e4d45afca7c3",
                                "text": "En 1910, le parti pro-germanique secondait les attaques contre la Chambre des Lords, dont la majorité était patriote."
                            },
                            {
                                "example_id": "144f325b-8240-461b-92ff-76d98f20e1d2",
                                "sense_id": "35a1b064-4225-3549-8a76-e4d45afca7c3",
                                "text": "Déjà, nous dénoncions publiquement les tendances pro-germaniques et pro-hitlériennes de Monsieur De Man."
                            }
                        ]
                    }
