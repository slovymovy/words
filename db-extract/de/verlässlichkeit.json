                    {
                        "sense_id": "b1951d09-741c-3993-afab-53e021c49948",
                        "entry_id": "9bedca1d-c3f2-30b2-900e-d97f0e77a6b3",
                        "glosses": [
                            "Fiabilité, crédibilité."
                        ],
                        "tags": [
                            "generally"
                        ],
                        "examples": [
                            {
                                "example_id": "47868203-f18a-412d-bb99-72eb85d2a89a",
                                "sense_id": "b1951d09-741c-3993-afab-53e021c49948",
                                "text": "Journalisten sollen immer die Verlässlichkeit ihrer Quellen überprüfen.",
                                "translation": "Les journalistes doivent toujours contrôler la fiabilité de leurs sources."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c4e9381-3fc7-3756-b16a-c1873e7ca119",
                        "entry_id": "9bedca1d-c3f2-30b2-900e-d97f0e77a6b3",
                        "glosses": [
                            "Fiabilité, fonctionnement avec un faible taux de panne, de défaillance."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "41d0f138-7565-411e-bbac-50d796f9be73",
                                "sense_id": "0c4e9381-3fc7-3756-b16a-c1873e7ca119",
                                "text": "Die Verlässlichkeit unserer Produkte ist nicht zu überbieten!",
                                "translation": "La fiabilité de nos produits est insurpassable !"
                            },
                            {
                                "example_id": "90a86475-c9e9-4bd4-8cf7-2adb009e74eb",
                                "sense_id": "0c4e9381-3fc7-3756-b16a-c1873e7ca119",
                                "text": "Denkst du, dass wir unser Ziel ohne Panne erreichen? An der Verlässlichkeit dieser Schrottkiste gibt es Grund zu zweifeln…",
                                "translation": "Penses-tu que nous allons arriver à destination sans panne ? Il y a de bonnes raisons de douter de la fiabilité de cette épave…"
                            }
                        ]
                    }
