                ],
                "senses": [
                    {
                        "sense_id": "ce9e23ac-8064-3022-b0a7-a30f8afa8045",
                        "entry_id": "6810b28e-16e8-36a6-b504-8aeb86dfe8e8",
                        "glosses": [
                            "The belief that natural objects have supernatural powers, or that something created by people has power over people."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "562e55fa-3398-32dd-baca-b76ab95156e0",
                        "entry_id": "6810b28e-16e8-36a6-b504-8aeb86dfe8e8",
                        "glosses": [
                            "A form of paraphilia where the object of attraction is an inanimate object or a part of a person's body."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf364f0-62c8-4b3b-b057-8f2b494491b9",
                                "sense_id": "562e55fa-3398-32dd-baca-b76ab95156e0",
                                "text": "That's cross-dressing to you and me and, according to Blanchard and the APA, there are two types – fetishism and autogynephilia."
                            }
                        ]
                    },
                    {
                        "sense_id": "c24e0fa2-3695-3664-b545-1142e37fa560",
                        "entry_id": "6810b28e-16e8-36a6-b504-8aeb86dfe8e8",
                        "glosses": [
                            "An irrational, obsessive belief in the power of some object or action."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c42f472f-25f6-446e-8c85-5c081e9938c2",
