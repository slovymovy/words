                        "source_sense_description": "process leading to formation of layers",
                        "target_lang_word": "Stratifizierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stratifizierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92ffe64b-a932-3029-9004-e08a8aa7548a",
                                        "entry_id": "9230a859-55aa-37a6-ada3-d7de13e88a5f",
                                        "glosses": [
                                            "Bildung von Schichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e71685-1bc9-4b48-af0d-e013cd331d67",
                                                "sense_id": "92ffe64b-a932-3029-9004-e08a8aa7548a",
                                                "text": "„Das Ausmaß der Stratifizierung erkennt man an der Selektivität eines Bildungssystems: Auf welcher Ebene, in welcher Altersstufe, finden Selektionen statt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c52bc55b-3c4a-3e6a-94d1-11a3c43ee4c8",
                                        "entry_id": "9230a859-55aa-37a6-ada3-d7de13e88a5f",
                                        "glosses": [
                                            "Behandlung von Saat/Keimgut, es zum Beispiel warm, kalt oder feucht halten, um das Keimen zu ermöglichen/beschleunigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f608a062-e727-499f-b4ea-9fc50be85274",
                                                "sense_id": "c52bc55b-3c4a-3e6a-94d1-11a3c43ee4c8",
                                                "text": "„Oft wollen frisch ausgesäte Samen von Bäumen und Sträuchern einfach nicht keimen. Der Grund ist eine Keimhemmung, die vor der Aussaat durch die Stratifizierung der Samen beseitigt werden muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5361c403-33e3-4bac-8cbd-ec5e179abc2a",
                        "source_entry_id": "fedab0ad-fe10-3c2c-9667-3d438e121627",
