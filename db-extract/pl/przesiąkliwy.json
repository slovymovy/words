                "senses": [
                    {
                        "sense_id": "d21c1b3d-7081-3cdd-b078-eb65e75c76f4",
                        "entry_id": "679bfac5-5f64-35a3-8a65-84f64db6dbed",
                        "glosses": [
                            "przepuszczający wodę lub inne płyny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f587370c-5b23-405f-9e68-4648e44993b2",
                                "sense_id": "d21c1b3d-7081-3cdd-b078-eb65e75c76f4",
                                "text": "Orka radłem wymagała gleb lekkich i przesiąkliwych, a jednocześnie na tyle urodzajnych, by plonów starczyło na wyżywienie i na przyszłoroczny siew"
                            },
                            {
                                "example_id": "56eec3cb-f79d-41f9-ae67-885a190fe029",
                                "sense_id": "d21c1b3d-7081-3cdd-b078-eb65e75c76f4",
                                "text": "Nawet jeśli grunt kupionej właśnie działki wydaje się suchy, piaszczysty i łatwo przesiąkliwy dla deszczówki warto zlecić specjaliście wykonanie dokładnych pomiarów wilgotności"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
