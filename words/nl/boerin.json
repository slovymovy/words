            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7974e91-1a0f-337d-9ebb-58911c0a6020",
                    "sense_definition": "Een vrouwelijke landbouwer of veeteler die een agrarisch bedrijf runt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge <w>boerin</w> werkt elke ochtend vroeg op het land om de groenten te oogsten.",
                            "target_lang_translations": {
                                "en": "The young <w>farmer</w> works on the land early every morning to harvest the vegetables."
                            }
                        },
                        {
                            "text": "In het televisieprogramma zoeken drie vrijgezelle <w>boerinnen</w> naar een leuke partner.",
                            "target_lang_translations": {
                                "en": "In the television program, three single <w>farmers</w> are looking for a nice partner."
                            }
                        }
                    ],
                    "synonyms": [
                        "landbouwster"
                    ],
                    "antonyms": [
                        "boer"
                    ],
                    "common_phrases": [
                        "vrijgezelle boerin",
                        "moderne boerin"
                    ],
                    "target_lang_definitions": {
                        "en": "A female farmer or livestock breeder who runs an agricultural business."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "farmer",
                                "target_lang_sense_clarification": "female agricultural professional"
                            },
                            {
                                "target_lang_word": "peasant",
                                "target_lang_sense_clarification": "historical or small-scale female farmer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2528a5-1870-3bad-8ca3-011bd8cfa971",
                    "sense_definition": "De echtgenote van een <w>boer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger was het heel gewoon dat de <w>boerin</w> de koeien molk terwijl de man op het veld werkte.",
                            "target_lang_translations": {
                                "en": "In the past, it was very common for the <w>farmer's wife</w> to milk the cows while the husband worked in the field."
                            }
                        },
                        {
                            "text": "Als <w>boerin</w> hielp ze haar man dagelijks met de administratie van de boerderij.",
                            "target_lang_translations": {
                                "en": "As a <w>farmer's wife</w>, she helped her husband daily with the farm's administration."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vrouw van de boer"
                    ],
                    "target_lang_definitions": {
                        "en": "The wife of a farmer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "farmer's wife",
                                "target_lang_sense_clarification": "spouse of a farmer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98ebc6bd-983e-34e3-b045-645895563afd",
                    "sense_definition": "Een vrouw die als lomp, onbeleefd of ongemanierd wordt beschouwd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar vader vond dat ze zich als een <w>boerin</w> gedroeg door zo hard te schreeuwen.",
                            "target_lang_translations": {
                                "en": "Her father thought she behaved like a <w>boor</w> by shouting so loudly."
                            }
                        },
                        {
                            "text": "Zij gedraagt zich als een echte <w>boerin</w> aan tafel door met haar mond vol te praten.",
                            "target_lang_translations": {
                                "en": "She behaves like a real <w>boor</w> at the table by talking with her mouth full."
                            }
                        }
                    ],
                    "antonyms": [
                        "dame"
                    ],
                    "common_phrases": [
                        "zich als een boerin gedragen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A woman who is considered coarse, rude, or ill-mannered."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boor",
                                "target_lang_sense_clarification": "a rude or insensitive woman"
                            },
                            {
                                "target_lang_word": "churl",
                                "target_lang_sense_clarification": "an ill-bred person"
                            },
                            {
                                "target_lang_word": "yokel",
                                "target_lang_sense_clarification": "a country person perceived as unsophisticated"
                            }
                        ]
                    }
                }
            ]
        }
    ]
