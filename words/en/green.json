                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That timber is still too <w>green</w> to be used for building.",
                            "target_lang_translations": {
                                "ru": "Эта древесина ещё слишком <w>сырая</w>, чтобы использовать её для строительства."
                            }
                        },
                        {
                            "text": "The <w>green</w> wood snapped easily under the pressure.",
                            "target_lang_translations": {
                                "ru": "<w>Непросушенное</w> дерево легко сломалось под давлением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "green wood",
                        "green timber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сырой, невысушенный (о древесине)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "о дереве"
                            },
                            {
                                "target_lang_word": "непросушенный",
                                "target_lang_sense_clarification": "содержащий влагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f29ee12-4d4d-3423-849f-f2df38341f6a",
