                    {
                        "sense_id": "0fd8203d-1e10-385f-91ce-a47f0dc8225a",
                        "entry_id": "819d04ea-71c6-35dc-941e-33d7f7c562a4",
                        "glosses": [
                            "Qui dénature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9e28b2-8593-46b4-ad51-7f876c754122",
                                "sense_id": "0fd8203d-1e10-385f-91ce-a47f0dc8225a",
                                "text": "Ces alcools dénaturés ne peuvent être utilisés sans en extraire préalablement tout ou partie de l’huile dénaturante qu’ils contiennent."
                            },
                            {
                                "example_id": "07714a89-1ff0-414c-99f5-ed0891fb31de",
                                "sense_id": "0fd8203d-1e10-385f-91ce-a47f0dc8225a",
                                "text": "L’argument faisait litière de ce que dans son arrêt, la Cour avait jugé, à bon droit, que ces œuvres avaient été détournées de leur finalité par l’usage dénaturant qui en avait été fait et que l’atteinte au droit au respect était constituée."
                            }
                        ]
                    }
                ],
