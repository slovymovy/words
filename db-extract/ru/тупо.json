        "fr-extract.jsonl": [
            {
                "entry_id": "0ee5f602-5e4e-31e0-9b85-d1df73293d0e",
                "word": "тупо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb290750-d47b-3faa-8e83-93a0d60ce71d",
                        "entry_id": "0ee5f602-5e4e-31e0-9b85-d1df73293d0e",
                        "glosses": [
                            "Stupidement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b5a9ab7-3195-4278-be89-ae3acb1d1686",
                                "sense_id": "eb290750-d47b-3faa-8e83-93a0d60ce71d",
                                "text": "Мы смотрели тупо и невнятно, не могли произнести сряду несколько слов, чтобы не впасть в одышку, топырили губы и как-то нелепо шевелили ими, точно сбираясь сосать собственный язык.",
                                "translation": "Nous regardions d'un air vide et inarticulé, nous ne pouvions pas prononcer plusieurs mots d'affilée sans devenir essoufflés, nous faisions la moue et remuions nos lèvres d'une manière absurde, comme si nous étions sur le point de sucer notre propre langue."
                            }
                        ]
                    },
                    {
                        "sense_id": "d09b8626-5332-3917-8131-23822a39f79d",
                        "entry_id": "0ee5f602-5e4e-31e0-9b85-d1df73293d0e",
                        "glosses": [
                            "Bêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d14fec4-4af3-4acf-9694-f2f9bec28119",
                                "sense_id": "d09b8626-5332-3917-8131-23822a39f79d",
                                "text": "Я не знал, что делать, и тупо спросил: — Где мама? — На работе, — ответил мальчик.",
                                "translation": "Je ne savais pas quoi faire et j'ai bêtement demandé : « Où est maman ? «Au travail», répondit le garçon."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
