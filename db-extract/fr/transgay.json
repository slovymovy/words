                        "examples": [
                            {
                                "example_id": "3972fe67-8829-47da-acb6-6b2381e82aa1",
                                "sense_id": "11c34163-f176-3fe2-b852-6663c164fea4",
                                "text": "Un aspect qui revient est la solitude, l’impression d’être un monstre, de ne trouver sa place nul^([sic : nulle]) part, y compris au sein du milieu LGBT. Face à ce problème les hommes qui écrivent cherchent à créer l’imaginaire transgay et les espaces de sociabilités qui leur ont manqué."
                            }
                        ]
                    }
