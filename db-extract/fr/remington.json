                "senses": [
                    {
                        "sense_id": "f834668a-58c2-3c2b-90de-2944e7c86e2b",
                        "entry_id": "cda3c249-ed99-3cba-ac2a-bab15ab0785c",
                        "glosses": [
                            "Arme à feu de marque Remington."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "33c9a953-6f1e-3dc0-af8f-ee63614cd25a",
                        "entry_id": "cda3c249-ed99-3cba-ac2a-bab15ab0785c",
                        "glosses": [
                            "Fusil \\\"Remington Rolling Block\\\" en usage dans l’armée française en 1870."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "e4d74a63-b633-4bb9-9f77-f3946e6c632a",
                                "sense_id": "33c9a953-6f1e-3dc0-af8f-ee63614cd25a",
                                "text": "Brûlant de fièvre, Verdette, accroupi près d'une flaque gelée, cassait avec la crosse de son remington des morceaux de glace terreuse qu'il suçait avidement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3d3c3ff6-107f-3d46-800e-1443f14f1434",
                "word": "Remington",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06623cdd-1807-47c7-b38e-778a633cd339",
                        "entry_id": "3d3c3ff6-107f-3d46-800e-1443f14f1434",
                        "tags": [
                            "plural"
                        ],
                        "form": "Remingtons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f1ccfb2-bd6c-3607-a89c-3f7303c9ce85",
                        "entry_id": "3d3c3ff6-107f-3d46-800e-1443f14f1434",
                        "glosses": [
                            "Pistolet ou revolver de marque Remington."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2daf919-6a91-42a4-91ea-1967c9bc484a",
                                "sense_id": "1f1ccfb2-bd6c-3607-a89c-3f7303c9ce85",
                                "text": "Ils remontèrent l’escalier et en gravirent un autre qui conduisait au premier étage : car les armes devaient être placées dans un endroit sec et les deux étages de la forteresse leur étaient spécialement affectés.\nDix salles en étaient pleines : elles étaient rangées avec ordre par modèles, et des étiquettes écrites en arabe indiquaient leur système et leur provenance.\nLes Martiny anglais et les Werndl autrichiens, les Remington espagnols et les Berdan russes, les Mauser allemands et les Gras français, les Comblain belges et les Vetterli italiens s’y alignaient en files pressées."
                            },
                            {
                                "example_id": "80d9daf1-1ff8-43fa-ab8f-fd01de65769c",
                                "sense_id": "1f1ccfb2-bd6c-3607-a89c-3f7303c9ce85",
                                "text": "Il opta pour un revolver Remington Pocket à cinq coups, dont le canon, très court, lui permettait de le remiser dans sa soutane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20e6deaf-c12d-450f-bdf3-e6388694752d",
                        "source_entry_id": "3d3c3ff6-107f-3d46-800e-1443f14f1434",
                        "source_sense_id": "1f1ccfb2-bd6c-3607-a89c-3f7303c9ce85",
                        "target_lang_word": "Remington",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Remington",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76bb128e-7af9-3db8-99cf-013f68b8e291",
                                        "entry_id": "25b9ee0b-5d9f-3e14-94a4-f20a23c26dc2",
                                        "glosses": [
                                            "An English habitational surname from Old English; (art) used specifically of Frederic Remington (1861–1909), an American artist who specialized in depictions of the Old West."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daeb2579-7629-4d59-94f0-d27f8e2bbb01",
                                                "sense_id": "76bb128e-7af9-3db8-99cf-013f68b8e291",
                                                "text": "One of his movies may suggest an inward unity and spaciousness that seems a mark of good fiction, as in The Big Sleep; it may have the scope and resonance to fill a historical landscape worthy of Remington, as Red River does."
                                            },
                                            {
                                                "example_id": "5d41816b-5951-4693-93e1-f807d3fdbb01",
                                                "sense_id": "76bb128e-7af9-3db8-99cf-013f68b8e291",
                                                "text": "Rafe loved Remington. He so typified the old West."
                                            },
                                            {
                                                "example_id": "d215c167-6279-44d8-a56d-0e19b347f224",
                                                "sense_id": "76bb128e-7af9-3db8-99cf-013f68b8e291",
                                                "text": "In jeans, a long sleeved canvas shirt and boots, Young gave the appearance of a living Remington painting as he listened quietly to Jenkins' rendition of the story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0805659d-858e-3cbb-8291-4bc3e28e2530",
                                        "entry_id": "25b9ee0b-5d9f-3e14-94a4-f20a23c26dc2",
                                        "glosses": [
                                            "A male given name transferred from the surname, of modern usage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35c26581-49ec-32dc-8ee4-3ae4db0500d9",
                                        "entry_id": "25b9ee0b-5d9f-3e14-94a4-f20a23c26dc2",
                                        "glosses": [
