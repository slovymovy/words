                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panthéiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "697c3645-83f6-36dc-9e74-d27b1cd16085",
