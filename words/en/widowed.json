    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c23a6c92-821d-3702-b166-930af7f75f8b",
                    "sense_definition": "Whose spouse has died; having become a widow or widower.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marital_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>widowed</w> mother worked two jobs to support her young children.",
                            "target_lang_translations": {
                                "es": "La madre <w>viuda</w> trabajaba en dos empleos para mantener a sus hijos pequeños."
                            }
                        },
                        {
                            "text": "After forty years of marriage, he found himself a <w>widowed</w> man living alone in the big house.",
                            "target_lang_translations": {
                                "es": "Después de cuarenta años de matrimonio, se encontró siendo un hombre <w>viudo</w> que vivía solo en la casa grande."
                            }
                        }
                    ],
                    "antonyms": [
                        "married"
                    ],
                    "common_phrases": [
                        "widowed mother",
                        "widowed spouse"
                    ],
                    "target_lang_definitions": {
                        "es": "Cuyo cónyuge ha fallecido; que se ha quedado viudo o viuda."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "viudo",
                                "target_lang_sense_clarification": "masculino"
                            },
                            {
                                "target_lang_word": "viuda",
                                "target_lang_sense_clarification": "femenino"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd811ab9-9bed-37d5-ab15-f1ca2b48d91a",
                    "sense_definition": "Simple past tense and past participle of <w>widow</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic war <w>widowed</w> many young women in the small village.",
                            "target_lang_translations": {
                                "es": "La trágica guerra <w>dejó viudas</w> a muchas mujeres jóvenes en el pequeño pueblo."
                            }
                        },
                        {
                            "text": "She was <w>widowed</w> at a very young age when her husband died in an accident.",
                            "target_lang_translations": {
                                "es": "Ella <w>enviudó</w> a una edad muy temprana cuando su esposo murió en un accidente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "widowed by war"
                    ],
