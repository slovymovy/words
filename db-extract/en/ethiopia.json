                                "target_senses": [
                                    {
                                        "sense_id": "edf82be7-2068-30ef-a560-c09fb51de96b",
                                        "entry_id": "d722b37c-6938-3caa-982e-8558fdd92152",
                                        "glosses": [
                                            "Pays d’Afrique, bordé par l’Érythrée au nord, Djibouti et la Somalie à l’est, le Kenya au sud, le Soudan du Sud et le Soudan à l’ouest. Sa capitale est Addis-Abeba."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80523c2a-2846-41f9-bb24-b462291c4fc5",
                                                "sense_id": "edf82be7-2068-30ef-a560-c09fb51de96b",
                                                "text": "L’Abyssinie ou Éthiopie est un Empire africain situé entre le Soudan, l’Afrique orientale anglaise, l’Érythrée et les Somalilands, français, anglais et italien. Son extension territoriale est supérieure à celle de la France […]"
                                            },
                                            {
                                                "example_id": "9bba27ee-837e-48fc-b3e2-680c2a95e8cd",
                                                "sense_id": "edf82be7-2068-30ef-a560-c09fb51de96b",
                                                "text": "Curieuse pendule en métal patiné représentant satyriquement Ménélik II, empereur d’Éthiopie entre 1889 et 1913. Le mouvement et le cadran inscrit dans son ventre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4baebdc-fa88-442f-a222-0fe1d07b8ef8",
                        "source_entry_id": "1e6baf74-2ee9-32e1-9cad-ae19dc44d62f",
                        "source_sense_description": "country in Eastern Africa",
                        "target_lang_word": "Äthiopien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äthiopien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                        "entry_id": "6017f804-ab13-3b06-8569-8e00abf1d9b5",
                                        "glosses": [
                                            "Staat in Ostafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb197064-f27c-4687-a8fc-5b3e26811a37",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "Ich komme aus Äthiopien."
                                            },
                                            {
                                                "example_id": "074f6ecf-7a08-44b7-b149-0fcd05357b61",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "Addis Abeba ist die Hauptstadt von Äthiopien."
                                            },
                                            {
                                                "example_id": "db265004-f3b4-4cd4-97d3-29ba1ccdbde8",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Der Außenhandel Äthiopiens besteht im Wesentlichen aus dem Export von Kaffee.“"
                                            },
                                            {
                                                "example_id": "0d2ae632-3c2b-4f35-84e2-340f3eb482f2",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Bekanntlich gibt es für mein Heimatland zwei Bezeichnungen. Die heute geläufige, Äthiopien, stammt aus dem Griechischen: »das Land der gebrannten Gesichter«. Die andere, Abessinien, leitet sich von dem arabischen Wort habesch ab, »Land der gemischten Rassen«.“"
                                            },
                                            {
                                                "example_id": "7dc78078-9b18-4bea-b365-8b0ec1d2428f",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Das christliche Äthiopien zerreibt sich fortan im Kampf gegen muslimische Nachbarn.“"
                                            },
                                            {
                                                "example_id": "0400c88c-2105-4cf0-973f-2138e108f54d",
                                                "sense_id": "b4e7e5e4-600e-3183-a996-3d63ce05c670",
                                                "text": "„Verstanden habe ich Äthiopien immer noch nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
