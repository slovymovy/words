                    },
                    {
                        "form_id": "cf5a68f5-f216-431d-9d36-8f137ae0532a",
                        "entry_id": "66e7fed2-5c72-3c16-bd40-e0286a3b1468",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "barakjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27da0fea-0c07-371c-998d-e8111aaccecb",
                        "entry_id": "66e7fed2-5c72-3c16-bd40-e0286a3b1468",
                        "glosses": [
                            "tijdelijk onderkomen voor een groep soldaten of andere personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f51917c-383a-42fd-9b0f-43273d99e284",
                                "sense_id": "27da0fea-0c07-371c-998d-e8111aaccecb",
                                "text": "Soldaten en asielzoekers slapen soms in barakken."
                            },
                            {
                                "example_id": "29d74b27-4d43-4ef2-8385-8165de23a5cc",
                                "sense_id": "27da0fea-0c07-371c-998d-e8111aaccecb",
                                "text": "Ze waren de onbetwiste heerseressen van de barakken en hielden zonder problemen een twintigtal kerels onder de duim, hoe naar liefde snakkend die zich ook konden gedragen na meerdere maanden in de bergen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b1949ab-869a-442d-9e6a-92a0cd3be962",
                        "source_entry_id": "66e7fed2-5c72-3c16-bd40-e0286a3b1468",
                        "source_sense_id": "27da0fea-0c07-371c-998d-e8111aaccecb",
                        "source_sense_description": "tijdelijk onderkomen voor een groep soldaten of andere personen",
                        "target_lang_word": "baraque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baraque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5df1b52d-3b44-3025-9ef2-8021866a500b",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Construction provisoire et légère, généralement faite en planches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9975e2ba-5f10-4c94-ba7d-399816e51e97",
                                                "sense_id": "5df1b52d-3b44-3025-9ef2-8021866a500b",
                                                "text": "Ils habitaient des baraques en planches dont une dizaine, groupées auprès du port Marie, composaient le petit hameau désigné sous le nom de village des Malouins. Deux de ces baraques étaient occupées par des cantines où on vendait du tabac, du cidre et de l’eau-de-vie ; une troisième était consacrée à la forge."
                                            },
                                            {
                                                "example_id": "d9125d7a-5da1-4fae-bc13-fd1ad58f18d2",
                                                "sense_id": "5df1b52d-3b44-3025-9ef2-8021866a500b",
                                                "text": "Il s’arrêtait devant la marchande qui a sa baraque au parvis Saint-Louis, et il lui achetait, pour Mˡˡᵉ Gilberte, un bouquet de saison."
                                            },
                                            {
                                                "example_id": "3910d696-c845-4852-9e92-d3181f61efff",
                                                "sense_id": "5df1b52d-3b44-3025-9ef2-8021866a500b",
                                                "text": "Le travail de ces milliers de condamnés à mort aura pour résultat la création d'un camp de concentration immense, contenant plus de deux cents baraques et quatre fours crématoires (le nombre des détenus de Birkenau a dépassé 100.000 pendant l'été 1944)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8065501-14b9-358a-856c-1285db01988a",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Construction mobile qui sert lieu de vente dans les fêtes foraines."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9db4f1c-7fd3-4570-bd9a-ae9b959ec95c",
                                                "sense_id": "b8065501-14b9-358a-856c-1285db01988a",
                                                "text": "Ainsi imaginait-il de vivre au milieu de monstres ridicules et misérablement comiques. Et je ne dis pas qu’au début il ne s’y était amusé, comme les amateurs de la baraque foraine […]"
                                            },
                                            {
                                                "example_id": "3f5c66f9-41c8-4e53-b2a0-b24a61bb2537",
                                                "sense_id": "b8065501-14b9-358a-856c-1285db01988a",
                                                "text": "La fête foraine (ducasse) est arrivée. Les barakis ont installé les carrousels, les manèges d’autos-tamponneuses, les loteries, les baraques à frites. On mangera ces dernières – les frites, pas les baraques – bien grasses, bien charnues, façon Jacques Brel chez Eugène, avec les doigts, à même le cornet en papier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd83708-14ad-326a-bf07-d4fce3f8cbca",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Maison mal bâtie et de chétive apparence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1048a4a-369b-48c2-8bb6-6faac680f58b",
                                                "sense_id": "2cd83708-14ad-326a-bf07-d4fce3f8cbca",
                                                "text": "En songeant à cela j’arrivai chez le sonneur de cloches Brainstein, qui demeurait au coin de la petite place, dans une vieille baraque décrépite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9638504-6ce1-307a-9b76-bb8e6ae8a6b4",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Personne de carrure imposante → voir baraqué."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e09112-6bef-41c9-be8c-6774c623dea6",
                                                "sense_id": "d9638504-6ce1-307a-9b76-bb8e6ae8a6b4",
                                                "text": "Au moment où il effectuait son troisième voyage, il remarqua un grand Noir qui l’observait, de l’autre côté de la rue, en parlant dans son téléphone portable. C’était une baraque impressionnante, au crâne rasé, il devait mesurer plus d’un mètre quatre-vingt-dix et peser dans les cent kilos, mais ses traits étaient juvéniles, il ne devait pas avoir plus de seize ans."
                                            },
                                            {
                                                "example_id": "0bf83c40-5813-4db5-b842-6972a534d464",
                                                "sense_id": "d9638504-6ce1-307a-9b76-bb8e6ae8a6b4",
                                                "text": "Comme cette équipe de baraques paramilitaires gonflées à la testostérone, surarmés…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0e48cd-c097-3d7c-a96f-1bbb3e8eb697",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Abri à foin avec un toit à quatre pans qui se hausse et se rabaisse sur quatre poteaux."
                                        ],
                                        "tags": [
                                            "Acadie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14db3723-6d5a-37d9-8d1d-39133f9fe832",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Bâtiment militaire servant de logement provisoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1d142f-4811-4d25-81ec-8b63ebf8517d",
                                                "sense_id": "14db3723-6d5a-37d9-8d1d-39133f9fe832",
                                                "text": "Le sous-lieutenant Louis Madelin, de qui les hasards de la guerre m’ont brusquement rapproché et qui m’offre un asile dans sa baraque en planches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d28886-af4f-33a6-8dbc-e613a21bad25",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Jeu de billard avec un petit casier en forme de plan incliné où l’on doit loger les billes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d6f6f8a-1f7a-3a96-a992-cfbed3be17b4",
                                        "entry_id": "67469e60-376f-3bff-b833-60aff16e5d39",
                                        "glosses": [
                                            "Maison."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
