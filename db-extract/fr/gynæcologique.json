                "senses": [
                    {
                        "sense_id": "526e7941-90db-3aa5-b471-b94f3d99daca",
                        "entry_id": "cfb2b43d-06e1-357b-8768-5aee5064641b",
                        "glosses": [
                            "Variante orthographique de gynécologique."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "43439058-adab-4c37-b628-fd291b95b5a9",
                                "sense_id": "526e7941-90db-3aa5-b471-b94f3d99daca",
                                "text": "Son disciple Thomas de Cantimpré , sous l’impulsion d’un motif on ne peut plus chrétien , traita , dans son ouvrage de Naturis rerum , de l’art gynæcologique , parce que , à défaut de cette science , il arrive qu’un grand nombre d’enfants périssent avant de naître , ou au moins avant d’avoir reçu le baptême."
                            },
                            {
                                "example_id": "acfc77db-5980-420d-a0c7-25e1de5c66f9",
                                "sense_id": "526e7941-90db-3aa5-b471-b94f3d99daca",
                                "text": "Cette proposition a été reproduite par Winkel (⁷) dans la section gynæcologique de la réunion des naturalistes de Giessen."
                            },
                            {
                                "example_id": "1b384882-ff81-4f2b-a94a-8211a908589f",
                                "sense_id": "526e7941-90db-3aa5-b471-b94f3d99daca",
                                "text": "Ce qui me suggéra cette idée, c’est une observation qu’il m’avait été permis de recueillir à la Clinique gynæcologique de Leipsick."
                            }
                        ]
                    }
                ],
