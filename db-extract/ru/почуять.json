                        "glosses": [
                            "перен., разг. осознать, понять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01dbd73a-9b5e-4cf7-9487-94a4726ac9b4",
                                "sense_id": "45859f86-d5b9-312b-ad78-f67c0699adc0",
                                "text": "― Нина Михайловна явно почуяла какую-то опасность: никогда я не мог понять, какую опасность чуют такие вот тётки с белыми лбами, когда их просят об элементарнейшей вещи: показать на секунду паспорт, чтобы можно было убедиться в отсутствии расхождений."
                            }
                        ]
                    }
