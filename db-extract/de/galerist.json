                "senses": [
                    {
                        "sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                        "entry_id": "b33e5543-0e75-3584-b3ab-9c34c1bf636b",
                        "glosses": [
                            "Betreiber einer Kunstgalerie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9b3ae0-102e-40fe-805f-95dda796c8e8",
                                "sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                                "text": "Der Galerist hatte in diesem Monat elf Gemälde verkauft."
                            },
                            {
                                "example_id": "0cc40219-4d6e-462d-8e96-23fa1665b227",
                                "sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                                "text": "„Sie war auch viel in Paris unterwegs, um Künstler, Kunsthändler und Galeristen zu besuchen.“"
                            },
                            {
                                "example_id": "7809da4a-109d-4b4f-a9f2-cc25028aeb88",
                                "sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                                "text": "„Freundschaften verbanden Remarque mit Galeristen und Buchhändlern des Ortes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57a69059-5bce-4884-be94-5fbc2bc93827",
                        "source_entry_id": "b33e5543-0e75-3584-b3ab-9c34c1bf636b",
                        "source_sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                        "source_sense_description": "Betreiber einer Kunstgalerie",
                        "target_lang_word": "gallerist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallerist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8fdd48-ae36-31fb-ab5e-0bfba0c83cc1",
                                        "entry_id": "d6abf826-1b4c-399f-ab9e-084d2f02f419",
                                        "glosses": [
                                            "The owner or operator of an art gallery"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1edc0f79-293b-4642-9b60-80f325c1c5a7",
                                                "sense_id": "ce8fdd48-ae36-31fb-ab5e-0bfba0c83cc1",
                                                "text": "Artists become gallerists in order to ensure a viewing."
                                            },
                                            {
                                                "example_id": "89f01e84-9b75-4a95-aa75-90f81b0abe6c",
                                                "sense_id": "ce8fdd48-ae36-31fb-ab5e-0bfba0c83cc1",
                                                "text": "Gallerist: Currently favored title for someone who owns a gallery. Avoids unpleasant associations with ownership (ie the tarnishing of one’s passion for art with the metallic hues of hard cash); also suggests a certain affinity with the word ‘artist’.\nWest Coast: Used by East Coast critics, gallerists, and collectors to describe anything produced west of the Hudson …"
                                            },
                                            {
                                                "example_id": "a94a8585-79ab-4707-9772-a18c88e684c4",
                                                "sense_id": "ce8fdd48-ae36-31fb-ab5e-0bfba0c83cc1",
                                                "text": "It’s an aesthetic that particularly appeals to the art dealers and gallerists who were scouring the Milan fringe shows for new talent last week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c67e4928-afaf-4b92-a8cc-c9fcbc69dab6",
                        "source_entry_id": "b33e5543-0e75-3584-b3ab-9c34c1bf636b",
                        "source_sense_id": "189d9f80-ec3e-3435-a9bb-76b7833db030",
                        "source_sense_description": "Betreiber einer Kunstgalerie",
                        "target_lang_word": "galeriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galeriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b955c5c9-ddf5-3962-a489-778c10beddd4",
                                        "entry_id": "6d6c482f-f573-3154-a784-963f7e9e70a0",
                                        "glosses": [
                                            "Personne qui tient une galerie d’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8bbc6b-ff87-4233-be81-343852972957",
                                                "sense_id": "b955c5c9-ddf5-3962-a489-778c10beddd4",
                                                "text": "Je crois, poursuivit-il, incertain, qu’habituellement le commerce d’œuvres d’art se fait par l’intermédiaire de galeries…\n— Je n’ai pas de galeriste."
                                            },
                                            {
                                                "example_id": "2ff95558-b0c3-45cc-9edf-80088b99d9b4",
                                                "sense_id": "b955c5c9-ddf5-3962-a489-778c10beddd4",
                                                "text": "Vous accorderez aussi un mandat au galeriste aux termes duquel il vous représentera pour vendre vos œuvres."
                                            },
                                            {
                                                "example_id": "f55f8467-765b-4137-9869-7d4f85cd635c",
                                                "sense_id": "b955c5c9-ddf5-3962-a489-778c10beddd4",
                                                "text": "L’autre élément psychologique de la valeur spéculative semble être une structure hiérarchique qui estampille une échelle de « valeur ». Pour qu’un caraboutcha de de Kooning, une égoutture de Pollock ou trois rectangles de couleurs de Rothko vaillent 200 millions de dollars ou plus, il faut que tout un écosystème de galeristes et de musées crée de toutes pièces une pyramide des prix en adoubant les gagnants et en grimpant sur le dos des perdants."
                                            },
                                            {
                                                "example_id": "515cf43f-7459-42df-b171-1f74917d1d95",
                                                "sense_id": "b955c5c9-ddf5-3962-a489-778c10beddd4",
                                                "text": "Éva St Esprit^([sic]), la galeriste d’Annabelle…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
