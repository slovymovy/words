                        "entry_id": "acf3e509-665b-3978-a4a3-d762a2b10808",
                        "glosses": [
                            "Première personne du singulier de l’indicatif présent du verbe endosser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "22e9bf2e-d7c0-4a28-be0a-a53a02074999",
                                "sense_id": "d727fd94-0949-30ed-abdf-82ca65b57390",
                                "text": "Tous les jours, j’endosse la veste de toile et je la « désendosse » pour le « bras de chemise »."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dbbad7e-9233-3bd2-8725-47cf736baa28",
                        "entry_id": "acf3e509-665b-3978-a4a3-d762a2b10808",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe endosser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "90454f58-8810-4fec-9e34-02ac8e8e2e51",
                                "sense_id": "1dbbad7e-9233-3bd2-8725-47cf736baa28",
                                "text": "Elle endosse le maillot jaune avec un solide matelas : trois minutes d’avance sur sa compatriote Demi Vollering et plus de quatre minutes sur la troisième, la Polonaise Katarzyna Niewiadoma."
                            },
                            {
                                "example_id": "4a784426-a4fd-4f5a-bac6-b34ff51e3160",
                                "sense_id": "1dbbad7e-9233-3bd2-8725-47cf736baa28",
                                "text": "Il est canné d’un coup de surin entre les endosses."
                            }
                        ]
                    },
