{
    "word_family": [
        "amusement",
        "amusing",
        "amused",
        "amusedly",
        "amusingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed3cf042-781c-39fb-83ba-7049a86b72f0",
                    "sense_definition": "To cause someone to laugh or find something funny.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His clever jokes rarely fail to <w>amuse</w> the audience during the show.",
                            "target_lang_translations": {
                                "ru": "Его остроумные шутки редко не могут <w>рассмешить</w> публику во время шоу."
                            }
                        },
                        {
                            "text": "It will <w>amuse</w> the children to see the clown performing tricks.",
                            "target_lang_translations": {
                                "ru": "Детям будет <w>забавно</w> увидеть, как клоун показывает фокусы."
                            }
                        }
                    ],
                    "synonyms": [
                        "entertain",
                        "please",
                        "divert"
                    ],
                    "antonyms": [
                        "bore",
                        "depress"
                    ],
                    "common_phrases": [
                        "amuse the audience",
                        "fail to amuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо смех или казаться кому-либо забавным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешить",
                                "target_lang_sense_clarification": "вызывать смех"
                            },
                            {
                                "target_lang_word": "рассмешить",
                                "target_lang_sense_clarification": "заставить кого-либо засмеяться"
                            },
                            {
                                "target_lang_word": "забавлять",
                                "target_lang_sense_clarification": "вызывать ироническое или веселое отношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dba8de73-ad17-311a-a6f8-3c1895871507",
                    "sense_definition": "To keep someone interested and occupied in a pleasant way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group of children spent the afternoon <w>amusing</w> themselves by drawing pictures.",
                            "target_lang_translations": {
                                "ru": "Группа детей провела вторую половину дня, <w>развлекая</w> себя рисованием картинок."
                            }
                        },
                        {
                            "text": "I brought a book to <w>amuse</w> myself while waiting for the train.",
                            "target_lang_translations": {
                                "ru": "Я взял с собой книгу, чтобы <w>развлечься</w>, пока жду поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "entertain",
                        "divert"
                    ],
                    "antonyms": [
                        "tire",
                        "weary"
                    ],
                    "common_phrases": [
                        "amuse oneself",
                        "amuse the kids"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать чей-либо интерес и занимать кого-либо приятным делом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлекать",
                                "target_lang_sense_clarification": "занимать чем-либо приятным"
                            },
                            {
                                "target_lang_word": "забавлять",
                                "target_lang_sense_clarification": "занимать чем-либо веселым"
                            },
                            {
                                "target_lang_word": "развлечь",
                                "target_lang_sense_clarification": "помочь приятно провести время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56e28f6a-23ef-3f09-b9a6-e3f3b14a4ce6",
                    "sense_definition": "To fully occupy or distract someone's attention, sometimes to the point of bewilderment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were <w>amused</w> by the distant fires while the enemy approached from behind.",
                            "target_lang_translations": {
                                "ru": "Солдаты были <w>отвлечены</w> далекими огнями, пока враг приближался сзади."
                            }
                        },
                        {
                            "text": "He was so <w>amused</w> with grief and fear that he could not find his way home.",
                            "target_lang_translations": {
                                "ru": "Он был так <w>ошеломлен</w> горем и страхом, что не мог найти дорогу домой."
                            }
                        }
                    ],
                    "synonyms": [
                        "beguile",
                        "divert"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of being distracted or bewildered is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью занять или отвлечь чье-либо внимание, иногда до состояния замешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвлекать",
                                "target_lang_sense_clarification": "переключать внимание на другое"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "полностью поглощать внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "064ed15a-4846-340e-acc2-f09df9598343",
                    "sense_definition": "To deceive or delude someone by keeping them in a state of expectation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat tried to <w>amuse</w> the rebels with false promises of a treaty.",
                            "target_lang_translations": {
                                "ru": "Дипломат пытался <w>завлечь</w> повстанцев ложными обещаниями о мирном договоре."
                            }
                        },
                        {
                            "text": "They were <w>amused</w> with vain hopes until it was too late to escape.",
                            "target_lang_translations": {
                                "ru": "Их <w>обольщали</w> напрасными надеждами, пока не стало слишком поздно для побега."
                            }
                        }
                    ],
                    "synonyms": [
                        "beguile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of deluding or beguiling is historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать или вводить в заблуждение, поддерживая в человеке состояние ожидания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завлекать",
                                "target_lang_sense_clarification": "хитростью побуждать к чему-либо"
                            },
                            {
                                "target_lang_word": "обольщать",
                                "target_lang_sense_clarification": "вводить в заблуждение надеждами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
