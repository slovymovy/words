                        "examples": [
                            {
                                "example_id": "f3e7fc60-2e95-42fc-bda6-2d04e3828426",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Steffen ist gerade im Urlaub."
                            },
                            {
                                "example_id": "df3e4b5e-41ad-4f51-9081-e8d2d7920916",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Steffens Schwester arbeitet auf einem Kreuzfahrtschiff."
                            },
                            {
                                "example_id": "b976c02b-e3eb-43f0-9277-328ce83f5a89",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Der Steffen war heute in Bad Tölz zu Besuch bei Verwandten."
                            },
                            {
                                "example_id": "9d36e997-aeb5-46da-92ea-b3d1e6d845c4",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Wo hat der Steffen schon wieder den Schuhlöffel versteckt?"
                            },
                            {
                                "example_id": "41fd19f3-e3a5-4f98-9236-4f08ad1fbc4b",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Das ist das Auto des Steffen."
                            },
                            {
                                "example_id": "45fef73d-c511-42bc-8637-d93e9d08cc05",
                                "sense_id": "f8470439-f004-38b5-900c-25ca7ea05633",
                                "text": "Des Steffens größter Widersacher ist Bruno."
                            }
                        ],
