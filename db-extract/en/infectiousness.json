                                    {
                                        "sense_id": "1ecec7ab-bf9b-36b3-ad6d-c607d9017e6f",
                                        "entry_id": "ba2e1646-10e4-3395-9530-332638412ea5",
                                        "glosses": [
                                            "Eigenschaft, als Krankheitserreger eine Ansteckung (Infektion) auslösen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d26d368-f9fb-47a6-b384-caa205cf4899",
                                                "sense_id": "1ecec7ab-bf9b-36b3-ad6d-c607d9017e6f",
                                                "text": "„Dies bedeutet, dass die Infektiosität von Viren in noch feuchten oder bereits eingetrockneten Ausscheidungen, Körpersekreten oder zellhaltigen Blutresten mit hohem Proteingehalt deutlich länger erhalten bleiben kann.“"
                                            },
                                            {
                                                "example_id": "9d305dab-4098-4a01-aff7-e9e9d8065df1",
                                                "sense_id": "1ecec7ab-bf9b-36b3-ad6d-c607d9017e6f",
                                                "text": "„Die Infektiosität bleibt bei 56°C mindestens 5 Stunden erhalten. Gebräuchliche Desinfektionsmittel sind wenig wirksam; deutliche Reduktion der Infektiosität bewirkt 0,5%iges Formaldehyd nach sechsstündiger Einwirkung.“"
                                            },
                                            {
                                                "example_id": "e5c25758-ea76-4210-bed3-637b1bdba223",
                                                "sense_id": "1ecec7ab-bf9b-36b3-ad6d-c607d9017e6f",
                                                "text": "[Coronaimpfung 2021:] „Und es ist so: Die Infektiosität im Hals, die wird durch die Impfung nach ein paar Monaten nach der Impfung, nach einer Latenzzeit nicht mehr unterbunden, sondern nur verkürzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
