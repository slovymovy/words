    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a22df6e1-db56-32da-8a3e-2a1af6d8fee9",
                    "sense_definition": "Present participle and gerund of <w>pursue</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>pursuing</w> a degree in computer science at the university.",
                            "target_lang_translations": {
                                "ru": "В настоящее время она <w>получает</w> диплом в области информатики в университете.",
                                "de": "Sie <w>strebt</w> derzeit einen Abschluss in Informatik an der Universität <w>an</w>."
                            }
                        },
                        {
                            "text": "The police officer ran down the alley, <w>pursuing</w> the suspect on foot.",
                            "target_lang_translations": {
                                "ru": "Полицейский бежал по переулку, <w>преследуя</w> подозреваемого пешком.",
                                "de": "Der Polizist rannte die Gasse hinunter und <w>verfolgte</w> den Verdächtigen zu Fuß."
                            }
                        }
                    ],
                    "synonyms": [
                        "chasing",
                        "following",
                        "seeking",
                        "tracking"
                    ],
                    "antonyms": [
                        "fleeing",
                        "ignoring",
                        "avoiding"
                    ],
                    "common_phrases": [
                        "pursuing a career",
                        "pursuing a goal",
                        "pursuing happiness",
                        "pursuing justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>pursue</w> (преследовать, стремиться, заниматься).",
                        "de": "Partizip Präsens und Gerundium von pursue (verfolgen, nachgehen, anstreben)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследующий",
                                "target_lang_sense_clarification": "физически или метафорически"
                            },
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "к цели, успеху"
                            },
                            {
                                "target_lang_word": "преследуя",
                                "target_lang_sense_clarification": "деепричастие; в процессе погони"
                            },
                            {
                                "target_lang_word": "занимающийся",
                                "target_lang_sense_clarification": "изучением или деятельностью"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verfolgend",
                                "target_lang_sense_clarification": "ein Ziel oder eine Person verfolgend"
                            },
                            {
                                "target_lang_word": "verfolgen",
                                "target_lang_sense_clarification": "Ziele, Pläne oder Täter verfolgen"
                            },
                            {
                                "target_lang_word": "nachgehen",
                                "target_lang_sense_clarification": "einer Tätigkeit, Ausbildung oder Karriere nachgehen"
                            },
                            {
                                "target_lang_word": "anstreben",
                                "target_lang_sense_clarification": "einen Abschluss oder ein Ziel anstreben"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0ebd6a6-b07e-33c3-8f58-04fe92867ef4",
                    "sense_definition": "The act of striving for something or an activity that one engages in; a pursuit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His various artistic <w>pursuings</w> took him to many different countries over the years.",
                            "target_lang_translations": {
                                "ru": "Его разнообразные творческие <w>искания</w> за эти годы приводили его во многие страны.",
                                "de": "Seine verschiedenen künstlerischen <w>Bestrebungen</w> führten ihn im Laufe der Jahre in viele verschiedene Länder."
                            }
                        },
                        {
                            "text": "She found little satisfaction in her idle <w>pursuings</w> of fame and fortune.",
                            "target_lang_translations": {
                                "ru": "Она находила мало удовлетворения в своей праздной <w>погоне</w> за славой и богатством.",
                                "de": "Sie fand wenig Erfüllung in ihrem müßigen <w>Streben</w> nach Ruhm und Reichtum."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursuit",
                        "endeavor",
                        "undertaking"
                    ],
                    "antonyms": [
                        "avoidance",
                        "retreat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по достижению чего-либо или деятельность, которой занимается человек; преследование, занятие.",
                        "de": "Das Streben nach etwas oder eine Tätigkeit, der man nachgeht; Bestreben oder Beschäftigung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искание",
                                "target_lang_sense_clarification": "творческий или духовный поиск"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание достичь чего-либо"
                            },
                            {
                                "target_lang_word": "погоня",
                                "target_lang_sense_clarification": "преследование цели (часто недостижимой)"
                            },
                            {
                                "target_lang_word": "занятие",
                                "target_lang_sense_clarification": "род деятельности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Streben",
                                "target_lang_sense_clarification": "nach Erfolg, Ruhm etc."
                            },
                            {
                                "target_lang_word": "die Verfolgung",
                                "target_lang_sense_clarification": "von Zielen oder Absichten"
                            },
                            {
                                "target_lang_word": "die Beschäftigung",
                                "target_lang_sense_clarification": "Tätigkeit oder Bestreben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
