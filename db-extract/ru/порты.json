                                                "sense_id": "ec63560a-2d32-37ab-bd02-87a89993f88f",
                                                "text": "You're talking pants!"
                                            },
                                            {
                                                "example_id": "9c72cf8b-137b-4f57-bb2e-7fbac1482dee",
                                                "sense_id": "ec63560a-2d32-37ab-bd02-87a89993f88f",
                                                "text": "The film was a load [or pile] of pants."
                                            }
