                "translations": [
                    {
                        "translation_id": "35d647fe-1bbc-4a95-83c3-60c558e66d57",
                        "source_entry_id": "cee6153f-7f3d-374b-9ec3-d176b67abd67",
                        "source_sense_description": "утверждать постановление, судебный приговор",
                        "target_lang_word": "ratify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                        "entry_id": "ba04f406-a857-3479-a002-b1a8d7d1ee2b",
                                        "glosses": [
                                            "To give formal consent to; make officially valid, sign off on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d80b79-d805-4bc5-89a1-b70437d58769",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "They ratified the treaty."
                                            },
                                            {
                                                "example_id": "e29af982-6b77-46fe-8804-44975617b9e1",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "Thus the workmen decide the principle, the Executive carry it out. The agent provides information and negotiates. The Conference finally ratifies or disapproves."
                                            },
                                            {
                                                "example_id": "85c8644b-48cc-48c7-9b3c-d7598255edff",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "If the Senate ratifies the covenant on human rights and the Supreme Court upholds it under the established principles outlined above, freedom of speech, freedom of the press, and freedom of peaceful assembly may be destroyed by our own Government at any time by an official proclamation of a state of emergency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30288007-35e2-4f5e-84dd-62f37702d7c7",
                        "source_entry_id": "cee6153f-7f3d-374b-9ec3-d176b67abd67",
                        "source_sense_description": "принимать в церковную общину",
                        "target_lang_word": "confirm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2422e92-562e-35fb-b71a-d0eb2ae5c692",
                                        "entry_id": "82debc1c-d63f-38bd-bd8c-0e4907b5b17a",
                                        "glosses": [
                                            "To strengthen; to make firm or resolute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdf84845-f13c-3337-b589-e226c78ec715",
                                        "entry_id": "82debc1c-d63f-38bd-bd8c-0e4907b5b17a",
                                        "glosses": [
                                            "To administer the sacrament of confirmation on (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895ce6fa-eec8-40ee-8ddf-05c31566a98d",
                                                "sense_id": "bdf84845-f13c-3337-b589-e226c78ec715",
                                                "text": "She pulled through with the boy till he was confirmed; but then she told him that she could not feed him any longer; he would have to go out and earn his own bread."
                                            },
                                            {
                                                "example_id": "25e65bb9-1f41-434a-a8c0-0a4ebfae8341",
                                                "sense_id": "bdf84845-f13c-3337-b589-e226c78ec715",
                                                "text": "Elizabeth, daughter of Henry VIII, was baptized and confirmed at the age of three days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4e6888-248c-37a1-9473-9fed105f217a",
                                        "entry_id": "82debc1c-d63f-38bd-bd8c-0e4907b5b17a",
                                        "glosses": [
                                            "To assure the accuracy of previous statements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d7f8b7-64dd-40e4-8b3e-40b15b13d29f",
                                                "sense_id": "4a4e6888-248c-37a1-9473-9fed105f217a",
                                                "text": "Despite all the evidence confirming the existence of the Protheans, little is known about their culture and society. From time to time, dig sites will yield new clues, but after 50,000 years of decay, little of value is unearthed."
                                            },
                                            {
                                                "example_id": "942d450c-aa76-48c5-b3ad-d0de9ac7944d",
                                                "sense_id": "4a4e6888-248c-37a1-9473-9fed105f217a",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            },
                                            {
                                                "example_id": "1d1be11a-d1b4-4275-9899-a059e6d9351e",
                                                "sense_id": "4a4e6888-248c-37a1-9473-9fed105f217a",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f0542f-7a7a-37bc-ab1a-c8053c0f78e2",
                                        "entry_id": "82debc1c-d63f-38bd-bd8c-0e4907b5b17a",
                                        "glosses": [
                                            "To approve a proposal or nomination."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a9e48a-6fa7-458b-878c-596628671f80",
                                                "sense_id": "62f0542f-7a7a-37bc-ab1a-c8053c0f78e2",
                                                "text": "The Senate must confirm federal court appointments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confirm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd693b70-329d-3e8d-b3ab-6ae3d5a2406f",
                                        "entry_id": "22a6cf64-ab6d-39d5-8e59-1b169ce6bd62",
                                        "glosses": [
                                            "For sure, definitely."
                                        ],
