                    {
                        "translation_id": "37cd46b3-355d-4873-9059-eee380384cd7",
                        "source_entry_id": "c21c251f-6572-34c4-a999-cb89e6b794b6",
                        "source_sense_id": "656e9a75-def1-3384-9f86-5253dd3e4cc2",
