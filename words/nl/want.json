            "senses": [
                {
                    "sense_id": "a80f0395-988d-3c0b-8e45-3f4b10c08f43",
                    "sense_definition": "een handschoen waarbij de vier vingers in één ruimte zitten en de duim apart",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de koude winter droeg ze een dikke <w>want</w> om haar hand warm te houden.",
                            "target_lang_translations": {
                                "en": "During the cold winter, she wore a thick <w>mitten</w> to keep her hand warm."
                            }
                        },
                        {
                            "text": "De kinderen verloren hun <w>wanten</w> in de sneeuw tijdens het spelen.",
                            "target_lang_translations": {
                                "en": "The children lost their <w>mittens</w> in the snow while playing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een paar wanten"
                    ],
                    "target_lang_definitions": {
