                "senses": [
                    {
                        "sense_id": "6d2f23c7-bcf0-342c-8a75-a60d94ddd209",
                        "entry_id": "e088985d-81f8-3ec4-8e30-7e753eef190e",
                        "glosses": [
                            "Donner un caractère épidémique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a799636-5560-497a-bf59-1aff25f25679",
                                "sense_id": "6d2f23c7-bcf0-342c-8a75-a60d94ddd209",
                                "text": "Une présence solaire qui épidémise le frisson."
                            },
                            {
                                "example_id": "8ce80fa5-ab55-4315-83f2-45a1edecc42a",
                                "sense_id": "6d2f23c7-bcf0-342c-8a75-a60d94ddd209",
                                "text": "Du Sempé, on en regorge, ça pullule, ça épidémise."
                            },
                            {
                                "example_id": "cc886db1-d6b9-42bc-bd14-122aed3c9deb",
                                "sense_id": "6d2f23c7-bcf0-342c-8a75-a60d94ddd209",
                                "text": "Cependant, lorqu’elle se réveille au printemps, il s’écoule deux mois avant qu’elle ne s’épidémise réellement"
                            }
                        ]
                    }
