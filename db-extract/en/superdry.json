                        "examples": [
                            {
                                "example_id": "c31722ae-1459-4d41-a92f-a46edbd32d4a",
                                "sense_id": "775cc48b-1ced-3c22-af9e-956fbe2c5755",
                                "text": "Most of the game can still find enough old grass to subsist. But the superdry food and the lack of vitamins cause constipation, and the affected animals are soon so weakened that, after a last visit to a water hole, they will remain there, to wait in the insignificant shade of a gray tamarisk bush for the night, the hyenas, and the inevitable."
                            },
                            {
                                "example_id": "b4a77777-435b-400e-b1ce-8a8c7c1b11d7",
                                "sense_id": "775cc48b-1ced-3c22-af9e-956fbe2c5755",
                                "text": "She tried to find her voice, which was hiding somewhere inside her superdry throat."
                            },
                            {
                                "example_id": "4d40e15b-c86a-4385-a9fd-ac1332a46db1",
                                "sense_id": "775cc48b-1ced-3c22-af9e-956fbe2c5755",
                                "text": "Once the broccolini are cool, you have to get them very dry, so let them drain in a colander, spin them in a salad spinner, dab them with paper towels, or even drive around the block a few times holding them out the window…just get them superdry."
                            }
                        ]
                    }
