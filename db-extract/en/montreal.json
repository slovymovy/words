                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc9fb01-4aea-4343-802b-69f9c57fc4cf",
                                                "sense_id": "35e6abef-eebf-3395-8745-86aaa78d47ef",
                                                "text": "Je reviendrai à Montréal\nDans un grand Boeing bleu de mer ;\nJ’ai besoin de revoir l’hiver\nEt ses aurores boréales."
                                            },
                                            {
                                                "example_id": "b89979df-f584-460d-ab73-0fd88785a49e",
                                                "sense_id": "35e6abef-eebf-3395-8745-86aaa78d47ef",
                                                "text": "Demain matin, Montréal m’attend"
                                            },
                                            {
                                                "example_id": "3b7504a6-570f-43d5-9645-a10d81d5ee6a",
                                                "sense_id": "35e6abef-eebf-3395-8745-86aaa78d47ef",
                                                "text": "J’ai eu pas mal de clients avec le gaz qui a remonté à Montréal les gens vont tinquer aujourd’hui, et toi?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa10043-c6c8-3c31-b0a9-9c1005a8d8ba",
