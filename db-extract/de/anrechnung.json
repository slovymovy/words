                        "entry_id": "0383d6e0-01ab-3a3e-88a6-2bbc985a99c9",
                        "glosses": [
                            "Abzug oder Berücksichtigung einer erbrachten (zu erbringenden) Leistung oder einer Zeitdauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c3af85-7e36-45c6-98a6-910a6e6ddab4",
                                "sense_id": "0462c531-fddf-3fa0-8298-98f165d6fc5e",
                                "text": "Die Anrechnung der Kosten für Porto und Verpackung unterbleibt, wenn der Wert der Sendung 100€ überschreitet."
                            },
                            {
                                "example_id": "b7182fb6-702f-4de7-8694-39a98d6e5cad",
                                "sense_id": "0462c531-fddf-3fa0-8298-98f165d6fc5e",
                                "text": "Unter Anrechnung der Untersuchungshaft muss er noch zwei Jahre absitzen."
                            },
                            {
                                "example_id": "4999a25f-fab6-491a-afca-e1bfeb786677",
                                "sense_id": "0462c531-fddf-3fa0-8298-98f165d6fc5e",
                                "text": "Um eine Doppelbesteuerung zu vermeiden gibt es die Möglichkeit der Anrechnung der ausländischen Steuern auf die deutsche Einkommensteuer."
                            }
                        ],
                        "sense_index_json": "\"1\""
