                        "examples": [
                            {
                                "example_id": "a63731d8-af7f-4865-a89a-3af41d4eb666",
                                "sense_id": "a650af61-5d9d-3bdd-acd9-067dd09a10f4",
                                "text": "Я подозреваю, что мне с Дианой Львовной еще не раз предстоит встретиться."
                            },
                            {
                                "example_id": "0a0c0d5e-da8f-4df1-b689-4159a4b1d71e",
                                "sense_id": "a650af61-5d9d-3bdd-acd9-067dd09a10f4",
                                "text": "Представил меня своей супруге Эмилии Львовне, даме некрасивой, но интересной и живой, торжественно восседавшей в конце длинного стола."
                            }
                        ]
                    }
