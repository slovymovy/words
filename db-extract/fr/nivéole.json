                ],
                "senses": [
                    {
                        "sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                        "entry_id": "ddf3bdbe-760d-3f2c-ade9-6cd019042479",
                        "glosses": [
                            "Plante herbacée à bulbes et toxique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af818f89-723c-4cb1-9bbf-43b59d542b32",
                                "sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                                "text": "La lisière de ce bois, vers l’Est, est couverte, de la fin de février à la fin de mars, de petites fleurs blanches qui forment un vaste tapis de près de deux kilomètres. Ce sont, des nivéoles, que les gens du pays appellent des glaudinettes."
                            },
                            {
                                "example_id": "6cac2368-98da-4c67-9b26-a9aac767779c",
                                "sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                                "text": "Quels parterres auront pu ainsi être établis artificiellement dans les bois d’agrément avec les pervenches, les primevères, les scilles, les cyclamens, les sceaux de Salomon, les galanthes, les nivéoles, le saxifrage ombreux, etc… ^([sic : etc.]) […]"
                            },
                            {
                                "example_id": "815303db-f82c-4fbd-9ce0-759d33f02264",
                                "sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                                "text": "En revanche, la nivéole, une cousine du perce-neige, ne se trouve quasi exclusivement dans les forêts de Hauts-de-France, que sur les anciens sites habités... ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6720824-2e4e-4e06-b18f-384df9ba618c",
                        "source_entry_id": "ddf3bdbe-760d-3f2c-ade9-6cd019042479",
                        "source_sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                        "target_lang_word": "Märzenbecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Märzenbecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8606dd28-8d61-305e-b8d4-913fe89d1c3c",
                                        "entry_id": "fe9bdcc4-c51f-3001-bec5-1fb3bd6b6094",
                                        "glosses": [
                                            "frühblühende weiße Blume"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431d97dc-de63-4e14-9345-d8b0100f85bb",
                                                "sense_id": "8606dd28-8d61-305e-b8d4-913fe89d1c3c",
                                                "text": "Der Märzenbecher blüht meistens etwas später als das Schneeglöckchen."
                                            },
                                            {
                                                "example_id": "6e1409aa-4826-4f22-9003-9a38569ba0d7",
                                                "sense_id": "8606dd28-8d61-305e-b8d4-913fe89d1c3c",
                                                "text": "„Draußen lag ein Beet mit aufgeblühten Märzenbechern, und die ersten Blätter der Johannisbeersträucher zeigten sich bereits.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49496566-3dd0-32ce-9438-caf264ba7fd2",
                                        "entry_id": "fe9bdcc4-c51f-3001-bec5-1fb3bd6b6094",
                                        "glosses": [
                                            "regional für die Osterglocke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4396053c-96ab-48ab-9109-88b3dfe9604b",
                                                "sense_id": "49496566-3dd0-32ce-9438-caf264ba7fd2",
                                                "text": "Märzenbecher und Tulpen sind die beliebtesten Zierpflanzen des Frühjahrs."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd6ed3ad-b550-4c65-b3b0-9846ee8ceb41",
                        "source_entry_id": "ddf3bdbe-760d-3f2c-ade9-6cd019042479",
                        "source_sense_id": "8550d7fe-c769-3f90-a7d0-f636ad4b3271",
                        "target_lang_word": "snowflake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowflake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e35ed2e-4b18-39cb-a878-ae35cf62be2e",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "A crystal of snow, having approximate hexagonal symmetry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcf4058a-719f-38d8-a489-584fdbb46d8d",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "Any of several bulbous European plants, of the genus Leucojum, having white flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "817b9869-4966-3b7a-92e0-a32e73f7c5f3",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "The snow bunting, Plectrophenax nivalis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef8cb8a5-1e3a-33b9-8c1c-521c29469bc5",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "Someone who believes they are particularly unique and special."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2d8064-6461-424f-ab6f-466c540c4bc5",
                                                "sense_id": "ef8cb8a5-1e3a-33b9-8c1c-521c29469bc5",
                                                "text": "When I come home, one space monkey is reading to the assembled space monkeys who sit covering the whole first floor. “You are not a beautiful and unique snowflake. You are the same decaying organic matter as everyone else, and we are all part of the same compost pile.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f0f3b0-029f-379c-86da-7231a01355a8",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "Someone hypersensitive to insult or offense, especially a young person with politically correct sensibilities."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9d2c009-35c9-42e3-8b4a-6a3f05acc61b",
                                                "sense_id": "11f0f3b0-029f-379c-86da-7231a01355a8",
                                                "text": "When have words ever hurt anyone? The triggered snowflakes at this liberal university are trying to literally murder our freedom of speech."
                                            },
                                            {
                                                "example_id": "ed3d30f8-075a-4665-96f0-15d4c9de68b4",
                                                "sense_id": "11f0f3b0-029f-379c-86da-7231a01355a8",
                                                "text": "Fox News pundits claim to be upset because companies are choosing to embrace the \"holidays\" rather than \"Christmas\" to avoid offending any liberal snowflakes."
                                            },
                                            {
                                                "example_id": "bb5e0556-8d73-4c93-802e-388f73c2cf25",
                                                "sense_id": "11f0f3b0-029f-379c-86da-7231a01355a8",
                                                "text": "Now, at least in theory, snowflakes on both coasts in withdrawal from Rachel Maddow’s nightly Kremlinology lesson can purchase a whole book to inspire paroxysms of rage. “White” — even the title is a trigger — is a veritable thirst trap for the easily microaggressed."
                                            },
                                            {
                                                "example_id": "b1bebf76-1960-4ce2-b444-26fb10938549",
                                                "sense_id": "11f0f3b0-029f-379c-86da-7231a01355a8",
                                                "text": "Within a few minutes of stepping foot on the school grounds, a triggered snowflake called the police. Multiple officers accosted Kevin McMahon, a YAF staffer, and threatened to arrest him for exercising his free speech rights since he was outside the designated \"free speech area.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4e2359-f68f-3fc8-95a1-3c382592c4a8",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "A type of lesion that appears as scattered white-brown spots under high magnification light microscopy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da4d89d-263e-4733-bca2-9547f6416de7",
                                                "sense_id": "5b4e2359-f68f-3fc8-95a1-3c382592c4a8",
                                                "text": "Robertson and colleagues reported 10 patients in four families with lesions similar to those of stage I and stage II snowflake generation."
                                            },
                                            {
                                                "example_id": "1e0f037b-978d-4168-ae2e-538e0e9d85bb",
                                                "sense_id": "5b4e2359-f68f-3fc8-95a1-3c382592c4a8",
                                                "text": "The authors have recently analyzed a PMMA lens explanted because of snowflake degeneration in the dry and hydrated states."
                                            },
                                            {
                                                "example_id": "2a23db2b-805e-4467-bdaa-3a2112701afe",
                                                "sense_id": "5b4e2359-f68f-3fc8-95a1-3c382592c4a8",
                                                "text": "These defects may be more pronounced in the superior visual field, perhaps corresponding to the inferior predilection for the snowflake lesions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c20152-ed15-371d-ab1e-14ffb8a17ddc",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "Something that is unique in every presentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a179a51-f1dd-46f7-a127-b9625f761b30",
                                                "sense_id": "e1c20152-ed15-371d-ab1e-14ffb8a17ddc",
                                                "text": "MS is referred to as a “snowflake” disease because symptoms vary from person to person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a2b700-5c8b-35d5-bcd6-2187b4006c83",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "A Caucasian person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02deaae-9466-4d51-8df9-3021eff73dec",
                                                "sense_id": "09a2b700-5c8b-35d5-bcd6-2187b4006c83",
                                                "text": "Alright, snowflake, where's the dope?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29770b55-782f-35fe-8563-c02df1a907ba",
                                        "entry_id": "f7f58998-67af-3ed0-804e-8143de4829fb",
                                        "glosses": [
                                            "Someone (usually white) who was opposed to the abolition of slavery (Missouri, 1860s)"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snowflake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c87b90c-ca91-3be8-841e-04589ba2d55e",
                                        "entry_id": "83dfe933-a97f-3a0b-a415-05c928a6aedc",
