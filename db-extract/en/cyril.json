                                        "examples": [
                                            {
                                                "example_id": "dc2db169-5180-46e2-a11f-d1d6f6693eeb",
                                                "sense_id": "3440ca68-aeb2-3048-99d3-8669fa60b7b0",
                                                "text": "À 41 ans, Cyril Hanouna est le roi du bac à sable. Un saltimbanque populaire qui fait rire autant qu'il énerve. Une vraie tête à clashs."
                                            },
                                            {
                                                "example_id": "ec08c367-cb14-45cd-b0ce-8e8641f5f6bb",
                                                "sense_id": "3440ca68-aeb2-3048-99d3-8669fa60b7b0",
                                                "text": "La série « Parler à ceux que l’on n’écoute jamais ! », réalisée par Cyril Zannettacci, plonge au cœur d’une unité de soins pour sans-abri durant l’épidémie du Covid-19."
                                            },
                                            {
                                                "example_id": "5b0887aa-d52d-4261-a028-8e9a96126b85",
                                                "sense_id": "3440ca68-aeb2-3048-99d3-8669fa60b7b0",
                                                "text": "Ils s’appellent Pierre, Justine, Nicolas, Rémi, Cyril, Antoine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
