                    {
                        "translation_id": "ef1bc468-2a41-4409-a329-272a8be9415b",
                        "source_entry_id": "e2f8898f-6b1d-3f64-b1e4-6835465e144a",
                        "source_sense_id": "47f424d4-efa4-3a47-8697-fb0571ab8939",
