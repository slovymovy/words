        "fr-extract.jsonl": [
            {
                "entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                "word": "infinité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8db9c840-74e4-448d-adf5-c1ad7beff344",
                        "entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "infinités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8f8e3c9-83b3-33d1-897e-9071cd9ceb46",
                        "entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                        "glosses": [
                            "Qualité de ce qui est infini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e898010-2da9-4482-8893-94296500944e",
                                "sense_id": "c8f8e3c9-83b3-33d1-897e-9071cd9ceb46",
                                "text": "Je comprends que ce mythe de la grève générale froisse beaucoup de gens sages à cause de son caractère d’infinité ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "41a7ab8e-c430-36ec-ab5f-e22676b8602e",
                        "entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                        "glosses": [
                            "Un très grand nombre."
                        ],
                        "tags": [
                            "D’une manière plus générale"
                        ],
                        "examples": [
                            {
                                "example_id": "2f16176f-54ea-4627-92bd-3de2ead59cec",
                                "sense_id": "41a7ab8e-c430-36ec-ab5f-e22676b8602e",
                                "text": "Jusqu’après Valpuiseaux, sur plus d'une lieue, les groupes de fermes se suivent. Ensuite le vallon est solitaire, pli étroit et profond dont les côtés sont striés par une infinité de vaux très courts."
                            },
                            {
                                "example_id": "225a9576-a29d-4a96-a855-80f0ee7cdd81",
                                "sense_id": "41a7ab8e-c430-36ec-ab5f-e22676b8602e",
                                "text": "On pourrait vous alléguer une infinité de raisons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24312a29-d8ba-4c76-b267-87af512e03a5",
                        "source_entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                        "source_sense_description": "qualité de ce qui est infini",
                        "target_lang_word": "Unendlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unendlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "nicht begrenzter Zustand; Ausmaß, dessen Grenzen nicht absehbar sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b303c7-7033-4ed2-b620-d92be8286d5e",
                                                "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                                "text": "„Auch im Bild findet sich eine Grenze, die den sinnierenden Mönch von der Unendlichkeit des Meeres und des Himmels trennt.“"
                                            },
                                            {
                                                "example_id": "2b14185b-b302-4181-8442-728f4e9a630b",
                                                "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                                "text": "„Aber die alten Reisenden, die auf Segelschiffen die Welt durchquerten, waren mindestens genauso dramatisch, glaubten an Monster und rachsüchtige Göttinnen und die Unendlichkeit einer Welt, die sie nicht verstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "etwas nicht in einem begrenzten Zeitraum Abzählbares"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d3f2e0-d51e-4923-868e-c5d081534a5e",
                                                "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                                "text": "„Zwei Mathematiker haben bewiesen, dass zwei Unendlichkeiten gleich groß sind.“"
                                            },
                                            {
                                                "example_id": "d485011e-6dd1-4eb5-922d-d93d7c519368",
                                                "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                                "text": "„Ob Keplers Vermutung zur Kugelpackung, das Rätsel der Primzahlen-Zwillinge oder die Frage nach verschiedenen Unendlichkeiten: In der Mathematik geht es oft darum, allgemeingültige Muster und Gesetzmäßigkeiten zu erkennen und mathematisch zu beweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7bb93946-76eb-38db-8810-f94b553adadf",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "etwas nicht in begrenzter Zeit Durchmessbares"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754c2d93-23d6-46e9-a7ea-511e94188894",
                                                "sense_id": "7bb93946-76eb-38db-8810-f94b553adadf",
                                                "text": "„Als Lee Jay darunter stand, meinte er, es ginge in alle Unendlichkeit des schwarzen Himmels über ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9ba934af-2ad4-3115-9dd9-f157f57fbaaf",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "langer Zeitraum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3a48c8b7-2113-37c1-8da2-ce958e72b53a",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "Zeitlosigkeit ohne Anfang und ohne Ende"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66407fb0-35fc-4895-981b-5fa81018e657",
                        "source_entry_id": "a994b54c-a3f6-3126-9bcb-e74f9efcd8fd",
                        "source_sense_description": "qualité de ce qui est infini",
                        "target_lang_word": "infinity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35346cee-45a8-3809-84ea-5facb28689d7",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "endlessness, unlimitedness, absence of a beginning, end or limits to size."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b55a8974-f0b6-3110-8049-8af62fe98786",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "A number that has an infinite numerical value that cannot be counted."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87599f1-dca0-4bf4-ba55-3b9badec9c76",
                                                "sense_id": "b55a8974-f0b6-3110-8049-8af62fe98786",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains. Getting rid of these nagging infinities has probably occupied far more effort than was spent in originating the theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888bba83-e849-36b6-92b4-92f7dab999a0",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "An idealised point which is said to be approached by sequences of values whose magnitudes increase without bound."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa9389b3-48fe-3bc7-84f2-4b73c9110c0f",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "A number which is very large compared to some characteristic number. For example, in optics, an object which is much further away than the focal length of a lens is said to be \\\"at infinity\\\", as the distance of the image from the lens varies very little as the distance increases further."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08370ffc-07f2-3710-bb51-ffa2126965c4",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "The symbol ∞."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
