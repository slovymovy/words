                            {
                                "example_id": "a4ea3a3c-30b9-4774-a981-682fe64161a9",
                                "sense_id": "1d4eeb0e-b9c2-37a6-b8f7-d36842b2d216",
                                "text": "Het bos was zo aangelegd dat verschillende vomen van vrijetijdsbeoefening en sportbeoefening veilig naast elkaar gedaan konden worden."
                            },
                            {
                                "example_id": "2d38bcaa-b24d-424f-9f3a-d9a9b03efa21",
                                "sense_id": "1d4eeb0e-b9c2-37a6-b8f7-d36842b2d216",
                                "text": "Industrialisering en anglocentrisme Die wereldwijde verspreiding is steeds vaker onderwerp van recente sportgeschiedenissen, maar dat neemt niet weg dat er consensus bestaat over waar de voedingsbodem voor moderne sportbeoefening het vruchtbaarst was: in het industrialiserende Verenigd Koninkrijk."
                            },
                            {
                                "example_id": "79fab713-bcf3-44e7-ac18-ba2636d601f4",
                                "sense_id": "1d4eeb0e-b9c2-37a6-b8f7-d36842b2d216",
                                "text": "In Europees perspectief zijn er ook andere kraamkamers van moderne sportbeoefening aan te wijzen, bijvoorbeeld de wintersporten als afgeleide van de Scandinavische levensstijl, de continentale oorsprong van wielrennen en de Duitse en Oost- Europese turncultuur."
                            },
                            {
                                "example_id": "5ca40d83-8f94-48fd-9301-1022b4473fb9",
                                "sense_id": "1d4eeb0e-b9c2-37a6-b8f7-d36842b2d216",
                                "text": "Zo concludeert historisch onderzoek uit de jaren zeventig van de vorige eeuw dat 'de Industriële Revolutie' een negatieve invloed had op sportbeoefening."
                            }
                        ]
