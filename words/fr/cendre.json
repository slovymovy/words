                    "frequency": "VeryLow",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan <w>cendre</w> la pâte avant de l'envoyer dans la cave d'affinage."
                        },
                        {
