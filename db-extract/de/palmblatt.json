                "senses": [
                    {
                        "sense_id": "f05c89fa-5e48-3f0c-b0af-05f79e8bbeec",
                        "entry_id": "12504dbc-d293-34e3-aeea-d7734a99a40e",
                        "glosses": [
                            "Blatt eines Palmbaumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1732d9d-1826-4333-8929-13fb93aabe68",
                                "sense_id": "f05c89fa-5e48-3f0c-b0af-05f79e8bbeec",
                                "text": "„Um 2000 vor Christus schnitten Steinzeitmenschen nachweislich mit Flintsteinmessern in die Kopfhaut anderer, aus Afrika ist bekannt, dass man dort nach Geburten die Nabelschnur mit einem scharfen Palmblatt durchtrennte.“"
                            },
                            {
                                "example_id": "253b0593-1935-4cab-b007-8dd0fd0cbd68",
                                "sense_id": "f05c89fa-5e48-3f0c-b0af-05f79e8bbeec",
                                "text": "„Manchmal fächelte er ihr mit dem Palmblatt Luft zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
