                "senses": [
                    {
                        "sense_id": "b51b96aa-8eb3-3167-abec-df859a66cc4b",
                        "entry_id": "3538df5b-46ed-352f-9864-138aa8e559fb",
                        "glosses": [
                            "Handwerker, der Börsen, Brief- und Handtaschen, Akten- und Schreibmappen und dergleichen herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e908bf0-d42a-4521-8692-1f825eaa05c4",
                                "sense_id": "b51b96aa-8eb3-3167-abec-df859a66cc4b",
                                "text": "„Kaum weniger bunt ist der Bereich Bekleidung mit insgesamt 839 Handwerksbetrieben, darunter Seiler, Segelmacher, Hut- und Mützenmacher, Feintäschner, Gerber, Sattler, Sticker und Stricker.“"
                            },
                            {
                                "example_id": "4ec7e636-50b9-4722-b286-edb9f9925dd8",
                                "sense_id": "b51b96aa-8eb3-3167-abec-df859a66cc4b",
                                "text": "„In sechs Bereichen liegt der Frauenanteil bei mehr als 50 Prozent: Bei den Damenschneidern, Friseuren, Feintäschnern, Augenoptikern, Buchbindern und im Graveur-Handwerk.“"
                            },
                            {
                                "example_id": "55571061-b301-400b-adb0-79a39e24f599",
                                "sense_id": "b51b96aa-8eb3-3167-abec-df859a66cc4b",
                                "text": "„Zur Blütezeit in den 50er Jahren erlernten 90 Prozent aller Schulabgänger den Beruf des Feintäschners.“"
                            },
                            {
                                "example_id": "e01b0f62-4a04-46c0-9116-71480bf330a6",
                                "sense_id": "b51b96aa-8eb3-3167-abec-df859a66cc4b",
                                "text": "„Der französische Feintäschner Louis Vuitton registrierte im ersten Quartal gar asienweit 40 Prozent mehr Umsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
