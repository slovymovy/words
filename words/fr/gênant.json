                            },
                            {
                                "target_lang_word": "unangenehm",
                                "target_lang_sense_clarification": "Verhalten, das andere irritiert"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "embarazoso",
                                "target_lang_sense_clarification": "situaciones sociales, silencios"
                            },
                            {
                                "target_lang_word": "incómodo",
                                "target_lang_sense_clarification": "preguntas, miradas, situaciones tensas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尴尬",
                                "target_lang_sense_clarification": "社交场合的沉默或窘境"
                            },
                            {
                                "target_lang_word": "难堪",
                                "target_lang_sense_clarification": "被人看穿或羞辱时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7112d4c-2c71-3430-83ba-4cc943b90133",
                    "sense_definition": "Qui incommode, importune ou fait obstacle dans une situation donnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "incommode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce meuble est trop grand pour le couloir et devient vraiment <w>gênant</w> pour circuler.",
                            "target_lang_translations": {
                                "en": "This piece of furniture is too big for the hallway and it's really <w>cumbersome</w> to get around.",
                                "ru": "Эта мебель слишком громоздка для коридора и по-настоящему <w>мешает</w> проходить.",
                                "de": "Dieses Möbelstück ist für den Flur zu groß und wird beim Durchgehen wirklich <w>hinderlich</w>.",
                                "es": "Este mueble es demasiado grande para el pasillo y resulta realmente <w>engorroso</w> pasar por allí.",
                                "zh": "这件家具对走廊来说太大了，通行时真的很<w>碍事</w>。"
                            }
                        },
                        {
                            "text": "L'accusé a tout fait pour écarter ce témoin <w>gênant</w> avant le début du procès.",
                            "target_lang_translations": {
                                "en": "The accused did everything to get rid of this <w>inconvenient</w> witness before the trial began.",
                                "ru": "Обвиняемый сделал всё, чтобы устранить этого <w>нежелательного</w> свидетеля до начала судебного процесса.",
                                "de": "Der Angeklagte hat alles darangesetzt, diesen <w>lästigen</w> Zeugen vor Prozessbeginn loszuwerden.",
                                "es": "El acusado hizo todo lo posible por deshacerse de este testigo <w>inconveniente</w> antes del inicio del juicio.",
                                "zh": "被告在开庭前想尽一切办法，要把这名<w>碍事</w>的证人排除在外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encombrant",
                        "incommode",
                        "fâcheux"
                    ],
                    "antonyms": [
                        "commode",
                        "pratique",
                        "utile"
                    ],
                    "common_phrases": [
                        "témoin gênant",
                        "obstacle gênant",
                        "présence gênante"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing inconvenience or getting in the way in a particular situation.",
                        "ru": "Создающий неудобства, мешающий или затрудняющий что-либо в конкретной ситуации.",
                        "de": "Lästig oder hinderlich, sodass es in einer bestimmten Situation stört oder behindert.",
                        "es": "Que molesta, estorba o dificulta algo en una situación concreta.",
                        "zh": "妨碍行动或事情的进行，使人感到不便或麻烦的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inconvenient",
                                "target_lang_sense_clarification": "getting in the way, causing trouble"
                            },
                            {
                                "target_lang_word": "cumbersome",
                                "target_lang_sense_clarification": "bulky, hard to move or handle"
                            },
