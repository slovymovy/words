                {
                    "sense_id": "91139752-5c3e-3062-ad80-6859f00cbcc4",
                    "sense_definition": "An event or behavior seen as characteristic or stereotypical of a specific group or person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cultural_relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The awkward silence was a total Reddit <w>moment</w> for the users involved.",
