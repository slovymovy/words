                                    {
                                        "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                        "entry_id": "b40e042d-af22-3795-a874-e7b8434965ce",
                                        "glosses": [
                                            "op hetzelfde moment, gelijktijdig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cee3869-d131-4f61-9df5-bca3591f8920",
                                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                                "text": "Dan kun je dat tegelijkertijd laten doen."
                                            },
                                            {
                                                "example_id": "0b5aac36-97c4-49a8-ba9f-1c331b65a17a",
                                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                                "text": "Zweden koos aan het begin van de coronacrisis een aanpak die afweek van die in veel andere landen in Europa: scholen, sportscholen, horecazaken en winkels bleven open. Wel moesten Zweden 1,5 meter afstand van elkaar houden op straat. Tegelijkertijd werd erop gerekend dat mensen de nieuwe coronaregels vrijwillig zouden naleven, tot afschuw van buurlanden."
                                            },
                                            {
                                                "example_id": "2f733436-08a1-4c75-be50-b422c7c9bcb7",
                                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                                "text": "Het idee om een lange tijd alleen door te brengen trok mij enorm aan, maar vond ik tegelijkertijd doodeng omdat ik geen ervaring had met langdurig alleen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2b52eb8-5dcb-4870-86f0-10a8cf90303c",
                        "source_entry_id": "6f023264-cf88-3b44-af32-6da6a29e5d98",
                        "source_sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                        "target_lang_word": "gelijktijdig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelijktijdig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                        "entry_id": "bc2964aa-54c8-3224-8a4b-ab9328b3413f",
                                        "glosses": [
                                            "op het zelfde moment plaats hebbende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1b3bef-2a0d-41d1-be34-3e64d145034c",
                                                "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                                "text": "Live Aid was een 16 uur durend internationaal benefietconcert op 13 juli 1985. Er trad een groot aantal vooraanstaande artiesten op. Het gehele evenement omvatte gelijktijdige optredens in de Verenigde Staten (JFK Stadium te Philadelphia), het Verenigd Koninkrijk (Wembley Stadium te Londen) en andere kleinere locaties waaronder Den Haag."
                                            },
                                            {
                                                "example_id": "e0e8dda1-af80-4e07-b4c8-091ea639739d",
                                                "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                                "text": "Er werd vrijwel gelijktijdig nog meer bier op de rustieke houten tafels neergesmakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
