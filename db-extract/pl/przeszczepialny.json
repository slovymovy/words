                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0a9429-cc3f-424c-bd55-9bd01aa7b722",
                                "sense_id": "efccb354-07d4-37c2-875f-6e27f67b5f0f",
                                "text": "Niektórzy sądzą, że idee zachodne nie są bardzo przeszczepialne do świata muzułmańskiego.",
                                "translation": "Někteří se domnívají, že západní myšlenky nejsou příliš naroubovatelné do muslimského světa."
                            }
                        ]
                    },
                    {
                        "sense_id": "71c91bf2-79f0-311c-85f3-5e3541e9d08f",
                        "entry_id": "096a8d36-6155-3082-aa3b-a51659c06956",
                        "glosses": [
                            "transplantovatelný"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c9ccc9-2592-43b7-aa9b-4ec7c2a97229",
                                "sense_id": "71c91bf2-79f0-311c-85f3-5e3541e9d08f",
                                "text": "Istnieje duża różnica w tom, ile przeszczepialne są wątroby u osób młodych i te w podeszłym wieku."
                            }
                        ]
                    }
