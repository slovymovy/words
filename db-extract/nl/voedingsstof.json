                    {
                        "sense_id": "2e3e71b3-5d9c-3388-905f-28f2381ea516",
                        "entry_id": "871cb53c-68a1-347b-b3c5-ccf95a415e8f",
                        "glosses": [
                            "is een natuurlijk bestanddeel dat onontbeerlijk is voor het lichaam van een organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eea53488-ba5d-4c8b-818a-276a8ea7c4d3",
                                "sense_id": "2e3e71b3-5d9c-3388-905f-28f2381ea516",
                                "text": "Soms worden ook water en voedingsvezels als een non-nutriënt beschouwd in plaats van een voedingsstof."
                            },
                            {
                                "example_id": "52cf2e46-5d92-4a8a-a24c-655f86bb4442",
                                "sense_id": "2e3e71b3-5d9c-3388-905f-28f2381ea516",
                                "text": "De mens heeft ongeveer 50 essentiële voedingsstoffen nodig."
                            },
                            {
                                "example_id": "05857b8f-3482-4c7b-b69e-8477f657cd4e",
                                "sense_id": "2e3e71b3-5d9c-3388-905f-28f2381ea516",
                                "text": "Uiteindelijk kunnen ook de botten van een verdronkene verdwijnen. Zogeheten 'bottenwormen' kunnen de voedingsstoffen uit het bot zuigen zodat daar uiteindelijk ook niets meer van overblijft. Dat kan echter nog wel een jaar of 10 duren."
                            }
                        ]
                    }
