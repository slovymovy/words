                "senses": [
                    {
                        "sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                        "entry_id": "ae50d752-9c0d-3bab-bc6d-bfa7b3ead3a2",
                        "glosses": [
                            "een computer die of computerprogramma dat diensten verleent aan andere programma's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff3c795-3542-4828-83dc-49091a39ad0d",
                                "sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                                "text": "Alle servers in het serverpark waren uitgevallen met als gevolg dat vele webpagina's urenlang niet bereikbaar zijn geweest."
                            },
                            {
                                "example_id": "1f5f8e32-f0f7-4796-9c1e-d9e19ca07b88",
                                "sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                                "text": "De UM werd eind 2019 volledig lamgelegd door criminele hackers. Als gevolg van de aanval met de gijzelsoftware konden studenten, onderzoekers en andere medewerkers dagenlang onder meer niet e-mailen, beperkt gebruikmaken van het internet en hadden zij geen toegang tot bestanden op de servers van de universiteit."
                            },
                            {
                                "example_id": "502327b0-91ca-414d-8faf-d104c276a390",
                                "sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                                "text": "In november vorig jaar berekende De Vries dat elke bitcointransactie een tuinzwembad (16.000 liter) aan water kost, nodig om servers te koelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e798d0-398f-4329-92b5-5a44c8662dcd",
                        "source_entry_id": "ae50d752-9c0d-3bab-bc6d-bfa7b3ead3a2",
                        "source_sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                        "source_sense_description": "een computer die of computerprogramma dat diensten verleent aan andere programma's",
                        "target_lang_word": "Server",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Server",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a85d472-4432-3cd3-ad5f-7b32c83baab5",
                                        "entry_id": "7beabe8f-187f-3b02-a9d2-aeba1a8d6e3a",
                                        "glosses": [
                                            "Computer in einem Netzwerk, der für andere Computer Dienste bereitstellt"
                                        ],
                                        "tags": [
                                            "Hardware"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5f679b-9e55-4a85-970b-7d66cfb27ff1",
                                                "sense_id": "0a85d472-4432-3cd3-ad5f-7b32c83baab5",
                                                "text": "Der Server ist schon wieder abgestürzt."
                                            },
                                            {
                                                "example_id": "b8da6e46-83cd-4ea6-a371-4321e0a2ed3d",
                                                "sense_id": "0a85d472-4432-3cd3-ad5f-7b32c83baab5",
                                                "text": "Wenn die Server von Wikimedia nicht funktionieren, wird es unruhig im Chat."
                                            },
                                            {
                                                "example_id": "bdd0e46b-8d59-4c79-afbb-ac170879146c",
                                                "sense_id": "0a85d472-4432-3cd3-ad5f-7b32c83baab5",
                                                "text": "„Nun ist die Sprache der Aweti mit all ihren Besonderheiten in 1512 Dateien abgelegt und auf den - immerhin 250 Terabyte fassenden - Servern im Max-Planck-Institut für Psycholinguistik in Nijmegen konserviert.“"
                                            },
                                            {
                                                "example_id": "bd05f0d2-175e-4b07-841c-66e13b9b9e55",
                                                "sense_id": "0a85d472-4432-3cd3-ad5f-7b32c83baab5",
                                                "text": "„Er baute Server bei Firmen auf und implementierte neue Software in die bestehenden Server auch großer Firmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ff58f58-bc92-3b4b-9242-75665035a95f",
                                        "entry_id": "7beabe8f-187f-3b02-a9d2-aeba1a8d6e3a",
                                        "glosses": [
                                            "Computerprogramm, das Dienste bereitstellt"
                                        ],
                                        "tags": [
                                            "Software"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e2b75f-e0d6-485c-ae3e-f5ceb0841500",
                                                "sense_id": "0ff58f58-bc92-3b4b-9242-75665035a95f",
                                                "text": "Der Server lastet die Hardware voll aus."
                                            },
                                            {
                                                "example_id": "b3f35ad8-57d2-4d39-b4c3-082606946366",
                                                "sense_id": "0ff58f58-bc92-3b4b-9242-75665035a95f",
                                                "text": "Bei uns laufen alle Server auf dem gleichen Computer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd9a0ab-5eca-480f-80d0-84968e4ae5b0",
                        "source_entry_id": "ae50d752-9c0d-3bab-bc6d-bfa7b3ead3a2",
                        "source_sense_id": "a66a1f74-8a28-351b-bb04-7c4e5de9aa9e",
                        "source_sense_description": "een computer die of computerprogramma dat diensten verleent aan andere programma's",
                        "target_lang_word": "server",
