                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26daefde-1e17-30f9-bdba-74500dd8964d",
                                        "entry_id": "88e50d7c-05b0-3aab-b64c-655061b0699a",
                                        "glosses": [
                                            "A place where foreign currency can be exchanged."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e96ecb-d4e6-43a6-a8dd-3b72b2b1b306",
                                                "sense_id": "26daefde-1e17-30f9-bdba-74500dd8964d",
                                                "text": "A bureau de change, as has been seen, is certainly an institution or person subject to the Directive and it arguably enters into business relations with its customers."
                                            },
                                            {
                                                "example_id": "2224f30d-0e84-4cdb-bd83-4c60e0b0288c",
                                                "sense_id": "26daefde-1e17-30f9-bdba-74500dd8964d",
                                                "text": "Good private bureaux de change include the Shangani Bureau de Change (at the northern end of Kenyatta Road, near the Tembo Hotel), and the Malindi Bureau de Change (next to the ZanAir office, east of the port gates)."
                                            },
                                            {
                                                "example_id": "2d65eded-0306-45d2-a978-db14498a6977",
                                                "sense_id": "26daefde-1e17-30f9-bdba-74500dd8964d",
                                                "text": "The network comprises Masterlink, a bureau de change, and a United Kingdom bank, along with a partnering MTO and a bank in Uganda."
                                            }
                                        ]
