                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e41a1ea-5bda-3ec8-9ca6-1cbc3135834f",
                        "entry_id": "3992234d-7a83-38de-9bfa-2f045f8cc71c",
                        "glosses": [
                            "koosnaam voor partner, lief kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef81fa6d-fec9-4290-8284-b5e80d5cfdc2",
                                "sense_id": "0e41a1ea-5bda-3ec8-9ca6-1cbc3135834f",
                                "text": "Mijn schattebout bracht me ontbijt op bed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09efa475-3f4b-4895-98b0-d40bed98b648",
                        "source_entry_id": "3992234d-7a83-38de-9bfa-2f045f8cc71c",
                        "source_sense_id": "0e41a1ea-5bda-3ec8-9ca6-1cbc3135834f",
                        "target_lang_word": "darling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "Often used as an affectionate term of address: a person who is very dear to one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1580257b-92b8-4288-b1b7-34a8c2fabb79",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Pass the wine, would you, darling?"
                                            },
                                            {
                                                "example_id": "6c2ab90f-cb90-4904-857b-270feac233d3",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "[I]t is better to be / An old mans derling than a yong mans werling."
                                            },
                                            {
                                                "example_id": "cea14c3a-ef4e-4ef3-84b9-8ef89a68d23b",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Feare ye not (ô darling) on thy ſide deſtinie runneth."
                                            },
                                            {
                                                "example_id": "89ff7397-f9f5-4956-bf12-06b182814cff",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "How ſhall I, void of tears, her death relate, / VVhile on her darling’s bed her mother ſate!"
                                            },
                                            {
                                                "example_id": "9bf8890d-ff56-4053-9721-e2bf681aa449",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Sleep, sweet babe! my cares beguiling: / Mother sits beside thee smiling: / Sleep, my darling, tenderly!"
                                            },
                                            {
                                                "example_id": "40691ab2-6279-46c3-8367-86daa2aec595",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "My first, last love; the idol of my youth, / The darling of my manhood, and, alas! / Now the most blessed memory of mine age."
                                            },
                                            {
                                                "example_id": "2d8384dd-eba7-4013-82a2-0ebb1eeab2c3",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "It is not worth the keeping: let it go: / But shall it? answer, darling, answer, no. / And trust me not at all or all in all."
                                            },
                                            {
                                                "example_id": "d0a43e4b-311c-4d64-8eb9-1fbc10fbb030",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "'Twas not satiety bade me leave the dearling of my soul, ⁕ But that she sinned a mortal sin which clipt me in its clip: […]"
                                            },
                                            {
                                                "example_id": "d375019e-fb3a-4df3-b73d-562341ff20c3",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Oh! Darling, please believe me / I'll never do you no harm"
                                            },
                                            {
                                                "example_id": "2551f7ed-7395-42a0-93ba-90bd1c70d8f8",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Oh, I could drink a case of you, darling / Still I'd be on my feet"
                                            },
                                            {
                                                "example_id": "e1d4d5c0-4002-4f3a-a96d-3479e8369e44",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "\"Whate'er you say, dearling.\" Despite her insults, Geirolf could see the love glowing in her face and he was encouraged."
                                            },
                                            {
                                                "example_id": "1b2dd98a-1451-4c08-b3d9-d83975b61b40",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "\"I dinna ken, dearling,\" he said huskily. \"I wish … och, how I wish … I canna bear to think o' ye locked up in here.\""
                                            },
                                            {
                                                "example_id": "18434a42-3d59-4a30-9325-2422e387ec0c",
                                                "sense_id": "ac143cea-5318-3fe7-8e2b-7fde70b46dc3",
                                                "text": "Yeah, intelligent input darling / Why don't you just have another beer then?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "A person who is kind, sweet, etc., and thus lovable; a pet, a sweetheart; also, an animal or thing which is cute and lovable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a847c273-1aee-4b92-a888-695112124646",
                                                "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                                                "text": "The girl next door picks up all my shopping for me. She is such a darling."
                                            },
                                            {
                                                "example_id": "f854b5ca-259e-4a7a-a569-83ebbbab4483",
                                                "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                                                "text": "When the Crocodile Queen came home, she found / That her eggs were broken and scattered around, / And that six young Princes, darlings all, / Were missing, for none of them answer'd her call."
                                            },
                                            {
                                                "example_id": "31ef7ecb-a873-47f2-9114-35a89255b8d2",
                                                "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                                                "text": "What did they want, then, or in what manner did he fail in his duty towards those innocent darlings [his children]?"
                                            },
                                            {
                                                "example_id": "da543975-7f52-45f3-9d02-a4c841c4c0b8",
                                                "sense_id": "62919b17-87a2-30d5-ad15-7c37db6e979c",
                                                "text": "With every flock of sheep and girls are one or two enormous mastiffs, which could eat one, and do bark nastily. But when the children call them and introduce them to you formally, they stand to be patted, and eat out of your hand; they are great darlings, and necessary against bear and wolf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef476fb-e629-381c-8562-bf7e3c19ebe1",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "A favourite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0919abb5-aca0-4b66-9a16-910ff531c6ed",
                                                "sense_id": "fef476fb-e629-381c-8562-bf7e3c19ebe1",
                                                "text": "And in ſo muche the more peril and haſard of the ſaid diſeaſes [“ambicion, auarice, riottous exceſſe, hatred, enuye, and ſuche others”] do the princes ſtand, as they are more then others made wantons ⁊ derelynges of fortune, and haue lybertie withoute checke or controllemente to fulfyll their owne ſenſuall luſtes and appetites."
                                            },
                                            {
                                                "example_id": "49d92e29-a92c-4a58-8f11-ac22a8fc95ed",
                                                "sense_id": "fef476fb-e629-381c-8562-bf7e3c19ebe1",
                                                "text": "[T]hat handkercher / Did an Egyptian to my mother giue, / […] ſhe told her vvhile ſhe kept it, / Tvvould make her amiable, and ſubdue my father / Intirely to her loue: […] [T]ake heed on't, / Make it [the handkerchief] a darling, like your pretious eye, / To looſe, or giue avvay, vvere ſuch perdition, / As nothing elſe could match."
                                            },
                                            {
                                                "example_id": "ef3e9769-d11b-4329-bca3-7b7574927bbc",
                                                "sense_id": "fef476fb-e629-381c-8562-bf7e3c19ebe1",
                                                "text": "Politics were never more corrupt and brutal; and Trade, that pride and darling of our ocean, that educator of nations, that benefactor in spite of itself, ends in shameful defaulting, bubble, and bankruptcy, all over the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "A favourite.",
                                            "The favourite child in a family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44cfd5e-66e2-4efa-8c05-87f449160606",
                                                "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                                "text": "Mary, the youngest daughter, was always her mother’s darling."
                                            },
                                            {
                                                "example_id": "7dfe2145-ad79-4f74-b493-b77ba2c9af5b",
                                                "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                                "text": "And tis a common obſervation in Familites, that the moſt diſcountenanc'd child oft makes better proof, then the dearling."
                                            },
                                            {
                                                "example_id": "c857a50e-847a-48f2-a93e-2a561b7a3596",
                                                "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                                "text": "[…] John vvas the Darling, he had all the good Bits, vvas cramm'd vvith good Pullet, Chicken, Pig, Gooſe and Capon, vvhile Miſs had only a little Oatmeal and VVater, or a dry Cruſt vvithout Butter."
                                            },
                                            {
                                                "example_id": "4d1ec03e-4576-45c3-b48a-7c8a6e71fede",
                                                "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                                "text": "Exhausted fathers thinned the blood, / You curse the legacy of pain; / Darling of an infected brood, / You feel disaster climb the vein."
                                            },
                                            {
                                                "example_id": "6f5753e8-2a80-4846-b054-295b145ed3c4",
                                                "sense_id": "11e549f2-648c-3685-b566-989f994ed16b",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance, appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "A favourite.",
                                            "A person (often a woman) or thing that is very popular with a certain group of people."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cebce87a-2e5b-405c-aa2a-c0981df5c6f1",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "a media darling"
                                            },
                                            {
                                                "example_id": "76b37fdc-98cd-4b5b-b2f7-9248dcd22d07",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "a darling of the theatre"
                                            },
                                            {
                                                "example_id": "a929b673-bdf5-41d1-877b-a41cafa47e1c",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "[…] Auguſtius Cæſar in his very entrance into affaires, vvhen he vvas a dearling of the Senate, yet in his haranges to the people, vvould ſvveare Ita parentis honores conſequi liceat, (vvhich vvas no leſſe then the Tyranny,) […]"
                                            },
                                            {
                                                "example_id": "85235f83-0176-4a9c-a821-b4b765df2620",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "The Generall of the Romanes in this action vvas Titus, ſonne to Veſpaſian the Emperour. A prince ſo good, that he vvas ſtyled the Darling of mankind for his ſvveet and loving nature; […]"
                                            },
                                            {
                                                "example_id": "53a79767-accd-4597-b104-bf77941767c0",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "Then the great knight, the darling of the court, / Loved of the loveliest, into that rude hall / Stept with all grace, […]"
                                            },
                                            {
                                                "example_id": "cd840b8f-4a0a-4a6f-bcbb-bdf75f215ea2",
                                                "sense_id": "5d192600-733e-37f3-b607-7f83a081202b",
                                                "text": "One of the darlings of the early vegetarian movement (particularly in its even sadder form, the cutlet), it was on the menu at John Harvey Kellogg's Battle Creek Sanitarium^([sic]), and has since become the default Sunday option for vegetarians – and a default source of derision for everyone else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ce9490-d756-3542-98c1-ce35b2e0b6f8",
                                        "entry_id": "083ed249-3818-352b-b292-4fa3dfe1a26c",
                                        "glosses": [
                                            "A favourite.",
                                            "A royal favourite, the intimate companion of a monarch or other royal personage, often delegated significant political power."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5a03ac-a2ae-48ed-8d5b-48ba43e67526",
                                                "sense_id": "78ce9490-d756-3542-98c1-ce35b2e0b6f8",
                                                "text": "When kyng Henry perceiued, that the cõmons [commons] wer thus ſtomacked and bent, againſt the Quenes [Margaret of Anjou's] dearlynge William [de la Pole,] Duke of Suffolke, he plainly ſawe, that neither gloſyng woulde ſette, nor diſſimulacion coulde appeace, the continuall clamor of the importunate cõmons: Wherefore to begyn a ſhorte pacificacion in to long a broyle."
                                            },
                                            {
                                                "example_id": "e5ac7714-067b-4bdb-bf0d-f6eead901002",
                                                "sense_id": "78ce9490-d756-3542-98c1-ce35b2e0b6f8",
                                                "text": "She [Caroline of Ansbach] immediately became the darling of the Princeſs Sophia [Charlotte of Hanover], vvho vvas acknovvledged in all the Courts of Europe the moſt accompliſhed vvoman of the age in vvhich ſhe lived, and vvho vvas not a little pleaſed vvith the converſation of one in vvhom ſhe ſavv ſo lively an image of her ovvn youth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "darling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                        "entry_id": "1a3c1155-707c-3b9c-a009-d1ff190c6b0a",
                                        "glosses": [
                                            "Very dear; beloved, cherished, favourite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366c0bbe-526e-4c28-94b0-75285a7c9990",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "She is my darling wife of twenty-two years."
                                            },
                                            {
                                                "example_id": "4dc02133-149d-4bb1-8b47-a017f03f8972",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "Do thou dred infant, Venus dearling doue, / From her high ſpirit chaſe imperious feare, / And vſe of avvfull Maieſtie remoue: […]"
                                            },
                                            {
                                                "example_id": "2e5885ed-f403-4dd4-8421-82f83cd631c4",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "Rough vvindes do ſhake the darling buds of Maie, / And Sommers leaſe hath all too ſhort a date: […]"
                                            },
                                            {
                                                "example_id": "3517e73b-c62d-439f-a027-7459e599cf53",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "VVherefore, for the future, I am reſolved, to Acknovvledge my darling faults, though alone, yet aloud; […]"
                                            },
                                            {
                                                "example_id": "8e6066ad-4d7c-40d5-b443-2d8842e641d6",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "[H]is darling Sons / Hurl'd headlong to partake vvith us, ſhall curſe / Their frail Originals, and faded bliſs, / Faded ſo ſoon."
                                            },
                                            {
                                                "example_id": "9f83801a-899d-47ff-93de-e68cb852aaa9",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "Now Ellen was a darling love / In all his joys and cares: / And Ellen's name and Mary's name / Fast-link'd they both together came, / Whene'er he said his prayers."
                                            },
                                            {
                                                "example_id": "c1d900ca-9d4a-416c-94b4-631115d974b4",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "He saw a cottage with a double coach-house, / A cottage of gentility; / And the Devil did grin, for his darling sin / Is pride that apes humility."
                                            },
                                            {
                                                "example_id": "a481e680-790f-4ebb-bf68-bc668c25f298",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "Mr. Bingley and Jane remained at Netherfield only a twelvemonth. So near a vicinity to her mother and Meryton relations was not desirable even to his easy temper, or her affectionate heart. The darling wish of his sisters was then gratified; he bought an estate in a neighbouring county to Derbyshire, and Jane and Elizabeth, in addition to every other source of happiness, were within thirty miles of each other."
                                            },
                                            {
                                                "example_id": "56a52d1e-947b-4341-ba73-fdc9d49341c4",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "[M]y dear sweet master, / My darling little Cyclops [Polyphemus], […]"
                                            },
                                            {
                                                "example_id": "c3b5dae5-80e4-4790-a0f3-16540bfbb111",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "A few enthusiasts on the other side were bent on pursuing, through endless civil troubles, their darling phantom of a republic."
                                            },
                                            {
                                                "example_id": "d747231c-c545-41d6-b6b4-902e0cbda59b",
                                                "sense_id": "46c5b39b-7fa4-3b86-b7d0-d0d6c9c43be8",
                                                "text": "My unchanged love is with my darling child, and I forgive her!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a111209b-50d3-3e9d-9532-829d578c705b",
                                        "entry_id": "1a3c1155-707c-3b9c-a009-d1ff190c6b0a",
                                        "glosses": [
                                            "Very cute or lovable; adorable, charming, sweet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f786ddbc-3b79-4995-8ded-dc42e2029750",
                                                "sense_id": "a111209b-50d3-3e9d-9532-829d578c705b",
                                                "text": "Well, isn’t that a darling little outfit she has on?"
                                            },
                                            {
                                                "example_id": "4a5476c6-2f01-4cbe-828b-7f8f512a79ca",
                                                "sense_id": "a111209b-50d3-3e9d-9532-829d578c705b",
                                                "text": "Isn't it the darlingest, sweetest, prettiest, little dear darling darling! Oh! did you ever!!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "darling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                        "entry_id": "c354b88b-ee0c-3ce2-9b41-7f575090647a",
                                        "glosses": [
                                            "To call (someone) \\\"darling\\\" (noun sense 1)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef4f2fa9-75c5-4b84-83d5-9777d0bf2e46",
                                                "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                                "text": "He was darlinging his wife at every opportunity. They were going to have a silver wedding party. And, according to Geraldine, this was meant to be a dead marriage."
                                            },
                                            {
                                                "example_id": "a43b680f-4500-4b4e-b82d-69d439e3b842",
                                                "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                                "text": "The frisky female, we have noticed, has one most unpleasant trick; it is that of darlinging and duckeying and otherwise spooneying her husband … in public. He is invariably, invariably set down as an ass, without its being in the least his fault."
                                            },
                                            {
                                                "example_id": "d9992405-cbe1-4716-bb9d-430117f09b95",
                                                "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                                "text": "Hullo! oh! Maud, darling, I wanted to know— / Great snakes, it's not she!—I want Miss Maud DeVaux.— / I think that I \"darlinged\" the old man that time. / If I did, I'll sell cheap,—this lot marked down,—one dime."
                                            },
                                            {
                                                "example_id": "b030d011-4f94-4e04-8f27-332ddfe0f49f",
                                                "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                                "text": "Wonderful the way you stage people darling each other. To hear you sometimes, you'd think you were passionately in love."
                                            },
                                            {
                                                "example_id": "7cf0b78d-9c4f-450a-8a9a-76b9eceeb195",
                                                "sense_id": "8376b9b4-3240-344f-ab14-fb8ef66e0d27",
                                                "text": "All the Marys, Janes, Francoises and Mikis darlinged and honeyed me for a day or two then vanished for ever. After a few weeks I could not recall their names or faces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4b05527-ab1c-41e2-b38b-1cfc62bfa4c7",
                        "source_entry_id": "3992234d-7a83-38de-9bfa-2f045f8cc71c",
                        "source_sense_id": "0e41a1ea-5bda-3ec8-9ca6-1cbc3135834f",
                        "target_lang_word": "sweetheart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetheart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d71591ab-e935-323f-af03-32304954b9ce",
                                        "entry_id": "edc71140-b2c4-3d90-8989-f6a10d1bc34d",
                                        "glosses": [
                                            "A person who is always very kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f10ee5-06d8-4b32-b22b-0e85b0fb618d",
                                                "sense_id": "d71591ab-e935-323f-af03-32304954b9ce",
                                                "text": "She is such a sweetheart: she never complains about me being late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ec9dc91-5604-3dcf-b451-3055333cedb8",
                                        "entry_id": "edc71140-b2c4-3d90-8989-f6a10d1bc34d",
                                        "glosses": [
                                            "A person very much liked or loved by someone, especially when both partners are young."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10812119-c466-49fc-9572-6391c705180d",
                                                "sense_id": "0ec9dc91-5604-3dcf-b451-3055333cedb8",
                                                "text": "John married his high-school sweetheart in 1981."
                                            },
                                            {
                                                "example_id": "45388131-d5a5-4982-ada8-e3219f1d48a5",
                                                "sense_id": "0ec9dc91-5604-3dcf-b451-3055333cedb8",
                                                "text": "Why Lambe, why Lady, fie you ſluggabed, / Why Loue I ſay, Madam, ſweeteheart, why Bride: / What not a word, you take your penniworths now, / Sleepe for a weeke, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d69f4989-3125-3864-b2d8-8edfe8bec1a7",
                                        "entry_id": "edc71140-b2c4-3d90-8989-f6a10d1bc34d",
                                        "glosses": [
                                            "A term of endearment, especially for a lover or child."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51928d23-350c-3804-840f-3ddd8a56cb93",
                                        "entry_id": "edc71140-b2c4-3d90-8989-f6a10d1bc34d",
                                        "glosses": [
                                            "A female member of a college or university fraternity."
                                        ],
