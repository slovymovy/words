                        "glosses": [
                            "Fédération française de rugby."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "834fc1bf-e384-4209-9527-ab9e0d38a8dc",
                                "sense_id": "02488c05-1413-326e-b4ce-78a9862d9571",
                                "text": "Condamné, mardi, à deux ans de prison avec sursis, notamment pour corruption, le président de la Fédération française de rugby (FFR), Bernard Laporte, se retrouve isolé."
                            },
                            {
                                "example_id": "10c2798b-5eee-4cc7-b723-e9361ec212f3",
                                "sense_id": "02488c05-1413-326e-b4ce-78a9862d9571",
                                "text": "Une cyberattaque au ransomware du groupe de pirates Play a touché la Fédération française de rugby (FFR), dans la nuit de mercredi à jeudi."
                            },
                            {
                                "example_id": "e5e50848-95d5-48dd-86fc-76bc2f030f23",
                                "sense_id": "02488c05-1413-326e-b4ce-78a9862d9571",
                                "text": "Il laisse l’avocat Foucauld Prache, qui s’occupe d’un recours administratif contre la Fédération française (FFR) et la Ligue (LNR) parler pour lui : « Quand on voit que Fabien Galthié fait une blague sur la sortie de Paul Boudehent contre la Namibie, on se dit que les mentalités n’évoluent pas. Le seul impératif pour une entraîneur, c’est d’avoir des joueurs remobilisables le plus vite possible. »"
                            }
                        ]
                    }
