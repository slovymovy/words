                        "entry_id": "6c0dc6e2-dbba-399a-bd7c-ce2179e00cab",
                        "glosses": [
                            "Excessively dainty or fastidious."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8246ced4-3e9d-406f-afd9-7945a7aa625b",
                                "sense_id": "d1b67f5e-f964-33bb-a8b0-d27c5467e5a2",
                                "text": "Have a great regard for the cleanliness of your hands, but do not be finikin about it."
                            },
                            {
                                "example_id": "c9ab3896-99ea-4b0b-9edb-e60dc2199068",
                                "sense_id": "d1b67f5e-f964-33bb-a8b0-d27c5467e5a2",
                                "text": "The bearded creatures are quite as eager for praise, quite as finikin over their toilettes, quite as proud of their personal advantages, quite as conscious of their powers of fascination, as any coquette in the world."
                            },
                            {
                                "example_id": "1da118c3-d72b-4a72-8fdc-89ab9739ec1b",
                                "sense_id": "d1b67f5e-f964-33bb-a8b0-d27c5467e5a2",
                                "text": "Artifice and imitation reveal the finikin or uncertain soul as surely as deliberate bareness reveals a conscious austerity."
                            }
                        ]
                    }
                ],
