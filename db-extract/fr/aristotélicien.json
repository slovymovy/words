                        "entry_id": "0ae1b716-4d93-3bf7-b254-154e40f1c01b",
                        "glosses": [
                            "Partisan de la doctrine d’Aristote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932eb57b-89b9-4f3b-9080-707fb76326f8",
                                "sense_id": "46fbc931-a59f-354d-979e-6b9de30a78df",
                                "text": "Les aristotéliciens."
                            },
                            {
                                "example_id": "8f00578c-3b92-4fac-8fc6-5de80d3550a7",
                                "sense_id": "46fbc931-a59f-354d-979e-6b9de30a78df",
                                "text": "Enfin, nous savons par les écrits de Siger de Brabant qu’il est un aristotélicien averroïste, c’est-à-dire un aristotélicien rigide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c13a89de-9134-45c6-9e1b-3c29851ab4cf",
                        "source_entry_id": "0ae1b716-4d93-3bf7-b254-154e40f1c01b",
                        "source_sense_id": "46fbc931-a59f-354d-979e-6b9de30a78df",
