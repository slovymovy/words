                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbda6d1b-b463-48e8-818b-76e07fb126a2",
                                                "sense_id": "5ecad923-a8c0-37e7-a2d9-6f97338f971c",
                                                "text": "There was an eruption of joy at the final whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb94563-d9e0-3217-973b-ff06ad14de8f",
                                        "entry_id": "fd9ac3db-f3cd-3e6c-bcdd-4656a141e433",
                                        "glosses": [
                                            "An utterance, especially a sudden one; an ejaculation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e9fd160-0bac-4216-8169-85fbb06e89e2",
                                                "sense_id": "beb94563-d9e0-3217-973b-ff06ad14de8f",
                                                "text": "Ultimately, Greenfield may remind us of no one so much as Boston's own, Sylvia Sidney — \"herself\" in the amusement business! From whom else does one expect so leveling a sequence of eruptions: \"i mean yah gotta win a little money/ i mean we're all whores turning a trick\"?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daba1365-18e6-3968-b76f-48f52a98aedd",
                                        "entry_id": "fd9ac3db-f3cd-3e6c-bcdd-4656a141e433",
                                        "glosses": [
                                            "An infection of the skin resulting in a rash or blemishing."
                                        ],
