                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Klosetts"
                    },
                    {
                        "form_id": "54eafac4-9db2-4cfa-b3cf-b844f3d9037a",
                        "entry_id": "4d81c90f-20b8-328e-ada6-8242f539cae8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Klosette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                        "entry_id": "4d81c90f-20b8-328e-ada6-8242f539cae8",
                        "glosses": [
                            "kleiner Raum, der für die Ausscheidung und Entsorgung menschlicher Fäkalien ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c882001e-1611-4d39-a5ef-f7b6202ae99d",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "Ich muss dringend aufs Klosett."
                            },
                            {
                                "example_id": "566257b4-0e81-483c-8378-4ff4032d3522",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "„Der Chasseur von unserem Hotel ging in Ferien, und wir konnten von unserem Hotel-Restaurant aus umsonst aufs Klosett gehen, denn die Klosettfrau war auch fort.“"
                            },
                            {
                                "example_id": "8619c121-75c1-4f66-947b-704aed1af990",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "„In der Tür zum Klosett steht der junge Mann, dem Stuff vor einer Viertelstunde zutrank.“"
                            },
                            {
                                "example_id": "a158bf05-108b-45ca-b6c1-25fd827cf739",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "„Im Flur strich er sich auf dem Weg zum Klosett über die Bartstoppeln.“"
                            },
                            {
                                "example_id": "fcd28a1d-6940-4459-b64e-d11ab296efe6",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "Im Klosett riecht es nach Lavendel."
                            },
                            {
                                "example_id": "c2913594-294d-45c7-9c7a-484cec5ac8da",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "In unserem Haus war das Klosett ursprünglich im Obergeschoss untergebracht."
                            },
                            {
                                "example_id": "155d9002-3f94-49d6-a418-be6017a3c4bc",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "In modernen Klosetten findet man kaum noch Plumpsklos."
                            },
                            {
                                "example_id": "18323175-7efd-4198-84e0-dcf15dc8a07c",
                                "sense_id": "19c43104-8edb-300e-9e9c-1127ece554ad",
                                "text": "Wir installieren im Klosett ein neues Waschbecken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "256661d6-21b2-37bd-83a6-0bc05983c4f6",
                        "entry_id": "4d81c90f-20b8-328e-ada6-8242f539cae8",
                        "glosses": [
                            "Becken, meist aus Keramik, in welches Kot und Urin ausgeschieden werden, um sodann entsorgt zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae059e9-031c-4434-bf55-c7ec97e533e0",
                                "sense_id": "256661d6-21b2-37bd-83a6-0bc05983c4f6",
                                "text": "Wir benutzen zum Putzen des Klosetts stets Essigreiniger."
                            },
                            {
                                "example_id": "0e35067a-10d3-48ea-ac3e-295a385665d7",
                                "sense_id": "256661d6-21b2-37bd-83a6-0bc05983c4f6",
                                "text": "Da das alte nicht mehr ansehnlich war, kaufte Herr Meier im Baumarkt ein neues Klosett."
                            },
                            {
                                "example_id": "e08135eb-7b90-45fb-8f67-8f5dd0b960ff",
                                "sense_id": "256661d6-21b2-37bd-83a6-0bc05983c4f6",
                                "text": "Da ist ein Sprung im Klosett."
                            },
                            {
                                "example_id": "8708db33-7551-44f4-bde2-14d1d827aa80",
                                "sense_id": "256661d6-21b2-37bd-83a6-0bc05983c4f6",
                                "text": "Die Klobürste neben dem Klosett ist nicht nur zum Angucken da."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
