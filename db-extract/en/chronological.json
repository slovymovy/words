                                "target_senses": [
                                    {
                                        "sense_id": "19629bc5-ab70-3222-855a-f41725eb3072",
                                        "entry_id": "0209c577-5ddb-3dae-9206-f26a543a2c59",
                                        "glosses": [
                                            "auf die Zeit oder einen Zeitpunkt bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2dc1362-25c4-4f4e-b378-41722e8ce128",
                                                "sense_id": "19629bc5-ab70-3222-855a-f41725eb3072",
                                                "text": "Zeitliche Differenzen ergeben sich bei jeder Messung."
                                            },
                                            {
                                                "example_id": "bdadafd2-c9ee-4d3d-b0ad-862ca529a160",
                                                "sense_id": "19629bc5-ab70-3222-855a-f41725eb3072",
                                                "text": "„Wenn die Entfernung zur Immobilie gering ist, minimieren sie auch so ihren zeitlichen Aufwand bei einem Mieterwechsel und können im Bedarfsfall Probleme persönlich klären.“"
                                            },
                                            {
                                                "example_id": "c46d8493-679b-4e57-b3dc-2f6b27382a1a",
                                                "sense_id": "19629bc5-ab70-3222-855a-f41725eb3072",
                                                "text": "Der Senat konnte sich in der Nacht zum Montag nicht auf eine Verlängerung der zeitlich befristeten Spähprogramme zur Terrorismusbekämpfung einigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
