                    {
                        "translation_id": "fe326c72-f5aa-4e1f-999e-b430e265d27d",
                        "source_entry_id": "0bfbc690-8fd5-390d-a3e7-129079363578",
                        "source_sense_id": "a56aac3e-afe8-3060-91c7-216c58a512d1",
