                        "entry_id": "cf9b70f6-d8e1-3279-9316-606e81b69c23",
                        "glosses": [
                            "Ustensile servant à ouvrir une boîte de conserve métalliques lorsqu'elle est dépourvue de système d’ouverture simplifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cb858d-1a9e-4239-99a8-83914933792b",
                                "sense_id": "26349c98-2190-3323-90dc-f3e9ba8c30b3",
                                "text": "Il prit son ouvre-boîte pour ouvrir une boîte de cassoulet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35dbf002-5692-4010-9f38-b59a5883a8c1",
