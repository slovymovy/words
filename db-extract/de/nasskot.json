                ],
                "senses": [
                    {
                        "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                        "entry_id": "f3edf593-cb25-3007-9b76-f93dfb9512a5",
                        "glosses": [
                            "frischer, noch nicht getrockneter Kot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80932882-d8ea-43b7-8b1d-4d92db2a81a9",
                                "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                                "text": "„Schätzungsweise 20 000 bis 30 000 Stadttauben leben in Stuttgart, von denen jede jährlich etwa zwölf Kilogramm Nasskot produziert.“"
                            },
                            {
                                "example_id": "64412a6a-eafc-4c04-90c3-d9eaaf1c3839",
                                "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                                "text": "„Jede Taube produziert allein 10 - 12 kg Nasskot jährlich.“"
                            },
                            {
                                "example_id": "6e918c29-3caf-4403-8f64-bd4a891ecb40",
                                "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                                "text": "„Tauben verunreinigen nicht nur Fassaden und Gehwege, sie führen auch durch ihren ätzenden Nasskot — immerhin ca. 10 bis 12 kg pro Taube und Jahr — zu dauerhaften Gebäudeschäden.“"
                            },
                            {
                                "example_id": "1571926b-a1f0-4b4a-b4a5-4c41f9658b51",
                                "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                                "text": "„Die Anlage arbeitet vollautomatisch und kann pro Stunde ca. 250 kg Nasskot (mit ca. 75% Feuchtigkeit) zu Trockenkot mit 10 — 13% Feuchtigkeit produzieren.“"
                            },
                            {
                                "example_id": "cf8bd766-07e0-4923-bc1e-56011cf40854",
                                "sense_id": "b39ca5c3-1032-3050-8665-934fbad0d07b",
                                "text": "„Nun hinterlässt ein Durchschnittshund 182 Kilo Nasskot im Jahr, ganz zu schweigen von dem was die vielen Kühe und Schweine hinterlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
