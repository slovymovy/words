                        "glosses": [
                            "Stadion, in dem die Olympischen Spiele ausgetragen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64864344-a6df-4651-8c30-d5154752d3b4",
                                "sense_id": "0aa00a1d-c55f-3c5a-a4db-08a1aad186b6",
                                "text": "Die Olympischen Sommerspiele 1972 fanden im Olympiastadion in München statt."
                            },
                            {
                                "example_id": "2318712b-26e7-48b9-8866-421094d447be",
                                "sense_id": "0aa00a1d-c55f-3c5a-a4db-08a1aad186b6",
                                "text": "„Unsere Gegend in Neuwestend, in der Nähe des Reichssportfeldes, dem heutigen Olympiastadion, war zwar auch an einigen Straßen getroffen worden, aber das, was ich jetzt auf der Fahrt ins Zentrum sah, war ohnegleichen.“"
                            }
                        ],
