                "senses": [
                    {
                        "sense_id": "8082ff63-0574-3dc3-b165-8de25eccb77c",
                        "entry_id": "83f421f0-1ab8-36d2-bdbe-823584d5401e",
                        "glosses": [
                            "eine Aussage über den Charakter einer Person; zum Beispiel, aber nicht nur, durch eine behördliche Bescheinigung über bisher registrierte Vorstrafen dieser Person, das Führungszeugnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe88f397-f0c4-4fdd-bd3a-16d0cfad8f40",
                                "sense_id": "8082ff63-0574-3dc3-b165-8de25eccb77c",
                                "text": "Leumundszeugnisse können von Sympathie oder Antipathie ihres Verfassers gefärbt sein."
                            },
                            {
                                "example_id": "93855cfa-ad74-45dc-adc2-2f8cc855c7d1",
                                "sense_id": "8082ff63-0574-3dc3-b165-8de25eccb77c",
                                "text": "Der Pastor stellte ihm nur zu gerne ein Leumundszeugnis aus."
                            },
                            {
                                "example_id": "c0387f5f-05ef-4ccc-b3a1-f38ba444057d",
                                "sense_id": "8082ff63-0574-3dc3-b165-8de25eccb77c",
                                "text": "Verwundert, ohne amtliches Leumundszeugnis vorgelassen zu werden, erreichte sie endlich das Vorzimmer des Mannes, der, nach einhelliger Meinung aller bisher Befragten, Auskunft über Lieutenant Martinez und die SEALs geben konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
