                "senses": [
                    {
                        "sense_id": "b7a76974-08ee-36e4-9ebd-f6331fdaf14b",
                        "entry_id": "c170272f-8942-3099-a085-dfd4fae2cf4e",
                        "glosses": [
                            "Hörer oder Leser (meist in der Fachsprache der Linguistik für Empfänger einer Nachricht verwendet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9243344b-842f-497f-bd31-6c40206d497b",
                                "sense_id": "b7a76974-08ee-36e4-9ebd-f6331fdaf14b",
                                "text": "Rezipient ist, wer eine sprachliche Botschaft, Nachricht aufnimmt."
                            },
                            {
                                "example_id": "b9053a10-22d2-46e4-86b7-3ad97df6733d",
                                "sense_id": "b7a76974-08ee-36e4-9ebd-f6331fdaf14b",
                                "text": "„Ist der Tabubruch als Strategie hier noch spürbar, stellt sich die Frage, wie viele Rezipienten dies langfristig noch als solchen zu verstehen vermögen.“"
                            },
                            {
                                "example_id": "0d0b3d84-5b70-4fc7-bc18-d7ec3bcf2d00",
                                "sense_id": "b7a76974-08ee-36e4-9ebd-f6331fdaf14b",
                                "text": "Der Begriff Rezipient wird in Kommunikationsmodellen verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72d81030-de1d-32a9-88f2-eaf5f558a35f",
                        "entry_id": "c170272f-8942-3099-a085-dfd4fae2cf4e",
                        "glosses": [
                            "Begriff für die semantische Rolle desjenigen, der Nutzen oder Schaden von einer Handlung hat"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "e0f974b1-a325-4467-b1bb-ffcc6ea1cfc9",
                                "sense_id": "72d81030-de1d-32a9-88f2-eaf5f558a35f",
                                "text": "In dem Satz: \"Er kauft seiner Mutter ein Buch\" ist \"seiner Mutter\" Rezipientin der Handlung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3126374f-62dc-3514-925f-5212c9714d97",
                        "entry_id": "c170272f-8942-3099-a085-dfd4fae2cf4e",
                        "glosses": [
                            "Glasbehälter zur Herstellung eines Vakuums"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ed361e1-6f4d-445d-8562-4099703d4d8c",
                        "source_entry_id": "c170272f-8942-3099-a085-dfd4fae2cf4e",
                        "source_sense_id": "b7a76974-08ee-36e4-9ebd-f6331fdaf14b",
                        "target_lang_word": "percipient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percipient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "541f690b-fd23-396a-92da-f37c053c4837",
                                        "entry_id": "5b7a3ee8-be09-3539-a707-c8417b858830",
                                        "glosses": [
                                            "Having the ability to perceive, especially to perceive quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ab5937-e972-4707-8949-a10122bd04c0",
                                                "sense_id": "541f690b-fd23-396a-92da-f37c053c4837",
                                                "text": "Fasting, yet not of want\nPercipient, he on that mysterious steed\nHad reach’d his resting-place,\nFor expectation kept his nature up."
                                            },
                                            {
                                                "example_id": "7ba0bc6b-c620-4719-af99-70e0610c8bbb",
                                                "sense_id": "541f690b-fd23-396a-92da-f37c053c4837",
                                                "text": "[...] he calls attention to the use of glasses […] The eye itself is no more percipient than the glass; is quite as much the instrument of the true self, and also as foreign to the true self, as the glass is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a35c1081-0b20-3f7f-b399-cdd810af3205",
                                        "entry_id": "5b7a3ee8-be09-3539-a707-c8417b858830",
                                        "glosses": [
                                            "Perceiving events only in the moment, without reflection, like a very young child."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "percipient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fef891a-f49f-3f4c-8fd0-c5b5875fa09e",
                                        "entry_id": "3a6109c3-5710-348f-ad4f-6a0e6c388c0a",
                                        "glosses": [
                                            "One who perceives something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b99ea96-378d-48ac-bc82-ae540a49089c",
                                                "sense_id": "9fef891a-f49f-3f4c-8fd0-c5b5875fa09e",
                                                "text": "As anatomy, physiology and, later, psychology have developed into more or less well-organized sciences, they have necessarily and rightly come to incorporate the study of, among other things, the structures, mechanisms, and functionings of animal and human bodies qua percipient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9f0663-51bb-3c56-824b-806b55d5a668",
                                        "entry_id": "3a6109c3-5710-348f-ad4f-6a0e6c388c0a",
                                        "glosses": [
                                            "One who has perceived a paranormal event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b2a20d-0571-465c-9deb-476bd694bc00",
                                                "sense_id": "dc9f0663-51bb-3c56-824b-806b55d5a668",
                                                "text": "In the course of investigating the haunting, I interviewed several percipients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
