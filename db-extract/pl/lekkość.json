                    {
                        "translation_id": "52837a78-362a-414a-a83d-5a1cad76f513",
                        "source_entry_id": "140f7399-0b31-3b62-97fe-8bb9e2abeec2",
                        "source_sense_id": "d0c353d0-d441-3c9a-9733-659567a5efb2",
                        "target_lang_word": "лёгкость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лёгкость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "56ecc7d0-b2f2-311c-90f8-c1c237593e21",
                                        "entry_id": "dc6370d3-6cde-36fd-802d-3befe9bd08b9",
                                        "glosses": [
                                            "свойство по значению прилагательного лёгкий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9007acca-0d0a-4d8d-b303-b9f1be989c72",
                                                "sense_id": "56ecc7d0-b2f2-311c-90f8-c1c237593e21",
                                                "text": "К тому же мышьи и крысьи меха у нас в высокой цене по причине их лёгкости и мягкости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36634214-2ba9-3103-91b0-cda9dcfd65f2",
                                        "entry_id": "dc6370d3-6cde-36fd-802d-3befe9bd08b9",
                                        "glosses": [
                                            "перен.простота, отсутствие усилий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1970e31-fb4e-46bf-b316-d326146c5da7",
                                                "sense_id": "36634214-2ba9-3103-91b0-cda9dcfd65f2",
                                                "text": "Соху поворачивает с удивительною легкостию."
                                            },
                                            {
                                                "example_id": "43b9a807-96f7-4939-b8cd-cb42e8e70f3f",
                                                "sense_id": "36634214-2ba9-3103-91b0-cda9dcfd65f2",
                                                "text": "С лёгкостью заучивал наизусть целые главы из учебников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ba3e83-5155-31a9-8b31-ff5df0599236",
                                        "entry_id": "dc6370d3-6cde-36fd-802d-3befe9bd08b9",
                                        "glosses": [
                                            "перен. ощущение приподнятости, бодрости, свободы, прилива сил, желания деятельности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2219857e-1003-4b09-ade7-2b7c2754193c",
                                                "sense_id": "e4ba3e83-5155-31a9-8b31-ff5df0599236",
                                                "text": "В течение двух последних дней меня держала какая-то узенькая тесёмка; теперь она оборвалась, и я почувствовал такую лёгкость, какой никогда не испытывал в жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27f78341-a5bc-34de-96a8-3d6266b3670f",
                                        "entry_id": "dc6370d3-6cde-36fd-802d-3befe9bd08b9",
                                        "glosses": [
                                            "перен. незначительность, малая степень проявления, воздействия и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4fd06d-1aaf-42ab-9b41-f2d7c0872a10",
                                                "sense_id": "27f78341-a5bc-34de-96a8-3d6266b3670f",
                                                "text": "Таня смотрела на все эти манипуляции как завороженная: отец с младенцем в руках чем-то напомнил ей Сергея с саксофоном — та же нежность и дерзость в обращении, свобода движения и лёгкость прикосновения..."
                                            }
                                        ]
                                    }
                                ]
                            }
