                        "examples": [
                            {
                                "example_id": "8369ef2f-afc5-40fd-85be-ebbab70d21e2",
                                "sense_id": "58c295e9-68e8-36dd-a38f-6350f50cadaa",
                                "text": "Während der Restaurierung einer Kirche entdeckte ein Bauarbeiter eine Reihe von Anonyma aus dem 16. Jahrhundert."
                            },
                            {
                                "example_id": "16d349e0-b50e-4d25-80b6-e9872b5dd4cd",
                                "sense_id": "58c295e9-68e8-36dd-a38f-6350f50cadaa",
                                "text": "„Ein ziemlich grosser Teil dieser Nachdrucke, nämlich zwei Drittel (=12 Werke), sind Anonyma.“"
                            },
                            {
                                "example_id": "7942f17d-604e-4dec-85dc-b3e78f14548f",
                                "sense_id": "58c295e9-68e8-36dd-a38f-6350f50cadaa",
                                "text": "„Mit Sicherheit kann eine ganze Anzahl der Anonyma, vornehmlich Hymnen und Offizien-Vertonungen, dieser Altersschicht zugeordnet werden.“"
                            }
                        ],
