                        "glosses": [
                            "szklanka do picia wódki lub spirytusu, kojarzona z Rosjanami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77f4e5cd-4567-48dd-ac72-1b0e1ca22442",
                                "sense_id": "14b1e3fb-1eba-309b-b592-a57ae643a447",
                                "text": "Żołnierze sowieccy nie mogli uwierzyć, że mimo pięciu lat wojny, zniszczeń, mordów, rekwizycji, kontrybucji i grabieży, nazajutrz po bitwie, na tej samej ulicy, na której wczoraj walczyli, mogli dostać stakan bimbru, a do tego jeszcze zakąskę."
                            }
