                {
                    "sense_id": "6c0b5a29-e7fe-3082-8982-7992fba1a48b",
                    "sense_definition": "Через небольшой промежуток времени; в скором времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лето пролетело очень <w>быстро</w> и незаметно.",
                            "target_lang_translations": {
                                "en": "Summer flew by very <w>quickly</w> and unnoticed.",
                                "zh": "夏天过得<w>很快</w>，不知不觉就结束了。"
                            }
                        },
                        {
                            "text": "Ты <w>быстро</w> привыкнешь к новой школе.",
                            "target_lang_translations": {
                                "en": "You will <w>quickly</w> get used to the new school.",
                                "zh": "你<w>很快</w>就会适应新学校的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "скоро",
                        "вскоре"
                    ],
                    "antonyms": [
                        "нескоро"
                    ],
                    "common_phrases": [
                        "быстро забыть",
                        "быстро понять",
                        "быстро найти",
                        "пройти быстро"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening after a short period of time; soon.",
                        "zh": "在很短的时间之后；不久。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quickly",
                                "target_lang_sense_clarification": "very soon"
