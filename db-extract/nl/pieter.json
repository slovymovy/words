                                            {
                                                "example_id": "ef020f05-ea3e-49ed-b87b-05e50899764e",
                                                "sense_id": "dfa650c9-3249-3706-bd1f-4ffa75bd6212",
                                                "text": "Anna und Peter haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "f4f67796-aa18-4fa6-80b5-e6f06e0d4a67",
                                                "sense_id": "dfa650c9-3249-3706-bd1f-4ffa75bd6212",
                                                "text": "Peter spielt gern."
                                            },
                                            {
                                                "example_id": "50b83b6d-77ac-44f6-998e-75e09f5e9817",
                                                "sense_id": "dfa650c9-3249-3706-bd1f-4ffa75bd6212",
                                                "text": "Peter Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "477233d0-2572-4d63-8a10-ef8e71b99cfa",
                                                "sense_id": "dfa650c9-3249-3706-bd1f-4ffa75bd6212",
                                                "text": "Kennen sie den Vornamen Peter?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Peter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef66f97-6cad-3594-9d93-386b07a48f8b",
                                        "entry_id": "7acd0b8c-cd74-36f8-b214-e5dbb8917755",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5feaf5-a784-411c-a4c8-eacf99e5ca50",
                                                "sense_id": "8ef66f97-6cad-3594-9d93-386b07a48f8b",
                                                "text": "„Dagegen verteidigte die Parteilinke Simone Peter den bisherigen Kurs der Partei: […]“"
                                            },
                                            {
                                                "example_id": "19b2f1c6-cee2-4b85-b7c5-492660a946fe",
                                                "sense_id": "8ef66f97-6cad-3594-9d93-386b07a48f8b",
                                                "text": "„Dabei lautet das Motto: »Blond, mild und frisch«, denn die Peters arbeiten mit einem speziellen Räucherverfahren, bei dem kein Fett in das Feuer tropfen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4622dd56-e6c6-4ec3-ab52-e7977e7b819e",
                        "source_entry_id": "47201cd9-659c-37e7-bc49-bf61d2f2ba9e",
