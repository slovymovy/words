                ],
                "senses": [
                    {
                        "sense_id": "973e031a-b637-35f9-9618-0c3a4169d9f2",
                        "entry_id": "5cb7ccdf-85f3-3ac5-91d2-1a1787406de3",
                        "glosses": [
                            "Moor, das Torf enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f4d0a9-3ad2-46d9-93cf-946e35ee1a70",
                                "sense_id": "973e031a-b637-35f9-9618-0c3a4169d9f2",
                                "text": "„Ein noch wirkungsvolleres Konservierungsmittel ist die Huminsäure der Torfmoore.“"
                            },
                            {
                                "example_id": "70dafcce-f4fa-44cc-b3dd-39be5ee33179",
                                "sense_id": "973e031a-b637-35f9-9618-0c3a4169d9f2",
                                "text": "„Dort sollen sie die Fuß- und Hufspuren beseitigen, damit der Anschein entsteht, als gäbe es kein Anwesen als Ziel, sondern bloß eine Verbindung mit dem Torfmoor, das in dieser Jahreszeit niemand betritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea28c185-c3fd-455b-9623-84c135d21a17",
                        "source_entry_id": "5cb7ccdf-85f3-3ac5-91d2-1a1787406de3",
                        "source_sense_id": "973e031a-b637-35f9-9618-0c3a4169d9f2",
                        "source_sense_description": "Moor, das Torf enthält",
                        "target_lang_word": "peat bog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peat bog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8b7ca2-b01b-322a-85b2-df741f6ba5c3",
                                        "entry_id": "89bcbed9-c5d1-353b-b74c-f034fa2c7680",
                                        "glosses": [
                                            "A bog in which the soil is formed from peat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bce785d2-e6b3-43fc-a788-6b402c47a0f8",
                        "source_entry_id": "5cb7ccdf-85f3-3ac5-91d2-1a1787406de3",
                        "source_sense_id": "973e031a-b637-35f9-9618-0c3a4169d9f2",
                        "source_sense_description": "Moor, das Torf enthält",
                        "target_lang_word": "tourbière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourbière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Endroit d’où l’on extrait de la tourbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f138ff3e-a4de-4d34-9db9-c89be7707fbb",
                                                "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                                "text": "Que de fois son père lui avait-il parlé de ces tourbières et de leurs entailles, c’est-à-dire des grands étangs que l’eau a remplis après que la tourbe a été enlevée, qui sont l’originalité de la vallée de la Somme."
                                            },
                                            {
                                                "example_id": "dc9a752c-cfb3-4cce-ac1e-98bcad1b1699",
                                                "sense_id": "6b7db72b-4a04-3808-93e2-4093a9787e61",
                                                "text": "On a pu suivre d'une façon précise l'histoire post-glaciaire dans le Nord de l'Europe, où de nombreux végétaux à demi fossilisés des tourbières ont permis de suivre couche par couche l’évolution des végétaux principaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Sol formé de tourbe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4bc8b52-cfd9-4682-a054-a7dadbcd8859",
                                                "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                                "text": "Au bord des petits lacs des Alpes, plus ou moins comblés, se forment des tourbières appelées fagnes ; pour le touriste elles se signalent par les élégantes houppes blanches des Linaigrettes."
                                            },
                                            {
                                                "example_id": "74f005f1-4b4d-4b1a-a49f-d76044c182dc",
                                                "sense_id": "650c3863-4721-3ac8-926a-3ddf91c97525",
                                                "text": "« La tendance n’est pas, non plus, à planter des résineux : on va même en enlever qui n’ont plus de valeur économique, en septembre, sur une tourbière à Argol », ajoute Marielle Chaumien, responsable communication du PNRA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c18705a-1250-3376-9fe3-c82e3cbc6d2d",
                                        "entry_id": "e3d4d7b3-f9b4-3c90-abdb-d125531f2052",
                                        "glosses": [
                                            "Celle qui extrait la tourbe."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4bc63d-d0e8-4316-a222-f51bb235050a",
                                                "sense_id": "5c18705a-1250-3376-9fe3-c82e3cbc6d2d",
                                                "text": "[…] ouvrière tourbière qui déchargeait les brouettés de tourbe […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tourbière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d430ddac-0b03-36d5-9986-2577e426c01b",
                                        "entry_id": "cb6f2750-397d-380e-87bd-ca2e7c5dbfd8",
                                        "glosses": [
                                            "Féminin singulier de tourbier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f96645-b1b8-4d1c-aa20-0d1ee202add7",
                                                "sense_id": "d430ddac-0b03-36d5-9986-2577e426c01b",
                                                "text": "Spécialisée dans l’industrie tourbière, l’entreprise québécoise Premier Tech est récemment devenue copropriétaire de l’équipe Astana après avoir été l’un de ses fidèles commanditaires pendant plusieurs années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
