                "senses": [
                    {
                        "sense_id": "1086137d-c27b-38c0-9993-af5ffc67bf39",
                        "entry_id": "5e406a22-2c42-38ca-b1ab-8b953d9389c4",
                        "glosses": [
                            "de mate waarin met goed kan nadenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c474e1cc-8119-4ec4-a54c-fa34604d6bd0",
                                "sense_id": "1086137d-c27b-38c0-9993-af5ffc67bf39",
                                "text": "Ik zal het u ronduit zeggen, zei vorst Vasili op de toon van een slimme man die ervan overtuigd is dat slimmigheidjes geen nut hebben tegenover de scherpzinnigheid van zijn gesprekspartner. Ik weet dat u dwars door mensen heen kijkt. Anatole is geen genie, maar het is een eerlijke, goede jongen, een fijne zoon en goed voor zijn familie."
                            },
                            {
                                "example_id": "5152aa0f-8e31-47e9-b58f-2c1856ba7b03",
                                "sense_id": "1086137d-c27b-38c0-9993-af5ffc67bf39",
                                "text": "De Jeroen Bosch-tentoonstelling in Den Bosch is niet onopgemerkt gebleven in de internationale media. Wereldwijd is er aandacht voor expositie in het Noordbrabants Museum. \"Verbeelding en scherpzinnigheid komen naar voren in deze waanzinnige show\", schrijft The Financial Times."
                            }
                        ]
                    },
                    {
                        "sense_id": "630a4e7b-a89e-3aaf-a7ff-a244f3893bc9",
                        "entry_id": "5e406a22-2c42-38ca-b1ab-8b953d9389c4",
                        "glosses": [
                            "iets heel slims"
                        ],
