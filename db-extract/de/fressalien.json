                                    },
                                    {
                                        "sense_id": "67f94e32-ada3-3c16-a074-48d8d6114c67",
                                        "entry_id": "47207f85-e441-3eac-bf61-b56374a130e2",
                                        "glosses": [
                                            "Acteur comique de comédies italiennes. ^([2])"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a7d9f8-1061-469f-8d53-27f003577619",
                                                "sense_id": "67f94e32-ada3-3c16-a074-48d8d6114c67",
                                                "text": "En 1800, une troupe de chanteurs italiens, parmi lesquels on comptait Lazzerini, ténor; Parlamagni, basse, l'excellent bouffe Raffanelli et Mᵐᵉ Strinasacchi, débuta, dans la jolie salle Olympique de la rue Chantereine, par le chef-d'œuvre de Cimarosa il Matrimonio segretto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b281242f-9465-3035-976a-0f14e1ccb102",
                                        "entry_id": "47207f85-e441-3eac-bf61-b56374a130e2",
                                        "glosses": [
                                            "Opéra bouffe. ^([2])"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c21fa74f-d8f5-3ec5-b415-cb45fc57c80f",
                                        "entry_id": "c1b908a4-8a6b-3700-a404-c91e6ec05a3c",
                                        "glosses": [
                                            "Nourriture."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09703e4a-d54c-421a-9aca-54f475ba6926",
                                                "sense_id": "c21fa74f-d8f5-3ec5-b415-cb45fc57c80f",
                                                "text": "Alors, comment est la bouffe à la cantine ?"
                                            },
                                            {
                                                "example_id": "a5796cb3-03bd-4750-af6f-30a693c5c0be",
                                                "sense_id": "c21fa74f-d8f5-3ec5-b415-cb45fc57c80f",
                                                "text": "Les troufions versent la bouffe dans les vieilles boîtes cabossées, nouilles, fayots, croûtes de fromage, confitures, tout ça mélangé, ils se marrent, ils en versent les trois quarts sur les clochards, plein la braguette, ça réchauffe, papa."
                                            },
                                            {
                                                "example_id": "4bdfe55f-3423-4cec-aa62-a71a707c28d1",
                                                "sense_id": "c21fa74f-d8f5-3ec5-b415-cb45fc57c80f",
                                                "text": "Au milieu de sa famille, dans sa maison, sa bouffe à eux dans ma bouche, puis dans mon tube digestif, puis dans mes intestins, mon estomac, un maximum d’organes, mon sang, et les déchets comme ça on aura les mêmes."
                                            },
                                            {
                                                "example_id": "0b7f921e-4a39-4c59-b2a7-95aa07313953",
                                                "sense_id": "c21fa74f-d8f5-3ec5-b415-cb45fc57c80f",
                                                "text": "La gamelle de croquettes ou le bol de lait que déguste ce bon vieux Fluffy tient presque du crime contre la patrie : le ministère de l'Agriculture et de l'Alimentation estime que les chats consomment chaque année environ 68 millions de litres de lait, pendant que les chiens avalent 280.000 tonnes de bouffe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ae71a6-8da4-39bd-b968-1e05e4ed7c9f",
                                        "entry_id": "c1b908a4-8a6b-3700-a404-c91e6ec05a3c",
                                        "glosses": [
                                            "Repas."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11d05a3-4cba-4c8d-bd9c-a9add1ee4022",
                                                "sense_id": "57ae71a6-8da4-39bd-b968-1e05e4ed7c9f",
                                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "977c2e20-6c4e-3de1-8041-7dad4cf51a95",
                                        "entry_id": "4dace78b-151b-3097-a428-e16ec5fa7f0b",
                                        "glosses": [
                                            "Plaisanterie, blague."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb5bff3-85d9-4eaf-90d1-9370f546120f",
                                                "sense_id": "977c2e20-6c4e-3de1-8041-7dad4cf51a95",
                                                "text": "C’était une bonne bouffe. Giuseppe avait la spécialité des bouffes de toutes les catégories jusques et y compris les bouffes sang-de-bœuf, ou sang de n’importe quoi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d9153a-6511-3118-bfff-681251fdb77b",
                                        "entry_id": "b7fa2e76-b075-39eb-9cd3-9e6066f9949b",
                                        "glosses": [
                                            "Gifle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9111d2f6-edcf-49f0-947c-87413c7253e1",
                                                "sense_id": "a2d9153a-6511-3118-bfff-681251fdb77b",
                                                "text": "Pas digne d’un homme d’éplucher des légumes, qu’il soit un peu comme les autres, à s’intéresser au sport, à hurler pour la moindre mauvaise note, supprimer les sorties et flanquer des bouffes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
