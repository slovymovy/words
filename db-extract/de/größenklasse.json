                        "sense_id": "62bd21ca-ff55-3256-9bf8-af40e8bbe957",
                        "entry_id": "fe1f6003-8dd3-3807-b9c2-0ee4fbe5b367",
                        "glosses": [
                            "Maßeinheit für die Helligkeit eines Sterns oder anderen Himmelskörpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b543f2b-ec25-4744-9163-e423624d6749",
                                "sense_id": "62bd21ca-ff55-3256-9bf8-af40e8bbe957",
                                "text": "Im Altertum teilte man die Sterne in sechs Größenklassen ein."
                            },
                            {
                                "example_id": "b8c8cd33-1687-4e1e-9dd3-2cde8be637bf",
                                "sense_id": "62bd21ca-ff55-3256-9bf8-af40e8bbe957",
                                "text": "Mensa besitzt nur Sterne ab fünfter Größenklasse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9e56441-2f2f-4f65-bffe-2c9d65459c40",
