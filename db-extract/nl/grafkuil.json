                                        "sense_id": "16a6dd70-99dd-3a72-b72e-6fb63355ffca",
                                        "entry_id": "aeda7a3a-60d9-355f-a388-e2b8af56a4c4",
                                        "glosses": [
                                            "Dull, produced in the middle or back of the mouth. (See Grave and acute on Wikipedia.Wikipedia)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
