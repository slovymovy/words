                "senses": [
                    {
                        "sense_id": "03c77c39-9978-3cbc-8979-ba24b6efa8ab",
                        "entry_id": "dec49c0a-6291-30ef-b8d1-458d4b9be201",
                        "glosses": [
                            "Behälter/Tank, der mit Wasser oder Luft gefüllt werden kann, um den Auftrieb eines U-Boots genauer einzustellen"
                        ],
                        "tags": [
                            "U-Boot-Bau"
                        ],
                        "examples": [
                            {
                                "example_id": "3beb8cc7-8867-4841-b05e-7ab376bf49c5",
                                "sense_id": "03c77c39-9978-3cbc-8979-ba24b6efa8ab",
                                "text": "„Da man das Boot, gleich dem Fisch, in der Tiefe schwebend halten und mit ihm auf- und absteigen will, bedarf es eines ständigen Flutens und Lenzens der Regelzellen.“"
                            },
                            {
                                "example_id": "7558cd91-ccf2-496f-9a08-7d7d3bd9c3d2",
                                "sense_id": "03c77c39-9978-3cbc-8979-ba24b6efa8ab",
                                "text": "„Andererseits soll der Füllstand in einer derartigen Regelzelle möglichst exakt einstellbar sein, so dass das Volumen der zusätzlichen Tieflenzzellen so klein als möglich gehalten werden kann.“"
                            },
                            {
                                "example_id": "09549f3e-00f4-4fce-8248-d58830294e07",
                                "sense_id": "03c77c39-9978-3cbc-8979-ba24b6efa8ab",
                                "text": "„Das in einer niederländischen Werft gebaute Boot verfügt denn auch über „echte“ Tauch- und Regelzellen wie sie von den U-Boot-Filmen bekannt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
