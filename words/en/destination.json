{
    "word_family": [
        "destine",
        "destiny",
        "predestination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dfb2d550-6fa4-3727-b4c5-2ffa1396b619",
                    "sense_definition": "The place set for the end of a journey, or to which something is sent; the point aimed at.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After driving for ten hours, we finally reached our <w>destination</w> just before midnight.",
                            "target_lang_translations": {
                                "ru": "После десяти часов за рулем мы наконец добрались до <w>пункта назначения</w> незадолго до полуночи."
                            }
                        },
                        {
                            "text": "Please make sure to check the flight status before you <w>arrive</w> <w>at</w> <w>your</w> <w>destination</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обязательно проверьте статус рейса, прежде чем прибудете в <w>место назначения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "terminus",
                        "goal"
                    ],
                    "antonyms": [
                        "origin",
                        "source",
                        "departure"
                    ],
                    "common_phrases": [
                        "arrive at your destination",
                        "final destination",
                        "holiday destination",
                        "tourist destination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, являющееся целью поездки или путешествия, либо адрес, по которому отправляется груз или письмо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пункт назначения",
                                "target_lang_sense_clarification": "официальный или транспортный термин"
                            },
                            {
                                "target_lang_word": "место назначения",
                                "target_lang_sense_clarification": "общий термин для цели поездки"
                            },
                            {
                                "target_lang_word": "направление",
                                "target_lang_sense_clarification": "в контексте туризма или маршрута"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be9fc97-b675-3688-b178-5161ab1e5547",
                    "sense_definition": "The purpose for which something is intended or the predetermined end or use of an object.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>destination</w> of these funds is to support local schools and community centers.",
                            "target_lang_translations": {
                                "ru": "<w>Назначение</w> этих средств — поддержка местных школ и общественных центров."
                            }
                        },
                        {
                            "text": "He felt that his life had a specific <w>destination</w> that he was meant to fulfill.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что у его жизни есть определенное <w>предназначение</w>, которое он должен исполнить."
                            }
                        }
                    ],
                    "synonyms": [
                        "aim",
                        "intent",
                        "objective"
                    ],
                    "common_phrases": [
                        "ultimate destination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель, для которой что-либо предназначено, или предопределенный результат использования объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предназначение",
                                "target_lang_sense_clarification": "высокая цель или жизненный путь"
                            },
                            {
                                "target_lang_word": "назначение",
                                "target_lang_sense_clarification": "цель использования средств или предметов"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "конечный результат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f90eeb-7bbb-3888-a118-445f70092239",
                    "sense_definition": "The act of destining, appointing, or decreeing something beforehand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>destination</w> of the new governor was met with both praise and criticism from the public.",
                            "target_lang_translations": {
                                "ru": "<w>Назначение</w> нового губернатора было встречено общественностью как похвалой, так и критикой."
                            }
                        },
                        {
                            "text": "In some philosophies, the <w>destination</w> of a soul is decided long before birth.",
                            "target_lang_translations": {
                                "ru": "В некоторых философиях <w>предопределение</w> души решается задолго до рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "appointment",
                        "designation",
                        "ordination"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт предварительного определения, назначения или предписания чего-либо (официально или философски)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначение",
                                "target_lang_sense_clarification": "на должность или пост"
                            },
                            {
                                "target_lang_word": "предопределение",
                                "target_lang_sense_clarification": "в философском или религиозном смысле"
                            },
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "рок или фатум"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}