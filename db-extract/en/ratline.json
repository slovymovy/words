    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                "word": "ratline",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a7cd709c-9006-4ba1-b05a-626f5917f629",
                        "entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                        "tags": [
                            "plural"
                        ],
                        "form": "ratlines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89fd8f07-78f3-3b3e-8512-112d6999269f",
                        "entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                        "glosses": [
                            "The rope or similar material used to make cross-ropes on a ship."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "48d37eb1-67cf-34dc-842f-39aff4804b1a",
                        "entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                        "glosses": [
                            "Any of the cross ropes between the shrouds, which form a net-like ropework, allowing sailors to climb up towards the top of the mast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f313cae9-244f-4fe0-9ec7-84c07e754582",
                                "sense_id": "48d37eb1-67cf-34dc-842f-39aff4804b1a",
                                "text": "[H]e laid hold of the first ratline with his right hand, then sprung to the second, with his left, and so on alternately, right and left, up to the last, close to the futtock shrouds."
                            },
                            {
                                "example_id": "4dd434b8-c029-4251-a02c-2d3320191e7d",
                                "sense_id": "48d37eb1-67cf-34dc-842f-39aff4804b1a",
                                "text": "That meant it was not possible to use ratlines — that is, to make rope ladders out of the shrouds by adding small connecting pieces of ropes."
                            }
                        ]
                    },
                    {
                        "sense_id": "790f0d25-dbb2-309b-a054-d93685085c4c",
                        "entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                        "glosses": [
                            "A system of escape routes for Nazis and other fascists fleeing Europe in the aftermath of World War II."
                        ],
                        "tags": [
                            "historical",
                            "in-plural",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "345e26f0-8ec5-440e-9282-a5fcf646a085",
                                "sense_id": "790f0d25-dbb2-309b-a054-d93685085c4c",
                                "text": "Marc Masurovsky, of the European Shoah Legacy Institute, has a remarkable knowledge of the Nazi ratlines and Allied intelligence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31259369-9606-41a0-b1f9-281a5294a24b",
                        "source_entry_id": "c44a5a92-5f55-32b1-b20c-7198b76c1520",
                        "source_sense_description": "net like ropework of the shrouds",
                        "target_lang_word": "enfléchure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfléchure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b1160b3-02dc-35d2-809e-6548aa0feeb8",
                                        "entry_id": "963f7547-6490-32a8-9bf6-750a7694cac9",
                                        "glosses": [
                                            "Échelons de cordage qui servent à monter dans les haubans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccabb646-f57d-460e-bea8-19764fa1931d",
                                                "sense_id": "5b1160b3-02dc-35d2-809e-6548aa0feeb8",
                                                "text": "Les matelots s’élancèrent dans les enfléchures du vent, et, non sans peine, ils diminuèrent la surface de la voile en l’enroulant de ses garcettes sur la vergue amenée."
                                            },
                                            {
                                                "example_id": "e5373ef5-5429-45a6-b6c4-b80dba08480b",
                                                "sense_id": "5b1160b3-02dc-35d2-809e-6548aa0feeb8",
                                                "text": "Jodu leva la tête et aperçut Mamdoo Tindal qui le regardait depuis la kursi du mât de misaine et lui faisait signe d'un doigt.\nMonte donc !\nC'était l'épreuve, Jodu le comprit : il cracha dans ses mains, murmura un bismillah avant de s’attaquer à l’enfléchure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
