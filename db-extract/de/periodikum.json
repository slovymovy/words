                                "target_senses": [
                                    {
                                        "sense_id": "4c3f51b1-85ce-344c-b5cb-7a199d5773c8",
                                        "entry_id": "427773ca-9533-3ec2-9e80-e6b082fde79a",
                                        "glosses": [
                                            "A publication issued regularly, but less frequently than daily."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5dcd74f-5410-33c6-bff6-1ad1c849d0af",
                                        "entry_id": "427773ca-9533-3ec2-9e80-e6b082fde79a",
                                        "glosses": [
                                            "A regularly issued thematic publication that contains the most current information in its field, often the primary means for communication of original scholarship or creative work at the cutting edge of research in its field."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "periodical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e60e28af-6364-3012-88ac-ae1bad2aae96",
                                        "entry_id": "08ef3666-5a2e-3364-b7ef-0fb41f24bf14",
                                        "glosses": [
                                            "Periodic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4cf119-d235-42df-ad78-5fc9533d9941",
                                                "sense_id": "e60e28af-6364-3012-88ac-ae1bad2aae96",
                                                "text": "The periodical times of all the satellites."
                                            },
                                            {
                                                "example_id": "9a6708d1-0b78-4e0f-89ad-bd21b0e7896b",
                                                "sense_id": "e60e28af-6364-3012-88ac-ae1bad2aae96",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501459d3-0144-314f-a427-38b9a3dc541d",
                                        "entry_id": "08ef3666-5a2e-3364-b7ef-0fb41f24bf14",
                                        "glosses": [
                                            "Published at regular intervals of more than one day, especially weekly, monthly, or quarterly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ff6efa-b386-4893-9911-f818308dd2ba",
                                                "sense_id": "501459d3-0144-314f-a427-38b9a3dc541d",
                                                "text": "influence opinion through the periodical press."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abac3ed-9389-39d2-b393-7b82ba433039",
                                        "entry_id": "08ef3666-5a2e-3364-b7ef-0fb41f24bf14",
                                        "glosses": [
                                            "Of, or relating to such a publication."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "354ea03a-4d2b-446c-a628-e8f5bb642b8b",
                        "source_entry_id": "d83a1bf6-ddbf-3ac4-913d-d933f66bbff9",
                        "source_sense_id": "ed842ab5-1a93-341e-9e52-abd9849dcfcb",
                        "source_sense_description": "etwas, das regelmäßig (periodisch) erscheint, zum Beispiel ein Magazin",
                        "target_lang_word": "périodique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périodique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1df597f-bb3d-3920-bff8-dab2b29b0c12",
                                        "entry_id": "99adb801-b28c-3b38-b36a-a7cfa364d492",
                                        "glosses": [
                                            "Qui revient régulièrement dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b864aca-d55f-4cb4-993b-0980b00bae25",
                                                "sense_id": "a1df597f-bb3d-3920-bff8-dab2b29b0c12",
                                                "text": "Après la dénomination des mois, nous nous sommes occupés des fractions du mois. Nous avons vu que les fractions des mois étant périodiques et revenant trois fois par mois et trente-six fois par an, étaient déjà fort bien nommées décades ou révolution de dix jours; […]."
                                            },
                                            {
                                                "example_id": "b81834fa-e156-4cdb-810e-b200b2aeda97",
                                                "sense_id": "a1df597f-bb3d-3920-bff8-dab2b29b0c12",
                                                "text": "Mais il entendit bientôt un bruit périodique assez semblable à celui que font les gouttes d’eau d’une fontaine en tombant du robinet."
                                            },
                                            {
                                                "example_id": "a849b20a-d51b-43b4-bdf1-28c4441a9193",
                                                "sense_id": "a1df597f-bb3d-3920-bff8-dab2b29b0c12",
                                                "text": "La capture des baleinoptères par des procédés modernes a remplacé la tuerie périodique des bandes de marsouins rabattus par les embarcations au fond des baies."
                                            },
                                            {
                                                "example_id": "ce4d2ea2-ae39-4c04-a390-7c322dfa0244",
                                                "sense_id": "a1df597f-bb3d-3920-bff8-dab2b29b0c12",
                                                "text": "A partir d'ici, nous étudions principalement le mouvement périodique d'un corps, le satellite artificiel, soumis a l'attraction gravitationnelle de la Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d1fca-0743-3c12-9cb5-96c190847ed8",
                                        "entry_id": "99adb801-b28c-3b38-b36a-a7cfa364d492",
                                        "glosses": [
                                            "Qualifie un ouvrage ou un écrit qui paraît par livraisons successives, dans des temps fixes et réglés."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b1fd713-7278-3e9b-a993-3a56dd023db1",
                                        "entry_id": "99adb801-b28c-3b38-b36a-a7cfa364d492",
                                        "glosses": [
                                            "Qualifie un ouvrage ou un écrit qui paraît par livraisons successives, dans des temps fixes et réglés.",
                                            "(En fonction de l'auteur et du contexte) Qui paraît à intervalles réguliers, indépendamment du rythme de cette parution."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e147a8-8890-4486-9bb0-f66c5356db23",
                                                "sense_id": "2b1fd713-7278-3e9b-a993-3a56dd023db1",
                                                "text": "Le 2 août, l’état de siège est déclaré, qui donne aux autorités militaires le pouvoir de suspendre ou d’interdire toute publication périodique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f39016e-1c76-39a8-94ee-e1dc4fbdc6b7",
                                        "entry_id": "99adb801-b28c-3b38-b36a-a7cfa364d492",
                                        "glosses": [
                                            "Qualifie un ouvrage ou un écrit qui paraît par livraisons successives, dans des temps fixes et réglés.",
                                            "(En fonction de l'auteur et du contexte) Qui paraît à intervalles réguliers, mais pas quotidiennement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ea6bed-6d4f-48ff-b553-d3013700bcfc",
                                                "sense_id": "4f39016e-1c76-39a8-94ee-e1dc4fbdc6b7",
                                                "text": "La presse quotidienne a perdu relativement de son importance, concurrencée par une presse périodique, spécialisée ou d’informations générales, dont les progrès considérables se font en partie à son détriment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6b3ded-0d0b-32b4-91db-e2ce7ea4d9ef",
                                        "entry_id": "99adb801-b28c-3b38-b36a-a7cfa364d492",
                                        "glosses": [
                                            "Dont la partie décimale peut s’écrire comme la répétition à l’infini d’une suite de chiffres appelée période."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2336923-92a5-485a-a13e-be80ad50dee9",
                                                "sense_id": "fc6b3ded-0d0b-32b4-91db-e2ce7ea4d9ef",
                                                "text": "Nombre ou fraction périodique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d4aed3-b831-3ba3-9eda-95ec717db5d2",
