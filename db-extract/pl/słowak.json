                                            {
                                                "example_id": "4a33fa8e-2e18-424e-9611-44f2eeab4b49",
                                                "sense_id": "d9626f74-1f9d-3cff-9f7c-c38e35bf1c09",
                                                "text": "„Es sind vor allem zwei große geschichtliche Verknotungen, die Tschechen und Deutsche – von den Slowaken war bis ins 20. Jahrhundert hinein keine Rede, und was man später die Slowakei nannte, hieß bis 1918 Oberungarn – gegeneinander hetzten.“"
                                            }
                                        ],
