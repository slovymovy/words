                "senses": [
                    {
                        "sense_id": "f682d473-1bd6-3d19-83c3-7fffb76e990f",
                        "entry_id": "7a343a0e-3fa3-3392-b4dc-c5c3c896919d",
                        "glosses": [
                            "durchlässige Vorrichtung, Gerät oder Baugruppe zur Trennung oder Aussonderung bestimmter Feststoffe in Filterlamellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4fddd32-2e78-4f39-8629-016edb02be45",
                                "sense_id": "f682d473-1bd6-3d19-83c3-7fffb76e990f",
                                "text": "„ „Mit dem Lamellenfilter als Pilotprojekt verfügen wir über eine weitere moderne Technik zur Behandlung von verschmutztem Regenwasser, das heute in unserer Region der wesentliche Eintragspfad für Nährstoffe in die Gewässer ist“, sagt Jörg Simon, Vorstandsvorsitzender der Berliner Wasserbetriebe.“"
                            },
                            {
                                "example_id": "54881f0b-7356-47d6-abbc-6a92da9cd064",
                                "sense_id": "f682d473-1bd6-3d19-83c3-7fffb76e990f",
                                "text": "„Lamellenfilter werden oft für feine Filtrierungen verwendet.“"
                            },
                            {
                                "example_id": "93537c46-7741-45d9-ad61-067addca2dbd",
                                "sense_id": "f682d473-1bd6-3d19-83c3-7fffb76e990f",
                                "text": "„Die meisten Maschinen besaßen einfache Metallsiebfilter, einige Maschinen waren mit Lamellenfiltern ausgerüstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
