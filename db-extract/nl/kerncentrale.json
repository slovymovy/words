                ],
                "senses": [
                    {
                        "sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                        "entry_id": "1e9bc31d-7853-3ecb-a301-ec13480811f1",
                        "glosses": [
                            "elektriciteitscentrale die energie opwekt met behulp van kernsplijting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e84ba3d-d005-4bb5-836f-3d274e184e1f",
                                "sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                                "text": "De Nationale 7 is een symbool van naoorlogs optimisme, toen de salarissen elk jaar omhoog gingen en Frankrijk het modernste land ter wereld was, met zijn Concorde, tgv en kerncentrales."
                            },
                            {
                                "example_id": "9b56aea5-0b96-494e-aaf0-5dd7724b4d2a",
                                "sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                                "text": "Japanners woedend om vrijspraak oud-topmannen kerncentrales Fukushima"
                            },
                            {
                                "example_id": "fed1354b-c1a5-426c-9bb1-3d2ccf698186",
                                "sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                                "text": "Een kerncentrale is een fabriek waar elektriciteit wordt gegenereerd met behulp van kernsplijting. Het grootste deel van een kerncentrale is conventioneel, het produceert elektriciteit op dezelfde manier als bijvoorbeeld een kolencentrale. Wat een kerncentrale onderscheidt, is het nucleaire deel van het proces. Dit proces speelt zich af in de reactor van de centrale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfd07f5f-b8b0-48a1-a642-0703c395e516",
                        "source_entry_id": "1e9bc31d-7853-3ecb-a301-ec13480811f1",
                        "source_sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                        "target_lang_word": "Kernkraftwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kernkraftwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f49e949-da49-34d0-88a3-e0c63e561b74",
                                        "entry_id": "b4481da9-fb66-3772-88fc-2ec56fe2e968",
                                        "glosses": [
                                            "Kraftwerk, das Strom aus Kernkraft (Kernenergie) herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcefc096-499a-47ed-8fa5-0dd7ae86f226",
                                                "sense_id": "3f49e949-da49-34d0-88a3-e0c63e561b74",
                                                "text": "Die Kernkraftwerke erzeugen einen Teil des Stroms, der in Deutschland verbraucht wird."
                                            },
                                            {
                                                "example_id": "e030a956-e9fe-4e82-9acb-097d13acfaa6",
                                                "sense_id": "3f49e949-da49-34d0-88a3-e0c63e561b74",
                                                "text": "„Im Kraftwerkspark bestünden Überkapazitäten von elf Gigawatt, was es erlaube, die sieben ältesten Kernkraftwerke plus Krümmel nicht wieder anzuschalten.“"
                                            },
                                            {
                                                "example_id": "81ee4faf-7c96-4b00-8fa7-538abd59e0b0",
                                                "sense_id": "3f49e949-da49-34d0-88a3-e0c63e561b74",
                                                "text": "„Derselben Terrassengeneration gehört talabwärts auf ähnlichem Höhenniveau der Bubenheimer Berg an, als schmaler bewaldeter Sporn unmittelbar rechts vom Kühlturm des Kernkraftwerks Mülheim-Kärlich zu erkennen (…).“"
                                            },
                                            {
                                                "example_id": "d1dee825-45f8-4e15-a39e-3ab509df6972",
                                                "sense_id": "3f49e949-da49-34d0-88a3-e0c63e561b74",
                                                "text": "„Der weltweite radioaktive Fall-out aus diversen Kernkraftwerken und Lagerstätten hatte andere Gegenden wesentlich schlimmer getroffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00d4e0b5-7137-4b92-9854-e16724ef31aa",
                        "source_entry_id": "1e9bc31d-7853-3ecb-a301-ec13480811f1",
                        "source_sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                        "target_lang_word": "nuclear power station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear power station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "098e4a9b-e11f-349f-8937-693278e558b8",
                                        "entry_id": "94539749-eaf5-389c-a405-c2672d63a0fe",
                                        "glosses": [
                                            "A power station that obtains its primary energy from the heat generated in nuclear reactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc3f27e-903b-44bd-a982-ae66851b34e4",
                                                "sense_id": "098e4a9b-e11f-349f-8937-693278e558b8",
                                                "text": "For 75 years, it has fulfilled a wide range of roles: producing weapons-grade plutonium for early atomic weapons in the aftermath of the Second World War; the world's first commercial nuclear power station supplying electricity to the National Grid; reprocessing and storage of nuclear fuel; and the processing of lower grades of radioactive waste for off-site storage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83c7d381-ecd3-4b02-8afa-c992d3a612b3",
                        "source_entry_id": "1e9bc31d-7853-3ecb-a301-ec13480811f1",
                        "source_sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                        "target_lang_word": "atomic powerstation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b1640899-ea63-4395-be54-477efbc95a50",
                        "source_entry_id": "1e9bc31d-7853-3ecb-a301-ec13480811f1",
                        "source_sense_id": "8e8c9f05-f4d4-3b16-9f99-686890750599",
                        "target_lang_word": "centrale nucléaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centrale nucléaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0d1d9f7-b9b5-3e1a-b719-f40cb394b825",
                                        "entry_id": "cfb52ce2-9f91-3707-926c-d16806bf333a",
                                        "glosses": [
                                            "Installation industrielle produisant de l’énergie électrique ou thermique à partir d’un ou plusieurs réacteurs nucléaires."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Exploitation des réacteurs",
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b06618-4872-4797-a871-0ecb96095a73",
                                                "sense_id": "f0d1d9f7-b9b5-3e1a-b719-f40cb394b825",
                                                "text": "La plus belle, la plus grosse, la plus grande centrale nucléaire jamais construite dans le monde, E.d.f. projette de l'implanter à Liours, tout près de Nogent."
                                            },
                                            {
                                                "example_id": "dce38f50-35d3-4789-ae57-a5b3aaaec390",
                                                "sense_id": "f0d1d9f7-b9b5-3e1a-b719-f40cb394b825",
                                                "text": "Il soutient les efforts d’Antonio Guterres, le secrétaire général de l’ONU, pour geler les combats autour de la centrale nucléaire ukrainienne de Zaporijia."
                                            },
                                            {
                                                "example_id": "c7e1e88e-2342-472d-b2b3-58347b5026cb",
                                                "sense_id": "f0d1d9f7-b9b5-3e1a-b719-f40cb394b825",
                                                "text": "Et si cette décision divise la population, c’est aussi parce que « les trois centrales nucléaires ne produiront que 5 térawattheures, soit environ 1 % de la production annuelle d’électricité en Allemagne », explique Heinz Smital, expert des questions nucléaires chez Greenpeace, qui estime que leur prolongement « ne sert pas à grand-chose »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
