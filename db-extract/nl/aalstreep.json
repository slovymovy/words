                        "entry_id": "2e0bb75d-6622-3778-bcb3-919dff6cffec",
                        "glosses": [
                            "a dark line along the length of the back of an animal, in particular an ungulate"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ccee9a-e18c-40e5-94c5-89d064e7aa44",
                                "sense_id": "5d80b2db-9563-300f-bf2e-5e0c1698c6d5",
                                "text": "De zoogenaamde Muisvaale Paarden hebben zwarte staarten, benevens zwarte maanen, en een zwarten streep, dien de kenners den aalstreep noemen, over de rugstreng.",
                                "translation": "The so called mousy grey horses have black tails, beside black manes, and a black stripe, that the experts call the eel stripe, over the spine of its back.",
                                "english": "The so called mousy grey horses have black tails, beside black manes, and a black stripe, that the experts call the eel stripe, over the spine of its back."
                            },
                            {
                                "example_id": "290f0527-19ca-44b2-b44a-7a4d292bf548",
                                "sense_id": "5d80b2db-9563-300f-bf2e-5e0c1698c6d5",
                                "text": "2004, Gilles Delaborde, \"Fjordenpaard\", Pony's en paarden, tr. by Wim Sanders, Biblion (publ.), page 8.\nDe aalstreep is soms duidelijk afgetekend en de zwarte vlekken worden op de benen zebrastrepen.",
                                "translation": "The dark dorsal line is sometimes clearly distinguishable and on the legs the black spots become zebra stripes.",
                                "english": "The dark dorsal line is sometimes clearly distinguishable and on the legs the black spots become zebra stripes."
                            }
                        ]
                    }
