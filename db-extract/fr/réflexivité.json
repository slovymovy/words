                "senses": [
                    {
                        "sense_id": "0aaa9420-083c-3f1e-8ac1-236a63cd8ae8",
                        "entry_id": "f38d9f7a-f833-3811-9d4a-69c6dece2072",
                        "glosses": [
                            "Faculté de réfléchir la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec88dff0-135c-478c-9cdf-b9c9068a1eec",
                                "sense_id": "0aaa9420-083c-3f1e-8ac1-236a63cd8ae8",
                                "text": "La mort est révélation du Moi à lui- même, absolue réflexivité : miroir et miroir de miroir, pour parler comme Jean Paul."
                            }
                        ]
                    },
                    {
                        "sense_id": "572cf24a-8d9d-35e9-955a-a0d89c686b09",
                        "entry_id": "f38d9f7a-f833-3811-9d4a-69c6dece2072",
                        "glosses": [
                            "Relation binaire qui met en relation tout élément avec lui-même."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6469570-7b38-34fa-8bfe-11dc0273e62e",
                        "entry_id": "f38d9f7a-f833-3811-9d4a-69c6dece2072",
                        "glosses": [
                            "Propriété d'un programme de pouvoir se manipuler soi-même."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4ba510e7-5bb5-3d45-b451-7aa9c907aa18",
                        "entry_id": "f38d9f7a-f833-3811-9d4a-69c6dece2072",
                        "glosses": [
                            "Démarche méthodologique consistant à appliquer les outils de l’analyse à son propre travail ou à sa propre réflexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742c0cb7-83c1-474b-9f36-2d122010c2bc",
                                "sense_id": "4ba510e7-5bb5-3d45-b451-7aa9c907aa18",
                                "text": "La distanciation constitue-t-elle une forme de réflexivité spécifique à la lecture littéraire ? Ou, à l'inverse, la réflexivité du lecteur n'est-elle qu'une dimension de la distanciation du sujet par rapport à soi, aux autres et au monde ?"
                            },
                            {
                                "example_id": "995597d5-8b19-4fb6-8fb1-880f476ce5a9",
                                "sense_id": "4ba510e7-5bb5-3d45-b451-7aa9c907aa18",
                                "text": "La coordination dédiée constitue alors un dispositif de réflexivité permettant de désimmédiatiser l’intervention."
                            },
                            {
                                "example_id": "2b832089-a464-4aea-bb7e-47297c0ae375",
                                "sense_id": "4ba510e7-5bb5-3d45-b451-7aa9c907aa18",
                                "text": "Une jeune femme … relate quelques souvenirs, non pas marquants, mais plutôt significatifs : un peu comme pour un journal intime, mais avec une forte dose de littéralité et de réflexivité (c.-à-d. cette volonté de réfléchir – rétrospectivement – à ses comportements passés)."
                            }
                        ]
                    }
                ],
