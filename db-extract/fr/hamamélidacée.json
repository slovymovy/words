                        "glosses": [
                            "Plante des dicotylédones, famille des Hamamelidaceae à laquelle appartiennent notamment l'hamamélis et le liquidambar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85795754-15d3-470c-a3d1-5425b9f6e164",
                                "sense_id": "bab80dbc-f6ed-3f68-8eda-1311b7bea25c",
                                "text": "Elle savait distinguer merveilleusement une légumineuse arbustive, la coronille par exemple (Coronilla), d'une hamamélidacée comme le Loropetalum chinense."
                            },
                            {
                                "example_id": "720aa309-3430-4428-a905-cb19f7b69f8a",
                                "sense_id": "bab80dbc-f6ed-3f68-8eda-1311b7bea25c",
                                "text": "Plante de la famille des hamamélidacées, ses fleurs sont identiques à celles d'un Hamamelis, donc minuscules, réunies en petits bouquets avec de longues étamines à anthères rouge-orange qui fleurissent tôt au printemps."
                            }
                        ]
                    }
