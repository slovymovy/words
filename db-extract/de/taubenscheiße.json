                        "sense_id": "e486bcf2-212a-36a8-8785-73d2aaf07126",
                        "entry_id": "d798d6b4-a501-3cc8-997f-59d4c4bc5d65",
                        "glosses": [
                            "Scheiße, die von einer Taube stammt"
                        ],
                        "tags": [
                            "colloquial",
