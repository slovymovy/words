                                "target_senses": [
                                    {
                                        "sense_id": "5c6af062-368b-3ba4-8d97-6ddedd6b9506",
                                        "entry_id": "c05901ab-f3ae-3b63-904a-e3d5bb518c37",
                                        "glosses": [
                                            "ein Vermittler, der auf der einen Seite Anfragen entgegennimmt, um dann über seine eigene Adresse eine Verbindung zur anderen Seite herzustellen"
                                        ],
                                        "tags": [
                                            "Rechnernetze"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb0118e-5d4f-4b2a-be89-20461235c5c6",
                                                "sense_id": "5c6af062-368b-3ba4-8d97-6ddedd6b9506",
                                                "text": "Ein Proxy kann sowohl dazu dienen, die eigene IP zu verstecken und Anonymität zu gewinnen, als auch dazu, die Ladezeiten zu verbessern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba341289-f193-3fa9-9f33-d0a5fd064d3f",
                                        "entry_id": "c05901ab-f3ae-3b63-904a-e3d5bb518c37",
                                        "glosses": [
                                            "ein indirekter Anzeiger des Klimas, welcher in natürlichen Archiven wie Baumringen, Eiskernen, Korallen, See- oder Ozeansedimenten, Pollen oder menschlichen Archiven wie historischen Aufzeichnungen oder Tagebüchern aufgezeichnet wurde"
                                        ],
                                        "tags": [
                                            "Klimaforschung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fd305c3-6104-41ee-8582-3ac727d23e5b",
                                                "sense_id": "ba341289-f193-3fa9-9f33-d0a5fd064d3f",
                                                "text": "„Aus den 14C-Analysen an diesen Chronologien erkennen wir 14C-Schwankungen auf Zeitskalen von Jahrzehnten bis Jahrtausenden. Es gibt überzeugende Belege dafür, dass die kurz- und mittelfristige Variabilität hauptsächlich durch Schwankungen der Sonnenaktivität hervorgerufen werden, wodurch die 14C-Zeitreihe zu einem einmaligen Proxy der Sonnenaktivität wird.“"
                                            },
                                            {
                                                "example_id": "582eb012-e57e-46ca-afd6-545878b34808",
                                                "sense_id": "ba341289-f193-3fa9-9f33-d0a5fd064d3f",
                                                "text": "Mit Hilfe der durch Proxys gewonnenen Stellvertreter-Daten war es möglich, jahreszeitliche Temperaturschwankungen über lange Zeiträume nachzuvollziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
