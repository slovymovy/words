                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3e31a7a-29ea-314a-a797-8f6e5f494cbd",
                        "entry_id": "f2fb3ffc-7a61-3d27-8212-f5609154f1a2",
                        "glosses": [
                            "Il."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd749e6-b644-4f6e-9807-898b5c2e3172",
                                "sense_id": "d3e31a7a-29ea-314a-a797-8f6e5f494cbd",
                                "text": "Revenant l’autre soir du théâtre avec Robert, nous passons près d’un groupe d’agents qui causent entre eux à mi-voix, et ceci parvient jusqu’à nous dans la rue déserte : « Il lui a filé un coup de lame. » Ou plus exactement : « Iya filé un coup de lame. »"
                            },
                            {
                                "example_id": "7eae9637-82f7-4868-889c-349fc6b95954",
                                "sense_id": "d3e31a7a-29ea-314a-a797-8f6e5f494cbd",
                                "text": "Tiens : eurgarde : j’ t’ai tout marqué sur un papier, tu n’auras qu’à le li donner, i s’arrangera ben avec !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b9d40a-d03d-3cd3-b3e0-0bc8da0e1b7d",
                        "entry_id": "f2fb3ffc-7a61-3d27-8212-f5609154f1a2",
                        "glosses": [
                            "Ils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e59c6e-c7b0-40dd-bf2f-64726a44356c",
                                "sense_id": "b3b9d40a-d03d-3cd3-b3e0-0bc8da0e1b7d",
                                "text": "I disent au poste qu’i va faire beau demain."
                            },
                            {
                                "example_id": "57d9b93a-c4a8-48eb-98be-7cffae36264a",
                                "sense_id": "b3b9d40a-d03d-3cd3-b3e0-0bc8da0e1b7d",
                                "text": "Il a déjà dit aux voisins qu’plus tard i m’verraient revenir avec des galons de capitaine, que j’étais instruit, que j’étais intelligent, et qu’il voudrait bien être à ma place."
                            }
                        ]
                    },
                    {
                        "sense_id": "2549b435-b308-3c7e-bde3-138d1559e050",
                        "entry_id": "f2fb3ffc-7a61-3d27-8212-f5609154f1a2",
                        "glosses": [
                            "Je."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "d99e5c2d-d065-48da-9eb3-b25f621bc92f",
                                "sense_id": "2549b435-b308-3c7e-bde3-138d1559e050",
                                "text": "En Vendée, i signifie « je » et o signifie « il »."
                            }
                        ]
                    }
