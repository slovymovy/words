                "senses": [
                    {
                        "sense_id": "d37819ea-92cd-3135-9101-3d9690f74ad9",
                        "entry_id": "298be50a-74e7-35b3-a3a8-5825a718f249",
                        "glosses": [
                            "wat men eerst moet doen of weten voordat men aan een werk kan beginnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6fad151-0f88-407d-b329-1ce178d3e69a",
                                "sense_id": "d37819ea-92cd-3135-9101-3d9690f74ad9",
                                "text": "Het Noordbrabants Museum in Den Bosch gaat vijf werken van Vincent van Gogh aan nader onderzoek onderwerpen, waaronder Spittende boerin uit 1885. Niet dat het museum denkt dat daar bijvoorbeeld een voorstudie van De Aardappeleters onder zit, maar het wil gewoon weten hoe Van Gogh te werk ging toen hij nog maar pas schilderde."
                            },
                            {
                                "example_id": "60ae5ba5-1b40-45ec-9e73-1e1e618db813",
                                "sense_id": "d37819ea-92cd-3135-9101-3d9690f74ad9",
                                "text": "Een man (58) uit Wanneperveen heeft negen maanden cel gekregen, waarvan drie maanden voorwaardelijk, omdat hij een nepschilderij wilde verkopen waarvan hij beweerde dat het van Vincent van Gogh was. Hij gebruikte daarvoor vervalste brieven en een vals echtheidsonderzoek van het Van Gogh Museum. Het doek zou een voorstudie zijn van Van Goghs schilderij 'De Oogst', een werk uit de vaste collectie van het Van Gogh Museum."
                            },
                            {
                                "example_id": "b59430cf-6885-4bed-ab40-0b5c7a1b1b92",
                                "sense_id": "d37819ea-92cd-3135-9101-3d9690f74ad9",
                                "text": "De ondernemingen leveren de voorstudie, waarbij 16 bruggen worden herbouwd en 15 worden aangepast naar een nieuwe hoogte."
                            }
                        ]
                    }
                ],
