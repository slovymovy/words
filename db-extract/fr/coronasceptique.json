                    {
                        "translation_id": "d1fa9a7a-d648-46fb-abd6-ad5b77b9a98e",
                        "source_entry_id": "abefef94-a56e-3da5-b82e-81a1170ce1d9",
                        "source_sense_id": "79e820e2-a34f-3407-b560-d93b3318441b",
                        "target_lang_word": "coronasceptic",
