                "senses": [
                    {
                        "sense_id": "709ec3c4-7035-379d-b62a-3a5e15a13a0e",
                        "entry_id": "9bb8d29f-01e9-37e7-9ca0-e08dd3a28598",
                        "glosses": [
                            "Déléguer une tâche à un grand nombre de groupes ou de personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da378a4f-6955-496b-98b5-921ae11c7476",
                                "sense_id": "709ec3c4-7035-379d-b62a-3a5e15a13a0e",
                                "text": "Mais pour être claire, avoir simplement des outils de partage vers les médias sociaux sur votre site n’est pas la même chose que de crowdsourcer la création de votre contenu et de vos promotions dans une stratégie de médias sociaux efficace."
                            }
                        ]
                    }
                ],
