                        "zh": [
                            {
                                "target_lang_word": "全部",
                                "target_lang_sense_clarification": "指代整体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc811da-1e6a-3cf2-b9a2-37bfdc4f49a1",
                    "sense_definition": "An uncastrated male horse; a stallion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable owner keeps an <w>entire</w> in a separate paddock for safety.",
                            "target_lang_translations": {
                                "ru": "Владелец конюшни держит <w>жеребца</w> в отдельном загоне ради безопасности.",
                                "zh": "马厩主人为了安全起见，将一匹<w>种马</w>关在单独的围场里。"
                            }
                        },
                        {
                            "text": "Handling an <w>entire</w> requires more experience than riding a gelding.",
                            "target_lang_translations": {
                                "ru": "Обращение с <w>жеребцом</w> требует большего опыта, чем езда на мерине.",
                                "zh": "驾驭<w>种马</w>比骑阉马需要更多的经验。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "animal husbandry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Некастрированный самец лошади; жеребец.",
                        "zh": "未阉割的雄性马；种马。"
