                "senses": [
                    {
                        "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                        "entry_id": "b27dcc0b-ed47-34a6-9d49-1a2c5800e449",
                        "glosses": [
                            "vorwiegend in Europa verbreitete Art des Steckers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e5db30-1b17-4f42-8a52-6b8550e03efc",
                                "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                                "text": "„Einen Adapter benötigen Sie nur bei einem Schuko-Stecker (geerdet), beim Flachstecker ist der Adapter nicht nötig.“"
                            },
                            {
                                "example_id": "aaf7caf3-7228-4c79-bf2c-c02247f229d1",
                                "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                                "text": "„Auf der nächsten Seite zeigen wir Ihnen, wie Sie Schuko-Stecker wechseln und außerdem, wie Sie Kabel löten.“"
                            },
                            {
                                "example_id": "d37a27a3-ba6e-4cf7-afb4-e9f730656189",
                                "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                                "text": "„Wenn Sie einen Schuko-Stecker selbst anschließen möchten, benötigen Sie hierfür etwas Fingerspitzengefühl.“"
                            },
                            {
                                "example_id": "a6bb7ae1-9f28-4d33-a7a2-bc8182bf67e9",
                                "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                                "text": "„Während der Schuko-Stecker den Strom über zwei runde Pole leitet und den aus Sicherheitsgründen gebotenen Erdungskontakt über seitlich eingelassene Metallfedern herstellt, hat der Inter-Stecker drei flache Kontaktstäbe.“"
                            },
                            {
                                "example_id": "34fed859-549a-4c4a-989c-539140328adb",
                                "sense_id": "d2a01906-a8ad-3b2a-bc90-62b4949268e7",
                                "text": "„Rein theoretisch ließe sich so eine Anlage per einfachem Schuko-Stecker an den privaten Stromkreis anschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
