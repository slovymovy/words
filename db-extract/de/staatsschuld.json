                ],
                "translations": [
                    {
                        "translation_id": "6651c07f-26ac-44f6-84fa-45962cf2e310",
                        "source_entry_id": "e6abf646-4d1b-3d29-b654-530aae4ec1c2",
                        "source_sense_id": "c4b065f0-455f-3f39-a906-63e6c32fca08",
                        "source_sense_description": "meist Plural: geschuldete Verbindlichkeiten eines Staates gegenüber Gläubigern",
                        "target_lang_word": "national debt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "national debt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a541eafb-af8f-34a9-85bc-10a320068476",
                                        "entry_id": "6c903780-a035-3fc4-955a-e438d662256e",
                                        "glosses": [
                                            "Any money owed by the government of a nation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e3dfa0-da8e-4fbf-816a-ad72becbd4bb",
                                                "sense_id": "a541eafb-af8f-34a9-85bc-10a320068476",
                                                "text": "The only reference to the national debt - the reduction of which was once a top priority for Republicans of all stripes - was a passing mention of the subject during a litany of Barack Obama's economic failings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dc314b6-77ac-4b26-83b7-e31f6102a90d",
                        "source_entry_id": "e6abf646-4d1b-3d29-b654-530aae4ec1c2",
                        "source_sense_id": "c4b065f0-455f-3f39-a906-63e6c32fca08",
                        "source_sense_description": "meist Plural: geschuldete Verbindlichkeiten eines Staates gegenüber Gläubigern",
                        "target_lang_word": "dette souveraine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dette souveraine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33291533-e9e1-302b-8a79-8ea6154c2846",
                                        "entry_id": "71ef1354-4035-3508-a1bf-5f5a0585a88f",
                                        "glosses": [
                                            "Dette émise ou garantie par un émetteur souverain (un État généralement ou parfois une banque centrale)."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "968742b8-7916-4f6e-8041-277049f2af07",
                                                "sense_id": "33291533-e9e1-302b-8a79-8ea6154c2846",
                                                "text": "Ce serait un comble que pour sortir de la crise financière, on oriente l’épargne vers les dettes souveraines. Je préfère qu’on stimule l’économie par la production."
                                            },
                                            {
                                                "example_id": "163f89e0-df32-4b13-8918-1831d96ab330",
                                                "sense_id": "33291533-e9e1-302b-8a79-8ea6154c2846",
                                                "text": "Il faut dire qu’une grande partie des réserves de change de l’impérialisme chinois ont été investies dans la dette souveraine de pays impérialistes en déclin."
                                            },
                                            {
                                                "example_id": "d38c1280-0c96-4d44-9bfb-ae4c03f26ef3",
                                                "sense_id": "33291533-e9e1-302b-8a79-8ea6154c2846",
                                                "text": "Ainsi, certains économistes voient dans une reprise de l’inflation une solution pour régler le problème des dettes souveraines."
                                            },
                                            {
                                                "example_id": "954d0490-96e3-4cde-977d-d561b6c0f69e",
                                                "sense_id": "33291533-e9e1-302b-8a79-8ea6154c2846",
                                                "text": "Comme toutes les firmes de Wall Street, les fonds vautours font appel à des cabinets de relations publiques et à des lobbies pour contrer les régulations contraires à leurs intérêts financiers. L'année dernière, une législation très contraignante contre la spéculation sur les dettes souveraines en défaut avait échoué à être votée, grâce à l'opposition de tout le secteur financier américain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
