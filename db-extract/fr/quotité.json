                "senses": [
                    {
                        "sense_id": "9df0889c-7d42-3dc3-98fd-9e6dfcf82fd7",
                        "entry_id": "6b20fd74-992e-3c2d-a1d0-efb343b0cbdc",
                        "glosses": [
                            "Montant proportionnel dans un partage, une répartition, une quote-part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47722e22-0b0a-48d9-94cd-285e72b1f223",
                                "sense_id": "9df0889c-7d42-3dc3-98fd-9e6dfcf82fd7",
                                "text": "Les calculs de ces dépenses peuvent donc être régulièrement établis sur la quotité de cette reproduction, même abstraction faite de tout commerce extérieur […]."
                            },
                            {
                                "example_id": "d55f0957-792b-446c-8f9e-681512cdab3f",
                                "sense_id": "9df0889c-7d42-3dc3-98fd-9e6dfcf82fd7",
                                "text": "Disons dès à présent que cette cause est la présence […] de ces métaux , dont une quotité presque infinitésimale suffit pour rendre le fer, et à plus forte raison l'acier fondu, inforgeable et insoudable."
                            },
                            {
                                "example_id": "03a2287e-d864-4205-b009-75555a381dce",
                                "sense_id": "9df0889c-7d42-3dc3-98fd-9e6dfcf82fd7",
                                "text": "Le légataire d’une quotité est celui auquel un défunt a légué un tiers, un quart, un dixième, en un mot une partie aliquote de sa succession."
                            }
                        ]
                    },
                    {
                        "sense_id": "6615c756-0491-3e67-a27f-2e123b02f1f7",
                        "entry_id": "6b20fd74-992e-3c2d-a1d0-efb343b0cbdc",
                        "glosses": [
                            "Quantité déterminée d'unité d'un titre considérée comme étant normale pour une opération boursière."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
