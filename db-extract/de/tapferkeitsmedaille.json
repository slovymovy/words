                        "examples": [
                            {
                                "example_id": "08c73b84-d686-46d3-862d-50aeabdff8ba",
                                "sense_id": "58b5c424-89d3-3254-8a94-928f1aeda432",
                                "text": "In Australien rettet ein Schäferhund sein Herrchen vor Einbrechern und erhält dafür eine Tapferkeitsmedaille."
                            },
                            {
                                "example_id": "4372ad1b-f69d-4346-b324-dc9c51ee4904",
                                "sense_id": "58b5c424-89d3-3254-8a94-928f1aeda432",
                                "text": "Wenn ich wüsste, ich würde bei einem riskanten Einsatz auch eine Tapferkeitsmedaille bekommen, ich würde mich fürs Militär entscheiden."
                            },
                            {
                                "example_id": "37302456-c3b4-471d-bbfb-8acf1018e842",
                                "sense_id": "58b5c424-89d3-3254-8a94-928f1aeda432",
                                "text": "„Die Burgwache besteht nicht aus Veteranen, sondern aus solchen Unteroffizieren und Gemeinen, welche die Tapferkeitsmedaille erworben haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
