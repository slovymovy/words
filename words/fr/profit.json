                        "tirer profit de"
                    ]
                },
                {
                    "sense_id": "10f04339-28e3-3a8f-b6ce-78588f687267",
                    "sense_definition": "En économie, part de la valeur ajoutée ou excédent des recettes sur les dépenses qui rémunère le capital d'une entreprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gain_financier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a réinvesti une grande partie de son <w>profit</w> annuel dans la recherche."
                        },
                        {
                            "text": "Les actionnaires espèrent une hausse du <w>profit</w> net après la restructuration de la société."
                        }
                    ],
                    "synonyms": [
                        "bénéfice",
                        "plus-value"
                    ],
                    "antonyms": [
                        "déficit",
                        "perte"
                    ],
                    "common_phrases": [
