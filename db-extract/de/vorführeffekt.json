                "senses": [
                    {
                        "sense_id": "c44fb06e-bb37-3b40-b155-5b9b0a4f68f4",
                        "entry_id": "73d56f52-998a-3bf5-9a09-812d630dae5e",
                        "glosses": [
                            "die häufig gemachte Erfahrung, dass etwas, das sonst mit hoher Wahrscheinlichkeit eintritt, gerade dann nicht eintritt, wenn man es jemandem demonstrieren will, oder dass genau das nicht eintritt, was man zeigen will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0314f12a-f171-4f72-9dca-4f7728f655c0",
                                "sense_id": "c44fb06e-bb37-3b40-b155-5b9b0a4f68f4",
                                "text": "Wenn man ein defektes Auto zur Werkstatt fährt und es dann dort einwandfrei funktioniert, ist das der Vorführeffekt."
                            }
                        ],
