                    ],
                    "synonyms": [
                        "appendant",
                        "annexed"
                    ],
                    "common_phrases": [
                        "supplemental notes",
                        "supplemental pages"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функционирующий как приложение или добавленная часть в конце документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "приложенный к основному тексту"
                            },
                            {
                                "target_lang_word": "сопутствующий",
                                "target_lang_sense_clarification": "прилагаемый к документу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26e08b8a-1df4-39a4-bf2d-647dffeecf27",
                    "sense_definition": "An item or element that is added to something else to enhance or complete it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new evidence served as a <w>supplemental</w> to the existing case file.",
                            "target_lang_translations": {
                                "ru": "Новые улики послужили <w>дополнением</w> к существующему делу."
                            }
                        },
                        {
                            "text": "He used various <w>supplementals</w> to ensure his research was as thorough as possible.",
                            "target_lang_translations": {
                                "ru": "Он использовал различные <w>дополнения</w>, чтобы его исследование было как можно более тщательным."
                            }
