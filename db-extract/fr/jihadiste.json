                ],
                "senses": [
                    {
                        "sense_id": "62cdf531-7399-35a6-a734-d0f50f9971bb",
                        "entry_id": "65c662e7-e0ef-3b0c-876a-67131ea43c85",
                        "glosses": [
                            "Qui fait le jihad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65895398-7d03-401a-899c-eee83f5f6cec",
                                "sense_id": "62cdf531-7399-35a6-a734-d0f50f9971bb",
                                "text": "« Les faits sont avérés, l’accusation est établie, vérifiée et prouvée», a affirmé le procureur précisant qu’il s’agit de personnes «qui ont avoué avoir adhéré au courant salafiste, jihadiste» et «aux idées d’Al-Qaida au Maghreb, après leurs séjours en 2005 en Irak, en Syrie, en Tchéchenie, au Mali, en Algérie et en Mauritanie »."
                            },
                            {
                                "example_id": "6aef2ddf-be54-4b64-8ab0-10ae5e043405",
                                "sense_id": "62cdf531-7399-35a6-a734-d0f50f9971bb",
                                "text": "En Europe, plusieurs jeunes défavorisés rejoignent des groupes jihadistes pour des raisons purement économiques ou par manque de perspectives d'avenir dans leur pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d49ea791-de63-40a9-9a85-6d22143286b0",
                        "source_entry_id": "65c662e7-e0ef-3b0c-876a-67131ea43c85",
                        "source_sense_id": "62cdf531-7399-35a6-a734-d0f50f9971bb",
