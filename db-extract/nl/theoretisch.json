                                "target_senses": [
                                    {
                                        "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                        "entry_id": "d1a5526b-58bc-3f02-ac75-2bf15a61be7d",
                                        "glosses": [
                                            "auf eine Theorie bezogen, in der Art und Weise einer Theorie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bde18f6-8939-4253-9ac2-687281cc25cc",
                                                "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                                "text": "„Damit soll theoretisch bewiesen worden sein, dass diese Technologie als Basis für noch leistungsfähigere Kommunikationsnetze einsetzbar ist.“"
                                            },
                                            {
                                                "example_id": "294d6a1b-2f51-4ab6-9a3c-a1848ffb4ed3",
                                                "sense_id": "502710cd-04ae-3301-9f84-4180fd7344a5",
                                                "text": "„Theoretischer geht es bei der Plattdeutsch-Prüfung und der Ostfrieslandkunde zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f9e36d9-1f97-42ff-afdf-e15914a62965",
                        "source_entry_id": "0ffbc849-8342-35ab-9b7d-bf73a02af4dc",
                        "source_sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                        "source_sense_description": "wat niet perse in de werkelijkheid voorkomt, m.b.t. feiten en wetten berustende ...",
                        "target_lang_word": "theoretical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theoretical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf70a4d0-15ba-3176-8854-08f78afc5cd5",
                                        "entry_id": "3540824c-9409-34b2-b3c0-d806a57adae2",
                                        "glosses": [
                                            "Of or relating to theory; abstract; not empirical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5cc575-a5b7-4289-ba6e-a25fde22f93c",
                                                "sense_id": "cf70a4d0-15ba-3176-8854-08f78afc5cd5",
                                                "text": "We may look upon this figure as representing in section a theoretical wing-form, or aerofoil"
                                            },
                                            {
                                                "example_id": "47cdd960-5259-432c-bb0c-2c3c1206c9a6",
                                                "sense_id": "cf70a4d0-15ba-3176-8854-08f78afc5cd5",
                                                "text": "Which makes the concept known as Rods From God the ultimate form of kinetic weaponry. This theoretical weapon would drop telephone pole sized rods of dense tungsten from a satellite in orbit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94a496d1-b01b-433e-80ff-977dc975d43a",
                        "source_entry_id": "0ffbc849-8342-35ab-9b7d-bf73a02af4dc",
                        "source_sense_id": "9c5f007a-fcea-3abb-9edf-fd0254b14cf6",
                        "source_sense_description": "wat niet perse in de werkelijkheid voorkomt, m.b.t. feiten en wetten berustende ...",
                        "target_lang_word": "théorique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0915f8-187b-3c62-a221-5cd5b13f3f4b",
                                        "entry_id": "3475b9f4-ca70-30a1-b07d-a39393802b7b",
                                        "glosses": [
                                            "Qui appartient à la théorie ; qui concerne la théorie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f11582d-2238-4129-b5c6-e2a96e637a2c",
                                                "sense_id": "6a0915f8-187b-3c62-a221-5cd5b13f3f4b",
                                                "text": "La fonction du philosophe consiste exclusivement dans la profanation des idées. Aucune violence n'égale par ses effets la violence théorique. Plus tard, l'action vient..."
                                            },
                                            {
                                                "example_id": "72966ff3-d5d5-4742-9f2a-640a67d3479f",
                                                "sense_id": "6a0915f8-187b-3c62-a221-5cd5b13f3f4b",
                                                "text": "L'opinion de Pavlov sur le rôle décisif du milieu ambiant […], se trouve ainsi en concordance parfaite avec les thèses théoriques de Mitchourine, avec les principes du darwinisme soviétique créateur développé actuellement par T. Lyssenko."
                                            },
                                            {
                                                "example_id": "6047a94c-7ea6-4afb-83a9-9ea588a818b3",
                                                "sense_id": "6a0915f8-187b-3c62-a221-5cd5b13f3f4b",
                                                "text": "La publication, en 1687, de Principia Mathematica, l’œuvre magistrale d’Isaac Newton révélant les lois de la gravitation universelle, a alors fourni de solides assises théoriques pour la poursuite de l’étude de l’Univers."
                                            },
                                            {
                                                "example_id": "5d09a2a9-c2f8-4c0e-b962-9c261bb2e5ab",
                                                "sense_id": "6a0915f8-187b-3c62-a221-5cd5b13f3f4b",
                                                "text": "Si le principe de cette « sismologie stellaire », ou astérosismologie, est simple, sa mise en œuvre est un véritable défi, tant en termes d'observations que de modélisation théorique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1b7554-be51-36be-94c6-a7d72c2b4761",
                                        "entry_id": "3475b9f4-ca70-30a1-b07d-a39393802b7b",
                                        "glosses": [
                                            "Qui ne se concrétise pas, qui n'entre pas dans la réalité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d69fcee1-73a2-44d9-b809-a28442baade8",
                                                "sense_id": "1a1b7554-be51-36be-94c6-a7d72c2b4761",
                                                "text": "Le matin, par exemple, ou même l'avant-veille dans l'avion, si elle essayait de voir Ferdinand, elle n'obtenait qu'une image floue, plus théorique que vraiment vivante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "théorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "572ad276-aeef-372e-8ed1-ddb01ae30d0a",
                                        "entry_id": "d5c631cf-199c-3be3-8b69-a3c49cd171cb",
                                        "glosses": [
                                            "Ensemble des connaissances abstraites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b35f5801-5288-4ff4-aab1-358da2b1bb27",
                                                "sense_id": "572ad276-aeef-372e-8ed1-ddb01ae30d0a",
                                                "text": "Le théorique se défend par l’étude, l’enseignement, la recherche. Il est défendu chaque fois que nous faisons l’effort d’apprendre un dispositif de pensée, facile ou difficile, d’enseigner les éléments rendant capables d’affronter de tels contenus, voire de travailler dans la foulée des conceptions transmises pour ajouter un segment inédit de conceptualité organisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b71aa3-83bc-38e0-b114-7099e50a28e7",
                                        "entry_id": "d5c631cf-199c-3be3-8b69-a3c49cd171cb",
                                        "glosses": [
                                            "Examen qui englobe les questions de théorie, par opposition à la partie pratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce7ecf9-6367-4efc-b0ac-361eea7da0ec",
                                                "sense_id": "60b71aa3-83bc-38e0-b114-7099e50a28e7",
                                                "text": "Les 14 centres wallons avaient enregistré 181.708 tentatives au théorique pour un taux général de réussite de 38,32 %."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
