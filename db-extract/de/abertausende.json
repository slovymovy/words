                                "example_id": "a13ad24e-2f84-483c-b52a-b6ac04ee5080",
                                "sense_id": "637ff6a5-3e69-326d-8730-c2f78e82b8b1",
                                "text": "Abertausende sind auf der Flucht."
                            },
                            {
                                "example_id": "ad8d538e-3cb2-4c0b-8956-dcb835cbbf7f",
                                "sense_id": "637ff6a5-3e69-326d-8730-c2f78e82b8b1",
                                "text": "Im Blut vermischen sich die wenigen Moleküle eines bestimmten Hormons mit Abertausenden von anderen Molekülen."
                            },
                            {
                                "example_id": "c4c6ce88-7368-425f-a4cf-4fd4473ea332",
                                "sense_id": "637ff6a5-3e69-326d-8730-c2f78e82b8b1",
                                "text": "Aber über einen letzten Punkt in sich gelingt ihm der Sprung schwer; tausende, die ihn wagen wollten, hat man zu den Irren getan, abertausende sind dabei um ihr Leben gekommen; denn es bleibt in diesem Punkt immer der Ernst bewahrt."
                            }
                        ],
