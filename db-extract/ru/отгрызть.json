                        "translation_id": "6a798786-920b-402e-bcfe-d9c7d0e31460",
                        "source_entry_id": "e769727c-c3da-3343-ba60-6ee3276a6d36",
                        "source_sense_id": "2bb4e3d4-57de-35c4-a1b5-965890e769d9",
                        "target_lang_word": "bite off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bite off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca11ca3-57b6-353a-a416-f8ba72a14ac1",
                                        "entry_id": "2f9d833e-984b-340f-90bc-9b7b14552517",
                                        "glosses": [
                                            "To bite so hard as to remove something from its source."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffce5ab-914f-4d0d-90b9-7982dadc05d1",
                                                "sense_id": "0ca11ca3-57b6-353a-a416-f8ba72a14ac1",
                                                "text": "Then she cocked her head back, opened her mouth, and bit off the trout's top half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e35d35-7f86-3e30-9a32-d4d38195720d",
                                        "entry_id": "2f9d833e-984b-340f-90bc-9b7b14552517",
                                        "glosses": [
                                            "To accept or commit oneself to a task, project, notion, or responsibility, especially one which presents challenges."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0343dbe2-0e22-462b-95bd-445a538ed9d2",
                                                "sense_id": "57e35d35-7f86-3e30-9a32-d4d38195720d",
                                                "text": "In between what she called the \"goody-good\" or \"frilly-knickers\" Hollywood films, she bit off some more demanding parts back home."
                                            },
                                            {
                                                "example_id": "b1c5b53b-a247-4a2c-bb71-4282185d5b82",
                                                "sense_id": "57e35d35-7f86-3e30-9a32-d4d38195720d",
                                                "text": "\"And for the next couple of years, with Nokia having bitten off so much, Vuorilehto is the right guy for the task they face.\""
                                            },
                                            {
                                                "example_id": "833589ee-5e8d-474c-9d38-db1e1f6bcec7",
                                                "sense_id": "57e35d35-7f86-3e30-9a32-d4d38195720d",
                                                "text": "We have set a plan that we believe everyone at News Corp. will bite off on."
                                            },
                                            {
                                                "example_id": "8f9a5c60-547b-438e-be3e-79fa0d8172f5",
                                                "sense_id": "57e35d35-7f86-3e30-9a32-d4d38195720d",
                                                "text": "They think it's politically too much for the government to bite off right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a649c2-d954-3751-9fbb-f8ba49fd1a53",
                                        "entry_id": "2f9d833e-984b-340f-90bc-9b7b14552517",
                                        "glosses": [
                                            "To acquire, especially in an abrupt or forceful manner."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a62336b-fd97-44e0-acf4-5ce5c7b32ff6",
                                                "sense_id": "36a649c2-d954-3751-9fbb-f8ba49fd1a53",
                                                "text": "To thicken that buffer zone Britain joined other powers in biting off larger chunks of China."
                                            },
                                            {
                                                "example_id": "52ac003c-a434-4bbe-8d4a-286195e4dcb7",
                                                "sense_id": "36a649c2-d954-3751-9fbb-f8ba49fd1a53",
                                                "text": "For R.I.M. to bite off just a tiny piece of that market would help it grow considerably."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
