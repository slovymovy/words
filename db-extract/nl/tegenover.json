                "senses": [
                    {
                        "sense_id": "d36d5221-4568-3837-993e-7e3d1a519418",
                        "entry_id": "651e6f44-2c50-34b6-9bea-d7a86ab7713b",
                        "glosses": [
                            "aan de overzijde van"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf28b84-0bc4-4dd1-bb1b-2904942b8714",
                                "sense_id": "d36d5221-4568-3837-993e-7e3d1a519418",
                                "text": "Tegenover de supermarkt staat een bankgebouw."
                            },
                            {
                                "example_id": "524f66a7-e4b1-4386-ab50-967224adbdaf",
                                "sense_id": "d36d5221-4568-3837-993e-7e3d1a519418",
                                "text": "Dit alles zou ik geneigd zijn positief te beoordelen. Daar staat echter tegenover dat deze vaas met plastic bloemen reden geeft tot zorgen met betrekking tot de affiniteit die de nieuwe eigenaar heeft met onze tradities. Maar ik wil u niet met mijn bekommeringen vervelen. We zijn er. Dit is kamer 17, de suite die ik voor u op orde heb laten brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "baed3846-6886-38da-8579-bbb3f5ae385e",
                        "entry_id": "651e6f44-2c50-34b6-9bea-d7a86ab7713b",
                        "glosses": [
                            "in de relatie met"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8019bbc5-d21c-4042-b86b-262c7d06ddbc",
                                "sense_id": "baed3846-6886-38da-8579-bbb3f5ae385e",
                                "text": "Ik voelde me een beetje opgelaten tegenover de medewerkers van het postkantoor."
                            },
                            {
                                "example_id": "5c8079d3-1def-4a86-89d8-f211f12c17d8",
                                "sense_id": "baed3846-6886-38da-8579-bbb3f5ae385e",
                                "text": "Ik schaamde me niet ten opzichte van Lauren en al helemaal niet tegenover Casper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e081c12f-9bf0-4347-8c16-1801f7af3921",
