    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "320c7e95-7a79-3fe2-baff-c628c1da1f3d",
                "word": "PowerPoint",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e94c0203-8e1e-3458-83e3-a7da3b4140a2",
                        "entry_id": "320c7e95-7a79-3fe2-baff-c628c1da1f3d",
                        "glosses": [
                            "A software package from Microsoft used to make slideshow presentations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e053ae8-b70d-44c6-abba-1859326d2758",
                                "sense_id": "e94c0203-8e1e-3458-83e3-a7da3b4140a2",
                                "text": "Proficiency in PowerPoint continues to be required for almost every office job."
                            },
                            {
                                "example_id": "052a5ece-9a3b-4a65-a4fe-1dc9296d9f51",
                                "sense_id": "e94c0203-8e1e-3458-83e3-a7da3b4140a2",
                                "text": "Can I be candid? I think I am on this group because none of you can do PowerPoint. I am literally going to draw some rectangle shapes for the pillars. We won’t be having feathers or whatever. And there’s a limit to how many pillars will fit on a single slide."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "519d036d-e022-3813-ba75-26c0671b5ac6",
                "word": "PowerPoint",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8cf61e33-224a-47ea-80d4-a994864a2410",
                        "entry_id": "519d036d-e022-3813-ba75-26c0671b5ac6",
                        "tags": [
                            "plural"
                        ],
                        "form": "PowerPoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                        "entry_id": "519d036d-e022-3813-ba75-26c0671b5ac6",
                        "glosses": [
                            "An electronic slide presentation created using the program Microsoft PowerPoint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae48cfb-3f1d-4d12-a16e-8ccc3e346167",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "PowerPoint presentation"
                            },
                            {
                                "example_id": "bb13dffc-815b-40f5-ad51-d59a8567e5c8",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "Sitting through his PowerPoints is a dull, but necessary, requisite for the job."
                            },
                            {
                                "example_id": "f1f7436d-2fe0-4d4a-8aaa-7f5e737b5fbe",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "The PowerPoint is the summation of Rove's thinking about the 2006 elections, in which Republicans lost 30 seats in the House and six in the Senate"
                            },
                            {
                                "example_id": "89fd0465-5041-411a-8c85-d746984061a9",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "Alas, our PowerPoint Generation gravitates to bullet points and two-dimensional bar charts, even as we stumble our way through this multidimensional universe."
                            },
                            {
                                "example_id": "622fe01b-f3f9-47e7-89cb-e15653146091",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "Hine showed many of his paintings and pictures in a PowerPoint."
                            },
                            {
                                "example_id": "b7fa43e9-4a26-4c92-969f-fab27831faa8",
                                "sense_id": "324bc853-6863-3993-ac42-2e4a699ce09f",
                                "text": "Through the new LEAD21 program, students research and put together a class presentation that will involve creating a PowerPoint and giving a speech based on their particular inquiry topic."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e71bd3d-a316-3496-a9b4-2c15c8400609",
                        "entry_id": "519d036d-e022-3813-ba75-26c0671b5ac6",
                        "glosses": [
                            "Any electronic slide presentation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a362e7e0-d6e6-48c2-9ccd-bd04faa6653c",
                                "sense_id": "7e71bd3d-a316-3496-a9b4-2c15c8400609",
                                "text": "She's asked James to prepare a PowerPoint for tomorrow's lesson."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "56cb8b2b-3c0d-309e-902b-797467d9bb75",
