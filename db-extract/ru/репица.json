                ],
                "senses": [
                    {
                        "sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                        "entry_id": "3ab96762-bfde-33cc-bf2e-5cc3912ba957",
                        "glosses": [
                            "анат. хвостовой отросток у позвоночных животных, покрытый шерстью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feeb61a2-e30f-421c-9a5e-ee56b8f36be0",
                                "sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                                "text": "Помогите его привязать к репице моей лошади."
                            },
                            {
                                "example_id": "7f7de538-4e84-4cb0-82a9-d6b7383bf57e",
                                "sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                                "text": "Стал… помахивать своим жидким пегим хвостом с оголенной репицей."
                            },
                            {
                                "example_id": "29f3ed7f-84a5-4945-a2ec-948b666729c1",
                                "sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                                "text": "У него была единственная обязанность ― оживлять лошадь игрой хвоста, к репице которого изнутри была прикреплена деревянная ручка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef4377e9-1fac-4e26-8b4b-4abe7e9d0e42",
                        "source_entry_id": "3ab96762-bfde-33cc-bf2e-5cc3912ba957",
                        "source_sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                        "target_lang_word": "tailhead",
