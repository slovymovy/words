                        "glosses": [
                            "Bewegungen, Abwechslung von verschiedenen Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59668d5-1e4b-4291-83b2-0b8e98c6216b",
                                "sense_id": "58f0ba0c-b1ba-354d-ac31-797f9f19a6c2",
                                "text": "Das Farbenspiel bei Sonnenuntergang fasziniert mich immer aufs Neue."
                            },
                            {
                                "example_id": "8b0e58ca-c16c-4bd8-9f53-9cf36c338a2a",
                                "sense_id": "58f0ba0c-b1ba-354d-ac31-797f9f19a6c2",
                                "text": "„Quell aller Farben ist die Sonne. Ihr Licht ermöglicht erst das Farbenspiel der Welt.“"
                            }
                        ],
