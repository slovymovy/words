{
    "word_family": [
        "obchodzić",
        "obchód",
        "obchodny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58b81bca-e024-3078-ae46-7df68c3fede2",
                    "sense_definition": "Gospodarstwo wiejskie wraz z budynkami gospodarczymi i podwórzem.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gospodarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zadbane <w>obejście</w> świadczy o pracowitości gospodarza.",
                            "target_lang_translations": {
                                "ru": "Ухоженная <w>усадьба</w> свидетельствует о трудолюбии хозяина."
                            }
                        },
                        {
                            "text": "Dwa <w>obejścia</w> ode mnie budują się państwo Ptaszkowie.",
                            "target_lang_translations": {
                                "ru": "Через два <w>двора</w> от меня строятся Пташки."
                            }
                        }
                    ],
                    "synonyms": [
                        "zagroda"
                    ],
                    "common_phrases": [
                        "zadbane obejście"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельская усадьба, включающая жилой дом, хозяйственные постройки и двор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усадьба",
                                "target_lang_sense_clarification": "комплекс жилых и хозяйственных построек"
                            },
                            {
                                "target_lang_word": "двор",
                                "target_lang_sense_clarification": "придомовая территория с постройками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "802a27d4-0ddc-30f4-8830-526b0980c000",
                    "sense_definition": "Droga pozwalająca ominąć centrum miasta lub przeszkodę.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowa <w>obejście</w> znacznie skróci czas przejazdu przez miasto.",
                            "target_lang_translations": {
                                "ru": "Новая <w>объездная</w> дорога значительно сократит время проезда через город."
                            }
                        },
                        {
                            "text": "Kierowcy ciężarówek muszą korzystać z <w>obejścia</w>.",
                            "target_lang_translations": {
                                "ru": "Водители грузовиков должны пользоваться <w>объездом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "budowa obejścia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дорога, позволяющая объехать центр города или препятствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объезд",
                                "target_lang_sense_clarification": "дорога в обход основного пути"
                            },
                            {
                                "target_lang_word": "объездная дорога",
                                "target_lang_sense_clarification": "специально построенная трасса вокруг города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "431095ff-ce0a-347d-a1aa-e5df5f4ddf64",
                    "sense_definition": "Sposób na rozwiązanie problemu lub uniknięcie trudności.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rozwiązanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znaleźliśmy <w>obejście</w> tego błędu w oprogramowaniu.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>обходной</w> путь для этой ошибки в программном обеспечении."
                            }
                        },
                        {
                            "text": "To <w>obejście</w> problemu jest tylko tymczasowe.",
                            "target_lang_translations": {
                                "ru": "Это <w>решение</w> проблемы лишь временное."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprytne obejście"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ решения проблемы или обхода трудностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обходной путь",
                                "target_lang_sense_clarification": "непрямое решение проблемы"
                            },
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "способ избежать ограничений или ошибок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c170f0c-2d3e-3334-96e5-6082008ce96a",
                    "sense_definition": "Korytarz lub przejście wokół wnętrza budowli, np. kościoła.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architektura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wąskie <w>obejście</w> prowadzi wokół ołtarza głównego.",
                            "target_lang_translations": {
                                "ru": "Узкий <w>обход</w> ведет вокруг главного алтаря."
                            }
                        },
                        {
                            "text": "Gotycka katedra posiada kamienne <w>obejście</w>.",
                            "target_lang_translations": {
                                "ru": "Готический собор имеет каменный <w>деамбулаторий</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коридор или проход вокруг внутренней части здания, например, храма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "архитектурный проход вокруг алтаря"
                            },
                            {
                                "target_lang_word": "деамбулаторий",
                                "target_lang_sense_clarification": "специальный термин для обхода в храме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5d53161-9091-3f28-9c6b-6712b21d4b9e",
                    "sense_definition": "Rzeczownik odczasownikowy od czasownika <w>obejść</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybkie <w>obejście</w> terenu pozwoliło sprawdzić wszystkie punkty.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>обход</w> территории позволил проверить все пункты."
                            }
                        },
                        {
                            "text": "To <w>obejście</w> przepisów jest nielegalne.",
                            "target_lang_translations": {
                                "ru": "Этот <w>обход</w> правил является незаконным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rzeczownik odczasownikowy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по глаголу 'обойти' (обход территории или нарушение правил)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "процесс осмотра территории"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "в контексте обхода правил или закона"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}