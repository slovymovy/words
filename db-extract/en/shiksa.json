                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c06b82c5-7a77-4284-8f5b-7e8b203a22b7",
                        "source_entry_id": "0db82092-1153-3273-b232-93e385197162",
                        "source_sense_description": "non-Jewish girl",
                        "target_lang_word": "Schickse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schickse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beef3a86-17be-397d-84de-ecf970ef5803",
                                        "entry_id": "640b8d5d-8d5b-30d5-8ef2-a0f6d29e89dc",
                                        "glosses": [
                                            "(aus jüdischer Sicht) eine weibliche Person nichtjüdischen Glaubens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c614068-a006-4ecc-a2ca-ee0bf59dcecf",
                                                "sense_id": "beef3a86-17be-397d-84de-ecf970ef5803",
                                                "text": "„Ich habe aufgehört zu arbeiten und widmete mich nur noch ihm. Ich tat es, ohne zu wissen, ob er mich jemals heiraten würde: eine Schickse, eine Nichtjüdin aus ärmlichen Verhältnissen.“"
                                            },
                                            {
                                                "example_id": "883b8641-5cfc-4266-9a0f-acefa72a7754",
                                                "sense_id": "beef3a86-17be-397d-84de-ecf970ef5803",
                                                "text": "„Als Fünfzehnjähriger trieb er sich mit einer jungen Schickse namens Wanda herum, die Ställe ausfegte.“"
                                            },
                                            {
                                                "example_id": "b0370b43-c3b4-47db-a6d1-89e0ffb6f80d",
                                                "sense_id": "beef3a86-17be-397d-84de-ecf970ef5803",
                                                "text": "„Ich wollte Alexander Silver Gelegenheit geben, seiner Aufregung im Familienkreise Herr zu werden; schließlich betrachtete er sich doch als Kavalier, für den auch eine Schickse als Frau galt, die Rücksicht verlangen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a293659-60c2-37fc-b176-fb4af3790601",
                                        "entry_id": "640b8d5d-8d5b-30d5-8ef2-a0f6d29e89dc",
                                        "glosses": [
                                            "weibliche Person, die zuweilen als einfältig und lästig empfunden wird und der man nachsagt, sie sei leichtlebig"
                                        ],
                                        "tags": [
                                            "salopp abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a41520f-00b8-47bf-828f-f218c13920f6",
                                                "sense_id": "6a293659-60c2-37fc-b176-fb4af3790601",
                                                "text": "„Die Großmutter hätte gern, dass diese aufgedonnerten Schicksen gleich mal die Hühner rupfen.“"
                                            },
                                            {
                                                "example_id": "cca60b0d-cf79-451a-a041-7b770a38327e",
                                                "sense_id": "6a293659-60c2-37fc-b176-fb4af3790601",
                                                "text": "„Er fängt sich was mit einer Schickse an aus einem Lokal; ’nem Büfettfräulein, was weiß ich!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b8cb925-2180-3231-9abf-70cc6bce635b",
                                        "entry_id": "640b8d5d-8d5b-30d5-8ef2-a0f6d29e89dc",
                                        "glosses": [
                                            "Frau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318af774-7738-454f-94e1-8e93ef2647de",
                                                "sense_id": "2b8cb925-2180-3231-9abf-70cc6bce635b",
                                                "text": "„Du hast deine Schickse und du hast mich, aber kaum taucht irgend ’ne Schlampe aus Europa auf, läufst du weg von mir, um dich mit ihr zu treffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "abc0e884-ff1c-3bf9-bd89-28b113e527b3",
                                        "entry_id": "640b8d5d-8d5b-30d5-8ef2-a0f6d29e89dc",
                                        "glosses": [
                                            "Prostituierte"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4be58b-2c3e-4b49-828c-caa3fd4cdcd9",
                                                "sense_id": "abc0e884-ff1c-3bf9-bd89-28b113e527b3",
                                                "text": "„Er war froh, daß wenigstens die Jette entkommen zu sein schien, und folgte den Polizisten, die ihn vorwärts schoben, nachdem sie an die Kunden und Schicksen noch einige Vermahnungen gerichtet hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f6c3230c-c244-30f9-a9e1-a9bbe6556e70",
                                        "entry_id": "640b8d5d-8d5b-30d5-8ef2-a0f6d29e89dc",
                                        "glosses": [
                                            "junges Mädchen; geliebtes Mädchen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb83e15d-ec73-4c3a-8773-03ef03274f36",
                                                "sense_id": "f6c3230c-c244-30f9-a9e1-a9bbe6556e70",
                                                "text": "„Eine ganze Mandel »Schicksen« waren mit – so nannte er die Mädchen – da würde sich’s schon leben lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
