                        "entry_id": "ba4aadc2-4c8c-37e0-bf7d-e9c7e7faeab1",
                        "glosses": [
                            "een onder de voet te binden stel wieltjes waarop men zich schaatsend voortbewegen kan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b05a4d-865b-4b88-b3da-e5d51544ae50",
                                "sense_id": "d15b09a3-918a-39d3-8355-72c93f98bb32",
                                "text": "Hij deed zijn rolschaatsjes aan en ging met zijn vriendjes hockey spelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31facf30-981d-48cf-9fe1-a34f55c87d67",
