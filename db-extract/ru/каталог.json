                "senses": [
                    {
                        "sense_id": "e7545020-24d7-3434-8560-10d820883977",
                        "entry_id": "b411a7fa-9a41-313a-8387-e302472fe4de",
                        "glosses": [
                            "упорядоченный список, перечень каких-либо однородных предметов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42387692-3646-4ccd-a4d7-209ce6f691ac",
                                "sense_id": "e7545020-24d7-3434-8560-10d820883977",
                                "text": "Подписной индекс по каталогу «Роспечать» ― 71691."
                            }
                        ]
                    },
                    {
                        "sense_id": "91bab95c-3d56-31a0-8984-bf0b2374acc7",
                        "entry_id": "b411a7fa-9a41-313a-8387-e302472fe4de",
                        "glosses": [
                            "торг. рекламная брошюра, журнал с продукцией какой-либо компании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550c8638-9f2a-4eb5-909e-963bf72e259a",
                                "sense_id": "91bab95c-3d56-31a0-8984-bf0b2374acc7",
                                "text": "Каталог фирмы насчитывает десятки моделей самых различных стилевых направлений и назначений ― от профессиональной посуды для ресторанов и кафе до современной посуды для дома на самый утонченный вкус и изысканной медной посуды в стиле ретро."
                            }
                        ]
                    },
                    {
                        "sense_id": "96fcba28-d1fe-3568-8d6a-7a1e69f6ffae",
                        "entry_id": "b411a7fa-9a41-313a-8387-e302472fe4de",
                        "glosses": [
                            "комп. структура данных, именованный раздел носителя информации, являющийся хранилищем компьютерных файлов или других каталогов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257cd747-06a6-4ac9-9102-fba9334158e7",
                                "sense_id": "96fcba28-d1fe-3568-8d6a-7a1e69f6ffae",
                                "text": "Уровень корневого каталога представляется просто косой чертой /."
                            },
                            {
                                "example_id": "af81d6ea-28e6-47da-9e46-0b6a6830cf0a",
                                "sense_id": "96fcba28-d1fe-3568-8d6a-7a1e69f6ffae",
                                "text": "Каталог bin содержит необходимые исполняемые файлы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4358c42d-7bc7-4310-99d7-a1f6d32a7531",
                        "source_entry_id": "b411a7fa-9a41-313a-8387-e302472fe4de",
                        "source_sense_description": "список",
                        "target_lang_word": "catalogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catalogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32b2b1ab-7996-3123-b739-e0c3ade9e849",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A systematic list of books, names, pictures, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f47d71d-4c23-47a9-b74a-2a9360a8b003",
                                                "sense_id": "32b2b1ab-7996-3123-b739-e0c3ade9e849",
                                                "text": "[T]he charge of my moſt curious, and coſtly ingredients fraide, amounting to ſome ſeaventeene thouſand crovvnes, a trifle in reſpect of health, vvriting your noble name in my Catalogue, I ſhall acknovvledge my ſelfe amply ſatisfi'd."
                                            },
                                            {
                                                "example_id": "64afdc8f-8cfa-4834-95e1-423abfba5559",
                                                "sense_id": "32b2b1ab-7996-3123-b739-e0c3ade9e849",
                                                "text": "He intended to publish a flora of the island, and drafted out a synonymic catalogue, into which he inserted from time to time elaborate descriptions drawn up from living specimens of the species which he was able to procure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6db15e8-63c8-3f4d-a073-f954824ebe0a",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A systematic list of books, names, pictures, etc.",
                                            "A complete (usually alphabetical or chronological) list of items."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0655eb5c-3c1b-3934-b73b-e1f224850c9a",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A systematic list of books, names, pictures, etc.",
                                            "A list of all the publications in a library; a library catalogue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0406095-acc6-3ff0-b108-6badb8bb0845",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A retailer's magazine detailing the products they sell, allowing the reader to order them for delivery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3943d998-93e5-386b-a260-e1d7cecd8ed9",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A book printed periodically by a college, university, or other institution that gives a definitive description of the institution, its history, courses and degrees offered, etc."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5dc592e-c147-3557-a691-eb65cb660f2d",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A directory listing."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac33a5b0-f0c8-47e7-b04e-89ebfb38cdba",
                                                "sense_id": "f5dc592e-c147-3557-a691-eb65cb660f2d",
                                                "text": "The program generates a catalogue of the files on the cartridge selected by the user, reads the catalogue into memory and erases the cartridge copy, so that an up-to-date copy is always generated."
                                            },
                                            {
                                                "example_id": "d749c01e-a863-4161-acb7-ba9ed1afb1d8",
                                                "sense_id": "f5dc592e-c147-3557-a691-eb65cb660f2d",
                                                "text": "BBCFiles is a BBC file converter that converts between some of the various types of files used by BBC emulators on Acorn & PC formats. It supports 6502Em style applications & scripts, /ssd dfs disc images (supporting watford double catalogue), vanilla directories, /zip of bbc files with /inf files (with limitations) and directory of bbc files with /inf files."
                                            },
                                            {
                                                "example_id": "d918bf64-35fa-4375-905c-ef0429f2c21f",
                                                "sense_id": "f5dc592e-c147-3557-a691-eb65cb660f2d",
                                                "text": "It has two extra options using extended syntax. CAT - an extended catalogue but not as detailed as some I've seen. ( The reason that the Spectrum CAT command is restricted is that it cleverly uses the 512 bytes data buffer of the microdrive channel to sort the filenames - hence the limit of 50 ten-character filenames )"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1229270-782e-3d53-a611-defb5a9c4267",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A complete list of a recording artist's or a composer's songs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                                        "entry_id": "2eb9fffd-7c11-3764-be43-2e65aaaecac1",
                                        "glosses": [
                                            "A series of unwelcome or unpleasant things, often similar."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73239384-54b3-4f8d-beb7-36a44db4e91d",
                                                "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                                                "text": "The accident followed a catalogue of errors."
                                            },
                                            {
                                                "example_id": "9b50686a-ab8c-49e1-8a55-d03073d67446",
                                                "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                                                "text": "Near-synonym: litany"
                                            },
                                            {
                                                "example_id": "ee67d7f9-23a5-41be-b4f3-cc52e7b168fe",
                                                "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                                                "text": "The Reds were on the back foot early on when a catalogue of defensive errors led to Ramires giving Chelsea the lead. Jay Spearing conceded possession in midfield and Ramires escaped Jose Enrique far too easily before scoring at the near post with a shot Reina should have saved."
                                            },
                                            {
                                                "example_id": "9c42aefc-46ed-4d94-a064-72f38497f453",
                                                "sense_id": "c7f13291-243a-3410-a161-f65744aa023a",
                                                "text": "\"A catalogue of basic errors resulted in this tragedy,\" said HM Chief Inspector of Railways Ian Prosser CBE."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "catalogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff1a1c1e-3909-3b5b-ac4c-ca92a34d625f",
