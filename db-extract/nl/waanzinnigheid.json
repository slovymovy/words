                                    {
                                        "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "Something deeply misguided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d19b8b-9523-4d1c-9059-14b0a3840af4",
                                                "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                                "text": "Two days have passed since that day of lunacy. What a noise and a fuss and a chattering and an uproar there was! And what a welter of unseemliness and disorder and stupidity and bad manners! And I the cause of it all! Yet part of the scene was also ridiculous—at all events to myself it was so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cd23f79-0ef3-49e2-ae7a-da9f62af610f",
                        "source_entry_id": "bfc783d9-2983-3445-9af2-c4667269e081",
                        "source_sense_id": "7a9066ef-a76f-3673-9fc2-a119491883be",
