                                "target_senses": [
                                    {
                                        "sense_id": "2396f1ca-e505-32b9-b2a1-5be48e460302",
                                        "entry_id": "043f1946-e2ac-39db-95ed-20381eedce3f",
                                        "glosses": [
                                            "Sexual bonding or marriage involving partners of equal social status."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1f313f9-a9b4-3df0-804e-b32add7140fd",
                                        "entry_id": "043f1946-e2ac-39db-95ed-20381eedce3f",
                                        "glosses": [
                                            "A form of sexual reproduction involving gametes of similar morphology."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80dbf508-a447-4c40-992b-45cf45e9a1b8",
                                                "sense_id": "a1f313f9-a9b4-3df0-804e-b32add7140fd",
                                                "text": "Among other organisms, alternative methods of reproduction include budding, hermaphroditism (one individual carrying both kinds of sex organs) and isogamy (two individuals, not distinguished as male and female, combining their genes)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8da5f9cf-083b-4cb9-bb2f-cf7d8df6552b",
                        "source_entry_id": "8e17d596-a7e4-38ba-99ba-5d0ea3af9cc2",
                        "source_sense_id": "bf5d5a8c-fa8c-321f-82d5-42daa89afac9",
                        "target_lang_word": "isogamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isogamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ab988c-fc99-3551-b9e3-44970428b56f",
                                        "entry_id": "3e645f9b-1698-3141-be0d-08c79c380615",
                                        "glosses": [
                                            "Mode de reproduction sexué dans lequel les deux gamètes sont identiques, de telle façon qu'on ne puisse distinguer le mâle de la femelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f3ff638-3144-4c4c-995e-ba6f98054a52",
                                                "sense_id": "e9ab988c-fc99-3551-b9e3-44970428b56f",
                                                "text": "L'isogamie parfaite se rencontre généralement chez les champignons."
                                            },
                                            {
                                                "example_id": "3a8645bc-bfb5-4639-8f82-8b07ba596528",
                                                "sense_id": "e9ab988c-fc99-3551-b9e3-44970428b56f",
                                                "text": "Quand les gamètes sont identiques il y a isogamie, cette gamie primitive où les gamètes sont nageurs (planogamètes) ne s’observent uniquement que chez des organismes unicellulaires comme Chlamydomonas par exemple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
