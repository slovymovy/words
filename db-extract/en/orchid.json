                    {
                        "translation_id": "ea82a9fd-eb01-4942-9de6-bf0c11a189a5",
                        "source_entry_id": "a4c80db2-cbed-3874-a6bf-eeb6180b08d1",
                        "source_sense_description": "plant",
                        "target_lang_word": "orchidée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchidée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "934db5d6-f2e8-30d8-9d25-e74137901df9",
                                        "entry_id": "f0871361-706d-3b8d-be3d-8de1590466fa",
                                        "glosses": [
                                            "Plante monocotylédone et bulbeuse, de la famille des Orchidaceae (Orchidacées), dont le type est l’orchis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c9efca-d885-4e1a-a704-f709e8f62679",
                                                "sense_id": "934db5d6-f2e8-30d8-9d25-e74137901df9",
                                                "text": "Et, sous les arceaux, entre les massifs, çà et là, des chaînettes de fer soutenaient des corbeilles, dans lesquelles s’étalaient des Orchidées."
                                            },
                                            {
                                                "example_id": "b456295c-2362-4239-b32f-909c420517da",
                                                "sense_id": "934db5d6-f2e8-30d8-9d25-e74137901df9",
                                                "text": "Chez certaines orchidées, on a pu observer un phénomène particulier de nécrotrophie qui lyse les pelotons, ce qui permet une décharge importante d'éléments nutritifs du champignon à la racine de l’orchidée, les pelotons se reformant au fur et à mesure de la croissance de la racine."
                                            },
                                            {
                                                "example_id": "df1870a4-e516-405f-9e25-f2577e708d23",
                                                "sense_id": "934db5d6-f2e8-30d8-9d25-e74137901df9",
                                                "text": "Sa biodiversité est exceptionnelle : hérons, aigrettes, poules d’eau, mais aussi orchidées sauvages, iris jaunes, roseaux…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc1918d-035b-35c1-b3f1-6c719066d759",
                                        "entry_id": "f0871361-706d-3b8d-be3d-8de1590466fa",
                                        "glosses": [
                                            "Fleur de cette plante, utilisée pour l’ornementation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688ec2fd-79ed-4027-bea8-63324fd29648",
                                                "sense_id": "cbc1918d-035b-35c1-b3f1-6c719066d759",
                                                "text": "Un miracle offrirait à nos bois quelque prodigieuse orchidée, mille mains aussitôt se tendraient pour l’arracher, la flétrir ; l’oiseau bleu vient-il à passer, tous les fusils sont mis en joue ; l’on s'étonne après s’il est rare !"
                                            },
                                            {
                                                "example_id": "bc2b3026-0299-41ad-b4e4-e382c68c60bb",
                                                "sense_id": "cbc1918d-035b-35c1-b3f1-6c719066d759",
                                                "text": "Une nouvelle espèce d’orchidée, dont les fleurs délicates roses et blanches ressemblent à du verre, a été découverte par des scientifiques japonais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
