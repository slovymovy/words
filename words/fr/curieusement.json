            "senses": [
                {
                    "sense_id": "be7011bf-ba5d-3b9e-9ca5-45c309ace0f5",
                    "sense_definition": "D'une manière étrange ou surprenante ; bizarrement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "étrangeté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille maison restait <w>curieusement</w> silencieuse malgré la présence de nombreux invités."
                        },
                        {
                            "text": "<w>Curieusement</w>, personne dans le village ne semblait se souvenir de cet événement marquant."
                        }
                    ],
                    "synonyms": [
                        "bizarrement",
                        "étrangement",
                        "singulièrement",
                        "drôlement"
                    ],
                    "common_phrases": [
