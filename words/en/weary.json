    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed78bb4d-4536-326d-be6b-4ada81f31ebc",
                    "sense_definition": "Having the strength exhausted by toil or exertion; tired; fatigued.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fatigued",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking for hours in the heat, the <w>weary</w> travelers finally reached the hotel.",
                            "target_lang_translations": {
                                "de": "Nachdem sie stundenlang in der Hitze gelaufen waren, erreichten die <w>erschöpften</w> Reisenden endlich das Hotel."
                            }
                        },
                        {
                            "text": "Her <w>weary</w> legs could barely support her after the long marathon.",
                            "target_lang_translations": {
                                "de": "Ihre <w>müden</w> Beine konnten sie nach dem langen Marathon kaum noch tragen."
                            }
                        }
                    ],
                    "synonyms": [
                        "tired",
                        "fatigued",
                        "exhausted",
                        "worn out",
                        "spent"
                    ],
                    "antonyms": [
                        "energetic",
                        "refreshed",
                        "lively"
                    ],
                    "common_phrases": [
                        "weary traveler",
                        "weary legs",
                        "weary feet"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch Arbeit oder Anstrengung erschöpft; müde; ermüdet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "müde",
                                "target_lang_sense_clarification": "schläfrig oder kraftlos nach Anstrengung"
                            },
                            {
                                "target_lang_word": "erschöpft",
                                "target_lang_sense_clarification": "völlig ohne Kraft"
                            },
                            {
                                "target_lang_word": "ermüdet",
                                "target_lang_sense_clarification": "durch Anstrengung müde geworden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9c8d7c7-7983-3290-bcce-a4f4d5088f6f",
                    "sense_definition": "Having one's patience, relish, or contentment exhausted; tired; sick.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impatient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens grew <w>weary</w> of the endless political debates on television.",
                            "target_lang_translations": {
                                "de": "Die Bürger wurden der endlosen politischen Debatten im Fernsehen <w>überdrüssig</w>."
                            }
                        },
                        {
                            "text": "I am <w>weary</w> of your constant complaints about the weather.",
                            "target_lang_translations": {
                                "de": "Ich bin deine ständigen Beschwerden über das Wetter <w>leid</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tired",
                        "fed up",
                        "bored",
                        "sick"
                    ],
                    "antonyms": [
                        "enthusiastic",
                        "eager"
                    ],
                    "common_phrases": [
                        "weary of waiting",
                        "grow weary of"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Geduld, des Interesses oder der Zufriedenheit beraubt; einer Sache überdrüssig oder müde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "müde",
