                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f8db75-1326-4671-ac3e-3eedcb85d9f1",
                                "sense_id": "19c5d66f-83b5-33fa-af3c-bc985d2479ae",
                                "text": "„Er erzählte auch von Edmund Carter, der bei den Hexenprozessen von Salem nur ganz knapp dem Galgen entgangen war und der einen von seinen Urahnen geerbten großen Silberschlüssel in einem uralten Kästchen verwahrt hatte.“"
                            },
                            {
                                "example_id": "bfe363d5-27fd-4c1e-a8a3-0358e5900cab",
                                "sense_id": "19c5d66f-83b5-33fa-af3c-bc985d2479ae",
                                "text": "„Der Ritus des Silberschlüssels, den Randolph Carter in der schwarzen, unheimlichen Innenhöhle vollzogen hatte, blieb nicht ohne Folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
