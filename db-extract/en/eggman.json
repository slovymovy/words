                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87255cf-4fed-4030-b66c-58e8c979961c",
                                "sense_id": "e390cd17-624f-3cf6-80db-324d9f8dcbc5",
                                "text": "\"There's no reason now,\" said the eggman, gazing at her."
                            },
                            {
                                "example_id": "846b34dc-c79a-4e85-8250-b253ceba0ba5",
                                "sense_id": "e390cd17-624f-3cf6-80db-324d9f8dcbc5",
                                "text": "Every few weeks, Mr. Farber the eggman would visit us in our third-floor, East Bronx apartment. He delivered eggs and collected premiums for Workmen's Circle life insurance policies."
                            },
                            {
                                "example_id": "abc9dbb0-8824-47bc-989c-7dc2f2032c4e",
                                "sense_id": "e390cd17-624f-3cf6-80db-324d9f8dcbc5",
                                "text": "Pullets became hens in the henhouse, producing eggs that Kate swapped at Henry's for coffee and salt, or that Kate collected in egg cartons in the toolshed for the Boston eggman to pick up every two weeks, fresh eggs."
                            }
                        ]
                    }
