                        "target_lang_word": "Kaiser roll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaiser roll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c85a0d99-382d-3ed9-b409-330b47c65e14",
                                        "entry_id": "829ffd0d-8e64-37f4-827d-2ddea5b77527",
                                        "glosses": [
                                            "A typically crusty round bread roll supposedly invented in Vienna, made from flour, barm, malt, water, and salt, and whose characteristic feature is a five-spoked propeller- or pinwheel-like star on its obverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd85ad3-49ce-4142-9bad-f8376f4625a9",
                                                "sense_id": "c85a0d99-382d-3ed9-b409-330b47c65e14",
                                                "text": "Did you see it?? It was the biggest bee in the world! It was the size of a Kaiser roll! It must've weighed 70 pounds!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "057bc252-d007-47f9-a2e7-8d54863f7305",
                        "source_entry_id": "0357186f-963d-3122-bce6-1b459737eb9d",
