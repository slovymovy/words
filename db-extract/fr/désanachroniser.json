                "senses": [
                    {
                        "sense_id": "2fbbe663-d373-3c18-a7d9-b99c3f9fa56a",
                        "entry_id": "63498abc-339b-3f7e-93b4-691f0793e78f",
                        "glosses": [
                            "Enlever son caractère anachronique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cfc3468-d9cc-4ed7-baba-7c3df61ebbec",
                                "sense_id": "2fbbe663-d373-3c18-a7d9-b99c3f9fa56a",
                                "text": "La poésie de Cavafy ne tente pas de replacer ces personnages dans le récit de l'histoire, de les « désanachroniser », pour ainsi dire, (…)"
                            },
                            {
                                "example_id": "9126e1fd-29ea-4111-94b2-623d4d9fc1ee",
                                "sense_id": "2fbbe663-d373-3c18-a7d9-b99c3f9fa56a",
                                "text": "Désanachroniser les saisons enfouies."
                            },
                            {
                                "example_id": "788a280d-fbdb-4f63-a84e-b84c2b4b01c4",
                                "sense_id": "2fbbe663-d373-3c18-a7d9-b99c3f9fa56a",
                                "text": "Si des passionnés comme toi jettent la serviette, sur qui pouvons-nous compter pour ’désanachroniser’ l’école québécoise?"
                            }
                        ]
                    }
                ],
