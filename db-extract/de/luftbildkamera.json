                "senses": [
                    {
                        "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                        "entry_id": "72f540a7-6f5e-3745-a9d7-a18a5a2a0743",
                        "glosses": [
                            "Kamera für Luftaufnahmen aus der Vogelperspektive"
                        ],
                        "tags": [
                            "Photogrammetrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b96611a6-dde7-4cce-98c4-894bc550e1cc",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Die Neuentwicklung ist mit einer kalibrierten Luftbildkamera bestückt, die mit einer Auflösung von 22 Millionen Megapixel Bilder liefert, die unmittelbar in Vermessungskarten und Landschaftsprofile umgesetzt werden können."
                            },
                            {
                                "example_id": "60ee5437-6376-432c-b66c-7ab702fe4cb0",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Man könnte die Luftbildkamera auf den Bildschirm im Büro richten, auf dem das Bild einer Luftbildkamera zu sehen ist, die auf einen Bildschirm scharf stellt."
                            },
                            {
                                "example_id": "cdd5c7c6-44f5-4707-99f8-b87a81324e8f",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Ein Exponat, wie es nicht in jedem Kameramuseum steht: eine Zeiss-Luftbildkamera, die einmal zusammen mit dem Auswertegerät so viel wie drei Einfamilienhäuser gekostet[e] hat."
                            },
                            {
                                "example_id": "b24bbebe-a038-41ef-ab01-72fbbfd1bf2a",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Die Luftbildkamera wurde dem Museum vom Institut für Photogrammetrie und Kartographie der Technischen Universität Darmstadt gespendet, nachdem sie dort nicht mehr gebraucht wurde."
                            },
                            {
                                "example_id": "ba3536b8-904c-4b9d-97cc-636b78698696",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Ihre Hauptausrüstung besteht in Luftbildkameras auch im Infrarotbereich."
                            },
                            {
                                "example_id": "34d45215-e8b9-4886-8cb7-4df289dee89d",
                                "sense_id": "dacdeb2a-6210-3731-ae49-60b308803481",
                                "text": "Dazu gehören astronomische Teleskope, Luftbildkameras und photogrammetrische Geräte, aber auch Objekte für die Halbleiterindustrie und Operationsmikroskope."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
