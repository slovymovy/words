                ],
                "senses": [
                    {
                        "sense_id": "7025f43b-7d17-3488-8e3e-22f3156322d0",
                        "entry_id": "63be6ca8-bdf5-3b5a-adf9-1143c44d58a7",
                        "glosses": [
                            "Relatif à Raël, au raëlisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aad8cfb-d068-48bf-a325-029c755a0fec",
                                "sense_id": "7025f43b-7d17-3488-8e3e-22f3156322d0",
                                "text": "Va-t-il se donner en spectacle dans les émissions à la mode comme un certain Claude Vorilhon, dirigeant autoproclamé de la secte raëlienne."
                            },
                            {
                                "example_id": "4b8bcdf9-68b6-4490-8499-a4a3d16d8ce9",
                                "sense_id": "7025f43b-7d17-3488-8e3e-22f3156322d0",
                                "text": "En 1973, Claude Vorilhon, un journaliste sportif, déclare avoir rencontré un extraterrestre qui lui a révélé l’origine et le sens de la vie. Le mouvement raëlien, qu’il a créé, prône le développement de la science, la paix et la recherche de la vie éternelle par le biais du clonage."
                            }
                        ]
                    }
                ],
