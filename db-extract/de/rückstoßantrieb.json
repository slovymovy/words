                "senses": [
                    {
                        "sense_id": "32d315c9-430e-33f4-bd46-f9b5b070517e",
                        "entry_id": "08ac3b64-3148-3ee2-a6cb-9ccb9772927f",
                        "glosses": [
                            "Antrieb (zum Beispiel bei Raketen), der durch Rückstoß erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e507e9cb-203a-4e42-b804-50d99b0516a7",
                                "sense_id": "32d315c9-430e-33f4-bd46-f9b5b070517e",
                                "text": "„Und dann zog Doro aus dem Stand, wie eine Apollo 8 Rakete mit Rückstoßantrieb, hoch, bis fast an die Wolken.“"
                            },
                            {
                                "example_id": "80231d35-13ed-4c07-ae60-db49bbb26fa2",
                                "sense_id": "32d315c9-430e-33f4-bd46-f9b5b070517e",
                                "text": "„Durch diesen Rückstoßantrieb können ozeanische Kalmare bis auf 80 km/h beschleunigen.“"
                            },
                            {
                                "example_id": "34433025-51b4-4107-aef1-8a35d87c1eab",
                                "sense_id": "32d315c9-430e-33f4-bd46-f9b5b070517e",
                                "text": "„Mit 14 entwarf er bereits technisch umsetzbare Pläne für Raketen mit Rückstoßantrieb, die sich durch den Ausstoß von Abgasen durch den Weltraum katapultieren konnten.“"
                            },
                            {
                                "example_id": "2e3c2bab-713e-4324-aef0-cb94386ad580",
                                "sense_id": "32d315c9-430e-33f4-bd46-f9b5b070517e",
                                "text": "„Aber schon die Feuerwerksrakete, schon seit Jahrtausenden den Chinesen bekannt, ist rein physikalisch gesehen, ein Rückstoßantrieb, so wie es dem Prinzip nach auch ein von einem Motor angetriebener Propeller ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
