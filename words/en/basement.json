    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "185966eb-c9a5-315d-88f3-ba7cdb8cba99",
                    "sense_definition": "A floor of a building below ground level.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We store our bicycles in the <w>basement</w> during the winter.",
                            "target_lang_translations": {
                                "ru": "Зимой мы храним наши велосипеды в <w>подвале</w>.",
                                "zh": "冬天我们把自行车存放在<w>地下室</w>里。"
                            }
                        },
                        {
                            "text": "They decided to rent out the <w>basement</w> apartment to a student.",
                            "target_lang_translations": {
                                "ru": "Они решили сдать квартиру в <w>цокольном этаже</w> студенту.",
                                "zh": "他们决定把那间<w>地下室</w>公寓租给一名学生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cellar"
                    ],
                    "antonyms": [
                        "attic",
                        "loft"
                    ],
                    "common_phrases": [
                        "finished basement",
                        "basement apartment",
                        "damp basement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Этаж здания, расположенный ниже уровня земли.",
                        "zh": "建筑物位于地面以下的楼层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвал",
                                "target_lang_sense_clarification": "помещение под первым этажом"
                            },
                            {
                                "target_lang_word": "цокольный этаж",
                                "target_lang_sense_clarification": "полуподвальный этаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地下室",
                                "target_lang_sense_clarification": "建筑物位于地面以下的房间或楼层"
                            },
                            {
                                "target_lang_word": "地窖",
                                "target_lang_sense_clarification": "通常用于储藏物品的地下空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b46b329-5985-33d2-8477-90237863d877",
                    "sense_definition": "The last place in a sports conference's standings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long losing streak, the team fell to the <w>basement</w> of the league.",
                            "target_lang_translations": {
                                "ru": "После длительной серии поражений команда скатилась на <w>дно</w> лиги.",
                                "zh": "在经历了一连串的失败后，这支队伍在联赛中<w>垫底</w>了。"
                            }
                        },
                        {
                            "text": "They are working hard to climb out of the <w>basement</w> before the season ends.",
                            "target_lang_translations": {
                                "ru": "Они усердно работают, чтобы выбраться из <w>подвала</w> турнирной таблицы до конца сезона.",
                                "zh": "他们正在努力工作，争取在赛季结束前摆脱<w>垫底</w>的位置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последнее место в турнирной таблице спортивной лиги.",
