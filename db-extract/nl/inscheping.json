                        "glosses": [
                            "aan boord gaan van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e05f4be5-5542-44b5-9e12-593ebf5f252d",
                                "sense_id": "2fe41477-23eb-3598-9a00-f377a38e00f4",
                                "text": "De formaliteit vereiste dat Trevor in het Secreet Besogne verlof vroeg voor hun inscheping."
                            },
                            {
                                "example_id": "ac664234-815d-43f1-99ef-bdab49562cfe",
                                "sense_id": "2fe41477-23eb-3598-9a00-f377a38e00f4",
                                "text": "Voorafgaand aan de inscheping betaalden vluchtelingen 7000 euro. Voor een smokkelreis met een personenauto of bestelbusje vanuit Italië betaalden zij per persoon 700 euro. Vermoedelijk vertrokken vanuit Milaan en Wenen dagelijks personenauto's en busjes naar Nederland, Duitsland, Denemarken en Zweden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db4041df-541e-469a-a27d-99c98b4a321a",
                        "source_entry_id": "14f2e9c4-97aa-30b1-874b-7cfea51b9311",
                        "source_sense_id": "2fe41477-23eb-3598-9a00-f377a38e00f4",
