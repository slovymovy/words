                "senses": [
                    {
                        "sense_id": "bee9eb47-ee67-316f-84ad-836b03b969be",
                        "entry_id": "f7592689-ceb9-397f-a7d7-b3797698083a",
                        "glosses": [
                            "Piège constitué d’une masse lourde soutenue par trois morceaux de bois dont l’assemblage rappelle la forme d’un quatre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afef50fc-2669-4465-abd2-4777455de3a7",
                                "sense_id": "bee9eb47-ee67-316f-84ad-836b03b969be",
                                "text": "[…], je me rappelle que ton père qui était allé conduire une fois du bois dans le Centre de la France racontait que là-bas c'est au traquenard qu'on prend les grives, dans les vignes, au quatre de chiffres."
                            },
                            {
                                "example_id": "28c96965-7317-4bee-81b3-c751c59a4beb",
                                "sense_id": "bee9eb47-ee67-316f-84ad-836b03b969be",
                                "text": "Quand il voulait prendre l’oiseau vivant, il remplaçait la pierre du quatre-de-chiffre par un panier en osier."
                            },
                            {
                                "example_id": "b1490038-a768-4b4b-a427-21154358cd70",
                                "sense_id": "bee9eb47-ee67-316f-84ad-836b03b969be",
                                "text": "Ça tient comme un quatre de chiffre : c'est dans un équilibre précaire."
                            }
                        ]
                    }
                ],
