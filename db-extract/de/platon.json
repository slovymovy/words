                ],
                "senses": [
                    {
                        "sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                        "entry_id": "3fc25fd2-7a8a-3d29-8e8e-65639218f21a",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2821779-5c52-4a0f-8f81-b1afaf01fb4e",
                                "sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                                "text": "Es gibt nicht viele Eltern, die ihrem Sohn heutzutage den Namen Platon geben."
                            },
                            {
                                "example_id": "2ea59f2c-909d-45e8-a643-243dbb50560f",
                                "sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                                "text": "Das geistige Erbe Platons beeinflusste und prägte zahlreiche jüdische, christliche und islamische Philosophen in kaum zu überschätzendem Maß."
                            },
                            {
                                "example_id": "19a76f75-34d9-4bd9-af8c-125285231b4b",
                                "sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                                "text": "„Im Grunde können wir sagen, daß Platon ein positives Frauenbild hatte — jedenfalls für seine Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71d9f531-7ab7-46cf-8ad4-8b6b0604d5f5",
                        "source_entry_id": "3fc25fd2-7a8a-3d29-8e8e-65639218f21a",
                        "source_sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Plato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bac4e777-199a-3f25-bd70-98ff2bde8cf1",
                                        "entry_id": "ea3ee93f-5a66-3219-aad0-02b7930693a1",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6dae2c-a28c-4666-bc77-39718d6d5a73",
                                                "sense_id": "bac4e777-199a-3f25-bd70-98ff2bde8cf1",
                                                "text": "My name is Plato Jones. Plato Constantine Jones. Plato because my mother is Greek, and Jones because my father is Welsh, and Constantine after his father, my grandfather, who is Constantine Llewellyn Jones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27ab00e-c88a-37ac-9f7e-947968ee35d6",
                                        "entry_id": "ea3ee93f-5a66-3219-aad0-02b7930693a1",
                                        "glosses": [
                                            "A male given name from Ancient Greek.",
                                            "The Greek philosopher, 427–347 BC, follower of Socrates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01721712-0e3e-4e86-87e6-077b5d911584",
                        "source_entry_id": "3fc25fd2-7a8a-3d29-8e8e-65639218f21a",
                        "source_sense_id": "1555f98a-3885-3c69-8a33-ae527742341b",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Platon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                        "entry_id": "85e7618d-9799-33b7-afff-ab115ed069ee",
                                        "glosses": [
                                            "Philosophe grec (427 av. J.-C. - 348 av. J.-C.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33b5b63-6b98-4778-89e2-789df294391b",
                                                "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                                "text": "Platon, le divin Platon, n'était en verve que lorsqu'il était en pointe de vin."
                                            },
                                            {
                                                "example_id": "21e06f18-6829-4e97-a022-e0d5bcccbc29",
                                                "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                                "text": "Les historiens de la philosophie me paraissent avoir été très hostiles à Xénophon parce qu'il est trop vieux Grec; Platon leur convient mieux parce qu'il est plus aristocrate, et par suite plus détaché de l'économie."
                                            },
                                            {
                                                "example_id": "404d6c3d-cb13-4e4d-9bd3-0c0735ad7cbd",
                                                "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                                "text": "De W. était jeune ; il était attiré par les cadavres, comme l'homme de Platon. J'avais et j’eus toujours la sagesse de ne pas regarder ces choses de près."
                                            },
                                            {
                                                "example_id": "543cc41f-f9c8-42d2-9c87-1aeb7509387c",
                                                "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                                "text": "« La philosophie abstraite, telle qu’on la pratique aujourd’hui, n’est qu’un amas de fumée qui cache le vide. Entre elle et la philosophie concrète de Platon, il y a la différence qui sépare un lumignon du soleil », avais-je lancé en pleine classe à notre professeur de philosophie de première supérieure à Louis-le-Grand."
                                            },
                                            {
                                                "example_id": "5cd8bab8-8504-4679-a8de-46d40a26cec4",
                                                "sense_id": "8e038623-64d7-3823-a66f-2b81baec21b9",
                                                "text": "La lecture de Platon m’avait conduite à prendre des leçons de mathématiques (« Nul n’entre ici s’il n’est géomètre »), science que j’ai dû essayer de réapprendre plus tard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Platon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e161f382-aca4-3995-a0f5-cb8501745621",
                                        "entry_id": "0cac7157-183a-329f-a06f-c105e4f38464",
                                        "glosses": [
                                            "Nom de famille français."
