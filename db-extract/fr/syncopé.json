                "senses": [
                    {
                        "sense_id": "357ec696-810a-3e0f-bce5-461054c186a0",
                        "entry_id": "06e9e55c-9686-3d85-abb1-36d65e1c6c8b",
                        "glosses": [
                            "Victime d'une syncope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46aab713-f073-46c7-a3d6-f62557dd3a8d",
                                "sense_id": "357ec696-810a-3e0f-bce5-461054c186a0",
                                "text": "Elle retomba sur son matelas, à bout, inerte, mais non syncopée cependant, ainsi que le prouvait sa respiration pantelante."
                            }
                        ]
                    },
                    {
                        "sense_id": "8708844f-a2ca-3212-8bf6-eb5697df70b8",
                        "entry_id": "06e9e55c-9686-3d85-abb1-36d65e1c6c8b",
                        "glosses": [
                            "Où il y a une syncope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00d4a45-bebe-4734-86a7-40f242efbdfa",
                                "sense_id": "8708844f-a2ca-3212-8bf6-eb5697df70b8",
                                "text": "Mot syncopé."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc43870b-9ad8-3f00-9bf0-0059584084f9",
                        "entry_id": "06e9e55c-9686-3d85-abb1-36d65e1c6c8b",
                        "glosses": [
                            "Qui fait une syncope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa0dfdc-264a-482e-a96c-4899d8c6cf46",
                                "sense_id": "bc43870b-9ad8-3f00-9bf0-0059584084f9",
                                "text": "Il est vrai qu’à l’époque le jazz - ou plus précisément sa version allégée, la musique syncopée, dernière vogue venue des États-Unis - constitue (comme le fera le rock plus tard) l’ossature de la variété."
                            },
                            {
                                "example_id": "10bfe035-3dd9-495c-81cc-7b89068fd274",
                                "sense_id": "bc43870b-9ad8-3f00-9bf0-0059584084f9",
                                "text": "Le second, octogonal à pans, d’après le modèle de Pierre Chabrol (1881-1967), présenté avec sa gouache préparatoire, évoque le rythme syncopé et la polyrythmie du jazz qui fait partie du paysage sonore des Années folles."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fb44e0e-4831-312b-bffe-6ddb34ab650a",
                        "entry_id": "06e9e55c-9686-3d85-abb1-36d65e1c6c8b",
                        "glosses": [
                            "Irrégulier."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "12c9a94f-103f-43b8-a8db-a011a33ca59c",
                                "sense_id": "8fb44e0e-4831-312b-bffe-6ddb34ab650a",
                                "text": "T'es syncopé comme type. Je m'en fous, je te parle quand même : tu dors mais t'es là."
                            },
                            {
                                "example_id": "1f174351-1e5e-4b2d-9e91-08ecf379c789",
                                "sense_id": "8fb44e0e-4831-312b-bffe-6ddb34ab650a",
                                "text": "Il s'était mis en route, la démarche syncopée, vers des fiascos inédit."
                            }
                        ]
                    }
