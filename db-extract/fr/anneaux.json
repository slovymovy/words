                        "glosses": [
                            "Pluriel du mot anneau."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0bbb2dd5-c2f8-4fd6-8bb3-f31e271eec4d",
                                "sense_id": "8e763ed1-0239-3658-b90d-5d6635b2b6f9",
                                "text": "Le type annellé s’oppose au précédent; il est dépourvu de nasse, mais possède (du moins en principe, car une évolution régressive les a souvent rudimentarisés ou supprimés) un ou plusieurs anneaux apicaux ; on les voit distincts ou soudés, et ils sont amyloïdes ou non."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9db7602-f7cb-3470-bcf0-2b31b3bf69d5",
                        "entry_id": "fe3245e6-784f-365d-a301-800cb823308b",
                        "glosses": [
                            "Agrès de gymnastique composé de deux cercles de métal fixés au bout de deux cordes suspendues à un portique."
                        ],
                        "tags": [
                            "especially",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b277586f-2978-40dd-911f-80156b465b1d",
                                "sense_id": "a9db7602-f7cb-3470-bcf0-2b31b3bf69d5",
                                "text": "Ils sont les hommes forts de la gymnastique. Les spécialistes des anneaux, épreuve réservée aux hommes…."
                            }
                        ]
                    }
