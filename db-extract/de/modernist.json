                ],
                "senses": [
                    {
                        "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                        "entry_id": "b3dab6f9-d78c-3e28-8986-d09ab6e45335",
                        "glosses": [
                            "Person, die der modernistischen Strömung angehört beziehungsweise den Modernismus unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56aae070-303b-4919-ac0a-837658887c97",
                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                "text": "„Die ersten Jahre waren durch Spannungen zwischen Modernisten und Traditionalisten gekennzeichnet.“"
                            },
                            {
                                "example_id": "e369d4cb-b8c4-4cdf-9db7-b6f10df1c71e",
                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                "text": "„Als Modernisten galten danach alle jene, die neue Gebräuche in die Kirche einführen wollen, sei es in der Liturgie oder Pastoral oder hinsichtlich disziplinärer und kanonistischer Vorschriften bis hin zur Infragestellung des Zölibats.“"
                            },
                            {
                                "example_id": "204cf998-ba43-478c-b4d7-d1e43632433a",
                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                "text": "„Ein nicht geringer Teil der ägyptischen Modernisten dieser Zeit waren Christen, die Europa und die Aufklärung prinzipiell nicht als Fremdkonzepte, sondern als Bestandteile ihrer eigenen Kultur auffaßten.“"
                            },
                            {
                                "example_id": "b5f6465c-40fe-4e96-9887-dc45bff80968",
                                "sense_id": "9bacd218-d6a8-3f34-8dc2-53d36d4ade76",
                                "text": "„Allen Modernisten gemeinsam war damit die Absage an die älteren moralischen und ästhetischen Normen der bürgerlichen Literatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
