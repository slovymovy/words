    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c1c4e13-fa11-3634-b6a3-911810b6329e",
                    "sense_definition": "An act or instance of waking up from sleep",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waking_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My morning <w>wakeup</w> routine usually includes a hot shower and coffee.",
                            "target_lang_translations": {
                                "pl": "Moja poranna <w>pobudka</w> zazwyczaj obejmuje gorący prysznic i kawę."
                            }
                        },
                        {
                            "text": "She had a rough <w>wakeup</w> after sleeping for only four hours.",
                            "target_lang_translations": {
                                "pl": "Miała ciężką <w>pobudkę</w> po zaledwie czterech godzinach snu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning wakeup",
                        "gentle wakeup"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czynność lub moment budzenia się ze snu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pobudka",
                                "target_lang_sense_clarification": "moment wstania z łóżka lub wybudzenia się"
                            },
                            {
                                "target_lang_word": "wstawanie",
                                "target_lang_sense_clarification": "proces budzenia się i rozpoczynania dnia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90ef4e53-876f-3fd1-a3b8-57fb21c86903",
                    "sense_definition": "An act or instance of being awakened, such as a phone call or alarm",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waking_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please give me a <w>wakeup</w> at seven o'clock tomorrow morning.",
                            "target_lang_translations": {
                                "pl": "Proszę, niech mnie ktoś <w>obudzi</w> jutro rano o siódmej."
                            }
                        },
                        {
                            "text": "I relied on a scheduled <w>wakeup</w> call to make sure I caught my early flight.",
                            "target_lang_translations": {
                                "pl": "Polegałem na zamówionym <w>budzeniu</w> telefonicznym, żeby mieć pewność, że zdążę na wczesny lot."
                            }
                        }
                    ],
                    "synonyms": [
                        "wake-up call"
                    ],
                    "common_phrases": [
                        "wakeup call",
                        "give a wakeup"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czynność lub sygnał mający na celu wybudzenie kogoś, np. telefon lub budzik."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pobudka",
                                "target_lang_sense_clarification": "sygnał do wstania"
                            },
                            {
                                "target_lang_word": "budzenie",
                                "target_lang_sense_clarification": "działanie polegające na wybudzeniu kogoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd27cfc6-9e3f-34a1-a419-8aa3cdd7af05",
                    "sense_definition": "A common North American bird of the woodpecker family, also known as the northern flicker",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted a yellow-shafted <w>wakeup</w> searching for insects on the tree trunk.",
                            "target_lang_translations": {
                                "pl": "Zauważyliśmy <w>dzięcioła różowoszyjego</w> szukającego owadów na pniu drzewa."
                            }
                        },
                        {
                            "text": "The loud calling of a <w>wakeup</w> echoed through the autumn woods.",
                            "target_lang_translations": {
                                "pl": "Głośne nawoływanie <w>dzięcioła różowoszyjego</w> niosło się echem po jesiennym lesie."
                            }
                        }
                    ],
                    "synonyms": [
                        "northern flicker",
                        "flicker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Północnoamerykański ptak z rodziny dzięciołowatych, znany również jako dzięcioł różowoszyi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dzięcioł różowoszyi",
                                "target_lang_sense_clarification": "nazwa gatunkowa ptaka"
                            }
                        ]
                    }
                }
            ]
        }
    ]
