                        "glosses": [
                            "That cannot be ascertained; uncertain, unable to be determined or discovered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b0c112-f75d-45d8-a98f-124399214e77",
                                "sense_id": "23f924c3-0533-3902-97b5-7bdc84b83366",
                                "text": "Everything one would wish to know of the relations of Aristotle and Alexander is unascertainable, the more so as legends were soon invented on the subject."
                            },
                            {
                                "example_id": "33ae58ef-b12b-4239-ac65-3d6cc8a21122",
                                "sense_id": "23f924c3-0533-3902-97b5-7bdc84b83366",
                                "text": "Reality is different from, and more than, the totality of facts and events, which, anyhow, is unascertainable."
                            },
                            {
                                "example_id": "8163a813-e4ba-4b7c-95dd-b992cc0e7d42",
                                "sense_id": "23f924c3-0533-3902-97b5-7bdc84b83366",
                                "text": "The regulation's vagueness is especially apparent in the last clause quoted above. That portion of the test is expressly based on an individualistic—and therefore necessarily varying and unascertainable—standard: the reactions of members of the public."
                            }
                        ]
                    }
