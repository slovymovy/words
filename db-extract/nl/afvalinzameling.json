                        "examples": [
                            {
                                "example_id": "878f7942-8df5-486b-afa6-0013ed1bea50",
                                "sense_id": "7f18f8dc-7348-352b-b42d-df22e29f5afc",
                                "text": "In die verbanden maken wethouders van verschillende gemeenten afspraken over gezamenlijk beleid, bijvoorbeeld voor afvalinzameling of de jeugdzorg."
                            },
                            {
                                "example_id": "b83cb4e5-32ab-4dfd-a9ea-0f713cca3a03",
                                "sense_id": "7f18f8dc-7348-352b-b42d-df22e29f5afc",
                                "text": "Burgers die moeten betalen per vuilnisbak, zijn net zo tevreden over het afvalbeleid in hun gemeente als inwoners die een vast bedrag betalen voor de afvalinzameling. Het scheiden zelf lijkt voor de meeste mensen geen probleem. Integendeel: mensen van wie het afval niet gescheiden wordt ingezameld, geven het afvalbeleid in hun gemeente een lager cijfer dan respondenten in gemeenten waar dat wel gebeurt."
                            }
                        ]
                    }
