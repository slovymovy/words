                        "glosses": [
                            "Gruppe von Leuten, die ein bestimmtes Gebiet erkunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4616dc7-7963-49f5-8cbf-d75c3233447a",
                                "sense_id": "17822829-17a6-3cc6-9bd0-f26b62ab0dd0",
                                "text": "„Gerade Schwellenländer wie China und Indien müssen ihren immensen Rohstoffhunger durch immer neue Lagerstätten decken und schicken ihre Erkundungstrupps aufs Meer.“"
                            },
                            {
                                "example_id": "d2f14b4f-2cc0-4878-82a5-591c9a57ce0b",
                                "sense_id": "17822829-17a6-3cc6-9bd0-f26b62ab0dd0",
                                "text": "„In den kommenden zwei Wochen wird ein Erkundungstrupp der Bundeswehr in der Provinz Herat sowie in der Region Charikar prüfen, ob deutsche Soldaten dort in Zukunft zivile Hilfsorganisationen beschützen können.“"
                            }
                        ],
