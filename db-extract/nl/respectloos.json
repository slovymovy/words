                "senses": [
                    {
                        "sense_id": "7b688a05-e3f4-3906-a1fe-208927790e20",
                        "entry_id": "860b8ae5-47ae-3866-abc6-1b6354567435",
                        "glosses": [
                            "oneerbiedig, gezegd over de aard van personen en het gedrag waaruit dat blijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e07bd9-b6bf-4a25-8303-51940ae142a3",
                                "sense_id": "7b688a05-e3f4-3906-a1fe-208927790e20",
                                "text": "Als mens was hij grof, rancuneus en respectloos, maar niettemin een ‘honnête homme’, een omgekeerde moralist."
                            }
                        ]
                    },
                    {
                        "sense_id": "99102126-879b-321b-8176-488e23357433",
                        "entry_id": "860b8ae5-47ae-3866-abc6-1b6354567435",
                        "glosses": [
                            "onbehoorlijk, vooral in verwijtende zin over bewust kwetsend gedrag en personen die dat vertonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e52659-28c1-4e9f-a4ed-5d06a8d7accd",
                                "sense_id": "99102126-879b-321b-8176-488e23357433",
                                "text": "Elke vergelijking is respectloos ten opzichte van de poëzie waarmee een vergelijking wordt aangegaan, zoals het ook het unieke element in de ‘frontgedichten’ aantast."
                            }
                        ]
                    }
