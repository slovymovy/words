                "senses": [
                    {
                        "sense_id": "e86ec3de-aea2-30e3-8dc7-58195b89eef9",
                        "entry_id": "f9a11a51-8aa7-38ef-b6ad-c15a88feb7b0",
                        "glosses": [
                            "Berechtigungsschein zum begrenzten Bezug von Brot in Notzeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01512b2b-6c5c-4e75-824d-5d379b22e87d",
                                "sense_id": "e86ec3de-aea2-30e3-8dc7-58195b89eef9",
                                "text": "„Auf die Beschlagnahmung aller Getreidebestände folgte eine Woche später die Ausgabe von Brotkarten, also die Rationierung des neben Kartoffeln wichtigsten Grundnahrungsmittels.“"
                            },
                            {
                                "example_id": "cf8cb83a-e9b2-4eb0-a533-a3a6b0b14f27",
                                "sense_id": "e86ec3de-aea2-30e3-8dc7-58195b89eef9",
                                "text": "„Im Sommer 1946 führten die Briten Brotkarten ein, die sie den ganzen Krieg über nicht gekannt hatten, um ihre Zone vor dem Verhungern zu bewahren.“"
                            },
                            {
                                "example_id": "013770b5-dcd7-4dcd-8663-caefe875fe82",
                                "sense_id": "e86ec3de-aea2-30e3-8dc7-58195b89eef9",
                                "text": "„Ich exerzierte unter der Fuchtel von Unteroffizieren, die schwach vor Hunger und Bauchschmerzen waren und nur daran dachten, sich Brotkarten zu besorgen.“"
                            },
                            {
                                "example_id": "9ade951e-ad04-450a-b2ab-8b740acb5c3f",
                                "sense_id": "e86ec3de-aea2-30e3-8dc7-58195b89eef9",
                                "text": "„Die literarische und künstlerische Liberalität dieses strammen kaiserlichen Regimes, in dem die Brotkarte und das Kriegsgesetz herrschten, ist von heute aus kaum mehr zu begreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
