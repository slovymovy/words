                "senses": [
                    {
                        "sense_id": "455fde9f-055c-3eb3-b760-922d59aa46bb",
                        "entry_id": "416d3a46-1cf5-3145-9114-0b535f20a8f5",
                        "glosses": [
                            "имеющий длину или высоту 18 метров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73a157a-7bf0-4f1e-84cc-c88c62397ae4",
                                "sense_id": "455fde9f-055c-3eb3-b760-922d59aa46bb",
                                "text": "В центре просторного зала возвышалась грандиозная восемнадцатиметровая статуя, целиком вырезанная из огромного сандалово годерева."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d634bf1-b409-315e-8028-c362989569bc",
                        "entry_id": "416d3a46-1cf5-3145-9114-0b535f20a8f5",
                        "glosses": [
                            "имеющий площадь 18 квадратных метров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc3bcbc-db4a-4958-a281-5df2af9f83db",
                                "sense_id": "3d634bf1-b409-315e-8028-c362989569bc",
                                "text": "Она состояла из большой проходной комнаты, справа от которой располагались две десятиметровые комнатки, а слева – одна восемнадцатиметровая."
                            }
                        ]
                    }
