                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I’ll have a ham sandwich with <w>lettuce</w> and tomato.",
                            "target_lang_translations": {
                                "ru": "Я буду сэндвич с ветчиной, <w>салатом</w> и помидором."
                            }
                        },
                        {
                            "text": "She prepared a fresh <w>lettuce</w> salad for lunch.",
                            "target_lang_translations": {
                                "ru": "Она приготовила свежий салат из <w>латука</w> на обед."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh lettuce salad",
                        "crisp lettuce leaf",
                        "shredded lettuce"
                    ],
                    "target_lang_definitions": {
