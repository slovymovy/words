                "senses": [
                    {
                        "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                        "entry_id": "f6058ee8-bb8c-3d97-a519-655c16abc01c",
                        "glosses": [
                            "Abschwung/Unterbrechung/Rückschlag in der beruflichen Laufbahn"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "98134534-c648-4633-b885-1290405eeeed",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "Die Geburt eines Kindes bedeutet in Deutschland für Frauen häufig einen Karriereknick."
                            },
                            {
                                "example_id": "275e2d78-a18d-470b-98d2-1dcb464f3c04",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "Wer sich gegen den Parteivorsitzenden stellt, muss mit einem Karriereknick rechnen."
                            },
                            {
                                "example_id": "bc4531ae-8003-4c6c-953c-efd428f524de",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "[Diskriminierung: Kaum Ärztinnen an der Spitze] […] Der Karriereknick kommt meistens, wenn die Familienplanung losgeht."
                            },
                            {
                                "example_id": "857b182b-e0e0-4ccb-bd11-1a9563ec7fdb",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "Fast alle Männer schuften dauerhaft Vollzeit. Auch jene, die gerne wegen ihrer Kinder früher das Büro verlassen würden. Doch sie fürchten einfach den Karriereknick."
                            },
                            {
                                "example_id": "655f2f0b-519d-4e82-a410-f8174266178e",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "Estevez […] erlitt im Verlaufe der 1990er Jahre als Erwachsener einen empfindlichen Karriereknick."
                            },
                            {
                                "example_id": "8113ce34-91d6-4ec8-965c-48dcede0556b",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "[…] ausgerechnet „Black and Proud“, sein Signatursong, beschert James Brown einen Karriereknick."
                            },
                            {
                                "example_id": "760045ea-2e4b-4c4b-805e-1df29507c5e0",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "[Aretha Franklin:] Nach einem Karriereknick ab Mitte der Siebziger katapultierte sie der Wechsel zum Label Arista wieder in alte Sphären des Erfolgs."
                            },
                            {
                                "example_id": "655cc2d2-e8db-4b15-b8f0-59e2f9923e2e",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "[Martin Schulz] hatte keine Lust, als einfacher Abgeordneter in Straßburg oder Brüssel zu versauern. Den möglichen Karriereknick vor Augen, organisierte Schulz rechtzeitig seinen Wechsel nach Berlin."
                            },
                            {
                                "example_id": "7e47a4d6-5cd5-413e-b1c7-081f1d55c5b1",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "[2002 wurde Winona Ryder] wegen wiederholten Ladendiebstahls von Kleidern im Wert von 5000 US-Dollar zu einer Bewährungszeit von drei Jahren und einer Arbeitsauflage von 480 Stunden verurteilt. Der Vorfall verursachte einen Karriereknick."
                            },
                            {
                                "example_id": "2db71f1b-fb37-49fd-9ce0-73c5b5b6be8a",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "„So spielt er wieder recht den Teufel und erzählt abgefeimt-ironisch seine Erfolgsstory, kleine und größere Niederlagen und Karriereknicke eingeschlossen.“"
                            },
                            {
                                "example_id": "4dc89fa6-9629-4a31-a305-a90a0c1ceb3a",
                                "sense_id": "8a3a21c9-6a36-32b7-86cc-4b8ffb03fac3",
                                "text": "„Mit einem Schwips kommen Menschen auf komische Ideen. Sie wollen dem Kollegen endlich mal richtig die Meinung sagen - das kann zu fatalen Karriereknicks führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
