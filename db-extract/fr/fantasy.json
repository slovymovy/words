        "fr-extract.jsonl": [
            {
                "entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                "word": "fantasy",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d509cc5c-c103-4313-acbc-254cbb223038",
                        "entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                        "tags": [
                            "plural"
                        ],
                        "form": "fantasys"
                    },
                    {
                        "form_id": "2353c91d-cea4-4bf7-8972-b80d37ed403a",
                        "entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                        "tags": [],
                        "form": "fantasie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22ac039a-29fb-37cd-b704-d72c7e5b3bc4",
                        "entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                        "glosses": [
                            "Un genre narratif présentant dans son récit un ou plusieurs éléments irrationnels qui relèvent généralement d’un aspect mythique et qui sont souvent incarnés par l’irruption ou l’utilisation de la magie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff54efd6-4c74-4452-9c7a-d083f776bcd5",
                                "sense_id": "22ac039a-29fb-37cd-b704-d72c7e5b3bc4",
                                "text": "George R. R. Martin cherchait à écrire de la fantasy pour les gens qui n’aiment pas la fantasy."
                            },
                            {
                                "example_id": "29e4f32f-0ce5-40f0-a42f-1c25d9f5f2ce",
                                "sense_id": "22ac039a-29fb-37cd-b704-d72c7e5b3bc4",
                                "text": "En d’autres termes, Robin Hobb manie parfaitement les ficelles de son histoire, et tient son lecteur en haleine en permanence, tant avec des personnages tous aussi profonds les uns que les autres, qu’avec un univers de fantasy qui tient la route sur le plan géographique, social comme politique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3974128-36b5-404a-afa1-35ba923c672d",
                        "source_entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                        "source_sense_id": "22ac039a-29fb-37cd-b704-d72c7e5b3bc4",
                        "target_lang_word": "Fantasy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fantasy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6817789d-6d87-3ca5-b26e-4133a5d3bd8c",
                                        "entry_id": "34688c39-efe5-3ec7-a405-19687115a5db",
                                        "glosses": [
                                            "Genre in Literatur und Film, das fantastische und magische Elemente enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485be863-0273-466d-9b18-b4f44e433506",
                                                "sense_id": "6817789d-6d87-3ca5-b26e-4133a5d3bd8c",
                                                "text": "„Packendes Abenteuer mit ein wenig Fantasy und wilden Räubergesängen – eine der schönsten Verfilmungen nach einem Buch von Astrid Lindgren.“ (Berliner Morgenpost Online)"
                                            },
                                            {
                                                "example_id": "2575a5f3-26dd-4663-85ea-dcc6d882f16d",
                                                "sense_id": "6817789d-6d87-3ca5-b26e-4133a5d3bd8c",
                                                "text": "„Ben hatte unzählige Krimis gesammelt und bunte Paperbacks mit Covern, die nach Fantasy und Science-Fiction aussahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13fe0a25-9fff-48c5-9118-47f20387d0b6",
                        "source_entry_id": "f083528a-8d67-33e6-bfbb-233e466c5783",
                        "source_sense_id": "22ac039a-29fb-37cd-b704-d72c7e5b3bc4",
                        "target_lang_word": "fantasy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantasy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a14484c-61b7-3967-80ec-a75916bd7b21",
                                        "entry_id": "19d88710-af02-3672-a05b-c96c8b0b1dcc",
                                        "glosses": [
                                            "That which comes from one's imagination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bbbae4-23b1-460f-b3c3-551541a69fc1",
                                                "sense_id": "5a14484c-61b7-3967-80ec-a75916bd7b21",
                                                "text": "Is not this something more than fantasy?"
                                            },
                                            {
                                                "example_id": "702dbfb0-db70-4617-a044-ad8704ed49b0",
                                                "sense_id": "5a14484c-61b7-3967-80ec-a75916bd7b21",
                                                "text": "A thousand fantasies / Begin to throng into my memory."
                                            },
                                            {
                                                "example_id": "d9d9f24e-c913-4986-a23c-3a03dd976974",
                                                "sense_id": "5a14484c-61b7-3967-80ec-a75916bd7b21",
                                                "text": "The whole position was so tremendous and so absolutely unearthly, that I believe it actually lulled our sense of terror, but to this hour I often see it in my dreams, and at its mere phantasy wake up covered with cold sweat."
                                            },
                                            {
                                                "example_id": "e3fdc3e7-c890-4986-9f0b-e10e469923a6",
                                                "sense_id": "5a14484c-61b7-3967-80ec-a75916bd7b21",
                                                "text": "Try as hard as it can, empirical science cannot come up with a naturalistic explanation; it can only slip into fantasies that make scientists feel good because they are in harmony with their opinions, prejudices, and unconscious assumptions about the nature of reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633188e6-782c-31c6-8c9e-1b88d8b916ac",
                                        "entry_id": "19d88710-af02-3672-a05b-c96c8b0b1dcc",
                                        "glosses": [
                                            "The literary genre generally dealing with themes of magic and the supernatural, imaginary worlds and creatures, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90d6dff3-3854-36ff-891f-7f49f619a884",
                                        "entry_id": "19d88710-af02-3672-a05b-c96c8b0b1dcc",
                                        "glosses": [
                                            "A fantastical design."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355eb6d8-fd39-49c2-b794-74508672f94f",
                                                "sense_id": "90d6dff3-3854-36ff-891f-7f49f619a884",
                                                "text": "Embroidered with fantasies and flourishes of gold thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3379de8b-25b6-31fd-9b5f-776eef47a33b",
                                        "entry_id": "19d88710-af02-3672-a05b-c96c8b0b1dcc",
                                        "glosses": [
                                            "The drug gamma-hydroxybutyric acid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fantasy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d94eb2-b3f7-3f70-aec0-80dd0dce4d2c",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To conceive (something) mentally; to imagine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d65fdc1-e973-342e-ade4-bc56a817bcfb",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To fantasize about something)."
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ecf349-408b-4e03-8e23-78e18c27b143",
                                                "sense_id": "4d65fdc1-e973-342e-ade4-bc56a817bcfb",
                                                "text": "Perhaps I would be able to help him recapture the well-being and emotional closeness he fantasied his brother had experienced with his parents prior to his birth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1232902e-4745-3a30-9f14-4f42ac29b7db",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To conceive mentally; to imagine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9a250a-8393-46b9-b399-9d7090dd437b",
                                                "sense_id": "1232902e-4745-3a30-9f14-4f42ac29b7db",
                                                "text": "Firſt I phantaſied that if I liſt to take vpon me the crowne and imperiall Scepter of the realme, now was the time propice and conuenient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                        "entry_id": "fe24b9f7-e0eb-31c0-b952-46a187a50c58",
                                        "glosses": [
                                            "To have a fancy for; to be pleased with; to like."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca19f5b0-7ab9-49d0-a83a-8b93af354eb6",
                                                "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                                "text": "Which he doth most fantasy."
                                            },
                                            {
                                                "example_id": "2d2c1f8d-6cf4-4956-bf39-2f98f9b34b32",
                                                "sense_id": "74e67f66-ee4f-3bec-932b-870751f7b547",
                                                "text": "The kyng fantasied so much his daughter Anne that almost everything began to grow out of frame and good order"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
