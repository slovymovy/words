        "fr-extract.jsonl": [
            {
                "entry_id": "82d66d55-4c10-382c-9227-f72a1108c56b",
                "word": "politiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "185e8575-d184-3db6-985f-e1b5ac9ede65",
                        "entry_id": "82d66d55-4c10-382c-9227-f72a1108c56b",
                        "glosses": [
                            "Du point de vue politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa4e32a-4786-4317-9fc1-3fac90eb7368",
                                "sense_id": "185e8575-d184-3db6-985f-e1b5ac9ede65",
                                "text": "[…] ; mais enfin, Fénelon luttait contre l’autocratie royale. Et Bossuet qui était un homme rampant, vous savez, c'était une carpette à l’égard du Roi, Bossuet avait considéré que Fénelon était un homme extrêmement dangereux politiquement."
                            },
                            {
                                "example_id": "68ebb097-c69c-4c76-baa8-abea39f44dec",
                                "sense_id": "185e8575-d184-3db6-985f-e1b5ac9ede65",
                                "text": "C’est ce qui permit à une minorité conquérante, politiquement et socialement dominante, de populations surtout chrétiennes, païennes et zoroastriennes, de consolider l’Islam et de soumettre rapidement les mondes sémitiques et iranien."
                            },
                            {
                                "example_id": "855f1954-38d3-4e6a-aae3-76dad3a17e59",
                                "sense_id": "185e8575-d184-3db6-985f-e1b5ac9ede65",
                                "text": "Aussi sombre que la Champagne sèche est claire, l'Ardenne lui a été rattachée politiquement, mais son terrain primaire ne s'accorde pas avec les couches tertiaires de notre province."
                            },
                            {
                                "example_id": "fc96231c-cf54-428c-a07a-cb8156c59f4b",
                                "sense_id": "185e8575-d184-3db6-985f-e1b5ac9ede65",
                                "text": "Le président Abdelaziz Bouteflika n'avait, à aucun moment, admis l'idée que l’Algérie et les Algériens étaient prêts, politiquement et culturellement, à vivre sous le régime de la démocratie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca8dbd6d-c475-3351-bcc4-f638c968403f",
                        "entry_id": "82d66d55-4c10-382c-9227-f72a1108c56b",
                        "glosses": [
                            "D’une manière fine, adroite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7a4758-bb09-48a6-bea9-e6c18a4a3480",
                                "sense_id": "ca8dbd6d-c475-3351-bcc4-f638c968403f",
                                "text": "Il agit politiquement en toutes choses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f44befe-295b-4b06-bcde-53a581aadd5e",
                        "source_entry_id": "82d66d55-4c10-382c-9227-f72a1108c56b",
                        "target_lang_word": "politically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63efc1eb-0dfc-368b-afad-b68d139415b6",
                                        "entry_id": "9d407114-ef6f-3a93-bb75-d3cd466b10a2",
                                        "glosses": [
                                            "In a political manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9e12f5-5709-4416-9664-3c8d83d45732",
                                                "sense_id": "63efc1eb-0dfc-368b-afad-b68d139415b6",
                                                "text": "tackle a matter politically"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                        "entry_id": "9d407114-ef6f-3a93-bb75-d3cd466b10a2",
                                        "glosses": [
                                            "Regarding politics, in a way connected to politics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c1c46c2-f674-4fe0-a35b-95b641da1f78",
                                                "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                                "text": "politically insensitive"
                                            },
                                            {
                                                "example_id": "afd9812a-5ebe-49fc-8d52-8d50f28c4273",
                                                "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                                "text": "a politically-charged speech"
                                            },
                                            {
                                                "example_id": "ae9590b7-a485-4cef-b471-a2c1466bf618",
                                                "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                                "text": "Although politically he claims to be a Democrat, his actions are more Republican."
                                            },
                                            {
                                                "example_id": "c698135d-dff6-4f08-a49b-df74fa3f1db0",
                                                "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                                "text": "Nevertheless intellectually, ideologically and politically he identified with industrialists whom he, just like Smith, saw as the usherers of progress."
                                            },
                                            {
                                                "example_id": "44745e1e-29c7-438d-b6ec-9455bc0a21fe",
                                                "sense_id": "48ec988d-a042-3c01-9b4c-3c1e17a7c975",
                                                "text": "Attorney General Merrick Garland said Thursday that when it comes to politically sensitive investigations, the Justice Department does “not shy away from cases that are controversial or sensitive or political.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
