                                    {
                                        "sense_id": "62fd6ce6-63f4-30c8-b352-35e44be9fad4",
                                        "entry_id": "165a9390-e54d-3113-a489-4f4f2ad5a279",
                                        "glosses": [
                                            "optisches Gerät zur Projektion nicht durchsichtiger Vorlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13018fca-54ff-4ded-b61b-6ab0d43851c4",
                                                "sense_id": "62fd6ce6-63f4-30c8-b352-35e44be9fad4",
                                                "text": "Unser Lehrer projizierte die Buchseite mit dem Episkop an die Tafel."
                                            },
                                            {
                                                "example_id": "06ee06a0-8fe9-4cd3-8f60-c3b56cd5311c",
                                                "sense_id": "62fd6ce6-63f4-30c8-b352-35e44be9fad4",
                                                "text": "„Wenn die Entwicklung nachgezeichnet wird, die von der Schiefertafel über das Episkop und den Overhead-Projektor bis zu \"Powerpoint\" führt, dann versteht man zwar, wie die alten Apparate in der jüngeren Technik in der Fixierung auf die \"Folie\" weiterleben - und auch, dass \"Powerpoint\" insofern einen Gewinn darstellt, als der Vortragende seinem Publikum in die Gesichter sehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
