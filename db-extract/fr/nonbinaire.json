                "senses": [
                    {
                        "sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                        "entry_id": "df8c8ae0-dce5-3334-a563-0db4bf95d4b7",
                        "glosses": [
                            "Dont l’identité de genre n’est pas strictement homme, ni strictement femme ; qui est hors de la binarité de genre."
                        ],
                        "tags": [
                            "Genres humains et identités de genre",
                            "Transitude",
                            "Non-binarité"
                        ],
                        "examples": [
                            {
                                "example_id": "c3a4396f-654f-4a20-a42a-ea65bff2de4c",
                                "sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                                "text": "Je suis nonbinaire (mon père a des origines séfarades et ma mère ashkénaze)"
                            },
                            {
                                "example_id": "f4105f7a-a983-4d28-b0ee-b8c8aba48a31",
                                "sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                                "text": "Ce faire bloquer dune conversation de groupe juste pour avoir dit etre nonbinaire gay\nEt envoyé cette photo (j'étais pas lea seul a mettre des selfie)\nL'admin m'a avoué m'avoir bloqué avec un petit hihi en commentaire...\nSa sens l’enbyphobie non?"
                            },
                            {
                                "example_id": "6cbf60fb-af09-4eb0-ab4d-758906f61aba",
                                "sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                                "text": "Vraiment... Je sais pas comment j'ai fait pour ne jamais m'être rendu compte que j'étais nonbinaire trans masc pendant toutes ses années tellement c'était obvious 🤔😂"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5992e10a-20de-4607-9651-1c22dabc6170",
                        "source_entry_id": "df8c8ae0-dce5-3334-a563-0db4bf95d4b7",
                        "source_sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                        "target_lang_word": "nichtbinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nichtbinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0796849f-2e74-3c57-99e0-003538f2bba3",
                                        "entry_id": "183901d1-0a03-3b5c-a8d3-24d5211adfcc",
                                        "glosses": [
                                            "nicht einem der beiden Geschlechter weiblich oder männlich zuzuordnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ad65b4-677c-4b43-b4c8-e9f9bd517d4e",
                                                "sense_id": "0796849f-2e74-3c57-99e0-003538f2bba3",
                                                "text": "Non-binär oder nichtbinär zu sein bedeutet, sich weder dem weiblichen noch dem männlichen Geschlecht zugehörig zu fühlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "008b874b-7592-43f0-ab6f-7fabaddf5ade",
                        "source_entry_id": "df8c8ae0-dce5-3334-a563-0db4bf95d4b7",
                        "source_sense_id": "a8b8f9fc-26c4-3f96-8efb-6755f42c34ca",
                        "target_lang_word": "abinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                        "entry_id": "6bcb25ef-c03e-3275-98fe-648acee62845",
                                        "glosses": [
                                            "nicht (ausschließlich) eine weibliche oder männliche Geschlechtsidentität aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f847681-a422-4268-a5fb-4d7816ecf3ab",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Wir bedanken uns bei allen abinären Geschwistern, die vor uns kamen und auch bei denen, die nach uns kommen werden.“"
                                            },
                                            {
                                                "example_id": "613a774b-b0c0-45cc-9a2a-fbb9410570dd",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Abinäre Menschen können z. B. mehrere Geschlechter haben, genderqueer sein oder ein Geschlecht haben, das weder Mann noch Frau ist.“"
                                            },
                                            {
                                                "example_id": "6fae1bc0-525a-46eb-b3ca-78be2e3c3084",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„In dem Vortrag werden Begriffe, die oft in Zusammenhang mit geschlechtlicher Vielfalt auftauchen, wie inter*, trans*, divers und abinär leicht verständlich erklärt.“"
                                            },
                                            {
                                                "example_id": "4e845523-a050-4a07-ba86-b81a7c9dba9b",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Das heißt abinäre Menschen können sich als ‚sowohl männlich als auch weiblich‘ oder als ‚weder männlich noch weiblich‘ verstehen oder das zweigeschlechtliche Konstrukt gänzlich ablehnen.“"
                                            },
                                            {
                                                "example_id": "ad910780-7980-4774-a3a5-9f5864252715",
                                                "sense_id": "ee0a9aab-371d-3dc6-8fbf-5f13524a1349",
                                                "text": "„Zum Beispiel haben nicht alle abinären Menschen auch einen geschlechtsneutral interpretierten Namen oder/und nutzen für sich im Alltag weibliche oder männliche Pronomen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "defaf517-0e2f-4f95-a20c-27e22359ceef",
                        "source_entry_id": "df8c8ae0-dce5-3334-a563-0db4bf95d4b7",
