                "senses": [
                    {
                        "sense_id": "76334fd4-68ed-367c-b8b2-33b534f727d5",
                        "entry_id": "dd4ff730-a241-3b20-a37a-244fea71bcb8",
                        "glosses": [
                            "Partie du méroplancton composée d’œufs et de larves de poissons, flottant et dérivant."
                        ],
                        "tags": [
                            "Hydrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4cfade-baaa-4236-81d2-1ce1ed70bcbf",
                                "sense_id": "76334fd4-68ed-367c-b8b2-33b534f727d5",
                                "text": "Les œufs des poissons vivant en haute mer flottent, sont très petits et facilement emportés par le courant. Ils restent dans la colonne d’eau et font partie de l’ichtyoplancton."
                            },
                            {
                                "example_id": "0e3bed9c-a47f-41fe-80b7-f4a24997822e",
                                "sense_id": "76334fd4-68ed-367c-b8b2-33b534f727d5",
                                "text": "Une des méthodes standard en halieutique est le suivi de l’ichtyoplancton."
                            },
                            {
                                "example_id": "79f9f0ce-fd5e-480e-a3df-80d71a9a3da0",
                                "sense_id": "76334fd4-68ed-367c-b8b2-33b534f727d5",
                                "text": "Les deux cadres de recherche en ichtyoplancton étudient le déterminisme de la variabilité spatio-temporelle des zones fonctionnelles importantes pour les populations de poissons comme les frayères et les zones de dérive larvaire."
                            }
                        ]
                    }
                ],
