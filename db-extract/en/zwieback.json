                ],
                "senses": [
                    {
                        "sense_id": "f74cddd6-b83e-378f-86e9-2e82982ef36c",
                        "entry_id": "4d019aff-d845-3a01-9c44-5b1ceff06e3b",
                        "glosses": [
                            "A form of rusk, usually sweetened bread enriched with eggs that is baked and then sliced and toasted until dry and crisp; considered easy to digest and therefore given to the ill and used as a teething food for toddlers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "899983d4-77f7-4d58-8a91-e90720c3c589",
                                "sense_id": "f74cddd6-b83e-378f-86e9-2e82982ef36c",
                                "text": "Ogden Nash, Adventures Of Isabel\nShe nibbled the zwieback that she always fed off,\nAnd when it was gone, she cut the giant's head off."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5f482cf-5d8a-4234-9318-38aa589d4ad4",
                        "source_entry_id": "4d019aff-d845-3a01-9c44-5b1ceff06e3b",
                        "source_sense_id": "f74cddd6-b83e-378f-86e9-2e82982ef36c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Zwieback",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwieback",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                        "entry_id": "d37ee3f1-8fb0-3d48-87b3-92b3d66ed6d9",
                                        "glosses": [
                                            "süßes Brot, das zunächst einmal gebacken (Einback), dann in Scheiben geschnitten und zum zweiten Mal gebacken (geröstet) wird, bis es trocken und knusprig ist; haltbare, knusprige Brotscheibe, heute meistens als leicht verdauliche Brotscheiben für Kinder und Kranke, zum Beispiel als Zwiebackbrei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d85676a-8c87-4215-9921-67a260a74e9f",
                                                "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                                "text": "Mit pikanten Dips und Cremes ist Zwieback eine leckere (und leichtere) Alternative zu Chips."
                                            },
                                            {
                                                "example_id": "9a465a98-a186-45ac-bb6b-f59d37c62123",
                                                "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                                "text": "„Sie aßen Zwieback, tranken Tee und sprachen über das Wetter.“"
                                            },
                                            {
                                                "example_id": "b7210fa4-8d99-4769-aecc-9ca55e33b734",
                                                "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                                "text": "„Jetzt wurde an die Soldaten reichlich Zwieback ausgegeben und sogar den anderen Schwadronen wurde von den erbeuteten Vorräten mitgeteilt.“"
                                            },
                                            {
                                                "example_id": "83e65277-e968-4b98-9e5e-7923af18177f",
                                                "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                                "text": "„Ein Stück gerösteten Zwiebacks im Mund, war sie nach unten in die Küche geeilt.“"
                                            },
                                            {
                                                "example_id": "7e91dcf5-470a-4676-9c06-2a21d9bf5d45",
                                                "sense_id": "b5cef835-6d53-3944-a956-119c942e4010",
                                                "text": "„Zum Frühstück gibt es eine Dose Ölsardinen und Zwieback, zwei Mitbringsel aus seiner eigenen Küche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
