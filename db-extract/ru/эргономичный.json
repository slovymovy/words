                "senses": [
                    {
                        "sense_id": "45d6233d-bd69-37ee-ba16-643583cca4e1",
                        "entry_id": "dec6256a-fbfc-3b1d-851c-766d1199c83e",
                        "glosses": [
                            "книжн. соответствующий требованиям эргономики; приспособленный для наиболее удобной и безопасной работы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd9eb7a-ad3e-4e63-9e63-bd57f6dd5297",
                                "sense_id": "45d6233d-bd69-37ee-ba16-643583cca4e1",
                                "text": "Именно этот тезис и лежит в основе философии построения эргономичного рабочего места."
                            },
                            {
                                "example_id": "a9c07cfe-8e57-429c-a37c-3b1532ad2d97",
                                "sense_id": "45d6233d-bd69-37ee-ba16-643583cca4e1",
                                "text": "Язык арабских чисел победил потому, что его алфавит и синтаксис оказались более эргономичными, т.е. более удобными, обеспечив максимальную «лёгкость мышления» при выполнении арифметических действий."
                            }
                        ]
                    }
