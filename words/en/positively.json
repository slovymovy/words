                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can state <w>positively</w> that he was not at home last night.",
                            "target_lang_translations": {
                                "ru": "Я могу <w>с уверенностью</w> заявить, что прошлой ночью его не было дома.",
                                "zh": "我可以<w>确定</w>地说，他昨晚不在家。",
                                "es": "Puedo afirmar <w>con seguridad</w> que él no estaba en casa anoche.",
                                "tr": "Dün gece evde olmadığını <w>kesinlikle</w> söyleyebilirim.",
                                "de": "Ich kann <w>sicher</w> sagen, dass er gestern Abend nicht zu Hause war.",
                                "nl": "Ik kan <w>met zekerheid</w> zeggen dat hij gisteravond niet thuis was.",
                                "pl": "Mogę <w>z całą pewnością</w> stwierdzić, że nie było go wczoraj w domu.",
