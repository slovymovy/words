                ],
                "senses": [
                    {
                        "sense_id": "6f78aee3-3ef3-3baa-b95d-d8cb34aa1c8e",
                        "entry_id": "a8812fe3-7351-3d92-9171-01ecbb59ffde",
                        "glosses": [
                            "half-time celebration (of a project, course, etc.)"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5183327c-b54f-4566-b1af-12649a6eeea9",
                                "sense_id": "6f78aee3-3ef3-3baa-b95d-d8cb34aa1c8e",
                                "text": "Das Bergfest! Wenn von den sechs Seminarsemestern drei verflossen waren und also der Berg des Ärgernisses bis zum Gipfel überwunden war, pflegte man das »Bergfest« zu feiern. Und diesmal sollten der Direktor und alle Lehrer dazu geladen werden."
                            },
                            {
                                "example_id": "f3ee6b94-aa01-492a-9631-16ac328100d1",
                                "sense_id": "6f78aee3-3ef3-3baa-b95d-d8cb34aa1c8e",
                                "text": "Seit vielen Jahren hat jeder Jahrgang der letztverbliebenen deutschen Telekomhochschule eine kleine Skulptur selbst entworfen, gestaltet und bei dem Bergfest zur Mitte des Studiums präsentiert."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6eda05d-c582-335c-9a6f-cf1aafd35ec6",
                        "entry_id": "a8812fe3-7351-3d92-9171-01ecbb59ffde",
                        "glosses": [
                            "mountain feast"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "6e7db6be-af62-45c8-9f22-e72cd92aa348",
                                "sense_id": "a6eda05d-c582-335c-9a6f-cf1aafd35ec6",
                                "text": "Wilhelm wurde darauf vom Gehülfen und Aufseher zu einem Bergfest eingeladen, welches zunächst gefeiert werden sollte. Sie erstiegen mit Schwierigkeit das Gebirg, Wilhelm glaubte sogar zu bemerken, daß der Führer gegen Abend sich langsamer bewegte, als würde die Finsternis ihrem Pfad nicht noch mehr Hinderung entgegensetzen.",
                                "translation": "Wilhelm Meister's Journeyman Years",
                                "english": "Wilhelm Meister's Journeyman Years"
                            }
                        ]
                    }
                ],
