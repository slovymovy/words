                        "glosses": [
                            "жилет, защищающий от пуль, ножевых ударов и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac25bda1-240b-4cd6-9168-eca9e1a337f1",
                                "sense_id": "7f83112c-83ad-3c0e-bf2e-1f4f597c0a75",
                                "text": "Поверх офицерского бушлата теперь на нем был бронежилет, а в руках ― милицейская портативная рация."
                            }
                        ]
                    }
