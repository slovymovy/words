                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23963dd-cae7-486e-8330-23bac4f19210",
                                "sense_id": "7d7d781c-4fb8-30fd-8194-be5a92ee6fa2",
                                "text": "Maandag debatteert de Tweede Kamer over de cultuurbegroting. De cultuurraad roept daarom nog een keer op: komt écht met meer geld over de brug. Zonder extra steun dreigen instellingen om te vallen, zegt voorzitter Kristel Baele tegen Nieuwsuur. \"De sector is wendbaar gebleken maar niet weerbaar.\""
                            }
