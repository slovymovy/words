                    "sense_id": "e6290a11-c199-36a8-8be1-d6d2481e3b8e",
                    "sense_definition": "geen helder stemgeluid kunnen produceren, vaak door verkoudheid of schreeuwen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stemgeluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het concert van gisteravond was ik de volgende ochtend behoorlijk <w>hees</w>.",
                            "target_lang_translations": {
                                "en": "After last night's concert, I was quite <w>hoarse</w> the next morning."
                            }
                        },
                        {
                            "text": "Je klinkt nogal <w>hees</w>, heb je soms een kou gevat?",
                            "target_lang_translations": {
                                "en": "You sound rather <w>hoarse</w>, have you caught a cold by any chance?"
                            }
