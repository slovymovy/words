                    },
                    {
                        "sense_id": "48e0df12-ac92-33bb-9824-e18b1f633930",
                        "entry_id": "21a14f89-94c0-3374-a374-a4c84f5ae30b",
                        "glosses": [
                            "hoe men de rol van een bepaalde functie of persoon vorm geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8c40d8b-98ff-4484-b25c-3cb9c0acfdd8",
                                "sense_id": "48e0df12-ac92-33bb-9824-e18b1f633930",
                                "text": "“Juist de burgemeesters weten wat er speelt in de gemeente en aan welke inzet behoefte is. Er gaat veel goed bij de inzet, maar in het bestuurlijk bestel waarin de inzet van de politie wordt bepaald, zou de inkleding van de burgemeester beter kunnen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "c9e1fc14-888d-38b0-815c-80cce94667eb",
                        "entry_id": "21a14f89-94c0-3374-a374-a4c84f5ae30b",
                        "glosses": [
                            "de inrichting van een ruimte of een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2717e7d9-cef0-44d7-9a2f-f80a66552112",
                                "sense_id": "c9e1fc14-888d-38b0-815c-80cce94667eb",
                                "text": "‘Dit jaar wilden we echt inzetten op de sfeer en inkleding’, vervolgt de student. ‘We wilden een totale ervaring creëren, zodat de studenten zich niet meer in Leuven wanen wanneer ze toekomen. Denk maar aan Tomorrowland.’"
                            },
                            {
                                "example_id": "03009096-796d-44fd-a6e9-70cb23dc3ce6",
                                "sense_id": "c9e1fc14-888d-38b0-815c-80cce94667eb",
                                "text": "De rondgang loopt langs vijf ruimten in ‘een Ensoriaanse sfeer’. Voor de inkleding daarvan werkt het bureau Madoc alleen met reproducties."
                            }
                        ]
                    }
