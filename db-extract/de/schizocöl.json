                "senses": [
                    {
                        "sense_id": "279cb860-46e0-34e8-901c-435ec2e8e922",
                        "entry_id": "710ae850-e15c-314b-8360-cde94c67f2d4",
                        "glosses": [
                            "die Bezeichnung für den von der primären Leibeshöhle abgeleiteten Raum zwischen Körperwand und Darm, der bis auf spaltförmige verbleibende Hohlräume vom Mesoderm (mittleres Keimblatt) abstammenden Gewebe ausgefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42203b8-db5f-4627-96bc-2206ae4dcf52",
                                "sense_id": "279cb860-46e0-34e8-901c-435ec2e8e922",
                                "text": "„Ich glaube nun aber auch gar nicht, daß wir von einem Schizocöl reden können. Bei Ascaris ist der ganze Raum zwischen Muskulatur und Organen von den Lamellen des Isolationsgewebes erfüllt, und wo scheinbar große Schizocölräume vorhanden sind, liegen sie innerhalb dieses Gewebes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
