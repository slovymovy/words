                            {
                                "example_id": "63f29ba4-0cd0-4aaa-b6c4-ecb594687049",
                                "sense_id": "d4fb19b4-5d43-30a3-a20a-cefb6c43cc2b",
                                "text": "Par toy vient la chaleur aux verdissautes prées, Vient la vie aux troupeaux, à l'oiseau ramageux"
