                        "entry_id": "866cc1db-886b-349c-ad2b-c5ec93cf111c",
                        "glosses": [
                            "To draw aside or open; to pull back a layer of fabric, e.g. a curtain."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5b8102bf-38b2-4d14-93f6-120e1540c41e",
                                "sense_id": "8e9b0bca-ec59-3003-a986-f19a7d0f7739",
                                "text": "She undrew the curtain to reveal the shining rays of the sun."
                            }
                        ]
                    },
                    {
                        "sense_id": "edd185c9-55da-33d1-8dfb-b43b99f79d4f",
                        "entry_id": "866cc1db-886b-349c-ad2b-c5ec93cf111c",
                        "glosses": [
                            "To clear or erase part of a drawing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "80af04be-2a5f-4da9-9ad8-3db899fb9de5",
                                "sense_id": "edd185c9-55da-33d1-8dfb-b43b99f79d4f",
                                "text": "It is easy to highlight graphics on a monochrome system. The simplest way is to set the GC to the GXxor logical function and draw your graphics once to draw them and again to undraw them."
                            }
                        ]
                    }
