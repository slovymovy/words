                        "glosses": [
                            "plaats waar mensen of dieren kunnen verblijven die (tijdelijk) niet (meer) in hun eigen huis kunnen wonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e86113e-1f85-4321-9b9a-d394ac724ee1",
                                "sense_id": "25a7fab7-d5de-3522-bf8e-1ed06b54e467",
                                "text": "Van de slachtoffers is de identiteit niet bekend. Waarschijnlijk komen ze uit Vietnam. Ze zijn naar een opvangadres gebracht."
                            },
                            {
                                "example_id": "32bfd7ce-2fbd-4276-8728-856331b09ffc",
                                "sense_id": "25a7fab7-d5de-3522-bf8e-1ed06b54e467",
                                "text": "De verdachte is de vriend van de moeder. Hij is niet de vader van het kind. Jeugdzorg heeft de andere drie minderjarige kinderen van de vrouw naar een ander opvangadres gebracht."
                            },
                            {
                                "example_id": "0b3d4ee8-8ecc-4088-82d1-9dc2233bd22d",
                                "sense_id": "25a7fab7-d5de-3522-bf8e-1ed06b54e467",
                                "text": "De hond is overgebracht naar een opvangadres waar hij een speciaal voedselprogramma krijgt om aan te sterken. Of de Stafford na behandeling terug mag naar de eigenaar is niet bekend. De eigenaar draait op voor alle kosten die gemaakt worden."
                            }
                        ]
                    }
