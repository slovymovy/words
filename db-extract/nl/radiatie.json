                                        "entry_id": "74932da2-edfb-32d9-9265-3479f8e6a09d",
                                        "glosses": [
                                            "Action de rayer, de radier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2ec78f-f4c0-4489-ae1b-ff0ac99836a2",
                                                "sense_id": "01b14964-9349-3788-8a60-189fa2f10c10",
                                                "text": "Solliciter, obtenir sa radiation d’un rôle de contributions."
                                            },
                                            {
                                                "example_id": "29d4d0b6-389e-4494-8957-c8d0da9a5ef7",
                                                "sense_id": "01b14964-9349-3788-8a60-189fa2f10c10",
                                                "text": "Sa radiation des cadres de l’armée a été prononcée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99c059ef-45e7-3da3-ae48-2a163459cead",
                                        "entry_id": "74932da2-edfb-32d9-9265-3479f8e6a09d",
                                        "glosses": [
                                            "Action de rayer, de radier.",
                                            "Suppression, annulation d’un article, d’un compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd05ce2-e1e2-4b63-a8cf-b6de380f29e6",
                                                "sense_id": "99c059ef-45e7-3da3-ae48-2a163459cead",
                                                "text": "Cet article est sujet à radiation."
                                            },
                                            {
                                                "example_id": "4d48d823-91f5-4af9-adf3-66b07c86c5d3",
                                                "sense_id": "99c059ef-45e7-3da3-ae48-2a163459cead",
                                                "text": "La radiation de l’écrou d’une personne détenue injustement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b6c9335-66c3-3e27-9228-a01037216d0b",
                                        "entry_id": "74932da2-edfb-32d9-9265-3479f8e6a09d",
                                        "glosses": [
                                            "Action de rayer, de radier.",
                                            "Biffure dans un acte, d’un écrit, pour l’annuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2ba3b3-50d7-4476-879a-acd8dfc1a2a0",
                                                "sense_id": "0b6c9335-66c3-3e27-9228-a01037216d0b",
                                                "text": "La radiation d’une inscription hypothécaire."
                                            },
                                            {
                                                "example_id": "862b65ea-f286-4f3f-baa7-abeff9e47b47",
                                                "sense_id": "0b6c9335-66c3-3e27-9228-a01037216d0b",
                                                "text": "On a fait plusieurs radiations sur ses comptes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radiation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96d5faab-37f6-33f6-b93d-3896ab88b0f9",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Propagation de l’énergie à partir d’une source rayonnante, sous forme d’ondes électromagnétiques ou de particules."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab91073-664c-410b-88ca-1fb115101219",
                                                "sense_id": "96d5faab-37f6-33f6-b93d-3896ab88b0f9",
                                                "text": "Dans l’espace, de graves dangers nous guettent, parmi lesquels : micrométéorites, radiations cosmiques mortelles et vieillissement accéléré en apesanteur."
                                            },
                                            {
                                                "example_id": "ef442808-7224-443b-8a8b-60824ec5089f",
                                                "sense_id": "96d5faab-37f6-33f6-b93d-3896ab88b0f9",
                                                "text": "Dans le cas du chauffage d’un solide par radiation, la transmission de chaleur sera une combinaison de radiation et de conduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61012dea-002c-3f11-afda-f07f46b1f856",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Énergie ainsi émise et propagée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "758649f5-fcb2-47f5-855a-fbf1c53e0b75",
                                                "sense_id": "61012dea-002c-3f11-afda-f07f46b1f856",
                                                "text": "Radiations lumineuses."
                                            },
                                            {
                                                "example_id": "40953969-d5b8-4078-9d6a-0db983778a0c",
                                                "sense_id": "61012dea-002c-3f11-afda-f07f46b1f856",
                                                "text": "Radiations ultraviolettes."
                                            },
                                            {
                                                "example_id": "6fe4eb73-6eae-4914-99a0-e2a67a2819a2",
                                                "sense_id": "61012dea-002c-3f11-afda-f07f46b1f856",
                                                "text": "Radiations électromagnétiques."
                                            },
                                            {
                                                "example_id": "b98b31b7-05bc-42dd-b1fe-aa92c66b9f3b",
                                                "sense_id": "61012dea-002c-3f11-afda-f07f46b1f856",
                                                "text": "Les radiations absorbées par la feuille de verre portée à température de la pièce, sont réémises selon une loi de corps noir. Le verre ne constitue donc qu'une barrière faible au rayonnement et se comporte comme un corps noir quasi parfait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a44eba9-161a-3cec-8c8c-cc9efc42940d",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Énergie ainsi émise et propagée.",
                                            "Énergie rayonnante émise par le soleil."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e98bb3-6acc-4c3e-abd6-479f28132160",
                                                "sense_id": "1a44eba9-161a-3cec-8c8c-cc9efc42940d",
                                                "text": "Les mesures du rayonnement solaire direct donnent (...) des résultats moins précis que celles de la radiation globale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36b26b3a-dee0-3210-a496-3c8fa1d9ed4c",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Énergie ainsi émise et propagée.",
                                            "Énergie radioactive des rayons X."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13edabec-f877-4124-a585-eb5f2d8c8716",
                                                "sense_id": "36b26b3a-dee0-3210-a496-3c8fa1d9ed4c",
                                                "text": "La radiothérapie est une méthode de traitement locorégional des cancers, utilisant des radiations pour détruire les cellules cancéreuses."
                                            },
                                            {
                                                "example_id": "aa8964b3-9b7a-4cee-a820-240af1af0bb5",
                                                "sense_id": "36b26b3a-dee0-3210-a496-3c8fa1d9ed4c",
                                                "text": "En France, la réglementation fixe les limites annuelles de radiation à 20 millirems pour les travailleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33cdaf1-ead8-3558-814a-9c77ce1f33e3",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Chacune des lignées divergentes selon lesquelles a évolué un organe animal ou végétal le long des divers phylums."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb5d498-9b97-4f8f-9152-964793698a60",
                                                "sense_id": "f33cdaf1-ead8-3558-814a-9c77ce1f33e3",
                                                "text": "Les acquisitions de ventouses, de sabots, de griffes rétractiles, etc., sont des radiations adaptatives de l’extrêmité des doigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf21bc20-a41a-34a0-a883-f8ea34b92b5a",
                                        "entry_id": "0d8825c7-5f57-3885-b698-d5db365880f9",
                                        "glosses": [
                                            "Force obscure ou inexpliquée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d93ff2-9bb8-4335-aa45-27d0427e0541",
                                                "sense_id": "bf21bc20-a41a-34a0-a883-f8ea34b92b5a",
                                                "text": "Une radiation télépathique."
                                            }
                                        ]
                                    }
                                ]
                            }
