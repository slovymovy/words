                        ],
                        "form": "die Besinnungslosigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
                        "entry_id": "79c03ade-095e-357c-b4c0-2b28d6202b20",
                        "glosses": [
                            "Zustand, bewusstlos zu sein/nicht bei Bewusstsein zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "913d54e6-787a-4b21-9ef0-67fb9fd455d9",
                                "sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
                                "text": "Der Mann soll sein Opfer bis zur Besinnungslosigkeit gewürgt haben."
                            },
                            {
                                "example_id": "33d30459-23e0-4ebf-a027-ffb62ef6acb4",
                                "sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
                                "text": "Dass Jugendliche bis zur Besinnungslosigkeit saufen, ist leider kein Einzelphänomen."
                            },
                            {
                                "example_id": "e08616a6-4ebd-457a-ba27-8127557095bc",
                                "sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
                                "text": "Ihr erster Rausch endet an diesem Abend in der Besinnungslosigkeit."
                            },
                            {
                                "example_id": "3d5a723a-9bc7-4146-9424-9149e31fa826",
                                "sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
                                "text": "„Bei seiner Arbeit war er genötigt, auf das Mittagessen zu verzichten, denn er liebte es, sich bis zur völligen Besinnungslosigkeit zu betrinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8099108-753b-4c1d-9380-6d03347d010d",
                        "source_entry_id": "79c03ade-095e-357c-b4c0-2b28d6202b20",
                        "source_sense_id": "326fff4c-8b08-39cb-8ba8-b5784d7253ea",
