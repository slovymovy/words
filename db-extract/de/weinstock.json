                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "593162c7-2516-3975-a0dd-b5f039b02334",
                                        "entry_id": "6603920a-f9c2-3580-acb3-64c1fa1dfd46",
                                        "glosses": [
                                            "Ancien type de menottes, instrument d’entrave enfermant le poignet d’un prisonnier dans un pont métallique fermé par une tige filetée droite. Surtout utilisé au pluriel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47085b07-621b-4624-8326-84bc029ff05e",
                                                "sense_id": "593162c7-2516-3975-a0dd-b5f039b02334",
                                                "text": "Vous montreriez peu de respect, manifesteriez une trop hardie malice contre la gracieuseté, la majesté de votre maître, en mettant aux ceps son messager."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cdb14ba-437f-438e-abae-02c6e545f8fd",
                        "source_entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "source_sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                        "source_sense_description": "Weinbau: eine einzelne Pflanze der Weinrebe",
                        "target_lang_word": "cep de vigne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cep de vigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f24953f0-99b1-3cbe-920f-2e9083cbd2db",
                                        "entry_id": "59939422-286a-34fc-9b61-a4a2207d35dc",
                                        "glosses": [
                                            "Pied de vigne."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ccb88ca-3731-4102-a217-e8b728bd68c6",
                                                "sense_id": "f24953f0-99b1-3cbe-920f-2e9083cbd2db",
                                                "text": "J’ai gravi tes sentiers rocailleux en serrant\nDans ma droite un long cep de vigne centenaire,\nJ’ai dormi sur le seuil des petits sanctuaires,\nLes mules aux longs yeux me frôlaient en passant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c21828b-6558-36f5-90a9-62b72f082c51",
                                        "entry_id": "59939422-286a-34fc-9b61-a4a2207d35dc",
                                        "glosses": [
                                            "Tronc de vigne coupé ou arraché et laissé à sécher, utilisé pour démarrer un feu, barbecue, cheminée…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca09807-74af-4b87-aff7-0cf37e41cc80",
                                                "sense_id": "5c21828b-6558-36f5-90a9-62b72f082c51",
                                                "text": "Le souper fini, tout le monde se groupe près du foyer où flambe un feu clair d’ajoncs séchés, de ceps de vigne, et l’on croque des marrons cuits sous la cendre, en les arrosant du petit vin blanc du pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dbaecb3-3705-32ed-a5d6-484694647efa",
                                        "entry_id": "59939422-286a-34fc-9b61-a4a2207d35dc",
                                        "glosses": [
                                            "Motif ornemental utilisé comme décor dans différents courants artistiques tels que la sculpture, peinture, tapisserie, papier peint…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f35954c-ff93-4f15-a172-f4123ab5f9d9",
                                                "sense_id": "2dbaecb3-3705-32ed-a5d6-484694647efa",
                                                "text": "La seconde [cuve] (long. 2,05-2 m ; haut. 0,48 m) est divisé en 8 panneaux par des moulures et ornée sur les registres supérieurs de ceps de vigne et inférieurs d’enroulement de feuilles de vigne, les petits côtés de feuilles de lierre en 4 panneaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f06c8327-05a0-357b-8606-892ab32fa99f",
                                        "entry_id": "59939422-286a-34fc-9b61-a4a2207d35dc",
                                        "glosses": [
                                            "Meuble représentant le pied de vigne du même nom dans les armoiries. Il est dit pampré quand le tronc et garni de feuilles et fruité quand les grappes sont d'un autre émail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c21a1d8-8c6c-4713-97dc-e7fb165beaef",
                                                "sense_id": "f06c8327-05a0-357b-8606-892ab32fa99f",
                                                "text": "Écartelé : aux 1 et 4, d’argent au cep de vigne pampré de sinople, fruité de deux grappes de gueules, soutenu de son échalas au naturel et terrassé de sable ; aux 2 et 3, de gueules à trois annelets d’argent qui est de la commune d’Hurigny de Saöne et Loire → voir illustration « armoiries avec 2 ceps de vigne »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b162966-7168-4e00-a002-49c438178ce4",
                        "source_entry_id": "61795b5b-253d-34e9-a34a-579ee6b7a017",
                        "source_sense_id": "eeb37262-1fe6-35cc-bd3b-3ff7c8490857",
                        "source_sense_description": "Weinbau: eine einzelne Pflanze der Weinrebe",
                        "target_lang_word": "wijnstok",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wijnstok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e50cad-4560-3f9d-87c5-3abc0102fc41",
                                        "entry_id": "e0d52b32-e8f0-3588-95a3-2d155dfa4c53",
                                        "glosses": [
                                            "Vitis vinifera klimplant uit de wijnstokfamilie met handvormige bladeren en geel-groenachtige bloemen, die de druif als vrucht voortbrengt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272e8804-4648-4b3a-98f7-968be9ad36f9",
                                                "sense_id": "b3e50cad-4560-3f9d-87c5-3abc0102fc41",
                                                "text": "Op een korte wandeling van Circus Maximus vind je de Aventijn, één van de zeven heuvels van Rome. Voor een aangename verrassing gluur je bovenaan de heuvel door het bescheiden koperen sleutelgat van de deuren van de Priorito dei Cavalieri di Malta (priorij van de orde der Maltezer ridders). Je krijgt een perfect plaatje van de Sint-Pietersbasiliek te zien, ingekaderd door een boog van wijnstokken."
                                            },
                                            {
                                                "example_id": "ddeb409c-5f07-4b11-a4d1-29885514b6ce",
                                                "sense_id": "b3e50cad-4560-3f9d-87c5-3abc0102fc41",
                                                "text": "Druiven en veel - héél veel - hazelnootbomen. We zitten in het hart van de Piemonte, het gebied tussen de zeer toeristische Bloemenrivièra en Zwitserland. De eindeloze rijen wijnstokken en hazelnootbomen verraden de producten van deze streek: wijn en hazelnootpasta, oftewel Nutella. Vooral de wijn is bekend. Alleen de wijnhuizen in het gebied rond het plaatsje Barolo mogen hun wijnen van het stempel Barolo voorzien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
