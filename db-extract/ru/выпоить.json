                        "entry_id": "80059e43-6f05-332c-82d1-b8404ece779e",
                        "glosses": [
                            "(о животных) выкормить жидкой пищей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b31b1eb-d939-4269-87d0-2bc1799beb94",
                                "sense_id": "0fec026e-ddb8-3492-ae80-1e2a1db3ee46",
                                "text": "Выпоить телят."
                            },
                            {
                                "example_id": "f1f8dd07-5f7c-4623-aeee-50f0630db83a",
                                "sense_id": "0fec026e-ddb8-3492-ae80-1e2a1db3ee46",
                                "text": "Выпоить бычка молоком."
