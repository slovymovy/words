                        "sense_id": "4e97ab78-006e-3db6-9491-16250d5f884f",
                        "entry_id": "46ce2304-a36e-379b-a76d-c77c530669eb",
                        "glosses": [
                            "Mann, der achtzig Jahre alt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8747a3-735d-4ede-9f8a-332720824a6e",
                                "sense_id": "4e97ab78-006e-3db6-9491-16250d5f884f",
                                "text": "„Wie gesagt, das erzählte ein Achtzigjähriger einem Mittdreißiger (Zanuck/Wilder), der mir nun seine Geschichte erzählte, als er selbst achtzig war und ich dreißig Jahre jünger.“"
                            },
                            {
                                "example_id": "68c31fde-cc05-4156-b64c-85706c12dcbd",
                                "sense_id": "4e97ab78-006e-3db6-9491-16250d5f884f",
                                "text": "„Ein Achtzigjähriger sucht zum Jahres-Check-Up seinen Hausarzt auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
