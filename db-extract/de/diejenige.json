                ],
                "senses": [
                    {
                        "sense_id": "4fc19090-16f6-3611-ae26-7617a35ec41b",
                        "entry_id": "3e081807-63c8-383d-b5f2-3f9dd01a45e3",
                        "glosses": [
                            "Nominativ Singular Feminin des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b16b813-93db-446c-a1a9-9f85003c9bac",
                                "sense_id": "4fc19090-16f6-3611-ae26-7617a35ec41b",
                                "text": "„Während dieses Gesprächs stand diejenige, von welcher die Rede war, am Fenster und hatte der fortrollenden Kutsche nachgesehen“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fdbc970e-da0b-37b8-aca3-df787d702595",
                        "entry_id": "3e081807-63c8-383d-b5f2-3f9dd01a45e3",
                        "glosses": [
                            "Akkusativ Singular Feminin des Demonstrativpronomens derjenige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64550954-20f1-4594-9bd5-79a36f9ad44b",
                                "sense_id": "fdbc970e-da0b-37b8-aca3-df787d702595",
                                "text": "„\"Ich würde damit\", erwiderte ich, \"diejenige Periode des Wachstums bezeichnen, wo der Charakter, der diesem oder jenem Geschöpf eigentümlich ist, vollkommen ausgeprägt erscheint.\"“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
