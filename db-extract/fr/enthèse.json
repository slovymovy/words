                ],
                "senses": [
                    {
                        "sense_id": "a61fb76b-e2a8-3494-9649-6a9725a04347",
                        "entry_id": "c7e38e2a-fd08-3931-bb34-4d6534a475c7",
                        "glosses": [
                            "Insertion des ligaments, tendons et aponévroses musculaires dans l'os."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0f1f13-0f19-4e8d-8d49-43c8b876078a",
                                "sense_id": "a61fb76b-e2a8-3494-9649-6a9725a04347",
                                "text": "Les spondylarthropathies se caractérisent par l’existence d’une atteinte inflammatoire des enthèses (enthésite ou enthésiopathie inflammatoire), c’est-à-dire de la zone d’insertion tendineuse, capsulaire ou ligamentaire sur l’os."
                            },
                            {
                                "example_id": "2af64b0d-f135-4a15-939e-b343f19620ee",
                                "sense_id": "a61fb76b-e2a8-3494-9649-6a9725a04347",
                                "text": "Dans tous les cas, la cible élective de la réaction inflammatoire semble être l’enthèse, zone d’insertion des tendons, des ligaments, des capsules et des fascias dans l’os."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa131ebc-f629-4a24-be9e-518edbedefb6",
                        "source_entry_id": "c7e38e2a-fd08-3931-bb34-4d6534a475c7",
                        "source_sense_id": "a61fb76b-e2a8-3494-9649-6a9725a04347",
                        "target_lang_word": "enthesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6dce9c-1f75-3596-8f59-b7e992a3bb08",
                                        "entry_id": "20b6e314-ce10-3fa0-9df3-7fbd8230bcaa",
                                        "glosses": [
                                            "The insertion point at which a tendon, ligament, or muscle inserts into a bone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5cd6c7e-74c0-4300-9f9f-575782d10fec",
                                                "sense_id": "2e6dce9c-1f75-3596-8f59-b7e992a3bb08",
                                                "text": "Like arthritis, peripheral enthesitis occurs predominantly in the lower extremities, particularly in the foot, at single sites at onset, and then at several entheses throughout the course of the disease."
                                            },
                                            {
                                                "example_id": "34cb0eb5-faa5-4cd5-9f00-638877d62a5d",
                                                "sense_id": "2e6dce9c-1f75-3596-8f59-b7e992a3bb08",
                                                "text": "Functional entheses occur where tendinous and ligamentous structures, while not actually attaching to bone, are adjacent and in a close relationship to the underlying bone."
                                            },
                                            {
                                                "example_id": "fb1869f8-4c03-4689-9730-1f0057ce027f",
                                                "sense_id": "2e6dce9c-1f75-3596-8f59-b7e992a3bb08",
                                                "text": "Inflammation of the enthesis, when associated with arthritis in children, is called the syndrome of seronegative enthesopathy associated with arthritis (SEA). The entheses most commonly involved in children are the plantar aponeurosis, calcaneal enthesis, and distal and proximal patellar ligament insertions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
