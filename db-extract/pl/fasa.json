                        ],
                        "examples": [
                            {
                                "example_id": "585535a4-dfb8-41bc-9f8a-4c708d084f5e",
                                "sense_id": "03d91cc5-50e1-31f3-8944-432c0eb0cd01",
                                "text": "Spasasz się, Maniusiu – rzekł kiedyś Józio – będziesz taka fasa, jak mama"
