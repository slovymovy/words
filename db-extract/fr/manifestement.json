        "fr-extract.jsonl": [
            {
                "entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                "word": "manifestement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                        "entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                        "glosses": [
                            "D’une manière manifeste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e57bfa3-9a31-477c-b260-912ff04bb101",
                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                "text": "La vertu de Dieu s’étant fait connaître manifestement."
                            },
                            {
                                "example_id": "2dd82efc-bd4c-40dd-a631-7bbf5b73d425",
                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                "text": "Cette présence immuable de l’éternité, toujours fixe, toujours permanente, enfermant en l’infinité de son étendue toutes les différences des temps, il s’ensuit manifestement que le temps peut être en quelque sorte dans l’éternité."
                            },
                            {
                                "example_id": "c7a2c994-381b-458b-8b77-b437bc51dd28",
                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                "text": "Qui ne sait que la loi si quis canis, Digeste De vi paragrapho, messieurs, caponibus, Est manifestement contraire à cet abus ?"
                            },
                            {
                                "example_id": "fe62e8d4-478c-45e9-872b-f2b350e3eabe",
                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                "text": "Une option manifestement irréaliste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "827f2e36-9567-4d30-924f-7ee6b2d9bd5a",
                        "source_entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                        "source_sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                        "source_sense_description": "D’une manière manifeste.",
                        "target_lang_word": "offensichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "dem Anschein nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e60d1e-ad13-4f2c-81fe-edec92866d25",
                                                "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                                "text": "Den Wolken nach zu urteilen, wird es offensichtlich regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "für jeden erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab0e9c-a524-4a5e-bf78-47a736cd6f2a",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "Es war offensichtlich, dass er gelogen hatte."
                                            },
                                            {
                                                "example_id": "f3761dd4-c271-4717-a207-45ed4e44513b",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Die offensichtlichen Mängel der Expertisen, so die Behörde heute, wären ganz sicher schon damals »in einem ‚Obergutachten‘ und/oder anderem Klageverfahren festgestellt worden«.“"
                                            },
                                            {
                                                "example_id": "36473f8d-c9a5-48b5-80d0-e0d958f80517",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "a6529f20-b446-4a31-82cd-7b7758b7593c",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bf2d3bc-1f2d-4519-9569-e95ef78c7501",
                        "source_entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                        "source_sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                        "source_sense_description": "D’une manière manifeste.",
                        "target_lang_word": "manifestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                        "entry_id": "fab1b0c3-43a7-34e1-9fa5-2ce867c5431b",
                                        "glosses": [
                                            "In a manifest manner; obviously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b716feb4-84a9-4029-a47a-9af6282e5535",
                                                "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                                "text": "Folk lore, legends, myths and fairy tales have followed childhood through the ages, for every healthy youngster has a wholesome and instinctive love for stories fantastic, marvelous and manifestly unreal."
                                            },
                                            {
                                                "example_id": "b463f314-1c85-4ab4-9989-ca97b490df32",
                                                "sense_id": "ad6a161a-20c0-3cbc-87c4-9a28f41abb65",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record. With this biological framework in place, Corning endeavors to show that the capitalist system as currently practiced in the United States and elsewhere is manifestly unfair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d994a539-c085-4774-b4c9-8e42fd22ffd5",
                        "source_entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                        "source_sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                        "source_sense_description": "D’une manière manifeste.",
                        "target_lang_word": "obviously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obviously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "In an obvious or clearly apparent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a2cb00-0ff5-4d12-a65f-dfcc4ec7ebec",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She was in floods of tears and obviously very upset."
                                            },
                                            {
                                                "example_id": "61370174-7462-4f05-97a9-743a3abcb477",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She'd obviously not gone to sleep yet: her eyes were bloodshot with sleepiness."
                                            },
                                            {
                                                "example_id": "1039c7ad-6815-4a9f-b377-98f227539248",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "The plane has obviously been delayed."
                                            },
                                            {
                                                "example_id": "2dfc1c3f-39e0-4137-b412-af9e1da3a71b",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "27eba153-6a8e-4637-94ee-071ae04d77b6",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "Used as a filler word, or to introduce information even when not obvious."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38742759-5d9a-4fa9-825e-818d1b5c53f0",
                                                "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                                "text": "You weren't to know, but I've spoken to, obviously, Jim about this, and ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69d9d233-f160-4d98-8449-d74552296ce6",
