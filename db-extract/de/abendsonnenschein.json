                        "examples": [
                            {
                                "example_id": "c8f9c3ec-cf9d-49e3-b4dc-f6e1ea7bdb0a",
                                "sense_id": "dea85d6b-31bd-3ba0-827f-c2a8d49ec7d9",
                                "text": "Und die sommergrünen Ufer / Glühn im Abendsonnenschein",
                                "translation": "And the deciduous shores / Glow in the evening sun",
                                "english": "And the deciduous shores / Glow in the evening sun"
                            },
                            {
                                "example_id": "4a2f165a-086e-4858-868a-c6937863313e",
                                "sense_id": "dea85d6b-31bd-3ba0-827f-c2a8d49ec7d9",
                                "text": "Drüben auf dem Hügel möchte ich sein / Im letzten Abendsonnenschein / Drüben auf dem Hügel möchte ich warten / Im nassen Gras in unserem Schrebergarten",
                                "translation": "I want to be over there on the hill / In the last of the evening sun / I want to wait over there on the hill / In the wet grass of our allotment garden",
                                "english": "I want to be over there on the hill / In the last of the evening sun / I want to wait over there on the hill / In the wet grass of our allotment garden"
                            }
                        ]
                    }
