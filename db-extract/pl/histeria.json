                    },
                    {
                        "translation_id": "e2e81bea-98a7-44eb-a78f-1e2790fddb93",
                        "source_entry_id": "952f7c13-db18-3eb0-a91f-a8bbf1320de9",
                        "source_sense_id": "a2cc1a95-7086-3620-81b0-5ab58f59f5d6",
                        "target_lang_word": "Hysterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hysterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ed5ab4-e38f-31c5-b691-bcab8ea50a6d",
                                        "entry_id": "55ac89f6-a0c5-37a3-9d8e-729de5ff675e",
                                        "glosses": [
                                            "neurotische Störung, Neurose"
                                        ],
                                        "tags": [
                                            "mittlerweile veralteter Fachbegriff"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a990d99-3a08-489b-947e-b9e502894292",
                                                "sense_id": "f2ed5ab4-e38f-31c5-b691-bcab8ea50a6d",
                                                "text": "„Die Hysterie ist eine Bezeichnung für eine neurotische Störung, bei der Geltungsbedürfnis, Egozentrismus und ein Bedürfnis nach Anerkennung zwar im Vordergrund stehen, die jedoch oft mit dem Symbol eines Paradiesvogels in Verbindung gebracht wird, da sie zu differenziert ist und dadurch kein einheitliches Erscheinungsbild aufweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "531ca83f-f027-3256-9599-19184feb9ceb",
                                        "entry_id": "55ac89f6-a0c5-37a3-9d8e-729de5ff675e",
                                        "glosses": [
                                            "übertriebene Erregbarkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b75fb1-8cad-4295-a042-1b9175b1efbd",
                                                "sense_id": "531ca83f-f027-3256-9599-19184feb9ceb",
                                                "text": "„Erst als den wilden Gerüchten keinerlei amtliche Bestätigungen folgten und durchsickerte, dass alle festgenommenen vermeintlichen Agenten binnen Kurzem wieder auf freiem Fuß waren, milderte die Hysterie sich deutlich.“"
                                            },
                                            {
                                                "example_id": "742c140c-359e-4882-842e-01e2a882c442",
                                                "sense_id": "531ca83f-f027-3256-9599-19184feb9ceb",
                                                "text": "„Für mich ist die kollektive Hysterie nicht immer nachvollziehbar.“"
                                            },
                                            {
                                                "example_id": "4ea930f1-4ce3-4af4-968d-a41c2c4e67e1",
                                                "sense_id": "531ca83f-f027-3256-9599-19184feb9ceb",
                                                "text": "„Der Sexualismus ist eine allgemeingültige, durchgehende Form der leichteren Hysterie.“"
                                            }
