                            {
                                "example_id": "91c175f7-35dc-4c06-91e7-2a858e886eee",
                                "sense_id": "6d7cf6bf-69f2-39d0-849f-311c9c380a36",
                                "text": "De heer Van Vlaenderen speelt als een gewoon komiek, en overigens niet zonder fijnheid. Zijn stil spel bij de vertooning der tooneelspelers in het derde bedrijf heb ik kunnen waardeeren om de leuke malheid ervan. Maar.... hij speelde voor een schouwburgpubliek, in eene schouwburgzaal en niet in openlucht."
                            }
                        ]
                    }
