                                        "entry_id": "d8918aa4-9d34-3680-ba79-feba91bfe695",
                                        "glosses": [
                                            "The origination of gods or a narrative describing the origin of gods."
                                        ],
                                        "tags": [
                                            "in ancient religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e55a769-c939-4a2b-ba58-a50ada444f62",
                                                "sense_id": "09d93ffb-053f-3082-b1fe-dc8cd343aead",
                                                "text": "This Phoenician history includes the cosmogony and theogony of the Phoenicians. In the theogony, Ourianos (Sky) has four children by his wife-sister Gē (Earth): Ēlos (interpreted as Kronos), Baitlos, Dagōn (Sitōn), and Atlas."
                                            }
                                        ]
                                    }
                                ]
                            }
