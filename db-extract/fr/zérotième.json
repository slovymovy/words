                                        "sense_id": "80c363d9-7030-3772-9379-d3ee4e70ef74",
                                        "entry_id": "51e7eac5-fb27-3ee5-ad75-aa2b7e6a12d7",
                                        "glosses": [
                                            "an der Stelle null stehend; Ordnungszahl vor erste"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd7dee5-90d7-436e-b2bd-b67f0c1c5bff",
                                                "sense_id": "80c363d9-7030-3772-9379-d3ee4e70ef74",
                                                "text": "„Dieses Postulat heißt der nullte Hauptsatz der Wärmelehre.“"
                                            },
                                            {
                                                "example_id": "21c027d4-78b9-45bc-b5f5-d216901cd78e",
                                                "sense_id": "80c363d9-7030-3772-9379-d3ee4e70ef74",
                                                "text": "„Dann berechnet man ohne ihn die Zeitentwicklung des Systems als sog. nullte Näherung, vergleicht das theoretische Ergebnis mit dem experimentellen Befund, und wenn man Glück hat, weicht schon die nullte Näherung nicht allzusehr von den beobachteten Daten ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
