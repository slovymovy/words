                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec75b03-ca10-4acf-af3a-d01bb9c63288",
                                "sense_id": "bc4eec96-b41b-369f-9def-5fd04b43c9c2",
                                "text": "The footsteps were trackable near the grass, but not on it, and were visible on the harrowed ground."
                            },
                            {
                                "example_id": "a9a8aadc-0192-4350-aabb-853d3e304eb2",
                                "sense_id": "bc4eec96-b41b-369f-9def-5fd04b43c9c2",
                                "text": "The long flight to Mars and the even longer orbiting time of a precisely trackable spacecraft will enable scientists to refine the accuracy of our data bank on true distances across the solar system, the exact shape of the planet Mars, and possible anomalies in its gravitational field caused by mass concentrations (mascons)."
                            },
                            {
                                "example_id": "2cf157f0-28e4-499f-be3d-7aa92806cfd9",
                                "sense_id": "bc4eec96-b41b-369f-9def-5fd04b43c9c2",
                                "text": "Instead of tightening controls, it relaxed them, making $10,000 the minimum value for trackable items, instead of $5,000, the report said."
                            }
                        ]
                    }
