                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A story or fact; especially, news learned and reported before anyone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f4d73f-da75-4962-a663-f8fd7833ae5c",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "He listened carefully, in hopes of getting the scoop on the debate."
                                            },
