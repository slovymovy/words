                                    {
                                        "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                        "entry_id": "82e980b1-00be-3dfb-8e92-90a04d8a9df0",
                                        "glosses": [
                                            "Qui sert à modifier ou à percevoir les sons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90f8c7b-f409-4b8a-8786-31ed6481ecdc",
                                                "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                                "text": "Le jeune clerc murmura ces renseignements dans le pavillon d’un tuyau acoustique et reçut en réponse dans le pavillon de sa propre oreille une communication qu’il n’eut garde de rendre publique."
                                            },
                                            {
                                                "example_id": "b15ca205-efbc-4681-baff-965041e44b62",
                                                "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                                "text": "L'appareil acoustique de Marti, qui quelques jours auparavant, nous avait donné 1600 m., nous indiqua des fonds de 250 mètres ; nous étions donc sur le plateau continental."
                                            },
                                            {
                                                "example_id": "2ad02fe0-ceeb-4cd1-9bd1-9efeebcbdca5",
                                                "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                                "text": "Le nombre et la place des trous du tuyau varie selon le type de musique que l'on joue. A l'origine, il est souvent fixé impérativement par des règles d'origine extra-acoustique, magiques ou religieuses."
                                            },
                                            {
                                                "example_id": "5e0c36b9-e350-4d2e-ac8c-a9d75ff34c12",
                                                "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                                "text": "Après ses trois repas, la douairière allait s’asseoir au salon dans une encoignure d’où elle pouvait surveiller sans être vue toute une enfilade de pièces, et entendre ce qui se disait contre elle au sous-sol, grâce à une bouche de calorifère faisant fonction de tuyau acoustique."
                                            },
                                            {
                                                "example_id": "687aed2a-db0d-4a03-a4ed-0e874c6c9037",
                                                "sense_id": "83011580-583c-38a4-9911-c8093f4e3e54",
                                                "text": "Voûte acoustique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d82509-e445-3052-949b-e1deefbf679f",
                                        "entry_id": "82e980b1-00be-3dfb-8e92-90a04d8a9df0",
                                        "glosses": [
                                            "Relatif aux organes de l’ouïe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a38f42-df05-4fbd-81ff-80a0fd7c128c",
                                                "sense_id": "a1d82509-e445-3052-949b-e1deefbf679f",
                                                "text": "Conduit acoustique."
                                            },
                                            {
                                                "example_id": "0f332a4f-efdc-4910-9f5f-5c053b86cac6",
                                                "sense_id": "a1d82509-e445-3052-949b-e1deefbf679f",
                                                "text": "Nerf acoustique."
                                            }
                                        ]
                                    }
                                ]
