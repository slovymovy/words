                        "translation_id": "a0f827aa-2543-45b3-9bd9-39486c446a2c",
                        "source_entry_id": "92897b4f-5bd8-3a71-97cb-21853fd7cde3",
                        "source_sense_id": "474d8c0b-1205-3d19-9ad9-7d20a074dd91",
                        "source_sense_description": "analyzing a culture from inside",
                        "target_lang_word": "emisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff653d61-533e-3ef2-9551-0fa99a56f554",
                                        "entry_id": "ac577322-2b8b-3b02-9566-7c52c9b062bf",
                                        "glosses": [
                                            "auf das Sprachsystem (die Langue) bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701d1744-afff-4099-a84b-2d1d5328d8a8",
                                                "sense_id": "ff653d61-533e-3ef2-9551-0fa99a56f554",
                                                "text": "„Von zentraler Bedeutung ist der Gegensatz zwischen den funktional kontrastiven ‚emischen‘ Einheiten (wie Phonemen und Morphemem) und den ‚etischen‘ Einheiten, die ihnen physische Form verleihen (…)“"
                                            },
                                            {
                                                "example_id": "c351720c-40ce-4cab-b70e-22aaaddab183",
                                                "sense_id": "ff653d61-533e-3ef2-9551-0fa99a56f554",
                                                "text": "Im Bereich der Laute sind Phoneme emische, Laute dagegen etische Einheiten."
                                            },
                                            {
                                                "example_id": "4574b2c2-9c61-47cc-aab7-a7c59304ab27",
                                                "sense_id": "ff653d61-533e-3ef2-9551-0fa99a56f554",
                                                "text": "Die emische Analyse berücksichtigt die Eigenschaften, die für die Kommunikation eine wichtige Funktion haben: Ob ein Verschlusslaut im Deutschen stark aspiriert (behaucht) ist oder weniger stark, ist für die Verständigung nicht relevant; ob ein solcher Verschlusslaut wie [d] (stimmhaft) oder [t] (stimmlos) stimmhaft ist oder nicht, unterscheidet Wörter: Rades [ˈʀaːdəs] - Rates [ˈʀaːtəs]. Damit zeigt sich, dass die Stimmhaftigkeit eine emische Eigenschaft der Laute des Deutschen ist, die Behauchung aber nur eine etische."
                                            },
                                            {
                                                "example_id": "ec3bbd0a-334c-4b2f-8328-11b62e8f2ec4",
                                                "sense_id": "ff653d61-533e-3ef2-9551-0fa99a56f554",
                                                "text": "„Der emische Text ist bezogen auf das Sprachsystem und erfordert eine Definition nach textinternen Kriterien, zum Beispiel mit Hilfe der syntagmatischen Substitution.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9545b92b-13f8-307a-900b-99d49cfa301c",
                                        "entry_id": "ac577322-2b8b-3b02-9566-7c52c9b062bf",
                                        "glosses": [
                                            "mit den Augen eines Insiders (im Gegensatz zu einem Betrachter, der sein Untersuchungsobjekt gewissermaßen von außen, distanziert betrachtet)"
                                        ],
                                        "tags": [
                                            "Sozialwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "919656dc-f8cb-4f4f-883c-2dedf3267505",
                                                "sense_id": "9545b92b-13f8-307a-900b-99d49cfa301c",
                                                "text": "Zum wirklichen Kulturverstehen ist eine emische Herangehensweise wichtig, beim Vergleichen kann dagegen eine etische Beschreibung sinnvoll sein. - (Wikipedia)"
                                            },
                                            {
                                                "example_id": "8cac6bc3-9524-4699-8b34-4fe113eb69c7",
                                                "sense_id": "9545b92b-13f8-307a-900b-99d49cfa301c",
                                                "text": "„Die Zugehörigkeit zu einem bestimmten System, also die emische Sicht auf eben dieses, impliziert eine etische Perspektive auf ein anderes System, sodass eine bewertende Analyse eines anderen Systems mit differierender Prägung beziehungsweise Ausrichtung aus etischer Perspektive nach Berry ein falscher Ansatz ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
