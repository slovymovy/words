                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0351ddf-318b-4e3b-b6ff-3078137a4307",
                                "sense_id": "70359a6b-79b2-3e38-8667-f31344f9bf06",
                                "text": "„In der beeindruckenden Bergwelt der Viamala lädt besonders der Kultur- und Weitwanderweg ViaSpluga zu einer Erkundung der Landschaft ein.“"
                            },
                            {
                                "example_id": "5e9558f5-cd9a-4048-943a-57a9044081d9",
                                "sense_id": "70359a6b-79b2-3e38-8667-f31344f9bf06",
                                "text": "„Wer Weitwanderwege bevorzugt, findet zahlreiche Möglichkeiten sich zu entfalten, denn Großbritannien wird von einem dichten Netz von Weitwanderwegen durchzogen.“"
                            }
                        ],
