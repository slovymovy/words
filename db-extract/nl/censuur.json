                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a370c5ea-7d8e-4e67-b89b-05f588329f88",
                        "entry_id": "d74d6d2f-ee59-3407-a9c7-e325bb4948b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "censuren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                        "entry_id": "d74d6d2f-ee59-3407-a9c7-e325bb4948b8",
                        "glosses": [
                            "controle van de kant van een autoriteit (vaak de overheid, ook de kerk) op de informatiestroom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c2248d-e4ce-48fe-9270-09314c09dc22",
                                "sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                                "text": "Tijdens de coup stond de staatszender onder militaire censuur."
                            },
                            {
                                "example_id": "141ec839-354c-4bde-aeba-3404dcc1fbdc",
                                "sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                                "text": "De stap is deels ingegeven door enkele “technisch zeer verfijnde” cyberaanvallen op de Singaporese overheid, aldus premier Lee Hsien Loong tegenover journalisten. Het betreft onder meer een incident uit 2013, toen hackers van het netwerk Anonymous zich toegang hadden verschaft tot het computersysteem van de overheid om te protesteren tegen nieuwe regels voor censuur op het web in de stadstaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cb6ed80-f4b1-4e8d-8539-47326cca2cf6",
                        "source_entry_id": "d74d6d2f-ee59-3407-a9c7-e325bb4948b8",
                        "source_sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                        "source_sense_description": "de controle van de kant van de overheid op alles wat de media uitbrengen",
                        "target_lang_word": "Zensur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zensur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06375f94-dd49-3f7e-94d2-2ca4e89f677a",
                                        "entry_id": "5fd56b1c-1a83-3db5-92bd-e22c8edfb1fa",
                                        "glosses": [
                                            "Note für erbrachte Leistung oder Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c805ca-4694-4862-9d49-6ecc048d37bf",
                                                "sense_id": "06375f94-dd49-3f7e-94d2-2ca4e89f677a",
                                                "text": "Ich habe eine gute Zensur bekommen."
                                            },
                                            {
                                                "example_id": "c9d8a279-ae0c-46cb-95f5-65978cf65a28",
                                                "sense_id": "06375f94-dd49-3f7e-94d2-2ca4e89f677a",
                                                "text": "„Sie machte den Eindruck, als habe sie Zensuren bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                        "entry_id": "5fd56b1c-1a83-3db5-92bd-e22c8edfb1fa",
                                        "glosses": [
                                            "besonders staatliche, aber auch von religiösen Institutionen durchgeführte Kontrolle und etwaige Anpassung oder Verbot von Presse, Kunst, Rundfunk, Filmen und anderen Medienerzeugnissen, sowie Briefen und ähnlichen Korrespondenzen nach sittlichen, religiösen oder politischen Kriterien"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddceae4c-aee8-4092-b207-f75dcd91ced4",
                                                "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                                "text": "Diese Nachricht ist der Zensur zum Opfer gefallen."
                                            },
                                            {
                                                "example_id": "1049d288-b370-423f-b9ed-7f50d557ec6f",
                                                "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                                "text": "„Daß mir der Simplizissimus eine Novelle zurückschickte - »die Zensur würde das keinesfalls passieren lassen« - bekümmerte mich diesmal nicht sonderlich.“"
                                            },
                                            {
                                                "example_id": "9f95d77c-59b3-4b19-bd6c-f8a38aa484f8",
                                                "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                                "text": "„Zum Glück kommt das Buch in einer Zeit auf den Markt, in der sich die Zensur zurückhält.“"
                                            },
                                            {
                                                "example_id": "dd4df63c-8854-432c-b610-c7266ff0b54f",
                                                "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                                "text": "„Es war naheliegend, daß die deutsche Presse die Wahrheit über das Scheitern des U-Bootkrieges zurückhielt, während die Zensur sämtliche politisch schädlichen Nachrichten aus dem Ausland abfing.“"
                                            },
                                            {
                                                "example_id": "6bc20004-286d-4ee6-a3ba-036a990cfac2",
                                                "sense_id": "3c0ee7b5-588f-3080-a539-d30e3a75bc74",
                                                "text": "„Lange Zeit bekamen Oleg und ich keinen Brief von ihm, dann kamen gleich mehrere auf einmal, doch die Umschläge trugen keine Stempel, und der Text war von der Zensur mehr als zur Hälfte mit braunem Klebstoff vollgeschmiert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1f2cf532-12ea-3326-8cd7-3775f2959f13",
                                        "entry_id": "5fd56b1c-1a83-3db5-92bd-e22c8edfb1fa",
                                        "glosses": [
                                            "Institution, die mit der Ausführung der in [2] beschriebenen Maßnahmen beauftragt ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68017c1e-e64d-4ca2-bb25-b37d363ad760",
                                                "sense_id": "1f2cf532-12ea-3326-8cd7-3775f2959f13",
                                                "text": "Die Zensur würde den neuen Roman nicht zur Veröffentlichung zulassen."
                                            },
                                            {
                                                "example_id": "a76bdedf-9e44-4d05-b78b-bb0a3db33059",
                                                "sense_id": "1f2cf532-12ea-3326-8cd7-3775f2959f13",
                                                "text": "„Die polnischen Autoren mußten sich über einen sehr langen Zeitraum mit der Zensur auseinandersetzen.“"
                                            },
                                            {
                                                "example_id": "1bb7ab36-f64b-47de-9ddc-5b5978b06820",
                                                "sense_id": "1f2cf532-12ea-3326-8cd7-3775f2959f13",
                                                "text": "„Aber sein Text wurde sofort von der Zensur abgelehnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdd7a0f3-602f-4bfe-9816-7a1dd4d9af95",
                        "source_entry_id": "d74d6d2f-ee59-3407-a9c7-e325bb4948b8",
                        "source_sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                        "source_sense_description": "de controle van de kant van de overheid op alles wat de media uitbrengen",
                        "target_lang_word": "censorship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censorship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43b303f1-bbc1-3975-b7d0-22c22b306e55",
                                        "entry_id": "ffc59bff-ce88-3334-91a0-24b580ba5d9b",
                                        "glosses": [
                                            "The use of state or group power to control freedom of expression or press, such as passing laws to prevent undesirable media from being published or propagated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "948ff3a0-0aeb-421b-87b9-99dc22c18995",
                                                "sense_id": "43b303f1-bbc1-3975-b7d0-22c22b306e55",
                                                "text": "[…] such a curious thing — it is the only thing left of the old censorship of the press.\""
                                            },
                                            {
                                                "example_id": "95dd956c-f529-458e-9166-f26b602af0a3",
                                                "sense_id": "43b303f1-bbc1-3975-b7d0-22c22b306e55",
                                                "text": "During the war, but unrecorded because of the requirements of censorship, a link with the now partly-abandoned Cardiff Railway disappeared with the demolition of Rhydyfelin Viaduct, near Treforest, South Wales, in the latter part of 1942. The steelwork in this structure, amounting to nearly 1,150 tons, was salvaged as scrap metal to assist the war effort."
                                            },
                                            {
                                                "example_id": "0c1ac7f6-6479-43e1-93c2-08c6d1081ca2",
                                                "sense_id": "43b303f1-bbc1-3975-b7d0-22c22b306e55",
                                                "text": "The Infantes had contacts among left-wing groups that opposed the dictatorial regime in Spain and their visibility in these circles was a serious concern for the censorship authorities […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f54b9eb8-12aa-38fc-8cd1-bd7c51d70b9f",
                                        "entry_id": "ffc59bff-ce88-3334-91a0-24b580ba5d9b",
                                        "glosses": [
                                            "The role of the censor (magistrate) in Ancient Rome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ffffcd-a044-42fb-87c6-df03c5169a65",
                        "source_entry_id": "d74d6d2f-ee59-3407-a9c7-e325bb4948b8",
                        "source_sense_id": "dc8aba17-b7c0-363c-9b9f-994455195b38",
                        "source_sense_description": "de controle van de kant van de overheid op alles wat de media uitbrengen",
                        "target_lang_word": "censure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Examen qu’un gouvernement fait faire des livres, des journaux, des pièces de théâtre, etc., avant d’en permettre la publication ou la représentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7da355-aa84-4479-b0f6-065129af2ea8",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "En l’absence de censure en amont, il fallait qu’un livre soit d’abord publié pour pouvoir être ensuite interdit, ce qui permettait, si on jouait serré, de mettre un bon nombre d’exemplaires en circulation avant que les censeurs ne frappent."
                                            },
                                            {
                                                "example_id": "66e49a51-5e7f-4112-9953-5ee28b01a851",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "Établir la censure."
                                            },
                                            {
                                                "example_id": "f30629da-16da-4c2c-bfd1-22c9462581b3",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "Abolir, rétablir la censure."
                                            },
                                            {
                                                "example_id": "54d91ae3-69c2-48e9-a95a-e3a87d0cab49",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "Censure préalable."
                                            },
                                            {
                                                "example_id": "1ee729b1-bf18-4d63-b9e8-c089288a5873",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "Censure dramatique."
                                            },
                                            {
                                                "example_id": "d76826bc-93fb-4b3f-b463-c0df61cbaa00",
                                                "sense_id": "c465cdf9-f745-3229-9b29-45a2384254c4",
                                                "text": "Passer à la censure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee780ea-e74c-3558-a70c-8defb61ec36d",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Corps des personnes chargées de cet examen."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d8c5e24-574b-4296-93a6-4ba7109f4a02",
                                                "sense_id": "aee780ea-e74c-3558-a70c-8defb61ec36d",
                                                "text": "Et les lettres passent ensuite à la censure qui raye soigneusement tout ce qui peut de près ou de loin ressembler à une indication d'ordre militaire."
                                            },
                                            {
                                                "example_id": "7a61f0af-4296-471a-8c6a-5c3a6960e968",
                                                "sense_id": "aee780ea-e74c-3558-a70c-8defb61ec36d",
                                                "text": "La censure ne permit pas l’insertion de cet article dans les journaux. Vers supprimés à la représentation par ordre de la censure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5915d7b1-318c-3a02-8037-84e544100b37",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Correction, répréhension, interdiction de publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a0b26d1-8dce-4d58-a33e-e737c3b514b8",
                                                "sense_id": "5915d7b1-318c-3a02-8037-84e544100b37",
                                                "text": "Soumettre ses écrits à la censure de quelqu’un."
                                            },
                                            {
                                                "example_id": "a196ac62-0c53-404d-a68e-49a251a942fc",
                                                "sense_id": "5915d7b1-318c-3a02-8037-84e544100b37",
                                                "text": "Souffrir la censure."
                                            },
                                            {
                                                "example_id": "f848cdbe-b0b6-403e-94ea-03f283a6966f",
                                                "sense_id": "5915d7b1-318c-3a02-8037-84e544100b37",
                                                "text": "S’exposer à la censure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c38c5a-9649-3e9c-be98-82e6b8f464ec",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Silence médiatique concernant une publication ou une information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6e1606-1a38-4070-bb36-adebac1c6c9a",
                                                "sense_id": "29c38c5a-9649-3e9c-be98-82e6b8f464ec",
                                                "text": "Censure médiatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e414831a-cf07-3ea6-a75b-7f5dc6b06a7d",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "En matière de dogme, jugement qui porte condamnation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ea7cdb-dfd0-4a0d-944c-b7e140e6131c",
                                                "sense_id": "e414831a-cf07-3ea6-a75b-7f5dc6b06a7d",
                                                "text": "La censure que la Sorbonne fit de tel livre, de telle proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c0bff1-6078-3b9b-bfda-67bf477eafc1",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Excommunication, interdiction ou suspension d’exercice et de charge ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e1001e-6530-42d6-a2d6-fca188ee342d",
                                                "sense_id": "f7c0bff1-6078-3b9b-bfda-67bf477eafc1",
                                                "text": "Il a encouru la censure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e10ec37-6f05-3b9f-ab52-d57a90589609",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Peine disciplinaire que les corps, les ordres, les communautés et les assemblées délibérantes prononcent contre un de leurs membres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2353efea-2438-32c6-9982-35df7f901ba0",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Dignité et fonction de censeur chez les romains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32ad649-acfc-4690-92aa-7e39a4885697",
                                                "sense_id": "2353efea-2438-32c6-9982-35df7f901ba0",
                                                "text": "Durant la censure de Caton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb2a2e4-2237-34a9-8816-a2778bd0d46f",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Annulation d’un acte législatif pour non-respect d’autres dispositions législatives, en particulier constitutionnelles."
                                        ],
                                        "tags": [
                                            "Législation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2df138c-eb63-4933-ade5-cbba4cd4430b",
                                                "sense_id": "bcb2a2e4-2237-34a9-8816-a2778bd0d46f",
                                                "text": "Pour les lois, seule la méconnaissance d’une obligation de consultation résultant de la Constitution elle-même ou d’une loi organique peut conduire à la censure du texte par le Conseil constitutionnel."
                                            },
                                            {
                                                "example_id": "4ccf9c71-57f0-489b-b34e-61225076e6fa",
                                                "sense_id": "bcb2a2e4-2237-34a9-8816-a2778bd0d46f",
                                                "text": "Des constitutionnalistes estiment d'ailleurs que certains aspects de la loi seront probablement censurés par le Conseil, car ils présenteraient un risque de « cavalier budgétaire » : […]. Une censure du texte entier, et notamment de la mesure emblématique de recul de l'âge de départ à la retraite, reste néanmoins peu probable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96fe4f9-f9f9-3175-bb5a-16edcfe1def8",
                                        "entry_id": "d2311a97-d59a-30ab-bbff-19975b234d01",
                                        "glosses": [
                                            "Fonction ayant l’effet de bloquer les désirs refoulés de l’inconscient de passer au préconscient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
