                "entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                "word": "vituperation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f7ac3c82-0524-461d-8eb6-113d0f46d84c",
                        "entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "tags": [
                            "plural"
                        ],
                        "form": "vituperations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da708891-af71-3041-bc6a-1e10a27657eb",
                        "entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "glosses": [
                            "The act of vituperating; severely blaming or censuring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                        "entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "glosses": [
                            "Criticism or invective that is sustained and overly harsh; abuse, severe blame or censure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8897c680-a27c-4c05-8a58-6557bcc2cb9d",
                                "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                                "text": "...but, for several successive days, as she was careful in observing the strictest regimen (..), she actually became much better, especially as to these favourable circumstances was added great calmness of temper, she wisely substituting the quiet sneer of contempt for angry vituperation and vindictive scorn."
                            },
                            {
                                "example_id": "db958fc6-6c7f-4eb9-917b-a57baa2f4f9e",
                                "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                                "text": "\"Do you call me a spy?\" / \"And what have you called me? Because you are a husband, is the privilege of vituperation to be all on your side?\""
                            },
                            {
                                "example_id": "cc541471-defb-460f-89d7-17f22e62c4ba",
                                "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                                "text": "His face turned red with passion; he made one bound, hurled me across the house with a sweep of his arm, spun the wheel down, and began to pour out a stream of vituperation upon me which lasted till he was out of breath."
                            },
                            {
                                "example_id": "fc4e3bee-691b-4e9b-92a6-a6483b94c63d",
                                "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                                "text": "The rather too inclusive speech brought down a torrent of vituperation from other quarters upon fair Tess’s unlucky head[…]"
                            },
                            {
                                "example_id": "754284e8-02d3-476e-9ad9-2cb549b767ba",
                                "sense_id": "fca0a2cc-2f98-3fc1-92e8-0ebdb9760d95",
                                "text": "Sterling himself, though he had the most picturesque and inimitable vocabulary of vituperation, was highly squeamish about ordinary smut or profanity. He had indeed that nice-Nelliness which is often characteristic of the Don Juan type."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c7c2218-3016-4133-a003-f728a9732914",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "afkeuring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afkeuring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                        "entry_id": "b8859241-fb84-3cb7-b244-594dcd881127",
                                        "glosses": [
                                            "het uitspreken van een negatief oordeel over iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ab6799-1218-450e-ba0a-3c5b88c703d4",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De zieke man was helemaal niet blij met de afkeuring voor zijn werk dat hij altijd met plezier had gedaan."
                                            },
                                            {
                                                "example_id": "a5236d96-a9b1-4778-bd2c-09907f70afde",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "De afkeuring van de oude volledig doorgeroeste auto kwam niet als een verrassing."
                                            },
                                            {
                                                "example_id": "e5ce8964-faf6-4865-9fb6-81ec4293389a",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "'Het is een lang verhaal,' zei hij in reactie op de afkeuring die hij in mijn woorden had bespeurd."
                                            },
                                            {
                                                "example_id": "e22a81ef-a961-43d9-a255-30f71f4d16e6",
                                                "sense_id": "7796a09f-1455-31ca-95a3-198fa4976f4a",
                                                "text": "Naast het feit dat er zeker een kern van waarheid in hun reactie zat, verbaasde ik me vooral over de felle toon van hun afkeuring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d560b7-54c4-43fa-acaf-4b2f4444da02",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "verwerping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwerping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                        "entry_id": "83ced013-71e9-30e5-bf58-e14e5b21dc31",
                                        "glosses": [
                                            "het afwijzen van iets; iets niet accepteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d419831e-c7a4-4746-9b26-aeb14cdcb66d",
                                                "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                                "text": "Door die wet te verwerpen was het misschien mogelijk geweest de oude opvatting van de beweging van lichamen te handhaven, maar zonder verwerping was het onmogelijk, zou men denken, de Ptolemeïsche werelden te blijven bestuderen."
                                            },
                                            {
                                                "example_id": "caefb0f1-e1c4-4715-bdc5-4740a96e5237",
                                                "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                                "text": "Sánchez werd vorig jaar premier van een minderheidskabinet. Na de verwerping van de begroting schreef hij verkiezingen uit voor april, die zijn partij overtuigend won (een winst van 38 zetels). Maar om een meerderheid te verwerven moest hij een coalitie vormen en dat lukt dus niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3b0f0c5-26b1-41f2-a68f-0cef6a00bc44",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "désapprobation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désapprobation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                        "entry_id": "50433f51-53ef-3dc6-acbe-1bb30a2a980b",
                                        "glosses": [
                                            "Action de désapprouver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1f00bd-ae33-45d9-ba7c-02a7cd511348",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "Ah ! messieurs, vous prenez vite pied chez nous ! Vous êtes de mauvaise humeur parce que je n’ai pas été assez sot pour signer, comme Louis XIV, la désapprobation des libertés gallicanes !"
                                            },
                                            {
                                                "example_id": "2dbc673d-e2ae-490a-8743-8442c5d631b0",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "– Bien, fit-elle, alors, vous allez comprendre à merveille. Mais que je ne voie pas dans vos regards la moindre nuance de désapprobation. Je m’arrêterais à l’instant même."
                                            },
                                            {
                                                "example_id": "ade96099-4964-4992-8cdf-792e8cc8992a",
                                                "sense_id": "f31fb423-6f73-3396-8d65-f3ec51acb651",
                                                "text": "Au troisième stade, la tension pouvait aller jusqu’à la désapprobation verbale ou, partiellement verbalisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "264b3887-9240-4362-9b4b-203c879f5d4b",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "répugnance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répugnance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                        "entry_id": "f78927c8-aca3-3f12-85f1-320fcf12b9fc",
                                        "glosses": [
                                            "Opposition naturelle, éloignement ou répulsion pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743684c0-c589-4226-a0d4-5dd99093d3bd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Alors Athos tira de sa poche un petit papier sur lequel étaient écrites deux lignes accompagnées d’une signature et d’un sceau, et le présenta à celui qui donnait trop prématurément ces signes de répugnance."
                                            },
                                            {
                                                "example_id": "0000f741-1e5c-4492-b10a-20e8145feddd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Ce fut donc le clergé qui, à Plassans, mena la réaction. La noblesse devint son prête-nom, rien de plus ; il se cacha derrière elle, il la gourmanda, la dirigea, parvint même à lui rendre une vie factice. Quand il l’eut amenée à vaincre ses répugnances au point de faire cause commune avec la bourgeoisie, il se crut certain de la victoire."
                                            },
                                            {
                                                "example_id": "bcbfb70a-38fe-44b1-a0b0-b4a0742b2caa",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "L’iguane est un plat médiocre, disent les uns, cela sent le reptile. Mais si l'on peut vaincre sa répugnance, cela constitue un plat de résistance et qui vaut bien le singe rouge. Quant à moi, j'en suis très friand ; […]."
                                            },
                                            {
                                                "example_id": "a3dffe78-fedb-4abf-8145-0033419d4024",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Il est vrai, […], que le juifs, plus versés que les prêtres chrétiens dans la connaissance des Écritures, étaient de redoutables controversistes, à ce point que Saint Louis manifesta sa répugnance pour les discussions entre les juifs et les chrétiens insuffisamment instruits : […]."
                                            },
                                            {
                                                "example_id": "d45a7b05-e12a-41fd-a1a5-8660ca6455b0",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Sa nuit de noce n'avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "e7c6a1b3-82a1-4914-8204-6555e31967be",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Un problème d’incontinence peut ne pas être reconnu étant donné la répugnance de la personne à parler de quelque chose d’aussi privé et d’aussi intime que la fonction urinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb0860f2-69c2-4164-9b97-b501ced7204c",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "Schmähung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmähung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                        "entry_id": "ed47389e-864e-3596-ac28-6d02c30b990b",
                                        "glosses": [
                                            "Handlung, jemanden oder etwas zu beleidigen und verächtlich zu machen, beleidigende Worte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d266bccf-a949-418d-81d5-c1f4cb8aa5d0",
                                                "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                                "text": "Der Mann stieß laute Schmähungen aus."
                                            },
                                            {
                                                "example_id": "385c4f12-ba54-4f7e-8aed-12a85a6df6e4",
                                                "sense_id": "a15c6835-fb82-3940-a722-54589fccb815",
                                                "text": "„Meine Schmähungen endeten mit dem Dunkel der Nacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                        "entry_id": "ed47389e-864e-3596-ac28-6d02c30b990b",
                                        "glosses": [
                                            "Ergebnis von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb45df16-22d9-4cf7-9604-e75f6a9fb095",
                                                "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                                "text": "„Glücklich sollten sich diejenigen schätzen, die trotz dieser Schmähung nicht im Gulag landeten.“"
                                            },
                                            {
                                                "example_id": "da6f1875-55e9-4da2-8987-8c73f370d0ce",
                                                "sense_id": "2b1bb28b-fe93-3e99-8f36-57923e4ec4b9",
                                                "text": "„Als er dann einen seiner Knechte bemerkte, überschüttete er ihn mit Schmähungen, weil er ihn nicht benachrichtigt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "780ee9ad-b252-4aef-a42e-bf99fe29f4ab",
                        "source_entry_id": "ca0dc536-2a71-3e05-9e65-f9442aea7c13",
                        "source_sense_description": "criticism or invective that is sustained and overly harsh",
                        "target_lang_word": "Beschimpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschimpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a128bf0c-3bf2-3312-9738-1db3cf2c6c1f",
                                        "entry_id": "800ce1f9-01ea-3b12-8d8a-c4de3abb71d1",
                                        "glosses": [
                                            "das Beschimpfen, Schmähen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2d2879-66b3-481a-a1cd-9cb7303f96a9",
                                                "sense_id": "a128bf0c-3bf2-3312-9738-1db3cf2c6c1f",
                                                "text": "Aber das Ansehen des Staatschefs hat sowohl durch unflätige Beschimpfungen von Journalisten gelitten als auch durch den Missbrauch des Parteiapparats:"
                                            },
                                            {
                                                "example_id": "3c407727-f493-4920-b145-25abef6946bd",
                                                "sense_id": "a128bf0c-3bf2-3312-9738-1db3cf2c6c1f",
                                                "text": "„Eine Beleidigung kann auch auf einem Missverständnis beruhen, während eine Beschimpfung nicht missverstanden werden kann - die Kränkung ist beabsichtigt.“"
                                            },
                                            {
                                                "example_id": "a476bf9f-771b-4290-8597-e072595e9f32",
                                                "sense_id": "a128bf0c-3bf2-3312-9738-1db3cf2c6c1f",
                                                "text": "„Die Fahrgäste drängelten und brüllten, die Tunesier wechselten dabei mühelos zwischen französischen und arabischen Beschimpfungen hin und her.“"
                                            },
                                            {
                                                "example_id": "c04b80b9-c4d6-43af-ba39-95cc0f09ca32",
                                                "sense_id": "a128bf0c-3bf2-3312-9738-1db3cf2c6c1f",
                                                "text": "„Es wäre ihnen als eine Beschimpfung seines Andenkens erschienen, überhaupt die Möglichkeit einer Zukunft zuzugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7139278-1fbc-3949-98af-77e24c9ee7f1",
                                        "entry_id": "800ce1f9-01ea-3b12-8d8a-c4de3abb71d1",
                                        "glosses": [
                                            "die Worte, die dem Beschimpfen dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d596c5-9cc6-41a1-9f95-06636634ef99",
                                                "sense_id": "d7139278-1fbc-3949-98af-77e24c9ee7f1",
                                                "text": "Beschimpfungen wie \"alte Sau\" können bis zu 2500 Euro kosten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
