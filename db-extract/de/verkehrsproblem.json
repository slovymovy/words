                ],
                "senses": [
                    {
                        "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                        "entry_id": "e7c56868-97cf-3df9-85f2-63d79261d48b",
                        "glosses": [
                            "Schwierigkeit beim Umgang mit einer Verkehrslage oder einem Verkehrsgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14ee4c4-0b2e-420e-b007-a261f6fd764d",
                                "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                                "text": "„Nach Ansicht Neuners löse die Autobahnführung über den Brenner das europäische Verkehrsproblem Brenner auf dem Sektor Straße dauerhaft.“"
                            },
                            {
                                "example_id": "84bcc39d-3ffa-4f0d-9585-d28219895630",
                                "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                                "text": "„Wer die meisten Verkehrszeichen richtig deutet, die meisten Verkehrsfragen richtig beantwortet, bei den meisten Verkehrsproblemen eine passende Lösung weiß und außerdem im praktischen Verkehrsspiel erfolgreich war, wird zum ‚Verkehrskönig’ ausgerufen.“"
                            },
                            {
                                "example_id": "5bfed2ef-5ed5-4570-bacd-bd5df43db492",
                                "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                                "text": "„Wenn man noch etwas länger zuwartet, dann macht man bald die Erfahrung, dass dann sowohl die Autobahn als auch die Bundesstraße völlig überlastet sind, und zwar in einer ganz anderen Größenordnung als das derzeitige Verkehrsproblem.“"
                            },
                            {
                                "example_id": "3821c85b-6fb6-40bd-b1d8-1fa2784451c7",
                                "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                                "text": "„Verkehrsprobleme zu bewältigen, Massenbedürfnisse zu befriedigen und zu steuern, Nachrichten an den Mann zu bringen.“"
                            },
                            {
                                "example_id": "cb587c87-0f0f-4126-a7be-aaa31878f076",
                                "sense_id": "d49c3fc5-7a4d-3e49-9c01-931fcc1a304f",
                                "text": "„Wir möchten die Verkehrsprobleme lösen, die Finanzen in den Griff bekommen, mehr Kultur haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
