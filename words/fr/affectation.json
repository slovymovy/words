    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6c826e0-1e6b-3ecb-9902-73c2d1dacd57",
                    "sense_definition": "Action de désigner quelqu'un pour occuper une fonction ou un poste ; ce poste ou ce lieu de travail lui-même.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poste_professionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune professeur a reçu sa première <w>affectation</w> dans un collège de la région."
                        },
                        {
                            "text": "Elle doit rejoindre son nouveau lieu d'<w>affectation</w> dès le début de la semaine prochaine."
                        }
                    ],
                    "synonyms": [
                        "nomination",
                        "poste",
                        "placement"
                    ],
                    "common_phrases": [
                        "lieu d'affectation",
                        "nouvelle affectation"
                    ]
                },
                {
                    "sense_id": "d98f64ce-9633-36b7-9188-d359f0cc4caf",
                    "sense_definition": "Destination ou attribution d'une ressource, d'un bien ou d'une somme d'argent à un usage déterminé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution_ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil municipal a approuvé l'<w>affectation</w> des fonds pour la rénovation de la bibliothèque."
                        },
                        {
                            "text": "L'<w>affectation</w> de ce bâtiment historique à des activités artistiques a ravi les habitants du quartier."
                        }
                    ],
                    "synonyms": [
                        "attribution",
                        "allocation",
                        "destination"
                    ],
                    "common_phrases": [
                        "affectation des fonds",
                        "affectation budgétaire"
                    ]
                },
                {
                    "sense_id": "42398df1-87f3-3283-92d3-96d0c53d525f",
                    "sense_definition": "Manière d'agir, de parler ou d'exprimer des émotions qui manque de naturel et cherche artificiellement à impressionner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il répondait toujours simplement et sans la moindre <w>affectation</w> aux questions des journalistes."
                        },
                        {
                            "text": "Son ton précieux et son <w>affectation</w> permanente finissaient par agacer tout son entourage."
                        }
                    ],
                    "synonyms": [
                        "artifice",
                        "maniérisme",
                        "prétention"
                    ],
                    "antonyms": [
                        "naturel",
                        "simplicité",
                        "spontanéité"
                    ],
                    "common_phrases": [
                        "sans affectation",
                        "avec affectation"
                    ]
                },
                {
                    "sense_id": "36038652-9908-31dc-8668-cf9acfffed93",
                    "sense_definition": "En informatique, opération consistant à attribuer une valeur précise à une variable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En programmation, le signe égal sert généralement à effectuer une <w>affectation</w> de valeur."
                        },
                        {
                            "text": "Le compilateur signale une erreur lors de l'<w>affectation</w> d'une chaîne de caractères à un entier."
                        }
                    ],
                    "synonyms": [
                        "assignation"
                    ],
                    "common_phrases": [
                        "opérateur d'affectation"
                    ]
                },
                {
                    "sense_id": "8bb23f8d-0eed-3234-94a4-0247ecf90c2c",
                    "sense_definition": "En droit administratif, acte juridique qui destine un bien au service public ou à l'usage direct du public.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>affectation</w> d'un terrain communal à la voirie publique entraîne son incorporation immédiate au domaine public."
                        },
                        {
                            "text": "Avant de vendre cet ancien tribunal, la commune doit prononcer la fin de son <w>affectation</w> légale."
                        }
                    ],
                    "antonyms": [
                        "désaffectation"
                    ]
                }
            ]
        }
    ]
}