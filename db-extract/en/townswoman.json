                                "target_senses": [
                                    {
                                        "sense_id": "c809a4cf-06f4-3e30-bb91-79ff6dd460e6",
                                        "entry_id": "1435233a-b967-3044-a403-e26aa6e9dbd9",
                                        "glosses": [
                                            "Celle qui habite une ville ou une zone urbaine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bf3f136-9c39-385b-bd15-e5c16331d31f",
                                        "entry_id": "1435233a-b967-3044-a403-e26aa6e9dbd9",
                                        "glosses": [
                                            "Voiture hippomobile publique utilisée en milieu urbain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee90d1e-f0c1-4206-acb3-448cf4a18055",
                                                "sense_id": "3bf3f136-9c39-385b-bd15-e5c16331d31f",
                                                "text": "— Si nous menions Gazonal chez la mère Fontaine, dit Bixiou qui fit signe à un cocher de citadine d’avancer, ce sera passer du sévère au fantastique. -- Cocher, Vieille rue du Temple."
                                            },
                                            {
                                                "example_id": "0585a275-f09b-45c4-bb86-7616d22ae0c7",
                                                "sense_id": "3bf3f136-9c39-385b-bd15-e5c16331d31f",
                                                "text": "À la porte de la fatale maison, stationnait une citadine à deux chevaux, de celles qui s’appellent Compagnie générale, du nom de l’entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e09bd521-f8d8-385d-820b-17db59dfa79b",
                                        "entry_id": "1435233a-b967-3044-a403-e26aa6e9dbd9",
                                        "glosses": [
                                            "Petite voiture particulière destinée principalement à l’usage urbain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3037c34f-f3d1-400b-b7d5-a4cc5012a899",
                                                "sense_id": "e09bd521-f8d8-385d-820b-17db59dfa79b",
                                                "text": "DS vient d’annoncer que les futurs propriétaires d’une DS3 peuvent choisir un toit à l’emblème de leur région pour leur citadine."
                                            },
                                            {
                                                "example_id": "96ff6018-d029-4a9e-981f-84c4e7ed6c0f",
                                                "sense_id": "e09bd521-f8d8-385d-820b-17db59dfa79b",
                                                "text": "Un peu plus loin dans l’avenue, chez Axone Automobile, un concessionnaire Volkswagen, on n’est pas plus inquiets : « Quand ils arrivent ici, les clients ont déjà choisi, donc je ne crois pas que ce soit une mesure comme ça qui va les faire basculer d’un SUV vers une citadine »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citadine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6ac7f2-1761-3877-a731-2a235b907dd8",
                                        "entry_id": "c3ec592f-1966-3226-b422-cef1d6671dd7",
                                        "glosses": [
                                            "Féminin singulier de citadin."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb818c3-7a9e-4552-93b8-bd342896c129",
                                                "sense_id": "5b6ac7f2-1761-3877-a731-2a235b907dd8",
                                                "text": "L’air léger, à haute dose d’oxygène, le changement de régime alimentaire, les bols de lait bourru absorbés à la porte de l’étable et puisés à même le ciselin, le poids de la fatigue accumulée durant l’année citadine, la tension nerveuse privée d’objet qui tout à coup se détend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
