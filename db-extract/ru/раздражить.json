                    },
                    {
                        "form_id": "ccd4088d-256a-4329-93be-ae1250eeff92",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "раздражи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ce2b8cb-c3a5-3138-bb28-8649aa899fa5",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "glosses": [
                            "физиол. воздействовать чем-либо на организм или на отдельный орган, вызывая какую-либо реакцию"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4c842db1-ac78-3a4e-b9d6-cc2d8b166b1c",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "glosses": [
                            "физиол. вызвать боль, зуд и т. п. в чём-либо, воспаление чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1144168-732a-4495-9f12-ea63a66a7cae",
                                "sense_id": "4c842db1-ac78-3a4e-b9d6-cc2d8b166b1c",
                                "text": "Никакими скрабами, термальными водами не пользоваться пока — это только раздражит кожу."
                            }
                        ]
                    },
                    {
                        "sense_id": "82a56f15-3f15-332d-8361-9d1de7149109",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "glosses": [
                            "возбудить, взволновать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc9eb11-58fd-44dc-9558-378ddd1f49b0",
                                "sense_id": "82a56f15-3f15-332d-8361-9d1de7149109",
                                "text": "Открытие тем более неприятное, что оно раздражило интерес к этой женщине, как будто призванной заместить в его жизни Марину."
                            }
                        ]
                    },
                    {
                        "sense_id": "344555e1-6f73-372e-9722-4a6537b1f017",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "glosses": [
                            "перен. усилить, обострить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "969f8ea0-9d6a-3025-ab84-2186bfe0ef8b",
                        "entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "glosses": [
                            "привести в состояние недовольства, досады, злости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33ee138-e827-4676-aa15-eff962e5d53e",
                                "sense_id": "969f8ea0-9d6a-3025-ab84-2186bfe0ef8b",
                                "text": "Она знала, что её приход ночью, в необычное время, раздражит его."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ecf5bf7-3ccd-40cc-bcd2-26ddb97091d0",
                        "source_entry_id": "922fde6d-2c39-3686-b535-e4fef12e8271",
                        "source_sense_description": "воздействовать чем-либо на организм или на отдельный орган, вызывая какую-либо реакцию",
                        "target_lang_word": "irritate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irritate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a17610b-3295-3a85-96ba-80b7cc9aea18",
                                        "entry_id": "50682853-1238-302e-81d2-996187f82ed2",
                                        "glosses": [
                                            "To provoke impatience, anger, or displeasure in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1770b0d-d023-4d21-b902-39e230eaf603",
                                                "sense_id": "8a17610b-3295-3a85-96ba-80b7cc9aea18",
                                                "text": "If thou irritatest my lord, there will come to war against thee all the Getulians, Numidians, and Garamantes, Afric contains."
                                            },
                                            {
                                                "example_id": "43216fb9-d716-4abd-855a-52f0892c28cc",
                                                "sense_id": "8a17610b-3295-3a85-96ba-80b7cc9aea18",
                                                "text": "Thou scandalizest me and irritatest my nature as much as it possibly can be irritated."
                                            },
                                            {
                                                "example_id": "e264ee77-45c2-43ea-9fe9-b2263489ecc0",
                                                "sense_id": "8a17610b-3295-3a85-96ba-80b7cc9aea18",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b88dc99e-112f-3535-96a9-fab274ba7a3a",
                                        "entry_id": "50682853-1238-302e-81d2-996187f82ed2",
                                        "glosses": [
                                            "To cause or induce displeasure or irritation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8570834f-0c2d-3987-ba6d-94e2b6d4d8f1",
                                        "entry_id": "50682853-1238-302e-81d2-996187f82ed2",
                                        "glosses": [
                                            "To induce pain in (all or part of a body or organism)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "irritate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f2ae23-30fd-309a-9103-13f8586bd4ef",
                                        "entry_id": "db0f4e40-380c-3b46-a2ca-21963d3f25c8",
                                        "glosses": [
                                            "To render null and void."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f24377-3d67-442b-8ba0-360ac4bd9b55",
                                                "sense_id": "95f2ae23-30fd-309a-9103-13f8586bd4ef",
                                                "text": "c. 1634-1661 John Bramhall, Protestants' Ordination Defended\nAre human laws presently superfluous, so often as they do not irritate or abrogate Divine laws ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
