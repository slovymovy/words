                        "cross_references": [
                            {
                                "target_word": "privilege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f946552-8635-364a-aac5-65ec9921f1d8",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "An exemption from certain laws granted by the Pope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A particular benefit, advantage, or favor; a right or immunity enjoyed by some but not others; a prerogative, preferential treatment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31e5f31-88bc-4a13-a61e-0cfc31b0d3ec",
                                                "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                                "text": "All first-year professors here must teach four courses a term, yet you're only teaching one! What entitled you to such a privilege?"
                                            },
                                            {
                                                "example_id": "b6ded33e-1c40-4878-b03e-a5e38fab809a",
                                                "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                                                "text": "Special privileges should be reserved for family and village life, while steps should be taken to prevent families and family ownings from being broken up by inheritance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffecb6c2-1ba5-3881-a98e-7222a1b15fe1",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "An especially rare or fortunate opportunity; the good fortune (to do something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc91a48-65f2-49ec-bd31-2b4e6d01a92a",
                                                "sense_id": "ffecb6c2-1ba5-3881-a98e-7222a1b15fe1",
                                                "text": "I had the privilege to sit near him in the House for a small part of his Commons service and there was an additional device provided to aid his participation in debates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "The fact of being privileged; the status or existence of (now especially social or economic) benefit or advantage within a given society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162660a7-d7f5-44a7-9f24-c8117402bb9a",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "People who at any other time would cling like glue to their miserable scraps of privilege, will surrender them fast enough when their country is in danger."
                                            },
                                            {
                                                "example_id": "4edc08a3-0a93-4a5c-b248-c6c37cb4b52b",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "There is no complexity expressed in the feverish discussions of white privilege that periodically grips South Africa's chattering class."
                                            },
                                            {
                                                "example_id": "69d00887-4a8e-4dfd-bfd0-90eda03d4650",
                                                "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                                                "text": "South Africa's 'miracle transition' has not put an end to white privilege."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8203613-fdbb-3dc9-8bbf-064688ee7ce7",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A right or immunity enjoyed by a legislative body or its members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4d44de-cb70-48de-9a8d-97a0f6f3007a",
                                                "sense_id": "d8203613-fdbb-3dc9-8bbf-064688ee7ce7",
                                                "text": "Dr Grigori Loutchansky is – according to a congressman speaking under congressional privilege – a \"purported Russian mob figure\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16f6829-c038-335a-90c0-5b2027a96f2f",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A stock market option."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf4bfce5-79e9-31b2-9ea2-60741ce20fda",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "A common law doctrine that protects certain communications from being used as evidence in court."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e528c1cd-63e3-4f37-8604-1444df6d7635",
                                                "sense_id": "bf4bfce5-79e9-31b2-9ea2-60741ce20fda",
                                                "text": "Your honor, my client is not required to answer that; her response is protected by attorney-client privilege."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf4057b7-7987-39eb-9c08-e13eb478d63d",
                                        "entry_id": "57cdddc2-23f6-3937-b398-a1294c94db28",
                                        "glosses": [
                                            "An ability to perform an action on the system that can be selectively granted or denied to users."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
