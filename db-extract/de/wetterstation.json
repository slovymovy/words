                ],
                "senses": [
                    {
                        "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                        "entry_id": "dad2dfb6-5e62-3c14-9498-29be57a58c36",
                        "glosses": [
                            "meteorologische Station, die Wetterdaten sammelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebc131e-31a6-4525-9ddc-16c4de4e7180",
                                "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                                "text": "„Die GA-Wetterstation befindet sich auf dem Dach des Verlagshauses in Dransdorf.“"
                            },
                            {
                                "example_id": "3ae26e36-c9ee-41e1-9e46-8f78af04fc9b",
                                "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                                "text": "„Die Wetterprognosen werden eher aus den Daten eines weltweiten Verbundes von Wetterstationen, Satelliten- und Radarbildern abgeleitet.“"
                            },
                            {
                                "example_id": "96fa7e18-b2c4-433c-8ef6-fc0262d82d40",
                                "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                                "text": "„In Wetterstation Brocken kommt es morgens zu leichtem Sprühregen und die Temperaturen liegen zwischen 8 und 9°C.“"
                            },
                            {
                                "example_id": "a90819b1-3587-43ce-a728-3b7a5a922832",
                                "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                                "text": "„Die Punktprognosen basieren auf der einzigartigen statistischen Aufbereitung von Meteomedia, die jeder Wetterstation eine dem Standort und den historischen Messdaten angepasste Wetter-Charakteristik zuweist.“"
                            },
                            {
                                "example_id": "13b1848d-11a0-479f-bc64-60ab2de6208d",
                                "sense_id": "1a509bc2-4a0c-34b4-9ee7-7420bc6a655d",
                                "text": "„Die Wetterstation erfasst Niederschlagsereignisse wie Regen oder Schnee, Windgeschwindigkeit und -richtung, die Umgebungshelligkeit, Dämmerung, und empfängt das Funk-Zeittelegramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
