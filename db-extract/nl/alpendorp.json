                "senses": [
                    {
                        "sense_id": "cf8a91f2-6463-3351-99d5-e24b172c945f",
                        "entry_id": "4e4d8c56-1781-3447-82af-2744b11a1fad",
                        "glosses": [
                            "klein dorp gelegen in de Alpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7462a628-bd33-4038-b677-427ca3248e60",
                                "sense_id": "cf8a91f2-6463-3351-99d5-e24b172c945f",
                                "text": "3 - Gelijkmoedigheid De filosoof Friedrich Nietzsche bracht zeven zomers - in 1881 en in de jaren 1883 tot en met 1888 - door in Sils Maria, een hooggelegen Alpendorp in het zuidoosten van Zwitserland."
                            },
                            {
                                "example_id": "73fee1c3-8af2-4a7e-8d4d-36848127f86c",
                                "sense_id": "cf8a91f2-6463-3351-99d5-e24b172c945f",
                                "text": "De verkiezing van Trump, de opkomst van populisten in Frankrijk, Duitsland en Italië worden door Xi beschouwd als nieuwe bewijzen dat het westerse democratische systeem reddeloos is. Het is dat modern China sinds 1978 niet meer zonder de wijde wereld kan, want anders zou Xi er niet over peinzen om naar het Zwitserse Alpendorp af te reizen om 3.000 leden van een bedreigde wereldelite een hart onder de riem te steken."
                            },
                            {
                                "example_id": "97aeec65-6618-47b7-93e9-9bb6149a7290",
                                "sense_id": "cf8a91f2-6463-3351-99d5-e24b172c945f",
                                "text": "11 mensen, onder wie 9 jongeren, sterven onder de sneeuw bij het Franse Alpendorp Les Orres."
                            },
                            {
                                "example_id": "9cb3cce1-e5c1-41a1-8ec0-0ffc6ae77e65",
                                "sense_id": "cf8a91f2-6463-3351-99d5-e24b172c945f",
                                "text": "Zaterdag staat een grote demonstratie gepland in Garmisch-Partenkirchen. Dat ligt twintig kilometer van het Alpendorp Elmau, waar de G7 bijeenkomt. De politie houdt hier rekening met 2000 tot 3000 demonstranten die op geweld uit zijn. Volgens de politie zijn in Garmisch-Partenkirchen al leden van de radicaal-linkse autonomen aangekomen."
                            }
                        ]
                    }
