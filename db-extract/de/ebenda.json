                "senses": [
                    {
                        "sense_id": "5b65f416-3020-32e5-8543-e3845ef86877",
                        "entry_id": "2f978e5d-8687-3c72-a8ad-76c3e0ac0003",
                        "glosses": [
                            "Là aussi, y … aussi, au même endroit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9de953-9a50-485a-ac09-14af001e6517",
                                "sense_id": "5b65f416-3020-32e5-8543-e3845ef86877",
                                "text": "Eduard VII. (englisch Edward VII, gebürtig Kronprinz Albert Edward; * 9. November 1841 im Buckingham Palace, London; † 6. Mai 1910 ebenda) war vom 22. Januar 1901 bis zu seinem Tod König des Vereinigten Königreichs von Großbritannien und Irland, König der Dominions und Kaiser von Indien.",
                                "translation": "Édouard VII (en anglais Edward VII, à sa naissance prince héritier Albert Edward, né le 9 novembre 1841 au Buckingham Palace à Londres et mort le 6 mai 1910 au même endroit) fut, du 22 janvier 1901 jusqu’à sa mort, roi du Royaume-Uni de Grande-Bretagne et d’Irlande, roi des Dominions et empereur d’Inde."
                            }
                        ]
                    },
                    {
                        "sense_id": "3edde76d-250f-3a47-b167-6dae654a545e",
                        "entry_id": "2f978e5d-8687-3c72-a8ad-76c3e0ac0003",
                        "glosses": [
                            "Ibidem, idem, dans les références bibliographiques."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1fd46d-cae5-474f-ac51-52ac451a553c",
                                "sense_id": "3edde76d-250f-3a47-b167-6dae654a545e",
                                "text": "Dieses Thema wurde bereits diskutiert (Schmidt 1870, S. 153), inklusive einer kurzen Einführung (ebenda).",
                                "translation": "Ce sujet a déjà été discuté (Schmidt 1870, p. 153), y compris une brève introduction (ibidem)."
                            }
                        ]
                    }
                ],
