                "translations": [
                    {
                        "translation_id": "4e5c9d35-eb78-4874-99be-bc0579adb184",
                        "source_entry_id": "f1d7ee80-1260-38e0-a3c5-2cdb55fe2197",
                        "source_sense_id": "f38610c1-66fa-3c30-be1f-906a530e6934",
                        "source_sense_description": "iemand die zich te voet door het verkeer verplaatst",
                        "target_lang_word": "Fußgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußgänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                        "entry_id": "472b4a54-9aa3-37bb-aa79-63a6e29dc53e",
                                        "glosses": [
                                            "Person, die zu Fuß unterwegs ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49476e97-99d6-47ad-8149-85f8f0541f73",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "Vor einer Woche hätte ich beinahe einen Fußgänger angefahren."
                                            },
                                            {
                                                "example_id": "be52bcdb-c83b-4840-ac1e-c60e73c93db3",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "Die Fußgänger halten vor dem Zebrastreifen."
                                            },
                                            {
                                                "example_id": "53dadb38-5549-4475-ae02-7d2753f6f1c9",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "„Eine Autodroschke fährt die Invalidenstraße hinauf, schiebt sich langsam durch eine Wirrnis von Fußgängern und Elektrischen, erreicht den freieren Platz vor dem Bahnhof und eilt, wie erlöst hupend, über die Auffahrt am Stettiner Bahnhof.“"
                                            },
                                            {
                                                "example_id": "5ab21dda-3f75-40d4-8d4b-d61c1f3498f2",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "„Fußgänger waren nur wenige unterwegs.“"
                                            },
                                            {
                                                "example_id": "fc589504-fecf-4242-ae79-d4c426037022",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "„Ich bin sowohl Automobilist als auch Fußgänger und entschlossen, mich genau an die Höchstgeschwindigkeit von 50 Stundenkilometern zu halten.“"
                                            },
                                            {
                                                "example_id": "6f5d06bc-f408-4ae2-a456-d2ad68279b12",
                                                "sense_id": "1f6750cf-59b8-39b4-986a-ec6bf2a733af",
                                                "text": "„So hielten sie schon allein ein ungewohnter furchtbarer Motorenlärm und die lauten, nahen Stimmen später Fußgänger wach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f4b0b8d-d505-435c-bd73-4153517da850",
