                "senses": [
                    {
                        "sense_id": "2f4a3120-edb8-36bd-970d-fc1ec6f618e6",
                        "entry_id": "12cc1d84-a2de-3c96-9c39-3565f3a48f27",
                        "glosses": [
                            "Souveraine d’un État indien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7c4b80-f5ff-4878-9c72-3e6f67d61356",
                                "sense_id": "2f4a3120-edb8-36bd-970d-fc1ec6f618e6",
                                "text": "Au Bengale, il y avait naguère la Maharani Surnomaye, dont en temps de disette, la générosité, pour ses tenanciers, suivants et dépendants, et les bonnes œuvres en tout temps, furent honorées non seulement par des titres indigènes mais aussi par une décoration anglaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "99a0ff6b-f08d-30db-ada4-e06abc4ec65b",
                        "entry_id": "12cc1d84-a2de-3c96-9c39-3565f3a48f27",
                        "glosses": [
                            "Épouse d’un maharaja."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e19582-5fa3-4941-b8c5-3f59c87ea5e9",
                                "sense_id": "99a0ff6b-f08d-30db-ada4-e06abc4ec65b",
                                "text": "Quand il y arriva, le maharana d’alors venait de mourir; la maharani veuve, seule avec son jeune fils de dix ans (le maharana actuel), avait demandé au gouvernement anglais un tuteur pour son enfant autant qu’un directeur politique pour ses États."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3ccbbe8-a9b7-4609-8e22-f4d242f2964a",
                        "source_entry_id": "12cc1d84-a2de-3c96-9c39-3565f3a48f27",
                        "target_lang_word": "maharani",
                        "target_lang_code": "en",
