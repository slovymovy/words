                                "nl": "Het is vanochtend buiten <w>ontzettend</w> koud, trek je warm aan voordat je naar buiten gaat.",
                                "de": "Heute Morgen ist es draußen <w>furchtbar</w> kalt, zieh dich warm an, bevor du rausgehst.",
                                "pl": "Dziś rano na dworze jest <w>strasznie</w> zimno, ubierz się ciepło, zanim wyjdziesz.",
                                "it": "Stamattina fuori fa <w>maledettamente</w> freddo, copriti bene prima di uscire.",
                                "cs": "Dnes ráno je venku <w>hrozně</w> zima, pořádně se obleč, než vyjdeš ven.",
                                "tr": "Bu sabah dışarısı <w>bayağı</w> soğuk, dışarı çıkmadan önce iyice sar kendini.",
                                "es": "Hace <w>muchísimo</w> frío fuera esta mañana, abrígate bien antes de salir.",
                                "zh": "今天早上外面<w>很</w>冷，出门前一定要多穿点儿。"
                            }
                        }
