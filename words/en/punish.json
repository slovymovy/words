{
    "word_family": [
        "punishment",
        "punishable",
        "punishing",
        "punisher",
        "punitive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4606199a-b843-3e6b-9305-01bce076cf18",
                    "sense_definition": "To impose a penalty or cause someone to suffer for a crime, fault, or misbehavior, typically by an authority.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher decided to <w>punish</w> the student for cheating on the final exam.",
                            "target_lang_translations": {
                                "ru": "Учитель решил <w>наказать</w> ученика за списывание на итоговом экзамене.",
                                "zh": "老师决定<w>惩罚</w>那个在期末考试中作弊的学生。"
                            }
                        },
                        {
                            "text": "The law needs to <w>punish</w> offenders as a deterrent to others in the community.",
                            "target_lang_translations": {
                                "ru": "Закон должен <w>наказывать</w> правонарушителей в качестве сдерживающего фактора для остальных членов общества.",
                                "zh": "法律需要<w>惩处</w>违法者，以对社区中的其他人起到威慑作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "castigate"
                    ],
                    "antonyms": [
                        "reward",
                        "pardon",
                        "forgive"
                    ],
                    "common_phrases": [
                        "punish offenders",
                        "punish the guilty",
                        "severely punish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Налагать взыскание или заставлять кого-либо страдать за преступление, вину или проступок, обычно со стороны власти.",
                        "zh": "对犯罪、过错或不当行为施加惩罚或使人受苦，通常由权威机构执行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказывать",
                                "target_lang_sense_clarification": "подвергать наказанию"
                            },
                            {
                                "target_lang_word": "наказать",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "карать",
                                "target_lang_sense_clarification": "высокий стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惩罚",
                                "target_lang_sense_clarification": "对过错进行处罚"
                            },
                            {
                                "target_lang_word": "处罚",
                                "target_lang_sense_clarification": "针对违规行为的正式惩戒"
                            },
                            {
                                "target_lang_word": "惩处",
                                "target_lang_sense_clarification": "严厉的惩罚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f484424-3500-373c-a49f-bef88b18c7f5",
                    "sense_definition": "To treat someone or something in a harsh, unfair, or damaging way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mistreatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain will <w>punish</w> the crops if it does not stop soon.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>погубит</w> урожай, если скоро не прекратится.",
                                "zh": "如果大雨不停，庄稼将会受到严重的<w>损害</w>。"
                            }
                        },
                        {
                            "text": "Some critics argue that the new tax laws <w>punish</w> small business owners unfairly.",
                            "target_lang_translations": {
                                "ru": "Некоторые критики утверждают, что новые налоговые законы несправедливо <w>ущемляют</w> владельцев малого бизнеса.",
                                "zh": "一些评论家认为，新的税法对小企业主来说非常<w>不利</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mistreat"
                    ],
                    "common_phrases": [
                        "punish the body",
                        "punish initiative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к кому-либо или чему-либо сурово, несправедливо или причинять вред.",
                        "zh": "以严厉、不公平或有害的方式对待某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказывать",
                                "target_lang_sense_clarification": "в переносном смысле, ставить в невыгодное положение"
                            },
                            {
                                "target_lang_word": "губить",
                                "target_lang_sense_clarification": "о растениях или урожае"
                            },
                            {
                                "target_lang_word": "ущемлять",
                                "target_lang_sense_clarification": "о правах или бизнесе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "对利益或事物造成负面影响"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "使人受苦或受难"
                            },
                            {
                                "target_lang_word": "不利于",
                                "target_lang_sense_clarification": "对某人或某事造成不公平的负面后果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15c195e3-89ab-367c-93c5-467264c0f69e",
                    "sense_definition": "To handle or beat something severely; to subject to heavy wear or physical force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer continued to <w>punish</w> his opponent with a series of heavy blows to the ribs.",
                            "target_lang_translations": {
                                "ru": "Боксер продолжал <w>избивать</w> своего противника серией тяжелых ударов по ребрам.",
                                "zh": "拳击手继续用一系列重拳<w>击打</w>对手的肋部。"
                            }
                        },
                        {
                            "text": "Driving on these rough mountain roads will really <w>punish</w> your car's suspension system.",
                            "target_lang_translations": {
                                "ru": "Езда по этим неровным горным дорогам действительно <w>угробит</w> подвеску вашего автомобиля.",
                                "zh": "在这些崎岖的山路上行驶，真的会严重<w>损耗</w>你汽车的悬挂系统。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "punish the opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестко обращаться с чем-либо или сильно бить; подвергать сильному износу или физическому воздействию.",
                        "zh": "猛烈地击打某物；使其承受严重的磨损或物理压力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избивать",
                                "target_lang_sense_clarification": "наносить удары противнику"
                            },
                            {
                                "target_lang_word": "гробить",
                                "target_lang_sense_clarification": "подвергать сильному износу технику"
                            },
                            {
                                "target_lang_word": "изматывать",
                                "target_lang_sense_clarification": "подвергать тяжелому испытанию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重击",
                                "target_lang_sense_clarification": "猛烈地打击"
                            },
                            {
                                "target_lang_word": "摧残",
                                "target_lang_sense_clarification": "使事物受到严重损害"
                            },
                            {
                                "target_lang_word": "损耗",
                                "target_lang_sense_clarification": "因过度使用而导致磨损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ac649d5-b267-3c51-a510-b5d056cbee15",
                    "sense_definition": "To consume a very large quantity of food or drink quickly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, the group sat on the porch <w>punishing</w> the gin until late at night.",
                            "target_lang_translations": {
                                "ru": "После долгого похода группа сидела на веранде, <w>приговаривая</w> джин до поздней ночи.",
                                "zh": "长途跋涉后，这群人坐在门廊上一直<w>狂饮</w>杜松子酒到深夜。"
                            }
                        },
                        {
                            "text": "They spent the entire evening <w>punishing</w> the buffet until there was no food left.",
                            "target_lang_translations": {
                                "ru": "Они провели весь вечер, <w>опустошая</w> шведский стол, пока не осталось никакой еды.",
                                "zh": "他们整个晚上都在<w>扫荡</w>自助餐，直到食物被吃得一干二净。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "punishing the bottle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe excessive consumption"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро употреблять очень большое количество еды или напитков.",
                        "zh": "快速且大量地消耗食物或饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приговаривать",
                                "target_lang_sense_clarification": "разговорное, быстро съедать или выпивать"
                            },
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "о еде в больших количествах"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "о запасах спиртного или еды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂饮",
                                "target_lang_sense_clarification": "大量饮酒"
                            },
                            {
                                "target_lang_word": "扫荡",
                                "target_lang_sense_clarification": "形容快速吃光所有食物"
                            },
                            {
                                "target_lang_word": "大吃大喝",
                                "target_lang_sense_clarification": "形容无节制地进食"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}