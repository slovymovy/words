                            {
                                "example_id": "26a24b59-079f-4af6-b90e-410c53cf58fd",
                                "sense_id": "35d9d8ca-d700-3672-b0e0-c72f7cbbb91e",
                                "text": "De collegezaal was maar net groot genoeg voor de groep eerstejaarsstudenten."
