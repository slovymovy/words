                "translations": [
                    {
                        "translation_id": "83ad78a9-4153-423c-9f5d-a805561a2806",
                        "source_entry_id": "67376034-a2c0-3323-b33e-e691e7b56d36",
                        "source_sense_id": "cc27e40a-69f0-3878-a208-4ea1ada58850",
                        "target_lang_word": "high-octane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "high-octane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "706f44a8-ce8d-35e1-a659-e6770573d608",
                                        "entry_id": "00fc3300-0617-3147-b322-be3bf4a30c8b",
                                        "glosses": [
                                            "Of fuel, having a high octane number, good antiknock characteristics; used in high-performance vehicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a586887d-dfd2-4d8a-a7be-8fb58f919193",
                                                "sense_id": "706f44a8-ce8d-35e1-a659-e6770573d608",
                                                "text": "Now, to do the job, I need some high-octane gasoline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7423f84b-edb1-3a61-b88e-a9bad3aaabb1",
                                        "entry_id": "00fc3300-0617-3147-b322-be3bf4a30c8b",
                                        "glosses": [
                                            "High-powered, energetic, forceful or dynamic."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cbb2e82-a05a-49f4-8ad0-a6597d9fc15c",
                                                "sense_id": "7423f84b-edb1-3a61-b88e-a9bad3aaabb1",
                                                "text": "So what if the Greeks never had BMX bikes? This year's Olympic Games, which kick off August 8 in China, add high-octane competitions—BMX racing and open-water swimming—and include sports like table tennis taken to Olympian levels."
                                            },
                                            {
                                                "example_id": "96abfacb-5bdd-4c06-9c71-9da15e39f67c",
                                                "sense_id": "7423f84b-edb1-3a61-b88e-a9bad3aaabb1",
                                                "text": "Will the exponential growth in TV rights income at home and abroad that has fuelled the endless inflation of the Premier League’s high-octane balloon ever level off?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6520769-1a94-3d1b-8592-d9e00c35eeb1",
                                        "entry_id": "00fc3300-0617-3147-b322-be3bf4a30c8b",
                                        "glosses": [
                                            "Of a drink, highly intoxicating or caffeinated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36369931-f23d-491c-934f-14ac63405ce4",
                                                "sense_id": "f6520769-1a94-3d1b-8592-d9e00c35eeb1",
                                                "text": "There's no question that the high-octane beers of Marshall Wharf have had a massive influence on the breweries that have opened in Maine since 2007."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
