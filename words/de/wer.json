{
    "word_family": [
        "irgendwer",
        "werauchimmer"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "d1955574-ee64-304e-b07d-236a083c5819",
                    "sense_definition": "Fragt als Interrogativpronomen nach der Identität einer Person oder mehrerer Personen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wer</w> hat dir gestern Abend bei den schweren Hausaufgaben geholfen?"
                        },
                        {
                            "text": "Ich möchte gerne wissen, <w>wer</w> morgen alles zu unserer Party kommt."
                        }
                    ],
                    "common_phrases": [
                        "wer weiß"
                    ]
                },
                {
                    "sense_id": "2a808c53-aa17-3b20-8a21-223606833980",
                    "sense_definition": "Bezeichnet als Indefinitpronomen eine unbestimmte oder nicht näher bekannte Person.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hast du gerade gehört, ob draußen an der Haustür <w>wer</w> geklingelt hat?"
                        },
                        {
                            "text": "Ich glaube nicht, dass heute noch <w>wer</w> im Büro vorbeischauen wird."
                        }
                    ],
                    "synonyms": [
                        "jemand",
                        "irgendjemand",
                        "irgendwer",
                        "einer",
                        "irgendeiner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "In der gesprochenen Sprache sehr gebräuchlich"
                        }
                    ]
                },
                {
                    "sense_id": "30516ee4-bfed-38fb-a745-51e37f514cb5",
                    "sense_definition": "Leitet als verallgemeinerndes Relativpronomen einen Nebensatz ein; diejenige Person, welche.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wer</w> die Prüfung bestehen will, muss sich gründlich darauf vorbereiten."
                        },
                        {
                            "text": "<w>Wer</w> heute noch mitfahren möchte, sollte sich bald bei mir melden."
                        }
                    ],
                    "common_phrases": [
                        "wer auch immer"
                    ]
                },
                {
                    "sense_id": "aee47cfd-06af-358b-a806-151c64694b5d",
                    "sense_definition": "Eine bedeutende, erfolgreiche oder angesehene Person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bedeutung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach jahrelanger harter Arbeit hatte er endlich das Gefühl, wieder <w>wer</w> zu sein."
                        },
                        {
                            "text": "Seit er im Fernsehen auftritt, ist er in seiner kleinen Heimatstadt plötzlich <w>wer</w>."
                        }
                    ],
                    "common_phrases": [
                        "wieder wer sein"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Überwiegend umgangssprachlich verwendet"
                        }
                    ]
                }
            ]
        }
    ]
}