                "senses": [
                    {
                        "sense_id": "fce9dbb0-1823-3171-a37a-4fc9d4149f45",
                        "entry_id": "8d564fdf-4010-3966-b067-1486ed33e8d7",
                        "glosses": [
                            "Fingernagel am Daumen (dickster Finger mit Sattelgelenk an der Innenseite jeder Hand)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb010063-b5a7-4611-bfca-1ef1313c24f2",
                                "sense_id": "fce9dbb0-1823-3171-a37a-4fc9d4149f45",
                                "text": "Franz hat sich beim Stapeln der Paletten den Daumennagel eingerissen."
                            },
                            {
                                "example_id": "bb72ac39-4adf-4446-ba9b-abb9c615f02a",
                                "sense_id": "fce9dbb0-1823-3171-a37a-4fc9d4149f45",
                                "text": "„Der Beamte begann vorsichtig damit, seinen Daumennagel zu glätten.“"
                            },
                            {
                                "example_id": "99683626-6a82-4fe5-8ebd-6bfd3cbbd020",
                                "sense_id": "fce9dbb0-1823-3171-a37a-4fc9d4149f45",
                                "text": "„Haffner schmatzte zufrieden, klemmte den zweiten Hörer mit der Schulter ans Ohr und setzte die Säuberung seines linken Daumennagels fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
