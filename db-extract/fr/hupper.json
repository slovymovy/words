                "senses": [
                    {
                        "sense_id": "227527c4-727c-3382-baba-782c03afe03e",
                        "entry_id": "e613dd84-8158-3436-9d08-16b6b2262f27",
                        "glosses": [
                            "En parlant des chouans, crier d’une certaine façon qui leur est propre."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "452b8130-432c-499b-a08e-897e8882eda9",
                                "sense_id": "227527c4-727c-3382-baba-782c03afe03e",
                                "text": "A la sortie de l’église la bachellerie se trouvait encore là, tirant des coups de fusil en l’air et huppant comme des chouans."
                            },
                            {
                                "example_id": "cb1527e8-f0a2-41f9-b454-204acffbfda2",
                                "sense_id": "227527c4-727c-3382-baba-782c03afe03e",
                                "text": "Cinq cents gosiers se mettent à « hupper » le cri de guerre qui terrorisera tant les Bleus pendant quelques années."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed1c25d-6ca1-32a5-87ac-15e5e0292f7f",
                        "entry_id": "e613dd84-8158-3436-9d08-16b6b2262f27",
                        "glosses": [
                            "Doter d’une huppe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d6fce0-1c62-4741-80d0-edd4b1ed8a4e",
                                "sense_id": "6ed1c25d-6ca1-32a5-87ac-15e5e0292f7f",
                                "text": "Les jolis doigts de Clotilde continuaient de décrêpeler la tignasse ; ils s’efforçaient de hupper la fille, comme une petite alouette."
                            }
                        ]
                    }
                ],
