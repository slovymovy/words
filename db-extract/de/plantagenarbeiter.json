                "senses": [
                    {
                        "sense_id": "c383bccc-85ed-3ecb-b13c-ac091ecd46ae",
                        "entry_id": "89323ede-40bd-3354-998a-874e368ba36a",
                        "glosses": [
                            "jemand, der auf einer Plantage als Arbeiter beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec032cad-a897-4e2b-8d86-6b569dd67b73",
                                "sense_id": "c383bccc-85ed-3ecb-b13c-ac091ecd46ae",
                                "text": "Das hawaiischste aller Instrumente, die Ukulele, ist ein Souvenir portugiesischer Plantagenarbeiter aus dem Ende des vorigen Jahrhunderts."
                            },
                            {
                                "example_id": "38a855ee-f69c-4323-b547-1c5c64ae9624",
                                "sense_id": "c383bccc-85ed-3ecb-b13c-ac091ecd46ae",
                                "text": "„Der gesetzliche Mindestlohn beträgt 169 Rupien pro Tag, etwa 2,30 Euro. Hier bekommen die Plantagenarbeiter nur 115 Rupien, rund 1,57 Euro.“"
                            },
                            {
                                "example_id": "1ed3d0b9-6c8d-45a4-a990-b1a128c1beac",
                                "sense_id": "c383bccc-85ed-3ecb-b13c-ac091ecd46ae",
                                "text": "„Besonders prekär ist die Lage von Plantagenarbeitern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
