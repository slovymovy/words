{
    "word_family": [
        "comfort",
        "comfortable",
        "comforting",
        "discomfort"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d7f85b84-7e2e-3859-a0c4-ff7f51946c75",
                    "sense_definition": "Feeling less sad, worried, or afraid because of support or reassurance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>comforted</w> knowing that my friends were there to support me during the difficult time.",
                            "target_lang_translations": {
                                "zh": "知道朋友们在那段困难时期支持我，我感到很<w>安慰</w>。"
                            }
                        },
                        {
                            "text": "She was <w>comforted</w> by the kind words her teacher said after the exam.",
                            "target_lang_translations": {
                                "zh": "考试后老师的暖心话语让她感到<w>宽慰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reassured",
                        "soothed",
                        "relieved"
                    ],
                    "antonyms": [
                        "distressed",
                        "anxious"
                    ],
                    "target_lang_definitions": {
                        "zh": "因得到支持或安慰而感到不再那么悲伤、担忧或恐惧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "感到安慰",
                                "target_lang_sense_clarification": "形容人内心因获得支持而产生的平静状态。"
                            },
                            {
                                "target_lang_word": "宽慰",
                                "target_lang_sense_clarification": "指心情舒畅、得到宽解。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "614dc958-fb9a-36e0-941b-b11ac44f59c7",
                    "sense_definition": "Simple past and past participle of <w>comfort</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>comforted</w> his crying sister until she finally stopped.",
                            "target_lang_translations": {
                                "zh": "他一直<w>安慰</w>着哭泣的妹妹，直到她终于停了下来。"
                            }
                        },
                        {
                            "text": "The child was <w>comforted</w> by his mother after he fell down.",
                            "target_lang_translations": {
                                "zh": "孩子摔倒后，母亲<w>抚慰</w>了他。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb comfort."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "安慰，抚慰（某人）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安慰",
                                "target_lang_sense_clarification": "通过言语或行动减轻他人的痛苦或不安。"
                            },
                            {
                                "target_lang_word": "抚慰",
                                "target_lang_sense_clarification": "侧重于通过关怀来平复他人的情绪。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}