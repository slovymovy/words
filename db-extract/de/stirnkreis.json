                "senses": [
                    {
                        "sense_id": "44f064cc-7b7b-32b8-9453-838222760b83",
                        "entry_id": "4011de2a-96bc-3afa-acf0-e5c2af5fe64c",
                        "glosses": [
                            "Sozialform, bei der die Spielenden oder Tanzenden einander zur Kreismitte hin mit ihrer Vorderseite zugewendet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af28c25a-3bac-4203-8119-db782fd570f1",
                                "sense_id": "44f064cc-7b7b-32b8-9453-838222760b83",
                                "text": "„Bei der Kenntnisvermittlung können wir uns auf die Erarbeitung einfacher Begriffe wie Barren, Reck, Bock, Kasten, Medizinball, Reihe, Linie, Stirnkreis, Flankenkreis, Riegenordnung, Staffelwettkampf usw. beschränken.“"
                            },
                            {
                                "example_id": "0e8c886f-f66f-44c6-b02c-ab83986deebb",
                                "sense_id": "44f064cc-7b7b-32b8-9453-838222760b83",
                                "text": "„Die Kinder bilden einen Stirnkreis und fassen sich gegenseitig bei den Händen.“"
                            },
                            {
                                "example_id": "09ff6af8-99f5-4f48-8d5f-063cf0f1ba3c",
                                "sense_id": "44f064cc-7b7b-32b8-9453-838222760b83",
                                "text": "„Vier Paare in Kreuzaufstellung, die Dirndl stehen rechts neben ihren Burschen mit Blick zur Kreismitte und bilden einen Stirnkreis.“"
                            },
                            {
                                "example_id": "33845351-3073-4b69-8e02-83d607864cb7",
                                "sense_id": "44f064cc-7b7b-32b8-9453-838222760b83",
                                "text": "„Bei Stirnkreisen kann sich der Lehrer auf die Kreislinie stellen, bei Flankenkreisen sollte sein Standpunkt außerhalb des Kreises sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
