                        "sense_id": "998b5b62-2cd7-323c-a882-6ad03eecde1a",
                        "entry_id": "4443ff8d-8eb3-310b-bf3d-ce1daf2e962f",
                        "glosses": [
                            "Festakt, bei dem ein Bahnhof offiziell seiner Bestimmung übergeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501ec9d4-1da1-47d8-bbf3-ae13e10ee267",
                                "sense_id": "998b5b62-2cd7-323c-a882-6ad03eecde1a",
                                "text": "„So eine Bahnhofseinweihung war seinerzeit ein tagelanges Volksfest.“"
                            },
                            {
                                "example_id": "da7ed7c6-4da9-46cf-b10a-981195d6a268",
                                "sense_id": "998b5b62-2cd7-323c-a882-6ad03eecde1a",
                                "text": "„Am 2. Mai fuhr der erste Zug durch Kamen nach Hamm; am 15. Mai war die offizielle Bahnhofseinweihung in Kamen und Hamm.“"
                            },
                            {
                                "example_id": "5d47cb6b-a495-43cc-af13-8e7be0409245",
                                "sense_id": "998b5b62-2cd7-323c-a882-6ad03eecde1a",
                                "text": "„Worauf Passant Mumenthaler wartete, dürfte auch für viele der geladenen Gäste aus Wirtschaft, Politik und Sport der eigentliche Höhepunkt der offiziellen Bahnhofseinweihung gewesen sein: die Taufe des neuen Fernverkehrs-Doppelstockzugs der SBB.“"
                            }
                        ],
