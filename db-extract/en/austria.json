                "senses": [
                    {
                        "sense_id": "4d3ec149-e0a3-3606-9a35-a3b6bd43ead0",
                        "entry_id": "458f6a4a-98b6-3c09-98a6-f096ad842c30",
                        "glosses": [
                            "A country in Central Europe. Official name: Republic of Austria. Capital and largest city: Vienna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82deebe6-5bc0-42e2-9d9f-0d3b4c64adb4",
                                "sense_id": "4d3ec149-e0a3-3606-9a35-a3b6bd43ead0",
                                "text": "Hungary, Austria and Poland are still refusing to participate in the resettlement plan, due to end in September. Other Eastern European countries, such as the Czech Republic, Bulgaria, Croatia and Slovakia, are only doing so on a limited basis, the commission said."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f155d835-3c9b-442e-8d17-a6ac1328040d",
