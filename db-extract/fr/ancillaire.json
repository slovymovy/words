                                        "entry_id": "eb597a12-85e7-3882-ac66-2ebace87ecec",
                                        "glosses": [
                                            "Subordinate; secondary; auxiliary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb224c01-fdb1-4ee0-a8b9-b26c4f6eaabe",
                                                "sense_id": "d44ecf10-8d62-333b-90ae-551e30cc94a7",
                                                "text": "[…] how easily he took all things along with him,—the persons, the opinions, and the day, and nature became ancillary to a man."
                                            },
                                            {
                                                "example_id": "739a2852-67f4-4791-9063-35411ef616cd",
                                                "sense_id": "d44ecf10-8d62-333b-90ae-551e30cc94a7",
                                                "text": "[E]very organ of the body, whatever function it may perform, must also perform the other four functions in an ancillary manner."
                                            },
                                            {
                                                "example_id": "4075637b-cb3e-4afa-b333-ec9713c960ce",
                                                "sense_id": "d44ecf10-8d62-333b-90ae-551e30cc94a7",
                                                "text": "The cafeteria is primarily used by students and staff (academic, administrative, and ancillary)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ancillary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f141b2b-d2f0-3504-affd-49d2c626e2ea",
                                        "entry_id": "b5e4b1c7-0c87-315e-a90b-30b110b4dd33",
                                        "glosses": [
                                            "Something that serves an ancillary function, such as an easel for a painter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
