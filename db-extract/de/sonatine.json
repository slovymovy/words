                ],
                "senses": [
                    {
                        "sense_id": "2ec383b4-a323-3ca3-b3ee-e379d119579b",
                        "entry_id": "eccd2cef-fb2e-330d-a90b-b96b3b6cdad0",
                        "glosses": [
                            "kleine, vereinfachte Sonate meist nur mit zwei oder drei anstatt der vier Sonatensätze"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "74dec41c-0dcf-4fd5-aa49-165ad894cd92",
                                "sense_id": "2ec383b4-a323-3ca3-b3ee-e379d119579b",
                                "text": "Die Sonatine stellt an den Interpreten in technischer Hinsicht geringere Anforderungen als die Sonate."
                            },
                            {
                                "example_id": "a043c684-698e-49dd-857b-c8c7ee34e20a",
                                "sense_id": "2ec383b4-a323-3ca3-b3ee-e379d119579b",
                                "text": "„Nicht weniger hübsch war die Ravel'sche Sonatine, ebenso wie die Schumann'sche Arabeske, die als erste Zugabe folgen sollte – doch wirkte beides derart gepflegt und kontrolliert, dass auch hier die durchaus vorhandenen Leuchtfeuer allzu matt blieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68d8a12e-c1fd-4fc9-9eff-623ee6d2023d",
                        "source_entry_id": "eccd2cef-fb2e-330d-a90b-b96b3b6cdad0",
                        "source_sense_id": "2ec383b4-a323-3ca3-b3ee-e379d119579b",
                        "source_sense_description": "kleine, vereinfachte Sonate",
                        "target_lang_word": "sonatina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonatina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbdca92b-cfa4-338b-86c6-4395bd02f220",
                                        "entry_id": "b8b8f594-f893-3464-95d5-e729cb97ac10",
                                        "glosses": [
                                            "A musical composition resembling a sonata but shorter or simpler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121d4546-057a-41bf-bb89-8803f303cb83",
                                                "sense_id": "cbdca92b-cfa4-338b-86c6-4395bd02f220",
                                                "text": "A sonatina usually has 2 or 3 rather short movements. While these movements provide contrasts of tempo and mood, they also complement one another, combining to fulfill the overall plan for a complete work in several parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
