                "senses": [
                    {
                        "sense_id": "d81640e0-218b-3a03-b3a8-12130b06c606",
                        "entry_id": "5c159532-40be-39c8-b880-27c648d48895",
                        "glosses": [
                            "gewohnheitsmäßige, als übertrieben eingeschätzte Verwendung der Anrede „sie“"
                        ],
                        "tags": [
                            "leicht abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "dfc05eec-9d94-4a31-94fb-4f0e83ec2632",
                                "sense_id": "d81640e0-218b-3a03-b3a8-12130b06c606",
                                "text": "„»Mama, du bist schuld daran, dass ich es als aktive Genossin so schwer habe«, sagte ich, »diese ewige Siezerei zu Hause!«“"
                            },
                            {
                                "example_id": "faf2abd6-b585-472b-9640-c4f39107997c",
                                "sense_id": "d81640e0-218b-3a03-b3a8-12130b06c606",
                                "text": "„Ich hasse diese Siezerei.“"
                            },
                            {
                                "example_id": "b944b9e1-63fa-4d95-95db-ba2cf9a4fd1d",
                                "sense_id": "d81640e0-218b-3a03-b3a8-12130b06c606",
                                "text": "„Kleine Vorbemerkung: Hier unter südlicher Sonne ist das \"Du\" allgegenwärtig und so haben wir's auch hier auf der Website gehalten. Du, ihr und euer sind an die Stelle der \"Siezerei\" getreten.“"
                            },
                            {
                                "example_id": "cea0c132-ca24-460b-bbd0-f0bdec9c0c10",
                                "sense_id": "d81640e0-218b-3a03-b3a8-12130b06c606",
                                "text": "In vielen Foren wird über die Siezerei gestritten."
                            }
                        ],
