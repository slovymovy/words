                        "glosses": [
                            "Fromage de lait de vache, écrémé puis caillé par présure ou par fermentation lactique, servant à la préparation de la cancoillotte. C'est un fromage fort de Franche-Comté."
                        ],
                        "tags": [
                            "Franche-Comté"
                        ],
                        "examples": [
                            {
                                "example_id": "1a9e3f9b-a8c6-451a-8ea0-76efe3db9df2",
                                "sense_id": "c01be08b-1969-35c0-bbac-193bc1159a78",
                                "text": "Le metton est un produit typiquement comtois."
                            },
                            {
                                "example_id": "ab36a443-d4ba-4758-9430-e7d9ca128977",
                                "sense_id": "c01be08b-1969-35c0-bbac-193bc1159a78",
                                "text": "Le fromager fait cailler – d’où le nom cancoillotte – ce lait écrémé avec de la présure & retire le « grain » tel quel – c’est le metton."
                            }
                        ]
                    }
