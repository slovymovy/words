                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb071059-d38a-44c3-8364-7593d8968515",
                        "source_entry_id": "8bd87974-3063-36aa-b0c8-2e4dd0120cc7",
                        "target_lang_word": "à la poursuite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "054c01a1-882a-41a0-a428-943813ff7226",
                        "source_entry_id": "8bd87974-3063-36aa-b0c8-2e4dd0120cc7",
                        "target_lang_word": "après",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "après",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "Marque la postériorité dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b40d1626-b4d3-4e2d-9daf-44d66bf57c99",
                                                "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                                "text": "— Et après ? — lui dis-je.\n— Eh bien ! voilà — répondit-il, il n’y a pas d’après !"
                                            },
                                            {
                                                "example_id": "a591bc67-2bc6-4d9e-8be0-ef8ed860ba4e",
                                                "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                                "text": "Solange, après avoir lancé son ultimatum, s'était renfermée dans un silence inquiétant. Elle s'en tenait à ce qu'elle avait dit […]."
                                            },
                                            {
                                                "example_id": "8af33913-c5f2-4840-b148-daf76e270958",
                                                "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                                "text": "Le jour naissait. Feempje se dressa sur son séant et ne reprit lourdement ses esprits qu’après quelques minutes."
                                            },
                                            {
                                                "example_id": "79690fbd-729e-4ac0-9576-2c1e2c2a2fc8",
                                                "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                                "text": "Reprenons ici l’exemple de l’atrazine, appliquée pour le désherbage des voies de chemin de fer en Suisse. Après avoir été détectée dans les nappes phréatiques, l’atrazine a été remplacée par le diuron."
                                            },
                                            {
                                                "example_id": "9c7e5f8d-6932-472a-9747-cf8c4673ac6e",
                                                "sense_id": "6f764aa0-73f7-313b-be5b-42ad5e382cbf",
                                                "text": "Après avoir garé la voiture près de la gare, empruntez le GR®20 qui longe l’Agnone. En suivant le fléchage, vous parviendrez à la première cascade après 1h de marche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c5a8b4-fc46-3aec-b2ca-e85a2e3e933a",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "Indique l’ordre, le rang immédiatement derrière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "960ce9f7-5225-4b68-934c-f416223ff8c3",
                                                "sense_id": "94c5a8b4-fc46-3aec-b2ca-e85a2e3e933a",
                                                "text": "Mois après mois, record après record, la perspective de maintenir l’élévation de la température moyenne terrestre sous la barre de 1,5 °C de réchauffement par rapport à l’ère préindustrielle s’éloigne irrémédiablement."
                                            },
                                            {
                                                "example_id": "127a8c1a-4da4-4c8c-8e20-26af566186ed",
                                                "sense_id": "94c5a8b4-fc46-3aec-b2ca-e85a2e3e933a",
                                                "text": "La place de quatrième, après les médaillés, est la plus mauvaise place."
                                            },
                                            {
                                                "example_id": "42366dde-3c50-47fa-bee0-78a4c7f7d3c5",
                                                "sense_id": "94c5a8b4-fc46-3aec-b2ca-e85a2e3e933a",
                                                "text": "Après l’or et le platine, l’argent est le plus cher des métaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1080e50a-2f60-394b-b3ad-47ffb7d81c5b",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "Indique un lieu placé derrière, plus loin."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61d54e4-b818-4623-9c15-6763f9575054",
                                                "sense_id": "1080e50a-2f60-394b-b3ad-47ffb7d81c5b",
                                                "text": "Après la porte de Gentilly, tourne à droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38f39b59-5691-3082-8b8e-0890a52eb97f",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "Indique la position où a lieu l’action."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f49dafff-5fee-4f31-993d-d85a1d0649cc",
                                                "sense_id": "38f39b59-5691-3082-8b8e-0890a52eb97f",
                                                "text": "J’étais toujours stupéfaite de voir que son lit n’avait aucun désordre à son lever.\nElle finit par me confier qu’elle épinglait ses draps et ses couvertures après son matelas."
                                            },
                                            {
                                                "example_id": "829f4b78-c80f-4a39-aa3b-1fe910a66387",
                                                "sense_id": "38f39b59-5691-3082-8b8e-0890a52eb97f",
                                                "text": "Deux valises étaient posées à côté de la porte. Après la poignée de la plus petite, était ficelé un rouleau de papier journal qui devait contenir des dessins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5a326a-022b-3327-9695-eef3d2a4c001",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "Indique sur quoi portent certaines actions ou intentions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da867ded-0c12-4fb3-9955-d29360374017",
                                                "sense_id": "af5a326a-022b-3327-9695-eef3d2a4c001",
                                                "text": "Au Labo, c’est après Boucherot que j’ai demandé."
                                            },
                                            {
                                                "example_id": "9727c635-51ba-427a-8ca1-638fdc7d768c",
                                                "sense_id": "af5a326a-022b-3327-9695-eef3d2a4c001",
                                                "text": "Nahoum l’apprit et vint hurler après moi."
                                            },
                                            {
                                                "example_id": "dc630bd7-4030-49f4-8a5e-2d3f353372b5",
                                                "sense_id": "af5a326a-022b-3327-9695-eef3d2a4c001",
                                                "text": "Les chiens aboient après le facteur, ils en ont méchamment après lui."
                                            },
                                            {
                                                "example_id": "a459e137-e99e-4c08-8d14-865b8aad89a8",
                                                "sense_id": "af5a326a-022b-3327-9695-eef3d2a4c001",
                                                "text": "Venez vite ! Les clients s’emportent après le personnel de la réception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a691de54-80a6-32a5-bc8a-129c8844a845",
                                        "entry_id": "55dcd68f-336f-36c4-95ac-49bfc92c412f",
                                        "glosses": [
                                            "en train de."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd42d3a-5808-4904-8673-87c5f0086c2b",
                                                "sense_id": "a691de54-80a6-32a5-bc8a-129c8844a845",
                                                "text": "Mon fils m’apporte: cinq livres de bibliothèque par semaine pis je passe à travers. Là je suis après lire la vie de Schumann que j’vais peut-être lue il y a longtemps, mais que j’avais pas mémorisée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "après",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                        "entry_id": "308e63d5-f9cc-32dc-880d-1dccd86815ba",
                                        "glosses": [
                                            "S’emploie adverbialement par ellipse."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9047f82d-8c91-40b2-bd0a-1f29478759f7",
                                                "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                                "text": "Quand il fut hors de vue de la cabane et du mâtin, il entra dans le bois, d’où il ressortit un peu après, écorçant avec son couteau une trique de grosseur assez respectable."
                                            },
                                            {
                                                "example_id": "e7c2c6d3-e6d3-45d5-a90a-3ad20e970408",
                                                "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                                "text": "J'ai remarqué deux lyonnaisismes : le mot « laurelle, » qui sert, à Lyon, à désigner l'arbuste qui, dans le reste de la France, se nomme « laurier-rose ; » et la préposition « après » employée adverbialement dans le sens de « ensuite, » emploi non prévu par le Dictionnaire de l'Académie française."
                                            },
                                            {
                                                "example_id": "d51bd7ca-e53a-4e3a-a136-41aed14d6e9b",
                                                "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                                "text": "Vous irez devant, et lui après."
                                            },
                                            {
                                                "example_id": "a2b129a2-e69e-4d46-b307-019a28a154d5",
                                                "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                                "text": "Nous en parlerons après."
                                            },
                                            {
                                                "example_id": "4a8bebab-5150-4721-b7f4-15938a2f199c",
                                                "sense_id": "ff7d3509-6fed-3da1-a713-1cdbe803188c",
                                                "text": "Il n’arriva que longtemps après."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5ab674-c1d9-3220-9d1c-649658b5d329",
                                        "entry_id": "308e63d5-f9cc-32dc-880d-1dccd86815ba",
                                        "glosses": [
                                            "Manière de questionner ou d'inciter ceux qui suspendent leur récit à le continuer. En ce sens, il est synonyme d’ensuite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32465bfe-8cc8-48ca-a525-52c8a24ab2c5",
                                                "sense_id": "9c5ab674-c1d9-3220-9d1c-649658b5d329",
                                                "text": "Il vous a dit qu’il me connaissait : après ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d1ae45-fbb9-3897-90fe-6258b8e3877a",
                                        "entry_id": "308e63d5-f9cc-32dc-880d-1dccd86815ba",
                                        "glosses": [
                                            "Qu’en résultera-t-il ?"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b68721-8805-4332-840f-c6abe17defc2",
                                                "sense_id": "44d1ae45-fbb9-3897-90fe-6258b8e3877a",
                                                "text": "Quand vous aurez frappé votre ennemi, vous serez vengé; et après ?"
                                            },
                                            {
                                                "example_id": "813ee126-f1e7-42cc-97d9-37c09385be4f",
                                                "sense_id": "44d1ae45-fbb9-3897-90fe-6258b8e3877a",
                                                "text": "— Des insultes, des insultes ? — Eh bien, après ? Est-ce que tu t’en portes plus mal, dis, mon garçon ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1c6534-49e1-3469-96f4-53702366c12e",
                                        "entry_id": "308e63d5-f9cc-32dc-880d-1dccd86815ba",
                                        "glosses": [
                                            "Mais ; dès lors ; néanmoins ; par ailleurs ; cela étant ; permet de nuancer un propos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5bf2c25-7e6b-46eb-a6ce-2be9cc4423e2",
                                                "sense_id": "1d1c6534-49e1-3469-96f4-53702366c12e",
                                                "text": "Mais est-ce que cela doit être l’objet d'une mise à jour centrale ? Cette stratégie n’a jamais empêché Apple de sortir des iPad au beau milieu du printemps. Après il est vrai que la tablette joue un rôle nettement moins central que l’iPhone…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "après",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "523b2567-0e55-32f5-8eab-9652ef7eb9e5",
                                        "entry_id": "9a5de1da-02cc-3215-b7cd-df43865122da",
                                        "glosses": [
                                            "Période, temps qui suit un événement donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3587b7-7c5a-4a2e-b705-5526c4b4a4a6",
                                                "sense_id": "523b2567-0e55-32f5-8eab-9652ef7eb9e5",
                                                "text": "Grâce à vos expériences débiles, une certaine idée du temps, de votre temps, nous a été inculquée. Il y avait un avant les filtres, il se devait d'y avoir un après."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87607549-4c14-3d3d-b1b0-4b0f7d32a16a",
                                        "entry_id": "9a5de1da-02cc-3215-b7cd-df43865122da",
                                        "glosses": [
                                            "(Apocope de après-bal) Réunion festive qui suit un événement."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "note": "S'emploie habituellement pour les bals de finissants",
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "après",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3021fe4d-a612-3fde-b724-8e0e637ae66a",
                                        "entry_id": "13cdfa00-24bd-3b4f-95d5-f5eb279f3bd3",
                                        "glosses": [
                                            "Indique une indifférence à la logique de l’interlocuteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74cb803-74c1-49d3-8a1b-f0bf156b15ba",
                                                "sense_id": "3021fe4d-a612-3fde-b724-8e0e637ae66a",
                                                "text": "Duchotel. — Lui !… et la dame adultère ?\nMadame Latour, moitié riant, moitié grondeur. — Eh bien ! après ? oui, ils sont là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
