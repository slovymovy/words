                                                "example_id": "0a530c00-bb2f-440f-b163-f9dbe19eac5d",
                                                "sense_id": "98290309-c37e-303a-a902-3ce512980215",
                                                "text": "The beach back is in pristine condition after a council-led cleanup."
                                            },
                                            {
                                                "example_id": "c2882980-b23d-4484-9864-ff8c7a1d0964",
                                                "sense_id": "98290309-c37e-303a-a902-3ce512980215",
                                                "text": "Fire fueled with gasoline\nLife is beautiful, the world is pristine\nWe have been bound unseen\nThe walls of existence remain unclean"
