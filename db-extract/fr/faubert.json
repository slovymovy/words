                                        "entry_id": "a31a7bc8-1e2f-3360-9a94-8aa2338c7a66",
                                        "glosses": [
                                            "A tassel worn in a buttonhole to indicate ones occupation in such a fair."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef9c3d2-d327-4579-a82a-a3f9c329f9a0",
