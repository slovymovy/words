                        "entry_id": "8b93de41-70f0-3003-880c-384e1c63f6f6",
                        "glosses": [
                            "Opioïde analgésique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f51ec967-56a5-425b-bdaf-330756695d70",
                                "sense_id": "969d9fb3-2f60-333b-a75a-d0c390650c67",
                                "text": "Certains clients doivent par exemple boire de la méthadone devant leur pharmacien dans certains cas de dépendance aux narcotiques, alors que d'autres personnes doivent se présenter quotidiennement en pharmacie pour obtenir leurs médicaments sur ordonnance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad2df43d-4466-4a9a-8325-458476db85a4",
                        "source_entry_id": "8b93de41-70f0-3003-880c-384e1c63f6f6",
                        "source_sense_id": "969d9fb3-2f60-333b-a75a-d0c390650c67",
                        "target_lang_word": "Methadon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Methadon",
