                                        "entry_id": "cc66c8dd-8249-3bd3-b0eb-e29d158360b9",
                                        "glosses": [
                                            "Qui a le caractère du style de Pierre Corneille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399f3515-370e-4727-9755-343b3ab26956",
                                                "sense_id": "fbb90d6f-5e91-34bc-abb6-cd8bd69a0f90",
                                                "text": "J’ai ôté toutes les dissertations cornéliennes qui anéantissent l’intérêt. ^([1])"
                                            },
                                            {
                                                "example_id": "f15bf4ce-af7c-46cb-ac3b-91604009c624",
                                                "sense_id": "fbb90d6f-5e91-34bc-abb6-cd8bd69a0f90",
                                                "text": "Le vers cornélien a de la grandeur, de la simplicité et une grave harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3ed5ae4-5528-3ad6-a08d-79986d866831",
                                        "entry_id": "cc66c8dd-8249-3bd3-b0eb-e29d158360b9",
                                        "glosses": [
                                            "Relatif aux tragédies de Pierre Corneille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14262936-9054-4f9b-8816-48a25b0167b8",
                                                "sense_id": "d3ed5ae4-5528-3ad6-a08d-79986d866831",
                                                "text": "Il est tout à fait évident que la liberté serait gravement compromise si les hommes en venaient à regarder les valeurs homériques (qui sont bien près des valeurs corné­liennes) comme étant seulement propres aux peuples barbares."
                                            },
                                            {
                                                "example_id": "4c5e5d27-2686-4b1d-948a-b35b97cd2916",
                                                "sense_id": "d3ed5ae4-5528-3ad6-a08d-79986d866831",
                                                "text": "— Choix cornélien\n— C’est le mot que je cherchais"
                                            }
                                        ]
                                    }
                                ]
