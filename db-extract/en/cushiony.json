                        "source_entry_id": "e31f0f26-cd05-3fd9-903a-582ccf794382",
                        "source_sense_description": "comfortable, soft, yielding",
                        "target_lang_word": "moelleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
