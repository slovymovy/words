                ],
                "senses": [
                    {
                        "sense_id": "19e97aef-0a4e-30e5-9112-1f190e03c2ce",
                        "entry_id": "6f1c7400-bf14-3ebf-84f6-1cf027fab588",
                        "glosses": [
                            "Voiler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f3cb20-b1fd-4dd9-bbd4-0f7707d47c31",
                                "sense_id": "19e97aef-0a4e-30e5-9112-1f190e03c2ce",
                                "text": "Celui qui voila primordialement les mêmes choses divines, écrivait nécessairement avant Moïse, puisque Moïse n'a fait que les revoiler."
                            },
                            {
                                "example_id": "3fcd1d25-b85f-48bb-af43-76fc391fcc11",
                                "sense_id": "19e97aef-0a4e-30e5-9112-1f190e03c2ce",
                                "text": "L'homme auquel elle a été dévoilée dans l'initiation et qui entreprend de la revoiler, pour la rendre visible à tous les yeux, palpable à toutes les mains, doit se préoccuper de choisir des symboles, des allégories, des mythes, qui soient en rapport avec les mœurs, la nature, les connaissances du peuple qu'il aspire à doter du bienfait précieux de la Vérité."
                            }
                        ]
                    }
                ],
