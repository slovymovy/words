                        "form": "den Arbeitsweg"
                    },
                    {
                        "form_id": "cd1331c2-5120-4fa0-9343-26d4f9dcd25c",
                        "entry_id": "b8dc5219-1291-384e-84ed-765e0779bf5a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Arbeitswege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                        "entry_id": "b8dc5219-1291-384e-84ed-765e0779bf5a",
                        "glosses": [
                            "Strecke zwischen Wohnung und Arbeitsstätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90dd8a74-e62a-42e2-903e-6dd1484ce80f",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„In NRW beträgt die durchschnittliche Pendlerstrecke knapp 20 Kilometer pro Arbeitsweg.“"
                            },
                            {
                                "example_id": "889766fc-67e2-4fea-890a-1f983e3ee0af",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„In Deutschland gibt es rund 20 Millionen Pendler mit einem durchschnittlichen Arbeitsweg von gut 17 Kilometern.“"
                            },
                            {
                                "example_id": "d43c5416-3dc0-416a-a0de-ce9c4aabccdb",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Die Pendlerinnen und Pendler in der Schweiz legten im Erhebungsjahr pro Arbeitsweg (ein Hinweg) im Durchschnitt 14 Kilometer zurück, um zur Arbeit zu gelangen.“"
                            },
                            {
                                "example_id": "79880e9e-51f1-49c5-bac5-aa417d98e6b2",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Kaum ein Arbeitsweg ist gefährlicher als der zu den Offshore-Anlagen 100 Seemeilen vor Cuxhaven.“"
                            },
                            {
                                "example_id": "986ac24e-65b8-4a13-acf0-cccf3f2f493c",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Im April 2024 erlitt Fankhauser auf dem Arbeitsweg einen Hirnschlag, den er überlebte.“"
                            },
                            {
                                "example_id": "d9e4b985-a155-46f4-80ae-f7ec9b7d60f5",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "Der Arbeitsweg der Pendler ist ein typischer Bestandteil des Berufsverkehrs."
                            },
                            {
                                "example_id": "a5e56a7d-fd28-4c81-b41b-dc128d5a149a",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Obwohl Wolfsburg eine sehr autogeprägte Stadt ist, spielt der Radverkehr insbesondere für die Arbeitswege und die übrige Nahmobilität eine wichtige Rolle.“"
                            },
                            {
                                "example_id": "1e383efc-5c5f-47d3-ac18-ad428ed4a8cc",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Möglicherweise lässt sich sogar regelmäßig ein Teil des Arbeitswegs zu Fuß oder mit dem Fahrrad zurücklegen.“"
                            },
                            {
                                "example_id": "9dec5156-9c03-4933-b9aa-aeb50a0fd5cc",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Wer etwa für seinen Arbeitsweg aufs Auto verzichtet und stattdessen mit der Bahn oder dem Rad fährt, kann viel sparen.“"
                            },
                            {
                                "example_id": "23fe0cc3-3cec-443f-b59c-4eb8ebfe90bf",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Je weiter der Arbeitsweg, desto größer das Einsparpotenzial.“"
                            },
                            {
                                "example_id": "c76c0485-1552-4407-af41-7cf97a6fbfa5",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Nur 14 Prozent nutzen für ihren Arbeitsweg die öffentlichen Verkehrsmittel.“"
                            },
                            {
                                "example_id": "452ed193-150f-4c17-ad29-e917a0596b17",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "[…] „Bei einem täglichen Arbeitsweg von 10 Kilometern landet das Auto mit Verbrennungsmotor bei 416 Kilo CO2 im Jahr. Das E-Auto - betankt mit dem aktuellen deutschen Strommix - landet bei 274 Kilo.“"
                            },
                            {
                                "example_id": "7289e76a-2482-42d9-b48f-2b817884cf1c",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Wenig überraschend: Je größer die Stadt, desto aufreibender der Arbeitsweg - zumindest für Leute, die mit dem Auto unterwegs sind.“"
                            },
                            {
                                "example_id": "29b4b798-c213-4c12-a945-e8772c5f9176",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Nach der alten Regelung konnte jeder Arbeitnehmer für den Arbeitsweg 30 Cent pro Kilometer von seinem zu versteuernden Einkommen abziehen, unabhängig davon, ob er mit dem Auto fuhr, der Bahn, dem Rad oder zu Fuß ging.“"
                            },
                            {
                                "example_id": "893e598b-d421-464f-a74a-1cdc7d59c865",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Die volle Entfernungspauschale für den Arbeitsweg angeben kann nur, wer tatsächlich den Hin- und Rückweg von der Wohnung zur Arbeitsstätte zurückgelegt hat.“"
                            },
                            {
                                "example_id": "23c36680-2e60-4344-8c6b-3680fb0bd1ef",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Jardena Flückiger, Stralsund: «Mein Arbeitsweg ist ein Traum» […] Die 33-jährige Baslerin liebt das Meer und ihren Arbeitsweg, der am Strand entlang führt.“"
                            },
                            {
                                "example_id": "6afe482a-5eef-4774-83cf-732d4fe49cd8",
                                "sense_id": "db0a3980-49c1-3f57-b26c-73ea718b86ea",
                                "text": "„Passiert ein Unfall auf dem Arbeitsweg oder anschließend auf dem direkten Heimweg, sind Betroffene […] über die gesetzliche Unfallversicherung abgesichert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
