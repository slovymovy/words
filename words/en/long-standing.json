    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "924bec1c-9251-36cb-a22b-3886422830a6",
                    "sense_definition": "Having existed or continued for a long period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two neighboring countries finally resolved their <w>long-standing</w> border dispute through peaceful negotiations.",
                            "target_lang_translations": {
                                "ru": "Две соседние страны наконец разрешили свой <w>давний</w> пограничный спор путем мирных переговоров."
                            }
                        },
                        {
                            "text": "She decided to retire after maintaining a <w>long-standing</w> commitment to the charity for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Она решила уйти на покой после <w>многолетней</w> преданности благотворительной организации на протяжении более тридцати лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "long-established",
                        "enduring",
                        "abiding",
                        "persistent"
                    ],
                    "antonyms": [
                        "recent",
                        "short-lived",
                        "new"
                    ],
                    "common_phrases": [
                        "long-standing tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или продолжающийся в течение длительного периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давний",
                                "target_lang_sense_clarification": "существующий долгое время"
                            },
                            {
                                "target_lang_word": "многолетний",
                                "target_lang_sense_clarification": "длящийся многие годы"
                            },
                            {
                                "target_lang_word": "застарелый",
                                "target_lang_sense_clarification": "о проблемах или конфликтах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e4d54d5-6fa1-325a-9201-58900acf11e5",
                    "sense_definition": "Having been practiced or followed for a long enough time to become a recognized convention or tradition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tradition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>long-standing</w> tradition in our family to gather for a large breakfast every Sunday morning.",
                            "target_lang_translations": {
                                "ru": "В нашей семье существует <w>давняя</w> традиция собираться за большим завтраком каждое воскресное утро."
                            }
                        },
                        {
                            "text": "The <w>long-standing</w> custom of wearing formal attire to the ceremony was strictly observed by all guests.",
                            "target_lang_translations": {
                                "ru": "<w>Укоренившийся</w> обычай надевать официальные наряды на церемонию строго соблюдался всеми гостями."
                            }
                        }
                    ],
                    "synonyms": [
                        "traditional",
                        "time-honored",
                        "established"
                    ],
                    "antonyms": [
                        "novel",
                        "unconventional"
                    ],
                    "common_phrases": [
                        "long-standing tradition",
                        "long-standing custom",
                        "long-standing practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практикуемый или соблюдаемый достаточно долго, чтобы стать признанной конвенцией или традицией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давний",
