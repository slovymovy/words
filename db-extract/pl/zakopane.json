                    {
                        "sense_id": "07da7c8f-7ec5-321e-90c5-6ab06dcc5bdd",
                        "entry_id": "016a1f3c-0df5-3730-bf86-78ab82bdc1ea",
                        "glosses": [
                            "miasto w południowej Polsce u podnóża Tatr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3808af3-8d28-452c-8f84-7e360f08fdd0",
                                "sense_id": "07da7c8f-7ec5-321e-90c5-6ab06dcc5bdd",
                                "text": "Chwilami złudzenie jest tak wielkie, że gdyby nie głośne rozmowy sąsiadów, myślałbym, że jestem w Zakopanem, i kazałbym podać sobie pstrąga i owczy serek"
                            },
                            {
                                "example_id": "b09d8546-8b70-4b53-aee1-fe895a39f2ce",
                                "sense_id": "07da7c8f-7ec5-321e-90c5-6ab06dcc5bdd",
                                "text": "(…) fachowcy stwierdzili jednoznacznie, że Zakopanemu zabraknie wody, a przyroda tatrzańska nie wytrzyma na dłuższą metę zmasowanego napływu turystów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
