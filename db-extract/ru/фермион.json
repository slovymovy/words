                                    {
                                        "sense_id": "040beb58-dbf6-3730-a964-f09cbd9eefaa",
                                        "entry_id": "b4c1dda0-5c1c-3cae-83a0-6dde0c6a567d",
                                        "glosses": [
                                            "Teilchen mit halbzahligem Spin; Teilchen, das der Fermi-Dirac-Statistik gehorcht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c5905d-a495-4a61-aed7-a0621076c15d",
                                                "sense_id": "040beb58-dbf6-3730-a964-f09cbd9eefaa",
                                                "text": "Die Fermionen bilden ein großes Spektrum an Elementarteilchen."
                                            },
                                            {
                                                "example_id": "86ab4b9f-4444-4d8e-a530-06597df3003b",
                                                "sense_id": "040beb58-dbf6-3730-a964-f09cbd9eefaa",
                                                "text": "Fermionen sind die Bausteine der Materie, die sich in drei Familien mit jeweils zwei Quarks und zwei leichten Teilchen, sprich Leptonen, aufteilen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d5aaf9-3798-4322-be02-a787df33a273",
