                                "sense_id": "492726b6-7448-3ce4-b3b2-af9a76b5af69",
                                "text": "Gelukkig konden we nog een goedkoop pension vinden."
                            }
                        ]
                    },
                    {
                        "sense_id": "d479aa55-48c1-34b1-83a7-25a71f8ff066",
                        "entry_id": "32266e47-fbc5-3ad9-94d7-edb957cb6e5a",
