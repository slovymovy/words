                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid hivernal a fini par lui <w>engourdir</w> complètement les doigts et les pieds."
                        },
                        {
                            "text": "Cette longue marche dans la neige glaciale <w>engourdit</w> les jambes des randonneurs."
                        }
                    ],
                    "synonyms": [
