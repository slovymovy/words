                "senses": [
                    {
                        "sense_id": "1a9022db-c89b-3de4-ad69-78d8c6c165c6",
                        "entry_id": "36b104b6-eb2e-33e2-ba74-123a978b7bc3",
                        "glosses": [
                            "schwarz färbende Paste für Hochdruck, Tiefdruck, Flachdruck und Offsetdruck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae92e737-2489-42d5-80f8-fe1c0d229748",
                                "sense_id": "1a9022db-c89b-3de4-ad69-78d8c6c165c6",
                                "text": "Von der Druckerschwärze bekommt man manchmal schmutzige Finger."
                            },
                            {
                                "example_id": "2b927ab9-46b1-4e88-b82c-d5ff7d331b31",
                                "sense_id": "1a9022db-c89b-3de4-ad69-78d8c6c165c6",
                                "text": "„Worte dafür gab es nicht in Druckerschwärze, und selbst ein Bild hätte die Wahrheit nicht zeigen können.“"
                            },
                            {
                                "example_id": "e666823c-8b04-4768-8b87-d24cc366ca66",
                                "sense_id": "1a9022db-c89b-3de4-ad69-78d8c6c165c6",
                                "text": "„Viel Druckerschwärze wurde verbraucht, um sich der literarisch-politischen Situation gewachsen zu zeigen.“"
                            },
                            {
                                "example_id": "2998d2fd-63b0-4687-8c7b-04f506b9060d",
                                "sense_id": "1a9022db-c89b-3de4-ad69-78d8c6c165c6",
                                "text": "„Zierkissen, Bettwäsche und Vorhänge waren mit Wasser vollgesogen, in zwei von Mamas Zeitschriften war die Druckerschwärze ausgelaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
