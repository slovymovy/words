                ],
                "senses": [
                    {
                        "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                        "entry_id": "34ae9381-ebdc-30c1-84a3-2ee2984903f1",
                        "glosses": [
                            "Teilnahme an einer Koalition, die die Regierung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c282d15-6414-4d57-80c1-cb90988d3fdb",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Was geschah am 17. Juli 1930?] „Nachdem Verhandlungen zwischen der Deutschnationalen Volkspartei (DNVP) und der Reichsregierung über eine Regierungsbeteiligung ergebnislos verlaufen sind, kommt es zum Bruch innerhalb der DNVP.“"
                            },
                            {
                                "example_id": "19bc2bb8-2712-4118-a1eb-24223987fe9c",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Einer Regierungsbeteiligung steht er kritisch gegenüber.“"
                            },
                            {
                                "example_id": "0c9d693e-ba55-4835-a138-1e8cfb7c59b3",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Eine erneute Regierungsbeteiligung scheint in weiter Ferne.“"
                            },
                            {
                                "example_id": "2f61afee-7885-4265-b6b5-f7a8900200dc",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Zu einer Regierungsbeteiligung kam es bisher weder auf Landes- noch auf Bundesebene.“"
                            },
                            {
                                "example_id": "999c1793-2cc8-4a59-aa42-6cde859204f2",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Seit 2017 gehört mit der Alternative für Deutschland (AfD) als sechste Kraft eine dezidierte Rechtspartei dem Bundestag an – ungeachtet zunehmender Erfolge vor allem in den neuen Bundesländern augenscheinlich ohne Chance auf eine Regierungsbeteiligung.“"
                            },
                            {
                                "example_id": "ba5e9d45-0004-4342-93c4-b19bbeb09eec",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Zwei Möglichkeiten der Regierungsbeteiligung gibt es für FDP und Grüne: eine sogenannte Ampel (SPD, Grüne, FDP) oder aber Jamaika (Union, Grüne, FDP).“"
                            },
                            {
                                "example_id": "e2d10411-a788-4dac-9471-8004d6c5b7b3",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Portugal, 2024:] „Nach jetzigem Stand dürfte eine Regierungsbeteiligung von Chega ausgeschlossen sein, wenn den Beteuerungen der Spitzenkandidaten Montenegro und Nuno Santos zu glauben ist.“"
                            },
                            {
                                "example_id": "abe9a73c-55e0-40f7-9aa0-a73f66c1a9db",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Spanien, 2023:] „Bis vor kurzem war eine Regierungsbeteiligung der Vox Tabu.“"
                            },
                            {
                                "example_id": "d809c88f-909d-4af5-a404-3e9556b7a53c",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Italien, 2013:] „Berlusconi bekräftigte nach dem Treffen mit Napolitano seine Forderung nach einer Regierungsbeteiligung mit dem Mitte-Links-Bündnis, was Bersani allerdings abgelehnt hat.“"
                            },
                            {
                                "example_id": "99dcaef9-bad7-4480-9104-33a05a8189ca",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Was geschah am 2. März 2000?] „Wien: Begleitet von massiven Protesten gegen die Regierungsbeteiligung der rechtspopulistischen FPÖ und in in Abwesenheit ausländischer Prominenz feiert die Wiener High Society den Opernball.“"
                            },
                            {
                                "example_id": "74e401a6-fb6a-4bbc-91ea-8e36b94fe537",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "[Was geschah am 8. September 1975?] „Die verfassunggebende Versammlung in Nordirland lehnt jede Regierungsbeteiligung der katholischen Minderheit ab.“"
                            },
                            {
                                "example_id": "db94a1e4-0851-4c67-acdc-09b2a184285a",
                                "sense_id": "0a1ba26d-104e-3dd8-92c2-857ee3c659fd",
                                "text": "„Bei dem Aufbau der NS-Diktatur nahm das spätere Gau Thüringen, bedingt durch die frühe Regierungsbeteiligung der Nationalsozialisten, in einigen Bereichen eine Vorreiterrolle innerhalb des „Dritten Reiches“ ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
