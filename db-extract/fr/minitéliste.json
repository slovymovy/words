                        "entry_id": "93f52910-f925-3ad2-a415-6162a6966b86",
                        "glosses": [
                            "Personne qui utilise un Minitel, ou qui travaille avec un Minitel."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "d4de389d-1757-4830-a35e-98e828a57c1f",
                                "sense_id": "9a665d0f-da8a-3c1f-9610-8d7a182f8820",
                                "text": "Elle est intervenue pour que l’identification du minitéliste à distance et à son insu, soit rendue techniquement impossible."
                            },
                            {
                                "example_id": "bdcbb4dc-f2a6-4ff6-ab77-6241eeef9de4",
                                "sense_id": "9a665d0f-da8a-3c1f-9610-8d7a182f8820",
                                "text": "Pour voter à « Salut les homards », on pouvait utiliser son téléphone ou, comme le rappelle un article de l’époque, « la solution viendra des minitélistes »."
                            }
                        ]
                    }
