                "senses": [
                    {
                        "sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                        "entry_id": "b48281dd-3416-369e-82de-ed029a20a908",
                        "glosses": [
                            "de persoon die voorafgaand aan een zeker persoon dezelfde positie bekleedde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714eed16-0fd9-4f79-8fa2-41ad426a935b",
                                "sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                                "text": "Zijn voorganger had alle documentatie netjes achtergelaten."
                            },
                            {
                                "example_id": "53f19147-d0de-4df8-9c09-dfe3b247c9a5",
                                "sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                                "text": "Nobelen uit vorige eeuwen hadden het eiland volgebouwd met hun pronkpalazzi en de kieren die toevallig ontstonden tussen de wereldwonderen in, moesten maar als straat dienen. Wie zich wil verplaatsen in Venetië moet voortdurend om het exhibitionistische vertoon van liefde voor de stad van zijn voorgangers in deze stad heen lopen."
                            },
                            {
                                "example_id": "151fd61c-c332-49f5-9604-59c966d7dfbb",
                                "sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                                "text": "Naast opvoeringen door paarden was er ook muziek van Andrew Lloyd Webber en mezzosopraan Katherine Jenkins. Hoogtepunten uit het Britse verleden kwamen voorbij onder het motto 'In galop door de geschiedenis', waarvoor actrice Helen Mirren zich verkleedde als voorganger en naamgenoot van de huidige koningin, Elizabeth I."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb72d35f-bf03-372c-ae68-8c0a982a3bcd",
                        "entry_id": "b48281dd-3416-369e-82de-ed029a20a908",
                        "glosses": [
                            "dienstdoende predikant in een kerkdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5804ff06-bd92-4f3f-b3f1-a53cb9159f84",
                                "sense_id": "bb72d35f-bf03-372c-ae68-8c0a982a3bcd",
                                "text": "De voorganger hield een betoog over vertrouwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83c824e1-49a8-4a35-aaa5-b2dd61b228ef",
                        "source_entry_id": "b48281dd-3416-369e-82de-ed029a20a908",
                        "source_sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                        "source_sense_description": "de persoon die voorafgaand aan een zeker persoon dezelfde positie bekleedde",
                        "target_lang_word": "Vorgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25346d00-645d-3490-9fd0-7b80f121fc3d",
                                        "entry_id": "0af43781-a947-371b-bab3-358c9dddb0db",
                                        "glosses": [
                                            "Person, die jemandes Amt, Stellung oder Ähnliches zuvor innehatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d792a48a-0dff-4a2d-84ba-8d3d96efe061",
                                                "sense_id": "25346d00-645d-3490-9fd0-7b80f121fc3d",
                                                "text": "Mein Vorgänger hat den Aktenschrank vollkommen verwahrlosen lassen."
                                            },
                                            {
                                                "example_id": "cc689e0e-9211-48f0-9c4e-540f3ed95be0",
                                                "sense_id": "25346d00-645d-3490-9fd0-7b80f121fc3d",
                                                "text": "„Auf gestickte Monogramme sollte man ebenfalls verzichten, denn künftige Lebensabschnittsgefährten schlafen nicht gerne in Bettbezügen mit den Initialen ihrer Vorgänger.“"
                                            },
                                            {
                                                "example_id": "5a70cc3b-592f-45b9-a831-490c4b21df82",
                                                "sense_id": "25346d00-645d-3490-9fd0-7b80f121fc3d",
                                                "text": "„Zudem muss Basileios seinen Höflingen misstrauen - etliche seiner Vorgänger sind durch Gift gestorben oder von Verschwörern gestürzt worden.“"
                                            },
                                            {
                                                "example_id": "2ed9c20e-620c-45b3-ae7f-ba0f9c10bcb4",
                                                "sense_id": "25346d00-645d-3490-9fd0-7b80f121fc3d",
                                                "text": "„Der neue Vizekönig Lord Willingdon verachtete Gandhi und fand, dass sein Vorgänger Irwin ihn unnötig aufgewertet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae9ac472-4850-3ed6-8741-64dfd20ab35e",
                                        "entry_id": "0af43781-a947-371b-bab3-358c9dddb0db",
                                        "glosses": [
                                            "die nächstkleinere Zahl in einer gegebenen Menge (meist der ganzen Zahlen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8956d70a-b18f-4dc5-b595-0a2defe10ee3",
                                                "sense_id": "ae9ac472-4850-3ed6-8741-64dfd20ab35e",
                                                "text": "1 ist der Vorgänger von 2."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59999e3-f562-4043-a624-e60c70abb7d7",
                        "source_entry_id": "b48281dd-3416-369e-82de-ed029a20a908",
                        "source_sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                        "source_sense_description": "de persoon die voorafgaand aan een zeker persoon dezelfde positie bekleedde",
                        "target_lang_word": "predecessor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predecessor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "One who precedes; one who has preceded another in any state, position, office, etc.; one whom another follows or comes after, in any office or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9961836b-f5cc-484d-8c12-c6f1f6ab43b9",
                                                "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                                "text": "I thought about my predecessor, who had died of drink and smoke; and I could have wished he had been so good as to live, and not bother me with his decease."
                                            },
                                            {
                                                "example_id": "ea620bfc-90ae-4396-943b-08ccb4bba234",
                                                "sense_id": "15ea6243-cac2-3955-8a72-df8295897870",
                                                "text": "\"The Northern Heights at last,\" you say to yourself, hastily closing the carriage window because the Yorkshire coal used by the Eastern Region and its predecessors makes their tunnels more sulphurous than any we know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "A model or type of machinery or device which precedes the current (or later) one. Usually used to describe an earlier, outdated model."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9947e80-4c95-463d-b627-8c8b717aa9ae",
                                                "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                                "text": "The steam engine was the predecessor of diesel and electric locomotives."
                                            },
                                            {
                                                "example_id": "7f5951ee-f33d-4422-900a-0c1d3d7cc562",
                                                "sense_id": "8e819e9d-9a82-3b0b-9c4d-6f6844cb05bd",
                                                "text": "No. 6959 is painted in the standard wartime black livery and, like its immediate predecessors, does not carry a nameplate, but the words \"Hall Class\" have been painted on the middle coupled-wheel splasher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f65b1dff-e7bd-3186-aecf-7c94bb9e3e95",
                                        "entry_id": "91d6ead0-9c02-379e-aaf1-4b519df3252b",
                                        "glosses": [
                                            "A vertex having a directed path to another vertex"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3b48e5-ba83-49fc-9be3-ca1a7f965f64",
                        "source_entry_id": "b48281dd-3416-369e-82de-ed029a20a908",
                        "source_sense_id": "a345962f-e8bc-3773-b822-62f4e0da69e7",
                        "source_sense_description": "de persoon die voorafgaand aan een zeker persoon dezelfde positie bekleedde",
                        "target_lang_word": "prédécesseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédécesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                        "entry_id": "16866a40-1aa7-3444-a008-30dddb227ebe",
                                        "glosses": [
                                            "Personne qui a précédé quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7541678a-caee-4631-9d83-7687eca78ac7",
                                                "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                                "text": "Pierre Giffard est présenté de nos jours comme le vulgarisateur de la bicyclette. Il ne faut pourtant pas oublier le rôle capital de son prédécesseur, Marinoni, qui lui s’était donné pour mission de populariser et développer la bicyclette."
                                            },
                                            {
                                                "example_id": "27475d08-8e76-49cd-9016-6609ff8619b0",
                                                "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                                "text": "À l’instar de Jeanne d’Arc, mascotte guerrière de son mouvement, la chef de file du Front national,entend des voix – des témoignages ! – qui lui disent de sauver la France en combattant non plus les Anglais, comme sa prédécesseur, non plus les immigrés en général comme son père, mais les musulmans,et pour cela elle doit se porter au secours des femmes, des homosexuels, des juifs et, plus classiquement, bien sûr des (vrais) Français."
                                            },
                                            {
                                                "example_id": "e23bb4df-c26e-4bcd-9dd4-71e5a4070a38",
                                                "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                                "text": "Enfin, on voyait ce meuble-meublant en acajou qui se vend dans nos études depuis cinquante ans de prédécesseur à successeur."
                                            },
                                            {
                                                "example_id": "a126be88-8e24-4f78-b714-7063b2a92271",
                                                "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                                "text": "Ne peut-on pas admettre après ce résultat, que les êtres exceptionnels qui apparaissent de loin en loin dans une famille, ne sont que le fait de l’éclosion spontanée de qualités supérieures restées latentes chez leurs prédécesseurs ?"
                                            },
                                            {
                                                "example_id": "1c099c64-957b-47c7-a303-0153be4554ca",
                                                "sense_id": "8f93b2f6-ffcb-36be-beee-44ece74ed0ea",
                                                "text": "Le rapport aux prédécesseurs, qu'il s'agisse des ancêtres ou des aïeux, est l'une des facettes les plus discutées de la condition humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8a824c-961a-3469-8701-187ee217f269",
                                        "entry_id": "16866a40-1aa7-3444-a008-30dddb227ebe",
                                        "glosses": [
                                            "Objet de même usage qui existait auparavant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c4bbb5-503a-4dda-b349-589500213052",
                                                "sense_id": "7c8a824c-961a-3469-8701-187ee217f269",
                                                "text": "Vers la fin du siècle dernier, le vélocifère, prédécesseur de la diligence et des messageries, débarquait à Paris un provençal, plein de verve et d'entrain, né dans la ville d'Aix, et bossu, comme Ésope, par devant et par derrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prédécesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dbff5b1-211f-3165-8d24-f2acfdfc5846",
                                        "entry_id": "e3ad57ad-b080-37b2-8ba3-edd113a5d861",
                                        "glosses": [
                                            "Nombre ou point qui précède un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d801cae-8844-4111-8f8a-0cba7a6d4914",
                                                "sense_id": "8dbff5b1-211f-3165-8d24-f2acfdfc5846",
                                                "text": "11 est le prédécesseur de 12."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a397b91-4a44-3e53-8916-b15388b82c06",
                                        "entry_id": "e3ad57ad-b080-37b2-8ba3-edd113a5d861",
                                        "glosses": [
                                            "Pour un sommet donné, autre sommet qui se situe au début d’un arc incident vers l’intérieur du premier."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
