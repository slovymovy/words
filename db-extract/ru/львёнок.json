                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lionceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fef664a-84db-3f86-b593-a3c250254efc",
                                        "entry_id": "620c5fa4-a113-37f6-8dbe-812b732a8df4",
                                        "glosses": [
                                            "Petit d’un lion."
                                        ],
                                        "tags": [
                                            "Félinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4459b9-6c4d-4df2-b5e2-62cbeaa8319f",
                                                "sense_id": "2fef664a-84db-3f86-b593-a3c250254efc",
                                                "text": "Elle le prit sur ses genoux, l’enfant la caressa familièrement en passant ses bras autour du cou majestueux d’Hélène, comme un lionceau qui veut jouer avec sa mère."
                                            },
                                            {
                                                "example_id": "97ace656-f888-44c8-96b9-5aac3dbf6d4f",
                                                "sense_id": "2fef664a-84db-3f86-b593-a3c250254efc",
                                                "text": "La direction de Planète sauvage a annoncé, lundi, la naissance de quatre lionceaux au parc animalier de Port-Saint-Père, près de Nantes."
                                            },
                                            {
                                                "example_id": "abc35c35-bc57-4bdb-9667-142ceb6d0a06",
                                                "sense_id": "2fef664a-84db-3f86-b593-a3c250254efc",
                                                "text": "Deux adorables frères lionceaux se livrent à une petite guéguerre au cœur du Masai Mara, au Kenya."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lionceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96211f4c-60fe-3046-84fb-e71f8ebe766f",
                                        "entry_id": "29ffe766-6548-3a85-a3c5-2446a0d6b105",
                                        "glosses": [
                                            "Jeune homme qui recherche et séduit des femmes plus âgées que lui (des cougars)."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf422316-247e-4815-8d75-1309900b3b6c",
                                                "sense_id": "96211f4c-60fe-3046-84fb-e71f8ebe766f",
                                                "text": "C’est une femme plus pour une nuit que pour la vie… Hier soir, j’ai été un véritable lionceau."
                                            },
                                            {
                                                "example_id": "f35c4365-91a0-47bf-a624-04b3f801eb61",
                                                "sense_id": "96211f4c-60fe-3046-84fb-e71f8ebe766f",
                                                "text": "Les femmes cougar sont des femmes de 40 ans ou plus à la recherche d’un “puma” ou d’un “lionceau”: homme d’une vingtaine d’années avec qui elles pourront avoir une aventure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
