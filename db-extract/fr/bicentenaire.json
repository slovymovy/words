                        "glosses": [
                            "Deux-centième anniversaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f8ca01f-062d-46f6-8acd-1218d113fef5",
                                "sense_id": "8863ef45-2f26-3e5b-a726-ed7d3836ec0d",
                                "text": "Situé sur les rives du fleuve Douro à proximité de Porto, le magnifique palais baroque de la famille Brodey ouvrira bientôt ses portes pour célébrer avec faste le bicentenaire de l’exploitation vinicole qui porte son nom."
                            }
                        ]
