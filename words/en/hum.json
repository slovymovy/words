{
    "word_family": [
        "hummer",
        "humming",
        "humbug"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e879834-123c-3d2e-a559-d083e31a7b85",
                    "sense_definition": "To make a sound from the vocal cords without pronouncing any real words, with one's lips closed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal-sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>hum</w> softly while she was working in the garden.",
                            "target_lang_translations": {
                                "ru": "Она начала тихо <w>напевать под нос</w>, пока работала в саду."
                            }
                        },
                        {
                            "text": "We are <w>humming</w> happily along with the music playing on the radio.",
                            "target_lang_translations": {
                                "ru": "Мы радостно <w>подпеваем</w> музыке, играющей по радио."
                            }
                        }
                    ],
                    "synonyms": [
                        "croon"
                    ],
                    "common_phrases": [
                        "hum happily",
                        "hum softly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звук голосовыми связками с закрытым ртом, не произнося слов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напевать под нос",
                                "target_lang_sense_clarification": "мелодию без слов"
                            },
                            {
                                "target_lang_word": "мычать",
                                "target_lang_sense_clarification": "издавать неопределенный звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6afee487-c4da-374a-aeba-69c2e4e56d0e",
                    "sense_definition": "To express or perform a specific melody by humming.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal-sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can <w>hum</w> a tune even if I do not know the lyrics.",
                            "target_lang_translations": {
                                "ru": "Я могу <w>напеть</w> мелодию, даже если не знаю слов."
                            }
                        },
                        {
                            "text": "The team <w>hummed</w> the national anthem as they came back onto the field.",
                            "target_lang_translations": {
                                "ru": "Команда <w>промычала</w> гимн, возвращаясь на поле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hum a tune",
                        "hum a song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять определенную мелодию путем напевания с закрытым ртом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напевать",
                                "target_lang_sense_clarification": "мелодию"
                            },
                            {
                                "target_lang_word": "мурлыкать",
                                "target_lang_sense_clarification": "тихо напевать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0929c449-7433-3ffd-ba33-0f571a68f9c6",
                    "sense_definition": "To be busily active and full of noise, like a beehive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city streets were <w>humming</w> with activity during the summer festival.",
                            "target_lang_translations": {
                                "ru": "Улицы города <w>кипели</w> жизнью во время летнего фестиваля."
                            }
                        },
                        {
                            "text": "By noon, the entire office began to <w>hum</w> with the sound of busy workers.",
                            "target_lang_translations": {
                                "ru": "К полудню весь офис начал <w>гудеть</w> от голосов занятых сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzz",
                        "bustle",
                        "hustle"
                    ],
                    "common_phrases": [
                        "hum with activity",
                        "hum with excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень активным и шумным, подобно пчелиному улью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "о деятельности"
                            },
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "от оживления"
                            },
                            {
                                "target_lang_word": "бурлить",
                                "target_lang_sense_clarification": "о жизни или толпе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c8032be-8eb2-389b-a573-8dde8b0263e9",
                    "sense_definition": "To make a low, continuous vibrating sound like a bee or a machine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical-sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old refrigerator started to <w>hum</w> loudly in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "Старый холодильник начал громко <w>гудеть</w> посреди ночи."
                            }
                        },
                        {
                            "text": "You can hear the bees <w>humming</w> around the flowers in the meadow.",
                            "target_lang_translations": {
                                "ru": "Слышно, как пчелы <w>жужжат</w> вокруг цветов на лугу."
                            }
                        }
                    ],
                    "synonyms": [
                        "drone",
                        "buzz",
                        "whir",
                        "thrum"
                    ],
                    "common_phrases": [
                        "hum loudly",
                        "hum constantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий, непрерывный вибрирующий звук, как пчела или машина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "как насекомое"
                            },
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "как прибор или мотор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2054e362-ebea-3ee1-a6da-c5ec0ba96e33",
                    "sense_definition": "To smell very bad; to reek.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your gym bag really <w>hums</w> after a long week of practice.",
                            "target_lang_translations": {
                                "ru": "От твоей спортивной сумки реально <w>несет</w> после целой недели тренировок."
                            }
                        },
                        {
                            "text": "The kitchen started to <w>hum</w> because someone forgot to take out the trash.",
                            "target_lang_translations": {
                                "ru": "На кухне начало <w>вонять</w>, потому что кто-то забыл вынести мусор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "really hums"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe a strong bad odor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохо пахнуть; вонять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонять",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "нести",
                                "target_lang_sense_clarification": "о неприятном запахе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4c38f9b-77ff-3188-bd78-8fbd87e6deb3",
                    "sense_definition": "A low, continuous, and often indistinct vibrating sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a constant <w>hum</w> coming from the air conditioning unit.",
                            "target_lang_translations": {
                                "ru": "От кондиционера исходил постоянный <w>гул</w>."
                            }
                        },
                        {
                            "text": "The distant <w>hum</w> of traffic helped the baby fall asleep.",
                            "target_lang_translations": {
                                "ru": "Далекий <w>шум</w> машин помог ребенку уснуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "drone",
                        "buzz",
                        "whir"
                    ],
                    "common_phrases": [
                        "low hum",
                        "constant hum",
                        "distant hum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий, непрерывный и часто неразличимый вибрирующий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "низкий звук"
                            },
                            {
                                "target_lang_word": "жужжание",
                                "target_lang_sense_clarification": "монотонный звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f86e096-6fda-3583-8c0a-822a0e42fc03",
                    "sense_definition": "A melody or tune that is hummed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She recognized the familiar <w>hum</w> of her mother's favorite lullaby.",
                            "target_lang_translations": {
                                "ru": "Она узнала знакомый <w>напев</w> любимой маминой колыбельной."
                            }
                        },
                        {
                            "text": "He gave a little <w>hum</w> of approval after tasting the soup.",
                            "target_lang_translations": {
                                "ru": "Он издал одобрительное <w>хмыканье</w>, попробовав суп."
                            }
                        }
                    ],
                    "common_phrases": [
                        "familiar hum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелодия или мотив, который напевают без слов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напев",
                                "target_lang_sense_clarification": "мелодия без слов"
                            },
                            {
                                "target_lang_word": "мурлыканье",
                                "target_lang_sense_clarification": "тихое пение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb143ccc-e16f-32a5-b096-f23ef4e893bc",
                    "sense_definition": "A state of busy activity or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hum</w> of the marketplace was overwhelming for the quiet tourist.",
                            "target_lang_translations": {
                                "ru": "Рыночный <w>гул</w> был слишком утомительным для тихого туриста."
                            }
                        },
                        {
                            "text": "I love the general <w>hum</w> of a newsroom right before a deadline.",
                            "target_lang_translations": {
                                "ru": "Мне нравится общее <w>оживление</w> в редакции прямо перед дедлайном."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzz",
                        "bustle"
                    ],
                    "common_phrases": [
                        "general hum",
                        "hum of activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние оживленной деятельности или возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "активность"
                            },
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "шум толпы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d88585e2-673c-3aa2-aaab-d45674428eb8",
                    "sense_definition": "An exclamation used to indicate that one is thinking or considering something; synonym of <w>hmm</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Hum</w>! I am not sure if that is the right answer,\" he said.",
                            "target_lang_translations": {
                                "ru": "«<w>Гм</w>! Я не уверен, что это правильный ответ», — сказал он."
                            }
                        },
                        {
                            "text": "The detective let out a thoughtful <w>hum</w> while looking at the evidence.",
                            "target_lang_translations": {
                                "ru": "Детектив издал задумчивое «<w>хм</w>», рассматривая улики."
                            }
                        }
                    ],
                    "synonyms": [
                        "hmm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, указывающее на раздумья или обдумывание чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гм",
                                "target_lang_sense_clarification": "выражение раздумья"
                            },
                            {
                                "target_lang_word": "хм",
                                "target_lang_sense_clarification": "выражение сомнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b9ab5ef-2763-3640-a017-0be38988a433",
                    "sense_definition": "An exclamation used to indicate doubt or uncertainty; synonym of <w>um</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were both, <w>hum</w>, a bit confused by the sudden change in plans.",
                            "target_lang_translations": {
                                "ru": "Они оба были, <w>э-э</w>, немного сбиты с толку внезапной переменой планов."
                            }
                        },
                        {
                            "text": "I think we should, <w>hum</w>, wait for the manager before we decide.",
                            "target_lang_translations": {
                                "ru": "Я думаю, нам стоит, <w>ну</w>, подождать менеджера, прежде чем решать."
                            }
                        }
                    ],
                    "synonyms": [
                        "um"
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, используемое для выражения сомнения или неуверенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "э-э",
                                "target_lang_sense_clarification": "запинка в речи"
                            },
                            {
                                "target_lang_word": "м-да",
                                "target_lang_sense_clarification": "неуверенность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0dfd8a3f-ca70-32e8-b746-3ce6de378725",
                    "sense_definition": "A town in the central part of Istria, Croatia, known as the smallest town in the world.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists visit <w>Hum</w> because it is famous for being a very tiny town.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Хум</w>, потому что он знаменит как очень маленький городок."
                            }
                        },
                        {
                            "text": "The historic stone buildings in <w>Hum</w> are well-preserved and beautiful.",
                            "target_lang_translations": {
                                "ru": "Исторические каменные здания в <w>Хуме</w> хорошо сохранились и очень красивы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Croatia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в центральной части Истрии, Хорватия, известный как самый маленький город в мире."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хум",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}