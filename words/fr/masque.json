                        "masque chirurgical"
                    ]
                },
                {
                    "sense_id": "522621d4-5e17-36d8-b720-d9dd8ea09554",
                    "sense_definition": "Accessoire protégeant les yeux ou le visage lors d'activités sous-marines, sportives ou industrielles.",
