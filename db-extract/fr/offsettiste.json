                        "entry_id": "43420056-b528-3957-bddd-e9f82b15a3ff",
                        "glosses": [
                            "Qui utilise le procédé d’impression offset."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "0c6c1f80-37f5-4c43-92bd-0b07abd5d809",
                                "sense_id": "654cfc4b-41dc-310b-80f8-fe4389208053",
                                "text": "Après avoir été éducateur, employé des PTT, ouvrier offsettiste, animateur, employé de cuisine ou de bureau, il trouve sa voie dans l’expression artistique et la peinture."
                            },
                            {
                                "example_id": "5b17ed66-5b37-4473-aaaf-5ffedc943e84",
                                "sense_id": "654cfc4b-41dc-310b-80f8-fe4389208053",
                                "text": "Fort de ses 50 ans d’expérience en impression offset, le Groupe … a investi depuis quelques années dans de nombreuses solutions d’impression numérique, venant ajouter à ses capacités d’imprimeur rotativiste, d’imprimeur offsettiste feuille, de routeur, celles d’imprimeur numérique."
                            }
                        ]
                    }
