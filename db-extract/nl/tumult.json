                "senses": [
                    {
                        "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                        "entry_id": "b4e90740-13c3-35d4-83da-1fdbc69a44f0",
                        "glosses": [
                            "lawaai en onrust in een groep van mensen, soms overgaand in oproer en opstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965e08f3-8bff-4b55-b4ce-f3f6d406980c",
                                "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                                "text": "Maar daar is seizoen twee al, dat de Suezcrisis biedt, de moord op Kennedy en het Profumo-schandaal. In het midden van dat tumult loopt Elizabeth II, die geen politieke standpunten mag innemen en geen schandaal mag veroorzaken in haar privéleven. Claire Foy moet het allemaal acteren met haar onberispelijk gestifte lippen."
                            },
                            {
                                "example_id": "b9315a1b-19c5-4daa-bd94-891310ced985",
                                "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                                "text": "Tumult aan de Meijersweg in Geesteren, enkele jaren geleden. In een voormalige boerderij met plek voor twee huishoudens is in een van de twee woongedeelten een extra ruimte om te wonen gecreëerd voor de zoon van de bewoners en zijn gezin. En dat is tegen het zere been van de bewoners aan de andere kant van het huis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0db5be28-825c-497e-b703-517d8f5a9b1c",
                        "source_entry_id": "b4e90740-13c3-35d4-83da-1fdbc69a44f0",
                        "source_sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                        "target_lang_word": "tumult",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b97dd9b2-3c19-3bf2-8bf3-ba41808adc55",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "Confused, agitated noise as made by a crowd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b7d4638-d9c2-4e7c-bd94-5d411ef44a44",
                                                "sense_id": "b97dd9b2-3c19-3bf2-8bf3-ba41808adc55",
                                                "text": "Till in loud tumult all the Greeks arose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "Violent commotion or agitation, often with confusion of sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44b4e3e-2009-4651-b5e1-773a13ade2ba",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "the tumult of the elements"
                                            },
                                            {
                                                "example_id": "aa8577ef-2c79-48b1-9efb-b6e56dc248ba",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "the tumult of the spirits or passions"
                                            },
                                            {
                                                "example_id": "fa23f013-63d8-4e68-beb2-7d0584af35e1",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "This is what I wanted my story 'Snapshot' to sound like — a very cold surface, with heat and passion beneath. The icy surface is going to break and you're totally engulfed in the tumult."
                                            },
                                            {
                                                "example_id": "f619fe9b-01ef-4f7b-b730-ebd109a7a6b0",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "Football is a game of tumult and glory, of small disappointments and lingering dreams, and Mata has played long enough at the highest level to appreciate these truths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1293b94-cae9-380c-af57-d7d635b857ab",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "A riot or uprising."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tumult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19506ea4-6506-3167-92d8-9e414282101c",
                                        "entry_id": "596e26fd-3cff-347b-a783-eb98b8af24a5",
                                        "glosses": [
                                            "To make a tumult; to be in great commotion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a27a64c7-d3da-4c46-9f79-a2b6dc7ed387",
                                                "sense_id": "19506ea4-6506-3167-92d8-9e414282101c",
                                                "text": "Importuning and tumulting even to the fear of a revolt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d87ec52b-bb0c-4461-a896-19c3a7779ba2",
