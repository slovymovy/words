                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bestuur</w> de auto terwijl jij op de kaart kijkt.",
                            "target_lang_translations": {
                                "en": "I am <w>driving</w> the car while you look at the map."
                            }
                        },
                        {
                            "text": "Elke dag <w>bestuur</w> ik deze complexe machine in de fabriek.",
                            "target_lang_translations": {
                                "en": "Every day I <w>operate</w> this complex machine in the factory."
                            }
                        }
                    ],
                    "traits": [
