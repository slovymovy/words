                ],
                "senses": [
                    {
                        "sense_id": "66c1997d-bfca-3b31-8cd8-69873b7eed6e",
                        "entry_id": "8627ddc2-5603-3a25-93a4-361292aae231",
                        "glosses": [
                            "Partie blanche de la queue juste après le procédé."
                        ],
                        "tags": [],
