        "fr-extract.jsonl": [
            {
                "entry_id": "0ac21810-516b-3a36-9b69-e4d252c97711",
                "word": "sponsor",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "798d1e2c-a752-45b8-b165-7086b60882c7",
                        "entry_id": "0ac21810-516b-3a36-9b69-e4d252c97711",
                        "tags": [
                            "plural"
                        ],
                        "form": "sponsors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3f7d7bd-35c6-313f-85de-d5b2eda143ef",
                        "entry_id": "0ac21810-516b-3a36-9b69-e4d252c97711",
                        "glosses": [
                            "Entreprise ou personne soutenant financièrement et matériellement et à des fins publicitaires une activité sportive, culturelle ou scientifique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760e4dca-8a98-4c19-b236-b535b4b33507",
                                "sense_id": "e3f7d7bd-35c6-313f-85de-d5b2eda143ef",
                                "text": "Les sponsors sont de plus en plus présents à tous les niveaux du sport, même amateur !"
                            },
                            {
                                "example_id": "2b01f694-1c58-4f2f-9ef1-957109206834",
                                "sense_id": "e3f7d7bd-35c6-313f-85de-d5b2eda143ef",
                                "text": "La crise économique a fait fuir les sponsors et pèse sur les porte-monnaie."
                            },
                            {
                                "example_id": "04853716-d283-4930-9998-994edf04b25e",
                                "sense_id": "e3f7d7bd-35c6-313f-85de-d5b2eda143ef",
                                "text": "sur l’étui en plastique de la barre chocolatée se trouvaient plusieurs éléments prouvant qu’il était vieux d’une trentaine d’années : un copyright de 1991, un logo de la Fédération internationale de football association (FIFA) de 1993, et une publicité pour la Coupe du monde de football de 1994, dont l’entreprise Mars était l’un des sponsors officiels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15c78960-6213-4804-8ab4-9236938e07f8",
                        "source_entry_id": "0ac21810-516b-3a36-9b69-e4d252c97711",
                        "source_sense_id": "e3f7d7bd-35c6-313f-85de-d5b2eda143ef",
                        "source_sense_description": "Entité soutenant financièrement et matériellement une activité",
                        "target_lang_word": "sponsor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sponsor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c815eb36-dd01-45f0-91a3-4aa3c09afc39",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "He was my sponsor when I applied to join the club."
                                            },
                                            {
                                                "example_id": "476a6f1e-692c-451b-91d8-db7a8111553a",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "They were my sponsors for immigration."
                                            },
                                            {
                                                "example_id": "c2d5736e-2f55-480d-9f6a-1f0c780e5005",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "The colonel and his sponsor made a queer contrast: Greystone [the sponsor] long and stringy, with a face that seemed as if a cold wind was eternally playing on it. […] But there was not a more lascivious reprobate and gourmand in all London than this same Greystone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect.",
                                            "A senior member of a twelve step or similar program chosen to guide an initiate and form a partnership with them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435b75e4-2d8a-4b93-bd86-3d8729b10948",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "My narcotics anonymous sponsor became my best friend when I finally was able to do something about my meth problem."
                                            },
                                            {
                                                "example_id": "03db4f57-ee93-47e6-bb1e-b34b759c2a00",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "Members also choose a sponsor, with whom they are supposed to remain in regular, even daily, contact—and that, too, is a powerful boost for monitoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization that pays all or part of the cost of an event, publication, media program, etc., usually in exchange for advertising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92efaac5-e314-41e4-b145-0f040a6a99a5",
                                                "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                                "text": "And now a word from our sponsor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sponsor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d29ec35-f290-3d4e-a4ce-432f72eabd83",
                                        "entry_id": "219c3327-013f-3803-8856-a8784f8d80bf",
                                        "glosses": [
                                            "To be a sponsor for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62cce4b-196e-4e28-b4cb-f733c1461cdb",
                                                "sense_id": "8d29ec35-f290-3d4e-a4ce-432f72eabd83",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
