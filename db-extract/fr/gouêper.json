                "senses": [
                    {
                        "sense_id": "a0529e2b-57f9-3fc4-8915-f73e591bcb71",
                        "entry_id": "2502ab4f-9a01-3464-a263-97338ce9f64f",
                        "glosses": [
                            "Variante de gouaper."
                        ],
                        "tags": [
                            "alt-of",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "47ef579a-22de-413a-860c-af37fd43a546",
                                "sense_id": "a0529e2b-57f9-3fc4-8915-f73e591bcb71",
                                "text": "Quoi ! tu voudrais que je grinchisse,\nSans tracquer de tomber au plan ?\nJ’doute qu’à grinchir on s’enrichisse ;\nJ’aime mieux gouêper, c’est du flan !"
                            }
                        ]
                    },
                    {
                        "sense_id": "bec1a80d-08a5-38d5-a835-7c680ddbba44",
                        "entry_id": "2502ab4f-9a01-3464-a263-97338ce9f64f",
                        "glosses": [
                            "Variante de gouaper.",
                            "Une interprétation libre de ce texte en français familier :"
                        ],
                        "tags": [
                            "alt-of",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "45571be7-c81d-4363-ada0-c277d63a95d6",
                                "sense_id": "bec1a80d-08a5-38d5-a835-7c680ddbba44",
                                "text": "Quoi ! tu voudrais que voleur je me fisse,\n Sans craindre d’aller en cabane\n J’doute qu’à voler on s’enrichisse ;\nJ’aime mieux trainailler, c’est du nanan."
                            }
                        ]
                    }
