        "fr-extract.jsonl": [
            {
                "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                "word": "vaguemestre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0019c51a-f54c-48c2-ab0a-5e9cd4096bd9",
                        "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                        "tags": [
                            "plural"
                        ],
                        "form": "vaguemestres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3599ccaf-2d4e-338f-b550-3309e0e14c0e",
                        "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                        "glosses": [
                            "Officier qui était chargé du soin des équipages militaires."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "32a650d3-c0ce-3f6c-a081-1468434f1da0",
                        "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                        "glosses": [
                            "Sous-officier chargé du service de la poste dans un régiment ou dans un établissement militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766cd2ea-0681-4bd3-bdae-03e0117da9d5",
                                "sense_id": "32a650d3-c0ce-3f6c-a081-1468434f1da0",
                                "text": "J’écoute le vaguemestre nous lire le courrier qui part : il approuve sans réserve la carte du colonel : Tout va bien, […]."
                            },
                            {
                                "example_id": "d6bfbba8-680d-4634-9997-2d8acf706c27",
                                "sense_id": "32a650d3-c0ce-3f6c-a081-1468434f1da0",
                                "text": "Le général Sarrail […] interdit aux militaires sous ses ordres d’envoyer leurs lettres par la poste. Toutes les correspondances doivent être remises au vaguemestre. La surveillance est ainsi plus facile."
                            },
                            {
                                "example_id": "d2304c03-1b52-4fac-89b5-9e950207eb3e",
                                "sense_id": "32a650d3-c0ce-3f6c-a081-1468434f1da0",
                                "text": "C’était un matin après la soupe, dans la cour de la caserne. Le vaguemestre faisait son ordinaire distribution de joies et de peines."
                            }
                        ]
                    },
                    {
                        "sense_id": "780ac971-60df-35e3-8054-734dc07eaf1d",
                        "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                        "glosses": [
                            "Dans un hôpital, ou un établissement pénitentiaire, fonctionnaire chargé du service postal (envoi et réception du courrier)."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "2c5c34af-0df7-4d81-abb0-4a0ced61df34",
                                "sense_id": "780ac971-60df-35e3-8054-734dc07eaf1d",
                                "text": "En plus de mettre en lumière une fonction méconnue – le vaguemestre est le responsable du courrier –, la triste nouvelle a souligné à quel point l’hôpital était, plus qu’un groupement de soignants, une ville dans la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0160546-d6e2-3127-b258-02e30f6b1108",
                        "entry_id": "920231a0-1255-3358-b215-6436fb4e8532",
                        "glosses": [
                            "Employé chargé du service postal."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc15cc0-4f5d-4b8a-9322-1b68b1940a72",
                                "sense_id": "b0160546-d6e2-3127-b258-02e30f6b1108",
                                "text": "Quand le vaguemestre de la maison lui remettait ces lettres d’une grosse écriture passionnée, elle se hâtait de les cacher dans sa poche."
                            }
                        ]
                    }
                ],
