                ],
                "senses": [
                    {
                        "sense_id": "be657c9f-c668-3c1a-9bae-6bcb3b7d6768",
                        "entry_id": "7aa9edfe-2abe-332f-b4b0-52d0ae0fb078",
                        "glosses": [
                            "спец. относящийся к иммерсии (погружению), основанный на иммерсии, создаваемый или обрабатываемый с помощью иммерсии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e72fd0be-cc74-461c-9113-ae2168380692",
                        "source_entry_id": "7aa9edfe-2abe-332f-b4b0-52d0ae0fb078",
                        "source_sense_id": "be657c9f-c668-3c1a-9bae-6bcb3b7d6768",
                        "target_lang_word": "immersion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immersion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2cd594-5910-3184-8a56-77446433444a",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "The act of immersing or the condition of being immersed.",
                                            "The total submerging of a person in water as an act of baptism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d7274f1-6d63-4268-992b-26992f904819",
                                                "sense_id": "5a2cd594-5910-3184-8a56-77446433444a",
                                                "text": "Jesus did not become known as a baptizer (cf. however John 3:26 and 4:1), but we can recognize the same ritual structure in his healing practice as in John's immersion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383014fb-e780-3b1f-a011-472ec2a3fbc7",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "The act of immersing or the condition of being immersed.",
                                            "Deep engagement in something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffad19c-e347-4147-bea2-59862c230f93",
                                                "sense_id": "383014fb-e780-3b1f-a011-472ec2a3fbc7",
                                                "text": "In examining Capote, Clarke follows the course of the precocious writer's life with painstaking attention to gossipy detail. It's an exhaustive roller coaster of a read, a high-tilt immersion into the social swirl and scandal that accompanied most of Capote's adult life."
                                            },
                                            {
                                                "example_id": "416e0cb2-e81b-4c40-a6d1-b0640a8240d2",
                                                "sense_id": "383014fb-e780-3b1f-a011-472ec2a3fbc7",
                                                "text": "Recognising and knowing how to understand visual imagery in relation to a narrative in picture books is primarily a matter of immersion in books within a specific culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18bb3421-94fe-3852-a73b-d2f3da3a993a",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "An immersion heater."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5097fb51-613e-4901-a2fd-0f5fcb5bbadf",
                                                "sense_id": "18bb3421-94fe-3852-a73b-d2f3da3a993a",
                                                "text": "She left the immersion on all the time, while I had been reared under pain of death to turn it off as soon as the bathwater was heated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5448fbdc-56b9-3a63-8248-8c17a018fe8a",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "A smooth map whose differential is everywhere injective, related to the mathematical concept of an embedding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab933d64-7c83-4a93-b622-08954c106c50",
                                                "sense_id": "5448fbdc-56b9-3a63-8248-8c17a018fe8a",
                                                "text": "Note that every embedding is an immersion, but the converse is not true. For an immersion to be an embedding, it must be one-to-one and the inverse must be continuous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604c6597-885b-31de-9e03-ea43ed50342b",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "The disappearance of a celestial body, by passing either behind another, as in the occultation of a star, or into its shadow, as in the eclipse of a satellite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa08d353-bd64-4497-825a-3c49f874c245",
                                                "sense_id": "604c6597-885b-31de-9e03-ea43ed50342b",
                                                "text": "An occultation of a star by the moon provides two sharply defined observable phenomena: the disappearance of a star behind the disc of the moon (called its immersion), and its subsequent reappearance (or emersion)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cc5463-5d0a-37e9-bb51-59874ed6c606",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "A form of foreign-language teaching where the language is used intensively to teach other subjects to a student."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5297253-4ff2-4ba0-afc3-ec013de43e5d",
                                                "sense_id": "53cc5463-5d0a-37e9-bb51-59874ed6c606",
                                                "text": "Although numerous studies have reported the effectiveness of immersion programmes in developing relatively high levels of second language proficiency without any tradeoff of first language development or subject matter mastery, little is known of immersion education in Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07bba890-7edd-3d99-acff-23bb19606450",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "One's suspension of disbelief while reading, playing a video game, etc. The experience of losing oneself in a fictional world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d5a4ab4-7448-3aaf-9369-ebdfbb1921c3",
                                        "entry_id": "6337562c-422a-313b-ad5a-a3b5a097c7d4",
                                        "glosses": [
                                            "A creative relationship with one's social and ecological environment as practiced by the Brooklyn Immersionists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
