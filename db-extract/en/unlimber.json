                    {
                        "sense_id": "ea3eeef2-b285-39bd-878a-f4519303b3ba",
                        "entry_id": "64fa19ab-09b0-3be3-a00d-4081338c8f07",
                        "glosses": [
                            "To detach (an artillery piece) from its limber to deploy for firing."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "370a4ea6-fcc4-444e-be0b-2bc7d827ba8e",
                                "sense_id": "ea3eeef2-b285-39bd-878a-f4519303b3ba",
                                "text": "The gun he drove had been unlimbered near Horsell, in order to command the sand-pits, and its arrival had precipitated the action."
                            }
                        ]
                    },
                    {
                        "sense_id": "afca1d61-bba4-31be-94ba-92f1fa990660",
                        "entry_id": "64fa19ab-09b0-3be3-a00d-4081338c8f07",
                        "glosses": [
                            "To clumsily put into employ (a large weapon or object)."
                        ],
                        "tags": [
                            "broadly",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "684058d7-9c20-31ef-84c3-8264dfa0f464",
                        "entry_id": "64fa19ab-09b0-3be3-a00d-4081338c8f07",
                        "glosses": [
                            "To unsling (something, as a backpack, carried on the body with a strap); to bring (something carried) into the hands for use."
                        ],
                        "tags": [
                            "broadly",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "89b24c6b-2165-3c3f-ad94-d42ad0a612fc",
                        "entry_id": "64fa19ab-09b0-3be3-a00d-4081338c8f07",
                        "glosses": [
                            "To stretch (limbs, muscles, etc., that have been cramped or unused for some time)."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "693a9761-195d-4022-acab-282e63d34ab0",
                                "sense_id": "89b24c6b-2165-3c3f-ad94-d42ad0a612fc",
                                "text": "\"I fancy,\" said Psmith, \"that this is one of those moments when it is necessary for me to unlimber my Sherlock Holmes system. […] Do you follow me, Comrade Maloney?\" / \"That's right,\" said Billy Windsor. \"Of course.\" / \"Elementary, my dear Watson, elementary,\" murmured Psmith."
                            },
                            {
                                "example_id": "5a32fbec-525f-41c5-9bbb-152fa2c4ffd9",
                                "sense_id": "89b24c6b-2165-3c3f-ad94-d42ad0a612fc",
                                "text": "Bony jumped down and unlimbered his cramped muscles before going after his camels."
                            }
                        ]
                    }
                ],
