                                        "glosses": [
                                            "Support du canon d'une arme reposant sur le sol par deux pieds en V renversé, servant à la stabilisation d'une arme pour un tir plus précis."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c3f1255-5335-47de-b6b7-747c02458fe6",
                                                "sense_id": "3e8a29e2-7bb2-33d5-acf2-1ac79930c67a",
                                                "text": "Il se compose d’un châssis modulaire en aluminium avec une poignée-pistolet et une crosse pliante et est équipé d’un bipied réglable en multipositions, d’un télescope à puissance variable et d’un silencieux."
                                            },
                                            {
                                                "example_id": "3a2979dc-5e3d-406d-9d38-5da3d319cd64",
                                                "sense_id": "3e8a29e2-7bb2-33d5-acf2-1ac79930c67a",
                                                "text": "Les fusils mitrailleurs, les fusils d'assaut et les mitrailleuses légères possèdent un bipied rabattable pour le transport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d922a758-4f98-3254-80e8-40fdf57d6812",
                                        "entry_id": "2c192dd2-3525-36ed-8d89-15b9bfa32ae9",
                                        "glosses": [
                                            "Béquille de moto."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f97bbc55-d663-46c4-b0e4-e61ea7651999",
                                                "sense_id": "d922a758-4f98-3254-80e8-40fdf57d6812",
                                                "text": "Alors il descendit de sa moto et la cala sur son bipied."
                                            }
                                        ]
                                    }
