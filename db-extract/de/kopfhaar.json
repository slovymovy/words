                ],
                "senses": [
                    {
                        "sense_id": "cd1dc269-d3c3-384c-8a07-d7ab05420299",
                        "entry_id": "776abbc0-43fd-30c3-b834-9a40370cffd8",
                        "glosses": [
                            "Behaarung auf dem Kopf einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae99acb6-a50d-41cd-8a32-a1009074ed21",
                                "sense_id": "cd1dc269-d3c3-384c-8a07-d7ab05420299",
                                "text": "„Während wir Touristen das Mahl genießen, erscheinen junge Männer mit Speeren und kunstvoll geflochtenem Kopfhaar.“"
                            },
                            {
                                "example_id": "ddcbbf0c-80e3-4cd4-ae6c-2812c0638d10",
                                "sense_id": "cd1dc269-d3c3-384c-8a07-d7ab05420299",
                                "text": "„Sein Kopfhaar war struppig, und Elma fragte sich, wann es zum letzten Mal einen Kamm gesehen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17c9239c-ea4a-355f-ba1f-b9f6503bdec5",
                        "entry_id": "776abbc0-43fd-30c3-b834-9a40370cffd8",
                        "glosses": [
                            "einzelnes Haar, das auf dem Kopf wächst"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dad299b-995e-4f68-8bbc-df38be5903b4",
                        "source_entry_id": "776abbc0-43fd-30c3-b834-9a40370cffd8",
                        "source_sense_id": "cd1dc269-d3c3-384c-8a07-d7ab05420299",
                        "source_sense_description": "Behaarung auf dem Kopf einer Person",
                        "target_lang_word": "cheveu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheveu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12faee43-fffb-3f1d-b1dd-e2b123ae1a94",
                                        "entry_id": "3c292b57-9e05-3ed4-aeb6-7295a4ef2a0a",
                                        "glosses": [
                                            "Filament organique synthétisé par l’épiderme du crâne humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d27900-647d-416b-8647-0dcd99c829c6",
                                                "sense_id": "12faee43-fffb-3f1d-b1dd-e2b123ae1a94",
                                                "text": "Les Liméniennes ont toutes de belles couleurs, les lèvres d’un rouge vif, de beaux cheveux noirs et bouclés naturellement, des yeux noirs d’une expression indéfinissable d’esprit, de fierté et de langueur."
                                            },
                                            {
                                                "example_id": "4bd3745c-62c1-4517-b01f-45b17d4be1e7",
                                                "sense_id": "12faee43-fffb-3f1d-b1dd-e2b123ae1a94",
                                                "text": "Sais-je où s’en iront tes cheveux\nCrépus comme mer qui moutonne\nSais-je où s’en iront tes cheveux\nEt tes mains feuilles de l’automne\nQue jonchent aussi nos aveux."
                                            },
                                            {
                                                "example_id": "da6c452c-195f-42e9-a557-50a949ea265f",
                                                "sense_id": "12faee43-fffb-3f1d-b1dd-e2b123ae1a94",
                                                "text": "Les cheveux humains viennent surtout de la Chine et du Japon où on peut se les procurer assez facilement. […]. Leur emploi, assez restreint, est limité à la fabrication des filtres, presses, des articles de maroquinerie et de voyage et à des articles de luxe."
                                            },
                                            {
                                                "example_id": "06808718-69eb-431e-8f0a-b69abe1c6571",
                                                "sense_id": "12faee43-fffb-3f1d-b1dd-e2b123ae1a94",
                                                "text": "Ses petits cheveux filasse, frisottants, hérissés autour du front, lui donnait un aspect farouche de méduse domestique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                        "entry_id": "3c292b57-9e05-3ed4-aeb6-7295a4ef2a0a",
                                        "glosses": [
                                            "Chevelure."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c3013af-6c5c-421c-98cc-aac26568a5c1",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Les jeunes filles relèvent leurs cheveux à la mode la plus nouvelle, avec des bouffantes sur le devant de la tête."
                                            },
                                            {
                                                "example_id": "fbde2e86-8aa4-474c-950c-0fccf28f1c86",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Sous son chapeau, à bords retroussés, apparaissaient, riches et crépus, des cheveux plutôt roux que blonds."
                                            },
                                            {
                                                "example_id": "488d930c-e7d4-430f-919f-de3516f0c70b",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Par un mystérieux tour de force, il avait réussi à se raser et à lisser ses cheveux dorés. Son visage était tout à fait séraphique."
                                            },
                                            {
                                                "example_id": "1c376e01-fa7b-4127-88c5-091b2cc5f65a",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Des dames viennent me voir parfois, accompagnées de demoiselles et de petites filles. Les unes enlèvent leur chapeau, et leurs cheveux nus apparaissent, mais leur visage perd sa bonté et son calme, car une tête sans chapeau frappe brutalement vos yeux comme une lampe sans abat-jour."
                                            },
                                            {
                                                "example_id": "6c3217ac-7cc7-43ad-957f-89b878e2ff2e",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Ses cheveux, étalés en frange sur le front, s’y déroulaient avec une élégance foraine du meilleur aloi."
                                            },
                                            {
                                                "example_id": "ce868726-0a1b-4596-9cc3-dabd6051f0db",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "Elle se poudra rapidement, passa un peigne dans ses cheveux, donna un coup d’œil prompt dans l’armoire à glace."
                                            },
                                            {
                                                "example_id": "6cac08b1-9d3f-42b7-978f-56fc69657e3a",
                                                "sense_id": "547daef7-445a-36a7-a55f-bad4a58798f0",
                                                "text": "[…] autour d’elle sans cesse il tournait, occupé à la parer, à la parfumer, à la friser et il poudrait ses cheveux et il les teignait tour à tour de toutes les couleurs et il les disposait en guiches, en coques, en macarons, ornant le chignon tantôt de nœuds de rubans, tantôt de fleurs artificielles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86afa1d7-98ce-3993-bcd3-56130acf710e",
                                        "entry_id": "3c292b57-9e05-3ed4-aeb6-7295a4ef2a0a",
                                        "glosses": [
                                            "Difficulté."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29b6204-c7e4-42b7-965e-2a9e0099b29d",
                                                "sense_id": "86afa1d7-98ce-3993-bcd3-56130acf710e",
                                                "text": "« Si c’est vraiment si beau, d’où vous venez, retournez-y. À moins qu’il y ait un cheveu. Eh ! bien, c’est précisément ce cheveu que nous voulons pas. Demi-tour. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a89efe0-36c3-4d15-9efa-fd5a276a56fd",
                        "source_entry_id": "776abbc0-43fd-30c3-b834-9a40370cffd8",
                        "source_sense_id": "cd1dc269-d3c3-384c-8a07-d7ab05420299",
                        "source_sense_description": "Behaarung auf dem Kopf einer Person",
                        "target_lang_word": "chevelure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevelure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Ensemble des cheveux d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5826ad-775c-4ac3-9b2a-e50de2d637c3",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Ce jeune homme frais, coquet et pommadé semblait ne penser qu’à sa chevelure et à l’effet de ses charmes sur son entourage féminin."
                                            },
                                            {
                                                "example_id": "fb95d20e-a5a5-4cac-8bfb-56765c692bf1",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Cette chevelure était éclatante et profonde, douce comme une fourrure, plus longue qu'une aile, souple, innombrable, animée, pleine de chaleur."
                                            },
                                            {
                                                "example_id": "e32eeaa0-9ab7-48c3-bd9d-051252ff2545",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Ses yeux bruns étaient bordés de noir ou plutôt meurtris ; sa lèvre supérieure était ornée d’un duvet brun qui dessinait une espèce de fumée ; elle avait les lèvres menues, et son front impérieux était rehaussé par une chevelure jadis noire, mais qui tournait au chinchilla."
                                            },
                                            {
                                                "example_id": "ffc2dd3d-240d-4b06-970e-f2187d3433bb",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Sa chevelure luxuriante, d’une nuance entre le brun et le blond, était partagée d’une manière gracieuse et élégante en nombreuses boucles où l’art avait assisté la nature."
                                            },
                                            {
                                                "example_id": "96b564d6-ce81-435c-b284-10b07ad69637",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Les étranges figures dont tout Mangarévien bigarrait sa peau, jointes à sa longue barbe et sa chevelure flottante, lui donnaient un air martial et terrible, […]."
                                            },
                                            {
                                                "example_id": "f9d47ed2-8763-4321-8476-566232b83671",
                                                "sense_id": "bcd6208b-f006-3bd4-b270-3bb9046cbf4c",
                                                "text": "Non, François ne se troublait pas. Cette jouvencelle aux yeux de paille mûre, cette blondeur capiteuse de la chevelure, cet arôme violent d'un corps en plein épanouissement, le remarquait-il ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Nébulosité entourant le noyau de certaines comètes et qui s’étire à l’opposé du soleil."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276628fc-69db-4f4a-9119-381255880cf8",
                                                "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                                "text": "La chevelure d’une comète est constituée de gaz et de particules solides arrachées au noyau."
                                            },
                                            {
                                                "example_id": "ab16e334-1bb3-45f3-9dea-2904998da6d6",
                                                "sense_id": "9c200fab-22a0-39bc-817c-d5b28b6d5e1b",
                                                "text": "Les astrophysiciens ont étudié la composition de la chevelure – ou coma – de Tchouri, alimentée par les dégazages du noyau cométaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee9e0999-7129-398e-8c56-1f9cb7ae0b1d",
                                        "entry_id": "5f899b67-3cf7-3a43-bd9c-e8659a53fac5",
                                        "glosses": [
                                            "Ensemble des feuilles des arbres, voire d'autres végétaux."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ff1423-6929-4482-a63a-39d5ac15c4d4",
                                                "sense_id": "ee9e0999-7129-398e-8c56-1f9cb7ae0b1d",
                                                "text": "C'est ainsi qu'à la ferme de la Faille près de Sainte-Marie-en-Chaux, […], le Ranunculus fluitans déploie seul ses longues chevelures sur de larges étendues, masquant presque totalement les galets du fond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
