                        "sense_id": "4ed8ac8e-fe7f-3968-8dba-e7a69cfb2742",
                        "entry_id": "4b1fbc04-c6a5-3c0e-9750-46e5a00472bb",
                        "glosses": [
                            "Salon ou salle principale d’une demeure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae693af2-c3a3-455b-8fb2-b037e7a50a7e",
                                "sense_id": "4ed8ac8e-fe7f-3968-8dba-e7a69cfb2742",
                                "text": "Au fond se présente le talar (la salle principale, le salon), percé de trois fenêtres à l’européenne et placé entre deux pavillons qui font saillie de chaque côté et sont ornés de niches garnies de stalactites dans le goût oriental."
                            }
                        ]
