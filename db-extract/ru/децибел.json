                ],
                "translations": [
                    {
                        "translation_id": "4d3f9405-a747-4246-a431-58afe52f1fd6",
                        "source_entry_id": "9a9f2e46-77ec-3aa1-9061-86c94055a60c",
                        "source_sense_id": "735e1c77-a578-3c4a-9506-037eee209303",
                        "target_lang_word": "decibel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decibel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fccadc94-0d02-34a7-aa2f-907bd181ca60",
                                        "entry_id": "0482a71e-79e1-349b-aa5a-cd84535a9fd5",
                                        "glosses": [
                                            "A common measure of intensity ratio (e.g. for sound) that is one tenth of a bel on the logarithmic intensity scale. It is defined as dB = 10 log₁₀(P₁ / P₂), where P₁ and P₂ are the relative intensities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "336acdf4-bd22-40f2-bbab-853c25e71cd3",
                        "source_entry_id": "9a9f2e46-77ec-3aa1-9061-86c94055a60c",
                        "source_sense_id": "735e1c77-a578-3c4a-9506-037eee209303",
                        "target_lang_word": "Dezibel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dezibel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                        "entry_id": "ec674dd0-8ad8-3c7c-b22b-c1ac2243f41e",
                                        "glosses": [
                                            "logarithmische Hilfsmaßeinheit zur Unterscheidung von Pegeln und Maßen in der Technik, insbesondere in der Akustik"
                                        ],
                                        "tags": [
                                            "zehnter Teil eines Bels"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a85588e1-3a43-4f35-a66b-c76e44df3c0f",
                                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                                "text": "Ein Dauerbombardement des Trommelfells mit 120 Dezibel ist nicht selten – so laut ist ein knapp über den Kopf hinwegfliegender Kampfjet."
                                            },
                                            {
                                                "example_id": "6b4c03d9-85ac-4ac8-8006-eda4bbe6aae7",
                                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                                "text": "Die üblicherweise in Dezibel (dB) gemessene Angabe beschreibt, in welchem Verhältnis die am Ausgang noch verbliebene Störspannung zum ursprünglichen Wert am Eingang steht."
                                            },
                                            {
                                                "example_id": "09eefd7f-2a99-4b8c-a13e-0d2e136db1da",
                                                "sense_id": "9055e283-7f6e-39ee-8952-976ff7d44443",
                                                "text": "„Als Kriegsgeschädigte durfte keine laute Musik in ihrer Nähe gespielt werden, denn alles über 90 Dezibel könnte bei ihnen zu traumatischen Psychosen führen, wie ein mafianaher Psychiater bestätigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cbf42d1-ee36-41fe-a434-d76eaa5fc15c",
