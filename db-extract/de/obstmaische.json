                "senses": [
                    {
                        "sense_id": "b9f3ada7-06aa-3f32-97e6-1cf2a7a22a97",
                        "entry_id": "651ae866-86f4-33a1-8dfc-2056e40d19e6",
                        "glosses": [
                            "aus Obst hergestellte Maische, die als Ausgangsstoff für die Herstellung von Obstbränden verwandt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e22a68-58aa-4a29-8804-853ea073fc55",
                                "sense_id": "b9f3ada7-06aa-3f32-97e6-1cf2a7a22a97",
                                "text": "„Gebrannt wird nur im Winter, hauptsächlich eigene Obstmaische sowie Hefe und Weintrester aus der Winzergenossenschaft.“"
                            },
                            {
                                "example_id": "cd6dcab2-d0a5-432d-bc25-0042dd834254",
                                "sense_id": "b9f3ada7-06aa-3f32-97e6-1cf2a7a22a97",
                                "text": "„Verschiedene Heferassen eignen sich nicht gleich gut und verhalten sich auch nicht bei allen Obstmaischen gleich.“"
                            },
                            {
                                "example_id": "3e160097-9099-415f-a8dd-0c13b256ca38",
                                "sense_id": "b9f3ada7-06aa-3f32-97e6-1cf2a7a22a97",
                                "text": "„Obstbrände (Obstbranntweine) werden durch Destillation vergorener Obstmaischen hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
