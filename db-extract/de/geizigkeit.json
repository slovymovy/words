                "senses": [
                    {
                        "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                        "entry_id": "390ba1ad-7fb2-34d8-9762-b17dd8dbdf21",
                        "glosses": [
                            "heftiger Unwille, etwas abzugeben (zum Beispiel Geld)"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f96bfba2-2f32-4179-b9f8-fba5c9953f49",
                                "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                                "text": "„Die übermäßige Geizigkeit unserer Mahlzeiten, indem sie mich Hunger leiden ließ, zeigte mir List und Diebstahl als die Mittel an, um dem Ziehen meines Magens entgegenzuwirken.“"
                            },
                            {
                                "example_id": "722ec6d7-b1f6-45a9-a791-ccd2eb8dce8c",
                                "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                                "text": "„Dabei wird immer mehr bestellt als gegessen, da leere Teller und Platten oft mit Geizigkeit des Einladenden in Verbindung gebracht werden.“"
                            },
                            {
                                "example_id": "c8da3449-7f50-4356-80ab-fece5435af0e",
                                "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                                "text": "„Leonardos Äußerungen über die Geizigkeit seines Herrn sind besonders unglaubwürdig.“"
                            },
                            {
                                "example_id": "53ab0110-fd4d-40f4-b9d2-aa7c0bddb87b",
                                "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                                "text": "„Wer französischen Komfort mit schwäbischer Geizigkeit verbinden möchte, wer auf eine gute Grundausstattung Wert legt und ein etwas anderes Auto fahren möchte, ist mit diesem Modell bestimmt gut bedient.“"
                            },
                            {
                                "example_id": "c3804e93-49d3-4618-b3ab-d465b01a8b4e",
                                "sense_id": "58b3c70b-837d-3c92-9ca8-28a13b6e1014",
                                "text": "„Die nächstfolgende, die Geizigkeit, wurde von ihm den Goldreichen, Staufleuten und Wechslern vermählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
