                        "glosses": [
                            "Of or relating to bacteriostasis or a bacteriostat; inhibiting the growth of bacteria without destroying them."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafd4b94-6cfc-4cec-a837-83782d097459",
                                "sense_id": "72e8fed3-fec6-3dea-8fe4-7d45beeb72ac",
                                "text": "All these compounds were bacteriostatic, affecting the bacterial metabolism and preventing its multiplication in the host, thereby permitting natural body defences to succeed against the invader."
                            }
                        ]
                    }
