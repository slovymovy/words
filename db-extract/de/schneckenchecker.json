                        "examples": [
                            {
                                "example_id": "dbe0e1e9-08d1-4962-8815-3110bcb44930",
                                "sense_id": "0e7f67bb-95e8-357d-86d1-6318a23a1015",
                                "text": "Er gibt sich gern als Womanizer und als „Schneggeschägger” („Schneckenchecker”): Comedian Maddin Schneider."
                            },
                            {
                                "example_id": "34110cc0-d4a0-46a9-8b0a-12e512c51089",
                                "sense_id": "0e7f67bb-95e8-357d-86d1-6318a23a1015",
                                "text": "Wenn Deutschland jemals ein Einwanderungsland war, dann ist es spätestens seit 2015 hauptsächlich Einreiseland für Genießer. Ich bin mit einer 4-[k]öpfigen irakischen Familie befreundet, die sprechen toll Deutsch, gehen fleißig arbeiten und die Kinder in die KiTa. Auch diese Familie schüttelt über das was hier los ist, über die soziale Hängematte für Massen an Ankommenden, für Langschläfer und Schneckenchecker in den Parks…nur noch mit den Köpfen…"
                            }
                        ]
                    }
