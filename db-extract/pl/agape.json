                        "sense_id": "3f8e41d5-7140-3ed5-84f6-aa42b7c8e055",
                        "entry_id": "78023e68-8f46-3b0b-bbd6-122889d8b255",
                        "glosses": [
                            "bezwarunkowa miłość Boga do człowieka"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12fb2905-c69d-35a0-b941-d5574d00bad0",
                        "entry_id": "78023e68-8f46-3b0b-bbd6-122889d8b255",
