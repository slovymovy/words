                ],
                "senses": [
                    {
                        "sense_id": "6221d4cb-1666-328a-9bca-a259df1417d2",
                        "entry_id": "911cb832-4f23-33fe-a456-7ff484a29981",
                        "glosses": [
                            "südlicher Teil Frankreichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab9fd806-3d6b-454b-b55a-48e20007a164",
                                "sense_id": "6221d4cb-1666-328a-9bca-a259df1417d2",
                                "text": "„[…] Ab dem 15. August 1944 landeten rund 180.000 alliierte Soldaten in Südfrankreich bei Saint Tropez.“"
                            },
                            {
                                "example_id": "450f9f67-59da-463c-9a75-a00619731c37",
                                "sense_id": "6221d4cb-1666-328a-9bca-a259df1417d2",
                                "text": "„Kaum daß die Mama und der Papa vom Campingurlaub aus Südfrankreich zurück sind, freuen sie sich schon auf ihren nächsten Campingurlaub in Südfrankreich.“"
                            },
                            {
                                "example_id": "587059e6-bf43-4d3b-8bb2-ee6c7dd1bc77",
                                "sense_id": "6221d4cb-1666-328a-9bca-a259df1417d2",
                                "text": "„Bereits unter Habibullah I. war Nader Schah zum ranghöchsten Militär aufgestiegen, hatte sich aber anschließend mit Amanullah überworfen und sich nach Südfrankreich zurückgezogen.“"
                            },
                            {
                                "example_id": "5d75ef7c-c30e-4b47-8d06-fe54b5d31ab3",
                                "sense_id": "6221d4cb-1666-328a-9bca-a259df1417d2",
                                "text": "„Wir sind uns in Südfrankreich begegnet, als wir mit der Band ein par Wochen in Aufführungen von zwei absurden Theaterstücken von Alfred Jarry auftraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
