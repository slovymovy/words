                "senses": [
                    {
                        "sense_id": "d1346311-6de8-30b2-aeea-51ad43d85fb9",
                        "entry_id": "f90ed19d-26be-3828-9c3b-2cdc3e8d78bb",
                        "glosses": [
                            "Form der Raserei und Gewaltausübung, bei der eine Person (genannt: Amokläufer) in blindem Vorwärtsstürmen jede ihm begegnende Person niedermetzelt oder niederschießt"
                        ],
                        "tags": [
                            "Gewaltverbrechen"
                        ],
                        "examples": [
                            {
                                "example_id": "73e99217-ee0b-4815-aeb5-633861d50b01",
                                "sense_id": "d1346311-6de8-30b2-aeea-51ad43d85fb9",
                                "text": "Seinen Amoklauf konnte selbst die Polizei zunächst nicht stoppen."
                            },
                            {
                                "example_id": "65ba264a-7a6d-4133-82ed-2b95a594b2a5",
                                "sense_id": "d1346311-6de8-30b2-aeea-51ad43d85fb9",
                                "text": "„Ein gräßlicher Verdacht stieg jetzt sogar in mir hoch: daß vielleicht Herr Kloßen im wirtschaftlichen Amoklauf unsere Stadt verlassen habe, anderswo ein neues Leben zu beginnen und eine unverbrauchte Gläubigerschaft aufzubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
