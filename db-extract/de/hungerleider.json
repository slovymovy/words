                "senses": [
                    {
                        "sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "glosses": [
                            "jemand, der sehr arm ist, ein armer Schlucker"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "deb6f645-38d1-46e7-b88e-0c120fff0c29",
                                "sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                                "text": "„Eines Tages faßte sich der Hungerleider Paul Simmel, dem der Magen knurrte, ein Herz und schleppte eine Mappe voller Berliner Motive in die Redaktionsräume der »Lustigen Blätter«.“"
                            },
                            {
                                "example_id": "3466bee1-4049-4b44-a808-3c64b154cf67",
                                "sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                                "text": "„Er legte es förmlich darauf ab, nach frierendem Hungerleider auszusehen, um seine völlige Weltverachtung zu zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23f806af-d09e-3aa7-8060-2b3bed3468f7",
                        "entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "glosses": [
                            "eine Person, die sich aus Geiz die notwendigsten Bedürfnisse versagt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bef0c2bc-11da-4052-a5ab-be7df7e31b7c",
                                "sense_id": "23f806af-d09e-3aa7-8060-2b3bed3468f7",
                                "text": "Unser Nachbar ist so ein richtiger Hungerleider."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cdda9c5-2633-4cad-8a4b-72d9552d46e1",
                        "source_entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "source_sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "source_sense_description": "umgangssprachlich, pejorativ: jemand, der sehr arm ist, ein armer Schlucker",
                        "target_lang_word": "starveling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starveling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebdd18b9-08f5-3a4e-8905-d757208a2628",
                                        "entry_id": "2524684a-cfb2-38bc-8388-25a56af11bf6",
                                        "glosses": [
                                            "One who is thin from lack of food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56887d5a-c0c8-4862-a8f2-281bb379e580",
                                                "sense_id": "ebdd18b9-08f5-3a4e-8905-d757208a2628",
                                                "text": "If I hang, I'll make a fat pair of gallows; for if I hang, old Sir John hangs with me, and thou knowest he is no starveling."
                                            },
                                            {
                                                "example_id": "301196b6-2879-4554-98ec-34b5522a2b27",
                                                "sense_id": "ebdd18b9-08f5-3a4e-8905-d757208a2628",
                                                "text": "As for the starveling rebels of our region, they soon began to reappear in town, more starved and abject, their blackened rags hanging on them[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "starveling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35102128-a90b-3c13-96a7-391eeab49265",
                                        "entry_id": "fd4df14f-497b-3871-b905-c4669855e4ef",
                                        "glosses": [
                                            "Starving; suffering from starvation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91866125-0d99-3c8f-9e7b-7e61dcd92158",
                                        "entry_id": "fd4df14f-497b-3871-b905-c4669855e4ef",
                                        "glosses": [
                                            "Meagre; scanty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b66187a-301c-45fd-989e-f956e4614608",
                                                "sense_id": "91866125-0d99-3c8f-9e7b-7e61dcd92158",
                                                "text": "[A] few meetings in the cape-broom, a starveling allowance of kisses in a very ill-advised publicity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1e5475e-77dd-4f10-ab6e-ec9f2378db32",
                        "source_entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "source_sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "source_sense_description": "umgangssprachlich, pejorativ: jemand, der sehr arm ist, ein armer Schlucker",
                        "target_lang_word": "crève-la-faim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crève-la-faim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f607d2a-41fc-3c76-8893-ebcbc55b8684",
                                        "entry_id": "e3d3b6ef-196c-3289-8df4-dbceb8e2dba7",
                                        "glosses": [
                                            "Variante de meurt-de-faim."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7958e312-45ac-457e-a090-19d1924886c6",
                                                "sense_id": "9f607d2a-41fc-3c76-8893-ebcbc55b8684",
                                                "text": "Elle lui préfère un greluchon qui fait des vers ! un métier de crève-la-faim !"
                                            },
                                            {
                                                "example_id": "fce6978f-0e00-4c29-aaf4-428fc877fefd",
                                                "sense_id": "9f607d2a-41fc-3c76-8893-ebcbc55b8684",
                                                "text": "On n’a pas besoin de toi, laisse donc les malheureux : tu n’auras pas ma gosse pour ton école de crève-la-faim !…"
                                            },
                                            {
                                                "example_id": "c7fd7a10-d872-4668-aa6d-dde9925b7ce2",
                                                "sense_id": "9f607d2a-41fc-3c76-8893-ebcbc55b8684",
                                                "text": "Il n’était pas rare de voir un ancien petit détaillant crève-la-faim devenir Maître-Fromager, avec un tablier bleu qui faisait très connaisseur et une boutique de poutres et de pailles…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "393562b5-561e-479e-ae3f-af9024489b3f",
                        "source_entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "source_sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "source_sense_description": "umgangssprachlich, pejorativ: jemand, der sehr arm ist, ein armer Schlucker",
                        "target_lang_word": "meurt-de-faim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meurt-de-faim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                        "entry_id": "5a221573-248b-35d3-9d90-c4846d67815f",
                                        "glosses": [
                                            "Personne qui manque du strict nécessaire et n’a même pas de quoi manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b154c61e-7e08-4e0d-8b1b-52ad9b29a1e0",
                                                "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                                "text": "Lorenzo.– Il paraît qu’il ne peut se guérir de cette singulière lubie d’ouvrir sa bourse à toutes ces viles créatures qu’on nomme bannis, et que ces meurt-de-faim se réunissent chez lui tous les jours, avant de mettre leurs souliers et de prendre leurs bâtons."
                                            },
                                            {
                                                "example_id": "1407cf93-b023-4185-ba4e-840df93691ef",
                                                "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                                "text": "C’était un gros avare, un homme brutal, qui les reçut comme des meurt-de-faim, la première fois qu’ils se présentèrent chez lui."
                                            },
                                            {
                                                "example_id": "7752eb34-3a8a-4828-b4b4-9b2e047e9243",
                                                "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                                "text": "Ou peut-être songeait-il aux représailles prochaines et sanglantes des meurt-de-faim, dans la rêverie incendiaire qui allumait ses grands yeux bleus, singuliers, vagues et brûlants."
                                            },
                                            {
                                                "example_id": "e8265d8f-84d1-4d3a-8ad1-e2c21fa7cb61",
                                                "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                                "text": "Il vit les Halles où des meurt-de-faim, des hommes du Peuple-Souverain glanent dans des tas de détritus (...)"
                                            },
                                            {
                                                "example_id": "15dbd683-4704-4f14-b32e-678f2fb9b76a",
                                                "sense_id": "873bd1fa-b404-3049-9430-809719a8a896",
                                                "text": "Quiconque mange bien peut défier le ciel. Ce sont les ascètes et les meurt-de-faim aux estomacs débilités qui ont inventé les dieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6127ee2d-48aa-4d0a-a8b1-d7e6c47f2920",
                        "source_entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "source_sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "source_sense_description": "umgangssprachlich, pejorativ: jemand, der sehr arm ist, ein armer Schlucker",
                        "target_lang_word": "meurt-la-faim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meurt-la-faim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9beea425-cfc3-3a02-b948-0eee86f553cc",
                                        "entry_id": "e968a4c9-115c-37a6-86d1-30af5cdca9c9",
                                        "glosses": [
                                            "Personne très pauvre, qui a du mal à trouver de quoi se nourrir."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35d566f6-a2f8-4957-84fc-c3886c0e068e",
                                                "sense_id": "9beea425-cfc3-3a02-b948-0eee86f553cc",
                                                "text": "Il n’avait pas l’aspect d’un meurt-la-faim et son visage n’était ni blafard ni verdâtre, stigmates habituels de ces sycophantes."
                                            },
                                            {
                                                "example_id": "ebbdc2a1-eb60-4e8c-84ac-b454e41fb600",
                                                "sense_id": "9beea425-cfc3-3a02-b948-0eee86f553cc",
                                                "text": "Ce meurt-la-faim réduit à l’aumône et à l’accueil gracieux des aubergistes, et que l’on assimile facilement au Diable pour cette même raison, s’inscrit bien dans la lignée du picaro espagnol avec qui il partage ce côté épicurien."
                                            },
                                            {
                                                "example_id": "0f903ebb-e644-48c3-8dc1-69e330e817dd",
                                                "sense_id": "9beea425-cfc3-3a02-b948-0eee86f553cc",
                                                "text": "Pour faire des meurt-en-gloire, il faut des meurt-la-faim, Chabrol !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fe0551e-46f4-4979-a3ea-3a419c3c3653",
                        "source_entry_id": "08ac4da5-e1bf-3fa7-aca7-d0e34efeca6d",
                        "source_sense_id": "7b79cc9a-8e60-3540-9202-a92ae449bcab",
                        "source_sense_description": "umgangssprachlich, pejorativ: jemand, der sehr arm ist, ein armer Schlucker",
                        "target_lang_word": "muerto de hambre",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muerto de hambre",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3580ed16-5a6e-39ec-9ac2-f7e6f17600ed",
                                        "entry_id": "5e5ba084-f0c5-30e3-be45-be0a8d142d0f",
                                        "glosses": [
                                            "Muy hambriento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30c3421-f5e1-476d-8652-faa6b9795866",
                                                "sense_id": "3580ed16-5a6e-39ec-9ac2-f7e6f17600ed",
                                                "text": "—¡O, reniego de quantos Cides ay en toda la cidería! ¡Venga, señor!, ¡pecador soy yo a Dios; que estas pobres cavalgaduras están de suerte que no pueden echar la palabra del cuerpo, según llegan de cansadas y muertas de hambre!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "muerto de hambre",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d23963c9-7afa-3282-8ee3-233cea98ef2f",
                                        "entry_id": "63825902-d3ca-3d5b-a78a-5ad23148a7da",
                                        "glosses": [
                                            "Persona muy pobre."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b20d3f4-52cf-4048-af0d-a0c218eef2d7",
                                                "sense_id": "d23963c9-7afa-3282-8ee3-233cea98ef2f",
                                                "text": "—Lo que no creo es que éste fuera el jefe —dijo el Chiquito—. Además, si robó tanto como dicen, no sería un muerto de hambre."
                                            },
                                            {
                                                "example_id": "8b54fc52-0d14-45df-8cb4-b764d9db30a7",
                                                "sense_id": "d23963c9-7afa-3282-8ee3-233cea98ef2f",
                                                "text": "me acerco más a tu oído atento aconsejándote esta noche por fin que no vale la pena seguir buscándolo porque puedes parir de un momento a otro y además el tal Romualdo era un muerto de hambre, no era ni dueño de la cabeza del Gigante con que te hizo lesa."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "465a0373-6b11-3a25-9be6-3944e9088e2a",
