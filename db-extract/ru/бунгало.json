                                        "sense_id": "d2ea9e1e-e676-38df-ad01-8c95d4a35283",
                                        "entry_id": "f40703a9-0547-311d-95ae-7d813ff66a44",
                                        "glosses": [
                                            "abitazione originaria dell'India, che consiste in una casa a un piano caratterizzata da una grande gronda sporgente che ricopre le ampie verande che la circondano"
                                        ],
