                            {
                                "example_id": "46d63f19-fc68-43cb-8bf5-a8c9e7b52716",
                                "sense_id": "7c5a723b-dfe7-3896-920c-2179541e4ad5",
                                "text": "„Käse sollte man immer doppelt in Wachspapier, Pergament oder Bienenwachstuch einschlagen und in einen mit feuchtem Küchenpapier ausgelegten Glas- oder Plastikbehälter legen.“"
                            },
                            {
                                "example_id": "f62289d8-c030-4512-b570-919dbf0396eb",
                                "sense_id": "7c5a723b-dfe7-3896-920c-2179541e4ad5",
                                "text": "„Sie öffnete den Kühlschrank und sah Dutzende Plastikbehälter, in die Hudson einen Teil des Essens gepackt hatte.“"
                            }
                        ],
