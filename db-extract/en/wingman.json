                        "glosses": [
                            "To act as a wingman for (someone); to accompany in order to provide support."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bcfb16d-4156-4e34-b8ce-8e049a79e3ec",
                                "sense_id": "19d32773-502b-3ea6-9447-ed0343bf0a31",
                                "text": "So Amir wingmanned me to Boots on my Johnny-bags buying mission."
                            },
                            {
                                "example_id": "bf7631f5-f332-4149-b999-ca0d77a7cecd",
                                "sense_id": "19d32773-502b-3ea6-9447-ed0343bf0a31",
                                "text": "They wingmanned for each other, and if they didn't have any luck, they'd screw each other."
                            },
                            {
                                "example_id": "d782d4c3-7547-40a4-a41d-b92e1613368b",
                                "sense_id": "19d32773-502b-3ea6-9447-ed0343bf0a31",
                                "text": "That night at the Mem, I wingmanned for Arthur. He was trying to hook up with a girl from the Meeting House, a share near the pond."
                            }
                        ]
                    }
