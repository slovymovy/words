                                                "sense_id": "90be1a55-6f09-3613-863d-6d6aff69158c",
                                                "text": "Władze tureckie zdołały częściowo opanować sytuację. Na Moście Bosforskim skapitulowała część puczystów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
