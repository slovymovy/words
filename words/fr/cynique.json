{
    "word_family": [
        "cynisme",
        "cyniquement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6a06dae-6c9f-3fbb-acbd-81d10b7548e1",
                    "sense_definition": "Qui fait preuve d'un mépris affiché pour les conventions sociales, la morale ou les sentiments d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude particulièrement <w>cynique</w> lors de la négociation a choqué tous ses collègues."
                        },
                        {
                            "text": "Il a esquissé un sourire <w>cynique</w> avant de répondre avec une grande franchise."
                        }
                    ],
                    "common_phrases": [
                        "sourire cynique",
                        "regard cynique"
                    ]
                },
                {
                    "sense_id": "0812c08b-8d50-3e3f-bfb6-a7bed27ab3c3",
                    "sense_definition": "Relatif à la doctrine ou à l'école philosophique antique prônant le retour à la nature et le rejet des conventions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diogène de Sinope est le représentant le plus célèbre de la philosophie <w>cynique</w>."
                        },
                        {
                            "text": "La pensée <w>cynique</w> cherchait à libérer les individus de l'attachement aux biens matériels."
                        }
                    ],
                    "common_phrases": [
                        "philosophie cynique",
                        "école cynique"
                    ]
                },
                {
                    "sense_id": "2e2c4b1c-8db0-31ed-bd87-85bcc7cbcff1",
                    "sense_definition": "Qui a rapport au chien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin décrivait un spasme <w>cynique</w> qui déformait les traits du visage du patient."
                        },
                        {
                            "text": "Le vieux manuel de médecine décrivait le rictus <w>cynique</w> d'un malade atteint du tétanos."
                        }
                    ],
                    "synonyms": [
                        "canin"
                    ],
                    "common_phrases": [
                        "spasme cynique"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme médical vieilli hérité du sens étymologique"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "194f3c6a-92ff-3020-8844-b881d5141191",
                    "sense_definition": "Personne qui exprime un mépris provocateur pour les principes moraux ou les valeurs admises.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce politicien se comporte comme un vrai <w>cynique</w> qui ne croit plus en rien."
                        },
                        {
                            "text": "Ne sois pas un <w>cynique</w> au point de douter de la sincérité de tes amis."
                        }
                    ],
                    "common_phrases": [
                        "faire le cynique"
                    ]
                },
                {
                    "sense_id": "61d839df-68f7-3e2f-8229-f7fc8633864f",
                    "sense_definition": "Adepte ou représentant de l'école philosophique cynique dans la Grèce antique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>cynique</w> vivait dans le dénuement pour démontrer l'inutilité du superflu."
                        },
                        {
                            "text": "Les <w>cyniques</w> critiquaient sans ménagement les hypocrisies de la cité grecque."
                        }
                    ],
                    "common_phrases": [
                        "les cyniques grecs"
                    ]
                }
            ]
        }
    ]
}