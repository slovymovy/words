    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2fe0635a-73bf-3160-9f9a-ebeb84c8515b",
                "word": "pregame",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3636874c-9d04-37f2-bd21-09bce6298262",
                        "entry_id": "2fe0635a-73bf-3160-9f9a-ebeb84c8515b",
                        "glosses": [
                            "Taking place before, or in preparation for, a sporting event or other game."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ad55658-9e06-422e-94f1-f442204f7e37",
                                "sense_id": "3636874c-9d04-37f2-bd21-09bce6298262",
                                "text": "Enough already with the predictions. Enough with the pregame analysis. Enough with the sidebars. Enough with the practices. Let the battle begin!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "af828973-273e-3ba1-9a9b-e77f5e7943f0",
                "word": "pregame",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4c6ac847-2984-4499-9c64-c7f68e1d5399",
                        "entry_id": "af828973-273e-3ba1-9a9b-e77f5e7943f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "pregames"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "188e9fce-8b2a-3835-9f39-a5b532c7888c",
                        "entry_id": "af828973-273e-3ba1-9a9b-e77f5e7943f0",
                        "glosses": [
                            "A social gathering of several friends who get together to drink before going out to a party or a sports game, in order to get a \\\"buzz\\\" before going out for the night."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643e44d4-203b-4394-9132-ec2d91110f0d",
                                "sense_id": "188e9fce-8b2a-3835-9f39-a5b532c7888c",
                                "text": "When the Brooklyn Nets are in town, there are office parties and tieless finance guys and pregame groups, like the one that showed up Wednesday night to celebrate the reunion of two old friends with a meal and some basketball (the Miami Heat, led by LeBron James, later trounced the home team)."
                            },
                            {
                                "example_id": "7e1c9c5c-5dd4-4318-960d-b0ee5aff2b1b",
                                "sense_id": "188e9fce-8b2a-3835-9f39-a5b532c7888c",
                                "text": "P: And what was going on there at Griffin Suite?\nJulia: A pregame."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b2f67a0-9b0f-34bc-a1b3-1cf32de0d21a",
                        "entry_id": "af828973-273e-3ba1-9a9b-e77f5e7943f0",
                        "glosses": [
                            "A television show preceding a sports game wherein commentators discuss that game."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554c9018-2b11-43af-a7dc-49e15421f0cc",
                                "sense_id": "9b2f67a0-9b0f-34bc-a1b3-1cf32de0d21a",
                                "text": "\"Hey sport, do you want to watch the pregame?\" asked Justin."
                            },
                            {
                                "example_id": "06d06b16-ab54-4308-b15e-cccd88d4dfbd",
                                "sense_id": "9b2f67a0-9b0f-34bc-a1b3-1cf32de0d21a",
                                "text": "Izzy had gone to the bar to catch the pregame."
                            },
                            {
                                "example_id": "7f83777c-9ce3-4518-8d61-b2345d08fdf1",
                                "sense_id": "9b2f67a0-9b0f-34bc-a1b3-1cf32de0d21a",
                                "text": "At the first Super Bowl, the pregame featured the marching bands from the University of Arizona and Grambling University."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4d8833d-7634-3eb7-9687-1daaeb55bde7",
                        "entry_id": "af828973-273e-3ba1-9a9b-e77f5e7943f0",
                        "glosses": [
                            "A period of time before an important event."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d1c938ed-421e-43b8-a3b6-adc9b27bbd38",
                                "sense_id": "b4d8833d-7634-3eb7-9687-1daaeb55bde7",
                                "text": "You can see the entire thing on SpaceX’s website. It looks long—45 whole minutes!—but there’s really only a 20-minute pregame, and then the rocket takes off, and then it flies and the stages separate and then it lands."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
