                "senses": [
                    {
                        "sense_id": "fbb283a8-45f4-396f-b57c-28601f61b420",
                        "entry_id": "55a25851-a0a7-34b7-80bd-d659348c35fe",
                        "glosses": [
                            "Kamera, die zur Überwachung des Straßenverkehrs dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8a948f-85ae-414e-a112-ae5587b70478",
                                "sense_id": "fbb283a8-45f4-396f-b57c-28601f61b420",
                                "text": "„Die Verkehrsüberwachungskameras zeigten, wie die Sabberer sich durch die Straßen schleppten: ein Bein nachziehend, geifernd die Zähne fletschend.“"
                            },
                            {
                                "example_id": "ae5ebb22-788a-4606-bd56-1784cb4ee637",
                                "sense_id": "fbb283a8-45f4-396f-b57c-28601f61b420",
                                "text": "„Im Heck des Transportraums beugten sich zwei Fahndungsagentinnen gemeinsam über einen Laptop, studierten die Informationen, die ihnen bereits in der Stadt befindliche Mossad-Agenten zur Verfügung stellten, und koordinierten den Datenaustausch mit Hackern in Tel Aviv, die das Netzwerk der Hamburger Verkehrsüberwachungskameras angezapft hatten.“"
                            },
                            {
                                "example_id": "37c7c0db-ab97-439b-8e5e-3feb62b40528",
                                "sense_id": "fbb283a8-45f4-396f-b57c-28601f61b420",
                                "text": "„›Zurzeit werden die Aufnahmen der Verkehrsüberwachungskameras geprüft, aber ich würde nicht damit rechnen, dass wir aussagekräftige Bilder haben.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
