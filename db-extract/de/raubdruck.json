                        ],
                        "form": "den Raubdruck"
                    },
                    {
                        "form_id": "21ad71b6-6bd9-48b2-ae7d-076f860cf462",
                        "entry_id": "e5277fcc-d281-394d-84f7-488546ad1b32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Raubdrucke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                        "entry_id": "e5277fcc-d281-394d-84f7-488546ad1b32",
                        "glosses": [
                            "der unberechtigte Nachdruck eines Druckwerks, zum Beispiel durch einen Konkurrenzverlag, der in der Regel dabei seine eigene Identität verschleiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49c9802-94f0-46ff-8954-a154d9634088",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "Kurz nach Erscheinung seines neuesten Romans wurde der Markt mit Raubdrucken überschwemmt."
                            },
                            {
                                "example_id": "d8808ef8-e711-4518-95a8-e86e58d8f618",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "Im neuen § 108 des UrhG ist Raubdruck nunmehr ein Offizialdelikt und nicht mehr nur ein Antragsdelikt."
                            },
                            {
                                "example_id": "8632bde2-b37c-4fde-ab45-67b667b729d8",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "„Gottfried August Bürger, dem es trotz des Erfolgs seiner Münchhausengeschichten nie gelang, sich am eigenen Schopf finanziell aus dem Sumpf zu ziehen, publizierte beispielsweise den Vorschlag einer Assekuranzkasse, mit der die Einnahmeausfälle durch Raubdrucke versichert werden sollten.“"
                            },
                            {
                                "example_id": "768b1255-c809-4d2b-a2d6-642405feca2d",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "„Ein Druckexemplar des Buches ohne diesen Fehler wäre unschwer als Raubdruck zu erkennen, wenn der scheinbare Fehler versehentlich korrigiert wurde.“"
                            },
                            {
                                "example_id": "20d9abf9-2253-4d67-a668-0ff91d7bf3e8",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "„Wie in einem Schneeballsystem reihten sich die Sätze aus den Raubdrucken revolutionärer Koryphäen aneinander.“"
                            },
                            {
                                "example_id": "8ceea9ef-b953-41c7-a8e2-a378d8bf5f9b",
                                "sense_id": "ab431c9a-0c59-3b4f-b9e8-1604e3f292ba",
                                "text": "„Die anti-chassidische Satire, die vor groteskem Humor sprüht, wurde ein großer Erfolg, sogar unter den verspotteten Chassidim selbst, sodass unmittelbar nach Abschluss der Serie schon die ersten Raubdrucke erschienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
