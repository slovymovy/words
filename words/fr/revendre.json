                    "sense_definition": "Vendre ce que l'on a soi-même acheté ou reçu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir acheté cette maison ancienne, il espère la <w>revendre</w> avec profit."
                        },
                        {
                            "text": "Elle a préféré <w>revendre</w> son ancien téléphone en ligne plutôt que de le jeter."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "acheter",
                        "racheter"
                    ],
                    "common_phrases": [
