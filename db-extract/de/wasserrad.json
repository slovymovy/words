                        ]
                    },
                    {
                        "translation_id": "05f1e20f-0e56-4ede-a280-9ccbc7efac77",
                        "source_entry_id": "7db05174-91c2-3d10-b0b8-1785e101c70b",
                        "source_sense_id": "9e8f8e9b-76d1-3446-ae1d-40b0b68d4407",
                        "target_lang_word": "roue à aubes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roue à aubes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "142150e6-3e94-3d6f-81c4-90c505d4b086",
                                        "entry_id": "6640dceb-c331-3820-9d20-62ba515cf5f3",
                                        "glosses": [
                                            "Roue de construction particulière, munie de pales qui captent et transmettent l’énergie de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cce3117-393b-427d-b039-290d10330107",
                                                "sense_id": "142150e6-3e94-3d6f-81c4-90c505d4b086",
                                                "text": "On aura donc toujours plus d’avantage, lorsqu’on voudra ménager l’eau, à se servir de roues à augets, en les faisant tourner lentement, qu’à employer des roues à aubes."
                                            },
                                            {
                                                "example_id": "97340c1c-4dbc-4e13-8d01-0193e2b6c6ae",
                                                "sense_id": "142150e6-3e94-3d6f-81c4-90c505d4b086",
                                                "text": "Ce sont les moulins à roue pendante, dans lesquels la roue à aubes, mais aussi l’arbre, le rouet et la lanterne qui lui sont le plus souvent solidaires, sont montés sur un chassis."
                                            },
                                            {
                                                "example_id": "4d78f85a-164f-42ea-9e75-ebf9f3bff3fe",
                                                "sense_id": "142150e6-3e94-3d6f-81c4-90c505d4b086",
                                                "text": "Avant l’apparition des roues Pelton vers 1850, on n’utilisait que deux types de roues hydrauliques dans les forges. … La plus répandue était la roue à aubes, dite à la gentille. La roue à augets, dite à la capucine, est plus rapide mais exige une plus grande chute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9697975e-4024-3c98-b86b-eb2702000419",
                                        "entry_id": "6640dceb-c331-3820-9d20-62ba515cf5f3",
                                        "glosses": [
                                            "Sorte de roue munie d’aubes articulées ou fixes et servant de propulseur à un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b6fd77-1690-4d0a-a277-32c064b9d0b2",
                                                "sense_id": "9697975e-4024-3c98-b86b-eb2702000419",
                                                "text": "Leur bateau à vapeur fut lancé en 1854. C’était une barque longue et étroite avec une grande roue à aubes placée à l’arrière et actionnée par une forte machine à vapeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ae461e4-88d7-4355-b7e5-8e835cf66723",
                        "source_entry_id": "7db05174-91c2-3d10-b0b8-1785e101c70b",
                        "source_sense_id": "9e8f8e9b-76d1-3446-ae1d-40b0b68d4407",
                        "target_lang_word": "roue hydraulique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roue hydraulique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "756e3d36-e1c1-3ed3-9e5c-6043ec1d7c38",
                                        "entry_id": "2e046ade-e760-3def-a77a-f76e7cb8db1b",
                                        "glosses": [
                                            "Roue motrice mue par la force de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98436b79-36c2-4682-8886-c8c566bd2e5a",
                                                "sense_id": "756e3d36-e1c1-3ed3-9e5c-6043ec1d7c38",
                                                "text": "Il y a deux espèces de Roues hydrauliques, l’une connue généralement sous le nom de roue à aubes ou à palettes, qui se meut par le choc de l’eau ; l’autre, connue sous le nom de roue à pots ou à godets, qui se meut en partie par le choc & en partie par le poids de l’eau."
                                            },
                                            {
                                                "example_id": "118d2d2a-be05-42d3-98f5-309859da8a49",
                                                "sense_id": "756e3d36-e1c1-3ed3-9e5c-6043ec1d7c38",
                                                "text": "Projet de roue hydraulique à augets pour un moulin à poudre à deux batteries de 12 pilons chacune, pour la poudrerie de Saint-Chamas."
                                            },
                                            {
                                                "example_id": "de16623a-2173-4e1a-a2b7-2cdf56ce6e67",
                                                "sense_id": "756e3d36-e1c1-3ed3-9e5c-6043ec1d7c38",
                                                "text": "La grande roue hydraulique avec son engrenage en fonte, donnant le mouvement à tous les laminoirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
