                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b21b3137-48fb-44c5-89ed-8251d9e455d2",
                                                "sense_id": "5e0d4ee7-9502-3fb7-88ae-3d79305d4fd1",
                                                "text": "„Das gesetzliche Vorausvermächtnis des überlebenden Ehegatten an der Ehewohnung (§ 758 ABGB) wird als Sublegat angesehen, wenn die Ehewohnung vom Erblasser legiert wurde (SZ 70/47).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
