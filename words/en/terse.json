    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1362277f-dfa4-36f0-b62b-4b320ddc23db",
                    "sense_definition": "Of speech or style: brief, concise, and directly to the point.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "style_of_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author's <w>terse</w> style of writing conveys deep meaning without wasting any words.",
                            "target_lang_translations": {
                                "ru": "<w>Краткий</w> стиль письма автора передает глубокий смысл, не тратя лишних слов.",
                                "nl": "De <w>bondige</w> schrijfstijl van de auteur brengt een diepe betekenis over zonder woorden te verspillen."
                            }
                        },
                        {
                            "text": "She sent a <w>terse</w> message to her team to announce the sudden change in plans.",
                            "target_lang_translations": {
                                "ru": "Она отправила своей команде <w>лаконичное</w> сообщение, чтобы объявить о внезапной смене планов.",
                                "nl": "Ze stuurde een <w>beknopt</w> bericht naar haar team om de plotselinge wijziging in de plannen aan te kondigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "concise",
                        "succinct",
                        "brief",
                        "crisp",
                        "laconic",
                        "to the point"
                    ],
                    "antonyms": [
                        "prolix",
                        "verbose",
                        "wordy"
                    ],
                    "common_phrases": [
                        "terse message",
                        "terse style",
                        "terse reply"
                    ],
                    "target_lang_definitions": {
                        "ru": "О речи или стиле: краткий, сжатый и по существу.",
                        "nl": "Betreffende spraak of stijl: kort, bondig en direct ter zake."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кра́ткий",
                                "target_lang_sense_clarification": "лаконичный, сжатый"
                            },
                            {
                                "target_lang_word": "лакони́чный",
                                "target_lang_sense_clarification": "выразительный и немногословный"
                            },
                            {
                                "target_lang_word": "немногосло́вный",
                                "target_lang_sense_clarification": "содержащий мало слов"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bondig",
                                "target_lang_sense_clarification": "kort en krachtig"
                            },
                            {
                                "target_lang_word": "beknopt",
                                "target_lang_sense_clarification": "met weinig woorden"
                            },
                            {
                                "target_lang_word": "laconiek",
                                "target_lang_sense_clarification": "kort en kalm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d299897a-b5ef-36f3-83d2-7292ee661ca4",
                    "sense_definition": "Of manner or speech: abruptly or brusquely short; curt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "style_of_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice was <w>terse</w> and tight, showing his growing impatience with the questions.",
                            "target_lang_translations": {
                                "ru": "Его голос был <w>резким</w> и напряженным, показывая растущее нетерпение к вопросам.",
                                "nl": "Zijn stem was <w>kortaf</w> en gespannen, wat zijn groeiende ongeduld met de vragen liet zien."
                            }
                        },
                        {
                            "text": "She gave a <w>terse</w> nod and walked away before I could explain myself.",
                            "target_lang_translations": {
                                "ru": "Она <w>отрывисто</w> кивнула и ушла, прежде чем я успел объясниться.",
                                "nl": "Ze gaf een <w>afgemeten</w> knikje en liep weg voordat ik mezelf kon uitleggen."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrupt",
                        "brusque"
                    ],
                    "common_phrases": [
                        "terse nod",
                        "terse tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "О манере или речи: резкий, сухой, отрывистый.",
                        "nl": "Betreffende houding of spraak: abrupt of bruusk kort; kortaf."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "грубоватый, сухой"
                            },
                            {
                                "target_lang_word": "отрывистый",
                                "target_lang_sense_clarification": "резкий, сухой по тону"
                            },
                            {
                                "target_lang_word": "односло́жный",
                                "target_lang_sense_clarification": "краткий, недружелюбный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kortaf",
                                "target_lang_sense_clarification": "onvriendelijk kort"
                            },
                            {
                                "target_lang_word": "bits",
                                "target_lang_sense_clarification": "scherp en onvriendelijk"
                            },
                            {
                                "target_lang_word": "afgemeten",
                                "target_lang_sense_clarification": "koel en afstandelijk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d110e3c-0c46-36a4-93f9-200a482e83e6",
                    "sense_definition": "Burnished, polished; fine, smooth; neat and spruce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient streets of Rome appeared polite and <w>terse</w> to the visiting poet.",
                            "target_lang_translations": {
                                "ru": "Древние улицы Рима казались приезжему поэту благородными и <w>отточенными</w>.",
                                "nl": "De oude straten van Rome leken voor de bezoekende dichter beleefd en <w>verfijnd</w>."
                            }
                        },
                        {
                            "text": "He admired the <w>terse</w> and polished surface of the classical marble sculptures.",
                            "target_lang_translations": {
                                "ru": "Он восхищался <w>гладкой</w> и отполированной поверхностью классических мраморных скульптур.",
                                "nl": "Hij bewonderde het <w>gepolijste</w> en gladde oppervlak van de klassieke marmeren beelden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of polished or neat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отполированный, гладкий, изящный.",
                        "nl": "Gepolijst, glad; fijn, netjes en verzorgd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отполированный",
                                "target_lang_sense_clarification": "гладкий, блестящий"
                            },
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "отделанный, утонченный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gepolijst",
                                "target_lang_sense_clarification": "glad en glanzend"
                            },
                            {
                                "target_lang_word": "verfijnd",
                                "target_lang_sense_clarification": "elegant en netjes"
                            }
                        ]
                    }
                }
            ]
        }
