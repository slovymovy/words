                ],
                "senses": [
                    {
                        "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                        "entry_id": "dd325408-4222-3335-bf93-20d32352d030",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09391115-0e90-4dd2-921d-78b36e9781e2",
                                "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                                "text": "„Auf dem Standesamt in Satteins tauschten Sieglinde Radis und Florian Noll aus Bürs, vor dem Standesbeamten Reinhard Konzett die Ringe.“"
                            },
                            {
                                "example_id": "fa0cc7d4-5925-43df-aff4-4e4e2f2358ce",
                                "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                                "text": "„Angeregt durch Jürgen Bauer und Abteilungsleiter Michael Radis wurde der Trainingsabend kurzerhand zum Turnierabend umfunktioniert.“"
                            },
                            {
                                "example_id": "e4dddc94-573b-4b0c-a529-dd6b17f44760",
                                "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                                "text": "„Ganz ohne Rote Karte ging es aber nicht. FSV Wittens Wolfgang Radis sah im Spiel gegen Herbede II die einzige Rote Karte des Turniers.“"
                            },
                            {
                                "example_id": "96531ff0-4d11-4f98-8aa1-ba226bdb54a8",
                                "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                                "text": "„‚Es ist ein Spagat‘, stimmen Nicole Radis und Elke Koch vollkommen überein.“"
                            },
                            {
                                "example_id": "32ccad56-4de6-4dc8-abee-bf2c699a5a29",
                                "sense_id": "ae280479-2cc0-3458-841d-5e432598aac2",
                                "text": "„Für Andreas Radis, Leiter des Anästhesie-Pflegeteams, „war es ein spannendes Training.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
