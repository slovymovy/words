                ],
                "senses": [
                    {
                        "sense_id": "c2908099-3fac-3805-be19-42eafe0be6a7",
                        "entry_id": "3340ce3d-ca2a-3272-9e9b-a486ff6a9394",
                        "glosses": [
                            "die Lehre von und über die Person Christi und dessen Heilswirken wie sie im Neuen Testament grundgelegt und von den christlichen Kirchen entfaltet wurde"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "451e5472-c02e-42e0-81f1-3d75eb8dcea6",
                                "sense_id": "c2908099-3fac-3805-be19-42eafe0be6a7",
                                "text": "Die Christologien des französischen Jesuitenpaters Teilhard de Chardin und diejenige der katholischen Kirche wurden zeitweise doch als äußerst different empfunden."
                            },
                            {
                                "example_id": "f889b4e9-699b-46a6-85ff-d8b71c9eda86",
                                "sense_id": "c2908099-3fac-3805-be19-42eafe0be6a7",
                                "text": "Die Christologie ist mit dem Bekenntnis „Jesus ist der Christus, Jesus ist der Herr!“ (Brief an die Römer 10,9 und Brief an die Philipper 2,11) aus dem jüdischen Umkreis herausgetreten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
