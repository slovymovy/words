                    {
                        "translation_id": "8ed3fc7c-6653-4a27-bf98-69a0aacd51b8",
                        "source_entry_id": "1228cfb3-6700-3d5d-9665-5ff8ac34978e",
                        "source_sense_id": "87f9a902-4397-3b00-bec9-a218db0a440f",
