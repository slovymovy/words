                    {
                        "sense_id": "138fb63a-8f16-3105-a70e-b8ce6afea620",
                        "entry_id": "5e65ff8a-f1a6-3b17-a9d0-6e5b8baeaa04",
                        "glosses": [
                            "Gerät zur Messung des spezifischen Gewichts von Wasser, der Geschwindigkeit fließenden Wassers, der Menge des durch ein Rohr strömenden Wassers"
                        ],
                        "tags": [],
