                        "glosses": [
                            "Savant qui s’occupe de l’étude des runes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0ff9b8-ac65-4569-9270-76ba6841aa5c",
                                "sense_id": "90a3e225-99f1-31cf-af39-788ed7f196dd",
                                "text": "La runologue Lisbeth Imer du musée national du Danemark ajoute : « Il est incroyablement rare de trouver des runes aussi anciennes que celles de ce couteau. C’est une occasion unique d’en apprendre davantage sur la première langue écrite du Danemark et aussi sur la langue qui était réellement parlée durant l’âge du Fer »."
                            },
                            {
                                "example_id": "d73da80e-6ab1-4cb8-828e-a9c57f06a1a7",
                                "sense_id": "90a3e225-99f1-31cf-af39-788ed7f196dd",
                                "text": "Aujourd’hui, aucun runologue n’a pu identifier un lieu d'origine des runes, même si l’on sait qu’elles étaient employées essentiellement en Scandinavie."
                            }
                        ]
                    }
