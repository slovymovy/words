                            "plural"
                        ],
                        "form": "régiolectes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df6347a9-befc-3677-ba8d-81dc014609ea",
                        "entry_id": "16476990-c8ad-3499-9a1e-57c1f3e8052b",
                        "glosses": [
                            "Langue ou dialecte propre à une région d’un pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07c0d24-432e-475a-a628-20d4a4a4e0d7",
                                "sense_id": "df6347a9-befc-3677-ba8d-81dc014609ea",
                                "text": "Pour des raisons pragmatiques nous avons choisi de vous proposer un seul régiolecte, en mettant en avant quelques variations dialectales dans les notes de grammaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f1f8182-c137-46c0-9164-08b2bdbddc5b",
                        "source_entry_id": "16476990-c8ad-3499-9a1e-57c1f3e8052b",
                        "source_sense_id": "df6347a9-befc-3677-ba8d-81dc014609ea",
                        "target_lang_word": "Regiolekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regiolekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3645aa3-2631-3609-a102-c50337cec963",
                                        "entry_id": "ae5fdd01-69fb-391f-9228-78bd2fdf53f7",
                                        "glosses": [
                                            "auf eine bestimmte Region beschränkte Varietät einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c003e3cb-046b-4dd8-935a-c2a5a484630d",
                                                "sense_id": "c3645aa3-2631-3609-a102-c50337cec963",
                                                "text": "„Wir verlassen den Bereich der Dialekte und Regiolekte und kehren zu den gemeinsprachlichen Bezeichnungen für die Repräsentantinnen des »ältesten Gewerbes der Welt« zurück…“"
                                            },
                                            {
                                                "example_id": "e353b551-dca6-46e3-aa47-adf081b67c65",
                                                "sense_id": "c3645aa3-2631-3609-a102-c50337cec963",
                                                "text": "„Ohne Basiskenntnisse der Sprachvarietäten beziehungsweise der Regiolekte kommt man schwer voran.“"
                                            },
                                            {
                                                "example_id": "e987d737-8e2e-4cbf-9650-237ee7dae0d9",
                                                "sense_id": "c3645aa3-2631-3609-a102-c50337cec963",
                                                "text": "„Sowohl der Dialekt als auch der Regiolekt haben einen relativ großen objektsprachlich gemessenen Abstand zur normierten Standardlautung.“"
                                            },
                                            {
                                                "example_id": "a3fad493-2946-48ea-baad-d13fe66c3e12",
                                                "sense_id": "c3645aa3-2631-3609-a102-c50337cec963",
                                                "text": "„In der Regel hört man auf der Straße und in den Gaststätten anstelle der original Kölner Mundart eine Art Kölsch light, einen abgemilderten rheinischen Regiolekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9de6b28-3604-45d6-a5c8-a62bfdfd8585",
                        "source_entry_id": "16476990-c8ad-3499-9a1e-57c1f3e8052b",
                        "source_sense_id": "df6347a9-befc-3677-ba8d-81dc014609ea",
                        "target_lang_word": "Regionalsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regionalsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                        "entry_id": "60dd03d7-6d5b-31b9-85fb-c219bdfc09be",
                                        "glosses": [
                                            "eine Sprachform, die in einer Sprachgemeinschaft nur eine räumlich begrenzte Verbreitung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6433c186-b302-4c39-a921-0c19f395e34c",
                                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                                "text": "„Die Tarnung früherer krimineller Vaganten als ambulante Gewerbetreibende, z.B. Wandermusikanten, Hausierer, Korbmacher, Kesselflicker, verweist zugleich auf weitere Sprachteilhaber des Rotwelschen, das im alltäglichen Kontakt mit dem Jiddischen (Handelsjuden), Zigeunerischen und der jeweiligen Regionalsprache zahlreiche Differenzierungen erfahren hat.“"
                                            },
                                            {
                                                "example_id": "4478f27a-88a8-418c-8616-16537b430b94",
                                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                                "text": "„Einzig zur soziolektalen Differenzierung einer Regionalsprache (des Ruhrgebiets) und zu deren sozialen Stigma-Signalen liegt eine empirische Studie von W. Steinig (1976) vor.“"
                                            },
                                            {
                                                "example_id": "a4b8d09d-49cc-4bed-8789-ff67238f23ac",
                                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                                "text": "„Ortssprachen und Regionalsprachen, über deren sprachwissenschaftliche Analyse wir nachdenken wollen, gehören in den Zusammenhang von Sprache und Sprachen in einem Gebiet, das ein Ortspunkt, ein Bezirk, eine Region, ein Land, eine Ländergruppe usf. sein kann.“"
                                            },
                                            {
                                                "example_id": "9a04817b-8ea8-4859-9dc1-5084b2e46fa5",
                                                "sense_id": "d93509a7-51ee-39de-afcf-a51a1051b5b0",
                                                "text": "„Die Diskriminierung der südlichen Regionalsprachen findet täglich in den Kindergärten und Schulen statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                        "entry_id": "60dd03d7-6d5b-31b9-85fb-c219bdfc09be",
                                        "glosses": [
                                            "Sprachform mit nur regionaler Verbreitung in einer Sprachgemeinschaft, die besonders geschützt/gefördert werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a7c9c8-b18c-4e43-9cd8-9ee0ee8fc501",
                                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                                "text": "In Deutschland genießt nur das Niederdeutsche den Status einer Regionalsprache."
                                            },
                                            {
                                                "example_id": "5248bc25-5c10-43b3-a608-dd37e8c1d25d",
                                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                                "text": "„Das Departement Haut-Rhin hat die Beamten ausdrücklich dazu aufgefordert, im Publikumsverkehr die Regionalsprache einzusetzen.“"
                                            },
                                            {
                                                "example_id": "38795688-5e5f-4f6e-8ccd-1302da5e6660",
                                                "sense_id": "85ee0fa0-bd6b-30f3-82dc-61c3804e6339",
                                                "text": "„Dabei gibt es doch die Europäische Charta der Regional- oder Minderheitensprachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
