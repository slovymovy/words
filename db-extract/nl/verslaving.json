                                "target_senses": [
                                    {
                                        "sense_id": "f1e8a2d7-55f9-3ba5-ad70-607bc4d8ddc4",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A state that is characterized by compulsive drug use or compulsive engagement in rewarding behavior, despite negative consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0aaf080-5485-4743-aea3-b4f3e5f2e9b7",
                                                "sense_id": "f1e8a2d7-55f9-3ba5-ad70-607bc4d8ddc4",
                                                "text": "Do your lethal addictions to self-prescriptions numb the ache of the darkest days?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab3c2b6-5264-3e84-a574-049def1e10a5",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "The state of being addicted; devotion; inclination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97b7dd5c-86af-3d86-8c2e-871f57891c21",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A habit or practice that damages, jeopardizes or shortens one's life but when ceased causes trauma."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "201889aa-a738-36d0-b9f4-e37d3469cc20",
                                        "entry_id": "10c6191b-9f70-37f2-8dfa-5bd40d129802",
                                        "glosses": [
                                            "A pathological relationship to mood altering experience that has life damaging consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea04ed5-67cc-4d12-b332-fa34962457d7",
                                                "sense_id": "201889aa-a738-36d0-b9f4-e37d3469cc20",
                                                "text": "His addiction was to courses vain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1425585-ffbb-47f9-b2e4-1d2cbf7f9616",
                        "source_entry_id": "cf3df4d3-802e-3496-ac63-0187bd9e1448",
                        "source_sense_id": "7d0f8392-2df4-3a84-b814-766cb44a7ad7",
                        "source_sense_description": "een toestand waarin een persoon fysiek en/of mentaal van een gewoonte of stof afhankelijk is",
                        "target_lang_word": "addiction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "addiction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b687def4-327e-348d-80af-718d9d0396ec",
                                        "entry_id": "9d4ee657-38c8-3bff-8e27-635b2650a0be",
                                        "glosses": [
                                            "Dépendance physique à une drogue, entraînant une perte de liberté d'action."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f72949f-bdd9-40a9-a463-4360cb65b727",
                                                "sense_id": "b687def4-327e-348d-80af-718d9d0396ec",
                                                "text": "— Et pourquoi ne dirait-on pas « addiction » en français ? l’interrogea Banon.\n— Parce que, cher Monsieur, cela risque inutilement de n’être pas compris.\n— Mais « addiction » est déjà dans Shakespeare !\n— Je préfère « dépendance » : c’est déjà dans Racine."
                                            },
                                            {
                                                "example_id": "e6224ae1-fc7f-444f-9ecd-1a5defed1a10",
                                                "sense_id": "b687def4-327e-348d-80af-718d9d0396ec",
                                                "text": "Ferenczi considérait déjà en 1932 l’origine traumatique des addictions et plus particulièrement leur rôle anesthésiant et protecteur vis-à-vis de l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                        "entry_id": "9d4ee657-38c8-3bff-8e27-635b2650a0be",
                                        "glosses": [
                                            "Dépendance psychique à une substance, une activité ou une structure sociale, menant à une consommation ou une répétition compulsives."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3609f1-2e8e-4e69-b86a-7ca6fe7aed72",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Façon d'être, mode de vie, philosophie du geek ou de la geekette, qui implique une dévotion quasi fanatique aux nouvelles technologies, et optionnellement une addiction aux meuporgs et une connaissance encyclopédique de tous les personnages secondaires de Star Wars ou du Seigneur des anneaux."
                                            },
                                            {
                                                "example_id": "3ceed810-3306-4b41-9f0c-3df828fc45e0",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Aux États-Unis, au Canada ou en Allemagne, où de tels travaux ont été menés, l’ addiction au sucre toucherait 5 à 10 % des gens."
                                            },
                                            {
                                                "example_id": "21ebe1fa-c54b-4962-a2bc-bc5144e4ebae",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Je regardais la télévision, en particulier le Tour de France, pour lequel je devais développer une addiction durable."
                                            },
                                            {
                                                "example_id": "c499d2df-7f1a-4c26-b28f-26978bfcce06",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Les détenteurs de robots cuiseurs multifonction forment une drôle de tribu enjouée, bavarde et prosélyte dont les membres se reconnaissent à leurs propos extatiques : « Ça change la vie, honnêtement, je ne m’en passerais plus. » De cette addiction électroménagère, le marché français témoigne, année après année."
                                            },
                                            {
                                                "example_id": "ea049cca-681a-4348-93f3-a82a7cd34676",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Mettant à profit des techniques de captation de l'attention qui s'inspirent du behaviorisme (la souris de Skinner) et de la théorie des jeux, des entreprises comme Google, Facebook ou Amazon ont transformé la simple habitude en addiction (« dépendance à la dopamine », un neurotransmetteur)."
                                            },
                                            {
                                                "example_id": "f11ad27d-0a6c-4c20-a3c3-c7b63dbfc408",
                                                "sense_id": "1afafee2-2f3d-35ae-a259-c26015a21704",
                                                "text": "Nos poursuites contre TikTok concernant le risque d' addiction de la plateforme se poursuivent, y compris l'enquête visant à déterminer si le lancement de TikTok Lite a été effectué conformément à la DSA."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "addiction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43c33234-5913-3609-93ec-bfc6a2a88912",
                                        "entry_id": "fc4a4868-c550-32cb-9ce3-c2d69a7ce2d7",
                                        "glosses": [
                                            "Adjudication."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2346c9af-2125-4da6-bbc3-bc20f12fd514",
                                                "sense_id": "43c33234-5913-3609-93ec-bfc6a2a88912",
                                                "text": "[…] avoir été battu de verges, était livré en addiction (addictus) à celui qu’il avait volé."
                                            },
                                            {
                                                "example_id": "22c3f800-f1a8-45d8-8578-b10e6bd8a295",
                                                "sense_id": "43c33234-5913-3609-93ec-bfc6a2a88912",
                                                "text": "Il est évident que, pour que l’addiction soit admissible et remplisse son double but, il faut deux conditions : nᵒ 1 que des libertés aient été laissées par le défunt, soit par testament, soit par codicilles ; nᵒ 2 que sa succession se trouve en déshérence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
