                        "sense_id": "92a13599-fe5f-3843-9f90-740f36e54f97",
                        "entry_id": "533dd434-3df9-33a1-adb2-680d34202c8b",
                        "glosses": [
                            "Disposition des feuilles autour de la tige."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d04a4382-a305-3359-8fdc-222efd824fc5",
                        "entry_id": "533dd434-3df9-33a1-adb2-680d34202c8b",
                        "glosses": [
                            "Moment où les bourgeons commencent à développer leurs feuilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e279bd74-f123-4c71-ab05-c63322f9dfe1",
                                "sense_id": "d04a4382-a305-3359-8fdc-222efd824fc5",
                                "text": "L’activité photosynthétique des arbres présente alors un minimum ou même un arrêt total en hiver, suivi d'une augmentation rapide au printemps au moment de la foliation."
                            }
                        ]
                    },
                    {
                        "sense_id": "713528d0-da9a-35ac-a155-09d9f1c6d678",
                        "entry_id": "533dd434-3df9-33a1-adb2-680d34202c8b",
                        "glosses": [
                            "Ségrégation des minéraux d'une roche en couches successives sous l'effet d'une pression ou d'une forte température."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7f6fe7-874d-4c22-b1f3-a0678808b6d7",
                                "sense_id": "713528d0-da9a-35ac-a155-09d9f1c6d678",
                                "text": "Pour la serpentinite, le résultat est étonnant. Regardée par la tranche (parallèlement à la foliation pour un géologue), la serpentinite a les mêmes propriétés que le manteau terrestre et sera invisible."
                            }
                        ]
                    }
