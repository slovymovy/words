                        "entry_id": "7a638f71-29f3-34e1-8225-edad2f8dcbb1",
                        "glosses": [
                            "Angehöriger der gleichnamigen Dynastie in Zentral- und Südasien"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3db39d44-e4d6-4b2e-adab-309ccce28db6",
                                "sense_id": "669a73ce-f890-33d0-bad5-13ec023ea851",
                                "text": "„Erst sein fähiger Heerführer, der Sklave Qutbuddin Aibak, der bei Mohammads Tod den Ghoriden die Gefolgschaft aufsagte, entschied sich für Indien und errichtete 1206 das Sultanat von Delhi, um die Unabhängigkeit von seinen einstigen Herren zu erringen.“"
                            },
                            {
                                "example_id": "5ff8b72b-0d37-4e8d-8c65-5abba44b178c",
                                "sense_id": "669a73ce-f890-33d0-bad5-13ec023ea851",
                                "text": "„Den endgültigen Niedergang der Ghaznawiden besiegelten die Ghoriden, benannt nach einer gebirgigen Region östlich Herats.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
