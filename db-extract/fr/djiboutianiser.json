                "senses": [
                    {
                        "sense_id": "98c59805-929f-3bc0-badb-977496cf412d",
                        "entry_id": "4e878630-6754-3565-b49e-016c1631558d",
                        "glosses": [
                            "Donner un caractère djiboutien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29b2bbc-a39f-4455-8cd0-f11596a68545",
                                "sense_id": "98c59805-929f-3bc0-badb-977496cf412d",
                                "text": "A l’époque, comme l’idée était de \"djiboutianiser\" l’enseignement, il suffisait d’avoir une maîtrise pour rentrer à Djibouti et travailler."
                            },
                            {
                                "example_id": "2114f626-38de-4633-97bf-35bd81b19dc1",
                                "sense_id": "98c59805-929f-3bc0-badb-977496cf412d",
                                "text": "Combien de temps croit pouvoir tenir un régime qui préfère massivement djiboutianiser des étrangers et au compte-gouttes naturaliser des nationaux ?"
                            },
                            {
                                "example_id": "22903a2d-10c3-41fb-8a28-3001d055af53",
                                "sense_id": "98c59805-929f-3bc0-badb-977496cf412d",
                                "text": "Ce n’est pas avec un bout de papier, dont il a l’habitude de « djiboutianiser » certains et de « dédjiboutianiser » d’autres, qu’il sèmera la terreur à Djibouti."
                            }
                        ]
                    }
                ],
