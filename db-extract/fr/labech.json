                        "sense_id": "eaf93995-9920-3860-ab3c-4cff9f5b6305",
                        "entry_id": "12a03df0-c096-3380-b4da-2df41f2c2125",
                        "glosses": [
                            "Vent de sud-ouest, dans les villes voisines de la Méditerranée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a482c86-9f20-4d9a-95f2-fbed8349b67c",
                                "sense_id": "eaf93995-9920-3860-ab3c-4cff9f5b6305",
                                "text": "Le labech est opposé au grégou ou nord-est."
                            },
                            {
                                "example_id": "1997a8b8-907f-432d-a50d-f46c2b52a4ce",
                                "sense_id": "eaf93995-9920-3860-ab3c-4cff9f5b6305",
                                "text": "Le labech soufflait avec violence, mais les nuages, emportés par ce vent furieux, avaient laissé le ciel pur et resplendissant d’étoiles."
                            },
                            {
                                "example_id": "f293a264-834a-4031-9d2e-6d0fe439aa8a",
                                "sense_id": "eaf93995-9920-3860-ab3c-4cff9f5b6305",
                                "text": "Le vent se tourna en lebeche, qui est entre le midi et le ponant."
                            }
                        ]
                    }
                ],
