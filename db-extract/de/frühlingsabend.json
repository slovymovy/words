                "senses": [
                    {
                        "sense_id": "c5f418f9-6eb1-3d88-970a-42e866fb5a95",
                        "entry_id": "a54552bc-e9ba-35c0-a1cd-656f27b10b5a",
                        "glosses": [
                            "Abend im Frühling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd8b158-feac-4138-a2c2-a234486bfcbf",
                                "sense_id": "c5f418f9-6eb1-3d88-970a-42e866fb5a95",
                                "text": "An diesem Frühlingsabend lag ein Spanngurt mitten auf der Autobahn."
                            },
                            {
                                "example_id": "a450d9c0-a730-45ab-814a-4f6a06906eba",
                                "sense_id": "c5f418f9-6eb1-3d88-970a-42e866fb5a95",
                                "text": "„An diesem Frühlingsabend, nachdem er tagsüber für alle Fälle noch etwas Mais in die wunde Scholle gesät, saß McDaffy breit vor dem hellen Kaminfeuer und schnitzte verdrießlich an einem neuen Schafte zur Axt, während Betty, mit ihrer Last unterm Herzen, stillgeschäftig ab und zu ging, den einfachen Imbiß zu bereiten und aufzutragen.“"
                            },
                            {
                                "example_id": "f67e833c-95a6-462a-9e5c-d8a24416ee80",
                                "sense_id": "c5f418f9-6eb1-3d88-970a-42e866fb5a95",
                                "text": "„Ich ging weiter die Straße hinauf, besah mir die Schaufenster und erfreute mich an dem Frühlingsabend und den Menschen, die mir entgegenkamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
