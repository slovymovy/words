                ],
                "senses": [
                    {
                        "sense_id": "b0fa9fd6-cabb-3302-896b-3f42589d3a77",
                        "entry_id": "e214426f-1923-3b24-a0ae-a9c13b709785",
                        "glosses": [
                            "einen kurzen Lauf habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1dddfb-f3f8-45c2-b767-c926d351d5e7",
                                "sense_id": "b0fa9fd6-cabb-3302-896b-3f42589d3a77",
                                "text": "„Aus seinem Hosenbund zog er einen kurzläufigen Revolver und feuerte einen einzelnen Schuss in das perplexe Gesicht des Professors ab.“"
                            },
                            {
                                "example_id": "48c6b12a-94b7-46b4-a39e-9626abaf36a7",
                                "sense_id": "b0fa9fd6-cabb-3302-896b-3f42589d3a77",
                                "text": "„Plötzlich hebt Garvey den kurzläufigen Revolver und hält ihn dem Mann vors Gesicht.“"
                            },
                            {
                                "example_id": "5346f429-7d28-4bf4-8a68-78f98d76f37f",
                                "sense_id": "b0fa9fd6-cabb-3302-896b-3f42589d3a77",
                                "text": "„Er zählte insgesamt acht Wachen um die große Villa, teils auf einer umlaufenden Veranda im Obergeschoss, teils im Garten, dazu zwei weitere am Wachhäuschen beim Einfahrtstor, und alle bewaffnet mit kurzläufigen Maschinenpistolen.“"
                            },
                            {
                                "example_id": "61c24fcb-83ba-4910-916b-9d1581a3cc9f",
