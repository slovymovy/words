                        ],
                        "examples": [
                            {
                                "example_id": "2ccd86c0-1ad5-4cec-ae03-ff7411f015f0",
                                "sense_id": "1a9028f6-aca6-3904-937f-fb7a070d42eb",
                                "text": "He did not perceive that regal power, in a few generations, introduces idiotism into the noble stem […]"
                            },
                            {
                                "example_id": "d0e372d5-d3de-4cc7-ad39-3c6ae747b236",
                                "sense_id": "1a9028f6-aca6-3904-937f-fb7a070d42eb",
                                "text": "Idiotism had long been accepted as hopeless: ‘Absolute idiocy admits of no cure,’ noted the nineteenth-century psychiatrist George Man Burrows (1771–1846)."
                            }
                        ]
                    },
                    {
                        "sense_id": "53b7eebc-d3ca-3ad4-93d5-a5b90f4f76ba",
                        "entry_id": "e05e0d76-44e6-30d2-a54c-47160aea7ad8",
                        "glosses": [
                            "A foolish utterance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6cda842-4f43-41fe-a16e-cb8433319338",
                                "sense_id": "53b7eebc-d3ca-3ad4-93d5-a5b90f4f76ba",
                                "text": "[…] that clear soprano, in nursery, rings out a shower of innocent idiotisms over the half-stripped baby, and suspends the bawl upon its lips."
                            }
                        ]
                    }
