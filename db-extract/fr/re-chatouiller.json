                "senses": [
                    {
                        "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                        "entry_id": "29b8b804-0f77-3a90-893a-b957ce5a3b56",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de rechatouiller (chatouiller à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b70ee3e-2838-41d7-a0fb-d7a3feeb0890",
                                "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                                "text": "Elle re-chatouille le grain de beauté."
                            },
                            {
                                "example_id": "1c337efe-7f5a-4ad3-b0af-574b90e7bc9f",
                                "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                                "text": "Le rayon cessa de la chatouiller, puis il la re-chatouilla, une feuille qui se balançait sans doute."
                            },
                            {
                                "example_id": "ccd04747-dd36-40f3-92ac-a8b1e8f509ba",
                                "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                                "text": "Les doigts me re-chatouillent et je repars vers d'autres horizons..."
                            },
                            {
                                "example_id": "381d56cf-f2ef-4437-91e6-1a4f4adf41b2",
                                "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                                "text": "Vu que ça me re-chatouillait beaucoup depuis un moment, il fallait bien faire quelque chose !!!"
                            },
                            {
                                "example_id": "7f6b47fb-d053-41fa-bb6c-ca4fafbca07b",
                                "sense_id": "b6ed1238-9f48-325d-968d-f599ccf13415",
                                "text": "Il m'a re-chatouillée à la récré pendant quelques secondes."
                            }
                        ]
                    }
