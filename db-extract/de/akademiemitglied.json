                "senses": [
                    {
                        "sense_id": "a576bf23-bcc2-37a8-ba5e-6c59bb67eee7",
                        "entry_id": "48a0702c-b896-3e13-b1b7-8605aad94c80",
                        "glosses": [
                            "Mitglied einer Akademie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f308ed9a-d03d-426b-a63f-6438f80d5fe9",
                                "sense_id": "a576bf23-bcc2-37a8-ba5e-6c59bb67eee7",
                                "text": "„Zu den vornehmsten Rechten ordentlicher Akademiemitglieder gehörte die Möglichkeit, Wahlvorschläge für neue Akademiemitglieder zu machen, die einer von vier Kategorien angehörten: Korrespondierende (KM), ordentliche (OM), auswärtige (AW) und Ehrenmitglieder(EM).“"
                            },
                            {
                                "example_id": "cf5b4ed4-f2fe-4a5c-9d0f-7755be37eed9",
                                "sense_id": "a576bf23-bcc2-37a8-ba5e-6c59bb67eee7",
                                "text": "„Zum Versammlungsleiter wählt man den Lyriker und Prosaautor Rudolf G. Binding, Akademiemitglied seit 1932, Dichter mit großer Leserschaft und eigenwilliger Interpunktion (Kommata liebt er nicht und lässt sie meistens weg).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
