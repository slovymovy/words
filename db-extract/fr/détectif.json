                "senses": [
                    {
                        "sense_id": "df4604e3-efd2-39a9-9f9f-95700faf3de3",
                        "entry_id": "520aaaa6-7682-306a-89a9-6a29e6671721",
                        "glosses": [
                            "Relatif à la détection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affbfe67-be91-4c8a-a429-9379f76d7f9c",
                                "sense_id": "df4604e3-efd2-39a9-9f9f-95700faf3de3",
                                "text": "Aucun écho de la conspiration n’arrivait jusqu’à la demeure de Paul Labre, et pourtant, l’instinct détectif était si étrangement développé chez notre gamin qu’au premier indice rencontré sur sa route, il flaira la piste."
                            },
                            {
                                "example_id": "fe4e3c9b-385d-4b9d-8014-998aeb48c6fb",
                                "sense_id": "df4604e3-efd2-39a9-9f9f-95700faf3de3",
                                "text": "De tels instrumens du système détectif figurent ensuite à titre de témoins dans le procès en vue duquel on a retenu leur ministère secret."
                            }
                        ]
                    }
                ],
                "translations": [
