                ],
                "senses": [
                    {
                        "sense_id": "8f64331a-77d8-338a-800b-dc56ac05bdc0",
                        "entry_id": "4f2d3d64-3de5-3b0a-86e3-53772cc2b0f9",
                        "glosses": [
                            "Faire passer du dollar au peso (en Argentine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24431357-6df5-4b8e-a73d-3be4c345b225",
                                "sense_id": "8f64331a-77d8-338a-800b-dc56ac05bdc0",
                                "text": "Le système, conçu pour « pesifier » l'économie par la convertibilité totale, remplit son rôle."
                            },
                            {
                                "example_id": "2eeea217-d390-43cd-94fd-064a6e6ebf06",
                                "sense_id": "8f64331a-77d8-338a-800b-dc56ac05bdc0",
                                "text": "Mais \"pesifier\" l'économie, largement dollarisée dans certains secteurs comme l'immobilier, pourrait avoir l'effet inverse à celui recherché."
                            },
                            {
                                "example_id": "dca77eb1-70e0-46d0-a2cc-94d45b20b877",
                                "sense_id": "8f64331a-77d8-338a-800b-dc56ac05bdc0",
                                "text": "Nous allons «pesifier» toute l'économie , a déclaré dimanche soir le ministre Lenicov."
                            }
                        ]
                    }
                ],
