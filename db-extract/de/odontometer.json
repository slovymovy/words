                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b018b063-9246-3e61-b6c8-cd16e7ac2735",
                                        "entry_id": "b0741b29-4f87-3712-abe8-ddef0a2d78e0",
                                        "glosses": [
                                            "A perforation gauge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d26c51a-6f04-40eb-8ad6-7c8987a7dde9",
                                                "sense_id": "b018b063-9246-3e61-b6c8-cd16e7ac2735",
                                                "text": "The idea of an odontometer is due to Dr. Magnus—the very word, signifying literally a tooth-measurer, was laid down by him; and in Le Timbre-Poste, five years ago, the first odontometer was published by him in illustration of an article on perforations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a7516b-81b5-3dbc-bde8-382bc075060b",
                                        "entry_id": "b0741b29-4f87-3712-abe8-ddef0a2d78e0",
                                        "glosses": [
                                            "A device for measuring teeth, used in orthodontia and for creating crowns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cc62092-5da1-4876-94fa-545ac5295f8a",
                        "source_entry_id": "8a5ce813-da89-3476-845b-baf41900b4df",
                        "source_sense_id": "81e480bd-af34-300e-9bff-e4e8ccd2c61c",
                        "source_sense_description": "Philatelie, veraltet: Hilfsmittel zur Bestimmung der Zähnung einer Briefmarke",
                        "target_lang_word": "perforation gauge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perforation gauge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0adaf628-751f-3164-bd56-80335946a6a5",
                                        "entry_id": "2cc80b1e-0040-37d9-a286-06b830863952",
                                        "glosses": [
                                            "A device for measuring the number of perforations per 2 centimetre distance along the edge of a postage stamp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab59bd2-a727-4fc5-a7e8-0abd4d6ea6cb",
                                                "sense_id": "0adaf628-751f-3164-bd56-80335946a6a5",
                                                "text": "The perforation-gauge is surrounded by a neat border, and inscription indicating the price — one shilling — and the publisher's address."
                                            },
                                            {
                                                "example_id": "f6d97cf9-b659-493c-91c4-9c8ceb0d075f",
                                                "sense_id": "0adaf628-751f-3164-bd56-80335946a6a5",
                                                "text": "We desperately need starter materials such as stamps, albums, perforation gauges, hinges or mounts, and magnifying glasses — any materials that a novice collector requires to get started."
                                            },
                                            {
                                                "example_id": "5378bcb3-70c1-4797-ab3c-114c49e8b0a4",
                                                "sense_id": "0adaf628-751f-3164-bd56-80335946a6a5",
                                                "text": "It is far easier to use a perforation gauge which for a few dollars can be found on eBay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
