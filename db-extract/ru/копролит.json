                "senses": [
                    {
                        "sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "glosses": [
                            "палеонт. окаменелые остатки экскрементов позвоночных животных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e8bb2a-3e42-436d-bb5a-067bc55dcaea",
                                "sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                                "text": "Копролиты показали, что поначалу с пищей люди заглатывали много пыльцы древесных пород, которая постепенно исчезла."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4aa49f9d-e9ca-4d28-bd61-f4071061e0bb",
                        "source_entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "source_sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "target_lang_word": "coprolite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coprolite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae4a8033-68d0-36bf-bf32-a1f21a0b579a",
                                        "entry_id": "79e17be0-ef76-35af-86ed-c52d807aaed8",
                                        "glosses": [
                                            "A fossil consisting of petrified dung."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341af519-3ceb-41bf-9d8f-a86a589998ed",
                                                "sense_id": "ae4a8033-68d0-36bf-bf32-a1f21a0b579a",
                                                "text": "This coprolite (the technical term for palaeo-poo) has yielded much to modern scrutiny. First, it is completely devoid of plant matter, including the corn and other plants that the Anasazi Pueblo people of the region lived on."
                                            },
                                            {
                                                "example_id": "cfea16da-9115-4bb3-ae2a-4dd012fbf9ea",
                                                "sense_id": "ae4a8033-68d0-36bf-bf32-a1f21a0b579a",
                                                "text": "Almost inevitably, he became the leading authority on coprolites – fossilized faeces – and had a table made entirely out of his collection of specimens."
                                            },
                                            {
                                                "example_id": "693c44cd-2611-41d4-85c2-7e92597a4e75",
                                                "sense_id": "ae4a8033-68d0-36bf-bf32-a1f21a0b579a",
                                                "text": "Analyses of the DNA fragments preserved in the moa and kakapo coprolites showed that moa and kakapo fed on fungi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8e00df7-d82b-4dc2-8090-d6f40f6a8f2c",
                        "source_entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "source_sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "target_lang_word": "coprolito",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coprolito",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "508f26cd-ce12-3d9c-92c1-34104338169b",
                                        "entry_id": "d2131c08-dfd5-3709-9277-d8f8111c80f5",
                                        "glosses": [
                                            "Excremento fosilizado de algún animal (o del ser humano) que suele presentarse en forma de concreción fosfatada. Se han encontrado coprolitos desde el periodo Ordovícico; siendo su tamaño y forma extremadamente variado: desde el calibre microscópico de los invertebrados (menos de cinco milímetros), hasta otros de siete kilogramos de Tyrannosaurus rex."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14e1db58-8fe5-40ac-8e87-5903a78ac1a8",
                        "source_entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "source_sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "target_lang_word": "coprolite",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3278fc04-ec38-4bf4-a785-cec1ed33a94c",
                        "source_entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "source_sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "target_lang_word": "Koprolith",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koprolith",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39d9af81-2bbc-3ce9-afd2-4e6c00eeefc2",
                                        "entry_id": "1859b978-ff72-3fa7-a4d3-176d491a4e66",
                                        "glosses": [
                                            "mineralisiertes, fossiles (versteinertes) Exkrement"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee3d8bfc-5971-42ce-b3fa-b47891b7e3c1",
                                                "sense_id": "39d9af81-2bbc-3ce9-afd2-4e6c00eeefc2",
                                                "text": "„Die in Westphalen gefundenen Koprolithen sprechen ebenfalls für den Aufenthalt der Thiere in den Höhlen.“"
                                            },
                                            {
                                                "example_id": "29ee2f36-a3a1-4d4a-9862-78e6914bf8fa",
                                                "sense_id": "39d9af81-2bbc-3ce9-afd2-4e6c00eeefc2",
                                                "text": "„Der schwarze Ueberzug der Koprolithen besteht aus Mangan und Eisen, welche Metalle auch die häufigen Dendriten auf den Knochen bilden.“"
                                            },
                                            {
                                                "example_id": "91c0ccbb-ff24-4ba6-b965-f2c182a9b68e",
                                                "sense_id": "39d9af81-2bbc-3ce9-afd2-4e6c00eeefc2",
                                                "text": "„Bouvard sprach von Koprolithen, die versteinerte Exkremente von Tieren seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33ab6303-180e-3e68-abeb-ff4528bcd396",
                                        "entry_id": "1859b978-ff72-3fa7-a4d3-176d491a4e66",
                                        "glosses": [
                                            "steinartige Ansammlung aus verhärtetem Kot, Phosphaten und Schleim im Blinddarm oder Dickdarm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66aa545-9ede-4f19-9f1b-bedc66e81484",
                                                "sense_id": "33ab6303-180e-3e68-abeb-ff4528bcd396",
                                                "text": "Koprolithe können akute Appendizitis verursachen."
                                            },
                                            {
                                                "example_id": "40e7efdd-423e-42e0-8bbe-bc6c3823af90",
                                                "sense_id": "33ab6303-180e-3e68-abeb-ff4528bcd396",
                                                "text": "„Ursachen sind hyperplastische Lymphfollikel (bei Kindern und Jugendlichen), Verlegung durch Kotsteine (Koprolith), Lageanomalien, Narbenstenosen oder Tumore.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8855d191-725c-4cfc-b1eb-96b7899b5449",
                        "source_entry_id": "b3966af0-ac19-34a4-a935-06075a3bf45e",
                        "source_sense_id": "1862e23e-ecc4-353e-9ea3-6f7ab093ce7a",
                        "target_lang_word": "coproliet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coproliet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aa125825-0a01-3c5e-8bcb-201305422c9f",
                                        "entry_id": "9302b5b0-d3c5-3f3e-adc6-116f091417e2",
                                        "glosses": [
                                            "versteende uitwerpselen van een dier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a3189b-2f43-4568-9b2f-07520656b41b",
                                                "sense_id": "aa125825-0a01-3c5e-8bcb-201305422c9f",
                                                "text": "Epp en haar collega’s onderzochten de coprolieten en vonden daarin het DNA van zowel hyena’s als van wolharige neushoorns. Zeer waarschijnlijk hadden de hyena’s wolharige neushoorns gegeten, waardoor het neushoorn-DNA in de drol belandde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
