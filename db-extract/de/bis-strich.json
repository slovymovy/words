                "senses": [
                    {
                        "sense_id": "8b10e423-7ad6-3b29-8c4e-f2a47e2edc77",
                        "entry_id": "92201cd1-6500-3bea-b7de-89f40979a21e",
                        "glosses": [
                            "Name des Zeichens ‚–‘ (typographisch ein Halbgeviertstrich) in der Bedeutung ‚(von) bis‘, also wenn es zwischen zwei Elementen einer Reihe steht und diese so als Endpunkte einer Spanne kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eeb9075-abd6-4d85-85a5-93932a2ce478",
                                "sense_id": "8b10e423-7ad6-3b29-8c4e-f2a47e2edc77",
                                "text": "„[Die Bandaufführung] besteht im allgemeinen aus der Bandangabe und dem Erscheinungsjahr des ersten und – durch Bis-Strich angeschlossenen – der Bandangabe und dem Erscheinungsjahr des letzten Bandes […]“"
                            },
                            {
                                "example_id": "8ecf8dd2-c09b-4e32-8981-7f9a76b08674",
                                "sense_id": "8b10e423-7ad6-3b29-8c4e-f2a47e2edc77",
                                "text": "„Abweichend von den bisherigen Regeln besteht [die DIN 5008] bei Wertangaben auf ein Leerzeichen zwischen dem Bis-Strich und den jeweiligen Werten.“"
                            },
                            {
                                "example_id": "152c8bfe-9629-422c-8707-fdfe5d7bead3",
                                "sense_id": "8b10e423-7ad6-3b29-8c4e-f2a47e2edc77",
                                "text": "„Neben verschiedenen Intervallangaben bezüglich Geldsummen […] bilden die Notationen von Uhrzeit-Intervallen […] die größte Teilgruppe des digitalen Bis-Strichs […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
