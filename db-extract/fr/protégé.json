                "senses": [
                    {
                        "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                        "entry_id": "920d87c7-7b56-3ad3-a566-dd68aeb89c80",
                        "glosses": [
                            "Personne qui bénéficie d’une protection de la part de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d990fa2-c277-4e40-bec3-50f5f27fd7cc",
                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                "text": "Le protégé ne peut se passer de la compétence du protecteur, de sa force et de sa vigilance."
                            },
                            {
                                "example_id": "86337f49-7425-46cb-8344-5875db1e6010",
                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                "text": "C’est sa protégée."
                            },
                            {
                                "example_id": "057eb6e1-3d25-4fca-8cd3-04d3c5e4a1e5",
                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                "text": "Cet homme est un des protégés du ministre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94ab1b5f-f756-453b-a6db-de6c8db60cb8",
                        "source_entry_id": "920d87c7-7b56-3ad3-a566-dd68aeb89c80",
                        "source_sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                        "target_lang_word": "protégé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protégé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                        "entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                                        "glosses": [
                                            "A person who is guided and supported by an older and more experienced person (a protector or mentor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2261276f-497c-48d1-8abb-fc5e721e35d3",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "His status as a protégé of the great artist had many benefits, but was ultimately a burden."
                                            },
                                            {
                                                "example_id": "2a742b8f-cd12-4edd-8915-f63c2388c0c1",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "While Yau was in China, he visited Xi-Ping Zhu, a protégé of his who was now chairman of the mathematics department at Sun Yat-sen University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ab42871-657f-4fb0-8cea-8eadc08e59cc",
                        "source_entry_id": "920d87c7-7b56-3ad3-a566-dd68aeb89c80",
                        "source_sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
