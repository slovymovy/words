                    },
                    {
                        "translation_id": "efdb2d80-02c8-4552-9e69-8081fb8721ba",
                        "source_entry_id": "01ad163a-b79c-3d6f-96f1-07c4c1999f47",
                        "source_sense_id": "aba36cd3-dd02-3833-a777-5fe9893dd28e",
                        "target_lang_word": "oolong",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oolong",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0f80e1-bde5-3766-b773-e22a90b57b06",
                                        "entry_id": "f8498df5-6608-32fc-91fa-e11a0cafc3fa",
                                        "glosses": [
                                            "Thé à oxydation incomplète appelé aussi thé bleu-vert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208d588e-b9c1-4d6f-adc7-ad62114dbc6b",
                                                "sense_id": "8a0f80e1-bde5-3766-b773-e22a90b57b06",
                                                "text": "Il s’agit là d’un oolong de Taiwan qui a été soumis à une forte oxydation."
                                            },
                                            {
                                                "example_id": "4a0558b1-fa3e-43a4-aa8d-3a1375b2cba6",
                                                "sense_id": "8a0f80e1-bde5-3766-b773-e22a90b57b06",
                                                "text": "Elles peuvent aussi contenir du ba bao du dragon de Palais des thés, composé d’une base de thé au jasmin et de oolong (« dragon noir ») auxquels sont ajoutés la pomme, le raisin, l’orange, les baies de goji, le ginseng et la rose."
                                            },
                                            {
                                                "example_id": "c7b12eff-784f-4639-bc61-c5685c6f3796",
                                                "sense_id": "8a0f80e1-bde5-3766-b773-e22a90b57b06",
                                                "text": "Aussi appelés thés bleus, les oolong sont des thés semi-oxydés, faibles en théine, qui peuvent être dégustés toute la journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
