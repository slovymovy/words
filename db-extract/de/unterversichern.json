                        "sense_id": "dd14baa4-8323-3d6b-9155-01239d7fa8ea",
                        "entry_id": "24f5f329-5a3f-3fe8-9ed9-c1f905792641",
                        "glosses": [
                            "eine Versicherung abschließen, die sich auf einen niedrigeren als den wahren Wert bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8cc176-eb37-4f7b-aabb-207575f3d3f7",
                                "sense_id": "dd14baa4-8323-3d6b-9155-01239d7fa8ea",
                                "text": "„Ich rede von der Schiffsladung, die der Depp unterversichert hat, um Geld zu sparen.“"
                            },
                            {
                                "example_id": "355bfbc8-2e8e-45ed-b111-52162551eda9",
                                "sense_id": "dd14baa4-8323-3d6b-9155-01239d7fa8ea",
                                "text": "„Alles schien in gemächlichem Fortgange, wenn auch nicht gerade dynamischem Fortschritt begriffen, als Ende 1908 ein Brand die Tribüne vollständig zerstörte. Es stellte sich heraus, daß der sparsame Verein sie unterversichert hatte.“"
                            },
                            {
                                "example_id": "be18457e-1948-4c18-b526-bab58f41e1e9",
                                "sense_id": "dd14baa4-8323-3d6b-9155-01239d7fa8ea",
                                "text": "Es ist riskant, sein Eigentum unterzuversichern."
                            },
                            {
                                "example_id": "2ad6b8a7-09aa-48cf-ae2c-7a0ff889f339",
                                "sense_id": "dd14baa4-8323-3d6b-9155-01239d7fa8ea",
                                "text": "Unterversicherung bezieht er sich auf den Wert einer versicherten Sache. Ist dieser höher, als die Versicherungssumme, so ist der Versicherungsnehmer unterversichert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
