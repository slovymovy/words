                "senses": [
                    {
                        "sense_id": "24baa781-a39b-3811-86eb-83f74d3ff73c",
                        "entry_id": "997999ce-c9e2-394f-bab0-6a0f22ae8429",
                        "glosses": [
                            "tiefe, enge Schlucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4702c819-2464-412c-b12a-b8644da784dd",
                                "sense_id": "24baa781-a39b-3811-86eb-83f74d3ff73c",
                                "text": "„Als ich den Canyon erreiche, weiß ich, was sie im Dorf mit »nass« meinten.“"
                            },
                            {
                                "example_id": "8efc107c-d97f-4764-9311-8587de0ed54d",
                                "sense_id": "24baa781-a39b-3811-86eb-83f74d3ff73c",
                                "text": "„Die Schiffe fahren zwischen palmenbewachsenen Inseln hindurch, durch Schluchten und Canyons, vorbei am monotonen Tosen von Wasserfällen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82b6a4d5-d410-4ce1-aec0-9039eadd72c7",
                        "source_entry_id": "997999ce-c9e2-394f-bab0-6a0f22ae8429",
                        "source_sense_id": "24baa781-a39b-3811-86eb-83f74d3ff73c",
                        "source_sense_description": "tiefe, enge Schlucht",
                        "target_lang_word": "canyon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canyon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c32dcc-e87a-392a-abd2-09c10364bfcd",
                                        "entry_id": "bce3a1b9-4ebd-3433-a4da-f8e95d5ea920",
                                        "glosses": [
                                            "A valley, especially a long, narrow, steep valley, cut in rock by a river."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fea24f1-bd57-41e2-bf97-34f545dcc8b7",
                                                "sense_id": "e3c32dcc-e87a-392a-abd2-09c10364bfcd",
                                                "text": "After we have crossed the Glenderamackin stream, which drains the northern slopes of Saddleback, and the latter has united with the St. John's Beck to form the Greta, however, we see ahead the miniature canyon the Greta has hollowed out for itself, and into the depth of which the train now descends."
                                            },
                                            {
                                                "example_id": "d421a102-b83f-4b48-9345-32f56a2e4afd",
                                                "sense_id": "e3c32dcc-e87a-392a-abd2-09c10364bfcd",
                                                "text": "Snow filled her mouth. She caromed off things she never saw, tumbling through a cluttered canyon like a steel marble falling through pins in a pachinko machine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canyon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae681342-61f0-33ed-b207-ab8017fba09c",
                                        "entry_id": "c21cf120-1b28-359b-9f4d-3233b309b4f0",
                                        "glosses": [
                                            "Of water, liquid, or another substance, to flow in or into a canyon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7809f401-8676-4606-942d-b8647fb4c100",
                        "source_entry_id": "997999ce-c9e2-394f-bab0-6a0f22ae8429",
                        "source_sense_id": "24baa781-a39b-3811-86eb-83f74d3ff73c",
