                    "frequency": "Middle",
                    "semantic_group_id": "missing_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot was listed as <w>MIA</w> after his plane disappeared from radar.",
                            "target_lang_translations": {
