                "translations": [
                    {
                        "translation_id": "68443fca-c6ae-462d-afd1-6ac12ca6723d",
                        "source_entry_id": "517d4950-5fa4-354e-a40c-1951043769df",
                        "source_sense_description": "process of transferring heat from an object in order to cool it",
                        "target_lang_word": "réfrigération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfrigération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "112d2292-7d51-3314-bde4-e94a5d5c205e",
                                        "entry_id": "ced5030a-07d7-3b4e-a35e-9238a4ac9f76",
                                        "glosses": [
                                            "Procédé permettant d'obtenir (refroidir) et de maintenir un système (local, produit, etc.) à une température inférieure à celle de l'environnement."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b97238-f5d9-4533-800b-a23739cebbda",
                                                "sense_id": "112d2292-7d51-3314-bde4-e94a5d5c205e",
                                                "text": "La distillation se fait par exhalation et réfrigération."
                                            },
                                            {
                                                "example_id": "4c7f7bde-4b84-4c9b-86fe-a22d3b0eadd5",
                                                "sense_id": "112d2292-7d51-3314-bde4-e94a5d5c205e",
                                                "text": "Notons que la réfrigération ne tue pas les microbes. Dans le réfrigérateur, entre 0 et 10°C, la plupart des microbes peuvent encore se multiplier. Au dessous de 0°, moisissures et levures se développent encore, ce qui entraîne des altérations. — (Meyer, C., Denis, J.-P. ed. sci., \"Elevage de la vache laitière en zone tropicale\", 314 p., pages 271-272, 1999, Montpellier, Cirad, Collection Techniques)"
                                            },
                                            {
                                                "example_id": "221085f9-0647-4e3b-8d11-f095281588e9",
                                                "sense_id": "112d2292-7d51-3314-bde4-e94a5d5c205e",
                                                "text": "À titre comparatif, le vaccin développé par Moderna nécessite une conservation à -20°C, tandis que celui d’AstraZeneca demande une simple réfrigération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b75cfd38-c4b1-429c-b68b-96768f0da5d9",
                        "source_entry_id": "517d4950-5fa4-354e-a40c-1951043769df",
                        "source_sense_description": "process of transferring heat from an object in order to cool it",
                        "target_lang_word": "Kühlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                        "entry_id": "40cb7d11-2715-3a28-8c67-70993d034da7",
                                        "glosses": [
                                            "Verringerung der Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69bed3c6-e441-4a75-8d34-fee2266b5687",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "Die Kühlung der Brennstäbe ist unbedingt notwendig."
                                            },
                                            {
                                                "example_id": "2a2cf21b-1e7f-4b7b-9f38-331b9b219a64",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            },
                                            {
                                                "example_id": "86b824b3-ab51-4bb4-be25-36554077a373",
                                                "sense_id": "71f70191-c195-30a4-a3e5-0719c0916fe4",
                                                "text": "„Das war der Platz, an dem Simen Tjing während der Sommermonate Kühlung zu suchen pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd878faa-3807-4d30-ad6e-73340c946acc",
