                                        "examples": [
                                            {
                                                "example_id": "fcf0bb1f-68a7-484f-9e8f-5e923b310546",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "This paper reports on ingestion of soil by dairy cows using titanium analysis of faeces by the X-ray fluorescence technique, and gives the range of soil intakes of a year on both an individual and a herd basis."
                                            },
                                            {
                                                "example_id": "25706708-96f6-4d03-9f7c-dec6f49982b0",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "The fact that dogs have a well developed sense of smell suggests that they might be able to use the odour of faeces as a means of communicating."
                                            },
                                            {
                                                "example_id": "7b68b0b3-be42-4f4e-845c-5ae39be351e6",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "Urine and faeces are complete fertilizers of high quality with low levels of contaminants such as heavy metals. Urine is rich in nitrogen, while faeces are rich in phosphorous, potassium and organic matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
