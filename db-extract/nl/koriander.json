                                "target_senses": [
                                    {
                                        "sense_id": "1bf6ddd1-4434-394b-ba16-7e39a21ee71f",
                                        "entry_id": "067100cd-eb01-355d-9b2b-6ccd5118c0bc",
                                        "glosses": [
                                            "Pflanzen der Gattung coriandrum (Koriander), besonders Echter Koriander (coriandrum sativum)"
                                        ],
                                        "tags": [
                                            "Doldengewächs"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185e0844-3d9a-44ca-ab24-21283098763f",
                                                "sense_id": "1bf6ddd1-4434-394b-ba16-7e39a21ee71f",
                                                "text": "Koriander ist ein einjähriges Kraut aus der Familie der Doldenblütler (Apiaceae)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                        "entry_id": "067100cd-eb01-355d-9b2b-6ccd5118c0bc",
                                        "glosses": [
                                            "getrocknete Samen, auch grüne Teile des Echten Korianders"
                                        ],
                                        "tags": [
                                            "Gewürz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09afa6a9-956c-4859-a1a9-fe54ec56ac17",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "Koriander wird besonders zu Weihnachten gern verwendet."
                                            },
                                            {
                                                "example_id": "3015f923-2d68-46dd-b87b-837e240db3b6",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "Koriander wird sehr oft mit Kreuzkümmel kombiniert."
                                            },
                                            {
                                                "example_id": "844cbe55-5865-48c2-a512-4770893cd156",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "„Fischfilets portionsweise auf das Gemüsebeet setzen, mit Zitronensaft beträufeln und mit Koriander, Salz und Pfeffer bestreuen.“"
                                            },
                                            {
                                                "example_id": "6879a6cd-c2a2-4d70-a495-1e2c02fc41f6",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "„Es wird [in Mexiko] gern und reichlich mit frischem Koriander und Limettensaft gewürzt, […]“"
                                            },
                                            {
                                                "example_id": "b895da03-045b-4f2f-870b-0320cd54d33f",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "„Ola legte eine Handvoll Koriander in die Küchenmaschine.“"
                                            },
                                            {
                                                "example_id": "468eff45-42f9-48e9-9b0e-bd268ee02428",
                                                "sense_id": "a149f2b5-cc94-3641-bfe6-a3190c564eb3",
                                                "text": "„Sie wollten Koriander zusetzen wie im Kümmel, Kirsch wie im Maraschino, Ysop wie in der Chartreuse, Bisam wie im Vespetro; Calamas aromaticus wie im Krambambuli; und mit Sandelholz sollte er eine rote Farbe bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62108ff3-4f1a-45a0-8fc8-d4717d86260d",
                        "source_entry_id": "45d6f1bd-9f11-3397-8552-e4df86a9ce79",
                        "source_sense_id": "fabf69f3-8075-37a3-9a91-0e426a51aad5",
