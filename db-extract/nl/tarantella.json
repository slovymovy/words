                            {
                                "example_id": "be807a39-3eb2-452a-b2b7-fa5c0672107b",
                                "sense_id": "de79762c-dfed-3e86-b4d6-48d6efb12cd8",
                                "text": "Frans hoefde niet terug naar Italië voor de opnamen van de clip. \"Nee, dat hebben we op een eigentijdse manier opgelost. Met hulp van een paar streetdancers is het hartstikke leuk geworden. Voor de kenners: het is een tarantella, een van de bekendste dansjes van Italië in 6/8 maat."
                            },
                            {
                                "example_id": "0a409b66-7f55-4099-9115-2de7202c27b9",
                                "sense_id": "de79762c-dfed-3e86-b4d6-48d6efb12cd8",
                                "text": "Ik ontdek constant nieuwe muziek. In 2010 kwam ik nog in aanraking met Tarantella, volksmuziek die veel wordt gespeeld in het zuiden van Italië, waarin de tamboerijn veel wordt gebruikt."
                            }
                        ]
                    }
