                        "examples": [
                            {
                                "example_id": "0455e1b1-fe9b-4403-bec8-8376218ad64d",
                                "sense_id": "9d24ef55-68ad-3e06-9264-8d94f60c42b3",
                                "text": "„Wir geben die Zügel unserer Kultur nicht gern aus der Hand. Um dann unsere Musik im Aufzug hören zu müssen. Die Balladen unserer Revolution, zu Hintergrundmusik der Fernsehwerbung geworden.“"
                            },
                            {
                                "example_id": "f52a3f9f-39b7-43bf-8cd8-916b6847dbe2",
                                "sense_id": "9d24ef55-68ad-3e06-9264-8d94f60c42b3",
                                "text": "„Durch die geschlossenen Zugangstüren drangen Stimmengewirr, Besteck- und Geschirrgeräusche sowie Hintergrundmusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
