                                                "sense_id": "d3116924-fdc1-3363-ba4c-8b3e9f31940f",
                                                "text": "an eruptive fever"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf590483-7b05-36ce-bb97-88ccc94e249a",
                                        "entry_id": "1d5ab3e9-b04e-3a8a-91ce-721c10f7a370",
                                        "glosses": [
                                            "Produced by eruption."
                                        ],
                                        "tags": [],
                                        "examples": [
