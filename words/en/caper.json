{
    "word_family": [
        "capering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9345bf9-39a2-35c2-9d70-4c6797716198",
                    "sense_definition": "The small pickled flower bud of a Mediterranean shrub, used as a seasoning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef added a spoonful of <w>capers</w> to the sauce for a salty kick.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni dodał łyżkę <w>kaparów</w> do sosu, aby nadać mu słonego charakteru."
                            }
                        },
                        {
                            "text": "Salmon is often served with a creamy sauce containing chopped <w>capers</w>.",
                            "target_lang_translations": {
                                "pl": "Łosoś jest często podawany z kremowym sosem zawierającym posiekane <w>kapary</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "caperberry"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mały, marynowany pąk kwiatowy krzewu śródziemnomorskiego, używany jako przyprawa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kapar",
                                "target_lang_sense_clarification": "pąk kwiatowy używany w kuchni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cafecbbe-8f1a-3287-98f9-fac7293d48a1",
                    "sense_definition": "A mischievous act or a lighthearted prank.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were involved in some harmless <w>capers</w> during the summer break.",
                            "target_lang_translations": {
                                "pl": "Dzieci brały udział w niewinnych <w>psotach</w> podczas wakacji."
                            }
                        },
                        {
                            "text": "He was always getting into trouble for his silly <w>capers</w> at school.",
                            "target_lang_translations": {
                                "pl": "Zawsze wpadał w kłopoty przez swoje głupie <w>figle</w> w szkole."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Psotne zachowanie lub niewinny żart."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "psota",
                                "target_lang_sense_clarification": "niewinny żart lub figiel"
                            },
                            {
                                "target_lang_word": "figiel",
                                "target_lang_sense_clarification": "żartobliwe zachowanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b192cd5-063a-3000-8e6b-5b7f8bf4988e",
                    "sense_definition": "An elaborate criminal activity, especially a heist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie tells the story of a daring bank <w>caper</w> gone wrong.",
                            "target_lang_translations": {
                                "pl": "Film opowiada historię zuchwałego <w>skoku</w> na bank, który nie poszedł zgodnie z planem."
                            }
                        },
                        {
                            "text": "They planned a complex jewel <w>caper</w> that required months of preparation.",
                            "target_lang_translations": {
                                "pl": "Zaplanowali skomplikowany <w>napad</w> na sklep jubilerski, który wymagał miesięcy przygotowań."
                            }
                        }
                    ],
                    "target_lang_definitions": {
