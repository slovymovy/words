                            {
                                "example_id": "4290d621-61e5-4f99-8a5b-a7d4405a4128",
                                "sense_id": "be6d059a-1c2a-31a0-9854-cfbc37974cc4",
                                "text": "Het neerknuppelen van de jongen van de zadelrob in Canada heeft veel stof doen opwaaien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7866f430-484b-40c6-8f9d-1e5c14ac8e2c",
                        "source_entry_id": "9f71e36b-7860-35f4-a190-7c128d50a17a",
                        "source_sense_id": "be6d059a-1c2a-31a0-9854-cfbc37974cc4",
                        "source_sense_description": "bepaald soort zoogdier, Pagophilus groenlandicus",
                        "target_lang_word": "лысун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лысун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                        "entry_id": "99c0553e-d0c6-3888-81ba-a4c6e92f68a2",
                                        "glosses": [
                                            "морское животное семейства настоящих тюленей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce1a09b-7c55-4516-a19a-a97683afda7e",
                                                "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                                "text": "Когда туман .. хоть не надолго рассеивался и на небе показывалось солнце, вся поверхность моря покрывалась разнородными морскими животными: белуги и лысуны, молодые моржи, зайцы и нерпы играли вокруг лодей. Мореходы наши .. много шутили и смеялись, стреляя по временам в стада играющих животных."
                                            },
                                            {
                                                "example_id": "b7e31cdb-e6c1-41d8-bf88-8d54c5eb21f4",
                                                "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                                "text": "У Новой Земли: звери морские, киты, моржи, нерпы, белуги, лысуны и другие .."
                                            },
                                            {
                                                "example_id": "10d4529a-f62d-4670-b29b-58e7704ff785",
                                                "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                                "text": "Прежде у нас на Кильдине и становище своё было, а теперь просто у Териберки рыбу промышляем. Много ловим. Ну, и морского зверя бьём — нерпу, лысуна, моржей, тюленей."
                                            },
                                            {
                                                "example_id": "089ae5c4-03b9-4060-9e2e-467bdff8d9b2",
                                                "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                                "text": "Из млекопитающих наибольшее значение имеют тюлени (в залив заходят .. лысун .. и нерпа ..), но это зимний промысел, и летом тюлень в заливе встречается не часто."
                                            },
                                            {
                                                "example_id": "53234f55-7ec2-4edf-ab40-ce4c3f3b254f",
                                                "sense_id": "59c5c6db-30d3-3fa0-9ce1-facc606d8cad",
                                                "text": "Всё лето лысуны — гренландские тюлени — охотятся за рыбой, кальмарами и рачками далеко на севере Атлантического и Ледовитого океанов, у кромки вечных льдов, на восток заходят до Карского моря."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94dd551-a9ae-3e75-a834-8fb58c31fe9e",
                                        "entry_id": "99c0553e-d0c6-3888-81ba-a4c6e92f68a2",
                                        "glosses": [
                                            "морская рыба"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf824d9a-d79c-4ed7-ba1a-14233cd0315a",
                                                "sense_id": "d94dd551-a9ae-3e75-a834-8fb58c31fe9e",
                                                "text": "Многие рыбы используют лысуна в качестве пищи (ошибень, морской петух, калкан и глосса, бычок-кнут, морская игла трубкорот и др.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
