                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil commence à <w>disparaître</w> lentement derrière la colline.",
                            "target_lang_translations": {
                                "en": "The sun is slowly beginning to <w>disappear</w> behind the hill.",
                                "ru": "Солнце начинает медленно <w>исчезать</w> за холмом.",
                                "nl": "De zon begint langzaam achter de heuvel te <w>verdwijnen</w>.",
                                "de": "Die Sonne beginnt langsam hinter dem Hügel zu <w>verschwinden</w>.",
                                "pl": "Słońce zaczyna powoli <w>znikać</w> za wzgórzem.",
                                "it": "Il sole comincia lentamente a <w>sparire</w> dietro la collina.",
                                "cs": "Slunce začíná pomalu <w>mizet</w> za kopcem.",
                                "tr": "Güneş yavaş yavaş tepenin arkasında <w>kaybolmaya</w> başlıyor.",
                                "es": "El sol empieza a <w>desaparecer</w> lentamente detrás de la colina.",
                                "zh": "太阳开始慢慢地<w>消失</w>在山丘后面。"
                            }
                        },
                        {
                            "text": "Le train a fini par <w>disparaître</w> à l'horizon au bout de quelques instants.",
                            "target_lang_translations": {
                                "en": "After a few moments, the train finally <w>disappeared</w> over the horizon.",
                                "ru": "Через несколько мгновений поезд наконец <w>исчез</w> за горизонтом.",
                                "nl": "Na enkele ogenblikken verdween de trein uiteindelijk aan de <w>horizon</w>.",
                                "de": "Nach einigen Augenblicken <w>verschwand</w> der Zug schließlich am Horizont.",
                                "pl": "Po kilku chwilach pociąg w końcu <w>zniknął</w> za horyzontem.",
                                "it": "Dopo alcuni istanti il treno è finalmente <w>sparito</w> all'orizzonte.",
                                "cs": "Po několika okamžicích vlak nakonec <w>zmizel</w> za obzorem.",
                                "tr": "Birkaç an sonra tren sonunda ufukta <w>kayboldu</w>.",
                                "es": "Al cabo de unos instantes, el tren terminó por <w>desaparecer</w> en el horizonte.",
                                "zh": "过了一会儿，火车终于<w>消失</w>在地平线上。"
                            }
                        }
