                        "source_sense_description": "het beheer van natuur, deels gericht op het in balans houden ervan",
                        "target_lang_word": "Landschaftsschutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landschaftsschutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6eeebc55-d386-3fe4-a309-33912438aac5",
                                        "entry_id": "06d9b88e-5003-3db1-a83c-81d274d52107",
                                        "glosses": [
                                            "die Gesamtheit aller Maßnahmen, mit denen die Leistungsfähigkeit des Naturhaushaltes gewährleistet, schwere Schäden in diesem verhindert oder behoben sowie das Aussehen und Erholungswert der Landschaft erhalten werden sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8a6af1-961b-443b-abe0-2e9bcaadda95",
                                                "sense_id": "6eeebc55-d386-3fe4-a309-33912438aac5",
                                                "text": "Der Landschaftsschutz versucht Landschaften durch harmonische Integration von Bauwerken und andere Maßnahmen vor der Verschandelung durch die vordringende Zivilisation zu bewahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00d630bc-2133-4098-aca1-926bd677f13a",
                        "source_entry_id": "d6a69c03-7b9a-3c8b-b042-db8603ee42a1",
                        "source_sense_id": "549732de-d8a1-3f5b-9511-0dcbce81bec9",
                        "source_sense_description": "het beheer van natuur, deels gericht op het in balans houden ervan",
                        "target_lang_word": "Naturschutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naturschutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                        "entry_id": "0023fdf9-20d0-3042-864e-7b19d0342362",
                                        "glosses": [
                                            "Sammelbegriff für die Maßnahmen zur Erhaltung der Natur; Schutz von gefährdeten Pflanzen und Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa92eb2-5f1c-4c27-8ef6-cb73fc078058",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Naturschutz dient der Erhaltung der Natur."
                                            },
                                            {
                                                "example_id": "89495392-d81d-4b73-a65b-0adec879a366",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "1870: In der Schweiz wird der Creux du Van als erstes Gebiet des Landes unter Naturschutz gestellt."
                                            },
                                            {
                                                "example_id": "517d6a9d-564e-445f-bd56-f16f06ae3c79",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Da Wölfe heute vom Aussterben bedroht sind, stehen sie unter Naturschutz."
                                            },
                                            {
                                                "example_id": "70f1d9b1-2ea2-4185-99e2-0a6163ac466d",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Der Naturschutz in Spanien begann bereits 1916, mit dem Erlass des Nationalparkgesetzes."
                                            },
                                            {
                                                "example_id": "0a1a870f-205d-4523-b39c-6bfd83b93b75",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Im Jahre 1993 wurde die Insel [Menorca] zu einem Biosphärenreservat erklärt. Heute steht fast die Hälfte der Insel unter Landschafts- und Naturschutz."
                                            },
                                            {
                                                "example_id": "6624d137-6f2e-4102-b3a6-44816d88aa2e",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Wissenschaftler und indigene Gruppen haben unterschiedliche Auffassungen vom Naturschutz."
                                            },
                                            {
                                                "example_id": "4ad176b9-4e46-4e79-803e-68d59e1f4fec",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Klimaschutz, Naturschutz, Umweltschutz, Artenschutz - heute weit verbreitete Begriffe. Philipp Leopold Martin war der erste, der das Wort \"Naturschutz\" benutzte. Vor 200 Jahren war er damit seiner Zeit weit voraus."
                                            },
                                            {
                                                "example_id": "daf69894-2ecb-4d46-bb19-babacf66eb0d",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Das ist ein Erfolg für den Naturschutz: Vor der Küste der Antarktis soll das bislang größte Meeresschutzgebiet der Erde entstehen."
                                            },
                                            {
                                                "example_id": "015ce234-c040-418a-9238-b641aaa2ce5e",
                                                "sense_id": "5a94b6ad-cbcd-3700-8e5f-2a9d6385b4d9",
                                                "text": "Seit kurzem steht der Regenwald […] unter Schutz. Doch die Bevölkerung wächst rasant, weswegen Jagdverbote und Naturschutz schwer zu vermitteln sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
