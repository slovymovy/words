                        "glosses": [
                            "Petite lanterne au sommet d’une coupole, au-dessus d’un escalier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9bd005-b85b-44f5-9188-b79676752e3b",
                                "sense_id": "74ea432d-f11c-3367-81f5-907c18bf245f",
                                "text": "Le jour, venant d’un lanterneau, donnait une clarté triste."
                            },
                            {
                                "example_id": "6a97813b-0acb-42c8-a4f9-2e795ad39f42",
                                "sense_id": "74ea432d-f11c-3367-81f5-907c18bf245f",
                                "text": "[Église Saint-Paul de Lyon] L’église à la belle silhouette romane et gothique, classée aux Monuments historiques, s’impose par son dôme octogonal avec ses deux séries d’arcatures surmontées d’un lanterneau à arcades ajourées."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d4e4a26-4430-3b71-aa38-eb4e06376602",
                        "entry_id": "4db6db8f-480a-3c86-a3fb-cf53146ee83c",
                        "glosses": [
                            "Partie surélevée d’une toiture avec un vitrage sur le pourtour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b18c68-be3d-4963-a02a-8eb4efa985e2",
                                "sense_id": "3d4e4a26-4430-3b71-aa38-eb4e06376602",
                                "text": "Par ailleurs nous disposons de renseignements épigraphiques et archéologiques très précis pour l'ὺπολαμπάς de la Salle hypostyle, renseignements qui autorisent à traduire le mot par « lanterneau », c’est-à-dire une construction en surélévation d’un toit comportant sur tout les côtés de baies qui servent de puits de lumière, …."
                            }
                        ]
