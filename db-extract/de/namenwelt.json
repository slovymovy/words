                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08aab07b-9263-4fa6-9ff2-cb1ca22f826d",
                                "sense_id": "3dbbd4a5-400e-3bd7-b458-bae282c7fe00",
                                "text": "„Die Namenwelt unserer neu eingewanderten Mitbürger ist uns vertrauter geworden.“"
                            },
                            {
                                "example_id": "ab5a6012-dab4-4aa9-970b-bf2b56c0a5a6",
                                "sense_id": "3dbbd4a5-400e-3bd7-b458-bae282c7fe00",
                                "text": "„Aufnahme in die deutsche Namenwelt fand er weniger durch den kirchlichen Namen (vgl. Papst Alexander III.), sondern seit etwa 1140 durch die mittelalterlichen Alexanderlieder und Alexanderromane, die Alexander den Großen preisen und im Mittelalter nach der Bibel zu den am meisten verbreiteten Schriften gehörten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
