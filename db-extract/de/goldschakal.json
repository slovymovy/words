                ],
                "senses": [
                    {
                        "sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                        "entry_id": "56a3efd8-3dde-3cfe-82a0-5ed960204d12",
                        "glosses": [
                            "Art der Wildhunde in Asien und Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37337605-fbe4-451f-acab-ce0269678dd2",
                                "sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                                "text": "„Europaweit gibt es mittlerweile bis zu 117 000 Goldschakale. Die Tiere haben sich vom Balkan aus Richtung Westeuropa ausgebreitet.“"
                            },
                            {
                                "example_id": "0163f20e-5d8f-432e-af65-4efa44b8a812",
                                "sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                                "text": "„Auch in Deutschland sind Goldschakale unterwegs. Erste bestätigte Nachweise gab es bereits 1997 im südlichen Brandenburg. 2012 tappte ein Goldschakal im Bayerischen Wald in eine Fotofalle. 2017 wurde auf der A9 nahe Freising in Oberbayern ein Goldschakal überfahren.“"
                            },
                            {
                                "example_id": "5bc5788b-665f-472c-baad-7cbbbdfbf053",
                                "sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                                "text": "„Auf den ersten Blick gleichen sich die auch in Europa heimischen Goldschakale und die Goldwölfe im Aussehen und Verhalten. Letztere weisen allerdings schärfere und kräftigere Zähne, längere Ohren und eine erhöhte Stirn auf, weshalb sie bislang als Unterart ausgewiesen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a2f26d4-2b51-40cc-97a7-c7caf52ba973",
                        "source_entry_id": "56a3efd8-3dde-3cfe-82a0-5ed960204d12",
                        "source_sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                        "source_sense_description": "Zoologie: Art der Wildhunde in Asien und Europa",
                        "target_lang_word": "golden jackal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golden jackal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "868aee81-3397-3997-be8b-866a0551dd3d",
                                        "entry_id": "72f0e6cf-0c95-335a-8601-72875d63aad2",
                                        "glosses": [
                                            "Canis aureus, a common jackal that can be found in southwest Europe, the Middle East and South Asia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43aac705-a05b-4a24-8023-d75bd8088752",
                        "source_entry_id": "56a3efd8-3dde-3cfe-82a0-5ed960204d12",
                        "source_sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
                        "source_sense_description": "Zoologie: Art der Wildhunde in Asien und Europa",
                        "target_lang_word": "chacal doré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chacal doré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9507f9-c7ee-341a-94f8-e4a0feb8052d",
                                        "entry_id": "43bd3d31-8a54-3db8-87a3-b5fc36c4aeb1",
                                        "glosses": [
                                            "Synonyme de chacal commun (canidé)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b666a3bf-9832-4fd7-94b6-9df4453d068f",
                                                "sense_id": "5d9507f9-c7ee-341a-94f8-e4a0feb8052d",
                                                "text": "Le chacal doré occupait à l’origine une vaste aire qui va de l’Inde au Moyen-Orient. Il profite aujourd’hui du réchauffement climatique et de l’éviction du loup, un de ses prédateurs, pour coloniser de nouveaux territoires."
                                            },
                                            {
                                                "example_id": "991368e0-fb65-4a7b-8e7b-13e7445a18ef",
                                                "sense_id": "5d9507f9-c7ee-341a-94f8-e4a0feb8052d",
                                                "text": "Une queue courte, touffue et tombante, de petites oreilles, une silhouette ramassée : aucun doute, le chacal doré avait fait son entrée en France."
                                            },
                                            {
                                                "example_id": "7384a335-08fd-45d3-87b8-dac4c1357f92",
                                                "sense_id": "5d9507f9-c7ee-341a-94f8-e4a0feb8052d",
                                                "text": "Dans un tout autre genre, le chacal doré, à mi-chemin entre le loup, le renard et le coyote, normalement réparti en Europe de l’Est et en Asie, s’est également implanté dans l’Hexagone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9861435e-e091-4bb8-86d9-a813e6cd1ec1",
                        "source_entry_id": "56a3efd8-3dde-3cfe-82a0-5ed960204d12",
                        "source_sense_id": "466ff703-3949-3fe7-b4a1-d64283d56b1e",
