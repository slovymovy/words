{
    "word_family": [
        "reed",
        "reediness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e33729f2-744f-3007-92af-bdc638e6fc57",
                    "sense_definition": "Full of, overgrown with, or edged with tall wetland grasses known as reeds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reedy_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat slowly navigated the <w>reedy</w> margins of the quiet river.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка медленно продвигалась сквозь <w>заросшие тростником</w> берега тихой реки."
                            }
                        },
                        {
                            "text": "Many migratory birds nest along the <w>reedy</w> shores of the lake.",
                            "target_lang_translations": {
                                "ru": "Многие перелетные птицы гнездятся вдоль <w>камышовых</w> берегов озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reedy bank",
                        "reedy lake",
                        "reedy shore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заросший или изобилующий тростником либо камышом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тростниковый",
                                "target_lang_sense_clarification": "состоящий из тростника или заросший им"
                            },
                            {
                                "target_lang_word": "камышовый",
                                "target_lang_sense_clarification": "заросший камышом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37957510-e9f1-349c-837c-eab41eb94059",
                    "sense_definition": "Tall, thin, and frail in appearance, resembling a reed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reedy_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>reedy</w> teenager who looked as though a strong wind might blow him away.",
                            "target_lang_translations": {
                                "ru": "Он был <w>тонким как тростинка</w> подростком, казавшимся настолько хрупким, что сильный порыв ветра мог сдуть его."
                            }
                        },
                        {
                            "text": "Her <w>reedy</w> frame was accentuated by the oversized winter coat she wore.",
                            "target_lang_translations": {
                                "ru": "Ее <w>худощавую</w> фигуру подчеркивало надетое зимнее пальто не по размеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "spindly",
                        "slender",
                        "lanky"
                    ],
                    "antonyms": [
                        "stocky",
                        "burly"
                    ],
                    "common_phrases": [
                        "reedy youth",
                        "reedy frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий, худой и хрупкий на вид; напоминающий тростинку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий как тростинка",
                                "target_lang_sense_clarification": "очень худой и стройный человек"
                            },
                            {
                                "target_lang_word": "худощавый",
                                "target_lang_sense_clarification": "сухощавый, тонкий"
                            },
                            {
                                "target_lang_word": "долговязый",
                                "target_lang_sense_clarification": "высокий и нескладный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64fbe3a-8561-328e-b8d5-6874cdafad4c",
                    "sense_definition": "Having a sound or voice that is high-pitched, thin, and whistling or vibrating like a reed instrument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reedy_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old woman called out to us in a thin, <w>reedy</w> voice.",
                            "target_lang_translations": {
                                "ru": "Старушка окликнула нас тонким, <w>писклявым</w> голосом."
                            }
                        },
                        {
                            "text": "An eerie, <w>reedy</w> tune came from the homemade wooden pipe.",
                            "target_lang_translations": {
                                "ru": "Жутковатая, <w>резкая свистящая</w> мелодия доносилась из самодельной деревянной дудочки."
                            }
                        }
                    ],
                    "synonyms": [
                        "piping",
                        "shrill"
                    ],
                    "antonyms": [
                        "resonant",
                        "deep"
                    ],
                    "common_phrases": [
                        "reedy voice",
                        "reedy tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий, писклявый, пронзительный или вибрирующий (о звуке или голосе), напоминающий звучание язычкового инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визгливый",
                                "target_lang_sense_clarification": "высокий и резкий голос"
                            },
                            {
                                "target_lang_word": "писклявый",
                                "target_lang_sense_clarification": "тонкий и слабый звук"
                            },
                            {
                                "target_lang_word": "сиплый",
                                "target_lang_sense_clarification": "с придыханием и дребезжанием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "256592fa-68d6-3336-8a5b-f7c5448e2e31",
                    "sense_definition": "Describing metal that is imperfectly welded together in masses of rods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structural failure was caused by defective, <w>reedy</w> iron used in the beams.",
                            "target_lang_translations": {
                                "ru": "Разрушение конструкции было вызвано дефектным, <w>волокнистым</w> железом, использованным в балках."
                            }
                        },
                        {
                            "text": "Blacksmiths discarded the <w>reedy</w> metal because it cracked under minimal pressure.",
                            "target_lang_translations": {
                                "ru": "Кузнецы выбраковывали <w>неоднородный</w> металл, потому что он растрескивался при малейшей нагрузке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reedy iron"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in traditional metallurgy."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свилеватый, волокнистый или неоднородный (о металле с дефектами сварки прутьев)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокнистый",
                                "target_lang_sense_clarification": "о дефекте структуры металла"
                            },
                            {
                                "target_lang_word": "свилеватый",
                                "target_lang_sense_clarification": "неоднородный по структуре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4de32768-0e34-3896-947e-68aec2e442b0",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Reedy</w> delivered an insightful lecture on local wetland ecosystems.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Риди</w> прочитал познавательную лекцию о местных водно-болотных экосистемах."
                            }
                        },
                        {
                            "text": "The author signed the contract under the name of Thomas <w>Reedy</w>.",
                            "target_lang_translations": {
                                "ru": "Автор подписал контракт под именем Томаса <w>Риди</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Риди",
                                "target_lang_sense_clarification": "транскрипция фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}