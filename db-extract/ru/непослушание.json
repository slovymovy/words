                                                "sense_id": "9eef853d-fcef-3a81-a3dc-0cefb37d8d96",
                                                "text": "„Analog der orthopädischen Fixierung sollte das Festbinden auf den Zwangsstuhl die Unbotmäßigkeit des Irren, seine geistige Verkrümmung, korrigieren, begradigen.“"
                                            },
                                            {
                                                "example_id": "b947548f-d0c5-40aa-89d2-f2565507b843",
                                                "sense_id": "9eef853d-fcef-3a81-a3dc-0cefb37d8d96",
                                                "text": "„Illoyalität wurde damit zur Unbotmäßigkeit gegenüber diesem Gott.“"
                                            }
                                        ],
