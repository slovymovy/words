                    {
                        "translation_id": "4edf3c76-583f-4e93-aadd-d84e024bdc53",
                        "source_entry_id": "7a822272-49fc-33ee-9394-b252f8693a2e",
                        "source_sense_id": "f968841f-384a-3f2d-880b-b93735b903af",
