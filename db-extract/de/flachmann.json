                            {
                                "target_word": "pocket flask",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a918f177-46b7-3f41-9ce1-145cf26db99e",
                                        "entry_id": "d9150b6b-714d-35e8-b4d3-9a277c30fbcd",
                                        "glosses": [
                                            "A flat metal container for alcoholic beverages, with a narrow neck suitable for use as a drinking spout, designed to fit into a man's pocket and popular in the 19th and early 20th centuries."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a34a5f4-d04a-4851-833d-e14db78dce66",
                                                "sense_id": "a918f177-46b7-3f41-9ce1-145cf26db99e",
                                                "text": "The traveller had been at the pains of going a long way up stairs to his sleeping-room, to fetch his pocket-flask of brandy."
                                            },
                                            {
                                                "example_id": "c47f079b-0635-4a8c-b29a-4a2c7de7fb72",
                                                "sense_id": "a918f177-46b7-3f41-9ce1-145cf26db99e",
                                                "text": "We were walking at a smart pace, and a sip from my pocket-flask soon set my old friend's tongue going."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
