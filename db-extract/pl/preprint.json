                                        "sense_id": "c6988dc6-c7b5-3877-bb98-eb748e271c95",
                                        "entry_id": "77191f73-3f77-3584-91da-442f1daa5564",
                                        "glosses": [
                                            "Veröffentlichung wissenschaftlicher Erkenntnisse zu einem frühen Zeitpunkt, zu dem noch keine/kaum Überprüfungen/Begutachtungen stattgefunden haben"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e49f33-884c-47a8-aff6-832feda8396c",
                                                "sense_id": "c6988dc6-c7b5-3877-bb98-eb748e271c95",
                                                "text": "„Im Zuge der Coronavirus-Pandemie bekam die Öffentlichkeit auch eine Art Crashkurs dazu, wie wissenschaftliche Erkenntnisse gewonnen werden – heftige Kontroversen inklusive. Preprints, also noch nicht begutachtete Studien, spielten dabei eine zentrale Rolle.“"
                                            },
                                            {
                                                "example_id": "d3ed5c69-1742-4bfd-a9ed-ec3958492551",
                                                "sense_id": "c6988dc6-c7b5-3877-bb98-eb748e271c95",
                                                "text": "„Eine zweite Studie aus Norwegen, die als Preprint veröffentlicht wurde, kam zu ähnlichen Ergebnissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
