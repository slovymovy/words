                        ]
                    },
                    {
                        "translation_id": "b69ba7c6-b7b4-4032-82f9-e8e10dbfb340",
                        "source_entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "source_sense_description": "ability to stabilize internal environment",
                        "target_lang_word": "homéostasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homéostasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                        "entry_id": "9adbffe4-9f44-3284-bb24-aaff9cb69354",
                                        "glosses": [
                                            "Capacité d’un organisme à maintenir son équilibre physiologique interne malgré les contraintes extérieures."
                                        ],
                                        "tags": [
                                            "Sciences de la vie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd438e0-f2d6-4146-9ff3-be34325588a9",
                                                "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                                "text": "De la même manière que les processus physiologiques sont accumulés pour aboutir à l’homéostasie (situation stable), les processus de développement sont régulés pour donner lieu à l’homéorhésie (flux stable)."
                                            },
                                            {
                                                "example_id": "2ce987bf-c1f9-4007-9302-eda16cfdab59",
                                                "sense_id": "7cb33549-6a8c-38e7-bb16-8ff40850b0ab",
                                                "text": "Et les sentiments nous informent sur ce qui se passe dans notre corps. Ils servent à savoir si nous éprouvons du plaisir ou de la souffrance et, grâce à cela, de maintenir notre homéostasie [en biologie, capacité pour un système à maintenir l’équilibre de son milieu intérieur, quelles que soient les contraintes externes, NDLR]. Ces sentiments sont les moteurs de nos actions et même de nos inventions culturelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9edb6e7d-6d18-42ac-ad07-ea2f11af3fe1",
                        "source_entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "source_sense_description": "ability to stabilize internal environment",
                        "target_lang_word": "Homöostase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homöostase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6199dc-573f-321b-b1c6-f182392d4e4c",
                                        "entry_id": "26e16073-b199-3984-bc44-971962628e2a",
                                        "glosses": [
                                            "der Vorgang eines Systems, sich durch Rückkopplung selbst innerhalb gewisser Grenzen in einem stabilen Zustand zu halten; ein sich selbst aufrecht erhaltendes Gleichgewicht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2702aa50-9bb2-4d08-9173-b757f9b06772",
                                                "sense_id": "7a6199dc-573f-321b-b1c6-f182392d4e4c",
                                                "text": "„Lebendige Systeme wie die Familie haben zwei sich widersprechende Tendenzen, einmal die zur Homöostase, zum Gleichgewicht, zum andern die zur Veränderung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f9f9031-40a0-4e02-b4c6-2cc3b63f46d3",
                        "source_entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "source_sense_description": "ability to stabilize internal environment",
                        "target_lang_word": "Selbstregulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstregulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                        "entry_id": "0f508a70-3528-358e-bbed-2fca987eb4a0",
                                        "glosses": [
                                            "Fähigkeit von Lebewesen, ökonomischen oder sonstigen Systemen, sich gegen erheblichen Druck von außen selbst zu behaupten, äußeren Störungen standzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf2159f-b7c7-4ea8-a88d-fd81c4c22faa",
                                                "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                                "text": "„Strafen helfe eher wenig, denn dadurch verfestigen sich nicht diejenigen Nervenverbindungen, die die Fähigkeit zur Selbstregulation und Selbstmotivation langfristig förderten.“"
                                            },
                                            {
                                                "example_id": "5cb95eb0-6b18-4001-a7a6-a86d50b23f46",
                                                "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                                "text": "„Die Frage war also, ob man die in der Wissenschaft noch bevorzugte Selbstregulation und -kontrolle forciert oder ob die Wissenschaft sich mit klaren, von der Gesellschaft bestimmten Regeln abfinden muss.“"
                                            },
                                            {
                                                "example_id": "8afd6a65-fce5-4cb1-8fa3-07f2c1309225",
                                                "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                                "text": "„Für Therapeuten sind Soldaten eine heikle Klientel, die psychische Probleme besonders häufig als Makel empfindet, den es schamhaft zu verschweigen oder durch Selbstregulation zu beheben gilt.“"
                                            },
                                            {
                                                "example_id": "36af8c3d-1194-4813-9dac-6979f71de304",
                                                "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                                "text": "„In mehreren therapeutischen Untersuchungen unseres Instituts trainierten Schwerstverbrecher in Hochsicherheitsgefängnissen jene Hirnregionen, welche für Selbstregulation und Aggressionssteuerung und Angstentstehung verantwortlich sind, zu verstärken, und/oder jene Regionen, die instrumentelle Aggression vermitteln, zu unterdrücken.“"
                                            },
                                            {
                                                "example_id": "3eaae75a-1946-4868-a5b6-fbfdeb56fd3b",
                                                "sense_id": "28b0e3cb-9b92-3328-8966-7dc8c1a6fbce",
                                                "text": "„Ihm gefällt die Idee, die Erde könnte am Ende einen Ausweg aus den gegenwärtigen Umweltkrisen finden - dank ihrer inhärenten Bereitschaft zur Selbstregulation bis hin zur ökologischen Selbstreinigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
