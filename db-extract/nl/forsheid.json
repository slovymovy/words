                "entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                "word": "forsheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                        "entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                        "glosses": [
                            "het groot zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8546be8f-f445-4c66-b8f4-8485644b670b",
                                "sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                                "text": "Nicolien Sauerbreij is 1.65 meter en weegt nog geen zestig kilo, dat is zeker twintig kilo minder dan haar snowboardconcurrenten. „En dan ben ik vergeleken met mijn zusje nog fors.” Haar jongere zus, Marieke, is ook professioneel snowboarder. Ik probeer niet al te opvallend over tafel te kijken naar waar die forsheid van haar zou moeten zitten. „Grote handen”, zegt ze. Ze roffelt ermee op haar dijen."
                            },
                            {
                                "example_id": "92c81d8b-5d16-4ad2-bdf3-ab0f6f9ae910",
                                "sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
                                "text": "De jarenlange klimtrainingen en uithoudingsbeproevingen werpen stilaan hun vruchten af. Kenners bemerken een zekere forsheid en kracht in de pedaaltred. Tussen dit en twee jaar zal Jurgen zijn beste resultaten boeken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c17a6bc-923d-4282-8131-8a293a791b16",
                        "source_entry_id": "e6a78a5c-1244-3933-b191-b04799f555d9",
                        "source_sense_id": "7b0c24ba-a1eb-3e08-b24c-6402f2e9b505",
