        "nl-extract.jsonl": [
            {
                "entry_id": "fc55dfa2-8bc6-3a5f-8122-9638fb8145ad",
                "word": "gate",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cd8ee609-a0d2-46e3-a30b-fe31664e5f2d",
                        "entry_id": "fc55dfa2-8bc6-3a5f-8122-9638fb8145ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "gates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8eeb67e4-53d7-37e8-b080-3f023cd6904e",
                        "entry_id": "fc55dfa2-8bc6-3a5f-8122-9638fb8145ad",
                        "glosses": [
                            "doorgang op een luchthaven waar de reizigers voor een vertrekkende vlucht het terminalgebouw verlaten of dat na een inkomende vlucht betreden\\nBij vertrek is gaat de luchtvaartmaatschappij hier na of de reisdocumenten in orde zijn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab0ee2f-b081-42cc-b7d1-1368c46ba951",
                                "sense_id": "8eeb67e4-53d7-37e8-b080-3f023cd6904e",
                                "text": "Bij de gate van een vliegveld worden je ticket en je paspoort gecontroleerd."
                            },
                            {
                                "example_id": "1b9cbbbd-a41b-435a-928d-b1889cf26bdc",
                                "sense_id": "8eeb67e4-53d7-37e8-b080-3f023cd6904e",
                                "text": "Luchthavens blijken vaak groter dan gedacht. Zelfs als je goed ter been bent, kan het nog steeds spannend zijn om op tijd bij de gate te komen."
                            },
                            {
                                "example_id": "b2d35277-2383-4e43-a93a-4aca3b0a81ef",
                                "sense_id": "8eeb67e4-53d7-37e8-b080-3f023cd6904e",
                                "text": "Een massale zucht ging door de cabine toen de piloot omriep dat de gate nog niet vrij was omdat we vanwege wind mee te vroeg waren geland."
                            }
                        ]
                    },
                    {
                        "sense_id": "a42335ea-d8ac-3dc2-87ab-894b65b2ca89",
                        "entry_id": "fc55dfa2-8bc6-3a5f-8122-9638fb8145ad",
                        "glosses": [
                            "plaats waar mensen die binnenkomen of weggaan worden gecontroleerd op zaken die ze niet bij zich mogen hebben"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7b5766bf-1078-4938-bff9-adf3cd3e20bb",
                                "sense_id": "a42335ea-d8ac-3dc2-87ab-894b65b2ca89",
                                "text": "Bij de uitgang van een winkel of bibliotheek is een gate die controleert op diefstal."
                            },
                            {
                                "example_id": "7df24f7d-0854-4be3-9b24-9041be898e1f",
                                "sense_id": "a42335ea-d8ac-3dc2-87ab-894b65b2ca89",
                                "text": "Hij moet me uitleggen wat dat betekent: de gate gaat live. Door het raam wijst hij op de nieuwe scanpoorten die de containertrucks passeren voordat zij de openbare weg bereiken. De wagen, chauffeur en lading: alles wordt gecheckt."
                            }
                        ]
                    }
                ],
