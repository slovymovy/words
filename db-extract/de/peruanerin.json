                                        "entry_id": "3b9c65a2-c0ef-34ec-bf15-f8cb996f9812",
                                        "glosses": [
                                            "Of, from, or pertaining to Peru or the Peruvian people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
