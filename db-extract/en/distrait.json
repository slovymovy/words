                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5ff5ec-5af8-4062-b7ea-3389aeb35360",
                                                "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                                                "text": "Air distrait."
                                            },
                                            {
                                                "example_id": "c36930f1-b024-4228-9dc1-2cf1c625a287",
                                                "sense_id": "bdd25288-c48b-338f-867d-083ed96f523f",
                                                "text": "Des yeux, des regards distraits."
                                            }
                                        ]
                                    }
                                ]
                            },
