            {
                "entry_id": "c057548b-2410-3ab7-a81d-03b023f9f0af",
                "word": "HU",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "902a08f0-31b3-3eee-96b7-7b16c3e46960",
                        "entry_id": "c057548b-2410-3ab7-a81d-03b023f9f0af",
                        "glosses": [
                            "A name for God in the Eckankar new religious movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25aa2512-70d5-4b4e-9bf6-4d6f72f8b390",
                                "sense_id": "902a08f0-31b3-3eee-96b7-7b16c3e46960",
                                "text": "The ECK can be experienced through chanting the word \"HU,\" a special name for God in ECKANKAR. Chanting HU with an open heart to God's love is a central spiritual practice of ECKANKAR. It is alleged to help lift one to spiritual self-realization, and ultimately God-realization."
                            },
                            {
                                "example_id": "306140c5-a226-4507-b930-2bc40029aed6",
                                "sense_id": "902a08f0-31b3-3eee-96b7-7b16c3e46960",
                                "text": "HU, Law of. The first law of the physical universe. Spirit is the all-penetrating power which is the forming power of the universes of HU, the Voice of HU (God). See also laws of the physical universe. / HU, A Year of. The fifth of the Spiritual Years of ECK. HU is the most ancient name for God, not God Itself."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
