                                        "entry_id": "b9db11f1-afa4-34f1-a82a-3c3d8d839caf",
                                        "glosses": [
                                            "ato ou efeito de marginalizar; exclusão de um indivíduo ou grupo do convívio ou participação plena na sociedade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792359d9-7152-41ed-895f-f7fe3afa3936",
                                                "sense_id": "a63cd9ac-17a6-3dd4-9974-e659c82a060b",
                                                "text": "A marginalização de minorias é um problema estrutural em muitas sociedades"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507f0a74-ae76-353b-988d-12a9490478b9",
