                "senses": [
                    {
                        "sense_id": "f07f3aaa-3ec5-3465-9c96-f4c5bd43f0ad",
                        "entry_id": "ff8249f9-21e5-3f52-9df8-cca8950b7167",
                        "glosses": [
                            "Femme qui a la fonction de ministre du culte dans la religion protestante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf213f5d-58e3-4bc5-b890-58618ea17ab4",
                                "sense_id": "f07f3aaa-3ec5-3465-9c96-f4c5bd43f0ad",
                                "text": "Nous avons donné le portrait de la première femme-avocate, à Genève ; il sied d’y ajouter celui de la première femme-pasteur en Angleterre. Le pasteur actuel (ou la pastoresse) de l’Église de Leicester est Mˡˡᵉ Gertrude von Petzold."
                            },
                            {
                                "example_id": "a94c8047-fbbb-47a9-83d6-cdcfc2b21388",
                                "sense_id": "f07f3aaa-3ec5-3465-9c96-f4c5bd43f0ad",
                                "text": "Et si Marie et Joseph cherchaient refuge aux États-Unis aujourd’hui, quel accueil recevraient-ils ? C’est la question que s’est posée cette Pastoresse de l’église californienne Claremont United Methodist Church, à une cinquantaine de kilomètres de Los Angeles."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e134c3d-ea8b-3508-bcd1-4a7dd1b118a0",
                        "entry_id": "ff8249f9-21e5-3f52-9df8-cca8950b7167",
                        "glosses": [
                            "Épouse d’un pasteur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "639aa5e2-9c71-4f2a-b790-0cc713514f9b",
                                "sense_id": "1e134c3d-ea8b-3508-bcd1-4a7dd1b118a0",
                                "text": "L’auteur nous présente le pasteur-doyen, son père, célébrant les funérailles de la pastoresse, sa mère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c6d998-acd0-4edb-9bbf-a258dca895f1",
                        "source_entry_id": "ff8249f9-21e5-3f52-9df8-cca8950b7167",
                        "source_sense_id": "f07f3aaa-3ec5-3465-9c96-f4c5bd43f0ad",
                        "source_sense_description": "Ministre du culte",
                        "target_lang_word": "Pastorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pastorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                                        "glosses": [
                                            "weibliche Person, die Geistliche einer Kirche ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3dec83-de84-4290-a627-6380b211b599",
                                                "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                                                "text": "„Er meldete sie als vermisst. Und bestellte gleichzeitig eine Pastorin aus Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                                        "glosses": [
                                            "Gattin eines evangelischen Geistlichen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c2a6c1-f16c-4fb5-84c3-11909e83afe6",
                                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                                "text": "„Unserer Nebel ältere Schwester ist die aus Goethe’s Dichtung und Wahrheit bekannte Frau Pastorin Griesbach […].“ (Gattin des Predigers und Theologen Johann Jakob Griesbach ^(→ WP))"
                                            },
                                            {
                                                "example_id": "5a2dc2ed-9cef-43e8-bc57-782f667717ce",
                                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                                "text": "„Die Herren vertieften sich in ein eifriges Gespräch über die politische Lage des Landes. Interessiert folgte die Pastorin ihren Auseinandersetzungen und warf hier und da ein verständnisvolles Wort dazwischen.“ (Novelle: Gattin von Pastor Berger)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
