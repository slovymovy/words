                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "857debd1-58c1-3082-ba89-d96e35f6d444",
                        "entry_id": "145636b7-d320-3947-8356-28d5f15f09ea",
                        "glosses": [
                            "ergens een tijd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f879f58-a2b9-40f5-a4e4-d974eb7055fa",
                                "sense_id": "857debd1-58c1-3082-ba89-d96e35f6d444",
                                "text": "- Ik heb twee uur in het museum rondgebracht maar toen had ik alles wel gezien."
                            }
                        ]
                    },
                    {
                        "sense_id": "62b1114c-c4fc-3ea3-b8ff-7a04b09f6b2f",
                        "entry_id": "145636b7-d320-3947-8356-28d5f15f09ea",
                        "glosses": [
                            "bezorgen, afleveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad1480c-892a-490e-a10a-3d9662a5dc04",
                                "sense_id": "62b1114c-c4fc-3ea3-b8ff-7a04b09f6b2f",
                                "text": "- Ik heb vele jaren de krant rondgebracht."
                            },
                            {
                                "example_id": "e975b6ec-5bda-4a5b-8223-76a06097a9fd",
                                "sense_id": "62b1114c-c4fc-3ea3-b8ff-7a04b09f6b2f",
                                "text": "- Inmiddels staan we voor de Community Shop. Tot zes jaar geleden was dit een supermarkt. De supermarkt leed verlies en sloot, een voorbeeld van de leegloop van de middenstand op het Engelse platteland. Maar de klimaatgroep kwam met een plan, stak er geld in, liet dorpelingen een belang kopen en nu is de supermarkt het vrolijke middelpunt van het dorp. „Mensen zoeken hier streekproducten en zelfgemaakte taarten. Ze willen de krant kopen en praten over de voorpagina. Ze verlangen de dingen die je niet kan vinden bij Tesco’s of Sainsbury’s”, zegt manager Deb Deynam. „We hebben tientallen vrijwilligers die achter de kassa staan, de inkoop verzorgen, boodschappen rondbrengen. Zij vinden het fijn om zo met mensen in contact te komen.”"
                            }
                        ]
                    }
                ],
