                    },
                    {
                        "translation_id": "6827f249-7e1b-44fb-9370-f2771214f5d9",
                        "source_entry_id": "b8eb7c21-5116-3703-bd2d-5bb76347eb8b",
                        "source_sense_id": "9b6d7a17-3754-327b-8b6d-b6a4f621efe5",
