                                "text": "Sie verlor den Rechtsstreit."
                            },
                            {
                                "example_id": "90bfb1b3-a033-460c-93bf-991eb2466cb6",
                                "sense_id": "1b625e6c-4640-3960-91ad-7ceacf66aafd",
