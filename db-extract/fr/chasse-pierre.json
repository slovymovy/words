                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A pilot vehicle."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1bb21d6-f991-3358-8da4-c1fc3a681095",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person authorised to drive such a vehicle during an escort."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56ad85c-d15d-3925-9c48-1530556eda9e",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A guide or escort through an unknown or dangerous area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1a7d61-563b-4413-8262-e0ede72d6123",
                                                "sense_id": "d56ad85c-d15d-3925-9c48-1530556eda9e",
                                                "text": "So we mounted our horses, and put out for that town, under the direction of two friendly Creeks we had taken for pilots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "Something serving as a test or trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d14b75-27e1-41f5-aa88-0f67115bc102",
                                                "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                                "text": "We would like to run a pilot in your facility before rolling out the program citywide."
                                            },
                                            {
                                                "example_id": "656deb8e-f2d6-42c2-9898-b08712d6a346",
                                                "sense_id": "7cd4e8dc-c4df-3732-bd3f-6b21fc52cd71",
                                                "text": "“I agreed with my husband when he said that to do the business properly we must do a pilot first.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d2c14a-a41d-35d2-b4f2-747dd6497703",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "Something serving as a test or trial.",
                                            "The heading or excavation of relatively small dimensions, first made in the driving of a larger tunnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa4b18fb-8cd5-31f9-b51e-410ffc46b3ae",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A tone or signal, usually a single frequency, transmitted over a communications system for control or synchronization purposes."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dea3445-b2a8-3cf1-a504-20115acefe9b",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A person who is in charge of the controls of an aircraft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47a0fd08-75de-3b4d-8a21-562eb2c69d52",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A sample episode of a proposed TV series produced to decide if it should be made or not. If approved, typically the first episode of an actual TV series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b362e0e-5c2b-4dc9-97d4-638fcb666915",
                                                "sense_id": "47a0fd08-75de-3b4d-8a21-562eb2c69d52",
                                                "text": "I think her biggest deal was she starred in a pilot.[…]Well, the way they pick TV shows is they make one show. That show's called a pilot. Then they show that one show to the people who pick shows, and on the strength of that one show, they decide if they wanna make more shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2667bd7-f32b-3bf5-b639-e4b20a315fbf",
                                        "entry_id": "e9f358a8-423e-302f-b4ba-287fe1a89ff6",
                                        "glosses": [
                                            "A cowcatcher."
                                        ],
                                        "tags": [],
