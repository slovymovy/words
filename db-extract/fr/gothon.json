                        "entry_id": "e389f9c8-e328-3e0e-9e14-30ea46ce2590",
                        "glosses": [
                            "Femme de mauvaises mœurs, prostituée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b7f55d82-b1ce-482a-a416-fe02c837b3ba",
                                "sense_id": "2df1f61f-eca9-33f3-abc6-118e2297db71",
                                "text": "Tu as le temps de penser à cette gothon qui te bouscule, te fait manger froid et te traite de propre à rien et de feignant."
                            },
                            {
                                "example_id": "ef4da4ef-3b4a-4d89-9c97-5e7e3cc58601",
                                "sense_id": "2df1f61f-eca9-33f3-abc6-118e2297db71",
                                "text": "Tant qu’ils auraient la faculté du débit de boissons, ils pourraient plumer leurs pigeons à l’aide de leurs gothons."
                            },
                            {
                                "example_id": "0c840376-c81f-47b0-9962-2d2ae3cf9901",
                                "sense_id": "2df1f61f-eca9-33f3-abc6-118e2297db71",
                                "text": "Moqué par ses élèves, vivant comme une gothon, sachant qu’une révolution se lève à l’Est, trop tard pour lui, haï par tous les patriotes de l’arrière, il veut se battre en duel, dans un dernier sursaut."
                            }
                        ]
                    }
