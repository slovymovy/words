                "senses": [
                    {
                        "sense_id": "9feab17b-3744-32e8-83e0-a22664579549",
                        "entry_id": "507506f0-3aa9-32c1-a1af-c91bcdd2e5c4",
                        "glosses": [
                            "Geldsumme, die für eine Sache bezahlt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f433ef-7d71-4cde-b383-0ea3bc4a230d",
                                "sense_id": "9feab17b-3744-32e8-83e0-a22664579549",
                                "text": "Die Kaufsumme kann in bar oder per Kreditkarte beglichen werden."
                            },
                            {
                                "example_id": "be7022ca-123d-46a9-9364-707185f360d4",
                                "sense_id": "9feab17b-3744-32e8-83e0-a22664579549",
                                "text": "„Der Schluss, der in dem Artikel aus der Kaufsumme gezogen wurde, lautete, derart grober Nepotismus sei eine Bedrohung für die Demokratie.“"
                            },
                            {
                                "example_id": "900088d8-7ef1-4364-9d3c-b1df083bc487",
                                "sense_id": "9feab17b-3744-32e8-83e0-a22664579549",
                                "text": "„Die gesamte Kaufsumme, 5500 Gulden, bezahlte er von seinen Ersparnissen.“"
                            },
                            {
                                "example_id": "1622328a-8b60-4af2-b83d-6464681a1d16",
                                "sense_id": "9feab17b-3744-32e8-83e0-a22664579549",
                                "text": "„Der Schweizer Strohmann mußte nämlich dreißig Prozent der Kaufsumme in Schweizer Franken bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
