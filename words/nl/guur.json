{
    "word_family": [
        "guurheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5115ffb-7a9e-3ac8-9939-7f0fe1172468",
                    "sense_definition": "Koud, winderig en regenachtig weer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag zo <w>guur</w> dat er bijna niemand op straat is.",
                            "target_lang_translations": {
                                "it": "Oggi fa così <w>gelido</w> che non c'è quasi nessuno per strada."
                            }
                        },
                        {
                            "text": "Door het <w>gure</w> weer bleven we de hele middag binnen bij de kachel.",
                            "target_lang_translations": {
                                "it": "A causa del tempo <w>inclemente</w> siamo rimasti tutto il pomeriggio in casa vicino alla stufa."
                            }
                        }
                    ],
                    "synonyms": [
                        "kil",
                        "ijzig"
                    ],
                    "common_phrases": [
                        "guur weer"
                    ],
                    "target_lang_definitions": {
                        "it": "Tempo freddo, ventoso e piovoso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "gelido",
                                "target_lang_sense_clarification": "riferito a un clima molto freddo e pungente"
                            },
                            {
                                "target_lang_word": "pungente",
                                "target_lang_sense_clarification": "riferito a un freddo che si sente sulla pelle"
                            },
                            {
                                "target_lang_word": "inclemente",
                                "target_lang_sense_clarification": "riferito a condizioni meteorologiche avverse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61499ba9-b442-3ef7-9dac-01bb9d636d3e",
                    "sense_definition": "Onaangenaam of onprettig in sfeer of voorkomen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sfeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man had een <w>guur</w> voorkomen dat iedereen afschrikte.",
                            "target_lang_translations": {
                                "it": "L'uomo aveva un aspetto <w>sinistro</w> che spaventava tutti."
                            }
                        },
                        {
                            "text": "Er hing een <w>gure</w> sfeer in de verlaten steeg.",
                            "target_lang_translations": {
                                "it": "Nel vicolo deserto si respirava un'atmosfera <w>inquietante</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onaangenaam",
                        "onheilspellend"
                    ],
                    "antonyms": [
                        "aangenaam"
                    ],
                    "target_lang_definitions": {
                        "it": "Sgradevole o inquietante nell'aspetto o nell'atmosfera."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sinistro",
                                "target_lang_sense_clarification": "che suscita timore o sospetto"
                            },
                            {
                                "target_lang_word": "sgradevole",
                                "target_lang_sense_clarification": "che non è piacevole o accogliente"
                            },
                            {
                                "target_lang_word": "inquietante",
                                "target_lang_sense_clarification": "che crea una sensazione di disagio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}