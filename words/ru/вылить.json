    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0b19399-df76-3901-a3e6-7ebd18a75afe",
                    "sense_definition": "Освободить сосуд или емкость от жидкости, выплеснув ее наружу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "перемещение жидкости",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>вылил</w> остатки холодного чая в раковину.",
                            "target_lang_translations": {
                                "en": "He <w>poured out</w> the leftover cold tea into the sink."
                            }
                        },
                        {
                            "text": "Повар <w>вылил</w> бульон в большую кастрюлю для супа.",
                            "target_lang_translations": {
                                "en": "The chef <w>poured</w> the broth into a large soup pot."
                            }
                        }
                    ],
                    "synonyms": [
                        "выплеснуть",
                        "опорожнить"
                    ],
                    "antonyms": [
                        "влить"
                    ],
                    "common_phrases": [
                        "вылить воду",
                        "вылить остатки"
                    ],
                    "target_lang_definitions": {
                        "en": "To empty a container by pouring its liquid contents out."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pour out",
                                "target_lang_sense_clarification": "general action of emptying a liquid"
                            },
                            {
                                "target_lang_word": "dump",
                                "target_lang_sense_clarification": "informal, to empty quickly or carelessly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "988ad039-5adf-3b56-83a3-23109b4f2edf",
                    "sense_definition": "Заставить жидкость вытечь из чего-либо или откуда-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "перемещение жидкости",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер <w>вылил</w> масло из старого двигателя в специальный контейнер.",
                            "target_lang_translations": {
                                "en": "The mechanic <w>drained</w> the oil from the old engine into a special container."
                            }
                        },
                        {
                            "text": "Пришлось <w>вылить</w> всю воду из бака перед ремонтом.",
                            "target_lang_translations": {
                                "en": "We had to <w>drain</w> all the water from the tank before the repair."
                            }
                        }
                    ],
                    "synonyms": [
                        "слить"
                    ],
                    "common_phrases": [
                        "вылить содержимое"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause liquid to drain or flow out of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "to remove liquid from a container"
                            },
                            {
                                "target_lang_word": "empty",
                                "target_lang_sense_clarification": "to remove all contents from a vessel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bb6754c-a339-3cbf-85fd-b276437582b6",
                    "sense_definition": "Изготовить изделие из металла или другого материала с помощью литья.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "производство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завод <w>вылил</w> новую партию бронзовых деталей для памятника.",
                            "target_lang_translations": {
                                "en": "The factory <w>cast</w> a new batch of bronze parts for the monument."
                            }
                        },
                        {
                            "text": "Мастер решил <w>вылить</w> фигурку из чистого серебра.",
                            "target_lang_translations": {
                                "en": "The craftsman decided to <w>cast</w> a figurine out of pure silver."
                            }
                        }
                    ],
                    "synonyms": [
                        "отлить"
                    ],
                    "common_phrases": [
                        "вылить деталь",
                        "вылить форму"
                    ],
                    "target_lang_definitions": {
                        "en": "To manufacture an object by pouring molten material into a mold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "technical term for shaping metal or plastic in a mold"
                            },
                            {
                                "target_lang_word": "mold",
                                "target_lang_sense_clarification": "to shape material using a form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}