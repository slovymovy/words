                        "glosses": [
                            "Pratiquant ou pratiquante du jeu provençal."
                        ],
                        "tags": [
                            "Jeux de boules"
                        ],
                        "examples": [
                            {
                                "example_id": "942cd3fe-6646-4393-9e2a-2890d99a4ce2",
                                "sense_id": "5b4c5ec7-15cd-330b-adf8-1bbef51f0fe1",
                                "text": "Dont on sait qu’elle est précisément recherchée à grands pas de va-et-vient et de réflexion pour tout joueur, pétanqueur ou longuiste, qui se respecte."
                            },
                            {
                                "example_id": "fdb298d9-6d06-46d4-8cd4-6bc4a734e25f",
                                "sense_id": "5b4c5ec7-15cd-330b-adf8-1bbef51f0fe1",
                                "text": "De grands noms de longuistes et pétanqueurs ont pu ainsi rapidement émerger, permettant à la sélection nationale de tenir tête aux équipes les plus prestigieuses lors des multiples éditions du Championnat du monde."
                            },
                            {
                                "example_id": "e0a5c95f-c4e7-45e4-8f83-619635a01f95",
                                "sense_id": "5b4c5ec7-15cd-330b-adf8-1bbef51f0fe1",
                                "text": "Les longuistes, en doublette, se sont affrontés en toute convivialité durant trois jours, jusqu’à la finale ce lundi, sur le terrain du Bar Le Rivage"
                            }
                        ]
