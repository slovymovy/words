                    {
                        "translation_id": "b1a7e82a-b201-47db-8b37-b8bc4734e16b",
                        "source_entry_id": "33151ace-d2df-37e5-8791-fb397097d105",
                        "source_sense_description": "профессиональный наездник на скачках",
                        "target_lang_word": "jockey",
