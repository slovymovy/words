                "senses": [
                    {
                        "sense_id": "80b2edfb-e800-3cfa-b064-60af184492e5",
                        "entry_id": "f50a1a38-26c0-3bdd-9fa6-55e6f38d31ef",
                        "glosses": [
                            "Quader, quaderförmiger Körper oder quaderförmiger Hohlkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0e9f15-8941-4583-8f43-8ad6347d67d1",
                                "sense_id": "80b2edfb-e800-3cfa-b064-60af184492e5",
                                "text": "Ein Körper, bei dem die in jeder Ecke zusammenstoßenden Kanten rechtwinklig zueinander stehen, heißt Rechtkant."
                            },
                            {
                                "example_id": "0519d4d6-8445-43bb-b842-4576a1c23f8c",
                                "sense_id": "80b2edfb-e800-3cfa-b064-60af184492e5",
                                "text": "Der letzte Bestimmungsort ist der tavoliere, wo der Käse seine charakteristische Form als Rechtkant annimmt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c730e7f3-b14f-35ac-b828-fe082eaee292",
                        "entry_id": "f50a1a38-26c0-3bdd-9fa6-55e6f38d31ef",
                        "glosses": [
                            "Gebäude in einfacher kubischer Grundform ohne Ornament und Profilierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "865281ca-8467-4937-8124-cd7da92b647c",
                                "sense_id": "c730e7f3-b14f-35ac-b828-fe082eaee292",
                                "text": "Wir setzen gegen die Splitterästhetik des Dekonstruktivismus erneut den gestrafften Rechtkant."
                            },
                            {
                                "example_id": "72fa2d4b-b276-4546-93f8-97b1f8142f55",
                                "sense_id": "c730e7f3-b14f-35ac-b828-fe082eaee292",
                                "text": "Der weitgehend verschlossene Rechtkantbau bildete den eigentlichen Speicher."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
