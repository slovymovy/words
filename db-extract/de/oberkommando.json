                    }
                ],
                "senses": [
                    {
                        "sense_id": "720d011d-3933-3fb7-a8ae-418c6626e7eb",
                        "entry_id": "cf95d403-0431-3ed3-af3e-7ccb6e17a220",
                        "glosses": [
                            "oberste Führungsgewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968576ea-7716-4ca3-af5a-f95e71d28811",
                                "sense_id": "720d011d-3933-3fb7-a8ae-418c6626e7eb",
                                "text": "Wer hat das Oberkommando?"
                            },
                            {
                                "example_id": "7480f34e-cb23-461b-9be8-55a926b74eb1",
                                "sense_id": "720d011d-3933-3fb7-a8ae-418c6626e7eb",
                                "text": "„Im Spätsommer 1944 verlegte das Oberkommando der Wehrmacht seine Einheit in den Süden Russlands bis zur Krim.“"
                            },
                            {
                                "example_id": "7dc1d787-2939-4915-8a56-5551755b750f",
                                "sense_id": "720d011d-3933-3fb7-a8ae-418c6626e7eb",
                                "text": "„Sein strukturell vereinheitlichtes Heer, die Kontinuität und die Ausschließlichkeit seines Oberkommandos und sein Informationsmonopol erlaubten ihm koordinierte und längerfristige Planungen sowie überhaupt rationalere Formen der Kriegsführung.“"
                            },
                            {
                                "example_id": "86921670-713f-4426-a077-c2b955254981",
                                "sense_id": "720d011d-3933-3fb7-a8ae-418c6626e7eb",
                                "text": "„Brown hatte noch das Oberkommando über die Gilgit Agency inne, was in London schon in Vergessenheit geraten war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7200c85-685e-3cfa-ae2e-15d0d6551d18",
                        "entry_id": "cf95d403-0431-3ed3-af3e-7ccb6e17a220",
                        "glosses": [
                            "oberster Führungsstab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abdaf74c-b73e-49a5-ba66-bfd8ac098aea",
                                "sense_id": "d7200c85-685e-3cfa-ae2e-15d0d6551d18",
                                "text": "Er ist jetzt im Oberkommando."
                            },
                            {
                                "example_id": "e97ca6f2-311c-4d98-a597-053b99b55420",
                                "sense_id": "d7200c85-685e-3cfa-ae2e-15d0d6551d18",
                                "text": "„Von dem Erfolg bei Kursk befeuert, war das sowjetische Oberkommando mit Zuversicht und Kühnheit zur Offensive übergegangen.“"
                            },
                            {
                                "example_id": "fd29d3dd-fb5f-4281-93a8-bf12d27ad080",
                                "sense_id": "d7200c85-685e-3cfa-ae2e-15d0d6551d18",
                                "text": "„Am 17. August 1943 gab das Oberkommando der Wehrmacht die – natürlich planmäßige – Räumung der Insel Sizilien bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
