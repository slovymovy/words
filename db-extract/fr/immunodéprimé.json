                                        "sense_id": "8adf366d-f42b-3fc3-97f9-66ec9bfb2403",
                                        "entry_id": "24ff43b0-97a8-38d1-9a9e-897ac1d377ca",
                                        "glosses": [
                                            "Having an immune system that has been impaired by disease or treatment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c08e7c0-e9ee-4203-b8a0-bf73b54fc577",
                                                "sense_id": "8adf366d-f42b-3fc3-97f9-66ec9bfb2403",
                                                "text": "More than seven million adults in the United States, or about 3 percent, are characterized by health professionals as immunocompromised because of a disease, medication or other treatment that weakens their body’s immune response, meaning that diseases such as Covid-19 can be more deadly to them, and that vaccines offer less protection."
                                            }
                                        ]
                                    }
