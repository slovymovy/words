                        "entry_id": "fe775aea-36c4-3b37-88c4-70a120d6b1a8",
                        "glosses": [
                            "największe miasto Turcji, leżące nad Bosforem, na dwóch kontynentach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebaeb869-0e53-415d-a119-77cbdc65cccf",
                                "sense_id": "6616c0b7-42ad-33ba-bf6c-8bc9068bb11b",
                                "text": "Azjatycka część Stambułu stanowi sypialnię miasta."
                            },
                            {
                                "example_id": "6c8b028c-ce95-44c0-9a22-db57f90c5bdf",
                                "sense_id": "6616c0b7-42ad-33ba-bf6c-8bc9068bb11b",
                                "text": "Rozwiane minarety, • meczety, kopuły, • w liliowych jaszmakach drzemiące kobiety, • pachnące Stambuły…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
