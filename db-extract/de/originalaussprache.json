                "senses": [
                    {
                        "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                        "entry_id": "8dcb05ff-ded0-3065-a39f-0e246cf3243c",
                        "glosses": [
                            "Aussprache/Lautung von sprachlichen Einheiten in ihrer herkömmlichen/ursprünglichen, also nicht an das aufnehmende Sprachsystem angepassten Form"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "78354f01-46f1-4903-8eb6-a346f6660925",
                                "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                                "text": "„Eindeutschende Schreibungen, welche die Originalaussprache wiedergeben, hat es schon immer gegeben.“"
                            },
                            {
                                "example_id": "16782d2f-8391-430b-bb64-24c8e993c1ec",
                                "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                                "text": "„Der Hintergrund ist, dass die Koreaner durch die Übernahme der chinesischen Schrift auch die chinesische Originalaussprache der Schriftzeichen übernahmen und zum großen Teil beibehielten.“"
                            },
                            {
                                "example_id": "c0d3668c-d6cb-4d1c-9e8b-8f85c7cdcb13",
                                "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                                "text": "„Für englische Originalaussprachen werden in Übereinstimmung mit den Notationskonventionen von Wells (2009) die Transkriptionen [eɪ̯]/[əʊ̯] verwendet (…).“"
                            },
                            {
                                "example_id": "aa62015d-6ff6-4af3-8e07-d845acd003fa",
                                "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                                "text": "„Die Originalaussprache wird in der folgenden Übersicht nicht angegeben.“"
                            },
                            {
                                "example_id": "3d411b6d-2036-494c-876b-e27014c0535d",
                                "sense_id": "cb6e37b9-545c-3737-89d5-1bbb6be6453e",
                                "text": "„Er gilt als Shakespeare-Experte, der sich vor allem um die Originalaussprache seiner Werke verdient gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
