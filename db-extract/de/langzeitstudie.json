                "senses": [
                    {
                        "sense_id": "35523d98-eeeb-37ec-90eb-ccb625e55912",
                        "entry_id": "1046fa93-ecbd-3a9d-9d79-d093b3b9dbee",
                        "glosses": [
                            "wissenschaftliche Untersuchung, die die Entwicklung ihres Forschungsobjektes über eine längere Zeitperiode beobachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f2a1e0-bcd9-4290-85eb-5c3e76ffe82a",
                                "sense_id": "35523d98-eeeb-37ec-90eb-ccb625e55912",
                                "text": "„Von erheblichem Interesse sind Langzeitstudien wie Busse (1993) und Langner (1995), die die Entwicklung des Anglizismenbestandes im verbreitetsten deutschen Wörterbuch, dem Rechtschreibduden, über etwa hundert Jahre hinweg verfolgen.“"
                            },
                            {
                                "example_id": "20fa48e4-1fbb-4bec-8653-7aaffb723b44",
                                "sense_id": "35523d98-eeeb-37ec-90eb-ccb625e55912",
                                "text": "„Langzeitstudien über 3 Jahre sind selten.“"
                            },
                            {
                                "example_id": "2692cd12-c67e-46ee-bcd7-03e8b310a365",
                                "sense_id": "35523d98-eeeb-37ec-90eb-ccb625e55912",
                                "text": "„In einer Langzeitstudie in Neuseeland wollen Forscher beobachtet haben, dass geduldigere Schüler im Schnitt einen besseren Schulabschluss machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
