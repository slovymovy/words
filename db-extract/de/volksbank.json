                ],
                "senses": [
                    {
                        "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                        "entry_id": "4d306d03-d57c-397e-b794-baa2c85c70fb",
                        "glosses": [
                            "Bank, die die Rechtsform einer Genossenschaft oder Aktiengesellschaft hat und einer genossenschaftlichen Bankengruppe in Deutschland, Italien, Österreich oder der Schweiz angehört oder angehört hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895fd0e1-f4f5-40e3-8113-e792aebac5f4",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "Ich führe mein Konto bei einer Volksbank."
                            },
                            {
                                "example_id": "29a0bc54-4767-4cca-88fa-25f0996d2b2b",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "[Hieronymus Jaegen] „führte die neugegründete Trierer Volksbank in den 19 Jahren seiner Tätigkeit als Bankdirektor zu Erfolg und Prosperität.“"
                            },
                            {
                                "example_id": "1541b4fd-6473-447d-b02a-849ae5576de6",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Die Volksbank Eifel ist im vergangenen Jahr nach eigenen Angaben weiter gewachsen.“"
                            },
                            {
                                "example_id": "55fbdda4-770a-4aa1-b2fc-f6fc4a9242cd",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Die Volksbanken Main-Tauber und Vorbach-Tauber wollen fusionieren.“"
                            },
                            {
                                "example_id": "d562d15b-0ca4-4530-9f26-31f126bb530d",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Die Frankfurter Volksbank und die Taunus Sparkasse in Hessen haben angekündigt, ihre Filialen an insgesamt 50 Standorten bis Ende 2021 zusammenlegen zu wollen.“"
                            },
                            {
                                "example_id": "d0816a75-b63b-4fcf-b158-724cce41da6b",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Mit dem Zahlungskontengesetz […] werden alle Geldhäuser verpflichtet, Menschen ohne festen Wohnsitz auf Wunsch ein Basiskonto auf \"Guthabenbasis\" einzurichten. Solche Personen waren bisher nur von einigen Sparkassen und Volksbanken als Kunden akzeptiert worden.“"
                            },
                            {
                                "example_id": "c25a56e7-41a5-440f-999b-37ee5180c02f",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Deutschland, ein Land der Sparer. […] Nun aber hat die erste Volksbank in Bayern Negativzinsen angekündigt, andere könnten folgen. Das heißt: Das Geld auf dem Konto wird immer weniger.“"
                            },
                            {
                                "example_id": "18ca847d-8f4e-4c7f-9238-ae9c540346cd",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Nach der Sprengung eines Geldautomaten in der Volksbank in Saffig im Kreis Mayen-Koblenz hat die Polizei einen Experten angefordert. Die Täter sind nach Polizeiangaben auf der Flucht.“"
                            },
                            {
                                "example_id": "8999593a-5ecb-4ddf-bbd6-958dd3195cbb",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Besonders auffällig ist das Engagement der DZ Bank, ein Gemeinschaftsunternehmen der Volksbanken. Insgesamt 404 Millionen Dollar soll die DZ Bank an das Unternehmen Northrop Grumman, einen Rüstungshersteller aus den USA, gezahlt haben.“"
                            },
                            {
                                "example_id": "89395ce2-91a4-4bdb-853a-031ebbbd7a4b",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "„Im schönen Bari im Süden Italiens ist eine kleinere Volksbank zusammengebrochen: Die Banca Popolare die Bari braucht dringend viel Geld und die italienische Regierung springt ein.“"
                            },
                            {
                                "example_id": "dc5a66ff-42b9-40df-aab9-4a5bf7421bdf",
                                "sense_id": "f2cf6681-7965-3453-b52f-29e47ea72871",
                                "text": "[1872:] „Mehr als 30.000 Menschen wurden beim Bankrott der sogenannten „Dachauer Volksbank“ um ihre Ersparnisse gebracht, zahlreiche Existenzen wurden ruiniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
