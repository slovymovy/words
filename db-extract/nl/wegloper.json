                                            {
                                                "example_id": "e8ca34d6-39af-44a6-9a85-af0b4fda6354",
                                                "sense_id": "0ff18b44-462b-3403-bc79-c560ffaaae59",
                                                "text": "a runaway train"
                                            },
                                            {
                                                "example_id": "c96bc468-0e11-46e4-8daa-6306c9589bfa",
                                                "sense_id": "0ff18b44-462b-3403-bc79-c560ffaaae59",
                                                "text": "a runaway greenhouse effect"
                                            },
                                            {
                                                "example_id": "c9f1178e-9fbd-4fb1-a9f4-7e0a6fa3a52b",
                                                "sense_id": "0ff18b44-462b-3403-bc79-c560ffaaae59",
                                                "text": "These epics nearly always had runaway trains, nincompoops floundering with the controls and a collapsed bridge just ahead!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb2e12b3-bf28-3274-adb8-3cdff1a661ce",
                                        "entry_id": "1240e09c-a898-3d2b-862c-36ad03b2d237",
                                        "glosses": [
                                            "Unchecked; rampant."
                                        ],
