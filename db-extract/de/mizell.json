                ],
                "senses": [
                    {
                        "sense_id": "bfba3521-e07e-39e4-9ac5-8a7f42daba84",
                        "entry_id": "f76003fb-efb0-3c2c-ad2e-272090b5f247",
                        "glosses": [
                            "Aggregate (Assoziate) aus amphiphilen Molekülen bzw. grenzflächenaktiven Substanzen, die sich in einem Dispersionsmedium (meist Wasser) spontan zusammenlagern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f644e9-29c9-42c7-a077-62b1840c7ccd",
                                "sense_id": "bfba3521-e07e-39e4-9ac5-8a7f42daba84",
                                "text": "Wie an der Oberfläche der Mizelle Wasserteilchen durch Molekularattraktion festgehalten werden, so können sich ihnen auch andere Stoffe (Kalk- und Kieselsalze, Farbstoffe, stickstoffhaltige Verbindungen etc.) anlagern, nachdem sie in gelöstem Ustand in den organisierten Körper aufgenommen worden sind."
                            },
                            {
                                "example_id": "3d93e81a-6e4e-4ea5-bc07-d767d603fe3b",
                                "sense_id": "bfba3521-e07e-39e4-9ac5-8a7f42daba84",
                                "text": "Das bei der Quellung zuerst aufgenommene Wasser durchdringt das Innere des Mizells, es erleidet nachweislich eine Deformation (…)."
                            },
                            {
                                "example_id": "804d290c-befa-49e9-8d55-16f3765d2987",
                                "sense_id": "bfba3521-e07e-39e4-9ac5-8a7f42daba84",
                                "text": "In ganz kurzer Reichweite wirken Kräfte, die wahrscheinlich in ihrem Wesen gleich den krystallbildenden Kräften sind, die das Mizell zusammenhalten, solche Molekularkräfte ziehen einerseits die Teilchen zueinander, andererseits die Teilchen zu dem Dispersionsmittel, und ihnen begegnet man vermutlicherweise auch bei der Adsorption."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
