                    "frequency": "High",
                    "semantic_group_id": "months",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "My birthday is in <w>January</w>.",
                            "target_lang_translations": {
                                "ru": "Мой день рождения в <w>январе</w>.",
                                "nl": "Mijn verjaardag is in <w>januari</w>.",
                                "pl": "Moje urodziny są w <w>styczniu</w>.",
                                "de": "Mein Geburtstag ist im <w>Januar</w>.",
                                "fr": "Mon anniversaire est en <w>janvier</w>.",
                                "it": "Il mio compleanno è a <w>gennaio</w>.",
