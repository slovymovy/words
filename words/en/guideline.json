{
    "word_family": [
        "guide",
        "guidance",
        "guiding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b380bc9-48a5-38ff-af2d-898e84418775",
                    "sense_definition": "A non-specific rule or principle that provides direction to action or behavior.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave us a general <w>guideline</w> for the essay but let us choose our own topics.",
                            "target_lang_translations": {
                                "ru": "Учитель дал нам общие <w>рекомендации</w> по написанию эссе, но позволил самим выбрать темы.",
                                "zh": "老师给了我们关于论文的通用<w>指导方针</w>，但让我们自己选择题目。"
                            }
                        },
                        {
                            "text": "You should follow this rule of thumb as a basic <w>guideline</w> when cooking pasta.",
                            "target_lang_translations": {
                                "ru": "Вам следует придерживаться этого эмпирического правила как основного <w>ориентира</w> при варке пасты.",
                                "zh": "煮意面时，你应该把这个经验法则当作基本的<w>准则</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rule of thumb"
                    ],
                    "common_phrases": [
                        "basic guideline",
                        "follow the guideline",
                        "general guideline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестрогое правило или принцип, задающий направление действий или поведения.",
                        "zh": "非强制性的规则或原则，为行动或行为提供指导方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "совет по выполнению действий"
                            },
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "примерный принцип для действий"
                            },
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "общее направление или принцип"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指导方针",
                                "target_lang_sense_clarification": "用于指导行动的原则"
                            },
                            {
                                "target_lang_word": "准则",
                                "target_lang_sense_clarification": "行为或行动的参考标准"
                            },
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "非强制性的参考意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c546a84f-be86-30d0-974f-612bd047b449",
                    "sense_definition": "A plan or explanation used to set standards or determine a course of action.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government issued a new <w>guideline</w> to help businesses reduce their carbon emissions.",
                            "target_lang_translations": {
                                "ru": "Правительство выпустило новое <w>руководство</w>, чтобы помочь предприятиям сократить выбросы углекислого газа.",
                                "zh": "政府发布了一项新的<w>指导原则</w>，以帮助企业减少碳排放。"
                            }
                        },
                        {
                            "text": "The strict safety <w>guideline</w> was implemented to prevent any further accidents in the factory.",
                            "target_lang_translations": {
                                "ru": "Были введены строгие <w>нормативы</w> по технике безопасности, чтобы предотвратить дальнейшие несчастные случаи на заводе.",
                                "zh": "工厂实施了严格的安全<w>规范</w>，以防止再次发生事故。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rule of thumb"
                    ],
                    "common_phrases": [
                        "safety guideline",
                        "official guideline",
                        "government guideline"
                    ],
                    "target_lang_definitions": {
                        "ru": "План или разъяснение, используемые для установления стандартов или определения курса действий.",
                        "zh": "用于设定标准或确定行动方针的计划或说明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "официальные инструкции или правила"
                            },
                            {
                                "target_lang_word": "директива",
                                "target_lang_sense_clarification": "руководящее указание органа власти"
                            },
                            {
                                "target_lang_word": "инструкция",
                                "target_lang_sense_clarification": "свод правил для выполнения задачи"
                            },
                            {
                                "target_lang_word": "нормативы",
                                "target_lang_sense_clarification": "установленные стандарты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指导原则",
                                "target_lang_sense_clarification": "正式的行动依据"
                            },
                            {
                                "target_lang_word": "规范",
                                "target_lang_sense_clarification": "设定的标准或要求"
                            },
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "详细的说明或手册"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb972e6b-3d1e-3cb9-901c-c446a57319e8",
                    "sense_definition": "A light line used in lettering or drawing to help align text or objects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist drew a faint <w>guideline</w> in pencil before starting the calligraphy.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал карандашом слабую <w>направляющую</w>, прежде чем приступить к каллиграфии.",
                                "zh": "艺术家在开始书法创作前，先用铅笔画了一条淡淡的<w>辅助线</w>。"
                            }
                        },
                        {
                            "text": "Make sure your pencil <w>guideline</w> is light enough to erase after the ink dries.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что ваша карандашная <w>вспомогательная линия</w> достаточно светлая, чтобы её можно было стереть после высыхания чернил.",
                                "zh": "确保你的铅笔<w>基准线</w>足够浅，以便在墨水干后能擦掉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pencil guideline",
                        "faint guideline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая линия, используемая в черчении или рисовании для выравнивания текста или объектов.",
                        "zh": "在书写或绘图中用于对齐文字或物体的辅助细线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направляющая",
                                "target_lang_sense_clarification": "вспомогательная линия в рисовании"
                            },
                            {
                                "target_lang_word": "вспомогательная линия",
                                "target_lang_sense_clarification": "линия для разметки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅助线",
                                "target_lang_sense_clarification": "绘图时用于定位的线条"
                            },
                            {
                                "target_lang_word": "基准线",
                                "target_lang_sense_clarification": "用于对齐的参考线"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e60e0ec8-233a-3c4d-9287-a3f6913fe66f",
                    "sense_definition": "To provide or establish guidelines for a particular project or task.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee is currently <w>guidelining</w> the new project to ensure everyone follows the same standards.",
                            "target_lang_translations": {
                                "ru": "В настоящее время комитет <w>устанавливает ориентиры</w> для нового проекта, чтобы все следовали единым стандартам.",
                                "zh": "委员会目前正在为新项目<w>制定准则</w>，以确保每个人都遵循相同的标准。"
                            }
                        },
                        {
                            "text": "After <w>guidelining</w> the work, the team began the implementation phase of the strategy.",
                            "target_lang_translations": {
                                "ru": "После <w>разработки инструкций</w> к работе команда приступила к этапу реализации стратегии.",
                                "zh": "在为工作<w>提供指导</w>后，团队开始了战略的实施阶段。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guidelining the work",
                        "guidelining the process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять или устанавливать руководящие принципы для конкретного проекта или задачи.",
                        "zh": "为特定项目或任务提供或制定指导原则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устанавливать ориентиры",
                                "target_lang_sense_clarification": "задавать правила работы"
                            },
                            {
                                "target_lang_word": "разрабатывать инструкции",
                                "target_lang_sense_clarification": "создавать правила для процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制定准则",
                                "target_lang_sense_clarification": "为工作设定规则"
                            },
                            {
                                "target_lang_word": "提供指导",
                                "target_lang_sense_clarification": "为项目指明方向"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}