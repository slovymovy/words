                                "example_id": "a376b6fa-c973-4b91-a2c3-626683e05591",
                                "sense_id": "d4a89972-72d2-394d-b5c6-e2e1c1936af8",
                                "text": "L’automne […] a encore broui quelques feuilles."
                            }
                        ]
                    }
