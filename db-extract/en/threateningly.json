                            {
                                "example_id": "140442e8-9d50-423a-9f88-7087a3b4f0e9",
                                "sense_id": "dbf8ab47-a97c-3fd9-923d-ea50c2cb2c98",
                                "text": "He tried to glare threateningly, but how much of a threat can you be when you are naked AND tied to a bed?"
                            },
                            {
                                "example_id": "96c64b4d-fad0-4799-ac26-b72563d3971e",
                                "sense_id": "dbf8ab47-a97c-3fd9-923d-ea50c2cb2c98",
                                "text": "As the beasts surrounded her, chattering threateningly the while they goaded her with their cudgels and beat and kicked her with their fists and feet, she lay with closed eyes, praying for the merciful death that she knew alone could give her surcease from suffering[.]"
                            }
                        ]
                    }
