                "translations": [
                    {
                        "translation_id": "49e59ab8-a94c-4484-9075-e518ed850bd7",
                        "source_entry_id": "09326dfb-a961-337b-84e6-bc24d1fba7c2",
                        "source_sense_id": "84a173bb-7b56-31ab-a564-c10d2eb590a3",
                        "target_lang_word": "Algonkin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Algonkin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c48d84-eacd-32d5-ad7b-37b1d68c8126",
                                        "entry_id": "c50371ee-4f17-3f5a-b019-6061f2ccb904",
                                        "glosses": [
                                            "Angehöriger eines gleichnamigen, bis zum 17. Jahrhundert existierenden Indianerstammes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04447055-b09a-4236-8ebc-3bc645c3bdac",
                                                "sense_id": "a9c48d84-eacd-32d5-ad7b-37b1d68c8126",
                                                "text": "„Am Anfang, glaubten die Algonkin, lag die Oberfläche der Erde vollständig unter Wasser. Nirgendwo Land in Sicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Algonkin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd0ebc55-43a5-397c-9e89-85f4db96f164",
                                        "entry_id": "80585100-389d-396d-a6d4-45a4517e888e",
                                        "glosses": [
                                            "Sprachfamilie, die von den Ureinwohnern Nordamerikas gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111ce17e-7f77-4e87-9ef9-32ef6fb31b0c",
                                                "sense_id": "fd0ebc55-43a5-397c-9e89-85f4db96f164",
                                                "text": "„In dieser reichlich mit Seen, Flüssen und Bächen durchsetzten Landschaft lebten die Angehörigen zweier indianischer Sprachfamilien: die Algonkin sprechenden Völker befanden sich in der Überzahl gegenüber denjenigen Gruppen, die sich des Irokesischen bedienten.“"
                                            },
                                            {
                                                "example_id": "fcb8ca59-c25c-4801-8eb2-0465271bc8b9",
                                                "sense_id": "fd0ebc55-43a5-397c-9e89-85f4db96f164",
                                                "text": "„Neben seinem strategischen Geschick ist Smith wissbegierig und lernt Algonkin, die Sprache der Powhatan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
