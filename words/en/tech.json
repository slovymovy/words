                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника; специфический метод или навык, используемый для выполнения задачи.",
                        "zh": "技巧；用于完成任务的特定方法或技能。"
