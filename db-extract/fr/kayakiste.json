                                            {
                                                "example_id": "5012cd2e-23e8-40ff-ae17-b112f56a98c0",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "A kayaker who was thrown from his boat and was being swept towards Teddington Weir was saved from a possible \"fatal injury\" by a brave rescue lifeboat team."
                                            },
                                            {
                                                "example_id": "01e496aa-9bf9-405e-9fc0-b3d7dd3a2ef2",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "Kayaking out in pre-dawn darkness to catch the sunrise behind Turnip Rock is a special treat for experienced kayakers."
                                            }
                                        ]
                                    }
                                ]
                            }
