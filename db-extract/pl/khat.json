                                "target_senses": [
                                    {
                                        "sense_id": "c02ce995-cebc-3b31-bfe8-f504ada0c9ba",
                                        "entry_id": "bbae00f7-8668-399d-aff4-c857ee462e81",
                                        "glosses": [
                                            "A shrub, Catha edulis, whose leaves are used as a mild stimulant when chewed or brewed as tea; also a drug produced from this plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7a06d8-4d51-4d4c-88b6-e71a22bebdc7",
                                                "sense_id": "c02ce995-cebc-3b31-bfe8-f504ada0c9ba",
                                                "text": "‘And skinny Arab beggars who chew qat all day long to kill their appetites and get high on the weed.’"
                                            },
                                            {
                                                "example_id": "1069870e-025f-4799-8307-5c4ef760212a",
                                                "sense_id": "c02ce995-cebc-3b31-bfe8-f504ada0c9ba",
                                                "text": "Of course he was an amateur of quat – hashish – which delighted the cops."
                                            },
                                            {
                                                "example_id": "e439abad-6396-42c4-b874-31d9a6211a1c",
                                                "sense_id": "c02ce995-cebc-3b31-bfe8-f504ada0c9ba",
                                                "text": "They are chewing on khat, a small serrated, bitter leaf with remarkable stimulative properties. […] One of the great things about khat[…] is that after a good chew you need to do something—walking, running, chopping wood, vigorously reciting a poem, throwing a grenade, anything that requires boldness and physical initiative."
                                            },
                                            {
                                                "example_id": "3889a447-512d-407c-9c0e-300c54cd8f17",
                                                "sense_id": "c02ce995-cebc-3b31-bfe8-f504ada0c9ba",
                                                "text": "Habitually munching on narcotic leaves of khat, they are easy enough to spot, their gleaming Toyota four-wheel-drives slicing paths around beaten-up wheelbarrows and pushcarts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
