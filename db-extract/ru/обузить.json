                        "examples": [
                            {
                                "example_id": "95e89cfa-256a-46da-bbb8-7fdd65472735",
                                "sense_id": "d23de806-d265-3512-accd-5dddc1237c42",
                                "text": "Кафтан испорчен. Еремеевна, введи сюда мошенника Тришку. (Еремеевна отходит.) Он, вор, везде его обузил."
                            },
                            {
                                "example_id": "86970566-95d9-462e-ae2c-1daf64a05491",
                                "sense_id": "d23de806-d265-3512-accd-5dddc1237c42",
                                "text": "Достаточно было взять в магазине любой пиджак, укоротить и обузить у него рукава, и пиджак сразу становился модным."
                            }
                        ]
                    }
