                "senses": [
                    {
                        "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                        "entry_id": "1425d412-f80c-316f-8568-d4d1cda00c4f",
                        "glosses": [
                            "das Entfernen von Verschmutzungen in der Lüftungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b74552-b7b5-4bcb-bfb4-d40b6ee80625",
                                "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                                "text": "„Die Lüftungsreinigung ist erforderlich bei Dunstabzugsanlagen in der Gastronomie, in Industrie und Produktionsstätten, Wohnanlagen, Krankenhäusern, Bürogebäuden, Alten- und Pflegeheimen, Schulen, Kur- und Bäderanlagen, Sporteinrichtungen und allen öffentlichen und privaten Einrichtungen, in denen eine Lüftung existiert.“"
                            },
                            {
                                "example_id": "48efc8c4-afbc-4e2c-a2e4-26fd36843e23",
                                "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                                "text": "„Tatsache ist auch, dass es in NRW keine Pflicht zur Lüftungsreinigung von Bädern gibt und somit auch in der Regel eine Reinigung nicht durchgeführt wird.“"
                            },
                            {
                                "example_id": "278db81b-d84a-4807-9085-1aba5c8c976a",
                                "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                                "text": "„Wir lassen sie nicht unnötig lange warten und sind im Notfall darauf eingestellt, die Lüftungsreinigung und die Reinigung von RLT Anlagen schnell und unter Beachtung aller Vorgaben für Sie, auch außerhalb Ihrer Geschäftszeiten, zu erledigen.“"
                            },
                            {
                                "example_id": "e350e943-3057-4552-bd45-39b004343090",
                                "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                                "text": "„Für weitere Fragen betreffend der Lüftungsreinigungen in jeglicher Grössenordnung stehen wir Ihnen gerne zur Verfügung.“"
                            },
                            {
                                "example_id": "5de23640-a49b-4a49-811f-9c1c6c5a2890",
                                "sense_id": "90d533b9-89ae-39f3-9408-1eafb7202c20",
                                "text": "„Aufgrund der erst langsam steigenden Nachfrage nach Lüftungsreinigungen gibt es erst wenige Anbieter mit Erfahrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
