                        "glosses": [
                            "Qui, par son excellence, l’emporte sur le reste ; préexcellent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb4c147-07b7-4b6a-b385-88d92fb8eeb5",
                                "sense_id": "1cccc0e9-72aa-36ef-a0e7-ce5be23f1a8f",
                                "text": "La sainte Vierge est une créature unique, rare,\nD’une rareté infinie,\nEntre toutes précellente,\nUnique entre toutes les créatures."
                            },
                            {
                                "example_id": "978f6cad-f89b-4138-8228-59f9f62cedf0",
                                "sense_id": "1cccc0e9-72aa-36ef-a0e7-ce5be23f1a8f",
                                "text": "Ces poètes précellents ont reçu de Dieu des choses si vastes à exprimer que le monde entier leur est nécessaire pour suffire à leur œuvre."
                            }
                        ]
                    }
