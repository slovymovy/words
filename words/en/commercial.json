                    "target_lang_definitions": {
                        "ru": "Рекламное объявление, транслируемое по радио или телевидению.",
                        "tr": "Radyo veya televizyonda yayınlanan reklam filmi veya duyurusu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекла́ма",
