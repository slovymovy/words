                        "sense_id": "3f5bb4ba-2c2c-3ed4-b45c-dbf795eb7dd0",
                        "entry_id": "5d4eab2d-a1d2-38d1-ab23-66626d679204",
                        "glosses": [
                            "A bogey: a ghost, goblin, or other hostile supernatural creature, especially a small local spirit haunting gloomy places or the scenes of violence."
                        ],
                        "tags": [
                            "UK",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "693e20e7-0f77-4dfb-b411-399f1c465667",
                                "sense_id": "3f5bb4ba-2c2c-3ed4-b45c-dbf795eb7dd0",
                                "text": "A Boggarde, spectrum."
                            },
                            {
                                "example_id": "b01d1a26-afda-45c3-ba95-dcf3e834c9da",
                                "sense_id": "3f5bb4ba-2c2c-3ed4-b45c-dbf795eb7dd0",
                                "text": "He thinks every bush a boggard, i.e. a bugbear or phantasm."
                            },
                            {
                                "example_id": "937bf0e8-7a64-4eba-b24d-20f4aedcdca8",
                                "sense_id": "3f5bb4ba-2c2c-3ed4-b45c-dbf795eb7dd0",
                                "text": "Boggle, Boggart, a fearful object, a hobgoblin."
                            }
                        ]
                    },
                    {
                        "sense_id": "c402765d-05ce-3813-85e5-655f89891b23",
                        "entry_id": "5d4eab2d-a1d2-38d1-ab23-66626d679204",
                        "glosses": [
                            "A bugbear: any terrifying thing."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d3ad0ba-3420-4ddb-a746-8ae3ad7a3af0",
                                "sense_id": "c402765d-05ce-3813-85e5-655f89891b23",
                                "text": "Nor be such buggarddes to the poor, yff they may not beare the bagge alone."
                            },
                            {
                                "example_id": "8d92738c-854a-41cd-83f9-c0709b6589dc",
                                "sense_id": "c402765d-05ce-3813-85e5-655f89891b23",
                                "text": "Hell is but a boggarde to scarre children."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb35a766-8383-3015-ba06-196de091cd31",
                        "entry_id": "5d4eab2d-a1d2-38d1-ab23-66626d679204",
                        "glosses": [
                            "Any real or imagined thing which prompts a horse to boggle (take fright)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
