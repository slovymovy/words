                "translations": [
                    {
                        "translation_id": "03418d68-50e1-4e49-b250-b35c8953d503",
                        "source_entry_id": "5f8c992c-5851-3fdb-8aaf-1cfd24864b8a",
                        "source_sense_id": "0eb2affa-fe17-3dfd-9399-87ad68d26641",
                        "source_sense_description": "pertaining to or containing ashes",
                        "target_lang_word": "Urne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                        "entry_id": "24741792-bf5f-3678-b5d8-16ccf2bf2110",
                                        "glosses": [
                                            "Behältnis, in dem die Asche einer verbrannten Person aufbewahrt wird"
                                        ],
                                        "tags": [
                                            "Bestattung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0782aa-5e83-4d6c-a3d3-22f6b1681f97",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "Die Urne ihrer Großmutter stand auf dem Kamin."
                                            },
                                            {
                                                "example_id": "8065b473-20cf-4bb3-9528-d8d42c2c2443",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "Urnen können sowohl in der Erde bestattet als auch in geeigneten Räumen wie Urnenhainen aufbewahrt werden."
                                            },
                                            {
                                                "example_id": "e558de75-7816-4e75-890a-24084e1522c2",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Ich hob diese teuren Reste auf, verschloß sie in einer Urne und stellte diese in unser Haustabernakel, unter die Schwingen der Cherubim.“"
                                            },
                                            {
                                                "example_id": "92371c30-b706-4e1b-b816-fe11d73a3e01",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Die Urne bewahrte sie auf, stellte sie im Vorderzimmer auf den Kaminsims und füllte sie mit den langen Rispen des Strandhafers.“"
                                            },
                                            {
                                                "example_id": "2a33cda2-ba31-4030-9cf7-a5c76dcd93d0",
                                                "sense_id": "1f5f9bfd-e83c-33d4-bc25-85ec68f37049",
                                                "text": "„Darauf ergriff Bouvard die beiden Urnen, die mit Erde gefüllt waren – was menschliche Asche sei –, dann hielt er das Fläschchen an seine Augen, um zu zeigen, wie die Römer ihre Tränen hineinfließen ließen .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                        "entry_id": "24741792-bf5f-3678-b5d8-16ccf2bf2110",
                                        "glosses": [
                                            "Behältnis, in dem die Stimmzettel gesammelt werden"
                                        ],
                                        "tags": [
                                            "Wahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef0b222-f382-4794-b15e-fbee389c773d",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "Aus Protest zerriss er demonstrativ seinen Wahlzettel und stieß die Urne um."
                                            },
                                            {
                                                "example_id": "344b6375-7356-4b60-9005-d6adfc020d07",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "Die Urne sollte während der Wahl nie unbeaufsichtigt gelassen werden."
                                            },
                                            {
                                                "example_id": "e789896f-d91f-4e42-93b3-31a6579a8442",
                                                "sense_id": "013f327c-43d9-3737-b8c9-99f743fcc442",
                                                "text": "„Egal mit wem wir sprechen, niemand glaubt, dass sich nach der Wahl etwas ändert. Also, warum überhaupt zur Urne gehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
