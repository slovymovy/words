                    {
                        "translation_id": "7f59b2ad-2134-42a6-b706-a982477ee1b6",
                        "source_entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "target_lang_word": "Arkade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arkade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                        "entry_id": "7c6e44d9-214a-313a-a1bc-397f8c4fe951",
                                        "glosses": [
                                            "ein Bogen, der von Säulen oder Pfeilern gestützt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60c0ba8-fb97-4e10-a2ee-058e8fe93f14",
                                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                                "text": "„Die mittlere Arkade wurde nach französischer Art als Durchgang durch die gewöhnlich geschlossene Tür zum Klerikerchor verwendet.“"
                                            },
                                            {
                                                "example_id": "5c4fab57-bac2-4ab4-8508-bcbf215cb391",
                                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                                "text": "„Unter einer Arkade stand eine sehr müde alte Frau und bot ein paar Wiesenblumen zum Verkauf an.“"
                                            },
                                            {
                                                "example_id": "c1c50ea2-c27f-48ce-8ece-8d740e81fe07",
                                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                                "text": "„Ich wandte mich ab; er folgte mir und bat mich, ich möge doch in die gegenüberliegende Arkade gehen, dort würde er seine Maske abnehmen.“"
                                            },
                                            {
                                                "example_id": "d97d9e87-ce9c-47ba-b94c-dce24b5877bf",
                                                "sense_id": "92d8053a-477a-3e1a-bdb0-39866091e364",
                                                "text": "„Sie gingen durch die Arkaden des Palais.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "934a3f3d-8110-3b0f-a6a8-cd4428183e1a",
                                        "entry_id": "7c6e44d9-214a-313a-a1bc-397f8c4fe951",
                                        "glosses": [
                                            "eine Reihe von Bogen, die von Säulen und Pfeilern gestützt werden und unter denen man geschützt herlaufen kann"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15ee18f-e314-4fae-b1bc-cfa10ee1987d",
                                                "sense_id": "934a3f3d-8110-3b0f-a6a8-cd4428183e1a",
                                                "text": "Wir machen unter den Arkaden einen Einkaufsbummel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "889f7825-51e6-45b7-858c-5d2de633382e",
                        "source_entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "target_lang_word": "arkada",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arkada",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c631e1-5dde-3202-b9c0-40c3cdf8d0c7",
                                        "entry_id": "a2c7d5c0-fb98-3155-894a-498f892dce40",
                                        "glosses": [
                                            "kompozycja składająca się z łuku opartego na kolumnach lub filarach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e181651-04d3-4a98-bbca-c28541b5612d",
                                                "sense_id": "d8c631e1-5dde-3202-b9c0-40c3cdf8d0c7",
                                                "text": "Nawy oddzielone są od siebie arkadami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74969c07-ea95-4ee1-8c5a-8f2782abac9a",
                        "source_entry_id": "e2f29892-a3b2-3afb-a44c-8404104bd303",
                        "target_lang_word": "arcade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "320ed706-f774-3427-8070-f00a7ee25301",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Ensemble composé d’un arc et des montants qui le soutiennent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea4e823-e7f5-4b0c-984c-66ca62f69d3c",
                                                "sense_id": "320ed706-f774-3427-8070-f00a7ee25301",
                                                "text": "À ce cri, un officier […] s’avança jusqu’à l’arcade du jardin, reconnut la jeune personne un moment cachée […]"
                                            },
                                            {
                                                "example_id": "4df6f6fe-fd88-410d-8500-2237efed79cb",
                                                "sense_id": "320ed706-f774-3427-8070-f00a7ee25301",
                                                "text": "Agadem, qu'il ne faut pas confondre avec Agadès, capitale de l'Aïr, est un ancien fortin abandonné, du type classique à cour intérieure, avec bâtiments donnant sur le puits et arcades en forme de cloître ; le fort est en ruine, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb60704-be53-324f-b02e-5a5ce1f2d7b2",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Partie haute des barreaux des balcons ou des rampes ayant la forme d’un demi-cercle ou d’une ogive, ce qui leur fait donner le nom de rampes ou balcons à arcade."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97003d73-7296-339b-877c-73c2d823b713",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Portique composé d’arcades."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec45f31-c000-4b38-ac71-95091d65a8e3",
                                                "sense_id": "97003d73-7296-339b-877c-73c2d823b713",
                                                "text": "Les arcades du Palais-Royal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f8ba25-579e-3284-a61e-1317a8238a05",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Partie courbée en arc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818ec694-55ea-447b-83cb-6fe0879de6bf",
                                                "sense_id": "31f8ba25-579e-3284-a61e-1317a8238a05",
                                                "text": "L’arcade temporale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfa1eb1-b05d-3951-bbdc-aa63d7b155be",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Arcade sourcilière."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e5fed4a-8493-45ab-89b8-9f33f57712f5",
                                                "sense_id": "ecfa1eb1-b05d-3951-bbdc-aa63d7b155be",
                                                "text": "La beauté de son front prophétique provenait surtout de la coupe extrêmement pure des deux arcades sous lesquelles brillait son œil noir, qui semblaient taillées dans l’albâtre, et dont les lignes, par un attrait assez rare, se trouvaient d’un parallélisme parfait en se rejoignant à la naissance du nez."
                                            },
                                            {
                                                "example_id": "b2e6e310-1fe0-444f-8730-d26b23789034",
                                                "sense_id": "ecfa1eb1-b05d-3951-bbdc-aa63d7b155be",
                                                "text": "C’était un homme de belle prestance, blond, l’œil profondément enfoncé sous l’arcade, le nez camard, les pointes de la moustache relevées à angle droit, et de longues mains blanches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94cdf120-d359-3423-8535-617d8980d22b",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Lieu public où l’on peut jouer à des jeux (anciennement mécaniques, de nos jours vidéo)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00853d01-233c-4f58-ba54-be004950ebec",
                                                "sense_id": "94cdf120-d359-3423-8535-617d8980d22b",
                                                "text": "De fait, le genre de jeu à défilement vertical constitue aujourd'hui encore une tradition vivante de l’arcade, au Japon en particulier, avec les jeux de shoot them up, dont le principe consiste à diriger un vaisseau tout en évitant une multitude toujours croissante d'ennemis et de projectiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49687b22-6afa-3310-b631-eea578933526",
                                        "entry_id": "3d68aaac-0665-30ac-9c21-45c51870eeb4",
                                        "glosses": [
                                            "Fil de chanvre composé de 10 à 12 brins."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
