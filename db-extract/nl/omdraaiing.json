                "senses": [
                    {
                        "sense_id": "cf032dcc-0ab8-35da-934e-d97f39490cb8",
                        "entry_id": "fd954afd-4b94-395f-bafa-e7e27301a59a",
                        "glosses": [
                            "verandering waarbij iets een halve slag om zijn as wentelt, rotatie van 180°"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fcb146-e99a-4a5f-abc8-f37b4f9cbb22",
                                "sense_id": "cf032dcc-0ab8-35da-934e-d97f39490cb8",
                                "text": "Zo’n omdraaiing van het magnetisch veld gebeurt gemiddeld eens in de 450.000 jaar, de laatste keer was 780.000 jaar geleden."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cd31799-524f-3584-a3af-8544354e9454",
                        "entry_id": "fd954afd-4b94-395f-bafa-e7e27301a59a",
                        "glosses": [
                            "omkering van een volgorde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce96238-53c2-46d1-af7b-b80eb4e5b7f5",
                                "sense_id": "2cd31799-524f-3584-a3af-8544354e9454",
                                "text": "Gezze is een omdraaiing van zegge(n)."
                            },
                            {
                                "example_id": "f7675bea-8b3d-4b5f-ace3-902bcff81aad",
                                "sense_id": "2cd31799-524f-3584-a3af-8544354e9454",
                                "text": "Omdraaiingen in bijvoorbeeld telefoonnummers en geboortedata komen dan ook veelvuldig voor."
                            }
                        ]
                    },
                    {
                        "sense_id": "21116461-1d77-3425-a419-83fd7f9c2818",
                        "entry_id": "fd954afd-4b94-395f-bafa-e7e27301a59a",
                        "glosses": [
                            "eenvoudige verandering waardoor een toestand of redenering opeens een tegenovergesteld resultaat oplevert"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e474a903-1d12-4afc-a59e-5bc91194cfb5",
                                "sense_id": "21116461-1d77-3425-a419-83fd7f9c2818",
                                "text": "Het scenario blijft daarbij wat een de ‘magere’ kant. Eén langgerekte grap die draait om de omdraaiing dik is goed, dun is slecht."
                            },
                            {
                                "example_id": "f99bb500-442a-4d47-82e5-20c1512d7a79",
                                "sense_id": "21116461-1d77-3425-a419-83fd7f9c2818",
                                "text": "De nummers waarbij zangeres Audrey Gbaguidi op de voorgrond trad, zorgden voor een verrassende omdraaiing van de afrobeat die traditioneel door achtergrondzangeressen wordt opgevrolijkt. In Allens versie klonk er nu een laag brommend mannelijk achtergrondkoor."
                            }
                        ]
                    }
