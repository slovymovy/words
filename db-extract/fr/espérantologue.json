                "senses": [
                    {
                        "sense_id": "5b611f53-07bf-39f9-af8f-9da4bc27a1dd",
                        "entry_id": "399a52df-c8da-32c7-8c7e-7e66fa4447f0",
                        "glosses": [
                            "Spécialiste de l’espéranto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253b42d2-8145-4711-a02f-ca069b24f13b",
                                "sense_id": "5b611f53-07bf-39f9-af8f-9da4bc27a1dd",
                                "text": "Des ornières d’où cette langue cherche un peu à sortir en passant aujourd’hui par les nouvelles technologies et l’Internet pour se donner une nouvelle jeunesse, indique l’espérantologue montréalais."
                            },
                            {
                                "example_id": "59ebc32c-90f7-4655-9b25-90ce5a7aab27",
                                "sense_id": "5b611f53-07bf-39f9-af8f-9da4bc27a1dd",
                                "text": "Wüster étudia quant à lui l’espéranto dès l’adolescence et fut espérantiste puis « espérantologue » avant d’être « terminologue »."
                            },
                            {
                                "example_id": "fee7de3c-7269-4bac-bdf9-982a8b61c378",
                                "sense_id": "5b611f53-07bf-39f9-af8f-9da4bc27a1dd",
                                "text": "C’est ce qu’affirme l’espérantologue allemand Detlev Blanke."
                            }
                        ]
                    }
                ],
