                                    {
                                        "sense_id": "2c301c04-6ec1-3282-b12f-3241b79c63cc",
                                        "entry_id": "0fcc1a56-5a74-362b-9b94-2bd463d36764",
                                        "glosses": [
                                            "het onhandig en ongeoefend zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0753f4b-2576-4b13-8021-3a13d08f7e7e",
                                                "sense_id": "2c301c04-6ec1-3282-b12f-3241b79c63cc",
                                                "text": "Ik dook terug in mijn stoel en luisterde verstomd toe hoe Conybeare de plesiosaurus vergeleek met een schildpad zonder schelp en speculeerde over zijn onbeholpenheid, zowel op land als in zee."
                                            },
                                            {
                                                "example_id": "12064242-3093-4631-a8f6-00f8dde422d6",
                                                "sense_id": "2c301c04-6ec1-3282-b12f-3241b79c63cc",
                                                "text": "Hoewel de Inuit zijn leergierigheid waardeerden, merkte Tinbergen dat men zijn onbeholpenheid dolkomisch vond. Bij zijn eerste kajakles liep het halve dorp uit om hem in het water te zien belanden. Hij leerde het vlot, volgens eigen zeggen omdat balanceren in een kajak hem aan fietsen deed denken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12765e8d-eedd-3994-a437-a013a0218a5c",
                                        "entry_id": "0fcc1a56-5a74-362b-9b94-2bd463d36764",
                                        "glosses": [
                                            "iets wat past bij een onhandig en ongeoefend persoon"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14f8025c-1692-4123-aad5-4aafc30e3046",
                        "source_entry_id": "f6874087-03ce-3ddb-93a5-ddf38e6f8aed",
                        "source_sense_description": "the state or quality of being awkward",
                        "target_lang_word": "onhandigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onhandigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "519c1110-bbc1-3a33-9ec3-6695b54da5de",
                                        "entry_id": "f84ab163-b9fa-380d-9898-8c9a7459f05c",
                                        "glosses": [
                                            "de mate waarin iemand iets op een moeilijke, omslachtige, of gebrekkige manier doet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6070011a-8962-4cac-a031-c8675fc3ffdf",
                                                "sense_id": "519c1110-bbc1-3a33-9ec3-6695b54da5de",
                                                "text": "Maar zijn verstrooidheid, zijn onhandigheid bij het binnenkomen van een salon en het converseren werden goedgemaakt door zijn goedhartige, eenvoudige en bescheiden voorkomen."
                                            },
                                            {
                                                "example_id": "d141bbc8-c521-4755-9209-7b878056b8cf",
                                                "sense_id": "519c1110-bbc1-3a33-9ec3-6695b54da5de",
                                                "text": "Maar de waardering voor zijn inzet kelderde vervolgens ook weer, vooral door zijn sociale onhandigheid. Zo sprak hij na een voor Nederlandse begrippen forse aardbeving in het voorjaar van 2019 over \"een bevinkje\". Dat werd hem tot in Den Haag zeer kwalijk genomen. Ook premier Rutte was not amused. Een verspreking moet kunnen, zei de VVD-leider. \"Maar deze was echt wel heel ongelukkig.\" Wiebes maakte excuses voor de pijnlijke uitglijder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6571344-263a-3710-92c3-987644d038a5",
                                        "entry_id": "f84ab163-b9fa-380d-9898-8c9a7459f05c",
                                        "glosses": [
                                            "iets wat moeilijk, omslachtig of gebrekkig gebeurt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bae89a23-016e-4a4e-b639-3c09bf7d6986",
                        "source_entry_id": "f6874087-03ce-3ddb-93a5-ddf38e6f8aed",
                        "source_sense_description": "the state or quality of being awkward",
                        "target_lang_word": "maladresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ca0feab-b2a6-32f8-8335-3516d4dce2ea",
                                        "entry_id": "60defa44-8068-3439-a2cd-8a0115fa650f",
                                        "glosses": [
                                            "Défaut d’adresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edff19f-49e3-4b15-8933-89a64a695038",
                                                "sense_id": "2ca0feab-b2a6-32f8-8335-3516d4dce2ea",
                                                "text": "Cette personne est d’une si grande maladresse qu’elle ne peut toucher à rien sans le briser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c466ae-6b99-327a-bd05-2899aff7219f",
                                        "entry_id": "60defa44-8068-3439-a2cd-8a0115fa650f",
                                        "glosses": [
                                            "Manque de savoir-faire ou manque d'habileté à bien faire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1482ad5-3974-453e-952e-cfe60d81816f",
                                                "sense_id": "c3c466ae-6b99-327a-bd05-2899aff7219f",
                                                "text": "[…], il devenait taciturne, maussade, ne répondait qu’avec difficulté aux questions qu’elle lui adressait et avec cette maladresse habituelle aux amoureux peu aguerris, il saisissait le premier prétexte venu pour la quitter."
                                            },
                                            {
                                                "example_id": "9e6aacea-d90a-40d9-bddf-6a67917ac7a3",
                                                "sense_id": "c3c466ae-6b99-327a-bd05-2899aff7219f",
                                                "text": "Dernièrement, j’avais eu la maladresse de m’enrhumer en pleine chaleur. Voilà pourtant ce que c'est que de devenir vieux : on ne peut résister à rien."
                                            },
                                            {
                                                "example_id": "3e81bfe7-a515-4811-b974-797c65285ad7",
                                                "sense_id": "c3c466ae-6b99-327a-bd05-2899aff7219f",
                                                "text": "Chez les écolos, l’erreur de distribution n’est pas un accident électoral, c’est une seconde nature. Cette maladresse congénitale finirait par les rendre sympathiques […]."
                                            },
                                            {
                                                "example_id": "532d3d75-4153-43fa-8b26-5e5d914eb9d5",
                                                "sense_id": "c3c466ae-6b99-327a-bd05-2899aff7219f",
                                                "text": "Les multirécidivistes sont paranos, […]. À chaque fois qu’ils tombent, ils analysent en détail le dossier judiciaire pour connaître ce qui leur a été fatal, apprenant de leurs maladresses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6b835f2-e9ca-4e5d-9295-9b7c37e41611",
