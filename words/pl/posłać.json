    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ca6ca84-8afd-35b6-9e3f-389ecc64d54e",
                    "sense_definition": "nadać lub przekazać coś za czyimś pośrednictwem, na przykład list albo paczkę; aspekt dokonany od <w>posyłać</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "send",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj rano <w>posłałem</w> ważny list polecony do urzędu skarbowego.",
                            "target_lang_translations": {
                                "en": "Yesterday morning I <w>sent</w> an important registered letter to the tax office."
                            }
                        },
                        {
                            "text": "Czy mogłabyś sprawdzić, czy kurier odebrał już przesyłkę, którą mu <w>posłałam</w>?",
                            "target_lang_translations": {
                                "en": "Could you check if the courier has already picked up the package I <w>sent</w> him?"
                            }
                        }
                    ],
                    "synonyms": [
                        "wysłać",
                        "nadać"
                    ],
                    "antonyms": [
                        "odebrać"
                    ],
                    "common_phrases": [
                        "posłać list",
                        "posłać paczkę"
                    ],
                    "target_lang_definitions": {
                        "en": "to send or dispatch something through someone or via a service (e.g. a letter or package)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "send",
                                "target_lang_sense_clarification": "a letter, parcel, or message"
                            },
                            {
                                "target_lang_word": "dispatch",
                                "target_lang_sense_clarification": "mail or goods"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c34c8a4f-256f-3009-98b0-a290839fada2",
                    "sense_definition": "uporządkować lub przygotować miejsce do spania; aspekt dokonany od <w>słać</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko starannie <w>posłało</w> łóżko przed wyjściem do szkoły.",
                            "target_lang_translations": {
                                "en": "The child neatly <w>made</w> the bed before leaving for school."
                            }
                        },
                        {
                            "text": "Zaraz po wstaniu z materaca szybko <w>pościelę</w> pościel w sypialni.",
                            "target_lang_translations": {
                                "en": "Right after getting off the mattress, I will quickly <w>make</w> the bed in the bedroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "pościelić"
                    ],
                    "antonyms": [
                        "rozgrzebać"
                    ],
                    "common_phrases": [
                        "posłać łóżko"
                    ],
                    "target_lang_definitions": {
                        "en": "to make or tidy up a bed for sleeping"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "a bed"
                            },
                            {
                                "target_lang_word": "make the bed",
                                "target_lang_sense_clarification": "arrange bedding neatly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43fa1cdf-ad56-313f-a769-e9e790130cf8",
                    "sense_definition": "nakazać komuś udać się w określone miejsce w konkretnym celu, na przykład do szkoły lub po zakupy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "send",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rodzice zdecydowali, że od września <w>poślą</w> syna do nowej szkoły.",
                            "target_lang_translations": {
                                "en": "The parents decided that in September they would <w>send</w> their son to a new school."
                            }
                        },
                        {
                            "text": "Mama <w>posłała</w> młodszego brata do pobliskiego sklepu po świeży chleb.",
                            "target_lang_translations": {
                                "en": "Mom <w>sent</w> my younger brother to the nearby store for fresh bread."
                            }
                        }
                    ],
                    "synonyms": [
                        "wysłać",
                        "oddelegować"
                    ],
                    "antonyms": [
                        "zatrzymać"
                    ],
                    "common_phrases": [
                        "posłać do szkoły",
                        "posłać po lekarza"
                    ],
                    "target_lang_definitions": {
                        "en": "to send someone somewhere for a specific purpose (such as to school or on an errand)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "send",
                                "target_lang_sense_clarification": "a person to a place or for an errand"
                            }
                        ]
                    }
                }
            ]
        }
    ]
