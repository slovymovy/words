                            {
                                "example_id": "dade93b7-4e02-4c58-999d-27aecf6e18c0",
                                "sense_id": "51422052-f53b-3d0a-b069-518675b86995",
                                "text": "Of een koe buitenkomt, hangt af van de boer. Kleine boeren laten hun melkkoeien vaker grazen dan grote bedrijven."
                            },
                            {
                                "example_id": "74ab66c1-f870-403f-96b1-7b6ebf529243",
                                "sense_id": "51422052-f53b-3d0a-b069-518675b86995",
                                "text": "Heel logisch, want ze denken allemaal dat ik een zonderling ben die nooit buitenkomt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b092cd4-cbb5-3d35-9530-97a172859eff",
                        "entry_id": "9526c358-fdc1-35c4-b877-3a9b50954df6",
                        "glosses": [
                            "uit de gevangenis komen na een tijd gevangen gezeten te hebben"
                        ],
