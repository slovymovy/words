                            {
                                "target_lang_word": "сражение",
                                "target_lang_sense_clarification": "боевое столкновение войск"
                            },
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "вооруженное столкновение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce279b5a-4df0-37a3-8914-ee5f7f90bb23",
                    "sense_definition": "A sustained effort or struggle against a difficult situation or opposition.",
