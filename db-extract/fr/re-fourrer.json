                "senses": [
                    {
                        "sense_id": "b5b9f501-8225-3bd3-a3ff-43ac018d124b",
                        "entry_id": "89a41ea3-1632-3426-8b37-fd4b541a003d",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de refourrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58fc1c0c-b80f-464a-84de-ba0b2635c3f2",
                                "sense_id": "b5b9f501-8225-3bd3-a3ff-43ac018d124b",
                                "text": "Il lui arrive même de se retirer afin de maîtriser la chose, et puis il se re-fourre à l'intérieur quand il est calme."
                            },
                            {
                                "example_id": "0da9d67d-4e5e-4271-8031-e8ee71bdaaa9",
                                "sense_id": "b5b9f501-8225-3bd3-a3ff-43ac018d124b",
                                "text": "Lui, il ne la rejoignit pas mais se re-fourra dans la peluche grise."
                            },
                            {
                                "example_id": "763bbb5f-02c9-4191-a68c-e077e492d220",
                                "sense_id": "b5b9f501-8225-3bd3-a3ff-43ac018d124b",
                                "text": "Il re-fourre le goulot de la bouteille dans sa bouche, et le suce un petit moment."
                            }
                        ]
                    }
