            {
                "entry_id": "7daf80f5-e00c-3e4a-bcdf-8c1a90285169",
                "word": "Luo",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "767553dd-dcc1-3466-a827-43de72828294",
                        "entry_id": "7daf80f5-e00c-3e4a-bcdf-8c1a90285169",
                        "glosses": [
                            "A river in Shaanxi, China, tributary to the Wei."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1af4e3de-ffb6-3c4a-8d58-e111cf2d98c0",
                        "entry_id": "7daf80f5-e00c-3e4a-bcdf-8c1a90285169",
                        "glosses": [
                            "A river in Henan, China, tributary to the Yellow River."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15907319-6a97-4c96-ac81-692807dc21e9",
                                "sense_id": "1af4e3de-ffb6-3c4a-8d58-e111cf2d98c0",
                                "text": "The remains of the capital of the Eastern Han dynasty, Luoyang 洛阳, are situated approximately 15 km east of the present-day city of Luoyang in Henan. Since the site is bordered on the north by the Mangshan 邙山 (Mángshān) Mountains and overlooks the Luo River to the south, it has protective natural barriers and is also at an important junction for transportation and communication (fig. 37)."
                            },
                            {
                                "example_id": "1ac7de2a-3492-47d7-a7f3-9d3d26720f76",
                                "sense_id": "1af4e3de-ffb6-3c4a-8d58-e111cf2d98c0",
                                "text": "Several dozen animals have died and villagers are suffering nausea and dizziness after a massive spill of cyanide into the Luo River in Henan province."
                            },
                            {
                                "example_id": "be2be6f2-7d64-473e-aa94-208d39dbc7f4",
                                "sense_id": "1af4e3de-ffb6-3c4a-8d58-e111cf2d98c0",
                                "text": "A tributary of the Yellow River, the Luo River runs through Luoyang as well as several other ancient Chinese cities."
                            }
                        ]
                    },
