                "senses": [
                    {
                        "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                        "entry_id": "24a58bc3-ac57-3932-a45d-7d4df3551cac",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in etwas, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61bba891-80f7-487f-85fb-4acae7daf08f",
                                "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                                "text": "„Denn auf Grund der wachsenden Siedlung rund um die Bunkerkapelle reichte diese mittlerweile für die Gemeinde nicht mehr aus.“"
                            },
                            {
                                "example_id": "ad5b9b93-7019-4fe9-8cd0-1185b419cf5c",
                                "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                                "text": "„Auch die in einem kleinen Wäldchen befindliche Bunkerkapelle bietet ein interessantes Ziel.“"
                            },
                            {
                                "example_id": "a40a2403-17ed-4136-9285-380351838c7f",
                                "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                                "text": "„Was einmal die Bunkerkapelle gewesen war, entpuppte sich nun als das perverse Abbild eines Gotteshauses.“"
                            },
                            {
                                "example_id": "80afee60-a7e8-4028-b815-705e2c5fc95a",
                                "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                                "text": "„August 1949. Zunächst wird eine Bunkerkapelle errichtet.“"
                            },
                            {
                                "example_id": "df0e4308-c32d-4579-96d8-4931a6beaff5",
                                "sense_id": "311f32b0-3e29-34cd-abe8-5a1b7b419ece",
                                "text": "„Auch die in einem kleinen Wäldchen befindliche Bunkerkapelle bietet ein interessantes Ziel.“"
