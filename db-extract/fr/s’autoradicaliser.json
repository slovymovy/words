                ],
                "senses": [
                    {
                        "sense_id": "efb9d9be-bc54-3f0c-9ed5-6b7bef159aab",
                        "entry_id": "ed9bced7-875e-31a4-9400-208c2321d80e",
                        "glosses": [
                            "Se radicaliser de soi-même, par un processus naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2565bc6-d4a9-4751-bdcb-a216b071bb61",
                                "sense_id": "efb9d9be-bc54-3f0c-9ed5-6b7bef159aab",
                                "text": "Dans leur isolement, ils finissent par s'autoradicaliser et, parfois, par basculer dans la violence aveugle."
                            },
                            {
                                "example_id": "ddaca7ea-f46a-4c66-8d35-54eafef34db4",
                                "sense_id": "efb9d9be-bc54-3f0c-9ed5-6b7bef159aab",
                                "text": "Un individu peut, le soir chez lui, s'autoradicaliser via Internet et entrer en contact avec des membres haut placés des organisations terroristes."
                            },
                            {
                                "example_id": "ccd93e3f-df3c-49fc-9b53-abd46ca88d7a",
                                "sense_id": "efb9d9be-bc54-3f0c-9ed5-6b7bef159aab",
                                "text": "Il est attendu que les différentes filiales de la nébuleuse d’Al-Qaîda, comme l’Aqmi, ou les shababs de Somalie s’autoradicalisent et continuent l’œuvre destructrice de leur parrain."
                            }
                        ]
                    }
