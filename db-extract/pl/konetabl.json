                "senses": [
                    {
                        "sense_id": "58d238b5-a659-3833-b023-f023af2bd8af",
                        "entry_id": "123eebe3-0ae1-3dfa-b3e5-13984150f71f",
                        "glosses": [
                            "w średniowiecznej i renesansowej Francji: tytuł naczelnego wodza królewskich wojsk"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d9c3392e-31ad-3440-9c96-98be4e2baabb",
                        "entry_id": "123eebe3-0ae1-3dfa-b3e5-13984150f71f",
                        "glosses": [
                            "człowiek z tytułem konetabla (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f793635-3b81-4407-9a68-c58336f6ec09",
                                "sense_id": "d9c3392e-31ad-3440-9c96-98be4e2baabb",
                                "text": "Celem Henryka było Calais, główna angielska baza na kontynencie. Droga była jednak daleka, a do Henryka dochodziły wieści o marszu potężnej armii francuskiej pod wodzą konetabla Karola d’Albret"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df5429fe-c2e3-46ce-860e-309b1cd82b8c",
                        "source_entry_id": "123eebe3-0ae1-3dfa-b3e5-13984150f71f",
                        "source_sense_id": "58d238b5-a659-3833-b023-f023af2bd8af",
                        "target_lang_word": "constable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0fdb8e-e183-3a2c-bab3-7d7320d59f65",
                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "One holding the lowest rank in most Commonwealth police forces. (See also chief constable.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6376fcb8-0a00-4b23-b8b2-89c156a360a3",
                                                "sense_id": "bb0fdb8e-e183-3a2c-bab3-7d7320d59f65",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45235174-1e1c-3db7-af15-f270ff41f34c",
                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "A police officer or an officer with equivalent powers."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c1589d6-2af7-35ce-a7b3-fa4443d336f2",
                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "An officer of a noble court in the Middle Ages, usually a senior army commander. (See also marshal)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25729da1-b080-3940-bf44-ec08b412fa8d",
                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "The warden of a castle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0de6a557-3467-37d3-9fbd-d108f648db85",
                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "An elected or appointed public officer, usually at municipal level, responsible for maintaining order or serving writs and court orders."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
