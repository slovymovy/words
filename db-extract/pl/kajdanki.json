                ],
                "senses": [
                    {
                        "sense_id": "b29c08a2-17a7-31e0-8097-8d7a35f2f49c",
                        "entry_id": "6d5d2292-75d1-386a-8de9-a1fb41500137",
                        "glosses": [
                            "handcuffs, manacles"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "343da68a-a01e-4c38-b3a5-073815406dc8",
                                "sense_id": "b29c08a2-17a7-31e0-8097-8d7a35f2f49c",
                                "text": "Owo metaforyczne porównanie bransoletki do kajdanka przekracza bowiem potrzeby stylu sprawodawczego, nie jest ideologicznie obojętne.",
                                "translation": "After all, this metaphorical comparison of a bracelet to a manacle exceeds the demands of the journalistic style; it is not ideologically neutral.",
                                "english": "After all, this metaphorical comparison of a bracelet to a manacle exceeds the demands of the journalistic style; it is not ideologically neutral."
                            },
                            {
                                "example_id": "a026392c-5ae6-40be-ada8-5f3191aaf30d",
                                "sense_id": "b29c08a2-17a7-31e0-8097-8d7a35f2f49c",
                                "text": "[...] się rozwarło, wyskakując z uszka kajdanka. Obie ręce były teraz wolne.",
                                "translation": "... it opened, jumping out of the chain loop of the handcuff. Both hands were now free.",
                                "english": "... it opened, jumping out of the chain loop of the handcuff. Both hands were now free."
                            },
                            {
                                "example_id": "6997d03c-36f5-4869-be9d-7907567c958c",
                                "sense_id": "b29c08a2-17a7-31e0-8097-8d7a35f2f49c",
                                "text": "Ale już na schodach, jak zaczęli nas bić, te kajdanki się rozkuły i zostałem z kajdanką na ręku i wychodziłem sam…",
                                "translation": "But before, on the stairs, when they started to beat us, the handcuffs came apart and I was left with a handcuff on my hand, and I went out alone...",
                                "english": "But before, on the stairs, when they started to beat us, the handcuffs came apart and I was left with a handcuff on my hand, and I went out alone..."
                            },
                            {
                                "example_id": "72d591bd-4378-482f-9e29-ef594bf65d86",
                                "sense_id": "b29c08a2-17a7-31e0-8097-8d7a35f2f49c",
                                "text": "Kiedy morderca słyszy kliknięcie zapadki, sięga do torby i wyciąga dwie kolejne pary kajdanek.",
                                "translation": "When the murderer hears the click of the catch, he reaches into the bag and pulls out two more pairs of handcuffs.",
                                "english": "When the murderer hears the click of the catch, he reaches into the bag and pulls out two more pairs of handcuffs."
                            }
                        ]
                    }
