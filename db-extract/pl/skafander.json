                                "target_senses": [
                                    {
                                        "sense_id": "276824fb-7651-32b9-b3fa-de1c745f67da",
                                        "entry_id": "2ddf6492-7e19-355a-b04c-b8672bdaf80b",
                                        "glosses": [
                                            "Equipo acuático que le permite a las personas permanecer un determinado tiempo bajo el agua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69904ae-b1c8-42de-8463-e8f272cc230d",
                                                "sense_id": "276824fb-7651-32b9-b3fa-de1c745f67da",
                                                "text": "También pinté bajo el agua en Acapulco, con escafandra y pintura al óleo. La Vanguardia (1997)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79a9a0bd-0973-3f84-8bd4-502bf3fc46fc",
                                        "entry_id": "2ddf6492-7e19-355a-b04c-b8672bdaf80b",
                                        "glosses": [
                                            "Traje usado por los astronautas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c26d1628-53c2-406b-adcc-a616238775e6",
                                                "sense_id": "79a9a0bd-0973-3f84-8bd4-502bf3fc46fc",
                                                "text": "Ayer, las cosas no comenzaron con buen pie al detectarse fallos en la escafandra de Soloviov que retrasaron dos horas la salida al espacio. La Vanguardia (1997)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
