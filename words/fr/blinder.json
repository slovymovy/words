    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2d56293-48ea-35be-b80f-4e6131a93297",
                    "sense_definition": "Munir d'un blindage ou d'un renfort pour protéger contre les attaques, les projectiles ou les chocs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a décidé de <w>blinder</w> la porte d'entrée pour assurer la sécurité de son appartement."
                        },
                        {
                            "text": "L'armée a fait <w>blinder</w> tous les véhicules envoyés sur les zones à haut risque."
                        }
                    ],
                    "synonyms": [
                        "renforcer",
                        "cuirasser",
                        "protéger"
                    ],
                    "common_phrases": [
                        "blinder une porte",
                        "blinder un véhicule"
                    ]
                },
                {
                    "sense_id": "21ece1fc-d676-3130-8a91-2d117ab2273a",
                    "sense_definition": "S'endurcir moralement ou se préparer à supporter des critiques, des reproches ou des désagréments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut apprendre à se <w>blinder</w> face aux remarques négatives que l'on reçoit sur internet."
                        },
                        {
                            "text": "Avec les années d'expérience, cette infirmière a réussi à se <w>blinder</w> contre la souffrance quotidienne."
