                        "glosses": [
                            "One who performs the confirmation of an estate; the grantor of a deed of confirmation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39d8a69-36c0-4eb1-b8f4-46e55b16d3da",
                                "sense_id": "0320961f-805c-35e8-8f2f-fcd517230c24",
                                "text": "The confirmor must have such an estate and property in the thing of which the confirmation is made, as may enable him to confirm the estate to the confirmee; Dyer 109."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a706065-afb0-3d39-a263-fca132ad09bc",
                        "entry_id": "a1b53cf8-6e00-3eaf-808a-dd1e091cbdad",
                        "glosses": [
                            "A purchaser of real estate who resells the property before the transaction is completed."
                        ],
                        "tags": [
                            "Hong-Kong"
                        ],
                        "examples": [
                            {
                                "example_id": "0df2e38e-5ff3-4a1f-92ca-e57f1aada9ce",
                                "sense_id": "3a706065-afb0-3d39-a263-fca132ad09bc",
                                "text": "Confirmors buy and sell a property before a transaction is completed and they are generally thought to be speculators."
                            },
                            {
                                "example_id": "c400d1ad-3c52-4fd0-a9e8-54b34f74f6d7",
                                "sense_id": "3a706065-afb0-3d39-a263-fca132ad09bc",
                                "text": "During the period between the signing of the provisional S&P agreement and the completion of the sale, “A” (the confirmor) sells the property to sub-purchaser “C” for a higher price."
                            }
                        ]
                    }
