            {
                "entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
                "word": "liche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e22967ef-9983-440a-898a-d6feb2aac52b",
                        "entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
                        "tags": [
                            "plural"
                        ],
                        "form": "liches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                        "entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
                        "glosses": [
                            "Créature des mondes imaginaires, magicien mort-vivant d’apparence quasi squelettique."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "4c3d32ab-1677-453a-8df8-1e7cfca0a44b",
                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                "text": "Se riant de la liche, il saisit une page du grimoire et la déchira, certain d'avoir découvert le secret. Une nouvelle déchirure apparut dans la cape élimée de la liche."
                            },
                            {
                                "example_id": "a4810f1f-24c1-40a4-af33-d8c0a177458e",
                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                "text": "La liche projeta devant elle un rayon d'énergie noir et maléfique qui aurait absorbé une grande partie des forces vitales de l’Archimage s'il avait touché sa cible."
                            },
                            {
                                "example_id": "1a01ca73-4542-4339-871b-aac57248a59a",
                                "sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                                "text": "Shader n'avait pas besoin qu'on lui dise que ces trois auriges étaient des liches, formés post-mortem par le Seigneur Liche lui-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edc569dd-c5a0-4c75-9028-c35fd5949896",
                        "source_entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
                        "source_sense_id": "8902ef89-6edd-3885-92f4-6d1ad9cfac53",
                        "target_lang_word": "lich",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165a4a2f-a76f-35c2-83a6-a67d749e33a8",
                                        "entry_id": "58907edd-ad48-31c2-a741-151822435656",
                                        "glosses": [
                                            "A corpse or dead body."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e88067ac-d8d8-49d5-aea3-c3e379112e04",
                                                "sense_id": "165a4a2f-a76f-35c2-83a6-a67d749e33a8",
                                                "text": "[…] and that, as the chronicle states, a lich-way would be made through then, assembled his servants, and attempted to stop its progress as it was carried over a bridge. A scuffle ensued, and the body was thrown into the water. The lich-way as not made ; but the Bishop of Exeter amply revenged himself for the proceedings."
                                            },
                                            {
                                                "example_id": "f1745143-2358-401e-ac51-efdba19fca98",
                                                "sense_id": "165a4a2f-a76f-35c2-83a6-a67d749e33a8",
                                                "text": "She saw him again that eventide, but then he was a reddened lich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90f311c-dbfa-3923-aea9-0886d5b78d30",
                                        "entry_id": "58907edd-ad48-31c2-a741-151822435656",
                                        "glosses": [
                                            "A reanimated corpse or undead being; particularly an intelligent, undead spellcaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab5a65c-fb1d-47f2-a569-0f9203adfb8d",
                                                "sense_id": "c90f311c-dbfa-3923-aea9-0886d5b78d30",
                                                "text": "It was a lich’s face – desiccated flesh tight over its skull."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f5bac54-dbcc-3250-aac0-31e9756b40dd",
                                        "entry_id": "1a978af0-5397-3705-9bf0-b17170d66256",
                                        "glosses": [
                                            "Like; resembling; equal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25475f32-3468-4ccd-98d9-473ec39188e7",
                                                "sense_id": "1f5bac54-dbcc-3250-aac0-31e9756b40dd",
                                                "text": "1386-90, John Gower, Confessio Amantis.\nAnon he let two cofres make / Of one semblance, and of one make, / So lich, that no lif thilke throwe, / That one may fro that other knowe."
                                            },
                                            {
                                                "example_id": "ef7dcc3c-bfff-4ff3-94de-bee04b92f085",
                                                "sense_id": "1f5bac54-dbcc-3250-aac0-31e9756b40dd",
                                                "text": "[He] rather joy'd to be than seemen sich, For both to be and seeme to him was labour lich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf6d2e5-857e-4118-98a4-7f698b88f242",
                        "source_entry_id": "7713aabb-f5aa-39df-8a3c-beeb9fb1b78b",
