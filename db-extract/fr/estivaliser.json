                "senses": [
                    {
                        "sense_id": "8a7ef4e6-020f-3baf-8523-1491f3a56ad9",
                        "entry_id": "1342375d-1118-35b5-a56f-c676cad42b4e",
                        "glosses": [
                            "Donner un caractère estival à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531747fd-4719-4221-8e3e-08a6e39e4ad7",
                                "sense_id": "8a7ef4e6-020f-3baf-8523-1491f3a56ad9",
                                "text": "La lecture n’est pas comme l’été ; elle devient l’été, c’est une lecture « estivalisée »."
                            },
                            {
                                "example_id": "065fcac8-814d-491e-9b4e-7381db1866f6",
                                "sense_id": "8a7ef4e6-020f-3baf-8523-1491f3a56ad9",
                                "text": "On peut « estivaliser » le germe (en russe : le « jaroviser ») en lui faisant subir des températures, des degrés d'humidité et d’obscurcissement très déterminés."
                            }
                        ]
                    }
