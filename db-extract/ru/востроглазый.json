                "senses": [
                    {
                        "sense_id": "332f9f95-a5d8-36db-b226-96a73eb0f39f",
                        "entry_id": "36e807b5-c684-3b85-9579-4bcfbbd795fc",
                        "glosses": [
                            "прост. имеющий быстрый или проницательный взгляд; остроглазый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4195ecac-1733-4170-aaf2-393229276a06",
                                "sense_id": "332f9f95-a5d8-36db-b226-96a73eb0f39f",
                                "text": "Филисова была маленькая, востроглазая и востролицая женщина, лет сорока, и глядела лукаво и пристально."
                            },
                            {
                                "example_id": "b4c55089-fb28-475d-8f33-31460819994c",
                                "sense_id": "332f9f95-a5d8-36db-b226-96a73eb0f39f",
                                "text": "Один безногий, на костыле, с гвардейским значком на рубахе, востроглазый и вертлявый, другой угреватый, но красивый."
                            }
                        ]
                    }
                ],
