    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2587e62c-22d0-384a-b387-09b9a9547537",
                    "sense_definition": "iemand onderdak bieden of huisvesten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "huisvesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het noodweer was hij verplicht om de hele wandelgroep in zijn huis te <w>herbergen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the severe weather, he was obliged to <w>accommodate</w> the entire hiking group in his house."
                            }
                        },
                        {
                            "text": "De oude boerderij kan gemakkelijk twintig gasten <w>herbergen</w> tijdens het weekend.",
                            "target_lang_translations": {
                                "en": "The old farmhouse can easily <w>house</w> twenty guests during the weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "huisvesten",
                        "onderbrengen"
                    ],
                    "common_phrases": [
                        "gasten herbergen",
                        "onderdak herbergen"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide shelter or housing for someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accommodate",
                                "target_lang_sense_clarification": "to provide housing or space for"
                            },
                            {
                                "target_lang_word": "house",
                                "target_lang_sense_clarification": "to provide with a place to live"
                            },
                            {
                                "target_lang_word": "harbor",
                                "target_lang_sense_clarification": "to give shelter to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edc944a6-823e-3c12-80ba-cfa4e443a683",
                    "sense_definition": "als verblijfplaats of locatie dienen voor iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kom <w>herbergt</w> vier vissen, wat erg uitzonderlijk is voor zo'n klein formaat.",
                            "target_lang_translations": {
                                "en": "That bowl <w>houses</w> four fish, which is very exceptional for such a small size."
                            }
                        },
                        {
                            "text": "Het natuurreservaat <w>herbergt</w> vele zeldzame vogelsoorten die nergens anders voorkomen.",
                            "target_lang_translations": {
                                "en": "The nature reserve <w>is home to</w> many rare bird species that occur nowhere else."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevatten",
                        "huisvesten"
                    ],
                    "common_phrases": [
                        "soorten herbergen"
                    ],
                    "target_lang_definitions": {
                        "en": "to serve as a residence or location for something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "house",
                                "target_lang_sense_clarification": "to contain or be the home of"
                            },
                            {
                                "target_lang_word": "home",
                                "target_lang_sense_clarification": "to be the habitat or location for"
                            },
                            {
                                "target_lang_word": "shelter",
                                "target_lang_sense_clarification": "to provide a place for"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e17f4bc1-e385-3176-a9bc-83ca08e7646d",
                    "sense_definition": "iets in zich hebben of bevatten, vaak figuurlijk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor zo'n dun boek <w>herbergt</w> het erg veel informatie over de geschiedenis.",
                            "target_lang_translations": {
                                "en": "For such a thin book, it <w>contains</w> a great deal of information about history."
                            }
                        },
                        {
                            "text": "Zijn hart <w>herbergt</w> een groot geheim dat hij aan niemand durft te vertellen.",
                            "target_lang_translations": {
                                "en": "His heart <w>harbors</w> a great secret that he dares not tell anyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevatten",
                        "inhouden",
                        "omvatten"
                    ],
                    "common_phrases": [
                        "informatie herbergen",
                        "geheimen herbergen"
                    ],
                    "target_lang_definitions": {
                        "en": "to hold or contain something within, often used figuratively"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contain",
                                "target_lang_sense_clarification": "to hold inside"
                            },
                            {
                                "target_lang_word": "harbor",
                                "target_lang_sense_clarification": "to keep a thought or feeling in one's mind"
                            },
                            {
                                "target_lang_word": "hold",
                                "target_lang_sense_clarification": "to have within"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf1d1b9a-f76b-3742-90cb-48e37dc0dc93",
                    "sense_definition": "meervoud van <w>herberg</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gebouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langs de oude handelsroute stonden vroeger vele <w>herbergen</w> voor vermoeide reizigers.",
                            "target_lang_translations": {
                                "en": "Along the old trade route, there used to be many <w>inns</w> for weary travelers."
                            }
                        },
                        {
                            "text": "In dit dorp zijn nog twee authentieke <w>herbergen</w> waar je kunt overnachten.",
                            "target_lang_translations": {
                                "en": "In this village, there are still two authentic <w>hostels</w> where you can spend the night."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of herberg"
                        }
                    ],
                    "target_lang_definitions": {
