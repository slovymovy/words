                    ],
                    "target_lang_definitions": {
                        "ru": "Национальный парк Арчес в штате Юта, США"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Арчес",
                                "target_lang_sense_clarification": "название национального парка"
