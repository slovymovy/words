    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "ad8062b0-6718-386c-9889-41bcba8c5116",
                    "sense_definition": "Uiting die men gebruikt om hulp te vragen in nood.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij in het water viel, riep hij luid <w>help</w>!",
                            "target_lang_translations": {
                                "it": "Quando è caduto nell'acqua, ha gridato forte <w>aiuto</w>!"
                            }
                        },
                        {
                            "text": "Roep <w>help</w> als je de weg niet meer kunt vinden.",
                            "target_lang_translations": {
                                "it": "Grida <w>aiuto</w> se non riesci più a trovare la strada."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Espressione usata per chiedere soccorso in caso di emergenza."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "aiuto",
                                "target_lang_sense_clarification": "esclamazione per chiedere soccorso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f5fd3bc-c1fc-316e-a65b-ff5c4372c4c0",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>helpen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>help</w> je graag met het dragen van die zware tassen. ",
                            "target_lang_translations": {
                                "it": "Ti <w>aiuto</w> volentieri a portare quelle borse pesanti."
                            }
                        },
                        {
                            "text": "Elke middag <w>help</w> ik mijn broer met zijn huiswerk.",
                            "target_lang_translations": {
                                "it": "Ogni pomeriggio <w>aiuto</w> mio fratello con i compiti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik help"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Prima persona singolare del presente indicativo del verbo 'aiutare'."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "aiuto",
                                "target_lang_sense_clarification": "presente indicativo, 1a pers. sing."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b03bc59-299b-31c2-82ae-d87ed3f47d8b",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd (in inversie) van <w>helpen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Help</w> je me even met het opruimen van de tafel?",
                            "target_lang_translations": {
                                "it": "Mi <w>aiuti</w> un attimo a sparecchiare la tavola?"
                            }
                        },
                        {
                            "text": "Wanneer <w>help</w> je jouw vader in de tuin?",
                            "target_lang_translations": {
                                "it": "Quando <w>aiuti</w> tuo padre in giardino?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "help je"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud in inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Seconda persona singolare del presente indicativo (in inversione) del verbo 'aiutare'."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "aiuti",
                                "target_lang_sense_clarification": "presente indicativo, 2a pers. sing."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f7774de-8e17-3b75-bac7-bfa9a9021cfc",
                    "sense_definition": "Gebiedende wijs van <w>helpen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Help</w> me alsjeblieft om dit probleem op te lossen.",
                            "target_lang_translations": {
                                "it": "<w>Aiutami</w> per favore a risolvere questo problema."
                            }
                        },
                        {
                            "text": "Als je tijd hebt, <w>help</w> dan even mee.",
                            "target_lang_translations": {
                                "it": "Se hai tempo, <w>dà una mano</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "help me"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Modo imperativo del verbo 'aiutare'."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "aiuta",
                                "target_lang_sense_clarification": "imperativo singolare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
