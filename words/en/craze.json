                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя как безумный; бредить"
                    },
                    "translations": {
                        "ru": [
