                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dd5501c-7060-3fc5-94fd-3804a535fafb",
                        "entry_id": "6b75f156-1602-3772-8921-afb23c6b34ea",
                        "glosses": [
                            "ломая, выбить, вынуть что-либо из своего места"
                        ],
                        "tags": [],
