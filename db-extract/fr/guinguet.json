                        "sense_id": "bf84599d-6724-3088-9409-6b924526906f",
                        "entry_id": "b7bce89d-0012-3481-ac73-a6b7840476ce",
                        "glosses": [
                            "Vin aigrelet, autrefois produit en région parisienne."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3c638663-cdca-453b-b5f8-963433b1969d",
                                "sense_id": "bf84599d-6724-3088-9409-6b924526906f",
                                "text": "Je te paierai le guinguet et la boucaneuse avec, si le cœur t’en dit."
                            },
                            {
                                "example_id": "4a354463-51ff-4e16-86a0-efc5473b3183",
                                "sense_id": "bf84599d-6724-3088-9409-6b924526906f",
                                "text": "C’était en effet à Belleville que l’on produisait le guinguet, le vin que l’on boit pour danser au son des guigues, le vin qui donna plus tard son nom aux guinguettes, ces cabarets aux portes de la ville où le vin n’était pas taxé. Le guinguet était un vin jeune et légèrement pétillant."
                            }
                        ]
                    }
