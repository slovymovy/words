        "fr-extract.jsonl": [
            {
                "entry_id": "ddd733b3-0455-31e5-b43f-7bdce44e092b",
                "word": "blogueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3667ab6-5f21-4148-b548-624c5a4bbe89",
                        "entry_id": "ddd733b3-0455-31e5-b43f-7bdce44e092b",
                        "tags": [
