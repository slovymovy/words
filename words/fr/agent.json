{
    "word_family": [
        "agence",
        "agir",
        "action",
        "actif",
        "agentivité"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e0a372-7d69-38c3-bc95-9d681417fb4c",
                    "sense_definition": "Membre des forces de police ou de maintien de l'ordre public.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "securite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>agent</w> de police règle la circulation au carrefour pour éviter les embouteillages."
                        },
                        {
                            "text": "Le jeune homme a demandé son chemin à un <w>agent</w> dans la rue."
                        }
                    ],
                    "synonyms": [
                        "policier"
                    ],
                    "common_phrases": [
                        "agent de police",
                        "agent de circulation"
                    ]
                },
                {
                    "sense_id": "d6dee6ea-50b6-35fb-bc33-9e17fb166181",
                    "sense_definition": "Personne chargée d'une fonction ou d'une mission pour un service public, une administration ou un organisme privé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons contacté un <w>agent</w> immobilier pour trouver un appartement dans le centre-ville."
                        },
                        {
                            "text": "Cette jeune femme travaille comme <w>agente</w> administrative au sein de la mairie."
                        }
                    ],
                    "synonyms": [
                        "employé",
                        "fonctionnaire"
                    ],
                    "common_phrases": [
                        "agent immobilier",
                        "agent administratif",
                        "agent de voyages"
                    ]
                },
                {
                    "sense_id": "70509069-31e9-3374-afa0-bd4d029b2832",
                    "sense_definition": "Personne chargée de gérer la carrière et de négocier les contrats d'un artiste ou d'un sportif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'actrice a discuté des propositions de tournage avec son <w>agent</w> artistique."
                        },
                        {
                            "text": "Un bon <w>agent</w> négocie des contrats très avantageux pour les footballeurs professionnels."
                        }
                    ],
                    "synonyms": [
                        "imprésario",
                        "manager"
                    ],
                    "common_phrases": [
                        "agent artistique",
                        "agent de joueurs",
                        "agent littéraire"
                    ]
                },
                {
                    "sense_id": "f51917fe-ca50-33a8-9be8-c9bac773af17",
                    "sense_definition": "Personne travaillant pour un service d'espionnage ou de renseignement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "securite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce roman d'aventures raconte les missions périlleuses d'un <w>agent</w> secret en Europe."
                        },
                        {
                            "text": "Le gouvernement a découvert qu'un <w>agent</w> double transmettait des informations sensibles à l'ennemi."
                        }
                    ],
                    "synonyms": [
                        "espion"
                    ],
                    "common_phrases": [
                        "agent secret",
                        "agent double"
                    ]
                },
                {
                    "sense_id": "beb8a427-4b7e-3786-a462-12b80ba812d8",
                    "sense_definition": "Substance, organisme ou facteur naturel produisant un effet physique, chimique ou biologique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs tentent d'identifier l'<w>agent</w> pathogène responsable de cette nouvelle infection virale."
                        },
                        {
                            "text": "Le chlore est un <w>agent</w> chimique souvent employé pour désinfecter l'eau des piscines."
                        }
                    ],
                    "synonyms": [
                        "facteur"
                    ],
                    "common_phrases": [
                        "agent pathogène",
                        "agent chimique",
                        "agent infectieux"
                    ]
                },
                {
                    "sense_id": "afac0d6e-d871-3073-8fc1-e52be51b94a3",
                    "sense_definition": "Entité qui accomplit l'action exprimée par le verbe, notamment introduite par une préposition à la voix passive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une phrase passive, le complément d'<w>agent</w> indique qui accomplit réellement l'action."
                        },
                        {
                            "text": "Le professeur a demandé aux élèves de repérer l'<w>agent</w> dans chaque phrase passive."
                        }
                    ],
                    "common_phrases": [
                        "complément d'agent"
                    ]
                },
                {
                    "sense_id": "a19d0e67-61bb-3710-89f7-6173643520ee",
                    "sense_definition": "Principe ou être qui agit ou cause une transformation, par opposition à ce qui subit l'action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En philosophie morale, l'homme est conçu comme un <w>agent</w> libre et pleinement responsable de ses choix."
                        },
                        {
                            "text": "Ce traité étudie la relation complexe entre l'<w>agent</w> et le patient dans le processus causal."
                        }
                    ],
                    "antonyms": [
                        "patient"
                    ]
                },
                {
                    "sense_id": "b8ed8b5a-c7b0-314c-a9a4-7bdd942c1bd5",
                    "sense_definition": "Programme ou processus autonome exécutant des opérations pour le compte d'un utilisateur sur un réseau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>agent</w> logiciel analyse les requêtes et transmet automatiquement les résultats aux différents serveurs."
                        },
                        {
                            "text": "Le système déploie plusieurs <w>agents</w> intelligents pour surveiller la sécurité des réseaux."
                        }
                    ],
                    "common_phrases": [
                        "agent logiciel",
                        "agent intelligent"
                    ]
                }
            ]
        }
    ]
}