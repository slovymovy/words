                ],
                "senses": [
                    {
                        "sense_id": "4350ea86-9138-35bb-ad07-502f768cbdac",
                        "entry_id": "9665e7e2-2f8f-394d-a3d7-8e7d84460b4c",
                        "glosses": [
                            "Verhandlung mit dem Ziel, eine Koalitionsvereinbarung zu erreichen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "9afeaed9-ec7f-488f-b872-5bf4694eb7d1",
                                "sense_id": "4350ea86-9138-35bb-ad07-502f768cbdac",
                                "text": "„Bei der Regierungsbildung 2017 gehörte der Berufsdiplomat – er entstammt einer alten oberösterreichischen Adelsfamilie – dem Verhandlungsteam für die Koalitionsverhandlungen an.“"
                            },
                            {
                                "example_id": "e05faf5b-2977-4288-b65e-f6656aea5fa3",
                                "sense_id": "4350ea86-9138-35bb-ad07-502f768cbdac",
                                "text": "„Thorning-Schmidt will, wie bereits ihr Vorgänger Rasmussen, eine Minderheitsregierung bilden. Die Sozialdemokraten wollen dafür Koalitionsverhandlungen mit den Volkssozialisten (SF) und mit den Sozialliberalen (Radikale Venstre) führen.“"
                            },
                            {
                                "example_id": "247d8bec-c65b-4551-8ceb-9e926c28e733",
                                "sense_id": "4350ea86-9138-35bb-ad07-502f768cbdac",
                                "text": "„Die CDU-Landtagsfraktion und der Landesvorstand beschlossen im Laufe des Tages, dass sie zu Koalitionsverhandlungen bereit sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
