                "senses": [
                    {
                        "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                        "entry_id": "91968cba-382b-3589-98fc-a0399cbfa1c3",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5e5f89-8257-4628-99e6-323ad784da16",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Frau Schöchlin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b6653c05-491f-4c1f-858c-6aad20838f59",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Herr Schöchlin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2ad2ac99-02d0-4f1e-8308-3cd524eb5103",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Die Schöchlins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3c493b11-a7e2-4246-969c-59a1d4776d86",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Der Schöchlin trägt nie die Schals, die die Schöchlin ihm strickt."
                            },
                            {
                                "example_id": "90eb58a5-e9ee-4e77-9246-69ec0b579cce",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöchlin kommt, geht der Herr Schöchlin.“"
                            },
                            {
                                "example_id": "53a017a6-1475-4093-b4b3-24265f85dc2c",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Schöchlin kommt und geht."
                            },
                            {
                                "example_id": "c91f94da-1ca7-4624-852d-08d7d57a523f",
                                "sense_id": "f0fec295-00b0-3b26-9bc2-64e7fbd9a602",
                                "text": "Schöchlins kamen, sahen und siegten."
                            }
                        ],
