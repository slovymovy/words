                        "entry_id": "c5d4f254-ded1-3582-8f98-5ab6920ac040",
                        "glosses": [
                            "Eisen zur Bewehrung von Stahlbetonkonstruktionen, die in die Schalung eingebaut und dann in Decken, Treppen oder anderen Bauteilen einbetoniert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad7adc0-2410-41b8-8c74-d1f9cca4fca8",
                                "sense_id": "466c34ea-256a-38e1-9746-e8ff0a777884",
                                "text": "Sie werden wohl mehr Moniereisen in diese Deckenkonstruktion einbringen müssen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
