                ],
                "translations": [
                    {
                        "translation_id": "0e4fd551-8145-4c81-ab37-7d485ef282eb",
                        "source_entry_id": "38c376e7-47d8-399b-9d05-980b7e9af611",
                        "source_sense_id": "cfbf0a5d-7019-39ad-ae1a-282b0b3c5272",
                        "source_sense_description": "een soort kano",
                        "target_lang_word": "Piroge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Piroge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7ea838-270a-30d2-a1a7-f571ced95788",
                                        "entry_id": "475fc481-ace9-38c8-8af0-53db7fa374ce",
                                        "glosses": [
                                            "Einbaum mit erhöhtem Bord"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c89bbcf-4341-4455-8f72-d7ae1b686384",
                                                "sense_id": "7a7ea838-270a-30d2-a1a7-f571ced95788",
                                                "text": "„Dabei kam ihm ein Gedanke: Konnte er sich vielleich ein Floß, eine Piroge oder ein improvisiertes leichtes Boot bauen und damit übers Meer flüchten?“"
                                            },
                                            {
                                                "example_id": "d313bb96-a55c-4c18-8fbd-5f825ffa956f",
                                                "sense_id": "7a7ea838-270a-30d2-a1a7-f571ced95788",
                                                "text": "„Kaba, Sékou und Kourou standen am Ufer und sahen der Piroge nach, in der wir langsam auf den Fluss hinausglitten.“"
                                            },
                                            {
                                                "example_id": "bed7bac0-6d0d-438e-ad67-d8b7d12300f4",
                                                "sense_id": "7a7ea838-270a-30d2-a1a7-f571ced95788",
                                                "text": "„Zwischen ihnen landeten die bunten Pirogen, Fisch wurde entladen.“"
                                            },
                                            {
                                                "example_id": "75c53315-6f3b-479d-8d8e-cd9f299562c9",
                                                "sense_id": "7a7ea838-270a-30d2-a1a7-f571ced95788",
                                                "text": "„Er wollte kein richtiges Boot mit Spanten und Planken konstruieren, sondern nur eine flache Piroge, mit der man leicht über Untiefen hinwegkam, und die sich auch ohne Anstrengung tragen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89e13484-09d2-4f4d-b593-090c0172df93",
                        "source_entry_id": "38c376e7-47d8-399b-9d05-980b7e9af611",
                        "source_sense_id": "cfbf0a5d-7019-39ad-ae1a-282b0b3c5272",
