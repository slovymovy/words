    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                "word": "unaltered",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                        "entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                        "glosses": [
                            "Remaining in its initial state; not changed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfc91a93-1677-4976-be26-1080f4b67914",
                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                "text": "\"A first love is not easily extinguished, Mr. Allanson,\" said she. \"You may guess from my appearance, that I have been fortunate in life; but, for all that, my first love for you has continued the same, unaltered and unchanged, and you must forgive the little freedoms I used to-day to try your affections, and the effects my appearance would have on you.\""
                            },
                            {
                                "example_id": "bb4e817e-9838-4bed-ae9a-f461fc9aa740",
                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                "text": "Pat found subject and scene of his wooing unaltered, but all his specious blandishments could not induce the matured matron of 'Gi' Away Nothin' 'All' to join fortunes, though his perseverance would have delighted Bruce's spider."
                            },
                            {
                                "example_id": "6869a395-6759-4b7a-8f43-f67a93d18e83",
                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                "text": "But beyond these cut-offs, to avoid the wholesale alteration of all mileposting and mileages—of bridges and culverts, for example—the original mileposts have remained unaltered."
                            },
                            {
                                "example_id": "aae0c8bb-1a4e-4be7-bb62-3171c0915c3d",
                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                "text": "The new yearbooks at Wall Township High School in Wall, New Jersey – with the original, unaltered photos – will be available for students to pick up in about two weeks, Cheryl Dyer, the superintendent of Wall Township schools, said in a letter to students and parents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5545b44-e280-4d9c-908b-3c63a8390122",
                        "source_entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                        "source_sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                        "source_sense_description": "remaining in its initial state",
                        "target_lang_word": "ongewijzigd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongewijzigd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                                        "entry_id": "72e72e5b-de2b-3d82-9b86-1e5534fed367",
                                        "glosses": [
                                            "zonder verandering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afeba1c7-16d7-4940-a615-62fe0423a417",
                                                "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                                                "text": "Die ongewijzigde rentestand verbaasde vriend en vijand."
                                            },
                                            {
                                                "example_id": "1559f386-dbb2-4ed2-b29c-32f2a42ffb25",
                                                "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                                                "text": "Voor het huidige personeel bleven de afspraken ongewijzigd, maar voor nieuwe medewerkers zijn de arbeidsvoorwaarden versoberd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88d2cb11-3a29-4dd4-8274-00a3670efe81",
                        "source_entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                        "source_sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                        "source_sense_description": "remaining in its initial state",
                        "target_lang_word": "inaltéré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inaltéré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "683ffd4b-4d00-363d-8710-b3af1f0f121d",
                                        "entry_id": "38dce0b9-68e5-34a2-a8e8-c1dcd2a14ba5",
                                        "glosses": [
                                            "Non altéré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7148b03e-5bb9-3911-979b-780fd11c9ffd",
                                        "entry_id": "38dce0b9-68e5-34a2-a8e8-c1dcd2a14ba5",
                                        "glosses": [
                                            "Qui n’a subi aucune altération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f4e9a6-e775-480b-84ff-42f25e9305d2",
                                                "sense_id": "7148b03e-5bb9-3911-979b-780fd11c9ffd",
                                                "text": "Qu'un mot grec à l’état de flexion se soit conservé entier, inaltéré, dans les ouvrages des historiens chinois, c'est un fait inattendu qu'on est d'abord tenté de déclarer impossible ; […]."
                                            },
                                            {
                                                "example_id": "5f5e0e73-25a5-4ca0-b051-41e0efa3dd36",
                                                "sense_id": "7148b03e-5bb9-3911-979b-780fd11c9ffd",
                                                "text": "Je revois ce jeune homme aux joues et au front inaltérés, un jeune homme vierge jeté comme l’habitant d’une autre planète sur une terre aux langages non déchiffrés, aux signes mystérieux."
                                            },
                                            {
                                                "example_id": "6aac89f2-de2d-43a7-9e22-a8523e0bbbb5",
                                                "sense_id": "7148b03e-5bb9-3911-979b-780fd11c9ffd",
                                                "text": "Sur l’horizon, l’aube se devinait au frémissement de l’air, bien que la nuit se révélât encore d’un noir inaltéré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bc18966-959e-402c-b264-1c2c5257e51c",
                        "source_entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                        "source_sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                        "source_sense_description": "remaining in its initial state",
                        "target_lang_word": "unverändert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverändert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                        "entry_id": "54d2b61f-f5c6-3253-a6e6-5795c6b1a6b8",
                                        "glosses": [
                                            "gleichbleibend; ohne Veränderung, nicht verändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a98dfb-5fb1-402d-8ec9-08b0d20a1672",
                                                "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                                "text": "Ich habe heute nach zehn Jahren Bob wiedergetroffen, das Gesicht war grauer, aber die Frisur unverändert."
                                            },
                                            {
                                                "example_id": "40d7d112-d7d7-4a78-bd2d-4e68987b57f3",
                                                "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                                "text": "\"Die unveränderte Botschaft lautet: Egal, was die anderen tun, ich bin und bleibe die Kanzlerin. Und alle Umfragen geben ihr Recht.\""
                                            },
                                            {
                                                "example_id": "73dbd517-4ce5-4966-8060-85ab1e4c7d70",
                                                "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                                "text": "„Der Q7 trat die Q-Welle los, er ist seit 2005 fast unverändert auf dem Markt.“"
                                            },
                                            {
                                                "example_id": "395c67c2-a266-4123-9815-a8b3cb695d03",
                                                "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                                "text": "„Der Schwund tropischer Regenwälder hielt 2021 nach Satellitenbild-Auswertungen unverändert an.“"
                                            },
                                            {
                                                "example_id": "e8ae821e-a9ce-47c5-8fd2-35bde336816c",
                                                "sense_id": "d297baf1-21db-32b7-9fbe-08106c65528f",
                                                "text": "„Bei jeder chemischen Reaktion bleiben die Art und die Anzahl der beteiligten Atome unverändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
