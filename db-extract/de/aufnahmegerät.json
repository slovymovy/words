                "senses": [
                    {
                        "sense_id": "12dfd853-f31c-3613-b41d-f88e871b1a9f",
                        "entry_id": "c9575f07-4e8b-3b5a-b92b-42a6fdaaeaac",
                        "glosses": [
                            "Gerät, mit dem auditive und/oder optische Vorgänge erfasst und gespeichert werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b926324f-4cf6-4374-aa2d-647dfd0b84f0",
                                "sense_id": "12dfd853-f31c-3613-b41d-f88e871b1a9f",
                                "text": "„Wir stellen das Aufnahmegerät auf den Tisch und sofort verändert sich die Körperhaltung der beiden.“"
                            },
                            {
                                "example_id": "b81f29b2-48fb-4da3-899a-53f56c4dd568",
                                "sense_id": "12dfd853-f31c-3613-b41d-f88e871b1a9f",
                                "text": "„Es breitete sich über Couchgarnitur und Fernsehecke aus, über den schmalen Schreibtisch, an dem Papa abends gearbeitet hatte, wo er in ein kleines Aufnahmegerät mit gezackten Rädchen diktierte, das seine Wörter verschlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
