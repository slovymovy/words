                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Heimweg"
                    },
                    {
                        "form_id": "f7c0c5b8-e1a2-4152-8d99-846e3bef6ae7",
                        "entry_id": "bb77a4bf-585d-3dec-8a1c-1e4fc515bec0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Heimwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                        "entry_id": "bb77a4bf-585d-3dec-8a1c-1e4fc515bec0",
                        "glosses": [
                            "der Weg nach Hause"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31777ad4-ca01-4c27-a7e8-cbfe3b5ab735",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Gern würde sich Eos sofort auf den Heimweg machen.“"
                            },
                            {
                                "example_id": "db5abc7c-cb59-49f0-af6b-c06a4e91072a",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Auf dem Heimweg kam mir Michael Gerlach entgegen.“"
                            },
                            {
                                "example_id": "57882800-c310-4d13-8fb0-848cc4a3450a",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Es war der Heimweg, vor dem ich mich fürchtete.“"
                            },
                            {
                                "example_id": "786f05ee-aec2-4be6-a45f-aa82d0f3e76b",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "Er befand sich gerade auf dem Heimweg, als sein Handy klingelte."
                            },
                            {
                                "example_id": "62151b2c-0847-4ca9-b7fe-a5b19232254c",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Auf dem Heimweg schnallten wir uns den Tornister vor den Bauch und spielten Lok.“"
                            },
                            {
                                "example_id": "dc17b8e0-404e-489f-9a46-9fce012ee5a3",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Zufällig verabschiedeten wir uns gleichzeitig von der Gesellschaft und machten uns gemeinsam auf den Heimweg; dabei sprachen wir von unserer Herkunft und den kleinen Angelegenheiten, die uns in Bologna interessierten.“"
                            },
                            {
                                "example_id": "8eb4be7d-52f2-4ba5-b011-6c2a0a46cac1",
                                "sense_id": "9b10fd46-157e-3338-8215-14450802f13b",
                                "text": "„Nichts hatte es gebracht, außer dass er auf dem Heimweg verhungert war, auf dem Rücken im Schnee ausgestreckt, als sei er hochschwanger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
