                "senses": [
                    {
                        "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                        "entry_id": "544a29bb-974f-3ad1-8b53-5eba0667b674",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801b3266-8bc0-49f4-b90e-85531da6132f",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Frau Pfitzenmayer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "38c861a4-8ecc-4010-a454-1a9286da6f70",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Herr Pfitzenmayer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "19662005-0dcf-4bec-b7bd-7d53de18c246",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Die Pfitzenmayers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f85cb30c-7fd1-44a7-a85d-045104a5878f",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Der Pfitzenmayer trägt nie die Schals, die die Pfitzenmayer ihm strickt."
                            },
                            {
                                "example_id": "bda74362-c47f-4685-b9fb-9183b6181269",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfitzenmayer kommt, geht der Herr Pfitzenmayer.“"
                            },
                            {
                                "example_id": "3f5519ea-5c9f-424b-8904-cd39867134ce",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Pfitzenmayer kommt und geht."
                            },
                            {
                                "example_id": "f6613285-06a5-4b5d-b4b7-c8e7dac7aa87",
                                "sense_id": "c9b2098c-ad70-31bc-bcc4-8c7bae509e95",
                                "text": "Pfitzenmayers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
