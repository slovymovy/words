                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55545eed-1f6d-4c09-8b71-485fa9e1dc5f",
                                                "sense_id": "d4276edd-1de7-3fae-8563-0b8668231a93",
                                                "text": "The feds want me in the dot\nI got luck for selling them drugs\nBut when I come out I’m still building a spot"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dot",
