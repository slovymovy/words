            {
                "entry_id": "e6bb75ea-6764-372a-b2e4-122d33a25018",
                "word": "mordieu",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                        "entry_id": "e6bb75ea-6764-372a-b2e4-122d33a25018",
                        "glosses": [
                            "Euphémisme du juron : Par la mort de Dieu."
                        ],
                        "tags": [
                            "dated",
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "7808ba93-135e-4466-b604-356d1977ace0",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "Quoique les Bestein soient étrangers et Lorrains, mordieu ! une poignée de main de Henry IV nous a conquis pour toujours."
                            },
                            {
                                "example_id": "f69729b0-fbf1-432f-8ffa-1be865a6c052",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "Il va croire que je me dérobe ! Mordieu ! Cogolin, ma rapière, mon cheval !"
                            },
                            {
                                "example_id": "38e2722b-334b-43e7-ba58-00bc94e30044",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "On vient de me voler, de me voler des papiers auxquels je tiens plus qu’à la vie... Mais, mordieu, je les rattraperai."
                            },
                            {
                                "example_id": "fe46f004-ad54-4e1a-9c64-b220cf0ca1fd",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "— Halte ! commanda Godefroy. Halte ! Je veux la sauver. Arrête, mordieu !…"
                            },
                            {
                                "example_id": "77d9853f-4924-48a0-996a-bf231322ac52",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "— Mordieu ! reprit l’ex-officier, je viens de me conduire comme un brutal et non comme un justicier."
                            },
                            {
                                "example_id": "9a02634b-bd80-4a15-a69e-798791159657",
                                "sense_id": "d8330b19-7655-3e32-921d-bd2a4bad2aef",
                                "text": "— Ralentis, mordieu, ralentis, cria Placide désespéré. Je me suis fait une bosse au front !"
                            }
                        ]
                    }
                ],
