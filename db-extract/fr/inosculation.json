                        "glosses": [
                            "Abouchement de deux vaisseaux de diamètre identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27129d46-d0a4-4d29-917f-506816e7497d",
                                "sense_id": "ab4c9e93-0b01-3942-a526-f0ed58da6d27",
                                "text": "Selon la manière dont se fait cette fusion, on lui donne les noms d’anastomose par inosculation , par convergence ou angulaire, et par communication transversale."
