                        "examples": [
                            {
                                "example_id": "dee4f20e-e883-4c46-91f6-61fd16775506",
                                "sense_id": "cf92f951-8f21-3c87-bf2b-8e7c16159830",
                                "text": "It seemed good therefore to his Holiness , not to canonise Garnet for a solemn saint , much less for a martyr , but only to beatificate him"
                            },
                            {
                                "example_id": "bc4d93c0-d673-4f83-989f-e8377b348736",
                                "sense_id": "cf92f951-8f21-3c87-bf2b-8e7c16159830",
                                "text": "The composition, not offering any historical fact, but an assemblage of beatificated personages, who lived at different periods, it is needless to give an account of it."
                            }
                        ]
