                        "entry_id": "f0a373f8-db64-32fb-9fe7-dc7707605299",
                        "glosses": [
                            "von Laien genähter einfacher Mund-Nasen-Schutz zur Vermeidung von Fremdgefährdung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bdef461-062c-42ba-84a7-d127dc6863d2",
                                "sense_id": "21956574-aa1d-39ff-938a-8cb055f5a50f",
                                "text": "Selbstgenähte Alltagsmasken werden oft mit Gummibändern an den Ohren befestigen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3d650c9-6d46-3023-ac17-08ecbc649be6",
                        "entry_id": "f0a373f8-db64-32fb-9fe7-dc7707605299",
                        "glosses": [
                            "(schützender) Schein von Normalität und Alltag, der durch offensichtliches Verhalten aufgebaut wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "224e17ef-ebfa-4765-99a9-08d3e6c8213b",
                                "sense_id": "b3d650c9-6d46-3023-ac17-08ecbc649be6",
                                "text": "„Die Rolle muß als Absprungbasis betrachtet werden, als ein Instrument, mit dem das, was sich hinter der Alltagsmaske verbirgt, untersucht werden kann – der innerste Kern der Persönlichkeit – damit er geopfert, bloßgelegt werden kann.“"
                            }
                        ],
