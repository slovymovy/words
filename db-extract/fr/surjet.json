                "senses": [
                    {
                        "sense_id": "bf8b259d-523f-3fb6-8c4d-d02e06bb30b4",
                        "entry_id": "124a0240-8168-36af-b022-59c0861f3da2",
                        "glosses": [
                            "Sorte de couture qu’on fait en tenant les deux étoffes qui doivent être jointes, appliquées l’une sur l’autre bord à bord, et en les traversant toutes deux à chaque point d’aiguille. Il est aussi utilisé pour arrêter la bordure d'un tissu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f406c9-2de6-485f-93f2-b6cecd282f0b",
                                "sense_id": "bf8b259d-523f-3fb6-8c4d-d02e06bb30b4",
                                "text": "Faire un surjet."
                            },
                            {
                                "example_id": "790d2e92-ea70-47e9-9855-21b21e63bd99",
                                "sense_id": "bf8b259d-523f-3fb6-8c4d-d02e06bb30b4",
                                "text": "Mais je sabotais les ourlets, les surjets, les reprises, les festons, le point de croix, le plumetis, le macramé."
                            },
                            {
                                "example_id": "69412c53-49c6-4f0b-a09d-3947fae25c3f",
                                "sense_id": "bf8b259d-523f-3fb6-8c4d-d02e06bb30b4",
                                "text": "« Peau de pêche », le petit Parisien dont je lisais l’histoire chaque samedi, pour accompagner le point de surjet de mes amies courbées sur leur ouvrage pendant la leçon de couture, avait été recueilli par un oncle paysan."
                            }
                        ]
                    }
                ],
