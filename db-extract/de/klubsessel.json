                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d052ac1a-3752-38c8-a5e1-e7ac1dfa5ff7",
                                        "entry_id": "a3f41f82-a968-3743-b937-e7a008037524",
                                        "glosses": [
                                            "Fauteuil large et profond, à structure de bois, ressorts, rembourrage de crin végétal et revêtement de cuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4ff7c9d-12c2-452f-9c44-6532ad57e96e",
                                                "sense_id": "d052ac1a-3752-38c8-a5e1-e7ac1dfa5ff7",
                                                "text": "D’abord réservé à l’aristocratie britannique puis italienne au XIXᵉ siècle, le fauteuil club se démocratise."
                                            },
                                            {
                                                "example_id": "b134defc-6c2b-4b6b-aaf1-547dd3b5727e",
                                                "sense_id": "d052ac1a-3752-38c8-a5e1-e7ac1dfa5ff7",
                                                "text": "Finalement, un secrétaire la fit asseoir dans un confortable fauteuil club - en s’y enfonçant, elle se demanda si elle pourrait se relever..."
                                            },
                                            {
                                                "example_id": "0181f2e5-29b0-4d8d-a8f6-3881dbfb33ed",
                                                "sense_id": "d052ac1a-3752-38c8-a5e1-e7ac1dfa5ff7",
                                                "text": "Il semblait ne rien entendre, le monsieur, il glissait, il se raccrochait aux bras du fauteuil club, des soubresauts à n’en plus finir, les pieds lâchaient le sol, glissades, contorsions des bras, du torse, de la tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
