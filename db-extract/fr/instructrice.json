                    {
                        "sense_id": "bdf567d9-e1ee-3f97-b720-3aa7519f6a3e",
                        "entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "glosses": [
                            "Celle qui instruit."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "7360c4fc-4ddc-47f4-9373-6640a562b6fe",
                                "sense_id": "bdf567d9-e1ee-3f97-b720-3aa7519f6a3e",
                                "text": "Chaque rencontre avec le bébé, d’une durée de trente minutes, est précédée et suivie de la visite de l’instructrice seule."
                            }
                        ]
                    },
                    {
                        "sense_id": "17a18c30-11e9-33ca-8baa-db39cec994f4",
                        "entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
                        "glosses": [
                            "Celle qui est chargée d’enseigner aux jeunes soldats l’exercice et le maniement des armes."
                        ],
