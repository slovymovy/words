                                                "sense_id": "932a4e47-2cf4-379b-99b1-f1379a7c16e8",
                                                "text": "Podwórka oddzielone były żywopłotem z derenia."
                                            },
                                            {
                                                "example_id": "a1ee6dc7-8c95-46e7-aef0-13c00fc767ad",
                                                "sense_id": "932a4e47-2cf4-379b-99b1-f1379a7c16e8",
                                                "text": "(…) całe bowiem widły rzeczne i zewnętrzne brzegi były porośnięte częścią zwyczajnym dereniem, częścią świdwą"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "86f917f3-0e41-334b-be4b-a5cc197c0301",
                                        "entry_id": "3659b51c-fac5-3beb-be2d-5f2221464e9f",
                                        "glosses": [
                                            "drobny, czerwony owoc derenia (1.2) jadalnego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d5a343-0afb-463e-b950-b86a56cf648b",
                                                "sense_id": "86f917f3-0e41-334b-be4b-a5cc197c0301",
                                                "text": "Babcia robi doskonałą nalewkę z dereni."
                                            },
                                            {
                                                "example_id": "6b9ce05d-087d-4ffd-90f0-6c02abef9dd1",
                                                "sense_id": "86f917f3-0e41-334b-be4b-a5cc197c0301",
                                                "text": "Dostarczano też im bez oporu kukurydzowych placków, suszonego dereniu i suszonego bawolego mięsa"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
