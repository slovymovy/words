                ],
                "senses": [
                    {
                        "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                        "entry_id": "2eac9da2-30d7-3115-b8d9-ca68db1e13b7",
                        "glosses": [
                            "Unterbrechung eines Weges zum Zwecke des Nichtdurchlassens, Verunmöglichung einer Bewegung, eines Vorgangs"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6ea5af-1530-4918-983a-2351182ce351",
                                "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                                "text": "„In dem vorliegenden Gutachten bezeichnet Datenschützer Weichert die Blockierung von Finanzströmen zwischen Glücksspielanbietern und ihren Kunden nun allerdings als ‚praktisch unmöglich‘.“"
                            },
                            {
                                "example_id": "cd0f3341-fa3f-4593-80bd-3ebe36ee20a4",
                                "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                                "text": "übertragen: „Es handelt sich dabei um eine Methode zur Unterbrechung und Blockierung von unerwünschten Gedanken.“"
                            },
                            {
                                "example_id": "bda26351-9c56-4e41-9546-f34e2bfc2753",
                                "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                                "text": "übertragen: „Die Blockirung [sic!] nach Ausfahrt eines Zuges geschieht ebenso, wie auf der Kopfstation A.“"
                            },
                            {
                                "example_id": "d1fb55ac-b119-488e-a2b3-652caac8955b",
                                "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                                "text": "übertragen: „Schon 1996 konnte der amerikanische Krebsforscher James Allison zeigen, dass die Blockierung eines dieser die Immunantwort hemmenden Proteine – genannt CTLA-4 – durch Antikörper in acht von zehn Mäusen zu einem vollständigen Verschwinden von Tumoren führt.“"
                            },
                            {
                                "example_id": "1836c2d6-b25a-4971-9ac6-aa8276dba10a",
                                "sense_id": "825de572-283a-3782-9fe1-da7b7629a9cf",
                                "text": "übertragen: „Darüber hinaus zeigte sich in den Experimenten, dass die Blockierung des Adenosin-Rezeptors A1 im auditorischen Thalamus bei den Mäusen nicht nur dazu führte, dass sie sich einmal gehörte Töne mehrere Wochen lang merken konnten, die Nager waren auch dazu in der Lage, Töne mit sehr ähnlichen Frequenzen scheinbar mühelos zu unterscheiden – eine Fähigkeit, die Mäuse normalerweise nicht besitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
