                "senses": [
                    {
                        "sense_id": "3bc4684b-b0af-3b50-a892-2646710959ae",
                        "entry_id": "08731d61-421d-3c66-90a2-a838daae05d7",
                        "glosses": [
                            "großes Raubtier, das zur Unterfamilie der Katzen gehört"
                        ],
                        "tags": [
                            "Pantherinae",
                            "Felidae"
                        ],
                        "examples": [
                            {
                                "example_id": "643706fd-b4f9-4adc-8f91-f97bbd042f06",
                                "sense_id": "3bc4684b-b0af-3b50-a892-2646710959ae",
                                "text": "Ein Löwe ist eine Großkatze."
                            },
                            {
                                "example_id": "2133d66b-9375-4d80-a583-300660ad98f9",
                                "sense_id": "3bc4684b-b0af-3b50-a892-2646710959ae",
                                "text": "„Aber die Spermaproben könnten wertvolle Hilfe leisten, wenn etwa die Paarung zweier Großkatzen auf anderem Wege nicht gelingt oder ein besonders wertvolles Männchen stirbt.“"
                            },
                            {
                                "example_id": "44720960-1207-4bcd-b7e3-645de1104361",
                                "sense_id": "3bc4684b-b0af-3b50-a892-2646710959ae",
                                "text": "„Um die Jahrtausendwende war der Bestand der Großkatzen, die auf Russisch „Bars“ heißen, auf 250 bis 300 Exemplare gesunken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
