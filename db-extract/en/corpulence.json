    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                "word": "corpulence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "225a73d9-6cd6-4c60-a143-f8dab3f3e705",
                        "entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                        "tags": [
                            "plural"
                        ],
                        "form": "corpulences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de319926-6b64-304d-993c-3a41d2ba0c77",
                        "entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                        "glosses": [
                            "The characteristic or state of being corpulent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b26e1cc0-77d9-486d-9caf-a6a858fa5b4e",
                                "sense_id": "de319926-6b64-304d-993c-3a41d2ba0c77",
                                "text": "Corpulence is a beauty: girls are fattened to a vast bulk by drenches of curds and cream thickened with flour, and are duly disciplined when they refuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54fc2426-998e-48a7-98af-4289faf38d7b",
                        "source_entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                        "source_sense_id": "de319926-6b64-304d-993c-3a41d2ba0c77",
                        "source_sense_description": "characteristic or state of being corpulent",
                        "target_lang_word": "corpulence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corpulence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                        "entry_id": "cc7b233a-f595-3035-86b5-b690df6df43e",
                                        "glosses": [
                                            "Ampleur plus ou moins considérable du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa256ec9-c5ab-4f75-a156-dd262e9901bb",
                                                "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                                "text": "Seul, Thomas Black, […], ne descendait jamais de son véhicule, car sa corpulence se fût mal accommodée de ces pénibles exercices."
                                            },
                                            {
                                                "example_id": "c8ec4ea2-bae0-46e2-aa1b-0f757fa8f611",
                                                "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                                "text": "[…] et, fort beau gars encore, malgré sa corpulence, présentait dans l'ensemble l'allure d'un écuyer de cirque."
                                            },
                                            {
                                                "example_id": "eaaa7e10-0e71-44f4-b3d1-ad8a963bf27e",
                                                "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                                "text": "Malgré sa corpulence excessive, l'autorité de M. Hector sur ses subordonnés n'est guère contestable. Il la doit surtout à sa placidité étudiée, au ton solennel et ampoulé qu'il affecte en s'exprimant, […]."
                                            },
                                            {
                                                "example_id": "488bb8e5-9090-4ec0-a4ca-e8c826d0eaf6",
                                                "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                                "text": "Dieudonné Djonabaye n'a rien en apparence d'un foudre de guerre. Calme et débonnaire, une corpulence de bon vivant dont la lourdeur est accentuée par des difficultés à se déplacer, rien en lui ne trahit un bagarreur constamment sur la brèche."
                                            },
                                            {
                                                "example_id": "5931f84a-a146-4e96-9fda-2bc4bf08f411",
                                                "sense_id": "e337742f-847f-32a1-a92d-5165782b0f51",
                                                "text": "Les équipementiers proposent des chaussures conçues, selon eux, pour des foulées et des corpulences toujours mieux ciblées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99e6186e-8379-4492-ba9f-b0fa9b9e2a89",
                        "source_entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                        "source_sense_id": "de319926-6b64-304d-993c-3a41d2ba0c77",
                        "source_sense_description": "characteristic or state of being corpulent",
                        "target_lang_word": "Korpulenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korpulenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                        "entry_id": "8076eb7a-84bd-33f7-aa1b-697ad53b4ff5",
                                        "glosses": [
                                            "Eigenschaft, dick/korpulent zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504e6ffa-f080-49b1-88c3-77c463cee75b",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Er trank sehr viel, obgleich die Aerzte ihm sagten, dass ihm der Wein bei seiner Korpulenz schaden könne.“"
                                            },
                                            {
                                                "example_id": "afeffc4a-d9d2-4722-8f41-0acad67f5b0c",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Doch da Korpulenz und Humor oft im innigsten Bunde stehen, gehen die Dicken meist gelassen an den Wartezimmern der Ärzte vorbei.“"
                                            },
                                            {
                                                "example_id": "71266dac-de61-4ab9-9f77-9e36dbc4e615",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Er drehte sich um und fixierte wütend mit unerträglich gespannten Nerven einen älteren Herrn von einiger Korpulenz, den er nicht im geringsten kannte, und er war bereit loszuschlagen, wenn der andere sich rührte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8d973ab-8a80-4609-a5ef-05e929ea2641",
                        "source_entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
