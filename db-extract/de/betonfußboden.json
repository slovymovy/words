                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb91b784-d625-42d5-858c-d249b82b097f",
                                "sense_id": "68e64598-0c28-3522-85af-12df4ae906a4",
                                "text": "„Also schob er den feuchtgeriebenen Schlüssel ins Schloss und trat ein. Ein kleiner, verwinkelter Raum mit einem Betonfußboden statt einem Teppich.“"
                            },
                            {
                                "example_id": "372c2e34-49b8-49c3-b4db-ed16c888d5ec",
                                "sense_id": "68e64598-0c28-3522-85af-12df4ae906a4",
                                "text": "„Ihre Füße entsteigen grünen Stilettos, und dann steht sie plattfüßig in reinweißen Strümpfen auf dem Betonfußboden.“"
                            },
                            {
                                "example_id": "2db6e697-ae49-4f74-b1bb-a8ff10ef4607",
                                "sense_id": "68e64598-0c28-3522-85af-12df4ae906a4",
                                "text": "„Kälte stieg vom Betonfußboden auf und schmerzte in den Beinen und Füßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
