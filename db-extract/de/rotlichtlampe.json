                ],
                "senses": [
                    {
                        "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                        "entry_id": "d02a55f2-a30c-3b45-802e-8ee67f5d0a2e",
                        "glosses": [
                            "Lampe, die wärmendes Infrarotlicht abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ede590-2d4c-42b6-889c-d5b82adbd644",
                                "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                                "text": "„Weil es im Stall dann auch noch zu kalt war, wurde das Eselkind hinter die Kulissen des Afrika-Hauses gebracht, wo eine Rotlichtlampe wenigstens für ein bisschen Kuschelwärme sorgte.“"
                            },
                            {
                                "example_id": "9c3d2df5-6daf-40c7-b889-01ab300ebc66",
                                "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                                "text": "„Sorge bereitet heute eine traumatisierte Katze, die aus dem 5. Stock fiel und jetzt reglos unter der Rotlichtlampe ausharrt.“"
                            },
                            {
                                "example_id": "8491d5b7-2ae2-4c4b-9fe2-4bb298a4255d",
                                "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                                "text": "„Einige der Rotlichtlampen wurden versetzt... Beispiele reißen hin.“"
                            },
                            {
                                "example_id": "c7961994-565e-4105-a65d-7d68bb38ab30",
                                "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                                "text": "„Damit alles gut geht, hat er bei den eisigen Temperaturen extra eine Rotlichtlampe aufgestellt.“"
                            },
                            {
                                "example_id": "4345b082-a18d-4886-b756-1aa8bd86f340",
                                "sense_id": "6205b8cd-cef1-35d8-89ae-84eeda1e93c4",
                                "text": "„Diesmal lief im Gästezimmer im Keller des großen Hauses unter der Rotlichtlampe alles glatt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
