                "senses": [
                    {
                        "sense_id": "5cd08d44-7f05-3a44-a423-414b8b47ceb3",
                        "entry_id": "05f6a09f-83ec-3425-846f-cd152f31b2da",
                        "glosses": [
                            "Gehalt/Wirkungswert einer Reagenslösung"
                        ],
                        "tags": [
                            "Maßanalyse"
                        ],
                        "examples": [
                            {
                                "example_id": "3d4706c1-853e-48f7-aa84-185ea1ae25da",
                                "sense_id": "5cd08d44-7f05-3a44-a423-414b8b47ceb3",
                                "text": "„Aber abgesehen davon, daß der zu bestimmende Anteil eines Stoffgemisches von vornherein keineswegs immer im gelösten Zustand vorliegt, so daß also eine bestimmte Menge der Substanz abgewogen und daraus ein definiertes Volumen der eigentlichen Analysenlösung bereitet werden muß, darf man doch nicht vergessen, daß zur Bereitung der Reagenslösung bekannten Gehalts (Titers) die Waage benutzt wird und daß daher allen Titrationen letzten Endes Wägungen zugrunde liegen.“"
                            },
                            {
                                "example_id": "1c39cd89-dd95-45c3-a242-26017f13da78",
                                "sense_id": "5cd08d44-7f05-3a44-a423-414b8b47ceb3",
                                "text": "„1. Gleiche Volumina von Lösungen gleicher „Normalität“ (gleichen Titers) enthalten äquivalente Stoffmengen; […].“"
                            },
                            {
                                "example_id": "68e6410e-b61f-48db-96c5-7cf96648ac2a",
                                "sense_id": "5cd08d44-7f05-3a44-a423-414b8b47ceb3",
                                "text": "„Der durch M[aßanalyse] zu bestimmenden Lösung […] werden steigende Mengen einer Maßflüssigkeit bekannter Konzentration (Titer) eines Reagens […] zugegeben, bis die Beendigung der betreffenden Reaktion erfolgt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "864de3fe-3f65-380b-a0b9-9a57b496d7db",
                        "entry_id": "05f6a09f-83ec-3425-846f-cd152f31b2da",
                        "glosses": [
                            "Gewichtseinheit bei der Seidengarnnummerierung"
                        ],
                        "tags": [
                            "Textilindustrie"
                        ],
                        "examples": [
                            {
                                "example_id": "e63a97c2-d2c7-407b-b053-0c6bfb337d01",
                                "sense_id": "864de3fe-3f65-380b-a0b9-9a57b496d7db",
                                "text": "Der Titer ist die Bezeichnung „für die Feinheit von Fasern u. Faserverbänden durch das Verhältnis vom Gewicht zur Länge“."
                            },
                            {
                                "example_id": "bc88f959-7ba1-4214-8266-62aeed3f81f0",
                                "sense_id": "864de3fe-3f65-380b-a0b9-9a57b496d7db",
                                "text": "Der Titer ist eine „Gewichtseinheit bei der Nummerierung von Seidengarnen: 1 T = 450 m o[der] 0,05 g.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c4f4d273-0a62-383d-8555-f41491ad0d83",
                        "entry_id": "05f6a09f-83ec-3425-846f-cd152f31b2da",
                        "glosses": [
                            "Menge der IgG-Antikörper nach Infektion oder Impfung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a419ac93-f090-4c46-bb9b-45787764e69a",
                        "source_entry_id": "05f6a09f-83ec-3425-846f-cd152f31b2da",
                        "source_sense_id": "5cd08d44-7f05-3a44-a423-414b8b47ceb3",
                        "source_sense_description": "Chemie, Maßanalyse: Gehalt/Wirkungswert einer Reagenslösung",
                        "target_lang_word": "dosage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dosage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1554c77c-2aca-35aa-8b08-d21a1560e6e8",
                                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                                        "glosses": [
                                            "Action de doser."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                                        "glosses": [
                                            "Mesure d’une quantité de matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59146c91-a129-414b-a7d4-247b7928e200",
                                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                                "text": "Les bancs d’essai automatiques de dosage des protéines dans les céréales seront vérifiés globalement à l’aide de farines de référence."
                                            },
                                            {
                                                "example_id": "304345d5-bc26-490a-828f-c58ad1c05860",
                                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                                "text": "Plus exactement, la détection et le dosage des cytokines dans le sang, un biomarqueur inflammatoire, permettent de différencier les patients atteints de troubles bipolaires de ceux qui souffrent d’un trouble dépressif."
                                            },
                                            {
                                                "example_id": "be776bb7-753f-46c4-8183-bfdb49bd2883",
                                                "sense_id": "03cfcb26-609e-3489-99c3-451fd8d9d663",
                                                "text": "Lucy se plongea dans ses dosages d’acide urique, de cholestérolémie et autres Numérations de Formules Sanguines avec un bonheur qui l’étonna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a01174-91cc-3f6b-aa8d-5d447d0d6bb3",
                                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                                        "glosses": [
                                            "Détermination, calcul, de la dose d’un médicament."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48f0df5e-e712-3b21-a9fc-712d5d9bd36d",
                                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                                        "glosses": [
                                            "Répartition en proportions adéquates."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                                        "entry_id": "dc54e54c-7c9e-3433-9dd8-9b5e46fae819",
                                        "glosses": [
                                            "Modification d’un peuplement pour réduire la présence d’une essence ou éliminer des sujets indésirables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4520c34b-6748-43d4-ab95-57da84f5b2cd",
                                                "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                                                "text": "Une fois le choix des arbres objectif fait, le marteleur se consacre alors entièrement au dosage des arbres à enlever, opération qui nécessite déjà de la technicité."
                                            },
                                            {
                                                "example_id": "5f22701d-e137-4799-9c5f-f35fbc55d965",
                                                "sense_id": "73dd5f17-d5a5-3ab1-9f1b-408d3a7fa71e",
                                                "text": "La gestion en futaie irrégulière permet l’installation des essences plus héliophiles comme le [c]hêne (sessile) à condition de pratiquer quelques travaux de dosages d’essences pour régler la trop forte concurrence qui leur est défavorable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cbc9553-c632-42fc-a3b5-6925dc047990",
                        "source_entry_id": "05f6a09f-83ec-3425-846f-cd152f31b2da",
                        "source_sense_id": "864de3fe-3f65-380b-a0b9-9a57b496d7db",
                        "source_sense_description": "Gewichtseinheit bei der Seidengarnnummerierung",
                        "target_lang_word": "titre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Élément qui est mis en valeur par rapport au contenu qui le suit et qui le résume parfois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dffb9d4-a58d-41ad-8bfe-02482f41d4fa",
                                                "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                                "text": "Des escouades de camelots ont parcouru les boulevards en hurlant le titre d'une nouvelle feuille : « Demandez Le Glaive ! »"
                                            },
                                            {
                                                "example_id": "a6f64f05-53e3-469b-8fac-c97162441644",
                                                "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (…) devinrent instantanément un feu d’artifice où les illustrations et les titres de colonnes s’enlevaient comme des fusées et éclataient comme des bombes."
                                            },
                                            {
                                                "example_id": "4d32c415-fb41-4411-896c-0794f5cb982c",
                                                "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                                "text": "Le Point est même en mesure d'en donner le titre (…) : Ma vérité. Pour quelqu'un qui, comme l'autre jour à la télévision, n’arrête pas de raconter des craques, c'est un beau titre, je trouve."
                                            },
                                            {
                                                "example_id": "d6263649-135c-4b04-9965-f54d391e860f",
                                                "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                                "text": "« Kevin contre la GroKo », cela pourrait être le titre d'une épopée enfantine et chevaleresque où un jeune héros finit par terrasser le monstre et réveiller la belle princesse endormie. Mais c'est bien autre chose."
                                            },
                                            {
                                                "example_id": "97de4623-4275-4d7e-bf64-aa2760b96403",
                                                "sense_id": "7b46e712-ee88-35a2-aff1-a203c99f17da",
                                                "text": "Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e45298-ae14-397c-908e-68a3b5841d33",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Le contenu lui-même."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b12ce807-3372-409e-9cd3-6a89e3981a83",
                                                "sense_id": "35e45298-ae14-397c-908e-68a3b5841d33",
                                                "text": "Le monde de la bande dessinée est bien plus cruel qu'il n'y paraît : un nombre hallucinant d'albums afflue dans les bouclards chaque mois, et bien rares sont les titres qui parviennent à s'imposer."
                                            },
                                            {
                                                "example_id": "4c21ffb7-dd03-4606-8a4e-25c93c2bb6d1",
                                                "sense_id": "35e45298-ae14-397c-908e-68a3b5841d33",
                                                "text": "Le nouveau titre du chanteur à la mode. — Tout compte fait, ce titre pèche par sa faible durée de vie malgré des graphismes agréables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9530420-a1b9-35a0-8997-7bd15be60a9d",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Désignation honorifique d’un nom indiquant un rang ou une dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c35448-dfd3-4c63-9cd2-c219636854e6",
                                                "sense_id": "e9530420-a1b9-35a0-8997-7bd15be60a9d",
                                                "text": "Bonaparte, qui s'y entendait, changeait le titre des gens: il cachait le nom de M. de Talleyrand sous celui de prince de Bénévent; il baronnifiait les marquis et ducalisait les comtes. La recette est assez bonne , et nous la recommandons fortement à qui de droit."
                                            },
                                            {
                                                "example_id": "5fc6861b-b3fa-4873-9de4-36539c7b1b5e",
                                                "sense_id": "e9530420-a1b9-35a0-8997-7bd15be60a9d",
                                                "text": "La société enrichie la veille par des spéculations, honnêtes ou non, joignait à ses richesses des titres nobiliaires ; chacun s'improvisait comte, marquis ou baron."
                                            },
                                            {
                                                "example_id": "8a8483e3-79c8-4933-8c87-cfd71fd7a9d8",
                                                "sense_id": "e9530420-a1b9-35a0-8997-7bd15be60a9d",
                                                "text": "La T∴ Ill∴ S∴ Marguerite Martin le remplace dans ces hautes fonctions, mais le Sup∴ Cons∴, à l’unanimité, décerne au T∴ Ill∴ F∴ Petit le titre de G∴ M∴ d'Honneur ad vitam."
                                            },
                                            {
                                                "example_id": "915a2ce8-7e43-4920-bf58-56c8ec909a2d",
                                                "sense_id": "e9530420-a1b9-35a0-8997-7bd15be60a9d",
                                                "text": "Le nom se compose tout d'abord du nom de famille, ensuite du prénom et, enfin, de ce que l'on appelle les accessoires du nom, pseudonyme, surnom et titres nobiliaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b0de05-e2cf-3089-becb-8cb9731d401f",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Nom qui indique un grade, une fonction, une charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd5b0ea-fedc-4886-bc94-e68c27f20d91",
                                                "sense_id": "92b0de05-e2cf-3089-becb-8cb9731d401f",
                                                "text": "Il se donne le titre de docteur."
                                            },
                                            {
                                                "example_id": "5b6ce9a3-bf81-42eb-8a0e-86faa3183d1d",
                                                "sense_id": "92b0de05-e2cf-3089-becb-8cb9731d401f",
                                                "text": "Monsieur le commissaire, dis-je alors (parce qu'il faut toujours donner leurs titres aux personnes), j'ai fait trois voyages en Angleterre …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79d8fcc-f191-3c0c-b730-c9c82802ceb2",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Genre civil d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec88280-56dc-4459-97cb-638a36e2c898",
                                                "sense_id": "f79d8fcc-f191-3c0c-b730-c9c82802ceb2",
                                                "text": "« Monsieur », « Madame » et anciennement « Mademoiselle » sont des titres de civilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a254d797-3d1c-303f-99b3-f46d3b3b7775",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Composition d'une monnaie dans un métal donné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2488e176-ecf0-3c2a-bb37-782fe5b1b3eb",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Ancien terme de chasse qui exprimait le lieu où les chiens étaient attitrés, mis sur la voie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e11d956-c231-360f-80e5-788ca0f83edd",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Rapport de la quantité du corps dissous à la quantité de la solution, permettant de calculer soit la concentration massique, soit la concentration ionique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61115cef-d76f-44eb-8701-645df2295361",
                                                "sense_id": "0e11d956-c231-360f-80e5-788ca0f83edd",
                                                "text": "Par son faible titre alcoolique, ses principes amers et son acide carbonique, la bière exerce sur l'organisme une action stimulante."
                                            },
                                            {
                                                "example_id": "8deff604-b104-48aa-a076-2813d936affa",
                                                "sense_id": "0e11d956-c231-360f-80e5-788ca0f83edd",
                                                "text": "L'importance ancienne donnée à la maîtrise de la dureté des eaux et aux différentes épurations chimiques d’adoucissement consécutives a entraîné l'expression de titres particuliers relatifs à la dureté de l'eau et à son alcalinité et qui sont le titre hydrotimétrique (TH) et les titres alcalimétriques (TAC et TA)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221a49e8-58bc-33d6-90e7-2a2b62027372",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Qualité attachée à la source d'un droit ou un ensemble de droits. Cette source peut se présenter sous la forme d'une disposition légale, ou administrative, ou sous la forme d'une convention ou d'un jugement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c73c2ce-1e34-3b12-903a-c9a9a307f79c",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Document qui constitue la preuve de son contenu."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ec25207-4c99-3ada-86c6-a40577203790",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Ce qui établit le droit qu’on a de posséder, de demander, de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879505bc-30e6-4689-8e54-b09441c5e93a",
                                                "sense_id": "8ec25207-4c99-3ada-86c6-a40577203790",
                                                "text": "À quel titre avez-vous obtenu cet emploi ?"
                                            },
                                            {
                                                "example_id": "bf2a2abe-46e7-44df-a063-c3d02dfd6b72",
                                                "sense_id": "8ec25207-4c99-3ada-86c6-a40577203790",
                                                "text": "Ce secret, vous étiez en droit de le deviner, mais vous n’avez aucun titre à le rendre public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f618a68b-8ec4-3d06-b747-8d2557c03ce7",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Écrit qui consacre traditionnellement le droit des titulaires de valeurs mobilières, qu'il s'agisse de parts, d'actions, de certificats d'investissement, de titres participatifs, ou d'obligations émises par les sociétés (maintenant habituellement dématérialisé et résultant donc seulement de l’inscription dans les comptes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb055d8-6531-484d-a974-9c1f9e6ad8d9",
                                                "sense_id": "f618a68b-8ec4-3d06-b747-8d2557c03ce7",
                                                "text": "Nos ministres des finances sont aux ordres des banquiers cosmopolites. Et ce qu’il y a de plus triste, c’est que la France, la France antique libératrice des peuples, n’a souci désormais que de venger, en Europe, les droits des porteurs de titres."
                                            },
                                            {
                                                "example_id": "4966d824-3161-4eaf-bd1d-bcf5cac0edba",
                                                "sense_id": "f618a68b-8ec4-3d06-b747-8d2557c03ce7",
                                                "text": "Dans toutes les Bourses de la terre, ce fut une avalanche de titres que les porteurs voulaient vendre ; les banques suspendirent leurs paiements, les affaires furent paralysées et cessèrent ; […]."
                                            },
                                            {
                                                "example_id": "2f000543-c357-4df2-b2c0-6514ea028891",
                                                "sense_id": "f618a68b-8ec4-3d06-b747-8d2557c03ce7",
                                                "text": "Certains même préparent à l'avance les titres d'alimentation que viennent chercher ensuite les hommes du maquis, comme à Vimory, au Charme et à Gy-les-Nonains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b3693b-bf3e-364d-b294-a0334f9b2c7e",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Nom donné au point placé sur la lettre i."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e977ebe-6c89-317c-9609-c83a82289f95",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Ensemble des indications portées sur une carte et permettant d’identifier celle-ci, comprenant éventuellement le sujet, le type et la désignation de la coupure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d97fd546-4d64-3825-9ff4-4dcaae1c18f1",
                                        "entry_id": "09750c87-77f7-3d0a-8811-e624082b5e26",
                                        "glosses": [
                                            "Dans le cas de cartes marines et de certaines cartes anciennes : ensemble comprenant le titre et des indications diverses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "titre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d3a187d-84f8-3d21-a9fe-aada524a9167",
                                        "entry_id": "7e088cae-fbbd-34db-8421-baa77d0896ca",
                                        "glosses": [
                                            "Réplique humoristique destinée à attirer l’attention sur une phrase venant d’être prononcée et présentant, généralement involontairement, un double sens grivois, tels certains titres de films pour adultes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb9b6fe-f082-49e3-ae53-34d907681a7d",
                                                "sense_id": "6d3a187d-84f8-3d21-a9fe-aada524a9167",
                                                "text": "-J'ai fourré la dinde !\n-Titre !"
                                            },
                                            {
                                                "example_id": "dfef09c2-0f55-48fd-9230-bf6613b944a5",
                                                "sense_id": "6d3a187d-84f8-3d21-a9fe-aada524a9167",
                                                "text": "En septembre, j'adore la rentrée."
                                            },
                                            {
                                                "example_id": "00966add-f6dc-4279-b0f7-de49ef60dc21",
                                                "sense_id": "6d3a187d-84f8-3d21-a9fe-aada524a9167",
                                                "text": "\"Dis donc il est tout juteux\" (en parlant d'un fuit par exemple)"
                                            }
                                        ]
                                    }
                                ]
                            },
