                "translations": [
                    {
                        "translation_id": "f744375f-2d08-4382-8b2d-920258d73e87",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "intrigue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrigue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "513d773f-7a4b-326a-8af5-522fb04d01f5",
                                        "entry_id": "4cbb5edb-f77f-3b33-bbf2-90993040512c",
                                        "glosses": [
                                            "A complicated or clandestine plot or scheme intended to effect some purpose by secret artifice; conspiracy; stratagem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e220614f-096a-40d0-9df0-67667a14f7dc",
                                                "sense_id": "513d773f-7a4b-326a-8af5-522fb04d01f5",
                                                "text": "[…] lost in such a jungle of intrigues, pettifoggings, treacheries, diplomacies domestic and foreign […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91459726-4891-38c0-a378-b5300d08bd9e",
                                        "entry_id": "4cbb5edb-f77f-3b33-bbf2-90993040512c",
                                        "glosses": [
                                            "The plot of a play, poem or romance; the series of complications in which a writer involves their imaginary characters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "394fe71d-5a19-3420-9138-ac083e0bec4a",
                                        "entry_id": "4cbb5edb-f77f-3b33-bbf2-90993040512c",
                                        "glosses": [
                                            "Clandestine intercourse between persons; illicit intimacy; a liaison or affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054af886-b6b0-4202-a1f3-bfccf25e4596",
                                                "sense_id": "394fe71d-5a19-3420-9138-ac083e0bec4a",
                                                "text": "I often used to smile at a young Ensign of the Guards, who always popped [pawned] his sword and watch when he wanted cash for an intrigue; […]"
                                            },
                                            {
                                                "example_id": "d4931ea6-427d-4138-ae34-c0ad449c5895",
                                                "sense_id": "394fe71d-5a19-3420-9138-ac083e0bec4a",
                                                "text": "He proposed to call witnesses to show how the prisoner, a profligate and spendthrift, had been at the end of his financial tether, and had also been carrying on an intrigue with a certain Mrs. Raikes, a neighbouring farmer’s wife."
                                            },
                                            {
                                                "example_id": "967bfa8b-4c0d-4115-888d-4bedcf96146c",
                                                "sense_id": "394fe71d-5a19-3420-9138-ac083e0bec4a",
                                                "text": "In 1679 and 1680 there were persistent rumors of an intrigue between Mary, Lady Grey, and the Duke of Monmouth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrigue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99cdc0ec-cf5f-3fe0-b664-c2ad7c9b82f6",
                                        "entry_id": "3939b1b8-0dc6-3b98-a696-92f62d51ac77",
                                        "glosses": [
                                            "To conceive or carry out a secret plan intended to harm; to form a plot or scheme."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeb61f8f-03a7-3bff-b199-99cb63217e60",
                                        "entry_id": "3939b1b8-0dc6-3b98-a696-92f62d51ac77",
                                        "glosses": [
                                            "To arouse the interest of; to fascinate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b7de87-0d6a-42d5-bc6a-a6d775ca7c52",
                                                "sense_id": "eeb61f8f-03a7-3bff-b199-99cb63217e60",
                                                "text": "Scenic illusions such as those caused by the haze, or the apparent diminution of scale where everything was enormous, intrigued Dutton."
                                            },
                                            {
                                                "example_id": "2c511129-9cce-41cb-8fe3-3c873afd7c17",
                                                "sense_id": "eeb61f8f-03a7-3bff-b199-99cb63217e60",
                                                "text": "These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story. And, on top of all that, they are ornaments; they entice and intrigue and sometimes delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5768d75-c14f-3f27-8cc6-6d609ac6293f",
                                        "entry_id": "3939b1b8-0dc6-3b98-a696-92f62d51ac77",
                                        "glosses": [
                                            "To have clandestine or illicit intercourse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0677dc4e-5f0e-3d86-a57b-39ea6ce74097",
                                        "entry_id": "3939b1b8-0dc6-3b98-a696-92f62d51ac77",
                                        "glosses": [
                                            "To fill with artifice and duplicity; to complicate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db56ba9-4cb5-40ee-a5f5-b540e50ccd1b",
                                                "sense_id": "0677dc4e-5f0e-3d86-a57b-39ea6ce74097",
                                                "text": "And as wililye as thoſe ſhrewes that beguyle hym haue holpe hym to inuolue and intryke the matter: I ſhall vſe ſo playn and open a way therin, that euery man ſhall well ſee the trouth."
                                            },
                                            {
                                                "example_id": "337473e9-af36-46ce-9eff-37e71aa4c64a",
                                                "sense_id": "0677dc4e-5f0e-3d86-a57b-39ea6ce74097",
                                                "text": "How doth it [sin] perplex and intrigue the whole course of your lives!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d09c4a4-bf82-42a2-ac54-a9a255661b2d",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "jiggery-pokery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jiggery-pokery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5919c07c-50ef-3424-9d73-16c50146996b",
                                        "entry_id": "b6e4e486-c08e-3e93-b0af-9613932073dc",
                                        "glosses": [
                                            "Trickery or misrepresentation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e247d74-4abb-40b0-a941-69b0acdc9c04",
                                                "sense_id": "5919c07c-50ef-3424-9d73-16c50146996b",
                                                "text": "'Jiggery-pokery,' said Helena, 'you talk jiggery-pokery. Stop it, can't you?'"
                                            },
                                            {
                                                "example_id": "3b42cf2a-c128-4dc6-b085-f025d441c37b",
                                                "sense_id": "5919c07c-50ef-3424-9d73-16c50146996b",
                                                "text": "Much as 'off-balance sheet' jiggery-pokery and other 'creative accounting' allowed banks to get away with false impressions of their true financial position..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bda564-f874-3c58-8ed8-c0aab9cb757d",
                                        "entry_id": "b6e4e486-c08e-3e93-b0af-9613932073dc",
                                        "glosses": [
                                            "Manipulation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1885c17-bdb3-41c8-945d-e9c2179d9905",
                                                "sense_id": "c6bda564-f874-3c58-8ed8-c0aab9cb757d",
                                                "text": "...under the present law, the averages were made up so faithfully and fairly as to prevent any jiggery-pokery."
                                            },
                                            {
                                                "example_id": "bd2b8668-0b7c-4130-b8ae-2c8bbcbad0df",
                                                "sense_id": "c6bda564-f874-3c58-8ed8-c0aab9cb757d",
                                                "text": "...what my friend Singleton calls \"rigging, cornering, and general jiggery-pokery methods,\"..."
                                            },
                                            {
                                                "example_id": "08402c28-7ada-4a7d-82b8-accfdec802ac",
                                                "sense_id": "c6bda564-f874-3c58-8ed8-c0aab9cb757d",
                                                "text": "Indeed, there was some highly questionable jiggery-pokery with couplings and continuous brakes in this agreeable story, which featured Moore Marriott as an old driver who averts a disaster on his last run."
                                            },
                                            {
                                                "example_id": "634a54ab-50e2-4977-b32a-2efee20815ec",
                                                "sense_id": "c6bda564-f874-3c58-8ed8-c0aab9cb757d",
                                                "text": "The hon. Member for Dover is suggesting that if all the facts were revealed, there would be less danger of people thinking that there was jiggery-pokery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0d628f-9397-3236-84e8-b0da44328ad0",
                                        "entry_id": "b6e4e486-c08e-3e93-b0af-9613932073dc",
                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2db95d-1b57-403d-a43f-55c54914bad3",
                                                "sense_id": "fa0d628f-9397-3236-84e8-b0da44328ad0",
                                                "text": "...the males, like most birds, have no penis. But that doesn't stop a bit of gay jiggery-pokery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9774f1b4-54e6-4244-8ca9-776310058ee2",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "crafty design of the enemy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ea40b525-15eb-4c17-a2c0-2594174128d3",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "crafty design against somebody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90c29614-4a69-4d09-908d-b9284244854c",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "scheme against somebody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c41393fa-a5b2-4d35-97a8-02797097cca8",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "machinate against somebody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51f3019a-b1a3-4cbb-ad8b-ec85c9954dd2",
                        "source_entry_id": "1398e53c-85cc-38dc-a57f-182ed3633e91",
                        "source_sense_id": "1c3d44ad-119c-3a9c-a6b4-cff5fd36dfe0",
                        "target_lang_word": "intrigue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                        "entry_id": "b690cae4-7661-35d5-9fb2-1fd411d43dbc",
                                        "glosses": [
                                            "Pratique secrète qu’on emploie pour faire réussir ou pour faire manquer une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e765b421-5687-4e2e-b814-2df3ef864ffa",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "C’est un homme de talent, qui connaît la Grèce, ses ressources, ses intrigues, qui peut tirer parti des unes et faire bientôt disparaître les autres."
                                            },
                                            {
                                                "example_id": "8deba020-d751-405c-a047-ecaa5e9df10c",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "Des chansons et des quolibets populaires, se joignant aux intrigues de la cour, ruinèrent auprès du roi le crédit d’un homme de bien."
                                            },
                                            {
                                                "example_id": "cda52575-f9f7-4de0-8838-291652fd219f",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "Pour moi, j'ai horreur de ces plates intrigues qui finiront par des mariages, des sous-préfectures, des recettes générales."
                                            },
                                            {
                                                "example_id": "dc0dfea2-bc50-40d0-8eae-7a03b2eccea8",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "La reine prit ce conseil en bonne part, et Frédégonde se mit à préparer sourdement, à force d’intrigues, le piège qu’elle voulait lui dresser."
                                            },
                                            {
                                                "example_id": "d14c86bd-d927-4138-aad8-c8a430cd739b",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "Ce coin perdu de Jan-Mayen n’est pas à l’abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            },
                                            {
                                                "example_id": "9db7f518-bf0d-47da-b366-0f99206c6974",
                                                "sense_id": "19a2f884-dddd-31be-a630-eccbc2319aa1",
                                                "text": "Parmi les voyageurs, il n’y avait pas de comédiennes et des écrivains. Mais aussi des diplomates et des espions. […] À l’époque, les intrigues allaient bon train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f867758b-8c96-3f7e-a7ca-958d66002289",
                                        "entry_id": "b690cae4-7661-35d5-9fb2-1fd411d43dbc",
                                        "glosses": [
                                            "Commerce secret de galanterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d6e110-b9b4-432e-99cd-a371aaf05087",
                                                "sense_id": "f867758b-8c96-3f7e-a7ca-958d66002289",
                                                "text": "Que faire donc ? je ne fume jamais ; la fidélité matrimoniale est bien ennuyeuse ; dans une intrigue où le cœur n'est que chatouillé on ne vise qu'au dénoûment : la promenade est mon unique plaisir ; triste plaisir à vingt ans !"
                                            },
                                            {
                                                "example_id": "6ad69e08-6e5a-4819-8f20-6be7dc7da27a",
                                                "sense_id": "f867758b-8c96-3f7e-a7ca-958d66002289",
                                                "text": "Dans Malhação par exemple, comme d'ailleurs dans toute télénovela, il y a une famille centrale autour de laquelle se greffent des intrigues amoureuses, mêlant tour à tour les thèmes de la santé, la jeunesse, la joie et la sexualité, et surtout l’adultère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde73d36-e92c-3dc3-a95f-4888ac2ad1b4",
                                        "entry_id": "b690cae4-7661-35d5-9fb2-1fd411d43dbc",
                                        "glosses": [
                                            "Ensemble des différents incidents qui forment le nœud d’une pièce ou d'un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa284f4-27d8-482e-9d81-78340cde0173",
                                                "sense_id": "bde73d36-e92c-3dc3-a95f-4888ac2ad1b4",
                                                "text": "Comme le dit M. Sarcey, « rien de plus simple et de plus nu que les scénarios habituels de Dancourt. Il ne se donnait guère la peine de nouer une intrigue, et pourtant, dans ces scénarios bâtis à la diable, que de trouvailles scéniques qui révèlent l'homme de théâtre !"
                                            },
                                            {
                                                "example_id": "5b8fa9f1-e982-439d-9034-d0287e954c35",
                                                "sense_id": "bde73d36-e92c-3dc3-a95f-4888ac2ad1b4",
                                                "text": "Le premier correspond à l’intrigue, dans laquelle on se laisse entraîner d'autant plus facilement que la feuilletonisation du récit est parfaitement maîtrisée grâce à un découpage et un rythme qui ménagent suspense, dévoilements et rebondissements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
