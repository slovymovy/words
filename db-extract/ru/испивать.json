                    },
                    {
                        "form_id": "b0a7e414-7814-4348-87e6-cd5eb3758307",
                        "entry_id": "103c0a1f-c926-32c3-a69d-52150f33e99c",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… испива́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06b81af6-7b30-30eb-87c6-063be8639821",
                        "entry_id": "103c0a1f-c926-32c3-a69d-52150f33e99c",
                        "glosses": [
                            "разг. выпивать чего-либо немного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7701fc78-e7b6-40bd-9929-38615364eef8",
                                "sense_id": "06b81af6-7b30-30eb-87c6-063be8639821",
                                "text": "Благоразумнее всех показался мне хозяин, который на все вопросы отвечал одним мычанием: «Гм, гм, гм, гм», ― и продолжал испивать вкусное вино."
                            }
                        ]
                    },
                    {
                        "sense_id": "b179e81c-e753-3625-8fca-0178df337a74",
                        "entry_id": "103c0a1f-c926-32c3-a69d-52150f33e99c",
                        "glosses": [
                            "устар., поэт. выпивать всё, до конца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4415f845-1984-4c68-8a9f-580412b85239",
                                "sense_id": "b179e81c-e753-3625-8fca-0178df337a74",
                                "text": "Этак лучше. Не сейчас надо испивать чашу."
                            }
                        ]
                    },
                    {
                        "sense_id": "45a0c8d2-ed35-3e32-8b5c-dda20a4cdbd8",
                        "entry_id": "103c0a1f-c926-32c3-a69d-52150f33e99c",
                        "glosses": [
                            "перен., поэт. переживать, выносить, вытерпливать что-либо тяжёлое, трудное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b712117-5361-4b10-addd-c19a70c1f9ab",
                                "sense_id": "45a0c8d2-ed35-3e32-8b5c-dda20a4cdbd8",
                                "text": "Горечь и желчь постепенно утекут, не могут не утечь ― уже бывало, она не первая, с кем приходилось испивать чашу до дна."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d8d19df-584a-3d13-8251-1b0792a693d0",
                        "entry_id": "103c0a1f-c926-32c3-a69d-52150f33e99c",
                        "glosses": [
                            "устар. злоупотреблять спиртным, выпивать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c56b2dac-f02d-4b70-9c8c-81fe5760c34c",
                                "sense_id": "9d8d19df-584a-3d13-8251-1b0792a693d0",
                                "text": "Кроме этого, дядя стал крепко испивать водку, ругался на весь дом, бил тётку, играл в карты и много проигрывал."
                            }
                        ]
                    }
                ],
                "translations": [],
