                        "sense_id": "503af1b0-90cb-3d52-8fa4-98c3fcb4322d",
                        "entry_id": "82d04571-2ec5-3398-b5ee-32d043a2db4b",
                        "glosses": [
                            "conferentie van belangrijke personen, in het bijzonder een vergadering van staatshoofden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7daba8b8-fc82-43e0-afdc-1d505ac71def",
                                "sense_id": "503af1b0-90cb-3d52-8fa4-98c3fcb4322d",
                                "text": "Ook Duitse politici en vakbonden beginnen zich zorgen te maken. IG Metall wil het thema begin mei bespreken met politici en autoproducenten op een automotive-topconferentie in Wiesbaden."
                            },
                            {
                                "example_id": "fa4c0e4b-6922-4938-8aeb-8bfd5d9d7b23",
                                "sense_id": "503af1b0-90cb-3d52-8fa4-98c3fcb4322d",
                                "text": "Er mag nooit meer een grote topconferentie in een grote Duitse stad worden gehouden. Dat zegt de Duitse minister van Justitie Heiko Maas tegen de krant Bild. Hij reageert daarmee op de hevige onlusten in Hamburg die van donderdagavond tot zondag woedden. Hij noemt de relschoppers ásociale zware criminelen', die onder meer 'pogingen tot moord pleegden'."
                            }
                        ]
                    }
