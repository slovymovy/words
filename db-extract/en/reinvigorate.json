                                "target_senses": [
                                    {
                                        "sense_id": "097983d3-2720-300a-8c14-f3a2f3befc4b",
                                        "entry_id": "bf584d60-1a41-3d35-933d-e087d8a8dbb3",
                                        "glosses": [
                                            "Donner une vigueur nouvelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d847d56-36b4-42ae-bf09-020bf1d35385",
                                                "sense_id": "097983d3-2720-300a-8c14-f3a2f3befc4b",
                                                "text": "Et surtout, il doit avoir prévu du sifflard et de la bière pour revigorer toute la troupe au coin du feu, entre deux longues journées de marche."
                                            },
                                            {
                                                "example_id": "fd735193-b8e3-41c6-8cda-ffedc0f8e327",
                                                "sense_id": "097983d3-2720-300a-8c14-f3a2f3befc4b",
                                                "text": "Revigorés par la deuxième vague, qui frappe au moment où l’affaire We Charity sombre dans les oubliettes, les libéraux bénéficient d’un taux de satisfaction très enviable de 48%, toujours selon le dernier Abacus Data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "493bbfef-522a-3e5c-83b7-d01a8aa8bf58",
                                        "entry_id": "bf584d60-1a41-3d35-933d-e087d8a8dbb3",
                                        "glosses": [
                                            "Redonner un bon moral, de la force spirituelle."
