                ],
                "senses": [
                    {
                        "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                        "entry_id": "ba0d7bae-1cfe-3a6a-bc8d-c1cefd2e0c41",
                        "glosses": [
                            "Wahrnehmung einer Person/Gruppe von Außenstehenden; Art und Weise, wie man von anderen Personen wahrgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ebff27-23c2-427b-8557-784d17c30c04",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Es erfolgt ein ständiger Wechsel zwischen Eigen- und Fremdperzeption sowie Subjekt und Objekt.“"
                            },
                            {
                                "example_id": "3296b508-e277-4b77-9b08-e81a3cf63142",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Die türkische Armee nimmt sowohl in ihrer Selbst- als auch in der Fremdperzeption durch die Gesellschaft die Rolle ein, ‚Schule der Nation‘ zu sein.“"
                            },
                            {
                                "example_id": "9b0002af-acfd-41de-a103-b1ff6adc3315",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Wann immer die Identität einer Gesellschaft nicht nur vom Selbstbild, son- dern auch von der Fremdperzeption anderer Staaten abhängt, ist es für den betreffenden Staat umso wichtiger, wie es sich im Ausland präsentiert.“"
                            },
                            {
                                "example_id": "f372b4d9-31d8-4be9-a6d1-d2bf691d65aa",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Damit näherte sich ihre Fremdperzeption der Ego-Platzierung ihrer eigenen Anhänger ebenso an wie der der Gesamtwählerschaft.“"
                            },
                            {
                                "example_id": "d206502a-38ba-4e4e-a1c1-5fa75c9bd9f4",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Beginnend mit der Fremdperzeption der Alliierten und der Wahrnehmung des eigenen Landes durch deutsche Fotografen beschreibt Derenthal die Illustriertenfotografie und die ersten Ausstellungen in Ost und West.“"
                            },
                            {
                                "example_id": "2c779c9a-0ba7-4527-a175-ec4a0e972d3c",
                                "sense_id": "8d57844a-960c-3818-b3b2-94bfa0ca462c",
                                "text": "„Der Ursprung nationaler Fremdperzeptionen lässt sich also, wenngleich Wandermotive berücksichtigt werden müssen, fast immer auf bestimmte historische Ereignisse oder Entwicklungen als Auslöser zurückführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
