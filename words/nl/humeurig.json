    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c8f2dbe-e834-340a-a044-0466c2beb709",
                    "sense_definition": "in een slecht humeur zijn, vaak gepaard gaand met een kortaf of onvriendelijk gedrag",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>humeurige</w> man had geen vrienden meer omdat hij altijd boos keek.",
                            "target_lang_translations": {
                                "en": "The <w>moody</w> man had no friends left because he always looked angry."
                            }
                        },
                        {
                            "text": "Ik ben vandaag een beetje <w>humeurig</w> omdat ik vannacht niet goed heb geslapen.",
                            "target_lang_translations": {
                                "en": "I am a bit <w>grumpy</w> today because I didn't sleep well last night."
                            }
                        }
                    ],
                    "synonyms": [
                        "nukkig",
                        "chagrijnig"
                    ],
                    "antonyms": [
                        "vrolijk",
                        "goedgehumeurd"
                    ],
                    "common_phrases": [
                        "een humeurige bui",
                        "humeurig wakker worden"
                    ],
                    "target_lang_definitions": {
                        "en": "being in a bad mood, often accompanied by abrupt or unfriendly behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moody",
                                "target_lang_sense_clarification": "unhappy or unfriendly for a period of time"
                            },
                            {
                                "target_lang_word": "grumpy",
                                "target_lang_sense_clarification": "easily annoyed and complaining"
                            },
                            {
                                "target_lang_word": "cranky",
                                "target_lang_sense_clarification": "irritable and in a bad mood"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a71b6e8f-5df1-3118-80d2-b720c20a0414",
                    "sense_definition": "onderhevig aan wisselende stemmingen of onvoorspelbaar gedrag",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is erg <w>humeurig</w> en kan het ene moment lachen en het andere moment huilen.",
                            "target_lang_translations": {
                                "en": "She is very <w>moody</w> and can be laughing one moment and crying the next."
                            }
                        },
                        {
                            "text": "Het weer in de bergen is vaak <w>humeurig</w> en verandert zonder waarschuwing.",
                            "target_lang_translations": {
                                "en": "The weather in the mountains is often <w>unpredictable</w> and changes without warning."
                            }
                        }
                    ],
                    "synonyms": [
                        "nukkig",
                        "chagrijnig",
                        "prikkelbaar"
                    ],
                    "antonyms": [
                        "stabiel",
                        "gelijkmatig"
                    ],
                    "common_phrases": [
                        "humeurig karakter"
                    ],
                    "target_lang_definitions": {
                        "en": "subject to changing moods or unpredictable behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moody",
                                "target_lang_sense_clarification": "having moods that change quickly and often"
                            },
                            {
                                "target_lang_word": "temperamental",
                                "target_lang_sense_clarification": "unpredictable in behavior or mood"
                            },
                            {
                                "target_lang_word": "capricious",
                                "target_lang_sense_clarification": "changing mood or behavior suddenly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
