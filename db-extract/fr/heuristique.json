                "senses": [
                    {
                        "sense_id": "3fad51fe-792c-378b-8c72-c80b820aa08b",
                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "glosses": [
                            "Art d’inventer, de faire des découvertes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35961f89-9849-314d-ac98-a4d0bec8c763",
                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "glosses": [
                            "Art de repérer de manière exhaustive toute la documentation relative à un sujet d’étude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44bc8fa-126b-4b9b-a2b9-1e1598af1849",
                                "sense_id": "35961f89-9849-314d-ac98-a4d0bec8c763",
                                "text": "Certaines enquêtes ne retiennent que les études qui leur paraissent de bonne qualité ; d’autres sont moins exigeantes et il est probable que les précautionnistes ou les écologistes ont tendance à privilégier les travaux les plus pessimistes, au nom de l’heuristique de la peur, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a1b629-6a43-3118-91ab-567155dbbadc",
                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "glosses": [
                            "Discipline qui se propose de dégager les règles de la recherche scientifique et de la découverte."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "185829f9-da84-377f-b9b3-1f7d96b26bdf",
                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "glosses": [
                            "Suite d'opérations mentales simples conduisant à une prise de décision rapide, ou à l’estimation d’un risque par exemple."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee61050f-63be-3ac7-897e-727e0e44735e",
                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "glosses": [
                            "Méthode de résolution de problèmes non fondée sur un modèle formel et qui n’aboutit pas nécessairement à une solution optimale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37f2818a-e6c6-4494-88eb-16129449559b",
                        "source_entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                        "source_sense_id": "3fad51fe-792c-378b-8c72-c80b820aa08b",
