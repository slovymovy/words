                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7df4675a-b081-3097-b260-2a3f80032a9c",
                                        "entry_id": "3e6e613e-ff4f-3e9d-a4f1-7dd711ae703b",
                                        "glosses": [
                                            "A contagious tropical disease, caused by the spirochete Treponema pertenue, characterized by yellowish or reddish tumors, which often resemble berries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0625aa4-cc0a-4a0f-ad1b-34ab826b42bb",
                                                "sense_id": "7df4675a-b081-3097-b260-2a3f80032a9c",
                                                "text": "Other threats came from organisms co-evolving with humans, including tapeworms and such spirochaetes as Treponema, the agent of syphilis, and the similar skin infection, yaws."
                                            }
                                        ]
                                    }
                                ]
                            },
