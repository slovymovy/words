        "nl-extract.jsonl": [
            {
                "entry_id": "25edb40d-3d7a-34d7-a6ae-df65e7d50def",
                "word": "vastberadenheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55a48869-bd7d-3d29-bb5a-4cb8610de552",
                        "entry_id": "25edb40d-3d7a-34d7-a6ae-df65e7d50def",
                        "glosses": [
                            "zonder op besluiten terug te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "623bc357-edf9-4c90-87d0-8c724cc6c51f",
                                "sense_id": "55a48869-bd7d-3d29-bb5a-4cb8610de552",
                                "text": "Op het bordje aan de voet van de boom schrijft de Society of European Affairs Professionals: *“Belangrijke kwesties moeten worden opgelost via discussie en besluitvorming, met vastberadenheid, geduld en toewijding."
                            },
                            {
                                "example_id": "d838850a-0be3-41b6-a87c-1266ec97400c",
                                "sense_id": "55a48869-bd7d-3d29-bb5a-4cb8610de552",
                                "text": "Zijn bewegingen zijn resoluut, zijn kin is hoog geheven. Wat Albert vooral ziet, is de heldere en directe blik van de luitenant. Een en al vastberadenheid. Opeens wordt hem alles duidelijk, alles."
                            },
                            {
                                "example_id": "695cac0e-5f3c-42fe-b89b-9389ff2e942b",
                                "sense_id": "55a48869-bd7d-3d29-bb5a-4cb8610de552",
                                "text": "Vooral de kracht en vastberadenheid van dit jonge meisje om anderen te helpen vond ik indrukwekkend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fa4256c-6133-4829-b57e-2807e37d12c7",
                        "source_entry_id": "25edb40d-3d7a-34d7-a6ae-df65e7d50def",
                        "source_sense_id": "55a48869-bd7d-3d29-bb5a-4cb8610de552",
                        "source_sense_description": "zonder op besluiten terug te komen",
                        "target_lang_word": "resolve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resolve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "affd13c9-3da3-3b72-ac77-b8827c97ab86",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To find a solution to (a problem)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8a70c21-26ce-49a2-af36-a4f4d883b3ca",
                                                "sense_id": "affd13c9-3da3-3b72-ac77-b8827c97ab86",
                                                "text": "Exeter. Shall I call in Thambaſſadors my Liege? / King. Not yet my Couſin, til we be reſolude / Of ſome ſerious matters touching vs and France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e012a7b7-fd8d-3d10-809e-8405e495c0d1",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To reduce to simple or intelligible notions; to make clear or certain; to unravel; to explain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4fd96b-71e1-445a-a524-abbf0e66d9a7",
                                                "sense_id": "e012a7b7-fd8d-3d10-809e-8405e495c0d1",
                                                "text": "to resolve a riddle"
                                            },
                                            {
                                                "example_id": "1fbe7735-9d39-414b-875a-8f4c49706212",
                                                "sense_id": "e012a7b7-fd8d-3d10-809e-8405e495c0d1",
                                                "text": "Resolve my doubt."
                                            },
                                            {
                                                "example_id": "a797e16d-8703-45ad-9bcb-c62fd3b08339",
                                                "sense_id": "e012a7b7-fd8d-3d10-809e-8405e495c0d1",
                                                "text": "If such a dreamy touch should fall,\n⁠O turn thee round, resolve the doubt,\n⁠My guardian angel will speak out\nIn that high place, and tell thee all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a2e01f8-9023-3ef8-a011-5b26c988b7e6",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To make a firm decision to do something. To become determined to reach a certain goal or take a certain action."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1b782f-9578-4073-8e3e-de4705be4ab4",
                                                "sense_id": "9a2e01f8-9023-3ef8-a011-5b26c988b7e6",
                                                "text": "I resolve to finish this work before I go home."
                                            },
                                            {
                                                "example_id": "8f3f7846-2534-42e9-a156-2ef9f7a7c046",
                                                "sense_id": "9a2e01f8-9023-3ef8-a011-5b26c988b7e6",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c480c3d-041b-3a65-800d-192b880845d2",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To determine or decide in purpose; to make ready in mind; to fix; to settle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e81625-486c-4a0c-ae57-7638358d8442",
                                                "sense_id": "1c480c3d-041b-3a65-800d-192b880845d2",
                                                "text": "He was resolved by an unexpected event."
                                            },
                                            {
                                                "example_id": "87c17f2b-6e3f-49ae-b971-a8189d6c3ebc",
                                                "sense_id": "1c480c3d-041b-3a65-800d-192b880845d2",
                                                "text": "Gentlemen, importune me no farther, / For hovv I firmly am reſolu'd you knovv: / That is, not to beſtovv my yongeſt daughter, / Before I haue a husband for the elder: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46921adf-0766-39f3-b272-837380ce41bf",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To come to an agreement or make peace; patch up relationship, settle differences, bury the hatchet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4993b7fa-0b24-4b6c-b3b9-aa627f7b1081",
                                                "sense_id": "46921adf-0766-39f3-b272-837380ce41bf",
                                                "text": "After two weeks of bickering, they finally resolved their differences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4196741b-1d8b-321e-a1e1-cd9a9494cbfa",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To break down into constituent parts; to decompose; to disintegrate; to return to a simpler constitution or a primeval state."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b67b1f-16f9-4219-9f7f-36d114d90813",
                                                "sense_id": "4196741b-1d8b-321e-a1e1-cd9a9494cbfa",
                                                "text": "O, that this too too solid flesh would melt, / Thaw, and resolve itself into a dew!"
                                            },
                                            {
                                                "example_id": "e13e2bbb-b5fa-4411-95ab-18984ee24a97",
                                                "sense_id": "4196741b-1d8b-321e-a1e1-cd9a9494cbfa",
                                                "text": "And ye Immortal Souls, that once vvere Men, / And novv reſolv’d to Elements agen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91de2685-e64e-3af7-9084-a7c78830e0ce",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To cause to perceive or understand; to acquaint; to inform; to convince; to assure; to make certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e11bec-5337-42ff-a640-4ef7fa446eb7",
                                                "sense_id": "91de2685-e64e-3af7-9084-a7c78830e0ce",
                                                "text": "In health, good air, pleasure, riches, I am resolved it cannot be equalled by any region."
                                            },
                                            {
                                                "example_id": "9b452952-dfa3-4f5e-8f38-079f3ca64a0c",
                                                "sense_id": "91de2685-e64e-3af7-9084-a7c78830e0ce",
                                                "text": "We must be resolved how the law can be pure and perspicuous, and yet throw a polluted skirt over these Eleusinian mysteries."
                                            },
                                            {
                                                "example_id": "6d058d5f-d517-46dd-85ec-033bece0be8a",
                                                "sense_id": "91de2685-e64e-3af7-9084-a7c78830e0ce",
                                                "text": "Reſolve me Reaſon, vvhich of theſe is vvorſe, / VVant vvith a full, or vvith an empty purſe: […]"
                                            },
                                            {
                                                "example_id": "257bea8a-819d-4405-851d-ffcf253955f9",
                                                "sense_id": "91de2685-e64e-3af7-9084-a7c78830e0ce",
                                                "text": "She was proceeding in this manner when the surgeon entered the room. The lieutenant immediately asked how his patient did. But he resolved him only by saying, \"Better, I believe, than he would have been by this time, if I had not been called; and even as it is, perhaps it would have been lucky if I could have been called sooner.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d203df32-ba77-3a13-9958-c63889c1039a",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To cause a chord to go from dissonance to consonance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a1ad587-9814-3bb6-8b91-88b03a7a6ac6",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To render visible or distinguishable the parts of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79513d5c-26be-44e9-af76-4c96d8e2ec8f",
                                                "sense_id": "0a1ad587-9814-3bb6-8b91-88b03a7a6ac6",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93fac1d0-c8e8-361e-ba6d-db6bbfe77275",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To find the IP address of a hostname, or the entity referred to by a symbol in source code; to look up."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2616031b-b56f-3b8c-b2a0-22c802342fee",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To melt; to dissolve; to liquefy or soften (a solid)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54fbeab-dcf7-4801-a997-c6351f452136",
                                                "sense_id": "2616031b-b56f-3b8c-b2a0-22c802342fee",
                                                "text": "With milke-white Hartes vpon an Iuorie ſled, / Thou ſhalt be drawen amidſt the froſen Pooles, / And ſcale the yſie mountaines lofty tops: / Which with thy beautie will be soone reſolu’d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f15b962-868e-3a6f-a900-65a79e024677",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To melt; to dissolve; to become liquid."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84036ad6-1b36-47bb-b980-de59128e25ab",
                                                "sense_id": "4f15b962-868e-3a6f-a900-65a79e024677",
                                                "text": "When the blood stagnates in any part, it first coagulates, then resolves, and turns alkaline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9178bc12-0b16-3057-953c-268e421f63b2",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To liquefy (a gas or vapour)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7de4a0ac-6738-36ab-a496-5789bbf58599",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To disperse or scatter; to discuss, as an inflammation or a tumour."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17c5b8cb-f894-3124-a56c-16547030d26c",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To relax; to lie at ease."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0f6694-eb21-4c01-bbee-2031cb096c4e",
                                                "sense_id": "17c5b8cb-f894-3124-a56c-16547030d26c",
                                                "text": "resolve himself into all sports and looseness again"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "493bb3b4-3063-305b-a25f-c3ceb391edb2",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
                                        "glosses": [
                                            "To separate racemic compounds into their enantiomers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf83351c-5ed7-3a72-a832-7867453dcb7e",
                                        "entry_id": "46f296b1-a18e-34da-a489-17383f650895",
