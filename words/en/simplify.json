{
    "word_family": [
        "simple",
        "simplicity",
        "simplification",
        "simplistic",
        "simplifier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9fc12710-79e7-3045-bfcd-358bda4a285b",
                    "sense_definition": "To make something easier to understand or less complicated by reducing its complexity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "make_simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher tried to <w>simplify</w> the complex math problem for the students.",
                            "target_lang_translations": {
                                "ru": "Учитель попытался <w>упростить</w> сложную математическую задачу для учеников."
                            }
                        },
                        {
                            "text": "We need to <w>simplify</w> the process to save time and reduce errors.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>упростить</w> процесс, чтобы сэкономить время и уменьшить количество ошибок."
                            }
                        }
                    ],
                    "synonyms": [
                        "decomplexify",
                        "decomplicate",
                        "uncomplicate"
                    ],
                    "antonyms": [
                        "complicate",
                        "elaborate"
                    ],
                    "common_phrases": [
                        "simplify the process",
                        "simplify the explanation",
                        "simplify the rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более понятным или менее сложным за счет уменьшения его запутанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрощать",
                                "target_lang_sense_clarification": "делать более простым"
                            },
                            {
                                "target_lang_word": "упростить",
                                "target_lang_sense_clarification": "сделать более понятным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "852be95e-4f3f-3f93-829c-d052e0d19181",
                    "sense_definition": "To become less complex or easier in nature over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "become_simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists observed that certain languages tend to <w>simplify</w> over many centuries.",
                            "target_lang_translations": {
                                "ru": "Лингвисты заметили, что некоторые языки имеют тенденцию <w>упрощаться</w> на протяжении многих веков."
                            }
                        },
                        {
                            "text": "As the software evolved, the user interface began to <w>simplify</w> naturally.",
                            "target_lang_translations": {
                                "ru": "По мере развития программного обеспечения пользовательский интерфейс начал естественным образом <w>упрощаться</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tend to simplify",
                        "simplify over time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться менее сложным или более легким по своей природе с течением времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрощаться",
                                "target_lang_sense_clarification": "становиться проще"
                            },
                            {
                                "target_lang_word": "упроститься",
                                "target_lang_sense_clarification": "стать менее сложным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}