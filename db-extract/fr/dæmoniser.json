                "senses": [
                    {
                        "sense_id": "ed25d315-e443-3192-86c1-a3ce4bc0d7dc",
                        "entry_id": "897433c0-f65e-301f-b748-8e96b3f88fc1",
                        "glosses": [
                            "Faire devenir un dæmon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38496e51-6ad5-42f5-8dd6-f45d17c4ec55",
                                "sense_id": "ed25d315-e443-3192-86c1-a3ce4bc0d7dc",
                                "text": "D'autre part, et c'est l'objet de mon post, je voudrais que cette application puisse forker et dæmoniser sur demande de l'utilisateur, c'est-à-dire sur un clic de l'utilisateur."
                            },
                            {
                                "example_id": "eb584acd-8666-4965-937e-fc07f275e2e1",
                                "sense_id": "ed25d315-e443-3192-86c1-a3ce4bc0d7dc",
                                "text": "Enfin, techniquement un script de init.d ne dæmonise pas un processus, le processus doit le gérer lui même pour bien faire."
                            },
                            {
                                "example_id": "09f02c96-c06a-448d-80cb-6632c26ae7b2",
                                "sense_id": "ed25d315-e443-3192-86c1-a3ce4bc0d7dc",
                                "text": "Le script ne se dæmonise pas (c.à.d. ne se détache pas du terminal)."
                            }
                        ]
                    }
