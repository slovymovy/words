            "senses": [
                {
                    "sense_id": "2721be57-b826-36dd-a42c-a224e27f2b3c",
                    "sense_definition": "De uitkomst of het resultaat van een onderzoek, waarneming of analyse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderzoeksresultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetenschapper presenteerde zijn belangrijkste <w>bevindingen</w> tijdens de internationale conferentie.",
                            "target_lang_translations": {
                                "en": "The scientist presented his most important <w>findings</w> during the international conference."
                            }
                        },
                        {
                            "text": "Op basis van deze <w>bevinding</w> moeten we onze strategie voor het project aanpassen.",
                            "target_lang_translations": {
                                "en": "Based on this <w>finding</w>, we need to adjust our strategy for the project."
                            }
                        },
                        {
                            "text": "De <w>bevindingen</w> van het onderzoek kun je vinden onder het kopje conclusies.",
                            "target_lang_translations": {
                                "en": "The <w>findings</w> of the study can be found under the conclusions heading."
                            }
                        }
                    ],
