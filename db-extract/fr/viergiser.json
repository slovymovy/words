                "senses": [
                    {
                        "sense_id": "0856fbc7-3c53-3104-80da-7ef6512cfeac",
                        "entry_id": "237240c0-6f77-3401-81ec-a3186bab7b71",
                        "glosses": [
                            "Rendre vierge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf0bf46-2021-4f9c-9b94-df0886260b24",
                                "sense_id": "0856fbc7-3c53-3104-80da-7ef6512cfeac",
                                "text": "Je pense que c'est possible de \"viergiser\" une actuelle. Il suffit de colorier en bleu la région qui est jaune et d'effacer le S.35 qui est en rouge."
                            },
                            {
                                "example_id": "700993b9-a876-4bfc-b828-82d4c8bc8d2b",
                                "sense_id": "0856fbc7-3c53-3104-80da-7ef6512cfeac",
                                "text": "J'ai bien essayé de “viergiser” le dossier /home/ricardo/.kde/share/config mais rien de mieux et il me faudrait tout reconfigurer, ce qui me gonflerait"
                            },
                            {
                                "example_id": "f860a1e2-d380-43e6-a748-ea2583eddcfc",
                                "sense_id": "0856fbc7-3c53-3104-80da-7ef6512cfeac",
                                "text": "Même si le remake est moins \"provocant\", et qu'il est \"hollywoodisé\", \"viergisé\", \"bodybuildé\" et \"moralisé\" (ce qu'on ne lui souhaite pas quand même), il peut toujours donner quelque chose de convenable."
                            }
                        ]
                    }
