                "senses": [
                    {
                        "sense_id": "07a3ed01-737b-326b-8fa4-2347c37ec715",
                        "entry_id": "bdac6df4-8e6c-3f94-9d02-375d16515d35",
                        "glosses": [
                            "de mate waarin een mens of dier trouw en toegenegen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebce360d-8b2f-4bff-8558-b3c99277e73e",
                                "sense_id": "07a3ed01-737b-326b-8fa4-2347c37ec715",
                                "text": "Door zijn aanhankelijkheid wordt de poes als een prettig huisdier ervaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f02c95-70d8-47fa-9d78-4acdddba3ad1",
                        "source_entry_id": "bdac6df4-8e6c-3f94-9d02-375d16515d35",
                        "source_sense_id": "07a3ed01-737b-326b-8fa4-2347c37ec715",
                        "source_sense_description": "de mate waarin een mens of dier trouw en toegenegen is",
                        "target_lang_word": "Anhänglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anhänglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de63a53a-39c8-35c2-9547-2b7425f2ef5c",
                                        "entry_id": "9fac55b3-bc65-3c5d-9cf4-6c5d6b140693",
                                        "glosses": [
                                            "die Eigenschaft, anhänglich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a4c510-3580-40f4-9375-9b86503e5503",
                                                "sense_id": "de63a53a-39c8-35c2-9547-2b7425f2ef5c",
                                                "text": "Mich stört ihre übertriebene Anhänglichkeit."
                                            },
                                            {
                                                "example_id": "26df98e1-1b78-4352-9a0c-54ecce91ee3a",
                                                "sense_id": "de63a53a-39c8-35c2-9547-2b7425f2ef5c",
                                                "text": "„Da man wußte, daß die alte Jüdin mit den Roten in Verbindung stand, wäre sie früher oder später auch dann erschossen worden, wenn diese halbverbrannten Papierfetzen nichts weiter enthalten hätten als gleichgültige Zeugnisse von der Anhänglichkeit des Sohnes an die Mutter, hinter denen sich aber möglicherweise Mitteilungen in Schlüsselschrift verbargen.“"
                                            },
                                            {
                                                "example_id": "2ed467fa-d1b8-4498-aba7-ca13017aa8d6",
                                                "sense_id": "de63a53a-39c8-35c2-9547-2b7425f2ef5c",
                                                "text": "„Aber selbst die Gefahr hatte die Anhänglichkeit nicht verdrängt.“"
                                            },
                                            {
                                                "example_id": "bc199e17-85f6-4be8-8735-7dcb6a813f21",
                                                "sense_id": "de63a53a-39c8-35c2-9547-2b7425f2ef5c",
                                                "text": "„Ihre Anhänglichkeit an ihn hat sie in diese furchtbare Lage gebracht, die panische Suche nach einer Rettung für sie lähmt seine Schaffenskraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b6e9490-235d-47c0-b139-b03a1f0c431a",
                        "source_entry_id": "bdac6df4-8e6c-3f94-9d02-375d16515d35",
                        "source_sense_id": "07a3ed01-737b-326b-8fa4-2347c37ec715",
                        "source_sense_description": "de mate waarin een mens of dier trouw en toegenegen is",
                        "target_lang_word": "affection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7173891e-385b-3f24-8bb7-c819c812bc0b",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "The act of affecting or acting upon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "731106d6-e716-34f9-b582-27e0df530fc8",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "The state of being affected, especially: a change in, or alteration of, the emotional state of a person or other animal, caused by a subjective affect (a subjective feeling or emotion), which arises in response to a stimulus which may result from either thought or perception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23283372-0df1-31bf-93fb-354e0f9b5ad2",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "An attribute; a quality or property; a condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094c0f8b-c0ec-4005-9443-11344823470e",
                                                "sense_id": "23283372-0df1-31bf-93fb-354e0f9b5ad2",
                                                "text": "A Porism is a proposition in which it is proposed to demonstrate that some one thing, or more things than one, are given, to which, as also to each of innumerable other things, not given indeed, but which have the same relation to those which are given, it is to be shewn that there belongs some common affection described in the proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "An emotion; a feeling or natural impulse acting upon and swaying the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743bd066-64ad-4cb3-a562-9755d621f981",
                                                "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                                "text": "Our affections for wild animals are distributed very unevenly. Take insects."
                                            },
                                            {
                                                "example_id": "afcb332f-ff1f-4d75-85d2-00caf288a3b4",
                                                "sense_id": "88db41c7-22a5-3ef2-9e31-1b722d27a458",
                                                "text": "It is known that each individual has a variety of affections, one affection when in joy, another when in grief, another when in sympathy and compassion, another when in sincerity and truth, another when in love and charity, another when in zeal or in anger, another when in simulation and deceit, another when in quest of honor and glory, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "A feeling of love or strong attachment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a08810f-a2b9-489a-8c97-4a6ebd86e674",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "I have a lot of affection for my little sister."
                                            },
                                            {
                                                "example_id": "09e8b2bc-7b27-41ac-83bd-2fea9ebe7aab",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "The marriage therapist suggested they show each other more affection."
                                            },
                                            {
                                                "example_id": "f9fef831-3023-4cd5-9986-f1a6e23cd8f6",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "Mr. Bennet missed his second daughter exceedingly; his affection for her drew him oftener from home than anything else could do. He delighted in going to Pemberley, especially when he was least expected."
                                            },
                                            {
                                                "example_id": "78a60b5c-c12e-4e56-a09a-4bc3de6fda9d",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "What is more, they are protected from even such discomfort as the dislike of his prisoners may cause to a gaoler by the hypnotism of the convention that the natural relation between husband and wife and parent and child is one of intense affection, and that to feel any other sentiment towards a member of one's family is to be a monster."
                                            },
                                            {
                                                "example_id": "2bf64a08-5c95-420f-80ea-42da39f87a64",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "\"Did you ever like me back, Ryan? All those years, I didn't know how to show my affection for you, so I wasn't sure if you weren't getting it or you just didn't care. But I need to know which it was.\""
                                            },
                                            {
                                                "example_id": "c4795bc4-5d66-4eb5-880a-b06eebefcb14",
                                                "sense_id": "4ab04238-0626-3367-bc54-83151b609e68",
                                                "text": "Dated a girl that I hate, for the attention / She only made it two days, what a connection / It's like you'd do anything, for my affection / You're going all about it in the worst ways"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                        "entry_id": "8af1ccf5-14ad-34c6-8c79-db638249d886",
                                        "glosses": [
                                            "A disease; a morbid symptom; a malady."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e13e11-d928-44d2-97a2-5fad30fb0e80",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "a pulmonary affection"
                                            },
                                            {
                                                "example_id": "4404baa6-9f42-45e4-b339-5b6040468108",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "The recedent or retrograde form is marked by a sudden subsidence of the inflammatory state of the joints, succeeded immediately by an affection of some internal part, where is thenceforth the seat of the morbid manifestations."
                                            },
                                            {
                                                "example_id": "2b5cfe34-39dc-4389-a140-41b81161d4de",
                                                "sense_id": "e38e657d-7419-339e-b640-65c1d5f9c49d",
                                                "text": "A heavy clay soil is bad for all neuralgics, and the house should be dry, and on a sandy or gravel soil. The desideratum for all neuralgic affections is perpetual summer […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf12a52-7e63-3270-b6c4-1fb53a40a3a3",
                                        "entry_id": "00758d05-2e03-3429-8175-e539f560093d",
                                        "glosses": [
                                            "To feel affection for."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7884f88-c359-4a09-b88e-766bc9df11ff",
                                                "sense_id": "cdf12a52-7e63-3270-b6c4-1fb53a40a3a3",
                                                "text": "Why, truth is truth, I do not think my lady Isabella ever much affectioned my young lord, your son: yet he was a sweet youth as one should see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdd5a4d5-4ceb-4fa9-bffd-af4ec185bd68",
                        "source_entry_id": "bdac6df4-8e6c-3f94-9d02-375d16515d35",
                        "source_sense_id": "07a3ed01-737b-326b-8fa4-2347c37ec715",
                        "source_sense_description": "de mate waarin een mens of dier trouw en toegenegen is",
                        "target_lang_word": "attachement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attachement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                        "entry_id": "f415fb57-0d93-33c7-8d57-a5ace950596c",
                                        "glosses": [
                                            "Sentiment qui fait qu’on s’attache fortement et volontairement à quelqu’un, à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2268656c-e57a-4daf-af13-b96fc0947d7e",
                                                "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                                "text": "Il avait pour elle un attachement solide et vertueux, et Sémire l'aimait avec passion."
                                            },
                                            {
                                                "example_id": "0ab6680a-f6b3-40f6-a85f-0f7b5824674d",
                                                "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                                "text": "L'ordre de l'Oratoire, […], fut obligé d'y renoncer ; et l'attachement du P. Lami au cartésianisme lui valut dans cet ordre les mêmes persécutions qu'eut à souffrir dans la Compagnie de Jésus le P. André comme malebranchiste."
                                            },
                                            {
                                                "example_id": "98400493-d846-4c5c-964b-a4ffb1b2d2c2",
                                                "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                                "text": "Il y a dix ans que je vous connais, croyez-le, et je m'attendais à votre ingratitude. Ainsi je n'ai mérité qu'un attachement vulgaire, et il a suffi qu'une petite fille minaudière et coquette se jouât de vous pour vous détourner en un instant de celle..."
                                            },
                                            {
                                                "example_id": "6f656a5d-d324-4fb3-ab03-101d6834a0b2",
                                                "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                                "text": "D'autre part, Péchenard écrit que le pasteur de Gespunsart, « à cause de son attachement aux erreurs jansénistes » fut dénoncé par ses paroissiens à l'autorité diocésaine. Il fut donc interdit par l'archevêque de Mailly."
                                            },
                                            {
                                                "example_id": "584de0a8-17c2-4f11-b1d2-b29c9f5fba94",
                                                "sense_id": "3aadcf18-bae5-328c-8a04-a10c46290614",
                                                "text": "Malheureusement, il n'existait aucun attachement philosophique au laïcisme et à ses valeurs de scepticisme, d'expérimentation et de tolérance, si essentielles au pluralisme politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe265a0-ffd6-3fcb-abe3-0c07dea6a23d",
                                        "entry_id": "f415fb57-0d93-33c7-8d57-a5ace950596c",
                                        "glosses": [
                                            "Grande application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fb1aa7-20f6-47ae-824a-92ec3c50a873",
                                                "sense_id": "7fe265a0-ffd6-3fcb-abe3-0c07dea6a23d",
                                                "text": "Avoir de l’attachement à l’étude."
                                            },
                                            {
                                                "example_id": "07ba007a-13ea-4b6e-8955-987066e7deec",
                                                "sense_id": "7fe265a0-ffd6-3fcb-abe3-0c07dea6a23d",
                                                "text": "Avoir de l’attachement au travail, à l’ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9de9a49-3725-34ef-be8f-d55ae297aa71",
                                        "entry_id": "f415fb57-0d93-33c7-8d57-a5ace950596c",
                                        "glosses": [
                                            "Notion de base de la théorie de l’attachement, considérant le fait pour un enfant de s’attacher, d’avoir une relation avec au moins une personne qui prend soin de lui de façon cohérente et continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba024aac-8ac3-42e6-a44a-dcc1a6e4fb80",
                                                "sense_id": "e9de9a49-3725-34ef-be8f-d55ae297aa71",
                                                "text": "La théorie de l’attachement est une théorie décrite par John Bowlby (psychiatre britannique) en 1969. Son postulat est que nous développons un certain type d’attachement dans nos relations qui dépend de la qualité des soins que l’on a reçu lors de notre petite enfance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
