                                "target_senses": [
                                    {
                                        "sense_id": "4d0a2195-987f-3e30-9e8d-216e8dbf124d",
                                        "entry_id": "ce36088d-1684-327d-a528-e79b758f6498",
                                        "glosses": [
                                            "Wissenschaft von den dichterischen Gesetzen des Dramas und seiner Darstellung auf der Bühne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41c7ab44-2d49-4038-94b7-17c3105749e3",
                                                "sense_id": "4d0a2195-987f-3e30-9e8d-216e8dbf124d",
                                                "text": "In Leipzig begann er das Studium der Dramaturgie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e656ed35-b7fe-35f8-9266-410acec1fc79",
                                        "entry_id": "ce36088d-1684-327d-a528-e79b758f6498",
                                        "glosses": [
                                            "dramatische Gestalt, dramatische Struktur eines Dramas (zum Beispiel Film, Hörspiel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d814b625-56a7-4859-9346-5c59049d0ea8",
                                                "sense_id": "e656ed35-b7fe-35f8-9266-410acec1fc79",
                                                "text": "Die besonders gute Dramaturgie der Inszenierung ließ sie über das mittelmäßige Spiel der Schauspieler hinwegsehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74babc79-e540-3c91-ad18-ab0afaa70cdb",
                                        "entry_id": "ce36088d-1684-327d-a528-e79b758f6498",
                                        "glosses": [
                                            "eine Abteilung, auch die Einrichtung, in der Dramaturgen arbeiten"
                                        ],
                                        "tags": [
                                            "Theater",
                                            "Funk",
                                            "Fernsehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af848192-a1c6-4ba6-827c-6308210546b6",
                                                "sense_id": "74babc79-e540-3c91-ad18-ab0afaa70cdb",
                                                "text": "Die Dramaturgie des Theaters hatte nach vielen anstrengend Monaten das Wochenende über frei."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
