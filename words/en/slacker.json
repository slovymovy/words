{
    "word_family": [
        "slack",
        "slacken",
        "slackness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5249557d-46b2-3fb4-9795-05a40cff9d36",
                    "sense_definition": "A lazy person who avoids work, effort, or responsibility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lazy_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to work with the <w>slacker</w> on the group science project.",
                            "target_lang_translations": {
                                "de": "Niemand wollte bei dem naturwissenschaftlichen Gruppenprojekt mit dem <w>Drückeberger</w> zusammenarbeiten."
                            }
                        },
                        {
                            "text": "He was labeled a <w>slacker</w> because he spent all day playing video games instead of studying.",
                            "target_lang_translations": {
                                "de": "Er wurde als <w>Faulpelz</w> abgestempelt, weil er den ganzen Tag Videospiele spielte, anstatt zu lernen."
                            }
                        }
                    ],
                    "synonyms": [
                        "idler",
                        "shirker",
                        "loafer"
                    ],
                    "antonyms": [
                        "hard worker",
                        "overachiever"
                    ],
                    "common_phrases": [
                        "total slacker",
                        "lazy slacker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for an idler"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine faule Person, die Arbeit, Anstrengung oder Verantwortung vermeidet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Faulpelz",
                                "target_lang_sense_clarification": "Person, die faul ist und Anstrengung scheut"
                            },
                            {
                                "target_lang_word": "Drückeberger",
                                "target_lang_sense_clarification": "Person, die sich vor Pflichten oder Aufgaben drückt"
                            },
                            {
                                "target_lang_word": "Nichtstuer",
                                "target_lang_sense_clarification": "Person, die untätig ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93860269-b96f-355b-aca8-9b3536c0bac3",
                    "sense_definition": "A person lacking ambition, purpose, or a sense of direction in life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lazy_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics unfairly dismissed the entire generation as aimless <w>slackers</w>.",
                            "target_lang_translations": {
                                "de": "Kritiker taten die gesamte Generation unfairerweise als ziellose <w>Nichtstuer</w> ab."
                            }
                        },
                        {
                            "text": "After college, he spent a year living like a <w>slacker</w> before finding a career.",
                            "target_lang_translations": {
                                "de": "Nach dem College lebte er ein Jahr lang wie ein <w>Taugenichts</w>, bevor er eine berufliche Laufbahn einschlug."
                            }
                        }
                    ],
                    "synonyms": [
                        "underachiever",
                        "drifter"
                    ],
                    "antonyms": [
                        "go-getter"
                    ],
                    "common_phrases": [
                        "generation of slackers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for an underachiever"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, der es an Ehrgeiz, Zielen oder einer Richtung im Leben fehlt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Taugenichts",
                                "target_lang_sense_clarification": "ziellose oder unproduktive Person"
                            },
                            {
                                "target_lang_word": "Herumtreiber",
                                "target_lang_sense_clarification": "Person ohne feste Beschäftigung oder Ziel"
                            },
                            {
                                "target_lang_word": "Slacker",
                                "target_lang_sense_clarification": "Jugend- bzw. Umgangssprache für jemanden ohne Ambitionen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "463cb007-0dee-3754-8550-c7d17b68a51a",
                    "sense_definition": "A member of a 1990s youth subculture characterized by an apathetic attitude toward conventional careers and societal expectations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Independent films of the 1990s often celebrated the lifestyle of the young <w>slacker</w>.",
                            "target_lang_translations": {
                                "de": "Independent-Filme der 1990er-Jahre zelebrierten oft den Lebensstil des jungen <w>Slackers</w>."
                            }
                        },
                        {
                            "text": "The movie captured the mood of nineties <w>slackers</w> who rejected corporate culture.",
                            "target_lang_translations": {
                                "de": "Der Film fing die Stimmung der Neunzigerjahre-<w>Slacker</w> ein, die die Unternehmenskultur ablehnten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slacker culture"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "specifically associated with the 1990s and Generation X"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Angehöriger einer Jugend-Subkultur der 1990er-Jahre, die durch Gleichgültigkeit gegenüber traditionellen Karrieren und gesellschaftlichen Erwartungen geprägt war."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Slacker",
                                "target_lang_sense_clarification": "im kulturhistorischen Sinne der 1990er Jahre"
                            },
                            {
                                "target_lang_word": "Nullbock-Typ",
                                "target_lang_sense_clarification": "Person mit demonstrativer Null-Bock-Haltung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff8be0c7-5e46-3732-977b-85d7ca1245c7",
                    "sense_definition": "A person who attempts to evade or shirk mandatory military service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the war, local authorities conducted raids to arrest suspected military <w>slackers</w>.",
                            "target_lang_translations": {
                                "de": "Während des Krieges führten örtliche Behörden Razzien durch, um mutmaßliche militärische <w>Drückeberger</w> festzunehmen."
                            }
                        },
                        {
                            "text": "Wartime propaganda condemned any young man who acted as a <w>slacker</w> instead of enlisting.",
                            "target_lang_translations": {
                                "de": "Kriegspropaganda verurteilte jeden jungen Mann, der sich als <w>Drückeberger</w> erwies, anstatt sich freiwillig zu melden."
                            }
                        }
                    ],
                    "synonyms": [
                        "draft dodger"
                    ],
                    "antonyms": [
                        "enlistee"
                    ],
                    "common_phrases": [
                        "slacker raid"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used during early 20th-century conscription eras"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die versucht, sich dem Wehrdienst zu entziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wehrdienstverweigerer",
                                "target_lang_sense_clarification": "Person, die den Militärdienst ablehnt"
                            },
                            {
                                "target_lang_word": "Drückeberger",
                                "target_lang_sense_clarification": "Person, die sich dem Wehrdienst entzieht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61650a52-5a75-39ab-87e1-263db33c24d9",
                    "sense_definition": "A user of the Slackware Linux operating system distribution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The online forum was full of experienced <w>slackers</w> helping beginners compile software.",
                            "target_lang_translations": {
                                "de": "Das Online-Forum war voll von erfahrenen <w>Slackware-Nutzern</w>, die Anfängern beim Kompilieren von Software halfen."
                            }
                        },
                        {
                            "text": "He has been a dedicated <w>slacker</w> since installing the operating system in the late nineties.",
                            "target_lang_translations": {
                                "de": "Seit er das Betriebssystem Ende der neunziger Jahre installiert hat, ist er ein überzeugter <w>Slackware-Nutzer</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing community jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Benutzer der Slackware-Linux-Distribution."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Slackware-Nutzer",
                                "target_lang_sense_clarification": "Anwender von Slackware Linux"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "758b2743-8dfb-38fe-8084-4f3e9696eb7b",
                    "sense_definition": "Comparative form of <w>slack</w>: more loose, slow, or inactive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comparative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rope hung noticeably <w>slacker</w> after the heavy anchor dropped to the seabed.",
                            "target_lang_translations": {
                                "de": "Das Seil hing spürbar <w>lockerer</w>, nachdem der schwere Anker auf den Meeresgrund gefallen war."
                            }
                        },
                        {
                            "text": "Shop owners often reduce employee hours during the <w>slacker</w> months of winter.",
                            "target_lang_translations": {
                                "de": "Ladenbesitzer reduzieren die Arbeitszeiten ihrer Angestellten in den <w>ruhigeren</w> Wintermonaten oft."
                            }
                        }
                    ],
                    "synonyms": [
                        "looser"
                    ],
                    "antonyms": [
                        "tighter"
                    ],
                    "common_phrases": [
                        "slacker rope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative form of the adjective slack"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Komparativ von slack: lockerer, schlaffer oder ruhiger."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "lockerer",
                                "target_lang_sense_clarification": "weniger straff oder angespannt"
                            },
                            {
                                "target_lang_word": "schlaffer",
                                "target_lang_sense_clarification": "weniger fest"
                            },
                            {
                                "target_lang_word": "ruhiger",
                                "target_lang_sense_clarification": "geschäftlich weniger aktiv"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}