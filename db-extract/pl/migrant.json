                ],
                "senses": [
                    {
                        "sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                        "entry_id": "1ef9226a-4286-37f0-93a9-388be51c7e59",
                        "glosses": [
                            "osoba migrująca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18cf14f1-5ddb-487a-9dab-4fedc68a816c",
                                "sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                                "text": "Badaniami objęto dużą grupę migrantów zarobkowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51cfcaaf-977a-4621-b607-49c45c2066ac",
                        "source_entry_id": "1ef9226a-4286-37f0-93a9-388be51c7e59",
                        "source_sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                        "target_lang_word": "migrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a720da-72d6-3564-9f8c-13a2d4f29f43",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "A migratory animal, in particular a migratory bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44bff7d-fd74-4162-8c6e-967a1a2a7ec7",
                                                "sense_id": "e7a720da-72d6-3564-9f8c-13a2d4f29f43",
                                                "text": "Gilbert White writes, \"I have consulted a sportsman who tells me that […] often there are amongst them little parties of small blue doves which he calls rockiers. The food of these numberless migrants was beechmast and some acorns.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b68cf5c-191c-3db0-a9b4-4158d20e7889",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "Traveller or worker who moves from one region or country to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "A person who leaves one place in order to permanently settle in another."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b905f24-a022-493c-85f2-f58c71a8481b",
                                                "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                                "text": "These first English migrants to Jamestown endured terrible disease and arrived during a period of drought and colder-than-normal winters. The migrants to Roanoke on the outer banks of Carolina, where the English had gone in the 1580s, disappeared. And a brief effort to settle the coast of Maine in 1607 and 1608 failed because of an unusually bitter winter."
                                            },
                                            {
                                                "example_id": "897de4b3-1c6b-4503-89e5-8b1e1c873aa5",
                                                "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                                "text": "“But once you lose everything— your home, your school, your clinic, your road, your church—then it’s an impossible situation. You become an environmental migrant because you have to find those facilities in some other place.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8810dbfe-8bd0-3edb-ae90-8423631360a9",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "Any of various pierid butterflies of the genus Catopsilia. Also called an emigrant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "migrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af18e50f-a7b8-3ede-bf4d-480032abce33",
                                        "entry_id": "267bc2ed-eb91-398a-8481-82a98dcc265c",
                                        "glosses": [
                                            "Migratory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "829b017c-6eeb-4c9d-8b5a-71d13a45bd96",
                        "source_entry_id": "1ef9226a-4286-37f0-93a9-388be51c7e59",
                        "source_sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                        "target_lang_word": "migrant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c41daba-224e-3677-ada4-6eac394f6167",
                                        "entry_id": "e8c56c44-2266-3620-98ce-f75b3e434c56",
                                        "glosses": [
                                            "Qui migre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85d1705-4b45-4a9e-9412-732ce1fc997c",
                                                "sense_id": "1c41daba-224e-3677-ada4-6eac394f6167",
                                                "text": "À titre de professionnels de la santé et travailleurs de première ligne tentant de répondre aux besoins des personnes migrantes, nous dénonçons le moyen de pression de l'AQPP."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "migrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                        "entry_id": "505d1017-4133-3e96-be35-022d2d78ea4f",
                                        "glosses": [
                                            "Personne effectuant une migration volontaire ou subie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd2c960-8778-4937-8955-93ee22c9119f",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "S’agissant de l’intégration comme étant le dernier volet du processus, le migrant est en contact permanent avec la société dans le but de s’installer et de travailler."
                                            },
                                            {
                                                "example_id": "ba7d38e8-5fc6-415c-b4d6-41c37c48a5e2",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "Le recours à des migrants à fort potentiel démographique se rencontre même dans des États fédéraux comme le Canada où la « Belle province », le Québec, en panne démographique depuis quelques décennies mène une politique d’immigration francophone active pour maintenir son identité."
                                            },
                                            {
                                                "example_id": "d279a9bc-7ab9-4615-9be4-4da3eb962e6b",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "Comment est-on passé de ce mot des années 1990, \"sans-papiers\", mot juste, descriptif, à ce mot de \"migrant\", qui maintient les exilés en l'air, en suspens, au participe présent, quand les émigrés, au participe passé, peuvent enfin se poser ?"
                                            },
                                            {
                                                "example_id": "671563bb-a2b8-432f-9bf7-0ad42d8e7058",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "Migrants ou réfugiés ? Le débat sémantique s’installe en Europe pour savoir comment qualifier les milliers de personnes qui arrivent quotidiennement sur les côtes méditerranéennes. Le premier terme est fustigé pour ne pas refléter la détresse de ceux qui, le plus souvent, fuient un conflit."
                                            },
                                            {
                                                "example_id": "4b77c4ff-dfd7-444b-aeb3-41cd87b773ee",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "Durant les années 2000, ont été ouvertes des lignes aériennes à bas coûts au départ de petits aéroports régionaux comme ceux de Limoges ou de Bergerac. Elles ont pu renforcer l’attractivité de ces territoires pour des ménages plus modestes que ceux des premières vagues de migrants britanniques."
                                            },
                                            {
                                                "example_id": "bfe1c8b8-16ff-4a2f-9199-a7f9ff84dfd0",
                                                "sense_id": "e8e2a986-4b9c-3cc6-bf93-088566c93d2a",
                                                "text": "« Les migrants français aux Amériques (XIXᵉ - XXᵉ siècles), nouvel objet d'histoire »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "migrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acf88af9-9cac-37b2-8bf7-0a02a12e5dd5",
                                        "entry_id": "8b013f1f-9de3-324e-923a-9ff1d33a7608",
                                        "glosses": [
                                            "Participe présent de migrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2915e7-b6df-4529-beef-aa07a585d8d9",
                        "source_entry_id": "1ef9226a-4286-37f0-93a9-388be51c7e59",
                        "source_sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                        "target_lang_word": "migrante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1d74eadc-258f-4ea3-b265-08c17018403d",
                        "source_entry_id": "1ef9226a-4286-37f0-93a9-388be51c7e59",
                        "source_sense_id": "2046cc29-b5cb-3f66-ad8b-27ea836a0336",
                        "target_lang_word": "Migrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Migrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                        "entry_id": "b1c96f82-32aa-3247-ad92-8857e39eab4e",
                                        "glosses": [
                                            "Person, die von einem Land in ein anderes Land zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9de94662-30e3-4380-849c-5abdb6b473b5",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "Ein Boot mit Migranten aus Afrika war bei starkem Wind gesunken."
                                            },
                                            {
                                                "example_id": "492669bc-9f30-40e7-ae50-d46171344d15",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "In manchen Stadtteilen leben überwiegend Migranten."
                                            },
                                            {
                                                "example_id": "d1487b9a-3093-4d4b-ba77-315c4b332d0e",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "„Migranten hießen in den sechziger Jahren Gastarbeiter, in den Siebzigern Ausländer, in den Achtzigern ausländische Mitbürger, in den Neunzigern Asylanten oder Flüchtlinge.“"
                                            },
                                            {
                                                "example_id": "27421698-01a7-4d9e-b749-e3211c639cd0",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "Migranten werden in Deutschland bei der Wohnungssuche benachteiligt."
                                            },
                                            {
                                                "example_id": "6cf97532-064f-4fa3-afe3-4fa2a9dc4b1e",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "In Italien, das mit großem Einsatz Migranten aufnimmt, werden dieselben Migranten gnadenlos ausgebeutet. Große Teile der Landwirtschaft leben von diesen Ausgebeuteten."
                                            },
                                            {
                                                "example_id": "674b8349-5837-43d0-9ab4-1daea093f263",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "„Ich war naiv genug zu glauben, allein die westliche Lebensweise reiche aus, um in Deutschland als Migrant akzeptiert zu werden.“"
                                            },
                                            {
                                                "example_id": "aa2e2636-b14c-4907-9084-dba2123bf97e",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "„Eine zweite Quelle für Sprachveränderungen liegt in den Herkunftssprachen der Migranten.“"
                                            },
                                            {
                                                "example_id": "90cfee46-6aeb-44dd-95ad-40e6eeb6291a",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "Tausende Migranten hängen auf der griechischen Insel Chios fest. Sie dürfen nicht aufs Festland, aber freiwillig zurück in die Türkei wollen sie auch nicht."
                                            },
                                            {
                                                "example_id": "1e0dba1b-1a5a-48d1-aa7a-0d65657046cc",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "„Sie verändern das Bild von den Migranten und das von den Deutschen.“"
                                            },
                                            {
                                                "example_id": "ff3abdbb-d67a-493c-8104-9db492bdfa56",
                                                "sense_id": "424d3749-c2e4-390e-b84f-675746b775bb",
                                                "text": "„1991 beschloss das wiedervereinigte Deutschland, in großer Zahl jüdische Migrantinnen und Migranten aufzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
