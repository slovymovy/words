    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b99e47f-4f3b-3a79-964b-b85083139bd2",
                    "sense_definition": "To change one's behavior or appearance to match the standards or expectations of a group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult for teenagers to <w>conform</w> to the expectations of their peers."
                        },
                        {
                            "text": "He refused to <w>conform</w> to the dress code of the office."
                        }
                    ],
                    "synonyms": [
                        "conform",
                        "fall in line",
                        "follow the crowd",
                        "go with the flow"
                    ],
                    "antonyms": [
                        "nonconform"
                    ],
                    "common_phrases": [
                        "conform to expectations",
                        "conform to standards"
                    ]
                },
                {
                    "sense_id": "bd54147f-28ad-38d3-a100-d897fd242162",
                    "sense_definition": "To be in agreement with a rule, law, or technical specification.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building plans must <w>conform</w> to local safety regulations."
                        },
                        {
                            "text": "All products must <w>conform</w> to international quality standards."
                        }
                    ],
                    "synonyms": [
                        "comply"
                    ],
                    "common_phrases": [
                        "conform to rules",
                        "conform to regulations"
                    ]
                },
                {
                    "sense_id": "5b6a5b4b-ff62-373f-83d7-16c10cf16a24",
                    "sense_definition": "To adapt or adjust something so that it fits or matches a specific shape or structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new design <w>conforms</w> to the existing architecture of the city."
                        },
                        {
                            "text": "The material <w>conforms</w> to the shape of the object it covers."
                        }
                    ]
                }
            ]
        }
    ]
