{
    "word_family": [
        "supplementary",
        "supplemental",
        "supplementation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a33f81d-2947-36ae-8776-1f936a38dfa2",
                    "sense_definition": "A pill, powder, or drink containing vitamins, minerals, or other nutrients taken to improve one's diet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many athletes use protein <w>supplements</w> to help build muscle.",
                            "target_lang_translations": {
                                "ru": "Многие спортсмены используют белковые <w>добавки</w> для наращивания мышечной массы.",
                                "zh": "许多运动员使用蛋白质<w>补充剂</w>来帮助增加肌肉。"
                            }
                        },
                        {
                            "text": "The doctor recommended a daily iron <w>supplement</w> to treat her anemia.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал ежедневную <w>добавку</w> железа для лечения её анемии.",
                                "zh": "医生建议她每天服用铁质<w>补充剂</w>来治疗贫血。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dietary supplement",
                        "vitamin supplement",
                        "take supplements",
                        "food supplement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таблетка, порошок или напиток, содержащие витамины, минералы или другие питательные вещества, принимаемые для улучшения рациона.",
                        "zh": "含有维生素、矿物质或其他营养成分，用于改善饮食的药片、粉末或饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доба́вка",
                                "target_lang_sense_clarification": "пищевая / биологически активная"
                            },
                            {
                                "target_lang_word": "дополне́ние",
                                "target_lang_sense_clarification": "к питанию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补充剂",
                                "target_lang_sense_clarification": "营养或膳食补充剂"
                            },
                            {
                                "target_lang_word": "补品",
                                "target_lang_sense_clarification": "用于滋补或补充营养的食品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a6db4c6-5ac8-3398-87b5-8a7576ef17b5",
                    "sense_definition": "Something added to something else in order to improve it or complete it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The handout serves as a <w>supplement</w> to the main textbook.",
                            "target_lang_translations": {
                                "ru": "Раздаточный материал служит <w>дополнением</w> к основному учебнику.",
                                "zh": "这份讲义是主教材的<w>补充</w>。"
                            }
                        },
                        {
                            "text": "This report is a <w>supplement</w> to our previous findings on the subject.",
                            "target_lang_translations": {
                                "ru": "Этот отчет является <w>дополнением</w> к нашим предыдущим выводам по этому вопросу.",
                                "zh": "这份报告是对我们之前相关研究发现的<w>补充</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "supplement to"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что добавляется к чему-то другому с целью улучшения или завершения.",
                        "zh": "为改进或完善某事物而添加的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополне́ние",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "приложе́ние",
                                "target_lang_sense_clarification": "к документу или книге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补充",
                                "target_lang_sense_clarification": "一般性补充"
                            },
                            {
                                "target_lang_word": "附录",
                                "target_lang_sense_clarification": "书籍或文件的增补部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e031790-2b87-3133-8572-4dfa0844d196",
                    "sense_definition": "A separate section of a newspaper or magazine devoted to a specific subject.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always read the travel <w>supplement</w> in the Sunday paper first.",
                            "target_lang_translations": {
                                "ru": "Я всегда первым делом читаю туристическое <w>приложение</w> в воскресной газете.",
                                "zh": "我总是先读周日版报纸里的旅游<w>增刊</w>。"
                            }
                        },
                        {
                            "text": "Her short story was published in the literary <w>supplement</w>.",
                            "target_lang_translations": {
                                "ru": "Ее рассказ был опубликован в литературном <w>приложении</w>.",
                                "zh": "她的小说发表在文学<w>副刊</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Sunday supplement",
                        "color supplement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный раздел газеты или журнала, посвященный определенной теме.",
                        "zh": "报纸或杂志中专门针对某一主题的独立版块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приложе́ние",
                                "target_lang_sense_clarification": "к печатному изданию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增刊",
                                "target_lang_sense_clarification": "报刊的附加部分"
                            },
                            {
                                "target_lang_word": "副刊",
                                "target_lang_sense_clarification": "报纸中刊登文学艺术作品的版面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f3e3233-a0ad-374f-a141-c10638c4b941",
                    "sense_definition": "An extra amount of money charged for a specific service or item.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a small <w>supplement</w> for single occupancy of a double room.",
                            "target_lang_translations": {
                                "ru": "За одноместное размещение в двухместном номере взимается небольшая <w>доплата</w>.",
                                "zh": "双人间单人入住需支付少量<w>附加费</w>。"
                            }
                        },
                        {
                            "text": "We had to pay a <w>supplement</w> to get seats with extra legroom.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось внести <w>доплату</w>, чтобы получить места с дополнительным пространством для ног.",
                                "zh": "我们不得不支付一笔<w>附加费</w>才换到了腿部空间更大的座位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "single room supplement"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительная сумма денег, взимаемая за определенную услугу или товар.",
                        "zh": "为特定服务或项目而额外收取的费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доплата",
                                "target_lang_sense_clarification": "денежная"
                            },
                            {
                                "target_lang_word": "надбавка",
                                "target_lang_sense_clarification": "к цене"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附加费",
                                "target_lang_sense_clarification": "额外收取的费用"
                            },
                            {
                                "target_lang_word": "补差价",
                                "target_lang_sense_clarification": "因升级或特殊要求支付的差额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6576990c-aaa0-36fb-ad40-53498025410f",
                    "sense_definition": "An angle that, when added to another angle, results in a sum of 180 degrees.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supplement</w> of a 60-degree angle is 120 degrees.",
                            "target_lang_translations": {
                                "ru": "<w>Дополнительным углом</w> к углу в 60 градусов является угол в 120 градусов.",
                                "zh": "60度角的<w>补角</w>是120度。"
                            }
                        },
                        {
                            "text": "Students learned how to calculate the <w>supplement</w> in geometry class.",
                            "target_lang_translations": {
                                "ru": "Ученики учились вычислять <w>дополнительный угол</w> на уроке геометрии.",
                                "zh": "学生们在几何课上学习了如何计算<w>补角</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол, который в сумме с другим углом составляет 180 градусов.",
                        "zh": "与另一个角相加等于180度的角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополни́тельный у́гол",
                                "target_lang_sense_clarification": "геометрия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补角",
                                "target_lang_sense_clarification": "几何学概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ec53792-27a4-3cb0-b541-b521c08b0ba8",
                    "sense_definition": "To add something to something else in order to improve it or make it complete.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works a second job to <w>supplement</w> his income.",
                            "target_lang_translations": {
                                "ru": "Он работает на второй работе, чтобы <w>пополнить</w> свой доход.",
                                "zh": "他做第二份工作来<w>补充</w>收入。"
                            }
                        },
                        {
                            "text": "You should <w>supplement</w> your diet with plenty of fresh fruit and vegetables.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>дополнить</w> свой рацион большим количеством свежих фруктов и овощей.",
                                "zh": "你应该多吃新鲜水果和蔬菜来<w>补充</w>日常饮食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "supplement income",
                        "supplement diet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять что-то к чему-то другому с целью улучшения или придания целостности.",
                        "zh": "为了改进或完善某事物而向其中添加内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополня́ть",
                                "target_lang_sense_clarification": "делать полным"
                            },
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "увеличивать количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补充",
                                "target_lang_sense_clarification": "增加不足之处"
                            },
                            {
                                "target_lang_word": "增补",
                                "target_lang_sense_clarification": "增加并补足"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}