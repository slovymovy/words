                "senses": [
                    {
                        "sense_id": "39368ac0-2e8b-3272-b00f-c4395150bb7a",
                        "entry_id": "c25a2f96-1dd0-30f0-b1e6-f714983afb36",
                        "glosses": [
                            "Donner un caractère tangentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174ae6ef-1eb6-45f5-9557-cc068d1d7d6e",
                                "sense_id": "39368ac0-2e8b-3272-b00f-c4395150bb7a",
                                "text": "Le but est de limiter, autant que possible, les superpositions osseuses (mandibule et basi-occiput). Pour ce faire, on cherche à tangentialiser le rayon incident avec la ligne unissant le bord inférieur des incisives supérieures et la table externe du basi-occiput."
                            },
                            {
                                "example_id": "50d2c24b-5605-4779-86f3-9e7209c7e4f3",
                                "sense_id": "39368ac0-2e8b-3272-b00f-c4395150bb7a",
                                "text": "Les intérêts adaptatifs n’y sont pas exclus, mais tangentialisés – c’est-à-dire qu’ils touchent ou frôlent ce qui se déroule dans le baquet."
                            }
                        ]
                    }
                ],
