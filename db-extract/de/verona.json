                "senses": [
                    {
                        "sense_id": "51619e38-29c9-3013-a9cf-2ae9d8d9557b",
                        "entry_id": "5c19c2ee-973d-3f65-8816-ce58b83e154d",
                        "glosses": [
                            "italienische Stadt in Venetien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a516dbd1-40a7-4ff4-b7a9-16f909d57d87",
                                "sense_id": "51619e38-29c9-3013-a9cf-2ae9d8d9557b",
                                "text": "„Erst als Kolonie des Kaisers Augustus wurde Verona eine große, blühende Stadt.“"
                            },
                            {
                                "example_id": "1423d16a-e66c-4a3f-bc20-a9cfa66e2e4b",
                                "sense_id": "51619e38-29c9-3013-a9cf-2ae9d8d9557b",
                                "text": "Verona hat eine Menge Sehenswürdigkeiten: Das Amphitheater, Plätze mit historischen Fassaden und einige beeindruckende Brücken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
