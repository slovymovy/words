{
    "word_family": [
        "klamp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a24c9fa2-51a2-313b-ac46-2671ad61c7ee",
                    "sense_definition": "Iets met een klem of klamp stevig vastzetten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman <w>klampt</w> de houten planken stevig <w>vast</w> om ze te kunnen lijmen.",
                            "target_lang_translations": {
                                "fr": "Le menuisier <w>cramponne</w> fermement les planches en bois pour pouvoir les coller."
                            }
                        },
                        {
                            "text": "De constructie wordt door metalen palen aan de muur <w>vastgeklampt</w>.",
                            "target_lang_translations": {
                                "fr": "La structure est <w>fixée</w> au mur par des poteaux métalliques."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastklemmen",
                        "bevestigen"
                    ],
                    "common_phrases": [
                        "stevig vastklampen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fixer solidement quelque chose à l'aide d'une pince ou d'un crampon."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cramponner",
                                "target_lang_sense_clarification": "Fixer avec un crampon ou une pièce métallique."
                            },
                            {
                                "target_lang_word": "fixer",
                                "target_lang_sense_clarification": "Attacher fermement un objet."
                            },
                            {
                                "target_lang_word": "serrer",
                                "target_lang_sense_clarification": "Maintenir fermement en place."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f00b484-cea6-3230-9c8d-b188fb0d1442",
                    "sense_definition": "Zich met kracht ergens aan vasthouden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vasthouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bange kind <w>klampt</w> zich aan de hand van zijn moeder <w>vast</w>.",
                            "target_lang_translations": {
                                "fr": "L'enfant effrayé <w>s'agrippe</w> à la main de sa mère."
                            }
                        },
                        {
                            "text": "Tijdens de storm <w>klampten</w> de zeelieden zich <w>vast</w> aan de reling van het schip.",
                            "target_lang_translations": {
                                "fr": "Pendant la tempête, les marins <w>se cramponnaient</w> à la rambarde du navire."
                            }
                        }
                    ],
                    "synonyms": [
                        "vasthouden",
                        "omklemmen"
                    ],
                    "antonyms": [
                        "loslaten"
                    ],
                    "common_phrases": [
                        "zich vastklampen aan"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se tenir fermement à quelque chose, souvent par peur ou nécessité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se cramponner",
                                "target_lang_sense_clarification": "S'agripper fortement à quelque chose pour ne pas tomber ou lâcher."
                            },
                            {
                                "target_lang_word": "s'agripper",
                                "target_lang_sense_clarification": "Se tenir fermement avec les mains."
                            },
                            {
                                "target_lang_word": "se tenir",
                                "target_lang_sense_clarification": "Rester attaché à quelque chose."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}