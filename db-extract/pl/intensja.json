                                "target_senses": [
                                    {
                                        "sense_id": "dae40ddd-023e-3047-865a-fbf156a92b92",
                                        "entry_id": "3db979b2-694d-36c1-b942-4215cbdf832d",
                                        "glosses": [
                                            "innerliche Anspannung, Eifer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08239d80-11ce-4587-a6f9-8c248171ebe0",
                                                "sense_id": "dae40ddd-023e-3047-865a-fbf156a92b92",
                                                "text": "Man spürte förmlich die Intension, mit der sie sich ihrer neuen Rolle widmete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5b85232-f881-31ce-975a-168d37c07150",
                                        "entry_id": "3db979b2-694d-36c1-b942-4215cbdf832d",
                                        "glosses": [
                                            "Begriffsinhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c73d8fd-75ed-4b4e-8ab6-d04ee60e3a99",
                                                "sense_id": "c5b85232-f881-31ce-975a-168d37c07150",
                                                "text": "„In der Logik werden Begriffe nach ihrem Inhalt oder nach ihrer Intension und nach ihrer Extension oder ihrem Umfang untersucht.“"
                                            },
                                            {
                                                "example_id": "a8c2ea8c-7fe6-4558-87ac-f955f6eb2b8d",
                                                "sense_id": "c5b85232-f881-31ce-975a-168d37c07150",
                                                "text": "„…; die Intension eines Begriffs ist die Menge der Merkmale, durch die er charakterisiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
