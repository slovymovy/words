                        ],
                        "examples": [
                            {
                                "example_id": "1dd41c3a-e67d-423d-839a-0be3088cea70",
                                "sense_id": "95201d4b-c289-3d0f-8844-32a887ef6790",
                                "text": "Door deze blunder komen in de laatste twee weken van het jaar meer dan 15.000 vluchten in gevaar door personeelsgebrek, becijferde een vereniging van verkeersvliegers."
                            },
                            {
                                "example_id": "c4102d40-8e73-496d-bb28-d13c0aa1307b",
                                "sense_id": "95201d4b-c289-3d0f-8844-32a887ef6790",
                                "text": "'Wat we nu zien gebeuren, is wat Ryanair betreft uniek', zegt Joost van Doesburg van de Vereniging Nederlandse Verkeersvliegers (VNV). 'Nog nooit was een Europese samenwerking van Ryanair-piloten zo dichtbij.'Ryanair heeft ook een basis met 40 piloten op Eindhoven Airport. Bijna al deze piloten zijn de afgelopen weken lid geworden van de VNV. Volgens Van Doesburg 'behoort het zeker tot de mogelijkheden'dat ook zij in de nabije toekomst gaan staken."
                            }
                        ]
                    }
