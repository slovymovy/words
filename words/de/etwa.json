                {
                    "sense_id": "043446e6-7c11-3216-84f8-4949af752485",
                    "sense_definition": "drückt in Fragesätzen Erstaunen, Zweifel oder die Erwartung einer verneinenden Antwort aus",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modal_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Möchtest du <w>etwa</w> jetzt schon nach Hause gehen?",
                            "target_lang_translations": {
                                "en": "Do you <w>really</w> want to go home already?",
                                "ru": "Ты <w>разве</w> уже сейчас хочешь идти домой?",
                                "nl": "Wil je <w>soms</w> nu al naar huis gaan?",
                                "pl": "Czy chcesz <w>przypadkiem</w> już teraz iść do domu?",
                                "fr": "Voudrais-tu <w>par hasard</w> déjà rentrer à la maison ?",
                                "it": "Vuoi <w>per caso</w> già andare a casa adesso?",
                                "cs": "Chceš jít <w>snad</w> už teď domů?",
                                "tr": "<w>Yoksa</w> şimdiden eve mi gitmek istiyorsun?",
                                "es": "¿<w>Acaso</w> quieres irte ya a casa?",
                                "zh": "你<w>难道</w>现在就想回家了吗？"
                            }
                        },
                        {
                            "text": "Hast du <w>etwa</w> das ganze Geld auf einmal ausgegeben?",
                            "target_lang_translations": {
                                "en": "Did you <w>really</w> spend all the money at once?",
                                "ru": "<w>Неужели</w> ты потратил все деньги разом?",
                                "nl": "Heb je <w>soms</w> al het geld in één keer uitgegeven?",
                                "pl": "<w>Czyżbyś</w> wydał wszystkie pieniądze naraz?",
                                "fr": "As-tu <w>vraiment</w> dépensé tout l'argent d'un coup ?",
                                "it": "Hai <w>davvero</w> speso tutti i soldi in una volta?",
                                "cs": "Utratil jsi <w>snad</w> všechny peníze najednou?",
                                "tr": "<w>Yoksa</w> bütün parayı bir kerede mi harcadın?",
                                "es": "¿<w>Acaso</w> has gastado todo el dinero de una sola vez?",
                                "zh": "你<w>难道</w>把所有的钱一次全花光了？"
                            }
                        }
