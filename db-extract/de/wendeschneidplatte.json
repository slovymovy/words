                "senses": [
                    {
                        "sense_id": "46e33b8d-3be8-3a32-bf5c-cb4e96c7f027",
                        "entry_id": "e9bb28e0-e50b-3259-bcfa-b3fef5008f24",
                        "glosses": [
                            "Bauteil von Werkzeugen, das in einen Werkzeughalter eingespannt wird und als Schneidstoffträger zum Sägen, Fräsen, Drehen, Bohren oder Schleifen eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b411df-61ed-470f-9d2f-cd3c2b45ce1c",
                                "sense_id": "46e33b8d-3be8-3a32-bf5c-cb4e96c7f027",
                                "text": "Wendeschneidplatten werden aus besonders harten Materialien wie Cermet oder polykristallinem Diamant hergestellt."
                            },
                            {
                                "example_id": "ce0ff706-ad01-4b7d-8d47-d04e8513a491",
                                "sense_id": "46e33b8d-3be8-3a32-bf5c-cb4e96c7f027",
                                "text": "„Ist eine der Schneiden infolge zu hohen Verschleißes unbrauchbar geworden, so wird nach Lösen der Klemmvorrichtung die Schneidplatte gedreht oder gewendet und dadurch eine neue Schneide zum Einsatz gebracht. Hieraus ergibt sich die Bezeichnung Wendeschneidplatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
