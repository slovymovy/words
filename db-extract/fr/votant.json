                    },
                    {
                        "form_id": "15516065-f8f4-4679-8581-3faed01702e1",
                        "entry_id": "6ec64330-c721-3bc6-bbf3-276f782b63eb",
                        "tags": [
                            "feminine"
                        ],
                        "form": "votante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a985356a-100c-367b-9aab-3aa2337a878c",
                        "entry_id": "6ec64330-c721-3bc6-bbf3-276f782b63eb",
                        "glosses": [
                            "Celui qui vote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf7ec33-20cc-45d8-a3e1-80a52c566a06",
                                "sense_id": "a985356a-100c-367b-9aab-3aa2337a878c",
                                "text": "Les votants aiment, avant tout, les films historiques et, ensuite, les émotions fortes, précise Didier Allouch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2028224c-f054-44b1-9753-8245fa48a7a3",
                        "source_entry_id": "6ec64330-c721-3bc6-bbf3-276f782b63eb",
                        "source_sense_id": "a985356a-100c-367b-9aab-3aa2337a878c",
                        "target_lang_word": "Wähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9436d8fb-ac2d-3911-b3f5-c7b41d46ce9b",
                                        "entry_id": "ac6ed5d9-5916-385d-8c79-c30e0e810ae5",
                                        "glosses": [
                                            "Person, die aktiv an einer Wahl teilnimmt/teilnahm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7ff53d-23c1-47ba-b653-c2d7acb5e6ee",
                                                "sense_id": "9436d8fb-ac2d-3911-b3f5-c7b41d46ce9b",
                                                "text": "Bei der Wahl stimmte die Mehrheit der Wähler für die Bildung einer neuen Regierung."
                                            },
                                            {
                                                "example_id": "64c4987b-57f1-4421-837f-134898e27bb7",
                                                "sense_id": "9436d8fb-ac2d-3911-b3f5-c7b41d46ce9b",
                                                "text": "„Man denkt im Wahljahr nun mal verstärkt an die Wähler, und bei denen ist der Grexit populär.“"
                                            },
                                            {
                                                "example_id": "bc5f7610-9f91-419d-8eb2-b790a4001dc1",
                                                "sense_id": "9436d8fb-ac2d-3911-b3f5-c7b41d46ce9b",
                                                "text": "[Amerikanische Präsidentschaftswahl 2024:] „Rund 78 Millionen Wähler haben nach Angaben des \"Election Lab\" der Universität Florida bereits vorzeitig ihre Stimme abgegeben.“"
                                            },
                                            {
                                                "example_id": "df1827e8-4a6d-430a-a33c-d28f44375e9f",
                                                "sense_id": "9436d8fb-ac2d-3911-b3f5-c7b41d46ce9b",
                                                "text": "„Nicht nur der Wähler oder Unternehmer oder der Kommunalpolitiker, sondern jeder Straßenkehrer, jeder Schülerlotse, jede Kindergärtnerin, ja, jeder Drogendealer bastelt am Staat mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85091461-0db2-3ae6-b8a8-c5ce82bf415a",
                                        "entry_id": "ac6ed5d9-5916-385d-8c79-c30e0e810ae5",
                                        "glosses": [
                                            "Person, die dazu berechtigt ist, an einer Wahl teilzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654c1735-7ea8-4bfb-b5c6-5fbef2f0ed6b",
                                                "sense_id": "85091461-0db2-3ae6-b8a8-c5ce82bf415a",
                                                "text": "„Nicht nur der Wähler oder Unternehmer oder der Kommunalpolitiker, sondern jeder Straßenkehrer, jeder Schülerlotse, jede Kindergärtnerin, ja, jeder Drogendealer bastelt am Staat mit.“"
                                            },
                                            {
                                                "example_id": "f0c199ad-ea76-4e4a-a3e5-6b16278f1f0e",
                                                "sense_id": "85091461-0db2-3ae6-b8a8-c5ce82bf415a",
                                                "text": "„Der eine, ein wohlhabender Farmer aus der Nachbarschaft, Kowles mit Namen, hatte die Wähler mit einem Festessen, das er am vorigen 4. Juli, am Jahrestag der amerikanischen Unabhängigkeitserklärung, gegeben, auf seine Seite zu bringen gesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df823eb4-2051-4dcc-8cd8-3868ea4b88e6",
                        "source_entry_id": "6ec64330-c721-3bc6-bbf3-276f782b63eb",
                        "source_sense_id": "a985356a-100c-367b-9aab-3aa2337a878c",
                        "target_lang_word": "Abstimmender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "acf83d6c-610e-4d08-9532-2b594a1b8c43",
                        "source_entry_id": "6ec64330-c721-3bc6-bbf3-276f782b63eb",
                        "source_sense_id": "a985356a-100c-367b-9aab-3aa2337a878c",
                        "target_lang_word": "voter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ca999c-bf59-3230-87ae-d442cf5d32d9",
                                        "entry_id": "0a983ef1-5d7b-3050-83b6-221fba4db5d3",
                                        "glosses": [
                                            "Someone who votes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e09f5d6d-151a-43d2-a528-8ef13bed2ccc",
                                                "sense_id": "f6ca999c-bf59-3230-87ae-d442cf5d32d9",
                                                "text": "The generational shift Mr. Obama once embodied is, in fact, well under way, but it will not change Washington as quickly — or as harmoniously — as a lot of voters once hoped."
                                            },
                                            {
                                                "example_id": "effa1073-8445-4aac-b051-c5ccbe3fc8c3",
                                                "sense_id": "f6ca999c-bf59-3230-87ae-d442cf5d32d9",
                                                "text": "\"Until relatively recently, there was a Midwestern rural white voter who was distinct from a southern rural white voter,\" Mr. Rosenfeld said. \"There was a real progressive tradition in the Midwest uncoopted by Jim Crow and racial issues.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
