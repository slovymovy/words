                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e07b96f-4689-4e3c-b16e-63e9f01bcf75",
                                                "sense_id": "99b72bd4-f649-354b-9427-40d834734da3",
                                                "text": "Qui serait ennemi ouvert, Dieu ne permettrait pas qu’il fît des miracles ouvertement."
