                "senses": [
                    {
                        "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                        "entry_id": "166164a0-f16f-3958-82cf-e6a56c51068a",
                        "glosses": [
                            "Zustand der Mattheit nach reichlichem Verzehr von Nahrung"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8bd4b598-b089-4b59-8a78-d52e357d7d36",
                                "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                                "text": "„Es gibt reichlich, und so kommt zu meiner Langeweile auch noch eine Fressnarkose dazu.“"
                            },
                            {
                                "example_id": "fc1da507-0956-46c2-9e6e-6171618df4da",
                                "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                                "text": "„Sie klimpert mit dem Schlüsselbund und weckt so die übrigen Anwesenden aus der Fressnarkose.“"
                            },
                            {
                                "example_id": "89aa1fbb-32df-42a1-a8c8-360f397379e9",
                                "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                                "text": "„Unfähig, sich zu bewegen, ließ Pakku sich von Tami tragen, als es weiterging, für die drei anderen war die Fressnarkose des Marders eine willkommene Pause von dem hyperaktiven kleinen Fellbündel, das immer etwas zu sagen hatte oder umherwuselte.“"
                            },
                            {
                                "example_id": "a98e2444-670b-4151-8dd8-7971499e5660",
                                "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                                "text": "„Nach einer Woche Rumgesülze fallen alle in Fressnarkose und die Show ist aus.“"
                            },
                            {
                                "example_id": "fa19de71-e7b1-4790-a4fb-f27d4258784e",
                                "sense_id": "ed35e2c8-2214-354d-9ad6-f393981bc339",
                                "text": "„Es ist zwar sinnvoll, sowohl ‚Hungerlöcher‘ als auch ‚Fressnarkosen‘, also die bleierne Müdigkeit nach einem zu üppigen Essen, zu vermeiden, wenn man den ganzen Tag über fit und leistungsfähig sein möchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
