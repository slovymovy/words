                {
                    "sense_id": "2d45da48-ff8f-31dd-beef-b304e453db42",
                    "sense_definition": "Qui exprime ou manifeste une profonde certitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a défendu son client d'un ton <w>convaincu</w> et passionné.",
                            "target_lang_translations": {
                                "en": "The lawyer defended his client in a <w>confident</w> and passionate tone.",
                                "ru": "Адвокат защищал своего клиента <w>уверенным</w> и страстным тоном.",
                                "de": "Der Anwalt verteidigte seinen Mandanten in <w>überzeugtem</w>, leidenschaftlichem Ton.",
                                "es": "El abogado defendió a su cliente con un tono <w>convencido</w> y apasionado.",
                                "zh": "律师以<w>自信</w>而充满激情的语气为当事人辩护。"
                            }
                        },
                        {
                            "text": "Il hochait la tête d'un air <w>convaincu</w> pendant tout le discours.",
                            "target_lang_translations": {
                                "en": "He kept nodding his head with an <w>assured</w> air throughout the speech.",
                                "ru": "На протяжении всей речи он кивал головой с <w>уверенным</w> видом.",
                                "de": "Während der ganzen Rede nickte er mit <w>selbstsicherer</w> Miene.",
                                "es": "Durante todo el discurso asentía con la cabeza, con aire <w>convencido</w>.",
                                "zh": "整场演讲期间，他一直点着头，神情<w>笃定</w>。"
                            }
