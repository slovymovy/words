                        "source_sense_id": "de1441f0-8194-3b48-802a-177c99c68a8b",
                        "target_lang_word": "fee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8369666e-6c32-3304-9cf7-8a73749fa6ab",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An amount charged for a privilege."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b289a0-9010-428e-a1aa-3c6e03a0662f",
                                                "sense_id": "8369666e-6c32-3304-9cf7-8a73749fa6ab",
                                                "text": "late fee; license fee, admission fee; activation fee; service fee"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An amount charged for professional services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11da372a-f8c4-416d-b95f-8ec169b45ed8",
                                                "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                                "text": "legal fees; consulting fees"
                                            },
                                            {
                                                "example_id": "bd6f92fe-9d56-41c7-a4c5-eebb83dd000d",
                                                "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38893f15-7968-345e-946b-e2a25eb492e6",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An additional monetary payment charged for a service or good, especially one that is minor compared to the underlying cost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac87e302-e4db-30bd-ba3d-2effd6637236",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An inheritable estate in land, whether absolute and without limitation to potential heirs (fee simple) or with limitations to particular kinds of heirs (fee tail)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1e97c2d-a288-3940-8fc7-19746fb7f186",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "A right to the use of a superior's land as a stipend for certain services to be performed, typically military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31db57ae-0ed8-3a8c-b295-4b70c4c8dadd",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Synonym of fief: the land so held."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35deb5c0-ec9c-3e07-bc9a-89d398e04529",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "An inheritable estate in land held of a feudal lord on condition of performance of certain services, typically military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Synonym of possession."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd0745c9-a4e0-45be-9f38-a4b42973d161",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "Once did she hold the gorgeous East in fee;"
                                            },
                                            {
                                                "example_id": "622a0069-e6f3-46f3-bf7e-13e2ee51e8ff",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "What doth the poor man's son inherit? / Stout muscles and a sinewy heart, / A hardy frame, a hardier spirit; / King of two hands, he does his part / In every useful toil and art; / A heritage, it seems to me, / A king might wish to hold in fee."
                                            },
                                            {
                                                "example_id": "67f3450f-b002-42e2-8856-8b4009ffd2a8",
                                                "sense_id": "ad105ea1-92e6-31f6-8a9d-441dbcbb396a",
                                                "text": "Cronshaw had told him that the facts of life mattered nothing to him who by the power of fancy held in fee the twin realms of space and time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e427a7d3-7fe9-3eea-8b79-71bd458171c8",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "Money paid or bestowed; payment; emolument."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5a2e22c-42fb-318c-a874-b1d7b9f80ebd",
                                        "entry_id": "3feeb3a7-94b3-3a32-9cbb-660e8a99813f",
                                        "glosses": [
                                            "A prize or reward. Only used in the set phrase \\\"A finder's fee\\\" in Modern English."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77d60fb5-ce1b-4ba7-9a8e-550485b0900f",
                                                "sense_id": "a5a2e22c-42fb-318c-a874-b1d7b9f80ebd",
                                                "text": "For though sweet love to conquer glorious bee, / Yet is the paine thereof much greater than the fee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                        "entry_id": "cf855820-5b07-3bda-8588-f2925e45337a",
                                        "glosses": [
                                            "To reward for services performed, or to be performed; to recompense; to hire or keep in hire; hence, to bribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ae6e47-fcce-4bae-898c-7886abdd2165",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "In vain for Hellebore the patient cries / And fees the doctor; but too late is wise"
                                            },
                                            {
                                                "example_id": "6a7d6100-6680-43d6-880b-729284a36d79",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "There's not a one of them but in his house I keep a servant feed."
                                            },
                                            {
                                                "example_id": "3d797110-105c-4b30-957d-963ab564cbcd",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "We departed the grounds without seeing Marbonna; and previous to vaulting over the picket, feed our pretty guide, after a fashion of our own."
                                            },
                                            {
                                                "example_id": "5f0dc84c-4a8a-406a-aac7-e8681f40b6c8",
                                                "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                                                "text": "It was at a much earlier hour than that which Mrs. Santon had named, that Delwood presented himself, and handsomely feeing the porter who answered his summons, he asked to see Miss Santon […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
