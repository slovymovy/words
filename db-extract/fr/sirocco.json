        "fr-extract.jsonl": [
            {
                "entry_id": "206e99d7-3a54-3c53-b8d5-4f424cd7a36a",
                "word": "sirocco",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "037debdb-bef8-4411-a1fe-bee9f1f533da",
                        "entry_id": "206e99d7-3a54-3c53-b8d5-4f424cd7a36a",
                        "tags": [
                            "plural"
                        ],
                        "form": "siroccos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62a4dd72-18a5-3176-a1fc-299b3ccd3bb1",
                        "entry_id": "206e99d7-3a54-3c53-b8d5-4f424cd7a36a",
                        "glosses": [
                            "En Méditerranée, vent brûlant venant du sud-est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2666f647-52b4-4670-97c6-ba329f4a2298",
                                "sense_id": "62a4dd72-18a5-3176-a1fc-299b3ccd3bb1",
                                "text": "Les pittoresques coiffes en dentelles des femmes, légèrement frissonnantes sour le tiède sirocco, leur démarche ferme, leurs conversations sonores dans les rues; […]."
                            },
                            {
                                "example_id": "53f11cf2-4a5b-4c5d-a115-79a4017ebc10",
                                "sense_id": "62a4dd72-18a5-3176-a1fc-299b3ccd3bb1",
                                "text": "Après huit heures de marche en terrain souvent difficile, par un sirocco étouffant et une température qui doit dépasser 60° au soleil, nous atteignons Ras El-Ma, la source de l’oued Fez, à douze kilomètres de la capitale."
                            },
                            {
                                "example_id": "11299d30-3f37-480d-b550-11446042bdfd",
                                "sense_id": "62a4dd72-18a5-3176-a1fc-299b3ccd3bb1",
                                "text": "– Tramontane, sirocco, libeccio, ponant et mistral. Ce n’est tout de même pas difficile ! s’emporta Viola. Il n’y a que cinq vents qui soufflent ici."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd901bb0-f454-410e-a3ee-56a2011a10da",
                        "source_entry_id": "206e99d7-3a54-3c53-b8d5-4f424cd7a36a",
                        "source_sense_id": "62a4dd72-18a5-3176-a1fc-299b3ccd3bb1",
                        "target_lang_word": "sirocco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sirocco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                        "entry_id": "cb9fbbdf-4c49-3c21-8a26-2f9d2ab5ed01",
                                        "glosses": [
                                            "A hot and often strong southerly to southeasterly wind on the Mediterranean that originates in the Sahara and adjacent North African regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd5ec11-d9df-469f-a440-8d1b9ced5fb9",
                                                "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                                "text": "But come, the board is spread; our silver lamp / Is trimm’d, and heeds not the sirocco’s damp."
                                            },
                                            {
                                                "example_id": "90452674-fbf4-45dd-b8d2-0085122f507a",
                                                "sense_id": "c865bece-27cb-3a5c-bd8a-d666be3cfbe0",
                                                "text": "Diese Toleranz und largeur des Herzens, die Alles „verzeiht“, weil sie Alles „begreift“, ist Scirocco für uns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0552eefb-276b-308a-90dc-9896e8b56041",
                                        "entry_id": "cb9fbbdf-4c49-3c21-8a26-2f9d2ab5ed01",
                                        "glosses": [
                                            "A draft of hot air from an artificial source of heat."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dabccf8-2bd4-481c-8b29-a06f9526d3e1",
                                                "sense_id": "0552eefb-276b-308a-90dc-9896e8b56041",
                                                "text": "In the hearth at the north wall a large fire cracked and lisped, flushing the room with a dry sirocco that caused frozen skin to tingle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
