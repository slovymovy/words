                        "examples": [
                            {
                                "example_id": "92235888-2b62-4a40-a77d-55a975666174",
                                "sense_id": "2d231358-9096-30a1-a72f-9efa41fb1b9c",
                                "text": "Американский астронавт Скотт Келли, совершивший четыре космических полёта, в том числе на российских кораблях «Союз», заявил, что отказывается от российской государственной награды «За заслуги в освоении космоса» — в знак протеста против вторжения России в Украину."
                            }
                        ]
                    }
