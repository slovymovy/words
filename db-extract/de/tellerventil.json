                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poppet valve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30764558-1658-3346-90ce-e7a81f1ad0af",
                                        "entry_id": "f644a9f0-65d5-3d89-9a98-e2308c2493d2",
                                        "glosses": [
                                            "A valve (as in an internal combustion engine) which consists of a sliding shaft with a disk on the end (the disk being shaped to alternately plug and unplug a matching port). Such a valve is opened by either a cam or a solenoid and is closed by either a spring or a solenoid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62ddb51-72e6-4e7c-ab22-9278c2d07986",
                                                "sense_id": "30764558-1658-3346-90ce-e7a81f1ad0af",
                                                "text": "This communication between the tank and pump is controlled by a float valve in the tanks and a cock in the pipe, while a poppet valve prevents the undrawn liquor going into the waste tank."
                                            },
                                            {
                                                "example_id": "80fa9879-5e7d-4e25-a714-36c92168fac9",
                                                "sense_id": "30764558-1658-3346-90ce-e7a81f1ad0af",
                                                "text": "Chesapeake & Ohio's enormous L-2 4-6-4's with Franklin rotary-cam poppet valves boasted an engine weight of 221½ tons and were coal-minded Chessie's last bid to beat the passenger diesel with a reciprocating engine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
