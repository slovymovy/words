                        "translation_id": "c72c65fa-30de-4d4a-9f2c-76672637b36a",
                        "source_entry_id": "318c08fa-1d60-302a-b80d-7db87e8af4db",
                        "source_sense_id": "0c1afd0f-fe9f-3d6b-b861-a7379e7092c1",
                        "target_lang_word": "technocratic",
                        "target_lang_code": "en",
