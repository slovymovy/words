                ],
                "senses": [
                    {
                        "sense_id": "45cb59b1-063c-35c7-bf78-55640d070d49",
                        "entry_id": "c84b28a9-2a05-3797-b040-651e599a0965",
                        "glosses": [
                            "die Vergangenheit der Kommunikationsmittel (insbesondere Presse, Hörfunk, Fernsehen und Internet)"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "76873ffd-35dd-4fb5-b3c3-8bbf67527362",
                                "sense_id": "45cb59b1-063c-35c7-bf78-55640d070d49",
                                "text": "„Gewinne sind für uns wichtig, aber sie sind nicht das einzige Unternehmensziel“, hatte sie kurz vor der Entscheidung über den wohl größten Deal in der deutschen Mediengeschichte noch in einem Interview gesagt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82b5c642-6dc0-33ad-b5f5-b2dadac79dc2",
                        "entry_id": "c84b28a9-2a05-3797-b040-651e599a0965",
                        "glosses": [
                            "die Gesamtheit der historischen Darstellungen von Medienprozessen als Teil der allgemeinen Geschichtsschreibung"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "f5b9128c-1461-4245-977f-6cc2f3e68992",
                                "sense_id": "82b5c642-6dc0-33ad-b5f5-b2dadac79dc2",
                                "text": "„Die drei zentralen Arbeitsfelder der Medienwissenschaft sind Medienanalyse, Mediengeschichte und Medientheorie.“"
                            },
                            {
                                "example_id": "84f37903-c1ac-496a-8f04-a23269a47430",
                                "sense_id": "82b5c642-6dc0-33ad-b5f5-b2dadac79dc2",
                                "text": "Die Mediengeschichte ist das Fachgebiet der Medienhistoriker."
                            },
                            {
                                "example_id": "a121b538-7e69-4213-a4d7-9ab10bdafdd2",
                                "sense_id": "82b5c642-6dc0-33ad-b5f5-b2dadac79dc2",
                                "text": "Aus einem Interview: „Herr Bärtschi, weshalb suchen wir in der SonntagsZeitung vergeblich nach einer Medienseite?“ - „Eine Medienseite wurde nie angestrebt und hat sich nie ergeben. Gute Mediengeschichten brauchen kein eigenes Ressort.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
