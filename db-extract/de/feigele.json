                ],
                "senses": [
                    {
                        "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                        "entry_id": "a9dd0df6-1f90-39bb-bfbc-114309413146",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da182a2-2634-45d2-8589-0e9d8a55089e",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Frau Feigele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "572f2e89-4b2a-4f85-b1e3-4db9023f7478",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Herr Feigele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "800f7357-68ad-47d5-9f71-72eabef5e178",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Die Feigeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "16a93679-fd45-459e-a5e8-c556277a2c9d",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Der Feigele trägt nie die Schals, die die Feigele ihm strickt."
                            },
                            {
                                "example_id": "ca2c95f8-4361-4f45-bd46-4782508a7e19",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feigele kommt, geht der Herr Feigele.“"
                            },
                            {
                                "example_id": "cb2fdebb-620b-4a4a-8a2a-c374f4b4ddea",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Feigele kommt und geht."
                            },
                            {
                                "example_id": "683ee3a5-67d0-406f-9ca1-0a718096e5ae",
                                "sense_id": "584055f3-fd44-3304-b703-eeaf8aad9551",
                                "text": "Feigeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
