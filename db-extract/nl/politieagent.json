                    },
                    {
                        "form_id": "0e31da09-478b-44d9-b99a-fe84d7796978",
                        "entry_id": "4b8ec323-47be-3aef-9875-d10b4b45850e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "politieagentjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
                        "entry_id": "4b8ec323-47be-3aef-9875-d10b4b45850e",
                        "glosses": [
                            "een persoon die belast is met hulpverlening en met de handhaving van de openbare orde en veiligheid"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "bd7a6192-010b-4468-9c5c-eccf1c16a0bb",
                                "sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
                                "text": "De politieagent bracht het weggelopen kind terug naar zijn ouders."
                            },
                            {
                                "example_id": "fb25be71-470d-45e0-a794-2e3b1c6de4ef",
                                "sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
                                "text": "We kregen al snel een lift naar de weg waar ik vijf dagen geleden door de politieagent werd opgepikt."
                            },
                            {
                                "example_id": "dd428c92-9504-49a6-a9cd-1d814d34cd52",
                                "sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
                                "text": "Ik liep er wat dichter naartoe om te zien wat er aan de hand was en zag twee Park Rangers, federale politieagenten met verstrekkende bevoegdheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92bd078f-5ea2-4f13-97df-833c361821b6",
                        "source_entry_id": "4b8ec323-47be-3aef-9875-d10b4b45850e",
                        "source_sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
                        "source_sense_description": "een persoon die belast is met hulpverlening en met de handhaving van de openbare orde en veiligheid",
                        "target_lang_word": "Polizist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                        "entry_id": "4e0b0e4d-ce09-3c07-b95e-829afca8bbb7",
                                        "glosses": [
                                            "Angehöriger der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573a6e95-efd0-4288-8b32-5518642bd897",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Die Polizisten verhafteten 21 gewalttätige Demonstranten."
                                            },
                                            {
                                                "example_id": "2ed6e61a-9a8a-47e2-8796-4ba0dab04ea3",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "cb549a3e-613b-4b88-9410-e6886a0b8b23",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Im März 1954 treiben Aufständische 30 Polizisten zusammen, sperren sie in ein Haus und zünden es an.“"
                                            },
                                            {
                                                "example_id": "4c43b5b6-68ea-468d-a341-038de7ac6bd7",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Einer der Polizisten schob sie heftig zur Seite, und sie bekam vor Angst weiche Knie.“"
                                            },
                                            {
                                                "example_id": "eeb75324-6e61-48b5-9a2c-546cd4b03963",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Ein junger Polizist eilte den Gang herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07bfc46e-b217-4aee-b79d-c8292d5f1fd8",
                        "source_entry_id": "4b8ec323-47be-3aef-9875-d10b4b45850e",
                        "source_sense_id": "885562ac-e476-3e42-aa24-064fc45fb60c",
