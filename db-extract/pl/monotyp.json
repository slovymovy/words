                        "entry_id": "1c4f9725-8ae0-3931-b8da-2f3816dc939d",
                        "glosses": [
                            "poligraficzna maszyna odlewnicza umożliwiająca skład tekstu i odlewanie czcionek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2107fd-1a8a-4d02-b5c2-29667d7f72f6",
                                "sense_id": "5775c391-4881-3117-b8ca-f1bec4dfeaca",
                                "text": "Maszyną podobną do monotypu, ale odlewającą od razu całe wiersze tekstu, był linotyp"
                            }
