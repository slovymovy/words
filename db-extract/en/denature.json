                        "cross_references": [
                            {
                                "target_word": "dénaturer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88d49bfc-76f9-331f-a082-2d8bd7092470",
                                        "entry_id": "483f8bf7-effa-36c9-b8f9-9ce8463736ff",
                                        "glosses": [
                                            "Altérer une chose dans sa nature ou dans ses qualités, faire qu’elle ne soit plus ce qu’elle était ou ce qu’elle devrait être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa22572-c0a9-4fff-805f-91aba566190a",
                                                "sense_id": "88d49bfc-76f9-331f-a082-2d8bd7092470",
                                                "text": "En outre, les marchés d’ingénierie classiques ne permettent pas de déceler et d’anticiper suffisamment les risques liés à des inadaptations des projets aux contraintes techniques ou constructives, ou au contraire, à des difficultés de réalisation des ouvrages pouvant conduire à dénaturer les caractéristiques initiales des projets."
                                            },
                                            {
                                                "example_id": "2618b71b-12ac-42f0-a226-530dbde1a81b",
                                                "sense_id": "88d49bfc-76f9-331f-a082-2d8bd7092470",
                                                "text": "Il dénatura les objets volés, pour qu’on ne pût les reconnaître."
                                            },
                                            {
                                                "example_id": "86a605cd-b77c-4253-a2b4-d396c0de8246",
                                                "sense_id": "88d49bfc-76f9-331f-a082-2d8bd7092470",
                                                "text": "Il a dénaturé le fait, en changeant, en taisant plusieurs des circonstances principales."
                                            },
                                            {
                                                "example_id": "613900f2-4d20-4b1b-93ad-1da606ee188b",
                                                "sense_id": "88d49bfc-76f9-331f-a082-2d8bd7092470",
                                                "text": "Dénaturer la pensée de quelqu’un par une fausse interprétation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508356f5-385b-3369-bd09-64bc11bd78bd",
                                        "entry_id": "483f8bf7-effa-36c9-b8f9-9ce8463736ff",
                                        "glosses": [
                                            "Rendre impropre à la consommation humaine certains aliments, pour les destiner à des usages industriels, en y mélangeant certaines substances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7173e26d-532d-4e19-b49c-fc277b4cddf7",
                                                "sense_id": "508356f5-385b-3369-bd09-64bc11bd78bd",
                                                "text": "Dénaturer l'alcool alimentaire en alcool pour la combustion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
