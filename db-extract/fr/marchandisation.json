                "senses": [
                    {
                        "sense_id": "04c0a409-3682-36af-a3e8-e8c42a592440",
                        "entry_id": "8a2213fc-ab4b-30ac-b274-33de20f55ad6",
                        "glosses": [
                            "Passage d’une forme non marchande à une forme marchande de l’offre de biens et services."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f50ade-ed8b-4abb-9c6c-cc78d03d20dc",
                                "sense_id": "04c0a409-3682-36af-a3e8-e8c42a592440",
                                "text": "À l’heure de la concentration de l’édition, de la tyrannie du profit, des agents littéraires, de la « marchandisation » du livre et de la montée du livre électronique, qui devra un jour offrir davantage que la version homothétique de l’ouvrage papier, ces témoignages permettent d’esquisser des pistes de réflexion sur l’avenir de la profession et du livre."
                            },
                            {
                                "example_id": "64de7451-b6bb-4593-9cd0-4638f50dc148",
                                "sense_id": "04c0a409-3682-36af-a3e8-e8c42a592440",
                                "text": "Le collectif « Indépendance des chercheurs » s’interroge : « Jusqu’où iront la marchandisation du savoir, la privatisation du patrimoine intellectuel et la participation active du monde politique dans ce processus de démolition ?"
                            },
                            {
                                "example_id": "ec2da078-ea52-47d4-945c-d1631ec0bc9d",
                                "sense_id": "04c0a409-3682-36af-a3e8-e8c42a592440",
                                "text": "Nous sommes dans la civilisation de la marchandisation systématique du corps."
                            }
                        ]
                    }
                ],
