                ],
                "senses": [
                    {
                        "sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                        "entry_id": "8c507009-6f18-33b1-9484-c13096989be5",
                        "glosses": [
                            "Un·e des parents du parent d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df545011-b86c-4871-b10c-f13d3477a8dc",
                                "sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                                "text": "Ce n’est donc pas un grand-parent que nous attendons pour la cérémonie. Qu’est-ce alors ?"
                            },
                            {
                                "example_id": "cdac86d0-7bf4-4e3c-8ca8-79c97cabb96d",
                                "sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                                "text": "Quelle vie ont eu nos grand-parents\n Entre l’absinthe et les grand-messes\n Ils étaient vieux avant que d’être."
                            },
                            {
                                "example_id": "e8c97a1a-f06b-4b51-96c2-0b72bbf71c9c",
                                "sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                                "text": "Il est aussi possible qu’Albert Dupontel rende visite à sa famille à Carantec (29) ou que Didier Wampas aille séjourner chez ses grands-parents du côté de Spézet (29)."
                            },
                            {
                                "example_id": "6927e73a-9ff0-4d61-b692-1ee19f6fd31e",
                                "sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                                "text": "Des grands-parents qui ont fréquenté leurs petits-enfants dont l’école était aux prises avec plusieurs cas de COVID-19 seraient à l’origine d’une autre éclosion, cette fois dans une résidence pour personnes âgées de Saint-Charles-Borromée, dans Lanaudière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "398a95cf-c734-4a30-a441-dbec05e78568",
                        "source_entry_id": "8c507009-6f18-33b1-9484-c13096989be5",
                        "source_sense_id": "f21a0cad-47da-31ab-b374-3509b0bfc2d0",
                        "target_lang_word": "Großeltern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großeltern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                        "entry_id": "fad866f7-cbc1-3590-a074-31cd93f47586",
                                        "glosses": [
                                            "die Eltern des Vaters oder der Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16f1c91-bdf9-4162-bc39-62ce29f3ad75",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "Ich verbringe meine Ferien immer bei meinen Großeltern."
                                            },
                                            {
                                                "example_id": "23f275d2-1999-4213-a63a-f67fa1bda9bb",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Die wurden von meinen Großeltern gut verpackt im Keller aufbewahrt.“"
                                            },
                                            {
                                                "example_id": "ef14df5c-4af4-4421-ad72-7e0fe3269f28",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Die belastenden Erlebnisse meiner mütterlichen und väterlichen Großeltern in Kriegs- und Nachkriegszeit wirken noch heute auf die Familie.“"
                                            },
                                            {
                                                "example_id": "24947223-11ee-4c66-ad87-2ac21b2b8e60",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Meine Großeltern und meine Urgroßmutter hatten schon 1930 ihre Heimat verlassen müssen, als immer mehr Muslime Opfer der Gewalt serbischer Nationalisten wurden.“"
                                            },
                                            {
                                                "example_id": "b0c446be-3c14-42fd-8171-c5fc45663649",
                                                "sense_id": "3b3dad5a-7707-3537-99b8-f7b1af064948",
                                                "text": "„Während der Ferien fuhr er auch immer mit der Straßenbahn zu den irischen Großeltern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
