                        "glosses": [
                            "Fêtes solennelles qu’on célébrait à Athènes en l’honneur de Pallas Athéné."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7e25f0d5-0b8b-40c4-ad31-87677510019c",
                                "sense_id": "70efafd8-eee2-3907-ac93-3f2bba50c3ac",
                                "text": "Vers l’après-midi le mont Hélias, couronné de blanc et de rose comme une danseuse des Panathénées, indiqua la présence d’Eubée."
                            }
                        ]
                    }
                ],
