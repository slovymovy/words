                        ],
                        "examples": [
                            {
                                "example_id": "0560dea9-ec90-4f5e-ad73-5972a05a9e39",
                                "sense_id": "01c27bca-3301-322c-b1f8-e0c5e9768b9c",
                                "text": "„Die Schlüsselgewalt der Kirche beziehe sich nach Gottes Festsetzung nur auf die Sündenschuld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
