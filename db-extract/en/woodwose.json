                        "glosses": [
                            "A wild man of the woods; a faun, a satyr or a representation of such a being in heraldry or other decoration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3bed54b-22b7-4111-8d23-9cc39850f1b9",
                                "sense_id": "0b3059cc-b1e8-3370-9dc3-31ce19c1b57f",
                                "text": "The young woodwose had now closed his eyes and was stretched out supine on the pool's marble margin; his Tarzan brief had been cast aside on the turf."
                            },
                            {
                                "example_id": "8fd47780-951a-4c5c-9807-1917e248e40e",
                                "sense_id": "0b3059cc-b1e8-3370-9dc3-31ce19c1b57f",
                                "text": "'If the cub has a grievance, let him bring it to the King's judgement,' answered Saeros. 'But the drawing of swords here is not to be excused for any such cause. Outside the hall, if the woodwose draws on me, I shall kill him.'"
                            }
                        ]
                    }
