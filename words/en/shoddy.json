                    "target_lang_definitions": {
                        "ru": "Низкосортная ткань из переработанной шерсти или отходов шерстяного производства",
                        "nl": "Een laagwaardige stof gemaakt van gerecyclede wol of bijproducten van wolbewerking",
                        "cs": "Méně kvalitní látka vyrobená z recyklované vlny nebo vlněného odpadu"
                    },
                    "translations": {
