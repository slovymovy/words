                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "After the nomination, he was required to accept or decline the offer."
                                            },
                                            {
                                                "example_id": "331fa207-5d4a-4345-aa1b-b765e9e2cf3b",
                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "Her nomination for the award came as a pleasant surprise."
                                            },
                                            {
                                                "example_id": "194a0c53-5447-47e5-9d50-5928ac622146",
                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "The committee announced his nomination for the position of president."
                                            }
