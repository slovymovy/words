                        "zh": "印度尼西亚楠榜省的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Метро",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梅特罗",
                                "target_lang_sense_clarification": "印度尼西亚城市名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
