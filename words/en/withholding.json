{
    "word_family": [
        "withhold",
        "withholder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e6a2b9c-82b4-3eae-a3e2-26ab4f6535d7",
                    "sense_definition": "present participle and gerund of <w>withhold</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "withhold_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was accused of <w>withholding</w> important evidence from the police.",
                            "target_lang_translations": {
                                "es": "El testigo fue acusado de <w>ocultar</w> pruebas importantes a la policía."
                            }
                        },
                        {
                            "text": "She had trouble trusting him after discovering he was <w>withholding</w> the truth.",
                            "target_lang_translations": {
                                "es": "Le costó confiar en él tras descubrir que le estaba <w>ocultando</w> la verdad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "withholding information",
                        "withholding evidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio de presente y gerundio de withhold; ocultar, retener o no revelar algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ocultar",
                                "target_lang_sense_clarification": "información o pruebas"
                            },
                            {
                                "target_lang_word": "retener",
                                "target_lang_sense_clarification": "guardarse algo sin entregarlo o compartirlo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6027ccd2-e4dc-3d1c-a002-5bffb9436156",
                    "sense_definition": "The act or process of deducting taxes or other amounts directly from an employee's salary or wages.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tax_deduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The payroll system handles automatic tax <w>withholding</w> for all full-time staff.",
                            "target_lang_translations": {
                                "es": "El sistema de nóminas gestiona la <w>retención fiscal</w> automática para todo el personal a tiempo completo."
                            }
                        },
                        {
                            "text": "You can adjust your rate of <w>withholding</w> by submitting a new declaration form.",
                            "target_lang_translations": {
                                "es": "Puedes ajustar tu tasa de <w>retención</w> enviando un nuevo formulario de declaración."
                            }
                        }
                    ],
                    "synonyms": [
                        "deduction"
                    ],
                    "common_phrases": [
                        "tax withholding",
                        "withholding rate"
                    ],
                    "target_lang_definitions": {
                        "es": "Acción o proceso de deducir impuestos u otras cantidades directamente del salario o nómina de un empleado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retención fiscal",
                                "target_lang_sense_clarification": "proceso de deducción de impuestos de la nómina"
                            },
                            {
                                "target_lang_word": "retención",
                                "target_lang_sense_clarification": "deducción salarial general"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76641b8a-f0a5-3439-aaed-25400ca71e7f",
                    "sense_definition": "An amount of money, such as income tax, deducted from wages and paid directly to the government.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tax_deduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His total <w>withholdings</w> for the year were listed clearly on the final pay stub.",
                            "target_lang_translations": {
                                "es": "El total de sus <w>retenciones</w> del año figuraba claramente en el último recibo de nómina."
                            }
                        },
                        {
                            "text": "If your total <w>withholding</w> exceeds what you owe, you will receive a refund.",
                            "target_lang_translations": {
                                "es": "Si tu <w>retención</w> total supera lo que debes, recibirás un reembolso."
                            }
                        }
                    ],
                    "synonyms": [
                        "withholding tax"
                    ],
                    "common_phrases": [
                        "withholding tax"
                    ],
                    "target_lang_definitions": {
                        "es": "Cantidad de dinero retenida del salario y pagada directamente a la administración tributaria."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retención",
                                "target_lang_sense_clarification": "importe deducido de los ingresos"
                            },
                            {
                                "target_lang_word": "retención fiscal",
                                "target_lang_sense_clarification": "monto correspondiente a impuestos retenidos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}