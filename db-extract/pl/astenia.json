                ],
                "translations": [
                    {
                        "translation_id": "9abcb661-49e6-4640-aad9-f7c88542fd8b",
                        "source_entry_id": "cb9acbc4-5574-3b33-bbac-d9076cdb8e39",
                        "source_sense_id": "cd6498ab-6dc6-3ef3-b70d-5d13274a9b9a",
                        "target_lang_word": "asthenia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthenia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df06b5d8-446f-378a-927a-a58dd3fabe9f",
                                        "entry_id": "f712777c-7813-3987-9bd0-82e1c1e66628",
                                        "glosses": [
                                            "Weakness; loss of strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ed9605-718e-4c20-a9c2-82f13df6eac5",
                                                "sense_id": "df06b5d8-446f-378a-927a-a58dd3fabe9f",
                                                "text": "The savage gets a headache when his thought is forced to flow in a stream of representation. In the imbecile, in the idiot we find the same thing manifested. They can only think in concrete sensory terms. In mental asthenia which approaches the state of the higher stages of imbecility and also in secondary dementia, states consequent on psychic degeneration, we find the same truth illustrated. The patient's mental activity falls many stages nearer to the level of presentative life. It is only in the higher forms of psychic life that representative elements become free, independent, and are freely and easily associated and dissociated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091b2da9-ef16-38e4-94b3-254b281fd8f6",
                                        "entry_id": "f712777c-7813-3987-9bd0-82e1c1e66628",
                                        "glosses": [
                                            "weakness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce79a061-9829-4bfa-95c0-d3f4851e335c",
                                                "sense_id": "091b2da9-ef16-38e4-94b3-254b281fd8f6",
                                                "text": "You see nothing that might even remotely suggest life, beyond the solitary brave watering the ponies below you; but that is because the asthenia of civilization has left you half blind as well as half deaf, for where you see nothing and hear nothing Geronimo is conscious of life, movement and sound-of rodents, reptiles and birds awaiting, quiescent, the lessening heat of dusk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bae537d-3252-48c7-9be3-21df99adc0a9",
                        "source_entry_id": "cb9acbc4-5574-3b33-bbac-d9076cdb8e39",
                        "source_sense_id": "cd6498ab-6dc6-3ef3-b70d-5d13274a9b9a",
                        "target_lang_word": "asthénie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9e40cf-a9fc-347d-abea-8721b21921d0",
                                        "entry_id": "5299b105-345f-3634-8b27-e183eb485537",
                                        "glosses": [
                                            "Fatigue physique du patient ou de la patiente, affaiblissement de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be380023-6bde-4aaa-aae1-ee2d5eddf0c3",
                                                "sense_id": "4f9e40cf-a9fc-347d-abea-8721b21921d0",
                                                "text": "L’asthénie et la fatigue sont l’un des premiers motifs de consultation en médecine générale."
                                            },
                                            {
                                                "example_id": "19109091-485c-431f-93c5-0c9b316ad946",
                                                "sense_id": "4f9e40cf-a9fc-347d-abea-8721b21921d0",
                                                "text": "Pendant des semaines, une brume maintint sous le boisseau la clarté du soleil, aggravant l'asthénie générale et rendant mon étude incommode."
                                            },
                                            {
                                                "example_id": "eeb651be-514c-48ab-b5aa-02538e3f66e9",
                                                "sense_id": "4f9e40cf-a9fc-347d-abea-8721b21921d0",
                                                "text": "Cette asthénie des sens se doublait d’un désinvestissement professionnel croissant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asthénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
