                ],
                "senses": [
                    {
                        "sense_id": "7bd1a6e8-6314-337d-85aa-129ab158212d",
                        "entry_id": "1e61f27d-5e7f-332c-bd2b-c98e4b74cfa3",
                        "glosses": [
                            "durch das Geruchsorgan wahrzunehmender modernder Müll und dessen Ausgasung"
                        ],
                        "tags": [
                            "Geruchssinn"
                        ],
                        "examples": [
                            {
                                "example_id": "dca50c1a-0bd6-4170-91f2-0149f05a8e7a",
                                "sense_id": "7bd1a6e8-6314-337d-85aa-129ab158212d",
                                "text": "„Der Müllgeruch ist deshalb noch weniger zumutbar, weil beiden Parteien dadurch ein großer Nachteil entsteht.“"
                            },
                            {
                                "example_id": "b9efb0c3-2309-4d46-85b5-5e1281debf8f",
                                "sense_id": "7bd1a6e8-6314-337d-85aa-129ab158212d",
                                "text": "„Der Müllgeruch wird also einfach mitverbrannt.“"
                            },
                            {
                                "example_id": "3beb76ce-91ce-47c1-b55b-99dd311ec37b",
                                "sense_id": "7bd1a6e8-6314-337d-85aa-129ab158212d",
                                "text": "„Angesichts der heutigen technischen Möglichkeiten sei es nicht zu akzeptieren, dass Wohngebiete im Umkreis von Entsorgungsanlagen durch Müllgeruch belastet werden.“"
                            },
                            {
                                "example_id": "76a4ad6d-dcc1-4130-bd1c-357a68b70501",
                                "sense_id": "7bd1a6e8-6314-337d-85aa-129ab158212d",
                                "text": "„Die BesucherInnen [sic] nahmen trotz kühler Witterung und deutlichen Windes zwischen den gelagerten Ballen einen ausgeprägten Müllgeruch wahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
