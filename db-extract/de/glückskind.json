                "senses": [
                    {
                        "sense_id": "fd085e1c-7f08-3f5c-8dae-fb88faa02f1f",
                        "entry_id": "fcbcf8eb-7498-3283-bc53-5985a763717a",
                        "glosses": [
                            "eine Person, die oft Glück hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969d78c4-054b-46ab-adc9-19279a86bea3",
                                "sense_id": "fd085e1c-7f08-3f5c-8dae-fb88faa02f1f",
                                "text": "Er war immer ein Glückskind."
                            },
                            {
                                "example_id": "0c9bcac6-0839-4f0f-8b7b-4f07f0de8956",
                                "sense_id": "fd085e1c-7f08-3f5c-8dae-fb88faa02f1f",
                                "text": "Doch Christiane Paul ist ein Glückskind, eine vom Schicksal begünstigte Pendlerin zwischen den Welten, zwischen Ost und West, Vergangenheit und Zukunft."
                            },
                            {
                                "example_id": "37d0ad43-ce1c-49ec-8f04-c7fda593945a",
                                "sense_id": "fd085e1c-7f08-3f5c-8dae-fb88faa02f1f",
                                "text": "„Zunächst scheint es nicht so, als ob dieses Sonntagskind auch ein Glückskind wäre, eher im Gegenteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
