            {
                "entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                "word": "marinier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "01d0f5cd-1fc5-4181-aa88-56db6a5b40a0",
                        "entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "mariniers"
                    },
                    {
                        "form_id": "77936416-2d48-4e90-9698-09cdaa79a629",
                        "entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "marinière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab87d7fd-484c-339a-8de0-9087a4c91a59",
                        "entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "glosses": [
                            "Personne dont la profession est de conduire les bâtiments sur les rivières, les canaux navigables, les lacs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea9ac97-a10c-4de3-897f-777ad3ac5420",
                                "sense_id": "ab87d7fd-484c-339a-8de0-9087a4c91a59",
                                "text": "La navigation cesse aussitôt que le soleil est couché et à bord des bateaux amarrés le long des rives, les mariniers éteignent leurs falots à l'heure où jadis on sonnait le couvre-feu."
                            },
                            {
                                "example_id": "7ba154fe-1182-4ec6-992a-b23a3f30a51a",
                                "sense_id": "ab87d7fd-484c-339a-8de0-9087a4c91a59",
                                "text": "Autrefois le Lot était une voie navigable : ses écluses, ses relais faisaient vivre un peuple de mariniers. On a déclassé le Lot."
                            },
                            {
                                "example_id": "007a6924-06ff-4f98-b696-df993513d252",
                                "sense_id": "ab87d7fd-484c-339a-8de0-9087a4c91a59",
                                "text": "Même s'ils sont des « marins d’eau douce », les bateliers et mariniers sont aussi seuls, isolés dans leur corporation, que ceux de la marine marchande de Marseille ou de La Rochelle. Ils ne se connaissent qu'entre eux, […]."
                            },
                            {
                                "example_id": "d78587eb-5b4a-42da-a9c1-7176c522f978",
                                "sense_id": "ab87d7fd-484c-339a-8de0-9087a4c91a59",
                                "text": "Les mariniers, artisans ou salariés, et les membres de leurs familles habitant à bord peuvent, sans condition de résidence, s’ils remplissent les autres conditions prévues par les lois en vigueur, être inscrits sur [une] liste électorale."
                            }
                        ]
                    },
                    {
                        "sense_id": "47c73943-fcd3-3a15-8430-5e264cf0d252",
                        "entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "glosses": [
                            "Homme de mer pour la manœuvre d’un vaisseau ; marin."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c66ea8e4-6665-4c90-ae53-a110817e1a69",
                        "source_entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "target_lang_word": "Schiffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                        "entry_id": "7739d886-85ca-3fd4-b3d9-aa3e7a62bd7f",
                                        "glosses": [
                                            "eine in der Binnenschifffahrt tätige Person"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d053e595-46a9-4735-8517-ee19cf238228",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "Er hat viele Jahre als Schiffer in der Binnenschifffahrt gearbeitet."
                                            },
                                            {
                                                "example_id": "5f286afe-a0e3-4d7f-b91f-e0a2e86e13e9",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Flößer und Schiffer manövrierten in mühseliger Arbeit durch die gefährlichen Stellen.“"
                                            },
                                            {
                                                "example_id": "24b0406e-490c-4bdc-ad06-af5e242287db",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„In der Familie Kokot fuhren die Männer seit Generationen als Schiffer auf der Oder.“"
                                            },
                                            {
                                                "example_id": "3d4ac4a5-8dc1-43be-a88b-8cc496381443",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Die Schiffer waren darüber wütend und schimpften.“"
                                            },
                                            {
                                                "example_id": "20a10fa9-c6c1-454b-a0b8-a2aead82a851",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Er sprach es nicht aus, plante aber im Herzen, irgendwie mit den Schiffern gemeinsame Sache zu machen, um seinen Herrn ins Wasser zu stoßen und so ums Leben zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e6b32a7-23b6-325a-b83b-078d8713d2b9",
                                        "entry_id": "7739d886-85ca-3fd4-b3d9-aa3e7a62bd7f",
                                        "glosses": [
                                            "der Führer eines Schiffes"
                                        ],
                                        "tags": [
                                            "Seerecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efaefe10-f1d3-4770-8bb2-ad3e836cc0db",
                                                "sense_id": "9e6b32a7-23b6-325a-b83b-078d8713d2b9",
                                                "text": "„Kurz bevor ich mich zu Tich setzte, kam der Schiffer selbst mit einem Matrosen, um mein Gepäck zu holen; ich gab ihm den fertigen Koffer und sagte, den Rest würde ich selbst zur Abfahrtszeit an Bord bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d762b664-5b83-439a-8869-6c12547917a1",
                        "source_entry_id": "b4a188c4-24e2-32a4-8bcc-91c06980d6b5",
                        "target_lang_word": "bargeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bargeman",
