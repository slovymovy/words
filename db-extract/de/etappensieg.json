                        "entry_id": "856a539b-7aa1-3a5b-8697-831a981d285a",
                        "glosses": [
                            "Sieg auf einer Teilstrecke eines Rennens, das in mehreren Etappen abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fb4498-83d3-4f0d-bcbd-cc81b8f97b5e",
                                "sense_id": "44644356-a631-36b0-962d-353a90def3a4",
                                "text": "„Der Goldmedaillengewinner von Rio auf der Bahn feierte nach den 226 Kilometern des längsten Abschnitts von Wieselburg nach Altheim seinen zweiten Etappensieg.“"
                            },
                            {
                                "example_id": "8540fe11-4dc6-4410-ab74-6b3e586ddcf8",
                                "sense_id": "44644356-a631-36b0-962d-353a90def3a4",
                                "text": "„Trotz der schwierigen Umstände hofft er weiter auf seinen ersten Etappensieg.“"
                            }
                        ],
