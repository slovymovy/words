                ],
                "senses": [
                    {
                        "sense_id": "042b0273-695e-3ba1-a7d6-0728dc6dcf33",
                        "entry_id": "7b45e2b4-399c-3129-a8f9-28f138018866",
                        "glosses": [
                            "female equivalent of protoplasta (“protoplast; progenitrix, foremother, Eve”) (founder of a lineage)"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7a0d02f4-342c-40d1-87a1-24ab8db357db",
                                "sense_id": "042b0273-695e-3ba1-a7d6-0728dc6dcf33",
                                "text": "protoplastka rodu; rasy, poczty elektronicznej",
                                "translation": "progenitrix of a family; race, electronic mail",
                                "english": "progenitrix of a family; race, electronic mail"
                            },
                            {
                                "example_id": "fdd1c47c-a64c-4582-beaf-a91e4384b796",
                                "sense_id": "042b0273-695e-3ba1-a7d6-0728dc6dcf33",
                                "text": "Wówczas uproszono bawiącą w Trouville lady Stuart do przedstawienia swéj protoplastki.",
                                "translation": "It was then that Lady Stuart, who was playing in Trouville, was asked to introduce her progenitrix.",
                                "english": "It was then that Lady Stuart, who was playing in Trouville, was asked to introduce her progenitrix."
                            },
                            {
                                "example_id": "a6b8d045-5afd-451b-89fe-237e96e9cd46",
                                "sense_id": "042b0273-695e-3ba1-a7d6-0728dc6dcf33",
                                "text": "Mieszczanie ceniąc sobie te dobre z panami stósunki[…] niejedna złotowłosa Gretchen mieszczańska rezyduje w starym dworcu pańskim[,] jako protoplastka rycerskich mężów XVI [16] i XVII [17] wieku, odprzysięgających się potém,[…]!",
                                "translation": "The townspeople, appreciating these good relations with their lords, […] [not?] many golden-haired burgher Gretchen reside in the old lord's court[,] as the foremother of the knightly husbands of the 16. and 17. centuries, swearing off afterwards, […]!",
                                "english": "The townspeople, appreciating these good relations with their lords, […] [not?] many golden-haired burgher Gretchen reside in the old lord's court[,] as the foremother of the knightly husbands of the 16. and 17. centuries, swearing off afterwards, […]!"
                            }
                        ]
                    },
                    {
                        "sense_id": "47733ec1-8116-3e34-bb40-57109de5e92c",
                        "entry_id": "7b45e2b4-399c-3129-a8f9-28f138018866",
                        "glosses": [
                            "female equivalent of protoplasta (“protoplast; prototype”) (something from which a thing is derived)"
                        ],
