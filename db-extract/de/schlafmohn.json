                ],
                "senses": [
                    {
                        "sense_id": "9a19ed08-7c89-38f0-8691-80a59f239b35",
                        "entry_id": "2e8d517f-dc80-3b2d-9218-bcb71555d4eb",
                        "glosses": [
                            "Pflanzenart aus der Gattung des Mohns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fcc61b6-ec55-419a-9e31-9b6cf991d812",
                                "sense_id": "9a19ed08-7c89-38f0-8691-80a59f239b35",
                                "text": "„Besonders der Handel mit Schlafmohn, der in grenznahen afghanischen Provinzen wie Nangarhar, Hilmand oder Kandahar angebaut wird, eröffnete hier eine neue Dimension.“"
                            },
                            {
                                "example_id": "d80637c7-79b8-408b-a148-a71e35446d32",
                                "sense_id": "9a19ed08-7c89-38f0-8691-80a59f239b35",
                                "text": "„Paradoxerweise wurde die Wirtschaftskrise durch das Verbot von Schlafmohn verschärft - der einzige Fall, in dem die Taliban gegenüber Forderungen der internationalen Gemeinschaft einlenkten.“"
                            },
                            {
                                "example_id": "23dcf247-5dc6-4220-84ee-8f64f5d80cbe",
                                "sense_id": "9a19ed08-7c89-38f0-8691-80a59f239b35",
                                "text": "„Das war jedoch keineswegs das Ende des Anbaus von Marihuana und Schlafmohn in Mexiko.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
