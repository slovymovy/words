                        "form": "den Gobelin"
                    },
                    {
                        "form_id": "b9f271bd-7dd7-455e-b08a-ffc91f35f135",
                        "entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                        "tags": [
                            "accusative",
