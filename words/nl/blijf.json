                    "sense_id": "a0894ed4-be65-3683-add2-6d0e66507bd7",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>blijven</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>blijf</w> vandaag lekker thuis om uit te rusten.",
                            "target_lang_translations": {
                                "en": "I am <w>staying</w> home today to rest.",
                                "ru": "Я сегодня с удовольствием <w>остаюсь</w> дома, чтобы отдохнуть.",
                                "it": "Oggi <w>rimango</w> a casa a rilassarmi per riposarmi."
                            }
                        },
                        {
                            "text": "Ik <w>blijf</w> hopen dat alles uiteindelijk goed komt.",
                            "target_lang_translations": {
                                "en": "I <w>keep</w> hoping that everything will turn out fine eventually.",
                                "ru": "Я <w>продолжаю</w> надеяться, что в итоге всё будет хорошо.",
                                "it": "<w>Continuo</w> a sperare che alla fine andrà tutto bene."
                            }
                        }
                    ],
                    "common_phrases": [
