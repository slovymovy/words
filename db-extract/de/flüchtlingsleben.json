                        "examples": [
                            {
                                "example_id": "264fca2d-6805-40ad-9fbf-dc8c2f75f405",
                                "sense_id": "402f9704-151e-3c50-9f66-162b0bb5172e",
                                "text": "„Als Leser geht man durch die Geschichte in ein Leben, das viele Leute nicht kennen und sieht, wie das Flüchtlingsleben für ein Kind sein kann.“"
                            },
                            {
                                "example_id": "516fecdf-917d-4af8-9890-1f8cb5757c85",
                                "sense_id": "402f9704-151e-3c50-9f66-162b0bb5172e",
                                "text": "„Mutters Aufenthaltsgenehmigung wurde nicht verlängert, sie mußte noch am selben Tag zurück nach Uelzen - Garage bewohnen bei lieblosen Verwandten, Flüchtlingsleben leben.“"
                            }
                        ],
