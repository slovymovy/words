                        "examples": [
                            {
                                "example_id": "de7d04b5-a32d-44e1-a08c-e27d29f3b5e8",
                                "sense_id": "49667f41-418c-3bd7-8ff2-b2bf2daa9c68",
                                "text": "Лёгкий шорох, подобный шелесту женского платья, поднимался по временам в верхушках близких деревьев и возбуждал в Берсеневе ощущение сладкое и жуткое, ощущение полустраха.",
                                "translation": "On the tree-tops near there was a faint stir, like the rustle of a woman's dress, awaking in him a feeling half-sweet, half-painful, a feeling almost of fright.",
                                "english": "On the tree-tops near there was a faint stir, like the rustle of a woman's dress, awaking in him a feeling half-sweet, half-painful, a feeling almost of fright."
                            }
                        ]
                    }
