                "senses": [
                    {
                        "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                        "entry_id": "22ae3506-965f-3a4a-b4df-14c06362c0ef",
                        "glosses": [
                            "Coup de poing réalisé de bas en haut, et délivré le plus souvent à mi-distance avec le bras semi-fléchi, dans un combat de boxe ou une rixe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061532f6-7670-4990-b644-343a5a825bfa",
                                "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                                "text": "[…] mais quand Habib, rendu furieux par un uppercut qui faillit l’envoyer à terre, se ressaisit et fonça bestialement sur l’homme au beau visage, le combat prit une allure saisissante."
                            },
                            {
                                "example_id": "ddd6e03e-be0e-4a1f-8678-6f70143f84d7",
                                "sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
                                "text": "Il avait ramassé notamment deux droites assez violentes, un uppercut qui l'avait fait vaciller."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2524146-1928-481d-8cea-b14d8b8e366b",
                        "source_entry_id": "22ae3506-965f-3a4a-b4df-14c06362c0ef",
                        "source_sense_id": "816235b2-1836-3912-9cbc-f77d732bdfcd",
