                                "target_senses": [
                                    {
                                        "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                        "entry_id": "c89c74a9-2be3-328b-9b3d-6b652eaa366a",
                                        "glosses": [
                                            "A prenuptial agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083687a4-eb93-49e8-a01a-b64a5d8689d5",
                                                "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                                "text": "Such tangles and many others can be avoided with a buy-sell agreement — basically a business prenup or a postnup, depending on when owners draw it up."
                                            },
                                            {
                                                "example_id": "b307eaba-42ee-48fe-8759-7eff25040e34",
                                                "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                                "text": "Now, let me add that I am not generally a fan of prenups for people without big assets or liabilities, or children from previous relationships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00efc60a-00e1-3590-89fc-3064f081e6a6",
                                        "entry_id": "c89c74a9-2be3-328b-9b3d-6b652eaa366a",
                                        "glosses": [
                                            "A casual photoshoot before a wedding"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
