        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2bff77ed-097b-3611-88de-70cf01ecb839",
                "word": "cheroot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fee8cfed-a641-4bcc-b377-9222b1c11902",
                        "entry_id": "2bff77ed-097b-3611-88de-70cf01ecb839",
