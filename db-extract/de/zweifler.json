                        "glosses": [
                            "Person, die leicht/oft dazu neigt, an etwas zu zweifeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54eee958-ba46-4efa-bf10-0b5b0a052204",
                                "sense_id": "0401cffa-b0bf-3475-a5a2-f4361905f245",
                                "text": "„Auch hier konnte es der alte Zweifler nicht unterlassen, die Echtheit seiner Gefühle in Frage zu stellen.“"
