                        "entry_id": "95abb5dd-6b50-3356-8d92-9e7f4e38ded3",
                        "glosses": [
                            "het herdenken van de doden die vielen in de Tweede Wereldoorlog, in het bijzonder op 4 mei"
                        ],
                        "tags": [
                            "Nederland"
                        ],
                        "examples": [
                            {
                                "example_id": "2fb4554c-a0fd-4623-8ab1-5904d1ee3213",
                                "sense_id": "25f9e1f3-dfff-3e42-8021-a76882de482d",
                                "text": "Wij zijn gisteren naar de dodenherdenking op de Erebegraafplaats Bloemendaal geweest."
                            },
                            {
                                "example_id": "3ab005a4-643a-4e19-ba62-54ae39f1624c",
                                "sense_id": "25f9e1f3-dfff-3e42-8021-a76882de482d",
                                "text": "Tijdens de dodenherdenking moet je 2 minuten stil zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5aebfde-77d0-4055-9fea-f464c61b0f3d",
                        "source_entry_id": "95abb5dd-6b50-3356-8d92-9e7f4e38ded3",
                        "source_sense_id": "25f9e1f3-dfff-3e42-8021-a76882de482d",
                        "source_sense_description": "het herdenken van de doden die vielen in de Tweede Wereldoorlog, meestal op 4 mei",
                        "target_lang_word": "Totenfeier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totenfeier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6327c314-3409-3871-8569-1d3b6d3a23f6",
                                        "entry_id": "8e6e8fe5-b617-38ca-9b3f-317adeb39392",
                                        "glosses": [
                                            "eine Feier zu einem würdigen, ehrenden Gedenken an einen Verstorbenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9084b338-fe29-4d84-82f9-57b7d2873e46",
                                                "sense_id": "6327c314-3409-3871-8569-1d3b6d3a23f6",
                                                "text": "Zur Totenfeier erschienen auch die örtlichen Würdenträger."
                                            },
                                            {
                                                "example_id": "5b994d01-96ba-4cff-828c-9e4b62a859e8",
                                                "sense_id": "6327c314-3409-3871-8569-1d3b6d3a23f6",
                                                "text": "„Gewiß kam jedem Maya nach seinem Ableben eine anständige Totenfeier und ein Begräbnis zu.“"
                                            },
                                            {
                                                "example_id": "861b1388-0281-4f81-9935-e8183983c527",
                                                "sense_id": "6327c314-3409-3871-8569-1d3b6d3a23f6",
                                                "text": "„Nach der Totenfeier löst sich die Trauergemeinde auf; man strebt vereinzelt oder in kleinen Gruppen durch die kahle Allee dem Ausgang zu.“"
                                            },
                                            {
                                                "example_id": "42554938-f8a1-40c1-88e9-458204b5cab6",
                                                "sense_id": "6327c314-3409-3871-8569-1d3b6d3a23f6",
                                                "text": "„Die Trauermusik, die von Hiller komponiert und ursprünglich auf den Tod des – Kant nicht sehr gnädig gesonnenen – Königs Friedrich Wilhelm II. geschrieben, doch noch rechtzeitig geändert worden war, eröffnete und beschloss die Totenfeier, bei der auch städtische Schauspieler mitwirkten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
