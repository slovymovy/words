                                        "entry_id": "fcf882e3-6e0f-3e37-9e83-32323eec9f80",
                                        "glosses": [
                                            "jean shorts, a pair of shorts made from denim (especially, mid-thigh or knee-length)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
