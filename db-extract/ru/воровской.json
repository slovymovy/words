                                        "glosses": [
                                            "(häufig) klauend/stehlend; jemandem etwas wegnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a41df2-7118-4dff-a57e-6b31695383e0",
                                                "sense_id": "44573608-134f-3604-8ffe-aec83ceb74bb",
                                                "text": "Du diebische kleine Kröte! Gib mir sofort die Tasche wieder her!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c173715f-1342-370f-a410-a93396c19116",
                                        "entry_id": "7c5734b0-7e2f-3a7d-a18f-3c9278f72b62",
                                        "glosses": [
                                            "sich heimlich freuend; voller angedeuteter heimlicher Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953313a7-c6c3-4d9a-861c-778b17490aa8",
                                                "sense_id": "c173715f-1342-370f-a410-a93396c19116",
                                                "text": "Mit einem diebischen Lächeln reichte sie ihm das leere Kuvert."
                                            },
                                            {
                                                "example_id": "a5abd40d-8ebb-424c-9d0a-1a68d21fa7c3",
                                                "sense_id": "c173715f-1342-370f-a410-a93396c19116",
                                                "text": "Die Kinder freuten sich diebisch, als die Nachbarin zum dritten Mal die Tür öffnete und niemand zu sehen war."
                                            }
