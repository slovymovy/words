                "senses": [
                    {
                        "sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
                        "entry_id": "6b1698ff-e92d-3f08-b423-54b857a0f444",
                        "glosses": [
                            "zo op het eerste gezicht, zo naar het uiterlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e766428a-effd-44a0-9522-d5371466d2d0",
                                "sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
                                "text": "Ogenschijnlijk deden de kinderen erg hun best, maar eigenlijk deden ze helemaal niets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69f879ce-d1ee-4b7a-8eff-47719c0175a8",
                        "source_entry_id": "6b1698ff-e92d-3f08-b423-54b857a0f444",
                        "source_sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
                        "target_lang_word": "apparent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a078ec8-5623-395f-bf9c-ef020d3150c5",
                                        "entry_id": "bf53429d-cc2f-3c87-b309-64e203c6d80b",
                                        "glosses": [
                                            "Capable of being seen, or easily seen; open to view; visible to the eye; within sight or view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8fdff9-fdbd-46a2-9e56-c33f2cb2f4a7",
                                                "sense_id": "3a078ec8-5623-395f-bf9c-ef020d3150c5",
                                                "text": "[…] Hesperus, that led / The starry host, rode brightest, till the moon, / Rising in clouded majesty, at length / Apparent queen unveiled her peerless light, / And o’er the dark her silver mantle threw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899e336a-3608-337a-896a-d17deb1e96c8",
                                        "entry_id": "bf53429d-cc2f-3c87-b309-64e203c6d80b",
                                        "glosses": [
                                            "Clear or manifest to the understanding; plain; evident; obvious; known; palpable; indubitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec61ffce-f458-46bc-a32d-84c15255196a",
                                                "sense_id": "899e336a-3608-337a-896a-d17deb1e96c8",
                                                "text": "Salisbury: It is apparent foul-play; and ’tis shame / That greatness should so grossly offer it: / So thrive it in your game! and so, farewell."
                                            },
                                            {
                                                "example_id": "9c35a863-d6ff-4bd2-96e8-59af972cf0b8",
                                                "sense_id": "899e336a-3608-337a-896a-d17deb1e96c8",
                                                "text": "When I came to Renfield's room I found him lying on the floor on his left side in a glittering pool of blood. When I went to move him, it became at once apparent that he had received some terrible injuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                                        "entry_id": "bf53429d-cc2f-3c87-b309-64e203c6d80b",
                                        "glosses": [
                                            "Appearing to the eye or mind (distinguished from, but not necessarily opposed to, true or real); seeming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23d1363-74b1-4a0a-a071-b04f0a5cc2f1",
                                                "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                                                "text": "1785, Thomas Reid, Essays on the Intellectual Powers of Man, Essay II (“Of the Powers we have by means of our External Senses”), Chapter XIX (“Of Matter and of Space”),\nWhat George Berkeley calls visible magnitude was by astronomers called apparent magnitude."
                                            },
                                            {
                                                "example_id": "363b0c92-3448-4a99-a88f-997cd8070518",
                                                "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                                                "text": "To live on terms of civility, and even of apparent friendship."
                                            },
                                            {
                                                "example_id": "9959db95-c314-436d-b0d2-19fa89eab8dc",
                                                "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                                                "text": "This apparent motion is due to the finite velocity of light, and the progressive motion of the observer with the earth, as it performs its yearly course about the sun."
                                            },
                                            {
                                                "example_id": "c41558a8-c171-424d-8525-78f20dc6b25e",
                                                "sense_id": "1b5124d1-e82d-35ab-8066-4575aa0569d3",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92252019-9ce5-4db9-9eda-db4fef218816",
                        "source_entry_id": "6b1698ff-e92d-3f08-b423-54b857a0f444",
                        "source_sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
