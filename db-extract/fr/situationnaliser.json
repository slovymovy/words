                "senses": [
                    {
                        "sense_id": "c2529c1b-749a-3807-ad56-97f14c36d60f",
                        "entry_id": "a6fe228c-70ae-3e90-bed2-6d141ba5cce1",
                        "glosses": [
                            "Donner un caractère situationnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae83b241-fa14-43af-a793-46b9da16b02a",
                                "sense_id": "c2529c1b-749a-3807-ad56-97f14c36d60f",
                                "text": "En effaçant l’importance donnée au sujet, l’effet est aussi de rapprocher les événements dont on parle, de les « situationnaliser »."
                            },
                            {
                                "example_id": "eb3d0440-d75c-47e5-a097-f0a48fb0927d",
                                "sense_id": "c2529c1b-749a-3807-ad56-97f14c36d60f",
                                "text": "Compte-tenu de la question de l’interaction des paramètres, qui est évidemment trop complexe pour être traitée ici, nous voulons mettre en exergue deux facettes des PR détachées : le caractère situationnalisé du contenu de la relative, la PR détachée en tant que pseudo-indépendante."
                            }
                        ]
                    }
