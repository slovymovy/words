                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72046acb-3aab-4fbe-8643-293af017c1d0",
                                                "sense_id": "64dbf472-424c-36b0-9926-359b0fac074e",
                                                "text": "It's going to be in the low thirties tonight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thirties",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1253819b-1acb-3e72-b2d0-66c7d850e5d4",
                                        "entry_id": "8a81fba0-e6f9-31fc-847a-670a15493253",
                                        "glosses": [
                                            "From or evoking the 31st through 40th years of a century (chiefly the 1930s)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d084f3e-7640-42e6-bfb4-0b351c847a2c",
                                                "sense_id": "1253819b-1acb-3e72-b2d0-66c7d850e5d4",
                                                "text": "Yearslong droughts? How thirties!"
                                            },
                                            {
                                                "example_id": "73632964-bd67-4bf4-959b-450fda249144",
                                                "sense_id": "1253819b-1acb-3e72-b2d0-66c7d850e5d4",
                                                "text": "'Something light and airy for this last burst of summer, non?' said Madame, and held up a dress in creamy pink crêpe-de-Chine. 'Very thirties, n'est-ce pas? I adore this fabric—so fluid, so graceful.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
