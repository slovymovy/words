                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c73d5f-2637-3e3c-8e5f-00f6cf95a18c",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "neben der Beschaffung und der Produktion die dritte grundlegende betriebliche Funktion; umfasst alle betrieblichen Maßnahmen, die der Veräußerung und dem Verkauf der produzierten Güter dienen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "a18c439e-a994-3d46-a41f-7e6f1a4513f3",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "der Prozess des Verkaufens oder Absetzens"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "0518b9b7-1ed3-3c65-b8cc-57823c45db87",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "die Unterbrechung eines fortlaufenden Textes durch den Neubeginn in einer neuen Zeile oder in einem ganz neuen Abschnitt"
                                        ],
                                        "tags": [
                                            "Typographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4274cf31-e687-43bc-9da3-635070270edb",
                                                "sense_id": "0518b9b7-1ed3-3c65-b8cc-57823c45db87",
                                                "text": "Fügen Sie nach dieser Textpassage einen Absatz ein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "der erhöhte Teil der Schuhsohle am hinteren Schuhende"
                                        ],
                                        "tags": [
                                            "Bekleidung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b9f80f1-5e48-4305-9078-fb4fd209522f",
                                                "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                                "text": "Mit hohen Absätzen zu laufen ist ungesund für die Füße."
                                            },
                                            {
                                                "example_id": "b892d052-e5d4-4ff5-b76e-7bb0a65d2eec",
                                                "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                                "text": "„Ich hatte gerade Paris in violetten Sandaletten mit sehr hohen Absätzen durchquert, die ich bei Christian Louboutin im Sonderangebot gekauft hatte.“"
                                            },
                                            {
                                                "example_id": "ae03a151-a4f3-4f43-8a5a-2097848529d1",
                                                "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                                "text": "„Sisi, an hohe Absätze nicht gewöhnt, konnte mit den glänzenden, silbernen Pumps kaum das Gleichgewicht halten, schwenkte aber ihren Po, wie sie es bei Models gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "920ad1c7-43c3-4e98-ba0a-3b183da63d2e",
                                                "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                                "text": "„Ich drehte mich auf dem Absatz um und machte, daß ich da rauskam.“"
                                            },
                                            {
                                                "example_id": "05f13195-1da3-41d2-9ebd-4b53c5afd1b3",
                                                "sense_id": "f189b775-3669-3558-9a59-78d08f050866",
                                                "text": "„Das zerbrochene Glas zerstörter Straßenlaternen knirschte unter seinen Absätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "654009ee-83be-3a98-9524-9bd1c3659a06",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "der Absatz einer Treppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e77d518-27bb-494c-a85f-43c815b1e8fe",
                                                "sense_id": "654009ee-83be-3a98-9524-9bd1c3659a06",
                                                "text": "Diese Treppe hat sehr schmale Absätze."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "709cf107-46bc-3cff-8362-0b6507fe1133",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "die Ablagerung von Sedimentgesteinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aaa5b29-7e31-4bf5-b0ce-ec55f2835431",
                                                "sense_id": "709cf107-46bc-3cff-8362-0b6507fe1133",
                                                "text": "Tuff, in der Geologie oft gebraucht für lockere Absätze aus Wasser (wie Kalktuff, Kieseltuff)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "Teil eines Textes mit zusammengehörendem Inhalt, der durch eine neue Zeile und/oder Einrückung grafisch markiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d003ffa-287f-47fa-95ce-03d2d1110ab8",
                                                "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                                "text": "Ihr fiel es zu, den dritten Absatz vorzulesen, der lang war und voller schwerer Konstruktionen."
                                            },
                                            {
                                                "example_id": "dedb9058-632f-429f-975e-f6649cfea788",
                                                "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                                "text": "Das Bonner Grundgesetz verbietet in Artikel 26, erster Absatz, das friedliche Zusammenleben der Völker zu stören, insbesondere die Führung eines Angriffskrieges vorzubereiten."
                                            },
                                            {
                                                "example_id": "75dec08f-9273-40e8-99fc-14e2d1fb0796",
                                                "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                                "text": "„Die letzten Absätze waren die Einleitung zum Thema.“"
                                            },
                                            {
                                                "example_id": "64d8c6d5-c3c9-4a8f-a409-ba2f6d648105",
                                                "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                                "text": "„Dieser Absatz ist charakteristisch für Schopenhauers künstlerische Verfahrensweise; es geht ihm darum, uns eine Analogie vor Augen zu führen, die sich ihm durch lange, tiefe Betrachtung offenbart hat.“"
                                            },
                                            {
                                                "example_id": "a67e77b3-329f-4e9e-8210-b233aca07219",
                                                "sense_id": "06adfb1d-6ec4-38b8-8b5e-e2e2e34a0640",
                                                "text": "„Im letzten Absatz des Romans sitzt Lohkamp am Totenbett der verlorenen Geliebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "41762370-09d8-3bc2-be2c-4c80e977f989",
                                        "entry_id": "0fc2a83b-b76e-3651-9063-4a7d8f766b18",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2e16ac-5d15-435a-af7d-e60d2bf6e81a",
                                                "sense_id": "41762370-09d8-3bc2-be2c-4c80e977f989",
                                                "text": "Der Absatz hat die Erwartungen nicht erfüllt."
                                            },
                                            {
                                                "example_id": "d8ca0c4f-2215-4593-afda-44b16a654967",
                                                "sense_id": "41762370-09d8-3bc2-be2c-4c80e977f989",
                                                "text": "„Zudem brach der Absatz von nicht lebenswichtigen Waren weitgehend ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
