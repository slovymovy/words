                "senses": [
                    {
                        "sense_id": "807bd4fc-c461-3491-ba54-ef725217c99a",
                        "entry_id": "fdb78462-b7ac-3536-b192-55783cfa64bf",
                        "glosses": [
                            "een mythisch wezen dat voorkomt in verschillende culturen, meestal samengesteld uit een gedeelte mens (hoofd) en een gedeelte dier (lichaam), soms ook uit twee dierlijke delen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1310181e-3909-4d63-bb09-98b41d6ba009",
                                "sense_id": "807bd4fc-c461-3491-ba54-ef725217c99a",
                                "text": "De Sfinx van Gizeh is de bekendste sfinx."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c2fafbe-6961-4f1a-b5c3-8ad4ffb106e7",
                        "source_entry_id": "fdb78462-b7ac-3536-b192-55783cfa64bf",
                        "source_sense_id": "807bd4fc-c461-3491-ba54-ef725217c99a",
                        "target_lang_word": "Sphinx",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sphinx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Statue eines männlichen Löwen mit einem Menschenkopf beziehungsweise auch einem Kopf des Widders, Falken und Sperbers"
                                        ],
                                        "tags": [
                                            "ägyptische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fcc254e-aee8-4dc9-bfff-ad46454b11a1",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Die meisten als Sphinx bezeichneten Statuen stellen einen König oder Pharao als Sonnengott, Horus oder auch andere ägyptische Götter dar, andere fungierten in liegender Form als Wächterfiguren vor Tempeleingängen.“"
                                            },
                                            {
                                                "example_id": "14f05788-275e-437c-bb3a-0ea83dfb4f8d",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Die Mumienabteilung ist das Herz des Ägyptischen Museums, vorher mussten wir an Sphinxen und Göttern vorbei, die entweder keinen Kopf oder keinen Rumpf mehr hatten, aber auch an Nachbauten von Streitwagen, für die ich ein größeres Faible besitze.“"
                                            },
                                            {
                                                "example_id": "c80d9c6c-7a76-4b62-9f42-852fd62f5512",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„So gilt der Widder als Symboltier des Amun, und zu den großen Amun-Tempeln von Karnak und Luxor führen heute zum Teil noch gut erhaltene steinerne Alleen von widdergestaltigen Sphingen.“"
                                            },
                                            {
                                                "example_id": "181362a4-6ded-4e58-a1f5-c06681609e9b",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Ihr Haar war gelackt wie eine ägyptische Sphinx; sie war stark geschminkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52d0e022-11c4-390c-b2bc-3e476135fcee",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "bekanntes Bauwerk aus dem Alten Ägypten"
                                        ],
                                        "tags": [
                                            "Große Sphinx von Gizeh"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ae7d64-d388-4ff4-8006-cd3d031d309d",
                                                "sense_id": "52d0e022-11c4-390c-b2bc-3e476135fcee",
                                                "text": "Seit mehr als vier Jahrtausenden ragt der Sphinx aus dem Sand der ägyptischen Wüste."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Statue eines geflügelten Löwen mit dem Kopf einer Frau beziehungsweise auch eine Frau mit den Tatzen und Brüsten einer Löwin"
                                        ],
                                        "tags": [
                                            "griechische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b218c6e-b847-4e34-96ea-25ad14679a01",
                                                "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                                "text": "„Die Sphinx galt als Dämon der Zerstörung und des Unheils.“"
                                            },
                                            {
                                                "example_id": "1bf306fa-eac5-499b-a15d-8b1cd0e11a37",
                                                "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                                "text": "„Henrik Ibsen brachte es dahin, jahrelang zu einer bestimmten Stunde in einem bestimmten Stuhl und in einem bestimmten Café in München Sphinx zu spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af033ba9-15f0-35aa-9084-c8f7a33e23f2",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Gattung der Schwärmer, einer Unterart der Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "66c5d239-9b1c-3c9c-810b-d28de838bc79",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Hauskatzenrasse mit nur leichtem Flaum als Fell"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b57bfaba-9d4b-4492-87c5-93760538c272",
                        "source_entry_id": "fdb78462-b7ac-3536-b192-55783cfa64bf",
                        "source_sense_id": "807bd4fc-c461-3491-ba54-ef725217c99a",
                        "target_lang_word": "sphinx",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphinx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0190adb9-94ed-30aa-abd1-6ce52b830809",
                                        "entry_id": "b9219cde-d989-3d60-baa2-0bcbdaf16d60",
                                        "glosses": [
                                            "A creature with the head of a person and the body of an animal, commonly a lion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef27d152-b562-4112-bc8a-eba8ef68d623",
                                                "sense_id": "0190adb9-94ed-30aa-abd1-6ce52b830809",
                                                "text": "[W]hatsoe'er of strange / Sculptured on alabaster obelisk, / Or jasper tomb, or mutilated sphynx, / Dark Æthiopia in her desert hills. / Conceals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58aee00b-19ce-3c80-b042-ac6aa51c284d",
                                        "entry_id": "b9219cde-d989-3d60-baa2-0bcbdaf16d60",
                                        "glosses": [
                                            "A person who keeps their thoughts and intentions secret; an enigmatic or impassive person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07099322-5c94-4953-b86e-d6d0e52e4912",
                                                "sense_id": "58aee00b-19ce-3c80-b042-ac6aa51c284d",
                                                "text": "...it is clear that judges are no longer required to be as passive as they once were; to be what I call sphinx judges. We now not only accept that a judge may intervene in the adversarial debate, but also believe that it is sometimes essential for him to do so for justice in fact to be done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7e9653f-b662-3336-ba2b-b8f97fa88def",
                                        "entry_id": "b9219cde-d989-3d60-baa2-0bcbdaf16d60",
                                        "glosses": [
                                            "A mandrill (Mandrillus sphinx), formerly classified as a baboon, and called sphinx baboon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d212cc8c-bbd8-35b4-a897-7bd202fc25f3",
                                        "entry_id": "b9219cde-d989-3d60-baa2-0bcbdaf16d60",
                                        "glosses": [
                                            "A sphinx moth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b962afec-ac6b-334f-93ea-c47a2244abc2",
                                        "entry_id": "b9219cde-d989-3d60-baa2-0bcbdaf16d60",
                                        "glosses": [
                                            "A sphincter."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f78280b-36b0-4c8e-a951-598aca945a93",
                                                "sense_id": "b962afec-ac6b-334f-93ea-c47a2244abc2",
                                                "text": "Constance said boastfully, ‘My sphinxes are strong and in good repair. I order you to come.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sphinx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4507b4-af82-3733-b1bb-af843fa7b9dd",
                                        "entry_id": "02eb5534-9bcd-3e74-8c46-e7c0b370ab7c",
                                        "glosses": [
                                            "To decorate with sphinxes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "555ea2f8-65d9-44ba-8822-bcedd3d4bbda",
                                                "sense_id": "9d4507b4-af82-3733-b1bb-af843fa7b9dd",
                                                "text": "a marble sphinxed chimney-piece"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8818318b-dafe-3550-b947-b18e4c8f0ed0",
                                        "entry_id": "02eb5534-9bcd-3e74-8c46-e7c0b370ab7c",
                                        "glosses": [
                                            "To adopt the posture of the Sphinx."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a97a373-c845-48b3-a8a8-b6b8218168a1",
                                                "sense_id": "8818318b-dafe-3550-b947-b18e4c8f0ed0",
                                                "text": "A hot lion with a very bloated stomach … will adopt either a sphinxed or a squatting posture which takes some of the weight off its belly."
                                            },
                                            {
                                                "example_id": "3ef9e6aa-4d7e-4c2e-b4fd-20d6c40c46f2",
                                                "sense_id": "8818318b-dafe-3550-b947-b18e4c8f0ed0",
                                                "text": "Several animals maintained either a crouched … or a sphinxing posture (abdomen on the floor)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b7be56-4c0a-318b-a2d7-0ba78fade32d",
                                        "entry_id": "02eb5534-9bcd-3e74-8c46-e7c0b370ab7c",
                                        "glosses": [
                                            "To be inscrutable, often through silence."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaef6ebc-f0f7-4c4b-a00c-4314cb1ab3ca",
                                                "sense_id": "69b7be56-4c0a-318b-a2d7-0ba78fade32d",
                                                "text": "The sphinxèd riddle of the Universe,\nNature's unsolved enigma, who may prove?"
                                            },
                                            {
                                                "example_id": "b4a2ee5d-38bc-4274-b2b8-492b70590747",
                                                "sense_id": "69b7be56-4c0a-318b-a2d7-0ba78fade32d",
                                                "text": "Then there are the folks trying to do a Garbo on us[…]Janet Gaynor, so they tell, is sphinxing it and has gone into a Retirement, with \"Nothing to Say — Please Go Away\" written on the doormat."
                                            },
                                            {
                                                "example_id": "a7a70cce-8048-40d7-8b85-5cb48a809bc4",
                                                "sense_id": "69b7be56-4c0a-318b-a2d7-0ba78fade32d",
                                                "text": "What with Fisher whole-hogging on one side, and K. of K. sphinxing on the other, Churchill had his work cut out to get any sort of agreement at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99266489-5f45-334f-bfde-ad225271768e",
                                        "entry_id": "02eb5534-9bcd-3e74-8c46-e7c0b370ab7c",
                                        "glosses": [
                                            "To behave in a manner characteristic of the Sphinx."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b120d8-421a-4e92-8c0f-90f40c33329b",
                                                "sense_id": "99266489-5f45-334f-bfde-ad225271768e",
                                                "text": "Perhaps Nature is sphinxing us on purpose. Whatever her objects may be, perhaps she gets her work done better when she appeals to our gambling instincts. If you knew for certain exactly how your marriage was going to turn out[…]"
                                            },
                                            {
                                                "example_id": "c672f5df-fe0a-41eb-9de0-1233018fa871",
                                                "sense_id": "99266489-5f45-334f-bfde-ad225271768e",
                                                "text": "And then he summarizes his fears with a reference to that icon which[…]stood for the feminine threat to civilization: “Crowds are somewhat like the sphinx of ancient fable: it is necessary to arrive at a solution of the problems offered by their psychology or to resign ourselves to being devoured by them.” Male fears of an engulfing femininity are here projected onto the metropolitan masses, who did indeed represent a threat to the rational bourgeois order.[…]We may want to relate Le Bon's social psychology of the masses back to modernism's own fears of being sphinxed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9e3faa0-f596-4143-8634-f38aa2447b7f",
                        "source_entry_id": "fdb78462-b7ac-3536-b192-55783cfa64bf",
                        "source_sense_id": "807bd4fc-c461-3491-ba54-ef725217c99a",
                        "target_lang_word": "sphinx",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphinx",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce50806-7a8c-3fdc-8136-afe120fa394b",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Monstre ayant une tête humaine et un corps de lion."
                                        ],
                                        "tags": [
                                            "Mythologie égyptienne"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9fd43d3-f511-3018-8c76-bd54379ba6f9",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Le sphinx de Gizeh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "516ae3ee-763c-3689-8505-6eedf3dfdf7a",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Ton père fut un sphinx et ta mère une nuit. — (Apollinaire, Le Larron, in Alcools, 1913)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49f4e63c-d4be-3f74-bf77-d8ec7f5bde3f",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Monstre ayant la tête et les seins d’une femme, le corps d’un lion et les ailes d’un aigle."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f5fc2bc-0b4d-3493-8e8b-f4e246f40640",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Figure qui a une tête et la poitrine d’une femme sur le corps d’un lion. Les sphinx sont représentés couchés sur le ventre, les pattes de devant étendues, et la tête droite."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e0ddbc-edf7-466f-8931-9d1e9e97dbf0",
                                                "sense_id": "2f5fc2bc-0b4d-3493-8e8b-f4e246f40640",
                                                "text": "Là, tout à coup, pour la première fois, dans un réduit obscur, une crypte, une sorte de cave, nous découvrîmes le sphinx. À Giseh, depuis 4 500 ans, le sphinx a quelque chose à dire."
                                            },
                                            {
                                                "example_id": "5faa9001-2048-42f7-96e7-a432c2fac236",
                                                "sense_id": "2f5fc2bc-0b4d-3493-8e8b-f4e246f40640",
                                                "text": "Un sphinx « souriant à deux fossettes », représentant un empereur romain, vient d’être mis au jour près du temple d’Hathor, d’où provient le célèbre zodiaque de Dendérah, à 500 km au sud du Caire (Égypte)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2e4652-dc53-3397-b8eb-262ded9ff70e",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Figure fantastique s’inspirant de l’art égyptien à la mode au XIXᵉ siècle."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "172a4f9e-2080-4a31-a3e2-09a22aa7a895",
                                                "sense_id": "aa2e4652-dc53-3397-b8eb-262ded9ff70e",
                                                "text": "C’étaient toutes ses anciennes lettres. […] Elle les avait enfermées dans un secrétaire d’acajou portant à ses angles des sphinx de cuivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78334196-d36a-323a-a8bb-abcc78f301e2",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Personne dissimulée, énigmatique impénétrable et cruelle, souvent membre des sphères de la politique ; par allusion au Sphinx de la légende d’Œdipe, qui proposait des énigmes aux passants, lesquels ne pouvant jamais répondre, payaient leur embarras de leur vie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1152727-c0f5-48a8-bb36-2a3861d04624",
                                                "sense_id": "78334196-d36a-323a-a8bb-abcc78f301e2",
                                                "text": "Rastignac ne pouvait donc pas demeurer longtemps sous le feu des batteries de Vautrin sans savoir si cet homme était son ami ou son ennemi. De moment en moment, il lui semblait que ce singulier personnage pénétrait ses passions et lisait dans son cœur, tandis que chez lui tout était si bien clos qu’il semblait avoir la profondeur immobile d’un sphinx qui sait, voit tout, et ne dit rien."
                                            },
                                            {
                                                "example_id": "8fbe1e69-c738-4ecd-9b93-0f3ebe783652",
                                                "sense_id": "78334196-d36a-323a-a8bb-abcc78f301e2",
                                                "text": "Ces réflexions traversèrent rapidement mon esprit, pendant que l’étrange personnage se taisait, absorbé et comme retiré en lui-même. Je le considérais avec un effroi mélangé d’intérêt, et sans doute, ainsi qu’Œdipe considérait le Sphinx."
                                            },
                                            {
                                                "example_id": "b72c5c0b-79e5-4c7f-8793-06c2da448b5a",
                                                "sense_id": "78334196-d36a-323a-a8bb-abcc78f301e2",
                                                "text": "Cette fille, qui me paraissait plus sphinx, à elle seule, que tous les Sphinx dont l’image se multipliait autour de moi, dans cet appartement Empire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4a560a-63ae-3d8e-93ec-8eb2ac275e97",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Symbole du mystère, de l’impénétrable. Situation angoissante comme le défilé où le Sphinx de Thèbes (en Grèce) arrêtait les voyageurs pour leur poser des questions mortelles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7291fe7-521d-4fdb-acba-c4c03dbe7093",
                                                "sense_id": "9d4a560a-63ae-3d8e-93ec-8eb2ac275e97",
                                                "text": "Gauvain voyait dans l’ombre le sinistre sourire du sphinx.\nCette situation était une sorte de carrefour redoutable où les vérités combattantes venaient aboutir et se confronter, et où se regardaient fixement les trois idées suprêmes de l’homme, l’humanité, la famille, la patrie."
                                            },
                                            {
                                                "example_id": "4a7a64a6-0474-420b-9006-a68e275aa17a",
                                                "sense_id": "9d4a560a-63ae-3d8e-93ec-8eb2ac275e97",
                                                "text": "L’Ivrognerie est un Sphinx toujours pénétré, qui s’en console en allant se soûler avec ses Œdipes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efdad17b-1f1b-3890-8e41-319fb9fd2cc3",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Personne qui s’amuse à poser des questions compliquées pour embarrasser son interlocuteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8129143-bea7-3727-a891-d1e808c9ccb5",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Auteur de grilles de mots croisés, à cause de l’habitude de proposer des définitions en forme d’énigme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a031fd-fcf7-4a91-85a1-2d9957270ad5",
                                                "sense_id": "a8129143-bea7-3727-a891-d1e808c9ccb5",
                                                "text": "Avant de devenir un « sphinx » l’auteur de mots croisés, a dû être d’abord un « œdipe » et apprendre à répondre aux énigmes."
                                            },
                                            {
                                                "example_id": "6bbd841e-ca34-451f-8366-9796e379f316",
                                                "sense_id": "a8129143-bea7-3727-a891-d1e808c9ccb5",
                                                "text": "Les mots croisés, c’est une passion que j’ai d’abord eue comme œdipe. Je pose le stylo, il se marre. Oui, dans les années 1930, on appelait œdipe celui qui résolvait les grilles et sphinx celui qui les composait.\n— Au début, je faisais l’œdipe, et puis j’ai fait le sphinx, avec des dictionnaires spécialisés. C’est difficile... Une bonne définition doit être évidente quand on a trouvé, et obscure tant qu’on n’a pas trouvé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45189266-8ecf-3813-a769-4134d238d9b2",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Variante de sphynx."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13c03e17-5887-41b9-a8c7-5096600af1d0",
                                                "sense_id": "45189266-8ecf-3813-a769-4134d238d9b2",
                                                "text": "Au-delà du téléphone, je sentis les larmes couler sur ses joues tandis qu’il me parlait de son chat, son chat sphinx. La vie était bizarre. Alors que Max semblait avoir enfin trouvé le bonheur, son seul compagnon, ce qu’il aimait par-dessus tout, était en train de partir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15335e9c-2522-3d93-8591-a4613d398b74",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Papillon de nuit surtout crépusculaire de la famille des sphingidés qui a le corps gros, les yeux grands et les ailes horizontales, longues et étroites, ornées de couleurs vives et variées."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013b7daa-58ae-47bc-81fe-d9d85c37a78f",
                                                "sense_id": "15335e9c-2522-3d93-8591-a4613d398b74",
                                                "text": "Ce sphinx a beaucoup de ressemblance avec le Fuciforme, mais il en diffère par les caractères suivans : la bande du milieu de l’abdomen est mélangée de noir et de verdâtre […] les premières ailes ne présentent pas de taches près du milieu de la côte, et la cellule de leur base n’est pas divisée par une nervure.\nOn trouve ce sphinx aux environs de Paris, dans les mois de mai et de juin."
                                            },
                                            {
                                                "example_id": "f6e0dbd1-c5e5-4c92-8479-0b5bd5c3a8d8",
                                                "sense_id": "15335e9c-2522-3d93-8591-a4613d398b74",
                                                "text": "Une fenêtre, au revers de la maison de ferme, est ouverte, éclairée : la ronde des moustiques et des sphinx tournoie autour d’une lampe Pigeon qui file."
                                            },
                                            {
                                                "example_id": "be50e3ff-f2e1-46ca-bfab-5496fd919a23",
                                                "sense_id": "15335e9c-2522-3d93-8591-a4613d398b74",
                                                "text": "Il y eut la capture des papillons, des sphinx à deux queues et aux grandes ailes blanches bordées de bleu, qui laissaient sur mes doigts une poudre d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e6bf70b-d030-3625-96d3-b332ecfa3db2",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "Meuble représentant le monstre du même nom dans les armoiries, dont la représentation varie entre le sphinx grec et l’égyptien (l’origine n’était jamais précisée) et aboutit souvent à un mélange des deux. La version égyptienne est généralement représentée sans ailes et couchée, parfois sur une tablette. La version grecque est plutôt représentée assise. Suivant les auteurs, des précisions sont ajoutées dans le blasonnement pour indiquer à quel type de sphinx on fait référence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ecfddbc-98b6-3c45-91c5-2e68bb408d1e",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "De sinople au sphinx ailé d’or, assis et contourné, qui est de la commune de Bessines-sur-Gartempe de la Haute-Vienne → voir illustration « armoiries avec un sphinx grec »"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b5cb1c7-8047-3c5a-9444-aabc0900eb15",
                                        "entry_id": "3b735dfd-3a58-3eb2-b643-b4c16670fc97",
                                        "glosses": [
                                            "D'azur au sphinx d'or surmonté d'une étoile du même, qui est de la famille Savalette → voir illustration « armoiries avec un sphinx égyptien »"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sphinx",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b00f7071-e3e0-319f-904e-462dc5ecdf19",
                                        "entry_id": "3aa4648a-171b-357d-be78-2540d8766d93",
                                        "glosses": [
                                            "Énigmatique ; incompréhensible."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b4fca3-9417-4a4a-9c20-0bc1a1a67a9c",
                                                "sense_id": "b00f7071-e3e0-319f-904e-462dc5ecdf19",
                                                "text": "Tous cherchaient l’ambition en moi, et à la fin me jugèrent un peu sphinx quant aux projets. Il n’y avait point d’ambition, ni de projet ; il n’y avait qu’un homme du peuple qui luttait pour son propre compte contre les tyrans de toute espèce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
