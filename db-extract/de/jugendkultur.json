                "senses": [
                    {
                        "sense_id": "8b96b419-52e5-396a-951c-2c839300af2e",
                        "entry_id": "4a30e3fd-3dab-368b-aa1e-d36d6323420f",
                        "glosses": [
                            "kulturelle Aktivitäten und Stile von Jugendlichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8592b81-4794-4372-9bb7-9dbae4610638",
                                "sense_id": "8b96b419-52e5-396a-951c-2c839300af2e",
                                "text": "„Daraus erklärten sich die Intoleranz der Nationalen Partei gegenüber dieser Jugendkultur und alberne Behauptungen, etwa Miniröcke seien auf kommunistischen Einfluss zurückzuführen.“"
                            },
                            {
                                "example_id": "417e4ba8-f040-4fe5-918e-34ee85da31c7",
                                "sense_id": "8b96b419-52e5-396a-951c-2c839300af2e",
                                "text": "„Jetzt schaffte er es nicht einmal mehr ansatzweise, die haarfeine Vielschichtigkeit der gerade angesagten Jugendkultur zu durchdringen, und das ganze Unterfangen erschien ihm albern und unbegreiflich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
