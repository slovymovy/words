    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "340f885d-4ae2-3f45-8f30-a0c06c7ccd2f",
                    "sense_definition": "Rendre propre en enlevant les saletés, les taches ou les poussières.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque samedi matin, nous <w>nettoyons</w> la cuisine de fond en comble."
                        },
                        {
                            "text": "Tu devrais <w>nettoyer</w> la table avant de servir le repas aux invités."
                        }
                    ],
                    "antonyms": [
                        "salir",
                        "tacher",
                        "souiller"
                    ],
                    "common_phrases": [
                        "nettoyer la maison",
                        "nettoyer le sol",
                        "nettoyer la table"
                    ]
                },
                {
                    "sense_id": "4c0b57d0-88dd-3805-a3f2-c372315b8e87",
                    "sense_definition": "Débarrasser un lieu de ce qui l'encombre ou des éléments indésirables.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier <w>nettoie</w> le terrain en arrachant toutes les mauvaises herbes."
                        },
                        {
                            "text": "Ils ont passé l'après-midi à <w>nettoyer</w> le grenier encombré de vieux meubles."
                        }
                    ],
                    "antonyms": [
                        "encombrer"
                    ],
                    "common_phrases": [
                        "nettoyer le terrain"
                    ]
                },
                {
                    "sense_id": "47a1e1af-81c9-3394-9e9b-94a971c99ece",
                    "sense_definition": "Éliminer toute présence ennemie ou tout foyer de résistance dans un secteur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les troupes ont reçu la mission de <w>nettoyer</w> le secteur avant la nuit."
                        },
                        {
                            "text": "Le bataillon <w>nettoya</w> la zone pour permettre l'avancée des convois médicaux."
                        }
                    ],
                    "common_phrases": [
                        "nettoyer le secteur",
                        "nettoyer la zone"
                    ]
                },
                {
                    "sense_id": "d9755a8b-eaa1-3e29-b84b-7d9dc887c2b9",
                    "sense_definition": "Prendre tout son argent à quelqu'un, en particulier au jeu ou par la ruse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce joueur de poker expérimenté a <w>nettoyé</w> tous ses rivaux à la table."
                        },
                        {
                            "text": "Il s'est fait complètement <w>nettoyer</w> au casino lors de sa dernière partie."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "1c5503f4-d0da-3a49-98a6-e13272a1e665",
                    "sense_definition": "Rendre plus pur, plus net et débarrasser des défauts d'exécution dans un dessin ou une œuvre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "propreté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste prend plusieurs heures pour <w>nettoyer</w> les contours de son illustration."
                        },
                        {
                            "text": "Avant de finaliser la gravure, elle <w>nettoie</w> les bavures visibles sur la plaque."
                        }
                    ],
                    "common_phrases": [
                        "nettoyer les contours"
                    ]
                }
            ]
        }
    ]
