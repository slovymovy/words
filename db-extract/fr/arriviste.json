                                "target_senses": [
                                    {
                                        "sense_id": "e0530bab-2b91-3067-9964-789ce6bc695d",
                                        "entry_id": "88e80522-ef71-3e24-b1a0-3b93208aa433",
                                        "glosses": [
                                            "One who tries to improve his or her social standing, especially by means of obsequious behaviour."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b375faeb-f433-4d5d-b766-e932632276ed",
                                                "sense_id": "e0530bab-2b91-3067-9964-789ce6bc695d",
                                                "text": "“Are you accusing me of social climbing!” she fumed, getting right in his face. “You are a social climber, my darling.” “They only call you a social climber if you're not good at it,” Lucy said, starting for the front door, checking her phone for what would be the last time as she exited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
