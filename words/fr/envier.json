{
    "word_family": [
        "envie",
        "enviable",
        "envieux",
        "envieusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cccaee0-5f1f-3762-a081-bfd473d69858",
                    "sense_definition": "Ressentir de la jalousie ou du dépit en voyant les avantages ou le bonheur d'autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne sert à rien d'<w>envier</w> la fortune des autres pour trouver son propre bonheur."
                        },
                        {
                            "text": "Ses collègues ont commencé à l'<w>envier</w> dès qu'elle a obtenu cette promotion méritée."
                        }
                    ],
                    "synonyms": [
                        "jalouser"
                    ],
                    "common_phrases": [
                        "envier le succès",
                        "envier le bonheur"
                    ]
                },
                {
                    "sense_id": "b5b7385f-3a4a-3eb1-ba21-3e41a8daef6d",
                    "sense_definition": "Désirer pour soi-même un avantage ou une qualité semblable à ce que possède un autre, sans animosité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite ville de province n'a rien à <w>envier</w> aux plus grandes métropoles régionales."
                        },
                        {
                            "text": "J'<w>envie</w> beaucoup ta capacité à garder ton calme dans les situations de crise."
                        }
                    ],
                    "common_phrases": [
                        "ne rien avoir à envier"
                    ]
                },
                {
                    "sense_id": "6598b13a-f5a5-3467-8ceb-042c0cea60cf",
                    "sense_definition": "Refuser ou disputer à quelqu'un un avantage, une distinction ou un droit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne m'<w>enviez</w> pas l'honneur de servir notre cause jusqu'au bout du combat."
                        },
                        {
                            "text": "Le souverain ne pouvait pas lui <w>envier</w> cette éclatante victoire remportée sur le champ de bataille."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage littéraire vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "7ceffde8-7e0b-3677-be13-a76e51b39396",
                    "sense_definition": "Augmenter la mise ou surenchérir dans certains jeux de cartes traditionnels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lieu de passer prudemment son tour, le joueur choisit d'<w>envier</w> sans la moindre hésitation."
                        },
                        {
                            "text": "Il tenta d'<w>envier</w> pour tenter d'impressionner tous les autres participants à la table."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme lié aux règles de jeux anciens"
                        }
                    ]
                }
            ]
        }
    ]
}