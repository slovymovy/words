                        "net erbuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "On the outside or excluded from the mentioned thing; replaces the combination of the preposition 'buiten' (outside) with a pronoun such as 'het' (it)."
                    },
                    "translations": {
                        "en": [
