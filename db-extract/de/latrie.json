                "senses": [
                    {
                        "sense_id": "739cd4de-475e-357b-9e0c-027152703d07",
                        "entry_id": "1fb46671-c13c-3d51-a25d-71b87010941a",
                        "glosses": [
                            "die Anbetung Gottes, bzw. der Dialog mit dem Göttlichen, also die Anbetung und die Verehrung, die im Gegensatz zu anderen Formen der Anbetung und Verehrung (Dulia und Hyperdulia) nur Gott allein zusteht."
                        ],
                        "tags": [
                            "katholische und orthodoxe Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "77ee5280-428d-4eb0-bc25-9e7ce05a3a16",
                                "sense_id": "739cd4de-475e-357b-9e0c-027152703d07",
                                "text": "In der Theologie versteht man unter Latrie (kirchenlateinisch latria) im Gegensatz zu anderen Formen religiöser Verehrung (Dulia, Hyperdulia), diejenige Verehrung, die ganz allein dem höchsten göttlichen Wesen zukommt. (siehe Augustinus Contra Faustum 20, 21 und De civitate Dei XII; Nicaen. II: D302)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
