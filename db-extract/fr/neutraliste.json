                                "target_senses": [
                                    {
                                        "sense_id": "a5c090b6-9ddc-387d-9df6-23921769b5a9",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Not taking sides in a conflict such as war; nonaligned."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25fedc51-1ff0-3d8e-b517-9d69b7176d18",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Favoring neither the supporting nor opposing viewpoint of a topic of debate; unbiased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63eaced7-d1a7-45ef-8056-f035324b362e",
                                                "sense_id": "25fedc51-1ff0-3d8e-b517-9d69b7176d18",
                                                "text": "I am neutral regarding the issue of gay marriage."
                                            },
                                            {
                                                "example_id": "629db9ac-527c-495c-b360-9fdaf8e7534e",
                                                "sense_id": "25fedc51-1ff0-3d8e-b517-9d69b7176d18",
                                                "text": "The heart can not possibly remain neutral, but constantly takes part one way or the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "373df5c1-99d9-355d-b143-719451ea180c",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Neither positive nor negative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2300f3a4-7328-35a2-b8f7-be6310e50781",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Not biased; viewing situations objectively in a way that is neither positive nor negative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8713aa51-df3d-4dbe-96d0-1fc58c27f68f",
                                                "sense_id": "2300f3a4-7328-35a2-b8f7-be6310e50781",
                                                "text": "a neutral person"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63632678-5b7f-3857-8d67-c6e7c7160a43",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Neither beneficial nor harmful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8586dce-cd78-4109-971f-f6f2fbcfde6e",
                                                "sense_id": "63632678-5b7f-3857-8d67-c6e7c7160a43",
                                                "text": "Some things good, and some things ill, do seem,\n And neutral some, in her fantastic eye."
                                            },
                                            {
                                                "example_id": "6e066613-cec7-49e6-9825-0d948fb9eed5",
                                                "sense_id": "63632678-5b7f-3857-8d67-c6e7c7160a43",
                                                "text": "Plant breeding is always a numbers game.[…] The wild species we use are rich in genetic variation,[…] In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36309877-9822-305d-a8c7-3e30aa4511d2",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Having no sex; neuter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c10397b-c69a-37c2-9e13-d3cf80cd5d53",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Having no obvious colour; gray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ab9ab04-4e3d-3b7a-8d28-cf689ab4a0b3",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Neither positive nor negative; possessing no charge or equivalent positive and negative charge such that there is no imbalance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4a1fbda-4788-3437-b278-e4dcdfbaebe3",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Having a pH of or near 7, neither acidic nor alkaline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "129dea4f-0bd2-3038-80a7-0021f9f98284",
                                        "entry_id": "479da7d8-ed07-33ab-8a06-02a288d6680a",
                                        "glosses": [
                                            "Of an alcoholic drink, having been fermented and distilled but with no additives."
                                        ],
