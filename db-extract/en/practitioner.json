                    {
                        "translation_id": "d3a2747e-b962-4aaf-8a36-c011758f2605",
                        "source_entry_id": "00a953ee-439b-318b-8f9e-fc5c0254d09a",
                        "source_sense_description": "person who practices a profession or art",
                        "target_lang_word": "Fachmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                        "entry_id": "9d788063-43a5-3a05-9a0d-254a0a23c96f",
                                        "glosses": [
                                            "(männliche^☆) Person, die in einem bestimmten Fach ausgebildet ist und entsprechende Kenntnisse hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af10565-c72b-4745-984f-aef47575dc6b",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "Das kann ich nicht selbst reparieren, da muss ein Fachmann her."
                                            },
                                            {
                                                "example_id": "81909ead-14c9-4d19-861f-3bbf6fc8f283",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Entdeckung 2003 elektrisierte nicht nur Fachleute.“"
                                            },
                                            {
                                                "example_id": "f4a4f31d-0e57-4fe3-ad97-546310489286",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Gesellschaft braucht weder Sprachgesetze noch eine Sprachpolizei, aber sie hat Anspruch auf Rat von Fachleuten.“"
                                            },
                                            {
                                                "example_id": "fff7e5b1-81e9-4a9f-993a-ea014a04a7b0",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Doch was bei den beiden wichtigsten Erzählern der frühen nachrömischen Geschichte Britanniens übereinstimmend nach Völkermord klingt, sehen heutige Fachleute weniger eindeutig.“"
                                            },
                                            {
                                                "example_id": "33c3ed77-3a24-45be-95bd-e072ad3040a4",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Israelis trafen notgedrungen mit den angereisten deutschen Fachleuten zusammen, die sie mit KFZ-Teilen, Lokomotiven und Schiffen vertraut machen sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
