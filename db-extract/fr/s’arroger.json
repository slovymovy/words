                ],
                "senses": [
                    {
                        "sense_id": "37f0e95f-d6f2-33ab-99e9-00a54cd65dd6",
                        "entry_id": "c38cc49b-959e-37b5-83e0-25b9f1da2871",
                        "glosses": [
                            "S’attribuer mal à propos quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0eea605-f229-4253-8430-489dec903f67",
                                "sense_id": "37f0e95f-d6f2-33ab-99e9-00a54cd65dd6",
                                "text": "Il s’arroge un pouvoir, une qualité, une autorité qu’il n’a pas."
                            },
                            {
                                "example_id": "98f047d7-82d9-4d0f-8985-064d1c668554",
                                "sense_id": "37f0e95f-d6f2-33ab-99e9-00a54cd65dd6",
                                "text": "Voilà tout le résultat de votre belle invention d’avoir assemblé les bourgeois, les vilains et autre manants pour leur faire approuver les décisions du roi. À présent le peuple s’arroge le droit de juger."
                            },
                            {
                                "example_id": "daa7d857-184d-4969-a270-928471f36fa2",
                                "sense_id": "37f0e95f-d6f2-33ab-99e9-00a54cd65dd6",
                                "text": "— Bon sang, je suis totalement impuissant. Des gens décident de mon sort, s’arrogent le droit de gouverner ma vie, de voler mon amour, de tuer mon enfant, et je ne peux rien faire…"
                            }
                        ]
                    }
                ],
