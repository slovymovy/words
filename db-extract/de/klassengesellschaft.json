                "senses": [
                    {
                        "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                        "entry_id": "33d85eb6-24ad-3d49-bb25-cf1283d0253d",
                        "glosses": [
                            "Gesellschaft, die aus mindestens zwei unterscheidbaren Schichten (Klassen) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4302f4-8563-46ce-addf-0fdcae459a57",
                                "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                                "text": "„Diese Linie trennt nicht nur zwei Badeterritorien, sie etabliert auch die Klassengesellschaft am Strand.“"
                            },
                            {
                                "example_id": "0f4f8e3b-092b-445e-a991-33b847e47c69",
                                "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                                "text": "Noch hat niemand ein Unterrichtskonzept erfunden, das in der Lage wäre, die Klassengesellschaft aus den Angeln zu heben. Aber Chancengleichheit in der Bildung, die sollte möglich sein in Deutschland."
                            },
                            {
                                "example_id": "f5fe1b97-be95-4104-8a64-73a884a8567f",
                                "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                                "text": "[Finnland:] Bodenreformen versorgten landlose Bauern mit Ackerflächen, was […] zur Abschaffung der Klassengesellschaft beitrug."
                            },
                            {
                                "example_id": "f0f2cf6c-b104-41ff-99b6-ad94d78559de",
                                "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                                "text": "Heute ist es [in Russland] um Bürgerrechte wie die Meinungsfreiheit schlecht bestellt, und die Klassengesellschaft hat sich verfestigt."
                            },
                            {
                                "example_id": "173bbd85-b40e-4fb4-881c-b1c006d39916",
                                "sense_id": "f41b094d-a7d8-3c0e-9c19-56e5b578fa17",
                                "text": "[Martin Luther] King wandte sich […] gegen eine Klassengesellschaft mit einer tiefen Kluft zwischen Arm und Reich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
