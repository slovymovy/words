                                "example_id": "c447f619-080f-4b62-a4c6-69c84ed3ca89",
                                "sense_id": "f62c41b7-a518-3ada-9239-51d9611df226",
                                "text": "philosophical duality"
                            },
                            {
                                "example_id": "10875ad7-6fdc-4b9e-bb70-e9c280eb6506",
                                "sense_id": "f62c41b7-a518-3ada-9239-51d9611df226",
                                "text": "The novel explored the duality of good and evil."
                            },
                            {
                                "example_id": "14d05b6d-badb-4a79-8055-89701ccf6ac1",
                                "sense_id": "f62c41b7-a518-3ada-9239-51d9611df226",
