        "nl-extract.jsonl": [
            {
                "entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                "word": "tiental",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "06c70806-5c70-4d0b-b182-745e86bae026",
                        "entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                        "tags": [
                            "plural"
                        ],
                        "form": "tientallen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                        "entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                        "glosses": [
                            "met het aantal van tien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41945eb6-9251-45d4-9203-50eb91416532",
                                "sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                                "text": "Het vertrek werd onmiddellijk gestopt en alle passagiers werden uit het vliegtuig gehaald. Het vliegtuig verliet Manchester uiteindelijk pas zaterdagochtend om 05.00 uur met enkele tientallen minder passagiers aan boord."
                            },
                            {
                                "example_id": "e4e69da3-fbbc-452b-9661-8e02b7d29655",
                                "sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                                "text": "In het boek staan tientallen foto's. \"We hebben het hele paleis geanalyseerd en alle ruimtes in beeld gebracht met de vraag: waar zitten scheuren en beschadigingen?\", zegt Verfürden tegen RTV Utrecht. \"Op basis daarvan maakten we het restauratieplan.\""
                            },
                            {
                                "example_id": "4f428d40-b7ce-4804-8f19-de76f5ba6a96",
                                "sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                                "text": "Johnson treedt ook per direct af als partijleider van de Conseratieve Partij. Vorige maand overleefde hij nog een vertrouwensstemming, toen een meerderheid van zijn partijgenoten vond dat hij kon aanblijven. Nu tientallen leden van zijn kabinet zijn opgestapt, treedt Johnson alsnog terug."
                            }
                        ]
                    },
                    {
                        "sense_id": "469f360c-adc3-37ed-9178-205c01aa0e9e",
                        "entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                        "glosses": [
                            "ongeveer tien"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b173a68-da1f-4785-aaf4-e2a01ba164a1",
                        "source_entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                        "source_sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                        "source_sense_description": "met het aantal van tien",
                        "target_lang_word": "dizaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dizaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae7de15-9dd5-3163-abc4-37398ef3704f",
                                        "entry_id": "93fe41b9-fdfc-332d-bba3-7a9d6e0285f6",
                                        "glosses": [
                                            "Groupe de dix unités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b04e4c1f-fc9a-4601-8cc1-cd20f560903b",
                                                "sense_id": "2ae7de15-9dd5-3163-abc4-37398ef3704f",
                                                "text": "Une dizaine de mille."
                                            },
                                            {
                                                "example_id": "9722f212-99a3-4991-8a55-7b8913932800",
                                                "sense_id": "2ae7de15-9dd5-3163-abc4-37398ef3704f",
                                                "text": "Le chapelet catholique comporte cinq dizaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8331834d-60fa-3220-bd56-cca01ae3e99e",
                                        "entry_id": "93fe41b9-fdfc-332d-bba3-7a9d6e0285f6",
                                        "glosses": [
                                            "La position du chiffre des multiples de dix dans l'écriture d'un nombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9561ccfa-44d7-482b-9861-545865e8902e",
                                                "sense_id": "8331834d-60fa-3220-bd56-cca01ae3e99e",
                                                "text": "Le chiffre des dizaines dans 584 est le huit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                        "entry_id": "93fe41b9-fdfc-332d-bba3-7a9d6e0285f6",
                                        "glosses": [
                                            "Environ dix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ecaf46-75d5-4791-9efc-e40f96e59a45",
                                                "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                                "text": "Le navire ayant été dépallé dans le Sud par un courant polaire, le cap Brewster, promontoire septentrional du Scoresby Sund, était à une dizaine de milles au N.-W."
                                            },
                                            {
                                                "example_id": "5a07f765-ada8-4e09-81e9-4a97eb496649",
                                                "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                                "text": "Un « muchacho » d’une dizaine d’années, à la tignasse embroussaillée, essaya de me démontrer les inconvénients de voyager seul, […]."
                                            },
                                            {
                                                "example_id": "da3b42b9-5178-4b96-9b72-12ec17483d17",
                                                "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                                "text": "Mais, en regardant la liste des invités, on constate que, sur la cinquantaine de streameurs présents, le nombre de femmes ne dépasse pas la dizaine."
                                            },
                                            {
                                                "example_id": "57b451ce-8edc-4071-b592-96fbe832d217",
                                                "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                                "text": "Leur but est de démontrer l’homologie de la flore et de la faune dans trois stations édaphiquement et climatiquement proches, distantes d'une dizaine de kilomètres."
                                            },
                                            {
                                                "example_id": "2f9159df-0ec9-4e64-8ac8-14db5cb944d0",
                                                "sense_id": "fffdf24a-0a2b-346e-bcc1-652bde282adc",
                                                "text": "La lentille de mon ordiphone braqué sur elle peine à suivre ses exploits lumineux. J'envoie un petit film à mon fils, avec une bonne dizaine d’emojis en prime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d90e39a-b31b-4a2f-ac58-18269e1051d6",
                        "source_entry_id": "80f0d53e-c629-32bc-b952-c77c2ba3b52c",
                        "source_sense_id": "9593b6dd-31fe-33ee-89d3-d5a0e31e856b",
                        "source_sense_description": "met het aantal van tien",
                        "target_lang_word": "десяток",
