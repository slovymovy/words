                                        "sense_id": "c1979751-3fbd-3ed6-bac6-b4b380bc9b00",
                                        "entry_id": "0d3f9f81-c655-3abc-8596-e5ff322521df",
                                        "glosses": [
                                            "Like a normal person."
                                        ],
                                        "tags": [
                                            "derogatory",
