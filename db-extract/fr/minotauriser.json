                ],
                "senses": [
                    {
                        "sense_id": "4361c1d3-614f-3569-9744-df846de0c905",
                        "entry_id": "c4c324ac-d55c-3586-813b-2a4aadfda4c6",
                        "glosses": [
                            "Cocufier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcbdd0f-4e2b-40c7-8b50-ba1e9837f902",
                                "sense_id": "4361c1d3-614f-3569-9744-df846de0c905",
                                "text": "En additionnant les dépenses de son procès et de son séjour, il se promettait à son retour d’empoisonner le préfet ou de le minotauriser !"
                            },
                            {
                                "example_id": "4a7a1b76-c60b-4c04-a930-b9340658a7a7",
                                "sense_id": "4361c1d3-614f-3569-9744-df846de0c905",
                                "text": "Quelques maris, dans ces sortes de circonstances, éclatent devant tout le monde, ils se font minotauriser six semaines après ;"
                            },
                            {
                                "example_id": "4de299ac-8a73-45f1-9cba-951664627f04",
                                "sense_id": "4361c1d3-614f-3569-9744-df846de0c905",
                                "text": "Quand une femme est inconséquente, le mari serait, selon moi, minotaurisé."
                            }
                        ]
                    }
                ],
