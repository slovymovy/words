                        "examples": [
                            {
                                "example_id": "12e02b03-7da4-4a52-90ab-5a2204b91523",
                                "sense_id": "1416440e-8681-389b-8729-40f875f2fbf5",
                                "text": "Morales werd in 2005 gekozen als president van het land. De linkse cocaboer was het eerste inheemse staatshoofd van Bolivia. In 2014 werd hij met 60 procent van de stemmen herkozen."
                            },
                            {
                                "example_id": "7afa7dc5-faea-4560-ad92-a8a13d445948",
                                "sense_id": "1416440e-8681-389b-8729-40f875f2fbf5",
                                "text": "Morales, een voormalige cocaboer, streed al lange tijd tegen die Amerikaanse inmenging in Bolivia. Toen hij aantrad als president zocht hij toenadering tot Brazilië om het probleem gezamenlijk aan te pakken."
                            }
                        ]
                    }
