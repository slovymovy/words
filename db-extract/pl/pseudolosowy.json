                "senses": [
                    {
                        "sense_id": "586b81b7-9a1f-377a-a593-49863237edc5",
                        "entry_id": "d42a5e90-e914-32b0-81df-2bde0a08a0e0",
                        "glosses": [
                            "będący lub związany z danymi generowanymi deterministycznie, jednak z pozoru nieodróżnialnymi od prawdziwie losowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8194b8b6-038a-4b5e-a445-dda57ba86822",
                                "sense_id": "586b81b7-9a1f-377a-a593-49863237edc5",
                                "text": "Prawie wszystkie stosowane generatory tworzą liczby pseudolosowe na podstawie funkcji rekurencyjnych wykorzystujących operator modulo."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdfa9310-f110-4b9d-9596-e5bce1c91bdd",
