                            {
                                "example_id": "a05d1646-cf4a-457c-8e43-b353ef7f8a9e",
                                "sense_id": "3ef1956e-ea0f-3949-9aa3-aefb8d188f05",
                                "text": "Morgen werden die neuen Aktenschränke für unser Büro geliefert."
                            },
                            {
                                "example_id": "60cfc1b8-24d7-48d2-8d5c-67499ac04dc2",
                                "sense_id": "3ef1956e-ea0f-3949-9aa3-aefb8d188f05",
                                "text": "„Als Henni geendet hatte, stand sie auf, suchte in einem Aktenschrank und setzte sich mit einem blassgrünen Hefter zurück an den Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
