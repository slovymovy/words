                                        "glosses": [
                                            "Excess of sexual behaviour or desire in women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2979ef6d-c37f-4111-8be8-60d06782b6cf",
                                                "sense_id": "7da3aa5c-68be-3308-93ed-050e40b8fa49",
                                                "text": "Camphor, however, has been used to counteract the conditions arising from nymphomania."
                                            }
