                "senses": [
                    {
                        "sense_id": "d3605d28-36eb-3561-a4bd-366732ecd4b1",
                        "entry_id": "8bebcfa0-3d7a-393a-b0b2-e37679f9afa2",
                        "glosses": [
                            "zinspelen op wat komen gaat, vooruitlopen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "9bbabd52-9f30-4345-84fc-7a8bc8860b09",
                                "sense_id": "d3605d28-36eb-3561-a4bd-366732ecd4b1",
                                "text": "Onze fractie zal er nu niet op preluderen, wij vertrouwen erop dat wij in het voorjaar voldoende tijd zullen krijgen om er met de bewindslieden over te debatteren"
                            }
                        ]
                    },
                    {
                        "sense_id": "fabfce10-39f6-3774-8e54-652fb05d5640",
                        "entry_id": "8bebcfa0-3d7a-393a-b0b2-e37679f9afa2",
                        "glosses": [
                            "als inleiding (improviserend) spelen, inleiden, een begin maken"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb8032cc-698c-46b3-91d0-46019ee3f1ad",
                        "source_entry_id": "8bebcfa0-3d7a-393a-b0b2-e37679f9afa2",
                        "target_lang_word": "préluder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préluder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b64d3b5-e16e-3def-ab00-e8887e312d77",
                                        "entry_id": "61f80676-f8c7-36a1-a48a-103af84e9772",
                                        "glosses": [
                                            "Se préparer à faire une chose en faisant une autre chose moins difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a77ca9-ea1b-4bba-ae69-2088c9d4bcc6",
                                                "sense_id": "5b64d3b5-e16e-3def-ab00-e8887e312d77",
                                                "text": "Va la trouver : […] qu’elle subisse comme moi les tortures qui préludent à l’enfer !"
                                            },
                                            {
                                                "example_id": "a4933302-5ed9-4e57-814c-047ed12da2ad",
                                                "sense_id": "5b64d3b5-e16e-3def-ab00-e8887e312d77",
                                                "text": "[…] dans les profondeurs mystérieuses des chaparals, les bêtes fauves, aux approches du soir, préludaient par de sourds rugissements à leurs lugubres concerts."
                                            },
                                            {
                                                "example_id": "fe22f632-5351-4835-8028-e01a01e1fdc8",
                                                "sense_id": "5b64d3b5-e16e-3def-ab00-e8887e312d77",
                                                "text": "Les mots : « Ils ont tiré » préludent à presque tous les assassinats, ou servent de conclusion à presque tous les massacres."
                                            },
                                            {
                                                "example_id": "86e89c69-3c3a-4d89-84d8-2d86256d323a",
                                                "sense_id": "5b64d3b5-e16e-3def-ab00-e8887e312d77",
                                                "text": "Le XIVᵉ siècle […] s’achève, ainsi qu’il a préludé, se tord dans des convulsions religieuses atroces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ed44455-1896-3e5b-8003-84f934c25cce",
                                        "entry_id": "61f80676-f8c7-36a1-a48a-103af84e9772",
                                        "glosses": [
                                            "Jouer sur un instrument pour se mettre dans le ton ou pour juger si l’instrument est accordé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
