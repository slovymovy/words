{
    "word_family": [
        "onliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b98f46a6-a750-3ec9-a099-800ba9a8a5b3",
                    "sense_definition": "Alone in a category.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "singular",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is the <w>only</w> doctor for miles in this rural area.",
                            "target_lang_translations": {
                                "ru": "Он <w>единственный</w> врач на многие мили в этой сельской местности."
                            }
                        },
                        {
                            "text": "That was the <w>only</w> time I ever visited Turkey.",
                            "target_lang_translations": {
                                "ru": "Это был <w>единственный</w> раз, когда я посетил Турцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "sole",
                        "lone"
                    ],
                    "common_phrases": [
                        "the only time",
                        "the only way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единственный в своей категории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный",
                                "target_lang_sense_clarification": "один в своем роде"
                            },
                            {
                                "target_lang_word": "единый",
                                "target_lang_sense_clarification": "единственно возможный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "303eae45-0f46-33cc-8ce8-a9efc73ad802",
                    "sense_definition": "Without siblings or without a sibling of the same gender.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is their <w>only</w> son and they spoil him quite a bit.",
                            "target_lang_translations": {
                                "ru": "Он их <w>единственный</w> сын, и они его изрядно балуют."
                            }
                        },
                        {
                            "text": "Being an <w>only</w> child can sometimes be lonely without brothers or sisters.",
                            "target_lang_translations": {
                                "ru": "Быть <w>единственным</w> ребенком в семье иногда бывает одиноко без братьев или сестер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "only child",
                        "only son"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без братьев и сестер или без сиблинга того же пола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный",
                                "target_lang_sense_clarification": "о ребенке в семье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6514136-6ae9-3b5d-8e20-88a7af310212",
                    "sense_definition": "Singularly superior; the best.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many fans, baseball is the <w>only</w> game worth watching.",
                            "target_lang_translations": {
                                "ru": "Для многих болельщиков бейсбол — <w>единственная</w> игра, которую стоит смотреть."
                            }
                        },
                        {
                            "text": "She frequently asserted that America was the <w>only</w> place to live.",
                            "target_lang_translations": {
                                "ru": "Она часто утверждала, что Америка — <w>единственное</w> место, где можно жить."
                            }
                        }
                    ],
                    "synonyms": [
                        "peerless",
                        "unequaled",
                        "nonpareil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно превосходный; лучший."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный",
                                "target_lang_sense_clarification": "лучший из всех"
                            },
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "не имеющий равных"
                            },
                            {
                                "target_lang_word": "наилучший",
                                "target_lang_sense_clarification": "самый подходящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87bab3a1-8555-3b92-a326-0eaa3a0267f8",
                    "sense_definition": "Mere.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>only</w> name of such a thing is enough to make men uncomfortable.",
                            "target_lang_translations": {
                                "ru": "<w>Одно</w> только название такой вещи заставляет людей чувствовать себя неловко."
                            }
                        },
                        {
                            "text": "He was terrified by the <w>only</w> thought of having to speak in public.",
                            "target_lang_translations": {
                                "ru": "Он был в ужасе от <w>одной</w> только мысли о том, что ему придется выступать на публике."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Всего лишь; простой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "один лишь",
                                "target_lang_sense_clarification": "только один"
                            },
                            {
                                "target_lang_word": "один только",
                                "target_lang_sense_clarification": "просто мысль или упоминание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ded21dbe-a947-3a0f-966f-ff8715a53909",
                    "sense_definition": "Without others or anything further; exclusively.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "exclusivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat sat <w>only</w> on the mat and kept off the sofa.",
                            "target_lang_translations": {
                                "ru": "Кот сидел <w>только</w> на коврике и не запрыгивал на диван."
                            }
                        },
                        {
                            "text": "This entrance is for staff <w>only</w> and is closed to the public.",
                            "target_lang_translations": {
                                "ru": "Этот вход <w>только</w> для персонала и закрыт для посетителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "members only",
                        "staff only"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без других или чего-либо еще; исключительно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "исключительно"
                            },
                            {
                                "target_lang_word": "лишь",
                                "target_lang_sense_clarification": "ограничение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2d58087-eabc-37a7-91dc-efc3f32f0452",
                    "sense_definition": "No more than; just.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>only</w> have five dollars in my pocket right now.",
                            "target_lang_translations": {
                                "ru": "У меня в кармане сейчас <w>всего</w> пять долларов."
                            }
                        },
                        {
                            "text": "It will <w>only</w> take a minute to finish this task.",
                            "target_lang_translations": {
                                "ru": "Завершение этой задачи займет <w>всего</w> минуту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "only a few",
                        "only a little"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не более чем; просто."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "не больше чем"
                            },
                            {
                                "target_lang_word": "всего",
                                "target_lang_sense_clarification": "о количестве или времени"
                            },
                            {
                                "target_lang_word": "лишь",
                                "target_lang_sense_clarification": "всего лишь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d840c9be-733a-3dbd-bdf6-24ee660493e5",
                    "sense_definition": "As recently as.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left <w>only</w> moments ago so you might still catch him.",
                            "target_lang_translations": {
                                "ru": "Он ушел <w>только</w> что, так что вы еще можете его догнать."
                            }
                        },
                        {
                            "text": "I saw her <w>only</w> yesterday at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Я видел ее <w>только</w> вчера в продуктовом магазине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "only yesterday",
                        "only just"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совсем недавно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "недавно"
                            },
                            {
                                "target_lang_word": "только что",
                                "target_lang_sense_clarification": "в этот самый момент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4a2a77c-f77f-39b2-9a9a-e9a3be27b8cd",
                    "sense_definition": "Emphasizing something that is just or necessary.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>only</w> fair to let him have a turn with the toy.",
                            "target_lang_translations": {
                                "ru": "Будет <w>только</w> справедливо дать и ему поиграть с игрушкой."
                            }
                        },
                        {
                            "text": "It is <w>only</w> natural to feel nervous before a big exam.",
                            "target_lang_translations": {
                                "ru": "Чувствовать нервозность перед важным экзаменом — это <w>вполне</w> естественно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "only fair",
                        "only natural"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подчеркивание того, что является справедливым или необходимым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "для усиления"
                            },
                            {
                                "target_lang_word": "вполне",
                                "target_lang_sense_clarification": "совершенно естественно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09941bec-3b21-33aa-88c7-8e4175deebba",
                    "sense_definition": "Introduces a disappointing or surprising outcome that renders futile something previously mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They rallied from a three-goal deficit <w>only</w> to lose in the final minutes.",
                            "target_lang_translations": {
                                "ru": "Они отыгрались после дефицита в три гола, <w>но только</w> для того, чтобы проиграть на последних минутах."
                            }
                        },
                        {
                            "text": "I spent years studying <w>only</w> to learn there was no job for me.",
                            "target_lang_translations": {
                                "ru": "Я потратил годы на учебу, <w>чтобы в итоге</w> узнать, что для меня нет работы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "only to find",
                        "only to lose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводит разочаровывающий или неожиданный результат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "но только",
                                "target_lang_sense_clarification": "с последующим разочарованием"
                            },
                            {
                                "target_lang_word": "чтобы в итоге",
                                "target_lang_sense_clarification": "о результате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda4757e-fc01-3f8e-845e-c1dc291e2fc2",
                    "sense_definition": "Used to express surprise or consternation at an action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>only</w> gone and run off with the milkman!",
                            "target_lang_translations": {
                                "ru": "Она <w>взяла</w> и сбежала с молочником!"
                            }
                        },
                        {
                            "text": "He was <w>only</w> using the same vehicle for catching rats that he used for burgers!",
                            "target_lang_translations": {
                                "ru": "Он <w>всего лишь</w> использовал ту же машину для ловли крыс, которую использовал для перевозки бургеров!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for dramatic effect in storytelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения удивления или негодования по поводу действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взял и",
                                "target_lang_sense_clarification": "о неожиданном действии"
                            },
                            {
                                "target_lang_word": "только и",
                                "target_lang_sense_clarification": "для выражения возмущения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac385ee6-c139-329b-8da6-ac102226a1c5",
                    "sense_definition": "Above all others; particularly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was his most <w>only</w> elected mistress in all the land.",
                            "target_lang_translations": {
                                "ru": "Она была его самой <w>единственной</w> избранной госпожой во всей стране."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превыше всех остальных; особенно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный",
                                "target_lang_sense_clarification": "избранный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b2efb68c-4bb4-3553-8c37-d9ef69cf756e",
                    "sense_definition": "But, except; but in fact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would enjoy running, <w>only</w> I have this broken leg.",
                            "target_lang_translations": {
                                "ru": "Я бы с удовольствием побегал, <w>только</w> вот у меня сломана нога."
                            }
                        },
                        {
                            "text": "You look just like your brother, <w>only</w> a bit shorter.",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь точь-в-точь как твой брат, <w>только</w> немного ниже ростом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Но, за исключением; но на самом деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "в значении 'но'"
                            },
                            {
                                "target_lang_word": "но",
                                "target_lang_sense_clarification": "противопоставление"
                            },
                            {
                                "target_lang_word": "только вот",
                                "target_lang_sense_clarification": "однако"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f0f58d-224e-3d33-9c45-bff466f70681",
                    "sense_definition": "Under the condition that; but.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are welcome to borrow my bicycle, <w>only</w> please take care of it.",
                            "target_lang_translations": {
                                "ru": "Можешь одолжить мой велосипед, <w>только</w>, пожалуйста, береги его."
                            }
                        },
                        {
                            "text": "I will help you with the project, <w>only</w> you must do your share.",
                            "target_lang_translations": {
                                "ru": "Я помогу тебе с проектом, <w>но</w> ты должен выполнить свою часть работы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "При условии, что; но."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "при условии"
                            },
                            {
                                "target_lang_word": "но",
                                "target_lang_sense_clarification": "однако"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5d254f2-0b2a-3a5c-8a9b-8626279a694c",
                    "sense_definition": "An <w>only</w> child.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sometimes, secondborns marry <w>onlies</w> and the conflicts are quite similar.",
                            "target_lang_translations": {
                                "ru": "Иногда вторые дети женятся на <w>единственных детях</w>, и конфликты в таких семьях очень похожи."
                            }
                        },
                        {
                            "text": "Research found that <w>onlies</w> showed greater flexibility and creativity than those with siblings.",
                            "target_lang_translations": {
                                "ru": "Исследование показало, что <w>единственные дети</w> проявляют большую гибкость и креативность, чем те, у кого есть братья и сестры."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единственный ребенок в семье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единственный ребенок",
                                "target_lang_sense_clarification": "в семье"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "58db0629-9558-3e50-8ab4-ed0c99719ca7",
                    "sense_definition": "Placed at the end of a sentence to emphasize that something is trivial, small, or undemanding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am just the assistant <w>only</w>, so I cannot make that decision.",
                            "target_lang_translations": {
                                "ru": "Я всего лишь ассистент <w>и всё</w>, поэтому я не могу принять это решение."
                            }
                        },
                        {
                            "text": "You just need to replace the filter <w>only</w> to fix the machine.",
                            "target_lang_translations": {
                                "ru": "Вам просто нужно заменить фильтр, <w>и всё</w>, чтобы починить машину."
                            }
                        }
                    ],
                    "synonyms": [
                        "that's all"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in some varieties of English like Singlish or Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставится в конце предложения, чтобы подчеркнуть незначительность или простоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и всё",
                                "target_lang_sense_clarification": "больше ничего"
                            },
                            {
                                "target_lang_word": "всего лишь",
                                "target_lang_sense_clarification": "подчеркивание простоты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}