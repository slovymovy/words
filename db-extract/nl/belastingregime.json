                        "examples": [
                            {
                                "example_id": "211b69e8-8dc9-4935-8b11-fb0914f8b19b",
                                "sense_id": "fae49b0d-0566-37ca-8a8c-808c06f4dd37",
                                "text": "Het belastingregime is van grote invloed op cultureel ondernemerschap en op de geefbereidheid van mensen. De Raad bepleit dan ook een consistent fiscaal pakket van maatregelen dat de overgang naar een cultuursector die minder afhankelijk is van overheidssubsidie mogelijk maakt."
                            },
                            {
                                "example_id": "5e108587-6527-45a1-a106-c88f32d31b57",
                                "sense_id": "fae49b0d-0566-37ca-8a8c-808c06f4dd37",
                                "text": "Het fonds, dat onder een gunstig belastingregime valt, is bedoeld voor een aantal zeer katholieke neefjes en nichtjes. Fabiola heeft zelf geen kinderen."
                            },
                            {
                                "example_id": "25c531a6-7c46-4db9-9d99-32d1a0e62e67",
                                "sense_id": "fae49b0d-0566-37ca-8a8c-808c06f4dd37",
                                "text": "Ook de bedrijven van internationale sterren als The Rolling Stones en U2 maken gebruik van het gunstige belastingregime in Nederland."
                            }
                        ]
                    }
