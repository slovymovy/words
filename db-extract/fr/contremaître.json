                                    },
                                    {
                                        "sense_id": "a5154259-43ab-38b2-bc89-f0e7bfa04156",
                                        "entry_id": "228cc12e-a5fe-3fad-bbba-995cd418f0e0",
                                        "glosses": [
                                            "A slave assistant to the white overseer who managed field hands."
