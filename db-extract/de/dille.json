                ],
                "senses": [
                    {
                        "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                        "entry_id": "3d5b1779-a66d-30d6-ac61-e63a72c70f10",
                        "glosses": [
                            "Dill"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd4562b-c0f1-41b4-80d3-917a15752e51",
                                "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                                "text": "Tust du noch die Dille an den Gurkensalat?"
                            },
                            {
                                "example_id": "433c6508-d1bd-4d33-a8a1-f8b4c5ccaebc",
                                "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                                "text": "„Denn wo Dille, da ein Wille.“"
                            },
                            {
                                "example_id": "6c67b4f5-46fd-4919-bf10-7f276e943821",
                                "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                                "text": "„Die Dille fein hacken.“"
                            },
                            {
                                "example_id": "c416889a-73fa-4100-96a2-ed0854ecab5c",
                                "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                                "text": "„Die Dille ist ein vielseitiges Kraut, das im Geschmack an Anis und Kümmel erinnert.“"
                            },
                            {
                                "example_id": "d359d7bc-b5e3-4eb1-a8df-27d8b0b90466",
                                "sense_id": "eedab6b0-3390-33b5-9ce7-30c041dc9b2b",
                                "text": "„Mit Curcuma oder Dille, Sesam, Kreuzkümmel und Salz abschmecken und sofort servieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
