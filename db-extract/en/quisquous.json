                        "glosses": [
                            "Hard to deal with; dubious; of people: having a character difficult to assess."
                        ],
                        "tags": [
                            "Scotland",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6f2cf16b-2b5d-4452-97c3-cbe5b271881d",
                                "sense_id": "d468d8ba-46ca-3444-bb45-fd584aa3258a",
                                "text": "Besides, the truths delivered by ministers in the fields upon quisquous subjects, with no small caution by some, and pretty safely, were heard and taken up by the hearers, according to their humours and opinions, many times far different from, and altogether without the cautions given by the preacher, which either could not, or were not understood by them."
                            }
                        ]
                    }
