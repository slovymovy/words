                "senses": [
                    {
                        "sense_id": "8f4b1cb0-74b9-35cd-9990-09cfe99e5b6e",
                        "entry_id": "ebd2c6be-5ce2-37ee-9b32-871c94256a2d",
                        "glosses": [
                            "Utiliser en tant que bouc émissaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd211d49-6c05-4791-ab67-662d9f196a2d",
                                "sense_id": "8f4b1cb0-74b9-35cd-9990-09cfe99e5b6e",
                                "text": "Au lieu de «bouc-émissariser» la famille en la rendant responsable des problèmes et en l'accablant d'exigences, la thérapeute a pu utiliser dans ce cas les ressources du kibboutz pour résoudre les problèmes et soutenir le fonctionnement de la famille."
                            },
                            {
                                "example_id": "bd41064e-cff8-42a9-aff1-5822580a6cd4",
                                "sense_id": "8f4b1cb0-74b9-35cd-9990-09cfe99e5b6e",
                                "text": "La tentation est donc grande, aujourd'hui, de bouc-émissariser Floyd Landis."
                            },
                            {
                                "example_id": "800ae508-da84-4f8a-a4cc-339a1846d3c5",
                                "sense_id": "8f4b1cb0-74b9-35cd-9990-09cfe99e5b6e",
                                "text": "Alors, \"bouc-émissariser\" le \"zoreille\" est inepte."
                            }
                        ]
                    }
