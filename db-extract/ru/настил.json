                                                "sense_id": "6b81885b-47f8-3c7e-b24a-49f8d0e68e1c",
                                                "text": "Planches-tu ? (Plaisantes-tu ?)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e0424cc-05eb-31b2-ba62-7c5daff0ba48",
