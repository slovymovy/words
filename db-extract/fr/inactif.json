                                "target_senses": [
                                    {
                                        "sense_id": "9f3ac1db-ae1a-310f-b94b-532beef693d1",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
                                            "Not active, temporarily or permanently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16ce565-5a78-49a3-a218-bb651384fe12",
                                                "sense_id": "9f3ac1db-ae1a-310f-b94b-532beef693d1",
                                                "text": "The volcano is inactive, but is only dormant."
                                            },
                                            {
                                                "example_id": "c84eef93-1ae6-43b2-97c3-d55f8bd34bfb",
                                                "sense_id": "9f3ac1db-ae1a-310f-b94b-532beef693d1",
                                                "text": "Inactive user accounts may be deleted after 90 days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd32e133-435e-3486-971b-78d2a22f16a6",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
                                            "Not engaging in physical activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6aee348-b6ed-45da-9af0-4135adc8e23d",
                                                "sense_id": "dd32e133-435e-3486-971b-78d2a22f16a6",
                                                "text": "[…] exercise in general will lead to dramatic improvements in comparison with an inactive lifestyle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b5a9f6b-2561-33dd-92ef-156826a4fca7",
                                        "entry_id": "66822b41-0320-3930-b577-d72ad513313b",
                                        "glosses": [
                                            "Not functioning or operating; broken down"
