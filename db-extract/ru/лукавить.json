                                                "example_id": "673fdb7a-090c-4b30-890f-979bad951134",
                                                "sense_id": "a29651bd-9c1b-3a7d-b8c2-9d33a7261346",
                                                "text": "Il y a de certains esprits qu’il ne faut prendre qu’en biaisant."
                                            },
                                            {
                                                "example_id": "0a3d2190-a9f9-4993-9afd-9355a6dd4bd6",
                                                "sense_id": "a29651bd-9c1b-3a7d-b8c2-9d33a7261346",
                                                "text": "D'abord, il est impossible de biaiser avec elle. Essaie et tu verras. Et c'est bien ce qu'il te faut puisque tu es un biaiseur. Oh, pour biaiser tu as réussi des coups fumants."
                                            }
                                        ]
                                    }
