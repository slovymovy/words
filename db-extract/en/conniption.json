                        "examples": [
                            {
                                "example_id": "8e8a7abf-a76a-476d-ae56-5844ef70113b",
                                "sense_id": "f98e62d7-c106-3d19-8efd-a91243d21a6f",
                                "text": "When she came downstairs and saw what her children were eating, she had a conniption.",
                                "translation": "[…], elle piqua une crise."
                            },
                            {
                                "example_id": "83c9d7f7-a3ac-4c57-a973-e0dad8131e94",
                                "sense_id": "f98e62d7-c106-3d19-8efd-a91243d21a6f",
                                "text": "[…] threatened by the conniptions gripping Wall Street.",
                                "translation": "[…] menacée par les accès de rage qui prennent Wall Street."
                            }
                        ]
                    },
                    {
                        "sense_id": "c143cd89-7212-30e4-a8f5-dd664b4ead4d",
                        "entry_id": "3cd16053-820a-3f8c-bf5d-92ab0a8337fd",
                        "glosses": [
                            "Crise de fou rire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6b7e4d-8b39-4c2f-a07f-1da884d9eb3f",
                                "sense_id": "c143cd89-7212-30e4-a8f5-dd664b4ead4d",
                                "text": "The joke was not that funny, but he went into conniptions laughing.",
                                "translation": "La plaisanterie n’était pas si drôle, mais il eut une crise de fou rire."
                            }
                        ]
                    }
