                ],
                "senses": [
                    {
                        "sense_id": "b5d0ecdc-0887-3154-b6a0-3d20ac324512",
                        "entry_id": "98d5dc30-ad85-386b-b748-25695f5401ef",
                        "glosses": [
                            "Faire perdre son caractère de fiction à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ecb961-7577-4eed-85e6-2457dfb761e4",
                                "sense_id": "b5d0ecdc-0887-3154-b6a0-3d20ac324512",
                                "text": "Perfectionniste dans ses rôles et adepte de son professeur d’art dramatique Stella Adler, qui demandait à ses élèves de « défictionner » la fiction, il apprit à jouer du saxophone pour le film New York, New York, un film musical de Martin Scorsese sorti en 1977."
                            },
                            {
                                "example_id": "771b5ae6-3b7b-4de6-9cff-bd7b5b2cd921",
                                "sense_id": "b5d0ecdc-0887-3154-b6a0-3d20ac324512",
                                "text": "Dans ces deux cas, on force la fiction au trompe-l’œil, on la « défictionne » d’une certaine manière par excès de signes réels destinés à manipuler le regard et la réalité du même coup."
                            }
                        ]
                    }
                ],
