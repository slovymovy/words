                                            "normalmente solo se emplea en oración subordinada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17842ff-20b5-4078-b547-71e079dbb627",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "deseo de una persona sobre otra: Mi madre quiere que estudie medicina."
                                            },
                                            {
                                                "example_id": "2e83dd3c-6794-4788-8bfc-76bb2ade238f",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "duda: No creo que llegue a tiempo."
                                            },
                                            {
                                                "example_id": "7937e5bf-170a-4cd6-8fda-a1c6c1a73a30",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "impresiones subjetivas: es probable que llueva, es interesante que haya vida."
                                            },
                                            {
                                                "example_id": "7880791a-de63-4f7a-9cb9-f1105745077c",
                                                "sense_id": "3ed2e14e-5884-357f-9a35-281ee5fc41a7",
                                                "text": "una situación hipotética: descansaremos cuando haya paz mundial; si hubiera paz mundial descansaríamos."
