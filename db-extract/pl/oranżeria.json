                        "entry_id": "2623d327-a474-346b-b2ea-64b211d507be",
                        "glosses": [
                            "szklarnia służąca do hodowli egzotycznych roślin, np. pomarańcz, cytryn, pełniąca rolę wypoczynkową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a643f34-00a3-4f32-aa47-4bcb88b3cdd8",
                                "sense_id": "7e314985-ffde-3847-9320-88442d35baa7",
                                "text": "Za najpiękniejszą w Europie uchodzi oranżeria w Wersalu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cd8cbd6-9b5f-4036-a105-d82a15f4c422",
                        "source_entry_id": "2623d327-a474-346b-b2ea-64b211d507be",
                        "source_sense_id": "7e314985-ffde-3847-9320-88442d35baa7",
