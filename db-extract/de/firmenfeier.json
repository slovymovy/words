                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0a43c5-2e61-4d80-aa20-5b70d888b5e8",
                                                "sense_id": "183c9406-6e39-37ce-92ca-bf83f0cd5057",
                                                "text": "Не помню ни одного сабантуя без того, чтоб в углу не бормотал магнитофон."
                                            }
                                        ]
