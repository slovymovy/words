                    {
                        "translation_id": "ad06c3a3-394e-4c4c-a14f-c5d504c3b33f",
                        "source_entry_id": "3dad6668-9eab-368a-83ce-d091e7b00dad",
                        "source_sense_id": "a9f4e71e-fc02-3a05-aeb1-6516e7cedad7",
                        "source_sense_description": "de eerste trap vanuit de middencirkel bij het begin van speeltijd van een voetbalwedstrijd",
                        "target_lang_word": "engagement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engagement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20299316-4805-3c95-8e11-5c773634438b",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Action d’engager quelque chose ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcea711-d9fe-4ebf-aedb-602266d67877",
                                                "sense_id": "20299316-4805-3c95-8e11-5c773634438b",
                                                "text": "Engagement de meubles. L’engagement de sa foi, de sa parole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb44f17-560a-333b-a0be-0de795d08518",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Acte par lequel on cède à quelqu’un la jouissance d’un bien-fonds pour un temps déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1913993e-6097-4cdb-94fa-e0bd030463b0",
                                                "sense_id": "dbb44f17-560a-333b-a0be-0de795d08518",
                                                "text": "Tenir un domaine par engagement. Il n’a pas la propriété, ce n’est qu’un engagement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c5dc08-61c9-3778-a1aa-907d8bbe3a7c",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Action de s’engager par une promesse ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215104f2-1248-4e20-b849-501b1dd4d1dc",
                                                "sense_id": "05c5dc08-61c9-3778-a1aa-907d8bbe3a7c",
                                                "text": "Dans ce but il demanda à la régence d’Ensisheim communication de l’engagement pris par les parties guerroyantes de respecter les possessions autrichiennes, ainsi que les villes impériales."
                                            },
                                            {
                                                "example_id": "d92a1a54-c355-4c7c-8c8f-87f68421686c",
                                                "sense_id": "05c5dc08-61c9-3778-a1aa-907d8bbe3a7c",
                                                "text": "Il savait que son futur beau-père était avant tout l’homme du devoir, esclave de tous ses engagements et incapable de manquer à un rendez-vous d’affaires."
                                            },
                                            {
                                                "example_id": "2b6c7986-ef38-4106-9941-a94bbdc4222a",
                                                "sense_id": "05c5dc08-61c9-3778-a1aa-907d8bbe3a7c",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f5c736-ab1f-35d7-b75d-d4ea34d89d3a",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Enrôlement volontaire d’un soldat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d97a61-998b-4505-8693-44c4ab2a54c5",
                                                "sense_id": "20f5c736-ab1f-35d7-b75d-d4ea34d89d3a",
                                                "text": "Peu de jours après, Yasmina apprit qu'on allait la donner à un homme qu'elle n'avait entrevu qu'une fois, un spahi, […], issu d'une bonne famille de Guelma, quoique brouillé avec ses parents à la suite de son engagement."
                                            },
                                            {
                                                "example_id": "3ced56bf-374e-4006-8798-d839bb907382",
                                                "sense_id": "20f5c736-ab1f-35d7-b75d-d4ea34d89d3a",
                                                "text": "Quoique le recrutement se fasse en entier par engagements volontaires, et sous la direction du commandant en chef de l’armée, ce sont les Magistrats qui reçoivent et constatent l’engagement des recrues; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6011f31-7d24-32f9-927c-56e859201ef3",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Fait de s’engager à servir quelqu’un, une société, une entreprise pour un certain temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0428d8-5d5c-4c0f-97b7-4123f3ae3a85",
                                                "sense_id": "a6011f31-7d24-32f9-927c-56e859201ef3",
                                                "text": "Les conditions d’engagement du capitaine et des hommes d’équipage d’un navire marchand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72debb52-825d-33f2-998d-1f6db2879de2",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Combat et surtout combat qui a lieu entre des corps détachés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aad5df2-4cc3-4bcf-963c-72431494b944",
                                                "sense_id": "72debb52-825d-33f2-998d-1f6db2879de2",
                                                "text": "Après un engagement assez vif avec un vaisseau ennemi, pendant lequel le bruit du canon s'était fait entendre de très-près, on chercha Kokoly (c'était le nom du perroquet marin); il avait disparu; on le crut mort au champ d'honneur, du vent, sinon du coup de quelque boulet; […]."
                                            },
                                            {
                                                "example_id": "543a9a3d-aa86-461b-a010-6d4d344345af",
                                                "sense_id": "72debb52-825d-33f2-998d-1f6db2879de2",
                                                "text": "À la nuit, on apprit que la division de Forton avait eu un engagement sérieux, du côté de Mars-la-Tour."
                                            },
                                            {
                                                "example_id": "3d5a0eb6-4449-40cd-abc7-f8a35d7372e6",
                                                "sense_id": "72debb52-825d-33f2-998d-1f6db2879de2",
                                                "text": "L’engagement fut rapide et d’une extrême brutalité. Le corps expéditionnaire prit les habitants par surprise, aux premières heures du jour. Ce fut un massacre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756d2d4a-05bf-3076-a1cd-140bf04e9141",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Acte ou attitude de l'intellectuel ou de l'artiste qui, prenant conscience de son appartenance au monde, abandonne une position de simple spectateur et met sa personne, sa pensée ou son art au service d'une cause"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65329ac0-07e2-47c9-a75e-d4b11cdaf680",
                                                "sense_id": "756d2d4a-05bf-3076-a1cd-140bf04e9141",
                                                "text": "Rédigé dans la fébrilité par un intellectuel ayant le goût de la théorisation, ce guide bien écrit du parfait révolutionnaire sera lu, médité et parfois même appliqué par une génération de jeunes tentés par l’engagement."
                                            },
                                            {
                                                "example_id": "a5da5337-c01b-481f-b7b7-e1f923ce97ad",
                                                "sense_id": "756d2d4a-05bf-3076-a1cd-140bf04e9141",
                                                "text": "Il y a quelques jours j'ai été invité chez une charmante amie brune bossant dans la publicité, et claironnant bruyamment ses engagements féministes dès qu'elle le peut en public..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ea885e-bd91-336b-bd91-75dde23406f4",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Procédure règlementée qui débute une séquence de jeu dans des sports tels le football ou le hockey sur glace, par laquelle l'objet utilisé (par ex. ballon, palet) est mis en jeu sur le terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c382affb-5d32-45e8-9bcf-b56ec34021e4",
                                                "sense_id": "b9ea885e-bd91-336b-bd91-75dde23406f4",
                                                "text": "L'équipe de Vorskla encaisse un but juste après son engagement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082e95d1-01a9-3422-b9be-6205d711cdb9",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Phénomène qui explique les raisons pour lesquelles une personne commet des actes de sa propre initiative."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6379376a-5a2d-3ee4-aac3-1f9265287560",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Inscription officielle d'un cheval comme participant à une course."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8c5b090-dfa3-3862-afa2-271b160115ec",
                                        "entry_id": "bfe4c2a8-4d69-357c-a6e5-b66ded5ced32",
                                        "glosses": [
                                            "Conditions de course pour un cheval, considérées relativement à ses chances de succès aux gains."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e60e163-e8c8-49a2-8958-68245dca0417",
                                                "sense_id": "f8c5b090-dfa3-3862-afa2-271b160115ec",
                                                "text": "un bon engagement, un engagement favorable, un engagement sur mesure"
                                            },
                                            {
                                                "example_id": "7cfea059-a660-4e03-84d7-e13fe2f7dffe",
                                                "sense_id": "f8c5b090-dfa3-3862-afa2-271b160115ec",
                                                "text": "Verdi de Tillard (7) me paraît bien à l'entraînement. Je n'ai pas trop d’engagements autres que celui-là pour effectuer une rentrée. Il restera ferré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
