                                        ]
                                    },
                                    {
                                        "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                        "entry_id": "3efa7b70-6a3e-3984-853b-80a7a73578cc",
                                        "glosses": [
                                            "Celui qui prend part à une tâche sans y être obligé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4e2ff5-4f52-472e-9b98-bdaebc207be2",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "Le cryobiologiste se caressa le menton. Il trouvait que son adjoint n'avait aucune considération pour les volontaires. Or, sans volontaires, il n'existerait pas d’expériences."
                                            },
                                            {
                                                "example_id": "2fadc2f2-a4b3-4538-b087-f741ad3c28db",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "On demande des volontaires."
                                            },
                                            {
                                                "example_id": "6939b8b0-d849-4d15-9c2e-68ff0679b5b6",
                                                "sense_id": "7ccecb6b-d3d9-3dff-86a2-36bc9ccc5c6d",
                                                "text": "Il y est allé comme volontaire."
                                            }
