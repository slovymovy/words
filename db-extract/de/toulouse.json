                                "sense_id": "de28577e-755b-3264-bb8d-a8bdca5dbc34",
                                "text": "„Nur fünf Jahre später bedrohte ein in Toulouse abgehaltenes Konzil die neuen ketzer und ihre Förderer mit Exkommunikation und Kerker.“"
                            },
                            {
                                "example_id": "e20da948-3fd2-404b-9f1d-72e4b3730f30",
                                "sense_id": "de28577e-755b-3264-bb8d-a8bdca5dbc34",
                                "text": "„Sie hatten Toulouse als Treffpunkt ausgemacht.“"
                            }
                        ],
