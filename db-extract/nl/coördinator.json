                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "10beff52-5738-4d6f-8582-428b7382255e",
                                "sense_id": "d8623827-20e2-3650-a344-55e3505d84b0",
                                "text": "Naar aanleiding van de stijging in het aantal roofovervallen is een landelijke coördinator overvalcriminaliteit aangesteld."
                            },
                            {
                                "example_id": "03b7be35-56bf-459d-9df7-ab0348f224db",
                                "sense_id": "d8623827-20e2-3650-a344-55e3505d84b0",
                                "text": "Iedereen hier in de omgeving had iets van: we willen hieraan deelnemen\", zegt Teun Verschueren, coördinator van het personeel."
                            }
                        ]
                    }
                ],
