                "senses": [
                    {
                        "sense_id": "13804f1f-af0c-3696-905e-5bcd5ac07faf",
                        "entry_id": "4ec371c8-3bb0-3c76-8348-5011cfc48d6f",
                        "glosses": [
                            "Instrument qui mesure l’angle nécessaire pour établir l’achromatisme de deux prismes de verres différents."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "8722eab2-1786-4bc4-abae-253511616fd4",
                                "sense_id": "13804f1f-af0c-3696-905e-5bcd5ac07faf",
                                "text": "Le diasporamètre de Rochon ou encore diasporamètre chromatique est un instrument créé par Alexis-Marie de Rochon en 1783 et monté par l’ingénieur opticien Jean-Baptiste Soleil en 1840. Il consiste en un tube contenant deux prismes de crown pouvant tourner l’un par rapport à l’autre."
                            },
                            {
                                "example_id": "363cb31e-1dc4-45b9-8a1a-14145075d189",
                                "sense_id": "13804f1f-af0c-3696-905e-5bcd5ac07faf",
                                "text": "Rochon et Brewster ont modifié de façons avantageuses la disposition du diasporamètre; mais la théorie en est toujours celle de Boscowich."
                            }
                        ]
                    }
                ],
