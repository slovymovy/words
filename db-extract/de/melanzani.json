                                "target_senses": [
                                    {
                                        "sense_id": "373128ba-997d-39fe-8bc4-012e017f9a61",
                                        "entry_id": "5a006968-ba7c-39a6-96b8-e4231c3a825c",
                                        "glosses": [
                                            "The plant Solanum melongena or its edible fruit; an aubergine."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce9282eb-de46-41fb-a068-d0d274fc2456",
                                                "sense_id": "373128ba-997d-39fe-8bc4-012e017f9a61",
                                                "text": "Some fun meatless recipes include jackfruit sandwiches in place of pulled pork; black bean meatless balls or eggplant and shiitake “meatballs.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25707dd-f313-3776-af84-accdc2aa43df",
                                        "entry_id": "5a006968-ba7c-39a6-96b8-e4231c3a825c",
                                        "glosses": [
                                            "A dark purple color, like that of the skin of this fruit."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b5e4b4a-adc5-38e9-9242-bbd5a5545702",
                                        "entry_id": "5a006968-ba7c-39a6-96b8-e4231c3a825c",
                                        "glosses": [
                                            "A black person (used mainly by Italian-Americans)."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273b32cb-f886-469a-b28f-d37e747a37e3",
                                                "sense_id": "3b5e4b4a-adc5-38e9-9242-bbd5a5545702",
                                                "text": "Hey. Yeah. And, and your great-great-great-great grandmother fucked a nigger, ho, ho, yeah, and she had a half-nigger kid… now, if that's a fact, tell me, am I lying? 'Cause you, you're part eggplant."
                                            },
                                            {
                                                "example_id": "23432b73-c04d-4a00-b6c8-b0a5b4a1a3f9",
                                                "sense_id": "3b5e4b4a-adc5-38e9-9242-bbd5a5545702",
                                                "text": "\"Why am I not surprised?\" This was the limit. \"You know, I'm black enough for his family to yell eggplant-this and nigger-that at me,\" she said."
                                            },
                                            {
                                                "example_id": "aad23002-b32a-4a45-884d-ce05d0af5d8d",
                                                "sense_id": "3b5e4b4a-adc5-38e9-9242-bbd5a5545702",
                                                "text": "What else can he do? But Hopper continues his riff. \"Sicilians still carry that nigger gene . . . Your ancestors are niggers. You're part eggplant.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda95cde-7198-3951-a6d9-57333205d35d",
                                        "entry_id": "5a006968-ba7c-39a6-96b8-e4231c3a825c",
                                        "glosses": [
                                            "A 180 backside rotated invert in which the front hand is planted on the lip of the halfpipe wall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc548ae4-6880-4d81-b9e9-38463184ea5b",
                        "source_entry_id": "223ceaf5-fed7-3149-8cda-831f30edb7fe",
                        "source_sense_id": "3f6fc4e8-12ef-3075-866f-f639a95e2271",
                        "source_sense_description": "österreichisch: Aubergine",
                        "target_lang_word": "aubergine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aubergine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9571bb-c5f2-370a-b95d-ea0159dd3988",
                                        "entry_id": "333eae8e-83e2-30ef-8766-60682b86cad6",
                                        "glosses": [
                                            "Plante herbacée de la famille des solanacées qui porte des fruits blancs semblables à des œufs, ou de forme allongée comme les concombres, et de couleur violette, jaune ou rougeâtre (Solanum melongena)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619394c5-411e-4536-bb76-8d5531844923",
                                                "sense_id": "5a9571bb-c5f2-370a-b95d-ea0159dd3988",
                                                "text": "En mars, les fèves commencent à se former, tandis qu’on sème concombres et aubergines, ainsi que citronnelle et marjolaine."
                                            },
                                            {
                                                "example_id": "5680e437-b81e-42c9-b241-39ab9f5b418b",
                                                "sense_id": "5a9571bb-c5f2-370a-b95d-ea0159dd3988",
                                                "text": "La domestication a eu lieu dans une région située entre l’Inde, le Myanmar et la Chine où on trouve toujours des types primitifs ou adventices d’aubergines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ccb5178-a19d-31d6-8580-ca2eb95f726c",
                                        "entry_id": "333eae8e-83e2-30ef-8766-60682b86cad6",
                                        "glosses": [
                                            "Fruit de cette plante, de couleur magenta-pourpre à violet, très sombre, de la famille des solanacées, utilisé comme légume, notamment dans la cuisine méditerranéenne, et servant à réaliser des plats tels que la moussaka ou la ratatouille."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e838a4bb-9cbc-4776-a7b3-889fd2c929e7",
                                                "sense_id": "6ccb5178-a19d-31d6-8580-ca2eb95f726c",
                                                "text": "Et le Progrès vint, qui l’obligea à mettre dans son étalage des artichauts et des aubergines de France, des pommes étrangères, […] des bananes, des noix aux formes insolites, des « grappes fruits » et des mangues…"
                                            },
                                            {
                                                "example_id": "e67b3a19-7f68-415d-98ee-f30cc3bca4c0",
                                                "sense_id": "6ccb5178-a19d-31d6-8580-ca2eb95f726c",
                                                "text": "À la clarté irrégulière des flammes, la plaie se dévoila. Cernée de croûtes, de tumeurs et de crevasses enflammées, elle avait la couleur et la matière d’une aubergine pourrie. À travers la peau corrodée, éclatée, perçaient les arêtes de l’os rompu."
                                            },
                                            {
                                                "example_id": "e3ecfcd2-7ba9-483e-a02f-67c562e845df",
                                                "sense_id": "6ccb5178-a19d-31d6-8580-ca2eb95f726c",
                                                "text": "En Europe, au Moyen Âge, on donnait à l’aubergine le nom de malum insanum, ou « pomme de la folie », car, disait-on, elle était dangereuse pour la santé mentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e0b009-7a77-3921-94a7-e0a7a61026b7",
                                        "entry_id": "333eae8e-83e2-30ef-8766-60682b86cad6",
                                        "glosses": [
                                            "Auxiliaire féminine de police, chargée du contrôle du stationnement, appelée ainsi à l’origine en raison de la couleur de son uniforme, proche de celle du fruit."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4603730-bc24-4820-932e-b3e201337ee2",
                                                "sense_id": "65e0b009-7a77-3921-94a7-e0a7a61026b7",
                                                "text": "Les aubergines c’est quand même mieux dans ton assiette, roulées avec de la mozza et du jambon, que dans la rue à te coller une prune sur le pare-brise."
                                            },
                                            {
                                                "example_id": "869114fc-f975-469c-a9ce-36814e88d164",
                                                "sense_id": "65e0b009-7a77-3921-94a7-e0a7a61026b7",
                                                "text": "On m’appelle Aubergine\nÀ cause de la jolie couleur de mon petit tailleur\nOn m’appelle Aubergine\nJe suis l’ange mauve du trottoir avec mes accessoires"
                                            }
                                        ]
                                    },
                                    {
