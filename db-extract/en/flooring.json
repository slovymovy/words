                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85de5a7-94bc-4fa2-9152-1815946840e9",
                        "source_entry_id": "2c287716-fd89-3835-ba68-c383910f60cf",
                        "source_sense_description": "floor",
                        "target_lang_word": "Fußboden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußboden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                        "entry_id": "32506a42-2135-3319-b188-bd560ff5e463",
                                        "glosses": [
                                            "begehbare Fläche in einem Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d7372f-8c62-4bb8-8e99-98d48b353f70",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "Der Fußboden ist mit Teppichen ausgelegt."
                                            },
                                            {
                                                "example_id": "39473324-0ac8-4d8d-b9e0-1fa51f740773",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "„Gerade wird er im großen Stil saniert: ein Glücksfall für die Archäologen, die bei Erdarbeiten nicht nur auf Azelins Grundmauern, sondern auch auf alte Fußböden, Gräber und Reste der ersten Kapelle stießen, die hier um 815 nach Christus stand.“"
                                            },
                                            {
                                                "example_id": "f9411797-b86e-4619-8d72-1b1e137074f2",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "„Der Fußboden war aus gestampftem Lehm, hinter dem Ladentisch im Regal ein paar nutzlose Waren und Attrappen, die Fenster verklebt vom Fliegendreck.“"
                                            },
                                            {
                                                "example_id": "35623dab-1f96-4b0b-a3a1-9c66900f65cf",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "„Eigil hob ihn vom Fußboden hoch.“"
                                            },
                                            {
                                                "example_id": "a8904af3-df0b-48df-b116-d05758e3f964",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "„Auf dem Fußboden liegen ihre Schuhe auf der Seite.“"
                                            },
                                            {
                                                "example_id": "b0d38d75-3136-45fe-b09d-baa59734d1d4",
                                                "sense_id": "c22dec94-bc17-36ec-b58c-712685b805eb",
                                                "text": "„An der Stelle, wo früher der Tisch gestanden hat, ist jetzt kein Tisch mehr, aber dort, wo seine Beine waren, sieht man immer noch die vier Abdrücke im Fußboden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3532ae41-b6eb-49b7-98f2-d971f9d3b958",
                        "source_entry_id": "2c287716-fd89-3835-ba68-c383910f60cf",
                        "source_sense_description": "floor",
                        "target_lang_word": "Boden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1ce1ab6-8374-310d-86b4-2abb727e1ed8",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "die Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b9b8b4-7537-4587-8145-98c0bb98fb4a",
                                                "sense_id": "f1ce1ab6-8374-310d-86b4-2abb727e1ed8",
                                                "text": "Die Tasse fiel auf den Boden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82379d5c-07d8-3560-a560-e6d703a4efef",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "die oberste Schicht der Erdkruste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecd7ca1-9a8b-4bbb-8cf1-93a7a8af194c",
                                                "sense_id": "82379d5c-07d8-3560-a560-e6d703a4efef",
                                                "text": "Die Böden sind in verschiedenen Klimazonen ganz unterschiedlich."
                                            },
                                            {
                                                "example_id": "65967782-aa8f-4ca9-bf51-1ce3f34aabdb",
                                                "sense_id": "82379d5c-07d8-3560-a560-e6d703a4efef",
                                                "text": "„Der Boden ist ein wichtiger Teil der Biosphäre an Land, weil die meisten Pflanzen ihn für ihr Wachstum brauchen.“"
                                            },
                                            {
                                                "example_id": "ceb6482e-fb24-4315-abb2-eed44d7211c0",
                                                "sense_id": "82379d5c-07d8-3560-a560-e6d703a4efef",
                                                "text": "„Birken schienen ihr eigenes Mikroklima mitzubringen, dachte ich, sie wuchsen in nassen und trockenen Böden, auf Wiesen, in Wäldern, Mooren und auf Dünen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8b4bc0ee-f8fa-38f8-84fc-329d6d31a046",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "unterer Abschluss eines Gefäßes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f48811e-5b0e-4942-9a13-c09c11b5c155",
                                                "sense_id": "8b4bc0ee-f8fa-38f8-84fc-329d6d31a046",
                                                "text": "Der Eimer hat ein Loch im Boden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "45b8f49d-cd3c-318d-93eb-535006a39201",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "Dachboden"
                                        ],
                                        "tags": [
                                            "North German",
                                            "especially",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e78224-ad40-4a6a-9521-5dc577beb549",
                                                "sense_id": "45b8f49d-cd3c-318d-93eb-535006a39201",
                                                "text": "Ich hole mal eben etwas vom Boden."
                                            },
                                            {
                                                "example_id": "e23f2824-2424-4fd9-ae57-1bf905c964c6",
                                                "sense_id": "45b8f49d-cd3c-318d-93eb-535006a39201",
                                                "text": "Der Weihnachtsschmuck liegt auf dem Boden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8e48b762-facf-35bc-bf27-49e8e5223517",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "Erdboden oder Fußboden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe0530c-544d-475a-9e02-e4442eac28f3",
                                                "sense_id": "8e48b762-facf-35bc-bf27-49e8e5223517",
                                                "text": "Ich muss noch den Boden wischen."
                                            },
                                            {
                                                "example_id": "d6da559a-58e2-40c8-a71a-e0720864c265",
                                                "sense_id": "8e48b762-facf-35bc-bf27-49e8e5223517",
                                                "text": "„Gestern war ich mit dem Kopf auf der Sofalehne aufgewacht, mit einem staubigen Geschmack im Mund, auf dem Boden eine umgestoßene Kaffeetasse und daneben eine umgefallene Zimmerlinde (Sparrmannia africana), keine Ahnung, wie das passiert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "49f4fc50-e530-31c3-9dbd-fe99943b6ad4",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "Gebiet, Besitz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a7a453-a95d-4ecb-b51a-aefc7f20f123",
                                                "sense_id": "49f4fc50-e530-31c3-9dbd-fe99943b6ad4",
                                                "text": "Auf unserem eigenen Grund und Boden durften wir nicht bauen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "1a8a1bc7-f544-3945-ab23-2aaf7a7972df",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "Grundlage, Basis"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "00b07f20-ee54-3971-90b8-69fb125c74aa",
                                        "entry_id": "49e23cf0-2df0-3674-b59c-8cbb5d4177d2",
                                        "glosses": [
                                            "Tortenboden"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9233a0b2-0943-44a9-9caa-77b80d6b1527",
                                                "sense_id": "00b07f20-ee54-3971-90b8-69fb125c74aa",
                                                "text": "Mutter backt die besten Böden."
                                            },
                                            {
                                                "example_id": "6c23cf2f-f9e2-4766-9386-df82f8a2551b",
                                                "sense_id": "00b07f20-ee54-3971-90b8-69fb125c74aa",
                                                "text": "Oma hat den Boden mit Erdbeeren belegt."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
