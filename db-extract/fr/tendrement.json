        "fr-extract.jsonl": [
            {
                "entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                "word": "tendrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4c9faf1-658c-3b95-91a4-fa1a5a0c074b",
                        "entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                        "glosses": [
                            "Avec tendresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4371785a-e7d8-4484-b1e3-aadfc579bfba",
                                "sense_id": "e4c9faf1-658c-3b95-91a4-fa1a5a0c074b",
                                "text": "Tout le respect et toute la vénération que j'ai pour elle [une dame], ne peuvent empêcher qu’avec cela je ne l’aime tendrement comme la meilleure personne qui soit au monde,"
                            },
                            {
                                "example_id": "6bb572b7-2d3d-45ad-9ae8-445d683176b5",
                                "sense_id": "e4c9faf1-658c-3b95-91a4-fa1a5a0c074b",
                                "text": "Puisque vous les lisez [nos lettres] avant votre coucher, nous vous empêchons tendrement de dormir trois fois la semaine,"
                            },
                            {
                                "example_id": "788fbd59-3091-4165-90ee-9983fb8b3f6e",
                                "sense_id": "e4c9faf1-658c-3b95-91a4-fa1a5a0c074b",
                                "text": "Il n'est pas possible que je [Platon] ne sois pas aimé de quelqu'un [Xénocrate] que j'aime si tendrement,"
                            }
                        ]
                    },
                    {
                        "sense_id": "d6ae434c-01ab-3036-8820-8d58432e164c",
                        "entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                        "glosses": [
                            "Avec une expression tendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35044e24-18a8-41ac-8aa4-f78ae8c6e7b7",
                                "sense_id": "d6ae434c-01ab-3036-8820-8d58432e164c",
                                "text": "Les héros chez Quinault parlent bien autrement, Et jusqu'à : Je vous hais, tout s'y dit tendrement,"
                            },
                            {
                                "example_id": "f95706ec-9677-4c7e-b0ce-a958371014a4",
                                "sense_id": "d6ae434c-01ab-3036-8820-8d58432e164c",
                                "text": "Il faut plus tendrement prononcer ce mot-là,"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff2e28f7-9721-3538-8f94-0f1cf0229997",
                        "entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                        "glosses": [
                            "Délicatement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f57f6c-0a0a-42d1-9dcc-98edf5719431",
                                "sense_id": "ff2e28f7-9721-3538-8f94-0f1cf0229997",
                                "text": "Peindre tendrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9691a338-f8e9-4534-8e32-a843d10a17ef",
                        "source_entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                        "target_lang_word": "tenderly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenderly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                        "entry_id": "79c7dc06-fef0-349b-9367-defe564b6672",
                                        "glosses": [
                                            "In a tender manner; gently; sweetly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3aab22-8e8e-40d2-8f0e-a21bfa677a73",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "and the hour striking at which I was oblig'd to dispatch my young man, I tenderly advised him of the necessity there was for parting",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "09640a22-1427-4c1f-979f-df2b3d87fdcc",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "After a moment of comfortable silence, with Ben tenderly rubbing his thumb gently over the back of her hand, he asked, “So what do you want to do now that you’re all stuffed full of waffley goodness?”"
                                            },
                                            {
                                                "example_id": "6404c69f-cdc1-4dba-8647-f4d6db8a931e",
                                                "sense_id": "53c78523-ff7c-359e-a65d-cd924ef261af",
                                                "text": "Outside is getting colder\nWhy does it feel like I'm older than I asked to be?\nBut when you say my name\nIt all falls away so tenderly"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e97f38-9522-442b-bd71-810638abc185",
                        "source_entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
                        "target_lang_word": "softly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "In a soft manner; gently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cecd2f-b4e7-46cd-b4fe-3fecf102946e",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "The masseuse was rubbing my back too softly for my liking, so I asked her to go harder."
                                            },
                                            {
                                                "example_id": "c77e3ca9-df67-41ad-93d2-3796161f1332",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "He had married a lady well educated and softly nurtured, but not dowered with worldly wealth. […] They would give up ideas of gentle living, of soft raiment, and delicate feeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "Not loudly; nearly inaudibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7ac6f1-5e92-45f1-8cec-77aae41d81c7",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "whisper softly in someone's ear"
                                            },
                                            {
                                                "example_id": "9c22bad6-7ccd-4f58-a02e-4ed377560ff8",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "play music softly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "With subdued color; faded or misty with distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ac4721-97b8-44c6-830b-4a48acabc289",
                                                "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                                "text": "And they sat very still, the two of them, and looked out over that great, beautiful desert—away to the home mesa that they could see, softly blue, in the distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8beb5487-e226-4fc4-bb6d-481c2e36d853",
                        "source_entry_id": "859e3b29-d101-3a45-8cb9-c6327a7da6a9",
