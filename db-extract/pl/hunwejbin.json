                ],
                "senses": [
                    {
                        "sense_id": "dd570136-1425-33ef-a78e-642aba8b6c9d",
                        "entry_id": "679b661d-75c3-344e-8850-f2ad2ca3ccea",
                        "glosses": [
                            "członek chińskiej Czerwonej Gwardii, komunistycznej organizacji młodzieżowej działająca podczas rewolucji kulturalnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f3765f-66ac-4d93-9168-207fa7bc0354",
                                "sense_id": "dd570136-1425-33ef-a78e-642aba8b6c9d",
                                "text": "W czasie Zjazdu przedstawiciele armii podkreślali, że działalność hunwejbinów stanowi przeszkodę na drodze stabilizacji kraju i podważa pracę komitetów rewolucyjnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f0221b08-e8f5-332d-9698-3977d9115207",
                        "entry_id": "679b661d-75c3-344e-8850-f2ad2ca3ccea",
                        "glosses": [
                            "członek młodzieżowego ugrupowania politycznego, które wobec politycznych przeciwników stosuje bezkompromisowe formy walki"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "f08f02a2-6947-420c-9484-2f6a1df84032",
                                "sense_id": "f0221b08-e8f5-332d-9698-3977d9115207",
                                "text": "Trzeba szanować wszystkich konkurentów, ale wydaje mi się, że żaden hunwejbin PiS nie powinien rządzić naszym miastem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64d0d01b-f326-4c94-91b2-65162cd8db47",
                        "source_entry_id": "679b661d-75c3-344e-8850-f2ad2ca3ccea",
                        "source_sense_id": "dd570136-1425-33ef-a78e-642aba8b6c9d",
                        "target_lang_word": "hongweibing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hongweibing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83201035-a637-3959-b446-be13b797c07b",
                                        "entry_id": "33c30da6-322d-3873-8399-d12e1ec014c0",
                                        "glosses": [
                                            "A red guard, a member of a mass movement of civilians, mostly students and other young people in China, who were mobilized by Mao Zedong in 1966 and 1967, during the Cultural Revolution."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b37db40-79ed-4181-96cf-f8e951d6ff71",
                                                "sense_id": "83201035-a637-3959-b446-be13b797c07b",
                                                "text": "The Chinese are hastily obliterating all traces of hongweibing pogroms in Moslem mosques and other holy places. Mao's successors have been clamouring for Moslems to preserve the Islamic cultural heritage. The blame for all the excesses in the Islamic policy has been heaped upon the \"gang of four\" and Lin Biao."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "442c1d07-ac05-4db8-8ed5-eb3927bca337",
                        "source_entry_id": "679b661d-75c3-344e-8850-f2ad2ca3ccea",
                        "source_sense_id": "dd570136-1425-33ef-a78e-642aba8b6c9d",
                        "target_lang_word": "хунвейбин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хунвейбин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a752a06-cd3b-337b-a140-6c3ad199f2b4",
                                        "entry_id": "c5f4bc64-957e-36b5-bff5-cdee425b5a0f",
                                        "glosses": [
                                            "истор. член молодёжных отрядов, сформированных в Китае в 1966 году для проведения так называемой «культурной революции»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a604e5ee-1fe9-4eb6-b222-efb6a244733f",
                                                "sense_id": "9a752a06-cd3b-337b-a140-6c3ad199f2b4",
                                                "text": "Забавная аналогия с миром коммунистического прошлого: отряды школьной и студенческой молодежи Китая, хунвейбины, времён культурной революции 1960-х уничтожали старую культурную, академическую элиту, памятники, историческое наследие в ходе кампании «Сокрушить четыре пережитка»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
