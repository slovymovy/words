{
    "word_family": [
        "pacer",
        "pacing",
        "pacemaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f79f558-b43c-31e1-bca8-30a105c0ad15",
                    "sense_definition": "The speed at which someone or something moves, happens, or changes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is moving forward at a very slow <w>pace</w>.",
                            "target_lang_translations": {
                                "ru": "Проект продвигается вперед очень медленным <w>темпом</w>.",
                                "zh": "这个项目正以非常缓慢的<w>速度</w>推进。"
                            }
                        },
                        {
                            "text": "She struggled to keep <w>pace</w> with the other runners in the marathon.",
                            "target_lang_translations": {
                                "ru": "Она изо всех сил старалась держать <w>темп</w> наравне с другими бегунами в марафоне.",
                                "zh": "在马拉松比赛中，她拼命想跟上其他跑者的<w>节奏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed",
                        "rate",
                        "tempo",
                        "velocity"
                    ],
                    "common_phrases": [
                        "keep pace",
                        "set the pace",
                        "at a snail's pace",
                        "change of pace",
                        "off the pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость, с которой кто-то или что-то движется, происходит или меняется.",
                        "zh": "某人或某物移动、进行或变化的速度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темп",
                                "target_lang_sense_clarification": "скорость осуществления чего-либо, ритм"
                            },
                            {
                                "target_lang_word": "скорость",
                                "target_lang_sense_clarification": "быстрота движения или действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "速度",
                                "target_lang_sense_clarification": "指移动、进展或变化的快慢"
                            },
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "指行动或发展的快慢与韵律"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4facb4d9-4642-3346-a81a-8a64f87a9cd0",
                    "sense_definition": "A single step taken when walking or running, or the distance covered by such a step.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "step_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a <w>pace</w> forward to shake my hand firmly.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>шаг</w> вперед, чтобы крепко пожать мне руку.",
                                "zh": "他向前迈了<w>一步</w>，与我用力握手。"
                            }
                        },
                        {
                            "text": "The hidden treasure is buried exactly ten <w>paces</w> from the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Спрятанное сокровище зарыто ровно в десяти <w>шагах</w> от старого дуба.",
                                "zh": "埋藏的宝物就在那棵老橡树外正好十<w>步</w>的地方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "step",
                        "stride"
                    ],
                    "common_phrases": [
                        "take a pace",
                        "three paces back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно движение ногой при ходьбе или беге, или расстояние, покрываемое таким движением.",
                        "zh": "走路或跑步时迈出的一步，或这一步所覆盖的距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "движение ногой или мера длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一步",
                                "target_lang_sense_clarification": "走路或跑步时迈出的一步"
                            },
                            {
                                "target_lang_word": "步",
                                "target_lang_sense_clarification": "作为距离单位时的一步"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee7925b-d3a8-37d9-a3a6-bae56c3a108a",
                    "sense_definition": "A particular way, rhythm, or style of walking or running.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gait_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor walked with a brisk and purposeful <w>pace</w> down the hospital corridor.",
                            "target_lang_translations": {
                                "ru": "Доктор шел по больничному коридору быстрым и решительным <w>шагом</w>.",
                                "zh": "医生迈着轻快而坚定的<w>步伐</w>走过医院的走廊。"
                            }
                        },
                        {
                            "text": "His leisurely <w>pace</w> suggested that he was in no hurry to arrive.",
                            "target_lang_translations": {
                                "ru": "Его неторопливая <w>походка</w> говорила о том, что он не спешит прибыть.",
                                "zh": "他那悠闲的<w>步态</w>表明他一点也不着急到达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gait",
                        "walk",
                        "stride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая манера, ритм или стиль ходьбы или бега.",
                        "zh": "特定的走路或跑步方式、节律或风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "походка",
                                "target_lang_sense_clarification": "манера ходить"
                            },
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "в контексте стиля или скорости ходьбы"
                            },
                            {
                                "target_lang_word": "поступь",
                                "target_lang_sense_clarification": "манера ступать (часто книжн. или высок.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "步伐",
                                "target_lang_sense_clarification": "指走路或跑步时的步子和节律"
                            },
                            {
                                "target_lang_word": "步态",
                                "target_lang_sense_clarification": "指一个人走路的样子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a802eaf1-864d-37f4-baed-ec81d676fa7b",
                    "sense_definition": "To walk back and forth within a small area, usually due to anxiety, impatience, or deep thought.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "walk_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>pace</w> up and down the hallway while waiting for the news.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>расхаживать</w> взад-вперед по коридору в ожидании новостей.",
                                "zh": "他等消息时，开始在走廊里<w>来回踱步</w>。"
                            }
                        },
                        {
                            "text": "The nervous actor <w>paced</w> the floor backstage before the curtain rose.",
                            "target_lang_translations": {
                                "ru": "Нервный актер <w>мерил шагами</w> пол за кулисами перед поднятием занавеса.",
                                "zh": "幕布升起前，那位紧张的演员在后台<w>踱来踱去</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pace up and down",
                        "pace the floor",
                        "pace back and forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить взад-вперед на небольшом пространстве, обычно из-за беспокойства, нетерпения или глубоких раздумий.",
                        "zh": "通常因焦虑、不耐烦或陷入沉思而在小范围内来回走动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расхаживать",
                                "target_lang_sense_clarification": "ходить взад и вперёд"
                            },
                            {
                                "target_lang_word": "ходить",
                                "target_lang_sense_clarification": "двигаться шагом (обычно нервно)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "来回踱步",
                                "target_lang_sense_clarification": "因焦虑、烦躁或思考而在小范围内走来走去"
                            },
                            {
                                "target_lang_word": "踱来踱去",
                                "target_lang_sense_clarification": "在一个地方不停地走来走去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "926a3390-5ad7-3d53-a211-c279321119ad",
                    "sense_definition": "To set the speed of an activity or race, or to manage one's own speed and energy to complete a task.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "regulate_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>pace</w> yourself if you want to finish this long exam on time.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>распределять силы</w>, если хочешь закончить этот длинный экзамен вовремя.",
                                "zh": "如果你想按时完成这场很长的考试，就得<w>控制节奏</w>。"
                            }
                        },
                        {
                            "text": "The lead runner <w>paced</w> the group for the first two laps before falling back.",
                            "target_lang_translations": {
                                "ru": "Лидирующий бегун <w>задавал темп</w> группе первые два круга, прежде чем отстать.",
                                "zh": "领跑的那名选手先为全组<w>领跑</w>了前两圈，随后才落到后面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pace oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать скорость деятельности или гонки, или управлять собственной скоростью и энергией для выполнения задачи.",
                        "zh": "设定某项活动或比赛的速度，或控制自己的速度和体力以完成任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задавать темп",
                                "target_lang_sense_clarification": "определять скорость движения группы"
                            },
                            {
                                "target_lang_word": "распределять силы",
                                "target_lang_sense_clarification": "экономить энергию (pace oneself)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控制节奏",
                                "target_lang_sense_clarification": "安排自己的速度与体力，以便完成任务"
                            },
                            {
                                "target_lang_word": "领跑",
                                "target_lang_sense_clarification": "在比赛中带头并决定他人的速度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51918db2-02a7-38a0-bb08-872b51e83198",
                    "sense_definition": "To measure a distance by walking across it and counting steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measure_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>paced</w> out the length of the field to estimate the fencing needed.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>измерил шагами</w> длину поля, чтобы прикинуть, сколько нужно ограждения.",
                                "zh": "农夫用<w>步子丈量</w>了这块地的长度，好估算需要多少围栏。"
                            }
                        },
                        {
                            "text": "We <w>paced</w> off ten meters from the wall to mark the penalty spot.",
                            "target_lang_translations": {
                                "ru": "Мы <w>отмерили шагами</w> десять метров от стены, чтобы отметить место для штрафного удара.",
                                "zh": "我们从墙边<w>步测</w>出十米，用来标出罚球点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pace out",
                        "pace off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерять расстояние, проходя по нему и считая шаги.",
                        "zh": "通过走过一段距离并数步数来测量它。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерять шагами",
                                "target_lang_sense_clarification": "определять расстояние счетом шагов"
                            },
                            {
                                "target_lang_word": "отмерять шагами",
                                "target_lang_sense_clarification": "откладывать расстояние шагами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "步子丈量",
                                "target_lang_sense_clarification": "靠走步并数步数来测量距离"
                            },
                            {
                                "target_lang_word": "步测",
                                "target_lang_sense_clarification": "用步数估量或量出距离"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "38b6accd-e05d-3435-9d2d-1b1b9cb4a125",
                    "sense_definition": "With all due respect to; used to express polite disagreement with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "preposition_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie is, <w>pace</w> the critics, actually quite enjoyable and well-made.",
                            "target_lang_translations": {
                                "ru": "Фильм, <w>при всём уважении к</w> критикам, на самом деле довольно приятный и хорошо сделанный.",
                                "zh": "这部电影，<w>与</w>评论家<w>不同</w>，我认为其实相当好看，而且制作精良。"
                            }
                        },
                        {
                            "text": "This theory, <w>pace</w> Freud, does not explain every aspect of human behavior.",
                            "target_lang_translations": {
                                "ru": "Эта теория, <w>при всём уважении к</w> Фрейду, не объясняет каждый аспект человеческого поведения.",
                                "zh": "这个理论，<w>与</w>弗洛伊德<w>不同</w>，并不能解释人类行为的每一个方面。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "При всем уважении к; используется для выражения вежливого несогласия с кем-либо.",
                        "zh": "表示“恕不同意……的看法”；用于礼貌地表达与某人的不同意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при всём уважении к",
                                "target_lang_sense_clarification": "вводная фраза для вежливого несогласия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与……不同",
                                "target_lang_sense_clarification": "表示礼貌地提出不同意见"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aef1982f-2039-3cd0-955d-6971b99b4d48",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pace</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пейс</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>佩斯</w>先生现在会在办公室见你。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пейс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佩斯",
                                "target_lang_sense_clarification": "英语姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aa85cd9-fee9-3f1c-8371-479e6bdd056b",
                    "sense_definition": "A place name, such as a town in Florida or Mississippi.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They moved to <w>Pace</w> last year to be closer to the coast.",
                            "target_lang_translations": {
                                "ru": "В прошлом году они переехали в <w>Пейс</w>, чтобы быть ближе к побережью.",
                                "zh": "为了离海岸更近，他们去年搬到了<w>佩斯</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, например, город во Флориде или Миссисипи.",
                        "zh": "地名，例如佛罗里达州或密西西比州的城镇名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пейс",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佩斯",
                                "target_lang_sense_clarification": "地名音译，如美国的一些城镇名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1f964c8c-e315-39fd-9fb6-6c8f23c078ce",
                    "sense_definition": "Describing a bowler in cricket who bowls fast balls.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needs a new <w>pace</w> bowler to strengthen their attack.",
                            "target_lang_translations": {
                                "ru": "Команде нужен новый <w>скоростной</w> боулер, чтобы усилить атаку.",
                                "zh": "球队需要一名新的<w>快速</w>投球手来加强进攻。"
                            }
                        },
                        {
                            "text": "He is known for his aggressive <w>pace</w> bowling style.",
                            "target_lang_translations": {
                                "ru": "Он известен своим агрессивным стилем <w>скоростного</w> боулинга.",
                                "zh": "他以自己极具侵略性的<w>快速</w>投球风格而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fast"
                    ],
                    "antonyms": [
                        "spin"
                    ],
                    "common_phrases": [
                        "pace bowler",
                        "pace bowling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает боулера в крикете, который подает быстрые мячи.",
                        "zh": "形容板球中投快球的投球手或这种投球方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоростной",
                                "target_lang_sense_clarification": "о подаче или игроке в крикете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快速",
                                "target_lang_sense_clarification": "指板球中快球投手或快球投法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}