                        "examples": [
                            {
                                "example_id": "9ab88bd3-842f-42e9-8a04-de654b2da366",
                                "sense_id": "d26db8d9-d7ec-3812-a45e-51764009eab5",
                                "text": "Door de beleidswijziging komt er naar verwachting 2 tot 4 procent meer donorbloed ter beschikking. Het nieuwe beleid moet komend jaar ingaan. Wel heeft het publiek nog de mogelijkheid om te reageren."
                            },
                            {
                                "example_id": "350b2011-837a-4b7f-be76-8f5e3118405e",
                                "sense_id": "d26db8d9-d7ec-3812-a45e-51764009eab5",
                                "text": "Dat is een beleidswijziging die een paar jaar geleden is aangekondigd. Als er wordt geschoten door iemand die wordt overvallen, dan wordt die persoon niet gelijk als verdachte, maar eerder als slachtoffer aangemerkt. Dat betekent dan ook dat er geen aanhoudingen plaatsvinden."
                            }
