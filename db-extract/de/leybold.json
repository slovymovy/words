                ],
                "senses": [
                    {
                        "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                        "entry_id": "f0b5dbc3-f8d4-3744-89d2-335e9b1fab21",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e848f8d6-3bb8-4a62-afc3-4354b4fc0188",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Die Leybolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e427cdf6-2b03-4803-9964-e99f825e0224",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Der Leybold trägt nie die Schals, die die Leybold ihm strickt."
                            },
                            {
                                "example_id": "744c09b9-5963-4b27-8749-7329c3df6611",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leybold kommt, geht der Herr Leybold.“"
                            },
                            {
                                "example_id": "d1f0774a-449c-42c0-9037-cd0e04a95b16",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Leybold kommt und geht."
                            },
                            {
                                "example_id": "24041de1-385f-4cb6-b892-f39716057761",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Leybolds kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f9c25c62-d32f-4a70-ba63-13643c0b5d1e",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Frau Leybold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eef2fd50-9613-4b24-b9da-45b38f66a082",
                                "sense_id": "81ca8834-fe36-3675-8940-a7a42bb6e1ca",
                                "text": "Herr Leybold wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
