                        "glosses": [
                            "tijdschrift dat leden van een vereniging ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612e9aee-c070-4d4f-b490-b69584fe100e",
                                "sense_id": "f0adefcf-41bd-3f53-b986-62da18860cae",
                                "text": "Over het algemeen is de kwaliteit van het Nederlandse zwemwater prima. Een minpunt was volgens het ledenblad van de ANWB dat de toiletvoorzieningen bij Nederlandse zwemlocaties vaak op slot zitten. De beschikbaarheid van sanitair verkleint de kans op schadelijke bacteriën, aangezien zwemmers dan minder geneigd zijn om hun behoefte te doen in het water."
                            },
                            {
                                "example_id": "e3a9ce7a-dafc-49f6-a6bd-44e0330df407",
                                "sense_id": "f0adefcf-41bd-3f53-b986-62da18860cae",
                                "text": "Een artikel van Medisch Spectrum Twente in Medisch Contact, het ledenblad van de Koninklijke Nederlandse Maatschappij ter bevordering der Geneeskunst (KNMG) heeft een tweede plaats behaald in de strijd om de Zilveren Zeepkist."
                            }
                        ]
                    }
