        "fr-extract.jsonl": [
            {
                "entry_id": "b7d6c418-57f5-3759-aae0-12e751d78812",
                "word": "pandanus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "60ccc83c-a0a2-4284-834a-104249b240fa",
                        "entry_id": "b7d6c418-57f5-3759-aae0-12e751d78812",
                        "tags": [],
                        "form": "pandan"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                        "entry_id": "b7d6c418-57f5-3759-aae0-12e751d78812",
                        "glosses": [
                            "Arbre ou arbuste du genre Pandanus, qui compte de nombreuses espèces dont les feuilles sont parfois utilisées pour la toiture ou la vannerie, et les fruits plus rarement consommés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1672332d-d17a-458f-bb57-4fa4c6ba4bf6",
                                "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                                "text": "Près du bord, un pandanus de Java épanouissait sa gerbe de feuilles verdâtres."
                            },
                            {
                                "example_id": "0690bec0-f3f8-44ad-a114-05ffaccee4eb",
                                "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                                "text": "Après le repas, plusieurs cadeaux me furent présentés, notamment des nacres, des coquillages et plusieurs chapeaux tressés en paille de pandanus."
                            },
                            {
                                "example_id": "535fa718-9008-4ced-9381-3458b285e48f",
                                "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                                "text": "À cette altitude, le pandanus produit un énorme fruit, la galipe, formé d’une multitude d’amandes succulentes. Ces fruits, exposés lors d’un festival qui leur est dédié, semblent être le symbole de l’abondance destiné à impressionner les clans voisins."
                            },
                            {
                                "example_id": "7b4d0181-601f-4bee-af76-4614c155845d",
                                "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                                "text": "Dans le petit Jardin de la Fontaine, mystérieux et doux sous la pluie fine, des grappes de fleurs étranges dévalaient le long des lianes entres les bananiers et les pandanus."
                            },
                            {
                                "example_id": "221dbb51-d722-454f-827d-72c93fec6c4d",
                                "sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                                "text": "Allez loin de Papeete, là où la civilisation n’est pas venue, là où se retrouvent sous les minces cocotiers, — au bord des plages de corail, — devant l’immense Océan désert, — les districts tahitiens, les villages aux toits de pandanus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01f0a2d3-2a89-467f-ad1e-520bc3d2ef43",
                        "source_entry_id": "b7d6c418-57f5-3759-aae0-12e751d78812",
                        "source_sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                        "target_lang_word": "Schraubenbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schraubenbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e5b8e4d-510e-3759-bd19-51742208fd6f",
                                        "entry_id": "2c50d307-a7f4-3411-81c6-85ac5a709299",
                                        "glosses": [
                                            "eine der vielen, in wärmeren Ländern der Südhalbkugel verbreiteten Baumarten aus der Familie der Schraubenbaumgewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc7881d-5848-4bd4-9e19-dd63057b5e88",
                                                "sense_id": "1e5b8e4d-510e-3759-bd19-51742208fd6f",
                                                "text": "„Der Wind raschelte in den Schraubenbäumen und strich über das kurze Gras; er stöhnte um die Felsen herum und heulte schrill an den Klippen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf4816a-4608-42cd-abde-44c7c28d7633",
                        "source_entry_id": "b7d6c418-57f5-3759-aae0-12e751d78812",
                        "source_sense_id": "d83b40dd-314c-3ae1-89c0-33fc627ce18f",
                        "target_lang_word": "pandanus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pandanus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb115c7b-42f8-3b23-a97e-2bbf782c695e",
                                        "entry_id": "f31d1ea5-c39e-3a1c-84c3-fafae75425e1",
                                        "glosses": [
                                            "Any of various palm-like plants in the genus Pandanus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83c12cf-2bad-4c36-b39a-db67b8411177",
                                                "sense_id": "bb115c7b-42f8-3b23-a97e-2bbf782c695e",
                                                "text": "A girl of fifteen, perhaps, was plaiting pandanus-leaf to make a hat, and an old woman was sitting on her haunches smoking a pipe."
                                            },
                                            {
                                                "example_id": "5b5dfd19-ab32-4006-9e05-31445fe4b1cd",
                                                "sense_id": "bb115c7b-42f8-3b23-a97e-2bbf782c695e",
                                                "text": "Cut the pandanus leaves to fit into the steamer, then place them over the tea towel or muslin cloth. If using pandanus essence, do not add at this stage. Spoon the rice onto the leaves and spread evenly. Steam, covered, over rapidly boiling water for 30 minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
