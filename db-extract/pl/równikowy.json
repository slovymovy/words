                    {
                        "sense_id": "964c47fa-0cad-3612-af79-3e8dd072471b",
                        "entry_id": "81008b77-d3f6-3a08-ae8a-7eb567ecea16",
                        "glosses": [
                            "charakterystyczny dla obszarów znajdujących się w pobliżu równika ziemskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24da2e54-6828-41c3-ad3a-da539004ea57",
                                "sense_id": "964c47fa-0cad-3612-af79-3e8dd072471b",
                                "text": "Uczniowie mają sobie wyobrażać, jak wygląda krajobraz lasu równikowego, sawanny, pustyni, oazy, stepu, wysokich gór, tundry, tajgi, pojezierza, krajobraz przemysłowy, rolniczy, śródziemnomorski i in."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
