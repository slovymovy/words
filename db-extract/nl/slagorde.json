                                        "entry_id": "6106ace4-0094-3fbc-b4ef-5f44b21188e1",
                                        "glosses": [
                                            "The arrangement of units or other divisions of the armed forces in combat; specifically, the deployment plans of an enemy, or a written record of this."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd981a81-7ab3-4ebe-b038-ad00f722518e",
                                                "sense_id": "b48ade85-f2e8-37cd-ae0a-9d64300f7fe9",
                                                "text": "Working for the Resistance, Challe, a regular airman, had skilfully obtained the Luftwaffe order-of-battle on the eve of D-Day and transmitted it to London, for which he was awarded the British D.S.O."
                                            }
                                        ]
                                    }
                                ]
