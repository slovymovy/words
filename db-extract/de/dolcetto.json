                        "glosses": [
                            "eine italienische Rotweinrebe, die vor allen Dingen im Piemont und in Ligurien angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53499f1-ed8c-4f16-9912-ed01148dd20b",
                                "sense_id": "159a5bce-3c67-38b4-a339-d5b7a0c7c023",
                                "text": "„Die Dolcetto-Traube ist für leichte Trinkbarkeit bekannt und wird in der DOC im südöstlichen Piemont erzeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
