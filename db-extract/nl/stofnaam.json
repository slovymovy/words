                    {
                        "sense_id": "c41016ff-06cd-3ebf-b3cf-600f04d223ab",
                        "entry_id": "36a73550-56ea-37a8-8bcc-982daf66cf57",
                        "glosses": [
                            "de officiële generieke naam van een medicament, dit in tegenstelling tot de merknaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79105bcc-dc78-4a5a-892f-b87d8813ef83",
                                "sense_id": "c41016ff-06cd-3ebf-b3cf-600f04d223ab",
                                "text": "Geneesmiddelen moeten op stofnaam worden voorgeschreven en patiënten moeten een juist aantal geneesmiddelen meekrijgen. Want nu wordt niet minder dan 40 procent van de geneesmiddelen gewoon niet gebruikt. In het interview waarschuwt hij ook voor de toename aan supplementen."
                            },
                            {
                                "example_id": "f7d58400-6334-477f-9d66-07113173b1fb",
                                "sense_id": "c41016ff-06cd-3ebf-b3cf-600f04d223ab",
                                "text": "Het gaat om het geneesmiddel Afinitor, dat de stofnaam everolimus draagt. Everolimus wordt toegevoegd aan de al bestaande hormonale therapie van exemestane. Daardoor kan de vaak ingrijpende chemotherapie gemiddeld met 11 maanden worden uitgesteld. Uit de eerste Nederlandse resultaten blijkt dat het middel goed werkt."
                            }
