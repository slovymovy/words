                                            {
                                                "example_id": "ce2a2b53-28f9-49e5-8218-3e87f58f4fb1",
                                                "sense_id": "e18ae3c7-94a6-3196-b936-d9626e476245",
                                                "text": "Der Ritter zog in seiner blanken Rüstung in den Kampf."
                                            },
                                            {
                                                "example_id": "0a44c158-1cd4-4acf-9526-4661bf33af42",
                                                "sense_id": "e18ae3c7-94a6-3196-b936-d9626e476245",
                                                "text": "„Dieser Neubau war das Haus, das jetzt noch stand. Es hatte denselben nüchternen Charakter wie fast alles, was unter dem Soldatenkönig entstand, und war nichts weiter als ein einfaches Corps de logis, dessen zwei vorspringende, bis dicht an den Graben reichende Seitenflügel ein Hufeisen und innerhalb desselben einen kahlen Vorhof bildeten, auf dem, als einziges Schmuckstück, eine große blanke Glaskugel sich präsentierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
                                        "glosses": [
                                            "offen, bloß; klar ersichtlich, rein"
                                        ],
                                        "tags": [
