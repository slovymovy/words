                    "sense_id": "141672df-90ab-3ea6-8be1-1702a9831ed8",
                    "sense_definition": "Испытывать чувство злости, раздражения или гнева по отношению к кому-либо или чему-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не нужно <злиться> на друга из-за такой мелочи.",
                            "target_lang_translations": {
                                "en": "There is no need <to get angry> at a friend over such a trifle.",
                                "nl": "Je hoeft niet <boos te worden> op een vriend om zo'n kleinigheid.",
                                "pl": "Nie trzeba <w>złościć się</w> na przyjaciela o taką błahostkę.",
                                "fr": "Il ne faut pas <se fâcher> contre un ami pour une telle broutille.",
                                "de": "Man muss wegen einer solchen Kleinigkeit nicht auf einen Freund <böse sein>.",
                                "es": "No hay por qué <enojarse> con un amigo por una tontería así.",
                                "it": "Non c'è bisogno di <arrabbiarsi> con un amico per una sciocchezza del genere.",
                                "tr": "Böyle bir önemsiz şey yüzünden arkadaşına <kızmana> gerek yok.",
                                "cs": "Není třeba se na kamaráda <zlobit> kvůli takové maličkosti."
                            }
                        },
                        {
                            "text": "Я начинаю <злиться>, когда автобус долго не приходит.",
                            "target_lang_translations": {
                                "en": "I start <to get angry> when the bus takes a long time to arrive.",
                                "nl": "Ik begin <me te ergeren> als de bus lang wegblijft.",
                                "pl": "Zaczynam się <w>złościć</w>, kiedy autobus długo nie przyjeżdża.",
                                "fr": "Je commence à <m'énerver> quand le bus met du temps à arriver.",
                                "de": "Ich fange an, <mich zu ärgern>, wenn der Bus lange nicht kommt.",
                                "es": "Empiezo a <enfadarme> cuando el autobús tarda mucho en llegar.",
                                "it": "Inizio ad <arrabbiarmi> quando l'autobus ci mette molto ad arrivare.",
                                "tr": "Otobüs uzun süre gelmeyince <sinirlenmeye> başlıyorum.",
                                "cs": "Začínám se <vztekat>, když autobus dlouho nejede."
                            }
                        }
                    ],
                    "synonyms": [
                        "серди́ться",
                        "раздражаться"
                    ],
                    "common_phrases": [
                        "злиться на себя",
                        "злиться на весь мир",
                        "злиться из-за пустяков"
                    ],
                    "target_lang_definitions": {
                        "en": "To feel anger, irritation, or rage towards someone or something.",
                        "nl": "Boosheid, irritatie of woede voelen tegenover iemand of iets.",
                        "pl": "Odczuwać złość, irytację lub gniew w stosunku do kogoś lub czegoś.",
                        "fr": "Éprouver de la colère, de l'irritation ou de l'énervement envers quelqu'un ou quelque chose.",
                        "de": "Gefühle von Wut, Ärger oder Zorn gegenüber jemandem oder etwas empfinden.",
                        "es": "Sentir enfado, irritación o ira hacia alguien o algo.",
                        "it": "Provare un sentimento di rabbia, irritazione o collera verso qualcuno o qualcosa.",
                        "tr": "Birine veya bir şeye karşı öfke, kızgınlık veya hiddet hissetmek.",
                        "cs": "Pociťovat hněv, podráždění nebo vztek vůči někomu nebo něčemu."
