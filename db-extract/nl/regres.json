                                                "sense_id": "13df0ddd-000b-31ea-9c9f-86c02346f910",
                                                "text": "[…] the flame departing and recoursing thrice ere the wood took strength to be sharper to consume […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1d572b-8ab5-3754-b765-e4a7eaf0c634",
                                        "entry_id": "b4a8c047-303a-3cde-9e4c-f2be38d42543",
                                        "glosses": [
                                            "To have recourse; to resort."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e810b44c-a579-4764-af39-8172aca138da",
                                                "sense_id": "2a1d572b-8ab5-3754-b765-e4a7eaf0c634",
                                                "text": "Recoursing deuoutlie to the onlie refuge of humane saluation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374b1c51-a69c-4aec-9c67-52c263c7d855",
                        "source_entry_id": "6b7b70ea-700a-3876-97ac-69b4cc00df72",
                        "source_sense_id": "fdc80b40-e952-3a4a-a566-86ef175f3365",
