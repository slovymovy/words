{
    "word_family": [
        "ciseau",
        "ciseleur",
        "ciselure",
        "ciselet"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8cf6559d-0a30-3b20-a521-d9508c94d1f4",
                    "sense_definition": "Couper très finement des herbes aromatiques, des oignons ou des échalotes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier commence par <w>ciseler</w> des herbes fraîches pour assaisonner la salade."
                        },
                        {
                            "text": "Elle <w>cisèle</w> une échalote avant de la faire revenir doucement à la poêle."
                        }
                    ],
                    "synonyms": [
                        "émincer",
                        "hacher"
                    ],
                    "common_phrases": [
                        "ciseler des herbes",
                        "ciseler une échalote"
                    ]
                },
                {
                    "sense_id": "e1d47d22-64ba-3a2b-893a-e37029d36a6a",
                    "sense_definition": "Travailler ou orner un métal ou une pierre à l'aide d'un ciseau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orfèvre prend tout son temps pour <w>ciseler</w> l'argent d'un calice précieux."
                        },
                        {
                            "text": "L'artisan <w>ciselait</w> chaque détail de la poignée en bronze avec une patience infinie."
                        }
                    ],
                    "synonyms": [
                        "graver",
                        "sculpter"
                    ],
                    "common_phrases": [
                        "ciseler le métal",
                        "ciseler l'argent"
                    ]
                },
                {
                    "sense_id": "23e99eff-8153-38d6-ae0a-d24b02f1916b",
                    "sense_definition": "Soigner les détails d'un écrit ou d'une œuvre avec une grande précision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète passe des heures à <w>ciseler</w> des vers parfaits pour son nouveau recueil."
                        },
                        {
                            "text": "L'auteur <w>cisèle</w> son style afin de rendre son discours percutant et élégant."
                        }
                    ],
                    "synonyms": [
                        "fignoler",
                        "peaufiner"
                    ],
                    "antonyms": [
                        "bâcler"
                    ],
                    "common_phrases": [
                        "ciseler des vers",
                        "ciseler son style"
                    ]
                },
                {
                    "sense_id": "f2a3c36a-0867-3124-9fb4-e614ca6b4d59",
                    "sense_definition": "Pratiquer des incisions superficielles sur une viande ou un poisson pour en réguler la cuisson.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut d'abord <w>ciseler</w> un poisson sur les deux faces avant de le griller."
                        },
                        {
                            "text": "Le chef <w>cisela</w> la peau du canard pour permettre à la graisse de s'échapper."
                        }
                    ],
                    "synonyms": [
                        "inciser",
                        "entailler"
                    ],
                    "common_phrases": [
                        "ciseler un poisson"
                    ]
                },
                {
                    "sense_id": "026ff514-01e6-31a2-9ab5-5980f58302fa",
                    "sense_definition": "Découper une étoffe ou du velours à l'aide de petits ciseaux pour y former des motifs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière venait de <w>ciseler</w> du velours pour créer un motif floral délicat."
                        },
                        {
                            "text": "On <w>ciselait</w> jadis les tissus précieux afin d'orner les vêtements d'apparat."
                        }
                    ],
                    "synonyms": [
                        "découper"
                    ],
                    "common_phrases": [
                        "ciseler du velours"
                    ]
                },
                {
                    "sense_id": "9ec1b746-6349-336d-8b7f-1df2f9ada039",
                    "sense_definition": "Éliminer les grains de raisin abîmés ou trop denses d'une grappe à l'aide de ciseaux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les viticulteurs prenaient le temps de <w>ciseler</w> le raisin pour aérer les grappes."
                        },
                        {
                            "text": "Elle <w>ciselait</w> chaque grappe avec soin pour ne conserver que les plus beaux fruits."
                        }
                    ],
                    "synonyms": [
                        "éclaircir"
                    ],
                    "common_phrases": [
                        "ciseler le raisin"
                    ]
                }
            ]
        }
    ]
}