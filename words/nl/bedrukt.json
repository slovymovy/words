                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "feeling distressed or pessimistic"
                            },
                            {
                                "target_lang_word": "heavy",
                                "target_lang_sense_clarification": "referring to an atmosphere or mood"
                            }
