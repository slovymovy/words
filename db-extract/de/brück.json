                ],
                "senses": [
                    {
                        "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                        "entry_id": "4d8423f0-4d19-324e-a953-ee8262936e80",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d043f7a-4121-42ad-9a08-5eae5cce0b94",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Frau Brück ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "65f4771a-3379-44cb-82cc-d44e2b59bd72",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Herr Brück wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bf66cf92-3abe-4613-8feb-a7c50d158f93",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Die Brücks fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "c060ec5e-ea87-4953-992f-d051f68aea05",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Der Brück trägt nie die Pullover, die die Brück ihm strickt."
                            },
                            {
                                "example_id": "0553e91a-ba9b-4173-98e5-6a248f0b3584",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brück kommt, geht der Herr Brück.“"
                            },
                            {
                                "example_id": "953d49d7-d01a-42b3-b55a-9004a776a20b",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Brück kommt und geht."
                            },
                            {
                                "example_id": "828613a9-bc09-42b8-af1e-71da240bd426",
                                "sense_id": "2de47158-3ae0-3c3b-8a78-273ba7ab9cf0",
                                "text": "Brücks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
