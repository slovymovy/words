            {
                "entry_id": "3ef935c4-7983-3ab1-8576-f38561a6c8c4",
                "word": "has-been",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1835930a-4312-4523-aed1-462126ed77b8",
                        "entry_id": "3ef935c4-7983-3ab1-8576-f38561a6c8c4",
                        "tags": [
