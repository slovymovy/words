                                        "glosses": [
                                            "auf die Zeit Napoleons I. bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f7622b-3c6f-423c-93ad-3bdb69e08968",
                                                "sense_id": "0267d423-d3d1-380a-8331-eac47b0f467e",
                                                "text": "„Die sogenannte Völkerschlacht vom 16. bis 19. Oktober 1813 machte während der napoleonischen Kriege von 1813 bis 1815 die Handelsstadt [Leipzig] zum Schauplatz der bis dahin größten Schlacht der europäischen Geschichte.“"
                                            },
                                            {
                                                "example_id": "e6a1ffcb-d50b-48ed-a355-19ce56aa3a09",
                                                "sense_id": "0267d423-d3d1-380a-8331-eac47b0f467e",
                                                "text": "„Das Gesicht war faltig wie ein alter polnischer Tabaksbeutel aus dem napoleonischen Krieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
