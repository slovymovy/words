                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fomalhaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "256eaa19-4a18-3b6a-a543-53719f4e8dc4",
                                        "entry_id": "c431dfc8-ef86-31cf-81f2-65928f97b430",
                                        "glosses": [
                                            "hellster Stern im Sternbild Südlicher Fisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6db84e7-0496-4960-a042-904961173178",
                                                "sense_id": "256eaa19-4a18-3b6a-a543-53719f4e8dc4",
                                                "text": "„Fische sind als Sternbild des Tierkreises bekannt, am Himmel aber sind sie unscheinbar. Viel auffälliger ist der Südliche Fisch, den kaum jemand kennt. In unseren Breiten fällt vor allem der Stern Fomalhaut auf. Sein Name bedeutet „Maul des Fisches“.“"
                                            },
                                            {
                                                "example_id": "ce82e17d-6699-4eed-9e02-0de8bf6236d8",
                                                "sense_id": "256eaa19-4a18-3b6a-a543-53719f4e8dc4",
                                                "text": "„Über dem Horizont funkelte der Fomalhaut wie ein Auge, das einen vom Weltraum aus beobachtete, und allmählich munkelte man auch andernorts über merkwürdige Vorkommnisse, die sich rings um Gloucestershire und den Severn häuften.“"
                                            },
                                            {
                                                "example_id": "4c0dbcc9-c97e-4251-a513-82db48198614",
                                                "sense_id": "256eaa19-4a18-3b6a-a543-53719f4e8dc4",
                                                "text": "„Für immer wirst du hier auf Fomalhaut verweilen; wo die Flammen sich kräuseln und zu den Rhythmen des Universums durch unermeßliche Räume fließen; wo sich Planeten durch unbeschreibliche Feuerräder bewegen und diese umkreisen, gebunden an das Räderwerk des Chaos der Lebenden Flamme.“"
                                            },
                                            {
                                                "example_id": "f1e8e557-9e1a-4c29-93bc-cd76c568e5ba",
                                                "sense_id": "256eaa19-4a18-3b6a-a543-53719f4e8dc4",
                                                "text": "„›Dann will ich aber wissen, wer oder was tief unter der Erde in tiefster Nacht umgeht, wenn Fomalhaut aufgegangen ist und die Hyaden im Osten stehen!‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
