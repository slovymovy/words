                "senses": [
                    {
                        "sense_id": "612defed-367d-3b41-8342-2ee664aeb675",
                        "entry_id": "b1399d1d-4a6b-30e2-9300-41ee1d0ed96f",
                        "glosses": [
                            "Direction technique nationale, en responsabilité d’un sport donné au niveau national."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd165f99-92be-435e-ae06-23674b4797b1",
                                "sense_id": "612defed-367d-3b41-8342-2ee664aeb675",
                                "text": "Éric Blahic quitte la DTN"
                            },
                            {
                                "example_id": "a333135c-b9d0-439b-8bde-9637090209b6",
                                "sense_id": "612defed-367d-3b41-8342-2ee664aeb675",
                                "text": "La DTN joue un rôle majeur dans la formation des jeunes (Pôles espoirs) et des entraîneurs de haut niveau (stages à Clairefontaine) et dans la définition du style de jeu (et de joueurs) à promouvoir."
                            },
                            {
                                "example_id": "68da0593-8233-40a9-af84-cbb6acbbd935",
                                "sense_id": "612defed-367d-3b41-8342-2ee664aeb675",
                                "text": "Pour obtenir le brevet d’entraîneur formateur de football (BEFF) et le brevet d’entraîneur professionnel de football (BEPF), il faut passer par une formation dispensée par les membres de la DTN à Clairefontaine."
                            }
                        ]
                    }
