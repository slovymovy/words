                        "glosses": [
                            "The largest of the five moons of Pluto."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25fd7142-79f9-4ce8-933b-dc2423814c6a",
