                        "sense_id": "006e8b01-b176-34bb-92d7-c6129fc02dfc",
                        "entry_id": "14de35a7-a8f1-369f-821e-dddcb4910f4d",
                        "glosses": [
                            "Qui émet un son rappelant un ululement."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "940138ba-2946-4734-8dc3-731187734da8",
                                "sense_id": "006e8b01-b176-34bb-92d7-c6129fc02dfc",
                                "text": "Les gens qui ne connaissent pas cette lande perdue ne savent pas ce qu’est le silence : il cerne la maison, comme solidifié dans cette masse épaisse de forêt où rien ne vit, hors parfois une chouette ululante (nous croyons entendre, dans la nuit, le sanglot que nous retenions)."
                            },
                            {
                                "example_id": "6196cc96-b3c2-46fe-b77b-40401673611d",
                                "sense_id": "006e8b01-b176-34bb-92d7-c6129fc02dfc",
                                "text": "Le violon est confronté à des sonorités de xylophone ululant et de piano, préparé façon gong, ainsi que de cloches."
                            }
                        ]
                    }
