                        "glosses": [
                            "Personne appartenant au peuple massachusett, Algonquiens de la baie du Massachusetts parlant le massachusett."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a18f1e-cfe8-4048-ade4-706b09716c23",
                                "sense_id": "f55a47f2-ff55-39ec-86ec-6ae964ad5d89",
                                "text": "Après quoi, ils reprirent leur voyage chez les Massachusetts, firent de bonne affaires et rentrèrent sains et saufs, Dieu soit loué."
                            },
                            {
                                "example_id": "080ddb9c-16c3-43c0-8c69-423199099775",
                                "sense_id": "f55a47f2-ff55-39ec-86ec-6ae964ad5d89",
                                "text": "Les colons furent, d’abord, en bons rapports avec les Massachusetts."
                            }
                        ]
                    }
                ],
