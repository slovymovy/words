                "senses": [
                    {
                        "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                        "entry_id": "63ca70e4-6614-32aa-85e8-10eb4c6c7e34",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07af95b7-520e-4b14-bbaa-a797ae974c45",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Speckle kommt und geht."
                            },
                            {
                                "example_id": "d20e622c-85d1-44df-a766-ac55ec759fb0",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Speckles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "304088ba-8714-453a-ade0-b3d1b83598fd",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Speckle kommt, geht der Herr Speckle.“"
                            },
                            {
                                "example_id": "b4c62454-39c3-4a96-8144-f36fdc27f663",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Frau Speckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "08fe1fbf-ebb0-4494-b1a6-1bb039edee1a",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Herr Speckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3896e4e-199c-4fce-8649-b64f7e74a54d",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Die Speckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1cd1d684-0416-41e7-8c07-2ce8b52e6279",
                                "sense_id": "de2130fe-4094-3868-80b1-e4cc735f57fd",
                                "text": "Der Speckle trägt nie die Schals, die die Speckle ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
