                ],
                "senses": [
                    {
                        "sense_id": "5ade31ef-5c4b-3b4d-8825-af8521f33ebf",
                        "entry_id": "0b9d96a3-950b-315b-8e80-0a2bcdcf73f3",
                        "glosses": [
                            "drunken revelry, drinking bout, bender"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0be32e27-5f27-4fc4-9a98-08a70f9ecb19",
                                "sense_id": "5ade31ef-5c4b-3b4d-8825-af8521f33ebf",
                                "text": "Вме́сто ти́хой жи́зни труда́ она́ нашла́ бу́рное существова́ние, напо́лненное бесконе́чными кутежа́ми, на́глым цини́змом и беспоря́дочною, ни к чему́ не приводя́щею суето́ю.",
                                "translation": "Instead of a quiet life of toil, she had embarked on a boisterous existence filled with unending revelry, shameless indecency, and a chaotic round of activity that led nowhere.",
                                "english": "Instead of a quiet life of toil, she had embarked on a boisterous existence filled with unending revelry, shameless indecency, and a chaotic round of activity that led nowhere."
                            }
                        ]
                    }
                ],
