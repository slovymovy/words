                            "comment": "Vaak in de context van geld witwassen gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To give illegally obtained money or goods a legal origin; to launder."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "launder",
                                "target_lang_sense_clarification": "to launder money or assets"
                            },
                            {
                                "target_lang_word": "whitewash",
                                "target_lang_sense_clarification": "colloquial term for laundering money"
                            }
                        ]
                    }
                }
