                        ]
                    },
                    {
                        "translation_id": "39426a79-e77d-47c7-89a6-cab0f0d9358d",
                        "source_entry_id": "9f36a737-d87e-370d-9ede-aa982d7c9b20",
                        "source_sense_id": "e140d52f-27b8-3252-a357-d09b6dc494ad",
                        "source_sense_description": "jährlichr Filmpreis der amerikanischen Academy of Motion Picture Arts and Sciences",
                        "target_lang_word": "Academy Award",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Academy Award",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                        "entry_id": "891b2295-f489-37b4-ac2f-1599271ee585",
                                        "glosses": [
                                            "An award in any of various fields related to moviemaking, most prominently acting, generally awarded at a televised gala to winners who then speak; commonly used to indicate a person has been lying with great skill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b9e775-3dea-4b54-83f8-edcd24c9b2ea",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "Lola's performance was academy award standard."
                                            },
                                            {
                                                "example_id": "67301345-36e3-4243-b56e-95fca8c60fc4",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "They still make each other smile and they each brag about how smart and talented and wise and tender the other one is and how lucky each is to have met the other and they actually look happy and if it's a front then I say both of them deserve Academy Awards for their splendid performances."
                                            },
                                            {
                                                "example_id": "4d88c11b-48f6-48f9-adec-d86e82ded3ac",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "\"Our drawing-room furniture and the corner cupboard will be lovely in this room,\" Tess had purred. \"And we could have the Turner over the mantelpiece; over the Adam fireplace. It would look lovely.\"\nThe agent got hopeful. He particularly liked people who talked about drawing rooms.\n\"You ought to get an Academy Award,\" Ronnie told her later. \"Bloody Academy Award you should have. Effing marvelous.\""
                                            },
                                            {
                                                "example_id": "5444de18-8f56-456b-9455-9f415b13d43f",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "Mrs. Malloy's innocent expression merited an Academy Award."
                                            },
                                            {
                                                "example_id": "11bfb527-6ce0-4a9a-a772-b207e50996f1",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "'You were a geisha?' she breathed. If her interest was feigned, she deserved an Academy Award."
                                            },
                                            {
                                                "example_id": "a387bc5e-8aa3-40c4-b672-3e9b3f65ef26",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "Although Emily had the figure and the bearing to pull off an Academy Award–red carpet–worthy dress, she'd selected something a little more sedate[.]"
                                            },
                                            {
                                                "example_id": "4daafdc9-90f6-46c2-bdc1-48b0992fcc30",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "Going limp and lying still works well for many animals, but a few species deserve Academy Awards for their death-feigning skills."
                                            },
                                            {
                                                "example_id": "94ab62cf-ce95-4e18-a559-083f3ad30670",
                                                "sense_id": "a87b82c9-710c-31d1-a287-748d2f77c207",
                                                "text": "Finally Ms. Dorchester announced that she was calling the defendant, Preston Oliver, to the stand. You'd have thought she was going to give him an Academy Award the way she escorted him to the box. he certainly deserved one. He'd sat at the defense table all day smirking or looking bored out of his mind, but the minute he hit the witness stand, he was the portrait of a concerned citizen, just there to do the right thing. You'd never have known he was on trial for a felony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ceb0d22-c430-4d65-a703-e7a67c6f0389",
