                    {
                        "sense_id": "4669fadc-6e68-35d6-acef-cbe47df7842d",
                        "entry_id": "3ecf619a-1ec0-329c-9c7c-dfd569984fba",
                        "glosses": [
                            "Festlegung/Durchsetzung einer Norm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32632100-56e9-455b-93d2-ef0ab9f1c416",
                                "sense_id": "4669fadc-6e68-35d6-acef-cbe47df7842d",
                                "text": "„Der Wunsch vieler Schreiber und Sprecher nach Normierung und damit Orientierung muss als wichtiges Bedürfnis wahrgenommen und akzeptiert werden.“"
                            },
                            {
                                "example_id": "66239c66-a295-4701-8214-d50cfdaf9ed6",
                                "sense_id": "4669fadc-6e68-35d6-acef-cbe47df7842d",
                                "text": "„Da das Konstrukt im Vergleich zur Objektsprache immer reduktionistisch ist, weil es aus dem empirisch beobachtbaren Ausgangsmaterial nur das als usuell Nachweisbare herausdestilliert, bedeutet dies zumindestens eine Standardisierung nach dem Kriterium üblich/nicht üblich, wenn nicht gar eine Normierung nach dem Gesichtspunkt richtig/falsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
