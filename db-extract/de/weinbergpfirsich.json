                ],
                "senses": [
                    {
                        "sense_id": "e6490909-d72e-30f9-a31f-2a6c2c564318",
                        "entry_id": "1b3a9a36-1a8d-36bc-8521-39366e66f65f",
                        "glosses": [
                            "die Frucht eines kleinwüchsigen Pfirsichbaumes, der oft als Begleiter der Weinrebe in Weinbergen steht oder auch der Baum selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f281ed-e196-4250-a1f1-8382c5802344",
                                "sense_id": "e6490909-d72e-30f9-a31f-2a6c2c564318",
                                "text": "Ich esse sehr gerne Weinbergpfirsiche."
                            },
                            {
                                "example_id": "94b13bf3-80ba-4e8d-bc16-62e9b041ab70",
                                "sense_id": "e6490909-d72e-30f9-a31f-2a6c2c564318",
                                "text": "„Der Weinbergpfirsich ist eine sehr aromatische weiße oder gelbliche Pfirsichsorte."
                            },
                            {
                                "example_id": "0a706106-e2d9-419d-ac91-e8eb411700b7",
                                "sense_id": "e6490909-d72e-30f9-a31f-2a6c2c564318",
                                "text": "„Der kleinwüchsige rote Weinbergpfirsich lockt Nützlinge an und schmeckt vorzüglich zum Dessert, als Marmelade und hochprozentig flüssig.“"
                            },
                            {
                                "example_id": "f6dc64ff-298a-4324-b980-84cc187b41f3",
                                "sense_id": "e6490909-d72e-30f9-a31f-2a6c2c564318",
                                "text": "„Als in den 195oer- und 196oer- Jahren an der Mosel der Obstanbau mehr und mehr aufgegeben wurde, gingen auch die Baumbestände der Weinbergpfirsiche drastisch zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f715a4df-926e-46e8-866d-7053b88b9111",
