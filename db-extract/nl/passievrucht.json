                                    {
                                        "sense_id": "8eab3404-ffe2-337d-a9c7-fbd63156ddff",
                                        "entry_id": "9aaaf198-6885-3b88-bad5-08d0011bfa3b",
                                        "glosses": [
                                            "Fruit de la grenadille ou fleur de la passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54389599-7ba0-4439-8b39-f9c8ca9d287f",
                                                "sense_id": "8eab3404-ffe2-337d-a9c7-fbd63156ddff",
                                                "text": "Dans son bouquet tertiaire apparaîtront des arômes suaves de kumquat confit, de fruit de la passion, d’épices douces et d’amande grillée, toujours sur le fond citronné ma foi assagi."
                                            },
                                            {
                                                "example_id": "89d545e6-073b-41ac-b92b-fd3e1b211608",
                                                "sense_id": "8eab3404-ffe2-337d-a9c7-fbd63156ddff",
                                                "text": "Coupez les fruits de la passion et les tranches d’ananas en deux. Détaillez la chair de la mangue en cubes. Répartissez harmonieusement les fruits sur 4 feuilles de papier sulfurisé grassement beurrées."
                                            },
                                            {
                                                "example_id": "9e0ce0ca-b4d8-4edb-a0fd-76f68ec33686",
                                                "sense_id": "8eab3404-ffe2-337d-a9c7-fbd63156ddff",
                                                "text": "Une fois de temps en temps, j’aime remplacer le jus d’un citron par celui de deux ou trois fruits de la passion bien mûrs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d08b89-8585-372d-9238-bf300e85e2c9",
                                        "entry_id": "9aaaf198-6885-3b88-bad5-08d0011bfa3b",
                                        "glosses": [
                                            "Vulve."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc393fe2-b874-4d5a-b9bb-0939c5f1e878",
                                                "sense_id": "b0d08b89-8585-372d-9238-bf300e85e2c9",
                                                "text": "« Tiens, voilà ton étalon\nQui enlève son pantalon\nEt c'est avec émotion\nQue je touche au fruit de la passion »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
