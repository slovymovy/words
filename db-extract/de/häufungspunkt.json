                "senses": [
                    {
                        "sense_id": "dfa6361f-9a38-365c-be64-faf1432de1d6",
                        "entry_id": "2f8c7e4d-5384-38d3-85d9-005a97c69b06",
                        "glosses": [
                            "0-dimensionales Objekt oder Zahlenwert, in dessen beliebig kleinen Umgebungen unendlich viele Elemente einer Menge oder Glieder einer Folge liegen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428747c4-e63c-4b8a-8ea3-903262afd6d4",
                                "sense_id": "dfa6361f-9a38-365c-be64-faf1432de1d6",
                                "text": "„[Der Satz von Bolzano-Weierstraß] garantiert die Existenz von Häufungspunkten bei beschränkten Folgen und wird oft verwendet, um die Existenz von Grenzwerten oder Häufungspunkten zu zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d88ce25a-790a-4aa4-b8cd-a7489c0174b1",
                        "source_entry_id": "2f8c7e4d-5384-38d3-85d9-005a97c69b06",
                        "source_sense_id": "dfa6361f-9a38-365c-be64-faf1432de1d6",
                        "target_lang_word": "limit point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limit point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "924de55c-2106-3efc-87aa-fa6923ee0f4e",
                                        "entry_id": "a31435f7-040a-3544-805d-9f42d10d60f0",
                                        "glosses": [
                                            "Given a subset S of a given topological space T, any point p whose every neighborhood contains some point, distinct from p, which belongs to S."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5a8c59-c9d3-4e69-bd9e-f13ff4080a60",
                                                "sense_id": "924de55c-2106-3efc-87aa-fa6923ee0f4e",
                                                "text": "is an example of a function having infinitely many essential singularities with a limit point at z=0. It is an easy matter to give examples of \"elementary\" functions whose singularities have a countable number of limit points."
                                            },
                                            {
                                                "example_id": "44a4dfe7-1bef-4a98-99db-95ec2bb7d504",
                                                "sense_id": "924de55c-2106-3efc-87aa-fa6923ee0f4e",
                                                "text": "If z_0 is a limit point of S, then every ϵ-neighborhood of z_0 must contain infinitely many points of S."
                                            },
                                            {
                                                "example_id": "df85fc54-7986-410c-ae7a-daf7b351825d",
                                                "sense_id": "924de55c-2106-3efc-87aa-fa6923ee0f4e",
                                                "text": "As the next example shows, the set of zeros may well have a limit point not belonging to the domain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
