                                ]
                            },
                            {
                                "target_word": "filling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc77b6c0-c0c8-3bb0-b46b-09cea68b4508",
                                        "entry_id": "994a0b28-b1b6-32a5-acd8-2087de5c6f3a",
                                        "glosses": [
                                            "Of food, that satisfies the appetite by filling the stomach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40146994-e13c-4118-97b0-b95df4dfb700",
                                                "sense_id": "cc77b6c0-c0c8-3bb0-b46b-09cea68b4508",
                                                "text": "a filling meal"
                                            },
                                            {
                                                "example_id": "6ec300e9-2468-4e05-93a6-338ca4f039a6",
                                                "sense_id": "cc77b6c0-c0c8-3bb0-b46b-09cea68b4508",
                                                "text": "We had oatmeal porridge for breakfast, which was fairly filling, but I always starved at lunch and dinner. My friend continually reasoned with me to eat meat, but I always pleaded my vow and then remained silent."
                                            },
                                            {
                                                "example_id": "73d6cbe2-970b-4788-af89-b0b912a50b17",
                                                "sense_id": "cc77b6c0-c0c8-3bb0-b46b-09cea68b4508",
                                                "text": "Plain and unexciting, perhaps, but they are solid, well cooked, appetising and filling, and moreover cheap."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "filling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da2139e-f9ff-3f4f-8924-64ac3d61177a",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "Anything that is used to fill something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44fd0b09-66ac-3c52-8d8c-4ab6d2d2a7db",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "The contents of a pie, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f2c1d35-6938-3643-af74-1ee6b0db4814",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "Any material used to fill a cavity in a tooth or the result of using such material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d580669b-3cfd-4af4-8604-7025ef639f85",
                                                "sense_id": "4f2c1d35-6938-3643-af74-1ee6b0db4814",
                                                "text": "I will be using a rapid-setting cement filling."
                                            },
                                            {
                                                "example_id": "9c20e29a-f498-4ea4-87ff-155f7ed88eb4",
                                                "sense_id": "4f2c1d35-6938-3643-af74-1ee6b0db4814",
                                                "text": "My temporary filling fell out and got lost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2223ea1-6999-3ea8-add5-e6f63e235f1c",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "The woof in woven fabrics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a520ee5-7155-38e9-8832-25a6a7441946",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "Prepared wort added to ale to cleanse it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adaa5d28-768c-3feb-92e4-6d306dd0c026",
                                        "entry_id": "8a353ec9-e41e-3026-b516-a7de7b8f9f3b",
                                        "glosses": [
                                            "A religious experience attributed to the Holy Ghost \\\"filling\\\" a believer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6670448-3a72-4f67-aac7-39f9d2f034e0",
                                                "sense_id": "adaa5d28-768c-3feb-92e4-6d306dd0c026",
                                                "text": "1903, William Edward Biederwolf, A Help to the Study of the Holy Spirit, James H. Earle & Company (publ.), page 100.\nAs learned Dr. Hodge has reminded us, any impartation of the Holy Spirit is a baptism, and certainly, apart from biblical phraseology, a filling with the Spirit may be called a baptism with the Spirit."
                                            },
                                            {
                                                "example_id": "b8045c20-514e-49a4-8a2d-7aa6caf46343",
                                                "sense_id": "adaa5d28-768c-3feb-92e4-6d306dd0c026",
                                                "text": "All these terms referencing the work of the Holy Spirit—coming upon, falling upon, being filled with the Holy Spirit, receiving the promise of the Father—can best be understood as synonymous with baptism in the Holy Spirit, with the key to understanding being “one baptism, many fillings.”"
                                            },
                                            {
                                                "example_id": "8c13571a-53fa-4773-a9fb-7abf099676f5",
                                                "sense_id": "adaa5d28-768c-3feb-92e4-6d306dd0c026",
                                                "text": "Other signs followed their subsequent fillings with the Holy Spirit, but the first filling was immediately followed by the speaking in other tongues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee3cbc06-da42-4c7f-bbd6-0173e661411e",
                        "source_entry_id": "0ca04ab1-246f-3998-9321-00a82f3d1567",
                        "source_sense_id": "602de7ab-1527-3dbd-a192-96ce52e2336d",
                        "target_lang_word": "weft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00db51b7-3ccf-34fb-85ca-44472b4ed165",
                                        "entry_id": "94ceead1-26c7-33d2-8580-e32cd8011aca",
                                        "glosses": [
                                            "The horizontal threads that are interlaced through the warp in a woven fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3423a888-fa7f-4445-a5ba-1ce55edc2744",
                                                "sense_id": "00db51b7-3ccf-34fb-85ca-44472b4ed165",
                                                "text": "It is all the more remarkable therefore that in one respect — weft colours — some of the pirnless looms are more versatile than conventional machines. Figure 6 shows the colour mechanism of a conventional loom designed to weave six colours of weft (there is never any problem about colour patterning in the warp)."
                                            },
                                            {
                                                "example_id": "57d1984d-d56a-42b4-a420-098ace698ec8",
                                                "sense_id": "00db51b7-3ccf-34fb-85ca-44472b4ed165",
                                                "text": "Other techniques for shaping included angling one or both loom bars, adding extra wefts, or adjusting warp tension."
                                            },
                                            {
                                                "example_id": "d12fe87c-4e36-4d5b-b058-00a15cb465d8",
                                                "sense_id": "00db51b7-3ccf-34fb-85ca-44472b4ed165",
                                                "text": "1993, Anni Albers, On Weaving, note on Plate 17, page 48,\nTo give greater firmness to the basket-weave plain weave, thin weft threads can be introduced that will be covered by the heavier pattern wefts of the basket weave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7437e1-1a90-35e7-9f32-8a8e6cac623f",
                                        "entry_id": "94ceead1-26c7-33d2-8580-e32cd8011aca",
                                        "glosses": [
                                            "The yarn used for the weft; the fill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06e97499-68d8-392c-afdc-6b0073d66745",
                                        "entry_id": "94ceead1-26c7-33d2-8580-e32cd8011aca",
                                        "glosses": [
                                            "A hair extension that is glued directly to a person′s natural hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2344cc51-6a5d-4793-963c-dc0833abda48",
                                                "sense_id": "06e97499-68d8-392c-afdc-6b0073d66745",
                                                "text": "Teaching tools include mannequins, slip-ons, hair wefts, rectangles, and profiles."
                                            },
                                            {
                                                "example_id": "3b4ed7d5-6353-477d-aba0-62eaa9966ca7",
                                                "sense_id": "06e97499-68d8-392c-afdc-6b0073d66745",
                                                "text": "Then, she held up the hair as it would look on my head. She positioned it like a pro, holding wefts of human hair so that it looked like it grew from my scalp."
                                            },
                                            {
                                                "example_id": "02f28b1f-9142-4a1a-8c74-9bc78880d69b",
                                                "sense_id": "06e97499-68d8-392c-afdc-6b0073d66745",
                                                "text": "In the bonding method of attaching hair extensions, hair wefts or single strands are attached with an adhesive or bonding agent. The adhesive is applied to the weft with an applicator gun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd13f8c2-1d4c-3c39-970b-186ca40107fa",
                                        "entry_id": "9ff24dc0-21bc-30ba-9705-d53a7790f2d9",
                                        "glosses": [
                                            "Alternative spelling of waif."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3e41e6-33a3-4b34-b422-ff77c9ae517d",
                                                "sense_id": "fd13f8c2-1d4c-3c39-970b-186ca40107fa",
                                                "text": "The gentle Lady, loose at randon left, / The greene-wood long did walke, and wander wide / At wilde aduenture, like a forlorne weft,"
                                            },
                                            {
                                                "example_id": "cb0cc233-e0e3-46e0-8187-0eab915190db",
                                                "sense_id": "fd13f8c2-1d4c-3c39-970b-186ca40107fa",
                                                "text": "[Y]ou are Lord o'the ſoyle Sir, Lilly is a Weft, a Stray, ſhee's yours, to uſe Sir, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
