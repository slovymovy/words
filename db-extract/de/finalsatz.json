                        "glosses": [
                            "Gliedsatz, speziell Adverbialsatz, der Ziel oder Zweck einer Handlung nennt."
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "84d46e79-1b0f-4208-b363-6d13e7229ffb",
                                "sense_id": "caa2918e-d47e-3bf2-ad48-ab7683fa25c4",
                                "text": "In dem Satz „Ich komme, damit ich dir helfen kann“ ist der Gliedsatz „damit ich dir helfen kann“ ein Finalsatz; er gibt Ziel oder Zweck der Handlung an. Viele Finalsätze werden mit „damit“ eingeleitet."
                            }
                        ],
