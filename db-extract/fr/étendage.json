            {
                "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                "word": "étendage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "497dfed3-7a52-4042-8a57-7f75121af1a4",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "tags": [
                            "plural"
                        ],
                        "form": "étendages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "glosses": [
                            "Action d’étendre en vue de faire sécher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8b355a-0cfc-4075-bcf9-fa39cd141c44",
                                "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                                "text": "Procéder à l’étendage du linge."
                            },
                            {
                                "example_id": "4c071e79-169a-4496-8c6e-a1ff15365e7d",
                                "sense_id": "d9ac8561-c0dc-3d58-aafa-b1eaa6cc0f2a",
                                "text": "Sylvie monte avec Roberto la séquence de l’étendage du linge pendant que j’essaye de me sortir du tatouage des « indiens » et de la visite du flic au gymnase."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "glosses": [
                            "Assemblage de cordes tendues horizontalement, sur lesquelles on fait sécher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92c079f-0ff2-4429-9484-dd43ad5ee8db",
                                "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                                "text": "L’étendage d’une blanchisserie, d’une imprimerie."
                            },
                            {
                                "example_id": "03339d52-6ee0-47ad-8590-abe90339ad98",
                                "sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                                "text": "Le père atteint le bord de l’allée. Pour enjamber la dalle, il se penche davantage en avant, s’assure que le corps ne risque pas de basculer et, le lâchant de la main gauche, il se cramponne à un piquet de l’étendage."
                            }
                        ]
                    },
                    {
                        "sense_id": "764dfb3b-13d2-3fe1-a088-c15f0f168c7b",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "glosses": [
                            "séchoir à linge."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f55a0bdf-c411-326e-bc03-08d79d21f2f3",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "glosses": [
                            "Opération qui se fait sur les laines avant de les employer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f04264e9-bcb3-3fc5-87b8-89377e394d4b",
                        "entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "glosses": [
                            "Action de s’étendre, de rester allongé en vue de la guérison de certaines affections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1165a298-24fd-4e32-9aea-bfb9b13fb368",
                                "sense_id": "f04264e9-bcb3-3fc5-87b8-89377e394d4b",
                                "text": "Le docteur a prescrit l’étendage pour cet enfant atteint de rachitisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d047e2a4-ce99-4038-aa8e-0fb9afd50527",
                        "source_entry_id": "8e09518b-a074-349f-9def-da8f6914444a",
                        "source_sense_id": "e5314eef-92c3-3d69-8b02-00d749258822",
                        "source_sense_description": "Assemblage de cordes tendues horizontalement, sur lesquelles on fait sécher",
                        "target_lang_word": "clothesline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clothesline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72d24917-679f-3e18-ba69-3fabce05df9d",
                                        "entry_id": "44fbba68-6beb-33c0-9d87-a0526d21a39b",
                                        "glosses": [
                                            "A rope or cord tied up outdoors to hang clothes on so they can dry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17aaa52c-6482-4daf-a233-e8419a149fe1",
                                                "sense_id": "72d24917-679f-3e18-ba69-3fabce05df9d",
                                                "text": "Hang this towel out on the clothesline for me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b331b70-1f56-37c2-910f-9ee36b141869",
                                        "entry_id": "44fbba68-6beb-33c0-9d87-a0526d21a39b",
                                        "glosses": [
                                            "A structure with multiple cords for the same purpose, such as a Hills hoist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f32ca19-8ebb-39fa-b8ae-b8acf54bbd4a",
                                        "entry_id": "44fbba68-6beb-33c0-9d87-a0526d21a39b",
                                        "glosses": [
                                            "The act of knocking a person over by striking his or her upper body or neck with one's arm, as if he or she had run into a low clothesline."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clothesline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7896259e-be3b-32ee-9be4-f28f51e6ba6e",
                                        "entry_id": "a450a7e6-d805-3cf3-914a-e39594c7205b",
                                        "glosses": [
                                            "To knock (a person) over by striking them across the neck or upper body with an outstretched arm, mimicking the motion of running into a low clothesline."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34ad97e8-926d-4e01-9eb2-f2ed32d40800",
                                                "sense_id": "7896259e-be3b-32ee-9be4-f28f51e6ba6e",
                                                "text": "The referee called a personal foul, when he clotheslined the running back."
                                            },
                                            {
                                                "example_id": "8b80b8cb-6b06-45f0-9253-a995321a324d",
                                                "sense_id": "7896259e-be3b-32ee-9be4-f28f51e6ba6e",
                                                "text": "One beast jams out its arm, as if to clothesline me, jagged claws poised to take my head off at the neck. I let my feet fall from under me, throwing my legs forward, praying for some momentum, ducking and sliding, a mad limbo to freedom."
                                            },
                                            {
                                                "example_id": "ddc211c5-d339-4deb-adb1-e003555fd838",
                                                "sense_id": "7896259e-be3b-32ee-9be4-f28f51e6ba6e",
                                                "text": "\"I turned around and the next thing I was taken out by this big guy. I'm not sure if he punched me or clothes-lined me,\" he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b062b844-045a-4ff8-8031-66d7e92a0c45",
