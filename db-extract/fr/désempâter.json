                "senses": [
                    {
                        "sense_id": "74648332-8340-3b0b-bbb0-6b45666572a1",
                        "entry_id": "f63d0bd0-e5c9-3a7a-aecb-1333957207a0",
                        "glosses": [
                            "Faire en sorte que quelque chose ne soit plus empâté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e9190f-1894-48bc-98b9-ee81a071905e",
                                "sense_id": "74648332-8340-3b0b-bbb0-6b45666572a1",
                                "text": "Il faut soigneusement éviter de laisser sécher le dessin ; car, pour le désempâter avec le rouleau , on le fatigue ou on le graisse beaucoup."
                            },
                            {
                                "example_id": "92fb73f8-5c7a-4d28-9831-0818add3dd3d",
                                "sense_id": "74648332-8340-3b0b-bbb0-6b45666572a1",
                                "text": "Les tempéramens pituiteux, les gens oisifs et accoutumés à la bonne-chère, doivent sur-tout employer ce moyen de se désempâter les entrailles;"
                            }
                        ]
                    }
