                    {
                        "sense_id": "7b8483ec-5e1d-399d-b82e-4b50cca007ce",
                        "entry_id": "20e64556-56dc-3504-b8cc-d2ae788cdc6d",
                        "glosses": [
                            "eine Solosonate für das Klavier"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "c5b9119e-cf12-4530-b1a5-e9dbbe163f2e",
                                "sense_id": "7b8483ec-5e1d-399d-b82e-4b50cca007ce",
                                "text": "„Die Klaviersonate B-Dur ist eines der letzten Werke von Franz Schubert, und er hat darin alles gesagt, was man mit schwarzen und weißen Tasten überhaupt sagen kann.“"
                            },
                            {
                                "example_id": "98e5623e-4e23-4bf7-804c-5973cdf6bb9a",
                                "sense_id": "7b8483ec-5e1d-399d-b82e-4b50cca007ce",
                                "text": "„Ich gebe auch zu, mitten in einer Klaviersonate an Mord gedacht zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
