                "senses": [
                    {
                        "sense_id": "839d8fcc-ee38-3374-94a6-3519e03553c3",
                        "entry_id": "58c59feb-abbb-3859-af7b-e7fbd36fd355",
                        "glosses": [
                            "Qui est en faveur de la France ou du peuple français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4288e226-6a32-48e9-b973-618a2e679d0c",
                                "sense_id": "839d8fcc-ee38-3374-94a6-3519e03553c3",
                                "text": "Entre la petite Écosse, pauvre, calviniste et profrançaise, et la puissante Angleterre, épiscopalienne et traditionnellement hostile à la France, les relations n'ont jamais été de tout repos."
                            },
                            {
                                "example_id": "2fd7471b-fa61-434b-bb64-816ac22e5d5c",
                                "sense_id": "839d8fcc-ee38-3374-94a6-3519e03553c3",
                                "text": "En 1511, se tient le concile schismatique profrançais de Pise, dont l'objectif est de déposer le pape Jules II et de brider l’ « omnipotence » du Saint-Siège."
                            },
                            {
                                "example_id": "73e7a38e-2d83-4c6c-8bb3-a759b19e89ee",
                                "sense_id": "839d8fcc-ee38-3374-94a6-3519e03553c3",
                                "text": "A ce moment là, Mitterrand voyait le mouvement des droits Tutsis comme une création de la CIA, conçue pour renverser un régime profrançais et le remplacer par un régime proaméricain."
                            }
                        ]
                    }
