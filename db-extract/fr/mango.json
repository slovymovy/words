                            },
                            {
                                "target_word": "mango",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "946328f9-3dfd-370f-8983-8e938d449992",
                                        "entry_id": "f8a97fae-db28-39d2-b04e-86718526a7ba",
                                        "glosses": [
                                            "To stuff and pickle (a fruit)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a02a90-273e-4d9c-8526-ec187413270a",
                                                "sense_id": "946328f9-3dfd-370f-8983-8e938d449992",
                                                "text": "Although any melon may be used before it is quite ripe, yet there is a particular sort for this purpose, which the gardeners know, and should be mangoed soon after they are gathered."
                                            },
                                            {
                                                "example_id": "12a21d70-dbdd-402f-912b-a526a95714bf",
                                                "sense_id": "946328f9-3dfd-370f-8983-8e938d449992",
                                                "text": "In an effort to reproduce the pickle, English cooks took to \"mangoing\" all sorts of substitutes, from cucumbers to unripe peaches. Americans, however, preferred baby musk melons, or, in areas where they did not grow well, bell peppers."
                                            },
                                            {
                                                "example_id": "3a3217ae-75c6-48f3-947a-18d5ea8fd0a5",
                                                "sense_id": "946328f9-3dfd-370f-8983-8e938d449992",
                                                "text": "For this cookbook, I made mangoed peppers that were not stuffed with cabbage, but stuffed with green and red tomatoes and onions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
