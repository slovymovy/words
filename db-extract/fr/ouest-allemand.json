                                    {
                                        "sense_id": "57289308-d986-34d0-b2cd-23461acbf839",
                                        "entry_id": "8799d657-7484-393f-b583-a53499f96314",
                                        "glosses": [
                                            "Of, from, or pertaining to West Germany."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe2775a-36a0-41a4-b8a4-95109ad6d44a",
                                                "sense_id": "57289308-d986-34d0-b2cd-23461acbf839",
                                                "text": "The first Antifas functioned as platforms to organize against far-right groups like the National Democratic Party (NPD) in an autonomist movement still numbering in the tens of thousands of active members and capable of occupying entire city blocks in some West German metropoles."
                                            }
                                        ]
                                    }
                                ]
                            },
