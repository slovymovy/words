{
    "word_family": [
        "strottenhoofd",
        "strotklepje",
        "uitstorten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f05bbf2-a8f9-3d06-8005-1a9b0d08c980",
                    "sense_definition": "De keel of de slokdarm, vaak gebruikt in informele of ruwe contexten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "keel-anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het koude bier gleed heerlijk door zijn droge <w>strot</w> na een lange dag werken.",
                            "target_lang_translations": {
                                "en": "The cold beer slid wonderfully down his dry <w>throat</w> after a long day of work."
                            }
                        },
                        {
                            "text": "Zij kneep hem hard de <w>strot</w> dicht zodat hij geen geluid meer kon maken.",
                            "target_lang_translations": {
                                "en": "She squeezed his <w>throat</w> hard so that he could no longer make any sound."
                            }
                        }
                    ],
                    "synonyms": [
                        "keel",
                        "gorgel"
                    ],
                    "common_phrases": [
                        "de strot dichtknijpen",
                        "door de strot duwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel of ietwat plat uitgedrukt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The throat or gullet, often used in informal, rough, or colloquial contexts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throat",
                                "target_lang_sense_clarification": "informal or rough context"
                            },
                            {
                                "target_lang_word": "gullet",
                                "target_lang_sense_clarification": "informal or rough context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dea76ebd-666f-3cd0-800f-270ec14caa84",
                    "sense_definition": "Het strottenhoofd; het bovenste deel van de luchtpijp waarin zich de stembanden bevinden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "keel-anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts onderzocht zijn <w>strot</w> om te kijken of de stembanden ontstoken waren.",
                            "target_lang_translations": {
                                "en": "The doctor examined his <w>larynx</w> to see if the vocal cords were inflamed."
                            }
                        },
                        {
                            "text": "Bij deze operatie wordt de <w>strot</w> voorzichtig vrijgemaakt van omliggend weefsel.",
                            "target_lang_translations": {
                                "en": "During this surgery, the <w>larynx</w> is carefully cleared of surrounding tissue."
                            }
                        }
                    ],
                    "synonyms": [
                        "strottenhoofd"
                    ],
                    "target_lang_definitions": {
                        "en": "The larynx; the upper part of the windpipe containing the vocal cords."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "larynx",
                                "target_lang_sense_clarification": "anatomical term"
                            },
                            {
                                "target_lang_word": "voice box",
                                "target_lang_sense_clarification": "common anatomical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38b4824a-8b7c-3c33-99ad-4f84635d488f",
                    "sense_definition": "De adamsappel of het uitstekende deel van het strottenhoofd bij mannen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "keel-anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn grote <w>strot</w> bewoog op en neer toen hij nerveus slikte.",
                            "target_lang_translations": {
                                "en": "His large <w>Adam's apple</w> moved up and down as he swallowed nervously."
                            }
                        },
                        {
                            "text": "Hij kreeg een harde klap op zijn <w>strot</w> tijdens het gevecht.",
                            "target_lang_translations": {
                                "en": "He took a hard blow to his <w>throat</w> during the fight."
                            }
                        }
                    ],
                    "synonyms": [
                        "adamsappel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Soms informeel gebruikt om specifiek de adamsappel aan te duiden."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The Adam's apple or the protruding part of the larynx in men."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Adam's apple",
                                "target_lang_sense_clarification": "protruding part of the throat in men"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}