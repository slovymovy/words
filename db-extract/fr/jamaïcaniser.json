                "senses": [
                    {
                        "sense_id": "0e7d9d44-0868-371f-87c9-293232c2883d",
                        "entry_id": "691e940a-4351-3f01-82a8-b3cc330265cb",
                        "glosses": [
                            "Donner un caractère jamaïcain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf71b38-21e6-495c-9484-e23c4a5aa414",
                                "sense_id": "0e7d9d44-0868-371f-87c9-293232c2883d",
                                "text": "Il peut s'agir d'un eﬀort de « jamaïcaniser » une prononciation déjà officialisée (boy en français se voit insérer un [w] 13 fois sur 14 comme en jamaïcain [bwɔ/ɑ:j]), même si cette similitude résulte souvent d’un nombre de traits partagés par le tchèque,le français et le jamaïcain."
                            },
                            {
                                "example_id": "6eaca959-df3c-432d-b353-bcfa5f38add4",
                                "sense_id": "0e7d9d44-0868-371f-87c9-293232c2883d",
                                "text": "Une version rub-a-dub bien sentie où Vegas jamaïcanise à merveille le titre de la chanteuse."
                            },
                            {
                                "example_id": "d4d20427-b203-4816-8096-1dbfb28b6acd",
                                "sense_id": "0e7d9d44-0868-371f-87c9-293232c2883d",
                                "text": "On se \"jamaïcanise\" du début à la fin avec du p*tain de bon son là !"
                            }
                        ]
                    }
