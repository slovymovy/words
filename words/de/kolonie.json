                    "frequency": "High",
                    "semantic_group_id": "geopolitik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Macao war dereinst eine portugiesische <w>Kolonie</w>."
                        },
                        {
                            "text": "Viele afrikanische Staaten erlangten erst spät ihre Unabhängigkeit von den europäischen <w>Kolonien</w>."
                        }
                    ],
                    "synonyms": [
                        "Schutzgebiet"
                    ],
                    "antonyms": [
                        "Mutterland"
                    ],
                    "common_phrases": [
