                "senses": [
                    {
                        "sense_id": "c5473791-9985-3a5c-b4fc-dc98f7504118",
                        "entry_id": "1957533d-e065-32f8-a3ca-7e054cbc6df2",
                        "glosses": [
                            "специалист по дегустации; тот, кто пробует кушанья или напитки, определяя их качество по виду, вкусу, запаху"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dbf06da-6bdf-4c14-a919-24afd4e4432e",
                        "source_entry_id": "1957533d-e065-32f8-a3ca-7e054cbc6df2",
                        "source_sense_id": "c5473791-9985-3a5c-b4fc-dc98f7504118",
                        "target_lang_word": "taster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73aeeff3-9a60-355b-96ef-991d417dfd19",
                                        "entry_id": "d4e89eb6-1004-356d-8077-c38e0cedd7ce",
                                        "glosses": [
                                            "An object in which, or by which, food or drink is tasted, such as a small cup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3924c728-41db-45f2-9560-db99a90f9a19",
                                                "sense_id": "73aeeff3-9a60-355b-96ef-991d417dfd19",
                                                "text": "A flight of tasters was served to the people who would vote on the next soda flavor to be released."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1f3624-8b5a-3026-a980-76557e1ab544",
                                        "entry_id": "d4e89eb6-1004-356d-8077-c38e0cedd7ce",
                                        "glosses": [
                                            "Someone who tastes something; especially, either (1) to check its quality (in food science, winemaking, etc.) or (2) as a security measure to prevent assassination of a protectee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "176a6e22-1a2b-4160-b303-bdc6dbf5a49e",
                                                "sense_id": "6f1f3624-8b5a-3026-a980-76557e1ab544",
                                                "text": "Big companies such as P&G or Kraft Heinz employ or contract with professional tasters who help with product development."
                                            },
                                            {
                                                "example_id": "925f5bd6-cf5b-4850-a7b9-28b69eac0e41",
                                                "sense_id": "6f1f3624-8b5a-3026-a980-76557e1ab544",
                                                "text": "Being a cook for protectees also entails being a taster for them."
                                            },
                                            {
                                                "example_id": "cb53025a-1d59-404b-b16a-429d9cf3a823",
                                                "sense_id": "6f1f3624-8b5a-3026-a980-76557e1ab544",
                                                "text": "Thy tutor be thy taster, ere thou eat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eefcab4-a32e-3380-882d-c7a9af53de25",
                                        "entry_id": "d4e89eb6-1004-356d-8077-c38e0cedd7ce",
                                        "glosses": [
                                            "A kind of zooid situated on the polyp-stem of certain Siphonophorae, resembling the feeding zooids, but destitute of mouths."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da612031-6c9d-3a31-9034-7d0933158b6e",
                                        "entry_id": "d4e89eb6-1004-356d-8077-c38e0cedd7ce",
                                        "glosses": [
                                            "A sample of something bigger or grander intended for future use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9bf54e-2da1-4e31-a14a-639b35042d5e",
                                                "sense_id": "da612031-6c9d-3a31-9034-7d0933158b6e",
                                                "text": "The Kraft Heinz exhibit at the trade fair was a taster of new snack products set to hit the market soon."
                                            },
                                            {
                                                "example_id": "fd01b094-5967-4664-b988-4f2ade3ac31e",
                                                "sense_id": "da612031-6c9d-3a31-9034-7d0933158b6e",
                                                "text": "The Samsung exhibit at the trade fair was a taster of new consumer electronic products set to hit the market soon."
                                            }
                                        ]
