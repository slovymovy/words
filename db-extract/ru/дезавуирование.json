                    },
                    {
                        "translation_id": "f49b2474-35a9-4e86-84be-410eed8ce200",
                        "source_entry_id": "d9f13358-5b97-373c-9927-873a4bbcaa1f",
                        "target_lang_word": "désaveu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désaveu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                        "entry_id": "f6f7fff3-6d54-3e3c-97cc-9f6f7b1ba9e1",
                                        "glosses": [
                                            "Parole ou acte par lequel on désavoue quelque chose ou quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d76f80-1c34-4556-a956-980332b3ce82",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "On prétendait qu’il avait tenu ce propos ; mais il a fait un désaveu formel."
                                            },
                                            {
                                                "example_id": "b876a67e-5e0f-40c4-9ae5-15144c5d33b4",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "Désaveu de paternité."
                                            },
                                            {
                                                "example_id": "e6d778e3-eb8e-4062-9525-dbec5b1909ae",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "Former une demande en désaveu contre un avoué."
                                            },
                                            {
                                                "example_id": "21bf95f4-d0f1-45b7-b386-0a578c5b2b5d",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "Sa vie entière est un désaveu des principes qu’on lui suppose."
                                            },
                                            {
                                                "example_id": "cff92274-d512-46ea-b750-0115214aba31",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "Jan n’en était pas à un reniement ou à un désaveu près."
                                            },
                                            {
                                                "example_id": "3d451bfc-52ab-4381-be21-93604ba9e190",
                                                "sense_id": "1621802d-119d-3432-8172-da89100dcfd6",
                                                "text": "En outre, ce désaveu n’arrangeait pas la réputation du jeune lord depuis longtemps compromise aux yeux des nobles du pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
