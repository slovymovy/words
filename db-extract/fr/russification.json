                    },
                    {
                        "translation_id": "4588bc29-7f41-431c-8291-d8f4a8ef7c9a",
                        "source_entry_id": "f0b71ade-9c1b-3622-b659-f0700263610e",
                        "source_sense_id": "20cb887a-a0db-3a65-bbc7-2b7ad6790ce2",
                        "target_lang_word": "русификация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "русификация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2dd14963-1c24-3bcf-b42d-46df577d0544",
                                        "entry_id": "f27f18a4-2b62-3581-a36b-777b22cae24f",
                                        "glosses": [
                                            "насаждение русского языка; переход на русский язык в быту, литературе или делопроизводстве"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e56bb3-10d3-45cf-b917-3a23cc770b55",
                                                "sense_id": "2dd14963-1c24-3bcf-b42d-46df577d0544",
                                                "text": "Видный деятель украинского движения Евгений Чикаленко писал: «Одесса, Херсон, Николаев, Севастополь и другие приморские порты, вероятно, очень долго останутся русскими. Именно потому, что малорусы вместе с великороссами крепко будут отстаивать русификацию этих городов»."
                                            },
                                            {
                                                "example_id": "7c89e84c-f925-403e-96e0-3e4f8e30dd98",
                                                "sense_id": "2dd14963-1c24-3bcf-b42d-46df577d0544",
                                                "text": "Довольно таки забавный факт, те люди которым уже за 60-70 говорят на украинском (и я не говорю про бабок у подъезда), а вот те уже которым 45-50 исключительно на русском хотя и знают украинский. Всегда задавался вопросом из-за чего получился такой перелом. Совковая русификация. Мой дед из Сумской области до 16 лет вообще не владел русским, выучил его уже в институте и до сих пор на нём разговаривает."
                                            },
                                            {
                                                "example_id": "4014bfb2-16d3-41d6-89ec-41c4df264b25",
                                                "sense_id": "2dd14963-1c24-3bcf-b42d-46df577d0544",
                                                "text": "Одни оппоненты Русского мира утверждают, что его не существует в виде оформленной системы взглядов. Другие рассматривают его как идеологию агрессивного русского национализма, пытающегося восстановить империю в границах СССР, обеспечив стабильность насильственной русификацией окраин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dda3c70-1cad-3eb8-9a4a-fe0686ab898b",
                                        "entry_id": "f27f18a4-2b62-3581-a36b-777b22cae24f",
                                        "glosses": [
                                            "комп. адаптация аппаратного и программного обеспечения компьютеров к потребностям русскоязычных пользователей (в частности, перевод интерфейса на русский язык); а также программа, прошедшая такую адаптацию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ee8af9-a191-4934-b7c1-109cd856a2ba",
                                                "sense_id": "4dda3c70-1cad-3eb8-9a4a-fe0686ab898b",
                                                "text": "В правой половине Кешиного поля зрения зажглась большая синяя «L». А под ней, уже красным, загорелись русские слова ― «лав-бук иувкщщь». Кеша так и не составил определённого мнения, что это ― неграмотная русификация, запредельная ирония или очередной плевок злопамятной цивилизации в прошлое, о котором сегодня напоминал только один из локализационных языков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
