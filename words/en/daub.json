            "senses": [
                {
                    "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                    "sense_definition": "To smear or apply a substance to a surface in a crude, careless, or hasty manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters used red paint to <w>daub</w> slogans across the stone wall."
                        },
                        {
                            "text": "She <w>daubed</w> thick sunscreen over her face before walking out into the sun."
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "plaster",
                        "coat"
                    ],
