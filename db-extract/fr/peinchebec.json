                        "glosses": [
                            "Alliage de zinc (7 % à 11 %) et de cuivre (89 % à 93 %) imitant l’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122ffb78-36d3-4a32-94fc-7c483475cdf4",
                                "sense_id": "acc6543c-3984-32f6-9390-8185ef29f30d",
                                "text": "C’est d’après ces différentes couleurs qu’il [alliage de zinc et de cuivre] prend les noms de similor, de peinchebec et de métal de prince."
                            }
                        ]
