                "forms": [],
                "senses": [
                    {
                        "sense_id": "0edfffd6-398c-3d58-8bc2-5a319a6eec84",
                        "entry_id": "cca67075-f7f5-3f62-b875-124823303a57",
                        "glosses": [
                            "Dʼune manière luxurieuse, avec luxure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe708b8-7d48-42bc-b5cf-e464f7a73c63",
                                "sense_id": "0edfffd6-398c-3d58-8bc2-5a319a6eec84",
                                "text": "— Je l’avais rencontré à Monte-Carlo, où je venais de passer, au Riviera Palace, une semaine calme…\n— Cet hôtel pourtant se vante, dans ses prospectus, d’être « le plus luxurieusement meublé qui soit en Europe » !"
                            },
                            {
                                "example_id": "8a7f8227-ab9a-4993-b69c-0f1cbb8fd9dc",
                                "sense_id": "0edfffd6-398c-3d58-8bc2-5a319a6eec84",
                                "text": "Les époux Journier s’étaient flattés, à leur repas de noces, qu’ils abuseraient luxurieusement de la permission de Dieu, et ils étaient devenus si pauvres qu’ils n’osaient même plus paraître à la messe."
                            },
                            {
                                "example_id": "a37fad27-9130-401c-a83c-9879646fda29",
                                "sense_id": "0edfffd6-398c-3d58-8bc2-5a319a6eec84",
                                "text": "Lʼéglise était luxurieusement parée, et un mariage sʼy célébrait avec toute la pompe et la solennité possibles."
                            }
                        ]
                    }
                ],
