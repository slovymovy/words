                    },
                    {
                        "form_id": "b7ebdc84-eddd-4f51-b03c-bd3906845242",
                        "entry_id": "8105245a-0d5b-3909-abbe-0c0844117e71",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Abenteuerlust"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                        "entry_id": "8105245a-0d5b-3909-abbe-0c0844117e71",
                        "glosses": [
                            "die Lust an Abenteuern, die Lust auf Abenteuer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e8f8e2-96f5-4da3-92a7-e893a37d8cc8",
                                "sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                                "text": "Seine ungebrochene Abenteuerlust brachte ihn schon auf manch originellen Gedanken."
                            },
                            {
                                "example_id": "c41a8345-4caf-46a2-a564-be094ec2352c",
                                "sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                                "text": "„Zudem ist Barth trotz seiner Jugend schon sehr erfahren, hat Abenteuerlust und Durchhaltewillen bewiesen: Als er von 1845 bis 1847 auf einer Bildungsreise die Länder rund um das Mittelmeer erkundete, wurde er im libysch-ägyptischen Grenzgebiet von Banditen überfallen und angeschossen.“"
                            },
                            {
                                "example_id": "717088e2-1d2c-41c9-acb8-8d664f778e1e",
                                "sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                                "text": "„Sehnsucht nach Abwechslung und Abenteuerlust waren meine Motive, und es kam mir nie in den Sinn, nach etwas zu fragen, das so unbedeutend für jemanden von meinem Temperament war.“"
                            },
                            {
                                "example_id": "683087c6-9f6f-4833-b706-b7d5c0ffb559",
                                "sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                                "text": "„Aus Abenteuerlust hatte er darum gebeten, auf einem U-Boot mitfahren zu dürfen, aus nächster Nähe wollte er einmal erleben, wie das so ist, wenn ein U-Boot ein feindliches Schiff versenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb5665a8-8b3d-4284-bc9b-7531afd72ff0",
                        "source_entry_id": "8105245a-0d5b-3909-abbe-0c0844117e71",
                        "source_sense_id": "aa26630e-a5a7-365b-9ad4-123d81233c09",
                        "source_sense_description": "die Lust an Abenteuern, die Lust auf Abenteuer",
