                                "target_senses": [
                                    {
                                        "sense_id": "884d7067-5363-36d5-95a7-495eed4b7b4e",
                                        "entry_id": "59616646-fb65-3b58-a009-5b78aef92ff5",
                                        "glosses": [
                                            "прежние, давно прошедшие времена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0209c1af-3674-453d-b426-36f61ebc38aa",
                                                "sense_id": "884d7067-5363-36d5-95a7-495eed4b7b4e",
                                                "text": "Дела давно минувших дней, // Преданья старины глубокой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e0555c-264e-3510-aee5-fc8afc3c3985",
                                        "entry_id": "59616646-fb65-3b58-a009-5b78aef92ff5",
                                        "glosses": [
                                            "разг. прошедшие для кого-либо годы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc3f9368-8017-3c44-8784-24ceccc7b2d4",
                                        "entry_id": "59616646-fb65-3b58-a009-5b78aef92ff5",
                                        "glosses": [
                                            "события, обычаи, порядки давних времён"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1dade1d-b1b1-466c-adb1-1e67966c51eb",
                                                "sense_id": "fc3f9368-8017-3c44-8784-24ceccc7b2d4",
                                                "text": "Историческое зданье // Над рекой стоит убого // Зданье знатно по преданью // Стариною зданье строго."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "698a1508-74a2-3178-b9be-6a6ae6232c84",
                                        "entry_id": "59616646-fb65-3b58-a009-5b78aef92ff5",
                                        "glosses": [
                                            "разг. то, что было в прошедшие для кого-либо годы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "791db9d0-0d34-39b1-b110-24a2610754de",
                                        "entry_id": "59616646-fb65-3b58-a009-5b78aef92ff5",
                                        "glosses": [
                                            "то, что создано в давние времена и существует с тех пор"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ста́рина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf644b8-62f0-395a-984f-cac5ed1af726",
                                        "entry_id": "a520eb7c-04db-32a3-9259-4751197eca02",
                                        "glosses": [
                                            "употребляется как фамильярно-ласковое обращение к старому человеку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb25298c-1853-40e0-8413-31c4797abcad",
                                                "sense_id": "1bf644b8-62f0-395a-984f-cac5ed1af726",
                                                "text": "«Стой, старина!» Старика обступили // Парней, и девок, и детушек тьма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9137273-4c88-3fbc-b171-ee7a2d00d0ae",
                                        "entry_id": "a520eb7c-04db-32a3-9259-4751197eca02",
                                        "glosses": [
                                            "перен. употребляется как фамильярно-ласковое обращение к приятелю, знакомому и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1581c129-9d3b-4fe6-8f2f-5903d754db89",
                                                "sense_id": "e9137273-4c88-3fbc-b171-ee7a2d00d0ae",
                                                "text": "За дружбу старую // До дна! // За счастье прежних дней! // С тобой мы выпьем, старина, // За счастье прежних дней."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
