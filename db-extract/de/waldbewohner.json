                            {
                                "example_id": "3728e400-eec0-4a88-aaa5-3f04f9ffd73a",
                                "sense_id": "e1ad30b2-a66e-3c00-ac9f-82e99a0e7b51",
                                "text": "„[Der Baummarder] lebt in Europa und Westasien und ist ein Waldbewohner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1154aad1-66ce-3163-b51d-e593169dd0d9",
                        "entry_id": "644b42be-5533-3fd2-b53a-350202efb584",
                        "glosses": [
                            "Mensch, der im Wald lebt"
                        ],
                        "tags": [
                            "Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cc246f9c-c21b-46cd-a858-43fe80e5855a",
                                "sense_id": "1154aad1-66ce-3163-b51d-e593169dd0d9",
                                "text": "„Für die Waldbewohner wird es immer schwieriger, Nahrung zu finden.“"
                            },
                            {
                                "example_id": "bcc17dc8-35a6-420c-afa2-780cbc20c694",
                                "sense_id": "1154aad1-66ce-3163-b51d-e593169dd0d9",
                                "text": "„Und bei Sturm müßten die Waldbewohner um ihr Hab und Gut fürchten.“"
                            }
                        ],
