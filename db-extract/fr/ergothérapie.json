                    {
                        "translation_id": "5de1ba8f-6609-4295-b233-4c5ca92e07a2",
                        "source_entry_id": "40a47b96-78c3-3552-a89f-2f604ca9cf49",
                        "source_sense_id": "8e050e34-4cd7-3827-8981-f0189fe6bd8b",
                        "target_lang_word": "Ergotherapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergotherapie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                        "entry_id": "57cbea12-80fc-32ea-aa6e-bcdb73313be7",
                                        "glosses": [
                                            "Therapieform, die sich mit der Ausführung konkreter Betätigungen und deren Auswirkungen auf den Menschen und seiner Umwelt befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f80db1-6bdc-4bd0-bda6-1a93c29cff38",
                                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                                "text": "„Ein Kind, das nicht bastelt oder keine Bilder malt, kommt zur Ergotherapie, wer stottert, wird zum Logopäden geschickt.“"
                                            },
                                            {
                                                "example_id": "724b9ebe-7788-4336-9f95-a5e8b2e014c3",
                                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                                "text": "„Die Ergotherapie unterstützt den Patienten in der Bewältigung seines Alltags.“"
                                            },
                                            {
                                                "example_id": "84918391-4f7e-4787-a0fc-5fd1703c6b19",
                                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                                "text": "Eine Kombination aus Ergo-, Physio- und Sporttherapie hat mich nach meinem Unfall wieder fit für den Beruf gemacht."
                                            },
                                            {
                                                "example_id": "b80a581b-d9e8-4631-9851-e2c0c62ccde5",
                                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                                "text": "„Nach der Ergotherapie durfte ich einen neuropsychologischen Test machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a56bf622-6538-4b14-9ebb-077440b114a0",
                        "source_entry_id": "40a47b96-78c3-3552-a89f-2f604ca9cf49",
