                                "target_senses": [
                                    {
                                        "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                        "entry_id": "70ff6630-432c-3ea2-9629-567b5f6ec8c5",
                                        "glosses": [
                                            "A brief argument, falling out, quarrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3a67a7-826d-489f-81dc-ffaaabfe8fba",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "get into a trivial spat over punctuality"
                                            },
                                            {
                                                "example_id": "7609225f-81c6-4e50-bb4c-2abb4c742c9d",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "have a vicious spat with the cousins"
                                            },
                                            {
                                                "example_id": "01ebe2ec-f497-411c-b33d-7df556139363",
                                                "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                                                "text": "The downside of this cost-saving strategy was that the train service could only be covered by goodwill. Whenever there was a spat between ASLEF and management - regardless of cause - the withdrawal of this goodwill became a stick with which unions could beat management."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                        "entry_id": "570426ba-3fc6-3660-9778-1e78237e2be2",
                                        "glosses": [
                                            "simple past and past participle of spit"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5eaa82-ee72-49e1-a41d-32e80eea382f",
                                                "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                                "text": "There was no sink in the room so we spat out the window."
                                            },
                                            {
                                                "example_id": "faf3fe4f-c7e6-49e3-8f81-2ed15d2155fd",
                                                "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                                                "text": "If I had known you had a spittoon in the corner I would never have spat on the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                        "entry_id": "a5724c18-4e7d-36d6-a0b6-6c00c4486b4f",
                                        "glosses": [
                                            "The spawn of shellfish, especially oysters and similar molluscs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9511117b-8948-4603-a390-b5464895bfc7",
                                                "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                                "text": "As spat-fall often occurs in areas away from environments suitable for oyster growing, the collection, transport and sale of oyster spat has developed into a separate industry."
                                            },
                                            {
                                                "example_id": "0d3d04c3-7670-4c63-9a9f-c38e2def4e71",
                                                "sense_id": "9dcb4cd5-3f05-3d1e-982f-5addbb215455",
                                                "text": "But Orata’s oysters were, like the dormice and fish, collected in the wild, as spat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                        "entry_id": "a5724c18-4e7d-36d6-a0b6-6c00c4486b4f",
                                        "glosses": [
                                            "A juvenile shellfish which has attached to a hard surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95dc77d8-19bc-4539-a906-76d5bf966a1e",
                                                "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                                "text": "Conditions in pearl oyster hatcheries are optimized for growth and survival of spat."
                                            },
                                            {
                                                "example_id": "f09ea976-7ee8-41d3-b55a-139009faa214",
                                                "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                                                "text": "If the spat are allowed to remain attached to the tank bottom for more than two days, they are difficult to remove without damage to the shell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a711f127-cabd-3d98-a1fe-fb0325e414f8",
