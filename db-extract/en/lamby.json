                        ],
                        "examples": [
                            {
                                "example_id": "ac29df16-a54a-42d2-a7e8-a72aebd64db3",
                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                "text": "With a big heavy bucket full of bottles of warm milk, she would call out, “Here, lamby, lamby, lamby.”"
                            },
                            {
                                "example_id": "5de3e612-e054-4498-847a-ecb323ef56dc",
                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                "text": "\"It's a lamby, Callie! A little baby lamby.\""
                            },
                            {
                                "example_id": "f4d8926b-5583-44b3-a685-54c3d1440a36",
                                "sense_id": "5be83083-02f9-30d9-9310-9aaa6334ee8d",
                                "text": "Now, if you're thinking being a shepherd means sitting around playing a harp and saying things like, “Here, lamby,” you are mistaken."
                            }
                        ]
                    }
