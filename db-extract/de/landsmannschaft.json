                ],
                "senses": [
                    {
                        "sense_id": "9124958f-a07c-395c-ad1b-bcd2f703db9c",
                        "entry_id": "3bf60406-dd66-32f3-9c54-decf6612a882",
                        "glosses": [
                            "klassische Form der Studentenverbindung, Vereinigung derjenigen Studenten, die aus dem gleichen Land an eine Universität kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc9795c-741d-4dc2-b6b0-5fc585ed3b09",
                                "sense_id": "9124958f-a07c-395c-ad1b-bcd2f703db9c",
                                "text": "Vertreter der Landsmannschaft nahmen an der Feierlichkeit zum Universitätsjubiläum teil."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dea6a0f2-dda6-3004-9326-865668cb370b",
                        "entry_id": "3bf60406-dd66-32f3-9c54-decf6612a882",
                        "glosses": [
                            "Vertriebenenverband nach dem 2. Weltkrieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e9ba20-b4bd-4c7f-8bca-b0a6976ca193",
                                "sense_id": "dea6a0f2-dda6-3004-9326-865668cb370b",
                                "text": "In der Landsmannschaft Ostpreußen fanden viele von dort Vertriebene eine geistige Heimat."
                            },
                            {
                                "example_id": "afc29e22-88d4-45d8-b6d0-c3ed6c088fcd",
                                "sense_id": "dea6a0f2-dda6-3004-9326-865668cb370b",
                                "text": "„Nachdem »Cholonek oder Der liebe Gott aus Lehm« in Deutschland erschienen war, konnte Herbert Hupka, der damalige Präsident der Landsmannschaft Schlesien, seine Empörung nicht verhehlen.“"
                            },
                            {
                                "example_id": "302f9c33-2da5-4df4-ac15-b6825e343327",
                                "sense_id": "dea6a0f2-dda6-3004-9326-865668cb370b",
                                "text": "„Niemand in Deutschland, nicht mal die Landsmannschaft, formuliert noch Ansprüche auf Ostpreußen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
