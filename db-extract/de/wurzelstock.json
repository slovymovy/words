                    {
                        "form_id": "8fe057e2-965c-4014-a8a0-540682792983",
                        "entry_id": "e660910b-61d3-39f1-bd0f-0c574c169253",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wurzelstöcke"
