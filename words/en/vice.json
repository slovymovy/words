{
    "word_family": [
        "vicious",
        "viciously",
        "viciousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d4c6b1b-c0eb-3dd5-841a-176679ddae52",
                    "sense_definition": "A bad habit or immoral behavior.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral_fault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking is a <w>vice</w> that can lead to serious health problems.",
                            "target_lang_translations": {
                                "ru": "Курение — это <w>порок</w>, который может привести к серьезным проблемам со здоровьем.",
                                "zh": "吸烟是一种可能导致严重健康问题的<w>恶习</w>。"
                            }
                        },
                        {
                            "text": "Greed is often considered a terrible <w>vice</w> in many cultures.",
                            "target_lang_translations": {
                                "ru": "Жадность часто считается ужасным <w>пороком</w> во многих культурах.",
                                "zh": "在许多文化中，贪婪常被视为一种可怕的<w>恶习</w>。"
                            }
                        },
                        {
                            "text": "He has no major <w>vice</w> other than drinking too much coffee.",
                            "target_lang_translations": {
                                "ru": "У него нет серьезных <w>пороков</w>, кроме того, что он пьет слишком много кофе.",
                                "zh": "除了喝太多咖啡，他没有什么大的<w>不良嗜好</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sin",
                        "wickedness",
                        "bad habit",
                        "weakness"
                    ],
                    "antonyms": [
                        "virtue"
                    ],
                    "common_phrases": [
                        "virtue and vice",
                        "secret vice",
                        "minor vice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дурная привычка или аморальное поведение.",
                        "zh": "指不良习惯或不道德的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поро́к",
                                "target_lang_sense_clarification": "нравственный недостаток"
                            },
                            {
                                "target_lang_word": "дурная привычка",
                                "target_lang_sense_clarification": "вредная наклонность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶习",
                                "target_lang_sense_clarification": "指道德上的坏习惯"
                            },
                            {
                                "target_lang_word": "不良嗜好",
                                "target_lang_sense_clarification": "指不好的个人习惯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1daec891-b428-3cbb-a5f5-3922e7712202",
                    "sense_definition": "A mechanical tool with two jaws used to hold an object firmly while work is done on it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter secured the wooden plank in the <w>vice</w> before sawing it.",
                            "target_lang_translations": {
                                "ru": "Плотник закрепил деревянную доску в <w>тисках</w> перед тем, как пилить её.",
                                "zh": "木匠在锯木板前，先将其固定在<w>台钳</w>上。"
                            }
                        },
                        {
                            "text": "He tightened the <w>vice</w> to keep the metal pipe steady.",
                            "target_lang_translations": {
                                "ru": "Он затянул <w>тиски</w>, чтобы удержать металлическую трубу неподвижно.",
                                "zh": "他拧紧了<w>虎钳</w>以固定金属管。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clamp"
                    ],
                    "common_phrases": [
                        "grip like a vice"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English spelling; US spelling is 'vise'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механический инструмент с двумя губками для прочной фиксации предмета во время работы.",
                        "zh": "一种带有两个钳口的机械工具，用于在加工时牢固地固定物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тиски́",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "台钳",
                                "target_lang_sense_clarification": "固定在工作台上的夹具"
                            },
                            {
                                "target_lang_word": "虎钳",
                                "target_lang_sense_clarification": "用于夹持工件的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1780270-eb31-3d94-9ab5-6519390aa72e",
                    "sense_definition": "Criminal activities involving prostitution, pornography, or drugs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor promised to clean up the <w>vice</w> in the downtown district.",
                            "target_lang_translations": {
                                "ru": "Мэр пообещал искоренить <w>порок</w> в центральном районе города.",
                                "zh": "市长承诺要清理市中心的<w>色情与非法交易</w>活动。"
                            }
                        },
                        {
                            "text": "Detectives from the <w>vice</w> squad raided the illegal gambling den.",
                            "target_lang_translations": {
                                "ru": "Детективы из полиции <w>нравов</w> совершили налет на подпольный игорный притон.",
                                "zh": "来自<w>扫黄组</w>的侦探突袭了那个非法赌窝。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vice squad",
                        "vice ring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преступная деятельность, связанная с проституцией, порнографией или наркотиками.",
                        "zh": "涉及卖淫、色情或毒品的犯罪活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преступления против нравственности",
                                "target_lang_sense_clarification": "категория преступлений"
                            },
                            {
                                "target_lang_word": "поро́к",
                                "target_lang_sense_clarification": "разврат, криминальная деятельность"
                            },
                            {
                                "target_lang_word": "полиция нравов",
                                "target_lang_sense_clarification": "в контексте 'vice squad'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "色情与非法交易",
                                "target_lang_sense_clarification": "指代此类犯罪活动"
                            },
                            {
                                "target_lang_word": "扫黄组",
                                "target_lang_sense_clarification": "指代 vice squad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e4547ea-b460-3b78-9156-32735dbd86a3",
                    "sense_definition": "Designating a person next in rank to and acting in place of a superior.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was elected as the <w>vice</w> president of the student council.",
                            "target_lang_translations": {
                                "ru": "Она была избрана <w>вице</w>-президентом студенческого совета.",
                                "zh": "她当选为学生会<w>副</w>主席。"
                            }
                        },
                        {
                            "text": "The <w>vice</w> chairman will lead the meeting while the chairman is away.",
                            "target_lang_translations": {
                                "ru": "<w>Вице</w>-председатель будет вести собрание, пока председатель в отъезде.",
                                "zh": "主席不在时，将由<w>副</w>主席主持会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deputy"
                    ],
                    "common_phrases": [
                        "vice president",
                        "vice admiral",
                        "vice chairman",
                        "vice captain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначает лицо, следующее по рангу за начальником и замещающее его.",
                        "zh": "指职位仅次于上级并代行其职权的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вице-",
                                "target_lang_sense_clarification": "приставка к должности"
                            },
                            {
                                "target_lang_word": "заместитель",
                                "target_lang_sense_clarification": "должность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副",
                                "target_lang_sense_clarification": "职位前缀"
                            },
                            {
                                "target_lang_word": "副职",
                                "target_lang_sense_clarification": "指代副手职位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "bad00a09-d6ad-36d8-baa0-d59cc05b25fe",
                    "sense_definition": "In the place of; succeeding someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "substitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mr. Smith was appointed director, <w>vice</w> Mr. Jones who retired last week.",
                            "target_lang_translations": {
                                "ru": "Мистер Смит был назначен директором <w>вместо</w> мистера Джонса, который вышел на пенсию на прошлой неделе.",
                                "zh": "史密斯先生被任命为主任，<w>代替</w>上周退休的琼斯先生。"
                            }
                        },
                        {
                            "text": "I will be attending the conference <w>vice</w> my commanding officer.",
                            "target_lang_translations": {
                                "ru": "Я буду присутствовать на конференции <w>вместо</w> моего командира.",
                                "zh": "我将<w>代替</w>我的指挥官出席会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instead of"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вместо кого-либо; занимая чье-то место.",
                        "zh": "代替某人；接替某人的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вме́сто",
                                "target_lang_sense_clarification": "предлог замены"
                            },
                            {
                                "target_lang_word": "взаме́н",
                                "target_lang_sense_clarification": "на смену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代替",
                                "target_lang_sense_clarification": "表示替换某人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f3e5284-d2c6-301b-b75f-c4529705cd44",
                    "sense_definition": "To hold or squeeze tightly, as if with a clamping tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fear <w>viced</w> his heart as he walked into the dark room.",
                            "target_lang_translations": {
                                "ru": "Страх <w>сжал</w> его сердце, когда он вошел в темную комнату.",
                                "zh": "当他走进黑暗的房间时，恐惧<w>紧紧抓住</w>了他的心。"
                            }
                        },
                        {
                            "text": "The wrestler <w>viced</w> his opponent's arm until he surrendered.",
                            "target_lang_translations": {
                                "ru": "Борец <w>зажал</w> руку противника, пока тот не сдался.",
                                "zh": "摔跤手<w>钳制</w>住对手的手臂，直到对方认输。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clamp",
                        "squeeze",
                        "grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко держать или сжимать, как будто инструментом.",
                        "zh": "像使用夹具一样紧紧地握住或挤压。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжима́ть",
                                "target_lang_sense_clarification": "крепко сдавливать"
                            },
                            {
                                "target_lang_word": "зажима́ть",
                                "target_lang_sense_clarification": "фиксировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧紧抓住",
                                "target_lang_sense_clarification": "用力握住"
                            },
                            {
                                "target_lang_word": "钳制",
                                "target_lang_sense_clarification": "用力压制或固定"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4bca2ca4-2873-3e9c-bec4-175c3573bb3b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met Mr. <w>Vice</w> at the community gathering yesterday.",
                            "target_lang_translations": {
                                "ru": "Мы встретили мистера <w>Вайса</w> на собрании общины вчера.",
                                "zh": "我们昨天在社区聚会上见到了<w>维斯</w>先生。"
                            }
                        },
                        {
                            "text": "The <w>Vice</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Вайс</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>维斯</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вайс",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}