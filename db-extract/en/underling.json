                                    {
                                        "sense_id": "00079318-c208-3502-8886-3d0b960b2857",
                                        "entry_id": "0913b293-956d-358e-9a10-d6d2a6e7fb30",
                                        "glosses": [
                                            "Person, die einem Herrscher untergeben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46d7d73-d94c-4a0d-a280-a5cb45cd33e3",
                                                "sense_id": "00079318-c208-3502-8886-3d0b960b2857",
                                                "text": "„Die Abhängigkeit der Untertanen, aber auch deren weitgehendes Vertrauen in die Obrigkeit unterschieden die deutsche Gesellschaft von anderen westeuropäischen Staaten.“"
                                            },
                                            {
                                                "example_id": "894a8f37-f110-47eb-ab97-7bc1bef2e138",
                                                "sense_id": "00079318-c208-3502-8886-3d0b960b2857",
                                                "text": "„Weil zahlreiche Untertanen des Königs Beziehungen mit Einheimischen oder gar mit katholischen Portugiesinnen begannen, wurden englische Frauen seit 1671 gezielt nach Bombay gebracht, um sich dort zu verheiraten.“"
                                            },
                                            {
                                                "example_id": "53505cab-a9c9-4322-9a1e-91917a364c03",
                                                "sense_id": "00079318-c208-3502-8886-3d0b960b2857",
                                                "text": "„Nicht nur die Untertanen des Kaisers feiern den Sieg.“"
                                            },
                                            {
                                                "example_id": "3f91b4a5-7976-45af-9563-e31ff4b5ebac",
                                                "sense_id": "00079318-c208-3502-8886-3d0b960b2857",
                                                "text": "„Aber man war vor allem mit geringen Rechten ausgestatteter Untertan, kein Staatsbürger in dem Sinne beispielsweise, dass man eine Staatsbürgerschaft verliehen bekam oder über einen Pass verfügte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3141acc3-e91c-456e-b6f8-67359ba6ace7",
                        "source_entry_id": "11f2457e-e99e-3ad1-b168-dc13c297da7a",
                        "source_sense_description": "a subordinate, or person of lesser rank or authority",
                        "target_lang_word": "Unterling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                        "entry_id": "860cefec-93b6-367b-8246-f2fd4671fe3c",
                                        "glosses": [
                                            "Person, die im Vergleich zu einer anderen einen niedrigeren Status hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b212e75-936a-43be-9fdf-5012723d4e73",
                                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                                "text": "„Mithin wollen die Chefs mehr Kontrolle über ihre Unterlinge, was weder progressiv noch nett ist.“"
                                            },
                                            {
                                                "example_id": "4cec31e9-91f0-4eff-ad0f-509d2687adf5",
                                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                                "text": "„Bei Fox News herrschte Ailes wie ein Autokrat - bis die Unterlinge ihrerseits rebellierten.“"
                                            },
                                            {
                                                "example_id": "db52c1e6-8d1b-4f67-8668-337642cbaf70",
                                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                                "text": "„Ein schnauzbärtiger Unterling eilt herbei, den Herrscher zu trösten: […].“"
                                            },
                                            {
                                                "example_id": "d7c1640f-7f13-4c89-836b-5f75fe43805a",
                                                "sense_id": "cdbd6cf1-85d7-36be-a9a9-57addeb1a204",
                                                "text": "„Der Treck war fast zusammengestellt, als der Auftritt der aufrechten Nazis vollends zur Groteske wurde und auch noch Herr Abramowski in Götzlack vorbeischaute, ein Unterling des Herrn Bierfreund, um das am Morgen ausgesprochene Verbot zu kontrollieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6c68f03-a65e-40b2-86ab-5552af45f7fc",
                        "source_entry_id": "11f2457e-e99e-3ad1-b168-dc13c297da7a",
