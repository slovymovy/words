                                    {
                                        "sense_id": "3cc6512a-ba81-3018-9bdd-c4b1066cfa7d",
                                        "entry_id": "7623f92f-7861-35b6-8550-a6c057e6194d",
                                        "glosses": [
                                            "Beruf, der sich mit der Herstellung von Geweben, textilen Stoffen beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9386f346-0e1e-4afe-8135-7ac77345ba36",
                                                "sense_id": "3cc6512a-ba81-3018-9bdd-c4b1066cfa7d",
                                                "text": "Die wirtschaftliche Situation der verlegten Weber war zum Ende des 18. Jahrhunderts sehr schlecht …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c63443c6-5a9d-3eec-a52f-00d16b0e6554",
                                        "entry_id": "7623f92f-7861-35b6-8550-a6c057e6194d",
                                        "glosses": [
                                            "Person, die webt, Textilien herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e43deba-e787-4cd3-8861-8af75c3eaa9a",
                                                "sense_id": "c63443c6-5a9d-3eec-a52f-00d16b0e6554",
                                                "text": "„Der Gatte der jungen Frau war ein Weber, wie seine beiden Freunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                        "entry_id": "e5e8a35d-a595-3fad-8ca6-e97123d0062e",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname; fünfthäufigster Nachname in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e41766b-868c-4763-a46c-d7fb775a5e40",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Das Übergewicht des Herrn Weber nimmt rasant zu."
                                            },
                                            {
                                                "example_id": "8285dac0-ac8b-467d-bb02-6d69b2a10742",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Der Kollegin Weber ist ein unschlagbar gutes Angebot gemacht worden."
                                            },
                                            {
                                                "example_id": "21e00ab8-691e-4173-8e85-a3b75d5040a3",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Webers sind zum Wandern im Fichtelgebirge."
                                            },
                                            {
                                                "example_id": "607a0e99-4874-44d1-ada4-9da6ea4cc7ae",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Des jungen Webers Erkrankung lähmt sein ganzes Umfeld."
                                            },
                                            {
                                                "example_id": "e1af2d29-92a3-48f2-8d74-536f06b62c27",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Irgendjemand muss mit Weber sprechen und ihr die Nachricht überbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
