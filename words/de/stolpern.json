                    "frequency": "Middle",
                    "semantic_group_id": "wahrnehmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Korrigieren des Textes <w>stolperte</w> die Lehrerin über mehrere merkwürdige Formulierungen."
                        },
