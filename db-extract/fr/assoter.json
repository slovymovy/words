                ],
                "senses": [
                    {
                        "sense_id": "0a4d372f-053b-377a-9c8d-8959b60b1ea2",
                        "entry_id": "56d7df05-78d8-339e-bb8a-bdca75aa6d42",
                        "glosses": [
                            "Rendre sot."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b72f0e3c-160c-4e39-9f1f-6aef2b3567c5",
                                "sense_id": "0a4d372f-053b-377a-9c8d-8959b60b1ea2",
                                "text": "Vos discours finiront par m’assoter."
                            },
                            {
                                "example_id": "bd48ac80-c71e-44f0-836b-c5852755334c",
                                "sense_id": "0a4d372f-053b-377a-9c8d-8959b60b1ea2",
                                "text": "Comme dit fortement Mme Daroux, les tout-petits, on ne s'occupe que de leur derrière. Puis on travaille des années à leur faire une tête, jusqu'à ce que, chez les tout-grands, on se retrouve assoté de l'ancien problème."
                            }
                        ]
                    },
                    {
                        "sense_id": "92b87a37-050b-3abd-8519-4b19c963512c",
                        "entry_id": "56d7df05-78d8-339e-bb8a-bdca75aa6d42",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241df306-af96-4d8a-9221-464ffae08eb7",
                                "sense_id": "92b87a37-050b-3abd-8519-4b19c963512c",
                                "text": "Le coup de trompette d’un butor traverse l’espace, assoté de coassements."
                            }
                        ]
                    },
                    {
                        "sense_id": "631db175-f209-3123-9d50-1676fd04910d",
                        "entry_id": "56d7df05-78d8-339e-bb8a-bdca75aa6d42",
                        "glosses": [
                            "Devenir sottement amoureux."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a1ef0ff1-ea60-4f96-8e9d-65fd76fc325a",
                                "sense_id": "631db175-f209-3123-9d50-1676fd04910d",
                                "text": "Il s’est assoté d’une femme qui le ruinera."
                            },
                            {
                                "example_id": "3f05461a-b47a-48b2-8501-9712db0bca8a",
                                "sense_id": "631db175-f209-3123-9d50-1676fd04910d",
                                "text": "« Quoi, à cause de Carrine, à cause de ces deux filles assotées… »"
                            }
                        ]
                    }
                ],
