                "translations": [
                    {
                        "translation_id": "34b73d29-4368-4253-ab9b-85165e00673a",
                        "source_entry_id": "8c57d6b3-349f-3549-a6ef-567e1165e394",
                        "source_sense_id": "a5c06779-5f0c-3baf-9bb0-130eb3b2b27e",
                        "source_sense_description": "veraltend: Abschmack, unangenehmer Geschmack, unangenehmer Nachgeschmack",
                        "target_lang_word": "Abschmack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschmack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8326c5-dc67-3a64-a315-12659cdad848",
                                        "entry_id": "6f5d6319-28a4-3ef0-9a87-7c5c47774066",
                                        "glosses": [
                                            "schlechter/verdorbener Geschmack, schlechter/verdorbener Nachgeschmack"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "178eb62c-66b3-44c6-9ee6-abc21279846c",
                                                "sense_id": "fe8326c5-dc67-3a64-a315-12659cdad848",
                                                "text": "Der Wein hat einen unangenehmen Abschmack."
                                            },
                                            {
                                                "example_id": "f68539fc-1c5f-4d1b-82af-a1a2965102ee",
                                                "sense_id": "fe8326c5-dc67-3a64-a315-12659cdad848",
                                                "text": "„Die Eier, die mit den Nestern weggenommen werden, sind viel größer als Hühnereier und wiegen fast ein Viertelpfund, sind frisch dem Geschmack nach kaum von jenen zu unterscheiden, werden aber später etwas tranig, doch kann man sie dadurch konservieren, dass man sie in Kalkwasser taucht und trocknen läßt, in welcher Weise man sie über zwei Jahre erhält, ohne dass sie einen Abschmack annehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46fee0fd-4787-3a69-a133-afa1e7fcb4c0",
                                        "entry_id": "6f5d6319-28a4-3ef0-9a87-7c5c47774066",
                                        "glosses": [
                                            "unangenehmer Nachgeschmack, unangenehmes Gefühl, unangenehme Erinnerung"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34724e3-bbd8-417b-ab84-55b3a03dc329",
                                                "sense_id": "46fee0fd-4787-3a69-a133-afa1e7fcb4c0",
                                                "text": "„Bald darauf war so ziemlich die ganze Familie im Zimmer versammelt; es war einer jener peinlichen Auftritte, von denen wir schon einen Abschmack haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "050b5d3f-4dc8-4e4f-8566-d2eb4cafc4bd",
                        "source_entry_id": "8c57d6b3-349f-3549-a6ef-567e1165e394",
                        "source_sense_id": "a5c06779-5f0c-3baf-9bb0-130eb3b2b27e",
                        "source_sense_description": "veraltend: Abschmack, unangenehmer Geschmack, unangenehmer Nachgeschmack",
                        "target_lang_word": "Geschmack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschmack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d81bae-b999-3d01-9d0b-819818b16a6c",
                                        "entry_id": "8db8b189-bb85-3c69-932d-f5fb28671544",
                                        "glosses": [
                                            "Sinn zu schmecken, geschmackliche Wahrnehmungsfähigkeit, Geschmackssinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "326b4f7a-e5c9-4a0c-b26b-9341c597c7c7",
                                                "sense_id": "f5d81bae-b999-3d01-9d0b-819818b16a6c",
                                                "text": "Mein Geschmack täuscht mich nie!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                        "entry_id": "8db8b189-bb85-3c69-932d-f5fb28671544",
                                        "glosses": [
                                            "Eigenschaft eines Stoffes, die man wahrnimmt, wenn man ihn isst oder trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02904223-7ffc-478a-bacf-cb87b80cb913",
                                                "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                                "text": "Der Geschmack erinnert etwas an Lollis."
                                            },
                                            {
                                                "example_id": "9391b181-54af-4a8d-9483-f9a4a48879dc",
                                                "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                                "text": "„Kommt, von allerreifsten Früchten",
                                                "translation": "Mit Geschmack und Lust zu speisen!“"
                                            },
                                            {
                                                "example_id": "55a93bcb-73a5-4797-8896-bc25a27bbf89",
                                                "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                                "text": "„Der Geschmack brennt unter und auf der Zunge, der Rausch ist schwer übelkeitserzeugend.“"
                                            },
                                            {
                                                "example_id": "8218bb1d-efd5-4303-9ac7-4ef69b7d28e0",
                                                "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                                "text": "„Die Erinnerung an den süßlich-säuerlichen Geschmack von Anar zieht mir den Mund zusammen.“"
                                            },
                                            {
                                                "example_id": "18cd248a-476e-4631-ae54-f7cbae23c6fe",
                                                "sense_id": "204275cd-13e6-3c30-8cbe-f88e2d1eb918",
                                                "text": "„Das Mädchen ließ sich Zeit, mochte vielleicht nicht von seinem Karamellbonbon lassen, an dem es eifrig lutschte, um an den süßen Geschmack zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4290f1a1-f090-3eb0-8723-5c2bc708bd33",
                                        "entry_id": "8db8b189-bb85-3c69-932d-f5fb28671544",
                                        "glosses": [
                                            "Urteilsvermögen bezüglich ästhetischer Werturteile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba2af8f-3290-479d-be56-2c7e11f1b3f6",
                                                "sense_id": "4290f1a1-f090-3eb0-8723-5c2bc708bd33",
                                                "text": "Mit der Wahl dieses Abendkleides hat sie schlechten Geschmack bewiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                        "entry_id": "8db8b189-bb85-3c69-932d-f5fb28671544",
                                        "glosses": [
                                            "Vorlieben einer Person vor allem hinsichtlich Ästhetik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fcf892e-f77d-4c7a-9b57-3c97879e12d7",
                                                "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                                "text": "Für meinen Geschmack ist das Schlagzeug zu laut."
                                            },
                                            {
                                                "example_id": "5703e9ee-6691-4905-8e48-07d9f146757c",
                                                "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                                "text": "Ob man die Band mag, ist eine Frage des Geschmacks."
                                            },
                                            {
                                                "example_id": "31609dc0-9745-41fa-bb5d-9f838746cb80",
                                                "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                                "text": "„Mehr als einmal nahm er mich mit, schickte nach dem Regimentsschneider und ließ Kleider für mich anfertigen, die seinem Geschmack entsprachen.“"
                                            },
                                            {
                                                "example_id": "4b88151d-1d3e-43a6-ab29-da151fe9f154",
                                                "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                                "text": "„Indes geht es hier nicht um den persönlichen Geschmack Wustmanns und damit die Subjektivität seiner Sprachverbesserungen, sondern um Erfolg und Wirkung eines Werks, das immerhin länger als ein halbes Jahrhundert das sprachkritische Standardbuch der Deutschen bildete.“"
                                            },
                                            {
                                                "example_id": "4ca3f852-759d-46e5-8bc1-0663e4871068",
                                                "sense_id": "484f6c80-709b-39b7-acd8-74ac9b4c6905",
                                                "text": "„Auch in Dingen des persönlichen Geschmacks ergänzten sie einander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fb79067b-f28f-32f8-8117-d088164814ed",
                                        "entry_id": "8db8b189-bb85-3c69-932d-f5fb28671544",
                                        "glosses": [
                                            "Wertmaßstab einer Zeit, Epoche, Region und Ähnlichem zur Ästhetik"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "118a15af-28bd-4fe3-9060-cb9ce7c10198",
