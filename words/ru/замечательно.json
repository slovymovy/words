    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "90b85710-7988-3cd6-8fb0-f28df1f7b261",
                    "sense_definition": "Очень хорошо, превосходно; вызывая чувство восторга или удовлетворения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positive_evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <замечательно> провели время в отпуске на море.",
                            "target_lang_translations": {
                                "en": "We had a <wonderful> time on vacation by the sea.",
                                "es": "Pasamos un tiempo <maravillosamente> bien en nuestras vacaciones en el mar.",
                                "fr": "Nous avons <merveilleusement> passé nos vacances au bord de la mer."
                            }
                        },
                        {
                            "text": "Ты сегодня <замечательно> выглядишь в этом новом платье.",
                            "target_lang_translations": {
                                "en": "You look <great> today in that new dress.",
                                "es": "Te ves <estupendamente> hoy con ese vestido nuevo.",
                                "fr": "Tu es <magnifique> aujourd'hui dans cette nouvelle robe."
                            }
                        },
                        {
                            "text": "У нас всё <замечательно>, спасибо за беспокойство.",
                            "target_lang_translations": {
                                "en": "Everything is <great> with us, thanks for your concern.",
                                "es": "Todo va <genial> con nosotros, gracias por preocuparte.",
                                "fr": "Tout va <très bien> pour nous, merci de vous en soucier."
                            }
                        }
                    ],
                    "synonyms": [
                        "прекра́сно",
                        "отли́чно",
                        "великоле́пно",
                        "превосходно",
                        "чудесно",
                        "классно"
                    ],
                    "antonyms": [
                        "плохо",
                        "ужасно",
                        "отвратительно"
                    ],
                    "common_phrases": [
                        "всё замечательно",
                        "выглядеть замечательно",
                        "чувствовать себя замечательно"
                    ],
                    "target_lang_definitions": {
                        "en": "Very well, excellently; causing a feeling of delight or satisfaction.",
                        "es": "Muy bien, de forma excelente; que causa un sentimiento de deleite o satisfacción.",
                        "fr": "Très bien, de manière excellente ; provoquant un sentiment de joie ou de satisfaction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wonderful",
                                "target_lang_sense_clarification": "causing delight"
                            },
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "very good (informal)"
                            },
                            {
                                "target_lang_word": "excellent",
                                "target_lang_sense_clarification": "of high quality"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "maravillosamente",
                                "target_lang_sense_clarification": "de manera maravillosa"
                            },
                            {
                                "target_lang_word": "estupendamente",
                                "target_lang_sense_clarification": "de forma excelente"
                            },
                            {
                                "target_lang_word": "genial",
                                "target_lang_sense_clarification": "muy bien (informal)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "merveilleusement",
                                "target_lang_sense_clarification": "de façon merveilleuse"
                            },
                            {
                                "target_lang_word": "très bien",
                                "target_lang_sense_clarification": "de manière très satisfaisante"
                            },
                            {
                                "target_lang_word": "parfaitement",
                                "target_lang_sense_clarification": "de façon excellente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c23723-b343-3c7e-814f-eb23a7c239dd",
                    "sense_definition": "Необыкновенно, исключительно, на редкость (обычно о качестве, вызывающем удивление).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Её лицо было <замечательно> бледным в лунном свете.",
                            "target_lang_translations": {
                                "en": "Her face was <remarkably> pale in the moonlight.",
                                "es": "Su rostro estaba <notablemente> pálido bajo la luz de la luna.",
                                "fr": "Son visage était <remarquablement> pâle au clair de lune."
                            }
                        },
                        {
                            "text": "Это было <замечательно> глупое решение для такого умного человека.",
                            "target_lang_translations": {
                                "en": "It was a <remarkably> stupid decision for such a smart person.",
                                "es": "Fue una decisión <excepcionalmente> estúpida para una persona tan inteligente.",
                                "fr": "C'était une décision <remarquablement> stupide pour une personne aussi intelligente."
                            }
                        }
                    ],
                    "synonyms": [
                        "порази́тельно",
                        "удиви́тельно",
                        "примеча́тельно"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "устар."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Unusually, exceptionally (usually regarding a quality that causes surprise).",
                        "es": "De manera inusual o excepcional; que causa sorpresa o llama la atención.",
                        "fr": "De manière inhabituelle ou exceptionnelle, souvent pour souligner une qualité surprenante."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remarkably",
                                "target_lang_sense_clarification": "worthy of attention"
                            },
                            {
                                "target_lang_word": "exceptionally",
                                "target_lang_sense_clarification": "unusually"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "notablemente",
                                "target_lang_sense_clarification": "que merece atención"
                            },
                            {
                                "target_lang_word": "excepcionalmente",
                                "target_lang_sense_clarification": "de forma inusual"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "remarquablement",
                                "target_lang_sense_clarification": "d'une manière qui attire l'attention"
                            },
                            {
                                "target_lang_word": "exceptionnellement",
                                "target_lang_sense_clarification": "de façon inhabituelle"
                            }
                        ]
                    }
                }
            ]
        },
