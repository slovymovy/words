                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ac3e6d5-63e6-3fa8-bc34-9fbd0cf2ae48",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A spirit believed to speak through a medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b888f9b0-43e0-4096-8585-479b2ee94fc0",
                                                "sense_id": "5ac3e6d5-63e6-3fa8-bc34-9fbd0cf2ae48",
                                                "text": "The familiars of the magicians, on the other hand, were not in all cases evil, and often may have approximated the \"guides\" with whom present-day spiritualists are well acquainted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393556f8-652a-37fc-981a-b50625bf6476",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A member of a group marching in formation who sets the pattern of movement or alignment for the rest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To serve as a guide for someone or something; to lead or direct in a way; to conduct in a course or path."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbbfbb40-b7a5-4eb7-aec3-1ae06e12f15b",
                                                "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                                "text": "And that you'd guide me to your Soueraignes Court,"
                                            },
                                            {
                                                "example_id": "a1b34137-fc1a-44c0-8cf4-2c29ddc9ce9f",
                                                "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                                "text": "Kolyat: I brought a prayer book, Commander. Would you care to join me?\nKolyat: Kalahira, this one's heart is pure, but beset by wickedness and contention.\nShepard: Guide this one to where the traveler never tires, the lover never leaves, the hungry never starve.\nShepard: Guide this one, Kalahira, and she will be a companion to you as she was to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d4dadf-78a3-3351-8427-512963a1fd3a",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To steer or navigate, especially a ship or as a pilot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ba5a65-c52a-36c3-abdb-2eb05ac9ae60",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To exert control or influence over someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5dd9a44-353e-4460-975a-00eb6878b2b5",
                                                "sense_id": "d4ba5a65-c52a-36c3-abdb-2eb05ac9ae60",
                                                "text": "A good man sheweth fauour and lendeth: he will guide his affaires with discretion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2dee0c-49ee-3214-83df-35d19a440641",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To supervise the education or training of someone."
                                        ],
                                        "tags": [],
                                        "examples": []
