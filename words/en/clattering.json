{
    "word_family": [
        "clatter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc8059f5-691c-3704-be3a-c630a1e694e6",
                    "sense_definition": "present participle and gerund of <w>clatter</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old train was <w>clattering</w> along the tracks as it approached the station.",
                            "target_lang_translations": {
                                "zh": "那列旧火车在接近车站时，在铁轨上<w>叮当作响</w>地行驶着。"
                            }
                        },
                        {
                            "text": "I could hear the dishes <w>clattering</w> in the kitchen while my brother was cooking.",
                            "target_lang_translations": {
                                "zh": "我哥哥做饭时，我能听到厨房里碗盘<w>叮当作响</w>的声音。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发出连续的碰撞声或咔哒声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发出咔哒声",
                                "target_lang_sense_clarification": "指物体碰撞发出的连续响声"
                            },
                            {
                                "target_lang_word": "叮当作响",
                                "target_lang_sense_clarification": "形容金属或硬物碰撞的声音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5f286d4-0573-3e82-8542-80c1d7754310",
                    "sense_definition": "A sharp, rattling sound made by hard objects hitting each other.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>clattering</w> of pans in the kitchen startled the sleeping cat.",
                            "target_lang_translations": {
                                "zh": "厨房里突然传来的一阵锅碗<w>叮当声</w>惊吓到了正在睡觉的猫。"
                            }
                        },
                        {
                            "text": "She heard a loud <w>clattering</w> as the keys fell onto the wooden floor.",
                            "target_lang_translations": {
                                "zh": "钥匙掉在木地板上时，她听到了一声响亮的<w>咔哒声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rattle",
                        "clatter"
                    ],
                    "common_phrases": [
                        "loud clattering"
                    ],
                    "target_lang_definitions": {
                        "zh": "硬物碰撞时发出的尖锐、连续的响声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叮当声",
                                "target_lang_sense_clarification": "硬物碰撞发出的声音"
                            },
                            {
                                "target_lang_word": "咔哒声",
                                "target_lang_sense_clarification": "物体撞击发出的短促响声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34d6e951-0cb1-363b-9048-b2b63fd76f83",
                    "sense_definition": "Characterized by or producing a loud, rattling noise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a song with heavy and <w>clattering</w> drums that echoed through the hall.",
                            "target_lang_translations": {
                                "zh": "乐队演奏了一首曲子，沉重而<w>叮当作响</w>的鼓声在大厅里回荡。"
                            }
                        },
                        {
                            "text": "We walked across the <w>clattering</w> metal bridge during the storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨中，我们走过了那座<w>叮当作响</w>的金属桥。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rattling",
                        "noisy"
                    ],
                    "antonyms": [
                        "silent",
                        "quiet"
                    ],
                    "common_phrases": [
                        "clattering drums"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出响亮、嘈杂的碰撞声的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叮当作响的",
                                "target_lang_sense_clarification": "形容发出连续碰撞声的"
                            },
                            {
                                "target_lang_word": "嘈杂的",
                                "target_lang_sense_clarification": "形容声音响亮且混乱的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}