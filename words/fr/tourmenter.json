                },
                {
                    "sense_id": "412ba61b-fe81-3be9-aad1-41eb6872be00",
                    "sense_definition": "S'inquiéter excessivement, se faire du souci pour quelque chose ou quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiétude_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas se <w>tourmenter</w> pour des détails sans importance.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>fret</w> over trivial details.",
                                "ru": "Не стоит <w>беспокоиться</w> из-за мелочей.",
                                "de": "Man sollte <w>sich</w> wegen belangloser Details nicht <w>aufregen</w>.",
                                "es": "No hay que <w>preocuparse</w> por detalles sin importancia.",
                                "zh": "不要为这些无关紧要的细节<w>担心</w>。"
                            }
                        },
                        {
                            "text": "Elle passe des nuits blanches à se <w>tourmenter</w> au sujet de ses examens.",
                            "target_lang_translations": {
                                "en": "She spends sleepless nights <w>worrying</w> about her exams.",
                                "ru": "Она проводит бессонные ночи, <w>беспокоясь</w> из-за экзаменов.",
                                "de": "Sie verbringt schlaflose Nächte damit, <w>sich</w> um ihre Prüfungen zu <w>sorgen</w>.",
                                "es": "Pasa noches en vela <w>preocupándose</w> por sus exámenes.",
                                "zh": "她为了考试的事<w>担心</w>得彻夜难眠。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "se tourmenter pour"
                    ],
                    "target_lang_definitions": {
                        "en": "To worry excessively about something or someone.",
                        "ru": "Чрезмерно беспокоиться или переживать из-за чего-либо или кого-либо.",
                        "de": "Sich übermäßig um etwas oder jemanden sorgen.",
                        "es": "Preocuparse en exceso por algo o por alguien.",
                        "zh": "过分地为某事或某人担心、操心。"
                    },
