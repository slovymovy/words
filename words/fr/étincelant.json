                    "frequency": "Middle",
                    "semantic_group_id": "eclat_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La neige fraîche était <w>étincelante</w> sous les premiers rayons du soleil d'hiver."
                        },
                        {
                            "text": "Elle portait pour la soirée une robe <w>étincelante</w> ornée de perles et de sequins."
                        }
                    ],
                    "synonyms": [
                        "brillant",
                        "scintillant"
                    ],
                    "common_phrases": [
