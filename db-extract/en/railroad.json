                "senses": [
                    {
                        "sense_id": "d3cc0081-2f6a-3d44-809e-49df5122f75d",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To transport via railroad."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "643028b9-4912-3e58-b5bf-e028e8fce046",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To operate a railroad."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "81bef0ef-8767-47c9-9ea8-f03f2b6ebaa7",
                                "sense_id": "643028b9-4912-3e58-b5bf-e028e8fce046",
                                "text": "The Thatcherite experiment proved the private sector can railroad as inefficiently as a state monopoly."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d58e081-bbd1-3415-b702-0367ab6b5219",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To work for a railroad."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "88b9c21c-d9de-3f35-9bef-537708c929ba",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To travel by railroad."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "12cec4b9-ad21-31dc-9341-446cdc77646c",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To engage in a hobby pertaining to railroads."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eaade1ce-81f4-3ac1-854a-bd30ab061e19",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To manipulate and hasten a procedure, as of formal approval of a law or resolution."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a700029a-47df-41e8-a949-033cf1dd75e3",
                                "sense_id": "eaade1ce-81f4-3ac1-854a-bd30ab061e19",
                                "text": "The majority railroaded the bill through parliament, without the customary expert studies which would delay it till after the elections."
                            },
                            {
                                "example_id": "4f1d810c-24f6-4b58-a07e-8cdda8c5a26b",
                                "sense_id": "eaade1ce-81f4-3ac1-854a-bd30ab061e19",
                                "text": "Sebastian Riedel lodged a complaint with TPF board, which he says was railroaded by a board member—therefore, Riedel quit."
                            },
                            {
                                "example_id": "e87679f8-a3b1-4b80-b706-5be345b8f0ac",
                                "sense_id": "eaade1ce-81f4-3ac1-854a-bd30ab061e19",
                                "text": "What appears suspect about the Beeching Report is how quickly it was railroaded through, with the answers manufactured before the questions were asked."
                            }
                        ]
                    },
                    {
                        "sense_id": "f263c26d-c207-3af0-8122-5e9bbfd3cce9",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To convict of a crime by circumventing due process."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b8e26677-3f3b-4ec1-82a6-ae2758a6b7b5",
                                "sense_id": "f263c26d-c207-3af0-8122-5e9bbfd3cce9",
                                "text": "They could only convict him by railroading him on suspect drug-possession charges."
                            },
                            {
                                "example_id": "92e4805d-3e52-4402-88ed-37ac4446e593",
                                "sense_id": "f263c26d-c207-3af0-8122-5e9bbfd3cce9",
                                "text": "My witnesses were not questioned to my advantage. Physical evidence in my attorney's possession was not presented to the jury. A promised expert witness was not called nor even sought. I knew that I was being railroaded but I was helpless."
                            },
                            {
                                "example_id": "b9cf5567-8006-4d86-a7c8-ee28780fb8e3",
                                "sense_id": "f263c26d-c207-3af0-8122-5e9bbfd3cce9",
                                "text": "\"I'm going to the^([sic]) Hague to see Mr Milosevic at his request,\" he told CBC radio before leaving Canada. \"All of us feel he's being railroaded and used as a scapegoat for Nato's attack on Yugoslavia."
                            },
                            {
                                "example_id": "dff2ab87-48e5-4d9c-bc44-f02d0a481299",
                                "sense_id": "f263c26d-c207-3af0-8122-5e9bbfd3cce9",
                                "text": "Stark reminder of how an innocent man can be railroaded into spending years in jail [title]"
                            }
                        ]
                    },
                    {
                        "sense_id": "02de7f70-5376-31d9-8afc-af148c9e57e9",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To procedurally bully someone into an unfair agreement."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8e1b8545-c390-4d77-a8ed-4e231002ed85",
                                "sense_id": "02de7f70-5376-31d9-8afc-af148c9e57e9",
                                "text": "He was railroaded into signing a non-disclosure agreement at his exit interview."
                            },
                            {
                                "example_id": "77892de5-436b-4262-bd1d-d18b1ca09d94",
                                "sense_id": "02de7f70-5376-31d9-8afc-af148c9e57e9",
                                "text": "Also on Friday, The Daily News published a column by Richard Azzopardi, a senior adviser to the governor, who wrote that Mr. Cuomo had been “railroaded” by Ms. James, a Democrat who is considered a possible candidate for governor next year but who has not said she plans to run."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8931c41-51c9-3ab3-82de-9f0e65798b3f",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To force players to follow the dungeon master's planned plot rather than improvise an alternative story."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9e78ba71-352d-343c-a419-68007e54fbf4",
                        "entry_id": "eeeec851-9991-3f00-ac0a-2f43200dcf47",
                        "glosses": [
                            "To run fabric horizontally instead of the usual vertically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c4af35-1880-4af3-b657-d69d0cae583e",
                                "sense_id": "9e78ba71-352d-343c-a419-68007e54fbf4",
                                "text": "If you are upholstering a larger item, such as a sofa, it's a good idea to see if the fabric you are buying can be railroaded. Railroading refers to being able to run the fabric from left to right, rather than the conventional top to bottom. […][W]hen a pattern is railroaded you can turn it on its side and roll it out to the width of the sofa without join lines."
                            }
                        ]
                    }
                ],
