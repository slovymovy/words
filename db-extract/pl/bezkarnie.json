                                                "sense_id": "0db0d949-2c3f-3f11-8d07-d5cf457586c8",
                                                "text": "Der Angeklagte ging straffrei aus."
                                            },
                                            {
                                                "example_id": "dfaea238-4020-46fb-82fd-665c13d2992d",
                                                "sense_id": "0db0d949-2c3f-3f11-8d07-d5cf457586c8",
                                                "text": "Die Verantwortlichen des Massakers blieben straffrei."
                                            },
                                            {
                                                "example_id": "ae5105e0-2630-469d-9539-4b8b42a38178",
                                                "sense_id": "0db0d949-2c3f-3f11-8d07-d5cf457586c8",
                                                "text": "„Die meisten Länder haben Kokain verboten, nur in wenigen bleibt der Besitz geringer Mengen straffrei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
