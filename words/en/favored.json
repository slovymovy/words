            "senses": [
                {
                    "sense_id": "6df273d2-2d75-3a44-99a8-2efa99dce7d2",
                    "sense_definition": "Preferred or treated with partiality; having special advantages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the <w>favored</w> candidate to win the election by a wide margin.",
                            "target_lang_translations": {
                                "zh": "她是<w>最被看好的</w>候选人，预计会以绝对优势赢得选举。"
                            }
                        },
                        {
                            "text": "Certain companies received <w>favored</w> treatment from the local government.",
                            "target_lang_translations": {
                                "zh": "某些公司获得了当地政府给予的<w>优惠</w>待遇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preferred",
                        "chosen"
                    ],
                    "antonyms": [
                        "disfavored"
                    ],
                    "common_phrases": [
                        "favored candidate",
                        "favored status",
                        "most favored nation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "受优待的，受青睐的；最有希望获胜或受到偏爱的。"
                    },
