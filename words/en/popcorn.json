    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdc50934-80f1-3910-bc1c-c49ecc0b4acd",
                    "sense_definition": "A snack food made from corn or maize kernels popped by dry heating.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a large bucket of <w>popcorn</w> to eat during the movie.",
                            "target_lang_translations": {
                                "ru": "Мы купили большое ведро <w>попкорна</w>, чтобы поесть во время фильма.",
                                "zh": "我们买了一大桶<w>爆米花</w>在看电影时吃。",
                                "es": "Compramos un cubo grande de <w>palomitas</w> para comer durante la película."
                            }
                        },
                        {
                            "text": "Do you prefer sweet or salty <w>popcorn</w>?",
                            "target_lang_translations": {
                                "ru": "Ты предпочитаешь сладкий или соленый <w>попкорн</w>?",
                                "zh": "你喜欢甜的还是咸的<w>爆米花</w>？",
                                "es": "¿Prefieres las <w>palomitas</w> dulces o saladas?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buttered popcorn",
                        "microwave popcorn",
                        "eat popcorn",
                        "popcorn bucket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закуска из зерен кукурузы, которые разрываются и увеличиваются в объеме при нагревании.",
                        "zh": "一种由玉米粒经干热加热后爆裂而成的零食。",
                        "es": "Un aperitivo hecho de granos de maíz que se inflan al calentarlos en seco."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попкорн",
                                "target_lang_sense_clarification": "закуска"
                            },
                            {
