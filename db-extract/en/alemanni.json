            {
                "entry_id": "7a8a9a9a-b02d-3333-b7e4-e1bef7acd7ea",
                "word": "Alemanni",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbde7cd2-e01b-3e53-bf25-4eed881eb711",
                        "entry_id": "7a8a9a9a-b02d-3333-b7e4-e1bef7acd7ea",
                        "glosses": [
                            "A group of Germanic peoples living between the Rhine, Main, and Danube Rivers from the third to the sixth century."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "10be7b35-6b56-4e59-a3de-bb03e8fcc641",
                                "sense_id": "cbde7cd2-e01b-3e53-bf25-4eed881eb711",
                                "text": "The hasty army of volunteers gradually coalesced into a great and permanent nation, and, as it was composed from so many different tribes, assumed the name of Alemanni, or Allmen ; to denote at once their various lineage, and their common bravery."
                            },
                            {
                                "example_id": "a663aa57-76c4-4b42-8e8a-b0e98374aa2e",
                                "sense_id": "cbde7cd2-e01b-3e53-bf25-4eed881eb711",
                                "text": "The Alemanni were originally composed of fragments of several Germanic peoples, and they remained a loosely knit confederation of tribes in the Suebi group (see Suebi)."
                            }
                        ]
                    },
                    {
                        "sense_id": "9460267e-cda7-3026-b109-cae2ab62bd88",
                        "entry_id": "7a8a9a9a-b02d-3333-b7e4-e1bef7acd7ea",
                        "glosses": [
                            "Those individuals descended from one of the Alemanni tribes."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "eda841eb-67d2-408b-9cac-595deb958993",
                                "sense_id": "9460267e-cda7-3026-b109-cae2ab62bd88",
                                "text": "On the basis of their location along the Rhine River during the sixteenth and seventeenth centuries, I have concluded that my ancestors were Alemanni and Franks, though lacking in ethnic purity."
                            }
                        ]
                    }
                ],
