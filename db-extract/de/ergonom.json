                        "entry_id": "28c2469f-3964-3e8c-a7aa-1d85d4db16dd",
                        "glosses": [
                            "Person, die sich mit dem arbeitenden Menschen in seinem Arbeitsumfeld (Ergonomie) beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f83d0d-4c54-4780-8f46-1aa50b2fb7a0",
                                "sense_id": "024acc74-2410-3c83-82ef-4cd945b5d900",
                                "text": "Der Ergonom untersucht und gestaltet Arbeitsplätze unter ergonomischen, biomechanischen und funktionellen Gesichtspunkten."
                            },
                            {
                                "example_id": "51c610e2-795e-49b3-a781-341b0abfbafd",
                                "sense_id": "024acc74-2410-3c83-82ef-4cd945b5d900",
                                "text": "Als Ergonom fand er seine erste Anstellung in der Arbeitsstudienabteilung eines Chemiekonzerns."
                            }
                        ],
