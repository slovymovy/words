                        "form": "наста́вивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ac8ce1c-729c-35ce-ae82-99a5b43b31b8",
                        "entry_id": "eaada808-a52c-3654-9db7-bafc595505ce",
                        "glosses": [
                            "разг. поставить в каком-нибудь количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc863567-30d8-4901-b070-c13fcf7838a1",
                                "sense_id": "7ac8ce1c-729c-35ce-ae82-99a5b43b31b8",
                                "text": "Наставить сторожей. Наставить много мебели."
                            }
                        ]
                    },
                    {
                        "sense_id": "a01999bb-2d6c-37b0-b4d9-46d83751840c",
                        "entry_id": "eaada808-a52c-3654-9db7-bafc595505ce",
                        "glosses": [
                            "прибавив, приставив, удлинить на сколько-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d239324-070a-496d-8e29-b5e257831b4a",
                                "sense_id": "a01999bb-2d6c-37b0-b4d9-46d83751840c",
                                "text": "Наставить лестницу."
                            },
                            {
                                "example_id": "87611bbe-349d-41a5-8900-ee909694dcee",
                                "sense_id": "a01999bb-2d6c-37b0-b4d9-46d83751840c",
                                "text": "Длиннее прежнего я рукава наставлю."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b630679-3750-3834-a40a-ad87480ff168",
                        "entry_id": "eaada808-a52c-3654-9db7-bafc595505ce",
                        "glosses": [
                            "прибавить, приставить для удлинения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a50c954-550f-4bfe-9374-9f63c9433cb7",
                                "sense_id": "4b630679-3750-3834-a40a-ad87480ff168",
                                "text": "Наставить несколько сантиметров."
                            },
                            {
                                "example_id": "9c627423-b4a3-43c9-8285-35525b25c92c",
                                "sense_id": "4b630679-3750-3834-a40a-ad87480ff168",
                                "text": "Начал собирать обрывки да верёвки, от лаптей оборки, связал всё вместе, наставил и надавил, на конце клепец в аршин присадил; пошёл к ямищу, опустил верёвку с клепцом да потряхивает."
                            }
                        ]
                    },
                    {
                        "sense_id": "450b1c79-9e6c-3d43-92ec-b15d9ec57d21",
                        "entry_id": "eaada808-a52c-3654-9db7-bafc595505ce",
                        "glosses": [
                            "разг. направить, нацелить, установив в нужном положении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5319445a-b69c-4973-b503-1c563970380b",
                                "sense_id": "450b1c79-9e6c-3d43-92ec-b15d9ec57d21",
                                "text": "Наставить дуло револьвера на кого-нибудь. Наставить зрительную трубу."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
