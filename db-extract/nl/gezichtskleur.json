                        "examples": [
                            {
                                "example_id": "b7ba5473-437a-427e-a565-bd87ae84ddee",
                                "sense_id": "31c56c66-e7b5-356c-97dd-cd43abd0dc57",
                                "text": "Piet en Sint zijn in de nieuwe versies duidelijk gelijkwaardig geworden, het woord ‘knecht’ is overal geschrapt en vervangen door ‘Piet’, die daarmee een flinke promotie heeft gekregen. Ook wordt niet langer vermelding gemaakt van de gezichtskleur van Sinterklaas’ compagnon."
                            },
                            {
                                "example_id": "4888be0f-c68e-4bf8-8df7-e5b419ab579f",
                                "sense_id": "31c56c66-e7b5-356c-97dd-cd43abd0dc57",
                                "text": "Alle zwellingen waren verdwenen, maar de littekens van de hechtingen waren hier en daar nog duidelijk te zien en ze had een gezichtskleur die neigde naar groen en geel."
                            }
                        ]
                    }
