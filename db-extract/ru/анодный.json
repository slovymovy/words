                ],
                "senses": [
                    {
                        "sense_id": "1df9731c-5a82-380e-b88d-5b4337288bbe",
                        "entry_id": "5b018cc8-3a12-3fbb-9ebb-901fd4afb390",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным анод"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27f9d701-226f-4c1e-8456-dc65685a7771",
                        "source_entry_id": "5b018cc8-3a12-3fbb-9ebb-901fd4afb390",
                        "source_sense_id": "1df9731c-5a82-380e-b88d-5b4337288bbe",
                        "target_lang_word": "anodisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anodisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                        "entry_id": "c3022512-9066-3b7c-be1f-33b9a3bf36fa",
                                        "glosses": [
                                            "die Anode betreffend; mit der Anode zusammenhängend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a41a8a0d-dbd1-4aeb-ba26-3eb641ff90ce",
                                                "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                                "text": "Die anodische Reaktion der Metallauflösung, also der Transport positiver Ladung von der Elektrode weg, stellt einen elektrischen Strom dar und wird als anodischer Strom I_A bezeichnet."
                                            },
                                            {
                                                "example_id": "85c64bbb-c506-46e3-a074-230f3168000d",
                                                "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                                "text": "Das elektrolytische Entfetten erfolgt in einem Bad anodisch, kathodisch und im Umpolverfahren."
                                            },
                                            {
                                                "example_id": "9ccb0932-387d-4b15-92db-8ecfcb63228b",
                                                "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                                "text": "Für das Zustandekommen von anodischer Spannungsrisskorrosion ist das Zusammenspiel von Werkstoffzusammensetzung, Werkstoffgefüge, pH-Wert,Temperatur und örtlicher Zugspannung maßgebend."
                                            },
                                            {
                                                "example_id": "e17c42dc-7a52-4122-add5-274731c18ed7",
                                                "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                                "text": "Ein metallener Werkstoff läßt sich durch anodische Polarisation vor Korrosion schützen, wenn er in dem angreifenden Elektrolyten passivierbar ist und sein Ruhepotential im Bereich der aktiven Auflösung liegt."
                                            },
                                            {
                                                "example_id": "4bb36efb-3e6d-4e41-99fd-ff972cdfffa1",
                                                "sense_id": "0e2025ea-364c-30fd-9679-1cb43dcc4fd9",
                                                "text": "Polypyrrol (PPy) wird oxidativ, meist durch anodische Polymerisation von Pyrrol hergestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
