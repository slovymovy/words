                    {
                        "translation_id": "8f43fcf5-41d7-4527-a133-237d5cca870e",
                        "source_entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                        "source_sense_description": "Jewish nationalist movement",
                        "target_lang_word": "sionisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sionisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                        "entry_id": "e18ef33d-1391-385b-aab3-581d96c5678e",
                                        "glosses": [
                                            "Mouvement pour la fondation d’un centre spirituel, territorial ou étatique juif en Palestine, idéologie politique nationaliste apparue au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10096f9f-510d-4462-a79c-35f5d062e10d",
                                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                                "text": "Comprendre le sionisme est devenu indispensable, non seulement à qui s'interroge sur la présence du peuple juif au cœur de l’histoire du XXᵉ siècle, mais pour éclairer les enjeux peut-être les plus décisifs du monde contemporain."
                                            },
                                            {
                                                "example_id": "e36bbcc9-abc7-4a63-a886-13b22c71e8d6",
                                                "sense_id": "924d087d-bb6c-3cbf-a552-3ef416f14358",
                                                "text": "La fin du XIXᵉ siècle, Théodore Herzl donne son sens précis à un mouvement politique et à une idéologie naissants : le sionisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7eaab40-1b5b-443f-98d9-a45e0c5ece33",
                        "source_entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                        "source_sense_description": "Jewish nationalist movement",
                        "target_lang_word": "Zionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                        "entry_id": "9061dbda-7761-3bdb-af9d-8e0ea25d2a5b",
                                        "glosses": [
                                            "im 19. Jahrhundert entstandene jüdische Bewegung, die sich für die Errichtung eines jüdischen Staats in Palästina einsetzte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beaa9b98-60c5-411f-92c3-c9eceaeffa39",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "Der Zionismus entstand zeitgleich mit anderen europäischen Emanzipations- und Nationalbewegungen infolge der Aufklärung und der Französischen Revolution."
                                            },
                                            {
                                                "example_id": "753a1332-2587-4f17-9831-f7cb76f13f1d",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Herzl, der Begründer des politischen Zionismus, hatte sich im Übrigen auch vorgestellt, dass man im künftigen »Judenstaat« Deutsch als Landessprache pflegen, dass man in den Kaffeehäusern deutschsprachige Zeitungen lesen würde.“"
                                            },
                                            {
                                                "example_id": "2150d745-0bea-45ec-85ae-34880cd1cd72",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„In letzter Zeit hatte sich allerdings eine gewisse Abkühlung seiner Begeisterung für den Zionismus bemerkbar gemacht.“"
                                            },
                                            {
                                                "example_id": "27930cbc-a06f-45f0-ab43-f35f88a1bb84",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Nicht jede dieser Bewegungen hatte die Errichtung eines autonomen oder souveränen jüdischen Gemeinwesens auf einem eigenen Territorium zum Ziel, wie etwa der Zionismus, der eine Staatsgründung in Palästina anstrebte.“"
                                            },
                                            {
                                                "example_id": "f61df464-639c-4185-9150-3be20decad20",
                                                "sense_id": "03518345-c605-3217-932f-9a69edad44cf",
                                                "text": "„Ben Gurion begann außerdem den Aufstieg des Nationalsozialismus in Deutschland als ein Mittel zur Förderung des Zionismus zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19776ee5-1aac-442f-89df-307ec6f666f2",
