                "senses": [
                    {
                        "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                        "entry_id": "8f1eeada-b891-3714-b2c8-b840391d1dd3",
                        "glosses": [
                            "großflächiger Befall mit Schimmelpilzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128cbfb5-b0f9-4435-8b8f-84dd90e44754",
                                "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                                "text": "„Werden jedoch geeignete Oberflächen feucht (durch Kondenswasser, eindringendes Regenwasser, Spritzwasser in Bädern etc.), so beginnen Pilzsporen ein üppiges Wachstum und bilden den sichtbaren Schimmelpilzrasen.“"
                            },
                            {
                                "example_id": "3dff2653-1dca-44cd-9744-7c954a0689ab",
                                "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                                "text": "„Der Schaden durch Frass ist meistens nicht auffällig, da sich die Staubläuse vielfach mit dem \"Abgrasen\" der Schimmelpilzrasen begnügen.“"
                            },
                            {
                                "example_id": "bc330d01-7822-4ee7-acc6-86e6b0bf7b99",
                                "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                                "text": "„Die Putze waren nicht von einem Schimmelpilzrasen bedeckt, sondern wiesen einzelne Schimmelpilznester an der Oberfläche auf.“"
                            },
                            {
                                "example_id": "4ae4b6ad-8e78-466e-8835-ca642b429b03",
                                "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                                "text": "„Zur Bereitung von Camembert werden die vorgeformten Käse von außen mit verschiedenen Penicillium-Kulturen beimpft, so dass innerhalb weniger Tage ein dichter weißer Schimmelpilzrasen entsteht.“"
                            },
                            {
                                "example_id": "d3ceb5e2-da3e-46af-be3d-f129517d310f",
                                "sense_id": "f1258947-d9ba-314d-b4cd-2c887b3fda12",
                                "text": "„Es genügt also nicht, den Schimmelpilzrasen nur oberflächlich zu entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
