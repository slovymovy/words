                            "target_lang_translations": {
                                "en": "<w>Luke</w> is going to the library today to borrow a book."
                            }
                        },
                        {
                            "text": "Mijn beste vriend heet <w>Luk</w> en hij woont in Antwerpen.",
                            "target_lang_translations": {
                                "en": "My best friend is named <w>Luke</w> and he lives in Antwerp."
