                                        "entry_id": "deb78aae-8f4f-36a4-b311-eaaeb7514901",
                                        "glosses": [
                                            "ozbrojená organizace schopná bojovat zbraněmi o území"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135b0a47-fa1e-471e-9c1b-c46bcc2e04ed",
                                                "sense_id": "95f1d015-bbb0-30c1-8cba-f268131e0c42",
                                                "text": "Vojsko se vrací z Letné do kasáren. Nejdříve štábní důstojníci na koních, pak vojenská kapela."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0a2e3f1-908e-452b-9d84-ecabae41fa6c",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
                        "source_sense_description": "soldiers considered as a group",
                        "target_lang_word": "mužstvo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mužstvo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c0dd55e5-12b1-33fc-94d7-b72e04f34d63",
                                        "entry_id": "49204044-5825-30fe-adf5-48beee0e9649",
                                        "glosses": [
                                            "skupina mužů se společným posláním"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4c1d60-a204-4fd9-84b5-43fada198e87",
                                                "sense_id": "c0dd55e5-12b1-33fc-94d7-b72e04f34d63",
                                                "text": "Důstojníci musí držet mužstvo na deset kroků od těla a nedovolit mu, aby přemýšlelo samostatné nebo dokonce vůbec myslilo…"
                                            },
                                            {
                                                "example_id": "b8c5b3d8-8553-400d-b523-b1f37a5abe5a",
                                                "sense_id": "c0dd55e5-12b1-33fc-94d7-b72e04f34d63",
                                                "text": "Mužstvo na lodi bylo se hned zase bývalému svému veliteli poddalo, ježto nemělo náčelníků vzpoury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9d464f-63ec-347e-90be-1e2763cf9022",
                                        "entry_id": "49204044-5825-30fe-adf5-48beee0e9649",
                                        "glosses": [
                                            "soubor hráčů v kolektivních sportech"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005232eb-9faf-4865-8a8e-5fe5682c1f88",
                                                "sense_id": "6d9d464f-63ec-347e-90be-1e2763cf9022",
                                                "text": "Favorizované ostravské mužstvo žen do zápasu vstoupilo jaksepatří a v 17. minutě vedlo 10:5."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3bc90d5-51ec-49e2-9854-f052d74a6b1e",
                        "source_entry_id": "f8b76239-b9ae-3a64-8136-52b886f59cb5",
