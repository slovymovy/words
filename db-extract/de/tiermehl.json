                                "sense_id": "dea14105-b3bc-333c-bc62-39e913f7eda8",
                                "text": "In der Tierhaltung wird auch Tiermehl verfüttert."
                            },
                            {
                                "example_id": "60ef55e9-349f-4918-ba11-9f4b801b3247",
                                "sense_id": "dea14105-b3bc-333c-bc62-39e913f7eda8",
                                "text": "Dieses Ei schmeckt grässlich, als ob das arme Huhn Tiermehl bekommen hat."
                            }
                        ],
