                                        "glosses": [
                                            "Lignivore, qui se nourrit de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147bd4e6-7c3e-448b-9f6f-531c03e66d38",
                                                "sense_id": "75301da0-3c0e-31b1-beaa-284497d59b0d",
                                                "text": "Les insectes, les champignons xylophages."
                                            },
                                            {
                                                "example_id": "810fb89f-a39b-4ba5-bf68-b05b9344a4fb",
                                                "sense_id": "75301da0-3c0e-31b1-beaa-284497d59b0d",
                                                "text": "Il passe ses journées en forêt pour suivre l’exploitation d’autant plus que le bostryche, minuscule insecte xylophage qui a envahi la forêt vosgienne menace la Forêt-Noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727ece6d-7bd2-309c-8c49-636e5131b00a",
                                        "entry_id": "ab93d21b-513c-38d8-acb9-7560fc741180",
                                        "glosses": [
                                            "Qui dévore, ronge le bois."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
