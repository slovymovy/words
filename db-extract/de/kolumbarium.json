                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ad6f6da-a373-3cb8-a1b5-1f7aab015d4f",
                        "entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "glosses": [
                            "Taubenschlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535d1966-d935-4622-beaf-193d5c217e16",
                                "sense_id": "4ad6f6da-a373-3cb8-a1b5-1f7aab015d4f",
                                "text": "„Der Obstgarten grenzte an ein Kolumbarium mit grauem Strohdach, weiß gesprenkelt vom Kot der Tauben, beschattet von einer Linde, deren Geäst sich unbestimmt in dem der sie umgebenden Kastanien verlor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f54e51fd-2a58-3ba2-bb19-202b894921fd",
                        "entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "glosses": [
                            "übereinander angeordnete Nischen für die Aschenkrüge in altrömischen Grabkammern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461eef7d-7e1f-4002-8768-20a00bd233d9",
                                "sense_id": "f54e51fd-2a58-3ba2-bb19-202b894921fd",
                                "text": "„[…] und daß vielleicht sogar eine Halle da gestanden haben dürfte, in deren Nischen (Kolumbarien) die Römer ihre Aschentöpfe beyzusetzen in Gewohnheit hatten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4ab2ee24-0665-3417-a5cf-1d385751e7c6",
                        "entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "glosses": [
                            "altrömische Grabkammer mit den Nischen unter [2]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ede5fd8-40e4-4bc1-bb94-efaffb238fdc",
                                "sense_id": "4ab2ee24-0665-3417-a5cf-1d385751e7c6",
                                "text": "„Charakteristisch sind zwei Kolumbarien aus römischer Zeit. Eines davon, dem ein von dorischen Halbsäulen getragener Giebel monumentale Wirkung verleiht, kann auf das I. Jahrh. n.Chr. datiert werden […].“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "44689f0a-5c31-3e14-aacb-15786140480e",
                        "entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "glosses": [
                            "Gebäude bei einem Friedhof, in dem Urnen aufbewahrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25de0ec9-3036-4d2d-8511-4336aa4ecf18",
                                "sense_id": "44689f0a-5c31-3e14-aacb-15786140480e",
                                "text": "„Auf den Friedhöfen der Stadt werden 26 verschiedene Beisetzungsarten angeboten. Eine davon ist die Unterbringung von Urnen in sogenannten Kolumbarien.“"
                            },
                            {
                                "example_id": "ac1d7a45-7560-42dd-855e-3f688043850f",
                                "sense_id": "44689f0a-5c31-3e14-aacb-15786140480e",
                                "text": "„Tagsüber ist das Kolumbarium geöffnet, schreibt die Pfarrgemeinde St. Franziskus, damit die Trauernden der Toten gedenken können.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d90545ef-2189-4d26-8ab5-67d896becfbf",
                        "source_entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "source_sense_id": "4ad6f6da-a373-3cb8-a1b5-1f7aab015d4f",
                        "source_sense_description": "Taubenschlag",
                        "target_lang_word": "columbarium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "columbarium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a9dcb6-f468-3110-8edd-dfb9199a7c9a",
                                        "entry_id": "e11043b3-758f-3b69-bd1b-65fd12333b55",
                                        "glosses": [
                                            "A large, sometimes architecturally impressive building for housing a large colony of pigeons or doves, particularly those of ancien regime France."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b20d41e8-e976-4424-a00b-6f1ae1bfb434",
                                                "sense_id": "d1a9dcb6-f468-3110-8edd-dfb9199a7c9a",
                                                "text": "Their sides present the well-known appearance of the Roman columbaria (dove-cotes), but with the important difference, that they are adapted to contain coffins instead of urns, the holes being about 2 feet square and 6 feet deep."
                                            },
                                            {
                                                "example_id": "3df23954-c582-4855-b93f-1d1e579c03d9",
                                                "sense_id": "d1a9dcb6-f468-3110-8edd-dfb9199a7c9a",
                                                "text": "Doves were culticly protected; great towers were built for them in which they could nest; they were called columbaria (columba is the Latin word for dove)."
                                            },
                                            {
                                                "example_id": "e8516b13-43ce-4d29-8eaf-e8150bfa0552",
                                                "sense_id": "d1a9dcb6-f468-3110-8edd-dfb9199a7c9a",
                                                "text": "Fish ponds were stocked with netted fish during the summer as a source of protein and dove cotes, or as the Romans called them, 'columbariums', were another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9f6392e-0a16-3fd3-afbd-dbb99c69fa9f",
                                        "entry_id": "e11043b3-758f-3b69-bd1b-65fd12333b55",
                                        "glosses": [
                                            "A pigeonhole in such a dovecote."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f00cd99-ecc1-3917-a976-2de3d10349c4",
                                        "entry_id": "e11043b3-758f-3b69-bd1b-65fd12333b55",
                                        "glosses": [
                                            "A building, a vault or a similar place for the respectful and usually public storage of cinerary urns containing cremated remains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0adba966-b957-4e01-abae-f2fce92fb166",
                                                "sense_id": "5f00cd99-ecc1-3917-a976-2de3d10349c4",
                                                "text": "We have seen how it is originally language which works on the construction of concepts, a labor taken over in later ages by science. Just as the bee simultaneously constructs cells and fills them with honey, so science works unceasingly on this great columbarium of concepts, the graveyard of perceptions."
                                            },
                                            {
                                                "example_id": "ef90cd1a-8411-4d88-8e6a-8af424c1986a",
                                                "sense_id": "5f00cd99-ecc1-3917-a976-2de3d10349c4",
                                                "text": "The columbarium (vaults lined with recesses for cinerary urns) in the form of a grotto (a cave-like structure) is the centerpiece of the Elks plot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e790b4f7-4abf-34a0-8034-fe000c1bc448",
                                        "entry_id": "e11043b3-758f-3b69-bd1b-65fd12333b55",
                                        "glosses": [
                                            "A niche in such a building for housing urns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd046d7-920a-49a4-a802-4ccd7bf94494",
                        "source_entry_id": "088f19af-dbb5-36f2-9359-7a812f88a623",
                        "source_sense_id": "4ad6f6da-a373-3cb8-a1b5-1f7aab015d4f",
