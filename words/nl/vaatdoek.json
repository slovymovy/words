    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd9eae25-348d-3a4b-81bb-ea80a6e1dfb5",
                    "sense_definition": "Een doek die wordt gebruikt om het aanrecht, de gootsteen en het fornuis in de keuken schoon te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "keukengerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het koken veeg ik de tafel altijd even af met een vochtige <w>vaatdoek</w>.",
                            "target_lang_translations": {
                                "en": "After cooking, I always wipe the table with a damp <w>dishcloth</w>.",
                                "ru": "После готовки я всегда протираю стол влажной <w>тряпкой</w>."
                            }
                        },
                        {
                            "text": "Vergeet niet om de <w>vaatdoek</w> regelmatig te vervangen voor een schoon exemplaar.",
                            "target_lang_translations": {
                                "en": "Don't forget to replace the <w>dishcloth</w> regularly with a clean one.",
                                "ru": "Не забывайте регулярно заменять <w>кухонную тряпку</w> на чистую."
                            }
                        }
                    ],
                    "synonyms": [
                        "schoteldoek",
                        "wisdoek"
                    ],
                    "common_phrases": [
                        "natte vaatdoek",
                        "schone vaatdoek",
                        "vuile vaatdoek"
                    ],
                    "target_lang_definitions": {
                        "en": "A cloth used for cleaning the countertop, sink, and stove in the kitchen.",
                        "ru": "Тряпка, используемая для очистки столешницы, раковины и плиты на кухне."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dishcloth",
                                "target_lang_sense_clarification": "for cleaning surfaces"
                            },
                            {
                                "target_lang_word": "kitchen cloth",
                                "target_lang_sense_clarification": "general cleaning cloth"
                            },
                            {
                                "target_lang_word": "dishrag",
                                "target_lang_sense_clarification": "informal term for cleaning cloth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кухонная тряпка",
                                "target_lang_sense_clarification": "для протирки поверхностей"
                            },
                            {
                                "target_lang_word": "тряпка для стола",
                                "target_lang_sense_clarification": "для уборки на кухне"
                            },
                            {
                                "target_lang_word": "салфетка для уборки",
                                "target_lang_sense_clarification": "из микрофибры или ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f798790-e313-39b8-9f9f-326d4e0f8eff",
                    "sense_definition": "Een doek die specifiek bedoeld is voor het afwassen of afdrogen van de vaat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "keukengerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een <w>vaatdoek</w> maak je het aanrecht schoon, met een theedoek droog je het servies af.",
                            "target_lang_translations": {
                                "en": "You use a <w>dishcloth</w> to clean the counter, and a tea towel to dry the dishes.",
                                "ru": "<w>Кухонной тряпкой</w> вы чистите столешницу, а кухонным полотенцем вытираете посуду."
                            }
                        },
                        {
                            "text": "Hang de <w>vaatdoek</w> over de kraan zodat hij goed kan drogen.",
                            "target_lang_translations": {
                                "en": "Hang the <w>dishcloth</w> over the tap so it can dry properly.",
                                "ru": "Повесьте <w>тряпку</w> на кран, чтобы она могла хорошо высохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "keukenhanddoek"
                    ],
                    "common_phrases": [
                        "vaatdoek over de kraan"
                    ],
                    "target_lang_definitions": {
                        "en": "A cloth specifically intended for washing or drying dishes.",
                        "ru": "Тряпка, специально предназначенная для мытья или вытирания посуды."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dishcloth",
                                "target_lang_sense_clarification": "for washing dishes"
                            },
                            {
                                "target_lang_word": "tea towel",
                                "target_lang_sense_clarification": "specifically for drying dishes"
                            },
                            {
                                "target_lang_word": "dish towel",
                                "target_lang_sense_clarification": "for drying dishes"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тряпка для мытья посуды",
                                "target_lang_sense_clarification": "используется в процессе мытья"
                            },
                            {
                                "target_lang_word": "кухонное полотенце",
                                "target_lang_sense_clarification": "для вытирания посуды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
