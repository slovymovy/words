                    }
                ],
                "senses": [
                    {
                        "sense_id": "8922a9de-81f4-30d6-bc21-48b7fad629bb",
                        "entry_id": "37ce39f0-4b47-34d8-9b5a-eae0bc6a15f2",
                        "glosses": [
                            "für die sprechende(n) oder angesprochene(n) Person(en) beziehungsweise Ding(e) stehendes Pronomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a370efde-80f6-4677-9607-9db744ef92a7",
                                "sense_id": "8922a9de-81f4-30d6-bc21-48b7fad629bb",
                                "text": "„Ich“ ist das Personalpronomen der 1. Person."
                            },
                            {
                                "example_id": "f3002e88-f8db-4c1d-bf13-5c2a7cb1e439",
                                "sense_id": "8922a9de-81f4-30d6-bc21-48b7fad629bb",
                                "text": "„Als Konsequenz aus diesem Flexionsabbau ergibt sich, daß primär die Personalpronomina für das Funktionieren der Verbalflexion verantwortlich sind - ein Zustand, der sich nur geringfügig von den Verhältnissen im Dänischen, Schwedischen oder Norwegischen und deren Einheitsflexion abhebt.“"
                            },
                            {
                                "example_id": "93a6ffb9-ef6a-40a5-b090-744af8a5cb58",
                                "sense_id": "8922a9de-81f4-30d6-bc21-48b7fad629bb",
                                "text": "„Die Endung des Verbs zeigt deutlich, dass es sich hier um die erste Person Singular handelt, ein Personalpronomen war zur Verdeutlichung nicht nötig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44e1e64c-3575-4ece-b09d-dd1bb8d13dd3",
                        "source_entry_id": "37ce39f0-4b47-34d8-9b5a-eae0bc6a15f2",
                        "source_sense_id": "8922a9de-81f4-30d6-bc21-48b7fad629bb",
