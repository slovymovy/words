                    "frequency": "Middle",
                    "semantic_group_id": "elegantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij liep <w>zwierig</w> door de gangen van het paleis.",
                            "target_lang_translations": {
                                "en": "She walked <w>gracefully</w> through the corridors of the palace.",
                                "ru": "Она <w>грациозно</w> шла по коридорам дворца."
                            }
                        },
                        {
                            "text": "Met een <w>zwierig</w> gebaar schonk hij de glazen wijn in voor zijn gasten.",
                            "target_lang_translations": {
                                "en": "With a <w>flourish</w>, he poured the glasses of wine for his guests.",
                                "ru": "С <w>изящным</w> жестом он разлил вино по бокалам для своих гостей."
                            }
                        }
