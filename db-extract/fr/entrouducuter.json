                "senses": [
                    {
                        "sense_id": "cd50c5c9-78a2-319a-966b-2633b1f58fc7",
                        "entry_id": "246e7dfc-a3aa-3f8d-aa30-f165fd431edc",
                        "glosses": [
                            "Variante de trouducuter (enculer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a6934c-a5f1-4e4d-8066-8052daec5d5f",
                                "sense_id": "cd50c5c9-78a2-319a-966b-2633b1f58fc7",
                                "text": "Eux, il peuvent aller se faire entrouducuter ailleurs."
                            },
                            {
                                "example_id": "4f6b0128-9fa5-47c6-8536-52f2023a1b34",
                                "sense_id": "cd50c5c9-78a2-319a-966b-2633b1f58fc7",
                                "text": "Et voilà, il suffit d’avoir un peu moins le temps que d’hab’ et paf, on se fait entrouducuter par les autres plus prompts à trouver les erreurs !"
                            },
                            {
                                "example_id": "0bf0f213-855f-4120-8cee-c03ec7c4f7ba",
                                "sense_id": "cd50c5c9-78a2-319a-966b-2633b1f58fc7",
                                "text": "Et viens plutôt m’entrouducuter."
                            },
                            {
                                "example_id": "96966bac-c7bc-45fb-bff7-06500a3bc284",
                                "sense_id": "cd50c5c9-78a2-319a-966b-2633b1f58fc7",
                                "text": "Ils voulaient savoir ce que je ressentais, si j’en voulais à l’administration, à la terre entière, si je comprenais pourquoi j’étais là, si j’étais triste que mes parents viennent pas me voir, si je me faisais entrouducuter par d’autres détenus et tout le bazar..."
                            }
                        ]
                    }
