                        "sense_id": "92276668-cf94-371e-945d-6b8b904e407e",
                        "entry_id": "8e4cb09f-0fa7-3607-817a-9dff96c79464",
                        "glosses": [
                            "der Aufbau des Nervensystems oder von Teilen davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdd4a0f-8e88-499d-bc08-7b2c1e1c43d1",
                                "sense_id": "92276668-cf94-371e-945d-6b8b904e407e",
                                "text": "Zur Neuroanatomie der glutamergen Neurone ist zu bemerken, dass es sich beim Glutamat um den wichtigsten Neurotransmitter der corticalen Neurone handelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
