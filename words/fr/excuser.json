                    "frequency": "High",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a bien voulu <w>excuser</w> son retard exceptionnel ce matin."
                        },
                        {
                            "text": "Nous devons <w>excuser</w> ses maladresses car il commence tout juste ce travail."
                        }
                    ],
                    "synonyms": [
