                "senses": [
                    {
                        "sense_id": "2e1db861-8b03-379b-92c1-026125df6dc3",
                        "entry_id": "ebc6da2a-cd55-3e7e-b2fa-062076222a6a",
                        "glosses": [
                            "weibliches, für die Streitkräfte verantwortliches Regierungsmitglied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce694e7-c452-4808-8e1b-526c21bda19d",
                                "sense_id": "2e1db861-8b03-379b-92c1-026125df6dc3",
                                "text": "Seit April 2008 ist Carme Chacón Verteidigungsministerin Spaniens."
                            },
                            {
                                "example_id": "4d0dbe6e-39c2-45ac-bb01-f6afb1030c55",
                                "sense_id": "2e1db861-8b03-379b-92c1-026125df6dc3",
                                "text": "„Angesichts der weltweiten Bedrohungslage appellierte die französische Verteidigungsministerin Michèlle Alliot-Marie an alle Kollegen, ihre Verantwortung wahrzunehmen.“"
                            },
                            {
                                "example_id": "dba75f3b-20eb-4412-b6f3-1e5aa09fe487",
                                "sense_id": "2e1db861-8b03-379b-92c1-026125df6dc3",
                                "text": "„Die Verteidigungsministerin bekräftigte zugleich ihr Versprechen, den Dienst in der Truppe attraktiver und familienfreundlicher zu gestalten.“"
                            },
                            {
                                "example_id": "d19be0d9-1a6d-4954-8a2a-dc700bace5f3",
                                "sense_id": "2e1db861-8b03-379b-92c1-026125df6dc3",
                                "text": "„Die Finnin Elisabeth Rehn war von 1990 bis 1995 die erste Verteidigungsministerin der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
