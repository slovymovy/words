                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "517a4c8d-5c9c-4d04-9d39-64440a558ea7",
                        "source_entry_id": "4b040e65-9d39-3e1c-ab98-90ade65d96d6",
                        "target_lang_word": "Rhizom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhizom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f850679-d6bd-38b8-ab93-8703b5ae7121",
                                        "entry_id": "f28683cc-6da4-3aac-9f66-60934737378a",
                                        "glosses": [
                                            "nährstoffspeichernder, einer Wurzel ähnelnder Teil des Sprosses vieler Stauden in (oder knapp in) der Erde senkrecht oder waagrecht wachsend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46f24cd-59df-45ab-89b9-37ca598cb756",
                                                "sense_id": "1f850679-d6bd-38b8-ab93-8703b5ae7121",
                                                "text": "Die Schwertlilie hat fleischige Rhizome."
                                            },
                                            {
                                                "example_id": "c6612dc0-0768-4090-96fb-206333c41640",
                                                "sense_id": "1f850679-d6bd-38b8-ab93-8703b5ae7121",
                                                "text": "Ein Rhizom ist ein verzweigtes Sprossachsensystem, wie es Gartenbesitzer bei Unkräutern wie dem Giersch fürchten."
                                            },
                                            {
                                                "example_id": "a73bf26e-e31e-47cf-b375-cd4cf5652e8b",
                                                "sense_id": "1f850679-d6bd-38b8-ab93-8703b5ae7121",
                                                "text": "Rößler vermutet, dass sich die Schachtelhalme über ein Rhizom vermehrten, von dem aber bei der ausgewachsenen Pflanze nichts übrig blieb."
                                            },
                                            {
                                                "example_id": "93dfc4cc-0772-4c30-a28b-5b95e2ea0fda",
                                                "sense_id": "1f850679-d6bd-38b8-ab93-8703b5ae7121",
                                                "text": "„Liegt das Rhizom waagrecht im Boden, so streckt es sich und schiebt seine Endknospe vorwärts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
