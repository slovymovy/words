                                        "entry_id": "3c09a4c9-21d3-3dfe-bf4c-aadacca28e79",
                                        "glosses": [
                                            "A household in which a child or animal is raised by someone other than their natural or adoptive parent or owner (respectively), especially, in the case of a child, when that caregiver is otherwise unrelated to the child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be16c64f-22fc-4978-905e-350f8f9d2303",
                                                "sense_id": "0643cf97-0e53-35cd-baf4-d03330e4298c",
                                                "text": "The group placed him in a foster home with a woman and two little girls, then advertised in the local paper."
                                            },
                                            {
                                                "example_id": "943af2fb-e535-468d-acda-09534b2f8402",
                                                "sense_id": "0643cf97-0e53-35cd-baf4-d03330e4298c",
                                                "text": "Pete's foster home placements were never successful."
                                            },
                                            {
                                                "example_id": "ec811567-9bfa-454d-946b-401132e4787f",
                                                "sense_id": "0643cf97-0e53-35cd-baf4-d03330e4298c",
                                                "text": "For a long time, as they shifted him from foster home to foster home, his records lost somewhere, he believed he was an orphan; but slowly it came to him that this was not true: he was a bastard."
                                            }
                                        ]
                                    }
