                "senses": [
                    {
                        "sense_id": "d7b511cd-c408-3b70-8027-2e74a96c9098",
                        "entry_id": "7766a85d-95da-35db-b75b-0b2ef1e2ff30",
                        "glosses": [
                            "Sprachvarietät, die sich infolge bestimmter Kommunikationsfunktionen herausgebildet hat"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "4ddd15f2-c845-46f5-9608-10800dd190cd",
                                "sense_id": "d7b511cd-c408-3b70-8027-2e74a96c9098",
                                "text": "„Die äußeren sechs Ecken stellen sprachliche Großbereiche (‚Lekte‘) dar, die sich nach dem Medium (Mediolekte), der Funktion (Funktiolekte), der arealen Verteilung (Dialekte), der Sprechergruppen (Soziolekte), nach Alter und Geschlecht (Sexolekte, Alterssprachen) und nach Interaktionstypen bzw. Situationen (Situolekte) unterscheiden.“"
                            },
                            {
                                "example_id": "d45d6a99-2dc4-4678-8f14-d9a54d02d531",
                                "sense_id": "d7b511cd-c408-3b70-8027-2e74a96c9098",
                                "text": "„Löfflers Varietäten-Modell unterscheidet bei den Mediolekten geschriebener und gesprochener Sprache, bei den Funktiolekten gibt es eigens die Kategorie des Pressewesens bzw. der Zeitungssprache.“"
                            },
                            {
                                "example_id": "dcaa0cc5-5aaa-44af-9b43-6d3881bbbcc1",
                                "sense_id": "d7b511cd-c408-3b70-8027-2e74a96c9098",
                                "text": "„Fachsprache ist sprachwissenschaftlich betrachtet ein Funktiolekt des Deutschen, man bedient sich ihrer z.B., um etwas möglichst präzise oder eindeutig darzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
