                                "example_id": "674783b8-b605-40fa-9236-84603000aa5e",
                                "sense_id": "eaec942b-7851-32ed-858b-facfea8f91fd",
                                "text": "The poor old dog did look fairly peched, and didn't bat an eyelid when I lifted up the nearest pup, a black and white ball of fluff."
                            },
