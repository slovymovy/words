                                        "entry_id": "c961de21-6a06-3791-be72-6751f0cb573e",
                                        "glosses": [
                                            "urządzenie służące do zamiany informacji dźwiękowej na sygnał elektryczny, zwykle celem jej wzmocnienia"
                                        ],
                                        "tags": [],
