                "senses": [
                    {
                        "sense_id": "6f09e71f-c1f8-3a96-90bd-5fc7d2d36702",
                        "entry_id": "d8aba4e3-82b3-332a-a293-2bdc059ec96a",
                        "glosses": [
                            "unter häufig auftretenden Pannen leidend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a50909a6-89bb-40a4-8050-c3b5f14df516",
                                "sense_id": "6f09e71f-c1f8-3a96-90bd-5fc7d2d36702",
                                "text": "„Doch die Bordgastronomie ist pannengeplagt: Nicht immer klappt der Warennachschub, die teils veralteten Bordküchen gelten als chronische Sensibelchen.“"
                            },
                            {
                                "example_id": "ffc89909-0a44-4636-b9a0-76b7a891fa52",
                                "sense_id": "6f09e71f-c1f8-3a96-90bd-5fc7d2d36702",
                                "text": "„Weniger pannengeplagt sind Fernreisende, aber das reine Vergnügen ist das Bahnfahren auch für sie nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
