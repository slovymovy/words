                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e9fd1c-cc06-47a5-8225-c94a393908ef",
                                "sense_id": "12eded83-e09f-3399-93d1-784e885fbc6b",
                                "text": "Who doesn’t like crisp, hot, buttery-and-syrupy waffles?"
                            },
                            {
                                "example_id": "d6f456d6-3556-4db3-9d33-7a371d43390d",
                                "sense_id": "12eded83-e09f-3399-93d1-784e885fbc6b",
                                "text": "Cherry dropped into a chair and stared with lip-curling distate at the platter of sausages and their syrupy pancakes on the plates about her."
                            },
                            {
                                "example_id": "47e7fb7e-e079-4430-8490-55c6889e587e",
                                "sense_id": "12eded83-e09f-3399-93d1-784e885fbc6b",
                                "text": "Beth stabs her fork into a mound of syrupy waffles."
                            }
                        ]
                    },
