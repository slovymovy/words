                        "examples": [
                            {
                                "example_id": "943b4597-3618-4b22-9090-01a05814ba16",
                                "sense_id": "6957724f-d0ee-3f22-a972-47d0a18e8517",
                                "text": "On top of the agger, a foundation layer of large stones or cobbles would be rammed into the earth, and on top of that a finer surface layer of gravel or pebbles would be laid and compacted to form a hard, durable, even surface."
