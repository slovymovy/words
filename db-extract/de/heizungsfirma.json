                "senses": [
                    {
                        "sense_id": "86d61cd7-b89d-3d4f-a721-16c48fec43b4",
                        "entry_id": "11799bae-3192-37e4-86cf-247515e298c5",
                        "glosses": [
                            "Unternehmen, das im Bereich der Heiztechnik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "451a583e-f194-407f-b30d-fddb9f4bf1f1",
                                "sense_id": "86d61cd7-b89d-3d4f-a721-16c48fec43b4",
                                "text": "„Im Sommer 1997 sanierte eine Heizungsfirma in einem dreigeschossigen Wohnhaus komplett die Wärme- und Wasserinstallation.“"
                            },
                            {
                                "example_id": "726cfabe-1ba3-4761-b8c8-f8729928f734",
                                "sense_id": "86d61cd7-b89d-3d4f-a721-16c48fec43b4",
                                "text": "„Die Heizungsfirma läßt einen Tank für Flüssiggas hinter dem Stall aufstellen und montiert die Heizungsanlage.“"
                            },
                            {
                                "example_id": "d10ed21c-b5f8-40f4-9aa3-45a027f666d0",
                                "sense_id": "86d61cd7-b89d-3d4f-a721-16c48fec43b4",
                                "text": "„Eine Mieterin klagt per Mail, dass die Heizung dringend mit Wasser aufgefüllt werden müsse, sie könne die Heizungsfirma nicht erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
