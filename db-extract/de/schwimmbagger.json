                "senses": [
                    {
                        "sense_id": "764ece6b-fa9a-375a-aecd-3b8b9be03c2c",
                        "entry_id": "b1ee83ae-770f-3c44-9ae7-1a9644b68141",
                        "glosses": [
                            "Bagger, der auf einer schwimmfähigen Plattform montiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23101434-2508-40c7-b408-65c0455cea70",
                                "sense_id": "764ece6b-fa9a-375a-aecd-3b8b9be03c2c",
                                "text": "„Beim Prozeß der Verlandung räumen Schwimmbagger den Kleiboden ab und ersetzen ihn mit tragfähigem Sand vom Grund der Weser.“"
                            },
                            {
                                "example_id": "86cf679d-54cd-4565-9cfa-c8c8c968dd0f",
                                "sense_id": "764ece6b-fa9a-375a-aecd-3b8b9be03c2c",
                                "text": "„Das Wasser ist überraschend klar, der Blick bis zum Meeresgrund in durchschnittlich acht bis 15 Metern Tiefe abseits der Schwimmbagger ungetrübt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
