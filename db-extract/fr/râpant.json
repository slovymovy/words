                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab48df9a-8371-4e38-b687-8523362d7267",
                                "sense_id": "6bad5b10-9894-3093-9d44-f5e630b9eb04",
                                "text": "J’éveille en moi des pensées cruelles, mais émoussées, et qui ne blessent plus. Je les aiguise sur mon âme engourdie, et j’y prends plaisir, comme j’en prenais à passer sur ma langue cette herbe râpante. La langue saigne, mais il n’y a ni plaie ni douleur, et l’on boit son propre sang comme si c’était celui d’un autre."
                            }
                        ]
                    }
