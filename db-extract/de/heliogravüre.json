                                "target_senses": [
                                    {
                                        "sense_id": "df218891-2096-37f5-90a6-f7e48eab5843",
                                        "entry_id": "39e54cd0-f6f5-3b34-b11a-f6975339ec6e",
                                        "glosses": [
                                            "An apparatus for signalling by means of a moveable mirror which reflects flashes of sunlight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fcb48e-f646-4dc2-ae39-fce35cf85c0d",
                                                "sense_id": "df218891-2096-37f5-90a6-f7e48eab5843",
                                                "text": "Now Jones had left his new-wed bride to keep his house in order, / And hied away to the Hurrum Hills above the Afghan border, / To sit on a rock with a heliograph; but ere he left he taught / His wife the working of the Code that sets the miles at naught. / And Love had made him very sage, as Nature made her fair; / So Cupid and Apollo linked, per heliograph, the pair."
                                            },
                                            {
                                                "example_id": "8104f451-2982-4080-9cd6-f96c64359763",
                                                "sense_id": "df218891-2096-37f5-90a6-f7e48eab5843",
                                                "text": "It was a lieutenant and a couple of privates of the 8th Hussars, with a stand like a theodolite, which the artilleryman told me was a heliograph."
                                            },
                                            {
                                                "example_id": "b5a40bef-4cf1-4f00-9054-ae4cd14cbf32",
                                                "sense_id": "df218891-2096-37f5-90a6-f7e48eab5843",
                                                "text": "when we stood up at nightfall we saw, in the sunset, the sparkle of the heliograph above cities, on the far side of the horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "520b3f04-4d92-3d7a-9f6b-a3ac33e62596",
                                        "entry_id": "39e54cd0-f6f5-3b34-b11a-f6975339ec6e",
