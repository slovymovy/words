                        ],
                        "examples": [
                            {
                                "example_id": "022c462b-b0c8-4e96-9aea-996a210631ec",
                                "sense_id": "57940002-24fa-3c6b-93d5-2cf8755b6277",
                                "text": "Николай Петрович с сыном и с Базаровым отправились через тёмную и почти пустую залу, из-за двери которой мелькнуло молодое женское лицо, в гостиную, убранную уже в новейшем вкусе.",
                                "translation": "Nikolai Petrovich with his son and Bazarov walked through a dark and almost empty hall, through the door of which they caught a glimpse of a young woman's face, and into a drawing room furnished in the most modern style.",
                                "english": "Nikolai Petrovich with his son and Bazarov walked through a dark and almost empty hall, through the door of which they caught a glimpse of a young woman's face, and into a drawing room furnished in the most modern style."
                            }
                        ]
                    }
