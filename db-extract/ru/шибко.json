                        "examples": [
                            {
                                "example_id": "da8edac8-6e8c-4b3e-9db7-e311bd17c23b",
                                "sense_id": "2cf1df4f-42a3-37b3-bf55-9d85eb306c66",
                                "text": "ши́бко уда́рить кого́-либо",
                                "translation": "to give someone a hard knock",
                                "english": "to give someone a hard knock"
                            },
                            {
                                "example_id": "5e00c8c2-c9d4-49f8-a2ab-f60ef9538088",
                                "sense_id": "2cf1df4f-42a3-37b3-bf55-9d85eb306c66",
                                "text": "он ши́бко скуча́ет",
                                "translation": "he is very lonely",
                                "english": "he is very lonely"
                            },
                            {
                                "example_id": "f6006ae6-1c78-4736-b37b-a9d359b828f9",
                                "sense_id": "2cf1df4f-42a3-37b3-bf55-9d85eb306c66",
                                "text": "Моё тебе́ письмо́ — рабо́та над оши́бками,\nЧто́-либо меня́ть хоте́лось бы не ши́бко мне,\nМы мо́жем помолча́ть, сожги́ моё письмо́,\nРабо́тай над оши́бками"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
