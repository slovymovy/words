                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "158be8f8-596e-3194-9e56-49f0fd6a4da2",
                                        "entry_id": "164c8979-e3c1-3511-929a-f80287f6d2f6",
                                        "glosses": [
                                            "An emulsion of rubber in water, used in adhesives and the like."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "548faf4e-6e7e-33fa-98a9-46a4b842360f",
                                        "entry_id": "164c8979-e3c1-3511-929a-f80287f6d2f6",
                                        "glosses": [
                                            "Natural latex rubber, especially nonvulcanized rubber, such as is used in making latex gloves, latex condoms, and latex clothing."
                                        ],
                                        "tags": [
