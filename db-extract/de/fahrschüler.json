                "senses": [
                    {
                        "sense_id": "af49f375-f1cc-32e3-bb95-89456f546750",
                        "entry_id": "999a0a90-01c7-3ddc-a185-d80b291550f8",
                        "glosses": [
                            "Schüler, der öffentliche Verkehrsmittel nutzt, um zu seiner Schule zu kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527b8ce5-45a1-47e0-a771-32fc14222658",
                                "sense_id": "af49f375-f1cc-32e3-bb95-89456f546750",
                                "text": "„»Viele, die bisher mit dem Bus kamen, können nun zur Schule laufen, oder das Fahrrad benutzen.« Entsprechend werden die angestammten Fußgänger zu Fahrschülern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98911219-a2a2-38cf-80be-a38beab4fa78",
                        "entry_id": "999a0a90-01c7-3ddc-a185-d80b291550f8",
                        "glosses": [
                            "Anwärter auf eine Fahrerlaubnis/eines Führerscheins für ein (motorbetriebenes) Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8881c1a-73dc-4e33-95ce-14c5712dc0b1",
                                "sense_id": "98911219-a2a2-38cf-80be-a38beab4fa78",
                                "text": "Der Fahrschüler ist durch die Prüfung gefallen, weil er dem Polizisten die Vorfahrt genommen hatte."
                            },
                            {
                                "example_id": "3070ba8e-fc12-45f7-84f3-84f3a6b64597",
                                "sense_id": "98911219-a2a2-38cf-80be-a38beab4fa78",
                                "text": "„Dem Fahrschüler sind durch die theoretische und die praktische Ausbildung in der Fahrschule jene Kenntnisse und Fertigkeiten zu vermitteln, die es ihm ermöglichen, sich mit einem Kraftfahrzeug im Straßenverkehr vorschriftsgemäß, sicher und umweltbewusst zu verhalten und die ihn in die Lage versetzen, die angestrebte Lenkberechtigung zu erwerben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
