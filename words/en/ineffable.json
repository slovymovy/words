{
    "word_family": [
        "ineffability",
        "ineffably",
        "effable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9b682843-1166-36fa-b252-18f8203e6d1b",
                    "sense_definition": "Too great or extreme to be expressed or described in words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beyond expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset over the ocean filled her with an <w>ineffable</w> sense of peace and wonder.",
                            "target_lang_translations": {
                                "ru": "Закат над океаном наполнил её <w>невыразимым</w> чувством покоя и благоговения."
                            }
                        },
                        {
                            "text": "The artist spent years trying to capture the <w>ineffable</w> beauty of the mountain landscape.",
                            "target_lang_translations": {
                                "ru": "Художник потратил годы, пытаясь запечатлеть <w>неописуемую</w> красоту горного пейзажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "indescribable",
                        "inexpressible",
                        "unspeakable",
                        "indefinable",
                        "unutterable"
                    ],
                    "antonyms": [
                        "effable"
                    ],
                    "common_phrases": [
                        "ineffable beauty",
                        "ineffable joy",
                        "ineffable sadness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слишком великий или исключительный, чтобы его можно было выразить или описать словами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыразимый",
                                "target_lang_sense_clarification": "тот, который невозможно передать словами"
                            },
                            {
                                "target_lang_word": "несказанный",
                                "target_lang_sense_clarification": "поэтическое или возвышенное описание чего-то прекрасного"
                            },
                            {
                                "target_lang_word": "неописуемый",
                                "target_lang_sense_clarification": "не поддающийся описанию из-за своей силы или красоты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b193066-a272-3460-ab87-e0736a46983c",
                    "sense_definition": "Not to be uttered or spoken, often due to religious or social prohibition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forbidden speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some ancient cultures, the true name of the deity was considered <w>ineffable</w> and sacred.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних культурах истинное имя божества считалось <w>непроизносимым</w> и священным."
                            }
                        },
                        {
                            "text": "The high priest alone was permitted to contemplate the <w>ineffable</w> name of their god.",
                            "target_lang_translations": {
                                "ru": "Только верховному жрецу было позволено созерцать <w>неизреченное</w> имя их бога."
                            }
                        }
                    ],
                    "synonyms": [
                        "taboo",
                        "unnameable",
                        "unspeakable"
                    ],
                    "common_phrases": [
                        "ineffable name"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который нельзя произносить вслух, часто из-за религиозного или социального запрета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непроизносимый",
                                "target_lang_sense_clarification": "запрещенный к произношению"
                            },
                            {
                                "target_lang_word": "священный",
                                "target_lang_sense_clarification": "относящийся к божественному имени, которое нельзя называть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}