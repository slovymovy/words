                                    {
                                        "sense_id": "15898246-e286-31cf-8284-f81c3d26bcbd",
                                        "entry_id": "bc221099-370f-3a47-aaec-a427773ece7d",
                                        "glosses": [
                                            "sugar, especially sucrose"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b998b66a-fda2-491c-afca-3d9e94f6b5d2",
                        "source_entry_id": "edae40c4-5060-3940-81f3-97562588c64b",
                        "source_sense_id": "46b43a3f-4af0-33ac-b5b9-aad431705460",
                        "target_lang_word": "sucrose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sucrose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe336278-b48c-3772-9eb0-2a1181b93235",
                                        "entry_id": "0a644776-d465-306c-829f-5e60cb2d1089",
                                        "glosses": [
                                            "A disaccharide with formula C₁₂H₂₂O₁₁, consisting of two simple sugars, glucose and fructose; normal culinary sugar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b71cc4e-2725-4c33-92ac-2a1bf8a8b409",
                                                "sense_id": "fe336278-b48c-3772-9eb0-2a1181b93235",
                                                "text": "There were four forms of sugar interesting to the physiologist---cane sugar, grape sugar, milk sugar, and liver sugar. They might be called, for the sake of distinction, sucrose, glucose, lactose, and hepatose. The first two were vegetable, the last two, animal products."
                                            },
                                            {
                                                "example_id": "bc726b2c-1ddd-4e7a-849f-6b40b1fd9637",
                                                "sense_id": "fe336278-b48c-3772-9eb0-2a1181b93235",
                                                "text": "Dextran is an indicator of cane deterioration and sucrose loss after harvesting of the cane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ad4e62-b3a9-4a5e-aea8-8f8fdf405ab3",
                        "source_entry_id": "edae40c4-5060-3940-81f3-97562588c64b",
                        "source_sense_id": "46b43a3f-4af0-33ac-b5b9-aad431705460",
                        "target_lang_word": "saccharose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saccharose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                        "entry_id": "8661d7d8-702a-37e7-b446-f7a728584e0d",
                                        "glosses": [
                                            "Diholoside formé par la condensation d’une molécule de glucose et d’une molécule de fructose, extrait de la canne à sucre ou de la betterave sucrière et utilisé comme sucre de table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1daccddb-7e32-4939-8013-9133d37f1f54",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Si l’on porte la saccharose à une température élevée, il se forme des produits qui ont été désignés sous les noms d’acide caramélique, de caramélan, etc. Ces produits sont noirs, impossibles à purifier, et paraissent être le résultat d’une condensation moléculaire."
                                            },
                                            {
                                                "example_id": "8f677c5c-faa0-41e8-8e42-69a49ccf3f68",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Le sirop de sucre ou sirop simple est un liquide sirupeux constitué par une solution de sucre dans l'eau. Le sirop de sucre ou sirop simple contiendra au moins 60 p. c. de saccharose."
                                            },
                                            {
                                                "example_id": "a5500a21-331d-4de8-be9f-3e9719b192a9",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Deux plantes ont une richesse en saccharose beaucoup plus importante : la canne à sucre (qui contient 20 % de saccharose), connue depuis l’Antiquité, et la betterave sucrière (dont la racine en contient 18,7 %), qui sont aujourd’hui les deux sources principales de sucre."
                                            },
                                            {
                                                "example_id": "077ba571-e7f7-4dab-af41-85a0935f4b76",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Le saccharose, encore nommé commercialement « sucre », est le glucide de référence en matière de pouvoir sucrant."
                                            },
                                            {
                                                "example_id": "73861cc3-6070-4ca3-a03a-384e956409e5",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Afin d’entrer dans la glycolyse les carbones des glucides de réserve comme l’amidon, le saccharose ou les fructosanes, doit d'abord être hydrolysé sous forme de glucose ou de fructose puis converti en fructose-1,6-biphosphate."
                                            },
                                            {
                                                "example_id": "14bacd07-d999-4e1c-a7dd-d6fdd0e3da93",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Et le sucre emprunte parfois un pseudo : saccharose, sirop de glucose ou sirop de fructose."
                                            },
                                            {
                                                "example_id": "955c9ef9-cf1f-414a-ac45-ace45e492efb",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Pendant longtemps, ce sucre ajouté était exclusivement du saccharose extrait de la betterave ou de la canne, une molécule qui combine une molécule de glucose et une molécule de fructose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfdbe2df-e931-4ce2-ae8c-d76c6f1926fa",
                        "source_entry_id": "edae40c4-5060-3940-81f3-97562588c64b",
                        "source_sense_id": "46b43a3f-4af0-33ac-b5b9-aad431705460",
                        "target_lang_word": "sucrose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sucrose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "394c4d28-6f4d-378d-af65-5be6002c4038",
                                        "entry_id": "a9b8dfe1-ce56-3a59-91f4-96e21bdf8202",
                                        "glosses": [
                                            "Saccharose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "defff930-dd4b-4c4a-9bb4-2bc29f92354a",
                                                "sense_id": "394c4d28-6f4d-378d-af65-5be6002c4038",
                                                "text": "Les principaux sucres présents dans les aliments sont le sucrose (saccharose), le glucose, le fructose, le maltose et le lactose. Le sucrose est obtenu à partir de la canne à sucre et de la betterave à sucre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b523ad8-81e4-4033-a6fa-2fa9ebe0d60e",
                        "source_entry_id": "edae40c4-5060-3940-81f3-97562588c64b",
                        "source_sense_id": "46b43a3f-4af0-33ac-b5b9-aad431705460",
                        "target_lang_word": "Saccharose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saccharose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "348db08e-0e54-396d-b1ef-659023c9f699",
                                        "entry_id": "edc5dddc-0ef0-3e19-93d4-220962f86bcb",
                                        "glosses": [
                                            "eine glykosidische Verbindung aus einem Fructose- und einem Glucose-Baustein"
                                        ],
                                        "tags": [
                                            "Organik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e95047f-7786-4314-b322-901da99954d8",
                                                "sense_id": "348db08e-0e54-396d-b1ef-659023c9f699",
                                                "text": "Jeder hat reine Saccharose als normalen Haushaltszucker bei sich zu Hause."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5673edef-e427-4614-9539-c2b616887098",
                        "source_entry_id": "edae40c4-5060-3940-81f3-97562588c64b",
                        "source_sense_id": "46b43a3f-4af0-33ac-b5b9-aad431705460",
