                            {
                                "example_id": "78ae7543-51fe-4334-a9c0-ec555a6cd450",
                                "sense_id": "a0d6a5fd-2a73-3e36-b45c-e7ef17321560",
                                "text": "„Im August bekam der Secret Service zwei weitere Briefe, die mit ›C.A.T.‹ unterschrieben und an das ›Büro des Präsidenten, Washington, D.C.‹ adressiert waren, beide in Bakersfield, Kalifornien, abgestempelt.“"
                            },
                            {
                                "example_id": "1580e4c0-c475-4ce9-98af-e80ff93fc998",
                                "sense_id": "a0d6a5fd-2a73-3e36-b45c-e7ef17321560",
                                "text": "„Die arme Testperson in Bakersfield hatte die Leitung ihrer religiösen Grundschule über und über mit ihren Körperflüssigkeiten bespritzt.“"
                            },
                            {
                                "example_id": "2116c44b-123c-4093-8e57-663eb21611df",
                                "sense_id": "a0d6a5fd-2a73-3e36-b45c-e7ef17321560",
                                "text": "„Iverheart war in Bakersfield aufgewachsen, hatte staatliche Schulen besucht und danach an der University of Southern California studiert.“"
                            }
