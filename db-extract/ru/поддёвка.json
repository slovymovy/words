                "senses": [
                    {
                        "sense_id": "6809e8b9-da54-36c8-9611-4b0119ab8e57",
                        "entry_id": "aa9c561a-11bf-3930-8fc5-afd8d75089d9",
                        "glosses": [
                            "a kind of outerwear"
                        ],
                        "tags": [
                            "feminine",
                            "inanimate"
                        ],
                        "examples": [
                            {
                                "example_id": "06905da2-f7a4-4e35-a686-a244dd3282ca",
                                "sense_id": "6809e8b9-da54-36c8-9611-4b0119ab8e57",
                                "text": "Он пошёл к буфе́ту и там, как бы неча́янно, вдруг очути́лся вме́сте с тем па́рнем в поддёвке, кото́рого так бесцеремо́нно зва́ли Митро́шкой.",
                                "translation": "He went up to the buffet, and there, as though by chance, stood close by the young man in the tunic, who was so unceremoniously called Mitroshka.",
                                "english": "He went up to the buffet, and there, as though by chance, stood close by the young man in the tunic, who was so unceremoniously called Mitroshka."
                            },
                            {
                                "example_id": "9773158f-9fdb-4baf-ae23-3ea79c1eba54",
                                "sense_id": "6809e8b9-da54-36c8-9611-4b0119ab8e57",
                                "text": "Константи́н Лёвин загляну́л в дверь и уви́дел, что говори́т с огро́мной ша́пкой воло́с молодо́й челове́к в поддёвке, а молода́я рябова́тая же́нщина, в шерстяно́м пла́тье без рука́вчиков и воротничко́в, сиди́т на дива́не.",
                                "translation": "Konstantin Levin looked in at the door, and saw that the speaker was a young man with an immense shock of hair, wearing a Russian jerkin, and that a pockmarked woman in a woolen gown, without collar or cuffs, was sitting on the sofa.",
                                "english": "Konstantin Levin looked in at the door, and saw that the speaker was a young man with an immense shock of hair, wearing a Russian jerkin, and that a pockmarked woman in a woolen gown, without collar or cuffs, was sitting on the sofa."
                            }
                        ]
                    }
                ],
