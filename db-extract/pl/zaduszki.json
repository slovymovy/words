                "senses": [
                    {
                        "sense_id": "50929f9b-4f45-3513-815e-3fb87337b3e0",
                        "entry_id": "eab07e23-97f8-31b5-bcb5-872dc311837a",
                        "glosses": [
                            "w Kościele katolickim dzień poświęcony pamięci wszystkich zmarłych, przypadający na 2 listopada (po dniu Wszystkich Świętych)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee73bfb-d4c2-48e2-b66f-e32be10a0070",
                                "sense_id": "50929f9b-4f45-3513-815e-3fb87337b3e0",
                                "text": "W tym roku Zaduszki wypadły w poniedziałek."
                            },
                            {
                                "example_id": "748aafac-d840-438b-93e4-3f5f5dbab6ae",
                                "sense_id": "50929f9b-4f45-3513-815e-3fb87337b3e0",
                                "text": "Zaduszki to dzień modlitw za zmarłych, odwiedzania cmentarzy i zapalania na grobach świateł (świec, zniczy), które symbolizują nieśmiertelność duszy"
                            },
                            {
                                "example_id": "7fd1dbf4-93cd-433f-a5bd-48d10ab12a65",
                                "sense_id": "50929f9b-4f45-3513-815e-3fb87337b3e0",
                                "text": "Zaduszki następują po dniu Wszystkich Świętych"
                            },
                            {
                                "example_id": "709bffa1-cdda-48b5-a22b-3a45a303536c",
                                "sense_id": "50929f9b-4f45-3513-815e-3fb87337b3e0",
                                "text": "Najhojniej obdarowywano ich podczas odpustów, pogrzebów i Zaduszek, jako że modlili się za dusze zmarłych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
