                        "glosses": [
                            "female equivalent of покупа́тель (pokupátelʹ): female buyer, purchaser, customer, client"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5f709f57-6ac8-4ebd-9476-86a481fd59b9",
                                "sense_id": "24fa3050-9288-3151-a7cf-c6c5043ad914",
                                "text": "Прорабо́тав мно́го лет на ры́нке, Тама́ра всю жизнь име́ла де́ло с веща́ми. Она́ могла́ узна́ть пальто́, кото́рое продала́ покупа́тельнице мно́го лет наза́д."
                            }
                        ]
                    }
