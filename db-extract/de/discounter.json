                        ],
                        "form": "den Discounter"
                    },
                    {
                        "form_id": "0be81799-f5e1-4682-ac12-5aa425490858",
                        "entry_id": "bc9df641-a094-3b35-883c-c316456436fd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Discounter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1810129-f7f0-313b-af1f-cfbe9cfe7c9a",
                        "entry_id": "bc9df641-a094-3b35-883c-c316456436fd",
                        "glosses": [
                            "Handelskette (oder Filiale davon), die reduzierte Ware beziehungsweise Billigware anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12eda8f-e708-4c90-a527-a766819ee6c6",
                                "sense_id": "c1810129-f7f0-313b-af1f-cfbe9cfe7c9a",
                                "text": "Aldi und Kik sind Discounter."
                            },
                            {
                                "example_id": "bdb3d234-b26c-4b64-9f0d-3ebeca020ec4",
                                "sense_id": "c1810129-f7f0-313b-af1f-cfbe9cfe7c9a",
                                "text": "„Die Discounter, sagt Schneider, sind die Angstgegner der Bäcker.“"
                            },
                            {
                                "example_id": "c9c17912-0ad3-46e6-ae9b-0134dce12a6f",
                                "sense_id": "c1810129-f7f0-313b-af1f-cfbe9cfe7c9a",
                                "text": "„Beim Discounter fühle ich mich genauso unwohl wie auf dem Wochenmarkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                        "entry_id": "bc9df641-a094-3b35-883c-c316456436fd",
                        "glosses": [
                            "kurz für Discountzertifikat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fed9606-4897-42b6-b94d-18b87303161b",
                                "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                                "text": "„Angesichts weithin fallender Aktienkurse im ersten Halbjahr haben sich viele Discounter besser entwickelt als ihre Basiswerte. Steigen aber die Kurse stark, dann haben Anleger das Nachsehen.“"
                            },
                            {
                                "example_id": "6f5e5c50-d902-4306-8ff0-b5fb76788213",
                                "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                                "text": "„Überdies sollte man lernen, wie man mit sogenannten Bonus-Zertifikaten oder Discountern bei vergleichsweise geringem Risiko eine Jahresrendite von vier oder fünf Prozent erzielt.“"
                            },
                            {
                                "example_id": "63a2f420-83e6-4b04-925b-8d85d042af4e",
                                "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                                "text": "„Eine Alternative bieten dem Anleger so genannte Rolling-Discountzertifikate. Bei diesen endlos laufenden Zertifikaten wird aller vier Wochen das angelegte Geld in einen neuen Discounter mit einer verbleibenden Restlaufzeit von jeweils einem Monat investiert.“"
                            },
                            {
                                "example_id": "dbabc174-b26e-45fe-b8f0-1d28d4243984",
                                "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                                "text": "„Nicht ohne Grund werden Discount-Zertifikate als das Taschenmesser der Geldanlage bezeichnet. Die meisten Discounter, wie die Papiere auch genannt werden, haben Aktien und Indizes als Basiswerte, beziehen sich also auf diese Titel.“"
                            },
                            {
                                "example_id": "01614f30-c84a-433e-b223-fca7827d28bd",
                                "sense_id": "e9e3e36b-709e-37a8-85d6-ae434b27a034",
                                "text": "„Die Frankfurter haben […] die Wertentwicklung aller von ihnen im Zeitraum zwischen November 1999 und Dezember 2009 emittierten Discounter untersucht und mit der Performance der Basiswerte verglichen. Sage und schreibe 73% der über 24.500 untersuchten Discount-Zertifikate haben sich über ihre jeweilige Produktlaufzeit besser entwickelt als der ihnen zugrunde liegende Basiswert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
