        "fr-extract.jsonl": [
            {
                "entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
                "word": "organiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ab1f4763-ed17-4825-bc7a-2e70eafe1960",
                        "entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "organistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1e7a42e-ba47-3cde-91ff-d5c85f7333e3",
                        "entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
                        "glosses": [
                            "Personne qui joue de l’orgue."
                        ],
                        "tags": [
                            "Orgues"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b46eae-8249-46eb-be53-3dc40758f837",
                                "sense_id": "f1e7a42e-ba47-3cde-91ff-d5c85f7333e3",
                                "text": "Il n’y a donc pas moyen d’obtenir qu’on expulse l’organiste, qu’on balaie le maître de chapelle et les professeurs de chant de la maîtrise, qu’on refoule chez les liquoristes les voix de rogomme des gros chantres ?"
                            },
                            {
                                "example_id": "171711e5-3293-44dc-8673-0324f559e64e",
                                "sense_id": "f1e7a42e-ba47-3cde-91ff-d5c85f7333e3",
                                "text": "La très charmante fille de l’organiste de la cathédrale du Mans, Mˡˡᵉ Kahn, fut notre maîtresse de piano."
                            },
                            {
                                "example_id": "900c19cc-70a6-4800-bad4-c3a63001451d",
                                "sense_id": "f1e7a42e-ba47-3cde-91ff-d5c85f7333e3",
                                "text": "À l’affiche cette année, entre autres, le chanteur, guitariste et auteur-compositeur Gilberto Gil, le pétillant groupe de jazz-funk Earth Wind and Fire, la chanteuse Jane Birkin, l’organiste Rhoda Scott ou encore l’ensemble vocal de gospel Golden Gate Quartet."
                            }
                        ]
                    },
                    {
                        "sense_id": "c44919de-7948-3cc0-846c-dc0e553477ea",
                        "entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
                        "glosses": [
                            "Désigne des espèces d’oiseaux des genres Euphonia et Chlorophonia, de la famille des Fringillidae."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64877902-be81-42ad-a174-3e34ac4633a7",
                        "source_entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
                        "target_lang_word": "Organist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Organist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                        "entry_id": "af2198a0-d739-3ea9-90b8-2864f13801c5",
                                        "glosses": [
                                            "jemand, der eine Orgel spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49a741f-e05e-44c3-b2fb-37f8b3b3ee1e",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "Der Organist kam zu spät zur Chorprobe."
                                            },
                                            {
                                                "example_id": "442d44b2-ea42-4b6b-ad31-bed6d7707307",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Die unerwartete Kunde von dem neuen Organisten füllte Bodendorfs Kirche am Sonntag bis auf den letzten Platz.“"
                                            },
                                            {
                                                "example_id": "6b270895-eaf5-4546-a628-ff7922f053e0",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Zu dieser Zeit erschienen zehn Haftchen, die der Organist Jónas Helgason herausgab.“"
                                            },
                                            {
                                                "example_id": "0c901684-430c-4634-82e9-8877c81fa79a",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Ein Organist übt für seinen Auftritt am nächsten Sonntag, erfahren wir später.“"
                                            },
                                            {
                                                "example_id": "68ebf73f-7742-42c7-a01d-d79a7a15c00f",
                                                "sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
                                                "text": "„Wir sind dann weiter durch den großen Dom von Trier gegangen, und wir haben uns seinen Kreuzgang und die Krypta angeschaut, als ein Organist auf der Orgel etwas geübt und geprobt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5ccc143-f001-3833-ae3e-b50b4ebbd6b5",
                                        "entry_id": "af2198a0-d739-3ea9-90b8-2864f13801c5",
                                        "glosses": [
                                            "die Vogelgattung Euphonia aus der Familie der Finken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4522afd-d2e8-46d9-a556-ba1b992acddc",
                                                "sense_id": "f5ccc143-f001-3833-ae3e-b50b4ebbd6b5",
                                                "text": "Organisten leben in Mittel- und Südamerika."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2617945-7331-4b8c-bf31-2559d799c64e",
                        "source_entry_id": "7c473855-3a5e-3155-a59a-bd0ab17e0291",
