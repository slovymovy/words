                "senses": [
                    {
                        "sense_id": "577e8b76-7b76-3d13-b83a-15f2acbc6f18",
                        "entry_id": "ba21734c-0dcf-34c2-bb66-436e70779f3f",
                        "glosses": [
                            "Hamburger, der mindestens eine Scheibe Käse enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20f9c805-1421-43d2-99f6-b85ac3125a27",
                                "sense_id": "577e8b76-7b76-3d13-b83a-15f2acbc6f18",
                                "text": "Aufgrund seiner Diät durfte er keine Cheeseburger essen."
                            },
                            {
                                "example_id": "a815ec58-9958-48ff-be54-d7a2859911e0",
                                "sense_id": "577e8b76-7b76-3d13-b83a-15f2acbc6f18",
                                "text": "„Mit beiden Händen hob er den Cheeseburger, biss hinein und lehnte sich kauend zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba1bcd01-d074-4884-b112-2733ecf79072",
                        "source_entry_id": "ba21734c-0dcf-34c2-bb66-436e70779f3f",
                        "source_sense_id": "577e8b76-7b76-3d13-b83a-15f2acbc6f18",
                        "source_sense_description": "Hamburger mit mindestens einer Scheibe Käse",
                        "target_lang_word": "cheeseburger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheeseburger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4469f6-85bc-3b73-b72e-0b656d06665e",
                                        "entry_id": "98f81041-338b-30d5-856f-72924c53b601",
                                        "glosses": [
                                            "A hamburger containing cheese (usually one or more slices of processed cheese)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad874a0d-1f7e-45a4-a292-4c460940917c",
                                                "sense_id": "7b4469f6-85bc-3b73-b72e-0b656d06665e",
                                                "text": "Neon in daylight is a / great pleasure, as Edwin Denby would / write, as are light bulbs in daylight. / I stop for a cheeseburger at JULIET'S / CORNER."
                                            },
                                            {
                                                "example_id": "655b5686-cbce-4acd-90f5-de6b2f160971",
                                                "sense_id": "7b4469f6-85bc-3b73-b72e-0b656d06665e",
                                                "text": "Busy Americans (many women were working and not cooking as much) were dining on foods such as deep-fried chicken, thick slices of pizza, double cheeseburgers, and big slabs of steak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b63df03-5ae3-353a-aef6-387bf6e9089e",
                                        "entry_id": "98f81041-338b-30d5-856f-72924c53b601",
                                        "glosses": [
                                            "The BLU-82 bomb."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44799c5-dc89-41dd-964f-ee0905ddc2d8",
                        "source_entry_id": "ba21734c-0dcf-34c2-bb66-436e70779f3f",
                        "source_sense_id": "577e8b76-7b76-3d13-b83a-15f2acbc6f18",
                        "source_sense_description": "Hamburger mit mindestens einer Scheibe Käse",
                        "target_lang_word": "cheeseburger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheeseburger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c920e06-58f9-3de7-a42c-832ff520f077",
                                        "entry_id": "4293f62b-17e1-3daa-820d-d3a1dfe11690",
                                        "glosses": [
                                            "Bifteck haché grillé, recouvert d’une tranche de fromage, et assaisonné, servi dans un petit pain rond."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320a7749-4e05-4ce8-9bfa-522ce218ffe6",
                                                "sense_id": "8c920e06-58f9-3de7-a42c-832ff520f077",
                                                "text": "Lula prit un chickenburger, moi un cheeseburger, Cal et Junior, rien. Je suppose qu'ils ne mangent jamais pendant le service. Ils ne veulent pas avoir les mains prises par un hamburger au cas où ils devraient dégainer leur arme."
                                            },
                                            {
                                                "example_id": "a1077ade-f211-4d6b-9b04-c29569bfe618",
                                                "sense_id": "8c920e06-58f9-3de7-a42c-832ff520f077",
                                                "text": "Le Bourguignon Patrick Frei, qui s’est mis au diapason des saveurs de la Côte, joue, à point, salade César, pâtes, risotto, poisson (loup de ligne doré sur la peau) ou encore sushi, sashimi, club-sandwich, pizzas et cheeseburger qui font plaisir aux petits comme aux grands."
                                            },
                                            {
                                                "example_id": "a9fac851-81e9-4a5c-94be-f14b7e72f687",
                                                "sense_id": "8c920e06-58f9-3de7-a42c-832ff520f077",
                                                "text": "Les grands transformateurs, ceux qui fabriquent des frites congelées et des croustilles aux saveurs toujours très originales — «cheeseburger», «hot-dog» et «ailes de poulet» arrivent certainement au sommet de la liste —, ont préféré contourner le tubercule modifié pour ne pas effrayer et s’aliéner les consommateurs."
                                            },
                                            {
                                                "example_id": "1f00160a-2a76-4a25-bbe1-5f8303252cd9",
                                                "sense_id": "8c920e06-58f9-3de7-a42c-832ff520f077",
                                                "text": "Il s’enquit avec une sollicitude ironique de la qualité et de la cuisson du cheeseburger quand celui-ci arriva, et mit un point d’honneur à demander au serveur une longue liste de desserts américains – du cheesecake new-yorkais, un sundae, de la tarte aux myrtilles – pour le compte du malheureux acteur, alors même que monsieur Pacino insistait tout à fait catégoriquement sur son envie de goûter l’Apfelstrudel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
