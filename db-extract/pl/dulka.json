                                        "examples": [
                                            {
                                                "example_id": "5fccabf3-a07e-4467-b936-1af1aa9b3be0",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "Sie legten die Ruder in die Dollen."
                                            },
