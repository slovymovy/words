                        "glosses": [
                            "het aannemen van een houding waarbij geen aanspraak gemaakt wordt op macht of eer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2701d42f-6560-4712-97f5-420fe3ea3549",
                                "sense_id": "56c4ac35-5761-3c69-b07f-2a2674502e20",
                                "text": "Zijn nederigheid doet bijna vergeten wat een groot kustenaar hij in werkelijkheid is."
                            },
                            {
                                "example_id": "22f23e0c-b7d6-4873-a321-567bad578a1f",
                                "sense_id": "56c4ac35-5761-3c69-b07f-2a2674502e20",
                                "text": "Er viel hierboven niks te faken of te bluffen, de bergen dwongen me om hen met respect en nederigheid te bejegenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24657072-f1f0-4b08-8c3e-17d701c3ec2b",
