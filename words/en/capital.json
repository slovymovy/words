{
    "word_family": [
        "capitalism",
        "capitalist",
        "capitalize",
        "capitalization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6df6fce-81a0-320b-a85f-3e88f65e53a1",
                    "sense_definition": "A city designated as the official seat of government of a country or region, or the most important city for a specific activity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "city_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paris is the <w>capital</w> of France.",
                            "target_lang_translations": {
                                "ru": "Париж — <w>столица</w> Франции.",
                                "tr": "Paris, Fransa'nın <w>başkentidir</w>.",
                                "zh": "巴黎是法国的<w>首都</w>。"
                            }
                        },
                        {
                            "text": "They traveled to the <w>capital</w> to visit the national museum.",
                            "target_lang_translations": {
                                "ru": "Они отправились в <w>столицу</w>, чтобы посетить национальный музей.",
                                "tr": "Milli müzeyi ziyaret etmek için <w>başkente</w> seyahat ettiler.",
                                "zh": "他们前往<w>首都</w>参观国家博物馆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capital city",
                        "national capital",
                        "state capital"
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, являющийся официальным местом пребывания правительства страны или региона, или важнейший город для определенной деятельности.",
                        "tr": "Bir ülkenin veya bölgenin resmi hükümet merkezi olan şehir veya belirli bir faaliyet için en önemli kent.",
                        "zh": "一个国家或地区的官方政府所在地，或在特定活动中最重要的城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столи́ца",
                                "target_lang_sense_clarification": "главный город"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başkent",
                                "target_lang_sense_clarification": "yönetim merkezi olan şehir"
                            },
                            {
                                "target_lang_word": "başşehir",
                                "target_lang_sense_clarification": "başkent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首都",
                                "target_lang_sense_clarification": "国家的行政中心"
                            },
                            {
                                "target_lang_word": "省会",
                                "target_lang_sense_clarification": "省级的行政中心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa575ca5-d39e-30ad-9d51-355762de78d4",
                    "sense_definition": "Wealth in the form of money or other assets owned by a person or organization, used for starting a business or investing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "money_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needs to raise more <w>capital</w> to expand its operations.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо привлечь больше <w>капитала</w> для расширения своей деятельности.",
                                "tr": "Şirketin faaliyetlerini genişletmek için daha fazla <w>sermaye</w> bulması gerekiyor.",
                                "zh": "公司需要筹集更多<w>资本</w>以扩大业务。"
                            }
                        },
                        {
                            "text": "He does not have enough <w>capital</w> to start a business.",
                            "target_lang_translations": {
                                "ru": "У него недостаточно <w>капитала</w>, чтобы начать бизнес.",
                                "tr": "Bir iş kurmak için yeterli <w>sermayesi</w> yok.",
                                "zh": "他没有足够的<w>资金</w>来创业。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "raise capital",
                        "venture capital",
                        "working capital",
                        "investment capital"
                    ],
                    "target_lang_definitions": {
                        "ru": "Богатство в форме денег или других активов, принадлежащих лицу или организации, используемое для начала бизнеса или инвестирования.",
                        "tr": "Bir kişi veya kuruluşun bir iş kurmak veya yatırım yapmak için kullandığı para veya diğer varlıklar şeklindeki servet.",
                        "zh": "个人或组织拥有的金钱或其他资产形式的财富，用于创业或投资。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капита́л",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "состоя́ние",
                                "target_lang_sense_clarification": "богатство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sermaye",
                                "target_lang_sense_clarification": "finans, anapara"
                            },
                            {
                                "target_lang_word": "kapital",
                                "target_lang_sense_clarification": "ekonomik varlık"
                            },
                            {
                                "target_lang_word": "anapara",
                                "target_lang_sense_clarification": "yatırılan para"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资本",
                                "target_lang_sense_clarification": "经济学或商业中的资产"
                            },
                            {
                                "target_lang_word": "资金",
                                "target_lang_sense_clarification": "用于特定目的的钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3109b1c-6449-3ede-8a5e-62b08704655f",
                    "sense_definition": "An uppercase letter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "letter_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your name in <w>capitals</w> on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите ваше имя <w>заглавными буквами</w> в бланке.",
                                "tr": "Lütfen formdaki adınızı <w>büyük harflerle</w> yazın.",
                                "zh": "请在表格上用<w>大写字母</w>填写你的名字。"
                            }
                        },
                        {
                            "text": "The password must contain at least one <w>capital</w>.",
                            "target_lang_translations": {
                                "ru": "Пароль должен содержать хотя бы одну <w>заглавную букву</w>.",
                                "tr": "Parola en az bir <w>büyük harf</w> içermelidir.",
                                "zh": "密码必须包含至少一个<w>大写字母</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caps",
                        "majuscule",
                        "uppercase"
                    ],
                    "antonyms": [
                        "minuscule"
                    ],
                    "common_phrases": [
                        "in capitals",
                        "block capitals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заглавная (прописная) буква.",
                        "tr": "Büyük harf.",
                        "zh": "大写字母。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загла́вная бу́ква",
                                "target_lang_sense_clarification": "в письме"
                            },
                            {
                                "target_lang_word": "прописна́я бу́ква",
                                "target_lang_sense_clarification": "термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "büyük harf",
                                "target_lang_sense_clarification": "yazımda kullanılan büyük karakter"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大写字母",
                                "target_lang_sense_clarification": "书写形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9250992-3064-38ff-9425-8c45e58b7e65",
                    "sense_definition": "The uppermost part of a column or pillar in architecture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>capital</w> of the column was carved with intricate leaves.",
                            "target_lang_translations": {
                                "ru": "<w>Капитель</w> колонны была украшена резными листьями.",
                                "tr": "Sütunun <w>başlığı</w> karmaşık yaprak figürleriyle işlenmişti.",
                                "zh": "柱子的<w>柱头</w>上雕刻着复杂的叶子图案。"
                            }
                        },
                        {
                            "text": "Each stone <w>capital</w> supports the heavy roof of the temple.",
                            "target_lang_translations": {
                                "ru": "Каждая каменная <w>капитель</w> поддерживает тяжелую крышу храма.",
                                "tr": "Her bir taş <w>sütun başı</w>, tapınağın ağır çatısını taşır.",
                                "zh": "每一块石制<w>柱头</w>都支撑着寺庙沉重的屋顶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chapiter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть колонны или столба в архитектуре.",
                        "tr": "Mimaride bir sütunun veya dikmenin en üst kısmı.",
                        "zh": "建筑中柱子或立柱的最上部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капите́ль",
                                "target_lang_sense_clarification": "архитектура"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sütun başı",
                                "target_lang_sense_clarification": "mimaride sütun üst parçası"
                            },
                            {
                                "target_lang_word": "kapitel",
                                "target_lang_sense_clarification": "mimaride sütun başlığı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "柱头",
                                "target_lang_sense_clarification": "建筑构件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5c8dd98-152e-3086-aef0-f398a3efa21f",
                    "sense_definition": "Relating to uppercase letters (A, B, C) rather than lowercase ones (a, b, c).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "letter_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must begin every sentence with a <w>capital</w> letter.",
                            "target_lang_translations": {
                                "ru": "Вы должны начинать каждое предложение с <w>заглавной</w> буквы.",
                                "tr": "Her cümleye <w>büyük</w> bir harfle başlamalısınız.",
                                "zh": "你必须用<w>大写</w>字母开始每一个句子。"
                            }
                        },
                        {
                            "text": "Proper nouns like names and places require a <w>capital</w> first letter.",
                            "target_lang_translations": {
                                "ru": "Имена собственные, такие как имена и названия мест, требуют <w>заглавной</w> первой буквы.",
                                "tr": "İsimler ve yerler gibi özel isimlerin ilk harfinin <w>büyük</w> olması gerekir.",
                                "zh": "人名和地名等专有名词的首字母需要<w>大写</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uppercase",
                        "majuscular",
                        "big"
                    ],
                    "antonyms": [
                        "lower-case"
                    ],
                    "common_phrases": [
                        "capital letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к заглавным буквам (А, Б, В), в отличие от строчных (а, б, в).",
                        "tr": "Küçük harflerden (a, b, c) ziyade büyük harflerle (A, B, C) ilgili olan.",
                        "zh": "指大写字母（A, B, C）而非小写字母（a, b, c）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загла́вный",
                                "target_lang_sense_clarification": "о букве"
                            },
                            {
                                "target_lang_word": "прописно́й",
                                "target_lang_sense_clarification": "о букве"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "büyük",
                                "target_lang_sense_clarification": "harf hakkında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大写的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d3561b9-99d4-3846-a9fd-c018ebaa5f17",
                    "sense_definition": "Punishable by death; involving the death penalty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Murder is considered a <w>capital</w> offense in some legal systems.",
                            "target_lang_translations": {
                                "ru": "Убийство считается преступлением, караемым <w>смертной казнью</w>, в некоторых правовых системах.",
                                "tr": "Cinayet, bazı hukuk sistemlerinde <w>idamlık</w> bir suç olarak kabul edilir.",
                                "zh": "在某些法律体系中，谋杀被视为<w>死刑</w>罪。"
                            }
                        },
                        {
                            "text": "The jury debated the morality of <w>capital</w> punishment for hours.",
                            "target_lang_translations": {
                                "ru": "Присяжные часами обсуждали моральность <w>смертной</w> казни.",
                                "tr": "Jüri üyeleri saatlerce <w>ölüm</w> cezasının ahlaki boyutunu tartıştılar.",
                                "zh": "陪审团就<w>死刑</w>的道德问题辩论了几个小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capital punishment",
                        "capital offense",
                        "capital crime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Караемый смертью; связанный со смертной казнью.",
                        "tr": "Ölümle cezalandırılabilir; ölüm cezasını içeren.",
                        "zh": "可判处死刑的；涉及死刑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сме́ртный",
                                "target_lang_sense_clarification": "о казни"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "idamlık",
                                "target_lang_sense_clarification": "ölüm cezasını gerektiren"
                            },
                            {
                                "target_lang_word": "ölüm",
                                "target_lang_sense_clarification": "ceza veya suç bağlamında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死刑",
                                "target_lang_sense_clarification": "法律惩罚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80b5f219-3bc3-3e13-b7c9-49617df6f5df",
                    "sense_definition": "Excellent or first-rate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>capital</w> idea for our holiday plans!",
                            "target_lang_translations": {
                                "ru": "Это <w>превосходная</w> идея для наших планов на отпуск!",
                                "tr": "Bu tatil planlarımız için <w>harika</w> bir fikir!",
                                "zh": "这对我们的假期计划来说是个<w>绝佳的</w>主意！"
                            }
                        },
                        {
                            "text": "We had a <w>capital</w> time at the dinner party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>превосходно</w> провели время на званом ужине вчера вечером.",
                                "tr": "Dün geceki akşam yemeğinde <w>şahane</w> vakit geçirdik.",
                                "zh": "我们昨晚在晚宴上度过了<w>极好的</w>时光。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capital idea"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, превосходный или первоклассный.",
                        "tr": "Mükemmel veya birinci sınıf.",
                        "zh": "极好的或一流的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосхо́дный",
                                "target_lang_sense_clarification": "отличный"
                            },
                            {
                                "target_lang_word": "отли́чный",
                                "target_lang_sense_clarification": "высшего качества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harika",
                                "target_lang_sense_clarification": "mükemmel"
                            },
                            {
                                "target_lang_word": "şahane",
                                "target_lang_sense_clarification": "çok iyi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "形容质量"
                            },
                            {
                                "target_lang_word": "绝佳的",
                                "target_lang_sense_clarification": "形容主意或时间"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
