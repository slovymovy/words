                "senses": [
                    {
                        "sense_id": "4dc94578-217a-33cb-b2e2-ea996202357c",
                        "entry_id": "b9d921ec-8561-39f8-9e4b-8afaca4946a3",
                        "glosses": [
                            "A porridge made by boiling hulled wheat, typically with additional ingredients such as milk, egg yolks, and/or almond milk, traditionally served with venison or porpoise."
                        ],
                        "tags": [
                            "historical",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bc5f7488-f75d-4e83-8e5f-ccc2d3660191",
                                "sense_id": "4dc94578-217a-33cb-b2e2-ea996202357c",
                                "text": "Frumenty was often the first dish on the menu of a medieval English feast."
                            },
                            {
                                "example_id": "57246052-ca73-46cc-af90-68dff6c5fc12",
                                "sense_id": "4dc94578-217a-33cb-b2e2-ea996202357c",
                                "text": "Family MS. of the Cunliffes. Quoted by Letitia Elizabeth Landon in the note to her poem, Christmas in the Olden Time, 1650. (1835): 'Their entertainment was, a large hall of curious ashler work, a long table, plenty of furmenty like new milk, in a morning, made of husked wheat, boiled and roasted beef, with a fat goose, and a pudding, with plenty of good beer for dinner.'"
                            }
                        ]
                    }
                ],
