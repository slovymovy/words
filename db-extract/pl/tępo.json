        "pl-extract.jsonl": [
            {
                "entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                "word": "tępo",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b4c007a-de7e-309e-aa94-0dbea32ee477",
                        "entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "glosses": [
                            "tak, że coś nie ma ostrego końca lub krawędzi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d519a621-f5ee-47ce-a52e-bae8ec275125",
                                "sense_id": "8b4c007a-de7e-309e-aa94-0dbea32ee477",
                                "text": "Następnie w operowane miejsce przez kilkumilimetrowe nacięcia […] wprowadza się tępo zakończoną sondę z otworkami, za pomocą której usuwa się tłuszcz […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f56feaef-8db0-373f-8f2b-4f3fea000884",
                        "entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "glosses": [
                            "w sposób świadczący o niskiej zdolności umysłowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f86ebec-d50d-4668-ada6-03ed63b9dc45",
                                "sense_id": "f56feaef-8db0-373f-8f2b-4f3fea000884",
                                "text": "Pisarz prezentuje Polaków jako ludzi nie rozumiejących własnej historii, wyzbytych tożsamości, tępo broniących własnej tradycji, ze strachu wypychających obcych poza swoją wspólnotę […]"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "385a8701-3baa-3aae-a245-9cc814a6451c",
                        "entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "glosses": [
                            "w sposób bierny, świadczący o zamyśleniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed1eeef-354c-4080-a64d-5e013f4c82ea",
                                "sense_id": "385a8701-3baa-3aae-a245-9cc814a6451c",
                                "text": "W międzyczasie na podwórzu zbierał się już spory tłum gapiów, tępo wpatrzony w powiększającą się plamę krwi."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "10ade1de-61e6-3804-8315-b46320377bb1",
                        "entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "glosses": [
                            "będąc mało dźwięcznym i przytłumionym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d99863-0ee7-4f39-aaaf-8a6a69aafd47",
                                "sense_id": "10ade1de-61e6-3804-8315-b46320377bb1",
                                "text": "I dziewczyna stojąca w mroku zaciskała dłonie, bransolety podzwaniały tępo."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00a6e2ab-bf12-4bcf-b922-d07724c55030",
                        "source_entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "source_sense_id": "8b4c007a-de7e-309e-aa94-0dbea32ee477",
                        "target_lang_word": "bluntly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bluntly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                        "entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                                        "glosses": [
                                            "In a blunt manner; without delicacy, or the usual forms of civility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c948693-1f19-478c-84d3-c40f0ab41782",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                                            },
                                            {
                                                "example_id": "8e8f4e80-d6d8-4612-9df6-f4a278baded9",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "To put it bluntly, they are going to have to start defending a heck of a lot better than they have been, otherwise their season - and top-flight status - could well be over before they know it."
                                            },
                                            {
                                                "example_id": "26f6ec1f-eaee-4e3b-8752-d5a5eca50a61",
                                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                                "text": "Drivers' union ASLEF bluntly rebuffed the claim of unofficial action, calling it a lie. And Avanti West Coast was unable to provide any proof for its assertion, when questioned by RAIL."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1fd891e-a4d0-4041-8fc1-f1035ff0f16f",
                        "source_entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "source_sense_id": "f56feaef-8db0-373f-8f2b-4f3fea000884",
                        "target_lang_word": "dully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec9311f-4ab1-34d7-8a59-9e180e197f14",
                                        "entry_id": "0fa686b8-1ed0-3eb4-84f6-defe2337d9bd",
                                        "glosses": [
                                            "In a dull manner; without liveliness; without lustre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dcc75d8-59e9-492b-9be5-c1869f16787d",
                                                "sense_id": "dec9311f-4ab1-34d7-8a59-9e180e197f14",
                                                "text": "The parson, all unaware, dully pursued his calling, perched above the exquisite derision of their glances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8e8f462-8b76-4918-8138-4d30bb8c8a0f",
                        "source_entry_id": "7ee0bfda-e397-305d-bbba-c194827ad814",
                        "source_sense_id": "f56feaef-8db0-373f-8f2b-4f3fea000884",
                        "target_lang_word": "stupidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "In a stupid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd8f4e5-5e9f-4877-8a6c-f1f205cda69b",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "She was so modest, so expressive, she had looked so soft in her thin white gown that he felt he had acted stupidly."
                                            },
                                            {
                                                "example_id": "d05f7205-47ce-491a-b132-0e592d73b797",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "\"Don't we behave just as stupidly in our pursuit of happiness - don't we?\" Simpson nodded dejectedly."
                                            },
                                            {
                                                "example_id": "5d0e05f0-9b21-4a34-b7c6-6025be9b0dd3",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "As I write this, drivers' union ASLEF has announced yet another series of one-day strikes, because ministers are stupidly insisting that the modest below-inflation pay rise they have offered drivers still comes with strings attached over working conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "To an extreme or excessive degree; absurdly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6690e55-4632-4f57-960e-1a6c0826f602",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "He is so—so proud of his money, and thinks every one ought to be as stupidly rich as he is himself."
                                            },
                                            {
                                                "example_id": "5fdc3d65-7d18-4e8a-8b42-033c1b8a9787",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "As well as being stupidly hungry I had a raging thirst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
