                                "target_senses": [
                                    {
                                        "sense_id": "289e8d49-c8a0-3c45-ab12-89365fb7497b",
                                        "entry_id": "14eef6f7-614e-3f5f-a5eb-828427e91283",
                                        "glosses": [
                                            "The drug phenobarbitone when taken recreationally."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f8503ba-72c2-3d46-b9e9-1f48b7bb87db",
                                        "entry_id": "14eef6f7-614e-3f5f-a5eb-828427e91283",
                                        "glosses": [
                                            "A drinamyl tablet when taken recreationally, popular in the 1960s."
                                        ],
                                        "tags": [
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc1c5c8-b695-4ae3-b932-24aa5debab12",
                                                "sense_id": "1f8503ba-72c2-3d46-b9e9-1f48b7bb87db",
                                                "text": "Detective Peter Goodall said the source of the tablets had not been traced. \"Purple heart\" or drinamyl tablets, were a stimulant drug and habit-forming."
                                            },
                                            {
                                                "example_id": "03d7ea3f-9e68-43a2-86ef-b38080096737",
                                                "sense_id": "1f8503ba-72c2-3d46-b9e9-1f48b7bb87db",
                                                "text": "And every penny she had / Was spent on purple hearts and cigarettes"
                                            },
                                            {
                                                "example_id": "6c8c7b25-6f57-4223-a7a8-b9302a6da9e7",
                                                "sense_id": "1f8503ba-72c2-3d46-b9e9-1f48b7bb87db",
                                                "text": "We were all coming down from taking purple hearts, the fashionable uppers of the period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d2953de-1371-4678-9143-377a958ca8e9",
