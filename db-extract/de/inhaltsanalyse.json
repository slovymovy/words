                "senses": [
                    {
                        "sense_id": "4b6ea3c6-5090-39c1-9f32-0ef57c3c8004",
                        "entry_id": "11666105-688e-3dd4-9f67-06a2f5af2b36",
                        "glosses": [
                            "nur noch wenig verwendeter Ausdruck für die Analyse der Bedeutungen von Lexemen (Wörtern) in semantische Merkmale (Seme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9196833d-4583-4e4a-bfec-bf285e943f65",
                                "sense_id": "4b6ea3c6-5090-39c1-9f32-0ef57c3c8004",
                                "text": "Die Inhaltsanalyse zerlegt sie Bedeutung von Wörtern in semantische Merkmale."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37694679-7240-3e6e-8085-2d47f9e774c3",
                        "entry_id": "11666105-688e-3dd4-9f67-06a2f5af2b36",
                        "glosses": [
                            "empirisches Verfahren, das versucht, mit möglichst objektiven Methoden Inhalte beliebiger Kommunikationsformen zu erschließen; in vielen Fällen werden dabei statistische Methoden eingesetzt."
                        ],
                        "tags": [
                            "Publizistik",
                            "Sozialwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "1ed5e8b3-286f-486b-b66a-072ee7ab7316",
                                "sense_id": "37694679-7240-3e6e-8085-2d47f9e774c3",
                                "text": "Die Inhaltsanalyse erschließt das Gewicht, das bestimmte Inhalte in der Kommunikation aus der Sicht des \"Sprechers\" haben."
                            },
                            {
                                "example_id": "0ee91a3b-1d80-42d8-b387-461d6462eff2",
                                "sense_id": "37694679-7240-3e6e-8085-2d47f9e774c3",
                                "text": "„Eine 2012 durchgeführte Inhaltsanalyse von Lehrbüchern ergab, dass Minderheiten darin stets negativ und als minderwertig dargestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
