                        "glosses": [
                            "A row or disturbance."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "201faaf6-dac6-4e9f-8412-ddc546e6e430",
                                "sense_id": "67a65758-5f59-314a-b5a6-f2ac0ca02565",
                                "text": "They talk, they laugh, they dance, they make a row — / Kick up a philliloo."
                            },
                            {
                                "example_id": "1047df2c-d712-4ab2-9932-cfaed0ac13ad",
                                "sense_id": "67a65758-5f59-314a-b5a6-f2ac0ca02565",
                                "text": "And iver since thin, on that day, / They kill him agin that same way, / Wid shticks and wid shtones, / Philliloos and loud groans, / In short, there's the divil to pay."
                            },
                            {
                                "example_id": "4d923888-feda-49b3-9f0d-150b30dffb81",
                                "sense_id": "67a65758-5f59-314a-b5a6-f2ac0ca02565",
                                "text": "Dubious as this charge sounded, it added to the general philliloo."
                            }
                        ]
                    }
