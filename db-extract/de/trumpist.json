                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc8f040-31b6-3061-b104-fedfc144ffef",
                                        "entry_id": "062417bb-f328-36f2-ba51-5af43a109192",
                                        "glosses": [
                                            "A political supporter of Donald Trump or his MAGA movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e3ca0b-6096-40f6-b81f-aa830d80f981",
                                                "sense_id": "7dc8f040-31b6-3061-b104-fedfc144ffef",
                                                "text": "Political observers who say that Youngkin was a Never Trumper — proving the viability of that movement — are deluding themselves. He was a Stealth Trumper and Sorta Trumper who took pains not to offend or alienate Forever Trumpers."
                                            },
                                            {
                                                "example_id": "d46ebd37-2bd0-4905-9f1d-942ea9f2276c",
                                                "sense_id": "7dc8f040-31b6-3061-b104-fedfc144ffef",
                                                "text": "But it wasn’t just Mr. Thune’s victory but the poor showing by the MAGA favorite in the race that signaled most Senate Republicans are still a breed apart from hardcore Trumpers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3afff15-9762-4142-848f-ef3cc97011c0",
                        "source_entry_id": "0f8bdaae-32e5-3995-a34c-2f8b24450057",
