                ],
                "senses": [
                    {
                        "sense_id": "61b4f3d9-623c-30ca-9435-caf1b0ca8565",
                        "entry_id": "f8cd7961-ed1b-31b0-aeb0-a4a65de1f5ec",
                        "glosses": [
                            "Diffuser plus que la normale, ou excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e09c3730-f07e-48f5-8483-61ed8ca35f2e",
                                "sense_id": "61b4f3d9-623c-30ca-9435-caf1b0ca8565",
                                "text": "Cela signifie qu’ils vont automatiquement sur-diffuser celles qui obtiennent le meilleur taux de clic."
                            },
                            {
                                "example_id": "a4c149b0-8fb3-427a-8cdb-fb11b7b0e4c2",
                                "sense_id": "61b4f3d9-623c-30ca-9435-caf1b0ca8565",
                                "text": "En effet, nous sommes dans une société qui éduque, dans une société où l'information, la connaissance, les arts, la culture au sens large sont sur-diffusés."
                            },
                            {
                                "example_id": "86539b8c-2659-4201-a365-a967d9253785",
                                "sense_id": "61b4f3d9-623c-30ca-9435-caf1b0ca8565",
                                "text": "Contrairement aux demeurés d'IBM, il a bien vu ce qui allait se passer: le PC, boosté par son indigence totale en matière de brevets, est copié, concurrentialisé, guerredesprisé, sur-diffusé, et enfin conquiert le marché."
                            }
                        ]
                    }
