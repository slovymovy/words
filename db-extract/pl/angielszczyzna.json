                    },
                    {
                        "translation_id": "a01d8da8-e460-47af-8a47-08a4569dff75",
                        "source_entry_id": "2cbb6ad1-0a20-3d4b-afcf-51cfbfe94a4f",
                        "source_sense_id": "4463bad5-5474-3938-95c4-5d107ab59142",
                        "source_sense_description": "Linguistik: englische Sprache, Englisch",
                        "target_lang_word": "Sprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b190cfa-41ec-3e03-b8c9-3793c31fb141",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "das Vermögen, die allgemeine Fähigkeit zu sprechen, sich zu verständigen; der Informationsträger mündlicher oder schriftlicher Kommunikation (= langage, Sprachvermögen/Sprachfähigkeit)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc97580-b210-4220-8fad-ce6a507fee73",
                                                "sense_id": "0b190cfa-41ec-3e03-b8c9-3793c31fb141",
                                                "text": "Ihm ist die Sprache durch den Schlaganfall abhandengekommen."
                                            },
                                            {
                                                "example_id": "a907af71-5bd7-4530-a6de-6cb9644ca6cb",
                                                "sense_id": "0b190cfa-41ec-3e03-b8c9-3793c31fb141",
                                                "text": "„Die Grenzen meiner Sprache bedeuten die Grenzen meiner Welt.“"
                                            },
                                            {
                                                "example_id": "4aea8b80-0ebc-44b3-a767-4769dde6f6d5",
                                                "sense_id": "0b190cfa-41ec-3e03-b8c9-3793c31fb141",
                                                "text": "„Daran sehen wir, dass die Sprache als Fundament der Herrschaft begriffen wird.“"
                                            },
                                            {
                                                "example_id": "9e75c674-690c-435c-bf94-7b17d40a1584",
                                                "sense_id": "0b190cfa-41ec-3e03-b8c9-3793c31fb141",
                                                "text": "„In der schwärmerischen Sprache der Zeit wird zum Ausdruck gebracht, was die Bergwanderer und Kletterer bewegt: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "ein System von Einheiten und Regeln, das den Mitgliedern einer Sprachgemeinschaft als Mittel der Verständigung dient (= Langue, Einzelsprache)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e6389d-360e-4483-96d2-2e5fe2db704b",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "„In der schwärmerischen Sprache der Zeit wird zum Ausdruck gebracht, was die Bergwanderer und Kletterer bewegt: […].“"
                                            },
                                            {
                                                "example_id": "9509b705-0ab2-441e-af4d-22c1eb9234b3",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "Ich spreche mehrere Sprachen."
                                            },
                                            {
                                                "example_id": "7a997f66-a45f-4390-bc4c-272b61201bcb",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "„Sprache vermittelt Identität und Kultur oder zumindest die Wahrnehmung davon.“"
                                            },
                                            {
                                                "example_id": "6c53a6f5-3f09-4a17-87d1-5e9adb3de3a9",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "„Ich begann nun ein wenig Bengali aufzuschnappen und konnte, bevor ich den Handel verließ, ein Schiff sehr gut auch in dieser Sprache segeln.“"
                                            },
                                            {
                                                "example_id": "c51ecf2b-ebb9-4d6f-babc-98a8f37ffcdf",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "„Historisch ist der Kapitalismus gewachsen, so wie Sprachen gewachsen sind. Sprachen wurden nicht erfunden, konstruiert und erdacht, sondern sind das Ergebnis von ungesteuerten spontanen Prozessen.“"
                                            },
                                            {
                                                "example_id": "f5f214c7-c0d0-4e2c-bb1f-89c0f0ede61c",
                                                "sense_id": "1e15ab26-145b-332c-88cd-ec232831b157",
                                                "text": "„Heute beherrschen zwar 80 Prozent aller Amerikaner mindestens ein wenig Englisch, aber darüber hinaus werden weitere 160 Sprachen gesprochen, zusätzlich dazu kommen noch die 176 Sprachen der Ureinwohner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2bd68f09-842d-37aa-9be2-3b4e529c0f2c",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "eine Varietät von [2], fachlich, regional, sozial, … bedingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b82dcf9-ecfa-420f-9219-2a60fb75360e",
                                                "sense_id": "2bd68f09-842d-37aa-9be2-3b4e529c0f2c",
                                                "text": "Die verschiedenen sozialen Gruppen oder Schichten haben ihre jeweils eigene Sprache."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3c69c26b-ad19-335d-a833-a8346e2529b7",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "Art der Sprachverwendung: Rede (= parole), Sprechweise, Schreibweise, Stil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704ac5b0-41e2-42f9-93c6-e33e76576487",
                                                "sense_id": "3c69c26b-ad19-335d-a833-a8346e2529b7",
                                                "text": "Die Sprache in diesem Buch ist mir zu deftig."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "950df143-3efc-3729-bb42-ef43e9cf40d3",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "Zeichen und Regeln, um Software zu schreiben"
                                        ],
                                        "tags": [
                                            "kurz für Programmiersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c121ab-af99-45c6-9bf6-8820e4efee58",
                                                "sense_id": "950df143-3efc-3729-bb42-ef43e9cf40d3",
                                                "text": "Pascal ist eine von N. Wirth entwickelte Sprache."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7d465433-5dc6-30a7-b17a-39a1d7cfda17",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "Sprache definiert als (un)endliche Möglichkeiten der Verknüpfung einer endlichen Anzahl Zeichen (im Alphabet)"
                                        ],
                                        "tags": [
                                            "kurz für formale Sprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "362a222b-a1c8-480d-bfdc-3a7663d17f03",
                                                "sense_id": "7d465433-5dc6-30a7-b17a-39a1d7cfda17",
                                                "text": "Die Sprache der korrekt geschachtelten Klammergebirge wird von keiner Typ-3-Grammatik erzeugt; sie ist kontextfrei und nicht regulär."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
