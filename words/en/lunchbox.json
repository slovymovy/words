                },
                {
                    "sense_id": "cc18c23e-fd25-378b-ba09-596821bdc129",
                    "sense_definition": "A meal packed in a disposable box to be eaten away from home.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tour guide handed everyone a <w>lunchbox</w> for the long bus trip.",
