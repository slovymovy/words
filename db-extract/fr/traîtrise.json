                    {
                        "sense_id": "af8d6a5b-7467-39e2-982d-a542cf7cf3c6",
                        "entry_id": "f525b162-2efa-361c-b402-146ea658f387",
                        "glosses": [
                            "Acte de trahison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbb099b-9d20-4842-a381-36ff930293d6",
                                "sense_id": "af8d6a5b-7467-39e2-982d-a542cf7cf3c6",
                                "text": "Il l’a pris par traîtrise, en traîtrise."
                            },
                            {
                                "example_id": "3546f09c-ea3a-4f15-aaf0-a91387709dd0",
                                "sense_id": "af8d6a5b-7467-39e2-982d-a542cf7cf3c6",
                                "text": "Charest joue avec l'immigration en intégrant tout nouvel immigrant à la communauté anglophone, une traitrise sans nom, une parodie, un génocide culturel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bee277ec-8d0e-43c0-996f-521d3bff7368",
                        "source_entry_id": "f525b162-2efa-361c-b402-146ea658f387",
