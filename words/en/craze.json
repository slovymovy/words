                {
                    "sense_id": "48ff426a-6195-3d00-8157-19ec6d5ac0c5",
                    "sense_definition": "To act or appear as if one is insane; to rave",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "act_insane",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If he were to lose his home, he would surely weep and <w>craze</w> with despair.",
                            "target_lang_translations": {
                                "ru": "Если бы он потерял свой дом, он наверняка рыдал бы и <w>безумствовал</w> от отчаяния."
                            }
                        },
                        {
                            "text": "The character began to <w>craze</w> on stage, shouting at shadows that weren't there.",
                            "target_lang_translations": {
                                "ru": "Персонаж начал <w>бредить</w> на сцене, выкрикивая проклятия теням, которых там не было."
                            }
                        }
                    ],
                    "synonyms": [
                        "rave",
                        "delirate"
