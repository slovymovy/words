{
    "word_family": [
        "tune",
        "tunable",
        "tuning",
        "untuned",
        "attune"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63d67778-5297-3f70-9495-c662aee3d9f2",
                    "sense_definition": "A device, electronic or mechanical, that helps a person tune a musical instrument by showing the deviation of the played pitch from the desired pitch.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist used a digital <w>tuner</w> to make sure every string was perfectly in pitch.",
                            "target_lang_translations": {
                                "ru": "Гитарист использовал цифровой <w>тюнер</w>, чтобы убедиться, что каждая струна настроена идеально."
                            }
                        },
                        {
                            "text": "I need to buy a new guitar <w>tuner</w> because my old one stopped working.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новый гитарный <w>тюнер</w>, потому что мой старый перестал работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitch pipe"
                    ],
                    "common_phrases": [
                        "guitar tuner",
                        "digital tuner",
                        "chromatic tuner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное или механическое устройство, помогающее настроить музыкальный инструмент, показывая отклонение высоты звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюнер",
                                "target_lang_sense_clarification": "устройство для настройки инструментов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a6840d-49b1-331e-9461-959db00f8384",
                    "sense_definition": "The component of an audio system that receives radio broadcasts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He connected the <w>tuner</w> to the amplifier to listen to his favorite FM station.",
                            "target_lang_translations": {
                                "ru": "Он подключил <w>тюнер</w> к усилителю, чтобы послушать свою любимую FM-станцию."
                            }
                        },
                        {
                            "text": "Modern home cinema systems often include a built-in radio <w>tuner</w>.",
                            "target_lang_translations": {
                                "ru": "Современные системы домашнего кинотеатра часто включают встроенный радио<w>тюнер</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "receiver"
                    ],
                    "common_phrases": [
                        "radio tuner",
                        "stereo tuner",
                        "FM tuner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент аудиосистемы, принимающий радиовещательные сигналы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюнер",
                                "target_lang_sense_clarification": "радиоприемное устройство"
                            },
                            {
                                "target_lang_word": "радиоприемник",
                                "target_lang_sense_clarification": "устройство для приема радиоволн"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1534ba02-93e0-377b-a7b7-6721c6fcbbbd",
                    "sense_definition": "A person who tunes a piano or organ.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "professions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional <w>tuner</w> spent three hours adjusting the grand piano in the concert hall.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>настройщик</w> провел три часа, настраивая рояль в концертном зале."
                            }
                        },
                        {
                            "text": "We should call a piano <w>tuner</w> before the recital starts next week.",
                            "target_lang_translations": {
                                "ru": "Нам стоит вызвать <w>настройщика</w> пианино до начала концерта на следующей неделе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piano tuner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, профессионально занимающийся настройкой пианино или органов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настройщик",
                                "target_lang_sense_clarification": "специалист по настройке инструментов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ed72037-f64b-390c-aae6-73dc2682d108",
                    "sense_definition": "On a musical instrument, a peg or mechanical device that changes the tension, and hence pitch, of a string.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "instrument_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One of the <w>tuners</w> on my violin is stuck and won't turn.",
                            "target_lang_translations": {
                                "ru": "Один из <w>колков</w> на моей скрипке застрял и не поворачивается."
                            }
                        },
                        {
                            "text": "The guitar features high-quality locking <w>tuners</w> to keep the strings from slipping.",
                            "target_lang_translations": {
                                "ru": "Гитара оснащена высококачественными запирающимися <w>колками</w>, предотвращающими проскальзывание струн."
                            }
                        }
                    ],
                    "synonyms": [
                        "tuning peg",
                        "machine head"
                    ],
                    "common_phrases": [
                        "locking tuners"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колок или механическое устройство на музыкальном инструменте, изменяющее натяжение струны и высоту звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колок",
                                "target_lang_sense_clarification": "деталь для натяжения струн"
                            },
                            {
                                "target_lang_word": "колковый механизм",
                                "target_lang_sense_clarification": "система для настройки струн"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420a9ef5-4b75-3360-8952-0af9fb13cb96",
                    "sense_definition": "One who sings or makes music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musician",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old poet was known as a sweet <w>tuner</w> of melodies in his youth.",
                            "target_lang_translations": {
                                "ru": "Старый поэт в юности был известен как нежный <w>создатель</w> мелодий."
                            }
                        },
                        {
                            "text": "Every <w>tuner</w> in the choir practiced their parts diligently for the upcoming performance.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>певец</w> в хоре усердно репетировал свои партии перед предстоящим выступлением."
                            }
                        }
                    ],
                    "synonyms": [
                        "singer",
                        "musician"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to describe a singer"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто поет или создает музыку (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "певец",
                                "target_lang_sense_clarification": "исполнитель песен"
                            },
                            {
                                "target_lang_word": "музыкант",
                                "target_lang_sense_clarification": "человек, занимающийся музыкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}