                "senses": [
                    {
                        "sense_id": "4f1986b5-4dd1-381b-913b-47ce3ce187c7",
                        "entry_id": "13c1e101-ed61-3760-a266-6685047ea979",
                        "glosses": [
                            "in den USA entwickelte Variante des Kartenspiels Siebzehn und Vier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76dc0056-9a6e-4ed9-b88a-5f039fab602d",
                                "sense_id": "4f1986b5-4dd1-381b-913b-47ce3ce187c7",
                                "text": "„Beim Blackjack geht es darum, mehr Punkte als die Bank zu erreichen, maximal 21, in Deutschland kennt man das Spiel unter dem Namen 17 und 4. Hat man mehr als 21 Punkte, hat man sich überkauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "064dde8e-7cf3-4404-8074-14d50580ca54",
                        "source_entry_id": "13c1e101-ed61-3760-a266-6685047ea979",
                        "source_sense_id": "4f1986b5-4dd1-381b-913b-47ce3ce187c7",
                        "source_sense_description": "in den USA entwickelte Variante des Kartenspiels Siebzehn und Vier",
                        "target_lang_word": "blackjack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79d2e962-e676-3e18-b600-42cf04ac3381",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A common gambling card game in casinos, where the object is to get as close to 21 without going over."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6ebd420-71e6-33e2-99f7-b1353d4bf1f9",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A hand in the game of blackjack consisting of a face card and an ace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "813fef27-50c0-387a-9dac-60c087b5cbdd",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A variant of switch where each player is initially dealt the same number of cards, usually seven, and when one player plays a black jack the player whose turn comes next has to pick up that many cards, unless they play a red jack (as this normally cancels a black jack)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3825f36b-4c26-3cb4-8969-b7e57824c25a",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A variant of hearts where the Jack of Spades is the penalty card."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10350ff6-3b96-31eb-9819-e2b87ad62806",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "The flag (i.e., a jack) traditionally flown by pirate ships; popularly thought to be a white skull and crossed bones on a black field (the Jolly Roger)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d028e0c9-44c6-3d02-ace1-092a34b2481a",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A small, flat, blunt, usually leather-covered weapon loaded with heavy material such as lead or ball bearings, intended to inflict a blow to the head that renders the victim unconscious with diminished risk of lasting cranial trauma."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a59aea2-f63a-4c11-884f-8dced24e66b6",
                                                "sense_id": "d028e0c9-44c6-3d02-ace1-092a34b2481a",
                                                "text": "The pain is sometimes like the dull, heavy thud of being hit with a lead-filled blackjack; other times like a wizard is reaching deep below the skin and ripping muscles, tendons, and nerves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d24a122-487f-39f0-b3c0-38abc321b216",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "A tool of leather filled with shot (or similar), resembling the weapon, used for shaping sheet metal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef1dfcf8-fe23-3e35-be25-329a10119551",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "Any of several species of weed of genus Bidens, such as Bidens pilosa, in the family Compositae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21baa1bc-22e7-3c12-a8dc-7cef246f753b",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "Ellipsis of blackjack oak."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e41db6-1c84-46b1-aafd-94574ee1ef21",
                                                "sense_id": "21baa1bc-22e7-3c12-a8dc-7cef246f753b",
                                                "text": "A little creek ran through the land, and the prairie rolled a little there, too. Nothing but blackjacks for miles around it, but on that section, because of the water, I suppose, there were elms and persimmons and cottonwoods and even a grove of pecans."
                                            },
                                            {
                                                "example_id": "a8b51163-9885-419c-8f75-1df26d4de6cd",
                                                "sense_id": "21baa1bc-22e7-3c12-a8dc-7cef246f753b",
                                                "text": "A steep slope rose, crested by stunted blackjacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "Any of a series of hard, dark soils, often considered low quality, but suitable for growing certain crops such as cotton."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e91f02d-371c-4893-972c-80650356004e",
                                                "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                                "text": "This man had a brother about six miles off, settled on a rich White River bottom-land farm -- and while a blackjack clay soil yielded seventy bushels to the acre, this fine bottom-land would not average fifty."
                                            },
                                            {
                                                "example_id": "299920d1-d197-40cf-b048-7f93cd184964",
                                                "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                                "text": "Blackjack soil is generally the poorest of all; it covers the narrow and rocky ridges, and has a stunted growth of blackjack and post oaks. The soil is dark in color, thin and cold, and is underlaid with pale yellow or slate-colored clay."
                                            },
                                            {
                                                "example_id": "4f53137d-0d78-4448-ae67-9d70921ca4c8",
                                                "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                                "text": "The predominant soil is the blackjack soil like that of the lower plateaus, seemingly, however, in most cases a little more sandy and a little coarser in grain."
                                            },
                                            {
                                                "example_id": "cf30cb97-c8d2-4786-9a23-4afa5a2c63ba",
                                                "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                                "text": "Today, most types of land development in areas underlain by Iredell and related “blackjack” soil series—a catch-all term for Jackland, Whitestore, Orange, Zion, and other high shrink-swell clayey soils—is generally discouraged."
                                            },
                                            {
                                                "example_id": "25b3fdd7-afb9-4c25-ab28-9dbb84aceddc",
                                                "sense_id": "fbb66ed4-c77d-364b-8409-2b8c451897b2",
                                                "text": "Cotton grew robustly in western Cabarrus County's blackjack soil, pointing Concord beyond its agricultural base toward its first industry: textiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd876d8c-4493-3f59-90b5-e46d081565a4",
                                        "entry_id": "3d186d82-8cd8-32c5-b1af-48100f909b38",
                                        "glosses": [
                                            "Ammonium bituminosulfonate."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4424b1d9-3131-4a35-9393-98ab772eda20",
                                                "sense_id": "dd876d8c-4493-3f59-90b5-e46d081565a4",
                                                "text": "\"Next!\" steps gingerly in to confront the medical eye fastened questioningly upon him. \"Crook in the guts,\" he says tersely. The picturesque reports of previously treated and disgusted patients - have left him doubtful, and he casts, an anathematising eye upon the \"Black Jack\" bottle. \"Tabloids and duty!\" says the doctor, and the sufferer sighs with relief."
                                            },
                                            {
                                                "example_id": "549b221e-d5ff-4a7d-9fc0-aeb9713e3008",
                                                "sense_id": "dd876d8c-4493-3f59-90b5-e46d081565a4",
                                                "text": "I remember Black Jack very well and actually like the smell. It is no longer available with that trade name but glycerine of ichthammol can still be bought in chemists."
                                            },
                                            {
                                                "example_id": "2575ae15-6d65-48fa-ad8c-bed9b9e4678e",
                                                "sense_id": "dd876d8c-4493-3f59-90b5-e46d081565a4",
                                                "text": "Used to be called Black Jack think my mom had an ancient jar in her medicine cupboard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blackjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ca43e9-892d-38cf-9d15-29d26957df4e",
                                        "entry_id": "8793c353-6c45-3b57-9104-aaa6edfd40e0",
                                        "glosses": [
                                            "To strike with a blackjack or similar weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60640e2-8480-40e8-97c2-a5ffb858f728",
                                                "sense_id": "f9ca43e9-892d-38cf-9d15-29d26957df4e",
                                                "text": "“We cannot have you getting blackjacked and bound yet again.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
