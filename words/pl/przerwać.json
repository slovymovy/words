                {
                    "sense_id": "3292f4b2-af4a-34ff-8181-a05051df5389",
                    "sense_definition": "Sprawić, że coś przestaje być fizyczną całością lub naruszyć ciągłość struktury",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "break_continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielka fala powodziowa może <przerwać> wały ochronne.",
                            "target_lang_translations": {
                                "ru": "Большая паводковая волна может <прорвать> защитные дамбы.",
                                "en": "A huge flood wave could <breach> the flood barriers.",
                                "zh": "巨大的洪峰可能会<冲垮>防护堤。"
