                        "glosses": [
                            "een auto die niet in eigendom is maar voor een korte periode en tegen betaling wordt gehuurd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f52adc-3f9c-4bd9-b7e0-820b8c5ab4ba",
                                "sense_id": "3575411f-ff16-3a84-bdf7-e95330c422be",
                                "text": "Voor de verhuizing gebruikten we een huurauto."
