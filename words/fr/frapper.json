{
    "word_family": [
        "frappe",
        "frappeur",
        "frappement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                    "sense_definition": "Donner un ou plusieurs coups physiques à quelqu'un ou à quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coup",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur court vers le ballon pour le <w>frapper</w> avec force."
                        },
                        {
                            "text": "L'enfant a failli <w>frapper</w> la vitre avec son jouet en bois."
                        }
                    ],
                    "synonyms": [
                        "cogner",
                        "taper"
                    ],
                    "common_phrases": [
                        "frapper fort",
                        "frapper dans un ballon"
                    ]
                },
                {
                    "sense_id": "d233312e-bc00-30e3-8638-b55c43880dd8",
                    "sense_definition": "Donner des coups répétés contre une porte ou une ouverture afin de signaler sa présence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "porte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelqu'un vient de <w>frapper</w> à la porte de la cuisine."
                        },
                        {
                            "text": "Pensez toujours à <w>frapper</w> avant d'entrer dans son bureau."
                        }
                    ],
                    "synonyms": [
                        "toquer"
                    ],
                    "common_phrases": [
                        "frapper à la porte"
                    ]
                },
                {
                    "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                    "sense_definition": "Faire une impression vive ou soudaine sur l'esprit, la vue ou les sentiments.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La ressemblance entre ces deux frères m'a tout de suite <w>frappé</w>."
                        },
                        {
                            "text": "Ce tableau remarquable a su <w>frapper</w> l'imagination de tous les visiteurs."
                        }
                    ],
                    "common_phrases": [
                        "frapper les esprits",
                        "frapper l'imagination"
                    ]
                },
                {
                    "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                    "sense_definition": "Affecter durement ou anéantir par une catastrophe, une épidémie ou un grand malheur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calamite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une violente tempête risque de <w>frapper</w> la région côtière cette nuit."
                        },
                        {
                            "text": "Cette crise économique a <w>frappé</w> de plein fouet les petits commerces locaux."
                        }
                    ],
                    "common_phrases": [
                        "frapper de plein fouet"
                    ]
                },
                {
                    "sense_id": "9176982f-8de3-3b6d-be2c-3778360e0634",
                    "sense_definition": "Fabriquer des pièces de monnaie ou des médailles en leur imprimant une empreinte avec un coin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "monnaie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet atelier royal possédait le droit exclusif de <w>frapper</w> la monnaie en argent."
                        },
                        {
                            "text": "L'État a décidé de <w>frapper</w> une nouvelle médaille pour célébrer cet anniversaire historique."
                        }
                    ],
                    "common_phrases": [
                        "frapper la monnaie",
                        "frapper une médaille"
                    ]
                },
                {
                    "sense_id": "7adee8ea-7dd5-39d0-b340-88f68535bde2",
                    "sense_definition": "Avoir des pensées négatives ou s'inquiéter excessivement pour quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inquietude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne te <w>frappe</w> pas pour cette remarque maladroite, ce n'était rien."
                        },
                        {
                            "text": "Il a toujours tendance à se <w>frapper</w> dès qu'un problème survient."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "s'emploie principalement à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "eb88cc22-cd9a-3e4f-8274-2df170c55a1b",
                    "sense_definition": "Refroidir très fortement une boisson en la plaçant dans la glace pilée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "froid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sommelier conseille de bien <w>frapper</w> le vin blanc avant la dégustation."
                        },
                        {
                            "text": "Il a pris soin de <w>frapper</w> le champagne quelques heures avant l'arrivée des convives."
                        }
                    ],
                    "common_phrases": [
                        "frapper le champagne"
                    ]
                }
            ]
        }
    ]
}