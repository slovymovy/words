                    },
                    {
                        "translation_id": "2f327ae1-6cc6-4b88-97b2-98473ac0f80f",
                        "source_entry_id": "7ab0dd29-58ff-3995-bd8e-a67edbee1d21",
                        "source_sense_id": "34a1e46f-b258-3175-b10d-4a9c0f9e94af",
                        "target_lang_word": "adolescence",
                        "target_lang_code": "fr",
