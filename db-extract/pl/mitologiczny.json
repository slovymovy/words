                        "examples": [
                            {
                                "example_id": "7efb8615-b70b-4e3a-abd4-331f19a8df1f",
                                "sense_id": "08c5c069-e275-309e-bf2f-962d2a7f9006",
                                "text": ", 2003."
                            },
                            {
                                "example_id": "41836703-1856-4166-9721-d927f8824889",
                                "sense_id": "08c5c069-e275-309e-bf2f-962d2a7f9006",
                                "text": "Ogrom elfów bytuje w mitologicznym tolkienowskim świecie."
                            }
