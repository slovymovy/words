                            }
                        },
                        {
                            "text": "Pacjent zaczął <w>odczuwać</w> silny ból w nodze.",
                            "target_lang_translations": {
                                "en": "The patient began <w>to feel</w> severe pain in his leg.",
                                "ru": "Пациент начал <w>ощущать</w> сильную боль в ноге.",
                                "nl": "De patiënt begon een hevige pijn in zijn been te <w>voelen</w>.",
                                "de": "Der Patient begann, starke Schmerzen im Bein zu <w>fühlen</w>.",
                                "fr": "Le patient a commencé à <w>ressentir</w> une forte douleur dans la jambe.",
                                "it": "Il paziente ha iniziato ad <w>avvertire</w> un forte dolore alla gamba.",
                                "cs": "Pacient začal <w>cítit</w> silnou bolest v noze.",
                                "tr": "Hasta bacağında şiddetli bir ağrı <w>hissetmeye</w> başladı.",
                                "es": "El paciente empezó a <w>sentir</w> un dolor fuerte en la pierna.",
                                "zh": "病人腿部开始<w>感到</w>剧痛。"
                            }
                        }
