                            {
                                "example_id": "36919f9a-6769-4c28-ae10-a559537d4132",
                                "sense_id": "c6fc116c-ae6e-3731-b59c-af5b90067e0c",
                                "text": "Philibert ne bégayait plus [depuis son récent mariage] mais cessait de respirer dès qu’elle [sa récente épouse] sortait de son punctum."
                            },
                            {
                                "example_id": "72c3ada8-24b4-47f0-82e2-58f3b3d834c6",
                                "sense_id": "c6fc116c-ae6e-3731-b59c-af5b90067e0c",
                                "text": "Comme, à âge égal, l'amplitude d'accommodation est à peu près la même pour les différents sujets les punctums du myope sont plus rapprochés de l'œil que ceux d'un emmétrope."
                            },
                            {
                                "example_id": "ef184b38-3126-4046-bf27-c4ed983ba4df",
                                "sense_id": "c6fc116c-ae6e-3731-b59c-af5b90067e0c",
                                "text": "Cette taxation pouvait varier dans chaque Université; elle était faite par les docteurs, et le recteur devait contrôler si les régents observaient les puncta."
                            }
                        ]
