        "fr-extract.jsonl": [
            {
                "entry_id": "6ec641dd-2cba-3b6b-a056-bffde86d8478",
                "word": "acmé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b0000fb-5805-4ee1-9031-8699e33c0158",
                        "entry_id": "6ec641dd-2cba-3b6b-a056-bffde86d8478",
                        "tags": [
                            "plural"
                        ],
                        "form": "acmés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                        "entry_id": "6ec641dd-2cba-3b6b-a056-bffde86d8478",
                        "glosses": [
                            "Phase d’intensité maximale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386c895c-7906-4065-8856-11f40e70f4fe",
                                "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                                "text": "Dans le domaine positif, médical, sont attestés des cas de femmes qui, dans l’acmé de l’orgasme, s’évanouissent ou tombent dans des états semi-cataleptiques susceptibles de durer plusieurs heures."
                            },
                            {
                                "example_id": "d741da1d-131d-4db3-93e3-25212b5f3f0c",
                                "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                                "text": "Hicks identifie deux catégories d’acmés (« climax ») : d'une part, celui correspondant au développement d'une action arrivée à son moment paroxystique, par exemple le saut d'une ballerine ou le coup droit d'un boxeur ; d'autre part, celui susceptible de produire les effets psychologiques les plus intenses, […]."
                            },
                            {
                                "example_id": "9e8249ec-8c63-46fc-98d2-edbe5a35cfda",
                                "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                                "text": "Je crois qu'elle assistait, désemparée, à la transformation de son mari, subjugué par celle qu'on prenait a priori pour une charmante vieille dame mais qui, à bien y regarder, dissimulait une femme avertie, experte dans l’art de porter l’ego masculin à son acmé."
                            },
                            {
                                "example_id": "9b68fc4e-ca3d-4e4d-bdcd-fca2004dd750",
                                "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                                "text": "Comme dans l’espace où Achille ne rattrapera jamais la tortue, minutes et secondes se divisaient à l’infini, portant à son acmé la torture de l’imminence."
                            },
                            {
                                "example_id": "37853749-4a3e-4a24-859c-b5f1090eaaea",
                                "sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                                "text": "Elle était à l’acmé de sa beauté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fca0264-e109-4a6e-addd-c7b652ef8d99",
                        "source_entry_id": "6ec641dd-2cba-3b6b-a056-bffde86d8478",
                        "source_sense_id": "c390f768-7363-317b-bfb6-eca818bf6fbd",
                        "target_lang_word": "acme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97f66066-ea48-3c80-96ed-50d898ad6d3c",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "A high point: the highest point of any range, the most developed stage of any process, or the culmination of any field or historical period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcdaf76-62f7-4ebc-84d1-8f0c3d9dec9a",
                                                "sense_id": "97f66066-ea48-3c80-96ed-50d898ad6d3c",
                                                "text": "The Latin tong, euen whan it was, as the Grecians say, in ακμη, that is, at the hiest pitch of all perfitenesse."
                                            },
                                            {
                                                "example_id": "8d908939-e558-43c3-9428-47ce9606cd72",
                                                "sense_id": "97f66066-ea48-3c80-96ed-50d898ad6d3c",
                                                "text": "Eum.: Our Loves what are they\nBut howerly Sacrifices, only wanting\nThe prease and tumult of Solemnity?\nIf then i'th' heat and Achme of Devotion\nWe drink a new fiame in, can it be ought\nBut to increase the Worship?"
                                            },
                                            {
                                                "example_id": "084ae84e-2ac4-4072-aea4-384678827ae3",
                                                "sense_id": "97f66066-ea48-3c80-96ed-50d898ad6d3c",
                                                "text": "Ah, what a sight burst upon our astonished eyes as we gained its summit!\nIt seemed the very acme of mountain glory in all the glories around us."
                                            },
                                            {
                                                "example_id": "dfbf2ded-9e93-493c-8788-57c51507f25a",
                                                "sense_id": "97f66066-ea48-3c80-96ed-50d898ad6d3c",
                                                "text": "The moment when a certain power reaches the acme of its supremacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd8fca12-36d6-3e47-890c-73e6408cee3b",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "A paragon: a person or thing representing such a high point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1a452f-abf4-45ec-a905-67ee1d57c553",
                                                "sense_id": "bd8fca12-36d6-3e47-890c-73e6408cee3b",
                                                "text": "The few words of advice she gave him as to escaping political embarrassments, struck him as the acme of wisdom, and as indicating an interest in his well-being of the kindest description;..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d9b2ce-8f07-3843-9ff6-46091689c694",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "Full bloom or reproductive maturity."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c5ea3e3-8bf2-48dc-9d0d-199d4f332b1d",
                                                "sense_id": "c2d9b2ce-8f07-3843-9ff6-46091689c694",
                                                "text": "He must be one that can instruct your youth,\nAnd keep your acme in the state of truth"
                                            },
                                            {
                                                "example_id": "464a2da7-66d9-4cf1-a5dc-40b9520ed2a0",
                                                "sense_id": "c2d9b2ce-8f07-3843-9ff6-46091689c694",
                                                "text": "The very acme and pitch of life for epic poesy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ec1605-e89e-3b33-b960-e539145b6fbb",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "Sexual orgasm."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de82e88-cdf9-43bf-bd7f-da34c7e7e5e7",
                                                "sense_id": "59ec1605-e89e-3b33-b960-e539145b6fbb",
                                                "text": "[He] then holds back his own climax for another ten or fifteen minutes of active copulation until his mate signals him that she is about to reach her acme; then they both ecstatically erupt together."
                                            },
                                            {
                                                "example_id": "77268f31-91ff-4fc4-995a-2fa0311fdd4d",
                                                "sense_id": "59ec1605-e89e-3b33-b960-e539145b6fbb",
                                                "text": "She has enough of the narcissist in her to love exhibiting herself and to have the exhibition itself arouse her and bring her to her acme (that's very literary, even a little affected, but it's a word that pleases me)."
                                            },
                                            {
                                                "example_id": "4ec67b50-1986-4794-a7fa-a34e50f90525",
                                                "sense_id": "59ec1605-e89e-3b33-b960-e539145b6fbb",
                                                "text": "He reached a climax about one minute after penetration and as this was always much sooner than his partner reached her acme this disturbed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0aec0d2-f70e-319f-b5e2-fc0654dbe27f",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "Synonym of crisis, the decisive moment in the course of an illness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "114acbea-edd3-36bc-9af2-e144d17c00e5",
                                        "entry_id": "f129d58c-c065-31d2-bb2b-328c85aceeb3",
                                        "glosses": [
                                            "Alternative letter-case form of Acme, particularly as a threading format."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
