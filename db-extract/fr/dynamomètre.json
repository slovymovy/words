        "fr-extract.jsonl": [
            {
                "entry_id": "15de43bd-9450-3b2b-b8c4-6f905aa90cad",
                "word": "dynamomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54869891-1a80-40eb-a39c-336718e4fc48",
                        "entry_id": "15de43bd-9450-3b2b-b8c4-6f905aa90cad",
                        "tags": [
                            "plural"
                        ],
                        "form": "dynamomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc36ce19-5234-3252-9ab2-ff78c3304212",
                        "entry_id": "15de43bd-9450-3b2b-b8c4-6f905aa90cad",
                        "glosses": [
                            "Instrument qui sert à mesurer les forces d’un homme, d’un animal, d’un moteur, etc., ou la résistance mécanique d’un matériau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64a4560-0681-4559-bb06-1212bfeedfd2",
                                "sense_id": "bc36ce19-5234-3252-9ab2-ff78c3304212",
                                "text": "On conditionne enfin l’élasticité et la ténacité mesurées au dynamomètre et la torsion mesurée au torsiomètre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a29c2eeb-a2ac-408b-a95f-ace4fc78767d",
                        "source_entry_id": "15de43bd-9450-3b2b-b8c4-6f905aa90cad",
                        "source_sense_id": "bc36ce19-5234-3252-9ab2-ff78c3304212",
                        "target_lang_word": "Dynamometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dynamometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1eb6bbf-5d36-3d0c-92ce-d836839eba83",
                                        "entry_id": "9be96aef-fa4b-319f-bc6b-872545f86344",
                                        "glosses": [
                                            "Gerät zum Messen von mechanischen Kräften"
                                        ],
                                        "tags": [
                                            "Mechanik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff791b73-02a8-4325-b210-14c27883417a",
                                                "sense_id": "f1eb6bbf-5d36-3d0c-92ce-d836839eba83",
                                                "text": "„Das Dynamometer besteht im Wesentlichen aus einer festen Rolle mit vertikaler Axe und einer innerhalb derselben drehbaren beweglichen Rolle mit gleicher Aue.“"
                                            },
                                            {
                                                "example_id": "f86aaf0d-08a7-4bed-ac18-4e443ae2aede",
                                                "sense_id": "f1eb6bbf-5d36-3d0c-92ce-d836839eba83",
                                                "text": "„Apparate zur direkten Messung von Kräften oder Drehmomenten heißen Dynamometer. Jede Wage ist ein Dynamometer, sie mißt die Schwerkraft von Körpern.“"
                                            },
                                            {
                                                "example_id": "8b5bca48-a88a-46e4-b363-c81ba008be0a",
                                                "sense_id": "f1eb6bbf-5d36-3d0c-92ce-d836839eba83",
                                                "text": "„Auf die Riemenscheibe wird deshalb ein Bremszaum aufgesetzt und festgezogen, dessen Hebel über ein Dynamometer verankert ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
