                                    {
                                        "sense_id": "655bd5bf-fb01-3eac-8031-e75544136806",
                                        "entry_id": "cc5f5fc6-7b3e-3a67-a3af-5674fd50ba68",
                                        "glosses": [
                                            "Relatif à la délinquance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea877c0-c051-4589-acfd-7f52434e527b",
                                                "sense_id": "655bd5bf-fb01-3eac-8031-e75544136806",
                                                "text": "Réécouter les enregistrements, consigner tous les résultats dans des tableaux de suivi, donner la parole aux commerces délinquants dans un souci de démarche équitable..."
                                            },
                                            {
                                                "example_id": "cefa5095-ec2f-40e4-9387-d9145d6ac6ed",
                                                "sense_id": "655bd5bf-fb01-3eac-8031-e75544136806",
                                                "text": "Pas besoin de se garder une petite gêne ou de faire preuve d’un MINIMUM de jugement en sachant qu’on exhibe des comportements délinquants alors que des milliers de personnes sont abonnées à nos plateformes et, dans certains cas, nous admirent – on est en vacances, on fait ce qu’on veut et on publie le tout sur les réseaux sociaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "délinquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39d874ea-c104-3c85-afaa-6cc64cad76ce",
                                        "entry_id": "eb8356fc-a11d-3d4e-9c4b-796e7c6d1589",
                                        "glosses": [
                                            "Celui qui a commis un délit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd704cc-d40a-4ef1-8e8b-25cebf5d3f6a",
                                                "sense_id": "39d874ea-c104-3c85-afaa-6cc64cad76ce",
                                                "text": "Une insulte faite au baylon (syndic) est punie d’une amende de dix écus, et même de la prison, à la diligence du viguier ; le délinquant ne sortait de prison que sur l’intervention du syndic."
                                            },
                                            {
                                                "example_id": "dab0e5c1-f03a-48fd-bc21-e94074bd0142",
                                                "sense_id": "39d874ea-c104-3c85-afaa-6cc64cad76ce",
                                                "text": "Elle appelle le délinquant à son tribunal ; elle commence par lui administrer la bâtonnade pour lui rafraîchir la mémoire, et ensuite elle lui dit : Prouve ton innocence."
                                            },
                                            {
                                                "example_id": "327b3fd3-221b-4f78-bd23-6107581effbe",
                                                "sense_id": "39d874ea-c104-3c85-afaa-6cc64cad76ce",
                                                "text": "Les délinquants s’amusèrent à comploter des délits inconstatables, et la vieille moustache enragea de son impuissance."
                                            },
                                            {
                                                "example_id": "04771284-2831-4f48-8b9b-e2b59d7f5eab",
                                                "sense_id": "39d874ea-c104-3c85-afaa-6cc64cad76ce",
                                                "text": "À la différence peut-être de l’avocat civiliste ou commercialiste, qui fait essentiellement du droit et de la procédure, l’avocat pénaliste, défenseur de délinquants usagers de drogues, se doit d’être en quelque sorte pluridisciplinaire."
                                            }
                                        ]
                                    }
                                ]
                            },
