            "pos": "verb",
            "senses": [
                {
                    "sense_id": "270e20dd-0d7b-3b81-bd33-40a6fab42a5e",
                    "sense_definition": "To make something wider or more extensive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase_width",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city plans to <w>broaden</w> the main road to reduce traffic congestion.",
                            "target_lang_translations": {
                                "nl": "De stad is van plan de hoofdweg te <w>verbreden</w> om de verkeersdrukte te verminderen."
                            }
                        },
                        {
                            "text": "Reading different types of books will <w>broaden</w> your perspective on the world.",
                            "target_lang_translations": {
                                "nl": "Het lezen van verschillende soorten boeken zal je blik op de wereld <w>verruimen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "widen",
                        "extend"
                    ],
                    "common_phrases": [
                        "broaden horizons",
                        "broaden knowledge"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets breder of uitgebreider maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verbreden",
                                "target_lang_sense_clarification": "Iets fysiek of abstract breder maken."
                            },
                            {
                                "target_lang_word": "verruimen",
                                "target_lang_sense_clarification": "Iets ruimer maken, vaak gebruikt voor abstracte zaken zoals perspectieven of regelingen."
                            }
                        ]
                    }
                },
