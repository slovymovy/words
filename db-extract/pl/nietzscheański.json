                                        "glosses": [
                                            "Misspelling of Nietzschean."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f015efa5-ff18-4991-ae41-93cb9a81a727",
                                                "sense_id": "e67a83b6-c5f0-31ff-81c1-d875d4aca847",
                                                "text": "Their plan, the writer claimed, was to transform humanity into the Nietzschen Übermensch."
                                            }
                                        ]
                                    }
                                ]
