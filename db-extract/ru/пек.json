                            {
                                "target_word": "peck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7f6cb12-02e6-3942-a53a-4c3ac2651f32",
                                        "entry_id": "e7b672b7-94bf-35dc-aba6-4ce8626bb310",
                                        "glosses": [
                                            "One quarter of a bushel; a dry measure of eight quarts; equal to approximately 9092 cubic centimeters in the imperial system or 8810 cubic centimeters in the U.S. system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1cf8099-d29c-490f-9726-0056a49ea1aa",
                                                "sense_id": "e7f6cb12-02e6-3942-a53a-4c3ac2651f32",
                                                "text": "Peter Piper picked a peck of pickled peppers."
                                            },
                                            {
                                                "example_id": "ea4b8ea6-ea38-4a93-8341-ffc9985575b5",
                                                "sense_id": "e7f6cb12-02e6-3942-a53a-4c3ac2651f32",
                                                "text": "22,110 bushels of French beans, at 6d. per peck, or 2s. per bushel"
                                            },
                                            {
                                                "example_id": "b00cc11b-c461-49ce-b6c7-5bf4d0c39089",
                                                "sense_id": "e7f6cb12-02e6-3942-a53a-4c3ac2651f32",
                                                "text": "I took his advice, and went to Billingsgate for the first time in my life, and bought a peck of oysters for 2s. 6d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdab5ba5-4b6d-3127-b412-fa84f44dabec",
                                        "entry_id": "e7b672b7-94bf-35dc-aba6-4ce8626bb310",
                                        "glosses": [
                                            "Similar units in other systems of measure, such as the Roman modius or Chinese dou."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cac6e0ca-caa1-35b2-a8ad-6ded7c23b400",
                                        "entry_id": "e7b672b7-94bf-35dc-aba6-4ce8626bb310",
                                        "glosses": [
                                            "A great deal; a large or excessive quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e63f42-80bd-4f5b-adde-09333b1453f8",
                                                "sense_id": "cac6e0ca-caa1-35b2-a8ad-6ded7c23b400",
                                                "text": "She figured most children probably ate a peck of dirt before they turned ten."
                                            },
                                            {
                                                "example_id": "b4b7ef87-8cc9-48d4-84f7-1b15aad70e7a",
                                                "sense_id": "cac6e0ca-caa1-35b2-a8ad-6ded7c23b400",
                                                "text": "a peck of uncertainties and doubts"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
