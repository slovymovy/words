                    {
                        "translation_id": "3509bb92-d748-4317-a368-3444a8088083",
                        "source_entry_id": "566187cc-c088-3fd7-a8cb-ef6a6d50a2e9",
                        "source_sense_id": "056e191a-8d76-302c-b2fc-810882479698",
                        "target_lang_word": "hernie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hernie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a60c3812-41a0-3948-8e10-86764e9d2162",
                                        "entry_id": "a64299e3-5057-3bc7-beb5-2cad995e3bb0",
                                        "glosses": [
                                            "Tumeur molle formée par un organe ou une partie d’organe sorti de la cavité qui le contient normalement par un orifice naturel ou accidentel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887285e0-dad4-4d40-b187-9d724608f0a4",
                                                "sense_id": "a60c3812-41a0-3948-8e10-86764e9d2162",
                                                "text": "Hernie du cerveau, du poumon."
                                            },
                                            {
                                                "example_id": "aa2f4a79-8e24-4f92-a372-d0a21b9b1acd",
                                                "sense_id": "a60c3812-41a0-3948-8e10-86764e9d2162",
                                                "text": "Hernies abdominales."
                                            },
                                            {
                                                "example_id": "0d542ca0-e2cd-4e46-bfe4-7c3d9cd364e3",
                                                "sense_id": "a60c3812-41a0-3948-8e10-86764e9d2162",
                                                "text": "Hernies inguinales, crurales, etc."
                                            },
                                            {
                                                "example_id": "d1ab68f4-7450-4a66-8a5d-dacfc75207a6",
                                                "sense_id": "a60c3812-41a0-3948-8e10-86764e9d2162",
                                                "text": "Une hernie survient lorsqu’une couche de muscles se déchire et laisse sortir des parties d’organes, d’intestins par exemple. Elle peut former une grosseur sous la peau ou affecter le scrotum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd00066-e19c-356a-9b41-a49d5120dcc9",
                                        "entry_id": "a64299e3-5057-3bc7-beb5-2cad995e3bb0",
                                        "glosses": [
                                            "Hernie abdominale ou descente."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "069c3f88-b2b2-44b8-964c-55c08ee64d2c",
                                                "sense_id": "5fd00066-e19c-356a-9b41-a49d5120dcc9",
                                                "text": "Pendant la dissection du sac, la hernie se désétrangle spontanément : on entend un gargouillement et le sac s’affaisse."
                                            },
                                            {
                                                "example_id": "32710c37-81d2-4c6b-ab32-09368742c723",
                                                "sense_id": "5fd00066-e19c-356a-9b41-a49d5120dcc9",
                                                "text": "Elle était plus jeune que lui, bien sûr, elle ne souffrait pas de ce mal de poitrine qui le serrait pour l’empêcher de respirer librement, mais elle avait ses hernies qui devaient lui tirer le ventre vers le bas à chaque pas."
                                            },
                                            {
                                                "example_id": "32b8dbf0-c724-4305-821e-4f2df6469105",
                                                "sense_id": "5fd00066-e19c-356a-9b41-a49d5120dcc9",
                                                "text": "Elle n’avait jamais voulu se soigner. Elle ne voulait pas donner ses sous aux médecins. Elle s’était même fabriqué elle-même, avec un vieux corset, un bandage pour ses hernies qui la faisaient tant souffrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf3c1540-816d-34a1-a1e9-9decd3b2b480",
                                        "entry_id": "a64299e3-5057-3bc7-beb5-2cad995e3bb0",
                                        "glosses": [
                                            "Maladie des choux, des navets, et des Brassicacées (ou Crucifères) plus généralement."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1228dc22-00b2-40ea-8150-0294152896fc",
                                                "sense_id": "cf3c1540-816d-34a1-a1e9-9decd3b2b480",
                                                "text": "Dans le sol des cultures de choux, le fongicide chlorothalonil utilisé pour la protection contre l’hernie, est biodégradé en trois métabolites, dont seulement un (métabolite 1) est fongicide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "030fbd27-1a53-45c5-9a3e-926199c3bad5",
                        "source_entry_id": "566187cc-c088-3fd7-a8cb-ef6a6d50a2e9",
