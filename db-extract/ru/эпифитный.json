                                "target_senses": [
                                    {
                                        "sense_id": "feb186cf-989f-3872-84c6-dab1f3c151fc",
                                        "entry_id": "9f385ffb-0ca7-3d6c-b1cb-73f974b9b1b0",
                                        "glosses": [
                                            "Relatif aux épiphytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a497a55-ab8e-48e7-8503-b0fca740b7a8",
                                                "sense_id": "feb186cf-989f-3872-84c6-dab1f3c151fc",
                                                "text": "Suivant une première opinion, la pellagre est une maladie spécifique produite par un agent toxique, à savoir le verdet ou verderame, parasite épiphytique qui se développe sur le maïs altéré ; empoisonnement lent qui […] finit par causer la mort des malades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd96bacb-2fda-340f-aa5b-9d5726b3fb2c",
                                        "entry_id": "9f385ffb-0ca7-3d6c-b1cb-73f974b9b1b0",
                                        "glosses": [
                                            "Qualifie les maladies produites sur les plantes, soit par des épiphytes, soit par des parasites végétaux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
