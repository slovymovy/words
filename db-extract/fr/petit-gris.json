                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d59e1bc-6de2-31d9-9726-b97d6b5c55f6",
                                        "entry_id": "ecb107f5-43b0-327e-b335-97b081732166",
                                        "glosses": [
                                            "Something that grows very quickly or seems to appear suddenly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb2b2ff8-d503-4ca3-bcce-8e91e070da44",
                                                "sense_id": "8d59e1bc-6de2-31d9-9726-b97d6b5c55f6",
                                                "text": "The craze [hula hoops] began in the U.S.A., and in October the boom crossed the Atlantic and 40 firms sprang into being, some being overnight mushrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43d14131-f42c-37be-b7a9-62e7506f8c4f",
