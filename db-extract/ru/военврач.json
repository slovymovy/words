                    }
                ],
                "senses": [
                    {
                        "sense_id": "c316cc25-6eef-313b-9f33-b71423b585fb",
                        "entry_id": "ef4bc21f-b3a5-38f9-b651-97b327b242c6",
                        "glosses": [
                            "воен. то же, что военный врач"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92d96d2-156a-49bb-9b2d-4281670120cf",
                                "sense_id": "c316cc25-6eef-313b-9f33-b71423b585fb",
                                "text": "А когда война началась, пылкий Гольдберг, окончивший медицинский факультет в начале двадцатых годов вместе с Павлом Алексеевичем, но, в отличие от друга, никогда практической медициной не занимавшийся, записался на скорые курсы переквалификации и оказался в госпитале, в должности заведующего клинической лабораторией. Так, военврачом, он и прошёл всю войну от звонка до звонка, без ранений и даже с наградой не пустяковой ― с Красной Звездой, полученной за эвакуацию транспорта с ранеными из захваченного немецкими войсками городка."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ca10cc3-8488-3989-b30c-029375fa6148",
                        "entry_id": "ef4bc21f-b3a5-38f9-b651-97b327b242c6",
                        "glosses": [
                            "воен. истор. : группа воинских званий для военнослужащих медицинской службы"
                        ],
                        "tags": [
                            "в Красной армии в 1936—1943 годах"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae6cbf0-4dd4-4b57-9af8-b3bb7aa5019b",
                                "sense_id": "4ca10cc3-8488-3989-b30c-029375fa6148",
                                "text": "Людмила Николаевна приехала в Саратов через неделю после того, когда Толе сделали ещё одну, третью, операцию. Операцию производил военврач второго ранга Майзель."
                            },
                            {
                                "example_id": "a551e1ff-bc8d-4424-b118-f01e877809d5",
                                "sense_id": "4ca10cc3-8488-3989-b30c-029375fa6148",
                                "text": "А тут приезжают Люба с Володей. Люба уже врач, и Володя три года как окончил Военно-медицинскую академию, тоже в военной форме, и не с кубарями, а со шпалой, военврач 3-го ранга."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f6f7fbd-56c1-4e91-b6cc-e4cbb27c61f6",
                        "source_entry_id": "ef4bc21f-b3a5-38f9-b651-97b327b242c6",
                        "target_lang_word": "Militärarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Militärarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                        "entry_id": "8bf0ebc4-d346-36bf-9c00-f0bcab99591a",
                                        "glosses": [
                                            "Arzt, zur medizinischen Versorgung von militärischem Personal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4eedf6-b66d-445d-bda6-5c64549dab59",
                                                "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                                "text": "„Erfunden worden ist die typische Luftpolster-Sohle um 1945 am Starnberger See von Militärarzt Dr. Klaus Maertens.“"
                                            },
                                            {
                                                "example_id": "35fc26a3-8471-4073-83cb-29be3168aaac",
                                                "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                                "text": "„Dr. Theodor Aschenbrandt, ein deutscher Militärarzt, verabreicht 1883 bayerischen Soldaten das inzwischen vom Pharmaunternehmen Merck hergestelltes [sic!] reines Kokain und berichtet, dass die Jungs jetzt nicht mehr müde würden.“"
                                            },
                                            {
                                                "example_id": "e2fe3665-6489-44ae-b9d0-4cfdd373c900",
                                                "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                                "text": "„Die Militärärzte rieten ihm, zu seiner Familie zurückzukehren.“"
                                            },
                                            {
                                                "example_id": "e2c33af5-93d2-448d-9f76-0af6fd196379",
                                                "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                                "text": "„Bernhard Schmitt, ein Elsässer, war französischer Militärarzt.“"
                                            },
                                            {
                                                "example_id": "d1ab64bc-fc66-471a-850c-768ce9a1f631",
                                                "sense_id": "d6c87b6e-6d1b-3b43-b92e-2d0683709f38",
                                                "text": "„Es war keine Kleinigkeit für die Militärärzte gewesen, alle die verwundeten Fremdenlegionäre zu verbinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
