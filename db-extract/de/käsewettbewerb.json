                "senses": [
                    {
                        "sense_id": "4e10c5d6-4793-36be-8f7a-7d5421870f48",
                        "entry_id": "e8be05ba-a562-3f41-961c-8cbee88a7645",
                        "glosses": [
                            "Veranstaltung, bei welcher der beste Käse ausgezeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87901743-5d51-4e05-813d-f5e953064d67",
                                "sense_id": "4e10c5d6-4793-36be-8f7a-7d5421870f48",
                                "text": "„Während des Wiener Kongresses hatte Talleyrand einen Käsewettbewerb organisiert, um die Stimmung zu lockern.“"
                            },
                            {
                                "example_id": "bb7b9ea3-1a14-4fc1-b94e-7acd3a7e4e19",
                                "sense_id": "4e10c5d6-4793-36be-8f7a-7d5421870f48",
                                "text": "„Im Vorfeld unserer Reise war auch die Rede von einem Käsewettbewerb dort ‒ ich bin gespannt.“"
                            },
                            {
                                "example_id": "e3988ac5-dcad-48e6-9322-5657a8cc3593",
                                "sense_id": "4e10c5d6-4793-36be-8f7a-7d5421870f48",
                                "text": "„Letzterer wurde auf einem Käsewettbewerb anlässlich des Wiener Kongresses im Jahr 1815 zum ‚König aller Käse‘ ernannt.“"
                            },
                            {
                                "example_id": "9369438b-f50f-443f-bcfc-da8209938179",
                                "sense_id": "4e10c5d6-4793-36be-8f7a-7d5421870f48",
                                "text": "„Deshalb freue ich mich jedes Mal, wenn ich als Juror zu einem Käsewettbewerb eingeladen bin, denn da bekomme ich so viel gute Käsesorten zu prüfen wie sonst nie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
