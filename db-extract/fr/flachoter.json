                                "target_senses": [
                                    {
                                        "sense_id": "36ff1766-0256-39e9-83b9-81077df84649",
                                        "entry_id": "1cbd5f50-2b05-3b5b-9c64-8f84c89bf062",
                                        "glosses": [
                                            "een flits veroorzaken, maken of gebruiken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed722ec-ee0c-4b0e-8fe8-da7d1c6bf94e",
                                                "sense_id": "36ff1766-0256-39e9-83b9-81077df84649",
                                                "text": "Om in het donker foto's te kunnen maken moet je flitsen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8149fb7-e19c-3f25-9dee-4e134a19e986",
                                        "entry_id": "1cbd5f50-2b05-3b5b-9c64-8f84c89bf062",
                                        "glosses": [
                                            "auto's fotograferen die te snel rijden om een boete te kunnen geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00e2566-bc1b-4a31-959d-d397e004766b",
                                                "sense_id": "d8149fb7-e19c-3f25-9dee-4e134a19e986",
                                                "text": "Mijn dochter en ik zijn tweemaal geflitst in Nijmegen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686cea38-272c-3f66-a5ec-68ffef12c03a",
                                        "entry_id": "1cbd5f50-2b05-3b5b-9c64-8f84c89bf062",
                                        "glosses": [
                                            "een snelle beweging maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd61f5c-6116-44ba-a0b9-cbb8b8dbb273",
                                                "sense_id": "686cea38-272c-3f66-a5ec-68ffef12c03a",
                                                "text": "De wielrenners van de Tour de France flitsen voorbij."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be03e807-4b23-316d-bdd6-c0e57dde46b5",
                                        "entry_id": "1cbd5f50-2b05-3b5b-9c64-8f84c89bf062",
                                        "glosses": [
                                            "heftig maar kort aanwezig zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac5487c-e478-4ab4-aa9a-196cd316bf72",
                                                "sense_id": "be03e807-4b23-316d-bdd6-c0e57dde46b5",
                                                "text": "De rampen die zouden kunnen gebeuren flitsten door mijn hoofd toen ik de kinderen bij het ravijn zag spelen."
                                            },
                                            {
                                                "example_id": "c599913b-8b58-4d09-a150-4afb7b6c7c7c",
                                                "sense_id": "be03e807-4b23-316d-bdd6-c0e57dde46b5",
                                                "text": "Tijdens de laatste kilometers liet ik alle herinneringen van de trail in een noodvaart door mijn hoofd flitsen, misschien zoals mensen die een bijna-doodervaring hebben."
                                            }
                                        ]
                                    }
                                ]
                            },
