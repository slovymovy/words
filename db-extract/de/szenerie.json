                ],
                "senses": [
                    {
                        "sense_id": "d0eaeb18-2c37-3131-9e55-a15f7c348416",
                        "entry_id": "ca05c839-cd5a-3839-8967-469d505d60b3",
                        "glosses": [
                            "das für ein Stück entwickelte Bühnenbild"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "26510a34-a661-46a9-bf17-0f3a8d644e17",
                                "sense_id": "d0eaeb18-2c37-3131-9e55-a15f7c348416",
                                "text": "„Die Szenerien sind anmutig, die Dialoge voller Esprit, die Konsequenzen der modernen Astronomie für die Marquise eine Zumutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29b3c960-b544-3731-b095-ae88f78de5ec",
                        "entry_id": "ca05c839-cd5a-3839-8967-469d505d60b3",
                        "glosses": [
                            "Gesamtheit dessen, was sich von einem Standort aus dem Blick des Betrachters darbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1362043-6b65-4ffb-9671-03325ddc5776",
                                "sense_id": "29b3c960-b544-3731-b095-ae88f78de5ec",
                                "text": "„Berlin wimmelte von Mäzenen, sie gehörten zur Szenerie.“"
                            },
                            {
                                "example_id": "59d3e5a2-47d4-4d45-a4de-ee308b860a0f",
                                "sense_id": "29b3c960-b544-3731-b095-ae88f78de5ec",
                                "text": "„In diese Szenerie platzte Emma Bertinis zweite Ankunft in Bodendorf.“"
                            },
                            {
                                "example_id": "9a99fd6f-004e-466a-9354-cc06864b8809",
                                "sense_id": "29b3c960-b544-3731-b095-ae88f78de5ec",
                                "text": "„Ich blickte auf die mit dreckigem Schnee bedeckte deutsche Erde in unserem Garten, zum Rhein, über die Trauerweiden hinweg aufs Siebengebirge, und diese ganze Szenerie kam mir idiotisch vor.“"
                            },
                            {
                                "example_id": "bdae9f37-50ec-4675-8b10-c3044f1d5b2e",
                                "sense_id": "29b3c960-b544-3731-b095-ae88f78de5ec",
                                "text": "„Die Szenerie war offen genug, um sie mit Einfällen zu füllen, die ein Autor braucht, um Begegnungen, Konflikte, Abenteuer zu erfinden, die den Roman spannend halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
