                {
                    "sense_id": "428f4a42-d9d9-3f70-b838-6578e47af853",
                    "sense_definition": "A type of fast-drying paint made of pigment suspended in an acrylic polymer emulsion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art_materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When it comes to painting, I prefer using <w>acrylics</w> as my medium because they dry so quickly.",
                            "target_lang_translations": {
                                "ru": "Когда дело доходит до живописи, я предпочитаю использовать <w>акрил</w> в качестве материала, потому что он очень быстро сохнет."
                            }
                        },
                        {
                            "text": "The artist used a bright <w>acrylic</w> to capture the vibrant colors of the sunset.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркий <w>акрил</w>, чтобы запечатлеть живые краски заката."
                            }
