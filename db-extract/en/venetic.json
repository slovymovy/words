                    {
                        "translation_id": "aaeca72d-2419-4042-8fd3-1adf8500bb4f",
                        "source_entry_id": "1dc22667-2f75-300c-97c5-350661fe0559",
                        "source_sense_id": "242ffe54-3b53-3ff3-a103-7c10a2807c1f",
                        "source_sense_description": "Venetic language",
                        "target_lang_word": "Venetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c8c1491-f21c-3b71-9aee-2d1acee8ffd0",
                                        "entry_id": "8814b2cc-828c-3d3c-a65c-f724d0820522",
                                        "glosses": [
                                            "romanische Sprache, die im Nordosten Italiens gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7123259d-6399-4345-9ebb-09c0e1148bd6",
                                                "sense_id": "2c8c1491-f21c-3b71-9aee-2d1acee8ffd0",
                                                "text": "Über drei Millionen Menschen sprechen Venetisch."
                                            },
                                            {
                                                "example_id": "912ea83c-f37b-4de1-8ee2-5c4c3447a760",
                                                "sense_id": "2c8c1491-f21c-3b71-9aee-2d1acee8ffd0",
                                                "text": "Die Verwandtschaft des Venetischen mit dem Französischen und Spanischen ist teilweise größer als mit der italienischen Standardsprache."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f85e6cd9-68d0-31e1-9afd-631451a29d3e",
                                        "entry_id": "8814b2cc-828c-3d3c-a65c-f724d0820522",
                                        "glosses": [
                                            "etwa im 1. Jahrhundert nach Christus ausgestorbene Sprache, die in der nördlichen Adria-Region gesprochen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18913df-1e36-4148-a819-bd0d22faf094",
                                                "sense_id": "f85e6cd9-68d0-31e1-9afd-631451a29d3e",
                                                "text": "„Überliefert ist das Venetische durch mehr als 200, meist kurze Inschriften auf Stein- und Bronzetafeln sowie Tongefäßen.“"
                                            },
                                            {
                                                "example_id": "76cd390f-8c08-4869-a938-31d2f41cb092",
                                                "sense_id": "f85e6cd9-68d0-31e1-9afd-631451a29d3e",
                                                "text": "„Schließt man den Zufall aus, muss man eine frühe Stufe des Italischen annehmen, wo Latein und Venetisch für kurze Zeit benachbart waren und erst die Südwanderung der Vorfahren der Lateiner den Kontakt mit den Ostitalikern intensivierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
