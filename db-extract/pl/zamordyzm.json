                ],
                "senses": [
                    {
                        "sense_id": "0fa8691f-e0a9-3422-b6a2-f10122175f16",
                        "entry_id": "82fd975e-0334-33b8-9af3-91ff67b54397",
                        "glosses": [
                            "government or management through strict discipline and severe punishment of dissent"
                        ],
                        "tags": [
                            "derogatory",
                            "inanimate",
                            "informal",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "9d69b354-2ba9-4cdd-a0ce-8faa2126fefa",
                                "sense_id": "0fa8691f-e0a9-3422-b6a2-f10122175f16",
                                "text": "Najtragiczniejsze jest jednak to, że wpływom zamordyzmu ulegli nie tylko ci, którzy go uprawiali, lecz także ci, którzy z nim walczyli.",
                                "translation": "The most tragic part of all of this is that not only those who did it fell victim to extreme rigor, but also those who fought with it.",
                                "english": "The most tragic part of all of this is that not only those who did it fell victim to extreme rigor, but also those who fought with it."
                            },
                            {
                                "example_id": "6ce70d76-1912-4af2-aad3-6cf4432ff0ad",
                                "sense_id": "0fa8691f-e0a9-3422-b6a2-f10122175f16",
                                "text": "Społeczeństwo trzymane jest w ryzach, zamordyzm pleni się obficie i jest to zamordyzm najwyższej próby, trochę tylko ustępujacy stalinizmowi, bo to wszak inna kultura.",
                                "translation": "Society is kept on the straight and narrow, strict discipline multiplies profusely and this is top-notch rigor, second only to Stalinism, because that is after all a different culture.",
                                "english": "Society is kept on the straight and narrow, strict discipline multiplies profusely and this is top-notch rigor, second only to Stalinism, because that is after all a different culture."
                            },
                            {
                                "example_id": "0babb1ed-86dd-443a-a8f2-f060a4c4183e",
                                "sense_id": "0fa8691f-e0a9-3422-b6a2-f10122175f16",
                                "text": "Zaczynała się właśnie gomułkowska odwilż, która po latach zamordyzmu wyzwoliła niesłychany potencjał prywatnej inicjatywy gospodarczej.",
                                "translation": "the Gomułkian thaw was starting, which after years of rigor released the unheard o potential of the private sector.",
                                "english": "the Gomułkian thaw was starting, which after years of rigor released the unheard o potential of the private sector."
                            }
                        ]
                    }
                ],
