                                        "entry_id": "c9fa66ac-3387-3884-ad1d-125a0c439a59",
                                        "glosses": [
                                            "Naturally-occurring uranium oxide, a variety of the mineral uraninite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d374b375-7356-4fcd-8cb6-2160759bccfa",
                                                "sense_id": "f0352da2-9b8c-367e-b1fe-b35af348672f",
                                                "text": "Working in Paris in 1898, Marie and Pierre Curie processed thousands of pounds of pitchblende from the same glass-factory tailings in order to isolate two radioactive elements that had hitherto been unknown: radium and polonium."
                                            }
                                        ]
                                    }
                                ]
