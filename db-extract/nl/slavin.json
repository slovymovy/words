                        "cross_references": [
                            {
                                "target_word": "slave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25dc48db-34ab-3f6b-93c7-97ab9804ac48",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "A person who is held in servitude as the property of another person, and whose labor (and often also whose body and life) is subject to the owner's volition and control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd14994-83bb-49fb-b2b2-0ab02fb3cf6b",
                                                "sense_id": "25dc48db-34ab-3f6b-93c7-97ab9804ac48",
                                                "text": "Fear of their cargo bred a savage cruelty into the crew. One captain, to strike terror into the rest, killed a slave and dividing heart, liver and entrails into 300 pieces made each of the slaves eat one, threatening those who refused with the same torture. Such incidents were not rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81a7e6e-6317-31de-99b1-854ec6f2d72d",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "A drudge; one who labors or is obliged (e.g. by prior contract) to labor like a slave with limited rights, e.g. an indentured servant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73634754-ab32-34cd-b792-1c2dde924a89",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "An abject person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c20e024-0e50-4981-bbc7-ca4c50482d51",
                                                "sense_id": "73634754-ab32-34cd-b792-1c2dde924a89",
                                                "text": "Art thou the ſlaue that with thy breath haſt kill'd / Mine innocent child?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa0f81e-b505-3678-a595-1a14943d6f8a",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "One who has no power of resistance to something, one who surrenders to or is under the domination of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "583ad169-b40d-4894-bbaf-7458cee807e5",
                                                "sense_id": "3aa0f81e-b505-3678-a595-1a14943d6f8a",
                                                "text": "a slave to passion, to strong drink, or to ambition"
                                            },
                                            {
                                                "example_id": "90d1d8b0-9c4d-44ee-ad60-3feb1ac652d4",
                                                "sense_id": "3aa0f81e-b505-3678-a595-1a14943d6f8a",
                                                "text": "Slave to the rhythm! / Keep it up, keep it up! / Never stop! Never stop!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8acfbfb-d789-3e48-a4cd-b9fbc1dcc731",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "A submissive partner in a BDSM relationship who consensually submits to, sexually or personally, serving one or more masters or mistresses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "076b5909-4d90-4b65-8798-41ffbd69700f",
                                                "sense_id": "a8acfbfb-d789-3e48-a4cd-b9fbc1dcc731",
                                                "text": "In the clip the black female “slave” dons a chain around her neck for which her white mistress possesses the key. The black woman sub is further disciplined by the power of speech—the force of silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d059fd30-a602-3706-8c4e-4136da534291",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "A sex slave, a person who is forced against their will to perform, for another person or group, sexual acts on a regular or continuing basis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964feb44-1b4f-3d0a-abe7-0342aa9e6f4c",
                                        "entry_id": "2aa3938f-f11a-3e07-99ff-f44fb3ad79d7",
                                        "glosses": [
                                            "A device (such as a secondary flash or hard drive) that is subject to the control of another (a master)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb2e830-ca72-4871-8f4a-e3113d083c54",
                                                "sense_id": "964feb44-1b4f-3d0a-abe7-0342aa9e6f4c",
                                                "text": "If you administer your own reverse DNS zones, remember to include them in your slave configuration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                        "entry_id": "e3e5611e-45a1-3e16-ba06-26296e6f6761",
                                        "glosses": [
                                            "To work as a slaver, to enslave people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d622e65a-a8cb-422d-83c8-1b0c683989ab",
                                                "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                                "text": "MASSINISSA: Wilt thou be slaved?\nSOPHONISBA: No, free"
                                            },
                                            {
                                                "example_id": "22704c1d-3934-4488-a2c0-1ff3526c997b",
                                                "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                                "text": "The truth is from the Zambesi to Lake Nyasa on the north and east banks of the river, there is nothing but slaving — Africans selling each other . . ."
                                            },
                                            {
                                                "example_id": "6abad020-c446-4c74-8dc7-7272f0b2dc15",
                                                "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                                "text": "Despite these examples, the majority of enslaved Africans were not able to rely on rulers for help against slaving. Africans living in chiefdoms and villages ruled by allied African authorities were, however, able to use the legal system (Tribunal of Mukanos) in place in the regions under formal Portuguese control […]"
                                            },
                                            {
                                                "example_id": "1ca60ffc-8cb6-4b2d-ac42-d20f0909236d",
                                                "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                                "text": "With ready access to firearms through trade, the slaving Africans held a distinct upper-hand over the groups they preyed upon, which were often politically and socially weakened or destroyed by the trade."
                                            },
                                            {
                                                "example_id": "c5b951ff-0dfc-438c-8c21-2e9826025bc2",
                                                "sense_id": "0d668388-b13e-3e2a-b6eb-bd28462c5141",
                                                "text": "Significant impacts resulted from slaving; there is evidence of how communities dealt with the threat and benefits of slaving. Africans provided most of the slaves to European slavers. Most slaves were created either to settle debts or raise funds, through warfare, or as punishment for a real or perceived crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cfe92ef-90b4-3929-81d4-febed08fd1d9",
                                        "entry_id": "e3e5611e-45a1-3e16-ba06-26296e6f6761",
                                        "glosses": [
                                            "To work hard."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41acc8d3-e2ff-45c4-8ddd-49197c5e15b5",
                                                "sense_id": "9cfe92ef-90b4-3929-81d4-febed08fd1d9",
                                                "text": "I was slaving all day over a hot stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee9f555-6e75-3c7d-a313-ef0e4034adef",
                                        "entry_id": "e3e5611e-45a1-3e16-ba06-26296e6f6761",
                                        "glosses": [
                                            "To place a device under the control of another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f2cface-0cd7-44a3-8b03-3361268e36fe",
                                                "sense_id": "dee9f555-6e75-3c7d-a313-ef0e4034adef",
                                                "text": "to slave a hard disk"
                                            },
                                            {
                                                "example_id": "c54742f4-1590-448c-8cf0-66fb1004e01f",
                                                "sense_id": "dee9f555-6e75-3c7d-a313-ef0e4034adef",
                                                "text": "Slaving one digital audio device to another unit using timecode alone results in time-based synchronisation[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
