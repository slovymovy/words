                                    {
                                        "sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
                                        "entry_id": "6cb529f0-7338-3021-ab80-8d0d395b30e8",
                                        "glosses": [
                                            "Commune, ville, port et chef-lieu de département français, situé dans le département de la Loire-Atlantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78394b47-bfc2-43db-b083-e29d496b7f54",
                                                "sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
                                                "text": "Le département des Ardennes n'est pas un département vinicole ; il se trouve en grande partie au delà de la ligne idéale qui marque la limite de la culture de la vigne en France et qui va de Nantes à Mézières."
                                            },
                                            {
                                                "example_id": "1d4a498e-690a-4ff4-b7ec-6d5b27dd4983",
                                                "sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
                                                "text": "Les tripots de Nantes étaient célèbres ; la police avait beau multiplier ses enquêtes et la municipalité faire une guerre acharnée à ceux qui favorisaient le jeu, on ne pouvait empêcher ni les ruines, ni les scandales."
                                            },
                                            {
                                                "example_id": "b6eb0aea-204a-47b0-9cfe-18edb07e68de",
                                                "sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
                                                "text": "Il marcha de long en large dans sa chambre, en bras de chemise, fenêtre grande ouverte sur Nantes endormi sous une lune voilée."
                                            },
                                            {
                                                "example_id": "6a541c19-e52f-468a-991b-a1744d0cca37",
                                                "sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
                                                "text": "Il saute par-dessus les remparts et s’en va par les rues de Nantes endormie, criant à qui veut l’entendre « A la force ! Les seigneurs veulent outrager et prendre le duc ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
