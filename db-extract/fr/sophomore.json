                "senses": [
                    {
                        "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                        "entry_id": "6d77681e-ffa5-30d9-889b-b744719fac81",
                        "glosses": [
                            "Étudiant en deuxième des quatre années d’université ou de lycée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "89d09ec9-d005-4d67-8797-52d0e5c53354",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "L'émulation était âpre parmi les freshmen (première année) et les sophomores (deuxième année) pour se faire distinguer par les aînés influents dont dépendait leur accession au monde prestigieux de l'Ivy Club, noté pour son raffinement aristocratique, […]."
                            },
                            {
                                "example_id": "2862ac12-0c51-4ed1-8392-d7c33fd5d9ff",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "Il s'agissait d'une de mes étudiantes – une « sophomore », le surnom des secondes années, chez nous, à Columbia. Une grande perche blonde ; tout le contraire de Sofia. Elle s'appelait Annie."
                            },
                            {
                                "example_id": "5fd143f3-cf77-4477-a0f9-835557f5133b",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "Les parents de Pénélope vivaient non loin de Princeton. Après une année de résidence à l’université, la sophomore avait obtenu une dispense pour réintégrer le toit familial."
                            },
                            {
                                "example_id": "c7be667e-679e-4f92-b7c5-828920cf4a65",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "C'est sa façon de montrer ces fameuses qualités de chef qui l'ont fait élire capitaine de l'équipe de natation bien qu'il ne soit que sophomore."
                            },
                            {
                                "example_id": "d55953e9-133d-4689-89ae-ce58124fb633",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "Roy ne pouvait, certes, déployer plus ou moins le pavillon des gais ailleurs qu'au lycée, où il avait enrôlé quatre Tories, tous sophomores, et quatre élèves de sa classe."
                            },
                            {
                                "example_id": "dd75b0db-aa9c-4dfc-9bc4-72fe140758d0",
                                "sense_id": "85810c25-6523-3ec8-99eb-8cad1eafbed6",
                                "text": "J'avais appris cela en Histoire Américaine 267, cours de deuxième année, niveau sophomore…"
                            }
                        ]
                    }
