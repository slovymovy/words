                "translations": [
                    {
                        "translation_id": "a3b7e038-32e1-4210-bb29-ab3f3eec173d",
                        "source_entry_id": "e3a63043-70b7-3c88-97dc-78bf96a4a2a8",
                        "target_lang_word": "aufheizen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufheizen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99641909-40e5-3826-a3ae-40374f3ed316",
                                        "entry_id": "32ada236-a2af-3e5e-a47d-da22953f4457",
                                        "glosses": [
                                            "die Temperatur (von außen) steigern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5446c152-ec8e-46e8-a01c-dd1433e63f26",
                                                "sense_id": "99641909-40e5-3826-a3ae-40374f3ed316",
                                                "text": "„Nach dem Erkalten gießt man in 1,5 l Wasser, heizt auf 80° auf, filtriert das unveränderte Anthrachinon ab und wäscht es mit wenig heißem Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c758905-da43-3547-a96c-2a4049a3f9e1",
                                        "entry_id": "32ada236-a2af-3e5e-a47d-da22953f4457",
                                        "glosses": [
                                            "an Temperatur zunehmen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c1a590-f8de-4829-946a-87ebf119836e",
                                                "sense_id": "9c758905-da43-3547-a96c-2a4049a3f9e1",
                                                "text": "„Die dunkle Farbe absorbiert das Licht, wandelt es in Wärme um - ähnlich wie sich ein schwarzes Auto in der Sonne mächtig aufheizt.“"
                                            },
                                            {
                                                "example_id": "7d3b4d90-bc28-4803-a40f-06c6daf9307a",
                                                "sense_id": "9c758905-da43-3547-a96c-2a4049a3f9e1",
                                                "text": "„Der Ölkonzern Exxon Mobil wusste intern bereits seit den 1970er-Jahren, dass fossile Brennstoffe das Klima aufheizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "badc462d-470f-3dff-8942-2b7e93e3406a",
                                        "entry_id": "32ada236-a2af-3e5e-a47d-da22953f4457",
                                        "glosses": [
                                            "an Spannung zunehmen (lassen)"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f611bba-549f-4157-b121-f7c8e5e5d085",
                                                "sense_id": "badc462d-470f-3dff-8942-2b7e93e3406a",
                                                "text": "„Martin Luther heizte die Stimmung weiter auf.“"
                                            },
                                            {
                                                "example_id": "5c717aa9-42ed-4dc3-a455-d905892c4c54",
                                                "sense_id": "badc462d-470f-3dff-8942-2b7e93e3406a",
                                                "text": "„‚Die langen Wartezeiten, Abweisungen und die räumliche Enge schüren zusätzliche Konflikte‘, erklärt Sozialreferentin Dorothee Schiwy. ‚Die Stimmung im Tagestreff heizt sich an manchen Tagen auf, und es kommt zu Sicherheitsproblemen.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
