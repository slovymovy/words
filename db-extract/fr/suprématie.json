        "fr-extract.jsonl": [
            {
                "entry_id": "5f6333c0-d86b-3a58-aef8-caffaffd91ab",
                "word": "suprématie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee69ecab-e62a-482a-869c-cc40d11fb20b",
                        "entry_id": "5f6333c0-d86b-3a58-aef8-caffaffd91ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "suprématies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54c53068-1e32-3c49-81ad-fcdf9d64790a",
                        "entry_id": "5f6333c0-d86b-3a58-aef8-caffaffd91ab",
                        "glosses": [
                            "Supériorité, prééminence, excellence au-dessus de tous les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506e018a-5d5b-4729-afd3-13065c787c39",
                                "sense_id": "54c53068-1e32-3c49-81ad-fcdf9d64790a",
                                "text": "Le sujet de la profonde inimitié qui régnait entre les Reybert et les Moreau provenait d’une blessure faite par Mme de Reybert à Mme Moreau, par suite d’une première pointillerie que s’était permise la femme du régisseur à l’arrivée des Reybert, afin de ne pas laisser entamer sa suprématie par une femme née de Corroy."
                            },
                            {
                                "example_id": "16e9e861-2fde-4ad1-86f4-6eda82c17c72",
                                "sense_id": "54c53068-1e32-3c49-81ad-fcdf9d64790a",
                                "text": "La période de l’entre-deux-guerres fut pourtant dominée, en pays musulmans, par la suprématie politique d’élites dirigeantes laïques visant à promouvoir une idéologie politique séculière, le nationalisme."
                            },
                            {
                                "example_id": "05ac40ed-c496-4281-b1e9-7c48f386bdb5",
                                "sense_id": "54c53068-1e32-3c49-81ad-fcdf9d64790a",
                                "text": "L’unilatéralisme américain et la mondialisation libérale procèdent d’une même logique. Ils refusent la suprématie du droit et de la délibération collective."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32525d87-07b6-46cb-a9dd-ec3ec308a26f",
                        "source_entry_id": "5f6333c0-d86b-3a58-aef8-caffaffd91ab",
                        "source_sense_id": "54c53068-1e32-3c49-81ad-fcdf9d64790a",
