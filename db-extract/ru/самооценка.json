                ],
                "senses": [
                    {
                        "sense_id": "69239c73-ef76-3e29-81c8-9613f53a8dd7",
                        "entry_id": "0cf14810-f55e-3e8c-a6b8-fdc0bd778a4c",
                        "glosses": [
                            "оценка человеком самого себя, своих качеств и места среди других людей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e432ac5d-3b84-46c0-ace6-b9ffe0e2f48d",
                                "sense_id": "69239c73-ef76-3e29-81c8-9613f53a8dd7",
                                "text": "Если бы для достижения жизненных целей было достаточно полагаться на то, что ты знаешь и умеешь делать, самооценка была бы пропорциональна собственным способностям, т.е. собственной полезной ценности; но поскольку успех зависит, по большей части, от того, как ты умеешь продать свою личность, то ты воспринимаешь себя как товар, или, вернее, и как продавца, и как товар одновременно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feabe18c-89da-4021-b861-8a7de145957c",
                        "source_entry_id": "0cf14810-f55e-3e8c-a6b8-fdc0bd778a4c",
                        "source_sense_id": "69239c73-ef76-3e29-81c8-9613f53a8dd7",
                        "target_lang_word": "self-appraisal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "19d1a758-7603-4fea-97a7-640aa787d3be",
                        "source_entry_id": "0cf14810-f55e-3e8c-a6b8-fdc0bd778a4c",
                        "source_sense_id": "69239c73-ef76-3e29-81c8-9613f53a8dd7",
                        "target_lang_word": "self-evaluation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-evaluation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb676690-39f0-32e2-aa0e-ab51f81b0f5d",
                                        "entry_id": "788ec17a-d253-34f2-b1a9-d2314fa5b709",
                                        "glosses": [
                                            "An evaluation of oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906ecd43-e01e-49f1-8d26-efb934ee99ab",
                                                "sense_id": "eb676690-39f0-32e2-aa0e-ab51f81b0f5d",
                                                "text": "Self-evaluation, done correctly, can help guide you through the next five or more years of your career, whether that means staying with your current company in your existing job or moving to a different position, going to another firm, or striking out on your own."
                                            },
                                            {
                                                "example_id": "35c9af3c-de2f-40c7-9cc6-239f6fa33758",
                                                "sense_id": "eb676690-39f0-32e2-aa0e-ab51f81b0f5d",
                                                "text": "You can use self-evaluations as a basis for creating future goals and objectives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
