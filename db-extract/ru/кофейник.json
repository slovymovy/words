                ],
                "senses": [
                    {
                        "sense_id": "665f93bd-644e-3bd9-ba5a-59f99094d630",
                        "entry_id": "04f9ce47-3551-3edb-91a4-42343121ba50",
                        "glosses": [
                            "сосуд (как правило, металличекий или керамический), используемый для разлития кофе по чашкам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaefd456-f871-4aa2-beed-42cdabe292e7",
                                "sense_id": "665f93bd-644e-3bd9-ba5a-59f99094d630",
                                "text": "Обыкновенный кофейник бывает в виде сосуда вытянутой формы (обычно имеет суженный верх) со сливным носиком и крышкой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb39266-18fc-4457-9e7f-6a1ec8defed7",
                        "source_entry_id": "04f9ce47-3551-3edb-91a4-42343121ba50",
                        "source_sense_id": "665f93bd-644e-3bd9-ba5a-59f99094d630",
                        "target_lang_word": "coffee pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffee pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f69ef79-d2ca-3b50-9703-e06f12ad6ccb",
                                        "entry_id": "766efe3d-e4f2-3aa9-951c-b05344bb0f12",
                                        "glosses": [
                                            "A pot in which coffee is brewed or from which it is served."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18c42ad-c6aa-4c8d-9644-c6106e70d6ab",
                                                "sense_id": "1f69ef79-d2ca-3b50-9703-e06f12ad6ccb",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30f3b9ed-38fd-43a3-bd3e-b21b19255769",
                        "source_entry_id": "04f9ce47-3551-3edb-91a4-42343121ba50",
                        "source_sense_id": "665f93bd-644e-3bd9-ba5a-59f99094d630",
                        "target_lang_word": "coffee-pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffee-pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2e108b-ca13-3da9-a8a3-e70f972d40bf",
                                        "entry_id": "9d409fce-483c-39f7-841a-07c71c4559f4",
                                        "glosses": [
                                            "Alternative form of coffee pot."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4639faeb-4672-4d80-a44b-b88c0aede160",
                                                "sense_id": "fe2e108b-ca13-3da9-a8a3-e70f972d40bf",
                                                "text": "The German looked round, and missed the coffee-pot; but the other Jew told him, “Do not be uneasy, my friend, go with me, and I will make my comrade give you back your coffee-pot\"."
                                            },
                                            {
                                                "example_id": "12a61e33-38a1-4ab4-91bd-049b066e2722",
                                                "sense_id": "fe2e108b-ca13-3da9-a8a3-e70f972d40bf",
                                                "text": "A matching new oval coffee-pot was available."
                                            },
                                            {
                                                "example_id": "aa523e61-f217-4652-ab58-e96853d03d37",
                                                "sense_id": "fe2e108b-ca13-3da9-a8a3-e70f972d40bf",
                                                "text": "If you intend to make half a dozen cups of coffee for drinking, measure six cups of water of the same size, and put the water into the coffee-pot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a51fceb2-1687-4b13-bf39-77ad180374e7",
                        "source_entry_id": "04f9ce47-3551-3edb-91a4-42343121ba50",
                        "source_sense_id": "665f93bd-644e-3bd9-ba5a-59f99094d630",
                        "target_lang_word": "Kaffeekanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffeekanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                        "entry_id": "afd373ce-3051-37e4-ab09-1f089cf89df8",
                                        "glosses": [
                                            "Behälter, in dem Kaffee zubereitet, warmgehalten, transportiert und serviert werden kann"
                                        ],
                                        "tags": [
                                            "Geschirr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2449f23-ee6e-4f68-9fac-c2f621082bbd",
                                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                                "text": "Man sollte eine Kaffeekanne nicht für Tee benutzen."
                                            },
                                            {
                                                "example_id": "568706c7-8454-4423-8665-658e71443432",
                                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                                "text": "„Die silberne Kaffeekanne ist umgefallen und hat ihren Inhalt über das Tischtuch ergossen und einen Frühstücksteller zerschlagen.“"
                                            },
                                            {
                                                "example_id": "b304e175-38c3-40ee-bbbb-16a6da81da73",
                                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                                "text": "„Er machte Licht und zündete die Flamme unter der Kaffeekanne an.“"
                                            },
                                            {
                                                "example_id": "91cdd6e6-5983-42a9-adc5-b0ccc6a2fdbb",
                                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                                "text": "„Ich setzte mich an den gescheuerten Tisch und sah Anna zu, wie sie am Herd den Filter von der Kaffeekanne nahm und ihn zum Austropfen auf eine Tasse stellte.“"
                                            },
                                            {
                                                "example_id": "9da7f293-d2fd-4144-b060-108f490d94d5",
                                                "sense_id": "fd3f9a61-414e-361a-9f32-5dec349e865f",
                                                "text": "„Ich sah die zierliche Frau, die unter der Totenliste gesessen hatte, mit einer Kaffeekanne herankommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
