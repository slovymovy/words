                "senses": [
                    {
                        "sense_id": "59074dd9-e6fe-309c-a3fd-10f0e5da703c",
                        "entry_id": "89a31f09-2609-35d3-9e00-d0f0104b19e7",
                        "glosses": [
                            "van een wapen dat er geen munitie in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25445cb1-e98d-4cc7-8a4c-001565df5203",
                                "sense_id": "59074dd9-e6fe-309c-a3fd-10f0e5da703c",
                                "text": "Volgens de rechter mocht de verdachte er niet van uitgaan dat het wapen ongeladen was. Aan de rechtbank vertelde hij immers dat hij vermoedde dat de vriend, de 24-jarige Angelo Frank, in de dagen voor het incident zelf met het wapen in de weer was geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "346557a8-378a-3db3-8ac9-4a04c9474533",
                        "entry_id": "89a31f09-2609-35d3-9e00-d0f0104b19e7",
                        "glosses": [
                            "zonder lading, zonder vracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e094b0-8f0e-42f2-ba6e-f6dd4c9b0878",
                                "sense_id": "346557a8-378a-3db3-8ac9-4a04c9474533",
                                "text": "Het ging woensdag ook al een paar keer mis. Op de A2 van Amsterdam naar Utrecht kantelde een ongeladen vrachtwagen bij Breukelen door de wind. De vrachtwagen is overdwars op de rijbaan terechtgekomen en lekt diesel. De hele rijbaan is afgesloten."
                            },
                            {
                                "example_id": "197b16e4-15b9-4383-ac45-354484fbdbe4",
                                "sense_id": "346557a8-378a-3db3-8ac9-4a04c9474533",
                                "text": "Aan boord van het vaartuig is ongeveer tweeduizend ton brandstof voor eigen gebruik. Het schip is verder ongeladen. Tot dusverre is er geen olie of schade aan het schip gesignaleerd, al werkt het roer niet meer, liet de Duitse kustwacht weten."
                            }
                        ]
                    }
                ],
