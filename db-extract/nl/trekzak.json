                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17ec03f3-6316-39ee-ba54-fbb50f595ce5",
                                        "entry_id": "3bf0b8fc-4130-35ff-8961-869bf0ee9cfa",
                                        "glosses": [
                                            "A type of reed organ with a single keyboard."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d17ea24-26ee-4284-a76e-381bb5659aa5",
                                                "sense_id": "17ec03f3-6316-39ee-ba54-fbb50f595ce5",
                                                "text": "The thin, nearsighted young woman who had been humped over the keyboard of the melodeon, straightened up. The worshipers relaxed a little and began to look about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242b8c39-0d98-3101-b98a-9284a063d69e",
                                        "entry_id": "3bf0b8fc-4130-35ff-8961-869bf0ee9cfa",
                                        "glosses": [
                                            "An accordion where the melody-side keyboard is limited to the notes of diatonic scales in a small number of keys."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770678bd-ec32-4961-ae34-ad02facc8695",
                                                "sense_id": "242b8c39-0d98-3101-b98a-9284a063d69e",
                                                "text": "But Chae said it didn't matter, he'd bring his melodeon and Long Rob his fiddle; and faith! if that didn't content the folk they were looking for a church parade of the Gordons, not a wedding."
                                            },
                                            {
                                                "example_id": "f7d065aa-b957-4635-abd3-473e90e581b4",
                                                "sense_id": "242b8c39-0d98-3101-b98a-9284a063d69e",
                                                "text": "His brother, Roy, joined him as a dancer - their two-man jigs were much admired - and his nephew, Jamie Wheeler, has become the side's principal musician, on melodeon and fiddle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melodeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aba8eb2e-e7ea-3289-a2f8-87fff7b0bf83",
                                        "entry_id": "5c9ce993-0e72-3443-8617-cfcba95f96c3",
                                        "glosses": [
                                            "A music hall."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
