                        "sense_id": "cb247406-78c2-3b89-a727-6a813682b343",
                        "entry_id": "65952f07-f0f9-3e7d-a97e-342069aa56b7",
                        "glosses": [
                            "Doter de façon excessive, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6756d366-8fcd-4682-9760-f22459786a55",
                                "sense_id": "cb247406-78c2-3b89-a727-6a813682b343",
                                "text": "De plus, le Système d'échanges de crédits européens (EU ETS) a été sur-doté en quotas carbone, ce qui a entrainé une chute des prix du marché."
                            },
                            {
                                "example_id": "d109ed61-ffe4-45b0-b602-ea60a4efb021",
                                "sense_id": "cb247406-78c2-3b89-a727-6a813682b343",
                                "text": "« Il faut renforcer le recouplage et sur-doter les hectares fourragers » (Fnb)."
                            },
                            {
                                "example_id": "d9028e76-5b36-4302-8d08-4a69b74da695",
                                "sense_id": "cb247406-78c2-3b89-a727-6a813682b343",
                                "text": "Pour la FNPL, une option plus favorable consisterait à sur-doter les premiers hectares fourragers."
                            }
                        ]
