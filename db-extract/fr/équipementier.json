                "senses": [
                    {
                        "sense_id": "b64a2925-cbe8-395b-9a9d-32a45c087307",
                        "entry_id": "b84eb457-9e80-37bf-8140-0361fa3da970",
                        "glosses": [
                            "Firme industrielle fabriquant des équipements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27534ad8-6960-4d9e-9617-b78309d265b6",
                                "sense_id": "b64a2925-cbe8-395b-9a9d-32a45c087307",
                                "text": "Lance Armstrong est de plus en plus seul : il a brutalement été lâché mercredi par l’un de ses plus solides soutiens, l’équipementier Nike, par Trek, le fabricant des cycles avec lesquels il a gagné sept fois le Tour de France, et par le brasseur Anheuser-Busch."
                            },
                            {
                                "example_id": "6a4fc500-0051-48fa-aac5-4902011188fb",
                                "sense_id": "b64a2925-cbe8-395b-9a9d-32a45c087307",
                                "text": "Un poste qui vient après sa nomination d’« administrateur indépendant » de la société Plastic Omnium Holding Shanghai, filiale chinoise de l’équipementier automobile français Plastic Omnium."
                            },
                            {
                                "example_id": "6b4e3b06-c1cc-4385-ae4f-f257af0006d0",
                                "sense_id": "b64a2925-cbe8-395b-9a9d-32a45c087307",
                                "text": "Chose rare dans le monde du vélo, ce nom est là pour durer, puisque le copartenariat avec l’équipementier français tient sur cinq ans."
                            }
                        ]
                    }
