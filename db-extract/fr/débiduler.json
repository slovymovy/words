                ],
                "senses": [
                    {
                        "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                        "entry_id": "5f05b6c6-8b5e-3cb4-b88b-c076099c8608",
                        "glosses": [
                            "Verbe au sens non bien défini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938576e4-465d-4736-89df-b193e83fd328",
                                "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                                "text": "Tandis que le Concombrineux masquouzé glabougnait bien peinard dans sa baignoire, la réalité a commencé à se débiduler grave, suite à «une sorte de clafoutis dans les valvules de l’espace-temps»."
                            },
                            {
                                "example_id": "df4271c8-5e81-4334-ad57-275811786fc8",
                                "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                                "text": "« Salagadou la méchikabou, Raccroche cette pomme à sa branche, Salagadou la méchikabou, Détruis cette bague, Salagadou la méchikabou, Étrangle le quiqui du serpent, Débidule le bidule pour que l’Œuf, S’étouffe dans l’œuf! »"
                            },
                            {
                                "example_id": "d182cc68-23f7-4a1a-8270-7e872b3c8416",
                                "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                                "text": "Va falloir débiduler des bidules Face à l’obscurantisme qui vient Va falloir détruquer des trucs Devant l’assaut des extrêmismes"
                            },
                            {
                                "example_id": "b3a2c953-4a4d-468a-9e9a-b282f7252e7e",
                                "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                                "text": "Si cette attitude des membres/adhérents/votants/cotisants ne change pas, je ne vois pas comment il serait possible de \"débiduler\" l’affaire."
                            },
                            {
                                "example_id": "04494e12-1c7e-4175-886b-1e066962bfd9",
                                "sense_id": "59e5b072-a0bd-327c-8745-001b7756d3ca",
                                "text": "Avez-vous déjà eu besoin de biduler ? Débiduler ? Truc-choser ou machiner ?"
                            }
                        ]
                    }
                ],
