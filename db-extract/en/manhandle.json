                                                "sense_id": "cd6fd537-9198-36bc-b8e4-c3512d60fb6a",
                                                "text": "„Diese Steine waren vor allem bearbeitet worden, um sie als Messer, Speer oder Pfeilspitzen zu gebrauchen – und nicht, um Feuer zu schlagen, denn das Zusammenschlagen von zwei Feuersteinen erzeugt zwar Funken, doch sind diese zu kalt und kurzlebig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cea4cd4-a380-3388-86db-d477177f63b2",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "durch körperliche Gewalt massiv verletzen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a97a80-960c-48ba-aa01-6378df14c7f4",
                                                "sense_id": "2cea4cd4-a380-3388-86db-d477177f63b2",
                                                "text": "„Ein Unbekannter hat im Frankfurter Bahnhofsviertel zwei Männer zusammengeschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd773778-5171-359b-a255-07b6426237b9",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "durch körperliche Gewalt unbrauchbar machen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ab640b1-99c1-4824-aa2c-94adb9d77db8",
                                                "sense_id": "fd773778-5171-359b-a255-07b6426237b9",
                                                "text": "„Der alte Mann ist davon überzeugt, daß die Polizei in jedes Haus kann, wenn sie will, daß sie die Einrichtung zusammenschlagen darf und nicht einmal Rechenschaft ablegen muß!“"
                                            }
                                        ],
