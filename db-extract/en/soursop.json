                                    {
                                        "sense_id": "b7a2f1a0-a313-34e3-a696-98bc79551818",
                                        "entry_id": "7ba5d3c3-1b5f-33ee-bc0d-9b818c325cf9",
                                        "glosses": [
                                            "Nom vernaculaire de Annona muricata, petit arbre de la famille des Annonacées (Annonaceae), originaire du nord de l'Amérique du Sud, cultivé dans les régions tropicales pour son fruit comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55b980a-4e1d-438a-9f13-7ef9e04c79a2",
                                                "sense_id": "b7a2f1a0-a313-34e3-a696-98bc79551818",
                                                "text": "En Inde, on utilise des extraits des racines et des feuilles de corossolier pour la préparation de purgatifs et de toniques."
                                            },
                                            {
                                                "example_id": "64f06b6c-0f38-4b02-954b-2b9348860167",
                                                "sense_id": "b7a2f1a0-a313-34e3-a696-98bc79551818",
                                                "text": "Puisque cette même année où la Révolution entra dans l'orphelinat le président de la République la décréta « Année de l'arbre » en plantant lui-même à l'entrée du palais du Peuple un corossolier devant les caméras de la télévision nationale, nous devions nous aussi […] planter un corossolier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
