                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0dc4cbd8-efb8-4bf6-9088-b170ef129717",
                        "entry_id": "344fa599-7e02-3101-ab18-f126c3f563ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "baguenaudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7435e7f4-d815-3a37-aa9d-c65d599eb9a9",
                        "entry_id": "344fa599-7e02-3101-ab18-f126c3f563ad",
                        "glosses": [
                            "Fruit du baguenaudier, espèce de gousse en forme de petite vessie pleine d’air et qui éclate avec bruit lorsqu’on la presse entre les doigts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a4b8715-5b71-4596-a82e-f7f0219164cb",
                                "sense_id": "7435e7f4-d815-3a37-aa9d-c65d599eb9a9",
                                "text": "Qu’il faisait bon […] se donner gaîment de bonnes chiquenaudes\nEt faire entre ses doigts claquer les baguenaudes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7620ce6-187f-3b22-a991-7e723bb9d5ba",
                        "entry_id": "344fa599-7e02-3101-ab18-f126c3f563ad",
                        "glosses": [
                            "Poche."
                        ],
                        "tags": [
                            "analogy",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "82125b02-26f7-4d54-acbd-9cca4343693f",
                                "sense_id": "a7620ce6-187f-3b22-a991-7e723bb9d5ba",
                                "text": "Barbotter dans les baguenaudes, faire les poches."
                            },
                            {
                                "example_id": "2041c318-d33a-4e0a-8228-73519c80a906",
                                "sense_id": "a7620ce6-187f-3b22-a991-7e723bb9d5ba",
                                "text": "Baguenaude à sec, poche vide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c45c1537-0799-4b15-9915-5cba3444e231",
                        "source_entry_id": "344fa599-7e02-3101-ab18-f126c3f563ad",
                        "source_sense_description": "fruit du baguenaudier",
