                ],
                "senses": [
                    {
                        "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                        "entry_id": "8cfc30ef-1eec-33bf-bead-610106af5b40",
                        "glosses": [
                            "Berechtigungsschein mit der Erlaubnis zum Bezug bestimmter, rationierter Lebensmittel und gegebenenfalls anderer Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b17f2b6-8508-4c58-a42d-2f1bae8b6c59",
                                "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                                "text": "„Und es gehe ja schon nicht wegen der Lebensmittelkarten, sie wüssten doch auch, wie das wäre.“"
                            },
                            {
                                "example_id": "6aa41c89-3725-40ca-9c17-d3bcf7faeef8",
                                "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                                "text": "„Bereits im Februar 1915 mussten reichsweit »Brotkarten« eingeführt werden - Vorbild des im Zweiten Weltkrieg immer differenzierter werdenden Systems der »Lebensmittelkarten«, die auch »Raucherkarten« und »Reichseierkarten« umfassten.“"
                            },
                            {
                                "example_id": "37007545-b338-46b8-9777-945fd88224c4",
                                "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                                "text": "„Fräulein Reber brachte die Lebensmittelkarten von Haus zu Haus.“"
                            },
                            {
                                "example_id": "f6317250-5d82-40d6-9cc9-17fbca392136",
                                "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                                "text": "„Schwierig war auch das Einkaufen geworden, denn zum Einkaufen brauchte man nun Lebensmittelkarten und musste oft in den Geschäften lange anstehen, um nur wenig dafür zu bekommen.“"
                            },
                            {
                                "example_id": "ff83ca25-7d59-48f6-84b1-9f6b70452411",
                                "sense_id": "7284beca-7a86-3ce7-b387-f2dbae1c8de3",
                                "text": "„Theodor Wandt hatte Bezugsscheine für Kleider, Wäsche und Schuhe sowie einen Stoß Lebensmittelkarten für den Rest des Monats August gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
