                "senses": [
                    {
                        "sense_id": "dfc5d3b5-9f60-3b8e-aed8-f7936f96a494",
                        "entry_id": "9ff5dd57-f328-35ba-a387-c7b368f5a022",
                        "glosses": [
                            "Qui est propre à suggérer, en particulier avec un sous-entendu sensuel ou érotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74065fa7-8db7-42d1-b44f-bfde000fa5ed",
                                "sense_id": "dfc5d3b5-9f60-3b8e-aed8-f7936f96a494",
                                "text": "Tard dans la soirée, les danseurs commencèrent à s’animer. Il y eut alors quelques essais de « upa upa », qui est d’origine tahitienne, suggestive et voluptueuse."
                            },
                            {
                                "example_id": "6d5b0190-dd21-4246-8d1d-bd2ed0dde4a4",
                                "sense_id": "dfc5d3b5-9f60-3b8e-aed8-f7936f96a494",
                                "text": "Des représentations très suggestives montrent un monde romain assez libéré."
                            },
                            {
                                "example_id": "52ed5e5c-0423-4a35-aff0-9830df873882",
                                "sense_id": "dfc5d3b5-9f60-3b8e-aed8-f7936f96a494",
                                "text": "Entretien suggestif."
                            },
                            {
                                "example_id": "54df642c-9b6a-46a8-aeba-3a7065a120dd",
                                "sense_id": "dfc5d3b5-9f60-3b8e-aed8-f7936f96a494",
                                "text": "Ce professeur a un enseignement très suggestif."
                            }
                        ]
                    },
                    {
                        "sense_id": "d659fecc-65eb-3b29-be98-c3dae8a45a99",
