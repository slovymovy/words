                ],
                "senses": [
                    {
                        "sense_id": "dac9c288-6341-334b-86a0-dce81d022e92",
                        "entry_id": "285f3f70-8728-384d-8744-acf9e0c45213",
                        "glosses": [
                            "Synonym of Belleek ware."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7e51828b-4654-418e-bfb6-9e3b8e216039",
                                "sense_id": "dac9c288-6341-334b-86a0-dce81d022e92",
                                "text": "Belleek was invented about thirty-five years ago by a potter named William Henry Goss, of Stoke-upon-Trent, England, whose workmen were induced to go to the porcelain-works established in Belleek, and it was there that the ware was first produced in any considerable quantity."
                            },
                            {
                                "example_id": "53dbf276-f7a0-4f27-a66c-25d6ed626329",
                                "sense_id": "dac9c288-6341-334b-86a0-dce81d022e92",
                                "text": "Belleek was made for both utilitarian and decorative purposes, shaped often in the form of seashells or marine life, such as coral branches."
                            },
                            {
                                "example_id": "52c77b43-471f-4843-a432-56d786208ae3",
                                "sense_id": "dac9c288-6341-334b-86a0-dce81d022e92",
                                "text": "The value of a damaged Belleek can be bleak. Because the porcelain is so thin, even hairline cracks can radically affect the value."
                            }
                        ]
                    }
                ],
