                "senses": [
                    {
                        "sense_id": "956448e2-ba05-3740-a147-eb33f8591421",
                        "entry_id": "12ee565b-6ee8-3473-9042-66e7f5302ed6",
                        "glosses": [
                            "разг. хитрый человек, хитрец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c809f6b-dd89-4c7a-b8e3-f16874002955",
                                "sense_id": "956448e2-ba05-3740-a147-eb33f8591421",
                                "text": "Хватит тебе, Витька, расписывать меня, — обиделся Александр. — Вон сам ты, хитрюга, уже делаешь кронциркули, угольники, нутрометры, мастером опиловки плоскостей и фигурных поверхностей считают тебя."
                            }
                        ]
                    }
                ],
