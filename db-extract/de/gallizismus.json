                ],
                "senses": [
                    {
                        "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                        "entry_id": "189a829b-347f-3f1b-b340-f3cdbfa62f23",
                        "glosses": [
                            "ein Wort oder sonstiger sprachlicher Ausdruck der französischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd45c682-6169-40cc-b057-d54c2845c427",
                                "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                                "text": "„Für die meisten Zeitgenossen etymologisch eher undurchsichtig ist der Gallizismus ‚bongen‘, in dem sich die norddeutsche Aussprachevariante orthographisch durchgesetzt hat (…).“"
                            },
                            {
                                "example_id": "c3f03d4e-8872-40b9-9498-9670400341b8",
                                "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                                "text": "„Während Latinismen und Gräzismen noch immer überwiegend den Wortschätzen in Bildung und Wissenschaft angehören und Gallizismen sich vor allem im Vokabular von Lifestyle und Kulinarik vermehren, finden sich Anglizismen buchstäblich überall, von der Jugendsprache bis zur Informatik, vom Bankeridiom bis zur Werbung.“"
                            },
                            {
                                "example_id": "cfd6ed20-3122-401f-842c-bdb2c43ea494",
                                "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                                "text": "„»Noch eine zweite Strafzahlung für den Gallizismus«, sagte ein russischer Schriftsteller, der auch mit im Salon war.“"
                            },
                            {
                                "example_id": "2312c98a-be5a-410f-b810-a76f148605fb",
                                "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                                "text": "„Ganz Italien schätzt Algarotti, obschon sein Stil mit Gallizismen durchsetzt ist.“"
                            },
                            {
                                "example_id": "8cd307b3-41c5-4532-9aad-db7720cf9f20",
                                "sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
                                "text": "„Bei Gallizismen ist die Integrationsentwicklung zum Stillstand gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
