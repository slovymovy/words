                                "example_id": "e4676a3d-e14f-4d5f-98e5-acabd5093cd9",
                                "sense_id": "42bb0383-8676-39aa-a672-f29feb03ac78",
                                "text": "Une bêchée de terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "93f52192-283b-3987-a15f-356563766311",
                        "entry_id": "13e37091-5031-3280-9697-7ebe4443772b",
                        "glosses": [
                            "Ancienne unité agraire de surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1481ab87-37fc-49f4-bdbf-60d9b4ca4a20",
                                "sense_id": "93f52192-283b-3987-a15f-356563766311",
                                "text": "Les mesures de la terre se référaient pour la plupart à la journée de travail (journal ou morgen) ou au type de labeur (hommée, bêchée, fauchée)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "489fa53a-d73a-41c8-b724-73fe88ea6022",
                        "source_entry_id": "13e37091-5031-3280-9697-7ebe4443772b",
                        "target_lang_word": "Morgen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                        "entry_id": "7eea1f49-9716-34f0-9983-3ea5e825d9e2",
                                        "glosses": [
                                            "Tageszeit zwischen Nacht und Vormittag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f99c5c6-00af-43f4-8ca9-ace336958695",
                                                "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                                "text": "„Das sind doch Brötchen vom gestrigen Morgen!“, beschwerte er sich."
                                            },
                                            {
                                                "example_id": "7db367a2-0b6c-4f1b-a62a-437e6378670e",
                                                "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                                "text": "Da ward aus Abend und Morgen der erste Tag."
                                            },
                                            {
                                                "example_id": "3dcc7649-2bee-4bc5-82f1-ee2630a040e5",
                                                "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                                "text": "Der Morgen ist die schönste Zeit auf dem Land. In der Stadt gibt es keinen Morgen."
                                            },
                                            {
                                                "example_id": "92a5fcfa-849b-44bc-8495-e05e9b4b1836",
                                                "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                                "text": "„[…] dann, am Morgen des 24. Februar 2022, überfielen russische Truppen die Ukraine.“"
                                            },
                                            {
                                                "example_id": "926647e4-6adc-4f5c-9da6-40b318711b8a",
                                                "sense_id": "81f2a9b7-f0ad-33b0-a4bf-bc248cadaae6",
                                                "text": "„Am Morgen vor unserer Abreise trug ich noch einmal den Handkoffer auf das mexikanische Konsulat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3224871-63e6-3130-93c3-ae423af63c4c",
                                        "entry_id": "7eea1f49-9716-34f0-9983-3ea5e825d9e2",
                                        "glosses": [
                                            "Osten"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1f0604-79c0-4932-81da-3fbbf386988a",
                                                "sense_id": "a3224871-63e6-3130-93c3-ae423af63c4c",
                                                "text": "Sie wandten sich gen Morgen."
                                            },
                                            {
                                                "example_id": "970e93aa-6828-455a-b1ec-da08322ca5d0",
                                                "sense_id": "a3224871-63e6-3130-93c3-ae423af63c4c",
                                                "text": "„Bis Ende des Jahres präsentiert die Pariser Galerie Louis Vuitton in der Ausstellung »Métamorphoses« neun Künstler aus dem Land des stillen Morgens.“"
                                            },
                                            {
                                                "example_id": "271962bd-61c6-46c1-b8dd-43bb12945d6e",
                                                "sense_id": "a3224871-63e6-3130-93c3-ae423af63c4c",
                                                "text": "„Der Hof steht am östlichen Ausläufer einer schmalen Geländerippe, die sich in der Ausdehnung einer halben Wegstunde von Abend nach Morgen erstreckt in leichtem Bogen, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2d32a629-1070-3282-aeca-cb7fbf311632",
                                        "entry_id": "7eea1f49-9716-34f0-9983-3ea5e825d9e2",
                                        "glosses": [
                                            "historisches Flächenmaß, variierte je nach Zeitabschnitt und Landstrich in seiner Größe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e95f43-21cf-4d35-87fd-c5998adc965d",
                                                "sense_id": "2d32a629-1070-3282-aeca-cb7fbf311632",
                                                "text": "„Für das Ackergrundstück von drei Morgen ist eine jährliche Pacht von 12 Thaler Courant zu entrichten“, sagte er und zog von dannen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "42596be1-d08d-35a2-b18e-e5417ae42738",
                                        "entry_id": "7eea1f49-9716-34f0-9983-3ea5e825d9e2",
                                        "glosses": [
                                            "die morgendliche Begrüßung „Guten Morgen!“"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e034bb9-b971-4715-840c-c807c9692c16",
                                                "sense_id": "42596be1-d08d-35a2-b18e-e5417ae42738",
                                                "text": "„Morgen!“, sagte sie gedankenverloren, während sie in ihr Büro ging."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Morgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84974194-6869-37eb-b708-6c41424ad1af",
                                        "entry_id": "60c9e80a-81b7-3575-8af9-23d9a7d55ff5",
                                        "glosses": [
                                            "das Zukünftige, Morgige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c6cf61-e528-45da-8d96-a1629ad8c283",
                                                "sense_id": "84974194-6869-37eb-b708-6c41424ad1af",
                                                "text": "Das Morgen wird über das Heute richten. Das Morgen gehört uns ganz allein."
                                            },
                                            {
                                                "example_id": "71cda506-fadf-4aab-86b4-9a743dd8389a",
                                                "sense_id": "84974194-6869-37eb-b708-6c41424ad1af",
                                                "text": "Oft verpassen wir die Blüte, die auf den Nachmittag wartet, im atemlosen Kampf um das Morgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Morgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "928d20f5-8ec7-3c9c-bc88-d6af53343b3a",
                                        "entry_id": "b069d794-95aa-3a69-8dac-9aa15e9436ab",
