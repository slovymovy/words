        "nl-extract.jsonl": [
            {
                "entry_id": "e33a07b9-d40f-3a6e-8e17-d54884ef5d43",
                "word": "dichtnaaien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "edc122cb-aca1-3491-9867-1df863d95a88",
                        "entry_id": "e33a07b9-d40f-3a6e-8e17-d54884ef5d43",
                        "glosses": [
                            "met behulp van naald en draad iets sluiten"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eabd0456-87d7-4c7a-a0ff-88823d7a52e8",
                                "sense_id": "edc122cb-aca1-3491-9867-1df863d95a88",
                                "text": "Ik herinner me van die eerste weken vooral dat ik alles voelde wat ik deed. Het aanbrengen van oogkapjes, het dichtnaaien van de mond, alles voelt aan alsof je het bij jezelf doet. Dat went pas na een tijdje.\""
                            },
                            {
                                "example_id": "7bb78a05-a4dc-4452-9fcb-6b08955636f6",
                                "sense_id": "edc122cb-aca1-3491-9867-1df863d95a88",
                                "text": "Daags voordat de hoofdaanklaagster Alison Saunders door een Kamercommissie zou worden ondervraagd over deze kwestie verklaarde ze dat een gynaecoloog is aangeklaagd wegens het deels dichtnaaien van een vrouwelijk geslachtsorgaan. Tijdens de rechtszaak werd duidelijk dat de arts - geen moslim - dit had gedaan om fatale bloedingen te stoppen bij een pas bevallen patiënte. De vrouw in kwestie was tegen een vervolging en een jury sprak hem binnen mum van tijd vrij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "921638d6-9973-4752-8ad7-6f3c393267be",
                        "source_entry_id": "e33a07b9-d40f-3a6e-8e17-d54884ef5d43",
                        "source_sense_id": "edc122cb-aca1-3491-9867-1df863d95a88",
                        "source_sense_description": "met behulp van naald en draad iets sluiten",
                        "target_lang_word": "suture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3280b8a9-5793-3ae0-a898-9f8868bf0824",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "A seam formed by sewing two edges together, especially to join pieces of skin in surgically treating a wound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e364cd84-38cc-48fb-add0-82b38fb06ec3",
                                                "sense_id": "3280b8a9-5793-3ae0-a898-9f8868bf0824",
                                                "text": "Although the sutures are difficult to trace, the supraoccipital contacts the parietal anteriorly at a tight interdigitated suture, and contacts the ophistotic posterolaterally at a straight suture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d19e90a-96b8-3d0e-84ef-df8c62b85324",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "Thread used to sew or stitch two edges (especially of skin) together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12aad2cc-b933-3e05-8a9b-f1bd1fd59d3d",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "An area where separate terrane join together along a major fault."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b15db02a-05e4-3976-b5c3-e2f76d96080c",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "A type of fibrous joint bound together by Sharpey's fibres which only occurs in the skull."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d3fac44-ebfe-3cad-8b82-f896046cfe19",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "A seam or line, such as that between the segments of a crustacean, between the whorls of a univalve shell, or where the elytra of a beetle meet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e36180bb-f950-383d-bde9-0785428caecb",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "The seam at the union of two margins in a plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a59613d-dcc8-4a08-b6db-5faf7fc2dcf3",
                                                "sense_id": "e36180bb-f950-383d-bde9-0785428caecb",
                                                "text": "It is also generally marked above by flexuose anastomosing black, indented lines, whence it appears as if insculpt with rivulose sutures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146cd489-bc36-3b74-84ac-494cd5dab6ad",
                                        "entry_id": "92d1995a-28ab-3a1d-95d7-631c192302b5",
                                        "glosses": [
                                            "The procedure by which a subject comes to be identified with its own representation, as in the identification of the speaker with the sign “I” within a certain discourse; (by extension) any process by which the content of something is determined or supplied from outside itself."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4539ba3-067b-4606-a8f2-ba4e559fd1be",
                                                "sense_id": "146cd489-bc36-3b74-84ac-494cd5dab6ad",
                                                "text": "The suture of science and philosophy constitutes an identification of philosophical thought and scientific objectivity that is unfortunately typical of contemporary so-called ‘analytic’ philosophy. […] Yet, the over-identification of philosophical tasks with science itself signifies a veritable retreat from philosophy itself."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf996321-ee9b-3a23-b9b9-314d01050ca9",
                                        "entry_id": "ed100bac-1783-3fdb-bb69-1e6e6b4f3bd9",
                                        "glosses": [
                                            "To sew up or join by means of a suture."
                                        ],
