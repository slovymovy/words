                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enregistreur de vol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b84fa57-08fa-39d0-acfa-b2651b3f2913",
                                        "entry_id": "690c6bb4-d2ce-33ff-98b3-972fc1a0ab22",
                                        "glosses": [
                                            "Appareil enregistrant automatiquement des éléments sonores ou des paramètres du vol d’un aéronef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b6aa9a-0917-4bc6-b843-39e2327a3141",
                                                "sense_id": "0b84fa57-08fa-39d0-acfa-b2651b3f2913",
                                                "text": "Cependant, l’enregistreur de vol démontre que les commandes de l’avion n’étaient plus entre les mains des pilotes mais émanaient d’une source extérieure à l’avion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5149b72-ec22-46a8-9f3b-587256447d06",
                        "source_entry_id": "0e66b584-516c-3a7b-8339-62808d1b2d21",
                        "source_sense_id": "ee7ef420-d107-3436-a415-12e781fefa35",
                        "target_lang_word": "boite noire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boite noire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59d71516-3ea6-3e96-a2e6-6369240da63e",
                                        "entry_id": "6829e2d1-170d-3d9c-b222-afa4e0a24db6",
                                        "glosses": [
                                            "Système (objet mécanique ou électronique, organisme, personne, mode d’organisation sociale, etc.) dont le fonctionnement interne est soit inaccessible, soit omis délibérément : on ne peut étudier que ses interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f8e039-786c-4b8c-aca5-074baa4ce968",
                                                "sense_id": "59d71516-3ea6-3e96-a2e6-6369240da63e",
                                                "text": "Pour beaucoup de monde, le système carcéral reste une boite noire. — (http://fr.1001mags.com/parution/horizons/numero-83-dec-09-jan-fev-2010/page-30-31-texte-integral)"
                                            },
                                            {
                                                "example_id": "8ac6ebc1-8e46-4d69-b856-076d01bf1318",
                                                "sense_id": "59d71516-3ea6-3e96-a2e6-6369240da63e",
                                                "text": "Le contraire d’une boite noire, dit boite blanche, par exemple une bicyclette, est un système dont les mécanismes sont visibles au premier coup d’œil et permettent d’en comprendre le fonctionnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2fa0cca-8178-31f3-b091-f0aa26cab2d4",
                                        "entry_id": "6829e2d1-170d-3d9c-b222-afa4e0a24db6",
                                        "glosses": [
                                            "Enregistreur des données d’un vol ou des conversations du cockpit."
                                        ],
                                        "tags": [],
                                        "examples": []
