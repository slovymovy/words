{
    "word_family": [
        "classicisme",
        "classiciste"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c28e34c3-8d93-332f-b327-3110f0782842",
                    "sense_definition": "Qui est sobre, traditionnel et sans extravagance dans son style ou son apparence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il porte toujours un costume <w>classique</w> pour aller au bureau."
                        },
                        {
                            "text": "Cette robe a une coupe très <w>classique</w> et élégante."
                        }
                    ],
                    "common_phrases": [
                        "style classique"
                    ]
                },
                {
                    "sense_id": "22cfe97f-a750-3006-9b50-1fb5ec911bb4",
                    "sense_definition": "Relatif à la musique savante occidentale par opposition à la musique populaire, ou à la danse académique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle écoute souvent de la musique <w>classique</w> pour se détendre le soir."
                        },
                        {
                            "text": "Ma fille prend des cours de danse <w>classique</w> depuis plusieurs années."
                        }
                    ],
                    "antonyms": [
                        "contemporain"
                    ],
                    "common_phrases": [
                        "danse classique",
                        "musique classique"
                    ]
                },
                {
                    "sense_id": "4d259515-56dc-3665-b003-ecfa2ab3b0b9",
                    "sense_definition": "Qui est habituel, ordinaire ou prévisible dans une situation donnée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ordinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une erreur <w>classique</w> chez les débutants en programmation."
                        },
                        {
                            "text": "Arriver en retard à cause des embouteillages est une excuse <w>classique</w>."
                        }
                    ],
                    "common_phrases": [
                        "coup classique",
                        "erreur classique"
                    ]
                },
                {
                    "sense_id": "08f3b00c-a804-330c-9d76-cf727fe966aa",
                    "sense_definition": "Qui a rapport à l'Antiquité grecque et romaine ou à leurs langues et cultures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il étudie les langues <w>classiques</w> comme le latin et le grec ancien."
                        },
                        {
                            "text": "L'Antiquité <w>classique</w> a profondément influencé la pensée politique européenne."
                        }
                    ],
                    "common_phrases": [
                        "Antiquité classique",
                        "langues classiques"
                    ]
                },
                {
                    "sense_id": "37fec927-7643-34e9-81bf-aee871816951",
                    "sense_definition": "Qui relève du classicisme, mouvement artistique fondé sur l'ordre, l'équilibre et l'harmonie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecture <w>classique</w> privilégie la symétrie et les lignes droites."
                        },
                        {
                            "text": "On oppose souvent la tragédie <w>classique</w> au drame romantique."
                        }
                    ],
                    "antonyms": [
                        "baroque"
                    ],
                    "common_phrases": [
                        "théâtre classique"
                    ]
                }
            ]
        },
        {
