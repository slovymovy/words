{
    "word_family": [
        "beat"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5e26203-d2c0-3483-9f45-c0a06f85d751",
                    "sense_definition": "Having a positive, lively, or perky tone or attitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "positive_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sounded <w>upbeat</w> when I talked to him on the phone.",
                            "target_lang_translations": {
                                "ru": "Он звучал <w>бодро</w>, когда я говорил с ним по телефону."
                            }
                        },
                        {
                            "text": "She gave an <w>upbeat</w> speech about the future of the company.",
                            "target_lang_translations": {
                                "ru": "Она выступила с <w>оптимистичной</w> речью о будущем компании."
                            }
                        }
                    ],
                    "antonyms": [
                        "downbeat"
                    ],
                    "common_phrases": [
                        "remain upbeat",
                        "stay upbeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий позитивным, оживленным или бодрым настроением или отношением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "о человеке или настроении, полном оптимизма и радости"
                            },
                            {
                                "target_lang_word": "бодрый",
                                "target_lang_sense_clarification": "о человеке или тоне, выражающем энергию и уверенность"
                            },
                            {
                                "target_lang_word": "оптимистичный",
                                "target_lang_sense_clarification": "выражающий уверенность в благоприятном исходе"
                            }
                        ]
                    },
                    "synonyms": [
                        "positive",
                        "cheerful",
                        "optimistic"
                    ]
                },
                {
                    "sense_id": "5a49a3e0-3396-3a7e-9e4c-f203780f5fa3",
                    "sense_definition": "Having a fast pace, tempo, or beat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_tempo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played an <w>upbeat</w> song that made everyone want to dance.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>быструю</w> песню, под которую всем захотелось танцевать."
                            }
                        },
                        {
                            "text": "It is an <w>upbeat</w> tune and should be played fairly quickly.",
                            "target_lang_translations": {
                                "ru": "Это <w>энергичная</w> мелодия, и её следует играть довольно быстро."
                            }
                        }
                    ],
                    "antonyms": [
                        "downbeat"
                    ],
                    "common_phrases": [
                        "upbeat music",
                        "upbeat tempo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий быстрый темп, ритм или музыкальный размер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "о темпе или ритме музыкального произведения"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "о музыке с активным, живым ритмом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "103fb9a9-79ce-3bae-b552-8c32fdce40c4",
                    "sense_definition": "An unaccented beat at the start of a musical phrase.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_tempo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor said to come in on the <w>upbeat</w>.",
                            "target_lang_translations": {
                                "ru": "Дирижер сказал вступать на <w>затакт</w>."
                            }
                        },
                        {
                            "text": "The melody begins with a short <w>upbeat</w> before the first full measure.",
                            "target_lang_translations": {
                                "ru": "Мелодия начинается с короткого <w>затакта</w> перед первым полным тактом."
                            }
                        }
                    ],
                    "synonyms": [
                        "unaccented beat",
                        "anticipatory note",
                        "anticipatory",
                        "unstressed note",
                        "unstressed",
                        "anacrusis",
                        "pickup"
                    ],
                    "antonyms": [
                        "downbeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неакцентированная доля в начале музыкальной фразы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затакт",
                                "target_lang_sense_clarification": "музыкальный термин для обозначения неполного такта в начале фразы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}