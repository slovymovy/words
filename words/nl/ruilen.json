                    "sense_definition": "het geven van iets en daarvoor in de plaats iets anders terugkrijgen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "uitwisseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil mijn sandwich <w>ruilen</w> voor jouw appeltaart.",
                            "target_lang_translations": {
                                "en": "I want to <w>exchange</w> my sandwich for your apple pie."
                            }
                        },
                        {
                            "text": "Kunnen we een dag van auto <w>ruilen</w>?",
                            "target_lang_translations": {
                                "en": "Can we <w>swap</w> cars for a day?"
                            }
                        }
                    ],
                    "synonyms": [
                        "verwisselen"
                    ],
                    "common_phrases": [
                        "van auto ruilen",
                        "ruilen voor"
                    ],
                    "target_lang_definitions": {
