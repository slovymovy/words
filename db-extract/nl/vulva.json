                                "example_id": "b50635b3-a753-478b-b5ce-e79b6babf4b0",
                                "sense_id": "b8c376db-1681-3848-9755-cd3eda289b12",
                                "text": "Ze ging gisteren naar de dokter vanwege haar vulva."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc522d85-eaf5-4090-969d-5203901c3606",
                        "source_entry_id": "a1bbbe92-06b2-324b-b9f7-b29e21693ab7",
                        "source_sense_id": "b8c376db-1681-3848-9755-cd3eda289b12",
                        "source_sense_description": "de schaamspleet, de ingang tot de vagina",
                        "target_lang_word": "Vulva",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulva",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9c1004-30e7-3eb5-9dd2-429fcdb8c4ed",
                                        "entry_id": "89c73994-1926-30bf-8cfc-abd5bb338d40",
                                        "glosses": [
                                            "die äußeren weiblichen Geschlechtsorgane bei Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88916a3-51e9-4de9-a8d6-2f1839adea69",
                                                "sense_id": "5d9c1004-30e7-3eb5-9dd2-429fcdb8c4ed",
                                                "text": "Vulva ist kein Begriff der Alltagssprache."
                                            },
                                            {
                                                "example_id": "b3ae393a-c211-4a09-97ae-bfd6b06b78b6",
                                                "sense_id": "5d9c1004-30e7-3eb5-9dd2-429fcdb8c4ed",
                                                "text": "„Man spürt es, und es ist, als gehörte diese Vulva zu einer Fauna aus einer anderen Welt, als wäre sie etwas, das im Meer zu Hause ist.“"
                                            },
                                            {
                                                "example_id": "65a9ac47-6a92-487c-8d1e-a052805ecafd",
                                                "sense_id": "5d9c1004-30e7-3eb5-9dd2-429fcdb8c4ed",
                                                "text": "„Schließlich erkennt sie, dass sich ihre Vulva verändert, die inneren Lippen sich zurückgebildet haben und fast verschwunden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5168cea6-e5a5-41ec-8a3f-d2ac792330d5",
                        "source_entry_id": "a1bbbe92-06b2-324b-b9f7-b29e21693ab7",
                        "source_sense_id": "b8c376db-1681-3848-9755-cd3eda289b12",
                        "source_sense_description": "de schaamspleet, de ingang tot de vagina",
                        "target_lang_word": "vulva",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5d5cf0-8059-3aac-a368-1acecc99df94",
                                        "entry_id": "afa3d82c-5d81-3dbb-bcfa-d48b56241482",
                                        "glosses": [
                                            "The external female genitalia of humans and other placental mammals, which includes the clitoris, labia, and vulval vestibule/vulvar opening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393b3c20-7f4f-4e96-a96f-9e43bb5a9bb1",
                                                "sense_id": "2c5d5cf0-8059-3aac-a368-1acecc99df94",
                                                "text": "The vulvae of the sow were popular as a gourmet's dish. Credited with erotic effects."
                                            },
                                            {
                                                "example_id": "f5142bb8-934b-4f7b-ba44-56878165f178",
                                                "sense_id": "2c5d5cf0-8059-3aac-a368-1acecc99df94",
                                                "text": "The wedge-shaped character was the triangle, the archaic Paleolithic sign of the vulva; the pubic triangle was at the end of the phallic stylus."
                                            },
                                            {
                                                "example_id": "1d15155e-54cd-4f9c-8ba7-528cf90df6c9",
                                                "sense_id": "2c5d5cf0-8059-3aac-a368-1acecc99df94",
                                                "text": "Many of the less-sophisticated works are sexual in nature. Among the most common images are stylised vulvas, whole flocks of which appear on some cave walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b4673b2-8113-322c-b886-270ee6f48318",
                                        "entry_id": "afa3d82c-5d81-3dbb-bcfa-d48b56241482",
                                        "glosses": [
                                            "A protrusion on the side of a nematode."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b5d43d1-44ee-4b85-9496-a3bfab21a484",
                        "source_entry_id": "a1bbbe92-06b2-324b-b9f7-b29e21693ab7",
                        "source_sense_id": "b8c376db-1681-3848-9755-cd3eda289b12",
                        "source_sense_description": "de schaamspleet, de ingang tot de vagina",
                        "target_lang_word": "vulve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "668e50fc-7780-3798-a37c-e7d51c704a99",
                                        "entry_id": "7e5d2ee4-f7d9-3306-a11d-fcb33d173e5c",
                                        "glosses": [
                                            "Ensemble des organes génitaux externes des filles et des femmes et de certaines femelles de mammifères, constitué principalement des grandes lèvres et des petites lèvres enserrant l’entrée du vagin, du clitoris et du méat urinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386c60d4-33f6-48ed-9561-e478fc919d87",
                                                "sense_id": "668e50fc-7780-3798-a37c-e7d51c704a99",
                                                "text": "Si l’anus est trop en avant, la partie supérieure de la vulve bascule horizontalement sur le bassin. Ce défaut de conformation ou le manque de tonus des lèvres vulvaires favorisent la pénétration permanente d'air dans le vagin (pneumovagin) entraînant vaginites (inflammation du vagin) et endométrites (inflammation de l'utérus)."
                                            },
                                            {
                                                "example_id": "7f3dd966-e676-4d8f-a706-a624f1607cf0",
                                                "sense_id": "668e50fc-7780-3798-a37c-e7d51c704a99",
                                                "text": "L’appareil génital féminin comprend la vulve, le vagin, l’utérus, les trompes de Fallope et les ovaires."
                                            },
                                            {
                                                "example_id": "a0b222b4-98d9-4be3-bfdf-51874c560e86",
                                                "sense_id": "668e50fc-7780-3798-a37c-e7d51c704a99",
                                                "text": "Les mots nehep ou nek, qui signifient « s’accoupler », « faire l’amour » se terminent par le hiéroglyphe du phallus éjaculant ou par celui du phallus pénétrant dans la vulve d’une femme."
                                            },
                                            {
                                                "example_id": "e9245aac-5db9-45ee-b8c3-7e5f740a56ff",
                                                "sense_id": "668e50fc-7780-3798-a37c-e7d51c704a99",
                                                "text": "Abîme où, loin des cieux aventurant son aile,\nL’Ange vit la beauté de la femme et l’aima,\nOù le fruit qu’un divin adultère forma,\nL’homme géant, brisa la vulve maternelle,\nTon spectre emplit les yeux du Voyant Thogorma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60922b07-057a-4fcc-ab1b-0de068e92a7a",
                        "source_entry_id": "a1bbbe92-06b2-324b-b9f7-b29e21693ab7",
