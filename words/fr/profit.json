                    "frequency": "High",
                    "semantic_group_id": "gain_financier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant a réalisé un bon <w>profit</w> en vendant ses produits au marché local."
                        },
                        {
                            "text": "Cette vente exceptionnelle a permis de générer des <w>profits</w> considérables pour l'artisan."
                        }
                    ],
                    "synonyms": [
