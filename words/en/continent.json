                {
                    "sense_id": "4f8d9f01-4b63-394b-9d69-7b62e065ec3e",
                    "sense_definition": "One of the very large areas of land on Earth, such as Africa, Asia, or South America.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography_landmass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Antarctica is the coldest <w>continent</w> on Earth.",
                            "target_lang_translations": {
                                "ru": "Антарктида — самый холодный <w>континент</w> на Земле.",
                                "tr": "Antarktika Dünya'daki en soğuk <w>kıtadır</w>."
                            }
                        },
                        {
                            "text": "She has traveled to every <w>continent</w> except Australia.",
                            "target_lang_translations": {
                                "ru": "Она побывала на каждом <w>континенте</w>, кроме Австралии.",
                                "tr": "Avustralya hariç her <w>kıtaya</w> seyahat etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "landmass"
                    ],
                    "common_phrases": [
                        "African continent",
                        "European continent",
                        "on the continent"
                    ],
                    "target_lang_definitions": {
