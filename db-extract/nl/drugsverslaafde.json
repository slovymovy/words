                                        "glosses": [
                                            "Mensch, der abhängig von Drogen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3307a1e-2a76-4859-b88d-a5677853abc5",
                                                "sense_id": "0e9bf53a-82fe-301c-a514-d9cd9ffbc49a",
                                                "text": "Um den Bahnhof herum leben viele Drogenabhängige."
                                            },
                                            {
                                                "example_id": "387608ec-2dd7-41dd-ad42-5c96a983de95",
                                                "sense_id": "0e9bf53a-82fe-301c-a514-d9cd9ffbc49a",
                                                "text": "„Ursprünglich wurde das Konzept der Recovery in der Therapie Drogenabhängiger angewendet.“"
                                            },
                                            {
                                                "example_id": "09c5b7ea-8bb4-408a-90a2-8e69a998d1e1",
                                                "sense_id": "0e9bf53a-82fe-301c-a514-d9cd9ffbc49a",
                                                "text": "„In der Konsequenz hieß das, dass Drogenabhängige lediglich eine Akutbehandlung im Sinne der Notfallmedizin erhielten.“"
                                            },
                                            {
                                                "example_id": "869c5281-810a-4fdc-9e28-c24d9c1adebb",
                                                "sense_id": "0e9bf53a-82fe-301c-a514-d9cd9ffbc49a",
                                                "text": "„Empfänger seiner Mitteilung ist Johannes Kagelmacher, Bauer aus Guderitz auf Rügen, bei dem er in seiner Zeit als Drogenabhängiger oft untergekrochen ist.“"
                                            }
                                        ],
