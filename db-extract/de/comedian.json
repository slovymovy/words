                "senses": [
                    {
                        "sense_id": "73fd59c4-3e5d-3fbe-b474-93642496401c",
                        "entry_id": "f2f82243-a73e-3c81-bbae-2c0f3fffe9c4",
                        "glosses": [
                            "Kleinkünstler, der humoristische Darbietungen präsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acdc6c6e-3497-460a-8586-def23d7344dd",
                                "sense_id": "73fd59c4-3e5d-3fbe-b474-93642496401c",
                                "text": "Heute sind Comedians im TV allgegenwärtig."
                            },
                            {
                                "example_id": "6c2fc4bd-472e-4c6a-8695-465a80e7bc7a",
                                "sense_id": "73fd59c4-3e5d-3fbe-b474-93642496401c",
                                "text": "„Ich gab den Comedian für sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae537512-0175-49a1-b6a4-74febf075ccb",
                        "source_entry_id": "f2f82243-a73e-3c81-bbae-2c0f3fffe9c4",
                        "source_sense_id": "73fd59c4-3e5d-3fbe-b474-93642496401c",
                        "source_sense_description": "Kleinkünstler, der humoristische Darbietungen präsentiert",
                        "target_lang_word": "comedian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16fb684d-c7e8-3b5e-b821-83c482b0013c",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "An entertainer who performs in a humorous manner, especially by telling jokes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42928892-85da-3a78-adfe-1cf5f01fdb7a",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "Any person who is humorous or amusing, either characteristically or on a particular occasion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "A person who performs in theatrical plays."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c90027-bade-4e2d-a51e-56630a7268c1",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "[…] the quick comedians\nExtemporally will stage us, and present\nOur Alexandrian revels;"
                                            },
                                            {
                                                "example_id": "0ac4201d-cbc1-42e7-a5a5-49be9ea6cfaa",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "1714, Susanna Centlivre, The Wonder, London: E. Curll and A. Bettesworth, Preface,\nI Don’t pretend to write a Preface, either to point out the Beauties, or to excuse the Errors, a judicious Reader may possibly discover in the following Scenes, but to give those excellent Comedians their Due, to whom, in some Measure the best Dramatick Writers are oblig’d."
                                            },
                                            {
                                                "example_id": "2d42fd73-6812-4fa0-8d31-4ed95dd4afda",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "When a Comedian, celebrated for his excellence in the part of Shylock, first undertook that character, he made daily visits to the center of business, the ’Change, and the adjacent Coffee-houses; that by a frequent intercourse and conversation with “the unforeskinn’d race,” he might habituate himself to their air and deportment."
                                            },
                                            {
                                                "example_id": "6f7fad39-43f0-45bf-98c2-ddfe4e968179",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "Becky, the nightingale, took the flowers which he threw to her and pressed them to her heart with the air of a consummate comedian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "A writer of comedies."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d8a01d3-a63c-4a66-99c0-19b69f773126",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "This doth the Comedy handle ſo in our priuate and domeſtical matters, as with hearing it, we get as it were an experience, what is to be looked for of a nigardly Demea: of a crafty Danus: of a flattering Gnato: of a vaine glorious Thraſo: and not onely to know what effects are to be expected, but to know who be ſuch, by the ſignifying badge giuen them by the Comedian."
                                            },
                                            {
                                                "example_id": "8225d852-27c0-477a-8fef-2b751b71ddba",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "Neither is it recorded that the writings of those old Comedians were supprest, though the acting of them were forbid;"
                                            },
                                            {
                                                "example_id": "6bfc70eb-e262-4146-9829-2f1b248789ee",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "1783, Hugh Blair, Lectures on Rhetoric and Belles Lettres, London: Whitestone et al., Volume 3, Lecture 47, p. 377,\n[…] the Dramatic Author, in whom the French glory most, and whom they justly place at the head of all their Comedians, is, the famous Moliere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
