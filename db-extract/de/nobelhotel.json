                        "examples": [
                            {
                                "example_id": "8ae09d7a-a874-44ea-bffe-3136bd689efa",
                                "sense_id": "707036d8-fade-305d-87de-6be8692df9b9",
                                "text": "„Laut der Bezirkshauptmannschaft Klagenfurt-Land sind in dem Nobelhotel Noroviren festgestellt worden, vier Mitarbeiter und auch zwei Gäste sind an dem Virus erkrankt.“"
                            },
                            {
                                "example_id": "53ce13bb-420e-4a69-aa7c-c675ed4aa310",
                                "sense_id": "707036d8-fade-305d-87de-6be8692df9b9",
                                "text": "„Manchmal werden die schlimmsten Träume wahr: Schauspielerin Jessica Schwarz hat in einem Nobelhotel den peinlichsten Moment ihres Lebens erlebt.“"
                            }
                        ],
