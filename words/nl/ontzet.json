{
    "word_family": [
        "ontzetting",
        "ontzetbaar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa85df70-af17-35b5-9742-2ba7aada0904",
                    "sense_definition": "heel erg van streek zijn na een grote schok of nare gebeurtenis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ontzette</w> dochter kwam bij haar moeder uithuilen na het ongeluk.",
                            "target_lang_translations": {
                                "en": "The <w>distraught</w> daughter came to cry with her mother after the accident.",
                                "ru": "<w>Потрясенная</w> дочь пришла выплакаться к матери после аварии."
                            }
                        },
                        {
                            "text": "Iedereen was totaal <w>ontzet</w> over het nieuws van de plotselinge sluiting.",
                            "target_lang_translations": {
                                "en": "Everyone was totally <w>appalled</w> by the news of the sudden closure.",
                                "ru": "Все были в полном <w>ужасе</w> от новостей о внезапном закрытии."
                            }
                        }
                    ],
                    "synonyms": [
                        "onthutst"
                    ],
                    "common_phrases": [
                        "totaal ontzet",
                        "ontzet reageren"
                    ],
                    "target_lang_definitions": {
                        "en": "Being very upset or shocked after a major shock or unpleasant event.",
                        "ru": "быть крайне расстроенным или потрясенным после сильного шока или неприятного события"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appalled",
                                "target_lang_sense_clarification": "feeling shock or horror"
                            },
                            {
                                "target_lang_word": "dismayed",
                                "target_lang_sense_clarification": "feeling distress or disappointment"
                            },
                            {
                                "target_lang_word": "aghast",
                                "target_lang_sense_clarification": "filled with horror or shock"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "потрясенный",
                                "target_lang_sense_clarification": "сильно шокированный"
                            },
                            {
                                "target_lang_word": "в ужасе",
                                "target_lang_sense_clarification": "крайне испуганный или возмущенный"
                            },
                            {
                                "target_lang_word": "обескураженный",
                                "target_lang_sense_clarification": "сбитый с толку и расстроенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5add468a-ce60-3851-81f3-3dc0c9ada16f",
                    "sense_definition": "uit de juiste vorm of het verband gerukt zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de harde klap was het hele kozijn volledig <w>ontzet</w>.",
                            "target_lang_translations": {
                                "en": "Due to the hard blow, the entire window frame was completely <w>warped</w>.",
                                "ru": "Из-за сильного удара вся оконная рама была полностью <w>перекошена</w>."
                            }
                        },
                        {
                            "text": "De deur klemt omdat de scharnieren door de hitte <w>ontzet</w> zijn.",
                            "target_lang_translations": {
                                "en": "The door is sticking because the hinges have been <w>displaced</w> by the heat.",
                                "ru": "Дверь заедает, потому что петли <w>сместились</w> из-за жары."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volledig ontzet"
                    ],
                    "target_lang_definitions": {
                        "en": "Being forced out of its proper shape, alignment, or connection.",
                        "ru": "вырванный из правильной формы или смещенный со своего места"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "warped",
                                "target_lang_sense_clarification": "bent or twisted out of shape"
                            },
                            {
                                "target_lang_word": "displaced",
                                "target_lang_sense_clarification": "moved out of its correct position"
                            },
                            {
                                "target_lang_word": "buckled",
                                "target_lang_sense_clarification": "bent under pressure"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перекошенный",
                                "target_lang_sense_clarification": "о конструкции или раме"
                            },
                            {
                                "target_lang_word": "смещенный",
                                "target_lang_sense_clarification": "сдвинутый с места"
                            },
                            {
                                "target_lang_word": "деформированный",
                                "target_lang_sense_clarification": "потерявший форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e9f1458-f6eb-34dd-acfc-88a24480544b",
                    "sense_definition": "de bevrijding van een belegerde stad door een leger van buitenaf",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Leiden vieren ze elk jaar op drie oktober het <w>ontzet</w> van de stad.",
                            "target_lang_translations": {
                                "en": "In Leiden, they celebrate the <w>relief</w> of the city every year on the third of October.",
                                "ru": "В Лейдене каждый год третьего октября празднуют <w>снятие осады</w> города."
                            }
                        },
                        {
                            "text": "Het leger slaagde er eindelijk in om het <w>ontzet</w> van de burcht te voltooien.",
                            "target_lang_translations": {
                                "en": "The army finally succeeded in completing the <w>liberation</w> of the fortress.",
                                "ru": "Армии наконец удалось завершить <w>освобождение</w> крепости."
                            }
                        }
                    ],
                    "synonyms": [
                        "onthutst"
                    ],
                    "common_phrases": [
                        "Leids ontzet",
                        "het ontzet vieren"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vaak gebruikt in historische context in Nederland"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The liberation of a besieged city by an army from the outside.",
                        "ru": "освобождение осажденного города армией извне"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relief",
                                "target_lang_sense_clarification": "the act of breaking a siege"
                            },
                            {
                                "target_lang_word": "liberation",
                                "target_lang_sense_clarification": "setting free from enemy control"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "снятие осады",
                                "target_lang_sense_clarification": "военное действие"
                            },
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "города от осады"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3525dce-d8a4-3a15-b575-e4d2cf3c86ca",
                    "sense_definition": "voltooid deelwoord van <w>ontzetten</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester is uit zijn ambt <w>ontzet</w> na het schandaal.",
                            "target_lang_translations": {
                                "en": "The mayor was <w>removed</w> from office after the scandal.",
                                "ru": "Мэр был <w>отстранен</w> от своей должности после скандала."
                            }
                        },
                        {
                            "text": "De troepen hebben de stad na maanden van honger eindelijk <w>ontzet</w>.",
                            "target_lang_translations": {
                                "en": "The troops finally <w>relieved</w> the city after months of hunger.",
                                "ru": "Войска наконец <w>освободили</w> город после месяцев голода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uit ambt ontzet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'ontzetten', meaning to remove from office or to relieve a siege.",
                        "ru": "причастие прошедшего времени от глагола «освобождать» или «отстранять»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "removed",
                                "target_lang_sense_clarification": "taken out of a position or office"
                            },
                            {
                                "target_lang_word": "relieved",
                                "target_lang_sense_clarification": "freed from a siege"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отстраненный",
                                "target_lang_sense_clarification": "от должности"
                            },
                            {
                                "target_lang_word": "освобожденный",
                                "target_lang_sense_clarification": "от осады"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93d30a77-af0a-3e85-8c5f-7654418e5f63",
                    "sense_definition": "enkelvoud tegenwoordige tijd van <w>ontzetten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>ontzet</w> de gevangenen uit hun benarde positie.",
                            "target_lang_translations": {
                                "en": "He <w>rescues</w> the prisoners from their precarious position.",
                                "ru": "Он <w>вызволяет</w> пленников из их бедственного положения."
                            }
                        },
                        {
                            "text": "De rechter <w>ontzet</w> de verdachte uit de ouderlijke macht.",
                            "target_lang_translations": {
                                "en": "The judge <w>strips</w> the suspect of parental authority.",
                                "ru": "Судья <w>лишает</w> подозреваемого родительских прав."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present tense singular of 'ontzetten', meaning to remove from power or to rescue.",
                        "ru": "форма настоящего времени глагола «освобождать» или «лишать»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "removes",
                                "target_lang_sense_clarification": "strips someone of a right or position"
                            },
                            {
                                "target_lang_word": "rescues",
                                "target_lang_sense_clarification": "sets free from a difficult situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "освобождает",
                                "target_lang_sense_clarification": "из плена или от осады"
                            },
                            {
                                "target_lang_word": "лишает",
                                "target_lang_sense_clarification": "прав или полномочий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803d86f9-ec47-39ff-8483-0b10da8ad80c",
                    "sense_definition": "gebiedende wijs van <w>ontzetten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ontzet</w> de stad voordat de vijand de muren doorbreekt!",
                            "target_lang_translations": {
                                "en": "<w>Relieve</w> the city before the enemy breaks through the walls!",
                                "ru": "<w>Освободите</w> город, пока враг не проломил стены!"
                            }
                        },
                        {
                            "text": "<w>Ontzet</w> hem onmiddellijk uit zijn functie als hij de regels overtreedt.",
                            "target_lang_translations": {
                                "en": "<w>Remove</w> him from his position immediately if he breaks the rules.",
                                "ru": "Немедленно <w>отстраните</w> его от должности, если он нарушит правила."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'ontzetten', used to command the relief of a city or removal from office.",
                        "ru": "повелительное наклонение глагола «освобождать» или «отстранять»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "command to break a siege"
                            },
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "command to strip someone of their post"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "освободи",
                                "target_lang_sense_clarification": "город или людей"
                            },
                            {
                                "target_lang_word": "отстрани",
                                "target_lang_sense_clarification": "от должности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}