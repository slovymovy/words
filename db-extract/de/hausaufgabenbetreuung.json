                ],
                "senses": [
                    {
                        "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                        "entry_id": "fc9a9a8e-44c1-3190-ad81-8e19d50d1379",
                        "glosses": [
                            "Angebot zur Unterstützung von Schülern bei der Erledigung von Hausaufgaben (meist nach der Schule)"
                        ],
                        "tags": [
                            "Schule"
                        ],
                        "examples": [
                            {
                                "example_id": "801b67aa-70b8-4135-ac98-8513a790b311",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Neben Hausaufgabenbetreuung und Nachhilfe wird gemeinsam gekocht und zu Abend gegessen.“"
                            },
                            {
                                "example_id": "641e91f5-e114-4f30-ae8a-8faebfaf1c7b",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Das Land NRW rechnet damit, dass ab 2026 etwa 80 Prozent aller Grundschulkinder eine Nachmittagsbetreuung in Anspruch nehmen werden. Für all diese Kinder hoffe ich, dass sie dann eine gute Hausaufgabenbetreuung haben werden. Damit alle die gleichen Chancen haben.“"
                            },
                            {
                                "example_id": "a2b4e0c9-c9b9-4395-b0d7-58c7595117d9",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "Oft wird eine Hausaufgabenbetreuung nicht von ausgebildeten Lehrkräften, sondern von Hilfskräften, Ehrenamtlichen oder Schülern/Schülerinnen durchgeführt."
                            },
                            {
                                "example_id": "cb68519e-a307-41b9-bf33-32b3b54de93d",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "Bildungsexperten und Bildungsexpertinnen hinterfragen regelmäßig, ob Hausaufgaben überhaupt sinnvoll oder gerecht sind, wenn eine Hausaufgabenbetreuung nötig ist, um die Hausaufgaben erledigen zu können."
                            },
                            {
                                "example_id": "b8d016d5-f7d9-42c0-8707-dbaaf76641f6",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "Kinder verbringen schon einen großen Teil des Tages in der Schule, durch Hausaufgabenbetreuung kann der Tag noch länger und anstrengender werden."
                            },
                            {
                                "example_id": "8207e099-542f-4f25-b3ca-927ea5877481",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„15 Kinder hat sie schon zu betreuen, aber das Haus könne für über 50 Kinder Platz bieten. Dafür werden auch noch weitere Ehrenamtliche gesucht, die bei der Hausaufgabenbetreuung, Spielplatz-Ausflügen oder in der Kreativwerkstatt mithelfen.“"
                            },
                            {
                                "example_id": "92c559cb-682a-4eda-87bf-081b41477be2",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Die pädagogische Qualität der Angebote, von Hausaufgabenbetreuung bis zur individuellen Unterstützung etwa bei Lese- und Rechenkompetenz bezweifelt auch Torsten Bärwald. Auch sein Sohn besucht eine Berliner Grundschule mit Ganztagsangebot.“"
                            },
                            {
                                "example_id": "c0fb1133-5b4d-4d14-9d86-563138c8c2ff",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Auch Berna muss sparen. Die Verkäuferin ist alleinerziehend. Ihren Sohn hat sie gerade bei der Hausaufgabenbetreuung abgemeldet, weil das Geld dafür fehlt.“"
                            },
                            {
                                "example_id": "b8d79590-61ee-4d02-9ace-0b4a9c34d779",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Die IKS bietet ihren Schülern die Möglichkeit, ihre Hausaufgaben unter Aufsicht in der Hausaufgabenbetreuung zu erledigen.“"
                            },
                            {
                                "example_id": "676c9cf6-1874-491b-9bb3-b41ceda58bfb",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„70 Prozent aller sächsischen Ganztagsschüler nehmen mehrmals in der Woche an Hausaufgabenbetreuungen teil.“"
                            },
                            {
                                "example_id": "80d3d712-6bb3-4939-8469-088668670ae3",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Die Schule bietet ein Tagesinternat an, in dem nachmittags eine Hausaufgabenbetreuung stattfindet. Dieses befindet sich in der Trägerschaft des Kolping-Bildungswerkes.“"
                            },
                            {
                                "example_id": "d39bc399-016a-4e1d-963d-3b69e38376f4",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Imane geht in die zweite Klasse. Sie und ihre Freundin Amira sind unzertrennlich. Beim Essen und bei der Hausaufgabenbetreuung sitzen sie immer zusammen.“"
                            },
                            {
                                "example_id": "684457b8-beec-452a-a48d-a400183a7152",
                                "sense_id": "f6af385a-4e3c-36a6-8031-5dd276afc66c",
                                "text": "„Der Sozialpädagoge Tobias Lucht hat eine Mission: Er will Kinderarmut bekämpfen. Dafür gründete er 2006 die Arche Hamburg, wo Kindern und Jugendlichen jeden Tag eine warme Mahlzeit, Hausaufgabenbetreuung und Freizeitaktivitäten geboten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
