                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac626c0b-7c6a-49b5-ac68-d0d8621ec671",
                        "source_entry_id": "46e5c0e2-2c4f-319d-9af1-2523ee041a9d",
                        "source_sense_id": "245f67c2-fb6f-3b02-87f4-c07faf4fa251",
                        "source_sense_description": "een, meestal oud, stadscentrum",
                        "target_lang_word": "Innenstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Innenstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                        "entry_id": "2f251018-dc67-3422-9f3e-c760bf83a8df",
                                        "glosses": [
                                            "innerer Teil, zentral gelegener Teil einer Stadt, in der sich generell Hauptverkehrswege, Dienstleistungseinrichtungen, Handel und so weiter konzentrieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d33eb4-c165-4458-a597-5accf38c9da3",
                                                "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                                "text": "„Mama hatte dann auch aufgeschrieben und gezeichnet, wie sie in die Innenstadt von Berlin gelangen konnte.“"
                                            },
                                            {
                                                "example_id": "4d938a9e-5d70-4d9a-93b1-ca5961e77124",
                                                "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                                "text": "Ich geh mal in die Innenstadt einkaufen!"
                                            },
                                            {
                                                "example_id": "9748e7cf-4dad-49ba-be80-9e97b6df5dd9",
                                                "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                                "text": "„Die Innenstadt wird im Süden vom Hafengelände und im Norden von einer Verkehrsstraße begrenzt.“"
                                            },
                                            {
                                                "example_id": "55172b8f-c101-45db-92dc-ecc79a8ea8b9",
                                                "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                                "text": "„Die Uferzone der Koblenzer Altstadt zieht mit den Anlegestellen für die Touristenschifffahrt, dem Reisebusparkplatz und der räumlichen Nähe zur Innenstadt hohe Touristenzahlen an.“"
                                            },
                                            {
                                                "example_id": "089f4fa1-1424-4924-b73b-323b41e7d382",
                                                "sense_id": "f96ce05a-2d85-3558-9006-6c2b63b4d466",
                                                "text": "„Die herausgeputzte Innenstadt wird von Pizzerien und Trattorien dominiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
