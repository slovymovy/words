                        "examples": [
                            {
                                "example_id": "60965dd1-dec6-4fb6-87b9-e346e1220579",
                                "sense_id": "c9aa8bde-65b9-3e02-aa35-7f1049caf54b",
                                "text": "Hij staart de dood in de ogen maar wordt gelukkig gered door de plaatselijke politie. John is zo onder de indruk dat hij besluit zijn leven om te gooien en een popo te worden."
                            },
                            {
                                "example_id": "6fd6a518-8677-45ed-9588-53ca491518a8",
                                "sense_id": "c9aa8bde-65b9-3e02-aa35-7f1049caf54b",
                                "text": "Dennis begint te tieren over ‘een popo in de bosjes’ die hem een ‘boete van ruim zestig euro in de maag splitste’."
                            }
                        ]
                    }
                ],
