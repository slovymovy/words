    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "df5b5f5a-a4bd-38be-a2d3-0f7b5d4e57a1",
                "word": "Eleanor",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                        "entry_id": "df5b5f5a-a4bd-38be-a2d3-0f7b5d4e57a1",
                        "glosses": [
                            "A female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f47e3d-4ef1-4e6e-85e2-37c3a871dd09",
                                "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                                "text": "Nay, Eleanor, then must I chide outright: / Presumptuous dame! ill-nurtured Eleanor! / Art thou not second woman in the realm, / And the protector's wife, belov'd of him?"
                            },
                            {
                                "example_id": "808e3b8d-2064-4753-8dfd-655689db90f2",
                                "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                                "text": "When you hear a young lady called Eleanor, you think of a tall, beautiful, interesting creature directly - the very opposite of me! With my personal appearance, Eleanor sounds ridiculous - and Neelie, as you yourself remarked, is just the thing. No! no! don't say any more - - -"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c018067-37aa-46a3-9cce-9886812b7f31",
                        "source_entry_id": "df5b5f5a-a4bd-38be-a2d3-0f7b5d4e57a1",
                        "source_sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
