                        "sense_id": "218dec09-631f-3a2c-bb39-f62b9e3c901c",
                        "entry_id": "4d197a11-cba2-35c2-a10d-3125e7adc1f6",
                        "glosses": [
                            "Any of various techniques that use water, either externally or internally, for the treatment of disease and for the soothing of pain."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f52d3ce-a799-4509-b537-22cf0493e269",
                                "sense_id": "218dec09-631f-3a2c-bb39-f62b9e3c901c",
                                "text": "Radio-active baths are said to act favourably in a sexual direction. So too with arsenical springs, cold water treatment, and hydrotherapy."
                            }
                        ]
                    }
                ],
