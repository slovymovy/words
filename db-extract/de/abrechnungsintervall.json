                "senses": [
                    {
                        "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                        "entry_id": "2628cafa-a30e-3404-8cfe-640268268814",
                        "glosses": [
                            "Zeitraum, in dem Abrechnungen erstellt oder Abrechnungsvorgänge durchgeführt werden, um bestimmte Dienstleistungen oder Verbrauchswerte in Rechnung zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cd96c8-504c-4e12-b15a-c364ee11a53b",
                                "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                                "text": "„Insgesamt können vier verschiedene Systemzustände im Abrechnungsintervall auftreten: • Wird nur positive Regelenergie im Abrechnungsintervall bezogen, gilt der (höhere) Regelenergiepreis für den Bezug von Ausgleichsenergie […]“"
                            },
                            {
                                "example_id": "0ba4bae5-840d-4f2b-b589-d95406518eb2",
                                "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                                "text": "„Das System bezieht die betreffende Faktura daher ab dem Abrechnungsintervall 01.10. bis 31.10.2020 in die Kontraktabrechnungen mit ein.“"
                            },
                            {
                                "example_id": "bc0c5490-6eb7-4177-a5f9-f8c27f54133a",
                                "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                                "text": "„Der Abrechnungsmodus kann über den Dropdown-Pfeil des Feldes Abrechnungsintervall ausgewählt werden. Wählen Sie das Abrechnungsintervall monatlich aus. Das Feld Gültig ab wird automatisch mit 01/2019 vorbelegt.“"
                            },
                            {
                                "example_id": "55fd3f89-3c77-4581-8264-114c3b4b5290",
                                "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                                "text": "„Der Abrechnungszeitraum richtet sich nach dem gewählten Abrechnungsintervall. […] Im Falle der unterjährigen Abrechnung steigt der Aussagegehalt der Daten mit der Verkürzung der Abrechnungsintervalle, gleichwohl werden die Messwerte […]“"
                            },
                            {
                                "example_id": "be825676-43de-49fe-8c34-8b125f87bddd",
                                "sense_id": "43807708-8d0c-3924-95d7-e797cde3a097",
                                "text": "„Der Beginn der Einspeisung aus der Batterie wird möglichst gegen Ende des Abrechnungsintervalls gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
