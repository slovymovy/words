    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dac13395-d4bc-3e83-8d3c-fee399f72521",
                    "sense_definition": "To take off one's clothing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "undressing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seeing that no one else was about, he <w>stripped</w> and dived into the river.",
                            "target_lang_translations": {
                                "ru": "Увидев, что никого нет рядом, он <w>разделся</w> и нырнул в реку.",
                                "zh": "见周围没人，他<w>脱掉</w>衣服跳进了河里。"
                            }
                        },
                        {
                            "text": "The doctor asked the patient to <w>strip</w> to the waist for the examination.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента <w>раздеться</w> до пояса для осмотра.",
                                "zh": "医生让病人<w>脱掉</w>上衣进行检查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uncover"
                    ],
                    "antonyms": [
                        "dress",
                        "clothe"
                    ],
                    "common_phrases": [
                        "strip naked",
                        "strip to the waist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снимать с себя одежду.",
                        "zh": "脱掉衣服。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздеваться",
                                "target_lang_sense_clarification": "снимать с себя одежду"
                            },
                            {
                                "target_lang_word": "раздеться",
                                "target_lang_sense_clarification": "завершить процесс снятия одежды"
                            },
                            {
                                "target_lang_word": "обнажаться",
                                "target_lang_sense_clarification": "становиться голым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脱衣",
                                "target_lang_sense_clarification": "脱掉身上的衣服"
                            },
                            {
                                "target_lang_word": "宽衣",
                                "target_lang_sense_clarification": "解开或脱掉衣服"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ca84a9f-0ffe-37ef-a8c1-1dbdf9571aa8",
                    "sense_definition": "To remove a covering or layer from something, often in long pieces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Norm will <w>strip</w> the old varnish before painting the chair.",
                            "target_lang_translations": {
                                "ru": "Норм <w>снимет</w> старый лак перед тем, как красить стул.",
                                "zh": "诺姆在给椅子刷漆前会先<w>清除</w>旧漆。"
                            }
                        },
                        {
                            "text": "You need to <w>strip</w> paint from the door before applying a new coat.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>удалить</w> краску с двери перед нанесением нового слоя.",
                                "zh": "在涂新漆之前，你需要把门上的旧漆<w>剥除</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peel",
                        "uncover"
                    ],
                    "antonyms": [
                        "cover",
                        "coat"
                    ],
                    "common_phrases": [
                        "strip paint",
                        "strip wallpaper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять покрытие или слой с чего-либо, часто длинными кусками.",
                        "zh": "去除某物表面的覆盖层或涂层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "удалять слой или покрытие"
                            },
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "с силой удалять верхний слой"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять старую краску или лак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剥除",
                                "target_lang_sense_clarification": "去除表层"
                            },
                            {
                                "target_lang_word": "清除",
                                "target_lang_sense_clarification": "去除旧的涂层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e13cb4d-10bc-3acf-86f8-fdd9fbd8d4dc",
                    "sense_definition": "To take away property, honors, or titles from someone as a punishment or through force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was <w>stripped</w> of his medal after failing a drugs test.",
                            "target_lang_translations": {
                                "ru": "Атлета <w>лишили</w> медали после провала допинг-теста.",
                                "zh": "该运动员因药检不合格被<w>剥夺</w>了奖牌。"
                            }
                        },
                        {
                            "text": "The general was <w>stripped</w> of his rank following the scandal.",
                            "target_lang_translations": {
                                "ru": "Генерала <w>лишили</w> звания после скандала.",
                                "zh": "丑闻发生后，这位将军被<w>撤销</w>了军衔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deprive"
                    ],
                    "antonyms": [
                        "award",
                        "grant"
                    ],
                    "common_phrases": [
                        "stripped of his title",
                        "stripped of power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо собственности, почестей или титулов в качестве наказания или силой.",
                        "zh": "因惩罚或强制手段剥夺某人的财产、荣誉或头衔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "отбирать права, титулы или награды"
                            },
                            {
                                "target_lang_word": "разжаловать",
                                "target_lang_sense_clarification": "лишать воинского звания или чина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剥夺",
                                "target_lang_sense_clarification": "强制收回权利或荣誉"
                            },
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "取消头衔或职位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f085c8-b784-3b10-b13f-23ff06e8fe45",
                    "sense_definition": "To damage the thread of a screw or the teeth of a gear so they no longer grip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't tighten that bolt any more or you'll <w>strip</w> the thread.",
                            "target_lang_translations": {
                                "ru": "Не затягивай этот болт сильнее, иначе ты <w>сорвёшь</w> резьбу.",
                                "zh": "别再拧那个螺栓了，否则你会把螺纹<w>拧坏</w>的。"
                            }
                        },
                        {
                            "text": "He accidentally <w>stripped</w> the screw by using the wrong screwdriver.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>сорвал</w> винт, используя неподходящую отвёртку.",
                                "zh": "他因为用了错误的螺丝刀，不小心把螺丝<w>拧滑</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "strip the thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повреждать резьбу винта или зубья шестерни так, что они перестают цепляться.",
                        "zh": "损坏螺丝的螺纹或齿轮的齿，使其无法咬合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "повреждать резьбу или зубья"
                            },
                            {
                                "target_lang_word": "сорвать",
                                "target_lang_sense_clarification": "испортить резьбу окончательно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑丝",
                                "target_lang_sense_clarification": "螺纹损坏"
                            },
                            {
                                "target_lang_word": "磨损",
                                "target_lang_sense_clarification": "齿轮或螺纹因过度使用而损坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25eb4d2a-625d-3215-a241-695b44674df8",
                    "sense_definition": "To perform a striptease.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the seedy club, a group of drunken men were watching a woman <w>stripping</w>.",
                            "target_lang_translations": {
                                "ru": "В сомнительном клубе группа пьяных мужчин наблюдала за тем, как женщина <w>раздевается</w>.",
                                "zh": "在那家破旧的俱乐部里，一群醉汉正看着一个女人<w>跳脱衣舞</w>。"
                            }
                        },
                        {
                            "text": "She earned extra money by <w>stripping</w> at a local nightclub.",
                            "target_lang_translations": {
                                "ru": "Она подрабатывала, <w>танцуя стриптиз</w> в местном ночном клубе.",
                                "zh": "她通过在当地一家夜总会<w>跳脱衣舞</w>赚取额外收入。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять стриптиз.",
                        "zh": "表演脱衣舞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздеваться",
                                "target_lang_sense_clarification": "исполнять стриптиз"
                            },
                            {
                                "target_lang_word": "танцевать стриптиз",
                                "target_lang_sense_clarification": "профессионально раздеваться под музыку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳脱衣舞",
                                "target_lang_sense_clarification": "表演脱衣舞"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a15c4ff-8ca4-3893-900e-27acbbbf256b",
                    "sense_definition": "A long, thin piece of any material.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Papier mache is made from <w>strips</w> of paper.",
