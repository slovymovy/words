                    "sense_definition": "Pousser des cris très puissants sous l'effet de la douleur, de la colère ou de la peur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cris_humains",
                    "name_type": "no",
