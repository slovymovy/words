                "senses": [
                    {
                        "sense_id": "3d6feb4a-b6ac-3f0c-bfed-81ae5d5b21dc",
                        "entry_id": "cb8451e4-4f64-38c3-b5a4-d3d59de75d01",
                        "glosses": [
                            "Aufstellung der Truppen für die Schlacht"
                        ],
                        "tags": [
                            "Kriegsführung"
                        ],
                        "examples": [
                            {
                                "example_id": "5dc8653a-4bd0-466f-a29a-12602edbecf9",
                                "sense_id": "3d6feb4a-b6ac-3f0c-bfed-81ae5d5b21dc",
                                "text": "„Tasächlich erscheint diese Macedonum legio im livianischen Bericht über die Schlachtaufstellung des karthagischen Heeres …“"
                            },
                            {
                                "example_id": "f4f86730-eb01-47bc-a237-85627c36f9ae",
                                "sense_id": "3d6feb4a-b6ac-3f0c-bfed-81ae5d5b21dc",
                                "text": "„Die Rehen werden verdünnt, d.h. geteilt, wenn eine Tiefe von 16 Mann gegeben ist und man die Schlachtaufstellung weiter ausdehnen will …“"
                            },
                            {
                                "example_id": "2048c90a-5c69-4ce6-804f-c5c5db09ebab",
                                "sense_id": "3d6feb4a-b6ac-3f0c-bfed-81ae5d5b21dc",
                                "text": "„Bei Gaugamela aber wird der Troß und seine aus thrakischer Infanterie Bewachung am Ende der Schlachtaufstellung genannt.“"
                            },
                            {
                                "example_id": "8deb7246-9549-4241-a106-3bcb802c13e1",
                                "sense_id": "3d6feb4a-b6ac-3f0c-bfed-81ae5d5b21dc",
                                "text": "„Der Khagan hatte sein Heer in zwölf Haufen angeordnet; denn ‚in der Schlacht formieren sie die Schlachtaufstellung nicht wie die Römer und Perser in drei Blöcken, sondern in verschiedenen Regimentern, wobei sie die Regimenter in Haufen zusammenschließen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
