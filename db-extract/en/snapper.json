                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "696ce880-9ca2-3f12-afaf-b6dbab24b8a9",
                        "entry_id": "11fa65f9-3318-3633-91e3-83332758ac4c",
                        "glosses": [
                            "A string bean."
