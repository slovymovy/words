                                    {
                                        "sense_id": "5bd5d7aa-5ec7-363c-8238-db856ae062b9",
                                        "entry_id": "347ac8a1-b6d5-376d-954d-222fe8d760ef",
                                        "glosses": [
                                            "mit Wissen und Zustimmung aller Beteiligten mehrere Liebesbeziehungen habend; solche mehrfachen Beziehungen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c8a6a5-3552-41e0-96b5-caaa9276d54b",
                                                "sense_id": "5bd5d7aa-5ec7-363c-8238-db856ae062b9",
                                                "text": "„Zentralen Stellenwert hat in polyamoren Kontexten das Prinzip der Mitfreude (engl. Compersion).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d37ae2cf-b236-4859-bfb1-c85de816d2e9",
                        "source_entry_id": "a74340c1-1aa5-3ed5-a117-ef86c180c466",
                        "source_sense_id": "ce2bf0df-92e7-3cd6-97a0-cdf059da8c50",
                        "target_lang_word": "polyamorös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyamorös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b74291b0-af5e-385f-8437-7d56d090472b",
                                        "entry_id": "12eb07c5-4c3f-361d-a95e-8f8b8b85abdd",
                                        "glosses": [
                                            "mit Wissen und Zustimmung aller Beteiligten mehrere Liebesbeziehungen habend; solche mehrfachen Beziehungen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0e31a9-437e-4370-a130-b715128b970c",
                                                "sense_id": "b74291b0-af5e-385f-8437-7d56d090472b",
                                                "text": "„Bekannt geworden ist die Arbeit The Polyamorists Next Door von Elisabetz Sheff (2014), die sich seit nunmehr 15 Jahren intensiv mit den Vor- und Nachteilen polyamoröser Beziehungen befasst.“"
                                            },
                                            {
                                                "example_id": "b334716e-5606-438e-8520-b25445a6952a",
                                                "sense_id": "b74291b0-af5e-385f-8437-7d56d090472b",
                                                "text": "„Das gilt folglich auch für polyamoröse Partnerschaften.“"
                                            },
                                            {
                                                "example_id": "5d3cbb76-b27d-4b46-b818-275af5028a6e",
                                                "sense_id": "b74291b0-af5e-385f-8437-7d56d090472b",
                                                "text": "„Es sollte der kritischen Sexualforschung ein Anliegen sein, die Potenziale und Widersprüche polyamoröser Diskurse zu ermitteln, um ihre herrschaftskritischen Elemente zu stärken.“"
                                            },
                                            {
                                                "example_id": "f1e8299c-617e-4411-9f4a-1c2e5b4aea8d",
                                                "sense_id": "b74291b0-af5e-385f-8437-7d56d090472b",
                                                "text": "„Implizit und von vorneherein soll jedoch durch den Oberbegriff Queer bzw. seine Definition vermittelt werden, dass die Entscheidung für ein monogames oder polyamoröses Leben wertneutral bzw. gleichwertig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
