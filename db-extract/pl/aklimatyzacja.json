                ],
                "translations": [
                    {
                        "translation_id": "a0f9c97d-3ac7-493a-95e4-44d554356862",
                        "source_entry_id": "2d8832cc-4554-3c0d-94a9-4c3785a1be7e",
                        "source_sense_id": "16a3a7bb-020a-3be8-84ce-805cae85345f",
                        "source_sense_description": "Biologie: Akklimatisation",
                        "target_lang_word": "Akklimatisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akklimatisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eea44c58-980f-316a-9200-21317e46836b",
                                        "entry_id": "2f372316-c4d5-3ab6-9f4f-849bfaef40dd",
                                        "glosses": [
                                            "Anpassung an veränderte Klimaverhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d02264b-438f-413d-8868-2a23e3e96f57",
                                                "sense_id": "eea44c58-980f-316a-9200-21317e46836b",
                                                "text": "Viele Tiere können sich durch Akklimatisation an verschiedenen Orten eingewöhnen."
                                            },
                                            {
                                                "example_id": "6bc431f3-10c9-42a4-9bca-f57a0ff78a25",
                                                "sense_id": "eea44c58-980f-316a-9200-21317e46836b",
                                                "text": "„Sollte aber das Wetter passen und die Akklimatisation gut verlaufen, könne er sich vorstellen, dass einer am 1. Mai auf dem Gipfel stehe, notierte er Ende März in sein Tagebuch.“"
                                            },
                                            {
                                                "example_id": "b15a97db-1da4-447c-94af-5de368f8a165",
                                                "sense_id": "eea44c58-980f-316a-9200-21317e46836b",
                                                "text": "„Ist die Akklimatisation unzureichend, kann die akute Höhenkrankheit auftreten.“"
                                            },
                                            {
                                                "example_id": "b6457524-9246-42b4-a70f-9785707aee01",
                                                "sense_id": "eea44c58-980f-316a-9200-21317e46836b",
                                                "text": "„Peter Bärtsch, ärztlicher Direktor der Sportmedizin am Universitätsklinikum Heidelberg, beschreibt das Höhen-Hirn-Ödem als typisches Risiko von Everest-Expeditionen, weil eine Akklimatisation über 7000 Metern, in der ‚Todeszone‘, nicht mehr möglich sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2361c925-27db-390d-92cb-199743ba215b",
                                        "entry_id": "2f372316-c4d5-3ab6-9f4f-849bfaef40dd",
                                        "glosses": [
                                            "Anpassung an veränderte Lebensverhältnisse; das Vertrautwerden mit veränderten Lebensverhältnissen"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35f60233-5930-44cb-9de2-8c3bf594c7cc",
                                                "sense_id": "2361c925-27db-390d-92cb-199743ba215b",
                                                "text": "„Aber vor dieser geistigen Akklimatisation … graute ihr! Sie wollte geistig nicht auf dasselbe Niveau sinken, auf dem die anderen standen, sie wollte sich ihre Eigenart bewahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
