                        "target_lang_word": "Einbettung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einbettung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4aadea8-335e-3534-b78a-07dbf62c8664",
                                        "entry_id": "202a636d-aaab-3a36-bcf4-7e8416ad7c0c",
                                        "glosses": [
                                            "eine Abbildung, die es ermöglicht, eine mathematische Struktur (Objekt) als Teil einer anderen aufzufassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ca0412-0fe3-40a0-bb69-e5ee7ea02683",
                                                "sense_id": "d4aadea8-335e-3534-b78a-07dbf62c8664",
                                                "text": "Mathematik: Die Abbildung i: ℝ↪ ℂ,i(x):=x*1+0*i ist eine Einbettung der reellen Zahlen in die komplexen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7121b64-47c8-3f0a-be43-beed21b179ad",
                                        "entry_id": "202a636d-aaab-3a36-bcf4-7e8416ad7c0c",
                                        "glosses": [
                                            "Verfestigung (mechanische Stabilisierung) einer Probe durch Infiltration mit einer flüssigen Substanz (Paraffin, Kunstharz), welche anschließend aushärtet."
                                        ],
                                        "tags": [
                                            "Histologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df0ba16e-60b3-4ade-9095-369149e1ef2f",
                                                "sense_id": "e7121b64-47c8-3f0a-be43-beed21b179ad",
                                                "text": "Zur mechanischen Stabilisierung der Gewebeprobe nimmt man eine Einbettung in Paraffin bzw. Kunstharze vor."
                                            },
                                            {
                                                "example_id": "acc371ff-67c7-4a0c-b7c8-f309eddfd250",
                                                "sense_id": "e7121b64-47c8-3f0a-be43-beed21b179ad",
                                                "text": "Vor dem Schneiden kam noch die Einbettung."
                                            },
                                            {
                                                "example_id": "618e1e45-a8de-459d-8026-f58a3209491f",
                                                "sense_id": "e7121b64-47c8-3f0a-be43-beed21b179ad",
                                                "text": "Das Einfrieren der Probe ist eine Alternative zur Einbettung, wenn man das Material vor dem Schneiden verfestigen will."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7fe94c8f-baf8-3af3-8673-724f22d3fb46",
                                        "entry_id": "202a636d-aaab-3a36-bcf4-7e8416ad7c0c",
                                        "glosses": [
                                            "Einfügung einer abhängigen syntaktischen Einheit in eine höherrangige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332bce3f-6054-41c6-8de1-47d4b3e11694",
                                                "sense_id": "7fe94c8f-baf8-3af3-8673-724f22d3fb46",
                                                "text": "Eine Einbettung liegt vor, wenn in einen Hauptsatz ein Nebensatz eingefügt wurde. Der Begriff Einbettung ist in der Linguistik vor allem aus der generativen Grammatik bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
