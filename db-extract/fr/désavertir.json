                "senses": [
                    {
                        "sense_id": "409a1948-102e-3fbd-8ec9-e7004b65cc4d",
                        "entry_id": "de68bf64-77a7-33b2-ba83-80d05909cac4",
                        "glosses": [
                            "Lever l’avertissement adressé à (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7aad82d-b211-4b75-b5c9-f142bade450d",
                                "sense_id": "409a1948-102e-3fbd-8ec9-e7004b65cc4d",
                                "text": "Le Délinquant aura également la faculté de payer l’Amende au Vingtenier après avoir reçu l’Avertissement, pendant les vingt-quatre heures après l’avoir reçu, en y ajoutant Dix Pennis pour les frais et peines du Vingtenier pour désavertir les Témoins et remettre la dite Amende à qui de droit."
                            },
                            {
                                "example_id": "63a56741-6a72-4d8d-9bbb-a2567960a656",
                                "sense_id": "409a1948-102e-3fbd-8ec9-e7004b65cc4d",
                                "text": "On peut se faire désavertir, au bon vouloir des admins et modos."
                            },
                            {
                                "example_id": "f4cf19d6-c0c6-4929-b4b6-9d7ebbd17421",
                                "sense_id": "409a1948-102e-3fbd-8ec9-e7004b65cc4d",
                                "text": "peut-être que si tu participes au forum et que t’es irréprochable, Attila dans sa grande bonté pourrait te désavertir"
                            }
                        ]
                    }
