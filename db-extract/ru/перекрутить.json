                        "source_entry_id": "774759c5-0993-3eab-9c53-e9341dadcd1a",
                        "target_lang_word": "überdrehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überdrehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc870b90-8e1d-3c7f-b1fb-c8807d93e65b",
                                        "entry_id": "066a5643-c6b8-32ff-a17f-c1d7cc85a3bc",
                                        "glosses": [
                                            "etwas durch zu starkes Drehen beschädigen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ce2ad8-301b-440b-ab8d-a61affdcd83f",
                                                "sense_id": "fc870b90-8e1d-3c7f-b1fb-c8807d93e65b",
                                                "text": "Eine Rutschkupplung verhindert dabei, dass die Zugfeder überdreht wird, falls die Uhr nach dem vollständigen Aufziehen weiter bewegt wird."
                                            },
                                            {
                                                "example_id": "b6841099-ee81-42c1-80fb-743550d46fbd",
                                                "sense_id": "fc870b90-8e1d-3c7f-b1fb-c8807d93e65b",
                                                "text": "Nahezu jeder Enduro- oder Crossfahrer war schon einmal in der Situation, eine Schraube überdreht und dadurch das Gewinde zerstört zu haben."
                                            },
                                            {
                                                "example_id": "2d2e33cf-d159-430c-af16-d3ae5d8e15b8",
                                                "sense_id": "fc870b90-8e1d-3c7f-b1fb-c8807d93e65b",
                                                "text": "Lässt sich eine Schraube nicht mehr festziehen oder herausschrauben, ist in der Regel eines der beiden Gewinde überdreht."
                                            },
                                            {
                                                "example_id": "63088b82-26bb-43b7-81c9-d22bac8273cc",
                                                "sense_id": "fc870b90-8e1d-3c7f-b1fb-c8807d93e65b",
                                                "text": "Was für die Marktwirtschaft generell gilt, stimmt auch für die Bildung einer integrierten Weltwirtschaft: Das freiheitliche System droht immer wieder zu überdrehen und sich auf diese Weise selbst die Grundlage zu entziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84dc18f8-39ab-3c72-850a-fa1d3c84b455",
                                        "entry_id": "066a5643-c6b8-32ff-a17f-c1d7cc85a3bc",
                                        "glosses": [
                                            "einen Motor mit zu hoher Drehzahl laufen lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22224d5c-8906-4e28-8b5e-4ad40b7d69bd",
                                                "sense_id": "84dc18f8-39ab-3c72-850a-fa1d3c84b455",
                                                "text": "Für den Laien: Jeder Gang läuft in einem großen Geschwindigkeitsbereich, ohne abzusaufen oder zu überdrehen."
                                            },
                                            {
                                                "example_id": "8f93e94f-25b0-4650-95a3-c76670e425d5",
                                                "sense_id": "84dc18f8-39ab-3c72-850a-fa1d3c84b455",
                                                "text": "Da pflegt einer jeden Morgen, ruhestörend, den Motor seines Wagens beim Start zu überdrehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
