                    {
                        "sense_id": "6fc30ddf-4f3e-3a35-bcb6-68cb15b58612",
                        "entry_id": "4ad85a37-a6f3-3657-ab0e-ca647c75bc64",
                        "glosses": [
                            "Galette repliée sur elle-même en forme rectangulaire et grillée, contenant toujours une garniture qui est le plus souvent à base de viande, de frites et de sauce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e275df-256e-4799-a074-52423fd73f4c",
                                "sense_id": "6fc30ddf-4f3e-3a35-bcb6-68cb15b58612",
                                "text": "Tout ça pour vous dire que vous pourrez être ultra-fiers la prochaine fois que vous savourerez un tacos (et on est à peu près sûr que ce jour viendra très vite…) : LE TACOS EST LYONNAIS !'"
                            },
                            {
                                "example_id": "36c55c0d-361e-4cde-8dd5-dd15c9ebbc4f",
                                "sense_id": "6fc30ddf-4f3e-3a35-bcb6-68cb15b58612",
                                "text": "Prêt à relever le défi et manger un tacos de 2 kilos ?"
                            },
                            {
                                "example_id": "b69663ae-b901-4ee4-ba61-8ce8d2ff8d44",
                                "sense_id": "6fc30ddf-4f3e-3a35-bcb6-68cb15b58612",
                                "text": "Tacos lyonnais à la sauce gruyère, voilà la recette du tacos lyonnais, un tacos au poulet à la sauce gruyère, le meilleur des tacos maison !"
                            }
                        ]
                    }
