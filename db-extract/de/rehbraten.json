                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308becaa-c1e4-4c91-9a9b-535f91150a87",
                                "sense_id": "dc0adb08-3fc7-3912-9273-bbffc5b1929f",
                                "text": "Als Hauptspeise gibt es Rehbraten mit Kartoffelknödeln und Rotkohl."
                            },
                            {
                                "example_id": "1dbc2f5e-c537-43e6-95f5-465921c13a00",
                                "sense_id": "dc0adb08-3fc7-3912-9273-bbffc5b1929f",
                                "text": "„Ich esse mit schlechtem Gewissen und starkem Mißtrauen, und der Rehbraten, eine Delikatesse ersten Ranges, schmeckt mir plötzlich nicht.“"
                            }
                        ],
