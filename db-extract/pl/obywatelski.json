                                                "example_id": "eddb64b1-9cb1-4fcb-9b6e-f81c3a43492b",
                                                "sense_id": "2fda5298-30f2-3bc6-a2df-29e327e1eb16",
                                                "text": "Гражданское право."
                                            },
