            {
                "entry_id": "ecb6403b-b5d4-36c1-b9bf-e7e69055b5a5",
                "word": "doc",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e536cade-7a2d-45b3-8bba-3b7059123cc6",
                        "entry_id": "ecb6403b-b5d4-36c1-b9bf-e7e69055b5a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "docs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7357fe5-3345-364d-946c-370cbf5423d3",
                        "entry_id": "ecb6403b-b5d4-36c1-b9bf-e7e69055b5a5",
                        "glosses": [
                            "A doctor."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "42c2ab25-61f4-4f70-962a-c16cdbca0285",
                                "sense_id": "e7357fe5-3345-364d-946c-370cbf5423d3",
                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a5add1f-9bba-4933-a953-9b1151f844ec",
                        "source_entry_id": "ecb6403b-b5d4-36c1-b9bf-e7e69055b5a5",
                        "source_sense_id": "e7357fe5-3345-364d-946c-370cbf5423d3",
                        "source_sense_description": "doctor (informal)",
                        "target_lang_word": "toubib",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toubib",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                        "entry_id": "68584d5c-5850-3e60-83dd-85cd8a23048a",
                                        "glosses": [
                                            "Médecin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae77eb7d-852f-4dbe-923e-d596862e5733",
                                                "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                                "text": "Ça dépendait de lui, le toubib, et elle le supplia de ne pas la faire entrer à la maison publique, de garder son secret."
                                            },
                                            {
                                                "example_id": "763a0292-1784-4367-8568-857322c84e40",
                                                "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                                "text": "À la visite, l’toubib commençait par les vérolées. Il leur mettait le speculum et, sans souvent l’laver, il te l’passait. Comme ça, si t'avais rien, trop tard !"
                                            },
                                            {
                                                "example_id": "3b4ba9a1-f1e4-4f61-ad25-79f1f7c1b64c",
                                                "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                                "text": "Il souriait parce que Le Folliculaire n’avait pas hésité, dès sa capture, à troquer ses galons de caporal pour des galons de sergent et que, de mèche avec les toubibs, il se planquait à l’infirmerie."
                                            },
                                            {
                                                "example_id": "c03cde84-0ef5-4a5b-b3d2-0062b3341c71",
                                                "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                                "text": "Je pourrais toujours m’y procurer de l’aspirine, à l’issue de ma visite au toubib."
                                            },
                                            {
                                                "example_id": "e4a689ad-b896-4a4f-bfa0-88830ab76dd0",
                                                "sense_id": "18e58bbf-9eb3-3c6d-b3bb-c597068f7644",
                                                "text": "La toubib me laisse mes antidépresseurs, y ajoute une pincée de Seresta pour le sevrage et une goutte de tranquillisant pour le sommeil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
