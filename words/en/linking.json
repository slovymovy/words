        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0cef2c0-8cd2-3183-9e5c-fa2f6cbc33a0",
                    "sense_definition": "The act or process of connecting things; a linkage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>linking</w> of these two distinct ideas created a new philosophy.",
                            "target_lang_translations": {
                                "ru": "<w>Связывание</w> этих двух различных идей создало новую философию.",
                                "es": "La <w>vinculación</w> de estas dos ideas distintas dio lugar a una nueva filosofía.",
                                "fr": "La <w>mise en relation</w> de ces deux idées distinctes a donné naissance à une nouvelle philosophie."
                            }
                        },
                        {
                            "text": "Careful <w>linking</w> between the chapters gives the book its coherence.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>связывание</w> глав между собой придаёт книге цельность.",
                                "es": "La cuidadosa <w>conexión</w> entre los capítulos le otorga al libro su coherencia.",
                                "fr": "Une <w>liaison</w> soignée entre les chapitres donne au livre toute sa cohérence."
                            }
                        }
                    ],
