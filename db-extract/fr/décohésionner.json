                "senses": [
                    {
                        "sense_id": "62e27bf6-575d-3b3f-8382-abe73c1c4568",
                        "entry_id": "536e8cdc-8e80-3c30-ae52-25c51c8e9ebb",
                        "glosses": [
                            "Faire perdre sa cohésion à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d920b5e4-468d-473a-8801-e6e4f9f0b407",
                                "sense_id": "62e27bf6-575d-3b3f-8382-abe73c1c4568",
                                "text": "Il est rappelé que la technique consiste à : - chauffer la couche de roulement ; - la décohésionner et mettre les matériaux en cordon"
                            },
                            {
                                "example_id": "b50f7a56-45bd-4123-b124-c48c70b55bd1",
                                "sense_id": "62e27bf6-575d-3b3f-8382-abe73c1c4568",
                                "text": "Elle consiste à récupérer un matériau bitumineux ancien, à le réchauffer pour le décohésionner et permettre au bitume qui y est contenu de se répartir dans la masse, et à le mélanger avec des granulats neufs et un liant d’ajout correctement dosés."
                            }
                        ]
                    }
