                        ],
                        "form": "ingénus"
                    },
                    {
                        "form_id": "a5bf450b-c8ab-4ead-911e-e4cf49df71eb",
                        "entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "ingénue"
                    },
                    {
                        "form_id": "e61e30ce-3916-42a8-83ae-e61092c1f394",
                        "entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ingénues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                        "entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                        "glosses": [
                            "Qui a de la simplicité et presque de la naïveté dans la franchise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ca7aee-fc91-4cf2-8e70-720b0ec22ca1",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Déclaration, réponse ingénue."
                            },
                            {
                                "example_id": "87061879-1a3b-4e7e-9896-95d1e6225cae",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Il fit un aveu ingénu."
                            },
                            {
                                "example_id": "3b0fd581-fd76-4cfa-9415-59f9007f03ec",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Elle avait en effet, et de la façon la plus naturelle, le regard ingénu, le geste décevant, la démarche hardie et décente tout ensemble, d'une femme du plus grand monde."
                            },
                            {
                                "example_id": "d25cb3a4-bda2-45df-bb70-57e7339f732d",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Les loups sont ingénus…"
                            },
                            {
                                "example_id": "0be5c556-67a9-430c-a709-5e22d0e39384",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Un homme ingénu."
                            },
                            {
                                "example_id": "b0dc44f7-7331-4f0a-ae54-1c12548bbfbf",
                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                "text": "Un esprit ingénu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c429c7f0-bdd5-4b8c-b495-13a06dd00c41",
                        "source_entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                        "source_sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                        "target_lang_word": "ingenuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingenuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82191d7a-0afa-3794-bbc5-73e288c71de0",
                                        "entry_id": "470b5898-82bf-32d7-9183-f6ed9ee38ad2",
                                        "glosses": [
                                            "Naive and trusting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6f55666-3491-3b70-962e-601e86859f14",
                                        "entry_id": "470b5898-82bf-32d7-9183-f6ed9ee38ad2",
                                        "glosses": [
                                            "Demonstrating childlike simplicity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c6e85e-732f-4143-ba53-031735908c3f",
                                                "sense_id": "d6f55666-3491-3b70-962e-601e86859f14",
                                                "text": "\"Do you mean to say you didn't leave your wife for another woman?\"\n\"Of course not.\"\n\"On your word of honour?\"\nI don't know why I asked for that. It was very ingenuous of me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa225f3-46b4-3a96-9169-89d022221fac",
                                        "entry_id": "470b5898-82bf-32d7-9183-f6ed9ee38ad2",
                                        "glosses": [
                                            "Unsophisticated; clumsy or obvious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7331a7db-e697-4487-89a3-6114c642062c",
                                                "sense_id": "afa225f3-46b4-3a96-9169-89d022221fac",
                                                "text": "The apparent contradictions in his behaviour should therefore be discounted as ingenuous attempts to extricate himself from the consequences of an intellectual position which he once adopted but was never really his by intimate conviction."
                                            },
                                            {
                                                "example_id": "75a582e5-8b99-4880-b338-f33753e719c0",
                                                "sense_id": "afa225f3-46b4-3a96-9169-89d022221fac",
                                                "text": "[…] Semitic agitation by stating 'the truth' in terms of facts and figures, the practice of self-criticism represented a well-intended but ingenuous effort to defend Jewry against anti-Semitism."
                                            },
                                            {
                                                "example_id": "1be743bc-1132-47db-becd-9974f021a544",
                                                "sense_id": "afa225f3-46b4-3a96-9169-89d022221fac",
                                                "text": "There was nothing more I dared say. My ingenuous attempts to lie my way out of trouble had only served to get me in deeper and deeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e8142d-4ca3-388f-b4c4-72307779b0e9",
                                        "entry_id": "470b5898-82bf-32d7-9183-f6ed9ee38ad2",
                                        "glosses": [
                                            "Unable to mask one's feelings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba5884f5-21fb-31d1-b9cc-9aa6644f400d",
                                        "entry_id": "470b5898-82bf-32d7-9183-f6ed9ee38ad2",
                                        "glosses": [
                                            "Straightforward, candid, open, frank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b47883-10c4-4f89-b49f-33304265a509",
                                                "sense_id": "ba5884f5-21fb-31d1-b9cc-9aa6644f400d",
                                                "text": "[H]is Grace’s Man at his club, in company doubtless with other Men of equal social rank, talks over his master’s character and affairs with the ingenuous truthfulness which befits gentlemen who are met together in confidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
