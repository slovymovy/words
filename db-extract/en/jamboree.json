                "word": "jamboree",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "acc2724b-a105-47a2-8575-d53499ecf1d8",
                        "entry_id": "4d431034-1b7c-30df-a829-58d86fcd1fc9",
                        "tags": [
                            "plural"
                        ],
                        "form": "jamborees"
