                                "example_id": "2f90b73e-e3d8-4d9a-a1e2-1821c8eca7c9",
                                "sense_id": "c4f1f3fb-4190-3473-86c4-9da19f1d7a36",
                                "text": "„Aber irgendjemanden hätten die Lagerleiter gefunden; sie hatten jedes Zwangsmittel zur Verfügung.“"
                            },
