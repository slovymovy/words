                "senses": [
                    {
                        "sense_id": "47f4ca20-8e60-3ae1-8482-342242c1297e",
                        "entry_id": "dc6ff1b5-07c1-3213-a5bc-babc3aad6b73",
                        "glosses": [
                            "Détacher d’une ganse."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0b3e7b1c-b33e-4eca-bbaf-56ca4c242a16",
                                "sense_id": "47f4ca20-8e60-3ae1-8482-342242c1297e",
                                "text": "[…] les ressorts du sommier grincent, mon gros corps s’enfonce dans le matelas comme si j’étais couché sur un tas de mousses molles – puis déganser le cuir qui retient l’attelle à mon bras et à mon épaule, puis de la main droite masser la chair moite de mon biceps, mince comme pelure d’oignon sur l’os, le virus de la poliomyélite ayant si bien dévoré le muscle qu’il n’en reste plus grand chose, même pas de quoi lever le coude pour que la main puisse se rendre jusqu’à la poche de mon veston […]"
                            },
                            {
                                "example_id": "03b86363-9f23-49be-90ff-fd1540ca978a",
                                "sense_id": "47f4ca20-8e60-3ae1-8482-342242c1297e",
                                "text": "quand je reviens à moi, j’ai le cou cassé à cause que ma tête s’est renversée par derrière, sur le dossier de bois du banc ; et mon attelage s’est dégansé tellement les danseuses, s’agrippant à moi, ne voulaient pas que je retrouve ni calixthe beyala ni justine […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "be657d19-626e-3363-a501-38206ed2e24e",
                        "entry_id": "dc6ff1b5-07c1-3213-a5bc-babc3aad6b73",
                        "glosses": [
                            "Tirer par force de l’argent de sa bourse."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "55c8bf39-2f7f-4366-aec8-10f11746ec5b",
                                "sense_id": "be657d19-626e-3363-a501-38206ed2e24e",
                                "text": "DÉGANSER, V. act. -- Tirer par force de l’argent de sa bourse : « Voilà un procés qui me fera déganser de l’argent . »"
                            }
                        ]
                    }
