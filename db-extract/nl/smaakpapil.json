                        "cross_references": [
                            {
                                "target_word": "Geschmacksknospe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af0233be-b5ee-303b-b8a9-1c10c7cea184",
                                        "entry_id": "2ed5ff45-7d17-3f9b-9c26-780e22c950d1",
                                        "glosses": [
                                            "Organ im Mund, mit dem der Geschmack der Nahrung wahrgenommen wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a3e12-0080-40ba-bb88-2e1651afc39c",
                                                "sense_id": "af0233be-b5ee-303b-b8a9-1c10c7cea184",
                                                "text": "„Es hatte offensichtlich keiner an ein Kind gedacht, das ja bekanntlich empfindlichere und sensiblere Geschmacksknospen hat als wir, und wie alle wissen, sind Kinder große Milchschlürfer.“"
                                            },
                                            {
                                                "example_id": "cf05ed09-8006-4251-94b9-27831ad4b7b5",
                                                "sense_id": "af0233be-b5ee-303b-b8a9-1c10c7cea184",
                                                "text": "„Manchmal schließt sie die Augen, um sich ganz auf den Geschmack zu konzentrieren, nur auf die Geschmacksknospen, um etwas zu schmecken, von dem sie nicht wusste, dass es überhaupt existiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
