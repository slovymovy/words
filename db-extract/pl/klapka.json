                "translations": [
                    {
                        "translation_id": "95a30a82-c271-4011-9939-9144c6bfae39",
                        "source_entry_id": "6958a6de-384c-38ae-9995-372403eb789c",
                        "source_sense_id": "78fa312a-c774-3a0b-8608-7a8d5a3c3c4a",
                        "target_lang_word": "blinker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a634b6ca-b0f6-3f26-ad7e-59a1da0e4b10",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "Anything that blinks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188e9265-4709-4fd5-b7d5-bd3df4fd9eb7",
                                                "sense_id": "a634b6ca-b0f6-3f26-ad7e-59a1da0e4b10",
                                                "text": "She was a frequent blinker, always on the verge of tears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4bc7cd-6c84-3bd6-b421-58d10e376ad6",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "The turn signal of an automobile."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Northern-US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27057dda-ebbb-38b1-aed8-7ab43b5dcdd1",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "A shield attached to the bridle of a horse or other domesticated animal to prevent it from seeing things behind it and to its side."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e3c6fc8-8e7c-3071-99f4-0a2ff39a7b96",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "Whatever obstructs sight or discernment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d65fa67-3634-4092-b7d5-43560d72d181",
                                                "sense_id": "2e3c6fc8-8e7c-3071-99f4-0a2ff39a7b96",
                                                "text": "This floor let not the vulgar tread, / Who worship only what they dread: / Nor bigots who but one way see, / Through blinkers of authority"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba79bdf8-bcc8-3ec5-bae6-e1b585d712cf",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "The eyelid."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fde1cfd9-0361-3eba-b2fd-6ebddd1492cb",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "A black eye."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68363530-dad7-47ce-8b0d-166242b1bb68",
                                                "sense_id": "fde1cfd9-0361-3eba-b2fd-6ebddd1492cb",
                                                "text": "The next morning, Jimmy came home with a fat lip and a black eye. Flory rushed over to tend to him. “Ain't nothin'. Just a blinker... had a fight with a guy. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8612019b-dfe5-3eb8-8fd0-7ff98d07e247",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "In Conway's Game of Life, an arrangement of three cells in a row that switches between horizontal and vertical orientations in each generation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b595ea78-acc9-4baf-bf3d-87f64619ee75",
                                                "sense_id": "8612019b-dfe5-3eb8-8fd0-7ff98d07e247",
                                                "text": "The following for example, doesn't work because the spark at the top is actually a blinker, and doesn't die. Without the blinker, this object is known as an OWSS (overweight spaceship)."
                                            },
                                            {
                                                "example_id": "d812f178-296a-4ec6-a245-f7f8c51a8011",
                                                "sense_id": "8612019b-dfe5-3eb8-8fd0-7ff98d07e247",
                                                "text": "3 live cells together can yield either a blinker or a block, so these will be the most common objects formed \"out of the void\"."
                                            },
                                            {
                                                "example_id": "e262e81d-d520-4ad7-8bf8-5b76de25c529",
                                                "sense_id": "8612019b-dfe5-3eb8-8fd0-7ff98d07e247",
                                                "text": "As Hickerson points out, a glider aimed at a faraway blinker or preblock has only 8 cells, but can be arranged to run as long as you want."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9f01e1-9493-37e7-9c4b-73129894b275",
                                        "entry_id": "c9e58698-bd67-3be5-8a57-f1f3dcba9473",
                                        "glosses": [
                                            "A situation where the light of a dab pen or vape starts blinking, which happens when the user takes an extremely long hit."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4431a23a-87d3-4e42-b38c-1b2502c40d9c",
                                                "sense_id": "dd9f01e1-9493-37e7-9c4b-73129894b275",
                                                "text": "a double blinker (hitting blinkers on two pens simultaneously)"
                                            },
                                            {
                                                "example_id": "4af49684-8132-4c3f-ae8b-0a2b110f861f",
                                                "sense_id": "dd9f01e1-9493-37e7-9c4b-73129894b275",
                                                "text": "I just hit a blinker."
                                            },
                                            {
                                                "example_id": "ec76ce6f-3e36-4d0a-b3dd-37c240f086d1",
                                                "sense_id": "dd9f01e1-9493-37e7-9c4b-73129894b275",
                                                "text": "When you just hit 2 back to back blinkers off the dab pen and you trying to hold your cough around people"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blinker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b8cf63b-2ebb-3e39-8b22-2b80632a2102",
                                        "entry_id": "5c4bf717-365d-38f6-b1a6-d3eca6f1fe43",
                                        "glosses": [
                                            "To put blinkers on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0151ef6-9dc6-49de-bfc0-54d227a63bd9",
                                                "sense_id": "3b8cf63b-2ebb-3e39-8b22-2b80632a2102",
                                                "text": "The farmer stopped to blinker his horse before riding into an area of heavy traffic."
                                            }
                                        ]
