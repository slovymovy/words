                "senses": [
                    {
                        "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                        "entry_id": "5fc2631e-82ef-3fe0-bd7b-91decf9912e9",
                        "glosses": [
                            "explosiver Stoff aus Salpeter, Holzkohle und säurefreiem Schwefel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ca7453-686a-4c29-ae1a-bf6a4e369ad9",
                                "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                                "text": "Schwarzpulver sollte man trocken aufbewahren."
                            },
                            {
                                "example_id": "5dd0ee05-d5fd-4c3a-a364-70eda834b349",
                                "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                                "text": "„Die sechsunddreißig Steuerbordsträflinge wurden ins Gefängnis beordert, um das Deck zu schrubben und den gesamten Raum mit Essig zu reinigen, bevor er mit Schwarzpulver ausgeschwefelt werden sollte.“"
                            },
                            {
                                "example_id": "078f0177-46b4-40e0-bea6-f3c2bf3de3f4",
                                "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                                "text": "„Hin und wieder benutzten sie auch Schwarzpulver, um große Felsen zu sprengen, und zwischen dem größer werdenden Steinbruch und dem Bauplatz fuhr eine Kipplore, mit der die sorgfältig zugerichteten Steine abtransportiert wurden.“"
                            },
                            {
                                "example_id": "c765b92a-d58c-4fe8-9680-686043c6359b",
                                "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                                "text": "„Dort saß er viele Stunden lang und machte kleine Experimente, die immer ehrgeiziger wurden – er hatte es sogar fertiggebracht, Schwarzpulver herzustellen.“"
                            },
                            {
                                "example_id": "803e9950-4060-44c7-9747-6777b4bd3a0d",
                                "sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
                                "text": "„Das Material ist seit der Erfindung des Schwarzpulvers durch die Chinesen im frühen Mittelalter sehr begehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aee8697b-f3d4-4d9a-9e2a-aadf2ebd60ae",
                        "source_entry_id": "5fc2631e-82ef-3fe0-bd7b-91decf9912e9",
                        "source_sense_id": "08e09706-2043-3370-a860-d6fa0d95ce71",
