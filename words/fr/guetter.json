{
    "word_family": [
        "guet",
        "guetteur",
        "guetteuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffa42faa-9ed4-3ea2-9959-ea76cd66af94",
                    "sense_definition": "Surveiller attentivement quelqu'un ou un animal avec l'intention de le surprendre ou de l'attraper.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Immobile au milieu des herbes hautes, le félin <w>guette</w> sa proie avec une grande patience."
                        },
                        {
                            "text": "Les policiers en civil <w>guettaient</w> discrètement les suspects depuis une voiture banalisée."
                        }
                    ],
                    "synonyms": [
                        "épier",
                        "surveiller"
                    ],
                    "common_phrases": [
                        "guetter sa proie",
                        "guetter les moindres faits et gestes"
                    ]
                },
                {
                    "sense_id": "4e2af076-fd09-3ee2-a568-c7b90cf1d29a",
                    "sense_definition": "Attendre avec vigilance ou impatience l'arrivée ou le passage de quelqu'un ou de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant impatient <w>guette</w> le facteur derrière la vitre pour recevoir son colis d'anniversaire."
                        },
                        {
                            "text": "Nous avons passé la soirée sur le balcon à <w>guetter</w> les étoiles filantes dans la nuit claire."
                        }
                    ],
                    "synonyms": [
                        "attendre"
                    ],
                    "common_phrases": [
                        "guetter l'arrivée",
                        "guetter le facteur"
                    ]
                },
                {
                    "sense_id": "28de2bc2-8faf-398e-9f87-ea7d1c50c47d",
                    "sense_definition": "Se tenir prêt à saisir une opportunité ou un instant propice pour agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune entrepreneur <w>guette</w> le moment propice pour faire son offre de rachat."
                        },
                        {
                            "text": "Elle prépare soigneusement son dossier et <w>guette</w> l'occasion d'en parler à sa directrice."
                        }
                    ],
                    "common_phrases": [
                        "guetter l'occasion",
                        "guetter le moment propice"
                    ]
                },
                {
                    "sense_id": "9d3e6dd7-d280-399c-82c6-d8ef228d91a6",
                    "sense_definition": "Menacer de façon imminente, en parlant d'un péril, d'une maladie ou d'un événement néfaste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "menace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si les marins ne font pas attention, de terribles tempêtes les <w>guettent</w> au large de cette côte."
                        },
                        {
                            "text": "Le médecin a prévenu son patient que le surmenage le <w>guettait</w> sans une période de repos complet."
                        }
                    ],
                    "synonyms": [
                        "menacer"
                    ],
                    "common_phrases": [
                        "danger qui guette",
                        "la mort le guette"
                    ]
                },
                {
                    "sense_id": "caec1fc5-38ec-3e70-b2ed-60336d8e2911",
                    "sense_definition": "Jeter un coup d'œil, regarder attentivement ou observer brièvement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viens voir dehors un instant et <w>guette</w> ce qui se passe dans la cour du voisin."
                        },
                        {
                            "text": "Pendant le concert, il <w>guettait</w> discrètement vers l'entrée pour voir si ses amis arrivaient."
                        }
                    ],
                    "synonyms": [
                        "regarder"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régionalisme, principalement au Canada francophone"
                        }
                    ]
                }
            ]
        }
    ]
}