                                        "sense_id": "20928bdc-4dc1-3012-9b68-b707b37c613f",
                                        "entry_id": "c4762f38-2392-36e3-9683-0d7c76b9d244",
                                        "glosses": [
                                            "To attempt to take away a ball."
                                        ],
