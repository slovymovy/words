                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6448444d-1723-30d8-b4d7-4f9fab101739",
                                        "entry_id": "2b1ca2a3-efc0-3acf-b158-0a991c0e69af",
                                        "glosses": [
