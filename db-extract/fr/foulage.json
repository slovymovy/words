                    {
                        "translation_id": "1aa08d3f-13e5-4892-9b78-92f62d928a8e",
                        "source_entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "source_sense_id": "0c95351f-336b-3021-89ae-6fefd40d4152",
                        "source_sense_description": "Piétinement, dans un fouloir, des raisins pour en extraire le jus.",
                        "target_lang_word": "Maische",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maische",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7c0ad33-ccde-3eaf-9055-4f94c9015a05",
                                        "entry_id": "811c64ef-fa50-306f-8b1c-de1690801a20",
                                        "glosses": [
                                            "für die Gewinnung von Wein, Bier etc. hergestelltes stärke- und zuckerhaltiges Gemisch aus Obst oder Feldfrüchten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb7f772-e9ff-4be7-b77f-8e7e202a4ed3",
                                                "sense_id": "e7c0ad33-ccde-3eaf-9055-4f94c9015a05",
                                                "text": "„Aus geschrotetem Malz und Wasser entsteht Maische, die geklärt (»geläutert«) wird, der feste Rückstand dient als Tierfutter.“"
                                            },
                                            {
                                                "example_id": "b1701846-ad06-4e0f-9c9b-b15318c55268",
                                                "sense_id": "e7c0ad33-ccde-3eaf-9055-4f94c9015a05",
                                                "text": "„Wenn sie dort drüben die Maische für Astra oder Carlsberg kochen, zieht süßer Malzgeruch durch die Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32d20e4d-ad86-3767-956a-8280d2f46667",
                                        "entry_id": "811c64ef-fa50-306f-8b1c-de1690801a20",
                                        "glosses": [
                                            "zerquetschte und gemahlene Trauben vor der Kelterung"
                                        ],
                                        "tags": [
                                            "speziell Weinbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b898b4c-2941-4c7f-80aa-ae99fae28cd2",
                                                "sense_id": "32d20e4d-ad86-3767-956a-8280d2f46667",
                                                "text": "„Ein zu langes Stehenlassen auf der Maische kann […] zu verstärkter Aufnahme von Gerbstoffen und Hochfarbigkeit führen.“"
                                            },
                                            {
                                                "example_id": "1376f8d4-0a3e-489c-990a-f49fbf1e01c8",
                                                "sense_id": "32d20e4d-ad86-3767-956a-8280d2f46667",
                                                "text": "„Die Maische, die nach dem Zerstampfen und Pressen der Trauben für den eigenen Wein übrig blieb, wurde in einem Kupfertopf über der Feuerstelle gekocht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
