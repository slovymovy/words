                        "sense_id": "27d79738-0749-3df5-b2a6-751d86229ed0",
                        "entry_id": "3ec4134c-c209-3c70-94e7-83843401d190",
                        "glosses": [
                            "ich habe die Lösung gefunden"
                        ],
                        "tags": [
                            "Ausruf im Sinne von"
                        ],
                        "examples": [
                            {
                                "example_id": "79d2a597-aaa6-4109-80c5-14a259b6d065",
                                "sense_id": "27d79738-0749-3df5-b2a6-751d86229ed0",
                                "text": "„Als Archimedes, bezeichnenderweise in der Badewanne, das Prinzip des fortan nach ihm benannten statischen Auftriebs entdeckt hatte, war er von seinem Fund so begeistert, dass er aus der Wanne sprang, nackt durch die Straßen von Syrakus rannte und ein ums andere Mal »Heureka!« rief: »Ich hab’s gefunden!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f3a160e-5df2-401d-98bf-cdb5c6d1ab7a",
                        "source_entry_id": "3ec4134c-c209-3c70-94e7-83843401d190",
                        "source_sense_id": "27d79738-0749-3df5-b2a6-751d86229ed0",
                        "source_sense_description": "Ausruf im Sinne von: ich habe die Lösung gefunden",
                        "target_lang_word": "eureka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eureka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb7d0d5-1cbc-3401-ab78-9e4e02e8179d",
                                        "entry_id": "a95d4981-7cc8-31c2-a721-ba0ffd84d804",
                                        "glosses": [
                                            "An exclamation indicating a sudden discovery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83534df-a2a8-4623-9488-847423a01304",
                                                "sense_id": "cfb7d0d5-1cbc-3401-ab78-9e4e02e8179d",
                                                "text": "Eureka! I have found it! What I mean / To say is, not that love is idleness, / But that in love such idleness has been / An accessory, as I have cause to guess."
                                            },
                                            {
                                                "example_id": "27315a9a-0342-440f-95a2-5f85d850398f",
                                                "sense_id": "cfb7d0d5-1cbc-3401-ab78-9e4e02e8179d",
                                                "text": "\"Eureka!\" he cried, his teeth shining through his beard. \"Gentlemen, you may congratulate me and we may congratulate each other. The problem is solved.\""
                                            },
                                            {
                                                "example_id": "79c2f174-b75f-4800-a2ac-a167711cdab6",
                                                "sense_id": "cfb7d0d5-1cbc-3401-ab78-9e4e02e8179d",
                                                "text": "A page is turned - eureka, a snatch of tune / is playing itself, the piss-proud syllables / are unveiling a difficult prosody."
                                            }
                                        ]
                                    }
                                ]
                            },
