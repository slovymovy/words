                        "entry_id": "aa0a8eb5-de7f-322a-ab5e-ee5d8bf6e3f1",
                        "glosses": [
                            "A fine smooth-faced woolen cloth for men’s garments, usually of double width (i.e., a yard and a half); so called in distinction from woolens three quarters of a yard wide."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a00826a5-5449-4892-8e3c-25929b0dcde5",
                                "sense_id": "590a01da-3439-3f84-9cbd-cd4181edeea5",
                                "text": "The look of hurt fury which she hurled at the Bishop's back might have singed his clerical broadcloth."
                            }
                        ]
                    }
