                        ],
                        "examples": [
                            {
                                "example_id": "266de879-7009-477d-8803-8a783b922ec0",
                                "sense_id": "df205281-aba7-39fe-beda-f30d3f6532c2",
                                "text": "Vanwege de storm en ijsvorming op het spoor schokte de passagierstrein hevig.",
                                "translation": "Because of the storm and the formation of ice on the tracks, the passenger train shook vehemently.",
                                "english": "Because of the storm and the formation of ice on the tracks, the passenger train shook vehemently."
