{
    "word_family": [
        "repertory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0238e0ff-b93d-3694-913d-19354f78f31b",
                    "sense_definition": "A collection of plays, songs, or performances that a person or group is prepared to present.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra added several new pieces to their <w>repertoire</w> this season.",
                            "target_lang_translations": {
                                "zh": "这个乐季，管弦乐队在他们的<w>曲目</w>中增加了几首新作品。"
                            }
                        },
                        {
                            "text": "She has a wide <w>repertoire</w> of jazz songs that she performs regularly.",
                            "target_lang_translations": {
                                "zh": "她有很广的爵士乐<w>曲目</w>，经常进行表演。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collection",
                        "range"
                    ],
                    "common_phrases": [
                        "expand repertoire"
                    ],
                    "target_lang_definitions": {
                        "zh": "个人或团体准备表演的剧目、歌曲或节目的总称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保留剧目",
                                "target_lang_sense_clarification": "指演员或剧团经常演出的剧目。"
                            },
                            {
                                "target_lang_word": "曲目",
                                "target_lang_sense_clarification": "指音乐家或乐团准备演奏的乐曲清单。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b4a5f1-8ef5-3b63-8a97-fbc9da4bc88d",
                    "sense_definition": "The range of skills, abilities, or experiences that a person possesses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef has a vast <w>repertoire</w> of cooking techniques learned over many years.",
                            "target_lang_translations": {
                                "zh": "这位厨师拥有多年积累的丰富烹饪<w>技能库</w>。"
                            }
                        },
                        {
                            "text": "He needs to add more problem-solving skills to his professional <w>repertoire</w>.",
                            "target_lang_translations": {
                                "zh": "他需要为自己的职业<w>技能库</w>增加更多解决问题的能力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skillset",
                        "abilities"
                    ],
                    "target_lang_definitions": {
                        "zh": "一个人所具备的技能、能力或经验的范围。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "技能库",
                                "target_lang_sense_clarification": "指一个人掌握的各种技能的集合。"
                            },
                            {
                                "target_lang_word": "本领",
                                "target_lang_sense_clarification": "指个人所拥有的能力或手段。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e72e0df6-5a92-35e0-bc68-39acd020862c",
                    "sense_definition": "A general collection or body of items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library holds a vast <w>repertoire</w> of historical documents from the region.",
                            "target_lang_translations": {
                                "zh": "图书馆收藏了该地区大量的历史文献<w>汇编</w>。"
                            }
                        },
                        {
                            "text": "The artist draws from a diverse <w>repertoire</w> of cultural influences in her work.",
                            "target_lang_translations": {
                                "zh": "这位艺术家的作品汲取了多元文化的<w>储备</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assortment",
                        "stock"
                    ],
                    "target_lang_definitions": {
                        "zh": "某类事物的总汇或集合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "汇编",
                                "target_lang_sense_clarification": "指资料或作品的集合。"
                            },
                            {
                                "target_lang_word": "储备",
                                "target_lang_sense_clarification": "指可供使用的资源或物品的集合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14822538-3499-3a51-ae89-cf5ba1dafaa0",
                    "sense_definition": "The set of sounds or calls produced by a specific animal, especially a bird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mockingbird has an impressive <w>repertoire</w> of songs it can mimic.",
                            "target_lang_translations": {
                                "zh": "嘲鸫拥有一套令人印象深刻的、可以模仿的<w>鸣叫声库</w>。"
                            }
                        },
                        {
                            "text": "Researchers studied the vocal <w>repertoire</w> of the songbird during the mating season.",
                            "target_lang_translations": {
                                "zh": "研究人员研究了鸣禽在交配季节的<w>鸣叫声库</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "特定动物（尤其是鸟类）所能发出的声音或鸣叫的集合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸣叫声库",
                                "target_lang_sense_clarification": "指动物发出的各种声音的集合。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31cfe4eb-ad25-3eef-93cf-e126efbf2f53",
                    "sense_definition": "A defined set of characters or symbols used in computing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software supports a wide character <w>repertoire</w> for international languages.",
                            "target_lang_translations": {
                                "zh": "该软件支持用于国际语言的广泛<w>字符集</w>。"
                            }
                        },
                        {
                            "text": "Developers must ensure the font includes the entire required <w>repertoire</w>.",
                            "target_lang_translations": {
                                "zh": "开发人员必须确保字体包含所需的全部<w>字符集</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "character set"
                    ],
                    "target_lang_definitions": {
                        "zh": "计算机中使用的特定字符或符号集合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "字符集",
                                "target_lang_sense_clarification": "计算机术语，指系统支持的字符范围。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288b2ded-8a7c-31d9-9af0-3a4d69353bb7",
                    "sense_definition": "The complete set of instructions that a computer processor can execute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new chip features an expanded instruction <w>repertoire</w> for faster processing.",
                            "target_lang_translations": {
                                "zh": "这款新芯片具有扩展的<w>指令集</w>，以实现更快的处理速度。"
                            }
                        },
                        {
                            "text": "Engineers analyzed the processor <w>repertoire</w> to optimize the system performance.",
                            "target_lang_translations": {
                                "zh": "工程师分析了处理器<w>指令集</w>以优化系统性能。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instruction set"
                    ],
                    "target_lang_definitions": {
                        "zh": "计算机处理器能够执行的完整指令集。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "指令集",
                                "target_lang_sense_clarification": "计算机体系结构中处理器支持的指令集合。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}