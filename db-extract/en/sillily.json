                        "glosses": [
                            "In a silly manner; foolishly."
                        ],
                        "tags": [
                            "dated",
                            "hypercorrect"
                        ],
                        "examples": [
                            {
                                "example_id": "57301c90-13a4-48a6-8b88-0bda07f22107",
                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                "text": "The man walked down the street so sillily that many a bystander stopped and stared slack-jawed."
                            },
                            {
                                "example_id": "51ae79a0-412f-4190-b3b2-8297f32d6491",
                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                "text": "It was a fish-trap—just a ring of reeds set up in the water with only one little opening in it, and in this opening, just below the water, were stuck reeds slanting the way of the river's flow, so that the fish, when they had swum sillily in, sillily couldn't get out again."
                            },
                            {
                                "example_id": "eae69aa3-451d-4ce1-a854-a5deefd1e440",
                                "sense_id": "4555398f-4058-39ce-9590-6b2a341e34a4",
                                "text": "Even 'Che Isa [...] had behaved sillily, making up to married men."
                            }
                        ]
                    }
                ],
