                        "glosses": [
                            "Beyond reproach; unimpeachable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d49bb8-2ed4-4fd5-90a1-9ce6be384792",
                                "sense_id": "d06abc46-5372-3b64-ba8c-93f8cf78259a",
                                "text": "My turn-out was unexceptionable; men copied my running-shoes; my jacket and trowsers were an admiration; my bat perfection; I was the very picture of a cricketer, but, alas! very little more than a picture."
                            }
                        ]
