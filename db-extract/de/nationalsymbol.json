                "senses": [
                    {
                        "sense_id": "8dab85c6-c5b7-3ce8-893e-3f857f546b22",
                        "entry_id": "d0979c9d-d565-34d0-9fab-8e128c2a53ab",
                        "glosses": [
                            "mit einer Nation/nationaler Identifikation verbundenes Symbol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3031c0-c417-4e6f-a6c7-33e8ce456acc",
                                "sense_id": "8dab85c6-c5b7-3ce8-893e-3f857f546b22",
                                "text": "„Mehrere arabische Bauern, die das Land gepachtet hatten, wurden vertrieben, und als sichtbarer Beweis der zionistischen Bestrebungen, die Araber zu enteignen wurde Al-Fula zu einem arabischen Nationalsymbol.“"
                            },
                            {
                                "example_id": "3b112eca-6f6e-4c23-853b-d32c4ea4095d",
                                "sense_id": "8dab85c6-c5b7-3ce8-893e-3f857f546b22",
                                "text": "„Begin war ein Mann der großen Worte, die vor allem auch dann in seinen flammenden Reden nicht fehlen durften, wenn es um die Überhöhung des Tempelbergs und der Klagemauer als Nationalsymbole ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
