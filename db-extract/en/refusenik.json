                    },
                    {
                        "translation_id": "74535db2-07c3-48a2-9b58-beec3d8d4092",
                        "source_entry_id": "9d55c190-45ba-3a35-a670-5e2eef9b4c4a",
                        "source_sense_description": "one of the citizens of the former Soviet Union who was refused permission to emigrate",
                        "target_lang_word": "refuznik",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refuznik",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f48768-5bf5-3291-9f40-9d9e9fc32c9f",
                                        "entry_id": "17587622-1071-3de9-98f5-3da03183c327",
                                        "glosses": [
                                            "En URSS et dans les pays de l’Est, personne à qui certains droits ont été refusés, notamment celui d'émigrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d41cfb-7d04-4bc3-a1ed-7d77d371fbfb",
                                                "sense_id": "a4f48768-5bf5-3291-9f40-9d9e9fc32c9f",
                                                "text": "Il se prénommait alors Anatoli et c’était l’un des plus célèbres refuzniks de l’Union soviétique (terme désignant les juifs soviétiques qui demandaient à émigrer)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4aa8f28-f572-375d-8f20-e1617552e02c",
                                        "entry_id": "17587622-1071-3de9-98f5-3da03183c327",
                                        "glosses": [
                                            "personne qui refuse de participer aux activités obligatoires, tel le service militaire (des objecteurs de conscience)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f12784f-0e8d-411d-aab0-ddaed3905d19",
                                                "sense_id": "e4aa8f28-f572-375d-8f20-e1617552e02c",
                                                "text": "Qui peut dire à ce jour ce que risque un jeune religieux « refuznik » ?"
                                            },
                                            {
                                                "example_id": "6d17d5be-3e46-4118-8163-f9b160852395",
                                                "sense_id": "e4aa8f28-f572-375d-8f20-e1617552e02c",
                                                "text": "« Cet argent appartient aux retraités. Nous sommes prêts à aller devant le Conseil constitutionnel », menace l’un des refuzniks."
                                            },
                                            {
                                                "example_id": "cac2739f-fd9a-4e53-be19-b98584d90dde",
                                                "sense_id": "e4aa8f28-f572-375d-8f20-e1617552e02c",
                                                "text": "Refuzkniks de tous les pays, éclipsez-vous !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
