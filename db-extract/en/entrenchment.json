                                    },
                                    {
                                        "sense_id": "3c49a799-4c8e-3eef-8f47-9da5c9c55761",
                                        "entry_id": "e0d9bef9-0a5d-32f3-9535-0ccfb566c6f5",
                                        "glosses": [
                                            "Bollwerk zum Schutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57d2aca-1477-4ed7-a14c-01df33e5d2b8",
                                                "sense_id": "3c49a799-4c8e-3eef-8f47-9da5c9c55761",
                                                "text": "„Er war noch nicht bei der im Bau befindlichen Verschanzung angelangt, als er in der abendlichen Dämmerung des trüben Herbsttages eine Anzahl Reiter auf sich zukommen sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0628407d-8b4c-3b62-b891-184c797dc6c3",
