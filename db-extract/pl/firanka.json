                                        "sense_id": "40913f36-ada7-3d68-9a63-96aebbae9141",
                                        "entry_id": "d8e632a7-9b8f-3b86-81ab-c9c1cbab5d82",
                                        "glosses": [
                                            "zavěšený velký kus tkaniny, obvykle průsvitné, používaný k zakrytí okna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06cab0e7-dfae-49ca-b332-639b18d04975",
                                                "sense_id": "40913f36-ada7-3d68-9a63-96aebbae9141",
                                                "text": "Jarní větřík, ten šibal, odhrnuje záclony u mého okna a vpouští mi potutelně do pokojíka zlatý sluneční paprslek."
                                            },
                                            {
                                                "example_id": "09c7a231-f6f8-4080-9f27-5b83c746c62e",
                                                "sense_id": "40913f36-ada7-3d68-9a63-96aebbae9141",
                                                "text": "Dálo se to totiž při spuštěných záclonách, za nimiž se rozléhalo úpěnlivé volání o pomoc a zvířecký řev zhýralé společnosti. ... A za takovými okenicemi lze se cítit ještě více „v závětří“ než za spuštěnými záclonami!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
