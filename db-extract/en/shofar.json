                    {
                        "translation_id": "794152eb-88e1-438d-9b74-90c3f6112945",
                        "source_entry_id": "426306b2-576d-3610-97fa-0755437aec28",
                        "source_sense_id": "6e63a26e-93a3-3508-9550-b2571832a809",
                        "source_sense_description": "ram’s-horn trumpet",
                        "target_lang_word": "Schofar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schofar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                        "entry_id": "2e24a19b-c6df-35ad-a543-f32e7370c56c",
                                        "glosses": [
                                            "kultisch gebrauchtes, posaunenähnliches Instrument aus Widderhorn, das nach in Thora und Talmud zur Tonfolge und Blasweise festgelegten Mitzwoth unter anderem zum Ankündigen des Sabbats, zum Morgengottesdienst an Rosch ha-Schana sowie zum Ende des Jom Kippur geblasen wird"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e8a5ea-4ab4-42b2-9d96-3a6fd18fc02c",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„In der Synagoge blies man das Schofar [sic], und es klang wie ein einsamer Weckruf in alle Gassen, hinweg über alle Häuser, – wie ein Ruf aus den dunklen Tiefen der Kabbala.“"
                                            },
                                            {
                                                "example_id": "5020accf-7349-4ac5-8ddd-f736444e2a4e",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„Entsprechend der Kabbala (jüdische Mystik) müssen mindestens zehn Geistliche um Mitternacht im Schein schwarzer Kerzen in einer Synagoge zusammenkommen und den Schofar blasen, nachdem sie gemeinsam den vorgeschriebenen Text gelesen haben.“"
                                            },
                                            {
                                                "example_id": "9b57afb8-3525-49b1-94b1-b3420db259ce",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„Zum Jahreswechsel war ich in der Dorfsynagoge nebenan, Tante Hilde fragte misstrauisch, was ich dort wolle, dann aber schickte sie mich mit einem ältern Herrn aus dem Kibbuz mit, der den Weg kannte, wir mussten vier Kilometer laufen, ich saß unter den Männern bis der Schofar geblasen wurde.“"
                                            },
                                            {
                                                "example_id": "351ea013-c50a-42f1-be87-ce979e753287",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„Der Schofar, dieses im jüdischen Ritual geblasene Horn, das wie der Schrei eines geopferten Tiers klingt, kann aufgefasst werden als eine solche unverständliche, \"inhaltlose, zum Gesetz gehörige Stimme, als die seinen Buchstaben untermauernde Stütze des Gesetzes\", die alle Bündnisse des Volks Israel mit Gott begleitet.“"
                                            },
                                            {
                                                "example_id": "cd01540a-10e4-4a2a-9fdc-8c5a512aa053",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„Sollten wir an den Hohen Feiertagen durch den Ruf des Schofarhorns zur Buße angehalten werden, oder ist es besser, das Schofar [sic] nicht zu hören, weil es an einem Schabbat nicht getragen werden darf?“"
                                            },
                                            {
                                                "example_id": "37b569a3-ffa9-47fa-be27-7fe378975450",
                                                "sense_id": "5ebabf92-987d-32c3-b2d1-4863c5c80400",
                                                "text": "„Als Vorbild diente dem Architekten das Schofar [sic], das gefurchte Widderhorn, welches von alters her an hohen jüdischen Festtagen geblasen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
