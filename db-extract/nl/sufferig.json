                        "translation_id": "54ff5b7c-6889-402b-aa23-6b5a3cb90c15",
                        "source_entry_id": "7ccd6e6e-50f5-3181-b713-fc5dcf8eb0ed",
                        "source_sense_id": "f86f2286-51fa-3da0-a049-af126ef681a6",
                        "source_sense_description": "dom",
                        "target_lang_word": "dullard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dullard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9227e7a-7d28-3d03-8d3d-c93b3df2e102",
                                        "entry_id": "69a443f8-52e2-3e2c-9026-755e80799605",
                                        "glosses": [
                                            "A stupid person; a fool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca079b7e-2e31-46c5-9612-71b7b8a17dcf",
                                                "sense_id": "f9227e7a-7d28-3d03-8d3d-c93b3df2e102",
                                                "text": "Oh! Richard of Bury, I sighed, for a sharp stone from your sling to pierce with indignant sarcasm the mental armour of these college dullards."
                                            },
                                            {
                                                "example_id": "22b2ea97-43c8-4cde-843b-2c47790a580a",
                                                "sense_id": "f9227e7a-7d28-3d03-8d3d-c93b3df2e102",
                                                "text": "Whereas some prodigies develop at an early age, Einstein did not exhibit any great genius as a young child. Some people thought he was a dullard."
                                            },
                                            {
                                                "example_id": "dfc4ce0a-d634-431c-b474-acf753becfc5",
                                                "sense_id": "f9227e7a-7d28-3d03-8d3d-c93b3df2e102",
                                                "text": "Marion has long since stopped listening. \"You dullard,\" she says now she can finally speak, \"I'm your chief of Antimemetics.\""
                                            },
                                            {
                                                "example_id": "ea643e1c-d946-4c83-857b-c7d60055fbd0",
                                                "sense_id": "f9227e7a-7d28-3d03-8d3d-c93b3df2e102",
                                                "text": "“Okay. What if we send him to a very selective private school so he doesn't have to worry about rubbing shoulders with street tramps and dullards?” “No. We have plenty of good public schools here, and they're free.” “I thought you were doing the accounting. Isn't the nightclub swimming in the trillions?” “No, we need that money to fix the house. And I wouldn't say \"trillions.\" No, definitely not.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
