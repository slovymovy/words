                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e72c4624-f644-4eb3-abde-9d56a8d08c87",
                        "source_entry_id": "1484a6e5-99a1-342c-b6bc-a63e6865bf70",
                        "source_sense_description": "ласк. к сущ. история в значении «рассказ, повествование»",
                        "target_lang_word": "historiette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historiette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                        "entry_id": "9ae04ceb-18f5-384b-a5ed-b6f8fb0ed63e",
                                        "glosses": [
                                            "Court récit de quelque aventure galante ou plaisante, ou d’autres choses de peu d’importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d2dac7-43d6-4024-9856-ac9da745c233",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "Lorsqu’il taillait un gros bloc, ou le sciait en long, il commençait toujours une petite chanson dans laquelle il y avait toute une historiette qu’il bâtissait à mesure qu’il allait, en vingt ou trente couplets, plus ou moins."
                                            },
                                            {
                                                "example_id": "17016551-d12e-450b-a4d5-4906e5401f9b",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "Quand la directrice racontait de gentilles historiettes : « Vos parents sont bons — ils n’agissent que pour votre bien — votre papa et votre maman se donnent beaucoup de peine pour que vous ne manquiez de rien… » je me suis souvent demandé comment elle n’était pas fascinée par le poche-œil de Gaston Fondant irradiant vert, jaune, noir, à la rencontre de ses paroles."
                                            },
                                            {
                                                "example_id": "fde7a402-e4da-4f59-a92b-d4ae5340b3ae",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "S’il entend son métier [de conteur], il doit entremêler habilement ses historiettes, et entre deux vertes avoir soin d’en faire passer une mûre."
                                            },
                                            {
                                                "example_id": "4733c1b9-9094-44cf-b13f-7c5371c769a8",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "À ce propos, une historiette : Au premier voyage qu’elles firent […]."
                                            },
                                            {
                                                "example_id": "d0a5c9cd-ab9e-4349-a5a5-caa1a4f0f28f",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "Je me suis moi-même diverti, moins des calembredaines qui ont traîné les rues et dont beaucoup furent inventées, que des historiettes qui me furent contées par des témoins auriculaires."
                                            },
                                            {
                                                "example_id": "c120095a-26fc-4a56-b542-2d15e675dc04",
                                                "sense_id": "7f1670c2-70cf-3d2a-bdce-f93cdcf5bf0c",
                                                "text": "Une historiette très significative exprime parfaitement cet état de fait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
