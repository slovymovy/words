                        "entry_id": "391b2bb3-9f29-31f6-a38c-468566202139",
                        "glosses": [
                            "Having grammatical gender."
                        ],
                        "tags": [
                            "of a language"
                        ],
                        "examples": [
                            {
                                "example_id": "5673b36c-3213-4f2b-a730-c4709b2aa634",
                                "sense_id": "0be77bd4-8c84-38ac-9fd1-e9306b7c5e82",
                                "text": "Grammatically, Hebrew is a gendered language because every noun is either masculine or feminine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8aa42b5-baa5-3046-88ba-ba3bb65f9580",
                        "entry_id": "391b2bb3-9f29-31f6-a38c-468566202139",
                        "glosses": [
                            "Having attributes associated with gender."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a39e56-56d3-41bc-a75a-2548bd30825a",
                                "sense_id": "c8aa42b5-baa5-3046-88ba-ba3bb65f9580",
                                "text": "Not surprisingly this differentiation of children by means of gendered clothing both reflects and reinforces traditional gender representations and identities already dominant within our contemporary society."
                            }
                        ]
                    },
                    {
                        "sense_id": "2322a3bc-f9cf-3b0b-8d49-5087e63a80ba",
                        "entry_id": "391b2bb3-9f29-31f6-a38c-468566202139",
                        "glosses": [
                            "Divided by gender."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78de9912-7479-441b-969e-0af83b3e00b5",
                                "sense_id": "2322a3bc-f9cf-3b0b-8d49-5087e63a80ba",
                                "text": "In the past, parenting was a more gendered activity with more distinct male and female roles."
                            }
                        ]
                    }
                ],
