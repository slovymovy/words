                "senses": [
                    {
                        "sense_id": "559e2780-9de0-3e3e-a1a2-2cd838d7f15e",
                        "entry_id": "a5194bac-d9cd-364a-b697-4d2729aa5ede",
                        "glosses": [
                            "Faire une incursion quelque part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b809e1-1300-480a-8eb2-55dd228730fc",
                                "sense_id": "559e2780-9de0-3e3e-a1a2-2cd838d7f15e",
                                "text": "Sortons du domaine de la Fantaisie pour incursionner dans le champ du Paradoxe afin, après, si nous en demeure le loisir, de faire un bond sur le tapis de l’Actualité."
                            },
                            {
                                "example_id": "c7893c67-fdf9-426e-b230-08145da76214",
                                "sense_id": "559e2780-9de0-3e3e-a1a2-2cd838d7f15e",
                                "text": "Pour le coup, un brin de chagrin lui vient, léger filet de vieille tendresse plus ou moins éventée. Il incursionne dans son passé, le Président."
                            }
                        ]
                    }
