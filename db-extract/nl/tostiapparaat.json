                        "examples": [
                            {
                                "example_id": "6dcc3018-379c-40e2-a712-6389f9fc0f41",
                                "sense_id": "475e7ad4-1091-3e4b-aa25-8f4db8e19c0d",
                                "text": "We lopen de keuken in. Op het aanrecht staat een tostiapparaat, in de berging wacht een lege wasmand om gevuld te worden."
                            },
                            {
                                "example_id": "ddda32df-d5c1-4dc2-b0ea-a46e7db34a3d",
                                "sense_id": "475e7ad4-1091-3e4b-aa25-8f4db8e19c0d",
                                "text": "‘Ik wil mensen laten zien wat de oorsprong is van de apparaten die ze dagelijks gedachteloos gebruiken. Een strijkijzer of een tostiapparaat, mobiele telefoons en printers - ze komen ergens vandaan. En als we ze niet meer nodig hebben, verdwijnen ze niet zomaar van onze planeet. Ik volg de weg die materialen afleggen."
                            }
                        ]
                    }
