                                "example_id": "b326570b-c590-4181-9605-03dae5a423e7",
                                "sense_id": "4aad5274-44c2-3411-af3b-69b07f9e2445",
                                "text": "Before me rose an avenue / Of tall and sombrous pines; / Abroad their fan-like branches grew, / And, where the sunshine darted through, / Spread a vapor soft and blue, / In long and sloping lines."
                            },
                            {
                                "example_id": "fd27544d-a560-44cc-b4a2-e23f3bec388d",
                                "sense_id": "4aad5274-44c2-3411-af3b-69b07f9e2445",
                                "text": "It was some time before my eyes became used to its artificial dusk, and I could make out the different animals leading their sombrous lives behind the glass by the light of a pale moon."
                            }
                        ]
                    }
