                "senses": [
                    {
                        "sense_id": "6fa47df5-a258-32a2-bd79-644aa411f3b6",
                        "entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "glosses": [
                            "To go to law; to carry on a lawsuit."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a948ef37-21f1-4f19-9cdb-82c7dfefd324",
                                "sense_id": "6fa47df5-a258-32a2-bd79-644aa411f3b6",
                                "text": "Ain't got no place to lay your head / Somebody came and took your bed / Don't worry, be happy / The landlord say your rent is late / He may have to litigate"
                            }
                        ]
                    },
                    {
                        "sense_id": "b66c066a-883d-3982-a42d-13084887b125",
                        "entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "glosses": [
                            "To contest in law."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "144374b2-06f4-3fa1-b118-52300e0022e3",
                        "entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "glosses": [
                            "To dispute; to fight over."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9216db38-4bfe-4251-b72f-08b9f198a27b",
                                "sense_id": "144374b2-06f4-3fa1-b118-52300e0022e3",
                                "text": "you can't keep litigating this same point!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6337de95-04f9-4bd5-87bf-ca2d2716cd12",
                        "source_entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "source_sense_description": "to go to law",
                        "target_lang_word": "procederen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procederen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a7c9b8-f3db-3112-b4b0-870a829c7850",
                                        "entry_id": "52132c51-9b51-3091-a8e2-f8f13fc91f3c",
                                        "glosses": [
                                            "een rechtsstrijd voeren"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7991f7a2-2316-4a68-bbef-bd3d9e97ee0c",
                                                "sense_id": "a8a7c9b8-f3db-3112-b4b0-870a829c7850",
                                                "text": "Zij procedeerden vele jaren maar het resultaat was nihil."
                                            },
                                            {
                                                "example_id": "c98825cf-f04c-4bc7-9ddd-7c56bc0abfeb",
                                                "sense_id": "a8a7c9b8-f3db-3112-b4b0-870a829c7850",
                                                "text": "Met een juridische spoedprocedure hoopt de vereniging van henneptelers de wet nog terug te kunnen draaien. Ook is Cusani, voorzitter van de vereniging, van plan om op Europees niveau te procederen. \"Daar zullen rechters ons gelijk geven, want volgens de Europese regels is het kweken van industriële hennep toegestaan.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddfb5187-820a-4649-af44-1d18f80aa84b",
                        "source_entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "source_sense_description": "to go to law",
                        "target_lang_word": "voor de rechter dagen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6762138f-f7cd-4fe3-b467-7a9b89e0b3e3",
                        "source_entry_id": "75cfafdd-98d9-379d-b719-71b84fb0420a",
                        "source_sense_description": "to go to law",
                        "target_lang_word": "prozessieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prozessieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                        "entry_id": "b86e1f63-c9ba-3316-a27a-3392b0400208",
                                        "glosses": [
                                            "gegen jemanden einen Rechtsstreit/Prozess führen"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02735c1-1030-4243-8e54-38f54667e8ea",
                                                "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                                "text": "Die Familie hat nicht genug Geld, um jahrelang prozessieren zu können."
                                            },
                                            {
                                                "example_id": "05f39713-1002-4960-8745-1a9ce5cad04f",
                                                "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                                "text": "Der alte Schmidt prozessierte gegen jeden in der Nachbarschaft."
                                            },
                                            {
                                                "example_id": "71336a2d-c5df-4f8e-958b-7541691c3020",
                                                "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                                "text": "„Sollte das Vorhaben in Wien scheitern, würde Sint auch nicht davor zurückschrecken, bis ‚zum Höchstgericht zu prozessieren‘, erklärte er gestern.“"
                                            },
                                            {
                                                "example_id": "168b8d0c-ef7c-4ecf-ab1f-e90b4230e6be",
                                                "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                                "text": "„Seit 2020 prozessieren ausgebildete Osteopathen gegen diese restriktive Handhabung.“"
                                            },
                                            {
                                                "example_id": "cccb2acb-acb9-472a-9bd6-0706dcf9871f",
                                                "sense_id": "23062caa-8f0d-33dd-8cdb-a736347d4b20",
                                                "text": "„Das bestreitet der Angeklagte vehement und hat deswegen auch schon erfolgreich prozessiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
