                "senses": [
                    {
                        "sense_id": "4a85f8d1-3c3e-319c-af70-37391f2c6e70",
                        "entry_id": "01ba9de1-fcce-304d-8222-3e3cf580e776",
                        "glosses": [
                            "Tötung eines Tieres, um es als Opfergabe darzubringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e0f042-b80b-45a7-9573-e7089ecd91c4",
                                "sense_id": "4a85f8d1-3c3e-319c-af70-37391f2c6e70",
                                "text": "„Neben Tier- und Menschenopfern fand man in Seen und Flüssen zahlreiche Waffen, Werkzeuge, Arbeitsgeräte, Schmuckstücke, Bronze- oder Eisenbarren und Münzen als Opfergaben.“"
                            },
                            {
                                "example_id": "5731cc69-150c-4290-9c0b-7a13cb0e141e",
                                "sense_id": "4a85f8d1-3c3e-319c-af70-37391f2c6e70",
                                "text": "„Beim Tieropfer wurde ein Teil des Fleisches verbrannt und damit der Gottheit geweiht, den anderen, wohl weit größeren Teil verspeiste die Kultgemeinde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
