                            {
                                "example_id": "c6d4eedd-35d3-41b3-865c-55399027eb8f",
                                "sense_id": "5b30772e-23ea-3a51-99c1-a3cf49b474fb",
                                "text": "Bertram hat einen Sohn mit einer Guatemaltekin."
