                        "examples": [
                            {
                                "example_id": "b443d49c-0580-4152-8cd3-f13f70e4100c",
                                "sense_id": "25a745a1-fbdc-3bef-9d00-216edb7a5e63",
                                "text": "Lʼintérêt de la détermination de deux plans d'analyse réside dans la possibilité quʼelle donne au sémiologue de ne plus devoir sʼinterroger sur la nature et la composition du signe de dénotation, ce premier « langage-objet »."
                            },
                            {
                                "example_id": "3b2c4552-3096-462f-8423-7b2eb93d9e50",
                                "sense_id": "25a745a1-fbdc-3bef-9d00-216edb7a5e63",
                                "text": "La chose la plus intelligente et la plus pertinente qui a été dite à propos des médias sociaux vient de l’écrivain et sémiologue italien, Umberto Eco."
                            }
                        ]
                    }
