                ],
                "senses": [
                    {
                        "sense_id": "979fbcae-f390-35c4-a4ab-05ad3c124086",
                        "entry_id": "96e2b8cb-e5fc-33d7-914f-6874efa66e12",
                        "glosses": [
                            "Landschaft, Gegend"
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0cc1a7-c45b-4569-84d6-e2a2f5817f46",
                                "sense_id": "979fbcae-f390-35c4-a4ab-05ad3c124086",
                                "text": "\"Wie sie ruh'n auf dem Gefilde,",
                                "translation": "Dunkle Nacht und herber Winter.\" - Chamisso, Nacht und Winter"
                            },
                            {
                                "example_id": "bed0cbc0-5333-42cb-8165-8681ec63d4b7",
                                "sense_id": "979fbcae-f390-35c4-a4ab-05ad3c124086",
                                "text": "Gerade jetzt im Winter sehne ich mich oft nach wärmeren Gefilden."
                            },
                            {
                                "example_id": "62407537-4f2e-4eac-bda8-5181b33bdb8a",
                                "sense_id": "979fbcae-f390-35c4-a4ab-05ad3c124086",
                                "text": "Durch allerlei schöne Gefilde bin ich spaziert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d4e88d8-1a58-3316-abcf-fa0dac742e71",
                        "entry_id": "96e2b8cb-e5fc-33d7-914f-6874efa66e12",
                        "glosses": [
                            "Bereich, Gebiet/Aufgabengebiet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "750b01f1-fe79-4334-beb5-716885e29fcb",
                                "sense_id": "6d4e88d8-1a58-3316-abcf-fa0dac742e71",
                                "text": "Aus dem Gefilde der Politik ausgetreten, ist er jetzt in der Wirtschaft tätig."
                            },
                            {
                                "example_id": "7e03ade1-a7ac-470b-b358-6b421b504270",
                                "sense_id": "6d4e88d8-1a58-3316-abcf-fa0dac742e71",
                                "text": "„Genau wie im Englischen hat das ! in den deutschen Gefilden noch viele Jahre, um in tägliche Texte Einzug zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
