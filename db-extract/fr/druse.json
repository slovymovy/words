                        ],
                        "examples": [
                            {
                                "example_id": "d9c394b3-fe6b-4556-9000-04ac60b51409",
                                "sense_id": "b77a94a7-1bcc-3bea-ac2d-8a1a960e96a7",
                                "text": "Le pilote parvint à se poser à temps […] Mais ils étaient au diable, sans eau ni vivres, dans une région en dissidence. Pour échapper aux Druses, particulièrement sauvages dans leur façon d’accueillir les Français, il fallait donc revenir à pied à Palmyre."
                            }
                        ]
                    }
