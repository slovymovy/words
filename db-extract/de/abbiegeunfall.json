                "senses": [
                    {
                        "sense_id": "1468be0f-3bc7-3ca4-99fd-fe08ed911ead",
                        "entry_id": "17e0b935-e943-36f3-8ba6-e0e2c82ccea6",
                        "glosses": [
                            "Unfall, der bei oder durch ein Abbiegemanöver eines der beteiligten Verkehrsteilnehmer passiert"
                        ],
                        "tags": [
                            "Unfalltyp"
                        ],
                        "examples": [
                            {
                                "example_id": "6d058191-d3d5-49c8-9949-0c266a9a1c45",
                                "sense_id": "1468be0f-3bc7-3ca4-99fd-fe08ed911ead",
                                "text": "„Um einen“ Abbiegeunfall „handelt es sich, wenn der Unfall durch einen Konflikt zwischen einem Abbieger und einem aus gleicher oder entgegengesetzter Richtung kommenden Verkehrsteilnehmer ausgelöst wurde.“"
                            },
                            {
                                "example_id": "23357d04-15f3-4fd5-852e-dbabe919153e",
                                "sense_id": "1468be0f-3bc7-3ca4-99fd-fe08ed911ead",
                                "text": "„Auf der Kreuzung von der B 38 mit dem Güterweg Thierberg kam es zum Abbiegeunfall, in den drei Autos verwickelt waren. Drei Verletzte mussten ins Krankenhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
