                                "target_senses": [
                                    {
                                        "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                        "entry_id": "969062f1-1ae9-302a-aa3f-7e5537453219",
                                        "glosses": [
                                            "Qui pénètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10738c57-3d16-4b7e-8f63-5ae513bb2a5a",
                                                "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                                "text": "Le ciel était nuageux, l'humidité pénétrante. Entre des éclaircies de soleil, des averses tombaient."
                                            },
                                            {
                                                "example_id": "5173274b-7dd2-4a1d-99fe-189f18b0d27e",
                                                "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                                "text": "Le sel est caustique et pénétrant."
                                            },
                                            {
                                                "example_id": "627bdb94-3dd5-4e08-a800-ae8416fd23d9",
                                                "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                                "text": "Liqueur pénétrante."
                                            },
                                            {
                                                "example_id": "2f2dd263-e240-4d17-8c9c-e7bcf3917558",
                                                "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                                "text": "Odeur pénétrante."
                                            },
                                            {
                                                "example_id": "95a9c244-265f-419d-98ca-0da24547a213",
                                                "sense_id": "3e0ba41f-b498-3ece-ad79-d5aab9bf31f1",
                                                "text": "Il fait un froid pénétrant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f3042f-0115-37e3-8a7b-60feb7d82e2e",
                                        "entry_id": "969062f1-1ae9-302a-aa3f-7e5537453219",
                                        "glosses": [
                                            "Qualifie une plaie qui pénètre dans une cavité du corps, dans la poitrine, dans le ventre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b7992b5-1d3d-38ce-bba2-3c9006e10f1f",
                                        "entry_id": "969062f1-1ae9-302a-aa3f-7e5537453219",
                                        "glosses": [
                                            "Qualifie une intelligence vive, qui approfondit promptement les choses difficiles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd79adca-d97a-41fe-802a-6f7a7f3df9ff",
                                                "sense_id": "4b7992b5-1d3d-38ce-bba2-3c9006e10f1f",
                                                "text": "Tous nos étudiants de japonais nous ont apporté une aide considérable par leurs questions franches et pénétrantes."
                                            },
                                            {
                                                "example_id": "506999ad-7007-4ac5-b868-9edf3e46d239",
                                                "sense_id": "4b7992b5-1d3d-38ce-bba2-3c9006e10f1f",
                                                "text": "Être pénétrant, avoir l’esprit pénétrant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508055a3-c2d3-32da-9399-2aaed3ae2a78",
                                        "entry_id": "969062f1-1ae9-302a-aa3f-7e5537453219",
                                        "glosses": [
                                            "Qualifie un regard qui peut lire, deviner, apercevoir ce que les personnes qu’il regarde ont dans l’esprit ou dans le cœur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad1ad5b-27a8-48c1-b23d-c6e082d014ab",
                                                "sense_id": "508055a3-c2d3-32da-9399-2aaed3ae2a78",
                                                "text": "Et pourquoi cela, Madame ? demanda Charles IX en fixant sur sa mère son œil vitreux qui, dans certaines occasions, devenait si pénétrant."
                                            },
                                            {
                                                "example_id": "25d723e3-40d9-45ce-b5cc-772ab2c654e4",
                                                "sense_id": "508055a3-c2d3-32da-9399-2aaed3ae2a78",
                                                "text": "Elle sentait bien qu’il ne l’aimait pas, qu’il en était très loin, au delà même de l’indifférence ; et elle était assez pénétrante pour démêler sous sa politesse quelque chose qui ressemblait plutôt à de l’aversion."
                                            },
                                            {
                                                "example_id": "f669580d-67b8-4de3-98a7-81648bceff9a",
                                                "sense_id": "508055a3-c2d3-32da-9399-2aaed3ae2a78",
                                                "text": "Des yeux trop pénétrants se posèrent sur ceux du jeune homme […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pénétrant",
