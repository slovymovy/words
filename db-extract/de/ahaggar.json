                                "example_id": "a6db8655-3a7e-4ff5-b032-bc7a3dca045e",
                                "sense_id": "7f14a775-1cc2-3865-9d36-c5c9610bf2fb",
                                "text": "Im Ahaggar gibt es viele Wadis."
                            },
                            {
                                "example_id": "41f9b439-964b-48fb-b1d7-2909816babac",
                                "sense_id": "7f14a775-1cc2-3865-9d36-c5c9610bf2fb",
                                "text": "Die höchste Erhebung im Ahaggar ist mit 3.003 Metern der Tahat."
                            },
                            {
                                "example_id": "2112da3d-3df7-45d0-963d-6a4241f5112c",
                                "sense_id": "7f14a775-1cc2-3865-9d36-c5c9610bf2fb",
                                "text": "Hauptort im Ahaggar ist Tamanrasset."
                            },
                            {
                                "example_id": "5ac09b69-c63f-4c66-8fed-2213f2d4acf7",
                                "sense_id": "7f14a775-1cc2-3865-9d36-c5c9610bf2fb",
                                "text": "Teile des Ahaggar reichen bis in den Norden von Niger und den Westen von Libyen."
