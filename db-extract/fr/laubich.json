                        "examples": [
                            {
                                "example_id": "c88fe3d5-b2c8-4944-89a5-5ed479fab658",
                                "sense_id": "92b95767-e850-3dc9-b76a-0b19e974830d",
                                "text": "Jour après jour, il venait de pointer les dépenses et les recettes de la semaine écoulée. C’était pas laubich !"
                            },
                            {
                                "example_id": "e77227ba-91f2-4ab5-bd05-9d58f36bcd5e",
                                "sense_id": "92b95767-e850-3dc9-b76a-0b19e974830d",
                                "text": "De même, n’y a-t-il pas quelque chose de laubich à marmitonner avec les nouvelles corrosions positives selon Baudrillard: avec ses glandilleuses notions de retour au symbolique, de réversibilité et de violence implosive?"
                            },
                            {
                                "example_id": "78f3697f-5e4a-4211-bd15-86dda110bffa",
                                "sense_id": "92b95767-e850-3dc9-b76a-0b19e974830d",
                                "text": "Dans Marty (Delbert Mann, 1955), un garçon boucher plutôt laid (Ernest Borgnine) tombe amoureux d’une instit pas laubiche (Betsy Blair, alors Madame Gene Kelly dans la vraie vie)"
                            }
                        ]
                    }
