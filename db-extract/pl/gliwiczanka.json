                "senses": [
                    {
                        "sense_id": "bb94d63f-a8f7-3017-bbfd-ce9c02d6ed28",
                        "entry_id": "d5a909f2-2d1a-38cb-98b9-35626f64c929",
                        "glosses": [
                            "female equivalent of gliwiczanin"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "64fff548-b62e-4f72-980a-54a334b08f9e",
                                "sense_id": "bb94d63f-a8f7-3017-bbfd-ce9c02d6ed28",
                                "text": "Właściciel solarium, w którym miała się opalać gliwiczanka, nie uważa, aby przyczyną zmian skórnych było korzystanie z łóżek stojących w jego salonie.",
                                "translation": "The owner of the tanning salon where the woman from Gliwice supposedly tanned does not believe that the skin changes were caused by using the beds in his salon.",
                                "english": "The owner of the tanning salon where the woman from Gliwice supposedly tanned does not believe that the skin changes were caused by using the beds in his salon."
                            },
                            {
                                "example_id": "0c3a3737-7da0-482d-8ea6-2e652ee26b31",
                                "sense_id": "bb94d63f-a8f7-3017-bbfd-ce9c02d6ed28",
                                "text": "Tez jestem ciekawa metod terapii w tym osrodku, dołączam się do pytania. Jako Gliwiczanka niedaleko mieszkająca mam obserwacje z zewnątrz.",
                                "translation": "I am also curious about the treatment methods used at this center, so I would like to join in with the question. As a resident of Gliwice living nearby, I have some observations from the outside.",
                                "english": "I am also curious about the treatment methods used at this center, so I would like to join in with the question. As a resident of Gliwice living nearby, I have some observations from the outside."
                            }
                        ]
                    }
