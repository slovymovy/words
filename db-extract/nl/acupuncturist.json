                        "sense_id": "550c4952-66eb-363d-9ece-0c9005dcedf2",
                        "entry_id": "fb604dbc-25f0-3cc4-aa4e-fc642a64e29f",
                        "glosses": [
                            "beoefenaar van de acupunctuur"
