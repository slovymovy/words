                ],
                "senses": [
                    {
                        "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                        "entry_id": "ff0788b2-98ec-33ef-96f3-af3747ef269e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaab624b-ed6a-49fc-8020-d6f86706fa95",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Herr Eichle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fd4a4e92-d0af-4540-9eda-d23f4a8162bd",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Die Eichles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "257728f8-c05b-44b2-9184-e1645f52a690",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Frau Eichle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "994a8aa9-57f7-4da4-8833-711d6d70eeb0",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Der Eichle trägt nie die Pullover, die die Eichle ihm strickt."
                            },
                            {
                                "example_id": "3cf13e0f-947d-429f-b42f-6d360a0a78de",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eichle kommt, geht der Herr Eichle.“"
                            },
                            {
                                "example_id": "5b885ab2-6518-4bb1-8263-7f2fffbf9dae",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Eichle kommt und geht."
                            },
                            {
                                "example_id": "e4137131-8689-4d58-98f6-802d90714cf7",
                                "sense_id": "d2d47faf-3f8b-3807-96b7-fcf16664caed",
                                "text": "Eichles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
