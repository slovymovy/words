                        "examples": [
                            {
                                "example_id": "94953bbc-9222-4e88-aa6f-538a0cac10b6",
                                "sense_id": "e78a0877-3f6f-3eda-90a2-adda83b67ac5",
                                "text": "„›Wenn eine Person stirbt, begräbt man sie und bewältigt die Trauer. Aber was, wenn man nicht weiß, ob die Lieblingsperson noch lebt oder tot ist?‹“"
                            },
                            {
                                "example_id": "bfe27e47-b9ac-4467-b4f6-d9f896dd546f",
                                "sense_id": "e78a0877-3f6f-3eda-90a2-adda83b67ac5",
                                "text": "„Sie mag nicht meine absolute Lieblingsperson sein, aber gerade bin ich dankbar für die Unterbrechung.“"
                            }
                        ],
