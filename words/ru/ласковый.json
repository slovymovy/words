                                "target_lang_sense_clarification": "warm and loving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d55c37a-cc6d-3d4d-8947-0b92978898f3",
                    "sense_definition": "Приветливый, дружелюбный и обходительный в общении с другими.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отношение_человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хозяйка гостиницы оказалась необыкновенно <w>ласковой</w> и встретила гостей с улыбкой.",
                            "target_lang_translations": {
                                "en": "The hotel hostess proved to be extraordinarily <w>welcoming</w> and greeted the guests with a smile."
                            }
                        },
                        {
                            "text": "Этот продавец всегда <w>ласков</w> с покупателями и охотно помогает с выбором.",
                            "target_lang_translations": {
                                "en": "This salesperson is always <w>gracious</w> with customers and gladly helps them choose."
                            }
                        }
