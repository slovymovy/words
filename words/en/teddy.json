            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba86317a-7950-3564-91d4-eb1d17829929",
                    "sense_definition": "A soft toy, usually in the shape of a bear; a short form of <w>teddy bear</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl hugged her <w>teddy</w> tightly while she slept.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка крепко обнимала своего <w>плюшевого мишку</w>, пока спала.",
                                "zh": "小女孩睡觉时紧紧抱着她的<w>泰迪熊</w>。"
                            }
                        },
                        {
                            "text": "He still keeps his childhood <w>teddy</w> on a shelf in his room.",
                            "target_lang_translations": {
                                "ru": "Он до сих пор хранит своего детского <w>мишку</w> на полке в своей комнате.",
                                "zh": "他至今仍把儿时的<w>小熊</w>放在房间的架子上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cuddly teddy",
                        "favorite teddy",
                        "hug a teddy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая игрушка, обычно в форме медведя; сокращение от <w>teddy bear</w>.",
                        "zh": "一种通常呈熊形的软玩具；“泰迪熊”的简称。"
                    },
