                    {
                        "sense_id": "03c736ea-3ab3-3738-9966-7b9200bbfa69",
                        "entry_id": "a154f6ee-a76d-3700-a214-63e047116298",
                        "glosses": [
                            "That detracts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166d5d7b-23cf-491f-8bb7-a63f03a6e3fe",
                                "sense_id": "03c736ea-3ab3-3738-9966-7b9200bbfa69",
                                "text": "Neither is there any thing in the condition of the laborer, more taxing to human exertion, more detracting from honorable self-respect, than any other occupation; on the contrary, agriculture, if we reason from realities, and not prejudices, is the truly noble occupation of life."
                            },
                            {
                                "example_id": "b8efc174-6505-4507-aba7-2dfcdd569459",
                                "sense_id": "03c736ea-3ab3-3738-9966-7b9200bbfa69",
                                "text": "\"In vino veritas,\" properly translated, means—that when a man is fairly under the influence of liquor, you see a strong manifestation of his real character. The vain man is vainer, the voluble, more voluble, the morose, more morose; the passionate, more passionate, the detractor, more detracting; the sycophant, more sycophantic, and so forth."
                            },
                            {
                                "example_id": "85517a63-04b1-4e4d-b6ca-6b7e8310573c",
                                "sense_id": "03c736ea-3ab3-3738-9966-7b9200bbfa69",
                                "text": "Probably nothing is more detracting and dissatisfying than buying a potted flowering plant which quits flowering as soon as it is taken home."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
