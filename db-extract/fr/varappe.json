                    {
                        "sense_id": "ef2ea4a0-b434-3ef9-b883-b81d04706ec3",
                        "entry_id": "8d92f7e8-bd8d-31ef-8531-7ce5c938eb83",
                        "glosses": [
                            "Sport consistant à atteindre le haut d’une structure naturelle ou artificielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4c9b32-5ff9-4243-bdc7-179fed0ac26d",
                                "sense_id": "ef2ea4a0-b434-3ef9-b883-b81d04706ec3",
                                "text": "Je crains, jeune homme, que le temps ne nous permette pas de mener à bien les quelques exercices de varappe au cours desquels je me serais rendu compte de vos facultés."
                            },
                            {
                                "example_id": "3eee665d-718b-4c11-8811-e00b3228adc3",
                                "sense_id": "ef2ea4a0-b434-3ef9-b883-b81d04706ec3",
                                "text": "J’éprouvais en elle les délices de l’herbe, la fuite de l’eau, et cette varappe à rebours qui me menait à l’inconscience et l’étouffement."
                            }
                        ]
                    }
