                                            {
                                                "example_id": "90e7e1fd-6984-4c00-9623-aa44eb1010d7",
                                                "sense_id": "8fff1752-31fd-3921-b1c1-8223847ecc3f",
                                                "text": "Mein Nachbar ist verärgert, weil sich Holland zur Fußball-WM qualifiziert hat."
                                            },
                                            {
                                                "example_id": "a9bfe083-31cf-4a8e-b51c-3a192f760ea5",
                                                "sense_id": "8fff1752-31fd-3921-b1c1-8223847ecc3f",
                                                "text": "„Alle Menschen in Holland hatten von Hekkenfeldt auf Island vernommen, in dessen Tiefe die Hölle brennt, und sie waren sehr begierig, Neues über diesen Felsberg zu vernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
