                        "entry_id": "5e2cba59-248f-3cb2-a744-ece19bfbaa69",
                        "glosses": [
                            "An unincorporated community in North Carolina, United States; named for tobacco businessman W. J. Olive."
                        ],
                        "tags": [],
                        "examples": []
                    }
