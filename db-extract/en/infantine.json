                        "glosses": [
                            "Infantile; childish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5830955a-2f32-48be-a447-2974b17dfe33",
                                "sense_id": "c4c0f442-fa6a-3430-8453-cc87cec0203c",
                                "text": "Man, because he could not but acknowledge the majesty of Nature, fell into childish exultation at his acquired and still-increasing dominion over her elements. Even while he stalked a God in his own fancy, an infantine imbecility came over him."
                            },
                            {
                                "example_id": "124326ca-2c1e-4307-9984-87fe38db099e",
                                "sense_id": "c4c0f442-fa6a-3430-8453-cc87cec0203c",
                                "text": "I saw Peggy with the infantine procession at her tail, marching with great dignity towards the stall of a neighbouring lollipop-woman."
                            }
                        ]
                    }
                ],
