                    {
                        "sense_id": "7694744e-e835-3fac-aace-aae575e0adab",
                        "entry_id": "4f514421-0cf7-3aa7-8a0b-82e7a3cc5752",
                        "glosses": [
                            "vorgesehener Raum, in dem Dinge oder Sachen zum Trocknen verweilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e65c4f6-ff4e-424d-8d4a-9e83b8ce1a8c",
                                "sense_id": "7694744e-e835-3fac-aace-aae575e0adab",
                                "text": "„Wer kennt nicht den muffigen Geruch in Trockenräumen die von mehreren Mietparteien benützt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
