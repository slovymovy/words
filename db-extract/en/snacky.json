                        "glosses": [
                            "Resembling or characteristic of a snack; suitable as a snack."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7eb4e7b0-2998-4453-b20f-0b480a7046ad",
                                "sense_id": "309f5f36-ed34-36b0-8abb-af38027b6535",
                                "text": "If I haven't time for a proper lunch, I pick up something snacky from the store."
                            },
                            {
                                "example_id": "ca0aa5e0-d9bd-4604-8888-7eda9a9b6967",
                                "sense_id": "309f5f36-ed34-36b0-8abb-af38027b6535",
                                "text": "We arrived that day and after kicking off our flip-flops and cover-ups, we called Craig over and slowly unzipped the duffle, so he could see all the snacky goodness we had brought over for the three of us to feast upon."
                            }
                        ]
                    },
                    {
                        "sense_id": "f72a2acd-0d26-3e3e-ac5a-e948d2280b33",
                        "entry_id": "62dcf3d2-fb8a-3068-8448-32fe69d879a9",
                        "glosses": [
                            "Desiring a snack; peckish."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a00ea0c1-a7bc-472d-93dc-b90fda4fb065",
                                "sense_id": "f72a2acd-0d26-3e3e-ac5a-e948d2280b33",
                                "text": "Have you eaten yet? I'm feeling snacky."
                            }
                        ]
                    }
