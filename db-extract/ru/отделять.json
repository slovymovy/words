                "senses": [
                    {
                        "sense_id": "3770a993-3163-3030-9ce2-a56f7d78d0b8",
                        "entry_id": "9f268fd7-f361-315d-92f6-afbf2998a5fd",
                        "glosses": [
                            "отъединять что-либо, делать отдельным, самостоятельным, создавать границу, разрыв"
                        ],
                        "tags": [],
