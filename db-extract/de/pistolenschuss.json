                "senses": [
                    {
                        "sense_id": "d4814712-6911-310e-9cc0-e55e3b30601d",
                        "entry_id": "a62fb302-5c1a-3cc0-80d7-5f8480e44b53",
                        "glosses": [
                            "Schuss, der aus einer Pistole abgefeuert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60155e2f-aa31-4bae-bfed-6c75a2eb5059",
                                "sense_id": "d4814712-6911-310e-9cc0-e55e3b30601d",
                                "text": "Als er die Pistolenschüsse hörte, löste der Nachtwächter den Alarm aus."
                            },
                            {
                                "example_id": "431df634-4dc5-4f0c-b997-4d2b395a691b",
                                "sense_id": "d4814712-6911-310e-9cc0-e55e3b30601d",
                                "text": "„Wegen des Pistolenschusses war ich ohne Sorge, denn ich hatte an dem Unverschämten ja absichtlich vorbeigeschossen.“"
                            },
                            {
                                "example_id": "20a24b0c-640b-4171-a9d0-a542678c08b3",
                                "sense_id": "d4814712-6911-310e-9cc0-e55e3b30601d",
                                "text": "„Ein paar Pistolenschüsse sandte er dem Boote nach, sie wurden durch ein dumpfes Lachen erwidert.“"
                            },
                            {
                                "example_id": "bab66aa3-13bd-4b59-a4e4-ba49e7c3deda",
                                "sense_id": "d4814712-6911-310e-9cc0-e55e3b30601d",
                                "text": "„Der Pistolenschuss war nur ein gedämpfter Knall, flach und dünn in der dunklen Stille der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
