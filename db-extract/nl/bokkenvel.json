                        "examples": [
                            {
                                "example_id": "7ff2e8eb-1ccc-4558-b9b6-f12c9b58a94b",
                                "sense_id": "dc5ae07a-3f1b-325e-a342-2f7e8e6aec25",
                                "text": "Daarna zegt hij, op Teunis Smit wijzend: ‘Dien kerel in dat buis van bokkenvel moet ik ook hebben,’ maar deze uitval maakt op de Boeren in spijt van hun hachelijken toestand zoo'n koddigen indruk, dat zij in een schaterlach uitbarsten. Nu wordt de kaptein echter woedend, en hij zegt: ‘Dat Buis van bokkenvel schijnt alles in de puntjes te weten; waarom vertelt hij dan ook niet, dat mijn krijgers een paar dagen geleden achtentwintig Boeren aan hunne assegaaien hebben geregen?’"
                            }
                        ]
                    }
