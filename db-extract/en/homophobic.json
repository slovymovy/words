                        "entry_id": "c07d9859-2b34-3df7-9e2b-799b85fbf115",
                        "glosses": [
                            "Exhibiting homophobia; characteristic of homophobes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8f715a-ea47-464a-b771-b0ce5247aef6",
                                "sense_id": "60e54c97-4740-3f4f-a8b3-7aafcaca3a11",
                                "text": "homophobic abuse"
                            },
                            {
                                "example_id": "f5ea426d-7530-41a0-b18b-cdc19af3c2d5",
                                "sense_id": "60e54c97-4740-3f4f-a8b3-7aafcaca3a11",
                                "text": "The nail bomber who killed three people and injured dozens of others in a terrifying campaign last spring told police he was a homophobic Nazi, and that he hoped the explosions would \"set fire to the country and stir up a racial war\", the Old Bailey heard yesterday."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                        "entry_id": "c07d9859-2b34-3df7-9e2b-799b85fbf115",
                        "glosses": [
                            "Inconvenient, annoying, irritating."
                        ],
                        "tags": [
                            "excessive",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c10938-52ed-4ae9-9d54-601161bb36a8",
                                "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                                "text": "My bus left right as I got to the station. It's so homophobic of the driver to not wait for me!"
                            },
                            {
                                "example_id": "4168619c-b4fd-40aa-badd-e04d6b3f4314",
                                "sense_id": "6e0caa55-f4fe-38c3-94bd-931ed627f8e5",
                                "text": "It's homophobic that I'm not cuddling my girlfriend right now."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a52adf-1224-4c73-932a-6d2966a7f194",
                        "source_entry_id": "c07d9859-2b34-3df7-9e2b-799b85fbf115",
                        "source_sense_description": "characteristic of homophobia",
                        "target_lang_word": "homophobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homophobe",
