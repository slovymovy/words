                {
                    "sense_id": "7a73d8d7-9254-337a-960a-da94924e757c",
                    "sense_definition": "Produire une impression désagréable ou pénible sur les organes des sens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensoriel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces couleurs trop vives et contrastées <w>blessent</w> la vue des spectateurs."
                        },
                        {
                            "text": "Ce son strident et métallique dans le silence <w>blesse</w> l'oreille de tous."
