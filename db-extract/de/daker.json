                ],
                "senses": [
                    {
                        "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                        "entry_id": "d2050390-c777-3467-a7fc-0af7e20bd193",
                        "glosses": [
                            "Angehöriger des antiken, gleichnamigen Volkes, das westlich des Schwarzen Meeres siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99290586-b4b3-49ee-805c-6685b92b3206",
                                "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                                "text": "„Der Daker erwies sich als mit allen Wassern gewaschener Taktiker, ein Ehrgeizling, der nichts Geringeres anstrebte als die Errichtung eines Großreiches.“"
                            },
                            {
                                "example_id": "72dcee8b-14ab-45e2-85bd-c88f8aa79612",
                                "sense_id": "062c0f55-1237-3678-8f94-210c6f0af75e",
                                "text": "„Daneben wird eine Schlacht gegen die Daker dargestellt, die durch die Überlegenheit der römischen Soldaten siegreich endet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
