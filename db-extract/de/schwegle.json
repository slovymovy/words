                "senses": [
                    {
                        "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                        "entry_id": "a392e607-23c0-3a78-9b9a-1655e77aaa3a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4bd62ee-257a-4042-9fce-bdb8712c8d8c",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Frau Schwegle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c7b64cd7-c991-440a-9667-1ebadee05086",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Herr Schwegle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0a9b7f6a-2a89-42e6-bf9d-ecb64a909baf",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Die Schwegles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "365371a4-b872-4b4a-9c2b-86fca6d3b30e",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Der Schwegle trägt nie die Schals, die die Schwegle ihm strickt."
                            },
                            {
                                "example_id": "ae8cd19a-fe9b-4654-8b50-17f1f646efc0",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwegle kommt, geht der Herr Schwegle.“"
                            },
                            {
                                "example_id": "0d40155d-0a63-4c4a-b4d0-e83e05ba5a91",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Schwegle kommt und geht."
                            },
                            {
                                "example_id": "593e787b-f04a-436c-b97f-b2f5c9cf0400",
                                "sense_id": "1dac752d-f4f5-3b9d-9fea-f522b178bac3",
                                "text": "Schwegles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
