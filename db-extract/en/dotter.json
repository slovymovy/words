                                "example_id": "11f7841c-8226-443b-affe-5a5596c0af02",
                                "sense_id": "611b39ce-1dc6-30f9-80cb-79fa37dcaadc",
                                "text": "These have a long fine brush and a dotter in the lid of the brush for making small dots of the paint on the nail."
                            }
                        ]
