                    },
                    {
                        "form_id": "911af34f-ce8e-4f77-89b7-25e066fa55f7",
                        "entry_id": "ef6ab632-505e-34c7-a829-600131a40645",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind weisungsgebunden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                        "entry_id": "ef6ab632-505e-34c7-a829-600131a40645",
                        "glosses": [
                            "so, dass man eine verbindliche Anordnung einer/eines Vorgesetzten/einer in der Hierarchie übergeordneten Stelle (= eine Weisung) befolgen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e969d5b-9dc5-4d90-8ee7-b7f92a9f067d",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„In Deutschland gibt es mehr als 20.000 Richter. Sie sind in ihrer Rechtsprechung \"nicht weisungsgebunden\".“"
                            },
                            {
                                "example_id": "c3fca009-762d-43c3-83b3-382f0023f7d9",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Im Arbeitsrecht wird ein Angestelltenverhältnis darüber definiert, ob eine Person weisungsgebunden ist – also genau das tun muss, was man ihr gesagt hat.“"
                            },
                            {
                                "example_id": "ba42a320-12d2-4b37-a141-c00d351fb580",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Unser Rechtssystem legt fest: Wer weisungsgebunden arbeitet, also zum Beispiel genau gesagt bekommt, was er wann und wo zu tun hat, ist grundsätzlich Arbeitnehmer.“"
                            },
                            {
                                "example_id": "5b653e58-7498-4bdd-b1e7-94dc29fdb9a6",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Der Generalbundesanwalt ist ein \"politischer Beamter\" und weisungsgebunden.“"
                            },
                            {
                                "example_id": "f8113f69-622e-4c6c-bd9b-9c311cd44078",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Als Beamte sind Staatsanwälte – anders als Richter – weisungsgebunden (§ 146 Gerichtsverfassungsgesetz) und unterliegen uneingeschränkt der Dienstaufsicht durch Vorgesetzte (§ 144 GVG) (§ 147 GVG).“"
                            },
                            {
                                "example_id": "39f439c7-93f0-4096-9fcb-1ba05f1a7a73",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Die Arbeitnehmereigenschaft hängt davon ab, dass der Beschäftigte weisungsgebundene, fremdbestimmte Arbeit in persönlicher Abhängigkeit leistet.“"
                            },
                            {
                                "example_id": "24314bde-352a-4961-8464-2bea3890d42f",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "[Reisender:] „Der angestellte Verkäufer ist weisungsgebunden und hat i. d. R. tägliche Verkaufsberichte, häufig in elektronischer Form, abzuliefern.“"
                            },
                            {
                                "example_id": "f170a0ea-84b1-4efa-8718-aaa91d41b7da",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Die Arbeit als freier Mitarbeiter hat den Vorteil, nicht wie ein Arbeitnehmer weisungsgebunden zu sein. So kann die Arbeitszeit frei eingeteilt werden.“"
                            },
                            {
                                "example_id": "7d8d7fd2-f198-48c4-b884-613b2267512b",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Gegen die Kündigung kann Schlesinger klagen. Da sie vermutlich nicht als weisungsgebundene Arbeitnehmerin galt, ist wohl nicht das Arbeitsgericht, sondern das Landgericht Berlin zuständig.“"
                            },
                            {
                                "example_id": "06132a13-7a1e-45db-99d3-71919380c86d",
                                "sense_id": "7956d9b5-8d4d-39ad-99e6-8c7268270a13",
                                "text": "„Japan ist ein zentralistischer Staat, dessen 47 Präfekturen der Zentralregierung gegenüber weisungsgebunden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
