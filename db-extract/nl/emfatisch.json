                            {
                                "example_id": "7c63de16-8852-40d2-bf2c-b864daf86c9d",
                                "sense_id": "8785ee3f-5c1b-321d-a5f5-14f597d7673c",
                                "text": "De grammaticus stelde voor om de variant op te vatten als een emfatische vorm, wat er op neer kwam dat hij ook niet het flauwste benul had wat het nu eigenlijk is.",
                                "translation": "The grammarian suggested to interpret the variant as an emphatic form, which boiled down to the fact that he also did not have the foggiest idea what it actually is.",
                                "english": "The grammarian suggested to interpret the variant as an emphatic form, which boiled down to the fact that he also did not have the foggiest idea what it actually is."
                            }
                        ]
