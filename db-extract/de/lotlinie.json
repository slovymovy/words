                ],
                "senses": [
                    {
                        "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                        "entry_id": "1be3d3e4-f8d7-3132-85ca-5ec0ce4d8472",
                        "glosses": [
                            "ungekrümmter eindimensionaler zu einem Zentrum gerichteter oder senkrecht auf eine (Tangential-)Ebene (einer Kugeloberfläche) stehender Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9abe80b8-814f-4a2c-86a9-c84075632486",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Dabei wählt man den Abstand zwischen den parallelen Lotlinien so, dass sich auch für die zwischen ihnen liegenden Bereiche eine zuverlässige Tiefenliniendarstellung entwickeln lässt.“"
                            },
                            {
                                "example_id": "28aba46b-9f90-47ff-bf27-5ccb709e9efd",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Den zeitlichen Veränderungen, die die Richtung der Lotlinie aus verschiedenen Ursachen zeigen muss, ist man in letzter Zeit durch Messungen nachgegangen.“"
                            },
                            {
                                "example_id": "b2a844a8-1cae-4982-bf7c-2eac513aa173",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Bei der Herstellung eines Lagenetzes durch Triangulation wird durch jede Messung durch Projektion des Lagepunktes entlang der lokalen Lotlinie eine gekrümmte Niveaufläche realisiert.“"
                            },
                            {
                                "example_id": "0d20c0e7-6cec-4987-9f40-67bbb7417bc8",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Die Differenzen zwischen Realität und einem einfachen mathematischen Modell zeigen sich z. B. in der Abweichung der wahren Lotlinie von der Ellipsoidnormalen, der sog. Lotabweichung (ξ, η, engl.: vertical deflection).“"
                            },
                            {
                                "example_id": "3e9b6ddc-a55f-4437-87a3-9937ef2a13da",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„In gleicher Weise kommt die Schraubenlinie mit sich selbst zur Deckung, wenn sie eine Umklappung um eine Gerade erfährt, die als Lotlinie von einem ihrer Punkte auf die Achse gefällt ist.“"
                            },
                            {
                                "example_id": "88ba139b-49a2-4aff-829b-694e5e621093",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Die Lotlinie ist eine imaginäre Linie, die vom Nackenansatz nach unten zur Position des Fußes am Boden verläuft.“"
                            },
                            {
                                "example_id": "28d47955-756a-4772-984e-74ab9c6ef9e7",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„‚Dann, kurz bevor der Stab gebogen wird, befinden sich die obere Hand, der Kopf und der Absprungfuß in einer Lotlinie‘, erklärt Klima.“"
                            },
                            {
                                "example_id": "ac2c3732-e782-4622-b4f8-d9a95fb72c61",
                                "sense_id": "75ceb8a3-15b8-3501-9e61-e321dbcfb20b",
                                "text": "„Je größer die Abweichung von der Lotlinie ist, desto deutlicher werden diese Krümmungen, durch die der obere Teil der Sprosse wieder in die Lotlinie zurückgeführt wird, in der er dann weiter wächst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
