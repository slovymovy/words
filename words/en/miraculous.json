{
    "word_family": [
        "miracle",
        "miraculously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8cbc5f0-2d97-3c9a-8cb1-51087f801fd2",
                    "sense_definition": "Very surprising; amazing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>miraculous</w> recovery after the doctors said he would never walk again.",
                            "target_lang_translations": {
                                "pl": "To był <w>cudowny</w> powrót do zdrowia, po tym jak lekarze powiedzieli, że już nigdy nie będzie chodził."
                            }
                        },
                        {
                            "text": "The team made a <w>miraculous</w> comeback in the final minutes of the game.",
                            "target_lang_translations": {
                                "pl": "Drużyna dokonała <w>niesamowitego</w> powrotu do gry w ostatnich minutach meczu."
                            }
                        }
                    ],
                    "synonyms": [
                        "amazing",
                        "astonishing",
                        "incredible"
                    ],
                    "common_phrases": [
                        "miraculous recovery",
                        "miraculous escape"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo zaskakujący; zdumiewający."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cudowny",
                                "target_lang_sense_clarification": "w znaczeniu niezwykły, zdumiewający"
                            },
                            {
                                "target_lang_word": "niesamowity",
                                "target_lang_sense_clarification": "w znaczeniu bardzo zaskakujący"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e29621cb-248a-3c30-9b3e-ea4791b7611a",
                    "sense_definition": "Caused by supernatural or divine power; impossible to explain by natural laws.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient texts describe a <w>miraculous</w> event where the sea parted for the people.",
                            "target_lang_translations": {
                                "pl": "Starożytne teksty opisują <w>cudowne</w> wydarzenie, podczas którego morze rozstąpiło się przed ludźmi."
                            }
                        },
                        {
                            "text": "Many pilgrims travel to the site hoping to witness a <w>miraculous</w> healing.",
                            "target_lang_translations": {
                                "pl": "Wielu pielgrzymów podróżuje do tego miejsca, mając nadzieję na bycie świadkiem <w>cudownego</w> uzdrowienia."
                            }
                        }
                    ],
                    "synonyms": [
                        "supernatural",
                        "divine",
                        "wondrous"
                    ],
                    "antonyms": [
                        "natural",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "miraculous event",
                        "miraculous power"
                    ],
                    "target_lang_definitions": {
                        "pl": "Spowodowany mocą nadprzyrodzoną lub boską; niemożliwy do wyjaśnienia prawami natury."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cudowny",
                                "target_lang_sense_clarification": "w znaczeniu nadprzyrodzony, boski"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}