                "senses": [
                    {
                        "sense_id": "c0f71951-da90-3c1d-bdfb-373221214f38",
                        "entry_id": "0b6ee218-ef80-345a-a249-e8e6c0076f39",
                        "glosses": [
                            "Belastung mit Blei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b48a849-b48e-4c82-bb2a-6f555c1289ab",
                                "sense_id": "c0f71951-da90-3c1d-bdfb-373221214f38",
                                "text": "„Die Verbindung zwischen Blei im Blut und psychischen Störungen konnte bisher nur bei Menschen hergestellt werden, die berufsbedingt einer hohen Bleibelastung ausgesetzt sind.“"
                            },
                            {
                                "example_id": "b2709bdc-daa1-44a4-8291-ce0dae945229",
                                "sense_id": "c0f71951-da90-3c1d-bdfb-373221214f38",
                                "text": "„Noch höher war die Bleibelastung allerdings, als die Römer vor 2000 Jahren Bleierze über offenem Feuer verhütteten und dabei riesige Mengen von Bleiverbindungen in die Luft gelangten.“"
                            }
                        ],
