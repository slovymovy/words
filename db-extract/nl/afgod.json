                ],
                "senses": [
                    {
                        "sense_id": "068305d7-e0ae-37b4-9f77-63c1b39de8e0",
                        "entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "glosses": [
                            "een andere god dan de ene God; een \\\"valse\\\" god"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35a0f5c-2288-44b4-acf9-3016436d4a16",
                                "sense_id": "068305d7-e0ae-37b4-9f77-63c1b39de8e0",
                                "text": "Gij zult geen afgoden vereren, maar Mij alleen aanbidden en boven alles beminnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9286468-47d8-38a3-9872-5fa801cbef91",
                        "entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "glosses": [
                            "iemand of iets wat als een god vereerd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91022ab0-8755-4558-a68c-19610b01eebb",
                                "sense_id": "c9286468-47d8-38a3-9872-5fa801cbef91",
                                "text": "Zijn vrouw is zijn afgod."
                            },
                            {
                                "example_id": "61f2604c-f3c4-4898-9dca-58d05c03a94d",
                                "sense_id": "c9286468-47d8-38a3-9872-5fa801cbef91",
                                "text": "De beroemde voetballer is de afgod van veel kinderen."
                            },
                            {
                                "example_id": "3cc7409b-1b0a-40f8-81dd-fc44a3da9be6",
                                "sense_id": "c9286468-47d8-38a3-9872-5fa801cbef91",
                                "text": "De auto is voor veel mannen hun afgod."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f91dc95d-f792-407e-9aa6-39b742223911",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "Abgott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b79f9d-0fb5-330d-8ec4-7ef76cd952f1",
                                        "entry_id": "949c9b52-963f-3b15-96a0-74b0bfd075ee",
                                        "glosses": [
                                            "ein falscher Gott, ein Götze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43328b48-58eb-40d0-a683-5bc570834173",
                                                "sense_id": "e7b79f9d-0fb5-330d-8ec4-7ef76cd952f1",
                                                "text": "Ihre Kandidatur nennen sie »Liste Jörg Haider«, sie huldigen der Witwe Claudia Haider als »Landesmutter«, verklären ihren Parteigründer zu einem Abgott, der unersetzlich sei."
                                            },
                                            {
                                                "example_id": "06bd12a2-0283-4727-9633-46e03360752c",
                                                "sense_id": "e7b79f9d-0fb5-330d-8ec4-7ef76cd952f1",
                                                "text": "Leon Fleisher ist eine lebende Legende. […] Er war ihr Abgott, und sie hielten ihn fast für Mozart, Beethoven oder Schubert selbst."
                                            },
                                            {
                                                "example_id": "08c2b743-6882-4cfa-8e9f-fd822af20c10",
                                                "sense_id": "e7b79f9d-0fb5-330d-8ec4-7ef76cd952f1",
                                                "text": "„Dieses Verhalten machte ihn zum Abgott der kleinen Kolonie.“"
                                            },
                                            {
                                                "example_id": "ece85f5e-6517-47df-995a-925410c91117",
                                                "sense_id": "e7b79f9d-0fb5-330d-8ec4-7ef76cd952f1",
                                                "text": "„Meine vergängliche Freude wurde dadurch verschönt, daß mein Abgott beim Herrichten der Kissen nicht ungeduldig wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d27c5f7-0b4a-40be-9eb6-91e2aa1ca83e",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "Götze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Götze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa48ce6-204d-386c-b27b-68801beb1574",
                                        "entry_id": "856940ab-d064-30a4-b2da-d2056f0f32de",
                                        "glosses": [
                                            "heidnischer Gott (aus der Sicht der monotheistischen Religionen); falscher Gott (abwertend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "518c51fb-44ed-4dd3-8c02-34d1f3a98304",
                                                "sense_id": "7aa48ce6-204d-386c-b27b-68801beb1574",
                                                "text": "Denn aller Heiden Götter sind Götzen; der HERR aber hat den Himmel gemacht. (1 Chron. 16,26, in Luthers Übersetzung)"
                                            },
                                            {
                                                "example_id": "12b2ca2a-f760-4870-ab78-677954c040a0",
                                                "sense_id": "7aa48ce6-204d-386c-b27b-68801beb1574",
                                                "text": "„Wie der andere von ihm erzählte, hatte er lange in Borneo gedient, und es war wohl möglich, daß er, der schweigsam und langweilig wie ein chinesischer Götze war, einen Vorrat von absonderlichen Erinnerungen in sich verschloß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64a06779-2533-3897-a61a-d0f7a75eba79",
                                        "entry_id": "856940ab-d064-30a4-b2da-d2056f0f32de",
                                        "glosses": [
                                            "Bild eines solchen Gottes; Gegenstand, der angebetet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e262f342-9eab-4394-8995-656eadd8f21d",
                                                "sense_id": "64a06779-2533-3897-a61a-d0f7a75eba79",
                                                "text": "Jener [der Heiden] Götzen aber sind Silber und Gold, von Menschenhänden gemacht. (Ps. 115,4)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8603d2b-d476-4d15-a5de-4a46e2c26a82",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "false god",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bfd2234c-be01-4800-861b-b86915697543",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "idol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A graven image or representation of anything that is revered, or believed to convey spiritual power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4237136e-942a-4d08-83e7-d34a4ab43892",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "20 And the rest of the men which were not killed by these plagues, yet repented not of the works of their hands, that they should not worship deuils, and idoles of golde, and siluer, and brasse, and stone, and of wood, which neither can see, nor heare, nor walke:\n21 Neither repented they of their murders, nor of their sorceries, nor of their fornication, nor of their thefts."
                                            },
                                            {
                                                "example_id": "3d7f2424-7f56-4e04-903d-f4578e6d8209",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "1183da42-a6b2-48ff-929e-daceaee7b063",
                                                "sense_id": "f8f17eca-610e-38e8-920b-32be0c3d0587",
                                                "text": "There's a one-eyed yellow idol to the north of Kathmandu, There's a little marble cross below the town; There's a broken-hearted woman tends the grave of Mad Carew, And the Yellow God forever gazes down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1286905-f128-33c1-90ac-5b4e7d677f81",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A cultural icon, or especially popular person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "A popular entertainer, usually young, captivating and attractive, and often female, with an image of being close to fans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f717e0-c61b-4bfc-9b8c-a3e544b6a5d2",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "Tom Cruise is his idol."
                                            },
                                            {
                                                "example_id": "068ac76a-74b7-4e13-bf53-416f3788adaf",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "Sachin Tendulkar is Rohan's idol."
                                            },
                                            {
                                                "example_id": "a7171a0a-0c68-4102-ad57-6d303da8266f",
                                                "sense_id": "fcb44df2-0eb5-3c2d-977f-94f2c7fdc901",
                                                "text": "They are known as \"idols\" and their job is \"to sell dreams\". For decades, the young pop stars of Japan and South Korea have been the envy of teenagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76b8035-4985-3aa4-83fb-5aa900f64f06",
                                        "entry_id": "b58be051-677f-3e64-b5d2-6f0d1cd7682d",
                                        "glosses": [
                                            "An eidolon or phantom; a misleading or elusive image or representation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f2cc15c-17cc-4dcc-8edb-ea0e0d111101",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "divinité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divinité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Essence divine ; nature divine."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5875a6bf-a3c7-4518-9b4a-ba15afd8b804",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "Gardez-vous donc bien d’imiter le vulgaire, qui met la Fortune au nombre des dieux ; la bizarrerie de sa conduite l’éloigne entièrement du caractère de la divinité, […]."
                                            },
                                            {
                                                "example_id": "df9f767f-223f-4eff-b7c6-8c22facc85f4",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "Comme point de départ, adoptons donc la Divinité. Relativement à cette Divinité, considérée en elle-même, celui-là seul n’est pas un imbécile, celui-là seul n’est pas un impie, qui n’affirme absolument rien."
                                            },
                                            {
                                                "example_id": "0e6343b8-8c27-44f8-98a7-454a033a7184",
                                                "sense_id": "deb654f4-7327-3846-b38a-3590434cc5db",
                                                "text": "L'attitude de la théologie chrétienne à l'égard des juifs a été fixée dans le début du IVᵉ siècle (concile de Nicée, 325) : le judaïsme ne doit pas disparaître, il doit vivre, mais dans un état d'avilissement et de misère tel qu'il fasse nettement apparaître aux yeux des croyants comme des incroyants le châtiment infligé par Dieu à ceux qui n'ont pas voulu reconnaître la divinité de Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Dieu lui-même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0245eb8-dada-4a21-932b-da89e9202765",
                                                "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                                "text": "Je n’ai donc rien à vous demander pour moi, ô monseigneur Jésus ! maintenant, surtout, que de mes yeux mortels j’ai contemplé votre divinité."
                                            },
                                            {
                                                "example_id": "25f366cd-3f96-4198-bd2f-1be6214139ae",
                                                "sense_id": "4aba1988-1d03-3845-8be5-1c755bf125c5",
                                                "text": "Pourtant je tiens jalousement à l'avertissement lancé par Homère aux Grecs dans L'Iliade et par Tyrtée dans les Élégies : « C'est une faiblesse déraisonnable que de se décharger sur la divinité de la responsabilité d'une morale et d'un ordre public » — Dieu, Allah ou quel qu'il soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Dieu ou déesse du polythéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745478ae-5530-48a3-8845-568681bee693",
                                                "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                                "text": "Si les divinités telluriques de Puisaye président à la naissance de Colette, il ne faut pas oublier que les dieux liés à l'eau bercent son destin."
                                            },
                                            {
                                                "example_id": "c54f3c5b-d0fd-458b-a126-c34a805e983c",
                                                "sense_id": "37b6fe00-e906-3fed-bf02-7942c08df0c3",
                                                "text": "Les sadhu ne sont pas des marginaux ou des fanatiques religieux, ce sont des hommes saints, vénérés par les hindous comme des représentants des divinités, entrés dans la voie de la libération et de l'élévation spirituelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bea3c15-d315-377e-a11f-e35573a638cc",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Représentation matérielle d'un dieu sous forme de sculpture, de statue, de statuette, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d91d3f7-df5a-40d1-9a70-0710a46f532d",
                                                "sense_id": "7bea3c15-d315-377e-a11f-e35573a638cc",
                                                "text": "Divinités en bronze, en argent, en or – de tous poids, de toutes dimensions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                        "entry_id": "1dea88db-519e-31ac-a4d7-91f0961ba41f",
                                        "glosses": [
                                            "Être ou objet adoré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f909ae-da59-4191-af52-db6425a79fe5",
                                                "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                                "text": "Le whist de l’abbé Duret faisait une utile diversion aux quasi-monologues de la divinité."
                                            },
                                            {
                                                "example_id": "a7a0350b-2d22-4640-a377-14128ab721e3",
                                                "sense_id": "b88ebd46-825e-30b2-912e-ce4061e7ba83",
                                                "text": "Quelle erreur! ces divinités renieront leurs adorateur et se retourneront même contre eux"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d84f249a-87cc-48ce-afd3-47441d70b053",
                        "source_entry_id": "c11e8558-b51a-33ca-917f-21b9e139ceab",
                        "target_lang_word": "idolo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idolo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "7374104d-d15f-31ec-8f45-059bdf63e1ad",
                                        "entry_id": "b5d7e2df-df9c-3d21-8da6-a7d9883b37c0",
                                        "glosses": [
                                            "statua, ma anche immagine oppure oggetto, di una divinità ritenuta simulacro divino, quindi solitamente costruiti da alcuni uomini che paradossalmente li vogliono credere come Dio, e di conseguenza adorati e venerati, appunto pur se costruiti da loro stessi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888f89cb-4c04-498e-809c-b90ee70356aa",
                                                "sense_id": "7374104d-d15f-31ec-8f45-059bdf63e1ad",
                                                "text": "tra Dio, a cui si deve il culto poiché onnipotente e creatore, gli idoli, che sono oggetti inanimati senza alcun potere né volontà, la netta differenza consiste per esempio nella vita donata e nella provvidenza governata"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f0348cd-d3d8-3f7c-92fb-2a488a2b07a6",
                                        "entry_id": "b5d7e2df-df9c-3d21-8da6-a7d9883b37c0",
                                        "glosses": [
                                            "personaggio celebre osannato oppure oggetto molto ambito in modo spropositato"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
