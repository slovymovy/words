                    {
                        "form_id": "27753390-2442-4ea0-87d5-db9a6ccac12f",
                        "entry_id": "a24a9d46-9ad1-37fd-b4b5-e839f20157b3",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "высоча́йших"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a527189-7f57-34de-9827-9c436b01f70e",
                        "entry_id": "a24a9d46-9ad1-37fd-b4b5-e839f20157b3",
                        "glosses": [
                            "превосх. ст. к прил. высокий"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "08fa4716-139a-445c-8dc8-5b9afedb350c",
                                "sense_id": "5a527189-7f57-34de-9827-9c436b01f70e",
                                "text": "Четыре дня нужно для того, чтобы взойти на верхушку Монблана, одной из высочайших гор."
                            },
                            {
                                "example_id": "4f9d44f9-ca34-4507-8396-c8c2e1cba249",
                                "sense_id": "5a527189-7f57-34de-9827-9c436b01f70e",
                                "text": "Шерстяные ткани высочайшего качества столетиями экспортировались во многие страны мира."
                            },
                            {
                                "example_id": "9f933c60-5cf8-479c-8f67-57d6b9199f40",
                                "sense_id": "5a527189-7f57-34de-9827-9c436b01f70e",
                                "text": "В первую очередь, его подвёл недостаток опыта ― ему ещё ни разу не приходилось играть при таком высочайшем напряжении."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e9c7d1-06bd-3153-a554-651555d40a34",
                        "entry_id": "a24a9d46-9ad1-37fd-b4b5-e839f20157b3",
                        "glosses": [
                            "истор. императорский, царский, монарший"
                        ],
                        "tags": [
                            "в Российском государстве до 1917 г."
                        ],
                        "examples": [
                            {
                                "example_id": "86a72358-2300-4da2-9b0f-6787dd92e0a9",
                                "sense_id": "f7e9c7d1-06bd-3153-a554-651555d40a34",
                                "text": "С трудом объяснил он, что идёт в канцелярию по высочайшему устному повелению нового государя."
                            },
                            {
                                "example_id": "9968eb72-47e5-49b2-bf64-12e71f71c574",
                                "sense_id": "f7e9c7d1-06bd-3153-a554-651555d40a34",
                                "text": "В этом храме императоры российские и особы высочайшей фамилии при отправлении своём из С.-Петербурга в дорогу в напутствование испрашивают благословение свыше."
                            },
                            {
                                "example_id": "2fe74b88-3b1e-4f34-855c-07b8c3f22535",
                                "sense_id": "f7e9c7d1-06bd-3153-a554-651555d40a34",
                                "text": "Я уже написал на высочайшее имя докладную записку."
                            }
                        ]
                    }
                ],
