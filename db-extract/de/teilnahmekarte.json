                "senses": [
                    {
                        "sense_id": "8d01c6eb-4ec5-3a2a-a356-24fad3ff1a3a",
                        "entry_id": "f004a8ea-6503-37d7-af9e-250dc6f09129",
                        "glosses": [
                            "Karte, die zur Teilnahme berechtigt; mit der man an etwas teilnehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c660ac-50c8-4863-9744-1f4809b64061",
                                "sense_id": "8d01c6eb-4ec5-3a2a-a356-24fad3ff1a3a",
                                "text": "„Teilnahmekarten berechtigen dazu, innerhalb des jeweiligen Gültigkeitszeitraumes entsprechend dem auf den Karten genannten Umfang an Kurseinheiten teilzunehmen.“"
                            },
                            {
                                "example_id": "59739eba-6e48-47c4-8d2f-56f639096d21",
                                "sense_id": "8d01c6eb-4ec5-3a2a-a356-24fad3ff1a3a",
                                "text": "„Teilnahmekarten berechtigen nicht zur Teilnahme an Sonderkursen und Workshops.“"
                            },
                            {
                                "example_id": "aa1bcc17-9370-4cc6-b2e9-0de8827055d6",
                                "sense_id": "8d01c6eb-4ec5-3a2a-a356-24fad3ff1a3a",
                                "text": "„Teilnahmekarten sind nicht übertragbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
