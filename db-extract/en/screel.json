                "senses": [
                    {
                        "sense_id": "9a2a9f9b-7d0d-3690-b132-58d3b9353693",
                        "entry_id": "84c778f7-e552-3f5f-9e4d-34be7b822bb5",
                        "glosses": [
                            "To emit a screel; to screech or skirl."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f46f0291-5898-41c7-86de-d51e731d6399",
                                "sense_id": "9a2a9f9b-7d0d-3690-b132-58d3b9353693",
                                "text": "Katherine steps into the train and the sides hiss closed. Candlewax waves as it screels its way out of the station."
                            },
                            {
                                "example_id": "5dfcb4f4-34e7-42f1-ad74-f5c7c69f9cb8",
                                "sense_id": "9a2a9f9b-7d0d-3690-b132-58d3b9353693",
                                "text": "The creature screels, a spine-chilling sound so intense the two unbroken windows at the far left corner of the room shatter, spraying chunks and slivers of glass everywhere."
                            },
                            {
                                "example_id": "95c6d2af-99e3-4b08-a824-2c6125657c3c",
                                "sense_id": "9a2a9f9b-7d0d-3690-b132-58d3b9353693",
                                "text": "The bagpipe suddenly screeled in a peculiar off-beat, sending chills down Neil's spine."
                            }
                        ]
                    }
                ],
