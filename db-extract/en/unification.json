                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c6465c-6bd3-4185-8389-ac455c489a9d",
                                                "sense_id": "c6befd2b-cd61-3fa7-9a40-0283e63337bd",
                                                "text": "Tato opatrnost má nakonec racionální základ, v mnoha směrech je vidět, že i baronka se mýlila – třeba když dramaticky varovala před sjednocením Německa, jehož prospěšnost teď už nikdo nezpochybňuje."
                                            },
                                            {
                                                "example_id": "2d8af8cc-233b-4d3d-a8e2-43617b021240",
                                                "sense_id": "c6befd2b-cd61-3fa7-9a40-0283e63337bd",
                                                "text": "Normalizaci prováděly již nejstarší kultury, například sjednocením měr a vah, avšak teprve moderní doba zaznamenala její rychlý rozvoj."
                                            }
                                        ]
                                    },
