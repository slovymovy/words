                    {
                        "sense_id": "47fd82b8-5c81-3e99-bdbb-264b45170956",
                        "entry_id": "230cd8c2-2bc7-32b6-82ad-5dc5edadd682",
                        "glosses": [
                            "En tout temps, à chaque instant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ec11a2-21c6-4bea-9499-fdda17731bbb",
                                "sense_id": "47fd82b8-5c81-3e99-bdbb-264b45170956",
                                "text": "Eine Änderung ist jederzeit möglich.",
                                "translation": "Une modification est possible à tout moment."
                            },
                            {
                                "example_id": "7ee5a03b-e7a3-4b9a-835a-7adc4b63d6be",
                                "sense_id": "47fd82b8-5c81-3e99-bdbb-264b45170956",
                                "text": "Für die Kunden unserer Autovermietung halten sich jederzeit jederzeit zur telefonischen Beratung bereit.",
                                "translation": "Por les cients de notre service de location de voitures, des interlocuteurs se tiennent à la disposition des clients à tout moment pour les conseiller par téléphone."
                            },
                            {
                                "example_id": "f3f961df-58e1-4999-97af-ac43c5ba31f7",
                                "sense_id": "47fd82b8-5c81-3e99-bdbb-264b45170956",
                                "text": "Doch als Begleiterinnen und dekorative Gehhilfen sind die Bunnies einfach unersetzlich: Man kann sich bei ihnen jederzeit bequem einhaken und sie sehen dabei um so vieles sexyer aus als diese Rollatoren.",
                                "translation": "Mais en tant que compagnes et aides à la marche décoratives, les bunny girls sont tout simplement irremplaçables : on peut facilement s'y accrocher à tout moment et elles sont tellement plus sexy que ces déambulateurs."
                            }
                        ]
                    }
