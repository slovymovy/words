                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musicians in the 1940s often wore a shiny <w>conk</w> on stage.",
                            "target_lang_translations": {
