    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74dc4f45-e72d-3a9f-ae66-3ba46a4e35ba",
                    "sense_definition": "Être membre d'une assemblée, d'un parlement ou d'un conseil et y exercer ses fonctions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a été élue pour <w>siéger</w> au parlement durant les cinq prochaines années."
                        },
                        {
                            "text": "Le directeur refuse désormais de <w>siéger</w> au conseil d'administration de cette entreprise."
                        }
                    ],
                    "common_phrases": [
                        "siéger au parlement",
                        "siéger au conseil"
                    ]
                },
                {
                    "sense_id": "84f040cc-85ce-3f25-97eb-e174f2f770df",
                    "sense_definition": "En parlant d'un tribunal, d'une cour ou de juges, se réunir et tenir séance pour rendre la justice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les juges ont décidé de <w>siéger</w> à huis clos pour entendre le témoignage."
                        },
                        {
                            "text": "Le tribunal correctionnel <w>siège</w> chaque matin afin de traiter les dossiers urgents."
                        }
                    ],
                    "common_phrases": [
                        "siéger à huis clos"
                    ]
                },
                {
                    "sense_id": "1cd818f6-dcec-30c7-8c28-a41949542be3",
                    "sense_definition": "Avoir son siège officiel ou son administration centrale en un lieu déterminé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette cour internationale a choisi de <w>siéger</w> à La Haye depuis sa fondation."
                        },
                        {
                            "text": "Le conseil municipal <w>siège</w> traditionnellement dans le bâtiment historique de la mairie."
                        }
                    ],
                    "common_phrases": [
                        "siéger en permanence"
                    ]
                },
                {
                    "sense_id": "fba19d09-3c47-335a-b9db-32e33e755f87",
                    "sense_definition": "Avoir son foyer ou résider en un endroit précis du corps ou de l'esprit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'examen médical a confirmé que l'infection <w>siégeait</w> dans les poumons du patient."
                        },
                        {
                            "text": "Le médecin a cherché où pouvait <w>siéger</w> la source réelle de cette douleur persistante."
                        }
                    ],
                    "synonyms": [
                        "résider"
                    ]
                },
                {
                    "sense_id": "c01d25b1-48a3-3e59-929f-5a3afe0174d0",
                    "sense_definition": "Occuper le trône ou le siège épiscopal ou pontifical.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le souverain pontife a continué de <w>siéger</w> à Rome malgré les pressions politiques."
                        },
                        {
                            "text": "Cet évêque <w>siégea</w> pendant plus de trente ans à la tête du diocèse."
                        }
                    ],
                    "common_phrases": [
                        "siéger sur le trône"
