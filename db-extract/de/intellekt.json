                "senses": [
                    {
                        "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                        "entry_id": "2625d286-28f8-371d-aac4-af195bce0125",
                        "glosses": [
                            "Denk-, Erkenntnisvermögen; Verstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668745bb-ddf9-4c3f-a7a2-f2a3104f8744",
                                "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                                "text": "Dazu reicht ihr Intellekt einfach nicht."
                            },
                            {
                                "example_id": "dd9b4df7-0a46-4cb1-af97-c2d20c66954c",
                                "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                                "text": "„Seine scharfe Beobachtungsgabe und sein fast noch schärferer Intellekt machen nicht mehr vor der eigenen Person halt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c421c27-d066-4e9c-abe9-ffb0b56900e7",
                        "source_entry_id": "2625d286-28f8-371d-aac4-af195bce0125",
                        "source_sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                        "source_sense_description": "Denk-, Erkenntnisvermögen; Verstand",
                        "target_lang_word": "intellect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4998b4d-47ff-3ba2-b9e5-73ed620ba2fe",
                                        "entry_id": "ec26ca00-4bdc-3185-ba32-7a51fa6a47a3",
                                        "glosses": [
                                            "The faculty of thinking, judging, abstract reasoning, and conceptual understanding; the cognitive faculty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcfa45af-7a80-434b-b5ff-839bb357d4c6",
                                                "sense_id": "e4998b4d-47ff-3ba2-b9e5-73ed620ba2fe",
                                                "text": "Intellect is one of man's greatest powers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2653558-3d18-3e13-9c92-88b6973d1443",
                                        "entry_id": "ec26ca00-4bdc-3185-ba32-7a51fa6a47a3",
                                        "glosses": [
                                            "The capacity of that faculty (in a particular person)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070ead33-5158-461e-b3a0-4f1b0b9c76e0",
                                                "sense_id": "e2653558-3d18-3e13-9c92-88b6973d1443",
                                                "text": "They were chosen because of their outstanding intellect."
                                            },
                                            {
                                                "example_id": "2dadc94b-c5c6-4906-9fab-bfd8b38456d1",
                                                "sense_id": "e2653558-3d18-3e13-9c92-88b6973d1443",
                                                "text": "Arms of stripes and shirts of checks / You had a very nice intellect"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313d25e9-6687-36ea-85a4-9a29d3de1e9f",
                                        "entry_id": "ec26ca00-4bdc-3185-ba32-7a51fa6a47a3",
                                        "glosses": [
                                            "A person who has that faculty to a great degree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "643e84cc-3c0c-4c96-88fa-0edb285e881b",
                                                "sense_id": "313d25e9-6687-36ea-85a4-9a29d3de1e9f",
                                                "text": "Some of the world's leading intellects were meeting there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
