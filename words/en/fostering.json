        "fosterling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93ed8605-ca2f-3b46-80e4-f513de3fb9cf",
                    "sense_definition": "The act of raising a child who is not one's own biological offspring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fostering</w> of children requires patience and dedication.",
                            "target_lang_translations": {
                                "zh": "儿童的<w>寄养</w>工作需要耐心和奉献精神。"
                            }
                        },
                        {
                            "text": "They have dedicated their lives to the <w>fostering</w> of vulnerable youth.",
                            "target_lang_translations": {
                                "zh": "他们毕生致力于<w>寄养</w>弱势青少年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fosterage",
                        "rearing",
                        "upbringing"
                    ],
                    "common_phrases": [
                        "child fostering"
                    ],
                    "target_lang_definitions": {
                        "zh": "指抚养非亲生子女的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "寄养",
                                "target_lang_sense_clarification": "指将孩子暂时安置在他人家庭中抚养。"
                            },
                            {
                                "target_lang_word": "代养",
                                "target_lang_sense_clarification": "指代替他人抚养孩子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1be76394-e4bb-3f89-a3ff-4e78393a7a16",
                    "sense_definition": "The act of encouraging or aiding the development of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fostering</w> of innovation is essential for economic growth.",
                            "target_lang_translations": {
                                "zh": "<w>促进</w>创新对经济增长至关重要。"
                            }
                        },
                        {
                            "text": "Teachers play a key role in the <w>fostering</w> of creativity among students.",
                            "target_lang_translations": {
                                "zh": "教师在<w>培养</w>学生的创造力方面发挥着关键作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nurture"
                    ],
                    "common_phrases": [
                        "fostering innovation",
                        "fostering growth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指鼓励或促进某事物发展的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "促进",
                                "target_lang_sense_clarification": "指推动事物发展或进步。"
                            },
                            {
                                "target_lang_word": "培养",
                                "target_lang_sense_clarification": "指长期教育或训练以使其成长。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4937e71-9b33-33dd-8c96-e6e0d13abe4d",
                    "sense_definition": "Present participle and gerund of <w>foster</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>fostering</w> two kittens until they find a permanent home.",
                            "target_lang_translations": {
                                "zh": "她目前正在<w>寄养</w>两只小猫，直到它们找到永久的家。"
                            }
                        },
                        {
                            "text": "By <w>fostering</w> a positive environment, the manager improved team morale.",
                            "target_lang_translations": {
                                "zh": "通过<w>营造</w>积极的环境，经理提高了团队士气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fostering a child",
                        "fostering a sense"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 foster 的现在分词和动名词形式，意为抚养、培养或促进。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "寄养",
                                "target_lang_sense_clarification": "指照顾非亲生子女或动物。"
                            },
                            {
                                "target_lang_word": "培养",
                                "target_lang_sense_clarification": "指促进某种能力或氛围的发展。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}