                "senses": [
                    {
                        "sense_id": "0eac2a0d-2ea7-36b6-ae56-e8ed8ddf5510",
                        "entry_id": "a67e80c1-df5d-32e6-ab3f-79294d3320e4",
                        "glosses": [
                            "Variante orthographique de déméduller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9939b7b6-715a-4eb6-8101-388017ab0321",
                                "sense_id": "0eac2a0d-2ea7-36b6-ae56-e8ed8ddf5510",
                                "text": "Déméduler le poisson. Enfoncement d'une tige dans la tête du poisson et jusqu'à la queue afin de couper les connexions nerveuses du poisson."
                            },
                            {
                                "example_id": "afd0e641-83b4-441d-9777-fee952163845",
                                "sense_id": "0eac2a0d-2ea7-36b6-ae56-e8ed8ddf5510",
                                "text": "Expliquez avec précision pourquoi, il faut décérébrer et déméduler la grenouille."
                            },
                            {
                                "example_id": "b2134816-d136-4f54-a569-eb44adcc7eaf",
                                "sense_id": "0eac2a0d-2ea7-36b6-ae56-e8ed8ddf5510",
                                "text": "La technique Ikejime consiste à perforer le cerveau du poisson de façon à ce que sa chair ne reçoive plus d’influx nerveux, et à déméduler ou neutraliser les nerfs qui passent le long de son arête dorsale."
                            }
                        ]
                    }
