                "senses": [
                    {
                        "sense_id": "fb20e090-9887-3a4a-9e46-a796728dba08",
                        "entry_id": "1853f322-23b0-3c42-8365-126c495094af",
                        "glosses": [
                            "äußerst feiner, fadenartiger Monokristall, der organisch oder anorganisch gewachsen ist und sehr zugfest ist"
                        ],
                        "tags": [
                            "Kristallographie",
                            "nur Plural 1"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9b145b30-a8b0-31fa-b175-7c33b4b9fd20",
                        "entry_id": "1853f322-23b0-3c42-8365-126c495094af",
                        "glosses": [
                            "Bestandteil eines Boxplots, der sich außerhalb der Box befindet und dessen Länge meist das 1,5-Fache des Interquartilsabstandes beträgt"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "ae352aca-69e4-45a2-8619-afeea0233cff",
                                "sense_id": "9b145b30-a8b0-31fa-b175-7c33b4b9fd20",
                                "text": "„Ist der Boxplot symmetrisch – liegt der Median also in der Mitte der Box und sind die Whiskers vergleichsweise gleich lang – liegt eine symmetrische Verteilung vor.“"
                            },
                            {
                                "example_id": "4cc03f2c-e5e2-4fcd-9633-cdd4cfce8cb8",
                                "sense_id": "9b145b30-a8b0-31fa-b175-7c33b4b9fd20",
                                "text": "„Wie man erkennt, liegen keine Ausreißer vor, sodass die Whisker bis zur kürzesten Zeit von 62,6 s bzw. längsten Zeit von 148,2 s reichen.“"
                            },
                            {
                                "example_id": "96688c71-ad2d-4026-af03-a25ee2122e8a",
                                "sense_id": "9b145b30-a8b0-31fa-b175-7c33b4b9fd20",
                                "text": "„Durch die Whisker werden die außerhalb der Box liegenden Werte dargestellt.“"
                            },
                            {
                                "example_id": "083013aa-bd33-4339-9419-ac67023623c0",
                                "sense_id": "9b145b30-a8b0-31fa-b175-7c33b4b9fd20",
                                "text": "„Darüber hinaus sind bei asymmetrischen Daten die Whisker nicht gleich lang.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
