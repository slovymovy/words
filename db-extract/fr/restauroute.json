                                "example_id": "043d35a0-b61a-4360-aaa0-45c9297587f7",
                                "sense_id": "7357375d-0742-3a83-a4ad-631b413db157",
                                "text": "Le restauroute : y’a pas mieux pour pleurer en silence sans se faire emmerder."
