                ],
                "senses": [
                    {
                        "sense_id": "a967038d-2cad-3c45-a09a-39aba80e8cfd",
                        "entry_id": "01475ab0-580b-3aa0-ae9d-959daa8ef01b",
                        "glosses": [
                            "Relatif à l'orgasme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca23f151-8fe1-475e-8e33-e03c14d60149",
                                "sense_id": "a967038d-2cad-3c45-a09a-39aba80e8cfd",
                                "text": "Un équivalent orgastique est une activité sans connotation sexuelle mais pouvant procurer les mêmes bénéfices qu'un orgasme."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4c4767b-ff66-3bb8-93e5-34d097e6bb7c",
                        "entry_id": "01475ab0-580b-3aa0-ae9d-959daa8ef01b",
                        "glosses": [
                            "Relatif à un plaisir d’une grande intensité, à une jouissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714d6cd1-889c-4f5e-a963-771b18990663",
                                "sense_id": "b4c4767b-ff66-3bb8-93e5-34d097e6bb7c",
                                "text": "Dans un premier élan orgastique, caractéristique du début tumultueux de toute révolution spirituelle, elle a purifié l’air en le débarrassant de ce que la tradition avait d’étouffant, déchargé les tensions accumulées pendant de nombreuses années, et ses expérimentations audacieuses ont malgré tout laissé des impulsions fécondes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df527971-4279-40ad-8b0f-75ea104f0749",
                        "source_entry_id": "01475ab0-580b-3aa0-ae9d-959daa8ef01b",
                        "target_lang_word": "orgastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1d9b91-a195-30f4-bb31-ced7173b60fe",
                                        "entry_id": "30d3f36d-b5d0-3da1-9299-19028f09094c",
                                        "glosses": [
                                            "Orgasmic (exciting or stimulating; relating to or prone to orgasm)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77d0da8-ee29-4d1e-94f9-3cec47e07b53",
                                                "sense_id": "7a1d9b91-a195-30f4-bb31-ced7173b60fe",
                                                "text": "Gatsby believed in the green light, the orgastic future that year by year recedes before us."
                                            },
                                            {
                                                "example_id": "d1794728-0cbd-48cb-a8c9-d0ff18a2886c",
                                                "sense_id": "7a1d9b91-a195-30f4-bb31-ced7173b60fe",
                                                "text": "There is surely no more orgastic torture for children than the cries of another child being punished."
                                            },
                                            {
                                                "example_id": "06047780-f3d4-4393-8c23-506649a89e2c",
                                                "sense_id": "7a1d9b91-a195-30f4-bb31-ced7173b60fe",
                                                "text": "In the older half of our sample the nondevout women are somewhat more orgastic than the devout, but in the younger half of the sample it is the devout who are more orgastic."
                                            },
                                            {
                                                "example_id": "37a10108-d542-4624-8e53-f22a9d84a192",
                                                "sense_id": "7a1d9b91-a195-30f4-bb31-ced7173b60fe",
                                                "text": "However, Pomeroy's (1965) data are contradictory, in that he found prostitutes to be more orgastic than normal women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
