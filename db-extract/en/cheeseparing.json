                "translations": [
                    {
                        "translation_id": "09051907-38ed-4998-9095-c2d3ced88c92",
                        "source_entry_id": "6cca0b9d-9346-37c0-8608-d343a4535294",
                        "source_sense_id": "ad8008d3-9c7a-31a8-a4bc-e797349f34b8",
                        "source_sense_description": "niggardly, stingy",
                        "target_lang_word": "radin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5130220a-5bc5-3f2f-a40f-c56df05467cf",
                                        "entry_id": "9613bd3b-12bb-3616-8709-014db497ce41",
                                        "glosses": [
                                            "Qui est avare, pingre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c291d06f-17d5-4997-8147-0015ce215ecd",
                                                "sense_id": "5130220a-5bc5-3f2f-a40f-c56df05467cf",
                                                "text": "Thierry. — Elle joue gros jeu ? Alice. — Oh ! un affreux petit jeu, radin, râleux, comme si elle avait devant elle l'argent de son terme…"
                                            },
                                            {
                                                "example_id": "b576cd90-1a9a-4a1b-8281-c8f0e1200be3",
                                                "sense_id": "5130220a-5bc5-3f2f-a40f-c56df05467cf",
                                                "text": "Écrit à Champion au sujet du Manuscrit-Autographe. Ça ne servira à rien. Il est « radin » mais ça l'embêtera."
                                            },
                                            {
                                                "example_id": "bed4499e-ccca-447a-a99d-92b933c4fdce",
                                                "sense_id": "5130220a-5bc5-3f2f-a40f-c56df05467cf",
                                                "text": "Soyez radin. La prodigalité attire de nombreux amis sur le court terme mais, plus tard, personne ne vous en remerciera jamais."
                                            },
                                            {
                                                "example_id": "48a1d26b-83a9-41d9-9883-7d4cb60f05d7",
                                                "sense_id": "5130220a-5bc5-3f2f-a40f-c56df05467cf",
                                                "text": "Devenez radin ! Les petits ruisseaux font les grandes rivières « Être économe c’est très bien, surtout si vos parents l’ont été pour vous ! » disait Winston Churchill."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba9bacb-52a7-33b5-ba63-b4fdfe014095",
                                        "entry_id": "63e91b6f-dcaf-32a5-9d57-ffbba20869c0",
                                        "glosses": [
                                            "Personne radine."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc249dac-b509-4f00-9ff9-83d6161a2b7d",
                                                "sense_id": "3ba9bacb-52a7-33b5-ba63-b4fdfe014095",
                                                "text": "Un radin d’ailleurs, ce compère, qui m’agréa pour un tout petit salaire, mais avec un contrat et des clauses longues comme ça, toutes à son avantage. Un patron en somme."
                                            },
                                            {
                                                "example_id": "433e68e9-4557-4ed2-bae0-97b94e420720",
                                                "sense_id": "3ba9bacb-52a7-33b5-ba63-b4fdfe014095",
                                                "text": "Oui, les radins modernes sont devenus des gens qui savent gérer leur argent et profiter des bonnes occasions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63358c20-ce55-34c4-9d26-cf8f655cc3d8",
                                        "entry_id": "63e91b6f-dcaf-32a5-9d57-ffbba20869c0",
                                        "glosses": [
                                            "Argent monnayé, et par extension, argent du comptoir."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff276e94-b213-3691-9c27-673323a745a6",
                                        "entry_id": "63e91b6f-dcaf-32a5-9d57-ffbba20869c0",
                                        "glosses": [
                                            "Gousset de montre ou de gilet."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4e144c4-1fa1-3e8c-a687-918bb90f82e8",
                                        "entry_id": "63e91b6f-dcaf-32a5-9d57-ffbba20869c0",
                                        "glosses": [
                                            "Tiroir-caisse."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d055057-9799-4828-9685-389eebca5748",
                                                "sense_id": "a4e144c4-1fa1-3e8c-a687-918bb90f82e8",
                                                "text": "[…] et que c'est généralement l'argent du comptoir qui est volé, ce vol se nomme indifféremment : vol au radin ou vol au pégriot. Radin désigne le tiroir qui renferme l'argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
