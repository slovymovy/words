                    {
                        "translation_id": "327ca3ea-3ef1-4cd7-b0f1-ee08679c9e25",
                        "source_entry_id": "9c40c4da-315f-393c-a48e-afca9f8f0058",
                        "source_sense_id": "1e99d180-66ec-346c-97c7-abd2c4566147",
