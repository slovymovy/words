        "fr-extract.jsonl": [
            {
                "entry_id": "77d81b22-0de5-35e7-8ab3-4541458643fb",
                "word": "laconisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "92926fb4-03c6-4e88-9ecb-e289e3ae6c8a",
                        "entry_id": "77d81b22-0de5-35e7-8ab3-4541458643fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "laconismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41da5518-c42c-3dff-89b9-143cd205dc54",
                        "entry_id": "77d81b22-0de5-35e7-8ab3-4541458643fb",
                        "glosses": [
                            "Manière laconique d’exprimer sa pensée, concision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19215547-2b1e-4dd8-87a9-45a345d17036",
                                "sense_id": "41da5518-c42c-3dff-89b9-143cd205dc54",
                                "text": "Lediacre, qui m'avait saluée d'un simple mouvement de paupières, ne pipait mot. Il pouvait rester des heures sans ouvrir la bouche, surtout en présence de sa femme, dont la vertu cardinale n'était pas le laconisme."
                            },
                            {
                                "example_id": "c966c9ad-ee19-49de-9e09-76831436c691",
                                "sense_id": "41da5518-c42c-3dff-89b9-143cd205dc54",
                                "text": "Un faire-part imprimé, collé sur une vitre, annonçait la mort d’un client. Aucun nom sous le sien. Nulle mention d’ami ni de famille. […] Cet avis mortuaire, avec son laconisme, me parut d’une indicible tristesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a4bc42-3f1d-3f15-a852-fc6c679ba217",
                        "entry_id": "77d81b22-0de5-35e7-8ab3-4541458643fb",
                        "glosses": [
                            "Simplicité, minimalisme."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bca23ddc-bd0e-406c-a274-6d7d9a3a6b5b",
                                "sense_id": "58a4bc42-3f1d-3f15-a852-fc6c679ba217",
                                "text": "Elle est bien frêle et sèche, mais à peine nerveuse et, en dépit du laconisme de ses repas, elle se porte très bien, n’est même jamais souffrante."
                            },
                            {
                                "example_id": "f74ead47-b166-471f-a879-8286f0168ef9",
                                "sense_id": "58a4bc42-3f1d-3f15-a852-fc6c679ba217",
                                "text": "Seurat dont le génie, tôt interrompu, mais congénitalement total, est fait pour occuper tout le parcours qui va du rigoureux laconisme à la poésie infinie. Esprit de géométrie et esprit de finesse s'allient chez lui pour un miracle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6460adff-b6af-48d8-9e24-ba5aa91c8e02",
                        "source_entry_id": "77d81b22-0de5-35e7-8ab3-4541458643fb",
                        "target_lang_word": "laconism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laconism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3881426b-a7b8-3059-b5a3-f59d455f65f3",
                                        "entry_id": "638c17f2-8162-3b78-bafc-4589558fb1b9",
                                        "glosses": [
                                            "Extreme brevity in expression."
                                        ],
                                        "tags": [
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3a87bd-62fd-4c18-9dbd-6f927fa55d8d",
                                                "sense_id": "3881426b-a7b8-3059-b5a3-f59d455f65f3",
                                                "text": "“Well, where have you been?” he said to her with offhand laconism."
                                            },
                                            {
                                                "example_id": "7615aa45-bd56-47db-ac99-153f7a346d05",
                                                "sense_id": "3881426b-a7b8-3059-b5a3-f59d455f65f3",
                                                "text": "[…] Joe Montana is finally calling it quits. A retirement party in San Francisco and a press conference in Kansas City, Missouri, are planned for this week, and his agents are shopping him around to the networks as a broadcaster, even though Montana has a reputation for laconism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afd6658-5dd0-32c8-92c9-524558b900de",
                                        "entry_id": "638c17f2-8162-3b78-bafc-4589558fb1b9",
                                        "glosses": [
                                            "A very or notably brief expression."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd61c3c7-8046-4297-8026-840de6d628d3",
                                                "sense_id": "7afd6658-5dd0-32c8-92c9-524558b900de",
                                                "text": "The hand of PROVIDENCE writes often by abbreviatures, hieroglyphicks or short characters, which, like the Laconism on the wall, are not to be made out but by a hint or key from that SPIRIT which indited them."
                                            },
                                            {
                                                "example_id": "eec7f189-4c44-4add-90f3-28d997302ca0",
                                                "sense_id": "7afd6658-5dd0-32c8-92c9-524558b900de",
                                                "text": "Perhaps the most striking difference between [A Tale of Two Cities] and his other novels may seem to lie in the all but entire absence from it of any humour or attempt at humour; for neither the brutalities of that “honest tradesman” Jerry, nor the laconisms of Miss Pross, can well be called by that name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
