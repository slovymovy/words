                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec320ff4-aa19-313f-b08a-0fa771edaea6",
                                        "entry_id": "9413ff9e-db76-3507-a19a-9c1a43ca9179",
                                        "glosses": [
                                            "Use of a proper name to suggest its most obvious quality or aspect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb4eb22f-5aac-42d5-83d0-ff211fad26c5",
                                                "sense_id": "ec320ff4-aa19-313f-b08a-0fa771edaea6",
                                                "text": "Antonomasia proper names imparts\nFrom kindred, country, epithets, and arts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ed0de9a-fbeb-4ca9-80a5-3bbd66dbc3e4",
                        "source_entry_id": "134f8855-b650-35b9-901a-39ff98d86635",
                        "source_sense_id": "dd462cf6-1503-394b-be0e-9f2456343e4e",
                        "target_lang_word": "antonomase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antonomase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e843b1f-8c3e-3b2c-a6d6-f758f502e757",
                                        "entry_id": "62642e0b-06bd-338b-a921-c481eb1b5656",
                                        "glosses": [
                                            "Figure de style par laquelle un nom commun ou une périphrase désigne un nom propre."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e2d3a1-44d1-4c4d-992e-65b4674bfcd7",
                                                "sense_id": "8e843b1f-8c3e-3b2c-a6d6-f758f502e757",
                                                "text": "Il se souvint tout à coup d’une vieille chronique où il avait, pour flétrir, stigmatiser, juvénaliser les comportements bourgeois, […] projeté le feu rouge des catachrèses les plus imprévues, des synecdoches les plus arbitraires, des antonomases les plus follement tirées par les cheveux, […]."
                                            },
                                            {
                                                "example_id": "bd9132da-0020-4474-b09a-32e0022587e8",
                                                "sense_id": "8e843b1f-8c3e-3b2c-a6d6-f758f502e757",
                                                "text": "« L’Orateur romain » est une antonomase pour désigner Cicéron."
                                            },
                                            {
                                                "example_id": "36ce996b-a1be-4147-8561-82ed3b140142",
                                                "sense_id": "8e843b1f-8c3e-3b2c-a6d6-f758f502e757",
                                                "text": "« Le père des dieux » est une antonomase pour désigner Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f279b78d-304c-3271-8fc8-6ea21698f355",
                                        "entry_id": "62642e0b-06bd-338b-a921-c481eb1b5656",
                                        "glosses": [
                                            "Inversement, figure de style par laquelle un nom propre est utilisé comme un nom commun."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55f3aedd-541d-4d76-98d6-a83afb39fb70",
                                                "sense_id": "f279b78d-304c-3271-8fc8-6ea21698f355",
                                                "text": "« C’est un Néron » est une antonomase pour dire que c’est un prince cruel, un tyran imbu de sa personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cede6c1-59ea-3c89-ab96-633d12cee514",
                                        "entry_id": "62642e0b-06bd-338b-a921-c481eb1b5656",
                                        "glosses": [
                                            "Par lexicalisation de cette figure de style, transformation d’un nom propre en nom commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1086c036-2e40-42b8-a300-e4e17e68a0c5",
                                                "sense_id": "4cede6c1-59ea-3c89-ab96-633d12cee514",
                                                "text": "Certaines antonomases courantes finissent par se lexicaliser et figurent dans les dictionnaires usuels comme « une poubelle », « une silhouette », « un don Juan », « un harpagon », « un bordeaux », « le roquefort », « le macadam », « la langue de Molière », un christ, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dc56ed4-2c84-49b7-a8fa-71efd0d79341",
                        "source_entry_id": "134f8855-b650-35b9-901a-39ff98d86635",
                        "source_sense_id": "dd462cf6-1503-394b-be0e-9f2456343e4e",
                        "target_lang_word": "antonomasia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
