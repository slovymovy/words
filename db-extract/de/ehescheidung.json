                        "form": "die Ehescheidung"
                    },
                    {
                        "form_id": "37e88b76-ac8c-4eae-aa77-62324bfcf9e9",
                        "entry_id": "8851486e-631e-30aa-b4a7-aec20e07baa2",
                        "tags": [
                            "accusative",
