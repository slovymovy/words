                    },
                    {
                        "translation_id": "4af22717-bb31-428f-85b5-ebc54686af72",
                        "source_entry_id": "5d1deeea-8a17-327a-b69b-2610f378e3e7",
                        "source_sense_id": "3b837ee5-d3f6-33b9-aeaa-53bb5a82129f",
