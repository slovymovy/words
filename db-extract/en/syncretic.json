                                        "sense_id": "5ac3815d-517a-3003-80bf-b38cac807655",
                                        "entry_id": "d684f690-fd7c-3f01-834e-eb8e3a792719",
                                        "glosses": [
                                            "den Synkretismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a1c685-051b-4351-a19a-94e7e1a70619",
                                                "sense_id": "5ac3815d-517a-3003-80bf-b38cac807655",
                                                "text": "Der Tempel ist zwar daoistisch, aber durchaus synkretistisch beeinflusst."
                                            },
                                            {
                                                "example_id": "c636e1e2-cf39-43ee-9f33-228fcdef115a",
                                                "sense_id": "5ac3815d-517a-3003-80bf-b38cac807655",
                                                "text": "„Monotheistische Religionen grenzen sich von synkretistischen Tendenzen in der Regel stärker ab als Religionen, deren innere Struktur ohnehin einen gewissen Pluralismus aufweist.“"
                                            },
                                            {
                                                "example_id": "914a3016-3c6b-4675-85fb-0c68ce3067d7",
                                                "sense_id": "5ac3815d-517a-3003-80bf-b38cac807655",
                                                "text": "„Der Islam gewann allmählich an Bedeutung, ohne aber die synkretistischen Strömungen völlig zu verdrängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
