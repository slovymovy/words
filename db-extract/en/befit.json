                                        "sense_id": "ad9447e9-6f3f-3077-9986-dec97afb24e5",
                                        "entry_id": "e3202ccb-817d-383f-aac6-8554de590d69",
                                        "glosses": [
                                            "rinunciare al modo di esprimere la propria individualità specifica, comunque entro le regole consuete, rispettando invece alcuni aspetti \\\"normali\\\" o comuni e, talvolta appunto abituali ed invero imposti, gli schemi di una presunta collettività"
                                        ],
