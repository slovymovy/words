                        "sense_id": "49d5ee94-1cd9-3aef-9d11-c821dcd248c1",
                        "entry_id": "1f5575b1-5b4b-3e2c-b12d-2c9771254c8b",
                        "glosses": [
                            "iemand die op een heel eenvoudige, primitieve, natuurlijke wijze leeft; iemand die veel van de natuur houdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f7bcf3-3927-4642-aec1-e5936a39cbc2",
                                "sense_id": "49d5ee94-1cd9-3aef-9d11-c821dcd248c1",
                                "text": "Hij behoorde, kortom, tot het slag lieden dat zich natuurmens noemt omdat het geen televisiedocumentaire over wildreservaten overslaat, en 's zomers met een mandje bramen langs de spoorlijn plukt."
                            },
                            {
                                "example_id": "3ae0b64a-f229-4a83-9b1b-9c088a7735c7",
                                "sense_id": "49d5ee94-1cd9-3aef-9d11-c821dcd248c1",
                                "text": "\"Je zou zeggen: waarom zou een Afrikaan in vredesnaam hardlopen? Eerder liep die sowieso al genoeg, was gezond en veel meer een natuurmens dan een mens in zo'n consumptiemaatschappij als in het rijke, als je het zo wil noemen, westen.\""
                            }
                        ]
                    }
