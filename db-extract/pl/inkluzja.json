                                "target_senses": [
                                    {
                                        "sense_id": "722b7c00-e054-3482-9a75-66a825354fb5",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "An addition or annex to a group, set, or total."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa9f046-9e2b-4aeb-b366-ad5eef8c853e",
                                                "sense_id": "722b7c00-e054-3482-9a75-66a825354fb5",
                                                "text": "The poem was a new inclusion in the textbook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d12bee5-6286-3f91-b469-b54f422a8b2d",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "The act of including, i.e. adding or annexing, (something) to a group, set, or total."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "524b2ce8-306c-4848-920f-8d7133e1e100",
                                                "sense_id": "8d12bee5-6286-3f91-b469-b54f422a8b2d",
                                                "text": "The inclusion of the poem added value to the course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d9654e-29fd-3c88-8391-357323504f19",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "Anything foreign that is included in a material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a55ede07-65f4-336c-a4a9-78f423d0bfdc",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "Any material that is trapped inside a mineral during its formation, as a defect in a precious stone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa67f0f7-346d-44ee-9f71-1397a55d747d",
                                                "sense_id": "a55ede07-65f4-336c-a4a9-78f423d0bfdc",
                                                "text": "The fewer inclusions a diamond has, the better is its clarity and value. Often the inclusions can be cut out of a diamond in the rough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb64cb7a-1c27-30a8-9020-42eaffd3c35d",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "A nuclear or cytoplasmic aggregate of stainable substances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d923e868-e442-334c-a15f-ec766db54f9b",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "An object completely inside a tissue, such as epidermal inclusion cyst, a cyst in the epidermis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d67b6ab2-58a8-3859-a25f-cddb5c205f78",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "A mapping where the domain is a subset of the image."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "323e51b0-85a2-352e-9b8e-3f7a3e1fa31c",
                                        "entry_id": "fd64612f-3f83-3c6b-a84b-84a0215925d2",
                                        "glosses": [
                                            "Restriction; limitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
