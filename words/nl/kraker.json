    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f0c5b7f-fb8a-3695-8462-0dd20982ebc7",
                    "sense_definition": "Iemand die zonder toestemming van de eigenaar een leegstaand gebouw in gebruik neemt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>krakers</w> wilden het lege pand niet zomaar verlaten. Doordat de <w>krakers</w> woonden in het leegstaande pand, ontstond er een discussie. ",
                            "target_lang_translations": {
                                "en": "The <w>squatters</w> did not want to leave the empty building just like that. Because the <w>squatters</w> lived in the vacant building, a discussion arose."
                            }
                        },
                        {
                            "text": "In de oude fabriek woonden jarenlang <w>krakers</w>.",
                            "target_lang_translations": {
                                "en": "<w>Squatters</w> lived in the old factory for years."
                            }
                        }
                    ],
                    "synonyms": [
                        "occupant"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who occupies an abandoned building without permission from the owner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squatter",
                                "target_lang_sense_clarification": "person occupying property without permission"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49b7d508-b587-3326-a9c7-1bd83fbb1cae",
                    "sense_definition": "Een chiropractor of therapeut die gewrichten en spieren behandelt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ongeluk ging hij naar de <w>kraker</w> om zijn rug te laten behandelen. Hij had een afspraak bij de <w>kraker</w> voor zijn nekklachten.",
                            "target_lang_translations": {
                                "en": "After the accident, he went to the <w>chiropractor</w> to get his back treated. He had an appointment with the <w>chiropractor</w> for his neck complaints."
                            }
                        },
                        {
                            "text": "Hij moet voor een onderzoek naar de <w>kraker</w>.",
                            "target_lang_translations": {
                                "en": "He has to go to the <w>chiropractor</w> for an examination."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele term voor chiropractor"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A chiropractor or therapist who treats joints and muscles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chiropractor",
                                "target_lang_sense_clarification": "joint alignment specialist"
                            },
                            {
                                "target_lang_word": "bonesetter",
                                "target_lang_sense_clarification": "informal term for joint practitioner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c64a055-c969-35a8-a7bc-efc44c011553",
                    "sense_definition": "Een spannende sportwedstrijd of een groot succesnummer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgen spelen de twee topclubs een echte <w>kraker</w> in het stadion.",
                            "target_lang_translations": {
                                "en": "Tomorrow the two top clubs are playing a real <w>thriller</w> in the stadium."
                            }
                        },
                        {
                            "text": "De finale van het toernooi belooft een absolute <w>kraker</w> te worden.",
                            "target_lang_translations": {
                                "en": "The tournament final promises to be an absolute <w>thriller</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een echte kraker"
                    ],
                    "target_lang_definitions": {
                        "en": "An exciting sports match or a major hit/blockbuster."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thriller",
                                "target_lang_sense_clarification": "exciting sports match"
                            },
                            {
                                "target_lang_word": "blockbuster",
                                "target_lang_sense_clarification": "great success or hit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2e1b0f6-91f8-337f-9847-752718a30be5",
                    "sense_definition": "Iemand die iets kraakt, of een werktuig om iets mee te kraken (zoals een notenkraak).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gebruiken een metalen <w>kraker</w> om de harde noten te openen.",
                            "target_lang_translations": {
                                "en": "We use a metal <w>nutcracker</w> to open the hard nuts."
                            }
                        },
                        {
                            "text": "De computerhacker is een bekende <w>kraker</w> van beveiligingssystemen.",
                            "target_lang_translations": {
                                "en": "The computer hacker is a well-known <w>cracker</w> of security systems."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone or something that cracks things, such as a cracker tool or a hacker."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cracker",
                                "target_lang_sense_clarification": "tool or person that cracks"
                            },
                            {
                                "target_lang_word": "nutcracker",
                                "target_lang_sense_clarification": "tool for cracking nuts"
                            },
                            {
                                "target_lang_word": "hacker",
                                "target_lang_sense_clarification": "person cracking security systems"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d52864a-6523-359d-86e0-d955ba8fe342",
                    "sense_definition": "Een installatie of fabriek waarin grote organische moleculen gesplitst worden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de raffinaderij werkt de chemische <w>kraker</w> op volle toeren.",
                            "target_lang_translations": {
                                "en": "In the refinery, the chemical <w>cracker</w> is running at full capacity."
                            }
                        },
                        {
                            "text": "De nieuwe <w>kraker</w> zorgt voor een efficiënter productieproces van brandstoffen.",
                            "target_lang_translations": {
                                "en": "The new <w>cracker</w> ensures a more efficient fuel production process."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische/chemische term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An installation or chemical plant in which large organic molecules are split."
                    },
                    "translations": {
                        "en": [
                            {
