                            {
                                "example_id": "f0557014-1652-4957-8d07-b72584c4a726",
                                "sense_id": "a3f72fd3-6122-3459-8e4f-85c94b07557a",
                                "text": "Une clause assez ordinaire des baux est la défense faite au preneur de déssoler ni décomposter."
