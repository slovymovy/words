                ],
                "senses": [
                    {
                        "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                        "entry_id": "a3139088-0ca2-3659-af14-072111955dd1",
                        "glosses": [
                            "Umsetzung von Motiven in Handlungen; Wille, eine geplante Handlung tatsächlich auszuführen, um ein gesetztes Ziel zu erreichen"
                        ],
                        "tags": [
                            "Verhaltensforschung",
                            "Managementlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "ed4347fc-e4d3-40bd-bdd4-def342e8167b",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Motivation und Volition sind zwei wichtige Bereiche aus der Psychologie und Verhaltensforschung, welche, wenn sie optimal zusammenwirken, dabei helfen, das eigene Verhalten besser zu steuern.“"
                            },
                            {
                                "example_id": "fd4a823a-a125-4980-8884-640880ba5ac9",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Mit dem Blick auf Motivation und Volition, immer schön dem Rubikon-Prozess folgend, beleuchten wir das Thema Prokrastination:“"
                            },
                            {
                                "example_id": "a735564b-8ade-4197-a473-287a4995d692",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Die wichtigste Unterscheidung, die du zwischen Motivation und Volition kennen solltest [sic!] ist die, dass [sic!] sich ein Ziel setzen (Motivation) und es auch wirklich umsetzen (Volition) [sic!] zwei unterschiedliche Paar Schuhe sind.“"
                            },
                            {
                                "example_id": "8e5d9a7f-9eec-4c40-bda1-9556d848d9b0",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Die Motivation ist dein Kickstarter und bringt die Volition erst so richtig in Gang.“"
                            },
                            {
                                "example_id": "40b41f6a-5f7f-4647-a163-c9e7327ad6f4",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Eine Serie von Experimenten im MPI für Kognitions- und Neurowissenschaften mit der funktionellen Magnetresonanz-Tomographie (fMRT) hat nun gezeigt, dass ein ganz bestimmtes Areal die Volition verarbeitet – der \"frontomediane Kortex\" (FMK) gleich hinter der Stirn, ganz zentral.“"
                            },
                            {
                                "example_id": "9c6c0b9a-949d-4078-ab21-4999833ced01",
                                "sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                                "text": "„Weitergehend wird die Volition – das heißt, die Handlung, mit der das durch die Motivation angestrebte Ziel erreicht werden soll – untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dda8da7-df70-405e-b1ed-7d8e94bc2681",
                        "source_entry_id": "a3139088-0ca2-3659-af14-072111955dd1",
                        "source_sense_id": "43a37f35-88aa-3f6a-ba45-d3de6e66948c",
                        "source_sense_description": "Wille, eine geplante Handlung tatsächlich auszuführen",
                        "target_lang_word": "volition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "920ee501-99e7-3db2-81e7-e91a8d10a254",
                                        "entry_id": "d0d36200-b47a-3f17-be39-b1a1a57afc84",
                                        "glosses": [
                                            "A conscious choice or decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d908555a-3250-4bcc-ab9a-535714427056",
                                                "sense_id": "920ee501-99e7-3db2-81e7-e91a8d10a254",
                                                "text": "[…] And as the Understanding doth at once apprehend it as Good Abſolutely, or in ſome Reſpect, and Evil in other reſpects, and Comparatively a Leſs Good; ſo doth the Will at once continue to Love or Will it ſo farre as it is Apprehended as Good, and to Nill and Reject it as inconſiſtent with a Greater Good, or a hinderer of it. But if it fall out that the Inconſiſtency of theſe is not diſcerned or believed, or but Imperfectly, then may the Will by a Practical Volition Will them both."
                                            },
                                            {
                                                "example_id": "387457d4-0cfd-4281-90dc-9e6f8eaea9a3",
                                                "sense_id": "920ee501-99e7-3db2-81e7-e91a8d10a254",
                                                "text": "[Antonio] Conte has broken the mould further with the suggestion he might escape the [Roman] Abramovich cleaver, becoming the first of his line to leave by his own volition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0299860-0d96-3637-9abc-b8b3c2b7f602",
                                        "entry_id": "d0d36200-b47a-3f17-be39-b1a1a57afc84",
                                        "glosses": [
                                            "The mental power or ability of choosing; the will."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "147616dc-8d37-4d71-9050-cc07a5161220",
                                                "sense_id": "b0299860-0d96-3637-9abc-b8b3c2b7f602",
                                                "text": "Out of all the factors that can influence a person’s decision, none can match the power of his or her own volition."
                                            },
                                            {
                                                "example_id": "763b257a-1b16-4595-ab75-a5e0a7349c96",
                                                "sense_id": "b0299860-0d96-3637-9abc-b8b3c2b7f602",
                                                "text": "The volition may be in accordance with the desire or not; it may be in accordance with the moral feelings, and wholly at variance with the desires; but in both alike the desires and volitions are distinct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a5c76d-8bbf-3a4f-9428-5101e9ba028b",
                                        "entry_id": "d0d36200-b47a-3f17-be39-b1a1a57afc84",
                                        "glosses": [
                                            "A concept that distinguishes whether or not the subject or agent intended something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9659051-9e90-463a-97c1-113c18c55295",
                                                "sense_id": "64a5c76d-8bbf-3a4f-9428-5101e9ba028b",
                                                "text": "English has not one FOR TO construction but several. These several constructions are interrelated and form a chain, or rather a family, of constructions, with identical or similar components recurring in more or less similar configurations. […] The composition of this family can be represented as follows: (1) Personal volition (e.g. I want very much for Peter to be present.) (2) Volition expressed in directives (e.g. He gave orders for his family to be summoned.) (3) Impersonal (unspecified) volition (e.g. It is necessary for Peter to be present.) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
