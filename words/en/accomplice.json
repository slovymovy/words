{
    "word_family": [
        "accomplish",
        "accomplishment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                    "sense_definition": "A person who helps another person to commit a crime or do something wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criminal_associate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are still looking for the <w>accomplice</w> who drove the getaway car after the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция все еще ищет <w>сообщника</w>, который вел машину для побега после ограбления."
                            }
                        },
                        {
                            "text": "He was charged as an <w>unwilling</w> <w>accomplice</w> because he was forced to help the thieves.",
                            "target_lang_translations": {
                                "ru": "Ему было предъявлено обвинение как <w>невольному</w> <w>соучастнику</w>, так как его заставили помогать ворам."
                            }
                        }
                    ],
                    "synonyms": [
                        "abettor",
                        "accessory",
                        "confederate"
                    ],
                    "common_phrases": [
                        "unwilling accomplice",
                        "criminal accomplice",
                        "named as accomplice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который помогает другому совершить преступление или какой-либо предосудительный поступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщник",
                                "target_lang_sense_clarification": "человек, участвующий в преступлении"
                            },
                            {
                                "target_lang_word": "соучастник",
                                "target_lang_sense_clarification": "лицо, принимающее участие в совершении преступления"
                            },
                            {
                                "target_lang_word": "пособник",
                                "target_lang_sense_clarification": "тот, кто содействует совершению преступления"
                            },
                            {
                                "target_lang_word": "подельник",
                                "target_lang_sense_clarification": "разговорный термин для соучастника преступления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95444974-883d-36a9-8891-b0d490e385b1",
                    "sense_definition": "A person who works together with others toward a common goal; a cooperator.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general wished success to his brave <w>accomplices</w> in their noble quest for freedom.",
                            "target_lang_translations": {
                                "ru": "Генерал пожелал успеха своим отважным <w>соратникам</w> в их благородном стремлении к свободе."
                            }
                        },
                        {
                            "text": "In this ambitious project, he found a <w>willing</w> <w>accomplice</w> who shared his vision for change.",
                            "target_lang_translations": {
                                "ru": "В этом амбициозном проекте он нашел <w>готового</w> <w>помощника</w>, который разделял его видение перемен."
                            }
                        }
                    ],
                    "synonyms": [
                        "associate",
                        "ally",
                        "assistant"
                    ],
                    "common_phrases": [
                        "willing accomplice"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is less common in modern usage than the criminal sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который работает вместе с другими для достижения общей цели; соратник или помощник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соратник",
                                "target_lang_sense_clarification": "товарищ по борьбе или деятельности"
                            },
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "тот, кто помогает в каком-либо деле"
                            },
                            {
                                "target_lang_word": "соучастник",
                                "target_lang_sense_clarification": "в переносном смысле — тот, кто разделяет какое-либо дело или чувство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}