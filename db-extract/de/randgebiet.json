                    {
                        "form_id": "435f45bc-1668-4a13-b382-dce91de736bc",
                        "entry_id": "2f3f8897-91e4-3529-85ba-e9c858e0f88e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Randgebiete"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "275e4a72-d54b-328b-ab9e-6d943a1e31d2",
                        "entry_id": "2f3f8897-91e4-3529-85ba-e9c858e0f88e",
                        "glosses": [
                            "räumlich an der Außenseite/Außenkante/Peripherie liegendes Areal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ae7f5a-7439-4cca-82b5-1baec02c7904",
                                "sense_id": "275e4a72-d54b-328b-ab9e-6d943a1e31d2",
                                "text": "In den Randgebieten der Stadt wurden damals noch viele Neubauprojekte umgesetzt."
                            },
                            {
                                "example_id": "9d17905a-c6bd-4f0c-b54c-a7b7829635b5",
                                "sense_id": "275e4a72-d54b-328b-ab9e-6d943a1e31d2",
                                "text": "„In der Nacht, die er zum erstenmal im Archiv verbracht hatte, war der Patron seines Gasthofs von Stadtwächtern abgeholt und, wie es hieß, mit einem Transport in die abseits liegenden nordwestlichen Randgebiete auf den Weg gebracht worden.“"
                            },
                            {
                                "example_id": "b08b57af-d6d1-47b3-ab2c-1385eff42cf8",
                                "sense_id": "275e4a72-d54b-328b-ab9e-6d943a1e31d2",
                                "text": "„Schon vor rund 8000 Jahren gab es in den Randgebieten des Industals sesshaften Ackerbau.“"
                            },
                            {
                                "example_id": "dd5b9882-e7ad-4fc0-917f-6a2d757bd9a3",
                                "sense_id": "275e4a72-d54b-328b-ab9e-6d943a1e31d2",
                                "text": "„Sie waren im erst dreißig Jahre alten »Königreich Preußen« gelandet, das auch in seinen Randgebieten erstaunlich gut oganisiert war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6df027d7-8b61-347f-9849-e3ad5371d4fb",
                        "entry_id": "2f3f8897-91e4-3529-85ba-e9c858e0f88e",
                        "glosses": [
                            "bedeutungsmäßig weniger interessanter oder bekannter Themenkomplex"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12c8e8b-05a8-4662-959c-7dd9bebc7fe8",
                                "sense_id": "6df027d7-8b61-347f-9849-e3ad5371d4fb",
                                "text": "Sie beschäftigt sich mehr mit den Randgebieten der Archäologie."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
