                                "target_senses": [
                                    {
                                        "sense_id": "1eb629a8-4bbf-3ebd-8b89-e3c35ee878f3",
                                        "entry_id": "96b89e23-5a72-3076-a860-6907304f8fc8",
                                        "glosses": [
                                            "The state of being deprived of or lacking an attribute formerly or properly possessed; the loss or absence of such an attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dc96211-9b02-34ad-a195-a3ea2ed4e33b",
                                        "entry_id": "96b89e23-5a72-3076-a860-6907304f8fc8",
                                        "glosses": [
                                            "The state of being very poor, and lacking the basic necessities of life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ef255c-e299-433d-9146-485570ef9bdf",
                                                "sense_id": "6dc96211-9b02-34ad-a195-a3ea2ed4e33b",
                                                "text": "His [the Native American's] nature is stern, simple and enduring; fitted to grapple with difficulties, and to support privations."
                                            },
                                            {
                                                "example_id": "0e409724-87c8-47c4-bb71-a65da132e88c",
                                                "sense_id": "6dc96211-9b02-34ad-a195-a3ea2ed4e33b",
                                                "text": "For Yen Hsüeh-mei, the Shanghai-bred nurse, life in northern Hupei must have represented a striking change. Lao-ho-k'ou was the headquarters of General Li Tsung-jen, commander of the Fifth War Area.[…]If the General lived in such humble quarters, it is safe to say that the quarters to which Chiang Kuei brought his wife were plainer yet. But physical privation was nearly universal and in many ways Lao-ho-k'ou was an interesting place to be."
                                            },
                                            {
                                                "example_id": "2421593c-223a-439a-b2ec-fbea9c2cdc74",
                                                "sense_id": "6dc96211-9b02-34ad-a195-a3ea2ed4e33b",
                                                "text": "Mr. McCarthy wrote for many years in relative obscurity and privation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eb96333-76b3-3294-b4cb-e538353a8c93",
                                        "entry_id": "96b89e23-5a72-3076-a860-6907304f8fc8",
                                        "glosses": [
                                            "The act of depriving someone of such basic necessities; deprivation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ea217c-19a8-37a0-b79e-e0213ca9abe0",
                                        "entry_id": "96b89e23-5a72-3076-a860-6907304f8fc8",
                                        "glosses": [
                                            "Degradation or suspension from an office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63204e4c-ef06-4df0-8c12-4e3740225e5b",
                                                "sense_id": "b0ea217c-19a8-37a0-b79e-e0213ca9abe0",
                                                "text": "Refinement and amusement, like knowledge, are so diffused now-a-days, that an exile from the royal circle would be a nominal punishment; but it then included every species of privation. The theatre—at that era such a resource—balls, fêtes, &c., to say nothing of worldly influence, were all forfeited by a banishment from court, the centre of all the pleasures, variety, and ambition of society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
