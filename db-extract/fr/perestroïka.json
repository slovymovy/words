                "translations": [
                    {
                        "translation_id": "b59feeaf-600c-4057-bc17-8e0e5818bf57",
                        "source_entry_id": "d15e09db-0a85-3250-baea-55f5a0fb12e8",
                        "source_sense_id": "d07fe757-0fe7-3723-baf0-04d897f9bc87",
                        "source_sense_description": "historisch, Sowjetunion, Politik: Perestroika",
                        "target_lang_word": "Perestroika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perestroika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                        "entry_id": "f12dbfab-f55e-31fd-aa7a-fe169a9d995b",
                                        "glosses": [
                                            "Schlagwort des früheren sowjetischen Staatschefs Michael Gorbatschow, die auf die Reform des Staats- und Wirtschaftssystems der damaligen UdSSR abzielte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cefff4-51bb-4960-9c0e-f48c726ca325",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "Erst Gorbatschows Perestroika führte Mitte der Achtziger dazu, dass nicht mehr von oben entschieden wurde, wer zu welchem Turnier fährt, und dass das Preisgeld bei den Spielern blieb."
                                            },
                                            {
                                                "example_id": "22223c4a-5252-4b91-a005-87d3542fd75c",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Seit Beginn der »Perestroika« wurde das Verbot, sich mit der Vorkriegsgeschichte der Region zu beschäftigen, schrittweise aufgehoben.“"
                                            },
                                            {
                                                "example_id": "11c08ecb-c38d-4922-aee4-f79f8750d82b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mit der Perestroika begann schließlich eine neue Zeitrechnung.“"
                                            },
                                            {
                                                "example_id": "ec04982c-e57c-4dce-ace5-919adc2b5ae0",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mein Begleiter zeigte mir die Stadt, in deren Straßen der Frühlingshauch der Perestroika wehte.“"
                                            },
                                            {
                                                "example_id": "1ee70601-8465-4bd2-8f88-65269bb87b3b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Es ist aber längst an der Zeit, daß die Perestroika den Frauen ihr Gesicht zuwendet. Es wird Zeit, daß man auch weibliche Gesichter unter den Führern des Landes erblickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26606060-7675-46ed-8b54-f2c88e96ccaf",
                        "source_entry_id": "d15e09db-0a85-3250-baea-55f5a0fb12e8",
                        "source_sense_id": "d07fe757-0fe7-3723-baf0-04d897f9bc87",
                        "source_sense_description": "historisch, Sowjetunion, Politik: Perestroika",
                        "target_lang_word": "perestroika",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perestroika",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca6cfe4-9cae-3dcb-986e-581f5f7166aa",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "A program of political and economic reform carried out in the Soviet Union in the 1980s and early 1990s under the leadership of Mikhail Gorbachev."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8b784f-89ce-4d6a-a8ad-8e89237594be",
                                                "sense_id": "8ca6cfe4-9cae-3dcb-986e-581f5f7166aa",
                                                "text": "Gorbachev would introduce glasnost (openness and freedom) and perestroika (economic restructuring) to Russia under his tenure, ultimately freeing thousands of political prisoners and dissidents and trying to address the shortages in food and goods that had become the hallmarks of the failing Soviet economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd0c80a-3ea5-3a84-ac70-63b663b4a4b9",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "The period of time in the Soviet Union during which these reforms were carried out and in effect."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acdf5798-d5b6-3f81-8867-fe63e87af340",
                                        "entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                                        "glosses": [
                                            "A situation where a small variation of parameters leads to a sudden change in properties."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
