                    "sense_id": "029fcdb2-1e62-3fef-88f3-53cd05826251",
                    "sense_definition": "zebrać przedmioty lub rzeczy w jednym miejscu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W muzeum <w>zgromadzono</w> popiersia z brązu portretujące znanych Polaków.",
                            "target_lang_translations": {
                                "ru": "В музее <w>собрали</w> бронзовые бюсты, изображающие известных поляков."
                            }
                        },
                        {
                            "text": "W efekcie zbiórki <w>zgromadzono</w> sumę stu tysięcy złotych.",
                            "target_lang_translations": {
                                "ru": "В результате сбора средств <w>собрали</w> сумму в сто тысяч злотых."
                            }
                        }
                    ],
                    "synonyms": [
                        "skupić",
                        "zebrać"
                    ],
                    "antonyms": [
                        "rozproszyć"
                    ],
                    "common_phrases": [
                        "zgromadzić fundusze",
                        "zgromadzić zapasy"
                    ],
                    "target_lang_definitions": {
                        "ru": "сосредоточить предметы или вещи в одном месте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрать",
                                "target_lang_sense_clarification": "свести воедино, накопить что-либо в одном месте"
                            },
                            {
                                "target_lang_word": "накопить",
                                "target_lang_sense_clarification": "собрать в большом количестве (например, средства или запасы)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a685460-a8ef-3e7b-af69-33c6d06e7233",
                    "sense_definition": "sprawić, że grupa osób znajdzie się w jednym miejscu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczorajszy wiec <w>zgromadził</w> około czterech tysięcy uczestników.",
                            "target_lang_translations": {
                                "ru": "Вчерашний митинг <w>собрал</w> около четырех тысяч участников."
                            }
                        },
                        {
                            "text": "Wydarzenie to <w>zgromadziło</w> wielu fanów muzyki klasycznej.",
                            "target_lang_translations": {
                                "ru": "Это событие <w>собрало</w> многих поклонников классической музыки."
                            }
                        }
                    ],
                    "synonyms": [
                        "zebrać",
                        "zwołać"
                    ],
                    "common_phrases": [
                        "zgromadzić tłum",
                        "zgromadzić uczestników"
                    ],
                    "target_lang_definitions": {
                        "ru": "организовать присутствие группы людей в одном месте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрать",
                                "target_lang_sense_clarification": "привлечь или организовать группу людей"
                            },
                            {
                                "target_lang_word": "созвать",
                                "target_lang_sense_clarification": "официально пригласить или вызвать людей на встречу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5e124a-101d-3796-b859-674f4a0a37aa",
                    "sense_definition": "zebrać się w grupie w jednym miejscu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Póki co zaparzono kawę i rodzina <w>zgromadziła</w> <w>się</w> przy stole.",
                            "target_lang_translations": {
                                "ru": "Тем временем заварили кофе, и семья <w>собралась</w> за столом."
                            }
                        },
                        {
                            "text": "Wszyscy goście <w>zgromadzili</w> <w>się</w> w salonie, aby powitać Nowy Rok.",
                            "target_lang_translations": {
                                "ru": "Все гости <w>собрались</w> в гостиной, чтобы встретить Новый год."
                            }
                        }
                    ],
                    "synonyms": [
