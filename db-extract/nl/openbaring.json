                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ec2c43-f4d8-4c29-8e2a-1bcc8bc3daee",
                                "sense_id": "22bda3b0-e6bb-33f8-ad09-44d10738e800",
