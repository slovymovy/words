                ],
                "senses": [
                    {
                        "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                        "entry_id": "869fc5c7-6e4a-320e-86cf-e60050a9d427",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e4ffab-7b64-4f97-8835-bb30da88b853",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Frau Ungruh ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3eca4da9-3945-4f9e-8993-46e386a10cc3",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Herr Ungruh wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9c4910ff-a7b5-4465-94d7-1011b4be9581",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Die Ungruhs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f869ebb3-01ac-4b0e-abb3-7f53578fb167",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Der Ungruh trägt nie die Schals, die die Ungruh ihm strickt."
                            },
                            {
                                "example_id": "222ce9ab-80d7-4f01-a11a-3670f36ba3e6",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ungruh kommt, geht der Herr Unruh.“"
                            },
                            {
                                "example_id": "a8c5f664-3329-4699-afff-6fccf94cb60a",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Ungruh kommt und geht."
                            },
                            {
                                "example_id": "8dcedcb0-99c8-404a-ae87-7f5ed9fc3fe9",
                                "sense_id": "d2385477-2b44-38a4-9143-54f669fde5bd",
                                "text": "Ungruhs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
