                                        "glosses": [
                                            "Dans les traductions de textes antiques, relatif aux pays du Levant (les Grecs et les Romains ne connaissant pas l’Extrême-Orient)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77de2175-d759-41ee-9c20-ff23b5f23628",
                                                "sense_id": "8ff0dc24-2ec3-349d-86e8-13cb4d66df1e",
                                                "text": "Éloquence asiatique : profuse et ampoulée."
                                            }
                                        ]
                                    }
