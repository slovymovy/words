                    {
                        "form_id": "a1fc8f4c-3f00-455f-ae5d-621b8fe21b49",
                        "entry_id": "c21ca164-69a2-321e-b229-6ca2f7cca122",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ineradicable"
