                                        "entry_id": "aea6d5fb-cebe-3cae-b258-3e23d0e7597f",
                                        "glosses": [
                                            "any of four unstable subatomic particles, mesons, they are a combination of a strange quark or antiquark and either an up or down quark or antiquark"
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a02fe5-b357-4cff-ab13-343939ddc691",
                                                "sense_id": "feae3ae2-6ba2-38f9-a72e-0fba3cdffbff",
                                                "text": "K⁰: strange quark + down antiquark"
                                            },
                                            {
                                                "example_id": "b5912905-eead-4c82-add7-8166b50f34cc",
                                                "sense_id": "feae3ae2-6ba2-38f9-a72e-0fba3cdffbff",
                                                "text": "K (antiparticle of K⁰): down quark + strange antiquark"
                                            },
                                            {
                                                "example_id": "6e89416d-c058-4191-8c6e-d6f30e8b05ab",
                                                "sense_id": "feae3ae2-6ba2-38f9-a72e-0fba3cdffbff",
                                                "text": "K⁺: strange quark + up antiquark"
                                            },
                                            {
                                                "example_id": "7826509b-7a1a-4c28-88b6-9cfceff4e316",
                                                "sense_id": "feae3ae2-6ba2-38f9-a72e-0fba3cdffbff",
                                                "text": "K⁻ (antiparticle of K⁺): up quark + strange antiquark"
                                            }
                                        ]
                                    }
                                ]
