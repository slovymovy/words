                {
                    "sense_id": "cbd431a8-85f6-34b9-b202-d0b3ef89153a",
                    "sense_definition": "Simple past and past participle of <w>dig</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>dug</w> a deep hole in the backyard.",
                            "target_lang_translations": {
                                "ru": "Собака <w>вырыла</w> глубокую яму на заднем дворе.",
                                "de": "Der Hund <w>grub</w> ein tiefes Loch im Garten."
                            }
                        },
                        {
                            "text": "We <w>dug</w> up some old potatoes from the vegetable garden.",
                            "target_lang_translations": {
                                "ru": "Мы <w>выкопали</w> немного старой картошки из огорода.",
                                "de": "Wir haben einige alte Kartoffeln aus dem Gemüsegarten <w>ausgegraben</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dug a hole",
                        "dug up",
                        "dug in",
                        "dug out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>dig</w>.",
                        "de": "Vergangenheitsform (Präteritum) und Partizip Perfekt des Verbs 'dig' (graben)."
                    },
                    "translations": {
