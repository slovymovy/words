{
    "word_family": [
        "pick",
        "up"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5713177-9734-3a36-9bfe-cb7928636e6f",
                    "sense_definition": "A small truck with an enclosed cab and an open back for carrying goods; short for <w>pickup truck</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loaded the camping gear into the back of his <pickup>.",
                            "target_lang_translations": {
                                "ru": "Он погрузил туристическое снаряжение в кузов своего <пикапа>.",
                                "zh": "他把露营装备装进了他的<w>皮卡</w>后斗里。"
                            }
                        },
                        {
                            "text": "We rented a <pickup> to move the furniture.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали <пикап>, чтобы перевезти мебель.",
                                "zh": "我们租了一辆<w>皮卡</w>来搬运家具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pickup truck",
                        "drive a pickup",
                        "old pickup"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for pickup truck"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой грузовик с закрытой кабиной и открытым кузовом для перевозки грузов; сокращение от pickup truck.",
                        "zh": "一种带有封闭驾驶室和开放式货箱的小型卡车，用于运送货物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пикап",
                                "target_lang_sense_clarification": "тип кузова автомобиля"
                            },
                            {
                                "target_lang_word": "грузовичок",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皮卡",
                                "target_lang_sense_clarification": "汽车车型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c13db19-5347-3a11-bbca-6aeae01532c4",
                    "sense_definition": "The act of collecting a person or goods, often by vehicle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_collect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant offers curbside <pickup> for all online orders.",
                            "target_lang_translations": {
                                "ru": "Ресторан предлагает бесконтактный <самовывоз> для всех онлайн-заказов.",
                                "zh": "这家餐厅为所有在线订单提供路边<w>自提</w>服务。"
                            }
                        },
                        {
                            "text": "I am waiting for a <pickup> at the airport terminal.",
                            "target_lang_translations": {
                                "ru": "Я жду <машину> у терминала аэропорта.",
                                "zh": "我正在机场航站楼等车来<w>接</w>我。"
                            }
                        }
                    ],
                    "antonyms": [
                        "delivery",
                        "drop-off"
                    ],
                    "common_phrases": [
                        "curbside pickup",
                        "schedule a pickup",
                        "order for pickup",
                        "pickup point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по сбору людей или грузов, часто с использованием транспортного средства.",
                        "zh": "收集人员或货物的行为，通常使用车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самовывоз",
                                "target_lang_sense_clarification": "товара покупателем"
                            },
                            {
                                "target_lang_word": "забор",
                                "target_lang_sense_clarification": "груза курьером"
                            },
                            {
                                "target_lang_word": "подвоз",
                                "target_lang_sense_clarification": "пассажира"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自提",
                                "target_lang_sense_clarification": "顾客自行取货"
                            },
                            {
                                "target_lang_word": "接",
                                "target_lang_sense_clarification": "接人或接物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1d78274-914a-329d-9136-2ec3c0311549",
                    "sense_definition": "An item in a video game that a player collects to gain an advantage, ability, or points.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to grab the health <pickup> before fighting the boss.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно взять <аптечку> перед битвой с боссом.",
                                "zh": "在打BOSS之前，你需要先拿到那个生命值<w>补给</w>。"
                            }
                        },
                        {
                            "text": "There is a hidden weapon <pickup> behind that wall.",
                            "target_lang_translations": {
                                "ru": "За той стеной спрятан <бонус> с оружием.",
                                "zh": "那堵墙后面藏着一个武器<w>道具</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "health pickup",
                        "weapon pickup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет в видеоигре, который игрок подбирает для получения преимущества, способности или очков.",
                        "zh": "电子游戏中玩家收集以获得优势、能力或分数的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бонус",
                                "target_lang_sense_clarification": "усиление"
                            },
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "игровой объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道具",
                                "target_lang_sense_clarification": "游戏内可拾取物品"
                            },
                            {
                                "target_lang_word": "补给",
                                "target_lang_sense_clarification": "恢复类物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1af2d60b-0ed7-3982-806e-6abb7bf3f571",
                    "sense_definition": "A casual sports game played by people who gather without a formal team or schedule.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They played a game of <pickup> basketball at the park.",
                            "target_lang_translations": {
                                "ru": "Они играли в <дворовый> баскетбол в парке.",
                                "zh": "他们在公园里打了一场<w>野球</w>。"
                            }
                        },
                        {
                            "text": "He enjoys playing <pickup> hockey on weekends.",
                            "target_lang_translations": {
                                "ru": "Ему нравится играть в <любительский> хоккей по выходным.",
                                "zh": "他喜欢在周末打<w>业余</w>冰球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pickup game",
                        "play pickup",
                        "pickup basketball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любительская спортивная игра, в которую играют люди, собравшиеся без формальной команды или расписания.",
                        "zh": "人们在没有正式球队或赛程安排的情况下自发组织的休闲体育比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворовый",
                                "target_lang_sense_clarification": "уличный, непрофессиональный"
                            },
                            {
                                "target_lang_word": "любительский",
                                "target_lang_sense_clarification": "неофициальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "野球",
                                "target_lang_sense_clarification": "非正式比赛"
                            },
                            {
                                "target_lang_word": "业余比赛",
                                "target_lang_sense_clarification": "非职业比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3db34d8-e7b8-34b4-baa6-47f6d8a4cf26",
                    "sense_definition": "An electronic device on a musical instrument (like a guitar) or record player that converts sound vibrations into electrical signals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist adjusted the <pickup> to get a clearer sound.",
                            "target_lang_translations": {
                                "ru": "Гитарист настроил <звукосниматель>, чтобы получить более чистый звук.",
                                "zh": "吉他手调整了<w>拾音器</w>以获得更清晰的声音。"
                            }
                        },
                        {
                            "text": "This vintage record player needs a new <pickup>.",
                            "target_lang_translations": {
                                "ru": "Этому старинному проигрывателю нужен новый <звукосниматель>.",
                                "zh": "这台老式唱片机需要一个新的<w>拾音器</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "phono cartridge"
                    ],
                    "common_phrases": [
                        "guitar pickup",
                        "bridge pickup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное устройство на музыкальном инструменте или проигрывателе, преобразующее звуковые колебания в электрические сигналы.",
                        "zh": "乐器（如吉他）或唱片机上的电子装置，将声音振动转换为电信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звукосниматель",
                                "target_lang_sense_clarification": "устройство"
                            },
                            {
                                "target_lang_word": "адаптер",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拾音器",
                                "target_lang_sense_clarification": "乐器装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e5b64c7-a723-3ca5-87aa-d260fecf87be",
