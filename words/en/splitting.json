                    "sense_definition": "The cleavage or breaking of a covalent bond.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>splitting</w> of water molecules produces hydrogen and oxygen gas.",
                            "target_lang_translations": {
                                "ru": "<w>Расщепление</w> молекул воды приводит к образованию водорода и кислорода.",
                                "pl": "<w>Rozszczepienie</w> cząsteczek wody wytwarza wodór i tlen."
                            }
                        },
                        {
                            "text": "Energy is released during the <w>splitting</w> of the chemical bonds.",
                            "target_lang_translations": {
