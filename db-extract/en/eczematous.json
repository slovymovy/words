                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exémateux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                        "entry_id": "7e34acd9-8243-3984-839d-48591c6c2e61",
                                        "glosses": [
                                            "Variante de eczémateux."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd821f42-bf7f-4962-93de-96d575d54482",
                                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                                "text": "C’est une affection exémateuse."
                                            },
                                            {
                                                "example_id": "1b08f82a-2631-4506-bbac-991686967de0",
                                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                                "text": "Son bras exémateux le démange."
                                            },
                                            {
                                                "example_id": "29c692ca-6bf1-45b6-9e47-7d2bba3b281f",
                                                "sense_id": "44ea4b8f-6fdc-37da-b634-d9ddb3e21d72",
                                                "text": "Petit, malingre, le visage exémateux, il n’inspirait confiance que si on l’entendait discuter alfaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exémateux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "744d9cbc-f00c-3faa-ad4f-a05d178c4fe7",
                                        "entry_id": "e1a43256-8480-394e-8840-2ed10bb60953",
                                        "glosses": [
                                            "Variante de eczémateux."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f680a731-373e-43a3-9fbc-c80cfed00c9a",
                                                "sense_id": "744d9cbc-f00c-3faa-ad4f-a05d178c4fe7",
                                                "text": "Les exémateux sont de plus en plus nombreux."
                                            },
                                            {
                                                "example_id": "982fa7c4-6bea-41d6-9c9d-45846647082f",
                                                "sense_id": "744d9cbc-f00c-3faa-ad4f-a05d178c4fe7",
                                                "text": "Je ne sais plus où me mettre, et je dois être aussi rouge que la face d’un exémateux en plein soleil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
