                                                "sense_id": "fe88d851-0cf5-3be3-b622-1e37d092d97a",
                                                "text": "Zur Reduzierung der Heizkosten empfiehlt sich eine thermische Dämmung der Hausfassade."
                                            },
                                            {
                                                "example_id": "117888f6-cb8c-41ca-85fb-a26138364d6e",
                                                "sense_id": "fe88d851-0cf5-3be3-b622-1e37d092d97a",
                                                "text": "„Die thermische Energie, die in unserer Erde gespeichert ist, kann in Strom umgewandelt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
