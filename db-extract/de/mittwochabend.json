                "senses": [
                    {
                        "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                        "entry_id": "b44bdeec-f462-3bad-b78b-05aeb11cd37d",
                        "glosses": [
                            "der Abend eines Mittwochs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e198ce22-f502-41cc-8e2a-6f507e981211",
                                "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                                "text": "Mittwochabend komme ich kurz bei dir vorbei und hole das Segel ab."
                            },
                            {
                                "example_id": "fcc00f26-f1d0-447e-9d18-c56d61a29628",
                                "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                                "text": "Die nächsten drei Mittwochabende werde ich mit dem Vertikutieren unserer immensen Rasenflächen zu tun haben."
                            },
                            {
                                "example_id": "0b5f9401-f220-4da3-b18d-90dbf0cb6a15",
                                "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                                "text": "„Am frühen Mittwochabend, nur vier Tage nach der Tat, umzingelten 35 Beamte das Grundstück am Rand einer Kleingartensiedlung, auf dem Jörg B. hauste.“"
                            },
                            {
                                "example_id": "a505039e-3bb9-4a52-b3eb-7990bcce9d48",
                                "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                                "text": "„Am Mittwochabend veranlaßte sie John Fletcher, sie auf dem Grab zu fotografieren.“"
                            },
                            {
                                "example_id": "23bf8189-8dae-4f1e-8500-6ea458898413",
                                "sense_id": "7a256423-5cbc-339e-99d5-803779bbd9d9",
                                "text": "„An einem Mittwochabend gegen neun Uhr war Feuer bei der Vesterport, am westlichen Stadtrand, ausgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
