                        ],
                        "zh": [
                            {
                                "target_lang_word": "开瓶器",
                                "target_lang_sense_clarification": "用于开启瓶盖"
                            },
                            {
                                "target_lang_word": "开罐器",
                                "target_lang_sense_clarification": "用于开启罐头"
                            }
                        ]
