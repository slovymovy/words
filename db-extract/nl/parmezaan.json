                        "glosses": [
                            "bepaald soort harde, pittige Italiaanse kaas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7449b1-e813-486d-a47d-1f0e3058a63d",
                                "sense_id": "8c526363-7ba1-3897-906e-3b34c1851bf0",
                                "text": "De scheikundigen scheidden vetten en eiwitten af en concentreerden de aromastoffen in waterige oplossingen, die vervolgens met massaspectrometers werden onderzocht. Ervaren proefpersonen testten zowel de parmezaan als de oplossingen en concludeerden dat het extract en de echte kaas vrijwel hetzelfde smaakten."
                            },
                            {
                                "example_id": "61dc5ea6-e2d5-4b60-883c-ed4015d73130",
                                "sense_id": "8c526363-7ba1-3897-906e-3b34c1851bf0",
                                "text": "Er wordt soms gezegd: vis en kaas kunnen niet samen, maar deze scholfilet met groene asperges en parmezaan bewijst dat dit niet altijd het geval hoeft te zijn. Bovendien is het gezond en ziet het er kleurrijk uit."
                            }
                        ]
                    }
