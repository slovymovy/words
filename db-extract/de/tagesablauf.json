                        ],
                        "form": "den Tagesablauf"
                    },
                    {
                        "form_id": "109b54fa-eea2-43dc-9c2c-445c8d922144",
                        "entry_id": "e7fc6d89-9f71-318e-a279-6ec250c69434",
                        "tags": [
                            "accusative",
