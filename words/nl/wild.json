    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cba49091-bf2c-377e-8453-0b8583a55de8",
                    "sense_definition": "levend of groeiend in de vrije natuur, niet door mensen tam gemaakt of gekweekt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bos kun je nog <w>wilde</w> zwijnen tegenkomen als je heel stil bent.",
                            "target_lang_translations": {
                                "en": "In this forest, you can still encounter <w>wild</w> boars if you are very quiet."
                            }
                        },
                        {
                            "text": "De <w>wilde</w> kat is een beschermde diersoort die in de vrije natuur leeft.",
                            "target_lang_translations": {
                                "en": "The <w>wild</w> cat is a protected species that lives in the wild."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongetemd",
                        "natuurlijk"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wilde dieren",
                        "wilde bloemen",
                        "wilde planten"
                    ],
                    "target_lang_definitions": {
                        "en": "living or growing in the wild, not tamed or cultivated by humans"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "untamed or undomesticated"
                            },
                            {
                                "target_lang_word": "natural",
                                "target_lang_sense_clarification": "existing in nature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28adec51-349b-3d9d-a25b-de0e535ade0b",
                    "sense_definition": "onrustig, onbeheerst of heel druk in gedrag of beweging",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen waren erg <w>wild</w> aan het spelen in de achtertuin.",
                            "target_lang_translations": {
                                "en": "The children were playing very <w>wildly</w> in the backyard."
                            }
                        },
                        {
                            "text": "Hij probeerde het <w>wilde</w> kind tot rede te brengen door haar arm vast te houden.",
                            "target_lang_translations": {
                                "en": "He tried to reason with the <w>unruly</w> child by holding her arm."
                            }
                        }
                    ],
                    "synonyms": [
                        "onstuimig",
                        "woest",
                        "druk"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wild spelen",
                        "wilde haren",
                        "wilde plannen"
                    ],
                    "target_lang_definitions": {
                        "en": "restless, uncontrolled, or very active in behavior or movement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "unrestrained or rowdy"
                            },
                            {
                                "target_lang_word": "boisterous",
                                "target_lang_sense_clarification": "noisy, energetic, and cheerful"
                            },
                            {
                                "target_lang_word": "unruly",
                                "target_lang_sense_clarification": "disorderly and disruptive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e913b470-4be3-3269-b47d-31ee8f882900",
                    "sense_definition": "onbeschaafd, ruw of zonder rekening te houden met regels en conventies",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn jeugd leidde hij een <w>wild</w> leven vol feesten en muziek.",
                            "target_lang_translations": {
                                "en": "In his youth, he led a <w>wild</w> life full of parties and music."
                            }
                        },
                        {
                            "text": "De posters vertellen verhalen over jong en <w>wild</w> zijn in een voorbij tijdperk.",
                            "target_lang_translations": {
                                "en": "The posters tell stories about being young and <w>wild</w> in a bygone era."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeschaafd",
                        "bruusk",
                        "bandeloos"
                    ],
                    "antonyms": [
                        "tam"
                    ],
                    "common_phrases": [
                        "wild leven",
                        "wilde staking"
                    ],
                    "target_lang_definitions": {
                        "en": "uncivilized, rough, or without regard for rules and conventions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "licentious or unruly"
                            },
                            {
                                "target_lang_word": "savage",
                                "target_lang_sense_clarification": "brutal or uncivilized"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "without care for consequences"
                            }
                        ]
                    }
                }
            ]
        },
        {
