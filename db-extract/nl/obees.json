                "senses": [
                    {
                        "sense_id": "6d80b46d-eaec-37c0-8267-26a4c7e5b656",
                        "entry_id": "b1844464-eb82-3768-81c0-5f52c0885a5d",
                        "glosses": [
                            "overgewicht hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05927134-c453-4bf0-9768-11f5f00f304a",
                                "sense_id": "6d80b46d-eaec-37c0-8267-26a4c7e5b656",
                                "text": "De Amerikaanse kinder-endocrinoloog Robert Lustig, moedeloos van een praktijk vol obese kinderen, gaat verder en noemt suiker vergif."
                            },
                            {
                                "example_id": "78f13c06-8c9e-40e1-8b66-2eb4dc018a68",
                                "sense_id": "6d80b46d-eaec-37c0-8267-26a4c7e5b656",
                                "text": "\"Wij verwachten mensen tot 300 kilo. Iemand die zich vijf kilo te zwaar vindt en wil afvallen, hoort niet bij ons thuis. Wij zijn er voor mensen die een Quetelet Index hebben van 30 of hoger en lijden aan ernstig overgewicht ofwel vetzucht\", verklaart Jolien Pon, één van de initiatiefnemers tot de oprichting van de kliniek. Ze is zelf obees en voorzitter van de Nederlandse Obesitas Vereniging."
                            }
                        ]
                    }
