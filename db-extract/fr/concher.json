                ],
                "senses": [
                    {
                        "sense_id": "6bc9ebe0-6aed-34b2-84d9-c3cd6fed0cfa",
                        "entry_id": "d80dd7d9-9842-38a7-a06a-1e3713bbc310",
                        "glosses": [
                            "Affiner (le chocolat) par conchage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f10e4a8-c868-4db4-acfb-8352062fce77",
                                "sense_id": "6bc9ebe0-6aed-34b2-84d9-c3cd6fed0cfa",
                                "text": "Alors qu’un chocolat ordinaire n’est conché que quelques heures, un grand chocolat l’est parfois plusieurs jours."
                            },
                            {
                                "example_id": "d18a1f50-bf49-428d-babc-18830810dcd9",
                                "sense_id": "6bc9ebe0-6aed-34b2-84d9-c3cd6fed0cfa",
                                "text": "Il faut qu’on s’occupe de tout le processus : sélectionner les meilleures fèves de cacao bio, les monder et les concasser, les torréfier, les broyer pour obtenir une pâte liquide, concher et affiner le chocolat, puis mélanger tous les ingrédients avant d’arriver au produit final."
                            },
                            {
                                "example_id": "b8bcbf33-7433-4ef1-bba7-6bd213f94e8e",
                                "sense_id": "6bc9ebe0-6aed-34b2-84d9-c3cd6fed0cfa",
                                "text": "Le sucre est sous forme de petits grains, si petits que, pour un chocolat bien \"conché\" par une meule qui tourne, il est imperceptible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75c86db2-416f-426d-9080-237b03586342",
                        "source_entry_id": "d80dd7d9-9842-38a7-a06a-1e3713bbc310",
                        "source_sense_id": "6bc9ebe0-6aed-34b2-84d9-c3cd6fed0cfa",
                        "source_sense_description": "Affiner le chocolat par conchage",
                        "target_lang_word": "conchieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conchieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57a83003-0f9b-3fc1-95a7-3a2a3ae0fd52",
                                        "entry_id": "79923826-aa42-34bd-b8d0-5454a5b3b900",
                                        "glosses": [
                                            "Schokolade über längere Zeit durchrühren und dazu erwärmen (maschinell in einer Conche/Konche), um ihre Konsistenz und ihren Geschmack zu verbessern und zu veredeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab2ccb6-9212-42e1-89d0-bc0298fe1df1",
                                                "sense_id": "57a83003-0f9b-3fc1-95a7-3a2a3ae0fd52",
                                                "text": "„Nicht nur Wasser, sondern auch Geruchs-, Bitter- und Aromakomponenten verflüchtigen sich durch langes Conchieren. Der Geschmack der Schokolade wird so positiv beeinflusst.“"
                                            },
                                            {
                                                "example_id": "2a35628c-8d5d-4b22-b832-3135cd233901",
                                                "sense_id": "57a83003-0f9b-3fc1-95a7-3a2a3ae0fd52",
                                                "text": "„Einfache Schokoladen werden bis zu zwölf Stunden conchiert, hochwertige bis zu drei Tage.“"
                                            },
                                            {
                                                "example_id": "86ae2137-f43d-45ae-8373-e68939e99f3a",
                                                "sense_id": "57a83003-0f9b-3fc1-95a7-3a2a3ae0fd52",
                                                "text": "„Conchiert wird heutzutage nicht mehr nur Schokolade, die Erfindung von Lindt haben mittlerweile auch die Hersteller von Speiseeis für sich entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
