                                        "sense_id": "baff0434-4583-3544-a1af-09eb2b5ffb46",
                                        "entry_id": "07c5ea67-780d-3bae-ac3b-489b0ac50f2d",
                                        "glosses": [
                                            "Statuette funéraire égyptienne, partie du mobilier funéraire."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d65357-16b3-4ce6-9cd5-ad77f009cec1",
                                                "sense_id": "baff0434-4583-3544-a1af-09eb2b5ffb46",
                                                "text": "Un touriste débrouillard pourrait acheter un oushebti authentique pour quelques dollars, au Caire."
                                            },
                                            {
                                                "example_id": "4bb9e613-c3d2-439d-a4b9-3a8bc5c9a974",
                                                "sense_id": "baff0434-4583-3544-a1af-09eb2b5ffb46",
                                                "text": "Une inscription de huit lignes identifie le défunt comme étant « Psamétik, qu’a mis au monde Sebarekhyt » et présente le chapitre 6 du Livre des Morts indiquant la fonction de cet oushebti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
