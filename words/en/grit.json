{
    "word_family": [
        "gritty",
        "grittiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                    "sense_definition": "Strength of mind, courage, or determination to overcome difficulties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete showed true <w>grit</w> by finishing the race despite her injury.",
                            "target_lang_translations": {
                                "cs": "Mladá atletka prokázala opravdovou <w>odhodlanost</w>, když závod dokončila i přes své zranění."
                            }
                        },
                        {
                            "text": "It takes a lot of <w>grit</w> to start a business in such a difficult economy.",
                            "target_lang_translations": {
                                "cs": "Založit podnikání v takto obtížné ekonomické situaci vyžaduje velkou <w>vytrvalost</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "courage",
                        "fortitude",
                        "determination",
                        "perseverance"
                    ],
                    "antonyms": [
                        "cowardice"
                    ],
                    "common_phrases": [
                        "show grit",
                        "true grit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vnitřní síla, odvaha nebo odhodlání překonávat obtíže."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odhodlanost",
                                "target_lang_sense_clarification": "pevná vůle dosáhnout cíle"
                            },
                            {
                                "target_lang_word": "vytrvalost",
                                "target_lang_sense_clarification": "schopnost pokračovat i přes překážky"
                            },
                            {
                                "target_lang_word": "kuráž",
                                "target_lang_sense_clarification": "odvaha čelit těžkým situacím"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db518025-4c65-307a-84c0-4dbcd6faa3a5",
                    "sense_definition": "Small, hard particles of stone, sand, or dirt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers removed the <w>grit</w> from the floor before painting it.",
                            "target_lang_translations": {
                                "cs": "Dělníci před malováním odstranili z podlahy <w>drť</w>."
                            }
                        },
                        {
                            "text": "Heavy rain washed the <w>grit</w> into the storm drain.",
                            "target_lang_translations": {
                                "cs": "Silný déšť spláchl <w>písek</w> do kanalizace."
                            }
                        }
                    ],
                    "synonyms": [
                        "sand",
                        "dust",
                        "debris"
                    ],
                    "target_lang_definitions": {
                        "cs": "Drobné, tvrdé částečky kamene, písku nebo nečistot."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drť",
                                "target_lang_sense_clarification": "rozdrcený materiál"
                            },
                            {
                                "target_lang_word": "písek",
                                "target_lang_sense_clarification": "sypký materiál z drobných zrnek"
                            },
                            {
                                "target_lang_word": "štěrk",
                                "target_lang_sense_clarification": "drobné kamínky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbef7c42-85e0-3bb6-aa33-af5aa00aeb55",
                    "sense_definition": "Small, hard, inedible particles found in food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could feel the <w>grit</w> in the salad because the lettuce was not washed well.",
                            "target_lang_translations": {
                                "cs": "V salátu jsem cítil <w>písek</w>, protože salát nebyl dobře umytý."
                            }
                        },
                        {
                            "text": "The bread had some <w>grit</w> in it that made it unpleasant to eat.",
                            "target_lang_translations": {
                                "cs": "V chlebu byly nějaké <w>nečistoty</w>, kvůli kterým se špatně jedl."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malé, tvrdé a nejedlé částečky v jídle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nečistoty",
                                "target_lang_sense_clarification": "cizorodé částice v potravinách"
                            },
                            {
                                "target_lang_word": "písek",
                                "target_lang_sense_clarification": "často používané pro nečistoty v zelenině"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c77b060-acc5-3c2b-9760-72401d27625e",
                    "sense_definition": "A measure of the coarseness of abrasive grains on materials like sandpaper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use a high <w>grit</w> sandpaper for the final smooth finish.",
                            "target_lang_translations": {
                                "cs": "Pro konečnou hladkou úpravu byste měli použít brusný papír s vysokou <w>zrnitostí</w>."
                            }
                        },
                        {
                            "text": "The wood was very rough, so I started with a low <w>grit</w> paper.",
                            "target_lang_translations": {
                                "cs": "Dřevo bylo velmi hrubé, takže jsem začal papírem s nízkou <w>zrnitostí</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fine grit",
                        "coarse grit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Míra hrubosti brusných zrn u materiálů, jako je brusný papír."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hrubost",
                                "target_lang_sense_clarification": "stupeň zrnitosti brusiva"
                            },
                            {
                                "target_lang_word": "zrnitost",
                                "target_lang_sense_clarification": "technický termín pro velikost zrn"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04aca745-7ea2-3275-8d11-5bb1e45eab74",
                    "sense_definition": "To clench one's teeth tightly, usually due to pain, anger, or determination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>grit</w> her teeth to endure the painful medical procedure.",
                            "target_lang_translations": {
                                "cs": "Musela <w>zatnout</w> zuby, aby vydržela bolestivý lékařský zákrok."
                            }
                        },
                        {
                            "text": "He <w>grit</w> his teeth in frustration when he heard the bad news.",
                            "target_lang_translations": {
                                "cs": "Když uslyšel špatné zprávy, frustrovaně <w>zatnul</w> zuby."
                            }
                        }
                    ],
                    "synonyms": [
                        "clench"
                    ],
                    "common_phrases": [
                        "grit teeth"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně sevřít zuby, obvykle kvůli bolesti, vzteku nebo odhodlání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatnout zuby",
                                "target_lang_sense_clarification": "pevné sevření čelistí"
                            },
                            {
                                "target_lang_word": "skřípat zuby",
                                "target_lang_sense_clarification": "tření zubů o sebe při napětí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c65055b7-07a5-3486-87e4-ea0fcb6e201c",
                    "sense_definition": "Coarsely ground corn or hominy served as a porridge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a traditional breakfast of eggs and <w>grits</w>.",
                            "target_lang_translations": {
                                "cs": "Vychutnali jsme si tradiční snídani z vajec a <w>kukuřičné kaše</w>."
                            }
                        },
                        {
                            "text": "The restaurant serves creamy <w>grits</w> with shrimp.",
                            "target_lang_translations": {
                                "cs": "Restaurace podává krémovou <w>kukuřičnou kaši</w> s krevetami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot grits"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in the Southern United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hrubě mletá kukuřice nebo hominy podávaná jako kaše."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kukuřičná kaše",
                                "target_lang_sense_clarification": "popisný název pro pokrm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}