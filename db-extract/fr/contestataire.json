                                "target_senses": [
                                    {
                                        "sense_id": "09d3bb27-263e-361f-afc4-d5ddfc2232f5",
                                        "entry_id": "caf6c014-5766-3ce5-8c81-d8230d9ac9e2",
                                        "glosses": [
                                            "que diverge da opinião geral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41828c4-88bc-47c0-9d08-3af8bbfe05a4",
                                                "sense_id": "09d3bb27-263e-361f-afc4-d5ddfc2232f5",
                                                "text": "A divisão também assola os representantes da ala dissidente do peronismo, os “ Anti-K”, que há dois meses anunciaram uma aliança “invencível”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c440498-efb2-3d2b-8039-4943b763ed01",
                                        "entry_id": "caf6c014-5766-3ce5-8c81-d8230d9ac9e2",
