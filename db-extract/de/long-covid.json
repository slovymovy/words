                ],
                "senses": [
                    {
                        "sense_id": "fe5720f3-7a93-391c-b836-817627e4f65b",
                        "entry_id": "879d9031-73ff-3f9c-991d-3cdc43d3b7e0",
                        "glosses": [
                            "Nachwirkungen/Langzeitfolgen von Covid-19; Weiterbestehen von Krankheitssymptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5e816f-444f-41ac-a2ab-0c5b78aa89be",
                                "sense_id": "fe5720f3-7a93-391c-b836-817627e4f65b",
                                "text": "„Mehr Daten, mehr Studien und immer mehr Gewissheit unter Ärzten und Wissenschaftlern, dass Long-Covid zu einer weiteren Belastungsprobe der Gesundheitssysteme wird.“"
                            },
                            {
                                "example_id": "0185af19-1e4e-42f3-8127-01dcf6320ce1",
                                "sense_id": "fe5720f3-7a93-391c-b836-817627e4f65b",
                                "text": "„Sorge machen ihm allerdings Long-Covid, der Herbst und Patienten, deren Behandlung verschoben wurde.“"
                            },
                            {
                                "example_id": "a8580c1c-14f5-49a5-861a-041298193fb4",
                                "sense_id": "fe5720f3-7a93-391c-b836-817627e4f65b",
                                "text": "„Betroffene sind oft müde oder erschöpft, können sich schwer konzentrieren: Long-Covid trifft viele Corona-Infizierte.“"
                            },
                            {
                                "example_id": "3c4c6ed3-75e5-4bc9-9c34-58cca2658c2c",
                                "sense_id": "fe5720f3-7a93-391c-b836-817627e4f65b",
                                "text": "„Schon jetzt ist klar, dass 10 % aller mit Corona infizierten Menschen, egal, ob sie schwere oder nur leichte Symptome gezeigt haben, an Long-Covid erkranken können und dass eines der am häufigsten betroffenen Organe das Gehirn ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
