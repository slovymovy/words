                                        "glosses": [
                                            "um Hilfe und Unterstützung bemüht, voller Sorge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56f0e47-35b9-412a-9bd2-a2a3b803680e",
                                                "sense_id": "011ebaad-64d5-3e7c-b149-ea19cf897c4d",
                                                "text": "Die um ihre Kinder besorgten Eltern waren nicht zu beruhigen."
                                            },
                                            {
                                                "example_id": "f3fc15a0-c6f8-416a-b901-6f20fd294a67",
                                                "sense_id": "011ebaad-64d5-3e7c-b149-ea19cf897c4d",
                                                "text": "„Das Landratsamt hatte Anfang Juni wegen der beiden Fälle zu einer Informationsveranstaltung eingeladen und Antworten auf Fragen besorgter Anwohner gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
