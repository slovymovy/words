                        "entry_id": "12b05aec-20fe-3c1e-938f-b8efafc9c3dd",
                        "glosses": [
                            "Tiers à qui un conservateur délègue la conservation de fonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50ad1ac-2540-441c-af01-36599a563073",
                                "sense_id": "17f25e6b-3152-3544-9406-051ada2d91d6",
                                "text": "Le contrôle de la gestion du fonds ne peut être délégué à un sous-dépositaire ou à un sous-conservateur."
                            },
                            {
                                "example_id": "2dd94b41-4708-4940-aa9d-58f14ba8c57a",
                                "sense_id": "17f25e6b-3152-3544-9406-051ada2d91d6",
                                "text": "Sous-conservateur : le dépositaire peut choisir de déléguer l’activité de conservation à un tiers, appelé le sous-conservateur."
                            }
                        ]
