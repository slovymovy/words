                    {
                        "form_id": "1826da0c-09fe-4413-a83c-3d8f7f0886ec",
                        "entry_id": "1cb9c3f0-e74c-32fd-aab5-414dc9577139",
                        "tags": [
                            "Suisse, Liechtenstein"
                        ],
                        "form": "Schloss"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2357bbc0-1ad8-3b22-b617-d783819be579",
                        "entry_id": "1cb9c3f0-e74c-32fd-aab5-414dc9577139",
                        "glosses": [
                            "Serrure, fermeture, fermoir, cadenas, antivol, verrou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78451f0c-8805-4e83-a80a-7b47febef70f",
                                "sense_id": "2357bbc0-1ad8-3b22-b617-d783819be579",
                                "text": "Er hat versehentlich den Schlüssel im Schloß stecken lassen.",
                                "translation": "Il a laissé par mégarde la clé dans la serrure"
                            },
                            {
                                "example_id": "a3eb9861-ee83-416a-ac31-3cf318b05860",
                                "sense_id": "2357bbc0-1ad8-3b22-b617-d783819be579",
                                "text": "hinter Schloß und Riegel.",
                                "translation": "Fermé à double tour"
                            }
                        ]
                    },
                    {
                        "sense_id": "985f7819-0eda-372b-991c-2632289be697",
                        "entry_id": "1cb9c3f0-e74c-32fd-aab5-414dc9577139",
                        "glosses": [
                            "Culasse d'une arme à feu (abréviation de Gewehrschloß)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "53872053-7b90-3378-9b0e-653d723e816a",
                        "entry_id": "1cb9c3f0-e74c-32fd-aab5-414dc9577139",
                        "glosses": [
                            "Château."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d354c7c-a645-4ae0-8a7c-4e6d3aa73e11",
                                "sense_id": "53872053-7b90-3378-9b0e-653d723e816a",
                                "text": "Chambord ist ein Schloß im Renaissance-Stil, während Schloß Neuschwanstein im neugotischen Stil gehalten ist.",
                                "translation": "Chambord est un château de style Renaissance, alors que le château de Neuschwanstein est de style néogothique."
                            },
                            {
                                "example_id": "e67cd0c0-dfab-44b3-9a58-4824dec93b38",
                                "sense_id": "53872053-7b90-3378-9b0e-653d723e816a",
                                "text": "Niemand konnte leugnen, daß es im Schloß spukte. Nichts Spektakuläres, bloß Schritte in leeren Gängen, Kinderweinen ohne Ursprung und manchmal ein schemenhafter Herr, der mit schnarrender Stimme darum bat, ihm Schuhbänder, kleine Spielzeugmagneten oder ein Glas Limonade abzukaufen.",
                                "translation": "Personne ne pouvait nier que le château était hanté. Rien de bien spectaculaire, simplement des pas dans les couloirs vides, des pleurs d’enfants venus de nulle part et parfois un personnage fantomatique qui demandait d’une voix sourde qu’on lui achète des lacets de chaussures, de petits jouets aimantés, ou un verre de limonade."
                            }
                        ]
                    }
                ],
