                            {
                                "example_id": "2b494d8b-69cc-4d32-b9f1-53c0a0bef54d",
                                "sense_id": "83df308f-bd9b-3d9f-b727-e4ea882b4fc1",
                                "text": "„Und wenn eben dieser Detective Sie so richtig reinlegen will, sagt er vielleicht noch, dass er Ihre Fingerabdrücke von der Waffe hat, oder es zwei Augenzeugen gibt, die Sie auf einem Foto in der Verbrecherkartei erkannt haben, oder dass das Opfer Sie kurz vor seinem Tod als Täter genannt hat.“"
                            },
                            {
                                "example_id": "a3871c55-6803-47b8-a1a8-491cd8861fd0",
                                "sense_id": "83df308f-bd9b-3d9f-b727-e4ea882b4fc1",
                                "text": "„›Ich gehe davon aus, Sie suchen nicht bloß in der Verbrecherkartei...‹“"
                            }
                        ],
