                "senses": [
                    {
                        "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                        "entry_id": "604a3620-7da0-3bae-9483-a9129cf05a04",
                        "glosses": [
                            "Qui ne respecte pas la grammaire considérée comme l’ensemble des règles définissant le discours correct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87fd61d0-bd61-4886-910a-08f13d947c46",
                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                "text": "« En descendant de vélo, une vache me regardait. » Cette phrase est agrammaticale, sauf si l’on considère que c’est la vache qui descendait du vélo."
                            },
                            {
                                "example_id": "0a4c07cc-f87d-4263-b20a-9102095502dc",
                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                "text": "L’emploi du mode subjonctif derrière la locution conjonctive « après que » est agrammatical."
                            },
                            {
                                "example_id": "51b14bde-898a-4fe0-b05d-f68b3605d58d",
                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                "text": "Sous l’influence grandissante de l’anglais, un certain nombre de tournures agrammaticales, quoique parfaitement comprises, fleurissent dans le français commun."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c5de0b2-435c-344c-bbd1-1f2b6d6728b8",
                        "entry_id": "604a3620-7da0-3bae-9483-a9129cf05a04",
                        "glosses": [
                            "Qui ne respecte pas les règles de production d’un énoncé propres à une langue donnée. Noam Chomsky a montré que la phrase « d’incolores idées vertes dorment furieusement » n’est pas agrammaticale mais inacceptable."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9d74a10-6bd0-4e7a-88da-041819202a98",
                        "source_entry_id": "604a3620-7da0-3bae-9483-a9129cf05a04",
