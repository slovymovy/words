                                "sense_id": "1ba4ba38-bde3-37a3-ab1c-90d5f2e9d54d",
                                "text": "Wegens afzegging is er een plaats vrijgekomen bij mijn workshop.",
                                "translation": "Due to cancellation, a place has become available at my workshop.",
                                "english": "Due to cancellation, a place has become available at my workshop."
                            }
                        ]
                    },
