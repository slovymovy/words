                    {
                        "form_id": "aec1ec9e-9c79-410b-86f3-f56f1602e93c",
                        "entry_id": "16ef28eb-02e0-39e0-a82f-0e3cb67715a5",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most gravely"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                        "entry_id": "16ef28eb-02e0-39e0-a82f-0e3cb67715a5",
                        "glosses": [
                            "In a grave or serious manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267c1b4d-f6e6-4c02-886a-5db279345c62",
                                "sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                                "text": "'No, no one's called that at home,' said Heidi gravely."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a356e4-660a-47c7-8be1-a1212db5ce1b",
                        "source_entry_id": "16ef28eb-02e0-39e0-a82f-0e3cb67715a5",
                        "source_sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                        "source_sense_description": "grave or serious manner",
                        "target_lang_word": "gravement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                        "entry_id": "ef30683f-38af-345e-8f80-938d33ade2d4",
                                        "glosses": [
                                            "Avec gravité ; d’une manière composée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf97493-b60e-4a45-9327-b635f7138115",
                                                "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                                "text": "Ses doigts tordaient et retordaient une fibre imaginaire qu'il simulait de nouer gravement."
                                            },
                                            {
                                                "example_id": "a251df00-a56e-4f2b-a5c8-26ebd0b866ac",
                                                "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                                "text": "Les hommes jouent gravement aux boules et se passionnent pour le foteballe ; ils prennent l'apéritif par habitude, rejoints par ceux qui le font par snobisme."
                                            },
                                            {
                                                "example_id": "f4788955-86a1-4de1-bcc5-cb6d15350198",
                                                "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                                "text": "Et la troupe, à l’instant cessant de fredonner, D’un ton gravement fou se mit à raisonner."
                                            },
                                            {
                                                "example_id": "e9471427-f22e-425d-92e5-4234a6fbccf5",
                                                "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                                "text": "Cydias, après avoir toussé, relevé sa manchette, étendu la main et ouvert les doigts, débite gravement ses pensées quintessenciées."
                                            },
                                            {
                                                "example_id": "8bfb0120-455c-4da2-a9a8-a60e3d1710aa",
                                                "sense_id": "4fbdf868-8b4b-3239-9fd3-dad1816b2994",
                                                "text": "Quand la gravité n'est que dans le maintien, comme il arrive très souvent, on dit gravement des inepties ; cette espèce de ridicule inspire de l’aversion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0213cc2-b031-3e17-8f8a-63537d7c9a99",
                                        "entry_id": "ef30683f-38af-345e-8f80-938d33ade2d4",
                                        "glosses": [
                                            "Dangereusement, d’une manière à entraîner de fâcheuses conséquences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdc07d6-d6aa-4c95-85db-e2f9d6ead286",
                                                "sense_id": "c0213cc2-b031-3e17-8f8a-63537d7c9a99",
                                                "text": "Il a été gravement malade. Il s’est gravement compromis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7876fdd-3cb1-36f8-a9e9-49281d69d9c8",
                                        "entry_id": "ef30683f-38af-345e-8f80-938d33ade2d4",
                                        "glosses": [
                                            "Il indique un mouvement lent, mais moins lent que le mouvement indiqué par lentement. On dit et on écrit plus ordinairement grave en italien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
