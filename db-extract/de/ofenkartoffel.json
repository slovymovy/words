                "senses": [
                    {
                        "sense_id": "0f205f87-3da4-395c-88d8-628294dcc2d9",
                        "entry_id": "463ebe61-a495-348d-b6a7-e1682e8d3521",
                        "glosses": [
                            "eine Kartoffel, die im Backofen gebacken wird, statt sie im Wasser zu kochen, um sie essbar zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d2751e-5cdc-473a-8062-d4ac7e6271fc",
                                "sense_id": "0f205f87-3da4-395c-88d8-628294dcc2d9",
                                "text": "Auf der Speisekarte des kleinen Imbiss stehen auch Ofenkartoffeln mit Sauerrahm oder Kräuterquark."
                            },
                            {
                                "example_id": "d535c031-aece-47cd-85bc-d19ffae3b4c1",
                                "sense_id": "0f205f87-3da4-395c-88d8-628294dcc2d9",
                                "text": "Dafür bekommen Sie zum Beispiel ein Rumpsteak, rosa gebraten, mit Ofenkartoffel und blanchiertem Gemüse."
                            },
                            {
                                "example_id": "2679afa4-9fc9-4b86-b3d7-dcd7b2dca769",
                                "sense_id": "0f205f87-3da4-395c-88d8-628294dcc2d9",
                                "text": "\"Kohlrabischeiben oder Möhrenstreifen können ähnlich wie eine Ofenkartoffel zubereitet werden\", sagt der Seminarleiter."
                            },
                            {
                                "example_id": "b8489380-fdf9-4767-814a-584327d4552b",
                                "sense_id": "0f205f87-3da4-395c-88d8-628294dcc2d9",
                                "text": "Hier gibt es eine durch und durch solide Currywurst oder auch Schweinsbratwürstl frisch vom Grill, ordentlich gebratene Pommes, große Ofenkartoffeln aus der Folie, schön saftiges Sauerkraut oder ein zwar gut gewürztes, aber leider nicht mehr gar so saftiges Grillhendl."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
