                            }
                        ]
                    },
                    {
                        "sense_id": "aa1055e1-a4aa-3f69-9339-d9ef0805b14b",
                        "entry_id": "f12b989c-bf20-3e56-ab16-f32a5d8d1e0e",
                        "glosses": [
                            "Sailors’ breeches ending just below the knees or above the ankles, worn mainly in XVIII century."
                        ],
                        "tags": [
                            "historical",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "6743d36b-c73a-44c3-8866-3f43cd3740d0",
                                "sense_id": "aa1055e1-a4aa-3f69-9339-d9ef0805b14b",
                                "text": "The original \"slops\" were voluminous breeches of about knee length, reminiscent of 17th century \"petticoat breeches\", worn with stockings; these continue to be depicted as late as 1790s, but trousers, first introduced as slop-clothing in 1720s, were more functional and more popular."
                            }
                        ]
