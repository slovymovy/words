                "senses": [
                    {
                        "sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                        "entry_id": "d64ef9e2-a766-36ff-be9b-23740a755eb4",
                        "glosses": [
                            "een wijdverspreide honger als gevolg van voedselschaarste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0bd5ad-4d16-4a40-9c31-7850195a6210",
                                "sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                                "text": "De bezetting van westelijk Nederland eindigde in een hongersnood."
                            },
                            {
                                "example_id": "a5672bcd-fbb6-47ce-8224-04495bf2c335",
                                "sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                                "text": "Er verschenen boeken als The Population Bomb van Stanford-hoogleraar Paul Ehrlich, waarin hij waarschuwde voor grote hongersnoden aan het eind van die eeuw omdat er nooit genoeg voedsel geproduceerd kon worden voor de exploderende bevolking."
                            },
                            {
                                "example_id": "ab6dfcda-df92-4004-a9f7-635e4f424bbc",
                                "sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                            },
                            {
                                "example_id": "727859dd-0abc-469c-9088-47875e61cf40",
                                "sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                                "text": "Ïn Zuid-Korea legt de overheid verantwoording af aan de burgers en heeft de bevolking volop economische kansen; het land is zeer welvarend\", aldus de Nederlandse uitgever bij het verschijnen van dat boek. \"Noord-Korea wordt dictatoriaal geregeerd en kent al tientallen jaren onderdrukking en hongersnood.\""
                            }
                        ]
                    }
                ],
