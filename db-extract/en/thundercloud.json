                    }
                ],
                "senses": [
                    {
                        "sense_id": "934d8e1b-c272-35c9-a36a-199ecf83da15",
                        "entry_id": "4fefb944-9571-3bae-ae60-61f3af612370",
                        "glosses": [
                            "A large, dark cloud, usually a cumulonimbus, charged with electricity and producing thunder and lightning."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "34b934a3-912d-3b9b-b05c-a3582710e6aa",
                        "entry_id": "4fefb944-9571-3bae-ae60-61f3af612370",
                        "glosses": [
                            "Something menacing and brooding."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9b2fccb4-28d0-4db4-910f-387de6c99cbc",
                                "sense_id": "34b934a3-912d-3b9b-b05c-a3582710e6aa",
                                "text": "the ominous thunderclouds of war"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "396b153e-e7fb-4e4d-8359-7fb68e408c02",
                        "source_entry_id": "4fefb944-9571-3bae-ae60-61f3af612370",
                        "source_sense_description": "cloud",
                        "target_lang_word": "Gewitterwolke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewitterwolke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f4023b-50fb-3951-84be-bc77ef683f2f",
                                        "entry_id": "8bdb2470-927e-3929-8f59-c29be928b31b",
                                        "glosses": [
                                            "Wolke, die mit Gewitter einhergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085f4022-7030-4975-9369-fef4222c847f",
                                                "sense_id": "f5f4023b-50fb-3951-84be-bc77ef683f2f",
                                                "text": "„Eingestürzte Wände umgaben mich, gleißend hell wie Gewitterwolken bei einem Blitz.“"
                                            },
                                            {
                                                "example_id": "f64c4e0b-22dd-4285-8e74-e5ee76bdb222",
                                                "sense_id": "f5f4023b-50fb-3951-84be-bc77ef683f2f",
                                                "text": "„Während ich mich umsah, schossen ungeordnete Gedankenfetzen durch meinen Kopf, unruhig und fliehend wie die dunklen Gewitterwolken.“"
                                            },
                                            {
                                                "example_id": "739ea3b1-bbbc-476e-acff-6e388573a705",
                                                "sense_id": "f5f4023b-50fb-3951-84be-bc77ef683f2f",
                                                "text": "„Zu hören, wie die abgebrühte Gertrude Stein so begeistert von dem gewaltigen Himmel im Westen, den Wolkenkratzern in New York und den Gewitterwolken über Washington schwärmte, hatte in Sylvia zum ersten Mal seit vielen Jahren die Lust geweckt, das Land ihrer Herkunft wiederzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0e1cda-1624-4437-bbce-36ec1903d1ad",
                        "source_entry_id": "4fefb944-9571-3bae-ae60-61f3af612370",
                        "source_sense_description": "cloud",
                        "target_lang_word": "뇌운",
                        "target_lang_code": "ko",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "뇌운",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "4615213d-9198-3657-9929-6ef875aff27c",
                                        "entry_id": "3785cec6-ea10-3e91-8367-d5c5109d2d9d",
                                        "glosses": [
                                            "천둥과 번개가 발생하는 연직으로 크게 발달한 적란운."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e148900c-7647-4fa1-9145-7b73230d1ea4",
                                                "sense_id": "4615213d-9198-3657-9929-6ef875aff27c",
                                                "text": "대체로 발달한 번개구름(적란운)의 고도가 7km 이하이면 소나기는 내리지만 뇌방전은 일어나지 않고, 8km 이상이면 불꽃방전을 일으키는 뇌운에 이르게 된다."
                                            },
                                            {
                                                "example_id": "cd3da511-81f8-4509-bcaf-8f322cdc494e",
                                                "sense_id": "4615213d-9198-3657-9929-6ef875aff27c",
                                                "text": "강한 뇌방전을 일으키는 구름은 그 고도가 12~16km에 이르며, 여름철에 8~16km의 고도는 -20~-50˚C의 온도층에 해당된다."
                                            },
                                            {
                                                "example_id": "9b546e94-ba43-4fba-831b-f349ffed79ba",
                                                "sense_id": "4615213d-9198-3657-9929-6ef875aff27c",
                                                "text": "상승기류의 규모가 크고 구름의 상부가 -20~-50˚C의 온도층에 도달될 경우 이 온도가 뇌방전을 일으키는 필요조건으로 되어 있다."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
