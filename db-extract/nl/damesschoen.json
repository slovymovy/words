                        "examples": [
                            {
                                "example_id": "c0a23e24-ffed-45c3-b45f-b6ac75609995",
                                "sense_id": "a02bb625-9c4d-37db-82e8-5860ff2929c3",
                                "text": "Caroliene Ros en haar partner Nathalie bieden een gespreksgroep voor transgenders. In deze regio staan op dit moment vier- tot vijfhonderd transgenders op de wachtlijst om hun traject te starten. Maar dat is alleen een medisch verhaal, zegt Ros. Alles eromheen, van de emoties die komen kijken bij het slikken van hormonen tot het vinden van damesschoenen in maat 48, moeten deze mensen maar zelf uitzoeken."
                            },
                            {
                                "example_id": "81f8d934-a40b-4476-a469-85f090d8cb31",
                                "sense_id": "a02bb625-9c4d-37db-82e8-5860ff2929c3",
                                "text": "Kleding voor vrouwen werd 12% meer verkocht en bij damesschoenen steeg de verkoop met 6%. Ook kinderschoenen leverden 6% meer op en kleding voor kinderen iets meer: 10%."
                            }
                        ]
