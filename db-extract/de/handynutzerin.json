                                "example_id": "f4bafe48-203b-4c63-8298-37f57d70aee1",
                                "sense_id": "8db2380e-8613-3d8e-a231-afeed1e8777a",
                                "text": "„Auch Grünen-Fraktionschefin Katrin Göring-Eckardt tut sich als Handynutzerin hervor.“"
                            },
                            {
                                "example_id": "33e7f339-8e7c-4c4b-aa0c-2b02dd02dbc3",
                                "sense_id": "8db2380e-8613-3d8e-a231-afeed1e8777a",
                                "text": "„Für das Schweizer Teilprojekt luden die Forschenden im Jahr 2009 alle Handynutzerinnen und -nutzer in der Schweiz dazu ein, von versandten SMS eine Kopie an eine Gratisnummer zu schicken und im Internet einen anonymen Fragebogen auszufüllen.“"
                            }
