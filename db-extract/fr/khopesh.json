                        "examples": [
                            {
                                "example_id": "9a6275e5-16e6-4ed2-8643-9d50372dce99",
                                "sense_id": "dd32bc8f-3836-3429-abc3-b9fc8b7aad47",
                                "text": "Arrivée à sa hauteur, l’officier, vêtu d’une armure de cuir, arrêta la colonne et sauta à terre, la main serrée sur le poignée de son « khopesh », une courte épée incurvée."
                            },
                            {
                                "example_id": "7d7614c5-a5ed-411d-a1ff-083bb9e494d5",
                                "sense_id": "dd32bc8f-3836-3429-abc3-b9fc8b7aad47",
                                "text": "Cette arme, qui est un emblème de vaillance, avait reçu à cause de sa forme le nom de khopesh, nom égyptien de la cuisse de bœuf."
                            }
                        ]
                    }
