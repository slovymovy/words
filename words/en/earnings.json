{
    "word_family": [
        "earn",
        "earner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f070106-198c-3a70-ad4b-25486fd07853",
                    "sense_definition": "Money obtained in return for labor or services.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personal_income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was happy because her <w>earnings</w> increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Она была счастлива, так как её <w>заработок</w> в этом году значительно вырос.",
                                "zh": "她很高兴，因为她今年的<w>收入</w>显著增加了。"
                            }
                        },
                        {
                            "text": "The report shows that average <w>earnings</w> for women are still lower than for men.",
                            "target_lang_translations": {
                                "ru": "Отчет показывает, что средний <w>заработок</w> женщин все еще ниже, чем у мужчин.",
                                "zh": "报告显示，女性的平均<w>收入</w>仍然低于男性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "income",
                        "wages",
                        "pay",
                        "salary"
                    ],
                    "antonyms": [
                        "spending",
                        "expenditure"
                    ],
                    "common_phrases": [
                        "average earnings",
                        "annual earnings",
                        "gross earnings",
                        "weekly earnings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, полученные за работу или услуги.",
                        "zh": "通过劳动或服务获得的金钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за́работок",
                                "target_lang_sense_clarification": "плата за работу"
                            },
                            {
                                "target_lang_word": "дохо́д",
                                "target_lang_sense_clarification": "денежные поступления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收入",
                                "target_lang_sense_clarification": "个人获得的金钱总额"
                            },
                            {
                                "target_lang_word": "工资",
                                "target_lang_sense_clarification": "劳动报酬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5661c547-3798-345f-ba20-a47ffd0c2bcf",
                    "sense_definition": "The net profit made by a company.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "corporate_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company announced higher than expected <w>earnings</w> for the third quarter.",
                            "target_lang_translations": {
                                "ru": "Компания объявила о более высокой, чем ожидалось, <w>прибыли</w> за третий квартал.",
                                "zh": "该公司宣布第三季度的<w>利润</w>高于预期。"
                            }
                        },
                        {
                            "text": "Investors were disappointed by the drop in corporate <w>earnings</w>.",
                            "target_lang_translations": {
                                "ru": "Инвесторы были разочарованы падением корпоративной <w>прибыли</w>.",
                                "zh": "投资者对企业<w>利润</w>的下滑感到失望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "profit",
                        "net income"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "quarterly earnings",
                        "earnings report",
                        "earnings per share"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистая прибыль, полученная компанией.",
                        "zh": "公司获得的净利润。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при́быль",
                                "target_lang_sense_clarification": "чистый доход компании"
                            },
                            {
                                "target_lang_word": "дохо́д",
                                "target_lang_sense_clarification": "выручка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利润",
                                "target_lang_sense_clarification": "企业经营所得的净收益"
                            },
                            {
                                "target_lang_word": "收益",
                                "target_lang_sense_clarification": "公司财务表现中的盈利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2a66d89-c264-3a01-b374-b696df0bb772",
                    "sense_definition": "Financial gains obtained from investments.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "investment_gains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must declare all interest and <w>earnings</w> from your savings accounts.",
                            "target_lang_translations": {
                                "ru": "Вы должны задекларировать все проценты и <w>доходы</w> от ваших сберегательных счетов.",
                                "zh": "你必须申报储蓄账户中的所有利息和<w>收益</w>。"
                            }
                        },
                        {
                            "text": "The <w>earnings</w> on this bond are tax-free.",
                            "target_lang_translations": {
                                "ru": "<w>Доход</w> по этой облигации не облагается налогом.",
                                "zh": "该债券的<w>收益</w>免税。"
                            }
                        }
                    ],
                    "synonyms": [
                        "return",
                        "yield",
                        "gain"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "investment earnings",
                        "capital earnings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая выгода, полученная от инвестиций.",
                        "zh": "从投资中获得的财务收益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дохо́д",
                                "target_lang_sense_clarification": "прибыль от вложений"
                            },
                            {
                                "target_lang_word": "при́быль",
                                "target_lang_sense_clarification": "финансовая выгода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收益",
                                "target_lang_sense_clarification": "投资产生的回报"
                            },
                            {
                                "target_lang_word": "所得",
                                "target_lang_sense_clarification": "投资产生的财务进账"
                            }
                        ]
                    }
                }
