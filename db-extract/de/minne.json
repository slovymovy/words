                "senses": [
                    {
                        "sense_id": "c86e75f2-99b4-34ee-abe5-9fb657d734b8",
                        "entry_id": "add50a3f-30a8-344a-bfa2-b56494018dba",
                        "glosses": [
                            "das Gedenken (zu: meinen, im Mittelalter in der Bedeutung lieben, vergleiche „es mit jemandem gut meinen“)"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bfd02a36-92b6-3136-9dc0-83147acbb662",
                        "entry_id": "add50a3f-30a8-344a-bfa2-b56494018dba",
                        "glosses": [
                            "zunächst die helfende Liebe, dann die innige Liebe und Verehrung einer anderen Person, die Liebe zum anderen Geschlecht, später die körperliche Liebe; in der Mystik die Liebe zu Gott"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "90a8e6cf-2e77-4c60-b2aa-08b585cc6f55",
                                "sense_id": "bfd02a36-92b6-3136-9dc0-83147acbb662",
                                "text": "Die Minne ist ein häufig in der Literatur des Mittelalters anzutreffendes Thema."
                            },
                            {
                                "example_id": "4ebdd596-0e6f-4c36-83f4-765e9a341111",
                                "sense_id": "bfd02a36-92b6-3136-9dc0-83147acbb662",
                                "text": "„Am Ende des Mittelalters war das Wort Minne abgesunken, an seine Stelle tritt Liebe. Minne wird aber zusammen mit minnen … minniglich oder minnig (liebenswürdig) in der 2. Hälfte des 18. Jahrhunderts dichterisch neu belebt im Sinne edler Liebe […].“"
                            },
                            {
                                "example_id": "e97baee2-0e27-4e91-908a-cb2fe25af908",
                                "sense_id": "bfd02a36-92b6-3136-9dc0-83147acbb662",
                                "text": "„Etliche Leute wollen Gott mit Augen schauen, so wie sie eine Kuh betrachten, und wollen Gott genauso minnen, wie sie eine Kuh liebhaben. Die Kuh, die minnest du um die Milch und um den Käs, um deinen eigenen Nutz. So tun alle jene Leute, die Gott minnen um des auswendigen Reichtums oder um einwendigen Trostes willen. Solche Leute minnen Gott nicht auf rechte Weise, sondern sie minnen ihren eigenen Nutzen. Und wahrlich: solches Minnen wird dir zum Hindernis auf dem Weg zur allernächsten Wahrheit (Meister Eckhart Dominikanermönch ca. 1260 - 1327/29).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2552177-100b-4cee-9dc1-8d81f3a2dce8",
                        "source_entry_id": "add50a3f-30a8-344a-bfa2-b56494018dba",
                        "source_sense_id": "bfd02a36-92b6-3136-9dc0-83147acbb662",
                        "target_lang_word": "courtly love",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtly love",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e93543-f25c-34b9-beb1-246ff3c9e606",
                                        "entry_id": "680dd092-2a71-3bcd-aa72-c2dfcea886f1",
                                        "glosses": [
                                            "A mediaeval European conception of noble and chivalrous love, generally secret and between members of the nobility."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be309f84-5c00-400a-86ee-10f44bd5d5e0",
                                                "sense_id": "c1e93543-f25c-34b9-beb1-246ff3c9e606",
                                                "text": "The impression that courtly love is out of date, long superseded by modern manners, is a lure blinding us to how the logic of courtly love still defines the parameters within which the two sexes relate to each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
