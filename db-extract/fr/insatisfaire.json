                "senses": [
                    {
                        "sense_id": "32bc8580-7b6f-31ee-9b16-2dcf7ef3bbce",
                        "entry_id": "76d71e73-0efd-3e33-aa43-bfd4a8d72974",
                        "glosses": [
                            "Ne pas satisfaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6210a720-7cf4-4c03-a4c4-a199330ad9f3",
                                "sense_id": "32bc8580-7b6f-31ee-9b16-2dcf7ef3bbce",
                                "text": "Cette volonté d'insatisfaire la jouissance, voilà qui définit, de manière précise, la position hystérique."
                            },
                            {
                                "example_id": "4e0243e1-9dcb-49e7-88ed-520d999a318f",
                                "sense_id": "32bc8580-7b6f-31ee-9b16-2dcf7ef3bbce",
                                "text": "Elle devient une machine à insatisfaire."
                            },
                            {
                                "example_id": "402c19cd-16b4-43e9-bfeb-60e74a371737",
                                "sense_id": "32bc8580-7b6f-31ee-9b16-2dcf7ef3bbce",
                                "text": "L'entreprise est une formidable machine à « insatisfaire »."
                            },
                            {
                                "example_id": "61c20e35-4674-40f9-95c6-7b512eff4765",
                                "sense_id": "32bc8580-7b6f-31ee-9b16-2dcf7ef3bbce",
                                "text": "À la fin de l’exercice, ils avaient perdu tout le monde et avaient insatisfait tout le monde."
                            }
                        ]
                    }
