                {
                    "sense_id": "2f8f304a-dd68-35e3-9696-2c6137109dd0",
                    "sense_definition": "Als reactie op een handeling van iemand anders; wederkerig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reciprocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij naar mij zwaaide, zwaaide ik direct <w>terug</w>.",
                            "target_lang_translations": {
                                "en": "When he waved at me, I immediately waved <w>back</w>.",
                                "ru": "Когда он помахал мне, я сразу помахал <w>в ответ</w>.",
                                "pl": "Kiedy mi pomachał, od razu mu <w>odmachałem</w>.",
                                "de": "Als er mir winkte, winkte ich sofort <w>zurück</w>.",
                                "fr": "Quand il m'a fait signe, je lui ai immédiatement répondu <w>en retour</w>.",
                                "it": "Quando mi ha salutato con la mano, ho subito ricambiato il <w>saluto</w>.",
                                "cs": "Když na mě zamával, hned jsem mu zamával <w>zpátky</w>.",
                                "tr": "O bana el salladığında, ben de hemen <w>geri</w> el salladım.",
                                "es": "Cuando me saludó con la mano, yo le <w>devolví</w> el saludo de inmediato."
                            }
                        },
                        {
                            "text": "Als iemand je slaat, mag je niet zomaar <w>terug</w> slaan.",
                            "target_lang_translations": {
                                "en": "If someone hits you, you shouldn't just hit <w>back</w>.",
                                "ru": "Если кто-то тебя ударит, нельзя просто бить <w>в ответ</w>.",
                                "pl": "Jeśli ktoś cię uderzy, nie wolno ci tak po prostu <w>oddać</w>.",
                                "de": "Wenn dich jemand schlägt, darfst du nicht einfach <w>zurück</w>schlagen.",
                                "fr": "Si quelqu'un te frappe, tu ne dois pas simplement frapper <w>en retour</w>.",
                                "it": "Se qualcuno ti colpisce, non devi semplicemente colpire <w>a tua volta</w>.",
                                "cs": "Když tě někdo uhodí, nesmíš mu to jen tak oplatit a udeřit ho <w>zpátky</w>.",
                                "tr": "Biri sana vurduğunda, öylece <w>geri</w> vurmamalısın.",
                                "es": "Si alguien te pega, no debes simplemente <w>devolver</w> el golpe."
                            }
                        }
