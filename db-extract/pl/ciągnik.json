                        "source_sense_id": "8bdfdc6b-d3d6-389b-996b-43dbbfb9c507",
                        "target_lang_word": "Zugmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zugmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99c08337-6048-3d61-8aed-23d98c88ef87",
                                        "entry_id": "cfc94c3d-bda7-380e-855f-6fbb2a5f598b",
                                        "glosses": [
                                            "motorisiertes Fahrzeug ohne eigene Nutzfläche, das dazu dient, Anhänger zu ziehen, zum Beispiel als Motorwagen eines Sattelschleppers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc811492-8742-480b-96c1-b77e7e6b3310",
                                                "sense_id": "99c08337-6048-3d61-8aed-23d98c88ef87",
                                                "text": "„Dabei reagierte er weniger auf das, was er in den Rückspiegeln registrierte, sondern auf die schaukelnde Eigenbewegung der Zugmaschine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ec33778-2f19-48f9-99df-15e73c155c4f",
                        "source_entry_id": "2629a37a-0ac8-3b7c-8610-5fa9b8df5338",
                        "source_sense_id": "8bdfdc6b-d3d6-389b-996b-43dbbfb9c507",
                        "target_lang_word": "тягач",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тягач",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "058741cd-1550-3d75-b297-5dea2944fd5e",
                                        "entry_id": "1f681a6e-b2b0-3a74-9406-76a5e893edc2",
                                        "glosses": [
                                            "автомоб.-тракторн. специальный автомобиль, трактор с сильной тягой, применяемый для буксировки прицепов ◆ Местность вокруг была сильно покорежена снарядами и передвижением танков и тягачей, выводивших на новые позиции тяжелые орудия. А. А. Фадеев, «Молодая гвардия», 1943-1951 гг. [НКРЯ]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6d4fa3-2057-44e4-844c-0fbfc75be28f",
                                                "sense_id": "058741cd-1550-3d75-b297-5dea2944fd5e",
                                                "text": "Армейский тягач."
                                            },
                                            {
                                                "example_id": "c5a48544-9298-4105-8b3e-37a5beac9c68",
                                                "sense_id": "058741cd-1550-3d75-b297-5dea2944fd5e",
                                                "text": "Поезд состоит из седельного тягача, полуприцепа и двух прицепов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23ccc4b-4ab9-34de-bd7a-62cd3e0231b2",
                                        "entry_id": "1f681a6e-b2b0-3a74-9406-76a5e893edc2",
                                        "glosses": [
                                            "разг.-сниж. поспешное бегство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8191501-f977-48ab-b337-ed8e05eb3628",
                                                "sense_id": "c23ccc4b-4ab9-34de-bd7a-62cd3e0231b2",
                                                "text": "А купчина ― парень не промах, задал к озеру тягача, а песок тут сыпучий, ноги так и вязнут."
                                            },
                                            {
                                                "example_id": "7bdd3838-fd43-4d5d-aab7-c35a6d06890b",
                                                "sense_id": "c23ccc4b-4ab9-34de-bd7a-62cd3e0231b2",
                                                "text": "― Значит, он от вашего долга тягача-то и задал…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
