                                        "sense_id": "17030951-a303-325c-92dd-60041cb3dabb",
                                        "entry_id": "e242ab66-7bba-3974-a6f8-c760d769bd5b",
                                        "glosses": [
                                            "A cake made with honey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6272afec-eab3-44b6-b7f0-3ba49ed63e9a",
                                                "sense_id": "17030951-a303-325c-92dd-60041cb3dabb",
                                                "text": "On their return to the hallway they found a tray by the top of the steps, and hot honeycakes filling the hall with their sweet aroma."
                                            },
                                            {
                                                "example_id": "d7b22dfa-b491-4d6b-b6c9-5c66a82bc8e9",
                                                "sense_id": "17030951-a303-325c-92dd-60041cb3dabb",
                                                "text": "My Aunt Elizabeth makes this deliciously dark and chewy chocolate honeycake with layers of tangy plum jam."
                                            },
                                            {
                                                "example_id": "a620213d-c390-4832-9242-8a29770f456f",
                                                "sense_id": "17030951-a303-325c-92dd-60041cb3dabb",
                                                "text": "I love recipes that include my Dutch heritage, and this honeycake is SO good."
                                            }
                                        ]
                                    }
