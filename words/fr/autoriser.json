{
    "word_family": [
        "autorité",
        "autorisation",
        "autoritaire",
        "autoritarisme"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e97ae01-f759-34f7-867b-904c04d786d9",
                    "sense_definition": "Donner la permission, le droit ou le pouvoir d'accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur refuse d'<w>autoriser</w> l'accès aux personnes non inscrites sur la liste."
                        },
                        {
                            "text": "Les parents ont accepté d'<w>autoriser</w> leur fils à partir en voyage scolaire."
                        }
                    ],
                    "synonyms": [
                        "permettre"
                    ],
                    "antonyms": [
                        "interdire"
                    ],
                    "common_phrases": [
                        "autoriser l'accès",
                        "autoriser la sortie",
                        "autoriser une demande"
                    ]
                },
                {
                    "sense_id": "faaa5bae-2511-3b2a-b664-fe0b8ddd31ff",
                    "sense_definition": "Donner un motif légitime ou un prétexte suffisant pour agir d'une certaine manière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rien ne vous <w>autorise</w> à parler aux autres employés sur un ton aussi agressif."
                        },
                        {
                            "text": "La confiance que vous m'accordez m'<w>autorise</w> à exprimer franchement mon opinion."
                        }
                    ],
                    "synonyms": [
                        "justifier",
                        "légitimer"
                    ],
                    "common_phrases": [
                        "autoriser à penser"
                    ]
                },
                {
                    "sense_id": "9648725f-185f-392d-bc9c-15b00434f0c7",
                    "sense_definition": "Donner une approbation officielle ou réglementaire pour la mise en circulation ou l'usage d'un produit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "homologation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agence sanitaire a décidé d'<w>autoriser</w> la commercialisation de ce nouveau vaccin."
                        },
                        {
                            "text": "Le ministère refuse d'<w>autoriser</w> l'usage de cette substance toxique dans l'agriculture."
                        }
                    ],
                    "synonyms": [
                        "homologuer",
                        "valider"
                    ],
                    "antonyms": [
                        "interdire"
                    ],
                    "common_phrases": [
                        "autoriser la commercialisation",
                        "autoriser la mise sur le marché"
                    ]
                },
                {
                    "sense_id": "71c31f33-d781-3006-89ec-c6c367001f1a",
                    "sense_definition": "Prendre le droit ou utiliser un prétexte pour agir d'une certaine façon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>autorise</w> de votre exemple pour arriver régulièrement en retard aux réunions."
                        },
                        {
                            "text": "Elle s'<w>autorise</w> quelques libertés avec les règles habituelles du service."
                        }
                    ],
                    "synonyms": [
                        "se permettre"
                    ],
                    "common_phrases": [
                        "s'autoriser de",
                        "s'autoriser un écart"
                    ]
                },
                {
                    "sense_id": "eb5d4461-0c7b-36ec-887b-925546b8251f",
                    "sense_definition": "Revêtir d'une autorité officielle ou légale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, seul le souverain <w>autorisait</w> formellement les magistrats de province."
                        },
                        {
                            "text": "Certaines coutumes anciennes s'<w>autorisent</w> par le passage du temps jusqu'à faire loi."
                        }
                    ],
                    "synonyms": [
                        "investir",
                        "habiliter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi juridique ou classique vieilli"
                        }
                    ]
                }
            ]
        }
    ]
}