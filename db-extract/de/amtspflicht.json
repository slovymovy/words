                        "examples": [
                            {
                                "example_id": "fde13ccc-94af-4b1c-b355-17b353480204",
                                "sense_id": "61dbeeea-9809-322b-ab63-ed2140141132",
                                "text": "„Anders als Lee war Park vorzeitig ihrer Amtspflichten enthoben worden.“"
                            },
                            {
                                "example_id": "97171f93-777e-4dcf-a0f7-c8b1000126bd",
                                "sense_id": "61dbeeea-9809-322b-ab63-ed2140141132",
                                "text": "„Aber der Abbé tat sich wohl offenbar am Anblick ihrer Schönheit gütlich, war aber doch dazu von der Ausübung seiner Amtspflichten zu sehr hingenommen.“"
                            }
                        ],
