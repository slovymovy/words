                    "sense_definition": "Voorzien van tanden, kartels of inkepingen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machine zal de rand van het metaal <w>tanden</w>.",
                            "target_lang_translations": {
                                "ru": "Машина будет <w>нарезать зубья</w> на кромке металла.",
                                "en": "The machine will <w>tooth</w> the edge of the metal.",
                                "it": "La macchina provvederà a <w>dentellare</w> il bordo del metallo."
                            }
                        },
                        {
                            "text": "De smid moet het zaagblad opnieuw <w>tanden</w>.",
                            "target_lang_translations": {
                                "ru": "Кузнец должен заново <w>нарезать зубья</w> на пильном полотне.",
                                "en": "The smith needs to <w>tooth</w> the saw blade again.",
                                "it": "Il fabbro deve <w>dentellare</w> di nuovo la lama della sega."
                            }
                        }
