{
    "word_family": [
        "orebody"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41128a2c-2b91-30c9-9044-5bc6a734383e",
                    "sense_definition": "Rock or other material that contains valuable or utilitarian materials; primarily a rock containing metals or gems for which it is typically mined and processed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mineral_resource",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to mine iron <w>ore</w> from the new site next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует добывать железную <w>руду</w> на новом месторождении в следующем году.",
                                "it": "L'azienda intende estrarre <w>minerale</w> di ferro dal nuovo sito il prossimo anno."
                            }
                        },
                        {
                            "text": "Miners extract the raw <w>ore</w> and transport it to a factory for processing.",
                            "target_lang_translations": {
                                "ru": "Шахтёры добывают сырую <w>руду</w> и транспортируют её на завод для переработки.",
                                "it": "I minatori estraggono il <w>minerale</w> grezzo e lo trasportano in una fabbrica per la lavorazione."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iron ore",
                        "copper ore",
                        "gold ore",
                        "ore deposit",
                        "raw ore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горная порода или другой материал, содержащий ценные или полезные компоненты; преимущественно порода, содержащая металлы или драгоценные камни, которую добывают и перерабатывают.",
                        "it": "Roccia o altro materiale che contiene sostanze utili o di valore, principalmente metalli o gemme, per i quali viene estratto e lavorato."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руда",
                                "target_lang_sense_clarification": "полезное ископаемое"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "minerale",
                                "target_lang_sense_clarification": "roccia contenente metalli o sostanze estraibili"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac98037c-cf01-3262-9433-369544041bff",
                    "sense_definition": "A unit of currency used in England around the 10th to 12th centuries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "currency_historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fine for the crime was set at one <w>ore</w> of silver.",
                            "target_lang_translations": {
                                "ru": "Штраф за преступление был установлен в размере одной <w>оры</w> серебра.",
                                "it": "La multa per il reato fu fissata a una <w>ora</w> d'argento."
                            }
                        },
                        {
                            "text": "Historians found records of payments made in <w>ore</w> during the medieval period.",
                            "target_lang_translations": {
                                "ru": "Историки нашли записи о платежах, совершённых в <w>орах</w> в средневековый период.",
                                "it": "Gli storici hanno trovato registrazioni di pagamenti effettuati in <w>ore</w> durante il periodo medievale."
                            }
                        }
                    ],
                    "synonyms": [
                        "ora"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical currency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежная единица, использовавшаяся в Англии примерно в X–XII веках.",
                        "it": "Unità di moneta usata in Inghilterra tra il X e il XII secolo circa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ора",
                                "target_lang_sense_clarification": "историческая денежная единица"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ora",
                                "target_lang_sense_clarification": "antica moneta inglese"
                            }
                        ]
                    }
