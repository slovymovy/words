                "senses": [
                    {
                        "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                        "entry_id": "13a2a8be-da15-341d-b771-d91494a97b60",
                        "glosses": [
                            "Bereich um die Sonne, in welchem das solare Magnetfeld und der Sonnenwind gegenüber der interstellaren Materie vorherrschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c219983f-644e-4656-b25b-f4ea023eff03",
                                "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                                "text": "„Die Raumsonde Voyager 1, die 1977 startete, erreichte 2013 einen Abstand zur Erde von ca. 18 Milliarden Kilometern, das entspricht etwa 18 Lichtstunden (oder ca. 1/500 Lichtjahr) und verließ die Heliosphäre.“"
                            },
                            {
                                "example_id": "5ce7e760-83b1-4dc6-8cdd-c44fae073b26",
                                "sense_id": "d557aaea-2227-3b66-a3de-a86933e498c3",
                                "text": "„Der Sonnenwind reicht weit bis über die äußeren Planetenbahnen hinaus. Er treibt die interplanetare Materie aus dem Sonnensystem hinaus und bildet eine Art Blase im Weltall, die Heliosphäre genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b567705b-0582-4510-b0d7-4dab24ebad86",
