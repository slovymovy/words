                        "examples": [
                            {
                                "example_id": "888357ca-4e58-4829-a1ab-89f5b8b84392",
                                "sense_id": "34da2d4b-e019-3e99-8e7e-660d12c33c30",
                                "text": "Huit stalles, avec huit gars en rang d’oignon, bien assis, le derche au vent, et qui se concentraient, ou lisaient le feuilleton, ou conversaient de box à box."
                            },
                            {
                                "example_id": "40f814e3-0af2-420b-a484-919bc5aee9b0",
                                "sense_id": "34da2d4b-e019-3e99-8e7e-660d12c33c30",
                                "text": "Se dessina au fil de son imagination une galerie de fesses à la blancheur douteuse, de trous de balle hémorroïdaires, de derches de fiotes, de popotins pratiques, de croupes rétives, de derrières voluptueux, de raies au parfum de crevettes avariées."
                            }
                        ]
                    }
