                                "target_senses": [
                                    {
                                        "sense_id": "d78277e8-e061-364a-8821-05fd3dab5243",
                                        "entry_id": "2b5aa349-0b21-332f-8c57-b00bea12fcd4",
                                        "glosses": [
                                            "zin die is uitgesproken door een filmster in een serie of film en zovaak wordt herhaald dat het in de algemene omgangtaal veel gebruikt wordt; ingeburgerde uitspraak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e5d2d0-bbc6-40e3-9d8d-2e9cf09a93a6",
                                                "sense_id": "d78277e8-e061-364a-8821-05fd3dab5243",
                                                "text": "Coleman speelde in de serie een jongen uit Harlem die samen met zijn broer door een rijke blanke weduwnaar wordt geadopteerd. Als bijdehante lachebek was zijn catchphrase \"Wachoo talkin' 'bout, Willis?\""
                                            },
                                            {
                                                "example_id": "4d999eac-5011-4b0c-881c-0d9f1bfa1355",
                                                "sense_id": "d78277e8-e061-364a-8821-05fd3dab5243",
                                                "text": "Donald Trump was aanvankelijk de hoofdpersoon in het programma, waarin deelnemers meedingen naar een baantje door wekelijks opdrachten uit te voeren. Het maakte hem met zijn catchphrase \"You're fired!\" een realityster."
                                            },
                                            {
                                                "example_id": "331f5ea9-829b-4a1f-af3d-6aaca86cbc9f",
                                                "sense_id": "d78277e8-e061-364a-8821-05fd3dab5243",
                                                "text": "Als eerste ontlokte Trench de catchphrase \"Bond. James Bond\" aan de wereldberoemde spion. Sean Connery introduceerde zichzelf zo nadat Trench zich had voorgesteld tijdens een kaartspel in een casino."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
