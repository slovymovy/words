                                        "entry_id": "cc585c5f-5e30-32e3-8e1a-821423b24950",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de vivre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1823b251-aae6-43a3-94b7-36c9bde16995",
                                                "sense_id": "d78034c7-11f3-36da-bc14-46413691e0ae",
                                                "text": "Quoique en général les créanciers soient trompés, volés, dindonnés, attrapés, turlupinés, bafoués et joués, il n’existe pas à Paris de passion commerciale qui vive quatre-vingt-dix jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
