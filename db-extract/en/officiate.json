                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a5d8602-087d-448b-8433-d498609cb0a6",
                                "sense_id": "8638df5a-48a1-3681-a6b4-b673bda73dbd",
                                "text": "She officiated as registrar at the wedding."
                            },
                            {
                                "example_id": "6a40b011-e745-456e-a765-bf3796f024d9",
                                "sense_id": "8638df5a-48a1-3681-a6b4-b673bda73dbd",
                                "text": "She officiated the wedding as registrar."
                            }
                        ]
                    },
                    {
                        "sense_id": "fef4e80a-c866-3ec6-8dd3-0aa3e3ad46e8",
                        "entry_id": "92218dbd-26cf-312d-8625-d0f6e705434b",
                        "glosses": [
                            "To serve as umpire or referee."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40e32120-900f-421f-9444-9f59410aa3f9",
                                "sense_id": "fef4e80a-c866-3ec6-8dd3-0aa3e3ad46e8",
                                "text": "He's never officiated a cup-final before."
                            },
                            {
                                "example_id": "eb0e3abf-5399-4bbe-83b4-4a6ce772c2aa",
                                "sense_id": "fef4e80a-c866-3ec6-8dd3-0aa3e3ad46e8",
                                "text": "This is the second time he has officiated at a cup-final."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59058221-547f-4f2d-a392-3ff61fef8abc",
                        "source_entry_id": "92218dbd-26cf-312d-8625-d0f6e705434b",
                        "source_sense_description": "to perform the functions of some office",
                        "target_lang_word": "amtieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amtieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                        "entry_id": "e4807041-930f-33fa-baf0-4c762fc10fca",
                                        "glosses": [
                                            "ein Amt innehaben, im Amt sein; als etwas amtlich tätig sein, in diesem Amt dienen"
                                        ],
                                        "tags": [
                                            "als etwas amtieren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a83017-3cff-4da4-9c7c-7661d08e5e26",
                                                "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                                "text": "„Solange Schimon Peres als Ministerpräsident amtierte (von 1984 bis 1986) bestand zumindest die flüchtige Chance einer Verständigung zwischen Amman und Jerusalem […]“"
                                            },
                                            {
                                                "example_id": "8a2cdc64-dd19-4fcf-9c46-c418f8fab785",
                                                "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                                "text": "„Die letzte LDP-Regierung von Ministerpräsident Kiichi Miyazawa hatte am Donnerstag ihren Rücktritt erklärt und amtiert bis zur Vereidigung des neuen Kabinetts noch geschäftsführend weiter.“"
                                            },
                                            {
                                                "example_id": "e7522676-9dd2-455d-b921-cb6a93d3c485",
                                                "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                                "text": "„Bütschwils Pfarrer Josef Buchmann amtiert noch bis zum 10. August als Pfarradministrator ad interim […]“"
                                            },
                                            {
                                                "example_id": "db1479d7-1f14-4f36-9682-d18361f807a7",
                                                "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                                "text": "„Zwischen 1995 und 2001 amtierte er zweimal als polnischer Außenminister […]“"
                                            },
                                            {
                                                "example_id": "4c05ee18-387d-4450-8f82-40971249a844",
                                                "sense_id": "50ce5d0f-bf61-385a-ac9a-8834f134a6cc",
                                                "text": "„Kiesl war neben Karl Scharnagl, der noch von den Alliierten eingesetzt worden war und lediglich drei Jahre amtierte, der einzige CSU-Oberbürgermeister in München.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                        "entry_id": "e4807041-930f-33fa-baf0-4c762fc10fca",
                                        "glosses": [
                                            "die Aufgaben seines Amtes (auf eine bestimmte Weise) wahrnehmen, seiner Amtstätigkeit (auf eine bestimmte Weise) nachgehen; nicht immer eindeutig von [1] abgrenzbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590f11b4-df7c-4484-a101-8bee78a66920",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Er amtierte so geschickt, daß das Unterhaus, in dem 1945 die Sozialisten die Mehrheit bekamen, den Konservativen Clifton Brown einstimmig wiederwählte.“"
                                            },
                                            {
                                                "example_id": "216f176d-afcc-4fdb-aa79-35bc4ab19053",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Am Altar, wo der Pastor bereits amtierte, traf man sich wieder.“"
                                            },
                                            {
                                                "example_id": "221fd488-b488-4f30-b28b-9d89935c9acb",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Denn je nach Temperament wagten die jungen Behördenleiter und Manager entweder überhaupt nicht, eine Entscheidung zu fällen, oder sie amtierten fröhlich drauflos, ohne auf die Sachkenner zu hören.“"
                                            },
                                            {
                                                "example_id": "c28e74db-e93a-466e-9aad-b504857e18ee",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Der Bundeskanzler amtierte wie der Chef eines Generalstabes zum Zwecke der Verfolgung und Ergreifung der Terroristen und zur Befreiung ihrer Geisel.“"
                                            },
                                            {
                                                "example_id": "d9a35648-dccd-4762-9909-18b3ed8ea431",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Wäre es nicht absurd, wenn englische Richter ohne Perücke amtierten, während es in den ehemaligen Kolonien dabei bliebe?“"
                                            },
                                            {
                                                "example_id": "b670d46d-b69a-4637-b5d6-6e2f9842425b",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Die Polizisten kassierten ab, überwiegend von Schwarzen. Sie amtierten wie bewaffnete Steuereinzieher.“"
                                            },
                                            {
                                                "example_id": "fdf39b9a-0cb3-4ad9-ad8d-cf0d7e0533f4",
                                                "sense_id": "5180dd1b-3a73-3d55-b062-7f8a9e18af64",
                                                "text": "„Weil er sich in letzter Zeit so gut betragen hatte, durfte er sie ins Außenamt am Ballhausplatz begleiten […] Er war neugierig, wo der Onkel jetzt als Staatssekretär für Äußeres amtierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2674bf2b-c080-3f4f-82d5-dd988dd2df27",
                                        "entry_id": "e4807041-930f-33fa-baf0-4c762fc10fca",
                                        "glosses": [
                                            "übertragen auf eine berufliche oder andere Funktion, ohne Bezug zu einem Amt:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                        "entry_id": "e4807041-930f-33fa-baf0-4c762fc10fca",
                                        "glosses": [
                                            "eine (berufliche oder sonstige) Funktion innehaben, ausüben; als etwas fungieren, die Rolle von etwas ausfüllen"
                                        ],
                                        "tags": [
                                            "als etwas amtieren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140589ff-a8aa-46bb-8bc6-66ac6c428cc7",
                                                "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                                "text": "„Wer vor oder während der Messe als Losverkäufer amtieren möchte, kann sich täglich von 8 bis 12 Uhr unter der Telefon-Nummer 744 55 39 melden.“"
                                            },
                                            {
                                                "example_id": "8a163afe-1870-499b-ac83-016784b94d61",
                                                "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                                "text": "„Die Stadtschreiber amtieren ein halbes Jahr – von April bis September – und sollen sich neben dem sonstigen literarischen Schaffen auch mit Dresden beschäftigen.“"
                                            },
                                            {
                                                "example_id": "a186a41c-4be8-4363-b06a-92e95521cf98",
                                                "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                                "text": "„Stefan Aust, geboren 1946, war Chefredakteur und Moderator von Spiegel TV und amtierte von 1994 bis 2008 als Chefredakteur des Nachrichtenmagazins ‚Der Spiegel‘.“"
                                            },
                                            {
                                                "example_id": "813d79b7-ea72-476a-9725-f7ebebac0e78",
                                                "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                                "text": "„Tanner stand vor vier Jahren bereits einmal auf dem Siegerpodest und amtierte gleichzeitig als Vize-Europameister.“"
                                            },
                                            {
                                                "example_id": "e7a75a35-39d4-4f48-aba1-53b9f2c0da78",
                                                "sense_id": "08e51582-4bff-3b69-a6dd-7ef65e88e7d9",
                                                "text": "„Der Radiologe, der seit 2011 als ADAC-Vizepräsident amtierte, gibt jetzt den Reformer […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                        "entry_id": "e4807041-930f-33fa-baf0-4c762fc10fca",
                                        "glosses": [
                                            "seiner Funktion, seiner Tätigkeit, seinen Geschäften (auf eine bestimmte Weise) nachgehen, seinen Dienst (auf eine bestimmte Weise) tun; nicht immer eindeutig von [3] abgrenzbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0209dc8-ff00-4ea4-bed5-ac223a1e6555",
                                                "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                                "text": "„Wo früher eine Rechtsabteilung bei jeder Großbank amtierte […] suchen jetzt 30 Rechtsabteilungen nach dem, was Recht ist.“"
                                            },
                                            {
                                                "example_id": "1aa23674-921f-4e0e-a797-cbfc3773cacc",
                                                "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                                "text": "„Ein paar Tage lang amtierten die Juristen in dem kleinen Zimmer über der Kneipe. Später bezogen sie ein Zelt im Camp Wilson […]“"
                                            },
                                            {
                                                "example_id": "07d873d9-bbb8-4997-828c-380d821a82a1",
                                                "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                                "text": "„Der im Mai in Pension gegangene Deutsche-Bank-Sprecher Franz Heinrich Ulrich etwa amtierte zumeist im ersten Stock des Bankpalastes an Düsseldorfs Königsallee.“"
                                            },
                                            {
                                                "example_id": "10383536-48fb-4cc1-ad9d-876188366289",
                                                "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                                "text": "„Schiedsrichter der Partie war Man thei, der die Partie voll unter Kontrolle hatte, in einigen Fällen aber zu kleinlich amtierte.“"
                                            },
                                            {
                                                "example_id": "ef7b7073-1d1f-485b-8454-9c50b9bed238",
                                                "sense_id": "407de1de-f07f-3b75-ba65-28fdc6d25e35",
                                                "text": "„Hiervon abgesehen reden wir nicht groß über das Thema, während wir durch Landschaften und Kleinstädte fahren, um schließlich im berühmten Dinkelsbühl abzusteigen, in einem Hotel von 1480, […] dessen Portier vor einer ausladenden Franz-Josef-Strauß-Fotografie amtiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
