                        "glosses": [
                            "In a nippy way; quickly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b669d85a-7794-4692-acb3-beccee9a25c5",
                                "sense_id": "69290b66-f214-3bdc-bce9-f938347db26d",
                                "text": "With one class of boat, and continual practice under similar conditions, it is surprising to see how the boats are handled, how nippily the live ballast finds its place when gybing, how rapidly the canvas is taken in or set —a very important function, for the winds in the bay are treacherous and uncertain, the most favourable being hard north-easters."
                            },
                            {
                                "example_id": "a028ed07-7977-404e-be44-e96fe4b0e363",
                                "sense_id": "69290b66-f214-3bdc-bce9-f938347db26d",
                                "text": "I nippily learned that they could tidy away twice the amount of liquor we manly-men could without getting drunk."
                            }
                        ]
                    }
