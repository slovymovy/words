                {
                    "sense_id": "d4644613-5f7c-36f4-8613-6b871977e550",
                    "sense_definition": "Faire connaître nettement et formellement sa volonté ou une décision à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction lui a rapidement <w>signifié</w> la fin de son contrat.",
                            "target_lang_translations": {
                                "en": "Management quickly <w>notified</w> him that his contract was ending.",
                                "ru": "Руководство быстро <w>сообщило</w> ему о расторжении контракта.",
                                "nl": "De directie heeft hem snel het einde van zijn contract <w>meegedeeld</w>.",
                                "pl": "Kierownictwo szybko <w>zakomunikowało</w> mu, że jego umowa się kończy.",
                                "it": "La direzione gli ha rapidamente <w>comunicato</w> la fine del suo contratto.",
                                "cs": "Vedení mu rychle <w>oznámilo</w> konec smlouvy.",
                                "tr": "Yönetim, sözleşmesinin sona ereceğini ona hızla <w>bildirdi</w>.",
                                "es": "La dirección le <w>comunicó</w> rápidamente que su contrato llegaba a su fin.",
                                "zh": "管理层很快就<w>告知</w>他合同即将终止。",
                                "de": "Die Geschäftsleitung hat ihm rasch das Ende seines Vertrags <w>mitgeteilt</w>."
                            }
                        },
                        {
                            "text": "Il a voulu <w>signifier</w> son désaccord avant que la réunion ne commence.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>express</w> his disagreement before the meeting started.",
                                "ru": "Он хотел <w>заявить</w> о своём несогласии до начала совещания.",
                                "nl": "Hij wilde zijn onenigheid <w>te kennen geven</w> voordat de vergadering begon.",
                                "pl": "Chciał <w>wyrazić</w> swój sprzeciw przed rozpoczęciem spotkania.",
                                "it": "Ha voluto <w>esprimere</w> il suo disaccordo prima che la riunione iniziasse.",
                                "cs": "Chtěl <w>dát najevo</w> svůj nesouhlas, dříve než začala schůzka.",
                                "tr": "Toplantı başlamadan önce itirazını <w>dile getirmek</w> istedi.",
                                "es": "Quiso <w>expresar</w> su desacuerdo antes de que empezara la reunión.",
                                "zh": "他想在会议开始前<w>表达</w>自己的不同意见。",
                                "de": "Er wollte seinen Widerspruch vor Beginn der Besprechung <w>kundtun</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "signifier son refus",
                        "signifier son désaccord"
                    ],
                    "target_lang_definitions": {
                        "en": "To formally and clearly make one's will or a decision known to someone.",
                        "ru": "Официально и ясно сообщить кому-либо о своей воле или решении.",
                        "nl": "Iemand duidelijk en officieel laten weten wat je wil of hebt besloten.",
                        "pl": "Oficjalnie i wyraźnie dać komuś znać o swojej woli lub decyzji.",
                        "it": "Far conoscere in modo chiaro e formale la propria volontà o una decisione a qualcuno.",
                        "cs": "Jasně a oficiálně sdělit někomu svou vůli nebo rozhodnutí.",
                        "tr": "Bir kişiye, isteğini ya da kararını açık ve resmi biçimde bildirmek.",
                        "es": "Comunicar de forma clara y oficial a alguien la voluntad o la decisión propia.",
                        "zh": "正式、明确地把自己的意愿或决定告知某人。",
                        "de": "Jemandem eine Entscheidung oder einen Willen klar und offiziell mitteilen."
                    },
