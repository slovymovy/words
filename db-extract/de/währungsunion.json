                ],
                "senses": [
                    {
                        "sense_id": "3c8258ea-1c24-3dce-bd56-1d05fbe6a946",
                        "entry_id": "b4a2f9c1-2500-3291-b87b-95c9028be076",
                        "glosses": [
                            "Zusammenschluss mehrerer souveräner Staaten, welche eine gemeinsame Währung haben und eine gemeinsame Währungspolitik betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94490dc-d305-49e2-b4fa-4b98f52a5e23",
                                "sense_id": "3c8258ea-1c24-3dce-bd56-1d05fbe6a946",
                                "text": "Die Währungsunion stellte für die meisten DDR-Bürger zunächst den größten Einschnitt dar, da sie nun DM in ihren Händen hielten, die für sie, wie auch im Ausland, das Symbol für das Wirtschaftswunder und den bundesdeutschen Wohlstand war."
                            },
                            {
                                "example_id": "ae8e16a9-7cc6-4841-8fb5-ffb0f08cca66",
                                "sense_id": "3c8258ea-1c24-3dce-bd56-1d05fbe6a946",
                                "text": "Die Europäische Zentralbank (EZB) hält ihren Leitzins, wie an den Finanzmärkten erwartet, bei einem Prozent. Der Basiszins für die Geldversorgung der Finanzwirtschaft in den 16 Ländern der europäischen Währungsunion liegt seit Mai auf diesem rekordniedrigen Niveau."
                            },
                            {
                                "example_id": "ac1d4184-91c5-4b46-abc8-0306b7bb6d5f",
                                "sense_id": "3c8258ea-1c24-3dce-bd56-1d05fbe6a946",
                                "text": "„Europas Währungsunion verletzt, so wie sie heute konstruiert ist, einen wesentlichen Grundsatz funktionierender Demokratie: den Primat der Politik.“"
                            },
                            {
                                "example_id": "dce18ba1-9ffc-4932-b79a-ffd24a182180",
                                "sense_id": "3c8258ea-1c24-3dce-bd56-1d05fbe6a946",
                                "text": "„Nach der Währungsunion schossen die Autohäuser in der DDR aus dem Boden wie halluzinogene Pilze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
