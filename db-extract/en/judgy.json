                "senses": [
                    {
                        "sense_id": "0edb0ebc-28e5-333c-8d02-20a9b9023397",
                        "entry_id": "0efc3e82-75a5-3e58-99ad-bd623b78f7ef",
                        "glosses": [
                            "Inclined to make (disapproving) judgments; judgmental."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "33b09c42-1e9b-471d-b3cd-5c53513be38a",
                                "sense_id": "0edb0ebc-28e5-333c-8d02-20a9b9023397",
                                "text": "But when he just announced, matter-of-factly, that he really liked pot, and hash, and acid, and speed, and meth, and coke, well…it kind of seemed like, I don't know, everybody has a hobby. I shouldn't be so judgy."
                            },
                            {
                                "example_id": "43abc7d1-c593-4c9f-a36c-4cd57a627037",
                                "sense_id": "0edb0ebc-28e5-333c-8d02-20a9b9023397",
                                "text": "I can't blame her for thinking this way. Because until very recently, I had bought into it all too. “Don't get all judgy, Mel,\" she says."
                            },
                            {
                                "example_id": "e6aefb75-f40b-43f0-b7a8-70343d7537f5",
                                "sense_id": "0edb0ebc-28e5-333c-8d02-20a9b9023397",
                                "text": "Riley lowered his eyebrows and crossed his arms and tried to look non-judgy even if he felt a little judgy."
                            },
                            {
                                "example_id": "e759aa7c-bdb5-40a2-800b-1b850e6716ca",
                                "sense_id": "0edb0ebc-28e5-333c-8d02-20a9b9023397",
                                "text": "How to Stop Being So Judgy [title]"
                            }
                        ]
                    }
