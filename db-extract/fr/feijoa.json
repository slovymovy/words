                "senses": [
                    {
                        "sense_id": "81f9ccf5-7513-385a-af0b-99d034785339",
                        "entry_id": "e561b461-0020-3c96-b89c-cba2947b289b",
                        "glosses": [
                            "Nom usuel de Feijoa sellowiana (anciennement Acca sellowiana), arbre fruitier de la famille des Myrtaceae, originaire des zones subtropicales du sud du Brésil, de l’Uruguay et du nord de l’Argentine, aux feuilles coriaces et persistantes, aux fleurs blanches et rouges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f0975d-9498-42a8-a738-5ff8298e416b",
                                "sense_id": "81f9ccf5-7513-385a-af0b-99d034785339",
                                "text": "Le feijoa, bon arbuste d’ornement, mérite d’être aussi cultivé pour ses fruits."
                            },
                            {
                                "example_id": "2198d50a-19bd-444d-ada6-0d61860240e1",
                                "sense_id": "81f9ccf5-7513-385a-af0b-99d034785339",
                                "text": "Les fruits du feijoa, ont la forme d’un kiwi sans poils, avec une peau rugueuse verte et sont consommés."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd1af08f-9d95-3a57-9275-e27dff3423d5",
                        "entry_id": "e561b461-0020-3c96-b89c-cba2947b289b",
                        "glosses": [
                            "Fruit de cet arbre, également nommé goyave ananas, goyave du Brésil ou goyave de Montevideo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31e4219-2523-47c6-a7b0-e1dd5aebf2a6",
                                "sense_id": "cd1af08f-9d95-3a57-9275-e27dff3423d5",
                                "text": "Le feijoa est une baie piriforme qui reste verte même mûre, sa chair vert-jaunâtre clair a une texture légèrement granuleuse et dégage des senteurs et des saveurs subtiles."
                            },
                            {
                                "example_id": "c3039f72-119c-4d2a-b645-28fc3e201f11",
                                "sense_id": "cd1af08f-9d95-3a57-9275-e27dff3423d5",
                                "text": "Très riche en potassium, le feijoa exhalait une agréable odeur."
                            }
                        ]
                    }
                ],
