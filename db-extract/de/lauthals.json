        "de-extract.jsonl": [
            {
                "entry_id": "044d321d-a8a1-3771-9d37-46cdf6bc2125",
                "word": "lauthals",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                        "entry_id": "044d321d-a8a1-3771-9d37-46cdf6bc2125",
                        "glosses": [
                            "mit lauter Stimme, aus voller Kehle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36bcaf90-99a4-4645-b211-147b217b35f5",
                                "sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                                "text": "Als Fiete das Malheur sah, fing er lauthals an zu lachen."
                            },
                            {
                                "example_id": "cfaa3816-d77b-4cd8-bf9e-d865506ae766",
                                "sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                                "text": "Während die Polizei die Demonstranten wegtrug, protestierten diese lauthals gegen die Maßnahme."
                            },
                            {
                                "example_id": "950e12e2-1b71-494f-a862-eb525322c100",
                                "sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                                "text": "Lauthals krakeelend kamen die Kinder in die Diele gelaufen."
                            },
                            {
                                "example_id": "53116fca-9c15-4d5c-99bc-af7046cb2396",
                                "sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                                "text": "„Die Weißen nahmen in ihrer rassistischen Arroganz keinerlei Rücksicht darauf, ob die lauthals gemachten Äußerungen über die Primitivität der Afrikaner und ihr hochnäsiger Umgang mit ihnen verletzend wirken könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417af415-ce74-4408-b549-cabaa01f3db7",
                        "source_entry_id": "044d321d-a8a1-3771-9d37-46cdf6bc2125",
                        "source_sense_id": "da079c7d-4a65-371a-9605-2cc9dcf836c1",
                        "source_sense_description": "mit lauter Stimme, aus voller Kehle",
                        "target_lang_word": "à pleins poumons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à pleins poumons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5302b2a0-2838-3cd8-ba37-c08615cf33e1",
                                        "entry_id": "f1497315-0085-31ef-b6d5-71a6ebc24f2e",
                                        "glosses": [
                                            "En emplissant entièrement ses poumons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96bad1b6-dbb2-4c27-8fdf-bc25f68bcbc1",
                                                "sense_id": "5302b2a0-2838-3cd8-ba37-c08615cf33e1",
                                                "text": "Fatigué du vacarme des réjouissances qui battaient leur plein au château, Sir Trystan Delanyea déambulait sur le chemin de ronde du rempart en humant à pleins poumons l'air frais du dehors."
                                            },
                                            {
                                                "example_id": "f5469af5-b361-4adc-a6eb-c86e0c93f54b",
                                                "sense_id": "5302b2a0-2838-3cd8-ba37-c08615cf33e1",
                                                "text": "Parce que je me sens en sécurité dans mon environnement, je respire à pleins poumons grâce à l'air qui circule librement à travers les narines de mon nez. Mon corps et mon sang sont bien oxygénés et cela me permet d'avoir les idées claires."
                                            },
                                            {
                                                "example_id": "a3f35963-b8bf-49d7-801e-3f3c9f2f6fa5",
                                                "sense_id": "5302b2a0-2838-3cd8-ba37-c08615cf33e1",
                                                "text": "On respire à pleins poumons le parfum des fleurs de lait (Alstonia scholaris ou hoa sua en vietnamien), senteur emblématique qui annonce le retour de l’automne."
                                            },
                                            {
                                                "example_id": "42151081-e4c9-423c-a0ee-ee3f20427584",
                                                "sense_id": "5302b2a0-2838-3cd8-ba37-c08615cf33e1",
                                                "text": "Zef la suivit, respirant son sillage à pleins poumons. Sûr, il n’allait plus la quitter des yeux de la soirée. Et quand elle partirait, il la suivrait encore. Et il lui ferait son affaire dans une ruelle. Vite fait, mal fait. En plus, vilaine comme elle était, elle ne pourrait pas se plaindre, jugea-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c07be9-1c78-3423-8bde-7279bb82c352",
                                        "entry_id": "f1497315-0085-31ef-b6d5-71a6ebc24f2e",
                                        "glosses": [
                                            "Comme si l'on vidait ses poumons, parlant d’un cri, d’une parole, d’un chant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78419542-0dc9-433f-b574-29f5fcedad5b",
                                                "sense_id": "96c07be9-1c78-3423-8bde-7279bb82c352",
                                                "text": "Après avoir rassemblé son troupeau en beuglant à pleins poumons à travers un long bouquin de bois blanc, Frik reprit le chemin du village."
                                            },
                                            {
                                                "example_id": "e1e73265-d17e-4ec8-8a66-e31548394bf1",
                                                "sense_id": "96c07be9-1c78-3423-8bde-7279bb82c352",
                                                "text": "J’ai regroupé mes hommes et nous y sommes allés, laissant derrière nous l’énorme trou de cyclope qu’avait fait l’obus. Nous marchons dans la tranchée Berlin, nous enfonçant toujours plus dans la nuit barbelée. Nous avançons, la tête baissée dans les épaules, et c’est pour nous un terrible effort que d’avoir à monter au feu ainsi, sans crier, sans se donner du courage, sans hurler à pleins poumons, silencieux et discrets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
