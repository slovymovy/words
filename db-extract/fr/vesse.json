                "senses": [
                    {
                        "sense_id": "d03575b4-764c-37fc-9a13-d108928e73d1",
                        "entry_id": "9e778b3e-e16f-3d1d-8045-c82b7a13611a",
                        "glosses": [
                            "Gaz intestinal qui sort sans bruit et répand une mauvaise odeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b221ab61-8a30-426c-9a20-e36affd5c490",
                                "sense_id": "d03575b4-764c-37fc-9a13-d108928e73d1",
                                "text": "Cet empoté de Delhomme, un rude serin, avec sa pose au bon travail et à la justice ! et cette pie-grièche de Fanny, toujours à se fâcher pour une vesse de travers, exigeant qu’on l’adorât comme une image, sans même s’apercevoir des saletés qu’elle faisait aux autres !"
                            },
                            {
                                "example_id": "06a713cd-20b6-4e2c-b2c9-60ad0160a427",
                                "sense_id": "d03575b4-764c-37fc-9a13-d108928e73d1",
                                "text": "Une fois le livre terminé, vous saurez comment tirer profit d’un pet bien placé, en matière de séduction, ou en affaires, ou comment vous tirer d’une situation gênante lors d’une vesse en compagnie de personnes encore emplies de préjugés négatifs sur les flatulences."
                            }
                        ]
                    }
                ],
