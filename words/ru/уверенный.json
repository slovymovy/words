                    ],
                    "common_phrases": [
                        "уверен в том что"
                    ],
                    "target_lang_definitions": {
                        "en": "Firmly believing in someone or something; having no doubts about the truth of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "certain in one's knowledge or belief"
