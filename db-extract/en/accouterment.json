                                        "sense_id": "cfa3a20f-c53e-359f-a846-88272d0a025d",
                                        "entry_id": "830a765d-88e4-305e-80c0-f7862c27649e",
                                        "glosses": [
                                            "soubor předmětů (doplňků, příslušenství, schopností) sloužících k určitému účelu, výbava"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb17ac66-672b-4a62-80db-c9702886ac34",
                                                "sense_id": "cfa3a20f-c53e-359f-a846-88272d0a025d",
                                                "text": "Nakoupili jsme do bytu nové vybavení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0659f8b7-41a0-36fc-84e3-e4bf15f55dac",
                                        "entry_id": "830a765d-88e4-305e-80c0-f7862c27649e",
                                        "glosses": [
                                            "vyvolání informace (vzpomínky, představy) z paměti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85e47b6-60d7-4590-bffd-4122a6b5b26c",
                                                "sense_id": "0659f8b7-41a0-36fc-84e3-e4bf15f55dac",
                                                "text": "Vybavení vzpomínky je snadnější v pozitivním emočním kontextu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0bc807-3dc9-388a-9408-f27b1f5f52b9",
                                        "entry_id": "830a765d-88e4-305e-80c0-f7862c27649e",
                                        "glosses": [
                                            "aktivace (ochrany)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2405f621-1dd1-46da-a89c-067c743a9cb1",
                                                "sense_id": "0c0bc807-3dc9-388a-9408-f27b1f5f52b9",
                                                "text": "Proudové chrániče mají standardně „testovací tlačítko“, po jeho stisknutí se chránič vybaví."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vybavení",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe054fd-2b96-3f7b-a434-3bc65323bd97",
                                        "entry_id": "a6d733bd-da19-32b4-9918-c2971695ea5d",
