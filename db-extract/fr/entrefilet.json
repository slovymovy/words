        "fr-extract.jsonl": [
            {
                "entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                "word": "entrefilet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4a1c412a-44ce-4d3c-a558-0eb4f86dc753",
                        "entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                        "tags": [
                            "plural"
                        ],
                        "form": "entrefilets"
                    },
                    {
                        "form_id": "5614d5e3-bc8d-4ad4-8bdf-a0178acea4e9",
                        "entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                        "tags": [],
                        "form": "entre-filet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                        "entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                        "glosses": [
                            "Court article qui est séparé des autres par deux filets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d649b22d-e0d8-4b87-b537-f18e0a29fab8",
                                "sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                                "text": "La veille du jour où il arrêta Eugène sur le cours Sauvaire, il avait publié, dans l’Indépendant, un article terrible sur les menées du clergé, en réponse à un entrefilet de Vuillet, qui accusait les républicains de vouloir démolir les églises."
                            },
                            {
                                "example_id": "37fad4c0-2970-4dc3-8214-1c1626b5a9ca",
                                "sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                                "text": "Ses yeux étaient tombés sur un entrefilet du journal du soir qu’il avait plaqué contre la carafe d’eau."
                            },
                            {
                                "example_id": "52ecad48-a0c9-4a99-9045-dd8e34e7275d",
                                "sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                                "text": "– « Ne racontez notre entrevue à personne. Cela pourrait m’attirer des ennuis, des entrefilets dans les journaux satiriques. J’ai horreur des entrefilets ! »"
                            },
                            {
                                "example_id": "f4f56dc8-c986-4c28-a4a0-3079c08ff5ae",
                                "sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                                "text": "Était apparu, dès le lendemain, un entrefilet dans la feuille de chou locale, avec la photo des enchaînés qui l’agrémentait et quelques mots sur la bousculade qui s’était ensuivie entre les pros et les antis qui assistaient à la scène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1632f159-8182-42fd-8f49-c922190bed0e",
                        "source_entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                        "source_sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                        "source_sense_description": "Court article séparé des autres par deux filets",
                        "target_lang_word": "Notiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze schriftliche Aufzeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f35ddfd-a578-43f9-88ba-2a6d1fcc8943",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Protokollführer machte sich auf einem Notizblock seine Notizen, um sie später in Reinschrift zu übertragen."
                                            },
                                            {
                                                "example_id": "1b2be198-1b8b-4940-aac4-720611d48524",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Schreibtisch war übersät mit Zettelchen, Zeitungsausschnitten, Notizen und Skizzen."
                                            },
                                            {
                                                "example_id": "ab63cb3d-5454-425d-86b4-b0454cf98f73",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Jürgen Loose sieht von seinen Notizen auf.“"
                                            },
                                            {
                                                "example_id": "c964fbc2-dfcb-4f7f-beb2-0ba004c94f20",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Doch »Paris, die Hauptstadt des 19. Jahrhunderts« blieb unvollendet, obwohl in seinem Nachlass nach dem Kriege ein großes Konvolut aus Manuskripten, Zetteln, Notizen gefunden wurde.“"
                                            },
                                            {
                                                "example_id": "f0c85930-ed58-4910-9be0-714f046b6df4",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Ich glaubte, alles von und über Kant zu kennen, in diesem Text aber stieß ich auf eine scheinbar unbedeutende Notiz, die meine Dissertation zur Makulatur werden ließ.“"
                                            },
                                            {
                                                "example_id": "2335a12f-3790-4f1a-91e4-8149c0bfd060",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Am Ausgang des Friedhofs standen die Presseleute mit Kameras und Notizblöcken, machten sich ab und zu kurze Notizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze Zeitungsmeldung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517e23d9-b244-49a4-9d62-fbc2d23ed9c5",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Im Abendblatt fand sich am nächsten Tag nur eine kleine Notiz."
                                            },
                                            {
                                                "example_id": "5c2f8ed9-5c01-449e-a1d7-afe19608b55c",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Ich finde, sie hätten wenigstens eine Notiz über seinen Tod bringen können."
                                            },
                                            {
                                                "example_id": "e1e6b367-fb96-4f04-b839-e02123819bc6",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich las die Notiz durch.“"
                                            },
                                            {
                                                "example_id": "7a050dc1-813a-449a-91b3-7998776ac276",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich blätterte sie durch, überflog die Schlagzeilen, bis ich eine Notiz entdeckte, über die ich lachen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "Börsennotierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee11bc4-459e-4ebb-a0e6-3a297172dda2",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die amtliche Notiz ist die Festsetzung eines amtlichen Börsenkurses durch den Börsenvorstand, der diese Aufgabe aber auch auf einen Kursmakler übertragen kann."
                                            },
                                            {
                                                "example_id": "0199a5e5-4e16-4531-9bdb-c33004be0472",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die Voraussetzungen für eine Notiz im Prime Market der Wiener Börse sind nicht mehr gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9283b6a6-4470-4c2c-bc51-da03ecc682c6",
                        "source_entry_id": "5a75fae7-f49d-3ab6-b976-b83434e1e11a",
                        "source_sense_id": "0fd215b7-5ead-3fe0-968f-d2882b393a95",
                        "source_sense_description": "Court article séparé des autres par deux filets",
