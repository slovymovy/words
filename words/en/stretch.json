{
    "word_family": [
        "stretcher",
        "stretchy",
        "outstretch",
        "overstretch"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8add3b8d-30c3-3e93-8176-ac7b5857e4f3",
                    "sense_definition": "To extend one’s limbs or another part of the body, usually to improve muscle elasticity or relieve stiffness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always <w>stretch</w> my muscles before going for a run.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>растягиваю</w> мышцы перед пробежкой.",
                                "tr": "Koşuya çıkmadan önce her zaman kaslarımı <w>esnetirim</w>."
                            }
                        },
                        {
                            "text": "The cat woke up and <w>stretched</w> its legs on the rug.",
                            "target_lang_translations": {
                                "ru": "Кошка проснулась и <w>вытянула</w> лапы на коврике.",
                                "tr": "Kedi uyandı ve kilimin üzerinde bacaklarını <w>uzattı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch your legs",
                        "stretch your arms",
                        "stretch and yawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытягивать конечности или тело для улучшения эластичности мышц или снятия напряжения.",
                        "tr": "Kas esnekliğini artırmak veya sertliği gidermek için kasları, kolları veya bacakları esnetmek, uzatmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "мышцы"
                            },
                            {
                                "target_lang_word": "потягиваться",
                                "target_lang_sense_clarification": "всем телом"
                            },
                            {
                                "target_lang_word": "разминаться",
                                "target_lang_sense_clarification": "делать разминку"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerinmek",
                                "target_lang_sense_clarification": "tüm vücudu veya kolları açarak"
                            },
                            {
                                "target_lang_word": "esnetmek",
                                "target_lang_sense_clarification": "kasları veya vücudu"
                            },
                            {
                                "target_lang_word": "germek",
                                "target_lang_sense_clarification": "kasları"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a32c8cc-d5b7-359f-a270-70c72f3e4428",
                    "sense_definition": "To make something longer or wider by pulling it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>stretched</w> the rubber band until it snapped.",
                            "target_lang_translations": {
                                "ru": "Я <w>растягивал</w> резинку, пока она не лопнула.",
                                "tr": "Paket lastiğini kopana kadar <w>gertim</w>."
                            }
                        },
                        {
                            "text": "Be careful not to <w>stretch</w> the sweater out of shape.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>растянуть</w> свитер и не испортить его форму.",
                                "tr": "Kazağın şeklini bozacak kadar <w>esnetmemeye</w> dikkat et."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch the fabric",
                        "stretch tight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо длиннее или шире, потянув за это.",
                        "tr": "Bir şeyi çekerek daha uzun veya daha geniş hale getirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "материал, резинку"
                            },
                            {
                                "target_lang_word": "вытягивать",
                                "target_lang_sense_clarification": "удлинять форму"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esnetmek",
                                "target_lang_sense_clarification": "kumaş, lastik vb."
                            },
                            {
                                "target_lang_word": "germek",
                                "target_lang_sense_clarification": "çekerek uzatmak"
                            },
                            {
                                "target_lang_word": "çektirip uzatmak",
                                "target_lang_sense_clarification": "biçimini bozmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                    "sense_definition": "To extend over a distance or area; to be continuous from one point to another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful sandy beach <w>stretches</w> for miles along the coast.",
                            "target_lang_translations": {
                                "ru": "Прекрасный песчаный пляж <w>простирается</w> на мили вдоль побережья.",
                                "tr": "Güzel kumsal sahili boyunca miller boyu <w>uzanıyor</w>."
                            }
                        },
                        {
                            "text": "Fields of corn <w>stretched</w> out as far as we could see.",
                            "target_lang_translations": {
                                "ru": "Кукурузные поля <w>тянулись</w> так далеко, как только хватало глаз.",
                                "tr": "Mısır tarlaları gözümüzün görebildiği kadar uzağa <w>uzanıyordu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch for miles",
                        "stretch across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простираться на какое-либо расстояние или занимать определенную площадь.",
                        "tr": "Belirli bir mesafe veya alan boyunca uzanmak; bir noktadan diğerine devam etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "о местности"
                            },
                            {
                                "target_lang_word": "тянуться",
                                "target_lang_sense_clarification": "вдаль"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzanmak",
                                "target_lang_sense_clarification": "alan veya mesafe boyunca"
                            },
                            {
                                "target_lang_word": "yayılmak",
                                "target_lang_sense_clarification": "geniş bir alana"
                            },
                            {
                                "target_lang_word": "uzamak",
                                "target_lang_sense_clarification": "mesafe katetmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "235bdc4f-83a8-3bba-8a0a-69afc92897de",
                    "sense_definition": "To make a limited resource last longer than expected or cover more needs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have to <w>stretch</w> our budget to afford the trip.",
                            "target_lang_translations": {
                                "ru": "Нам придется <w>растянуть</w> наш бюджет, чтобы позволить себе эту поездку.",
                                "tr": "Bu seyahati karşılayabilmek için bütçemizi <w>idareli kullanmak</w> zorundayız."
                            }
                        },
                        {
                            "text": "She managed to <w>stretch</w> the meal to feed everyone.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>растянуть</w> еду так, чтобы накормить всех.",
                                "tr": "Yemeği herkese <w>yetirmeyi</w> başardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch the budget",
                        "stretch a dollar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Экономно расходовать ограниченный ресурс, чтобы его хватило на дольше.",
                        "tr": "Sınırlı bir kaynağı beklenenden daha uzun süre yetirmek veya daha fazla ihtiyacı karşılayacak şekilde idareli kullanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "бюджет, запасы"
                            },
                            {
                                "target_lang_word": "экономить",
                                "target_lang_sense_clarification": "ресурсы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "idareli kullanmak",
                                "target_lang_sense_clarification": "bütçe veya kaynak"
                            },
                            {
                                "target_lang_word": "yetirmeye çalışmak",
                                "target_lang_sense_clarification": "kısıtlı imkanları"
                            },
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "bütçeyi son sınırına kadar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31849bc4-d762-3fbf-a4d1-c62038dd6dde",
                    "sense_definition": "To interpret something (like a rule or truth) loosely or with exaggeration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To say he is an expert is <w>stretching</w> the truth.",
                            "target_lang_translations": {
                                "ru": "Назвать его экспертом — значит <w>преувеличить</w> правду.",
                                "tr": "Ona uzman demek gerçeği <w>esnetmek</w> olur."
                            }
                        },
                        {
                            "text": "It <w>stretches</w> credulity to believe such a strange story.",
                            "target_lang_translations": {
                                "ru": "В такую странную историю верится с <w>трудом</w>.",
                                "tr": "Böyle garip bir hikayeye inanmak mantık sınırlarını <w>zorluyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch the truth",
                        "stretch the rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толковать что-либо (правило или правду) вольно или с преувеличением.",
                        "tr": "Bir kuralı veya gerçeği esneterek, abartarak ya da serbestçe yorumlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "факты"
                            },
                            {
                                "target_lang_word": "натягивать",
                                "target_lang_sense_clarification": "факты (разг.)"
                            },
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "истину"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esnetmek",
                                "target_lang_sense_clarification": "kuralları veya gerçeği"
                            },
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "mantık sınırlarını"
                            },
                            {
                                "target_lang_word": "abartmak",
                                "target_lang_sense_clarification": "gerçeği saptırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "892c1dfe-7852-3ae7-8c4e-077019cd2eb6",
                    "sense_definition": "To execute someone by hanging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outlaw was <w>stretched</w> for his crimes in the old west.",
                            "target_lang_translations": {
                                "ru": "Преступника <w>повесили</w> за его преступления на Диком Западе.",
                                "tr": "Kanun kaçağı, Eski Batı'da işlediği suçlar yüzünden <w>asıldı</w>."
                            }
                        },
                        {
                            "text": "They threatened to <w>stretch</w> him if he didn't confess.",
                            "target_lang_translations": {
                                "ru": "Они угрожали <w>вздернуть</w> его, если он не сознается.",
                                "tr": "İtiraf etmezse onu <w>ipe çekecekleriyle</w> tehdit ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "hang",
                        "string up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Казнить через повешение.",
                        "tr": "Birini asarak idam etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздернуть",
                                "target_lang_sense_clarification": "повесить (слэнг)"
                            },
                            {
                                "target_lang_word": "повесить",
                                "target_lang_sense_clarification": "казнить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asmak",
                                "target_lang_sense_clarification": "idam etmek"
                            },
                            {
                                "target_lang_word": "ipe çekmek",
                                "target_lang_sense_clarification": "argo / deyim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36d8c183-5980-32b7-abd5-2a1b46baa90f",
                    "sense_definition": "A continuous area or extent of land or water; a segment of a journey.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>stretch</w> of road is known for being dangerous.",
                            "target_lang_translations": {
                                "ru": "Этот <w>участок</w> дороги известен своей опасностью.",
                                "tr": "Yolun bu <w>kesimi</w> tehlikeli olmasıyla bilinir."
                            }
                        },
                        {
                            "text": "We walked along a quiet <w>stretch</w> of the river.",
                            "target_lang_translations": {
                                "ru": "Мы гуляли вдоль тихого <w>участка</w> реки.",
                                "tr": "Nehrin sakin bir <w>bölgesi</w> boyunca yürüdük."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stretch of road",
                        "stretch of land"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный участок земли или воды; отрезок пути.",
                        "tr": "Kesintisiz bir kara veya su parçası; bir yolculuğun belirli bir bölümü."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "дороги, пути"
                            },
                            {
                                "target_lang_word": "отрезок",
                                "target_lang_sense_clarification": "пути"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kesim",
                                "target_lang_sense_clarification": "yol veya arazi parçası"
                            },
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "uzanan alan"
                            },
                            {
                                "target_lang_word": "hat",
                                "target_lang_sense_clarification": "yol veya nehir boyunca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32f90358-faa5-3f58-aac1-f0d7feb96ffe",
                    "sense_definition": "An act of extending one's body or limbs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stood up and had a good <w>stretch</w> after sitting so long.",
                            "target_lang_translations": {
                                "ru": "Я встал и хорошо <w>потянулся</w> после долгого сидения.",
                                "tr": "Uzun süre oturduktan sonra ayağa kalkıp iyice bir <w>gerindim</w>."
                            }
                        },
                        {
                            "text": "A quick <w>stretch</w> helps relieve tension in your back.",
                            "target_lang_translations": {
                                "ru": "Быстрая <w>растяжка</w> помогает снять напряжение в спине.",
                                "tr": "Hızlı bir <w>esnetme hareketi</w> sırtınızdaki gerginliği hafifletmeye yardımcı olur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a stretch",
                        "good stretch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по вытягиванию тела или конечностей.",
                        "tr": "Vücudu veya kasları esnetme, gerinme eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растяжка",
                                "target_lang_sense_clarification": "упражнение"
                            },
                            {
                                "target_lang_word": "потягивание",
                                "target_lang_sense_clarification": "движение"
                            },
                            {
                                "target_lang_word": "разминка",
                                "target_lang_sense_clarification": "мышц"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerinme",
                                "target_lang_sense_clarification": "vücudu esnetme hareketi"
                            },
                            {
                                "target_lang_word": "esneme",
                                "target_lang_sense_clarification": "kas esnetme eylemi"
                            },
                            {
                                "target_lang_word": "esnetme hareketi",
                                "target_lang_sense_clarification": "egzersiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58914db4-3afe-33f4-8884-9387f11ad870",
                    "sense_definition": "A continuous period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "7",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent a long <w>stretch</w> of time working abroad.",
                            "target_lang_translations": {
                                "ru": "Он провел долгий <w>период</w> времени, работая за границей.",
                                "tr": "Yurtdışında çalışarak uzun bir <w>dönem</w> geçirdi."
                            }
                        },
                        {
                            "text": "There was a <w>stretch</w> of bad weather last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце была <w>полоса</w> плохой погоды.",
                                "tr": "Geçen ay uzun bir kötü hava <w>süreci</w> yaşandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "stint"
                    ],
                    "common_phrases": [
                        "long stretch",
                        "stretch of time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный период времени.",
                        "tr": "Kesintisiz bir zaman dilimi veya süresi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "период",
                                "target_lang_sense_clarification": "времени"
                            },
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "времени"
                            },
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "перен. (напр. неудач)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "süreç",
                                "target_lang_sense_clarification": "belirli bir zaman dilimi"
                            },
                            {
                                "target_lang_word": "dönem",
                                "target_lang_sense_clarification": "kesintisiz süre"
                            },
                            {
                                "target_lang_word": "süre",
                                "target_lang_sense_clarification": "zaman aralığı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d61e5cb5-8e21-3b6f-beee-e9aa475a245d",
                    "sense_definition": "The ability of a material to lengthen when pulled without breaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These jeans have a lot of <w>stretch</w> for comfort.",
                            "target_lang_translations": {
                                "ru": "Эти джинсы обладают хорошей <w>эластичностью</w> для комфорта.",
                                "tr": "Bu kot pantolon rahatlık için oldukça yüksek <w>esnekliğe</w> sahip."
                            }
                        },
                        {
                            "text": "The fabric has lost its <w>stretch</w> over the years.",
                            "target_lang_translations": {
                                "ru": "Ткань с годами потеряла свою <w>эластичность</w>.",
                                "tr": "Kumaş yıllar içinde <w>elastikiyetini</w> kaybetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bit of stretch",
                        "no stretch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность материала удлиняться при натяжении.",
                        "tr": "Bir malzemenin çekildiğinde kopmadan uzayabilme yeteneği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эластичность",
                                "target_lang_sense_clarification": "ткани"
                            },
                            {
                                "target_lang_word": "растяжимость",
                                "target_lang_sense_clarification": "свойство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esneklik",
                                "target_lang_sense_clarification": "kumaş veya malzeme özelliği"
                            },
