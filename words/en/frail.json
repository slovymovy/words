{
    "word_family": [
        "frailty",
        "frailly",
        "frailness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8c4cd6a-d245-39ec-b8b0-1a0d43fa28af",
                    "sense_definition": "In an infirm state leading one to be easily subject to disease or other health problems, especially regarding the elderly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frail</w> old man needed assistance just to walk across the living room.",
                            "target_lang_translations": {
                                "ru": "<w>Немощному</w> старику требовалась помощь, просто чтобы перейти гостиную."
                            }
                        },
                        {
                            "text": "She became increasingly <w>frail</w> in her later years, requiring full-time care.",
                            "target_lang_translations": {
                                "ru": "В преклонном возрасте она становилась все более <w>слабой</w>, требуя постоянного ухода."
                            }
                        }
                    ],
                    "antonyms": [
                        "robust",
                        "strong",
                        "healthy"
                    ],
                    "common_phrases": [
                        "frail elderly",
                        "frail health"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в немощном состоянии, из-за которого человек легко подвержен болезням или другим проблемам со здоровьем, особенно в отношении пожилых людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дряхлый",
                                "target_lang_sense_clarification": "о пожилом человеке"
                            },
                            {
                                "target_lang_word": "немощный",
                                "target_lang_sense_clarification": "слабый здоровьем"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "физически ослабленный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fecc0e-1f87-3169-8d9f-85ca54d89f37",
                    "sense_definition": "Easily broken physically; not firm or durable; liable to fail and perish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird built its nest out of the <w>frailest</w> twigs it could find.",
                            "target_lang_translations": {
                                "ru": "Птица свила гнездо из самых <w>хрупких</w> веточек, какие только смогла найти."
                            }
                        },
                        {
                            "text": "Be careful with that <w>frail</w> wooden structure, as it might collapse under pressure.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны с этой <w>непрочной</w> деревянной конструкцией, так как она может рухнуть под тяжестью."
                            }
                        }
                    ],
                    "synonyms": [
                        "farasola",
                        "flail"
                    ],
                    "antonyms": [
                        "sturdy",
                        "durable",
                        "strong"
                    ],
                    "common_phrases": [
                        "frail structure",
                        "frail bridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко ломающийся физически; непрочный или недолговечный; склонный к разрушению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "легко ломающийся"
                            },
                            {
                                "target_lang_word": "непрочный",
                                "target_lang_sense_clarification": "ненадежный, легко разрушающийся"
                            },
                            {
                                "target_lang_word": "ломкий",
                                "target_lang_sense_clarification": "легко ломающийся при сгибании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1861365-cb49-35cd-9c17-9778c4195f5b",
                    "sense_definition": "Weak; infirm.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>frail</w> column of smoke rose from the chimney into the cold morning air.",
                            "target_lang_translations": {
                                "ru": "<w>Слабый</w> столбик дыма поднимался из трубы в холодный утренний воздух."
                            }
                        },
                        {
                            "text": "His voice sounded <w>frail</w> and hesitant over the telephone line.",
                            "target_lang_translations": {
                                "ru": "Его голос звучал <w>слабо</w> и нерешительно по телефону."
                            }
                        }
                    ],
                    "antonyms": [
                        "strong",
                        "powerful"
                    ],
                    "common_phrases": [
                        "frail voice",
                        "frail light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, едва заметный или немощный (о голосе, свете, дыме)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о голосе, свете, звуке"
                            },
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "едва уловимый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c732d5-a858-384b-ad7d-f70a3b332d82",
                    "sense_definition": "Mentally fragile.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the traumatic event, his <w>frail</w> state of mind was apparent to everyone.",
                            "target_lang_translations": {
                                "ru": "После травмирующего события его <w>хрупкое</w> душевное состояние было очевидно для всех."
                            }
                        },
                        {
                            "text": "She possessed a <w>frail</w> ego that could not handle even constructive criticism.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>ранимое</w> эго, которое не переносило даже конструктивной критики."
                            }
                        }
                    ],
                    "antonyms": [
                        "resilient",
                        "strong-minded"
                    ],
                    "common_phrases": [
                        "frail mind",
                        "frail ego"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически или душевно ранимый, хрупкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о душевном состоянии или эго"
                            },
                            {
                                "target_lang_word": "неустойчивый",
                                "target_lang_sense_clarification": "о психике"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о силе духа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87c5a8e8-7599-34af-b218-e21620bea803",
                    "sense_definition": "Liable to fall from virtue or be led into sin; not strong against temptation; weak in resolution; unchaste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Human nature is notoriously <w>frail</w> when confronted with sudden wealth.",
                            "target_lang_translations": {
                                "ru": "Человеческая природа, как известно, весьма <w>слаба</w> перед лицом внезапного богатства."
                            }
                        },
                        {
                            "text": "He acknowledged his <w>frail</w> resolution and avoided places of temptation.",
                            "target_lang_translations": {
                                "ru": "Он признал свою <w>слабую</w> решимость и избегал мест искушения."
                            }
                        }
                    ],
                    "antonyms": [
                        "resolute",
                        "virtuous"
                    ],
                    "common_phrases": [
                        "frail human nature",
                        "frail resolution"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or moral contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к грехопадению или пороку; слабый перед искушением; нерешительный; малодушный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "перед искушением"
                            },
                            {
                                "target_lang_word": "бренный",
                                "target_lang_sense_clarification": "о человеческой природе"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "легко поддающийся греху"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ed05371-bc81-30e7-96d4-5e84f897c4c5",
                    "sense_definition": "A girl or young woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective noticed a tall, quiet <w>frail</w> sitting alone at the corner table.",
                            "target_lang_translations": {
                                "ru": "Детектив заметил высокую, тихую <w>цыпочку</w>, сидевшую в одиночестве за угловым столиком."
                            }
                        },
                        {
                            "text": "He introduced the young lady as his <w>frail</w> to the rest of the gang.",
                            "target_lang_translations": {
                                "ru": "Он представил молодую леди остальным членам банды как свою <w>девушку</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "mid-20th century American slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девушка или молодая женщина (устаревший американский сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цыпочка",
                                "target_lang_sense_clarification": "сленг, девушка"
                            },
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "сленг, молодая женщина"
                            }
                        ]
                    }
                },
                {
