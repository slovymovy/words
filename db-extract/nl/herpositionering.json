                            {
                                "example_id": "45567424-839d-4b8a-92fc-4fff84bffe25",
                                "sense_id": "73ea61bb-0891-38e5-8aaf-c6661dbc9e0b",
                                "text": "Ook pleit de KNSB voor een herpositionering van het wereldbekerseizoen. In de nieuwe formule zouden World Cup-wedstrijden niet over een heel seizoen moeten worden verreden (zoals nu gebeurt), maar binnen een relatief kort tijdsbestek tussen november en december waarna begin januari de World Cup Finale moet volgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c885bca8-f8da-30de-a70f-a70a79bac89c",
                        "entry_id": "ac30d562-9099-3b0b-a69d-98fb5e18e78b",
                        "glosses": [
                            "verandering van de bezigheden van een bedrijf of organisatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff09b756-149a-4286-b3c3-4bda2b9b8897",
                                "sense_id": "c885bca8-f8da-30de-a70f-a70a79bac89c",
                                "text": "\"Herpositionering van onze organisatie is noodzakelijk\", aldus Ronald van Rooden, directeur van IJsterk. Het bedrijf gaat zich alleen richten op kinderdagverblijven voor kinderen van 0 tot 4 jaar."
                            },
                            {
                                "example_id": "2e630b80-ea54-4c03-82ca-e7c466ff2e0e",
                                "sense_id": "c885bca8-f8da-30de-a70f-a70a79bac89c",
                                "text": "Hudson's Bay wil tegenover de NOS niet bevestigen of de herpositionering ook betekent dat er gesneden gaat worden in het personeelsbestand. Er werken zo'n 1800 mensen bij de warenhuisketen."
                            }
                        ]
