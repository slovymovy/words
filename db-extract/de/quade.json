                    {
                        "translation_id": "0b483c85-3407-4550-9f54-a56a6cea63f7",
                        "source_entry_id": "195c5f1b-89a1-38b3-a889-b33649b484b2",
                        "source_sense_id": "747a641b-2d70-376f-919e-29949f8748fb",
                        "source_sense_description": "Angehöriger eines kleinen suebischen Volkstammes der Germanen",
                        "target_lang_word": "Quades",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quades",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "847e5f16-5110-3592-8324-fca414eeb8f0",
                                        "entry_id": "b8364906-d1ee-3aa5-a539-837fd692b6f9",
                                        "glosses": [
                                            "Tribu germanique du début de notre ère."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aebfca96-a6d6-48b6-aeba-b2e8644e4e18",
                                                "sense_id": "847e5f16-5110-3592-8324-fca414eeb8f0",
                                                "text": "De 167 à 170, des Quades et des Marcomans, deux tribus germaniques, percent les défenses de l'Empire et s'avancent jusqu'aux portes d'Aquilée, le verrou nord-est de l'Italie."
                                            },
                                            {
                                                "example_id": "09ee55c9-3c1f-4466-86b6-b9095d4cc70f",
                                                "sense_id": "847e5f16-5110-3592-8324-fca414eeb8f0",
                                                "text": "C’était sur cette pierre même qu’il avait chu, haletant, le vieux centurion gris de poil, au dur regard de faucon, là qu’il avait tâté sous le buffle la blessure mal guérie attrapée chez les Quades (il ne s’en était pas vanté longtemps, le maudit barbare aux dents jaunes)… là que le casque avait roulé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
