                    {
                        "sense_id": "932ffe68-5837-361a-aca4-aaec280461f7",
                        "entry_id": "99bdbee2-9d37-3ff3-8e33-1136df168954",
                        "glosses": [
                            "Großunternehmen (Konzern) mit verschiedenen Einheiten, die im wesentlichen in der Pharmaindustrie tätig sind, Arzneimittel erforschen, herstellen und oder vertreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf61137-c3e4-4564-8342-9f40ed19108e",
                                "sense_id": "932ffe68-5837-361a-aca4-aaec280461f7",
                                "text": "Im abgelaufenen Geschäftsjahr haben alle drei Pharmakonzerne Umsatz und Gewinn kräftig steigern können."
                            },
                            {
                                "example_id": "fab0d1d6-99ba-4646-8a0b-65b399b060cf",
                                "sense_id": "932ffe68-5837-361a-aca4-aaec280461f7",
                                "text": "Bei der Verteilung eines Impfstoffes gegen das Coronavirus will der Pharmakonzern gewisse Länder vorrangig versorgen."
                            },
                            {
                                "example_id": "892c5016-23a3-425e-a168-ba50b88fea4c",
                                "sense_id": "932ffe68-5837-361a-aca4-aaec280461f7",
                                "text": "Der Pharmakonzern hatte erst 2016 rund 600 Millionen Euro in den Standort investiert."
                            },
                            {
                                "example_id": "80e1727a-b0ab-4bf6-98ec-1e08c1cc94b9",
                                "sense_id": "932ffe68-5837-361a-aca4-aaec280461f7",
                                "text": "Der amerikanische Pharmakonzern Pfizer ist das größte Pharmaunternehmen der Welt."
                            }
                        ],
