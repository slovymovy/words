                                    },
                                    {
                                        "sense_id": "20657f3e-1f12-348b-9b18-214c57772f40",
                                        "entry_id": "070afedb-130b-329f-99b9-3b541bee9877",
                                        "glosses": [
                                            "Indígena obligado a servidumbre por un periodo de tiempo."
                                        ],
                                        "tags": [
                                            "Bolivia",
                                            "Peru"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69e0439-c35a-4fc1-a7f6-e74d702108c7",
                                                "sense_id": "20657f3e-1f12-348b-9b18-214c57772f40",
                                                "text": "Un hombrecito se encaminó a la casa-hacienda de su patrón. Como era siervo iba a cumplir el turno de pongo, de sirviente en la gran residencia. Era pequeño, de cuerpo miserable, de ánimo débil, todo lamentable; sus ropas viejas."
                                            },
                                            {
                                                "example_id": "89f271b0-4e7d-44f9-9e3c-99576ac7f5f8",
                                                "sense_id": "20657f3e-1f12-348b-9b18-214c57772f40",
                                                "text": "El pongo era, por último, como es sabido, algún infeliz indio miserable y embrutecido, que venía cada semana de las haciendas, a cumplir su obligación de servicio personal."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
