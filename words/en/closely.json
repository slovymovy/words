                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They met <w>closely</w> in the garden to discuss their plans.",
                            "target_lang_translations": {
                                "ru": "Они встретились <w>тайно</w> в саду, чтобы обсудить свои планы.",
