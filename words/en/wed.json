{
    "word_family": [
        "wedding",
        "newlywed",
        "wedlock"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24dfab18-79e2-3b43-8c0f-ba9b1b34c542",
                    "sense_definition": "To become husband and wife; to marry each other.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>wed</w> in a small chapel near the sea.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>пожениться</w> в маленькой часовне у моря.",
                                "zh": "他们决定在海边的一座小教堂里<w>结婚</w>。"
                            }
                        },
                        {
                            "text": "The famous couple will <w>wed</w> in a private ceremony next week.",
                            "target_lang_translations": {
                                "ru": "Знаменитая пара <w>поженится</w> на частной церемонии на следующей неделе.",
                                "zh": "这对知名情侣将于下周在一场私人仪式上<w>成婚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marry",
                        "get married"
                    ],
                    "common_phrases": [
                        "wed in secret",
                        "set to wed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать мужем и женой; вступить в брак друг с другом.",
                        "zh": "结为夫妻；结婚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожениться",
                                "target_lang_sense_clarification": "о паре; совершенный вид"
                            },
                            {
                                "target_lang_word": "вступить в брак",
                                "target_lang_sense_clarification": "официально/формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结婚",
                                "target_lang_sense_clarification": "最常用，指男女结为夫妻"
                            },
                            {
                                "target_lang_word": "成婚",
                                "target_lang_sense_clarification": "书面语，举行婚礼结为夫妻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0678b4d9-7ac0-3d18-b0e7-e1369560f1bf",
                    "sense_definition": "To take someone as a husband or wife.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wed</w> her childhood sweetheart after he returned from the war.",
                            "target_lang_translations": {
                                "ru": "Она <w>вышла замуж</w> за своего возлюбленного детства, после того как он вернулся с войны.",
                                "zh": "他从战场归来后，她便<w>嫁给</w>了自己的青梅竹马。"
                            }
                        },
                        {
                            "text": "The prince <w>wed</w> a woman from a noble family.",
                            "target_lang_translations": {
                                "ru": "Принц <w>женился</w> на женщине из знатной семьи.",
                                "zh": "王子<w>娶</w>了一位贵族出身的女子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взять кого-либо в мужья или жёны.",
                        "zh": "与某人结婚；娶或嫁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жениться",
                                "target_lang_sense_clarification": "о мужчине"
                            },
                            {
                                "target_lang_word": "выйти замуж",
                                "target_lang_sense_clarification": "о женщине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫁给",
                                "target_lang_sense_clarification": "女性与男性结婚"
                            },
                            {
                                "target_lang_word": "娶",
                                "target_lang_sense_clarification": "男性与女性结婚"
                            },
                            {
                                "target_lang_word": "与……结婚",
                                "target_lang_sense_clarification": "通用表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19e9c7d9-5297-3045-a970-28f78a9bfaca",
                    "sense_definition": "To perform the marriage ceremony that joins two people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local priest <w>wed</w> the couple in the village church.",
                            "target_lang_translations": {
                                "ru": "Местный священник <w>обвенчал</w> пару в деревенской церкви.",
                                "zh": "当地的牧师在乡村教堂里<w>为这对新人主持了婚礼</w>。"
                            }
                        },
                        {
                            "text": "They asked their friend to <w>wed</w> them on the beach.",
                            "target_lang_translations": {
                                "ru": "Они попросили своего друга <w>поженить</w> их на пляже.",
                                "zh": "他们请自己的朋友在海滩上为他们<w>主持婚礼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить церемонию бракосочетания, соединять двух людей узами брака.",
                        "zh": "为两人主持婚礼，使之结为夫妻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвенчать",
                                "target_lang_sense_clarification": "церковный обряд"
                            },
                            {
                                "target_lang_word": "сочетать браком",
                                "target_lang_sense_clarification": "официальная церемония"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主持婚礼",
                                "target_lang_sense_clarification": "主持仪式并见证二人成婚"
                            },
                            {
                                "target_lang_word": "为……主持婚礼",
                                "target_lang_sense_clarification": "牧师或司仪为主持成婚仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a4449d5-28d2-31ac-8a7e-df130962f2e9",
                    "sense_definition": "To combine different things together, or to be strongly attached to an idea or opinion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new design <w>weds</w> modern style with traditional functionality.",
                            "target_lang_translations": {
                                "ru": "Новый дизайн <w>сочетает</w> современный стиль с традиционной функциональностью.",
                                "zh": "这一新设计将现代风格与传统功能完美<w>结合</w>。"
                            }
                        },
                        {
                            "text": "He is too <w>wedded</w> to his old methods to try anything new.",
                            "target_lang_translations": {
                                "ru": "Он слишком <w>привержен</w> своим старым методам, чтобы пробовать что-то новое.",
                                "zh": "他过于<w>执着于</w>自己的老方法，不愿做任何新的尝试。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedded to the idea",
                        "wedded to tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять разные вещи вместе или быть сильно привязанным к какой-либо идее.",
                        "zh": "将不同的事物紧密结合；执着或依附于某种观点或做法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетать",
                                "target_lang_sense_clarification": "соединять стили или качества"
                            },
                            {
                                "target_lang_word": "быть приверженным",
                                "target_lang_sense_clarification": "быть преданным идее или методу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "将不同要素融合在一起"
                            },
                            {
                                "target_lang_word": "执着于",
                                "target_lang_sense_clarification": "常用于 be wedded to，深信或死守旧有观念/方法"
                            },
                            {
                                "target_lang_word": "融合",
                                "target_lang_sense_clarification": "风格或特性的结合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}