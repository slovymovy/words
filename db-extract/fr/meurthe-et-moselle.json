                        "examples": [
                            {
                                "example_id": "2ac4214e-1183-4dc7-a03a-42a4e53e82fe",
                                "sense_id": "1f9c5dc5-15f7-3e11-802b-d655547d09fd",
                                "text": "En 1953, Mohamed C… rejoint quatre de ses cousins en Meurthe-et-Moselle. Ils lui trouvent un emploi de ferrailleur, sur l'aérodrome militaire."
                            },
                            {
                                "example_id": "5cab0976-9710-4ef7-a360-63621a177053",
                                "sense_id": "1f9c5dc5-15f7-3e11-802b-d655547d09fd",
                                "text": "Laurent Hénart, député de Meurthe-et-Moselle, est un beau gosse dans le genre fonceur qui a eu quelques ennuis avec les flics pour excès de vitesse et qu’André Rossinot parraine comme son futur successeur à Nancy."
                            },
                            {
                                "example_id": "4fd13350-d7c7-447b-b144-5bf6922a53ef",
                                "sense_id": "1f9c5dc5-15f7-3e11-802b-d655547d09fd",
                                "text": "Une école a été incendiée dans la nuit de jeudi à vendredi à Mont-Saint-Martin, une commune de Meurthe-et-Moselle touchée par des émeutes depuis deux semaines, provoquant le « ras-le-bol » du maire qui appelle Emmanuel Macron à « venir » sur place."
                            }
                        ]
                    }
