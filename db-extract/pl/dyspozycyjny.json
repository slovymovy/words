                                    },
                                    {
                                        "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                                        "entry_id": "e75796f6-5fe6-31f6-8844-66ab18e105f8",
                                        "glosses": [
                                            "That is designed to be discarded rather than reused, refilled or repaired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1edfa2f2-b134-4e52-a458-462003282934",
                                                "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                                                "text": "Rather than purchase an expensive razor he bought a packet of cheap disposable ones."
                                            },
                                            {
                                                "example_id": "486d23c2-d634-4571-a688-b8d0b3bb7692",
                                                "sense_id": "074ccb86-810d-3909-892a-fad100dd598a",
                                                "text": "A disposable cup sits in a museum gallery, fully intact even after being cast aside thousands of years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63635ea-cc88-33e4-93dd-20b76925b474",
                                        "entry_id": "e75796f6-5fe6-31f6-8844-66ab18e105f8",
                                        "glosses": [
                                            "Available to be used; at one's disposal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b07478f-992f-435f-b2bd-f9264567323b",
                                                "sense_id": "e63635ea-cc88-33e4-93dd-20b76925b474",
                                                "text": "disposable income"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disposable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c42185b-dc03-3d3b-a603-8d375917d4d6",
                                        "entry_id": "ba84864d-1cd8-3865-984f-924c05d3c538",
                                        "glosses": [
                                            "Any object that is designed to be disposed of, rather than refilled or repaired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be262c8d-7c94-4851-b4dd-e2f74dcd4e3c",
                                                "sense_id": "9c42185b-dc03-3d3b-a603-8d375917d4d6",
                                                "text": "Parents who use cloth diapers often use disposables for travel, nights, or both."
                                            },
                                            {
                                                "example_id": "c09fbcf9-3888-42e9-a506-208b182a1188",
                                                "sense_id": "9c42185b-dc03-3d3b-a603-8d375917d4d6",
                                                "text": "Durable goods can be cost-effective but make great disease vectors, and disposables like syringes and needles can be a problem in the poorest places, where there's desperate need of vaccines for diseases like polio. That's where the UCSD scientists come in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa1e8a1-b7a5-3b60-ae3c-57d24b2fd92d",
                                        "entry_id": "ba84864d-1cd8-3865-984f-924c05d3c538",
                                        "glosses": [
                                            "Any object that is designed to be disposed of, rather than refilled or repaired.",
                                            "A disposable vaporizer, as for nicotine or a concentrate of cannabis (THC)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
