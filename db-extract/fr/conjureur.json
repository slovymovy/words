                        "glosses": [
                            "Celui qui fait des conjurations, des exorcismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb73b27-da39-4d23-ab67-b436666a2115",
                                "sense_id": "a8796c62-9d6a-3687-a5b1-55be1be94266",
                                "text": "Portier, lecteur, conjureur, acolythe."
                            },
                            {
                                "example_id": "5a580ca0-e088-4660-8574-a24834799d05",
                                "sense_id": "a8796c62-9d6a-3687-a5b1-55be1be94266",
                                "text": "Puisque les prières n’avaient aucun effet pour le contre-sort, il alla trouver, dans un village, près de Montigny, un conjureur bien renommé."
                            },
                            {
                                "example_id": "dc7e3b5b-6ec7-4c57-b9f5-132499cc538f",
                                "sense_id": "a8796c62-9d6a-3687-a5b1-55be1be94266",
                                "text": "D’ailleurs, en Anjou, les termes de mégeyeur, maige, empirique, hongreur, conjureur sont pratiquement synonymes."
                            }
                        ]
                    }
