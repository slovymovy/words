                    {
                        "sense_id": "a9f00c89-98e6-3440-8323-79f964854d66",
                        "entry_id": "f9862ff1-8510-3452-ae08-7c7428208293",
                        "glosses": [
                            "versendete Mitteilung über das Ableben eines Menschen und die Trauerfeier"
                        ],
                        "tags": [
                            "inhaltlich"
                        ],
                        "examples": [
                            {
                                "example_id": "409149a0-83db-4c28-95d8-ed70389d542e",
                                "sense_id": "a9f00c89-98e6-3440-8323-79f964854d66",
                                "text": "„Aber auch bei den Kosten für Trauerbriefe, Zeitungsanzeige und Kranz kommen schnell ein paar Hundert Euro zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6b286c5-86ff-39df-896a-4bf95b076bd8",
                        "entry_id": "f9862ff1-8510-3452-ae08-7c7428208293",
                        "glosses": [
