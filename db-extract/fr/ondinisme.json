                    {
                        "sense_id": "949c4394-be8a-35db-9f7a-4d6a280f9d17",
                        "entry_id": "cc848330-e798-37f8-b9bf-b3ccc5e3bd1f",
                        "glosses": [
                            "Érotisation des fonctions urinaires ; attirance sexuelle pour l’urine ou la miction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeed2b84-c8cc-428d-aaf0-cbd676e2bda7",
                                "sense_id": "949c4394-be8a-35db-9f7a-4d6a280f9d17",
                                "text": "Érotisation urinaire : ces perversions urino-érotiques peuvent consister en l’ondinisme (le plaisir sexuel est lié aux fonctions d’urination) : les urolagnes éprouvent un plaisir intense à uriner en présence d'un ou plusieurs partenaires, ou sur le ou la partenaire, […]."
                            },
                            {
                                "example_id": "549356a0-c937-495f-b706-4aaf35b3c9ae",
                                "sense_id": "949c4394-be8a-35db-9f7a-4d6a280f9d17",
                                "text": "Et puis, ne l'oublions pas, dans le cadre d'un savoir-vivre comme celui-ci, il est important de connaître les usages en matière d’ondinisme comme en matière de préséance protocolaire."
                            }
                        ]
                    }
