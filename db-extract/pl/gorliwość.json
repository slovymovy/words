                "senses": [
                    {
                        "sense_id": "1954bc89-01da-3657-b4cf-7bf0f20cd3f7",
                        "entry_id": "c5647af9-ef27-3029-b1ae-00ee836e8225",
                        "glosses": [
                            "wykazywanie w czymś wytrwałości i zapału"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231bc864-c3df-49e2-a2fb-99b3905a5e77",
                                "sense_id": "1954bc89-01da-3657-b4cf-7bf0f20cd3f7",
                                "text": "Jacek wykazuje dużą gorliwość w nauce i dlatego ma tak dobre stopnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a40b296-94b6-4375-ae31-e72b20836a8b",
                        "source_entry_id": "c5647af9-ef27-3029-b1ae-00ee836e8225",
                        "source_sense_id": "1954bc89-01da-3657-b4cf-7bf0f20cd3f7",
                        "target_lang_word": "zealousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zealousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7de438c-2c93-3c9c-b161-7a1526d1dd48",
                                        "entry_id": "6e5ac8e2-9335-3848-b30b-cd3f66e3b3f2",
                                        "glosses": [
                                            "The quality of being zealous; zeal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "583ee927-5855-4382-a9c6-427c2ef64a11",
                        "source_entry_id": "c5647af9-ef27-3029-b1ae-00ee836e8225",
                        "source_sense_id": "1954bc89-01da-3657-b4cf-7bf0f20cd3f7",
                        "target_lang_word": "zeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                        "entry_id": "5a927e60-fafb-3ec7-bda8-f8fb51432a31",
                                        "glosses": [
                                            "The fervour or tireless devotion for a person, cause, or ideal and determination in its furtherance; diligent enthusiasm; powerful interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8805d68a-0236-43a1-bf4b-f1d3ef6238e5",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "She extols the virtues of veganism with missionary zeal."
                                            },
                                            {
                                                "example_id": "5cfc0cb8-bdd9-4898-ba90-b37c935db225",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "I bear them record that they have a zeal of God, but not according to knowledge."
                                            },
                                            {
                                                "example_id": "8a1b4555-0ea7-4629-8d6b-1c98cdb41b02",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "Zeal, the blind conductor of the will"
                                            },
                                            {
                                                "example_id": "3c5d702d-38c0-4376-a98e-d479fe5006ba",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "[…] the highest zeal in religion and the deepest hypocrisy, so far from being inconsistent, are often or commonly united in the same individual character."
                                            },
                                            {
                                                "example_id": "45b970c6-d252-4da8-b53d-64e5f2ca4e11",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "[He] would begin admiring her drawings with so much zeal and so little knowledge as seemed terribly like a would-be lover,"
                                            },
                                            {
                                                "example_id": "81854fce-fad1-4430-b3ae-330e6ab45131",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "It [Troutbeck] has religious isolation also, for it is several miles—and very strenuous miles in winter—from the parish church at Mungrisdale, and the introduction of the harmonium to the waiting room was due to the zeal of a vicar of many years ago who, in the absence of any other room in the village, obtained permission to use the premises for services, including Sunday School. Most of his successors have continued this self-sacrificing duty."
                                            },
                                            {
                                                "example_id": "a453a970-46cb-4dab-8213-7751a50d4fd9",
                                                "sense_id": "46d925e8-f081-3b20-9d94-7f22e67aa6a7",
                                                "text": "The stockman’s zeal for eliminating the coyote has resulted in plagues of field mice, which the coyote formerly controlled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2598a16-82d0-3f99-9f3a-3cddf3c9769a",
                                        "entry_id": "5a927e60-fafb-3ec7-bda8-f8fb51432a31",
                                        "glosses": [
                                            "A person who exhibits such fervour or tireless devotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58d096ed-6873-4c09-ac79-bed6f0379213",
                                                "sense_id": "f2598a16-82d0-3f99-9f3a-3cddf3c9769a",
                                                "text": "[…] like a malicious purblinde zeale as thou art!"
                                            },
                                            {
                                                "example_id": "b261a3dd-3bf0-4555-828d-25d1b3b390a0",
                                                "sense_id": "f2598a16-82d0-3f99-9f3a-3cddf3c9769a",
                                                "text": "[…] there are questionlesse both in Greeke, Roman and Africa Churches, solemnities, and ceremonies, whereof the wiser zeales doe make a Christian use, and stand condemned by us;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e4d24b-fea7-3bd5-a046-e45458ec1e07",
                                        "entry_id": "5a927e60-fafb-3ec7-bda8-f8fb51432a31",
                                        "glosses": [
                                            "A group of zebras."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5dbad39-3815-48f6-8b61-d2fd912d8665",
                                                "sense_id": "a8e4d24b-fea7-3bd5-a046-e45458ec1e07",
                                                "text": "A zeal of zebras confuses predators. Each zebra has a different set of stripes."
                                            },
                                            {
                                                "example_id": "306258bf-f3b1-42ca-888b-dafe14db3e14",
                                                "sense_id": "a8e4d24b-fea7-3bd5-a046-e45458ec1e07",
                                                "text": "Zebras can also be called a herd or a zeal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e48fcd1a-29d2-4bfc-b834-00e61a13c7d7",
                        "source_entry_id": "c5647af9-ef27-3029-b1ae-00ee836e8225",
                        "source_sense_id": "1954bc89-01da-3657-b4cf-7bf0f20cd3f7",
                        "target_lang_word": "ardor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ardor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2ed879-06c7-3f0f-824d-1ab3abf629b7",
                                        "entry_id": "52c26971-9f17-363c-9bb6-b1847bd7c280",
                                        "glosses": [
                                            "Great warmth of feeling; fervor; passion."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2445e3-c356-4e1d-8093-1841e8eb60ed",
                                                "sense_id": "6a2ed879-06c7-3f0f-824d-1ab3abf629b7",
                                                "text": "I rushed towards her, and embraced her with ardour; but the deathly languor and coldness of the limbs told me, that what I now held in my arms had ceased to be the Elizabeth whom I had loved and cherished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f6b811-d8ec-3565-ba89-23ec7ceb8c19",
                                        "entry_id": "52c26971-9f17-363c-9bb6-b1847bd7c280",
                                        "glosses": [
                                            "Spirit; enthusiasm; passion."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c611259c-6ebc-3e20-99b2-bc8424184713",
                                        "entry_id": "52c26971-9f17-363c-9bb6-b1847bd7c280",
                                        "glosses": [
                                            "Intense heat."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5de47e4f-b4ef-4382-a068-bad54af23c2c",
                        "source_entry_id": "c5647af9-ef27-3029-b1ae-00ee836e8225",
