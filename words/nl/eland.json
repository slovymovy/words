                            "target_lang_translations": {
                                "en": "In Canada, <w>moose</w> are often hit by cars because they walk across the road."
                            }
                        },
                        {
                            "text": "Tijdens onze vakantie in Zweden hebben we een prachtige <w>eland</w> in het bos gezien.",
                            "target_lang_translations": {
                                "en": "During our holiday in Sweden, we saw a beautiful <w>elk</w> in the forest."
                            }
                        }
                    ],
                    "common_phrases": [
