                        "glosses": [
                            "Soûler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b949be7-268f-45b4-8c7f-4c2483431724",
                                "sense_id": "2fee9813-1352-3c59-97d7-4373d97c32fa",
                                "text": "Ça la resoûle."
                            },
                            {
                                "example_id": "45280d4e-c4e8-47ba-93c6-639af448ceb5",
                                "sense_id": "2fee9813-1352-3c59-97d7-4373d97c32fa",
                                "text": "« C’est moi, le salaud qui passe ; mais toi qui cries, qui pilles, qui trompes, toi qui resoûles, toi qui défonces le tendron, toi aussi tu es un salaud. »"
                            },
                            {
                                "example_id": "43911137-dd73-4c20-8c75-48621631f92e",
                                "sense_id": "2fee9813-1352-3c59-97d7-4373d97c32fa",
                                "text": "Ses yeux bleus le tuent, le resoûlent"
                            }
                        ]
                    }
