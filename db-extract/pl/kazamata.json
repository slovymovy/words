                "senses": [
                    {
                        "sense_id": "fe2422a7-5f41-3bee-8e09-ad6380c895ff",
                        "entry_id": "3342514b-5073-3b56-94c9-22315f98a132",
                        "glosses": [
                            "w fortyfikacji: budowla o murowanym sklepieniu, chroniącym przed ogniem artyleryjskim, używana jako stanowisko dział lub magazyn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b592e839-0dd0-4a04-83b8-702ad7fa9dc5",
                                "sense_id": "fe2422a7-5f41-3bee-8e09-ad6380c895ff",
                                "text": "Naówczas Iwanów, aby nie stracić twarzy, wysunął tezę, że podziemne składy, piwnice i obronne kazamaty w istocie służyły jako cele oraz izby tortur"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bd0f990-b7e0-4aa0-b74a-a4bb4e16acdd",
                        "source_entry_id": "3342514b-5073-3b56-94c9-22315f98a132",
                        "source_sense_id": "fe2422a7-5f41-3bee-8e09-ad6380c895ff",
                        "target_lang_word": "casemate",
