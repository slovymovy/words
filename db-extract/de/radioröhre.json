                                    },
                                    {
                                        "sense_id": "3cb3d8f6-0d0d-38b7-bd21-1ba31c61a02e",
                                        "entry_id": "5a3d4b84-e40b-3919-94da-be6760c1c35f",
                                        "glosses": [
                                            "Parte de un órgano hueca y alargada, tanto en animales como en vegetales."
                                        ],
