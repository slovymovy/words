                    {
                        "sense_id": "abf4e039-3c6a-3f96-8810-60fc687a3aeb",
                        "entry_id": "166ddd11-b85f-3006-b09a-0cbee45af9ee",
                        "glosses": [
                            "выровнять, гладя горячим утюгом; отгладить, выутюжить"
