                ],
                "senses": [
                    {
                        "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                        "entry_id": "f0e46888-e0c6-3c46-8f04-89080b6adbd6",
                        "glosses": [
                            "mit der Post an einen Empfänger verschickte Sendung, die Tonaufnahmen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50839f5e-2638-4b31-9cd0-f58d470fa4cb",
                                "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                                "text": "„Als der Dienst am 1.7.1940 startete, konnten in 27 Ländern (darunter die Schweiz und Liechtenstein) Phonopost-Sendungen aufgegeben werden.“"
                            },
                            {
                                "example_id": "be1800ef-9f1c-4642-ae06-6df4f619a6da",
                                "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                                "text": "„In der Woche zwischen den beiden Phonopost-Sendungen platziert Johnson Maries Vorschlag, Gesine möge ihr anstelle eines Tagebuchs Tonbänder hinterlassen […].“"
                            },
                            {
                                "example_id": "8b389690-7c6b-49c0-b56d-9c650a5b0d34",
                                "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                                "text": "„Handelsübliche Schallplatten sind in Phonopost-Sendungen nicht zugelassen, weil Phonopost als eine Art gesprochener Brief gilt und deshalb in vielen Ländern nicht der Zollabfertigung unterliegt.“"
                            },
                            {
                                "example_id": "4f1b7cfc-370e-4441-adb0-a5472588a15e",
                                "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                                "text": "„[…] einschl. Geschäftspapiere, Blindenschriften, Päckchen, eines Teiles der Sendungen zu ermäßigter Gebühr und der Phonopost-Sendungen in das Ausland.“"
                            },
                            {
                                "example_id": "c72bb342-c684-4730-8a5d-3fdfcca10b83",
                                "sense_id": "232ccaef-67e8-3733-a3ae-c527f5e22ce6",
                                "text": "„[…] Päckchen, Blindenschriften sowie Phonopost-Sendungen gerechnet werden, ferner als Anhang Sonderregeln über die Postbeförderung auf dem Luftwege.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
