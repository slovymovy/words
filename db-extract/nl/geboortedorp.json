                        "examples": [
                            {
                                "example_id": "0bb42b11-116e-485f-b363-89a1e9980d94",
                                "sense_id": "891bdc09-44fa-3fc7-a075-62662073364b",
                                "text": "'Mocht uw zus in uw geboortedorp wonen, dan zult u haar zonder twijfel opsporen. De dorpen zijn hier klein en besloten, vraag naar haar bij de plaatselijke kroeg of de bakker.'"
                            },
                            {
                                "example_id": "720018e4-12fd-47c9-938d-7e139350e12c",
                                "sense_id": "891bdc09-44fa-3fc7-a075-62662073364b",
                                "text": "In China heeft een man die als kind werd ontvoerd zijn biologische moeder teruggevonden dankzij de herinnering aan zijn geboortedorp."
                            }
                        ]
                    }
