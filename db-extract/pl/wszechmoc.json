                "senses": [
                    {
                        "sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                        "entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
                        "glosses": [
                            "przymiot tego, kto posiada nieograniczoną moc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8cc6bae-c5fb-44a4-8def-7486760a3a0e",
                                "sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                                "text": "Bóg potrafi uczynić wszystko, chyba że sam nałożył sobie granice działania, np. w odniesieniu do wolnych stworzeń, których nie chce zmuszać swoją wszechmocą do dobrego działania"
                            },
                            {
                                "example_id": "dce8a44a-3df4-435a-972b-23d457604e13",
                                "sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                                "text": "Polski myśliciel traktował scjentyzm jako zabobon o wszechmocy poznawczej nauki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88e5161e-16d0-4f7e-b3a1-35a090fa1451",
                        "source_entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
                        "source_sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                        "target_lang_word": "omnipotence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipotence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                        "entry_id": "ecb2de18-ca1e-318a-88ed-dbe74d92a24f",
                                        "glosses": [
                                            "Unlimited power; commonly attributed to a deity or deities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58539b3f-02cd-45f0-b185-944b93e24e0d",
                                                "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                                "text": "One purpose of the Freedom of Information Act is to make our society less of a police state. Until the CIA's omnipotence is seriously challenged, however, the xeroxed papers in my hand have little meaning. For now, they remind me of nothing less than the simple fact that evil forces still control our society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "723bd651-ba90-4b44-9b20-6ea4c52b5295",
                        "source_entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
                        "source_sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                        "target_lang_word": "almightiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "almightiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5aa179-af37-32ac-ad60-a6f2a5c55fa8",
                                        "entry_id": "2a716065-733d-3825-b02f-1beb9ccd3f35",
                                        "glosses": [
                                            "The state or quality of being almighty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739e0cea-1c4f-48b8-b2b7-0ff3716b4c0a",
                                                "sense_id": "8b5aa179-af37-32ac-ad60-a6f2a5c55fa8",
                                                "text": "Such is the almightiness of habit, that it can overcome the original disposition, even when it be fortified by the force of precept; then how much more easily so unprincipled a mind as the Chevalier's?"
                                            },
                                            {
                                                "example_id": "dfacb23d-0903-4058-9a1d-f1a69c5ad2a4",
                                                "sense_id": "8b5aa179-af37-32ac-ad60-a6f2a5c55fa8",
                                                "text": "They rejoice in his almightiness and infinite wisdom, they exult in his supremacy and absolute sovereignty, and are ravished in a view of his universal government, because it is absolutely perfect."
                                            },
                                            {
                                                "example_id": "406559c8-6bc2-46df-966f-ff0509518aed",
                                                "sense_id": "8b5aa179-af37-32ac-ad60-a6f2a5c55fa8",
                                                "text": "The mere assumption of a doubt for the purpose of the inquiry, is painful to him, for it presents to his mind illimitable space, dark, desolate and blank; void of the benignity, the almightiness and the perfect intelligence of the Supreme, and his own existence as a transient flame, and his moral constitution and sense of obligation and duty merely as machinery vainly to regulate his actions to which there are to be no corresponding consequences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dec6d529-ab71-43d2-8514-efd97b57a75d",
                        "source_entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
                        "source_sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                        "target_lang_word": "všemohoucnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1204e5be-6c81-4e1a-aec5-1be02c756c74",
                        "source_entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
                        "source_sense_id": "3195fc66-74cd-377a-9a7f-1da5824e79b0",
                        "target_lang_word": "omnipotence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipotence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                                        "glosses": [
                                            "Toute-puissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ab886e-4c19-4ff3-95dc-ccd8b4d18f12",
                                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                                "text": "Ce pamphlet contre l’homme que Diderot n’osa pas publier, le Neveu de Rameau ; ce livre, débraillé tout exprès pour montrer des plaies, est seul comparable à ce pamphlet dit sans aucune arrière-pensée, où le mot ne respecta même point ce que le penseur discute encore, où l’on ne construisit qu’avec des ruines, où l’on nia tout, où l’on n’admira que ce que le scepticisme adopte : l’omnipotence, l’omniscience, l’omniconvenance de l’argent."
                                            },
                                            {
                                                "example_id": "45797aeb-cc17-4741-bc2a-017b29782cb5",
                                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                                        "glosses": [
                                            "Faculté de décider souverainement en certaines matières."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7622c8d7-ea17-451b-95b0-6c492738b277",
                                                "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                                                "text": "L’omnipotence du jury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e459122-a9ff-4326-a968-c2ce72dffd73",
                        "source_entry_id": "f5ae4ff3-e3d1-3d85-912e-f86c77f7765e",
