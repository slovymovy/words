{
    "word_family": [
        "peevishness",
        "peevishly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "438971fe-1130-3082-a6a3-7b9114af551b",
                    "sense_definition": "Quick to become bad-tempered or cross, especially due to insignificant matters; irritable, pettish, petulant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irritable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would rather figure things out on my own than ask that <w>peevish</w> librarian for help.",
                            "target_lang_translations": {
                                "ru": "Я лучше разберусь во всем сам, чем буду просить помощи у этого <w>раздражительного</w> библиотекаря.",
                                "de": "Ich würde die Dinge lieber alleine herausfinden, als diesen <w>mürrischen</w> Bibliothekar um Hilfe zu bitten."
                            }
                        },
                        {
                            "text": "The <w>peevish</w> man yelled at his neighbor for parking too close to his driveway.",
                            "target_lang_translations": {
                                "ru": "<w>Ворчливый</w> мужчина накричал на соседа за то, что тот припарковался слишком близко к его въезду в гараж.",
                                "de": "Der <w>gereizte</w> Mann schrie seinen Nachbarn an, weil er zu nah an seiner Einfahrt geparkt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritable",
                        "petulant",
                        "cranky",
                        "grumpy"
                    ],
                    "antonyms": [
                        "patient",
                        "calm",
                        "tolerant"
                    ],
                    "common_phrases": [
                        "peevish mood",
                        "peevish tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный быстро раздражаться или сердиться, особенно по пустякам; вспыльчивый, капризный.",
                        "de": "Schnell verärgert oder schlecht gelaunt, besonders wegen belangloser Kleinigkeiten; leicht reizbar, unausstehlich oder mürrisch."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "склонный к раздражению по любому поводу"
                            },
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "склонный к необоснованным жалобам и недовольству"
                            },
                            {
                                "target_lang_word": "вспыльчивый",
                                "target_lang_sense_clarification": "быстро выходящий из себя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gereizt",
                                "target_lang_sense_clarification": "schnell verärgert und empfindlich"
                            },
                            {
                                "target_lang_word": "mürrisch",
                                "target_lang_sense_clarification": "schlecht gelaunt und unfreundlich"
                            },
                            {
                                "target_lang_word": "verdrießlich",
                                "target_lang_sense_clarification": "missmutig und leicht verstimmt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "880b24b8-9cdb-3f3d-8a22-f2a2aaa474e6",
                    "sense_definition": "Constantly complaining, especially in a childish way due to insignificant matters; fretful, whiny.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irritable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Due to the long wait, there were several <w>peevish</w> patients in the doctor’s waiting room.",
                            "target_lang_translations": {
                                "ru": "Из-за долгого ожидания в приемной врача было несколько <w>раздраженных</w> пациентов.",
                                "de": "Wegen der langen Wartezeit saßen mehrere <w>verdrießliche</w> Patienten im Wartezimmer des Arztes."
                            }
                        },
                        {
                            "text": "The child became <w>peevish</w> after missing his afternoon nap.",
                            "target_lang_translations": {
                                "ru": "Ребенок стал <w>капризным</w> после того, как пропустил дневной сон.",
                                "de": "Das Kind wurde <w>quengelig</w>, nachdem es seinen Mittagsschlaf verpasst hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "fretful",
                        "whiny",
                        "querulous"
                    ],
                    "antonyms": [
                        "uncomplaining"
                    ],
                    "common_phrases": [
                        "peevish complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно жалующийся, особенно по-детски, из-за незначительных причин; плаксивый, ворчливый.",
                        "de": "Ständig und oft auf kindische Weise wegen Nichtigkeiten klagend oder jammernd; quengelig, wehleidig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "постоянно выражающий недовольство"
                            },
                            {
                                "target_lang_word": "сварливый",
                                "target_lang_sense_clarification": "склонный к придиркам и жалобам"
                            },
                            {
                                "target_lang_word": "плаксивый",
                                "target_lang_sense_clarification": "склонный к нытью, часто о детях"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "quengelig",
                                "target_lang_sense_clarification": "oft über Kinder, die wehleidig und nörgelig sind"
                            },
                            {
                                "target_lang_word": "nörgelig",
                                "target_lang_sense_clarification": "ständig meckernd und unzufrieden"
                            },
                            {
                                "target_lang_word": "verdrossen",
                                "target_lang_sense_clarification": "lustlos, unwillig und missmutig"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9fb0a6e7-3576-3333-ad06-09497187e151",
                    "sense_definition": "In a peevish manner; whiningly; irritably, petulantly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "irritable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>peevish</w> complained about the cold weather all morning long.",
                            "target_lang_translations": {
                                "ru": "Он <w>ворчливо</w> жаловался на холодную погоду все утро.",
                                "de": "Er beschwerte sich den ganzen Morgen lang <w>mürrisch</w> über das kalte Wetter."
                            }
                        },
                        {
                            "text": "She spoke <w>peevish</w> when asked to repeat the instructions for the third time.",
                            "target_lang_translations": {
                                "ru": "Она <w>раздраженно</w> ответила, когда ее попросили повторить инструкции в третий раз.",
                                "de": "Sie antwortete <w>gereizt</w>, als sie gebeten wurde, die Anweisungen zum dritten Mal zu wiederholen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adverbial usage is largely archaic or non-standard compared to the modern 'peevishly'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздраженно, ворчливо, капризно.",
                        "de": "Auf mürrische, gereizte oder quengelige Art und Weise."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздраженно",
                                "target_lang_sense_clarification": "выражая раздражение"
                            },
                            {
                                "target_lang_word": "ворчливо",
                                "target_lang_sense_clarification": "с выражением недовольства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gereizt",
                                "target_lang_sense_clarification": "auf eine leicht verärgerte Weise"
                            },
                            {
                                "target_lang_word": "mürrisch",
                                "target_lang_sense_clarification": "missmutig oder griesgrämig"
                            },
                            {
                                "target_lang_word": "quengelig",
                                "target_lang_sense_clarification": "nörgelnd oder jammernd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}