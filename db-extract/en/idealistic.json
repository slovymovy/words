                                            {
                                                "example_id": "e7c4b6f4-82f9-4ac4-9885-d37304fffa09",
                                                "sense_id": "89d32845-4dcc-3834-bf3f-d3fedbeb5497",
                                                "text": "La philosophie idéaliste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idéaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59e51f5a-d8ff-38a3-b16f-1f7ae3261a9b",
                                        "entry_id": "02fd33da-3f11-36ff-bc22-db2981132740",
                                        "glosses": [
                                            "Adepte de l’idéalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac29178f-07d7-45b3-83d9-24f02cc7a081",
                                                "sense_id": "59e51f5a-d8ff-38a3-b16f-1f7ae3261a9b",
                                                "text": "Herbert est un idéaliste, un humaniste qui vit encore plus que moi dans les livres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ebaa39f-02b5-3363-9c2c-1090862e5525",
                                        "entry_id": "02fd33da-3f11-36ff-bc22-db2981132740",
                                        "glosses": [
                                            "Esprit qui se représente mal les conditions de la réalité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "770bd968-d89b-4d48-ba5b-795426525542",
                                                "sense_id": "5ebaa39f-02b5-3363-9c2c-1090862e5525",
                                                "text": "Il n’a pas le sens pratique, c’est un idéaliste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b97b1f57-98ed-46e7-99c6-b86a075d006a",
                        "source_entry_id": "26904a5c-f72e-37aa-ac9f-3226fdb9ddc1",
                        "source_sense_id": "c5e269df-ec9c-3ae5-a049-2ae36d1b040f",
                        "source_sense_description": "of or pertaining to an idealist or to idealism",
                        "target_lang_word": "idealistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idealistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4236d7b-5676-3939-834f-c05cbe8debc3",
                                        "entry_id": "5f7c39cd-5c79-3418-bddb-9cc68c862ce9",
                                        "glosses": [
                                            "der Lehre des Idealismus entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7c5840-764c-4799-b4bb-deee88d549ef",
                                                "sense_id": "c4236d7b-5676-3939-834f-c05cbe8debc3",
                                                "text": "Es ist wesentlicher Bestandteil einer idealistischen Auffassung des Seins, von der Unsterblichkeit der Seele auszugehen."
                                            },
                                            {
                                                "example_id": "089f6269-e20e-4a60-9bb9-361e579d71e7",
                                                "sense_id": "c4236d7b-5676-3939-834f-c05cbe8debc3",
                                                "text": "Das [Anm.: Verzichten auf staatliche Souveränität und Machtabgabe] klingt sehr idealistisch. Ist es nicht in Wahrheit oft so, dass wir Beziehungen weiter pflegen, weil wir uns bestimmte Vorteile davon versprechen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2e1f851-4fea-343c-aa13-b5969fa0aca6",
                                        "entry_id": "5f7c39cd-5c79-3418-bddb-9cc68c862ce9",
                                        "glosses": [
                                            "geprägt vom intensiven Streben nach und der Verwirklichung von Idealen, etwas weltfremd oder wirklichkeitsfern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3849007-9d97-4a62-8bdb-3239ee597f37",
                                                "sense_id": "b2e1f851-4fea-343c-aa13-b5969fa0aca6",
                                                "text": "Er gehört wie viele zu den idealistisch gesinnten jungen Menschen, die pazifistisch leben wollen ohne jemals eine Waffe in die Hand zu nehmen."
                                            },
                                            {
                                                "example_id": "4618ddeb-b295-4349-984d-1b809a1e7409",
                                                "sense_id": "b2e1f851-4fea-343c-aa13-b5969fa0aca6",
                                                "text": "Man kann ihre Haltung [Anm.: die der Partei 'Die Linke'] zur Außenpolitik (Nato abschaffen, keine Militäreinsätze, keine Waffen verkaufen) dogmatisch nennen oder idealistisch, stur oder konsequent. Fakt ist, dass manche Themen für sie dadurch quasi undiskutierbar sind."
                                            },
                                            {
                                                "example_id": "97f0596a-e16f-4085-819a-9cd27072a738",
                                                "sense_id": "b2e1f851-4fea-343c-aa13-b5969fa0aca6",
                                                "text": "ZEIT Campus: „Seiner Leidenschaft folgen – klingt gut, aber auch ein wenig idealistisch.“ - Gaissmaier: „Im Gegenteil: Bei der Berufswahl den eigenen Neigungen zu folgen bedeutet nicht, Luftschlösser zu bauen. […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
