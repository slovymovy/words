                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec2827f-b0ff-4067-aa09-1b102f73b671",
                                "sense_id": "9f15f6b7-0678-3d21-bcb3-044393db44ac",
                                "text": "Vollständig hieß der Schmuse-Barde Sasha Schmitz - jedenfalls bis vor wenigen Tagen."
                            },
                            {
                                "example_id": "1c06d9ed-ff43-4138-b1dc-443d23be3891",
                                "sense_id": "9f15f6b7-0678-3d21-bcb3-044393db44ac",
                                "text": "Frauenfußball-Bundesligist Turbine Potsdam hat Lisa Schmitz von Ligakonkurrent Bayer Leverkusen verpflichtet."
                            },
                            {
                                "example_id": "dc4cd705-92be-45e4-b436-f3202b3f7f79",
                                "sense_id": "9f15f6b7-0678-3d21-bcb3-044393db44ac",
                                "text": "Der Richter aus dem neuseeländischen Auckland hat den deutschen Betreiber von Megaupload, Kim Schmitz, einen Monat nach dessen Verhaftung gegen Kaution freigelassen."
                            }
                        ],
