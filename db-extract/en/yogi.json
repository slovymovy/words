                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "56f32898-21d0-468a-baee-8509ce1746fe",
                        "entry_id": "df3e25d5-6d8b-3b30-98ae-f5d9b8f28701",
                        "tags": [
