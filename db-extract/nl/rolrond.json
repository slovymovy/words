                            {
                                "example_id": "0bfc7cff-fbd8-4ebf-824d-9570da65ad18",
                                "sense_id": "14a3607a-2f71-3b7b-98b3-6ac1ac694cec",
                                "text": "ROND? Bolvormig. Rolrond. Bolrond. Cilindrisch, mollig, vol, gevuld…DAT zijn synoniemen voor ‘rond’. Ook een leuke: In Orde. En nee, dit is geen betoog voor ‘dik zijn’. Evenmin zeg ik dat er iets mis is met de Zara-modellen zelf. Ze zijn prachtig. Echt. Ze zijn alleen niet goed gekozen omdat het bij lange na niet matcht met de dagelijkse realiteit en al helemaal niet met de goedbedoelde slogan ‘Love your Curves’."
                            }
                        ]
                    }
