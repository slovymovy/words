                                "target_senses": [
                                    {
                                        "sense_id": "675fe5fc-d2ac-3831-bf35-4d484b755499",
                                        "entry_id": "7a779447-a0e6-3bdd-8a29-4487b3dd8e58",
                                        "glosses": [
                                            "Espèce de petit mammifère de la famille des mustélidés, dont la fourrure est très estimée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a670069e-4762-4f25-9c2d-8d69d9f0b59d",
                                                "sense_id": "675fe5fc-d2ac-3831-bf35-4d484b755499",
                                                "text": "Le vison d’Amérique (Mustela vison), élevé pour sa fourrure, est deux fois plus gros que le vison d’Europe (Mustela lutreola), menacé de disparition."
                                            },
                                            {
                                                "example_id": "b28d2312-8b0c-46f6-bd8a-a3896e97285b",
                                                "sense_id": "675fe5fc-d2ac-3831-bf35-4d484b755499",
                                                "text": "Le chat-pêcheur, la martre et le vison abondaient le long du torrent mais n’étaient point dangereux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ed8071-d3c9-3f15-98ce-80abf22ce9f6",
                                        "entry_id": "7a779447-a0e6-3bdd-8a29-4487b3dd8e58",
                                        "glosses": [
                                            "Vison d’Europe, au pelage brun foncé avec une tache blanche sur le menton et la lèvre supérieure."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1982024-e29c-3e04-8cb5-2b94dcae718a",
                                        "entry_id": "7a779447-a0e6-3bdd-8a29-4487b3dd8e58",
                                        "glosses": [
                                            "Fourrure de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19659834-5419-4ce6-955a-dce0439da327",
                                                "sense_id": "b1982024-e29c-3e04-8cb5-2b94dcae718a",
                                                "text": "Un manteau, une veste de vison."
                                            },
                                            {
                                                "example_id": "f9b2fe21-177d-4ee1-883e-db2d8a6fb721",
                                                "sense_id": "b1982024-e29c-3e04-8cb5-2b94dcae718a",
                                                "text": "Denise vit une tartanelle à quarante-cinq centimes, des bandes de vison d’Amérique à un franc, et des mitaines à cinq sous."
                                            },
                                            {
                                                "example_id": "a497f551-7df3-4c8a-8cd3-dda4feb9523f",
                                                "sense_id": "b1982024-e29c-3e04-8cb5-2b94dcae718a",
                                                "text": "Une couche moelleuse était placée en travers du grand tapis de Vison qui s’étendait sous le lustre, et le bateau de ce lit, en ébène sculpté, supportait des coussins dont l’intérieur et les plumes avaient été imprégnés d’un parfum oriental embaumant toute la pièce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba593f57-1e6d-348f-b4c6-7de0f71041e7",
                                        "entry_id": "7a779447-a0e6-3bdd-8a29-4487b3dd8e58",
                                        "glosses": [
                                            "Manteau de vison."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18863fd7-f5c0-484f-9111-c3538769e913",
                                                "sense_id": "ba593f57-1e6d-348f-b4c6-7de0f71041e7",
                                                "text": "Elle portait un magnifique vison."
                                            }
                                        ]
                                    }
                                ]
