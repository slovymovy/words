{
    "word_family": [
        "backpack",
        "backpacking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                    "sense_definition": "A traveler whose luggage consists of a backpack, especially one who uses hostels and inexpensive services.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>backpacker</w> spent three months exploring Southeast Asia on a very tight budget.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>бэкпэкер</w> провел три месяца, исследуя Юго-Восточную Азию с очень ограниченным бюджетом."
                            }
                        },
                        {
                            "text": "Every <w>backpacker</w> knows that choosing the right hostel is essential for meeting other travelers.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>пеший турист</w> знает, что выбор правильного хостела важен для знакомства с другими путешественниками."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiker",
                        "trekker"
                    ],
                    "common_phrases": [
                        "budget backpacker",
                        "solo backpacker",
                        "backpacker hostel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешественник, чей багаж состоит из рюкзака, особенно тот, кто пользуется хостелами и недорогими услугами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бэкпэкер",
                                "target_lang_sense_clarification": "путешественник с рюкзаком"
                            },
                            {
                                "target_lang_word": "пеший турист",
                                "target_lang_sense_clarification": "путешествующий пешком или бюджетно"
                            },
                            {
                                "target_lang_word": "бюджетный турист",
                                "target_lang_sense_clarification": "путешественник, экономящий на услугах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf58b53f-995e-389f-8c55-0a3f2b3f58b1",
                    "sense_definition": "A hostel or inexpensive lodging facility specifically catering to travelers with backpacks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to stay in a <w>backpacker</w> near the city center to save money on our trip.",
                            "target_lang_translations": {
                                "ru": "Мы решили остановиться в <w>хостеле</w> недалеко от центра города, чтобы сэкономить деньги в поездке."
                            }
                        },
                        {
                            "text": "The local <w>backpacker</w> was fully booked because of the music festival happening this weekend.",
                            "target_lang_translations": {
                                "ru": "Местный <w>бэкпэкер-хостел</w> был полностью забронирован из-за музыкального фестиваля, проходящего в эти выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "hostel",
                        "youth hostel"
                    ],
                    "antonyms": [
                        "hotel"
                    ],
                    "common_phrases": [
                        "stay in a backpacker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Australia, New Zealand, and South Africa"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage for a hostel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хостел или недорогое жилье, специально предназначенное для путешественников с рюкзаками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хостел",
                                "target_lang_sense_clarification": "недорогое жилье"
                            },
                            {
                                "target_lang_word": "бэкпэкер-хостел",
                                "target_lang_sense_clarification": "специализированное бюджетное жилье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                    "sense_definition": "A fan or performer of backpack rap, a subgenre of hip hop characterized by its underground or non-mainstream nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The underground club was filled with <w>backpackers</w> who preferred lyrical depth over commercial beats.",
                            "target_lang_translations": {
                                "ru": "Андеграундный клуб был полон <w>бэкпэкеров</w>, которые предпочитали глубину текстов коммерческим битам."
                            }
                        },
                        {
                            "text": "He started his career as a <w>backpacker</w> before signing with a major record label.",
                            "target_lang_translations": {
                                "ru": "Он начал свою карьеру как <w>бэкпэкер</w>, прежде чем подписать контракт с крупным лейблом звукозаписи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "backpacker rap"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to hip hop culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поклонник или исполнитель бэкпэк-рэпа, поджанра хип-хопа, характеризующегося андеграундным или некоммерческим характером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бэкпэкер",
                                "target_lang_sense_clarification": "в контексте хип-хоп культуры"
                            },
                            {
                                "target_lang_word": "андеграунд-рэпер",
                                "target_lang_sense_clarification": "исполнитель некоммерческого хип-хопа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
