                "senses": [
                    {
                        "sense_id": "fc706e24-81e9-363e-915b-b6af213ca401",
                        "entry_id": "09b6f3c9-21b9-3458-9193-353d653f801e",
                        "glosses": [
                            "fuss; ado; useless or fretful behaviour, talk"
                        ],
                        "tags": [
                            "colloquial",
