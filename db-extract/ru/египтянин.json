                    },
                    {
                        "sense_id": "1cd83373-1310-3571-86d6-5c735f1ec847",
                        "entry_id": "d543c91c-1f89-36a4-a5fc-b20c074dfa5a",
                        "glosses": [
                            "представитель народа Древнего Египта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a41fa0a-31bc-48b2-9c1f-3c3fab0fa6c1",
                                "sense_id": "1cd83373-1310-3571-86d6-5c735f1ec847",
                                "text": "Любой египтянин, какой бы высокий пост он ни занимал, целиком зависел от фараона."
                            }
                        ]
