                        "sense_id": "5242bbb7-c56b-3870-8bf5-9700c61dd95f",
                        "entry_id": "68bf7674-6674-319e-bd55-8e432f4dd658",
                        "glosses": [
                            "een glas met inhoud van ongeveer 200 ml waaruit men limonade kan drinken"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "1ed02325-6d68-40ee-a2e1-d15e38a5faac",
                                "sense_id": "5242bbb7-c56b-3870-8bf5-9700c61dd95f",
                                "text": "Een ander voorbeeld van Roelofs: \"Een vrachtwagenchauffeur van in de vijftig, die dronk 1,5 liter Beerenburg per dag. Hij moest 's ochtends eerst een limonadeglas vol drinken, anders trilde hij te veel om de sleutel in zijn autoslot te krijgen. Hij zit nu sinds twee weken in een verslavingskliniek.\""
                            },
                            {
                                "example_id": "22907a1e-6285-4fc2-84a1-fa0ef12b3ca0",
                                "sense_id": "5242bbb7-c56b-3870-8bf5-9700c61dd95f",
                                "text": "Het water zat in een limonadeglas. Dat het water heet is voel je dan echt wel.” Maar dat sprak L. tegen. „Ik had net mijn hand verbonden, door het verband voelde ik niet dat het glas heet was.”"
                            }
                        ]
                    }
