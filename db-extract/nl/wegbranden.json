                            {
                                "example_id": "fadfe46f-9083-4196-91c3-194b4bbc34bb",
                                "sense_id": "cc63d946-7f7e-3568-a28e-9920d8e1bfbb",
                                "text": "Het brandje ontstond aan de Breemarsweg. De bewoners waren onkruid aan het wegbranden, toen planken aan het muurtje vlam vatten."
                            },
                            {
                                "example_id": "a01048d0-26eb-40d2-8004-3e0fa1fb51cb",
                                "sense_id": "cc63d946-7f7e-3568-a28e-9920d8e1bfbb",
                                "text": "Het wegbranden van onkruid heeft grote gevolgen gehad bij een bedrijf aan de Holtersweg in Hengelo. Het vuur sloeg over op een heg die in brand vloog."
                            },
                            {
                                "example_id": "31a6ca4a-82ee-4917-8239-ed6091f2a7fa",
                                "sense_id": "cc63d946-7f7e-3568-a28e-9920d8e1bfbb",
                                "text": "De klassiekerspecialist onderging vorige maand een operatie van bijna vijf uur. ,,Het was heel heftig, zegt Boom. ,,Het is niet niks als ze dingen in je hart wegbranden. Een lichaam moet daarvan herstellen. Dat proces duurt langer dan ik had verwacht."
                            }
                        ]
                    }
