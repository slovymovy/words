                "senses": [
                    {
                        "sense_id": "ccc9dd51-cd21-359b-8830-8e3e9675add6",
                        "entry_id": "65bce0ec-5407-3968-9a78-4326fcf4eaf6",
                        "glosses": [
                            "een bak waar een hengelaar wormen vangt en bewaart die hij als aas gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bab5e9-cb12-4446-96f3-b2478c13020c",
                                "sense_id": "ccc9dd51-cd21-359b-8830-8e3e9675add6",
                                "text": "Al op tekeningen van Rembrandt zijn baarsvissers te zien. Vaste attributen waren een korte bamboehengel, een wormenbak aan de broekriem en, voor de vangst, een houten vistonnetje aan een dikke leren riem om de schouders. Rond 1890 waren alleen in Amsterdam al 25 baarsvisclubs actief."
                            }
                        ]
                    },
                    {
                        "sense_id": "adea64c4-171d-38e2-9f82-72feea32f8b6",
                        "entry_id": "65bce0ec-5407-3968-9a78-4326fcf4eaf6",
                        "glosses": [
                            "een bak met compostwormen die compost maken van Groente-, fruit-, tuin- en keukenafval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83023713-2898-4726-a4e1-09c467686442",
                                "sense_id": "adea64c4-171d-38e2-9f82-72feea32f8b6",
                                "text": "En zo zijn er nog veel meer manieren om beestjes te vangen. Nachtvlinders met suikerwater, bladluizen met een zuigpotje, wormen met een wormenbak."
                            },
                            {
                                "example_id": "1727d6ba-f700-45c3-abca-d9fe5eedfd7f",
                                "sense_id": "adea64c4-171d-38e2-9f82-72feea32f8b6",
                                "text": "Opzichters in een natuurgebied in Nieuw-Zeeland deden zaterdag een wel heel vreemde ontdekking. Dieven blijken er aan de haal te zijn gegaan met een wormenbak waar meer dan 8.000 van de glibberige beestjes in zaten."
                            }
                        ]
                    }
