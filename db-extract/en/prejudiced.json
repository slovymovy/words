                                            {
                                                "example_id": "42148e1e-393f-48cf-bf1f-36885258ff77",
                                                "sense_id": "c17d83b5-389f-394e-aaf1-9bee0fe0b320",
                                                "text": "Der Richter wurde als befangen vom weiteren Verfahren ausgeschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db29fd61-3206-3d82-8e9b-b7f4e441bde4",
                                        "entry_id": "6f7ac4c9-b7c7-3880-aeb6-17fb37dd2a45",
                                        "glosses": [
                                            "gehemmt, unsicher, verlegen, verwirrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e7c5ae-6922-4e02-9494-47cbe7eee123",
                                                "sense_id": "db29fd61-3206-3d82-8e9b-b7f4e441bde4",
                                                "text": "Beim ersten Rendezvous waren sie noch sehr befangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "befangen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "360cdf25-3424-30f9-abd4-5017141d5335",
                                        "entry_id": "e0af00f0-a2dc-35bd-a06d-09b5e80a09aa",
                                        "glosses": [
                                            "umfangen, umwickeln"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92599b94-56e2-4899-bcb4-7c834e471f73",
                                                "sense_id": "360cdf25-3424-30f9-abd4-5017141d5335",
                                                "text": "„Der wüste Fels, die waldumwachsne Bucht befangen mich.“ (1837)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49e18aad-461b-382e-b5b7-48485b0e8e03",
                                        "entry_id": "e0af00f0-a2dc-35bd-a06d-09b5e80a09aa",
                                        "glosses": [
                                            "gefangennehmen"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a7cbcb3-3107-4462-9cc5-c9baae35b19c",
                                                "sense_id": "49e18aad-461b-382e-b5b7-48485b0e8e03",
                                                "text": "„Wo ich einen Ritter fand, Der, als er von Furcht befangen Mich erblickt, zu seinen Waffen Greift.“ (1826)"
                                            },
                                            {
                                                "example_id": "5a5eaa05-d2f5-47c2-9f35-c526bf525ef4",
                                                "sense_id": "49e18aad-461b-382e-b5b7-48485b0e8e03",
                                                "text": "„Wirklich, Sie glauben nicht daran? Ach hören Sie doch; als ich als Kind nach einem kurzen Mittagsschlaf die Augen öffnete, hörte ich noch ganz im Schlaf befangen meine Mutter in natürlichem Ton vom Balkon hinunterfragen: ‚Was machen Sie meine Liebe. Es ist so heiß.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0254be57-d47e-3048-8c74-69b8c41c4d89",
                                        "entry_id": "e0af00f0-a2dc-35bd-a06d-09b5e80a09aa",
                                        "glosses": [
                                            "sich mit etwas befassen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "563f5310-9fd1-470b-b3ee-e580a4569078",
                                                "sense_id": "0254be57-d47e-3048-8c74-69b8c41c4d89",
                                                "text": "„Kein Forstbedienter befängt sich mit Geldgeschäften, die ganz dem Rentamt zugewiesen sind.“ (1823)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
