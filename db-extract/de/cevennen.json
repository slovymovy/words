                "senses": [
                    {
                        "sense_id": "aa77bed6-fa6c-3fff-ab11-d7a2f16e0ff0",
                        "entry_id": "46b29e90-b5fd-3477-bdcb-283a78519c96",
                        "glosses": [
                            "Gebirgskette in Süd- und Zentralfrankreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35c9a51-734f-4286-b022-617d1da99991",
                                "sense_id": "aa77bed6-fa6c-3fff-ab11-d7a2f16e0ff0",
                                "text": "„Ein Bewässerungsprojekt versorgt südlich der Cevennen 300 000 ha Ackerland mit Wasser, um den Obst- und Gemüsebau sowie die Viehzucht zu intensivieren.“"
                            },
                            {
                                "example_id": "bb0a7ea9-3696-4c49-be74-2ad823fe758f",
                                "sense_id": "aa77bed6-fa6c-3fff-ab11-d7a2f16e0ff0",
                                "text": "„Die in Frankreich verbliebenen Hugenotten zogen sich in die Cevennen zurück und lieferten dem französischen König 1702–1705 einen erbitterten Krieg (Aufstand der Kamisarden).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d7f0e5-27bb-4ab6-a80c-c8f35b7e73d8",
