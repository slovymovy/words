                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exposer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est immédiatement venu <w>présenter</w> ses excuses pour le retard causé par l'accident."
                        },
                        {
                            "text": "L'architecte <w>présente</w> un projet novateur devant les membres de la commission municipale."
