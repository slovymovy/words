                    {
                        "translation_id": "a1ea5605-ee2b-456e-8f7d-4cfd2079c9ef",
                        "source_entry_id": "75b9e308-ffae-391f-a350-a4cece479617",
                        "source_sense_description": "acting or occurring involuntarily, without conscious control",
                        "target_lang_word": "autonome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f4b28b-a485-3f8d-864c-6c63011e812c",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Qui se dirige ou se contrôle soi-même."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1afed85e-f67f-35b0-a945-e1a899ebcd15",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Organisation qui peut prendre ses propres décisions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed97b54e-a044-48ef-9693-6bd4091a7916",
                                                "sense_id": "1afed85e-f67f-35b0-a945-e1a899ebcd15",
                                                "text": "Pendant cinq siècles, sous la direction de ses capitouls et de ses consuls, Montauban fut une courageuse petite démocratie autonome."
                                            },
                                            {
                                                "example_id": "59baa907-4eed-4909-8aee-6fd399b72c94",
                                                "sense_id": "1afed85e-f67f-35b0-a945-e1a899ebcd15",
                                                "text": "Sous la domination du Saint-Empire, Metz était une ville autonome, indépendante de l’évêché."
                                            },
                                            {
                                                "example_id": "1fd27108-6bed-4e5f-b8a0-ff1a9b230a82",
                                                "sense_id": "1afed85e-f67f-35b0-a945-e1a899ebcd15",
                                                "text": "Les chambres régionales cesseraient d’être des juridictions autonomes et deviendraient des composantes de la Cour […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54943c07-780a-3d4d-8e58-32b113810ca6",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Se dit de l’exploitation d’une unité fonctionnelle lorsqu’elle n’est pas placée sous la commande directe de l’ordinateur. La définition ainsi que les termes autonome, hors ligne et en non connecté furent normalisés d’abord par l’ISO/CÉI ISO 2382-10:1979, et repris par l’ISO/CÉI ISO 2382-1:1993."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e7277a3-53ee-3238-8c5a-693d61d288cd",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Se dit d’un matériel lorsqu’il fonctionne indépendamment de tout autre : par exemple un poste de travail déconnecté de l’Internet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67f46b72-83a1-3435-b27a-abc965d4bf44",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Relatif au mouvement autonome."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0efa67ff-d12e-30fc-8e33-2907d9688c4c",
                                        "entry_id": "4c631833-3319-38dc-8a4a-586696c4a291",
                                        "glosses": [
                                            "Pour un véhicule, se dit d'un véhicule qui peut se mouvoir sans conducteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a6c17d-1d33-471a-8841-8fb25cedc936",
                                                "sense_id": "0efa67ff-d12e-30fc-8e33-2907d9688c4c",
                                                "text": "C’est vrai pour tous les types de véhicules autonomes de niveau 4 : robotaxis, robonavettes, camions autonomes, robots de livraison, nettoyeurs autonomes de voirie, robots de surveillance, robots de distribution alimentaire."
                                            }
                                        ]
                                    }
                                ]
                            },
