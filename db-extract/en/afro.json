    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                "word": "afro",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "17b024e9-979e-4990-9ef6-ba51a02826fc",
                        "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                        "tags": [
                            "plural"
                        ],
                        "form": "afros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe0af420-4e0c-3ff9-be27-5561411ddeb9",
                        "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                        "glosses": [
                            "hairstyle characterized by tightly curled locks and a rounded shape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a113c1-6c38-41bb-b6f3-a911923dd6af",
                                "sense_id": "fe0af420-4e0c-3ff9-be27-5561411ddeb9",
                                "text": "sheʼd been unmissable sitting in the front row of the lecture theatre with a crazy-ass afro and stunning face"
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                        "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                        "glosses": [
                            "A person of African ancestry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6d02c0-59e7-4c7d-9957-88359a22c178",
                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                "text": "The Ghanaian government employed several Afros, as many of the expatriates called themselves, downplaying their Americanness, in ideological and infrastructure-building occupations."
                            },
                            {
                                "example_id": "8b6e459b-ecd7-470a-99be-db0a13f2db48",
                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                "text": "At the height of the American civil rights agitation, a number of members of the Black Panther movement moved to Tanzania, and lived outside Arusha where they formed a community, calling themselves ‘’Afros.’’"
                            },
                            {
                                "example_id": "304e0482-e0ee-4a84-aed2-38b39a01f380",
                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                "text": "Afrodescendants (or simply Afros) are the descendants of Africans who were dispersed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2e01c50-3c20-463e-a7c0-6a1c00bb7a03",
                        "source_entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                        "source_sense_description": "hairstyle",
                        "target_lang_word": "afro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d5c19b-c795-3438-970a-8068369aa606",
                                        "entry_id": "3775c72e-213d-314c-b9ad-045096021faa",
                                        "glosses": [
                                            "Coupe de cheveux emblématique du Black Power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe52c70-ca8b-47bc-9f92-34e8d978d3e8",
                                                "sense_id": "c3d5c19b-c795-3438-970a-8068369aa606",
                                                "text": "Disons le ouvertement avoir le cheveu crépu ne se résume pas à porter le fameux afro des jackson five ou de la légendaire Angéla Davis."
                                            },
                                            {
                                                "example_id": "f18fe9e3-3ae8-45c6-b675-33010add5e61",
                                                "sense_id": "c3d5c19b-c795-3438-970a-8068369aa606",
                                                "text": "Tressé, locksé, en afro ou en vanille… le cheveu dit naturel - ou texturé - peut se coiffer de façons très différentes !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48dac2ed-0dd5-33c7-a770-87e8f4d0dac4",
                                        "entry_id": "dfe87657-e7b5-31eb-a187-3cbfd058e846",
                                        "glosses": [
                                            "Crépu et arrondi, en parlant de la coiffure portée par les membres du Black Power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4e4995-604c-4376-aa1b-3e4f120f4880",
                                                "sense_id": "48dac2ed-0dd5-33c7-a770-87e8f4d0dac4",
                                                "text": "On l’imagine nimbée d'une coiffure afro et d’un nuage de fumée, gauloise sans filtre aux lèvres. Les années ont beau passer, Angela Davis reste une icône."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "851dd83a-a34c-4c6c-9be3-40c4141b4b07",
                        "source_entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                        "source_sense_description": "hairstyle",
                        "target_lang_word": "Afrolook",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrolook",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12174630-cd56-371c-a3fe-c588babce8c8",
                                        "entry_id": "85a5cf78-14af-3179-b44c-13a6f2ae3b1c",
                                        "glosses": [
                                            "stark gekraustes Haar, das nach allen Seiten wild absteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400b0237-254a-4f03-bf0b-6bd45c254e02",
                                                "sense_id": "12174630-cd56-371c-a3fe-c588babce8c8",
                                                "text": "„Im frisurmäßig stets hinterherhinkenden Deutschland dauerte es länger, bis die Nackenwelle von Rudi Völler, der deutschlandgefärbte Irokese von Christian Ziege oder der Afrolook von Paul Breitner zum Thema auf der Tribüne wurden.“"
                                            },
                                            {
                                                "example_id": "415eaf9c-2a8c-4281-8958-f4cac7c294a9",
                                                "sense_id": "12174630-cd56-371c-a3fe-c588babce8c8",
                                                "text": "„Jutta sah mich herausfordernd an, zauste ihren Afrolook und fuhr fort: Dann komme ich nach Köln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f02e1fdd-159a-4554-8b44-1a76dc3428e6",
                        "source_entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
