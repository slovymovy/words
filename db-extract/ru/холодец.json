                "senses": [
                    {
                        "sense_id": "a38e3e80-d337-380b-b821-1d62bb3b5304",
                        "entry_id": "991135ab-6e01-3501-9d88-2c7d63a35572",
                        "glosses": [
                            "кулин. блюдо из сгустившегося до желеобразной массы от охлаждения мясного бульона с кусочками мяса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c2a260-3994-4a00-8fe6-c72f472d82ec",
                                "sense_id": "a38e3e80-d337-380b-b821-1d62bb3b5304",
                                "text": "Дадут ботвиньи нам с душистым огурцом, // Иль холодец, лапшу, иль с жёлтым маслом кашу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73fc71eb-940f-4ba2-8c71-aa67081c5aa6",
                        "source_entry_id": "991135ab-6e01-3501-9d88-2c7d63a35572",
                        "source_sense_id": "a38e3e80-d337-380b-b821-1d62bb3b5304",
                        "target_lang_word": "aspic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20f69d40-5afc-3fb3-8deb-b5468f1980ce",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A meat or fish jelly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2c9473-d52e-4b36-b90a-c3982f4ea56e",
                                                "sense_id": "20f69d40-5afc-3fb3-8deb-b5468f1980ce",
                                                "text": "“Put a little aspic in the mould, so as to cover the bottom ···“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc813e3f-cfed-3386-8c21-c6577728d8ea",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A dish in which ingredients are set into a gelatine, jelly-like substance made from a meat stock or consommé."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de5c70d8-c86d-4645-b46c-1452ac53ea23",
                                                "sense_id": "fc813e3f-cfed-3386-8c21-c6577728d8ea",
                                                "text": "\"I don't know what you mean, Mr. Wynand,\" whispered Keating. His eyes fixed upon the tomato aspic on his salad plate; it was soft and shivering; it made him sick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "An asp, a small venomous snake of Egypt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6680dd0-9f49-49d4-8fba-152a69472702",
                                                "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                                "text": "This is an aspic's trail: and these fig-leaves / Have slime upon them, such as the aspic leaves."
                                            },
                                            {
                                                "example_id": "23251643-9e5d-4b84-8bd4-3d43bd6ea2e4",
                                                "sense_id": "6eb8f976-f3bd-3f1d-b28c-1f201c8aa6e5",
                                                "text": "(With that she tore her robe apart, and half / The polished argent of her breast to sight / Laid bare. Thereto she pointed with a laugh, / Showing the aspic's bite. )"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4595e74-810c-3ade-85bb-23a377d83cea",
                                        "entry_id": "aef7d144-1922-3e69-b04a-824902edbb6c",
                                        "glosses": [
                                            "A light cannon firing a two-pound ball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aspic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460588d9-e761-3687-b49a-2fcfec7da1d6",
                                        "entry_id": "7cb9ac62-26ba-34f8-a2b0-9435afe13a43",
                                        "glosses": [
                                            "Aspish; relating to an asp, a small venomous snake of Egypt."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e96746-c252-47a6-a16d-69f80aa0b140",
                                                "sense_id": "460588d9-e761-3687-b49a-2fcfec7da1d6",
                                                "text": "Timeless mother, / How is it that your aspic nipples / For once vent honey?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
