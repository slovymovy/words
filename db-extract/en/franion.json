                        "glosses": [
                            "A cheerful, frivolous person, a silly man; a loose woman."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8628a412-8602-4c8f-b0f3-fc9c3c536c27",
                                "sense_id": "effc0d2f-106c-34b2-98f0-20a761e7367c",
                                "text": "First by her side did sitt the bold Sansloy,\nFitt mate for such a mincing mineon,\nWho in her loosenesse tooke exceeding ioy;\nMight not be found a francker franion,\nOf her leawd parts to make companion:"
                            },
                            {
                                "example_id": "c9a1d877-0528-42d2-b7d7-8eba7e728599",
                                "sense_id": "effc0d2f-106c-34b2-98f0-20a761e7367c",
                                "text": "1595, George Peele, The Old Wives’ Tale, The Malone Society Reprints, 1908, lines 12-14,\n[…] as I am frollicke franion, never in all my life was I so dead slaine."
                            },
                            {
                                "example_id": "8e7c2b2e-563a-4dc7-a895-f8f2bb4ebbbf",
                                "sense_id": "effc0d2f-106c-34b2-98f0-20a761e7367c",
                                "text": "Fine merry franions,\nWanton companions,\nMy days are ev’n banyans\nWith thinking upon ye;"
                            }
                        ]
                    }
                ],
