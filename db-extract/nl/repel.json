                                    {
                                        "sense_id": "1fd6bbc6-845b-3ff5-8d52-6caa9593b96d",
                                        "entry_id": "49360253-5b7c-3cc4-a372-d00f7412b72e",
                                        "glosses": [
                                            "To launch or unleash in rapid succession."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029f5f0a-4b50-4642-bd10-f5f10c06a005",
                                                "sense_id": "1fd6bbc6-845b-3ff5-8d52-6caa9593b96d",
                                                "text": "Hearns' 'Mech rippled fifteen missiles. Austen watched the missiles go in. They smashed into a copse of trees, smashing the trunks aside."
                                            }
                                        ]
                                    }
                                ]
                            },
