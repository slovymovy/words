                {
                    "sense_id": "cbc275b3-043a-3130-b743-d29dc5628003",
                    "sense_definition": "een eenheid van tijd die bestaat uit 60 minuten",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een dag bestaat uit vierentwintig <w>uur</w>.",
                            "target_lang_translations": {
                                "en": "A day consists of twenty-four <w>hours</w>."
                            }
                        },
                        {
                            "text": "De reis naar Amsterdam duurt ongeveer een <w>uur</w> met de trein.",
                            "target_lang_translations": {
                                "en": "The journey to Amsterdam takes about an <w>hour</w> by train."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een half uur",
                        "anderhalf uur",
                        "uren duren"
                    ],
                    "target_lang_definitions": {
                        "en": "a unit of time consisting of 60 minutes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "a unit of time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f63141-d499-3a52-a0d2-989e84e78b75",
                    "sense_definition": "wordt gebruikt om een specifiek tijdstip op de dag aan te geven",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tijdstip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is nu precies twaalf <w>uur</w> en tijd voor de lunch.",
                            "target_lang_translations": {
                                "en": "It is exactly twelve <w>o'clock</w> now and time for lunch."
                            }
                        },
                        {
                            "text": "De afspraak bij de tandarts is om acht <w>uur</w> 's ochtends.",
                            "target_lang_translations": {
                                "en": "The dentist appointment is at eight <w>o'clock</w> in the morning."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoeveel uur",
                        "om acht uur"
                    ],
                    "target_lang_definitions": {
                        "en": "used to indicate a specific time of day"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "o'clock",
                                "target_lang_sense_clarification": "used with numbers for the time"
                            },
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "used in military or formal time (e.g., 1300 hours)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be22eccc-0360-3a24-befb-58d5e2e7a98c",
                    "sense_definition": "een bepaald tijdstip of ogenblik op de dag",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijdstip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat doe jij op dit <w>uur</w> nog wakker in de woonkamer?",
                            "target_lang_translations": {
                                "en": "What are you doing awake in the living room at this <w>hour</w>?"
                            }
                        },
                        {
                            "text": "Vannacht om een laat <w>uur</w> vertrok de laatste trein naar huis.",
                            "target_lang_translations": {
                                "en": "The last train home left at a late <w>hour</w> last night."
                            }
                        }
                    ],
                    "synonyms": [
                        "tijdstip",
                        "ogenblik"
                    ],
                    "common_phrases": [
                        "op dit uur",
                        "te elfder ure"
                    ],
                    "target_lang_definitions": {
                        "en": "a certain time or moment during the day"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hour",
                                "target_lang_sense_clarification": "a particular time or moment"
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "a specific point in the day"
                            }
                        ]
                    }
                }
            ]
        }
    ]
