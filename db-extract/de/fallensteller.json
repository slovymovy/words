                ],
                "senses": [
                    {
                        "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                        "entry_id": "605af732-15cc-32d7-99bb-86e7a07dbf80",
                        "glosses": [
                            "Person, die Fallen auslegt; die Fallen aufstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b12afc-f8ac-498f-b1e3-042b3baebb52",
                                "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                                "text": "„Der Yukon Quest erinnert an die historische Rolle des Trails bei der Erforschung des amerikanischen und kanadischen Nordens und an die Gold-Schürfer, Fallensteller und Briefboten, die das Land ohne Hilfe moderner Beförderungsmittel erschlossen.“"
                            },
                            {
                                "example_id": "40060d5c-a7ce-4cb9-8b81-ee37750c0dc8",
                                "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                                "text": "„Sofern der Fallensteller als Killer ausgewählt wurde, werden über die Spielwelt geschlossene Bärenfallen verteilt, welche vom Killer aufgesammelt und an anderen Orten wieder platziert werden können, um so einen Überlebenden, sofern dieser die Falle aktiviert, indem er über sie läuft, dort festzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2a3c459-d1c6-40de-91cb-66af49803c83",
                        "source_entry_id": "605af732-15cc-32d7-99bb-86e7a07dbf80",
                        "source_sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                        "source_sense_description": "Person, die Fallen auslegt; die Fallen aufstellt",
                        "target_lang_word": "trappeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trappeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                        "entry_id": "5c32a227-939b-334b-96a3-70b86a38f955",
                                        "glosses": [
                                            "Chasseur de l’Amérique du Nord, qui se sert ordinairement de trappes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62d901a-cd1d-4878-8e48-ce271e5d985c",
                                                "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                                "text": "Entre autres manies, mon oncle avait celle de tuer tous les chats qu’il rencontrait. Il faisait, à ces pauvres bêtes, une chasse impitoyable, une guerre acharnée de trappeur."
                                            },
                                            {
                                                "example_id": "4d058347-008f-4505-869d-f90c381677c3",
                                                "sense_id": "58aae20e-3a1e-30fa-afcd-63a78ebacbfb",
                                                "text": "Même si l’époque des coureurs des bois se trouve loin derrière nous, des trappeurs de l’Est-du-Québec parcourent toujours des centaines de kilomètres dans la forêt chaque année de manière professionnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                        "entry_id": "5c32a227-939b-334b-96a3-70b86a38f955",
                                        "glosses": [
                                            "Musicien jouant de la trap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89aec653-d49f-4bd5-9920-facbdcdfe96f",
                                                "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                                "text": "Ce trappeur joue très bien."
                                            },
                                            {
                                                "example_id": "017c507f-4247-4f77-bd6b-f6071ed58c59",
                                                "sense_id": "5c5ca2da-4ed5-38cb-9f1f-239d5c5a9e4a",
                                                "text": "Ce trappeur est très abile avec sa trap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
