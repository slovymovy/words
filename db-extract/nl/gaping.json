        "nl-extract.jsonl": [
            {
                "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                "word": "gaping",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "67961249-df81-422e-b8c9-26cd4cbc267e",
                        "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gapingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9014d0b1-1938-3587-a9d5-752501b9e872",
                        "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                        "glosses": [
                            "een opening, met name als het gaat over een opening in een verder aaneengesloten front"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c5c94d-f1d6-4095-bd8d-cf15321d7583",
                                "sense_id": "9014d0b1-1938-3587-a9d5-752501b9e872",
                                "text": "Hoe voelt Nederland? Ingehouden, met dichtgeknepen billen. Dat is het eerste wat in me opkomt. Vaak wordt er in de lucht gekust. De Nederlandse huid laat zich niet gemakkelijk strelen. Nederland voelt ongemakkelijk. Er is een afstand, een kleine gaping tussen degene die voelt en het gevoelde; afstand die niet altijd overwonnen kan worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f5ee478-5de6-3767-9772-75f55a1dd640",
                        "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                        "glosses": [
                            "mond"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "af4e9b9f-16e7-3b1d-beee-e979a2d9fd80",
                        "entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                        "glosses": [
                            "ontbreken van voor de samenhang noodzakelijke onderdelen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f68a3f2e-a383-41a6-888e-fae7cee05bc0",
                                "sense_id": "af4e9b9f-16e7-3b1d-beee-e979a2d9fd80",
                                "text": "Dr. Brandt Corstius moet talrijke voorbeelden van echte en - dat moet de vakman de columnist toegeven - ook schijnbare germanismen op, zonder te besluiten of het verdwijnen van sommige (ik denk aan daadzaak, daarstellen) en het voortbestaan van andere (zich verdringen, middels) te verklaren is uit het optreden van publicisten, uit gapingen in onze taalvoorraad of uit andere oorzaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d658e597-486e-44ff-b1e0-161cc220d9a0",
                        "source_entry_id": "d74db522-9f20-35ab-a301-2fdd5bcf153a",
                        "source_sense_id": "9014d0b1-1938-3587-a9d5-752501b9e872",
                        "source_sense_description": "# (figuurlijk) ontbreken van voor de samenhang noodzakelijke onderdelen",
                        "target_lang_word": "hiatus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiatus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ac9139-999b-353b-8a99-0bbe22c2a7f8",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A gap in a series, making it incomplete."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c037d5-1fbd-4ba9-8153-3135845dac21",
                                                "sense_id": "f7ac9139-999b-353b-8a99-0bbe22c2a7f8",
                                                "text": "Even the mechanical engineer comes at last to an end of his figures, and must stand up, a practical man, face to face with the discrepancies of nature and the hiatuses of theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An interruption, break, pause or absence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fce861-88e4-4358-adbb-ff830544a2c4",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "The band decided to go on hiatus, citing creative differences."
                                            },
                                            {
                                                "example_id": "af938f02-36e9-4416-b7a5-567f391e6ef7",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "It is wonderful that you should have slipped back into your American life so easily after your English hiatus."
                                            },
                                            {
                                                "example_id": "1c1fe04e-8e92-4d2a-ad35-4cec22e764ed",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "After a ten-year dividend hiatus, shareholder payments only re-started in July 2022."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eaf9a1a-b2d9-3cee-bd85-a8eb39b9e8cb",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An temporary break from work, especially one which is unexpected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4408c7d6-5fb8-3ef2-a50a-1abe5ca9a4e0",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A gap in geological strata."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce5fc36-11af-4af2-b84b-4a7a6ee20cfd",
                                                "sense_id": "4408c7d6-5fb8-3ef2-a50a-1abe5ca9a4e0",
                                                "text": "The beginning of the Mesozoic Era on the Colorado Plateau is marked by a regional hiatus or break of sedimentary deposition that lasted about 25 to 30 Ma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5225cac4-8b80-3d6e-87a5-17ec4a654d44",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An opening in an organ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1dcf98-d096-4a95-8bb9-253d8f9908a2",
                                                "sense_id": "5225cac4-8b80-3d6e-87a5-17ec4a654d44",
                                                "text": "Hiatus aorticus is an opening in the diaphragm through which aorta and thoracic duct pass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c3b2c4e-78c9-3f1e-9a0a-fa5b5fa1a129",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A syllable break between two vowels, without an intervening consonant."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8626f8a0-8aef-496c-aa36-2a5807fe9674",
                                                "sense_id": "0c3b2c4e-78c9-3f1e-9a0a-fa5b5fa1a129",
                                                "text": "A hiatus is agreeable to any Polynesian ear; the ear even of the stranger soon grows used to these barbaric voids; but only in the Marquesan will you find such names as Haaii and Paaaeua, when each individual vowel must be separately uttered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
