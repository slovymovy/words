                        "entry_id": "a1343ce6-c5a2-34b5-bb83-42ab181f29cc",
                        "glosses": [
                            "Allouer préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cff1095-ab31-4f7b-811e-f1d5a4317fa7",
                                "sense_id": "2dce4d8e-9e37-38fa-b6d9-f5d7e401ce68",
                                "text": "Une solution à ce problème est de pré-allouer, par exemple, le réseau aux différents nœuds du système ; cas des protocoles TDMA."
                            },
                            {
                                "example_id": "9c886a33-1fe7-46ae-a4cf-6fa2f24f6811",
                                "sense_id": "2dce4d8e-9e37-38fa-b6d9-f5d7e401ce68",
                                "text": "La taille du tampon à pré-allouer doit être d'une taille un peu supérieure à la taille des données initiales, même si après compression, la taille des données sera moindre."
                            }
                        ]
                    }
