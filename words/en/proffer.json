{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf06c6c0-de6c-3e60-b243-e3cc474fc57d",
                    "sense_definition": "To hold out or put forward something to someone for acceptance; to offer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "give_or_offer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped forward to <w>proffer</w> his assistance when he saw her struggling with the heavy bags.",
                            "target_lang_translations": {
                                "de": "Er trat vor, um seine Hilfe <w>anzubieten</w>, als er sah, wie sie sich mit den schweren Taschen abmühte."
                            }
                        },
                        {
                            "text": "The diplomat decided to <w>proffer</w> friendship in hopes of de-escalating the growing border crisis.",
                            "target_lang_translations": {
                                "de": "Der Diplomat beschloss, Freundschaft <w>anzubieten</w>, in der Hoffnung, die wachsende Grenzkrise zu deeskalieren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proffer an explanation",
                        "proffer advice",
                        "proffer assistance"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem etwas zur Annahme hinhalten oder vorlegen; anbieten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anbieten",
                                "target_lang_sense_clarification": "etwas zur Annahme bereitstellen oder offerieren"
                            },
                            {
                                "target_lang_word": "darbieten",
                                "target_lang_sense_clarification": "gehoben für darreichen oder anbieten"
                            },
                            {
                                "target_lang_word": "antragen",
                                "target_lang_sense_clarification": "gehoben für vorschlagen oder anbieten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9736ba93-8402-3a65-94f3-d7494a786907",
                    "sense_definition": "To attempt or undertake something voluntarily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Not a single warrior would <w>proffer</w> to undertake such a perilous voyage across the uncharted sea.",
                            "target_lang_translations": {
                                "de": "Kein einziger Krieger wollte es <w>wagen</w>, eine solch gefährliche Reise über das unerforschte Meer zu unternehmen."
                            }
                        },
                        {
                            "text": "He chose to <w>proffer</w> the hazardous task without being commanded by his superior.",
                            "target_lang_translations": {
                                "de": "Er entschied sich dafür, sich freiwillig an die gefährliche Aufgabe zu <w>wagen</w>, ohne von seinem Vorgesetzten dazu befohlen worden zu sein."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas freiwillig versuchen oder auf sich nehmen (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "versuchen",
                                "target_lang_sense_clarification": "etwas erproben oder anstreben"
                            },
                            {
                                "target_lang_word": "wagen",
                                "target_lang_sense_clarification": "sich freiwillig an etwas Schwieriges heranmachen"
                            },
                            {
                                "target_lang_word": "sich erbieten",
                                "target_lang_sense_clarification": "sich freiwillig bereit erklären, etwas zu tun"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50f2a498-4323-34fc-ae58-99c74283e8dc",
                    "sense_definition": "An offer made; something presented or tendered for acceptance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "give_or_offer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She politely declined their generous <w>proffer</w> of food and drink after the meeting.",
                            "target_lang_translations": {
                                "de": "Sie lehnte ihr großzügiges <w>Angebot</w> an Speisen und Getränken nach dem Treffen höflich ab."
                            }
                        },
                        {
                            "text": "His sudden <w>proffer</w> of friendship was met with suspicion by the rival faction.",
                            "target_lang_translations": {
                                "de": "Sein plötzliches <w>Angebot</w> der Freundschaft stieß bei der gegnerischen Fraktion auf Misstrauen."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposition"
                    ],
                    "common_phrases": [
                        "proffer of assistance",
                        "proffer of marriage"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein unterbreitetes Angebot; etwas, das zur Annahme dargeboten wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Angebot",
                                "target_lang_sense_clarification": "Vorschlag oder Offerte zur Annahme"
                            },
                            {
                                "target_lang_word": "Offerte",
                                "target_lang_sense_clarification": "formelles Angebot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97d6d92-19d1-368c-9ccf-20b57e20bc20",
                    "sense_definition": "An attempt or trial; an essay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infant made an early <w>proffer</w> at speech before mastering full sentences.",
                            "target_lang_translations": {
                                "de": "Das Kleinkind machte einen frühen <w>Versuch</w> zu sprechen, bevor es ganze Sätze beherrschte."
                            }
                        },
                        {
                            "text": "Their first <w>proffer</w> of attack was easily repelled by the fortified garrison.",
                            "target_lang_translations": {
                                "de": "Ihr erster Angriffs<w>versuch</w> wurde von der befestigten Garnison mühelos abgewehrt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Versuch oder eine Probe (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Versuch",
                                "target_lang_sense_clarification": "Bemühung oder Erprobung"
                            },
                            {
                                "target_lang_word": "Ansatz",
                                "target_lang_sense_clarification": "erster Versuch"
                            }
                        ]
                    }
                }
            ]
        },
