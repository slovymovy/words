                        "sense_id": "954d99c1-4b63-382b-9743-334a18a87507",
                        "entry_id": "23f7ebcb-13be-3c30-9134-dabfd487a005",
                        "glosses": [
                            "overconfident, naive and emotional patriotism, especially in time of war or crisis; flag-waving, jingoism"
                        ],
                        "tags": [
                            "derogatory",
                            "masculine",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f8866bd6-5d81-46ee-9697-3c6938253a42",
                                "sense_id": "954d99c1-4b63-382b-9743-334a18a87507",
                                "text": "Wir dürfen nicht in Hurrapatriotismus verfallen, sondern müssen die geopolitische Lage klug und nüchtern analysieren.",
                                "translation": "We mustn’t lapse into flag-waving jingoism, but rather analyse the geopolitical situation wisely and objectively.",
                                "english": "We mustn’t lapse into flag-waving jingoism, but rather analyse the geopolitical situation wisely and objectively."
                            }
                        ]
                    }
