                                            {
                                                "example_id": "8f9a1d01-37fb-41f6-9f57-3e2fc149bcba",
                                                "sense_id": "004efc44-129b-35da-a314-8432627603fd",
                                                "text": "It's hard to keep hair in a specific hairdo when you just spritz only a little bit of hair spray."
                                            },
                                            {
                                                "example_id": "94125016-9500-4321-bc32-3ad2ecf3a3b2",
                                                "sense_id": "004efc44-129b-35da-a314-8432627603fd",
                                                "text": "“Sometimes,” he hastened to explain, looking at Khadijah and me, stroking his beard, “the fruit at Gaia is slightly rotten. That's the dark side of organic. Everything isn't spritzed with poisons to make it look neat.”"
                                            }
                                        ]
