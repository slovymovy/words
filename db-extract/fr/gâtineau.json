                            {
                                "example_id": "922ed026-4c0f-4fc4-8f1c-49add0ff0ed3",
                                "sense_id": "42346876-c0f3-3cb9-851e-867b202c9cc2",
                                "text": "La ferme-école du Petit-Chêne, créée en 1849 à Mazières-en-Gâtine, joua un rôle important auprès des Gâtineaux dans la diffusion de ces techniques nouvelles."
                            },
                            {
                                "example_id": "9b108b01-6abc-45fd-8e71-8d5bcf047251",
                                "sense_id": "42346876-c0f3-3cb9-851e-867b202c9cc2",
                                "text": "Pour l’essentiel, les Gâtineaux se situent dans la norme catholique en observant et respectant massivement les grands préceptes de l’Église de la Contre-Réforme."
                            },
                            {
                                "example_id": "69218ac9-b7bf-4ddf-a6dd-8e686cd126be",
                                "sense_id": "42346876-c0f3-3cb9-851e-867b202c9cc2",
                                "text": "Ce ne fut pas le moindre des étonnements de beaucoup de Gâtineaux et Gâtinelles que de s’apercevoir qu’ils comprenaient tout ou presque.\n« Eh ! oui, avait lancé le père Joseph à Eugène Boulineau, finalement on parle tous la même langue..."
                            }
                        ]
