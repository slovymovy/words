                                        "entry_id": "941a6510-fa50-3094-ac96-9c933a8fcb20",
                                        "glosses": [
                                            "Ở vị trí ngay trước mặt nhau, thành thế cân xứng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f421d0-986d-41c1-bd00-3af75f46e699",
                                                "sense_id": "9a52e685-cd79-312b-bb97-68c907c3fd9e",
                                                "text": "Lá mọc đối."
                                            },
                                            {
                                                "example_id": "f63fe713-4b54-466b-bdf2-43b935b2cceb",
                                                "sense_id": "9a52e685-cd79-312b-bb97-68c907c3fd9e",
                                                "text": "Hai dãy nhà đối nhau."
                                            },
                                            {
                                                "example_id": "d88ca20f-0ad2-407b-8ea6-e81ca14e9096",
                                                "sense_id": "9a52e685-cd79-312b-bb97-68c907c3fd9e",
                                                "text": "Mặt đối mặt với kẻ thù."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5811ebc4-e793-3471-bb94-bf405bb70a0f",
                                        "entry_id": "941a6510-fa50-3094-ac96-9c933a8fcb20",
                                        "glosses": [
                                            "Cân xứng với nhau về nội dung, giống nhau về từ loại, trái nhau về thanh điệu bằng trắc và được đặt ở thế trên dưới ứng với nhau thành từng cặp (ở một số điểm quy định trong vế câu) để tạo nên một giá trị tu từ nhất định."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26eaec1b-e10c-4563-a6f3-0973676164ef",
                                                "sense_id": "5811ebc4-e793-3471-bb94-bf405bb70a0f",
                                                "text": "\"Sông\" đối với \"núi\"."
                                            },
                                            {
                                                "example_id": "e1118715-21b3-4a49-8ceb-c33db2d33e86",
                                                "sense_id": "5811ebc4-e793-3471-bb94-bf405bb70a0f",
                                                "text": "Hai vế câu này đối nhau chan chát."
                                            },
                                            {
                                                "example_id": "f1dc883a-d506-40c6-86d5-311780844683",
                                                "sense_id": "5811ebc4-e793-3471-bb94-bf405bb70a0f",
                                                "text": "Câu đối."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d941daf-bf60-3a43-be11-7b923c11e4e1",
                                        "entry_id": "941a6510-fa50-3094-ac96-9c933a8fcb20",
                                        "glosses": [
                                            "Xử sự với người, với việc theo những mối quan hệ nhất định."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40034be6-5136-4339-ab09-bc2d9cd68676",
                                                "sense_id": "3d941daf-bf60-3a43-be11-7b923c11e4e1",
                                                "text": "Phải lấy tình thương mà đối với trẻ em."
