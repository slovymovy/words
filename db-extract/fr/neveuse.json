                    {
                        "translation_id": "6e5dc4bd-f162-4e76-8cd6-b61f83b7da6e",
                        "source_entry_id": "780d8765-696f-35b4-bfd0-34019177c213",
                        "source_sense_id": "42765565-127c-325e-a844-f6e52cf9c9ea",
                        "target_lang_word": "Nichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                        "entry_id": "c781a24b-ce9f-35f8-8d47-9b8a36aab49e",
                                        "glosses": [
                                            "Tochter der Schwester oder des Bruders , im weiteren Sinne auch des Schwagers oder der Schwägerin"
                                        ],
                                        "tags": [
                                            "Nichte 1. Grades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845b8975-3449-4880-9a55-ade14501cb51",
                                                "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                                "text": "Meine Nichte macht immer Blödsinn."
                                            },
                                            {
                                                "example_id": "0323edec-3b1c-4de7-a7c4-5d816b51a4a1",
                                                "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                                "text": "„Seine Nichte tat, was er ihr sagte.“"
                                            },
                                            {
                                                "example_id": "9b5b77bd-1909-4f01-968e-cbdea6167ac5",
                                                "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                                "text": "„Es ist die Tante, die über den Suchdienst ihre Nichte und ihren Neffen gefunden hat.“"
                                            },
                                            {
                                                "example_id": "f1e43dad-b330-4cee-b048-4f54097405d6",
                                                "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                                "text": "„Meine älteste Nichte war schon fünfzehn Jahre alt und tat zugleich nah verwandt und unnahbar.“"
                                            },
                                            {
                                                "example_id": "64528ce2-7464-43e2-b48f-b77314a88f51",
                                                "sense_id": "0d8531aa-53f6-3c9c-84ea-750b71d424cd",
                                                "text": "„Seine frühere Klavierlehrerin Paola besaß dort eine Villa, die teilweise von ihrer Nichte bewohnt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca120ef1-0967-3590-9fda-e05ccca57460",
                                        "entry_id": "c781a24b-ce9f-35f8-8d47-9b8a36aab49e",
                                        "glosses": [
                                            "Tochter der Cousine oder des Cousins"
                                        ],
                                        "tags": [
                                            "Nichte 2. Grades oder höher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b098e6c0-bb3f-43ca-a77f-d1c1b9624f4f",
                                                "sense_id": "ca120ef1-0967-3590-9fda-e05ccca57460",
                                                "text": "„Seine Nichte tat, was er ihr sagte.“"
                                            },
                                            {
                                                "example_id": "99b73883-2df8-4988-81c1-6ec7ceb8ea91",
                                                "sense_id": "ca120ef1-0967-3590-9fda-e05ccca57460",
                                                "text": "„Es ist die Tante, die über den Suchdienst ihre Nichte und ihren Neffen gefunden hat.“"
                                            },
                                            {
                                                "example_id": "c2e60717-948c-4604-9d81-33431be05d91",
                                                "sense_id": "ca120ef1-0967-3590-9fda-e05ccca57460",
                                                "text": "„Meine älteste Nichte war schon fünfzehn Jahre alt und tat zugleich nah verwandt und unnahbar.“"
                                            },
                                            {
                                                "example_id": "19eb9c41-796b-4c32-b847-eab2750a7c42",
