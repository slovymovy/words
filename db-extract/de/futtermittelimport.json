                ],
                "senses": [
                    {
                        "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                        "entry_id": "72cb2b7e-f82f-3a8b-a8e2-f18f2b4daf2f",
                        "glosses": [
                            "Einfuhr von Futter für Nutztiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c29af34-32f7-4292-bae0-b3779b4c9052",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Das deutsche Umweltministerium will für den Klimaschutz auch Futtermittelimporte, etwa von Soja, verringern.“"
                            },
                            {
                                "example_id": "cb90edff-08bc-47ac-8391-a45be951a0c8",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "[Rapspresskuchen:] „Kommt Presskuchen als Tierfutter zum Einsatz, können damit wegen des hohen Proteingehalts Futtermittelimporte, z. B. von Sojaextraktionsschrot, substituiert werden.“"
                            },
                            {
                                "example_id": "bb9d710e-7ec2-4712-9c5d-000581988116",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Die bundesdeutschen Agrarfabriken ballen sich in Süd-Niedersachsen, unweit der großen Häfen für Futtermittelimporte an der Weser.“"
                            },
                            {
                                "example_id": "8ee7915d-0b47-4a9c-9cf2-6666ebe61951",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„In Deutschland dienen etwa 60 Prozent der Agrarflächen der Tierhaltung, darüber hinaus werden große Flächen im globalen Süden für den Futtermittelimport nach Deutschland in Anspruch genommen.“"
                            },
                            {
                                "example_id": "5f3f1958-4afb-4e78-b064-1e00505edf69",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Infolge resultierte eine Verdoppelung der Futtermittelimporte zwischen 1962 und Mitte der 1970er Jahre.“"
                            },
                            {
                                "example_id": "485d080a-1886-4ffb-8949-c3c7a3a19ae8",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Im Schweizer Fleisch steckt immer weniger Schweiz. Was kaum jemand weiss: Die Futtermittelimporte haben sich in den letzten Jahren verdoppelt.“"
                            },
                            {
                                "example_id": "e38d9575-93a3-42be-b566-9a6378605165",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Knapp die Hälfte der Futtermittelimporte der Bundesrepublik kommt aus Ländern der Dritten Welt, in denen ein Teil der Bevölkerung unterernährt ist: Soja aus Brasilien, Maniok aus Südostasien, Erdnüsse aus dem Sahel.“"
                            },
                            {
                                "example_id": "b6e08e7b-1b11-4c7f-a751-92787a869ac8",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„»Wir wissen ja, dass man beim Fleischkonsum sieben oder acht Mal mehr Nahrung braucht, um dann hinterher ein Stück Fleisch produziert zu haben. Das benötigt Ressourcen, zum Beispiel Futtermittelimporte.«“"
                            },
                            {
                                "example_id": "3dbad4b7-baa2-459b-b9bb-52b63b828f7a",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Daneben ist eine spezifische Reduktion der Futtermittelimporte anzustreben; wozu eine flächengebundene Tierhaltung und die Fütterung von Wiederkäuern mit Grünlandaufwuchs sowie der verstärkte Anbau von Eiweißpflanzen in Deutschland (Flessa et al., 2012) beitragen können.“"
                            },
                            {
                                "example_id": "d704417c-22bb-478b-900e-055a72fda94b",
                                "sense_id": "5cd0b282-a858-3023-8dc6-7d56e0ef3562",
                                "text": "„Der Anteil von Maniok in der Mischfutterzusammensetzung der EU-27 betrug 2007 lediglich 0,5 %. Anfang der 1990er Jahre betrug der Anteil noch 6 %. Von den gesamten Futtermittelimporten machte Maniok 2007 gerade noch 0,2 % aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
