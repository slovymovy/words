                ],
                "senses": [
                    {
                        "sense_id": "aad276d8-55b1-352d-897e-f4e7b08f9b90",
                        "entry_id": "14fc28d0-9514-32cc-9627-3888e06398bb",
                        "glosses": [
                            "Arbitrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c07a4f-9895-4f92-957e-6ede5e7361d9",
                                "sense_id": "aad276d8-55b1-352d-897e-f4e7b08f9b90",
                                "text": "L’intuition a surtout accordé à l’homme la possibilité de croire, de vénérer et d’auto-arbitrer en son âme et conscience tous les actes de son existence."
                            }
                        ]
                    },
                    {
                        "sense_id": "b064de01-99ad-3b32-8ab7-5c64ea33a7e5",
                        "entry_id": "14fc28d0-9514-32cc-9627-3888e06398bb",
                        "glosses": [
                            "S’arbitrer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2389ba5a-4e00-4f29-bb3b-dd5543267335",
                                "sense_id": "b064de01-99ad-3b32-8ab7-5c64ea33a7e5",
                                "text": "C'est le cas où certains (toujours à tort) décident de s'auto-arbitrer : après tout, ces situations sont si fréquentes qu'on connaît la sanction."
                            },
                            {
                                "example_id": "f3b8f806-acf0-4266-922c-af7cd9d06313",
                                "sense_id": "b064de01-99ad-3b32-8ab7-5c64ea33a7e5",
                                "text": "S'auto-arbitrer, reconnaître ses erreurs pour jouer avec fair-play."
                            }
                        ]
                    }
                ],
