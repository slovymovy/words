        "fr-extract.jsonl": [
            {
                "entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                "word": "dénomination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "641e2214-ca19-4d0b-afb4-b05001972718",
                        "entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "tags": [
                            "plural"
                        ],
                        "form": "dénominations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "708c6620-0167-338c-815d-5c6c6bc55e80",
                        "entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "glosses": [
                            "Désignation d’une personne ou d’une chose par un nom qui en exprime l’état, l’espèce, les qualités essentielles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dddbc303-8ee4-42be-99bd-f0cc43c3650c",
                                "sense_id": "708c6620-0167-338c-815d-5c6c6bc55e80",
                                "text": "Dans les arts et dans les sciences, il ne faut rien changer sans nécessité aux dénominations reçues."
                            },
                            {
                                "example_id": "1ab799bb-11c4-4b5a-9073-4814796bb6b1",
                                "sense_id": "708c6620-0167-338c-815d-5c6c6bc55e80",
                                "text": "Les dénominations du projet du Magasin général sont aussi provisoires : elles ne traduisent pas, pour l’instant, de choix définitif effectué quant au devenir du site à reconvertir."
                            }
                        ]
                    },
                    {
                        "sense_id": "54c72403-0cab-3145-aaf9-5bcef1ea89bf",
                        "entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "glosses": [
                            "Mouvement, branche ou sous-groupe à l'intérieur d’une religion qui opère sous un nom, une tradition, et une identité."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "f5f723f7-302d-4b2b-b70b-cb445ba35641",
                                "sense_id": "54c72403-0cab-3145-aaf9-5bcef1ea89bf",
                                "text": "L’Église protestante d’Algérie est une dénomination chrétienne algérienne fondée en 1972 par l’union de plusieurs petites églises réformées déjà présentes dans le pays."
                            },
                            {
                                "example_id": "9907ab3f-0c61-4a7b-8c07-29e2edb7340b",
                                "sense_id": "54c72403-0cab-3145-aaf9-5bcef1ea89bf",
                                "text": "Qui ne s’est pas interrogé devant les milliers de dénominations protestantes différentes ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "db1059c8-508d-3bf2-b07c-40189238b2f5",
                        "entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "glosses": [
                            "Terme qui désigne formellement, qui identifie une entité donnée."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "de9c7160-965c-43ef-a9ec-7685bf7b8a40",
                                "sense_id": "db1059c8-508d-3bf2-b07c-40189238b2f5",
                                "text": "[…] retirer la dénomination “COMETIK” de l’intégralité des blogs dont il est l’auteur, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12ae0330-9452-446a-9551-adb9aca09197",
                        "source_entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "target_lang_word": "Bezeichnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bezeichnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Code aus Zeichen und Symbolen, der auf einen Gegenstand oder Begriff verweist"
                                        ],
                                        "tags": [
                                            "Semiotik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ceac54-fb57-44dc-90fd-ea3789e41f58",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Eine einheitliche Bezeichnung der Waren erleichtert die Suche."
                                            },
                                            {
                                                "example_id": "76805492-8a32-4b4b-9422-4c6491d7509c",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Die Europäische Artikelnummer (EAN) ist ein Strichcode, der auf jeder Ware sein sollte und so die eindeutige Bezeichnung des Artikels ermöglicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d652fd4d-78d2-44af-ad27-184e6ba9d266",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "In manchen Regionen Norddeutschlands verwendet man für „Samstag“ die Bezeichnung „Sonnabend“."
                                            },
                                            {
                                                "example_id": "2bdf1dd1-d885-47b7-b689-0ff00f9bf64e",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Nur die Richtung der Fragestellung - die Richtung vom Sachverhalt zur Sprache, vom zu Bezeichnenden zur Bezeichnung - verbindet unterschiedliche Vorgehensweisen.“"
                                            },
                                            {
                                                "example_id": "f2c20618-777d-4a98-b1ad-df5173558bdc",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Damit gehen Entdeckungen und Erfindungen einher, die genaue und immer differenziertere Bezeichnungen (Nominationen) verlangen.“"
                                            },
                                            {
                                                "example_id": "2fce1ef0-867d-46ac-8d48-d236c257b47f",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Wenn wir überdies auch für die frühen Zeiträume das Wort »Computer« benutzen, dann ist dieses als unsere Bezeichnung für das Gerät beziehungsweise die Technologie der jeweiligen Entwicklungsstufe zu verstehen und keineswegs als Zitat aus den damaligen (oft anderslautenden) Sprachgebräuchen.“"
                                            },
                                            {
                                                "example_id": "6de29c6a-4766-41ce-83c6-a44439a8d5ec",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Erst später gingen über das Warenangebot der Geschäfte die überregionalen Bezeichnungen allmählich in den Sprachgebrauch der Käufer aller Schichten und Sprachlandschaften über.“"
                                            },
                                            {
                                                "example_id": "1a4440b0-10b9-40c9-983e-3ac159d34e02",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e04507a6-0ef8-44c1-8b83-c7a90440af52",
                        "source_entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "target_lang_word": "Namensgebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namensgebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                        "entry_id": "805fb8bf-2306-384e-8a94-c6eeaa89c639",
                                        "glosses": [
                                            "die Handlung, etwas zu benennen (einen „Namen zu geben“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d22edf3-1ffb-4d38-ab57-5bfb13ddad28",
                                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                                "text": "Die Namensgebung war von einem Science-Fiction-Roman beeinflusst."
                                            },
                                            {
                                                "example_id": "745d7b71-b88f-4cfa-b23f-80dc2b11cd1e",
                                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                                "text": "„Aus dem Bootsinneren sollte dazu mit Stulpenhandschuhen und Greifarmen ein rund 50 Kilogramm schwerer Explosivkörper, der »Brand«, an den feindlichen Objekten befestigt werden, was die außergewöhnliche Namensgebung des ältesten erhaltenen Ubootes der Welt erklärt.“"
                                            },
                                            {
                                                "example_id": "780966bf-bd1e-41cf-aae3-59824c5e7bfa",
                                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                                "text": "„Auf Nólsoy hatte der Prinz hingegen mehr Glück, was die Namensgebung anging.“"
                                            },
                                            {
                                                "example_id": "0a0a65e4-ec65-4303-949d-d8260d4579c5",
                                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                                "text": "„Diese Systematik der Namensgebung sorgt natürlich für Unordnung.“"
                                            },
                                            {
                                                "example_id": "1d88699e-a84e-4902-8471-20f9544b33f9",
                                                "sense_id": "625f4a77-4a99-31a2-a0ac-e2e775655a65",
                                                "text": "„Den Wegen so beschriebener Ungereimtheiten nachzugehen und die eigentliche, ehedem wohl vorhandene Sinnhaftigkeit der Namensgebung aufzuspüren, ist wiederum Aufgabe der Etymologie, auch wenn diese nicht in allen Fällen eine befriedigende Lösung bereitstellen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "824ca33d-ea57-44b7-a3bb-12f3358ad31a",
                        "source_entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "target_lang_word": "designation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "designation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a42491c1-9577-3b71-8d17-8bd2650589c3",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "An act or instance of designating"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "Selection and appointment for a purpose or office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80ed8da-5891-4f1e-ac1f-cb95d950a6ae",
                                                "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                                "text": "His designation as chief justice was controversial."
                                            },
                                            {
                                                "example_id": "2c69be43-5f6c-456b-81a2-09898ce79d2e",
                                                "sense_id": "0d180cf3-894a-347a-9bbc-2fd7c2f4bdfa",
                                                "text": "July 2021, Omar Marrero, quoted in CyberNewshttps://web.archive.org/web/20210805184306/https://www.puertoricoheadlinenews.com/15-million-allocated-for-non-profit-organizations/\nThe designation of funds by Governor Pedro Pierluisi will also allow non-profit entities to continue providing services to communities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "That which designates; a distinguishing mark or name; distinctive title; appellation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3dab41f-fc8e-4f35-ac41-6c386c12172d",
                                                "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                                "text": "The Romans evolved a quite different system of nomenclature, which in its classical form consisted of three names, the praenomen (e.g. Marcus), nomen (e.g. Tullius), and cognomen (e.g. Cicero), and two other designations (the name of the father and of the tribe): […]"
                                            },
                                            {
                                                "example_id": "6be38fd1-3310-45c7-9426-b72428c6e518",
                                                "sense_id": "afe74c34-2e18-37be-ae61-fb7e7ce34eb3",
                                                "text": "Man is the most aggressive animal in the sea (and on the land as well), and all the \"man-eater\" stories in history will not change this designation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4b10a1-a779-3e29-844c-b61bd0b69a6c",
                                        "entry_id": "a4c99a35-6268-3e97-83ca-a824c60c314b",
                                        "glosses": [
                                            "Signification, meaning, for example of a word or phrase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd78055-476b-4340-a367-c533f75b4c37",
                                                "sense_id": "1b4b10a1-a779-3e29-844c-b61bd0b69a6c",
                                                "text": "It doesn't list all the connotations that the term may have in various contexts: it specifies the designation of the term, or one of the designations of the term."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5812aa0-9fb8-45c2-93db-3cc7416a7f45",
                        "source_entry_id": "73c7d63f-b1c7-3e1e-a931-bba9896b1eef",
                        "target_lang_word": "denomination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denomination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ff37bc-12ba-3dfb-a2b0-2579d3fbf5a0",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "The act of naming or designating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a735f6c5-6f20-3b85-971d-d4bb6e16e317",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "That by which anything is denominated or styled; an epithet; a name, designation, or title; especially, a general name indicating a class of like individuals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fd8557a-0506-4c7a-bfbf-35bc0ed1b1b2",
                                                "sense_id": "a735f6c5-6f20-3b85-971d-d4bb6e16e317",
                                                "text": "\"Will you allow me to present Sir George Evelyn to you?—the most accomplished coquet that ever 'Dealt destruction round the land On all he judged a foe;' under which denomination he ranks all women.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "A class, or society of individuals, called by the same name; a subdivision of a religion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7234a082-4e70-4b2e-9b18-4f5e4d51a1ba",
                                                "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                                "text": "She follows the Ahmadiyya denomination of Islam."
                                            },
                                            {
                                                "example_id": "6bd80225-f014-49b0-a9aa-195a99481fa4",
                                                "sense_id": "dcb12125-9736-3e70-ae85-9bd7cffc4da4",
                                                "text": "Denomination does more than create space in which to discern, however. It also provides a means for living out differing forms of a faithful Christian life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                        "entry_id": "f5566d40-7c3a-3bc7-bc76-7afbc3ab6b46",
                                        "glosses": [
                                            "A unit in a series of units of weight, money, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ca7a10-9489-4cd2-92a6-477b049ee8f8",
                                                "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                                "text": "What denomination is that money? They are all 50 euro notes."
                                            },
                                            {
                                                "example_id": "cca60b63-bfb2-4bcd-be45-a220e59d0a32",
                                                "sense_id": "bfaf9ded-6069-38fe-987e-a57fe55082c9",
                                                "text": "In 1823, a further issue of treasury notes was ordered to the amount of $100,000, in denominations of five to seventy-five cents, receivable for dues to the State."
                                            }
