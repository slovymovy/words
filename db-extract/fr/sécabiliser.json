                "senses": [
                    {
                        "sense_id": "e5b77b75-193a-3aaf-af4a-05c64ef2e721",
                        "entry_id": "f749c04e-cd91-3d85-abb4-453a9d3610b3",
                        "glosses": [
                            "Couper quelque chose, en particulier en utilisant son caractère sécable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6ab5d4-9d90-4fb9-91ab-178f0ac93dad",
                                "sense_id": "e5b77b75-193a-3aaf-af4a-05c64ef2e721",
                                "text": "Les comprimés matriciels : on peut les sécabiliser."
                            },
                            {
                                "example_id": "53e0f18b-fef0-48f4-b790-1427a9804e41",
                                "sense_id": "e5b77b75-193a-3aaf-af4a-05c64ef2e721",
                                "text": "On a passé toute notre petite enfance ensemble, et pour nous distinguer, nos parents ont décidé de sécabiliser notre prénom."
                            },
                            {
                                "example_id": "877fc490-0081-4de8-9c27-c7fe97ae6e32",
                                "sense_id": "e5b77b75-193a-3aaf-af4a-05c64ef2e721",
                                "text": "Notre objectif : un max d'agents en congés en juillet-aout, une juste compensation pour celles et ceux qui devront se « sécabiliser » cet été."
                            }
                        ]
                    }
