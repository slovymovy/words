                "senses": [
                    {
                        "sense_id": "8edf5ad4-0297-33b4-b8e3-81575c1c5aad",
                        "entry_id": "3bc973c8-e826-3523-a174-1356a906ecfd",
                        "glosses": [
                            "jemand, der eine unglücksverheißende Botschaft überbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df51b32c-378a-44d1-8e65-1bf8d6d5e98e",
                                "sense_id": "8edf5ad4-0297-33b4-b8e3-81575c1c5aad",
                                "text": "„Er trieb den Unglücksboten von sich und entschlief wieder.“"
                            },
                            {
                                "example_id": "5e9838d7-76d5-4bf2-b737-597c46898497",
                                "sense_id": "8edf5ad4-0297-33b4-b8e3-81575c1c5aad",
                                "text": "„Roth war ein empfindsamer Mensch und nahm es sich sehr zu Herzen, daß er damals so oft zum Unglücksboten werden mußte.“"
                            },
                            {
                                "example_id": "42d5f9c6-ddbe-4d0e-9ab3-2a0e6cf4de28",
                                "sense_id": "8edf5ad4-0297-33b4-b8e3-81575c1c5aad",
                                "text": "„Ich habe mir einige Umstände gemacht, um Ihr Eigentum wiederzubeschaffen, deshalb wäre es mir recht, wenn ich hier nicht als so etwas wie ein Unglücksbote behandelt würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
