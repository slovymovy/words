                        "glosses": [
                            "Produit qui détruit les œufs des parasites."
                        ],
                        "tags": [],
                        "note": "Se dit surtout en parlant des insecticides ou des acaricides",
                        "examples": [
                            {
                                "example_id": "ea822ef6-4ca8-4cfc-9a08-1ebeb0517a48",
                                "sense_id": "e82796dc-acd3-367d-8db1-78b2765a3da2",
                                "text": "Les substances moins rémanentes telles que les Pyréthrines et l’Alléthrine peuvent être additionnées d’un ovicide comme le dinitro - 2,4 - anisole , à raison de 2 %."
                            }
                        ]
