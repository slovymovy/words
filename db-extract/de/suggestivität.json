                "senses": [
                    {
                        "sense_id": "15a8f341-377a-31e6-a9f3-c3fce1cbcf8f",
                        "entry_id": "41ccc570-b4e0-3b51-87e6-bf5880e087cf",
                        "glosses": [
                            "Eigenschaft, beeinflussendes (suggestives) Verhalten zeigen zu können; das Potential besitzen, suggerieren zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a138d082-63dc-499a-ad6c-b0e6371d649d",
                                "sense_id": "15a8f341-377a-31e6-a9f3-c3fce1cbcf8f",
                                "text": "„Unter Suggestivität versteht man die Ausstrahlung, die Eigenschaften des Suggestors, die für das Suggestionsgeschehen maßgeblich sind. Suggestivität besitzt nur derjenige, welcher Persönlichkeit, Autorität und Sicherheit ausstrahlt!“"
                            },
                            {
                                "example_id": "d67d9bc2-8ae0-4096-b56c-3001111d66df",
                                "sense_id": "15a8f341-377a-31e6-a9f3-c3fce1cbcf8f",
                                "text": "„Beziehungen zwischen der Wahrscheinlichkeit des suggerierten Inhaltes und der Suggestivität der Frage waren nur in geringem Grade nachweislich (doch ist an die Bedeutung der Formulierung der Fragen hier nachdrücklich zu erinnern), deutlicher trat die Abhängigkeit der Suggestivität einer Frage von der Treue und Lebhaftigkeit des Erinnerungsbildes, auf das sie sich bezieht, hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
