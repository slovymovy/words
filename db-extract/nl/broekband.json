                                        "sense_id": "e13e8526-e083-3851-a0c2-13523ffd04e1",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A band worn around the waist to hold clothing to one's body (usually pants), hold weapons (such as a gun or sword), or serve as a decorative piece of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa05adc-b620-4c63-9dd9-240b1431af38",
                                                "sense_id": "e13e8526-e083-3851-a0c2-13523ffd04e1",
                                                "text": "As part of the act, the fat clown's belt broke, causing his pants to fall down."
                                            },
                                            {
                                                "example_id": "de1a0db8-37c0-4dfd-97a5-96388da5dc83",
                                                "sense_id": "e13e8526-e083-3851-a0c2-13523ffd04e1",
                                                "text": "Master leathercrafter does handcrafted wallets, belts, purses, handbags etc., supporting self and helpers. Good enough to carve fantst art and portraits into leather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0507463-3474-3c57-8b61-f3e2ea6a930d",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A band used as a restraint for safety purposes, such as a seat belt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0728b333-db37-40f7-950f-8e96312a91af",
                                                "sense_id": "f0507463-3474-3c57-8b61-f3e2ea6a930d",
                                                "text": "Keep your belt fastened; this is going to be quite a bumpy ride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912e21b2-9d09-3ebd-ada2-2beb45ca06e7",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A band that is used in a machine to help transfer motion or power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54e54a9-a7a1-49ea-8057-0d964bec787c",
                                                "sense_id": "912e21b2-9d09-3ebd-ada2-2beb45ca06e7",
                                                "text": "The motor had a single belt that snaked its way back and forth around a variety of wheels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74810f4c-ad52-3429-8499-067ab7ece248",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "Anything that resembles a belt, or that encircles or crosses like a belt; a strip or stripe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90ec3c7-f9ef-490d-9c87-d5d615a16ac0",
                                                "sense_id": "74810f4c-ad52-3429-8499-067ab7ece248",
                                                "text": "a belt of trees; a belt of sand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875acb6f-4408-3ac3-a58a-a39cb00552ed",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A trophy in the shape of a belt, generally awarded for martial arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf61343f-6dfc-4cdf-b8a7-596c8360e18d",
                                                "sense_id": "875acb6f-4408-3ac3-a58a-a39cb00552ed",
                                                "text": "the heavyweight belt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c09b8e-4d81-3819-a6e6-52bdc12781f7",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A collection of small bodies (such as asteroids) which orbit a star."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c291892-27c1-36c7-a145-9922e6bbfca2",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "One of certain girdles or zones on the surface of the planets Jupiter and Saturn, supposed to be of the nature of clouds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "807024bf-011e-397f-8254-e879c426c109",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A band of armor along the sides of a warship, protecting the ship's vital spaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa8fc89-ddf8-4749-90e5-a3e3826263c1",
                                                "sense_id": "807024bf-011e-397f-8254-e879c426c109",
                                                "text": "The battleship was protected by a twelve-inch belt just above the waterline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "342fdf1e-0f3b-3cc4-977a-340d27cda3e9",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A powerful blow, often made with a fist or heavy object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71394881-3445-44a4-9516-bb0e3ffbd847",
                                                "sense_id": "342fdf1e-0f3b-3cc4-977a-340d27cda3e9",
                                                "text": "After the bouncer gave him a solid belt to the gut, Simon had suddenly had enough of bar fights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5132eb-0dcc-3abf-b2b1-32ad60134be7",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A quick drink of liquor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96677ff5-b6c9-4870-983f-8b002c1b8413",
                                                "sense_id": "1e5132eb-0dcc-3abf-b2b1-32ad60134be7",
                                                "text": "Care to join me in a belt of scotch?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aa9422b-b99f-33a7-b8bb-3c2cd3e9ba05",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A geographical region known for a particular product, feature or demographic (Corn Belt, Bible Belt, Black Belt, Green Belt)."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f611e78f-b29d-33a0-a2a3-e06f8a638fed",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "The part of the strike zone at the height of the batter's waist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8673ec70-5c5c-4612-bb3d-2dd09d231553",
                                                "sense_id": "f611e78f-b29d-33a0-a2a3-e06f8a638fed",
                                                "text": "That umpire called that pitch a strike at the belt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d71650-162a-3e37-9ae2-18b657d368ff",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A device that holds and feeds cartridges into a belt-fed weapon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56b7f63d-6be5-3733-a1b8-4078b5ecbca3",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A vocal tone produced by singing with chest voice above the break (or passaggio), in a range typically sung in head voice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9629d824-1854-406d-802d-cc3b8926d5e4",
                                                "sense_id": "56b7f63d-6be5-3733-a1b8-4078b5ecbca3",
                                                "text": "Both auditionees had great ranges but Diamond had the strong belt we really need for the finale."
                                            },
                                            {
                                                "example_id": "7423566d-8d4c-4acc-8d86-a69ab54316b0",
                                                "sense_id": "56b7f63d-6be5-3733-a1b8-4078b5ecbca3",
                                                "text": "As previously mentioned, there was unexpected behavior in laryngeal lowering for belt in several singers and unchanged laryngeal height for two, as well as stable opening or widening of the pharyngeal walls, which must be investigated further."
                                            },
                                            {
                                                "example_id": "b8e82032-ef72-45b4-b229-a7301818ede2",
                                                "sense_id": "56b7f63d-6be5-3733-a1b8-4078b5ecbca3",
                                                "text": "In Clara's furious rant in Act II, Allsun broke out of her soprano into a belt, which made perfect sense in the moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fdd0625-81ee-3386-bbe5-723cb14a31a2",
                                        "entry_id": "b576ad1d-0564-3569-a943-2c7f3913d966",
                                        "glosses": [
                                            "A mostly-continuous, often curvilinear structure expressed on the surface or in the subsurface of a terrestrial planet or other solid planemo, such as a mountain belt, a fold and thrust belt, or an ore belt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c1fd01-6354-4f23-a46e-064c1cda4df9",
                                                "sense_id": "2fdd0625-81ee-3386-bbe5-723cb14a31a2",
                                                "text": "This belt of deformed platform sediments parallels the suture running east-to-west across the north of the region, which was left when the ocean basin that originally separated the two ancient continents on either side of it was consumed by subduction."
                                            },
                                            {
                                                "example_id": "887ec6aa-67cd-4695-827f-6ce916e16ab6",
                                                "sense_id": "2fdd0625-81ee-3386-bbe5-723cb14a31a2",
                                                "text": "Most foreland fold and thrust belts are linear or arcuate belts of folds and thrust faults that form a marginal part of an orogenic belt between an undeformed craton and a more intensely deformed inner zone."
                                            }
                                        ]
                                    }
                                ]
                            },
