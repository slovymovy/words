                "senses": [
                    {
                        "sense_id": "ff859ffe-19ce-38da-bb72-c4fb208d4f66",
                        "entry_id": "dd10bbb9-e7b6-3090-b4c9-976702e28505",
                        "glosses": [
                            "meistens dem heiligen Georg ^(→ WP) geweihtes Gotteshaus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ced30b-4475-457a-822e-8b9161127ac1",
                                "sense_id": "ff859ffe-19ce-38da-bb72-c4fb208d4f66",
                                "text": "„Sowohl während des Dreißigjährigen Krieges wie in der Schlacht bei Friedlingen im Jahr 1702 erlitt die Georgskirche schwere Beschädigungen.“"
                            },
                            {
                                "example_id": "95352f9b-ae36-4528-b688-291475c924e6",
                                "sense_id": "ff859ffe-19ce-38da-bb72-c4fb208d4f66",
                                "text": "„Ein Bild der Georgskirche mit offener Türe.“"
                            },
                            {
                                "example_id": "1684e017-92ed-47b9-ac83-8a973e7ba3c7",
                                "sense_id": "ff859ffe-19ce-38da-bb72-c4fb208d4f66",
                                "text": "„Die Georgskirche in Reichenau-Oberzell ist dem Heiligen Georg gewidmet. Sie ist eine der ältesten Georgskirchen in Mitteleuropa und soll seine Reliquien beherbergen.“"
                            },
                            {
                                "example_id": "2b142e4b-0045-4195-805c-1dff27566c9f",
                                "sense_id": "ff859ffe-19ce-38da-bb72-c4fb208d4f66",
                                "text": "„Die Georgskirchen gehen meist in sehr frühe Zeiten zurück; manche stehen wohl auf Plätzen, wo heidnische Kultstätten lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
