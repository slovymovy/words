                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c9cab8b2-34d7-321d-b3dd-196c9f24ef91",
                        "entry_id": "7ae28f40-5091-361d-8fec-4c96c5d6ad7f",
                        "glosses": [
                            "ładna dziewczyna"
                        ],
                        "tags": [
                            "metaphoric",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5021fb03-0913-403d-a504-2bac55e9cea0",
                                "sense_id": "c9cab8b2-34d7-321d-b3dd-196c9f24ef91",
                                "text": "Chłopaki, ale lala wczoraj szła osiedlem!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "39138a21-d3e0-3e97-bd66-db1218dc1509",
                        "entry_id": "7ae28f40-5091-361d-8fec-4c96c5d6ad7f",
                        "glosses": [
                            "ładna, wystrojona kobieta, lecz ograniczona i próżna"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "8784389a-2324-4106-911d-7c0a2a44fb6b",
                                "sense_id": "39138a21-d3e0-3e97-bd66-db1218dc1509",
                                "text": "Wziął sobie taką lalę za dziewczynę i teraz go to sporo kosztuje."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
