                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4d7b1a06-4aef-3abe-a946-ffd79275e7cc",
                        "entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "glosses": [
                            "Liveliness, or active mind and spirit."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e87f5406-6818-41a0-83fd-0424798cfcc5",
                        "source_entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "source_sense_description": "spirit, enthusiasm",
                        "target_lang_word": "Esprit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esprit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                        "entry_id": "7e5414b5-add0-3318-a286-090735ae9404",
                                        "glosses": [
                                            "gewitzter Geist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7643c9c6-e1f0-4cf0-a1be-074dffb2c5a2",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Aber sein Strahlen, seine Finessen und der ganze übrige Schnickschnack – Manieren, Kleidung, Auftreten, der näselnde Akzent, der Esprit und die zerfleischende Waffe desselben: die Ironie – waren noch das Geringste.“"
                                            },
                                            {
                                                "example_id": "4990425c-98b6-4795-8fda-f559f40298bb",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Trotz allem Esprit der Franzosen ist und bleibt Paris immer die Stadt, wo sich Betrug lohnt.“"
                                            },
                                            {
                                                "example_id": "c0ed96ae-4172-4e91-9cdd-0e2967fee41f",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Wovon sich der Journalist Esprit und Verve verspricht, ist nichts anderes als literarische Montage, eine Technik, bei der Wirkliches in Fiktion eingebaut und damit selbst fiktional wird.“"
                                            },
                                            {
                                                "example_id": "6cdc92dc-ef71-45f9-a68e-ebfa7e5a3c1b",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Krankenhausszenen, die Vivian auf ihren nackten und verletzlichen Körper reduzieren, wechseln mit Rückblenden auf ihre Zeit als Studentin der englischen Literatur ab, als sie den Esprit von Dichtern des 17. Jahrhunderts entdeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bde15c6d-270e-4bb4-8910-0c46a440f318",
                        "source_entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "source_sense_description": "spirit, enthusiasm",
                        "target_lang_word": "дух",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дух",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2e465d-8f91-3af8-834d-bedad2217fdf",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "сознание, мышление, психические способности человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55863080-f72f-484c-8e38-3aa228e19667",
                                                "sense_id": "fe2e465d-8f91-3af8-834d-bedad2217fdf",
                                                "text": "Противопоставление духа материи породило в невежественном сознании изуверское понимание материи, как чего-то низшего, тогда как, на самом деле, материя и дух едины."
                                            },
                                            {
                                                "example_id": "3c1bbda5-afcd-4d8b-8ecf-6d2a9ebf4933",
                                                "sense_id": "fe2e465d-8f91-3af8-834d-bedad2217fdf",
                                                "text": "В заключение зададим вопрос: неужели же доблесть, мужество, талант, остроумие, воображение — все эти замечательные свойства человеческого духа обусловлены только кислородом?"
                                            },
                                            {
                                                "example_id": "bf377181-bf19-4f36-85cf-3bbb477ece50",
                                                "sense_id": "fe2e465d-8f91-3af8-834d-bedad2217fdf",
                                                "text": "Куплю себе кеды, спортивный костюм и буду развивать плоть. В здоровом теле — здоровый дух! А дух мне нужен здоровый. Как никогда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b413a7af-de4a-38f8-8cfb-705b26616f78",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "мышление, сознание как особое свойство высокоорганизованной материи"
                                        ],
                                        "tags": [
                                            "в материалистической философии и психологии"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a499d9dc-5192-404a-99a4-4a6af4405afa",
                                                "sense_id": "b413a7af-de4a-38f8-8cfb-705b26616f78",
                                                "text": "Это так называемая «пирамидная мистика», во что я до поры до времени не верил, так как был ортодоксальным материалистом: материя — первична, дух — вторичен."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc559edb-712f-3cb2-b6ac-c76668d02aaf",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            ": бессмертное нематериальное начало, лежащее в основе всех вещей и явлений, являющееся первичным по отношению к материи"
                                        ],
                                        "tags": [
                                            "в идеалистической философии и религии"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43523a6-be04-413f-bf5e-c4c6c0c679be",
                                                "sense_id": "cc559edb-712f-3cb2-b6ac-c76668d02aaf",
                                                "text": "«Это не есть просто отношение духа к абсолютному духу; здесь абсолютный дух сам относит себя к тому, что мы в отличие от него поставили с другой стороны; таким образом, точнее говоря, религия есть идея духа, который относится, сам, к себе, самосознание абсолютного духа»."
                                            },
                                            {
                                                "example_id": "651dd219-0eee-46f8-b9d9-6f7e9696bfe6",
                                                "sense_id": "cc559edb-712f-3cb2-b6ac-c76668d02aaf",
                                                "text": "«Идеальное, т. е. гегелевский абсолютный дух, есть с точки зрения материалиста Маркса не что иное, как переведённое и переработанное в человеческой голове материальное „начало“»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13cd439c-b04b-3e32-a189-8a5ec34a5978",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "внутреннее состояние, моральная сила человека, коллектива; душа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35330a03-2a67-4f81-a3ac-9a037be9659c",
                                                "sense_id": "13cd439c-b04b-3e32-a189-8a5ec34a5978",
                                                "text": "Люди сутками не спали и не ели, однако, несмотря на все лишения, руководимые железной рукой генерала Кутепова, полки сохраняли высокий боевой дух."
                                            },
                                            {
                                                "example_id": "d786009d-a0e9-47a8-beb8-50d5cc37f7dc",
                                                "sense_id": "13cd439c-b04b-3e32-a189-8a5ec34a5978",
                                                "text": "Смело, товарищи, в ногу! // Духом окрепнем в борьбе, // В царство свободы дорогу // Грудью проложим себе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b93e947-6da1-37c7-8d63-7878084907e4",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "смелость, решимость, мужество"
                                        ],
                                        "tags": [
                                            "обычно в устойчивых сочетаниях"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffb01ae4-8b90-4939-a477-9d1a465e579f",
                                                "sense_id": "1b93e947-6da1-37c7-8d63-7878084907e4",
                                                "text": "Сказав сие и раскланявшись со мною, пошёл он своим путём далее, а я, оставшись, в несколько минут не мог собраться с духом от удивительного сплетения всех сих обстоятельств, поразившего меня нечаянностию своею до чрезвычайности."
                                            },
                                            {
                                                "example_id": "e391cea9-644b-4bb5-b11f-c593647dd816",
                                                "sense_id": "1b93e947-6da1-37c7-8d63-7878084907e4",
                                                "text": "Но как у вас хватает духа говорить всё это про честного, порядочного человека, который не сделал вам никакого зла? ❬…❭ Виноват же Иванов только в том, что у него слабый, великодушный характер, что у него не хватает духа прогнать от себя Боркина…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d429cca-8e8c-35b0-b285-17cb252eea27",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "основное направление, характерные свойства, сущность, суть, смысловая основа чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84c83f2-4225-4913-ba67-ad9837a75a4d",
                                                "sense_id": "9d429cca-8e8c-35b0-b285-17cb252eea27",
                                                "text": "В тех же случаях, где законы римские казались несовместными с духом народа или с обстоятельствами времени, там они заменялись домашними примерами, обычаями и преданиями."
                                            },
                                            {
                                                "example_id": "8a528a2d-9854-4a65-a243-0edade19fad7",
                                                "sense_id": "9d429cca-8e8c-35b0-b285-17cb252eea27",
                                                "text": "Однако, по точному смыслу и духу закона и в таких случаях земля должна отводиться непременно в личную, а не общую или общинную собственность .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e1f8511-c9ab-37b0-98aa-c3b73473ab9c",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "; то, что, определяет поведение, образ мыслей и т. п."
                                        ],
                                        "tags": [
                                            "чего или с определением"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e486e8b-8bac-49b7-9432-6238a2ab3bec",
                                                "sense_id": "6e1f8511-c9ab-37b0-98aa-c3b73473ab9c",
                                                "text": "Дух времени и нравы прекрасно выражены в некоторых лицах."
                                            },
                                            {
                                                "example_id": "6bd5d48f-3b99-4442-a59e-b7f0eb1bbb48",
                                                "sense_id": "6e1f8511-c9ab-37b0-98aa-c3b73473ab9c",
                                                "text": "Тогда отчаяние пробудило воинственный дух в новогородцах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7896cb-2c31-3172-91c1-c9778ce62884",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "разг. : дыхание"
                                        ],
                                        "tags": [
                                            "обычно в устойчивых сочетаниях"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3373f8-478a-421b-9a75-542b4de6beb1",
                                                "sense_id": "df7896cb-2c31-3172-91c1-c9778ce62884",
                                                "text": "На волну взбираться туда-сюда, а как вниз полетишь — всё нутро замирает, дух захватывает."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74407c9f-9b8b-3f87-b6e8-a9d596d78484",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "разг. воздух"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33122ab-c391-443d-b5ff-cddbe7083c5e",
                                                "sense_id": "74407c9f-9b8b-3f87-b6e8-a9d596d78484",
                                                "text": ".. дышать настоящим лесным духом, который так приятно пахнет столетними пнями, вечным мхом и гниющими листьями .."
                                            },
                                            {
                                                "example_id": "e5b14dc2-eade-4d36-ab33-677631368b59",
                                                "sense_id": "74407c9f-9b8b-3f87-b6e8-a9d596d78484",
                                                "text": "Уж первый ветерок пахну́л горько-сладким тёплым лесным духом и пошевелил камыши…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae495b7-1508-31b8-982c-acc2abc31513",
                                        "entry_id": "96875358-7a28-37ce-aacf-45041eaee7bd",
                                        "glosses": [
                                            "разг. запах, аромат"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908083b2-9cbb-47ad-b843-daafdc26bcdd",
                                                "sense_id": "eae495b7-1508-31b8-982c-acc2abc31513",
                                                "text": "Пробирались лесными чащами, где стоял грибной дух .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дух",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "265ea079-6aa3-3935-a375-6149c9d3f39b",
                                        "entry_id": "35802a39-7937-3f40-ba80-69a5afd2f529",
                                        "glosses": [
                                            "мифол. бесплотное, сверхъестественное существо (доброе или злое), принимающее участие в жизни природы и человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbcf3dc2-c324-4af0-8c77-c9772ea734b7",
                                                "sense_id": "265ea079-6aa3-3935-a375-6149c9d3f39b",
                                                "text": ".. прошу ободриться и подумать, что добрый дух и неудачу поправить может."
                                            },
                                            {
                                                "example_id": "927daa0c-35ee-4dd9-85b0-9c2a75e9f90d",
                                                "sense_id": "265ea079-6aa3-3935-a375-6149c9d3f39b",
                                                "text": "К комплексу посвящения восходят следующие мотивы: увод или изгнание детей в лес или похищение их лесным духом .."
                                            },
                                            {
                                                "example_id": "353ccfe2-1a15-4e8f-9ce5-811251446a7a",
                                                "sense_id": "265ea079-6aa3-3935-a375-6149c9d3f39b",
                                                "text": "Злой дух, принявший личину редактора, проделал один из своих нехитрых фокусов — вынул из портфеля тут же электрическую лампочку."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дух",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7d056f-da0f-36ba-af5f-b7a5a905e338",
                                        "entry_id": "9fbcaa99-1b09-3872-a854-700cf2b29e96",
                                        "glosses": [
                                            "воен. жарг. военнослужащий срочной службы, прошедший курс молодого бойца и отслуживший не более половины срока; молодой, начинающий службу солдат"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80421e10-e68b-30b6-8778-d6f6714be38f",
                                        "entry_id": "9fbcaa99-1b09-3872-a854-700cf2b29e96",
                                        "glosses": [
                                            "сленг милиционер"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75c4d5ec-6cc5-3e51-b313-4dc2afd4f4b5",
                                        "entry_id": "9fbcaa99-1b09-3872-a854-700cf2b29e96",
                                        "glosses": [
                                            "сленг, неопытный, слабый человек"
                                        ],
                                        "tags": [
                                            "обычно пренебр."
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "дух",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1ec7d6-2e8c-3e4e-9b9b-7a634edc1aae",
                                        "entry_id": "59b6132c-d2b5-39d1-afb5-c07a788cb1fe",
                                        "glosses": [
                                            "истор., воен. жарг. то же, что душман; афганский повстанец; представитель враждебной войскам СССР вооружённой группировки в Афганистане"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9e0482b-af56-3dba-8e70-6719bae85c16",
                                        "entry_id": "59b6132c-d2b5-39d1-afb5-c07a788cb1fe",
                                        "glosses": [
                                            "воен. жарг. то же, что чех; представитель враждебной войскам России вооружённой группировки в вооружённом конфликте в Чечне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6907bd37-d050-4561-ba1b-5aab1e3a5dcb",
                                                "sense_id": "e9e0482b-af56-3dba-8e70-6719bae85c16",
                                                "text": "«Духи» подбили головной танк, ударили со всех сторон, поливая автоматным и пулемётным огнём, закидывая гранатами. ❬…❭ В это же самое время в таком же огненном мешке чеченцы методично расстреливали из укрытий обездвиженную Майкопскую бригаду."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b4b67a4-1e2d-417b-a669-4d129edcea96",
                        "source_entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "source_sense_description": "spirit, enthusiasm",
                        "target_lang_word": "энтузиа́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "энтузиа́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "178d14cc-abb1-3e4b-ac43-67a6018c4511",
                                        "entry_id": "0cb04545-a05d-3f88-8a7b-9e168eeac4c1",
                                        "glosses": [
                                            "высокая степень воодушевления, душевный подъём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187a6b27-189b-4fd5-b7e7-adb1e1609271",
                                                "sense_id": "178d14cc-abb1-3e4b-ac43-67a6018c4511",
                                                "text": "В зале царил неслыханный энтузиазм, девушки благодарили небо, пославшее им Марио Чинечетти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90e9a6d4-76e4-4d0a-8876-e4177378fda0",
                        "source_entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "source_sense_description": "liveliness, or active mind and spirit",
                        "target_lang_word": "Esprit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esprit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                        "entry_id": "7e5414b5-add0-3318-a286-090735ae9404",
                                        "glosses": [
                                            "gewitzter Geist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7643c9c6-e1f0-4cf0-a1be-074dffb2c5a2",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Aber sein Strahlen, seine Finessen und der ganze übrige Schnickschnack – Manieren, Kleidung, Auftreten, der näselnde Akzent, der Esprit und die zerfleischende Waffe desselben: die Ironie – waren noch das Geringste.“"
                                            },
                                            {
                                                "example_id": "4990425c-98b6-4795-8fda-f559f40298bb",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Trotz allem Esprit der Franzosen ist und bleibt Paris immer die Stadt, wo sich Betrug lohnt.“"
                                            },
                                            {
                                                "example_id": "c0ed96ae-4172-4e91-9cdd-0e2967fee41f",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Wovon sich der Journalist Esprit und Verve verspricht, ist nichts anderes als literarische Montage, eine Technik, bei der Wirkliches in Fiktion eingebaut und damit selbst fiktional wird.“"
                                            },
                                            {
                                                "example_id": "6cdc92dc-ef71-45f9-a68e-ebfa7e5a3c1b",
                                                "sense_id": "444fd1d1-e771-3c69-825e-42ab1c151c7c",
                                                "text": "„Krankenhausszenen, die Vivian auf ihren nackten und verletzlichen Körper reduzieren, wechseln mit Rückblenden auf ihre Zeit als Studentin der englischen Literatur ab, als sie den Esprit von Dichtern des 17. Jahrhunderts entdeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
