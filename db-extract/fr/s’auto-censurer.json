                        "sense_id": "440620b6-46bf-3b02-97a0-870327a97f71",
                        "entry_id": "ac7cca46-e08d-379d-9025-0335dfc0aa88",
                        "glosses": [
                            "Se censurer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df75acb-4430-402c-9dc4-e34a3ffeb6ef",
                                "sense_id": "440620b6-46bf-3b02-97a0-870327a97f71",
                                "text": "Et pour l’État, c’est mieux ainsi : on n’a pas besoin alors de punir l’auteur, il se charge lui-même de s’auto-censurer en allant peut-être même plus loin (on ne sait jamais !) que ne l’aurait fait son censeur."
                            },
                            {
                                "example_id": "2e6c36df-b88b-4cee-b5d9-4dbaf7316bc8",
                                "sense_id": "440620b6-46bf-3b02-97a0-870327a97f71",
                                "text": "S’auto-censurer c’est ici s’auto-amputer."
                            }
                        ]
                    }
