                ],
                "senses": [
                    {
                        "sense_id": "00c37465-4a6f-3e44-bd1e-34c502552a8a",
                        "entry_id": "6f1276cf-2d78-388f-a5f8-9fe3a0c8ae9d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным гонт; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ceaad57-8597-44d4-9b64-8d2bada51edf",
                                "sense_id": "00c37465-4a6f-3e44-bd1e-34c502552a8a",
                                "text": "Гонтовой Завод при Охте Реке, на котором делают гонт для покрытия кровель."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf8a0d8-c17c-337b-acc0-0aa57444ad77",
                        "entry_id": "6f1276cf-2d78-388f-a5f8-9fe3a0c8ae9d",
                        "glosses": [
                            "сделанный из гонта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785db311-ae85-42b1-9216-3c1238690871",
                                "sense_id": "3bf8a0d8-c17c-337b-acc0-0aa57444ad77",
                                "text": "И дом был такой же ― без глупых затей (какими стали чваниться в Москве со времен царя Алексея Михайловича) ― неказист, но рублен крепко, с гонтовой крышей, поросшей от старости мхом, с маленькими окошечками ― высоко от земли."
                            }
                        ]
                    }
                ],
