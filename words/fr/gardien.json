{
    "word_family": [
        "garde",
        "garder",
        "garderie",
        "gardiennage",
        "sauvegarder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                    "sense_definition": "Personne chargée de surveiller, de veiller sur un lieu, des biens, des animaux ou d'autres personnes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>gardien</w> de l'immeuble distribue le courrier tous les matins."
                        },
                        {
                            "text": "Les touristes ont demandé leur chemin au <w>gardien</w> du musée."
                        }
                    ],
                    "synonyms": [
                        "surveillant",
                        "vigile"
                    ],
                    "common_phrases": [
                        "gardien de nuit",
                        "gardien de la paix",
                        "gardien de prison"
                    ]
                },
                {
                    "sense_id": "bda6175c-03a2-31b1-9d45-a26ba4889e6f",
                    "sense_definition": "Joueur chargé d'empêcher le ballon d'entrer dans la cage de son équipe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>gardien</w> a arrêté le tir décisif à la dernière minute du match."
                        },
                        {
                            "text": "Notre équipe cherche un nouveau <w>gardien</w> pour la saison prochaine."
                        }
                    ],
                    "synonyms": [
                        "goal"
                    ],
                    "common_phrases": [
                        "gardien de but"
                    ]
                },
                {
                    "sense_id": "fe9d9cd4-72fe-3517-93a6-2562f64f2612",
                    "sense_definition": "Personne, groupe ou institution qui protège et fait respecter une valeur, un principe ou une tradition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette institution se considère comme la <w>gardienne</w> des valeurs démocratiques."
                        },
                        {
                            "text": "Le juge rappelle qu'il est le <w>gardien</w> de la liberté individuelle."
                        }
                    ],
                    "synonyms": [
                        "défenseur",
                        "garant",
                        "protecteur"
                    ],
                    "common_phrases": [
                        "gardien des traditions"
                    ]
                },
                {
                    "sense_id": "0ef3c91d-7f75-30ec-9219-0943528d04bc",
                    "sense_definition": "Personne désignée par l'autorité judiciaire pour veiller sur des biens saisis ou sous scellés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal l'a désigné comme <w>gardien</w> des meubles placés sous séquestre."
                        },
                        {
                            "text": "En tant que <w>gardien</w> judiciaire, il ne peut pas disposer des biens saisis."
                        }
                    ],
                    "synonyms": [
                        "séquestre"
                    ]
                },
                {
                    "sense_id": "4f61b5e1-f683-3076-ad45-76b98a3bbd50",
                    "sense_definition": "Supérieur de certains couvents dans les ordres mendiants, en particulier chez les franciscains.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le frère François a été nommé père <w>gardien</w> de cette communauté monastique."
                        },
                        {
                            "text": "Tous les religieux se sont réunis pour écouter les consignes du père <w>gardien</w>."
                        }
                    ],
                    "common_phrases": [
                        "père gardien"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0da6b16d-e9e6-3fa8-88ee-73499770acb7",
                    "sense_definition": "Qui assure la garde, qui protège ou veille avec bienveillance sur un être ou une chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque enfant croit avoir un ange <w>gardien</w> qui veille sur lui dans l'ombre."
                        },
                        {
                            "text": "Elle a posé sur ses frères une main douce et <w>gardienne</w> pour les rassurer."
                        }
                    ],
                    "synonyms": [
                        "protecteur"
                    ],
                    "common_phrases": [
                        "ange gardien"
                    ]
                }
            ]
        }
    ]
}