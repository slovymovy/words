                                        "glosses": [
                                            "iemand die deel uitmaakt van een bestuur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4b7617-5a80-42a6-8770-23422d39a025",
                                                "sense_id": "bc68f90c-2e00-32c3-a441-219daf3cba55",
                                                "text": "De voorzitter en de secretaris zijn de belangrijkste bestuursleden"
                                            },
                                            {
                                                "example_id": "3ae86394-fbb5-4db4-97df-2906dde3bd07",
                                                "sense_id": "bc68f90c-2e00-32c3-a441-219daf3cba55",
                                                "text": "ECB-bestuurslid Sabine Lautenschläger stapt per 31 oktober op als bestuurslid van de Europese Centrale Bank (ECB). Lautenschläger is een uitgesproken tegenstander van het opkoopbeleid van de ECB. Gezien de ECB onlangs een nieuw opkoopbeleid aankondigde, speculeren analisten dat haar vertrek hiermee te maken heeft."
                                            },
                                            {
                                                "example_id": "d42024b2-2bdd-4f36-a661-827263d43656",
                                                "sense_id": "bc68f90c-2e00-32c3-a441-219daf3cba55",
                                                "text": "Als hij nog steeds kwaad was op Eric, want dat was vast het geval, dan was het om redenen waarvan niet een van de andere bestuursleden van deze kapitalistische bijeenkomst zich zelfs in hun wildste fantasie iets bij voor had kunnen stellen."
                                            }
                                        ]
