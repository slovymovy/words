                                "sense_id": "ae8f2e8b-228b-3f83-944b-82e0ca782cd4",
                                "text": "No arboret with painted blossomes drest, / And smelling sweet, but there it might be found […]"
                            },
                            {
                                "example_id": "93382114-ab8f-4b84-ad55-063b5e846cc8",
                                "sense_id": "ae8f2e8b-228b-3f83-944b-82e0ca782cd4",
                                "text": "Then voluble and bold, now hid, now seen, Among thick-woven arborets and flowers."
                            },
                            {
                                "example_id": "7636a7d3-8437-45c7-8cce-bbd562245988",
                                "sense_id": "ae8f2e8b-228b-3f83-944b-82e0ca782cd4",
                                "text": "And arborets of jointed stone were there, And plants of fibres fine as silkworm's thread."
                            }
                        ]
