                ],
                "senses": [
                    {
                        "sense_id": "0aef212d-7118-31d4-bb78-5655aa38ad1d",
                        "entry_id": "64fb1d2f-3cb8-3137-b142-1407c98ee3cc",
                        "glosses": [
                            "gemütlicher Ausflug einer oder mehrerer Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20509776-6b34-4a06-9d0a-8cd37bbd8f46",
                                "sense_id": "0aef212d-7118-31d4-bb78-5655aa38ad1d",
                                "text": "Von [Fußball-Bundestrainer Joachim] Löw […] gibt es leider nur Bilder, wie er am Wochenende eine Kaffeefahrt in einem Cabriolet unternommen hat."
                            },
                            {
                                "example_id": "fdfad70c-1e2e-4fe4-8481-59c69568ad3b",
                                "sense_id": "0aef212d-7118-31d4-bb78-5655aa38ad1d",
                                "text": "„Es gibt einige Aktionäre, die nur kommen, um sich am Büfett zu bedienen. Für sie ist die Hauptversammlung eine Alternative zur Kaffeefahrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "321d154b-4a14-3621-bb39-e28be53fb4ec",
                        "entry_id": "64fb1d2f-3cb8-3137-b142-1407c98ee3cc",
                        "glosses": [
                            "organisierte Tagesfahrt mit einem Reisebus oder Schiff, bei der überteuerte Produkte angepriesen werden, damit die Teilnehmer diese kaufen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "af64f9a6-007e-449d-a1ab-d59ed1ddc688",
                                "sense_id": "321d154b-4a14-3621-bb39-e28be53fb4ec",
                                "text": "„Nach meiner Erfahrung sind 100 Prozent der Kaffeefahrten unseriös und 95 Prozent illegal“, so [Berndhard] Stitz."
                            },
                            {
                                "example_id": "8d2ee5c8-c1dd-43e2-900b-42f622e33221",
                                "sense_id": "321d154b-4a14-3621-bb39-e28be53fb4ec",
                                "text": "Kochtöpfe, Heizdecken, Vitaminpräparate: Oft werden auf Kaffeefahrten minderwertige Produkte zu überhöhten Preisen angeboten."
                            },
                            {
                                "example_id": "623188e5-fd5d-44c6-bcde-39117f0d1b76",
                                "sense_id": "321d154b-4a14-3621-bb39-e28be53fb4ec",
                                "text": "Ältere Menschen sind besonders anfällig für unseriöse Angebote auf sogenannten Kaffeefahrten."
                            },
                            {
                                "example_id": "f68131f0-87a5-4972-8ecf-6a38d0a27a13",
                                "sense_id": "321d154b-4a14-3621-bb39-e28be53fb4ec",
                                "text": "Jedes Jahr nehmen schätzungsweise fünf Millionen Deutsche an Kaffeefahrten teil. Günstige Busfahrten, bei denen arglosen Kunden billige Produkte für viel Geld angedreht werden. Wer den Versprechungen glaubt, hat schon verloren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a4dfb753-af4d-340d-b907-5f5b581cfd38",
                        "entry_id": "64fb1d2f-3cb8-3137-b142-1407c98ee3cc",
                        "glosses": [
                            "nicht leicht, nicht einfach"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c1072e31-2d89-4731-ac83-f65ccfe2db9e",
                                "sense_id": "a4dfb753-af4d-340d-b907-5f5b581cfd38",
                                "text": "Nach und nach fahren die Starter über die Rampe und machen sich auf den Weg. Und schnell wird klar, dass das keine gemütliche Kaffeefahrt ist, sondern dass die Zeit knapp berechnet ist."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
