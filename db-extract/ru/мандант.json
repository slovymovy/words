                "senses": [
                    {
                        "sense_id": "980146a7-0f71-3e5e-8c9f-e5850ee26f82",
                        "entry_id": "805f717e-207c-34d8-84a4-b3ae1be703dd",
                        "glosses": [
                            "юр. лицо, дающее кому-либо поручение, приказание, мандат на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebc691d-0715-4722-8a84-5f1ca22ac1dd",
                                "sense_id": "980146a7-0f71-3e5e-8c9f-e5850ee26f82",
                                "text": "Мандант обязан был возместить мандатарию издержки, понесенные при исполнении поручения, даже независимо от результата, достигнутого путём произведённых расходов, лишь бы мандатарий действовал добросовестно и разумно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bb21181-46e8-4c7e-95f4-dad7a46d5459",
                        "source_entry_id": "805f717e-207c-34d8-84a4-b3ae1be703dd",
                        "source_sense_id": "980146a7-0f71-3e5e-8c9f-e5850ee26f82",
                        "target_lang_word": "Auftraggeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auftraggeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                        "entry_id": "649105dc-9511-3462-9a48-bee35e6a2be4",
                                        "glosses": [
                                            "Person, Firma oder auch Institution, die einen Auftrag erteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7a934f-490f-4210-9b1d-1dc6f1731a9f",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Deshalb haben die vier Fahnder jetzt Klage gegen Gutachter H. eingereicht und auch seinem Auftraggeber, dem Land Hessen, den Streit erklärt.“"
                                            },
                                            {
                                                "example_id": "e917f320-89d2-4faf-8563-3294050049a7",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Nach mehrmaliger Umarbeitung fand das Werk die Zufriedenheit der Auftraggeber …“"
                                            },
                                            {
                                                "example_id": "7d8d4bd8-8fe2-41d7-bded-8785b676d863",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Auftraggeber war der in Paris ausgebildete und zu den führenden Gelehrten der Universität Löwen gehörende Grammatiker und Jurist Antonius Haneron.“"
                                            },
                                            {
                                                "example_id": "d029f9b8-c899-431f-b35a-7b07f1c7d82c",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Vom Gewölbe des Archivs geschützt, hatte er sich auf eine Beschäftigung zurückgezogen, die vermutlich nicht im Sinne seiner Auftraggeber lag, als sie ihm das Amt des Archivars zuerkannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a3767a-fdc6-42af-a436-f8409c4d1df9",
                        "source_entry_id": "805f717e-207c-34d8-84a4-b3ae1be703dd",
                        "source_sense_id": "980146a7-0f71-3e5e-8c9f-e5850ee26f82",
                        "target_lang_word": "Mandant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de50a06f-a5c5-3478-bb5f-3f6fa2eca9d4",
                                        "entry_id": "5a2cfa57-11a6-3814-84ae-cbc6699a4971",
                                        "glosses": [
                                            "Auftraggeber eines Anwalts oder eines Steuerberaters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06581ca1-2e5f-4e10-bf44-b008a4f25656",
                                                "sense_id": "de50a06f-a5c5-3478-bb5f-3f6fa2eca9d4",
                                                "text": "Mein Mandant kann ein lückenloses Alibi für die Tatzeit vorweisen."
                                            },
                                            {
                                                "example_id": "27664c93-d209-4c37-8935-7e3c64dea397",
                                                "sense_id": "de50a06f-a5c5-3478-bb5f-3f6fa2eca9d4",
                                                "text": "„Der Anwalt, bei dem sie zur Ausbildung war, hat sie, ungeachtet seines Rufs als Linker, von seinen Mandanten ferngehalten.“"
                                            },
                                            {
                                                "example_id": "0036d765-5fde-4c86-9b65-c015e39ab197",
                                                "sense_id": "de50a06f-a5c5-3478-bb5f-3f6fa2eca9d4",
                                                "text": "„Mit diesem Sachverständigen hat die Verteidigerin ihren eigenen Mandanten schwer belastet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
