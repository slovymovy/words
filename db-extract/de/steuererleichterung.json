                        "examples": [
                            {
                                "example_id": "d12e5ea7-c887-45e0-982c-4524d389290c",
                                "sense_id": "fc70d1b9-d675-38d8-9a9f-8132d1977163",
                                "text": "Durch eine Zwischenfrage, die der amerikanische Hauptankläger Jackson an Göring selbst richtete, war im März vorigen Jahres zur Sprache gekommen, daß der Zigarettenfabrikant Göring 7,276 Millionen Mark gezahlt hat, um eine Steuererleichterung zu erreichen."
                            },
                            {
                                "example_id": "f77b894c-d9fc-4346-80e0-5c633310517e",
                                "sense_id": "fc70d1b9-d675-38d8-9a9f-8132d1977163",
                                "text": "Unternehmen, die von der Krankheitswelle stark betroffen seien, sollen Steuererleichterungen bekommen."
                            }
                        ]
                    }
