                "senses": [
                    {
                        "sense_id": "e7d62856-9402-3b80-addf-3eb30c1df554",
                        "entry_id": "927fb620-555c-321f-9a14-a366c92b25ca",
                        "glosses": [
                            "Système politique hétérosexuel qui exploite les femmes ; l'accent est mis sur le cissexisme."
                        ],
                        "tags": [
                            "Transféminisme"
                        ],
                        "examples": [
                            {
                                "example_id": "5296281f-d957-42f7-8ba1-152ff8e6cf86",
                                "sense_id": "e7d62856-9402-3b80-addf-3eb30c1df554",
                                "text": "Vous n'êtes pas un.e mauvais.e militant, vous n'êtes pas \"un.e mauvais.e trans\" si vous n'êtes pas h24 en train de vous battre contre le cispatriarcat."
                            },
                            {
                                "example_id": "72603ecd-afb1-494f-a284-70c16f720972",
                                "sense_id": "e7d62856-9402-3b80-addf-3eb30c1df554",
                                "text": "Dans nos luttes, dans nos têtes, dans nos cicatrices, on peut en vouloir au cispatriarcat de nous avoir fait traverser tant de traumas, et qui aujourd'hui peut nous nuire, nous faire mourir."
                            },
                            {
                                "example_id": "547bc34c-dd51-473d-b90a-00a844a28bc7",
                                "sense_id": "e7d62856-9402-3b80-addf-3eb30c1df554",
                                "text": "Au quotidien, nos corps sont soumis à des représentations normatives façonnées par le cispatriarcat, et son prolongement dans la médecine, les institutions, le marché, etc."
                            },
                            {
                                "example_id": "eb46606a-c31d-439a-9a5f-727d9a59f68a",
                                "sense_id": "e7d62856-9402-3b80-addf-3eb30c1df554",
                                "text": "Nous exigeons des droits pour les femmes et les minorités de genre qui nous permettent de mener nos vies librement et affranchi·e·s du cispatriarcat !"
                            }
                        ]
                    }
                ],
