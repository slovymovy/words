                        "examples": [
                            {
                                "example_id": "4b3d87d6-b900-46c7-a506-b3fbfe35ce8f",
                                "sense_id": "2ce89ac4-84e7-3dab-adc9-77684ad9ebd0",
                                "text": "Comme les suivants, ce but-là aura donné l'occasion aux supporters de rescander le nom de Sterchele."
                            },
                            {
                                "example_id": "c4a73661-2c26-4a50-bc01-3d683cce4276",
                                "sense_id": "2ce89ac4-84e7-3dab-adc9-77684ad9ebd0",
                                "text": "Après une pause d'une bonne vingtaine de minutes, le public commence à rescander le nom du groupe « GAZETTO! GAZETTO! » et se met à chanter « Happy Birthday to You »."
                            }
                        ]
