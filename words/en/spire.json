    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cf48cca-2427-32ea-8974-35403aaba5ed",
                    "sense_definition": "A tall, tapering, pointed structure on top of a roof or tower, especially on a church or cathedral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pointed_structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elegant <w>spire</w> of the old cathedral could be seen from miles away.",
                            "target_lang_translations": {
                                "ru": "Изящный <w>шпиль</w> старого собора был виден за много миль."
                            }
                        },
                        {
                            "text": "Architects designed a modern glass <w>spire</w> to crown the new city hall.",
                            "target_lang_translations": {
                                "ru": "Архитекторы спроектировали современный стеклянный <w>шпиль</w>, чтобы увенчать новую ратушу."
                            }
                        }
                    ],
                    "synonyms": [
                        "steeple"
                    ],
                    "common_phrases": [
                        "church spire",
                        "cathedral spire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокая, сужающаяся кверху, остроконечная конструкция на вершине крыши или башни, особенно на церкви или соборе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпиль",
                                "target_lang_sense_clarification": "остроконечное завершение здания"
                            },
                            {
                                "target_lang_word": "шпиц",
                                "target_lang_sense_clarification": "устаревшее обозначение шпиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed48b068-ebc9-3bf7-87aa-615b9fcedebe",
                    "sense_definition": "A sharp, tapering point, such as a pointed rock formation or the tip of a tree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pointed_structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers gazed up at the jagged rock <w>spires</w> piercing the morning mist.",
                            "target_lang_translations": {
                                "ru": "Альпинисты смотрели снизу вверх на зазубренные скалистые <w>пики</w>, пронзающие утренний туман."
                            }
                        },
                        {
                            "text": "Distant pine trees stood like dark <w>spires</w> against the pale winter sky.",
                            "target_lang_translations": {
                                "ru": "Далекие сосны высились, словно темные <w>острия</w>, на фоне бледного зимнего неба."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinnacle",
                        "peak",
                        "summit"
                    ],
                    "common_phrases": [
                        "rock spire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый, сужающийся кверху выступ, например, остроконечная скала или верхушка дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "острая вершина горы или скалы"
                            },
                            {
                                "target_lang_word": "остриё",
                                "target_lang_sense_clarification": "острый выступ или вершина"
                            },
                            {
                                "target_lang_word": "шпиль",
                                "target_lang_sense_clarification": "в переносном смысле о стоячей игле или скале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f1c0fc-ba28-3c55-8c44-2520205b85a3",
                    "sense_definition": "A spiral, or a single turn of a spiral.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spiral_shapes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shell of the snail was wound in a perfect, delicate <w>spire</w>.",
                            "target_lang_translations": {
                                "ru": "Раковина улитки была закручена в идеальный, изящный <w>завиток</w>."
                            }
                        },
                        {
                            "text": "The artist drew a continuous <w>spire</w> that coiled tightly toward the center of the canvas.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал непрерывную <w>спираль</w>, которая плотно закручивалась к центру холста."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiral",
                        "coil",
                        "whorl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спираль или один виток спирали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "виток спирали или раковины"
                            },
                            {
                                "target_lang_word": "спираль",
                                "target_lang_sense_clarification": "винтообразная линия или фигура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5feeaa6f-a888-39d7-959b-82369eb89847",
                    "sense_definition": "A coil or fold of a serpent or other reptile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spiral_shapes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive serpent lay resting in heavy, glistening <w>spires</w> on the forest floor.",
                            "target_lang_translations": {
                                "ru": "Огромный змей лежал на лесной подстилке, свернувшись тяжелыми блестящими <w>кольцами</w>."
                            }
                        },
                        {
                            "text": "With a sudden movement, the snake wound its <w>spires</w> around the thick branch.",
                            "target_lang_translations": {
                                "ru": "Внезапным движением змея обвила свои <w>кольца</w> вокруг толстой ветки."
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "fold",
                        "twist"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literary contexts to describe coiling animals."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кольцо или виток тела змеи или другого рептилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "виток свернувшейся змеи"
                            },
                            {
                                "target_lang_word": "виток",
                                "target_lang_sense_clarification": "изгиб тела змеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a88c11e6-55ae-3ac8-8625-6f72a449b26f",
                    "sense_definition": "A young shoot or sprout of a plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In early spring, the first green <w>spires</w> of crocus began to push through the cold soil.",
                            "target_lang_translations": {
                                "ru": "Ранней весной первые зеленые <w>стрелки</w> крокусов начали пробиваться сквозь холодную почву."
                            }
                        },
                        {
                            "text": "She carefully examined each delicate <w>spire</w> of the emerging herbs in her garden.",
                            "target_lang_translations": {
                                "ru": "Она внимательно осматривала каждый нежный <w>росток</w> пробивающейся зелени в своем саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "shoot",
                        "sprout",
                        "spear"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern botany; mostly found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой побег или росток растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "росток",
                                "target_lang_sense_clarification": "молодой побег растения"
                            },
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "острый молодой побег, например, лука или крокуса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b78d8f0-108f-3c3d-9d1d-b84042879d64",
                    "sense_definition": "The stalk or stem of a plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall <w>spire</w> of the hollyhock swayed gently in the summer breeze.",
                            "target_lang_translations": {
                                "ru": "Высокий <w>стебель</w> мальвы плавно покачивался на летнем ветру."
                            }
                        },
                        {
                            "text": "He cut the thick <w>spire</w> of the weed close to the root to prevent it from growing back.",
                            "target_lang_translations": {
                                "ru": "Он срезал толстый <w>стебель</w> сорняка у самого корня, чтобы тот не вырос снова."
                            }
                        }
                    ],
                    "synonyms": [
                        "stalk",
                        "stem"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mostly replaced by 'stalk' or 'stem' in modern usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стебель или цветонос растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стебель",
                                "target_lang_sense_clarification": "основная часть травянистого растения"
                            },
                            {
                                "target_lang_word": "цветонос",
                                "target_lang_sense_clarification": "стебель, несущий цветок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d3a162-2585-300c-a4c2-533c2c217c80",
                    "sense_definition": "Any of various tall grasses, rushes, or sedges.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marsh was thick with wild <w>spire</w> and reeds that rustled in the wind.",
                            "target_lang_translations": {
                                "ru": "Болото густо заросло дикой <w>осокой</w> и тростником, шуршащими на ветру."
                            }
                        },
                        {
                            "text": "They walked through fields of tall <w>spire</w> grass near the riverbank.",
                            "target_lang_translations": {
                                "ru": "Они шли по полям высокой <w>болотной</w> травы у берега реки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used dialectally or historically for certain types of coarse grass."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из различных высоких трав, камышей или осок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осока",
                                "target_lang_sense_clarification": "высокая болотная трава"
                            },
                            {
                                "target_lang_word": "тростник",
                                "target_lang_sense_clarification": "высокое прибрежное растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6154821-8af4-3a76-988e-735583d66f90",
                    "sense_definition": "The top, summit, or highest point of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reached the very <w>spire</w> of his professional career with this final award.",
                            "target_lang_translations": {
                                "ru": "С этой последней наградой он достиг самой <w>вершины</w> своей профессиональной карьеры."
                            }
                        },
                        {
                            "text": "The mountain's snowy <w>spire</w> was lost in the thick clouds above.",
                            "target_lang_translations": {
                                "ru": "Снежная <w>макушка</w> горы терялась в густых облаках вверху."
                            }
                        }
                    ],
                    "synonyms": [
                        "summit",
                        "pinnacle",
                        "apex",
                        "peak"
                    ],
                    "antonyms": [
                        "base",
                        "bottom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used figuratively in older literature to mean the pinnacle or summit."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вершина, верхушка или наивысшая точка чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верхушка",
                                "target_lang_sense_clarification": "верхняя часть чего-либо"
                            },
                            {
                                "target_lang_word": "макушка",
                                "target_lang_sense_clarification": "оконечность или верхняя часть горы, дерева"
                            },
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "наивысшая точка горы или карьеры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369f7508-a79f-363e-956a-83e6a5dad0f3",
                    "sense_definition": "A tube or fuse used to communicate fire to a blasting charge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners carefully laid the <w>spire</w> to ensure the charge would detonate safely from a distance.",
                            "target_lang_translations": {
                                "ru": "Шахтеры аккуратно проложили <w>запал</w>, чтобы заряд сдетонировал безопасно на расстоянии."
                            }
                        },
                        {
                            "text": "A damp <w>spire</w> could cause a dangerous delay in the blasting process.",
                            "target_lang_translations": {
                                "ru": "Сырой <w>фитиль</w> мог вызвать опасную задержку в процессе взрывных работ."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "An old mining term no longer in active use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трубка или фитиль, используемые для передачи огня взрывному заряду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запал",
                                "target_lang_sense_clarification": "устройство или фитиль для произведения взрыва"
                            },
                            {
                                "target_lang_word": "фитиль",
                                "target_lang_sense_clarification": "горючий шнур для передачи огня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62556786-ba8d-3a7f-bb28-e403d8e413c9",
                    "sense_definition": "The part of a spiral generated in one complete revolution about the pole.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spiral_shapes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician calculated the distance between each successive <w>spire</w> of the Archimedean spiral.",
                            "target_lang_translations": {
                                "ru": "Математик вычислил расстояние между каждым последующим <w>витком</w> спирали Архимеда."
                            }
                        },
                        {
                            "text": "Each <w>spire</w> of the shell grew progressively wider than the last.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>оборот</w> раковины становился постепенно шире предыдущего."
                            }
                        }
                    ],
                    "synonyms": [
                        "whorl",
                        "turn",
                        "revolution"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical or mathematical usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть спирали, образующаяся за один полный оборот вокруг центра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виток",
                                "target_lang_sense_clarification": "один полный оборот спирали"
                            },
                            {
                                "target_lang_word": "оборот",
                                "target_lang_sense_clarification": "полный круг в спиральном движении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0138c25b-7c58-3812-bf2f-f2e18bd52cf1",
                    "sense_definition": "To grow straight upward rather than spreading out horizontally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certain species of pine tend to <w>spire</w> rapidly toward the light in dense forests.",
                            "target_lang_translations": {
                                "ru": "Некоторые виды сосен имеют тенденцию быстро <w>тянуться вверх</w> к свету в густых лесах."
                            }
                        },
                        {
                            "text": "If you do not prune the shrub, it will simply <w>spire</w> up without producing side branches.",
                            "target_lang_translations": {
                                "ru": "Если кустарник не обрезать, он будет просто <w>вытягиваться</w> вверх, не давая боковых веток."
                            }
                        }
                    ],
                    "synonyms": [
                        "tower",
                        "shoot"
                    ],
                    "common_phrases": [
                        "spire up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти прямо вверх, не разрастаясь вширь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тянуться вверх",
                                "target_lang_sense_clarification": "расти вертикально к свету"
                            },
                            {
                                "target_lang_word": "вытягиваться",
                                "target_lang_sense_clarification": "расти в высоту без боковых веток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45802b17-372e-36f3-b76c-b9c833cba81d",
                    "sense_definition": "To sprout, germinate, or send forth the first shoots of growth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The barley seeds began to <w>spire</w> after a few days of warm rain.",
                            "target_lang_translations": {
                                "ru": "Семена ячменя начали <w>прорастать</w> после нескольких дней теплого дождя."
                            }
                        },
                        {
                            "text": "In the damp cellar, the stored potatoes started to <w>spire</w> pale shoots.",
                            "target_lang_translations": {
                                "ru": "В сыром подвале хранящийся картофель начал <w>пускать</w> бледные ростки."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprout",
                        "germinate",
                        "shoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in older agricultural or botanical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прорастать, пускать первые ростки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "давать первые ростки"
                            },
                            {
                                "target_lang_word": "пускать ростки",
                                "target_lang_sense_clarification": "начинать расти (о семенах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06ba58b0-77a4-3e14-bf66-31216a0be257",
                    "sense_definition": "To provide or ornament a building with a spire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architects decided to <w>spire</w> the new chapel to match the surrounding historic buildings.",
                            "target_lang_translations": {
                                "ru": "Архитекторы решили <w>увенчать шпилем</w> новую часовню, чтобы она гармонировала с окружающими историческими зданиями."
                            }
                        },
                        {
                            "text": "A beautifully <w>spired</w> church dominated the village skyline.",
                            "target_lang_translations": {
                                "ru": "Церковь, красиво <w>увенчанная шпилем</w>, возвышалась над силуэтом деревни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснастить здание шпилем или украсить его шпилями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенчать шпилем",
                                "target_lang_sense_clarification": "построить шпиль на вершине здания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3119d0c5-6fb6-3664-8fae-cf372b252aa9",
                    "sense_definition": "To breathe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying man could barely <w>spire</w> in the heavy, smoke-filled room.",
