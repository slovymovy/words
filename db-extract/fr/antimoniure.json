                                "example_id": "544fa050-4714-4f7b-b049-71bb84722602",
                                "sense_id": "3f80ac64-44fe-3d21-bf79-8d8bdad2c195",
                                "text": "Après un premier passage, le contenu de la nacelle est traité par l’eau qui, en dissolvant le chlorure de nickel, met à nu l’antimoniure formé."
                            }
                        ]
