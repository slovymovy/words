                                        "entry_id": "bbf179f9-5f3a-36c5-b8cf-9b853709a4d0",
                                        "glosses": [
                                            "die Person, die für die Erstellung, die Organisation und die Wartung einer Internetpräsenz zuständig ist"
                                        ],
