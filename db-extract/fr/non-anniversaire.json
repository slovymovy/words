                        "source_sense_id": "e9493170-9e99-3469-980e-5649d64f589e",
                        "target_lang_word": "unbirthday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbirthday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                        "entry_id": "bba55e78-e936-328e-96cc-d6bbce1ed0af",
                                        "glosses": [
                                            "A day that is not one's birthday but is celebrated as though it were."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c182b8-46ed-485b-9162-838518a72c56",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "\"They gave it me,\" Humpty Dumpty continued thoughtfully, as he crossed one knee over the other and clasped his hands round it, \"they gave it me⸺for an un-birthday present.\" / \"I beg your pardon?\" Alice said with a puzzled air.\" / \"I'm not offended,\" said Humpty Dumpty. / \"I mean, what is an un-birthday present?\" / \"A present given when it isn't your birthday, of course.\""
                                            },
                                            {
                                                "example_id": "60385155-2723-4123-ae25-6952d5dffda9",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "Hunting for treasures on any special day (like Easter, Christmas, birthdays or unbirthdays) can be fun for children and parents alike."
                                            },
                                            {
                                                "example_id": "7e115e80-b433-4e2a-b581-b2647d7dcdc9",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "Another way to look at unbirthdays is as an opportunity to celebrate every day of life. You can throw a party for no particular reason, except for FUN!"
                                            },
                                            {
                                                "example_id": "548a37f7-f21a-4160-a724-1391da18b731",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "Make an unbirthday cake and wear party hats when you blow out the candles together."
                                            },
                                            {
                                                "example_id": "c1248643-ef98-4654-8cb5-5afe46b76f45",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "I got some great photos with the unbirthday camera you left for me in the suitcase. Thanks."
                                            },
                                            {
                                                "example_id": "fefb83d8-b5a3-48fa-aa8a-ddf0d3df32cb",
                                                "sense_id": "728d5122-7a2e-398d-b92d-3cdb0a6f8358",
                                                "text": "\"This is just an unbirthday party. Wait till you see your birthday party. When is your birthday, Peg?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
