{
    "word_family": [
        "fathom",
        "fathomless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a43b740-171e-3ce6-8b01-8a77caee2c48",
                    "sense_definition": "Too deep to be measured or reached.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine explored the <w>unfathomable</w> depths of the ocean floor.",
                            "target_lang_translations": {
                                "es": "El submarino exploró las <w>insondables</w> profundidades del fondo oceánico."
                            }
                        },
                        {
                            "text": "The ship sank into the <w>unfathomable</w> abyss where no light could reach.",
                            "target_lang_translations": {
                                "es": "El barco se hundió en el abismo <w>insondable</w> donde la luz no podía llegar."
                            }
                        }
                    ],
                    "synonyms": [
                        "bottomless",
                        "fathomless",
                        "abyssal"
                    ],
                    "antonyms": [
                        "measurable",
                        "fathomable"
                    ],
                    "common_phrases": [
                        "unfathomable depth"
                    ],
                    "target_lang_definitions": {
                        "es": "Demasiado profundo para ser medido o alcanzado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "insondable",
                                "target_lang_sense_clarification": "de profundidad física imposible de medir o alcanzar"
                            },
                            {
                                "target_lang_word": "sin fondo",
                                "target_lang_sense_clarification": "abismo o profundidad de la que no se ve el fondo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f18acd45-6b12-33b1-bf05-9cc92b6757ea",
                    "sense_definition": "Impossible to understand or explain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reasons for his sudden resignation remain <w>unfathomable</w> to his colleagues.",
                            "target_lang_translations": {
                                "es": "Los motivos de su repentina renuncia siguen siendo <w>incomprensibles</w> para sus colegas."
                            }
                        },
                        {
                            "text": "She looked at him with <w>unfathomable</w> eyes that revealed nothing of her true thoughts.",
                            "target_lang_translations": {
                                "es": "Ella lo miró con ojos <w>inescrutables</w> que no revelaban nada de sus verdaderos pensamientos."
                            }
                        }
                    ],
                    "synonyms": [
                        "incomprehensible",
                        "inscrutable",
                        "mysterious"
                    ],
                    "antonyms": [
                        "understandable",
                        "explicable",
                        "intelligible"
                    ],
                    "common_phrases": [
                        "unfathomable mystery"
                    ],
                    "target_lang_definitions": {
                        "es": "Imposible de entender, explicar o descifrar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "incomprensible",
                                "target_lang_sense_clarification": "que no se puede comprender o explicar"
                            },
                            {
                                "target_lang_word": "insondable",
                                "target_lang_sense_clarification": "misterioso, difícil de descifrar o escudriñar"
                            },
                            {
                                "target_lang_word": "inescrutable",
                                "target_lang_sense_clarification": "que no se puede saber ni averiguar; impenetrable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}