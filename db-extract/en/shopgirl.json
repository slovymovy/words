                        "sense_id": "88a294e6-d403-35f4-941d-144a6b46f5ef",
                        "entry_id": "f47d9744-f9c7-36d2-8693-2fb25d1f206d",
                        "glosses": [
                            "A girl who works in a shop; a young saleswoman."
                        ],
                        "tags": [],
