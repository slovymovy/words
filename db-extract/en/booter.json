                        "glosses": [
                            "A program or process that boots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8e31d8-7b2a-4dc2-9978-e9824529aef0",
                                "sense_id": "4e914ebd-2326-35c6-9cae-a53bfcf8ca2b",
                                "text": "JavaOS works with a variety of booters."
                            },
                            {
                                "example_id": "79e7ea23-d63e-435e-a1f3-78f09c92b9eb",
                                "sense_id": "4e914ebd-2326-35c6-9cae-a53bfcf8ca2b",
                                "text": "If the firmware cannot locate a booter file, you will see a flashing folder icon with a question mark."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff1f3ab1-c30f-328f-b19f-aa53049f4ecb",
                        "entry_id": "f01007b6-c271-39e0-a9ca-7ae98f8c2f52",
                        "glosses": [
                            "A game that is launched by booting directly from the floppy disk containing the game program, rather than starting the program from within the computer's standardized operating system."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffaa63b7-17b8-41f3-b33b-c02b56ffb0df",
                                "sense_id": "ff1f3ab1-c30f-328f-b19f-aa53049f4ecb",
                                "text": "To allow full use of the system's limited resources and prevent users from making pirated copies of the game, the first version of Microsoft Flight Simulator was a booter, rather than being run from within DOS."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b14805d-594e-370f-8d14-fee8363ec132",
                        "entry_id": "f01007b6-c271-39e0-a9ca-7ae98f8c2f52",
                        "glosses": [
                            "The floppy disk used to launch a game in such a manner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
