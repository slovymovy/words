                        "solid compound"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics/typography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пишется как одно слово без пробелов и дефисов."
                    },
                    "translations": {
                        "ru": [
