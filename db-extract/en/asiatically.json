                        "glosses": [
                            "In a (typically) Asian manner; from, in or toward Asia."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1c4b03fd-68d3-4457-bef9-13d02910bf98",
                                "sense_id": "4c826ef4-9677-3dbb-bfcf-bd2ec943d922",
                                "text": "[…] to the Importance of your Mightiness, Prostrate at the Threshold of your Munificence, Do I Asiatically bow my Head;"
                            },
                            {
                                "example_id": "90b2eac6-9e51-4f96-af1c-44186162f0e6",
                                "sense_id": "4c826ef4-9677-3dbb-bfcf-bd2ec943d922",
                                "text": "1843, Charlotte Brontë, letter to Emily Brontë dated 2 September, 1843, in Muriel Spark (ed.), The Letters of the Brontës, Norman, OK: University of Oklahoma Press, 1954, p. 106,\nThe weather has been exceedingly fine during the last fortnight, and yet not so Asiatically hot as it was last year at this time."
                            },
                            {
                                "example_id": "ea3ce8b5-82f0-453e-a080-f27841baa1e5",
                                "sense_id": "4c826ef4-9677-3dbb-bfcf-bd2ec943d922",
                                "text": "[…] the iconoclast sovereigns, strong in the support of an Asiatically recruited army, had added much to the glory of the Empire,"
                            },
                            {
                                "example_id": "a1df7e83-52c4-43c7-b927-0b8e4fa3bcfb",
                                "sense_id": "4c826ef4-9677-3dbb-bfcf-bd2ec943d922",
                                "text": "The books in his waiting room inclined Asiatically, as did the knickknacks in his lavatory."
                            }
                        ]
                    }
