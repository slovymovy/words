                    ]
                },
                {
                    "sense_id": "61012200-64a5-3f07-8249-f68804da7d87",
                    "sense_definition": "Gleichgewicht und geordneter Ablauf von Aufnahme, Umwandlung und Abgabe von Stoffen oder Energie in einem System",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Biologie_Natur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eine unausgewogene Ernährung kann den <w>Haushalt</w> der Mineralstoffe im Körper stören."
                        },
                        {
                            "text": "Ausreichend Schlaf ist wichtig, um den hormonellen <w>Haushalt</w> des Körpers zu stabilisieren."
