    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "168bbcaf-8f9f-34ac-9d0c-6a2805652a26",
                "word": "gerontocracy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e7730289-9935-4bd9-abb8-a612e0d79d2f",
                        "entry_id": "168bbcaf-8f9f-34ac-9d0c-6a2805652a26",
                        "tags": [
                            "plural"
                        ],
                        "form": "gerontocracies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                        "entry_id": "168bbcaf-8f9f-34ac-9d0c-6a2805652a26",
                        "glosses": [
                            "Government by elders; government by elderly rulers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "231e1df9-fa8f-4dbd-ae1d-242d84150943",
                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                "text": "Near-synonym: senilocracy"
                            },
                            {
                                "example_id": "5b9b2d95-3d23-4481-9880-3809ab2952a9",
                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                "text": "It would come as no surprise to find that optimum science policy is apt to be developed neither by gerontocracy nor by juvenocracy but, like the community of scientists itself, by age-diversified meritocracy."
                            },
                            {
                                "example_id": "6c6cb889-a78f-4e2c-aff5-2b960c681cf5",
                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                "text": "But in his 1996 novel, Holy Fire, [Bruce] Sterling imagines a rather different future: a world ruled by an all-powerful gerontocracy, which appropriates most of the world's wealth to pay for ever more costly life-extension techniques."
                            },
                            {
                                "example_id": "aa6879a4-0d17-4b4d-8f29-5a444640b02b",
                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                "text": "Young people who are close to writing off the Democratic Party as a dinosaur, as a gerontocracy of prudish abuelos who gave birth by immaculate conception, may be in for a pleasant surprise."
                            },
                            {
                                "example_id": "0e75ae05-7b6c-4571-a405-0e00da8921be",
                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                "text": "He [Koizumi] was what would pass for a political maverick among Japan's faceless gray gerontocracy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d96b5e-909a-43fc-9415-508e25eea9ea",
                        "source_entry_id": "168bbcaf-8f9f-34ac-9d0c-6a2805652a26",
                        "source_sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                        "source_sense_description": "government by elders",
                        "target_lang_word": "gerontokracie",
