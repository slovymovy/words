                ],
                "senses": [
                    {
                        "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                        "entry_id": "1d8dda22-6f03-3457-9758-291e6601d859",
                        "glosses": [
                            "Beseitigung bestimmter Branderscheinungen die einen Brandschaden beheben"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "578670a8-f5a1-459c-b7ae-a225a726b335",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "Die Brandschadensanierung beginnt unmittelbar nach dem die Brandstelle erkaltet ist."
                            },
                            {
                                "example_id": "13197a13-b224-46c5-bd80-91b7843cf3b7",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "„Diese Richtlinien sind als Handlungsanweisung für den Umgang mit erkalteten Brandstellen, im weiteren als Brandschadensanierung bezeichnet, konzipiert.“"
                            },
                            {
                                "example_id": "73131f22-209c-49c6-8397-582ccbd9c385",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "„Brandschadensanierung umfasst sämtliche Tätigkeiten auf der kalten Brandstelle, die zur Beseitigung der brandbedingten Schäden an Gebäuden und Anlagen auszuführen sind, inklusive aller Vor- und Nacharbeiten“"
                            },
                            {
                                "example_id": "0e879dae-e32c-48ed-a673-8ee9f24875fd",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "„Eine sach- und fachgerechte Brandschadensanierung erfordert umfangreiche Kenntnisse auf diesem komplexen Gebiet (vgl. Schweizer, Sichere Brandschadensanierung, Württ. Bau-BG, Mitteilungen 1/96).“"
                            },
                            {
                                "example_id": "e96f0c98-22aa-4135-a1e9-3889b8591d2d",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "„Für diese sogenannte Brandschadensanierung beschreibt die Gefahrstoffverordnung die notwendigen Gesundheitsschutz- und Sicherheitsmaßnahmen. Als weitere wichtige Regel ist in diesem Zusammenhang die Richtlinie zur Brandschadensanierung (VdS 2357) des Gesamtverbandes der deutschen Versicherungswirtschaft e.V. zu nennen. “"
                            },
                            {
                                "example_id": "5e5bb03c-e5ac-4f58-b5ee-321e9237688f",
                                "sense_id": "6afac01c-8147-309e-a102-afca44b821cb",
                                "text": "„Wenn Sie Hilfe brauchen um die Zerstörungen und Verunreinigungen eines Brandschadens fachgerecht zu entfernen und zu entsorgen sind wir als Experten der Brandschadensanierung die richtigen Ansprechpartner.[…] Brandschadensanierung ist ein weites Feld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
