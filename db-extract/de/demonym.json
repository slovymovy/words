                    {
                        "translation_id": "91be2665-5945-4bcb-8d67-3109a0df8702",
                        "source_entry_id": "be67c231-f34e-3dbe-ab21-4250eaf195e3",
                        "source_sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                        "source_sense_description": "Bezeichnung eines Volkes, von Einheimischen oder Einwohnern eines bestimmten Landes",
                        "target_lang_word": "ethnonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                        "entry_id": "35d54b87-d486-3b95-887e-fdf60685ea87",
                                        "glosses": [
                                            "Nom d’un peuple, d’une ethnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29c43bf-5e7a-4977-b7c1-cfaef8a50fdf",
                                                "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                                "text": "Danois, Hachémite, sont des ethnonymes."
                                            },
                                            {
                                                "example_id": "e514de84-6c63-41a5-b977-43f689904338",
                                                "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                                "text": "D’autres ethnonymes gaulois, également demeurés dans nos noms de lieux, font allusion à la force des combattants, à la puissance physique."
                                            },
                                            {
                                                "example_id": "3e13abe4-3828-4f5d-a5f6-26efdc8959cb",
                                                "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                                "text": "Pour éviter d'inscrire dans le texte de loi un ethnonyme, il a été décidé de parler des nomades, tout en évitant de mêler sous le même statut les forains et autres commerçants ambulants."
                                            },
                                            {
                                                "example_id": "c4341234-4836-466b-a982-1716029561e3",
                                                "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                                "text": "Le mot Batavia renvoyait à l'ethnonyme utilisé par les Romains pour désigner, au temps de la guerre des Gaules, les populations de la Hollande."
                                            },
                                            {
                                                "example_id": "671e8789-a376-41e1-a5f1-8573b468b992",
                                                "sense_id": "05bfc85b-0a45-38c9-8d4d-ee3fcffae859",
                                                "text": "dans L'Iliade, il est très fréquent que les ethnonymes utilisés renvoient à des parties de ce grand ensemble: Béotiens, Étoliens et autres Myrmidons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd8f23c3-5f76-4f3e-a17a-619177555fb5",
                        "source_entry_id": "be67c231-f34e-3dbe-ab21-4250eaf195e3",
                        "source_sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
