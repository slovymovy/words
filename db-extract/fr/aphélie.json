                "senses": [
                    {
                        "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                        "entry_id": "d4e91952-e595-3faa-ba92-d25d5107a1ce",
                        "glosses": [
                            "Sur une orbite ayant pour foyer la Soleil, le point le plus éloigné de celui-ci ; autrement dit, l’apoapside d’une orbite héliocentrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cadc84d-3d1f-4204-98b6-16d7171fe8e3",
                                "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                                "text": "C’est en été que la Terre se trouve à l’aphélie de son orbite. La Terre arrive à son aphélie."
                            },
                            {
                                "example_id": "b2cefef1-16c5-41cc-9cc4-48cb80f1eeb2",
                                "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                                "text": "Les perturbations planétaires agissent près du périhélie des orbites, par conséquent elles en changent l’aphélie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44dde092-d6f3-4233-b8cc-52d5c3dc101f",
                        "source_entry_id": "d4e91952-e595-3faa-ba92-d25d5107a1ce",
                        "source_sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                        "target_lang_word": "Aphel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aphel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                                        "entry_id": "7d380430-fce4-3f8f-a0e2-331508f1f9e4",
                                        "glosses": [
                                            "sonnenfernster Punkt einer Planetenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6328fea-73ec-4670-871b-0e50d02221a7",
                                                "sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                                                "text": "Die Bahngeschwindigkeit eines Planeten ist im Aphel am geringsten."
                                            },
                                            {
                                                "example_id": "d21ed6b3-63f7-4c74-acdd-fc54cb958b3f",
                                                "sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                                                "text": "„Auch die Erde kam in eine größte Nähe zur Sonne, ihr Perihel, und in eine größte Ferne, ihr Aphel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad13e13c-9527-4376-915b-fe2fd95b4d4a",
                        "source_entry_id": "d4e91952-e595-3faa-ba92-d25d5107a1ce",
                        "source_sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                        "target_lang_word": "Sonnenferne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenferne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a91f3b1-8d15-3263-a77a-9b9c3cd0ba1a",
                                        "entry_id": "b1ead33f-d51d-3a9f-9260-b85933cb82f0",
                                        "glosses": [
                                            "der von der Sonne weitest entfernte Punkt einer Planeten- oder Kometenbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee25dc7-7139-4d3c-ba3e-b58940a8df68",
                                                "sense_id": "8a91f3b1-8d15-3263-a77a-9b9c3cd0ba1a",
                                                "text": "„‚In Sonnenferne läuft sie langsamer um die Sonne, in Sonnennähe schneller‘, erklärt Dietmar Stachowski vom Zeiss-Großplanetarium in Prenzlauer Berg.“"
                                            },
                                            {
                                                "example_id": "9826a525-f87a-4d5f-86c7-282240e36f66",
                                                "sense_id": "8a91f3b1-8d15-3263-a77a-9b9c3cd0ba1a",
                                                "text": "„Dass ausgerechnet für die nächsten paar tausend Jahre auf der Nordhalbkugel Sommer ist, wenn die Erde in Sonnenferne steht, ist reiner Zufall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
