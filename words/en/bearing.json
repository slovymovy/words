                {
                    "sense_id": "7f0b45a7-b31e-31db-a939-37e51b51219b",
                    "sense_definition": "A mechanical device that supports another part or reduces friction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to replace a worn <w>bearing</w> in the engine.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось заменить изношенный <w>подшипник</w> в двигателе.",
                                "es": "El mecánico tuvo que reemplazar un <w>rodamiento</w> desgastado en el motor.",
                                "cs": "Mechanik musel v motoru vyměnit opotřebované <w>ložisko</w>."
                            }
                        },
                        {
                            "text": "Without a proper <w>bearing</w>, the wheel will not rotate smoothly.",
                            "target_lang_translations": {
                                "ru": "Без исправного <w>подшипника</w> колесо не будет вращаться плавно.",
                                "es": "Sin un <w>cojinete</w> adecuado, la rueda no girará suavemente.",
                                "cs": "Bez správného <w>ložiska</w> se kolo nebude otáčet hladce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ball bearing",
                        "roller bearing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство, поддерживающее вал или ось и уменьшающее трение.",
                        "es": "Dispositivo mecánico que sostiene una pieza y reduce la fricción.",
                        "cs": "Mechanické zařízení, které podpírá hřídel nebo osu a snižuje tření."
                    },
                    "translations": {
                        "ru": [
