                                            {
                                                "example_id": "450b8878-0d6d-4c36-b143-214d9512d4f2",
                                                "sense_id": "e36056ea-da5e-3ec0-8a42-327710452830",
                                                "text": "Oxide entstehen häufig durch die Reaktion von Elementen mit Sauerstoff."
