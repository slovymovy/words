                        "cross_references": [
                            {
                                "target_word": "espléndido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "73c62a86-3679-32dc-adc2-a98c60ecc174",
                                        "entry_id": "fbf07996-505f-30a6-a987-ce92bef79c19",
                                        "glosses": [
                                            "Se aplica a lo que posee excelencia o muy alta calidad; con cualidades superiores a la norma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7be37e6-f85b-4f38-8ec0-c4d89163a8ac",
                                                "sense_id": "73c62a86-3679-32dc-adc2-a98c60ecc174",
                                                "text": "Fue una corrida espléndida porque todo funcionó a la perfección."
                                            },
                                            {
                                                "example_id": "865003cd-24e9-43a4-9762-c0ee2179e7d6",
                                                "sense_id": "73c62a86-3679-32dc-adc2-a98c60ecc174",
                                                "text": "Es una jugador espléndido, siempre juega de manera muy buena."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89b7ff61-cb81-318e-a9e0-d42578fae278",
                                        "entry_id": "fbf07996-505f-30a6-a987-ce92bef79c19",
                                        "glosses": [
                                            "Que se caracteriza por la generosidad abundante, actitud liberal y gran capacidad de compartir o dar a otros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8254294-a04d-49bd-9765-5eba2a011b77",
                                                "sense_id": "89b7ff61-cb81-318e-a9e0-d42578fae278",
                                                "text": "Se porta siempre de manera espléndida con su familia; les da muchos regalos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c1e489a4-b8de-388a-9478-041161d03fc1",
                                        "entry_id": "fbf07996-505f-30a6-a987-ce92bef79c19",
                                        "glosses": [
                                            "Que da luz, esplende o resplandece."
