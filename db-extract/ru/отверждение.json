                "senses": [
                    {
                        "sense_id": "5d206177-7324-36cf-8e41-dcda21a6c762",
                        "entry_id": "d87faf75-1b07-37a7-aa61-62b268568fb9",
                        "glosses": [
                            "действие, в результате которого происходит необратимое превращение жидких реакционноспособных олигомеров и(или) мономеров в твердые неплавкие и нерастворимые сетчатые полимеры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6533d4fd-c5bc-4e29-b461-bc3e848abafc",
                                "sense_id": "5d206177-7324-36cf-8e41-dcda21a6c762",
                                "text": "Отверждение под потоком электронных лучей."
                            },
                            {
                                "example_id": "9a0076d4-51b4-4110-87c6-0f1d09a958a2",
                                "sense_id": "5d206177-7324-36cf-8e41-dcda21a6c762",
                                "text": "Микроволновое отверждение происходит аналогично термическому отверждению."
                            },
                            {
                                "example_id": "5cb328c2-233d-4bb4-be95-3b7abb64b959",
                                "sense_id": "5d206177-7324-36cf-8e41-dcda21a6c762",
                                "text": "Ультрафиолетовое отверждение лаков и красок."
                            },
                            {
                                "example_id": "c30a33a3-9c92-4c90-adee-47ea4257edec",
                                "sense_id": "5d206177-7324-36cf-8e41-dcda21a6c762",
                                "text": "Отверждение проводят под действием тепла, УФ- или других излучений, при повышенном или пониженном давлении, на воздухе или без доступа кислорода."
                            }
                        ]
                    }
