                ],
                "senses": [
                    {
                        "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                        "entry_id": "c9b3ce73-49c0-37e2-b8b7-23c0e3bf3dc6",
                        "glosses": [
                            "Servitut, das zur Viehtrift über ein fremdes Grundstück berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11246514-8b2d-4b79-ba6d-6050099e0c20",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Ein Allmendrecht der Nachbargemeinde – die minimale Form desselben, das Übertriebsrecht – wird vorbehalten.“"
                            },
                            {
                                "example_id": "b7ec3473-46a9-47fc-8985-1b795c23ac06",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Dies Übertriebsrecht gehörte früher dem Fürsten Leiningen, der es durch die Hübnerschaft von Muckental ausüben ließ.“"
                            },
                            {
                                "example_id": "b7960fab-c1bc-4ede-b546-8acb22f822fc",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Damit hatten die Kernser die gemischten Nutzungsverhältnisse weitgehend bereinigt, ein eingeschränktes Übertriebsrecht mit Kleinvieh wurde offenbar vorbehalten.“"
                            },
                            {
                                "example_id": "fa9da59a-a538-4a0f-8357-359a3808ff46",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Da dieses Übertriebsrecht in der Regel nur in denjenigen Bezirken, welche den Schafhöfen und herrschaftlichen Gütern zunächst lagen, ausgeübt wurde, die entfernteren aber stets davon verschont blieben, so kam jenes Recht an den entferntesten Orten in Vergessenheit und das früher aller Orten geltende Übertriebsrecht der Herrschaft wurde thatsächlich auf jene Bezirke eingeschränkt, innerhalb welcher aus Zweckmäßigkeitsrücksichten gewöhnlich Gebrauch davon gemacht wurde.“"
                            },
                            {
                                "example_id": "f468a7f5-eca2-4b97-a086-f8ac987b8c0c",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Die Weiderechte und die Agrargemeinschaftsanteile hätten somit eine untrennbare Einheit gebildet und die Einforstungsrechte seien so genannte Übertriebsrechte der Agrargemeinschaftsmitglieder gewesen.“"
                            },
                            {
                                "example_id": "e465f0b9-f454-41ef-9fe3-4382870381ee",
                                "sense_id": "1575bf3f-fe83-3838-a766-d78114dde9f7",
                                "text": "„Heilbronn würde das Übertriebsrecht der Stadt Weinsberg (oben Nr. 10 c) abkaufen, wenn diese Stadt nicht allzuviel für diese Weide verlangte, die für ihren Schäfer sehr wenig Wert hat und so bleibt dieser Walddistrict verwüstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
