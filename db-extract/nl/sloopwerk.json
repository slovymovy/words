                        "glosses": [
                            "het afbreken van iets met name het afbreken van een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e5f745-53e8-4f82-81bc-178abb280d7c",
                                "sense_id": "bb48dfb8-084e-36ae-8ed1-693c4744b4a6",
                                "text": "De resten van luitenant-generaal Gonzalo Queipo de Llano zijn verwijderd uit zijn graf. Om ophef te voorkomen gebeurde dat in het holst van de nacht. Er mocht niet gefilmd worden, maar buiten was het sloopwerk goed te horen."
                            }
                        ]
                    },
                    {
