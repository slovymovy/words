                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "paresthésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paresthésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "857b78a7-aa25-34d0-b828-71b8a559ee44",
                                        "entry_id": "9c9052d4-cead-3036-83d2-3db958676d20",
                                        "glosses": [
                                            "Trouble de la sensibilité, désagréable et non douloureux, donnant la sensation de palper du coton, et pouvant s’accompagner d’une anesthésie, de picotements, d’une raideur cutanée et parfois d’une sensation de \\\"chaud-froid\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5dd8759-1fd1-49fd-b473-13b4789277c6",
                                                "sense_id": "857b78a7-aa25-34d0-b828-71b8a559ee44",
                                                "text": "Vous vous êtes endormi(e) sur votre bras et vous sentez des picotements dans la main ? Normal ! \"C’est une paresthésie, qui se produit quand un nerf sensitif subit une longue pression, une diminution de son irrigation sanguine ou une variation brutale de température\", avance Didier Bouhassira, neurologue à l’Inserm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7acb8c28-3b50-45aa-ae74-bda1cffbc605",
                        "source_entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "Missempfindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missempfindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfe9862-062f-3dbd-a655-46f800712186",
                                        "entry_id": "a2e033e3-66d8-32e0-874a-acc8a91ff5ab",
                                        "glosses": [
                                            "unangenehmes körperliches Gefühl; veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a834bde5-b0a7-44b6-a68c-8e589340d4b9",
                                                "sense_id": "cbfe9862-062f-3dbd-a655-46f800712186",
                                                "text": "„Manchmal habe ich das Gefühl, meine Hand wäre ein Fremdkörper und meine rechte Gesichtshälfte ist ebenso von einer Missempfindung betroffen.“"
                                            },
                                            {
                                                "example_id": "a31e2b29-dd60-41dd-85f6-a5949e4fff37",
                                                "sense_id": "cbfe9862-062f-3dbd-a655-46f800712186",
                                                "text": "„Meist fühlen sich die Körperstellen kühler an, da sie weniger durchblutet werden, die Missempfindung kann bis in die Schultern ausstrahlen.“"
                                            },
                                            {
                                                "example_id": "c08a5cf6-319e-49d0-9db4-1947587cf4fe",
                                                "sense_id": "cbfe9862-062f-3dbd-a655-46f800712186",
                                                "text": "„Bei chronischem Schmerz weicht die Missempfindung nicht mit dem Heilungsprozess oder spricht schlecht auf Medikamente an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b01347-0053-4f80-a838-ba703a7f440e",
                        "source_entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "Empfindungsstörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfindungsstörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                        "entry_id": "9f7429a8-8250-3181-b8f2-d781fbe8cccd",
                                        "glosses": [
                                            "veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca0de9fc-c7a2-4e2b-a66a-9146551df659",
                                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                                "text": "„Er kehrte als Rollstuhlfahrer mit einer Empfindungsstörung in den Beinen in die Familie zurück, wegen der er kaum noch laufen kann.“"
                                            },
                                            {
                                                "example_id": "22bcdfee-ccc7-4f82-a50c-5450ad62f909",
                                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                                "text": "„Unbehandelte Verletzungen zum Beispiel durch zu kleine Schuhe, was man aufgrund der Nervenschädigung - und der damit verbundenen Empfindungsstörung - häufig nicht wahrnimmt, können übersehen werden.“"
                                            },
                                            {
                                                "example_id": "04c65616-e464-4a8f-8798-78b503b30750",
                                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                                "text": "„Unterhalb der verletzten Stelle ist ipsilateral eine dissozierte Empfindungsstörung nachweisbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69e5617c-d777-4ca7-bded-de067fa5d652",
                        "source_entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "Sensibilitätsstörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sensibilitätsstörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f7ae771-9bdb-3add-9463-12295e2b58b0",
                                        "entry_id": "c6f61956-4fc7-3453-b95f-3409567af751",
                                        "glosses": [
                                            "veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9e1ad3-f17a-49d0-89ab-bba0801a9545",
                                                "sense_id": "1f7ae771-9bdb-3add-9463-12295e2b58b0",
                                                "text": "„Bei 3 Patienten war eine leichte Sensibilitätsstörung und eine leichte motorische Störung festzustellen.“"
                                            },
                                            {
                                                "example_id": "95ee9668-8851-46ab-b978-bc098af73c59",
                                                "sense_id": "1f7ae771-9bdb-3add-9463-12295e2b58b0",
                                                "text": "„Wir sahen 11 Fälle von Läsion gemischter Nerven ohne Sensibilitätsstörung, darunter 5 Plexus- und 4 Peroneusläsionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a761283-f891-4458-916b-01721a31e123",
                        "source_entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "Parästhesie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parästhesie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                        "entry_id": "9e4b0bc6-0f69-386e-8872-2507954b6e20",
                                        "glosses": [
                                            "Sensibilitätsstörung der Nerven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836f70a0-de41-4c2b-a0f9-f682f447ea84",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Es handelt sich im Wesentlichen um unbedeutende Komplikationen, wie Nachblutung, Schwellung, Hämatom oder eine temporäre Parästhesie.“"
                                            },
                                            {
                                                "example_id": "d5624128-0e8d-4f19-8df1-9fbe922e8d35",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Je eine Person meldete eine Schulterverletzung, Herzrhythmusstörungen sowie Taubheitsgefühl (Parästhesie) im Bein.“"
                                            },
                                            {
                                                "example_id": "e789a0ba-90e2-49e4-aea7-8a0231245172",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Häufig tritt eine sekundäre Hypophosphatämie mit Parästhesie und Schwächegefühl auf.“"
                                            },
                                            {
                                                "example_id": "4f4c6a69-0387-457c-bc88-cb35b2579c27",
                                                "sense_id": "4562ddb3-ebe8-3ea3-9536-857a294f59f2",
                                                "text": "„Mitunter visuelle Erscheinungen während des Anfalls und Parästhesien in den Händen, Füßen und der unteren Bauchgegend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "202d8289-0dd0-472e-8bb6-2d99cc9f18b0",
                        "source_entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                        "source_sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                        "source_sense_description": "sensation of burning, prickling, itching, or tingling of the skin with no obvious cause",
                        "target_lang_word": "Fehlempfindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlempfindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                        "entry_id": "d73c34d7-bac5-37b4-87ef-766456bae2ee",
                                        "glosses": [
                                            "veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c927f6-8603-4c61-8b78-82972a0e238e",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Dabei handelt es sich um eine Nervenstörung, die mit Fehlempfindungen beginnt und schließlich zu Muskelschwäche, Lähmung und Atemlähmung führt.“"
                                            },
                                            {
                                                "example_id": "ddd56f34-df74-4520-8557-55603a60e8c0",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Mit den Drogen versuchen FASD-Betroffene, zeitweilig einen Gefühlsausgleich zu erreichen und Fehlempfindungen zu kompensieren.“"
                                            },
                                            {
                                                "example_id": "e3a97529-bcea-4bf6-b177-6fcba5f38d74",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Diese führt über Fehlempfindungen zu Taubheitsgefühlen, so daß beim Diabetiker häufig die Schmerzphänomene geschwächt oder gar nicht auftreten.“"
                                            },
                                            {
                                                "example_id": "37dafbb6-1ec3-4329-adfe-289e0c910a4e",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Selbstverständlich müssen Fehlempfindungen oder sogar Kälteschmerzen erfragt und beachtet werden.“"
                                            },
                                            {
                                                "example_id": "d34e8720-5cf7-465b-974d-f42394bc4826",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Trotz zahlreicher charakteristischer parästhetischer Erscheinungen, läßt sich aus der Art der Fehlempfindung keine Krankheitsdiagnose stellen.“"
                                            },
                                            {
                                                "example_id": "525d639a-bcf4-4041-a696-1c2ea8f79610",
                                                "sense_id": "b98d30f8-5b21-3e95-9bb0-7d9ef63e43c1",
                                                "text": "„Reiben mit dem Eisball zur Durchblutungsförderung und Stimulation Fehlempfindungen oder sogar Kälteschmerzen erfragt und beachtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
