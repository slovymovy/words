                },
                {
                    "sense_id": "d4fe6390-b148-3525-b725-87b33353ec4b",
                    "sense_definition": "Tragfähiges Gitter aus Metallstäben, das zum Beispiel beim Grillen oder Heizen verwendet wird.",
