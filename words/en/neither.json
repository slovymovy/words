        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                    "sense_definition": "Similarly not; used to indicate that a negative statement also applies to another person or thing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never been to Paris, and <w>neither</w> has she.",
                            "target_lang_translations": {
                                "ru": "Я никогда не был в Париже, и она <w>тоже не</w> была.",
                                "tr": "Ben Paris'te hiç bulunmadım, o <w>da</w> bulunmadı.",
                                "zh": "我从没去过巴黎，她<w>也没</w>去过。",
                                "nl": "Ik ben nog nooit in Parijs geweest en zij <w>ook niet</w>.",
                                "pl": "Nigdy nie byłem w Paryżu i ona <w>też nie</w>.",
                                "de": "Ich war noch nie in Paris und sie <w>auch nicht</w>.",
                                "fr": "Je ne suis jamais allé à Paris, et elle <w>non plus</w>.",
                                "it": "Non sono mai stato a Parigi e <w>nemmeno</w> lei.",
                                "cs": "Nikdy jsem nebyl v Paříži a ona <w>také ne</w>.",
                                "es": "Nunca he estado en París y ella <w>tampoco</w>."
                            }
                        },
                        {
                            "text": "\"I don't like spinach.\" — \"<w>Neither</w> do I.\"",
                            "target_lang_translations": {
                                "ru": "«Я не люблю шпинат». — «Я <w>тоже не</w> люблю».",
                                "tr": "\"Ispanak sevmem.\" — \"Ben <w>de</w>.\"",
                                "zh": "“我不喜欢菠菜。”——“我<w>也不</w>喜欢。”",
                                "nl": "\"Ik houd niet van spinazie.\" — \"Ik <w>ook niet</w>.\"",
                                "pl": "„Nie lubię szpinaku”. — „Ja <w>też nie</w>”.",
                                "de": "„Ich mag keinen Spinat.“ – „Ich <w>auch nicht</w>.“",
                                "fr": "« Je n'aime pas les épinards. » — « Moi <w>non plus</w>. »",
                                "it": "\"Non mi piacciono gli spinaci.\" — \"<w>Neanche</w> a me.\"",
                                "cs": "„Nemám rád špenát.“ — „Já <w>také ne</w>.“",
                                "es": "—No me gustan las espinacas. —A mí <w>tampoco</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "me neither",
                        "neither do I",
                        "neither can I"
                    ],
                    "target_lang_definitions": {
                        "ru": "Также не; используется для указания, что отрицательное утверждение относится и к другому лицу или предмету.",
                        "tr": "Benzer şekilde değil; olumsuz bir ifadenin başka bir kişi veya şey için de geçerli olduğunu belirtmek için kullanılır.",
                        "zh": "也（不）；用于表示对前述否定陈述的认同。",
                        "nl": "Ook niet; gebruikt om aan te geven dat een negatieve uitspraak ook op een ander persoon of ding van toepassing is.",
                        "pl": "Również nie; używane do wskazania, że negatywne stwierdzenie odnosi się także do innej osoby lub rzeczy.",
                        "de": "Ebenfalls nicht; wird verwendet, um auszudrücken, dass eine negative Aussage auch auf eine andere Person oder Sache zutrifft.",
                        "fr": "Également non ; utilisé pour indiquer qu'une déclaration négative s'applique aussi à une autre personne ou chose.",
                        "it": "Anche non; usato per indicare che un'affermazione negativa si applica anche a un'altra persona o cosa.",
                        "cs": "Podobně ne; používá se k vyjádření, že záporné tvrzení platí i pro jinou osobu nebo věc.",
                        "es": "De igual manera no; se usa para indicar que una afirmación negativa también se aplica a otra persona o cosa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то́же не",
                                "target_lang_sense_clarification": "согласие с отрицанием"
                            },
                            {
                                "target_lang_word": "та́кже не",
                                "target_lang_sense_clarification": "формальное согласие с отрицанием"
                            }
                        ],
                        "tr": [
