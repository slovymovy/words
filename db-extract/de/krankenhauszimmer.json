                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "палата",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "43fcd166-6403-33f5-9ec8-c32b7b2cca4e",
                                        "entry_id": "64c7c1a7-187e-3c61-a480-626052cc3c06",
                                        "glosses": [
                                            "истор. большое богатое здание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a783b9-e5da-49a7-be87-123504c579d0",
                                                "sense_id": "43fcd166-6403-33f5-9ec8-c32b7b2cca4e",
                                                "text": "Владычная или Грановитая палата новгородского кремля — одно из интереснейших зданий некогда большого комплекса сооружений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e4b51c2-3ec8-3075-ac8e-26734b6193cb",
                                        "entry_id": "64c7c1a7-187e-3c61-a480-626052cc3c06",
                                        "glosses": [
                                            "отдельное помещение в лечебном заведении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7065eb76-362a-4f68-b5ef-2ab4ef947c04",
                                                "sense_id": "5e4b51c2-3ec8-3075-ac8e-26734b6193cb",
                                                "text": "Палаты травматологического отделения больницы полны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bcd6769-594d-34db-be7e-9dd605cfe4b7",
                                        "entry_id": "64c7c1a7-187e-3c61-a480-626052cc3c06",
                                        "glosses": [
                                            "название представительного учреждения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5280f01e-ff35-4b3a-9828-ea50186e2ef5",
                                                "sense_id": "9bcd6769-594d-34db-be7e-9dd605cfe4b7",
                                                "text": "Совет Федерации Федерального Собрания России, или Верхняя палата российского парламента, собрался на свое первое заседание в январе 1994 года."
                                            },
                                            {
                                                "example_id": "8393a8ae-6fa6-4f74-a35d-ec9973a54509",
                                                "sense_id": "9bcd6769-594d-34db-be7e-9dd605cfe4b7",
                                                "text": "Международная торговая палата — это независимая некоммерческая международная организация."
                                            },
                                            {
                                                "example_id": "e6d39229-8d16-4ba8-abcd-0bc535131e3d",
                                                "sense_id": "9bcd6769-594d-34db-be7e-9dd605cfe4b7",
                                                "text": "Президент встретился с советом Общественной палаты."
                                            },
                                            {
                                                "example_id": "ff78c845-4820-43ba-8c16-a366f8a08017",
                                                "sense_id": "9bcd6769-594d-34db-be7e-9dd605cfe4b7",
                                                "text": "Вознаграждение за оказание бесплатной юридической помощи гражданам РФ производят адвокатские палаты. ←…→ Наконец, закон называет четыре статьи расходов, по которым адвокаты обязаны производить отчисления из получаемого вознаграждения: на общие нужды адвокатской палаты (размер определяется собранием или конференцией адвокатов); на содержание соответствующего адвокатского образования; на страхование профессиональной ответственности и на «иные расходы»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d3c6b1-afae-3412-bd4e-5cc715781094",
                                        "entry_id": "64c7c1a7-187e-3c61-a480-626052cc3c06",
                                        "glosses": [
                                            "общая спальня в детском лагере, интернате, закрытом учебном заведении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855fc233-3dad-495a-8088-0723bf558fc8",
                                                "sense_id": "65d3c6b1-afae-3412-bd4e-5cc715781094",
                                                "text": "Спать, спать по палатам пионерам, октябрятам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
