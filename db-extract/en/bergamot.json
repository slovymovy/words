                        "entry_id": "4c980cd6-4ab4-37d4-972c-bc3131f33b40",
                        "glosses": [
                            "The fruit from the bergamot tree."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fb2600cc-2585-3766-a3b8-fea1df0b1680",
                        "entry_id": "4c980cd6-4ab4-37d4-972c-bc3131f33b40",
                        "glosses": [
                            "The essence or perfume made from the fruit."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "adf64efe-5085-32f9-b576-6e15b9fdd5f5",
                        "entry_id": "4c980cd6-4ab4-37d4-972c-bc3131f33b40",
                        "glosses": [
                            "A variety of snuff perfumed with bergamot."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
