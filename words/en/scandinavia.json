                {
                    "sense_id": "dda1b4bc-844e-34d2-9457-ecf9401a0c96",
                    "sense_definition": "A geographic region of Northern Europe, consisting of Denmark, Norway, and Sweden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Many people travel to <w>Scandinavia</w> to see the beautiful northern lights.",
                            "target_lang_translations": {
                                "zh": "许多人前往<w>斯堪的纳维亚</w>观赏美丽的北极光。"
                            }
                        },
                        {
                            "text": "The countries in <w>Scandinavia</w> are known for their high quality of life.",
                            "target_lang_translations": {
                                "zh": "<w>斯堪的纳维亚</w>各国以其高质量的生活水平而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel to Scandinavia",
                        "visit Scandinavia"
                    ],
                    "target_lang_definitions": {
                        "zh": "北欧的一个地理区域，包括丹麦、挪威和瑞典。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯堪的纳维亚",
                                "target_lang_sense_clarification": "指代北欧国家组成的地理区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43bd2869-e312-30c7-8132-5c7348cbcf80",
                    "sense_definition": "A large peninsula in Northern Europe, comprising Norway, Sweden, and part of Finland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Scandinavia</w> peninsula is characterized by its rugged mountains and deep fjords.",
                            "target_lang_translations": {
                                "zh": "<w>斯堪的纳维亚</w>半岛的特点是崎岖的山脉和深邃的峡湾。"
                            }
                        },
                        {
                            "text": "Geologically, the <w>Scandinavia</w> region is dominated by the Scandinavian Mountains.",
                            "target_lang_translations": {
                                "zh": "从地质学角度来看，<w>斯堪的纳维亚</w>地区主要由斯堪的纳维亚山脉构成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Scandinavian Peninsula"
                    ],
                    "target_lang_definitions": {
                        "zh": "北欧的一个大半岛，包括挪威、瑞典和芬兰的部分地区。"
