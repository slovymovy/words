                        "glosses": [
                            "Injektion, deren Wirkstoff den Appetit einer Person reduziert und so eine Gewichtsabnahme bewirken soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3615c8f5-209e-47d8-9327-62a6f0e52393",
                                "sense_id": "fe038fcb-5cc8-3a35-a321-1e6c5b37c4d0",
                                "text": "„Der Gewichtsverlust von Elon Musk hat Abnehmspritzen ins Gespräch gebracht.“"
                            },
                            {
                                "example_id": "088206d7-3d7e-4191-9b73-1228083c5ecf",
                                "sense_id": "fe038fcb-5cc8-3a35-a321-1e6c5b37c4d0",
                                "text": "„Kaum ein Medikament befindet sich so in aller Munde wie die sogenannte Abnehmspritze.“"
                            },
                            {
                                "example_id": "e35f5ff3-1f44-49ec-9d85-7f42d51421d4",
                                "sense_id": "fe038fcb-5cc8-3a35-a321-1e6c5b37c4d0",
                                "text": "„Starkes Übergewicht ist auch bei vielen Kindern schon ein großes Problem – umso mehr, da fettleibige Kinder sehr oft adipöse Erwachsene werden. Für Erwachsene gibt es inzwischen etwa Abnehmspritzen, die helfen können.“"
                            }
                        ],
