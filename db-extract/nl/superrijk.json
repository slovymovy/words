                        "glosses": [
                            "in het bezit van uitzonderlijk veel geld en andere eigendommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872e4099-6764-436f-a818-9b59b7b23ff4",
                                "sense_id": "d04fe662-91cc-308d-8f70-a7ed7891f095",
                                "text": "Een succesvolle ondernemer beschikt over 20 miljoen euro. In de ogen van velen is zo iemand superrijk en dat is natuurlijk ook zo. Gemiddeld heeft hij 10 miljoen vast zitten in onroerend goed: een prachtig huis, een villa in het buitenland en een of twee appartementen voor de kinderen. De andere 10 miljoen is belegd en van de opbrengst leeft hij in luxe."
                            }
                        ]
                    }
