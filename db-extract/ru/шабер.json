                ],
                "senses": [
                    {
                        "sense_id": "4da78340-47ea-3ee8-b52b-6d8b26fbeba6",
                        "entry_id": "69b4a438-4347-30a6-9108-26c4a883dcb2",
                        "glosses": [
                            "спец. режущий инструмент, предназначенный для выравнивания поверхности металлических изделий соскабливанием очень тонкой стружки (род стамески)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d07d799-4db7-4a94-8261-b42212a60873",
                                "sense_id": "4da78340-47ea-3ee8-b52b-6d8b26fbeba6",
                                "text": "Но ведь инженер пришёл сюда не затем, чтобы любоваться неисчислимыми сокровищами: не золото и серебро ему нужны, а быстрорежущая сталь, ему нужен не столько шабер, сколько грубая обдирка, грубое надёжное зубило, ведь не шабером же будет он выбирать шпунт у ахтерштевня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30ace9bf-13de-489a-ae4f-afae9b0f7573",
                        "source_entry_id": "69b4a438-4347-30a6-9108-26c4a883dcb2",
                        "source_sense_id": "4da78340-47ea-3ee8-b52b-6d8b26fbeba6",
                        "target_lang_word": "Abstreicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "63d92d0a-c70e-4e0b-aff8-ab1c7681c53d",
                        "source_entry_id": "69b4a438-4347-30a6-9108-26c4a883dcb2",
                        "source_sense_id": "4da78340-47ea-3ee8-b52b-6d8b26fbeba6",
                        "target_lang_word": "Schabeisen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "63046037-ded1-4233-a1e1-736d97ae057b",
                        "source_entry_id": "69b4a438-4347-30a6-9108-26c4a883dcb2",
                        "source_sense_id": "4da78340-47ea-3ee8-b52b-6d8b26fbeba6",
                        "target_lang_word": "Schaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08c7c507-8767-3322-81fb-e8f8d7c592bc",
                                        "entry_id": "d62a5689-3bd0-3fd5-92e6-f3e72898780c",
                                        "glosses": [
                                            "Werkzeug/Gerät, das zum Schaben/Kratzen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341c34ce-c48d-4bc1-8736-3121b82c0941",
                                                "sense_id": "08c7c507-8767-3322-81fb-e8f8d7c592bc",
                                                "text": "„Danach auf Teigstufe 2 Minuten kneten, dabei eventuell den Teig mit dem Schaber nach unten schieben.“"
                                            },
                                            {
                                                "example_id": "0dc6eac0-c538-40c2-92e1-67bc25d0ffef",
                                                "sense_id": "08c7c507-8767-3322-81fb-e8f8d7c592bc",
                                                "text": "„Bearbeiten Sie Ihr Kochfeld mit dem Schaber behutsam, um irreparable Kratzer zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
