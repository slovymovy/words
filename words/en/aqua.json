            "senses": [
                {
                    "sense_id": "622e6794-1b40-3cef-951d-8c5afc60ac53",
                    "sense_definition": "A shade of color that is a mix of blue and green, similar to turquoise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used shimmering <w>aquas</w> and gold leaf for the mural.",
                            "target_lang_translations": {
                                "ru": "Для росписи художник использовал мерцающие <w>аквамариновые оттенки</w> и сусальное золото."
                            }
                        },
                        {
                            "text": "We decided to paint the bathroom in a light <w>aqua</w> to make it feel fresh.",
                            "target_lang_translations": {
                                "ru": "Мы решили покрасить ванную в светло-<w>бирюзовый</w> цвет, чтобы она казалась свежее."
                            }
                        }
                    ],
                    "synonyms": [
                        "aquamarine"
                    ],
                    "common_phrases": [
                        "shimmering aquas",
                        "shade of aqua"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оттенок цвета, представляющий собой смесь синего и зеленого, похожий на бирюзовый."
                    },
                    "translations": {
