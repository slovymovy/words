                "senses": [
                    {
                        "sense_id": "c03a8822-7f59-31e5-8fe8-ec7807cf013b",
                        "entry_id": "af8d2481-971c-31eb-8884-186a560e746d",
                        "glosses": [
                            "Person, die im Internet agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be373823-c316-4eb0-ab5b-55a1fd029ca2",
                                "sense_id": "c03a8822-7f59-31e5-8fe8-ec7807cf013b",
                                "text": "Damit spielt sie zu Recht auf die Tatsache an, dass engagierte Netizen nie nur ›neutrale‹ Technik einrichten und verwalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11a4334c-0c57-4174-8c55-eb7697d10cf4",
                        "source_entry_id": "af8d2481-971c-31eb-8884-186a560e746d",
                        "source_sense_id": "c03a8822-7f59-31e5-8fe8-ec7807cf013b",
                        "source_sense_description": "Person, die im Internet agiert",
                        "target_lang_word": "netizen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "netizen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                        "entry_id": "2eb08958-1744-31c9-88cc-c886edfaf428",
                                        "glosses": [
                                            "A member of the community of Internet users."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6754490-f660-488a-a19b-9317e6a04cfb",
                                                "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                                "text": "The netizen posted their question on the forum."
                                            },
                                            {
                                                "example_id": "e0882ee3-11c2-4660-99e4-de13784f5737",
                                                "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                                "text": "Do we have to learn a new kind of language — ‘Netspeak’, as I shall call it — in order to be a netizen?"
                                            },
                                            {
                                                "example_id": "882247da-05f5-43e4-9e4b-b218e5849e81",
                                                "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                                "text": "It appeared by Wednesday evening that Congress would follow Bank of America, Netflix and Verizon as the latest institution to change course in the face of a netizen revolt."
                                            },
                                            {
                                                "example_id": "ce674e7f-b25a-4e3c-9f94-77e557ae468a",
                                                "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                                "text": "A $25,000 (£19,000) prize pool was established to reward the best solutions, and the competition was hosted on Kaggle – a Google-owned platform used by more than a million netizens to build AI models, find and share datasets, and collaborate with fellow Kagglers."
                                            },
                                            {
                                                "example_id": "e898dad9-a524-408e-82d4-dde4436ec755",
                                                "sense_id": "baa340ea-580b-3a75-8f89-4d52f0636b6c",
                                                "text": "The use of the term \"West Taiwan\" (西台灣) to mock China has steadily grown in popularity since January 2020 when President Tsai Ing-wen (蔡英文) said that Beijing needs to face the reality that Taiwan is already an independent country. At the time, netizens conjured terms such as \"Mainland Taiwan,\" \"Taiwanese Beijing,\" and \"West Taiwan\" to agitate Chinese nationalists, censors, and trolls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
