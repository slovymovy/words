                        "sense_id": "ec200e59-43ff-34ce-9324-157c50d7981c",
                        "entry_id": "07a47886-8850-3fa5-be8b-b2a31a33c244",
                        "glosses": [
                            "versteifendes Gerüst in einem Reitsattel"
