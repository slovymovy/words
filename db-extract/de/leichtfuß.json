                "senses": [
                    {
                        "sense_id": "4bc31774-799d-3103-b1ce-abb26cba112c",
                        "entry_id": "2e6039a1-ffcf-31aa-9251-cfb9a2b9cbf0",
                        "glosses": [
                            "jemand, dem Leichtfertigkeit und Leichtsinnigkeit anhaften"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "622545e7-aba1-4d44-86e6-f7ed2071d579",
                                "sense_id": "4bc31774-799d-3103-b1ce-abb26cba112c",
                                "text": "Ein solcher Leichtfuß wie der Verlobte meiner Nichte ist mir mein Lebtag noch nicht untergekommen."
                            },
                            {
                                "example_id": "b8274c22-8899-4119-9bc9-217021b9e6ab",
                                "sense_id": "4bc31774-799d-3103-b1ce-abb26cba112c",
                                "text": "„Leo wird sich davon einen guten Tag machen; er ist ein Leichtfuß, woran ich aber keine moralischen Betrachtungen knüpfe, denn auch die Leichtfüße sind mir sympathisch, vorausgesetzt, daß Anstand und gute Gesinnung in dem leichten Leben nicht untergehen.“"
                            },
                            {
                                "example_id": "9e0d738c-b00d-4650-9d36-e8b46e09a019",
                                "sense_id": "4bc31774-799d-3103-b1ce-abb26cba112c",
                                "text": "„Der Mann war ein Leichtfuß, der seine Frau vielleicht sehr liebte; aber dem guten Ton zuliebe fühlte er sich verpflichtet, den Gleichgültigen zu spielen, und gefiel sich aus Eitelkeit darin, ihr Anlaß zur Eifersucht zu geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbaee428-efc9-480e-8bb0-6d811d263088",
                        "source_entry_id": "2e6039a1-ffcf-31aa-9251-cfb9a2b9cbf0",
                        "source_sense_id": "4bc31774-799d-3103-b1ce-abb26cba112c",
                        "source_sense_description": "umgangssprachlich: jemand, dem Leichtfertigkeit und Leichtsinnigkeit anhaften",
                        "target_lang_word": "étourdi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étourdi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e93eac-dfc5-3e13-9899-cba272e3459a",
                                        "entry_id": "5cb5ec6f-4455-3456-84ae-ae921fad678b",
                                        "glosses": [
                                            "Qui agit sans réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b38d824-ac30-4ad9-bb83-7c0d7437afbc",
                                                "sense_id": "d6e93eac-dfc5-3e13-9899-cba272e3459a",
                                                "text": "Madame Duménil n’était pas d’un caractère à la dédommager de sa première amie : légère, étourdie, folle même, elle riait de tout, ne s’intéressait à rien ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f9908c-5ab3-3957-846e-94886825045a",
                                        "entry_id": "5cb5ec6f-4455-3456-84ae-ae921fad678b",
                                        "glosses": [
                                            "Qui a la tête qui tourne, qui a le vertige."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "étourdi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a55ec09-71f7-33c7-9538-1eef09a99e00",
                                        "entry_id": "090e4892-6583-350d-81ee-7b987e90f683",
                                        "glosses": [
                                            "Personne qui agit sans réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd22f40-b2e2-4f47-b961-b0ec28fb04f7",
                                                "sense_id": "1a55ec09-71f7-33c7-9538-1eef09a99e00",
                                                "text": "Or, si le jeune étourdi qui se chargera d’aimer Mme de Rochefide avait des démêlés avec Calyste, qu’il s’en suivît quelque duel…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étourdi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fac20fdb-070e-39e4-83a8-d9981d1528a8",
                                        "entry_id": "e323c8ac-42c1-31c0-b3ca-04ecd836b624",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe étourdir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "692f2a3d-1392-466f-9007-19d29a0e47d4",
                                                "sense_id": "fac20fdb-070e-39e4-83a8-d9981d1528a8",
                                                "text": "T’aimer comme le mistral souffle.\nTe prendre, étourdi, comme il saisit la feuille du platane pour la transporter au gré de son désir ; t’obliger à fermer les yeux, à tendre les bras, te voir chanceler et t’abattre pour te relever, pour emprisonner tes mains dans les miennes, pour endormir ton cœur éperdu.\nT’aimer comme le mistral souffle, pour te rendre fou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
