        "nl-extract.jsonl": [
            {
                "entry_id": "295783d1-d81d-39ad-874b-74508f2fb5d6",
                "word": "verrassend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14d09fe4-d835-3af3-a5b8-6a4ae2a8c8ce",
                        "entry_id": "295783d1-d81d-39ad-874b-74508f2fb5d6",
                        "glosses": [
                            "iets onverwachts veroorzakend vooral in de leuke zin van het woord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126e4a65-f09a-46e4-8ff3-9c6c33e04b59",
                                "sense_id": "14d09fe4-d835-3af3-a5b8-6a4ae2a8c8ce",
                                "text": "De ouders waren heel blij toen de kinderen hun een verrassende stedentrip cadeau gaven."
                            },
                            {
                                "example_id": "2807789f-9f10-4439-9a4f-c280be66ff66",
                                "sense_id": "14d09fe4-d835-3af3-a5b8-6a4ae2a8c8ce",
                                "text": "De stijgende beurskoes was een verrassende ontwikkeling voor de aandeelhouder."
                            },
                            {
                                "example_id": "d9eb31e6-ca01-4b68-bbcb-775bdb1090de",
                                "sense_id": "14d09fe4-d835-3af3-a5b8-6a4ae2a8c8ce",
                                "text": "Het was de uitkomst van een zenuwslopende stemming waarbij Laurence, de absolute topfavoriet van de bookmakers, bij de jury enigszins teleurstellend als derde eindigde met 231 punten. Zweden won bij de vakjury’s voor het verrassende Noord-Macedonië."
                            },
                            {
                                "example_id": "3ac7ae58-49d5-4a79-bf2f-9e3e69a647f9",
                                "sense_id": "14d09fe4-d835-3af3-a5b8-6a4ae2a8c8ce",
                                "text": "De Engelsen hadden verrassend veel sympathisanten onder de Zweden, het gespreksonderwerp was hoogst ongemakkelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "b329b9ca-663a-385f-aea8-a4622979fb53",
                        "entry_id": "295783d1-d81d-39ad-874b-74508f2fb5d6",
                        "glosses": [
                            "opmerkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ba0f1c-192a-482c-8ad2-1eceb1ce76a9",
                                "sense_id": "b329b9ca-663a-385f-aea8-a4622979fb53",
                                "text": "Niet dat The Favourite zich iets aantrekt van de werkelijkheid, of hoe die werkelijkheid er in films over die periode doorgaans uitziet. Dat komt door het smeuïge scenario van Deborah Davis en Tony McNamara, vol seks en jaloezie, verraad en vulgariteiten. Het woord ‘kutwijf’ valt verrassend vaak."
                            }
                        ]
                    }
