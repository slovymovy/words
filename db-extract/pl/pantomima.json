                "senses": [
                    {
                        "sense_id": "07933f29-69ba-3062-9c02-4b7ec4bddb9c",
                        "entry_id": "a210902b-99af-3ccf-bd65-28a8788045e1",
                        "glosses": [
                            "widowisko sceniczne, w którym treść przekazywana jest tylko za pomocą ruchu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53a7874-ab01-404f-b939-746d443060bd",
                                "sense_id": "07933f29-69ba-3062-9c02-4b7ec4bddb9c",
                                "text": "Taniec dawał jej elegancję ruchów, poruszała się wyraziście, jak w pantomimie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "354c4069-1dd2-48a3-b99f-b83f913a638b",
                        "source_entry_id": "a210902b-99af-3ccf-bd65-28a8788045e1",
                        "source_sense_id": "07933f29-69ba-3062-9c02-4b7ec4bddb9c",
                        "target_lang_word": "mime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42dac01f-08b9-3c6c-8543-9784a7f1ba8c",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A form of acting without words; pantomime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b82aff-5117-4454-8b29-581e7f075ef2",
                                                "sense_id": "42dac01f-08b9-3c6c-8543-9784a7f1ba8c",
                                                "text": "[Silence] demands returning to the self, to innocence and a a portrayal of situations as if all the particulars were completely unknown to the viewer. There are no props but the muscular versatility of the human form. Mime is the one thing that truly proves we can be all things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa8bb5e-4c35-38de-8784-e0a5325539d6",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A pantomime actor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3d1f9da-6e53-36f8-978d-a9947963b03c",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A classical theatrical entertainment in the form of farce."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c07f2ee-3916-4522-980e-b1b39a0f00ad",
                                                "sense_id": "a3d1f9da-6e53-36f8-978d-a9947963b03c",
                                                "text": "The mimes were packed with lascivious gestures and movements, and usually presented erotic scenes, on occasion farcically treated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67cbb7b8-2bc1-3d5a-952c-c94d0dc06dba",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A performer of such a farce."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4454a042-0d6b-3dfd-99a2-bd75c5bdcb41",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "A person who mimics others in a comical manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa24a89d-b7ce-37cf-9699-c8fa680da7f3",
                                        "entry_id": "9f2439a5-63fb-30c2-9845-284d692dab65",
                                        "glosses": [
                                            "Any of various papilionid butterflies of the genus Chilasa or Papilio, that mimic other species in appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
