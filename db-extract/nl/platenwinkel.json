                            {
                                "example_id": "aaccfb67-2339-42f6-b2e7-c1921576958e",
                                "sense_id": "e27af8e0-8d84-3a44-9a65-c3fd42cca616",
                                "text": "Mischa had hem leren kennen toen hij in een platenwinkel in East Village werkte en volgens haar ging het gerucht dat hij de enige was die binnenkort echt zijn Pollock-moment zou beleven."
                            },
                            {
                                "example_id": "01fcb71e-2df6-4fe0-b8a9-ece4789b0c5a",
                                "sense_id": "e27af8e0-8d84-3a44-9a65-c3fd42cca616",
                                "text": "Dat vinyl stukken beter verkoopt dan een paar jaar terug, merken ze ook in platenwinkels. \"Wij zijn in 2005 weer begonnen met meer vinyl aanbieden en dat is uitgegroeid tot wat het nu is. De verkoop is enorm toegenomen\", zegt Anton Speijers van platenwinkel Concerto in Amsterdam."
                            }
                        ]
                    },
