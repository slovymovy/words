                "senses": [
                    {
                        "sense_id": "019bec05-2928-3028-be77-0239e02d3470",
                        "entry_id": "8adf50a7-fd39-3384-a844-5ca55ca2f958",
                        "glosses": [
                            "Donner un caractère éphémère à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac24ae6d-26d3-4cb5-a3e9-35ae93ff1d42",
                                "sense_id": "019bec05-2928-3028-be77-0239e02d3470",
                                "text": "On doit pourtant se demander pourquoi l’on veut éphémériser pour comparer, surtout si l’on songe que la mémoire du passé disparaît de nos jours à vive allure ... à moins évidemment qu’on cherche à accélérer le mouvement."
                            },
                            {
                                "example_id": "b628cc70-f4ba-4352-bd19-d916735ee5ba",
                                "sense_id": "019bec05-2928-3028-be77-0239e02d3470",
                                "text": "L’industrie alimentaire s’est faite ainsi une spécialité de ses (fausses) innovations servant notamment à éphémériser le produit."
                            }
                        ]
                    }
                ],
