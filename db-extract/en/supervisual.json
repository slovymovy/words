                        "glosses": [
                            "Strongly or predominantly visual."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d72566a8-3082-4700-9a4b-e35d7d8d5371",
                                "sense_id": "2d24e2ce-412e-3f35-a7e8-2ba08daab8e3",
                                "text": "The heightened attention to issues of representation is precipitated, in good part, by the advent of new, supervisual media."
                            },
                            {
                                "example_id": "56863229-1304-462b-917f-328d7b568792",
                                "sense_id": "2d24e2ce-412e-3f35-a7e8-2ba08daab8e3",
                                "text": "Social media is supervisual, and there's nothing more shareable than images, so this is a way to increase shares and likes and follows."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f4cbf5a-1db5-3996-99f0-25642b3f5224",
                        "entry_id": "efda74d4-0e9d-3320-a0c2-27493f3aa3d4",
                        "glosses": [
                            "Beyond the threshold of vision, thus invisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ffb68f8-053f-4a0a-8498-6d794b5568ab",
                                "sense_id": "2f4cbf5a-1db5-3996-99f0-25642b3f5224",
                                "text": "So we build equipment to see light beyond the rainbow's spectrum, supervisual light like x-rays, and sub-visual light like radio waves."
                            }
                        ]
                    }
