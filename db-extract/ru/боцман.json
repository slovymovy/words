                                        "entry_id": "6a3bbeeb-4495-31b3-b5a9-9ad35fbd805c",
                                        "glosses": [
                                            "Alternative form of boatswain (“warrant or petty officer on board a naval ship”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf68f85d-5470-4839-9a48-9979bcb3a8be",
                                                "sense_id": "446e86c2-5a47-34e9-b803-f671cd070f06",
                                                "text": "They tied us up—the fellow who handled me could tie like a bosun—and there we lay with our toes up, beneath a tree, while a great brute stood guard over us with a club in his hand."
                                            }
                                        ]
                                    }
                                ]
