                    {
                        "translation_id": "38b980eb-a63d-41aa-a609-424233c73c80",
                        "source_entry_id": "9f446324-3c3f-33e4-bd49-d0bea6bb5a9b",
                        "source_sense_description": "skeptical, scornful or pessimistic attitude",
                        "target_lang_word": "цини́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цини́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "39ff3678-a46e-38ac-879b-13081da5348c",
                                        "entry_id": "55517521-ae66-386e-99d7-bfd7ad73274e",
                                        "glosses": [
                                            "истор. учение циников (киников)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ef2b3f-4e1f-4541-821d-4039b2d7d893",
                                                "sense_id": "39ff3678-a46e-38ac-879b-13081da5348c",
                                                "text": "Популярный цинизм учит не отказу от благ этого мира, а лишь некоторому безразличию к ним. Что касается тех, кто берет взаймы, то цинизм всячески преуменьшает его обязательства по отношению к заимодавцу. Видно, как слова «циничный», «циник» приобрели свое теперешнее значение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                        "entry_id": "55517521-ae66-386e-99d7-bfd7ad73274e",
                                        "glosses": [
                                            "грубая откровенность, бесстыдство, пренебрежительное отношение к нормам нравственности, благопристойности, к чему-либо пользующемуся всеобщим признанием, уважением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77afd77-564c-4a1e-ba37-f9a0ed2a5b04",
                                                "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                                "text": "Это была такая грязь, такое сало, такой цинизм и насмешка над чувством, что даже Розанов не утерпел, встал и подошел к Райнеру."
                                            },
                                            {
                                                "example_id": "63201e2d-ae50-4ef9-a417-121375a11ca9",
                                                "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                                "text": "Бывает и обратно: образование уживается иногда с таким варварством, с таким цинизмом, что вам мерзит, и, как бы вы ни были добры или предубеждены, вы не находите в сердце своем ни извинений, ни оправданий."
                                            },
                                            {
                                                "example_id": "bec0a28a-d98a-4e1d-af64-52c65c125f62",
                                                "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                                "text": "Разнузданность и цинизм танцорок достигали до такой степени, что приезжие истые парижане не верили глазам своим, уверяли, что у них в Париже ничего равного этому и нет, и не было, и не видывано, и бесконечно удивлялись par le principe de la liberté russe."
                                            },
                                            {
                                                "example_id": "73afa6ba-ca6d-4f72-9e67-f16c40dc7880",
                                                "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                                "text": "Советский строй приучил всех к величайшему цинизму в отношении бумажек."
                                            },
                                            {
                                                "example_id": "decf2c7a-c23f-42c8-a15c-79c5e0e2ae88",
                                                "sense_id": "371ac09a-d7a2-320a-aa0a-15a0bf12182e",
                                                "text": "В более резких случаях выступают на сцену цинизм в речи и поведении, полная утрата чувства стыдливости с бесстыдным обнажением половых органов, с мастурбацией."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
