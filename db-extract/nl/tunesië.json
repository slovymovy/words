                                            {
                                                "example_id": "ddfdf139-1271-49fa-b93d-284926b29ed8",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Die Einwohnerzahl Tunesiens beträgt etwa 10 Millionen."
                                            },
                                            {
                                                "example_id": "a3972b4f-c518-448f-9a80-ac8a176d9d95",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Das Tunesien der Neuzeit ist eine Präsidialrepublik."
                                            },
                                            {
                                                "example_id": "b5105ce6-bf9d-40d9-9f71-2fb6a20a8a8e",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Tunis ist die Hauptstadt von Tunesien."
                                            },
                                            {
                                                "example_id": "702365a3-7fdb-44ed-beab-a4590a0aaab5",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "„Die letzten Kilometer in Tunesien führten mich über den außerirdisch anmutenden Chott el Jerid, einen riesigen Salzsee, der in allen denkbaren Schattierungen von Pink und Lila das Sonnenlicht reflektierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
