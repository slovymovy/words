                    "frequency": "Middle",
                    "semantic_group_id": "vermogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij ernstig hersenletsel kan de <w>spraak</w> van een patiënt nadelig beïnvloed worden.",
                            "target_lang_translations": {
                                "en": "In cases of severe brain injury, a patient's <w>speech</w> can be adversely affected."
                            }
                        },
                        {
                            "text": "Na het ongeluk was hij tijdelijk zijn <w>spraak</w> verloren en kon hij niet communiceren.",
                            "target_lang_translations": {
                                "en": "After the accident, he had temporarily lost his <w>speech</w> and was unable to communicate."
                            }
                        }
                    ],
                    "synonyms": [
