                "senses": [
                    {
                        "sense_id": "069183a5-e069-31bf-b006-23f7bc66d600",
                        "entry_id": "ccadfb17-2ea1-3635-9ced-588c6923ae55",
                        "glosses": [
                            "Handlung des Mähens von Gras, das anschließend getrocknet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7cf3de-54ae-45fe-b31f-5c6f4147de42",
                                "sense_id": "069183a5-e069-31bf-b006-23f7bc66d600",
                                "text": "„Robinson zog sich noch mehrmals in die Verborgenheit der Höhle zurück, aber durch die Kornernte und die Heumahd wurde er davon abgelenkt.“"
                            },
                            {
                                "example_id": "ac6c79fe-21ed-4a5a-b36b-eabf503b19ec",
                                "sense_id": "069183a5-e069-31bf-b006-23f7bc66d600",
                                "text": "„Im weiteren ereignete sich während der Heumahd nichts von Bedeutung.“"
                            },
                            {
                                "example_id": "8b54c23f-db09-4081-a75f-4e6475ff9664",
                                "sense_id": "069183a5-e069-31bf-b006-23f7bc66d600",
                                "text": "„Steinunn steht noch mit der Karte in der Hand, Gísli sitzt auf ihrem Ehebett und guckt, als würde er an Schafe oder Heumahd denken.“"
                            }
                        ],
