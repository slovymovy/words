{
    "word_family": [
        "nuclear",
        "nucleate",
        "nucleation",
        "nucleolus",
        "nucleic",
        "nucleotide",
        "nucleon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84ff17c6-a1f8-3b8e-bf16-26b3186d9efe",
                    "sense_definition": "A large organelle enclosed by a membrane in eukaryotic cells that contains genetic material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cell_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "DNA is safely stored inside the <w>nucleus</w> of a plant or animal cell.",
                            "target_lang_translations": {
                                "zh": "DNA被安全地储存在动植物细胞的<w>细胞核</w>中。"
                            }
                        },
                        {
                            "text": "The students looked through a microscope to find the cell <w>nucleus</w>.",
                            "target_lang_translations": {
                                "zh": "学生们透过显微镜观察，以寻找<w>细胞核</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cell nucleus"
                    ],
                    "target_lang_definitions": {
                        "zh": "真核细胞中由膜包裹的大型细胞器，内含遗传物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "细胞核",
                                "target_lang_sense_clarification": "真核细胞的结构"
                            },
                            {
                                "target_lang_word": "核",
                                "target_lang_sense_clarification": "细胞核的简写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9788f31e-3fc8-3bb8-86f0-681fdf6b34fb",
                    "sense_definition": "The dense, positively charged central core of an atom, composed of protons and neutrons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physics_chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Electrons orbit around the dense <w>nucleus</w> at high speeds.",
                            "target_lang_translations": {
                                "zh": "电子以极高的速度绕着致密的<w>原子核</w>旋转。"
                            }
                        },
                        {
                            "text": "The <w>nucleus</w> of an atom contains most of its total mass.",
                            "target_lang_translations": {
                                "zh": "原子的<w>核</w>包含了其绝大部分的总质量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "atomic nucleus"
                    ],
                    "target_lang_definitions": {
                        "zh": "原子的中心部分，由质子和中子组成，带正电荷且密度极高。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "原子核",
                                "target_lang_sense_clarification": "原子的中心核心"
                            },
                            {
                                "target_lang_word": "核",
                                "target_lang_sense_clarification": "原子核的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73d84847-52cf-3351-bdc9-34cbb9687631",
                    "sense_definition": "The central, essential part or core of something around which other elements are gathered.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "core",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small group of dedicated volunteers forms the <w>nucleus</w> of the charity.",
                            "target_lang_translations": {
                                "zh": "一小群尽职尽责的志愿者构成了该慈善机构的<w>核心</w>。"
                            }
                        },
                        {
                            "text": "The old city centre serves as the cultural <w>nucleus</w> of the entire region.",
                            "target_lang_translations": {
                                "zh": "老城中心充当了整个地区的文化<w>中心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "core",
                        "kernel",
                        "hub"
                    ],
                    "common_phrases": [
                        "form the nucleus"
                    ],
                    "target_lang_definitions": {
                        "zh": "事物的核心或中心部分，其他组成部分围绕其聚集。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "核心",
                                "target_lang_sense_clarification": "中心或最重要部分"
                            },
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "聚集的中枢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd532145-1e0c-3361-b339-0e1caa52f827",
                    "sense_definition": "A starting point or initial foundation to which other things will be added over time.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "core",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This modest collection will form the <w>nucleus</w> of our new library.",
                            "target_lang_translations": {
                                "zh": "这批不多的藏书将构成我们新图书馆的<w>基础</w>。"
                            }
                        },
                        {
                            "text": "His early research provided the <w>nucleus</w> for an innovative business idea.",
                            "target_lang_translations": {
                                "zh": "他早期的研究为一个创新的商业构想提供了<w>雏形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "basis",
                        "seed"
                    ],
                    "common_phrases": [
                        "nucleus of a collection"
                    ],
                    "target_lang_definitions": {
                        "zh": "事物发展或扩充的起点或最初基础。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "后续发展的基底"
                            },
                            {
                                "target_lang_word": "雏形",
                                "target_lang_sense_clarification": "最初的形式或起步框架"
                            },
                            {
                                "target_lang_word": "胚芽",
                                "target_lang_sense_clarification": "萌芽或发端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a32593-58be-3a86-9b5a-daeb74b29280",
                    "sense_definition": "A cluster of nerve cell bodies located within the central nervous system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "neuroanatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Damage to this specific <w>nucleus</w> in the brainstem impairs basic motor skills.",
                            "target_lang_translations": {
                                "zh": "脑干中这一特定<w>神经核</w>受损会损害基本的运动技能。"
                            }
                        },
                        {
                            "text": "Signals pass through a relay <w>nucleus</w> before reaching the cerebral cortex.",
                            "target_lang_translations": {
                                "zh": "信号在到达大脑皮层之前会经过一个中继<w>核团</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "caudate nucleus"
                    ],
                    "target_lang_definitions": {
                        "zh": "中枢神经系统内神经元胞体聚集而成的结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神经核",
                                "target_lang_sense_clarification": "中枢神经内的神经细胞群"
                            },
                            {
                                "target_lang_word": "核",
                                "target_lang_sense_clarification": "神经解剖学中的核团"
                            },
                            {
                                "target_lang_word": "核团",
                                "target_lang_sense_clarification": "中枢神经系统内的神经元聚集区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fce9ab66-b050-3367-b307-e3b0997e6fe5",
                    "sense_definition": "The central and most sonorous part of a syllable, typically consisting of a vowel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English phonology, the vowel sound always forms the syllable <w>nucleus</w>.",
                            "target_lang_translations": {
                                "zh": "在英语音系学中，元音总是构成<w>音节核</w>。"
                            }
                        },
                        {
                            "text": "A consonant can occasionally serve as the <w>nucleus</w> in an unstressed syllable.",
                            "target_lang_translations": {
                                "zh": "在非重读音节中，辅音偶尔也可以充当<w>音节核</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "syllable nucleus"
                    ],
                    "target_lang_definitions": {
                        "zh": "音节的中心和响度最大的部分，通常由元音充当。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "音节核",
                                "target_lang_sense_clarification": "语音学中的音节核心"
                            },
                            {
                                "target_lang_word": "韵头以外的韵腹",
                                "target_lang_sense_clarification": "音节核心音"
                            },
                            {
                                "target_lang_word": "核",
                                "target_lang_sense_clarification": "音节核的简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}