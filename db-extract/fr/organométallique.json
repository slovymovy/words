                                "target_senses": [
                                    {
                                        "sense_id": "f83d06a3-3614-3e9f-a06a-25d8cdac7db7",
                                        "entry_id": "f09f7823-d28f-3ee1-9665-a375ad02e232",
                                        "glosses": [
                                            "eine chemische Verbindung betreffend, die zwischen dem Metall- oder Halbmetallatom und einem Kohlenstoffatom eine kovalente Bindung besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37fda9b1-1d97-471f-a6ab-1aead50029ec",
                                                "sense_id": "f83d06a3-3614-3e9f-a06a-25d8cdac7db7",
                                                "text": "Chemische Verbindungen, bei denen zum Beispiel ein Bor- oder Siliciumatom eine kovalente Bindung mit einem Kohlenstoffatom eingeht, sind strenggenommen nicht metallorganisch, da Bor und Silicium im elementaren Zustand keine Metalle sind. Daher kann man solche Verbindungen als elementorganisch auffassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
