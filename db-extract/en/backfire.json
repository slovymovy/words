                    {
                        "sense_id": "62d34a9a-ee13-3ae5-9c79-fd94af0db463",
                        "entry_id": "761d4852-7ac0-3ee1-a57d-d3e29986f5f0",
                        "glosses": [
                            "Alternative spelling of back fire."
