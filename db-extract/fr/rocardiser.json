                "senses": [
                    {
                        "sense_id": "c98ee463-69cc-3a56-b49e-02fc55589407",
                        "entry_id": "8788acf7-8405-363f-bb09-45950501ed77",
                        "glosses": [
                            "Réussir à marginaliser politiquement un homme politique perçu comme une concurrence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49181954-3dd9-4449-9235-9a4026e2fa70",
                                "sense_id": "c98ee463-69cc-3a56-b49e-02fc55589407",
                                "text": "Si Mégret a cherché à « ringardiser » Le Pen, celui-ci va désormais tout faire pour « rocardiser » son lieutenant."
                            },
                            {
                                "example_id": "c7345338-17a4-4c2d-8d08-1ed1f6ccf281",
                                "sense_id": "c98ee463-69cc-3a56-b49e-02fc55589407",
                                "text": "L’intérêt tactique de Chirac aurait d’ailleurs été de « rocardiser » Sarkozy et de l’éliminer pour 2007. L’inverse s’est ainsi totalement produit : Sarkozy est devenu le seul présidentiable de son camp."
                            }
                        ]
                    }
