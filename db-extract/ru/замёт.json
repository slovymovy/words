                    {
                        "form_id": "46cc6938-5f4e-4bd5-9fa6-08d08000bc24",
                        "entry_id": "dd8cbc82-35f1-3359-a219-41a58c26bc24",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "замётах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ab98e2c-0437-3cc4-b4f2-9a1dfe249606",
                        "entry_id": "dd8cbc82-35f1-3359-a219-41a58c26bc24",
                        "glosses": [
                            "действие по значению гл. замётывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4511c38c-2eba-4e96-b768-77b00022d111",
                                "sense_id": "1ab98e2c-0437-3cc4-b4f2-9a1dfe249606",
                                "text": "Все это создавало опасность изорвать невод при замёте."
                            }
                        ]
                    },
                    {
                        "sense_id": "37d20a25-ebe8-35ab-a6ba-616b24b1937b",
                        "entry_id": "dd8cbc82-35f1-3359-a219-41a58c26bc24",
                        "glosses": [
                            "рыбол. результат такого действия; заброшенные рыболовные снасти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929519da-9842-4a50-9086-1e3bd8895b06",
                                "sense_id": "37d20a25-ebe8-35ab-a6ba-616b24b1937b",
                                "text": "Каждой семье перед ледоставом разрешалось сделать два замёта неводом."
                            },
                            {
                                "example_id": "bfdfc371-ac3a-48b8-886f-7341252d7f9e",
                                "sense_id": "37d20a25-ebe8-35ab-a6ba-616b24b1937b",
                                "text": "Я не назвал бы прогрессивным способ ловли рыбы неводом, но зато он добычлив: несколько замётов, и весь колхоз обеспечен."
                            }
                        ]
                    }
                ],
