                        "cross_references": [
                            {
                                "target_word": "mousseron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dddc184f-4d88-397a-9f51-73bfe8d8a515",
                                        "entry_id": "f1fad238-cdc8-3994-99ea-fc9e0a41f46f",
                                        "glosses": [
                                            "Nom usuel de plusieurs champignons comestibles qui poussent dans les clairières, les prés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5412bf0e-6667-49dc-b8d0-0c2c391fe8e2",
                                                "sense_id": "dddc184f-4d88-397a-9f51-73bfe8d8a515",
                                                "text": "Les mousserons sont forts bons dans les divers aprêts de viandes."
                                            },
                                            {
                                                "example_id": "18504027-de6b-42ec-a815-792e7b2afd97",
                                                "sense_id": "dddc184f-4d88-397a-9f51-73bfe8d8a515",
                                                "text": "Assise sur un tapis feutré d’aiguilles de sapin, j’épile soigneusement un mousseron tout frais, englué d’une chevelure d’herbe fine. Il est moite et froid, emperlé et tendre comme un nez d’agneau et si tentant qu’au lieu de le déposer dans le panier je le croque cru ; délicieux, il sent la truffe et la terre…"
                                            },
                                            {
                                                "example_id": "47b8f83e-4ead-4a16-97e5-a7d865ec5422",
                                                "sense_id": "dddc184f-4d88-397a-9f51-73bfe8d8a515",
                                                "text": "Les dômes des mousserons rosés crevaient le léger terreau, gris d’argent, qui nourrit les bruyères."
                                            },
                                            {
                                                "example_id": "b1d088da-555a-49ab-ac76-b0280d1028cb",
                                                "sense_id": "dddc184f-4d88-397a-9f51-73bfe8d8a515",
                                                "text": "Les pêcheurs du dimanche nous rapportaient : des céteaux, du meuil, du merlu ; à la saison des champignons ; des mousserons, des lactaires délicieux, des rosées des prés, des pleurotes du panicaut appelées communément argouanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e13fd1-c6bc-3d75-9dcf-ca651b9e0a68",
                                        "entry_id": "f1fad238-cdc8-3994-99ea-fc9e0a41f46f",
                                        "glosses": [
                                            "Tricholome de la Saint-Georges, au chapeau blanc ou crème (Calocybe gambosa)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7db82169-a307-4e81-b72f-20f136cf06b2",
                        "source_entry_id": "d91767b7-62c9-3c68-b5b4-3ec02a20cc51",
                        "source_sense_id": "bfbf810d-7c9b-36a7-9439-dd13fed7b648",
                        "source_sense_description": "een dagvlinder uit de Nymphalidae-familie",
                        "target_lang_word": "Trauermantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trauermantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4c3cd34-3c51-37a1-941d-413bf3fc139a",
                                        "entry_id": "e5193649-5626-3aeb-b988-b0ea50665452",
                                        "glosses": [
                                            "Tagfalter mit samtigen braunschwarzen, gelb oder weiß geränderten Flügeln, der fast in ganz Europa sowie in Asien und Nordamerika vorkommt (Nymphalis antiopa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92d2624-8792-42a9-ab08-2147ac223073",
                                                "sense_id": "b4c3cd34-3c51-37a1-941d-413bf3fc139a",
                                                "text": "„Mit etwas Glück konnte man in der Stadt Schwalbenschwänze, Bläulinge und Tagpfauenaugen sehen. Hin und wieder gaukelte ein Trauermantel über Rabatten und Hecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
