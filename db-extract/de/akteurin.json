                ],
                "senses": [
                    {
                        "sense_id": "b58680f2-88fe-385d-b0f9-f0c4bbbc9ab9",
                        "entry_id": "d7f852e6-7f58-3fdf-8d3a-ed9b80b2ea67",
                        "glosses": [
                            "weibliche Person, die handelt, die etwas tut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6673762c-3082-4fdc-a9af-1ca38d529955",
                                "sense_id": "b58680f2-88fe-385d-b0f9-f0c4bbbc9ab9",
                                "text": "„[…] Die CDU-Vorsitzende hat sich an diesem Tag als konsequente, handlungsfähige Akteurin in Szene gesetzt wie lange nicht mehr, sie hat eine Fehlentscheidung korrigiert, eine Schwachstelle beseitigt und ganz behutsam einen Verantwortlichen für die Erfolglosigkeit der letzten Monate präsentiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0074c5df-173e-3c2a-8363-db330d90a135",
                        "entry_id": "d7f852e6-7f58-3fdf-8d3a-ed9b80b2ea67",
                        "glosses": [
                            "weibliche Person, die eine Rolle^([2]) spielt; Darstellerin, Schauspielerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4371b30-1e90-4e05-8f9c-245a9d905ef5",
                                "sense_id": "0074c5df-173e-3c2a-8363-db330d90a135",
                                "text": "Die Akteurin spielte das Bühnenstück ausgezeichnet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c9cd360-3fd2-40b6-8f58-5959e9e9e7be",
                        "source_entry_id": "d7f852e6-7f58-3fdf-8d3a-ed9b80b2ea67",
                        "source_sense_id": "0074c5df-173e-3c2a-8363-db330d90a135",
                        "source_sense_description": "weibliche Person, die eine Rolle spielt",
                        "target_lang_word": "actress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female who performs on the stage or in films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a42363-81f1-4b8b-8ff9-879895a29601",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "A while ago somewhere I don't know when / I was watchin' a movie with a friend / I fell in love with the actress / She was playin' a part that I could understand"
                                            },
                                            {
                                                "example_id": "9236a94e-d062-4f08-96f9-69f3c7b8f0f3",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "\"I'm an actress -- actor, as we have to say these days.\""
                                            },
                                            {
                                                "example_id": "60c2368a-30ec-481c-a2a7-3b35351dec9c",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "Court documents appear to show that Ian Edmondson, a senior News of the World journalist, had authorised Mr Mulcaire to hack phones belonging to Sienna Miller, an actress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female doer or \\\"actor\\\" (in a general sense)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d5f912-3c4c-474c-a16a-8248b2bdadab",
                                                "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                                "text": "My mental anguish, and the dreadful scenes in which I had been an actress, advanced the period of my labour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88abe8bf-79d2-4b3c-a13b-89236870726d",
                        "source_entry_id": "d7f852e6-7f58-3fdf-8d3a-ed9b80b2ea67",
                        "source_sense_id": "0074c5df-173e-3c2a-8363-db330d90a135",
                        "source_sense_description": "weibliche Person, die eine Rolle spielt",
                        "target_lang_word": "actrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71d2e46e-b1fa-3deb-9f95-e0addb153813",
                                        "entry_id": "5f642732-617c-3c2b-9ea3-fd083e16dc37",
                                        "glosses": [
                                            "Celle qui agit, qui intervient dans un processus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ccadf96-9718-4698-b337-f383fa2e89b3",
                                                "sense_id": "71d2e46e-b1fa-3deb-9f95-e0addb153813",
                                                "text": "Et si c’était la preuve que la France est bien en train de devenir, au plus profond d’elle-même, actrice du changement ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                        "entry_id": "5f642732-617c-3c2b-9ea3-fd083e16dc37",
                                        "glosses": [
                                            "Celle qui joue un personnage, un rôle dans un spectacle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad83c0bb-4875-4bb6-b9f9-f1bd74df19c7",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Les débutants, les bas-bleus, les actrices qui commencent et celles qui finissent leur carrière, auteurs et libraires caressent ou choyent ces plumes à tout faire."
                                            },
                                            {
                                                "example_id": "9093b921-b59c-4503-890b-83a5d4da4052",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Les actrices d’opéra-comique de ce temps-là ne se bornaient pas à roucouler un air ou une romance : on voulait encore qu'elles jouassent la comédie; et madame Favart représenta avec un rare talent Roxelane des Trois Sultanes, et tous les premiers rôles des ouvrages de son mari ou d'autres auteurs qui se disputaient ce charmant interprète."
                                            },
                                            {
                                                "example_id": "c1dc030b-1599-44a0-9d10-ad2befe9487b",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Sensible au talent de l’actrice, Albert Camus lui confie le rôle de Martha pour la création du Malentendu en juin 1944."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
