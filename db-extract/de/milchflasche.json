                        "entry_id": "1fdc8270-f40f-3531-9a0a-2a5d8fc24260",
                        "glosses": [
                            "Flasche zur Abfüllung von Milch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf25a78-dc47-47d5-b522-cf34cf8f472a",
                                "sense_id": "2483c475-7c14-3727-9b66-a6c504471178",
                                "text": "Für die Milchflasche wurde Pfand bezahlt."
                            },
                            {
                                "example_id": "80e555b9-c7ea-4677-a122-03f0ef8d77fb",
                                "sense_id": "2483c475-7c14-3727-9b66-a6c504471178",
                                "text": "„Zur Antwort warf er eine Milchflasche nach mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2f4dfa3-b787-39fb-b062-3ade387b5c1a",
                        "entry_id": "1fdc8270-f40f-3531-9a0a-2a5d8fc24260",
                        "glosses": [
                            "Trinkbehälter mit Sauggummi für Säuglinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5aa0ac4-fd00-4953-b2e1-f9b66bab4974",
                                "sense_id": "e2f4dfa3-b787-39fb-b062-3ade387b5c1a",
                                "text": "Das Baby nuckelt zufrieden an der Milchflasche."
                            },
                            {
                                "example_id": "cebf767c-59cf-46ea-8772-fe8132d75757",
                                "sense_id": "e2f4dfa3-b787-39fb-b062-3ade387b5c1a",
                                "text": "Wir haben das Kalb mit der Milchflasche aufgezogen."
                            },
                            {
                                "example_id": "c2995d7c-c76d-4399-b70a-62422378ea39",
                                "sense_id": "e2f4dfa3-b787-39fb-b062-3ade387b5c1a",
                                "text": "Die Igeljungen haben dann zu Hause die Milchflasche bekommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0951501b-679c-4624-8d68-65042bf38862",
                        "source_entry_id": "1fdc8270-f40f-3531-9a0a-2a5d8fc24260",
                        "source_sense_id": "2483c475-7c14-3727-9b66-a6c504471178",
                        "source_sense_description": "Flasche zur Abfüllung von Milch",
                        "target_lang_word": "milk bottle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milk bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68ad0fb9-60d7-38c0-9b50-a1feb7c57aa3",
                                        "entry_id": "236a8766-4c8b-38ef-a321-f13364c44cea",
                                        "glosses": [
                                            "A glass bottle traditionally used for doorstep delivery of fresh milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05011b78-0985-3ac3-9d9b-c3d704eb30dc",
                                        "entry_id": "236a8766-4c8b-38ef-a321-f13364c44cea",
                                        "glosses": [
                                            "A small white jube (confectionary) in the shape of a milk bottle."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc12e886-c6ba-351f-ac42-53dcb35fde75",
                                        "entry_id": "236a8766-4c8b-38ef-a321-f13364c44cea",
                                        "glosses": [
                                            "A white woman who visits Jamaica as a sex tourist."
                                        ],
                                        "tags": [
                                            "Jamaica",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a478a7-e35e-4f20-8d24-6786967a79eb",
                                                "sense_id": "fc12e886-c6ba-351f-ac42-53dcb35fde75",
                                                "text": "Clinton waits on the beach for the new arrivals, hoping that one of them will bring him good fortune. \"I look for the milk bottles,\" he says, explaining how ultra-white skin is a giveaway, \"the ones who've just arrived. Milk bottles that need filling ...\""
                                            },
                                            {
                                                "example_id": "5b99cfcf-c53c-44fb-ba31-1ea94d643ce6",
                                                "sense_id": "fc12e886-c6ba-351f-ac42-53dcb35fde75",
                                                "text": "SLY: Lots of white milk bottles?\nANDRE: (Laughs.) Yeah mon.\nSLY: The whiter the better. Fill dem up."
                                            },
                                            {
                                                "example_id": "ecafd3cf-a5f2-4d6b-89fe-e93f8a51c5a5",
                                                "sense_id": "fc12e886-c6ba-351f-ac42-53dcb35fde75",
                                                "text": "While it is not uncommon for “rent-a-dreads” to roam the beaches, or even wait at the airports, in search of “milk bottles,” a term used to describe white female tourists, the idea that this is somehow a natural part of the landscape is problematic and creates a myth which, as mentioned before, replicates colonial forms of discourse and maintains the broader geopolitical power structure"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
