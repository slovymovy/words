                "senses": [
                    {
                        "sense_id": "4ce029a2-4da3-3175-ab4d-48e7bb450e14",
                        "entry_id": "ac152af9-4cab-36df-b88e-a170227a5b14",
                        "glosses": [
                            "Boire comme un ivrogne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40299451-7b91-49c2-9b71-9ccd00babdcf",
                                "sense_id": "4ce029a2-4da3-3175-ab4d-48e7bb450e14",
                                "text": "Il est apparemment paradoxal d'insister d'abord sur la sobriété traditionnelle des ruraux, puis de révéler leur penchant à ivrogner."
                            },
                            {
                                "example_id": "56c4fab6-b1bd-4aa2-9e19-addeb2283946",
                                "sense_id": "4ce029a2-4da3-3175-ab4d-48e7bb450e14",
                                "text": "Celui de 1671 ne fut maintenu qu'à la condition d'avoir une meilleure conduite et de ne plus trop s'ivrogner."
                            }
                        ]
                    }
