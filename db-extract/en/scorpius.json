                    {
                        "translation_id": "1192de77-7231-4ab8-a128-8e7041cf100f",
                        "source_entry_id": "d18fad2c-989d-3a72-81c7-0101e86ad9c0",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Skorpion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skorpion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42d9448a-3c85-3512-8294-eb944758af02",
                                        "entry_id": "c710733d-aa6c-3b5a-97cd-ce50eeb61256",
                                        "glosses": [
                                            "Tier aus der Ordnung der Spinnentiere, mit zwei krebsähnlichen Scheren am Vorderkörper und einen Giftstachel am Hinterleib"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d84b9a-23c1-474b-803f-3d7888776068",
                                                "sense_id": "42d9448a-3c85-3512-8294-eb944758af02",
                                                "text": "Der Skorpion ist ein giftiges Raubtier."
                                            },
                                            {
                                                "example_id": "9e921e64-61a8-413b-8457-c379976173e7",
                                                "sense_id": "42d9448a-3c85-3512-8294-eb944758af02",
                                                "text": "„Der Schmuckstein des Ringes hatte die Form eines Skorpions.“"
                                            },
                                            {
                                                "example_id": "2333804c-28a0-4a52-bdc6-be16837d8321",
                                                "sense_id": "42d9448a-3c85-3512-8294-eb944758af02",
                                                "text": "„Zu den größten Gefahren für das menschliche Leben überhaupt zählen in Ägypten Bisse giftiger Schlangen und Skorpione.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d117e215-49a4-3794-99cb-1e11f85b69f5",
                                        "entry_id": "c710733d-aa6c-3b5a-97cd-ce50eeb61256",
                                        "glosses": [
                                            "Sternbild des Tierkreises"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bceb2b0-bfc7-4db1-ab8b-b8cee067a54e",
                                                "sense_id": "d117e215-49a4-3794-99cb-1e11f85b69f5",
                                                "text": "Das Sternbild Skorpion reiht sich am Himmelsäquator ein."
                                            },
                                            {
                                                "example_id": "e8bb1080-3a1c-4e69-a17d-2fe3a03a3169",
                                                "sense_id": "d117e215-49a4-3794-99cb-1e11f85b69f5",
                                                "text": "„Am Zenit leuchtete Antares im Skorpion und nahe dabei Beta im Zentauren, der als erdnächster Fixstern gilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "81c0aece-158d-3ffc-a7e7-9402ef6e4c26",
                                        "entry_id": "c710733d-aa6c-3b5a-97cd-ce50eeb61256",
                                        "glosses": [
                                            "Sternzeichen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764ad2b1-4c4b-429b-91a3-463bd9efd2bd",
                                                "sense_id": "81c0aece-158d-3ffc-a7e7-9402ef6e4c26",
                                                "text": "Skorpione werden heute einen schönen Tag erleben und viel Glück in der Liebe haben."
                                            },
                                            {
                                                "example_id": "a23a2737-a8c7-425e-a0c5-5272a2b9801c",
                                                "sense_id": "81c0aece-158d-3ffc-a7e7-9402ef6e4c26",
                                                "text": "„Da traten die rechten Planeten im Zeichen des Skorpions zusammen, wie Meister Dürer es gar wohlbelehrt gezeichnet hat im medizinischen Flugblatt […]."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b3e96eb1-6316-3c6d-9533-289bdb4547b8",
                                        "entry_id": "c710733d-aa6c-3b5a-97cd-ce50eeb61256",
                                        "glosses": [
                                            "eine antike Belagerungswaffe"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab06bfdd-0d19-4bfb-8573-4ee6f31d2b20",
                                                "sense_id": "b3e96eb1-6316-3c6d-9533-289bdb4547b8",
                                                "text": "Mit einem Bataillon an Skorpionen werde ich das Dorf verwüsten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
