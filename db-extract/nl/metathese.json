                "senses": [
                    {
                        "sense_id": "12544fe2-357a-352a-bfb2-940c43258ab9",
                        "entry_id": "f26c112f-614d-32d2-99f3-6811ae923714",
                        "glosses": [
                            "verschijnsel dat bepaalde klanken of lettergrepen binnen een woord van plaats wisselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43891aeb-ce66-4704-9c86-b20f9f0f29cc",
                                "sense_id": "12544fe2-357a-352a-bfb2-940c43258ab9",
                                "text": "Dit omdraaien van twee klanken (vaak twee medeklinkers en/of vaak liquidae, de medeklinkers uit het woord molenaar) wordt in de taalkunde metathesis (of metathese) genoemd. (…) Geldrop is een duidelijk voorbeeld, waar het woorddeel –dorp metathesis heeft ondergaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a9bda2-23f6-308c-a569-760b57f12959",
                        "entry_id": "f26c112f-614d-32d2-99f3-6811ae923714",
                        "glosses": [
                            "reactie waarbij moleculen van twee stoffen worden gesplitst en vervolgens weer kruislings gecombineerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2201ad2-8b9c-4f1e-ac7a-33ec1bb08ed6",
                                "sense_id": "85a9bda2-23f6-308c-a569-760b57f12959",
                                "text": "Het proces dat door hen is ontwikkeld wordt 'metathese' genoemd, 'dubbele omzetting' in organische synthese. Het is een methode om groepen atomen binnen moleculen van plaats te doen verwisselen op een wijze die door het Nobelcomité wordt vergeleken met een dans waarbij de dansers voortdurend van partner ruilen."
                            }
                        ]
                    }
