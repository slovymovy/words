                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "participle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Победитель конкурса был <w>определён</w> решением авторитетного жюри.",
                            "target_lang_translations": {
                                "tr": "Yarışmanın kazananı, yetkili jürinin kararıyla <w>belirlendi</w>."
                            }
                        },
                        {
                            "text": "Точный химический состав вещества был <w>определён</w> в лаборатории.",
                            "target_lang_translations": {
                                "tr": "Maddenin kesin kimyasal bileşimi laboratuvarda <w>saptandı</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'Определить' (belirlemek) fiilinin geçmiş zaman edilgen sıfat-fiili."
                    },
                    "translations": {
