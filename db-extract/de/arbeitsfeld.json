                ],
                "senses": [
                    {
                        "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                        "entry_id": "0e8d0bb6-7e30-3b77-9a0b-138f81ff2867",
                        "glosses": [
                            "Gesamtheit der Aufgaben, für die jemand oder etwas zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ca1e2f-37c8-4935-ac79-ed418515b6d7",
                                "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                                "text": "„Neue Arbeitsfelder sichern die Zukunft einer wachsenden Branche.“"
                            },
                            {
                                "example_id": "3c9cbb0a-7e9a-4e00-b4d7-b90769d58a41",
                                "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                                "text": "„Durch die Umstrukturierung hat auch der FDP-Gesundheitspolitiker Lars Lindemann ein neues Arbeitsfeld gefunden.“"
                            },
                            {
                                "example_id": "fd531049-a318-4c81-a2b9-ba5860dc5905",
                                "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                                "text": "„Der Historiker Valentin Groebner wirft dieses Thema auf als ein charakteristisches Arbeitsfeld der Historischen Anthropologie.“"
                            },
                            {
                                "example_id": "31f2c91d-76ad-4375-a358-01afa4acd4b6",
                                "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                                "text": "„November 2000 im Seilbahntunnel von Kaprun liegt das weite, interdisziplinäre Arbeitsfeld von Werner Bätzing, Professor für Kulturgeographie am Institut für Geographie der Universität Erlangen/Nürnberg.“"
                            },
                            {
                                "example_id": "4162b1ca-e816-4c71-86a9-527d7626e24f",
                                "sense_id": "1a343583-e780-3110-a341-9939b654d30b",
                                "text": "„Es sind Gesänge frommer, kindlicher, gottgeheiligter Seelen, theils im Arbeitsfelde Christi mit erprobter Glaubenskraft stehender Männer, theils zarter weiblicher und jungfräulicher Seelen, die theilweise nicht gerade zu Dichtern und Dichterinnen geboren, aber, wie Gustav Schwab irgendwo mit edler Gesinnung schreibt, durch die Liebe Christi zu Dichtern und Sängern geworden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
