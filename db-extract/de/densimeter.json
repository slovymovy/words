                "senses": [
                    {
                        "sense_id": "78e0c8d6-028f-3899-8a92-9886d5369d6e",
                        "entry_id": "eb51b06a-912c-3f87-a3c0-45ea96402b80",
                        "glosses": [
                            "Apparat zur Bestimmung der Wichte (Dichte) von Flüssigkeiten"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "e35806f0-4c4f-4867-85d4-c41d63f74ebe",
                                "sense_id": "78e0c8d6-028f-3899-8a92-9886d5369d6e",
                                "text": "„Wir könnten wohl mittels einer Tabelle aus der mit dem Densimeter gemessenen Dichte den Gehalt entnehmen.“"
                            },
                            {
                                "example_id": "675021e0-8c02-4725-88d1-47bd6b481a3e",
                                "sense_id": "78e0c8d6-028f-3899-8a92-9886d5369d6e",
                                "text": "„Wegen der uneinheitlichen Zusammensetzung der Zuckerrübensäfte schlägt E. Haddon vor, deren Dichte bestimmung nicht mittels des Densimeters, sondern durch Wägung eines Liters zu bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
