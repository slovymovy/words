                            "text": "Cette robe rouge fait beaucoup d'<w>effet</w> pendant la soirée."
                        },
                        {
                            "text": "Les <w>effets</w> de lumière de ce film sont vraiment magnifiques."
                        },
                        {
                            "text": "Ces arbustes font très bel <w>effet</w> dans le jardin au printemps."
                        }
                    ],
                    "synonyms": [
                        "impression"
                    ],
                    "common_phrases": [
                        "faire bel effet",
                        "effets de lumière"
                    ]
                },
                {
                    "sense_id": "c4534c48-c868-360c-9eff-8ba92f06e001",
