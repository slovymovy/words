                        ],
                        "form": "die Grundbegriffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "460962c7-e654-3745-be64-f1ee50720b7d",
                        "entry_id": "97e8e4fa-39d5-3dde-9a76-7e61d5311f17",
                        "glosses": [
                            "(verhältnismäßig) einfacher Ausdruck (Begriff) oder auch Sachverhalt, der zu den Grundlagen eines Themas gehört"
                        ],
                        "tags": [
                            "häufig im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4cfde3c6-e561-4374-9e6b-fc13d8c296d5",
                                "sense_id": "460962c7-e654-3745-be64-f1ee50720b7d",
                                "text": "Am ersten Tag wurden wir mit den Grundbegriffen der Wetterkunde bekanntgemacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02c0c8b9-fc04-3c65-902f-c5bec98d5137",
                        "entry_id": "97e8e4fa-39d5-3dde-9a76-7e61d5311f17",
                        "glosses": [
                            "(definierter, unbewiesener) elementarer Ausdruck, auf dem mittels Logik ein System aufgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a64cac-4f5b-4326-b6e1-a867871b82e0",
                                "sense_id": "02c0c8b9-fc04-3c65-902f-c5bec98d5137",
                                "text": "Die Gundbegriffe der Mathematik sind klar umgrenzte Aussagen und sie werden benutzt, um weitere Begriffe zu definieren."
                            },
                            {
                                "example_id": "a54eb282-8341-45f7-9796-23ab0aac7e85",
                                "sense_id": "02c0c8b9-fc04-3c65-902f-c5bec98d5137",
                                "text": "„Wenn der Begriff der Bedeutung als ein Grundbegriff neutestamentlicher Wissenschaft fungieren soll, erweist sich die Bestimmung dieses Begriffs als unumgänglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "072a6ecd-64e5-3f25-ac63-d6296e832a45",
                        "entry_id": "97e8e4fa-39d5-3dde-9a76-7e61d5311f17",
                        "glosses": [
                            "Kategorie als eine Form der Gliederung, die die Philosophie eines bestimmten Philosophen aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f21fe6c7-ef16-47b9-b85c-7a0ac67d5862",
                                "sense_id": "072a6ecd-64e5-3f25-ac63-d6296e832a45",
                                "text": "„Ohne eine zumindest einigermaßen gesicherte Interpretationsgrundlage, deren Gegenstand Umriß und systematische Bedeutungszuweisung zentraler Grundbegriffe der Philosophie Fichtes sind, fehlt den Einzelanalysen die systematische Sicherheit.“"
                            },
                            {
                                "example_id": "3f009d0e-b965-4063-aa08-54d799983815",
                                "sense_id": "072a6ecd-64e5-3f25-ac63-d6296e832a45",
                                "text": "„Es ist daher erhellend und unerläßlich zugleich, einige Grundbegriffe der Philosophie Heideggers nach Sein und Zeit ausdrücklich in den Blick zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
