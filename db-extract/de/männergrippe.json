                ],
                "senses": [
                    {
                        "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                        "entry_id": "bf5f15f7-dfb3-3cd5-8fb4-02553fe0dcae",
                        "glosses": [
                            "Erkrankung eines Mannes mit grippeähnlichen Symptomen (beispielsweise Fieber, Husten, Schnupfen, Heiserkeit), der darauf besonders wehleidig reagiert"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "68797cdf-3c86-4b61-9e22-c581f169c993",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "Nach dem, was seine Frau sagt, hat Peter eine Männergrippe."
                            },
                            {
                                "example_id": "4a631f04-92a6-4bcf-92d7-e340edd503a6",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Moment! Muss niesen …. Geschafft! Kann weiter schreiben. Was eigentlich? Ach ja, hab Männergrippe! Keine Ahnung, ob ich die überstehe. Ich glaube, es sieht ziemlich schlimm aus.“"
                            },
                            {
                                "example_id": "746fe1b7-317b-4cd5-8ac7-9ba65ca4c1a7",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Alfons leidet unter einer schweren Männergrippe, doch Hildegard wäre nicht Hildegard, wenn sie nicht alles dafür tun würde, um ihren Mann wieder aufzupäppeln.“"
                            },
                            {
                                "example_id": "f37737f5-096d-44c6-9a55-f42342d05acf",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Das Klischee der ‚Männergrippe‘ oder des ‚Männerschnupfens‘ hält sich hartnäckig: Demnach bekommen Männer häufiger als Frauen Erkältungen und leiden stärker darunter.“"
                            },
                            {
                                "example_id": "e17267bf-cb8e-4b52-a19c-be1602549050",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "[Schlagzeile:] Die Männergrippe gibt es wirklich"
                            },
                            {
                                "example_id": "fbb40ab0-bfc1-476b-bf93-24d78f84c52a",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Ob du und dein/e Partner/in an gemeinsamen Lebensträumen arbeitet, du deinem Partner auch bei einer Männergrippe zur Seite stehst und er dich in seine Familie integriert sagt viel über eure Beziehung aus.“"
                            },
                            {
                                "example_id": "9c6e4507-02a8-41f2-8598-1b367586e8a2",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Lucinde Hutzenlaub und Anna Herzog haben ein Buch über den Mythos ‚Männergrippe‘ geschrieben.“"
                            },
                            {
                                "example_id": "a15b30d3-d4fe-4776-896c-714e792bcb7e",
                                "sense_id": "842fbaac-16b3-30b2-b3ef-9b55b31edb81",
                                "text": "„Über Männergrippe wird zu Unrecht gelacht, rügen Mediziner. Denn einiges deutet darauf, dass weibliche und männliche Körper unterschiedlich auf Erkältungskrankheiten reagieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
