    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28f50562-aaa8-3111-8a22-05b9821ead3a",
                    "sense_definition": "Influence, power, or social standing, especially in politics or media.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small company lacked the financial <w>clout</w> needed to compete against global corporations.",
                            "target_lang_translations": {
                                "zh": "这家小公司缺乏与跨国大企业竞争所需的财务<w>影响力</w>。"
                            }
                        },
                        {
                            "text": "Many content creators do controversial things solely to gain online <w>clout</w>.",
                            "target_lang_translations": {
                                "zh": "许多内容创作者做有争议的事情纯粹是为了在网络上博取<w>影响力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "influence",
                        "leverage",
                        "sway",
                        "pull"
                    ],
                    "antonyms": [
                        "powerlessness"
                    ],
                    "common_phrases": [
                        "political clout",
                        "financial clout"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指政治或媒体方面的）影响力、权势、社会地位"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "影响力",
                                "target_lang_sense_clarification": "政治或社会力量"
                            },
                            {
                                "target_lang_word": "权势",
                                "target_lang_sense_clarification": "权力与势力"
                            },
                            {
                                "target_lang_word": "势力",
                                "target_lang_sense_clarification": "政治或经济地位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "391a4ce5-6642-3d7c-9704-92d7875184ea",
                    "sense_definition": "A heavy blow or strike, especially with the hand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "blow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the faulty radio a sharp <w>clout</w> to make it work again.",
                            "target_lang_translations": {
                                "zh": "他狠狠给了故障的收音机一记<w>重击</w>，想让它重新恢复工作。"
                            }
                        },
                        {
                            "text": "The mischievous boy received a stinging <w>clout</w> round the ear from his grandmother.",
                            "target_lang_translations": {
                                "zh": "淘气的男孩被祖母狠狠地扇了一记耳光<w>重击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smack",
                        "whack",
                        "cuff",
                        "blow"
                    ],
                    "common_phrases": [
                        "clout round the ear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informal/colloquial contexts, especially in British and Irish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指用手给予的）重击、猛击"
