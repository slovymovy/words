        "fr-extract.jsonl": [
            {
                "entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                "word": "bourgade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fcba7bd8-b96f-45be-b14b-af764bc0e5da",
                        "entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourgades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                        "entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "glosses": [
                            "Petit bourg, village dont les maisons disséminées occupent un assez grand espace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c948ee9-d8e2-45da-b18e-57dc64e8d37f",
                                "sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                                "text": "Après Mondragon, qui est la dernière bourgade, comme on dit en Espagne, le dernier pueblo de la province de Guipuscoa, nous entrâmes dans la province d’Alava, et nous ne tardâmes pas à nous trouver au bas de la montagne de Salinas."
                            },
                            {
                                "example_id": "29d26ba9-d54b-47d2-aff5-c8967f167c45",
                                "sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                                "text": "Quelles causes profondes, quelles turpitudes amenèrent donc l’annihilation de ce qui est une riante bourgade ?"
                            },
                            {
                                "example_id": "09ef2c6b-c1ec-47cc-bbfa-996009a12a03",
                                "sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l’obligeant […] à périr de la poitrine dans des bourgades industrielles."
                            },
                            {
                                "example_id": "ca30ec12-0f9f-41c6-a00f-a4114542599f",
                                "sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                                "text": "Le Mesnil-lès-Hurlus, un nom de village prédestiné, de mauvais augure, empli de hurlements avant un silence de mort. Rasée, rayée de la carte durant l'hiver 1915, la bourgade ne fut jamais reconstruite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35f5ab33-99d1-4c93-8c1f-76de96192f60",
                        "source_entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "source_sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                        "target_lang_word": "Kleinstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                        "entry_id": "3d9b06cb-8e77-3315-adb7-54e27d8cb3e7",
                                        "glosses": [
                                            "im deutschsprachigen Raum Bezeichnung für eine Stadt mit 5.000 bis 20.000 Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a13fb1-48e4-4177-bb36-583674252f2f",
                                                "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                                "text": "Das Leben in einer Kleinstadt hat Vor- und Nachteile."
                                            },
                                            {
                                                "example_id": "dade4344-48f5-45ba-8d44-d6f1d951a512",
                                                "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                                "text": "„Außer Worbis gibt es nur noch wenige andere Orte in Thüringen, die noch heute jene Spitzwegsche Gelassenheit ausstrahlen, wie sie einst den Alltag der meisten deutschen Kleinstädte prägte.“"
                                            },
                                            {
                                                "example_id": "68318dd3-5f51-4668-ad44-ad6c3d8e4ab2",
                                                "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                                "text": "„1914 lebte nur ein gutes Dutzend aller Deutschen in Groß- und Mittelstädten, die Mehrheit aber in Kleinstädten und auf dem Land.“"
                                            },
                                            {
                                                "example_id": "0fb5326c-7e33-427b-b7e0-b624dccfe54c",
                                                "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                                "text": "„Die Kleinstadt erscheint mir wie ein monumentales Freilichtmuseum.“"
                                            },
                                            {
                                                "example_id": "327271a2-eb8c-4388-8a45-62bb755e8794",
                                                "sense_id": "4c7ab6ca-3763-3c06-972d-e8105c9a22d2",
                                                "text": "„Thum ist eine Kleinstadt im sächsischen Erzgebirgskreis .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "758eadd0-8e8e-4012-8600-f9774ab2f1d9",
                        "source_entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "source_sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                        "target_lang_word": "Städtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Städtchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                        "entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                                        "glosses": [
                                            "kleine Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d750945-ffc7-47d3-918f-5c9f4fd6f17f",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Auf dem höchsten Punkt des Latium zum Beispiel, in dem Städtchen Guadagnolo, sieht in meinem Lieblingslokal zwischen den Amaro-Flaschen vom Regal hinter der Kasse eine gar nicht so kleine Figur des Duce der Wirtin über die Schulter.“"
                                            },
                                            {
                                                "example_id": "77901bc6-c972-477f-8be1-1a28f97a1502",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Das kleine Städtchen Ilulissat liegt 250 Kilometer nördlich des Polarkreises, hat fünftausend Einwohner und ebenso viele Schlittenhunde, einhundert angemeldete Autos, aber keine Ampel.“"
                                            },
                                            {
                                                "example_id": "e81a554d-b022-4ffe-bb0f-23d1c9b199e6",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Augustinus wurde im Städtchen Tagaste in Nordafrika geboren, ging aber schon mit sechzehn Jahren zum Studium nach Karthago.“"
                                            },
                                            {
                                                "example_id": "3645092c-afd5-448f-95e9-c65acf455371",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Ein hübsch am See gelegenes Städtchen, das sich, ruhig im Zonenrandgebiet gelegen, idyllisch gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb6db1e5-95ea-4377-afe2-eaac4fa58792",
                        "source_entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "source_sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                        "target_lang_word": "village",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "village",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A rural habitation of size between a hamlet and a town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8f093d-78cf-4b06-8e7f-811320c300e9",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "There are 2 churches and 3 shops in our village."
                                            },
                                            {
                                                "example_id": "1073d7df-2b2a-48f1-85d5-7bdf53ebb8b1",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "[…]belts of thin white mist streaked the brown plough land in the hollow where Appleby could see the pale shine of a winding river. Across that in turn, meadow and coppice rolled away past the white walls of a village bowered in orchards,[…]"
                                            },
                                            {
                                                "example_id": "a37b78fc-af8b-4cd4-9902-e49b5f2de17e",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "The principal economic activity is copra production, the Government copra plantation covering some 5,170 ha. The population in 1989 was estimated at 2,000, the great majority of whom live in London, Banana and Poland villages in the west."
                                            },
                                            {
                                                "example_id": "c7b63bab-a7b4-4044-9f12-d3d136400ef5",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages."
                                            },
                                            {
                                                "example_id": "11d30e64-baf1-4548-95b1-0ea6bf9e8607",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "It’s just offshore from private property inaccessible to the general public, so a good way to approach the rock is by kayak, which can be rented in the small village of Port Austin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f69ef7dd-dd38-3a5a-9fed-dd5338794462",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A rural habitation that has a church, but no market."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e738d21-d1c1-395b-b985-8d6ccdade342",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A planned community such as a retirement community or shopping district."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4082b44-c79e-3d47-8bc9-7528d2c6906a",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "An exclusive gated community; a subdivision."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55747db8-28da-4c44-858e-36af92b68198",
                                                "sense_id": "a4082b44-c79e-3d47-8bc9-7528d2c6906a",
                                                "text": "There are six blocks in our village, each having ten lots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f46e24b-07ee-4666-b2e4-0a29ff771a7c",
                        "source_entry_id": "53a87eba-6c6f-3fd9-8958-635652b65a26",
                        "source_sense_id": "c30a48e8-1040-30fb-ab04-282bbbb9899d",
                        "target_lang_word": "boerendorp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boerendorp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "afce1cb0-50dd-32e1-bae4-c7cb2efc6912",
                                        "entry_id": "af0d4d60-5dd6-381a-a79f-0598adeaef86",
                                        "glosses": [
                                            "een kleine nederzetting waar mensen voornamelijk werkzaam zijn in de agrarische sector"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec171c7-1a69-438a-aa08-a224d33db0f0",
                                                "sense_id": "afce1cb0-50dd-32e1-bae4-c7cb2efc6912",
                                                "text": "Fischer woont, op zijn studententijd na, zijn hele leven in Lech. Zijn ouders begonnen in 1959 pension Aurora. Lech was nog een boerendorp, het toerisme werd net ontdekt. Het toenmalige koningspaar, Juliana en Bernhard, ging een jaar eerder nog naar het lagergelegen Sankt Anton op wintersport."
                                            },
                                            {
                                                "example_id": "4d1234ca-1fa3-40ac-b951-de556e091a54",
                                                "sense_id": "afce1cb0-50dd-32e1-bae4-c7cb2efc6912",
                                                "text": "Tijdens het liften naar het boerendorp Trout Lake, verscholen in de bergen van Washington, werd ik opgepikt door een vriendelijke, oude man in een versleten tuinbroek, houthakkersoverhemd en een pistool aan zijn riem. Er klonk countrymuziek uit zijn autoradio en hij nodigde mij uit om een nacht in zijn guesthouse in de tuin te blijven logeren."
                                            },
                                            {
                                                "example_id": "f01ec965-a650-450a-91aa-4777eefeb6ec",
                                                "sense_id": "afce1cb0-50dd-32e1-bae4-c7cb2efc6912",
                                                "text": "Na de bevrijding in 1945 kwam de vliegmaatschappij Cogéa naar Keerbergen. Dit betekende de start van de transformatie van een rustig boerendorp naar een toeristisch ontspanningsoord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
