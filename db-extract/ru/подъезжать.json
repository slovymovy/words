                "senses": [
                    {
                        "sense_id": "aa07add9-672b-3a47-8d0f-bbb229f756f3",
                        "entry_id": "ae7b045e-fda8-365a-bf07-31822389a6c6",
                        "glosses": [
                            "to drive up (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db24f53-01a5-4e3b-ad54-5d41da899b08",
                                "sense_id": "aa07add9-672b-3a47-8d0f-bbb229f756f3",
                                "text": "Он подъезжа́ет к подъе́зду.",
                                "translation": "He is driving up to the entrance",
                                "english": "He is driving up to the entrance"
                            },
                            {
                                "example_id": "6e55647e-cb3c-4911-a1cc-a1ac8810230f",
                                "sense_id": "aa07add9-672b-3a47-8d0f-bbb229f756f3",
                                "text": "Мо́жно ли подъезжа́ть сюда́ на автомоби́ле?",
                                "translation": "Can one drive a car here?",
                                "english": "Can one drive a car here?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1e31c43d-a53a-3fb8-936a-fa50b15d22c1",
                        "entry_id": "ae7b045e-fda8-365a-bf07-31822389a6c6",
                        "glosses": [
                            "to drop in, to pay a short visit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "41457e67-8cba-3e52-9552-a8326bfce284",
                        "entry_id": "ae7b045e-fda8-365a-bf07-31822389a6c6",
                        "glosses": [
                            "to get (round), to start a pick up line, to get on the right side (of)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7e0abaa7-4a4c-4f5a-b71a-40a7da60d3ab",
                                "sense_id": "41457e67-8cba-3e52-9552-a8326bfce284",
                                "text": "Ло́вко он к ней подъезжа́ет.",
                                "translation": "He is getting round her very nicely; he is getting on the right side of her",
                                "english": "He is getting round her very nicely; he is getting on the right side of her"
                            }
                        ]
                    }
                ],
