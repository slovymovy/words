                "senses": [
                    {
                        "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                        "entry_id": "c734d844-f243-3dc5-ab9b-58d775e144e6",
                        "glosses": [
                            "Zündmechanismus in einer Feuerwaffe des Mittelalters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bcc2fc8-2ec7-4223-bcff-c040de5b7035",
                                "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                                "text": "„Um dem vorzubeugen, wird hier die Funktionsweise des Steinschlosses erläutert, das bei vielen der verwendeten Gewehre und Pistolen im Fantasylarp den Zündmechanismus darstellt.“"
                            },
                            {
                                "example_id": "964488be-cffa-416f-8ffa-41094d4dcd48",
                                "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                                "text": "„Ein Steinschloss muss eine kräftige Hauptfeder haben, und alle Schlossteile müssen mit minimaler Reibung laufen, damit möglichst wenig an Energie aufgezehrt wird – kräftige Funken brauchen eine Menge Energie!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c47f202d-8251-4b17-a272-2a2aaf739ebf",
                        "source_entry_id": "c734d844-f243-3dc5-ab9b-58d775e144e6",
                        "source_sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                        "source_sense_description": "Technik: Zündmechanismus in einer Feuerwaffe des Mittelalters",
                        "target_lang_word": "flintlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flintlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "667c3201-a70c-3ba3-b485-cf52b78eea2f",
                                        "entry_id": "ee600423-d5f4-34bb-96c2-679e59d8a56b",
                                        "glosses": [
                                            "An early type of firearm, using a spring-loaded flint to strike sparks into the firing pan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc08208c-197a-41be-b2f5-73906b36bf98",
                                                "sense_id": "667c3201-a70c-3ba3-b485-cf52b78eea2f",
                                                "text": "But then I had the flintlock by me for protection. ¶ There were giants in the days when that gun was made; for surely no modern mortal could have held that mass of metal steady to his shoulder. The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08ace89-afd9-3011-8013-433e7850f594",
                                        "entry_id": "ee600423-d5f4-34bb-96c2-679e59d8a56b",
                                        "glosses": [
                                            "A type of lock used on muskets, rifles, and pistols from the early 17th to the mid-19th century."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
