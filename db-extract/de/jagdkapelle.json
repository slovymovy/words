                "senses": [
                    {
                        "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                        "entry_id": "db7846cb-a39b-31c9-965e-84ed9de53e00",
                        "glosses": [
                            "unregelmäßig für Andachten genutzte Kapelle, die zu einem Jagdrevier gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22405a16-56e7-4ce1-8f9c-c948c9fd7ca4",
                                "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                                "text": "„Die Herren des nahegelegenen Schlosses Wildenstein hatten es als Jagdkapelle errichten lassen.“"
                            },
                            {
                                "example_id": "8dffa894-11e8-4bea-a960-e572509696ea",
                                "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                                "text": "„Die Schlossherren von Wildenstein ließen das Bartholomäuskirchlein wohl als Jagdkapelle errichten.“"
                            },
                            {
                                "example_id": "fc942669-33e2-41c3-85a6-76b9435011d2",
                                "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                                "text": "„Der tatsächliche, historisch gesicherte Gründungsgrund der Kirche war jedoch ein anderer: An der Stelle der heutigen Sakristei entstand an der Wegkreuzung des Brunnen an der Pilgerstraße in MarialindenWegs von Bernsau über Höhe nach Meegen und der Brüderstraße, einem alten Handelsweg zwischen Köln und Siegen, eine Jagdkapelle der Grafen von Bernsau.“"
                            },
                            {
                                "example_id": "8c030869-353a-4618-8f84-10027d004e9b",
                                "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                                "text": "„Die am Haus Penzinger Strasse 92 angebrachte Pieta erinnert daran, dass im 17. Jahrhundert an dieser Stelle eine Jagdkapelle stand.“"
                            },
                            {
                                "example_id": "c5a05e06-c372-4d11-bfb1-07b4953002c0",
                                "sense_id": "db45d2bf-3df0-3053-96e4-cb7b2ec48141",
                                "text": "„Seit 1808 kann man frühestens von einer kirchlichen Gemeinschaft in Schwimmbach sprechen, schon lange vorher existierte aber eine kleine Jagdkapelle und daneben ein kleiner Bauernhof, die wohl von der herzoglichen Jagdgesellschaft gestiftet worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
