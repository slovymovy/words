                "senses": [
                    {
                        "sense_id": "e9389b35-6f37-3460-9fb8-760998685628",
                        "entry_id": "6d1fad46-8c8e-3ad8-a02e-6b82ff1e6fc1",
                        "glosses": [
                            "Koch, der in einer Rotisserie oder innerhalb einer Küchenbrigade größerer Restaurants für die Zubereitung von Braten, Pfannengerichten und Frittiertem zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644a3b50-2c3f-4b16-bf8f-538c15e40d09",
                                "sense_id": "e9389b35-6f37-3460-9fb8-760998685628",
                                "text": "„In seiner jetzigen Position bekleidet er die Rolle des Rotisseurs und Poissonniers. ‚Einen klassischen Rotisseur, der riesige Schmorbraten zubereitet und vor dem Gast tranchiert, gibt es heute kaum noch, weil auch die entsprechende Klientel nicht mehr vorhanden ist‘, erläutert Halfter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3cdc4dc-4ab1-4e85-a667-32d4f4408373",
                        "source_entry_id": "6d1fad46-8c8e-3ad8-a02e-6b82ff1e6fc1",
                        "source_sense_id": "e9389b35-6f37-3460-9fb8-760998685628",
