                "senses": [
                    {
                        "sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                        "entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "glosses": [
                            "Berufsbild, Unternehmerin, die verstorbene Personen beisetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a5f94b-67d3-44d3-9525-497bb89be9af",
                                "sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                                "text": "Die Bestatterin holte den verstorbenen Opa ab und überführte seinen Leichnam ins Krematorium."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba64c59e-73fc-4ade-95e6-89416ed838d4",
                        "source_entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "source_sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                        "source_sense_description": "Berufsbild, Unternehmerin, die verstorbene Personen beisetzt",
                        "target_lang_word": "undertaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undertaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e9cff7-22e7-3e15-b963-9c67b82f3d50",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A funeral director; someone whose business is to manage funerals, burials and cremations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc6e3a4-d6ba-349b-aee4-453d04625857",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A person receiving land in Ireland during the Elizabethan era, so named because they gave an undertaking to abide by several conditions regarding marriage, to be loyal to the crown, and to use English as their spoken language."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3dc2e9-f4ce-4171-8586-6da9fdd399af",
                                                "sense_id": "fdc6e3a4-d6ba-349b-aee4-453d04625857",
                                                "text": "In 1588, Edmund Spenser became an undertaker in the first Elizabethan plantation, receiving the forfeited Irish estate of Kilcolman Castle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad596b2-9db3-3f93-b297-ff0d45c5b06c",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A contractor for the royal revenue in England, one of those who undertook to manage the House of Commons for the king in the Addled Parliament of 1614."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "One who undertakes or commits to doing something."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b66859a-9be1-4f2e-b211-cc6f7ad16bc9",
                                                "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                                "text": "A company shall not be appointed to be a water undertaker unless it is a limited company or a statutory water company and shall not be appointed to be a sewerage undertaker unless it is a limited company."
                                            },
                                            {
                                                "example_id": "4099b1be-13dc-40b5-8a81-9a277ae9a1bf",
                                                "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                                "text": "The undertaker of the enterprise is usually known today by the French term entrepreneur because we have surrendered the English word to the undertakers of funerals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6d40a29-4680-439f-9b2a-75d7ad3a30fc",
                        "source_entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "source_sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                        "source_sense_description": "Berufsbild, Unternehmerin, die verstorbene Personen beisetzt",
                        "target_lang_word": "funeral director",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funeral director",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bbd75a-8a4a-31a2-b3c4-3cd3f6d751ad",
                                        "entry_id": "7110d668-b418-3892-8718-ce4ef4c417bf",
                                        "glosses": [
                                            "An undertaker; one who arranges funerals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e265d5fb-9835-4c2a-bac5-1219e4892644",
                                                "sense_id": "20bbd75a-8a4a-31a2-b3c4-3cd3f6d751ad",
                                                "text": "Near-synonyms: cremator, embalmer, mortician"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e11dce5-b382-43fe-bc68-7d371fb32967",
                        "source_entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "source_sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                        "source_sense_description": "Berufsbild, Unternehmerin, die verstorbene Personen beisetzt",
                        "target_lang_word": "mortician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                        "entry_id": "2d3edd3b-4856-3f4e-9f8c-5b19872e2aa5",
                                        "glosses": [
                                            "An undertaker or funeral director; especially, one who is also the embalmer or cremator."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99d0c10-9941-438e-8375-31811a7c8308",
                                                "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                                "text": "“And I prefer mortician to funeral director. It sounds more professional and, well, it is more precise. I deal with more than mere funerals; I deal with death, passing on, the transition.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "896bcbb9-7565-4313-8b6f-0fdc30c69dd6",
                        "source_entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "source_sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
                        "source_sense_description": "Berufsbild, Unternehmerin, die verstorbene Personen beisetzt",
                        "target_lang_word": "croque-mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croque-mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                                        "entry_id": "a9844346-ad3e-3c16-a21b-70048a29df38",
                                        "glosses": [
                                            "Celui ou celle qui est chargé de transporter les morts au cimetière."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d4de92-5cd9-4be6-ad7e-7830e6015e52",
                                                "sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                                                "text": "Un gardien dont le rôle était de donner aux croque-morts décharge, sur un registre, des cercueils qu'il avait comptés et vu inhumer, signa le livre et apposa son timbre en marge."
                                            },
                                            {
                                                "example_id": "324b0c91-adae-4546-b859-e16e93fa426e",
                                                "sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                                                "text": "Quand les héritiers étaient contents\nAu fossoyeur, au croque-mort, au curé, aux chevaux même\nIls payaient un verre."
                                            },
                                            {
                                                "example_id": "251d1cd1-937a-40fd-9949-e2419602bf48",
                                                "sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                                                "text": "— À cinq heures du soir les croque-morts arrivèrent pour la mise en bière."
                                            },
                                            {
                                                "example_id": "99e45a74-3aa9-43c3-8afa-fa9df37cf294",
                                                "sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                                                "text": "Ce dernier ne présentant aucune réaction, il lui retira délicatement son chapeau de paille mité, un signe distinctif de ces croque-morts de fortune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cb8902c-c04e-468c-aff3-e572179be818",
                        "source_entry_id": "a449b424-aa26-32ed-8d45-5b3a6e730fc3",
                        "source_sense_id": "ff4c63fb-4846-30de-b173-1a57fdef882b",
