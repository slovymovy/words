                        "source_sense_id": "34e8273e-6c6b-3f69-801b-dfda7cfb8f45",
                        "source_sense_description": "Wassertropfen, der durch Tau entstanden ist",
                        "target_lang_word": "dauwdruppel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dauwdruppel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bc52c0bf-dff2-383f-95c7-acf1dc68f37d",
                                        "entry_id": "4144ce33-978e-3e5b-ab32-9090694cb837",
                                        "glosses": [
                                            "elk van de talrijke bolletjes gecondenseerd water die op het koudst van de nacht, net voor zonsopgang, uit de lucht neerslaan op voorwerpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5e6399-492c-4674-96e6-47d94e6c06fa",
                                                "sense_id": "bc52c0bf-dff2-383f-95c7-acf1dc68f37d",
                                                "text": "Margarita zorgde voor het ontwerp, juwelier Röell Diamonds and Jewels uit Antwerpen tekende voor de uitvoering en vervaardiging. Aan de eerdere ontwerpen is nu heel subtiel kleur toegevoegd, en er is voor het eerst ook witgoud gebruikt. De bladeren - 'leaves'in het Engels - zijn voorzien van dauwdruppels in de vorm van diamanten."
                                            },
                                            {
                                                "example_id": "92e32f86-08d6-4650-b2f5-c43847854c24",
                                                "sense_id": "bc52c0bf-dff2-383f-95c7-acf1dc68f37d",
                                                "text": "Zegna, waar Stefano Pilati creatief de scepter zwaait, imponeerde met het decor. Er was een groot regenwoud nagebouwd waardoor de mannen op de catwalk iets weg hadden van eco-strijders. Een lange rechte double breasted lurex jas glansde alsof er fijne dauwdruppels op de stof lagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
