                "senses": [
                    {
                        "sense_id": "9cbfe9bd-2e1f-3276-aef4-d92ada6c83d2",
                        "entry_id": "591f0e58-87a5-384b-ba45-76c88c48e300",
                        "glosses": [
                            "trifle, bagatelle; an activity or amount that is trivial and of little consequence"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "neuter",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c041a987-0411-4efa-8afe-0414d99b3a50",
                                "sense_id": "9cbfe9bd-2e1f-3276-aef4-d92ada6c83d2",
                                "text": "Eine Strafe in Höhe von 15 000 Euro, wie von der Regierung vorgeschlagen, ist Pillepalle. Das zahlen die aus der Portokasse.",
                                "translation": "A fine in the amount of 15,000 euros, as suggested by the government, is basically nothing. That's spare change to them.",
                                "english": "A fine in the amount of 15,000 euros, as suggested by the government, is basically nothing. That's spare change to them."
                            },
                            {
                                "example_id": "d9b115cd-0ea0-4bb2-8650-eaf32c836949",
                                "sense_id": "9cbfe9bd-2e1f-3276-aef4-d92ada6c83d2",
                                "text": "Nach der Sommerpause dürfe es dann von der Regierung beim Klimaschutz aber \"kein Pillepalle mehr\" geben, sagte die Kanzlerin Teilnehmerangaben zufolge. Es dürfe dann nicht mehr darum gehen, hier und dort noch einen Cent draufzuschlagen. Stattdessen seien Beschlüsse nötig, die zu \"disruptiven\" Veränderungen führen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d21424d-b60c-3f6a-89a3-365f018f6444",
                        "entry_id": "591f0e58-87a5-384b-ba45-76c88c48e300",
                        "glosses": [
                            "nonsense; something that is pointless"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "neuter",
                            "no-plural",
                            "strong",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "b03aa316-5b5c-40b1-8931-e835991ab829",
                                "sense_id": "1d21424d-b60c-3f6a-89a3-365f018f6444",
                                "text": "Zu dem, was ich heute lesen konnte – die Bundeskanzlerin will das Pillepalle in der Klimapolitik beenden –, kann ich nur sagen: Wenn Sie dieses teure Pillepalle meinen, dann haben Sie die Freien Demokraten an Ihrer Seite."
                            },
                            {
                                "example_id": "c45b2729-d57a-425a-bd3d-3cd960698430",
                                "sense_id": "1d21424d-b60c-3f6a-89a3-365f018f6444",
                                "text": "Training in Kleingruppen wie bei den Profis? – für die Amateure ist das kein Modell. „Kontaktloser Fußball ist doch Pillepalle“, sagt Thomas Loest, der Vorsitzende von Eintracht Mahlsdorf.",
                                "translation": "Training in small groups, like professional athletes do? For amateurs, that's not a viable model. \"Contact-free football is nonsense\", says Thomas Loest, chairman of Eintracht Mahlsdorf.",
                                "english": "Training in small groups, like professional athletes do? For amateurs, that's not a viable model. \"Contact-free football is nonsense\", says Thomas Loest, chairman of Eintracht Mahlsdorf."
                            }
                        ]
                    }
