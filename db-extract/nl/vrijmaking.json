                                        "sense_id": "d465e6fa-b00d-3bb8-8e8c-202cbac7a2c4",
                                        "entry_id": "ccf493db-d8c3-3922-9cfd-8b58991c13ec",
                                        "glosses": [
                                            "The act of setting free from the power of another, as from slavery, subjection, dependence, or controlling influence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
