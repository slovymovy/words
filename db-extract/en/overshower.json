                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0021eeec-c58a-4d7e-a1f4-d4b14873b09c",
                                "sense_id": "3608bc04-0513-3ba3-9df7-26f48777e168",
                                "text": "[…] they are said to hate and punish wrong and violence; they may show mercy to those who call upon them in their afflictions, their faithful worshipper they overshower with favors."
