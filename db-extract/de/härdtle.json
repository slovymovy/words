                ],
                "senses": [
                    {
                        "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                        "entry_id": "c66e5a93-c13e-3998-8eab-5635be55eee3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d5060b-eec1-4851-baee-0d787cd9940b",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Frau Härdtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "29cfb71c-2439-451a-b6f7-b225df368723",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Herr Härdtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "958954da-5d72-4a52-b057-2585ef4442b6",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Die Härdtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "784efdad-dddb-4020-8867-b038c26aa233",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Der Härdtle trägt nie die Schals, die die Härdtle ihm strickt."
                            },
                            {
                                "example_id": "3b7560d5-7e7f-4302-8e6d-3392a9cda6fa",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Härdtle kommt, geht der Herr Härdtle.“"
                            },
                            {
                                "example_id": "2b0a0f8c-3ca5-40c2-b15a-7a20301d6c42",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Härdtle kommt und geht."
                            },
                            {
                                "example_id": "526d2dc0-ee4b-45ad-a6a8-d334f1495edd",
                                "sense_id": "a366dda5-7258-3f9a-b8df-d22eb4066742",
                                "text": "Härdtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
