                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2449e46-05e5-496b-9949-d487ed237098",
                                "sense_id": "6214856b-9358-3d6e-9da2-65deceffe270",
                                "text": "„Einen Augenblick später, die Kutsche klapperte in der Ferne über die Muddy Dock Bridge, erschien Weeden, und die Versammelten reihten sich auf der Straße schweigend in militärischer Formation auf und schulterten die Büchsen, Jagdflinten oder Walharpunen, die sie bei sich hatten.“"
                            },
                            {
                                "example_id": "f29cc4f6-48bc-49d1-b73a-e5c8362fd218",
                                "sense_id": "6214856b-9358-3d6e-9da2-65deceffe270",
                                "text": "„Die Schnitte stammten eindeutig von etwas Menschengemachtem, einem scharfen, metallenen Gegenstand wie etwa der Spitze eines Speeres oder einer Walharpune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
