                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa361883-b658-4d35-b0c2-b0f28045bada",
                                "sense_id": "8c7b3c43-c6e6-3ed4-829d-4d918a69985c",
                                "text": "Xanthomyelomas are in most cases connected with tendon sheaths and constitute the commonest type of tendon-sheath tumor."
                            },
                            {
