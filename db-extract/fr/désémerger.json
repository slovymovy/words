                            {
                                "example_id": "d0170381-ed30-461c-b939-29a4d91a30bf",
                                "sense_id": "f600dda5-2792-3770-b97d-6d959cd03259",
                                "text": "Une autre opportunité lui est offerte, celle de désémerger, ce qui revient à redescendre d’un étage. Cela consiste à muter quand on est chromosome, à faire tabula rasa, à savoir la révolution, quand on est société humaine ; c’est enfin se remettre individuellement en question quand rien ne va plus."
                            },
                            {
                                "example_id": "6eb250b7-3cda-4c23-926b-e921a0689b10",
                                "sense_id": "f600dda5-2792-3770-b97d-6d959cd03259",
                                "text": "Que puis-je faire d'autre que désémerger, pour me tourner vers du soulagement ou de la visite ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "89d9e5f4-54fb-34e9-97f4-a5f523e728dc",
