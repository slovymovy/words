                                        "sense_id": "cd3cafc9-d997-3fd0-8490-b19672a7e895",
                                        "entry_id": "4e1f8a77-6448-32a3-a7a2-2a436217ac8a",
                                        "glosses": [
                                            "A large, palatial urban building in Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cccae82c-7e3e-4436-acf2-2b3dd5da8649",
                                                "sense_id": "cd3cafc9-d997-3fd0-8490-b19672a7e895",
                                                "text": "Cecil Spenser's society—who soon shewed he could understand and enter into his views—became a source of great gratification, and his young countryman was almost domesticated at the palazzo."
                                            },
                                            {
                                                "example_id": "e118579a-6c89-411d-8e74-1b0765fcc5f1",
                                                "sense_id": "cd3cafc9-d997-3fd0-8490-b19672a7e895",
                                                "text": "At the piazzas, Romans are usually surrounded by tourists attracted by the classical palazzos, churches, monuments and fountains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
