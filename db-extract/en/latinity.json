                "translations": [
                    {
                        "translation_id": "ae81ee1b-67d3-4e6d-b925-99c8d5034302",
                        "source_entry_id": "4f2ca975-b5ae-34c7-a735-8b0a59f1801c",
                        "source_sense_description": "essence of being Latin",
                        "target_lang_word": "latinité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latinité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04559a3c-a0b2-3408-b25f-6a53670c6b04",
                                        "entry_id": "11ae8c9d-da79-3a44-9585-2556eabb4f74",
                                        "glosses": [
                                            "Langage latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb5f3b3-0282-41df-a6bf-1f1d8ff92a11",
                                                "sense_id": "04559a3c-a0b2-3408-b25f-6a53670c6b04",
                                                "text": "Cependant on trouve encore des liens qui rattachent à la latinité les chants des troubadours et des trouvères. La rime qu'ils emploient a commencé à se produire insensiblement dans la poésie latine des temps barbares."
                                            },
                                            {
                                                "example_id": "0ac27cad-00fe-4a15-a69d-3b02d47c2f51",
                                                "sense_id": "04559a3c-a0b2-3408-b25f-6a53670c6b04",
                                                "text": "Mgr Jean-Marie-Malthias Debelay est né à Viriat (Ain) le 24 février 1800 d'une famille honorable. Il fit avec distinction, au collège de Bourg, ses classes de latinité."
                                            },
                                            {
                                                "example_id": "5b381990-1922-472d-b798-a5ae367ace2f",
                                                "sense_id": "04559a3c-a0b2-3408-b25f-6a53670c6b04",
                                                "text": "Là-dessus arrivèrent les savants, les grammairiens, les pédants, et particulièrement Robert Estienne, avec son dictionnaire de 1540. Robert Estienne était féru de latinité et d’étymologie. Il voulut calquer la langue française sur la latine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc842d3-c798-37d9-9900-c1994a4544b5",
                                        "entry_id": "11ae8c9d-da79-3a44-9585-2556eabb4f74",
                                        "glosses": [
                                            "Ensemble des nations de langue et de civilisation latine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2455b539-9dc2-4d65-8eba-dff2510b6e6c",
                                                "sense_id": "6fc842d3-c798-37d9-9900-c1994a4544b5",
                                                "text": "L’enjeu majeur pour la nouvelle université roumaine consista, bien évidemment, à trouver la meilleure organisation possible en matière d’enseignement et de recherche pour s’imposer sous la scène européenne, tout en valorisant son caractère national (voire de latinité)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d574bc57-410c-4ae1-b2e1-ff697608fd93",
                        "source_entry_id": "4f2ca975-b5ae-34c7-a735-8b0a59f1801c",
                        "source_sense_description": "essence of being Latin",
                        "target_lang_word": "Latinität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latinität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                                        "entry_id": "dd54596b-1d4c-3294-8c50-128bcac71cf6",
                                        "glosses": [
                                            "Schreibweise des Lateinischen, die klassisch und mustergültig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85dfb5f-fb4b-4261-b001-b82d0f5cd492",
                                                "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                                                "text": "„Inzwischen bin ich durch vielfältige meinem Amte über angemerkte Exempel überzeugt, daß, wenn sich ein junger Mensch in diesem meinem Schulbuche fleißig umsiehet, er dadurch unvermerkt einen guten Geschmak von der reinen und zierlichen Latinität überkömt, der ihn in den Stand setzt, andere vorkommende Wörter und Redensarten, ob sie dem Geiste einer reinen Schreibart gemäß sind, zu beurtheilen.“ (1753)"
                                            },
                                            {
                                                "example_id": "14a7245f-d8e5-41db-89b6-b5c19df18b73",
                                                "sense_id": "a5d0300e-4ab7-3714-a97c-6738199af791",
                                                "text": "„Ich werde gewiß nie lernen, sie zu erkennen, wie mir auch nie klargeworden ist, inwiefern Titus Livius angeblich gegen die Latinität verstieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e02d001-243a-3a99-b278-fc190d6e2a3e",
                                        "entry_id": "dd54596b-1d4c-3294-8c50-128bcac71cf6",
                                        "glosses": [
                                            "klassische schriftliche Quellen (Schrifttum) des Lateinischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1f3da8-3bad-42d9-a0e4-b646c9aaea59",
                                                "sense_id": "8e02d001-243a-3a99-b278-fc190d6e2a3e",
                                                "text": "„Als qualifizierendes \"Eigenschaftswort\" hingegen ist nescius in der klassischen Latinität nicht nachweisbar, taucht jedoch zweimal bei Plautus in der passivischen Bedeutung \"unbekannt\" auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
