                        "translation_id": "2dc2c03d-a09d-4e8c-8bb6-0cad5f2913c5",
                        "source_entry_id": "164cc816-37e9-398e-9ae4-d50e2f9b3d93",
                        "source_sense_id": "7f7addc6-555d-3dd0-8abf-db6374f8a0ec",
                        "source_sense_description": "deserving of merit or commendation; deserving reward",
                        "target_lang_word": "benemérito",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benemérito",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3e39fd77-c3c7-3baa-9ad0-667a85c61d66",
                                        "entry_id": "c1c08d4a-e95b-36a7-93e4-ba650ad48a2c",
                                        "glosses": [
                                            "Digno de reconocimiento o distinción por sus actos o servicios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa09177f-38d5-424e-8565-1b909e09bdd7",
                                                "sense_id": "3e39fd77-c3c7-3baa-9ad0-667a85c61d66",
                                                "text": "No es dueño, sino administrador de las dignidades, y debe considerarse como hombre caído de las nubes, sin vínculos de parentesco, amistad ni gratitud, y, por tanto, tendrá mil veces que negar su protección a las personas de su mayor aprecio por no hacer agravio a un desconocido benemérito."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2e6f4bd-c128-33e0-b397-3d3cde8ce9ef",
                                        "entry_id": "c1c08d4a-e95b-36a7-93e4-ba650ad48a2c",
                                        "glosses": [
                                            "Perteneciente al cuerpo de la Guardia Civil española, popularmente conocido como Benemérita."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bd201f-bfd4-4786-bf0c-0fb2a9bfcbbd",
                                                "sense_id": "f2e6f4bd-c128-33e0-b397-3d3cde8ce9ef",
                                                "text": "No quiero yo dudar de las garantías democráticas de España, pero si los Mägo de Oz se personan en un cuartelillo de la Guardia Civil disfrazados de piratas a pedir aunque sea la hora, desencadena sobre ellos el sargento benemérito una lluvia de hostias tal que les cambia las vestiduras por una de torero."
                                            },
                                            {
                                                "example_id": "1fd1841f-a68c-46c2-9c70-86ecca62d6e0",
                                                "sense_id": "f2e6f4bd-c128-33e0-b397-3d3cde8ce9ef",
                                                "text": "Hace unos días, un histórico agente de la Guardia Civil falleció en unas traumáticas circunstancias tras acudir a socorrer a dos ancianos que habían sufrido un accidente de tráfico. El benemérito era muy conocido y apreciado en el País Vasco, donde estuvo destinado diez años luchando contra ETA."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
