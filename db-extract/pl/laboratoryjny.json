                        "glosses": [
                            "dotyczący laboratorium, odbywający się lub wykonywany w laboratorium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca9ce48-a396-41d0-918f-de738ad853f3",
                                "sense_id": "44208295-2db8-31d1-8439-05f61c91140e",
                                "text": "Diagnostyka nadprodukcji hormonów obejmuje testy laboratoryjne mierzące poziom hormonów we krwi lub moczu, testy dynamiczne oceniające funkcję gruczołów oraz badania obrazowe (USG, TK, MRI) identyfikujące potencjalne zmiany anatomiczne."
                            },
                            {
                                "example_id": "5c62f8b7-a574-4f3f-aa6c-fa9eb764ee88",
                                "sense_id": "44208295-2db8-31d1-8439-05f61c91140e",
                                "text": "]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
