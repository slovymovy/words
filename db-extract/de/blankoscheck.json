                "senses": [
                    {
                        "sense_id": "68df7826-8166-39ab-bb17-141ee717d79e",
                        "entry_id": "7e5f9ab6-3283-3ca7-a511-efdc99fb33be",
                        "glosses": [
                            "unterschriebener Scheck, auf dem der Geldbetrag nicht eingetragen ist und später ergänzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b4dc8e-d480-4b21-ab6c-1a42636e4477",
                                "sense_id": "68df7826-8166-39ab-bb17-141ee717d79e",
                                "text": "So mancher hätte gerne einen Blankoscheck."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49ae6c1b-09d4-3967-8894-4b96b141d42d",
                        "entry_id": "7e5f9ab6-3283-3ca7-a511-efdc99fb33be",
                        "glosses": [
                            "Vollmacht/Erlaubnis, die keinen Einschränkungen unterliegt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "12ada19f-cd71-43c3-81f7-d262813aba69",
                                "sense_id": "49ae6c1b-09d4-3967-8894-4b96b141d42d",
                                "text": "„Und das Habsburgerreich konnte das nur tun, weil ihm das Deutsche Reich zuvor einen Blankoscheck ausgestellt hatte.“"
                            },
                            {
                                "example_id": "b18ec72b-6699-4ebb-9217-4abac609e327",
                                "sense_id": "49ae6c1b-09d4-3967-8894-4b96b141d42d",
                                "text": "„Doch trotz allen Bemühens um Transparenz: Der Ringkampf teilt die Stadt. Denn letztlich unterschreiben die Hamburger einen Blankoscheck. Zum einen sind Kostenüberschreitungen bei Olympischen Spielen nicht die Ausnahme, sondern die Regel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9faef1b6-050f-46d5-ac71-920ea99516d2",
                        "source_entry_id": "7e5f9ab6-3283-3ca7-a511-efdc99fb33be",
                        "source_sense_id": "68df7826-8166-39ab-bb17-141ee717d79e",
                        "source_sense_description": "unterschriebener Scheck, auf dem der Geldbetrag nicht eingetragen ist und später ergänzt wird",
                        "target_lang_word": "blank check",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blank check",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fec12f8-42f8-3680-befd-efe9bcd53e89",
                                        "entry_id": "849a2184-e1d1-3e29-bef0-035084343f0f",
                                        "glosses": [
                                            "A signed check of the type used to draw money from a bank account, containing no information as to the amount to be paid with it, so that any amount can be filled in."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fccd9b12-d2ce-3962-b4b8-b934de0c9dea",
                                        "entry_id": "849a2184-e1d1-3e29-bef0-035084343f0f",
                                        "glosses": [
                                            "A grant of complete authority to spend an unlimited amount of money, or to take other actions without restraint."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17e7b74-5342-4024-a4aa-56a28e48c498",
                                                "sense_id": "fccd9b12-d2ce-3962-b4b8-b934de0c9dea",
                                                "text": "Nixon and Kissinger had established a blank check policy, giving the Shah a free hand to buy as many American weapons systems as he wanted, even the most technologically advanced, so long as they were not nuclear."
                                            }
                                        ]
                                    }
                                ]
                            }
