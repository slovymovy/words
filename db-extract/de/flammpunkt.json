                        "form": "den Flammpunkt"
                    },
                    {
                        "form_id": "d0a162cd-8559-4821-9784-a0c9a10de4ff",
                        "entry_id": "c54ef8c2-c818-355d-b4e3-6e2206766239",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flammpunkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                        "entry_id": "c54ef8c2-c818-355d-b4e3-6e2206766239",
                        "glosses": [
                            "die tiefstmögliche Temperatur, bei der eine Flüssigkeit im Raum über sich ein brennbares Gas-Luft-Gemisch in Abhängigkeit vom Luftdruck bilden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c78d6b-afaf-4a45-9386-36932000344d",
                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                "text": "Nach der Deutschen Industrienorm 7732, Blatt 1, vom Juni 1963 ist der Flammpunkt die niedrigste Temperatur bei der aus einer Flüssigkeit, bei einem Luftdruck von 760 Torr, so viele Moleküle vom flüssigen in den gasförmigen Aggregatzustand übergehen, dass diese mit der über dem Flüssigkeitsspiegel stehenden Luft ein entflammbares Gasgemisch bilden."
                            },
                            {
                                "example_id": "1f9905fa-3da4-4499-9d46-8e7116d73201",
                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                "text": "Der Flammpunkt ist vom Brennpunkt zu unterscheiden."
                            },
                            {
                                "example_id": "ede136d3-35d1-4cae-ac23-4561da2bf3f6",
                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                "text": "Für die Gefahrenklassen von brennbaren Flüssigkeiten ist der Flammpunkt ein mitentscheidendes Kriterium."
                            },
                            {
                                "example_id": "dbca7df8-001f-4d22-8de1-ccf21021b9c8",
                                "sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                                "text": "Der Flammpunkt von Benzin liegt unterhalb von -20°C (256 K) und der von Ether bei -49°C (227 K)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd12a398-c497-4ed8-94d4-5cc83709fd68",
                        "source_entry_id": "c54ef8c2-c818-355d-b4e3-6e2206766239",
                        "source_sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                        "target_lang_word": "flash point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flash point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21b140b7-783e-3163-8a87-d33dd54b8610",
                                        "entry_id": "6a29eab7-fd73-372d-bddd-652be1659346",
                                        "glosses": [
                                            "The lowest temperature at which a liquid can form an ignitable mixture in air near the surface of the liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da051864-c2f2-4368-8bc3-01c1f5d23b5d",
                                                "sense_id": "21b140b7-783e-3163-8a87-d33dd54b8610",
                                                "text": "The whole cursed corporation ought to be rooted out and drowned in its own incombustible product. What is the flash point of this condemned coal oil anyway?"
                                            },
                                            {
                                                "example_id": "6862d115-39d8-42b1-9ce6-99302aca4f53",
                                                "sense_id": "21b140b7-783e-3163-8a87-d33dd54b8610",
                                                "text": "The flash point of new oils varies with viscosity: higher viscosity oils have higher flash points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639fc4a8-1d18-39bb-b12d-92bf1c5fd72f",
                                        "entry_id": "6a29eab7-fd73-372d-bddd-652be1659346",
                                        "glosses": [
                                            "A hotspot; a dangerous place of violent political unrest."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2128465-3c33-4901-ba90-115d57982273",
                                                "sense_id": "639fc4a8-1d18-39bb-b12d-92bf1c5fd72f",
                                                "text": "This strategic outcrop is home to a handful of derelict buildings once used to house US military personnel. But it has become a new flashpoint in the global rivalry between Beijing and Washington, as the US struggles to develop a coherent strategy to deal with China’s rising influence in Latin America."
                                            },
                                            {
                                                "example_id": "31b6f924-f74e-4f9b-89b6-891ca7525f51",
                                                "sense_id": "639fc4a8-1d18-39bb-b12d-92bf1c5fd72f",
                                                "text": "The forces of two nuclear weapons states have set about each other with clubs and rocks at one of the most forbidding flashpoints in the world, in a bloody incident that highlights the constant dangers posed by expansionist nationalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79d4e5eb-7dc8-4a2b-a442-25100fb77f8f",
                        "source_entry_id": "c54ef8c2-c818-355d-b4e3-6e2206766239",
                        "source_sense_id": "15c9fe51-d4e0-38fa-8d85-b7b92d763ba7",
                        "target_lang_word": "point d’éclair",
