                        "entry_id": "8445003d-0b6b-3d24-8b37-341d8bbf25ee",
                        "glosses": [
                            "Inflammation du périoste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8184fc-7f39-4743-b664-16542a222e28",
                                "sense_id": "0fe7025d-ca34-3571-988b-89bf1c2696f0",
                                "text": "La périostite est ressentie comme une douleur ou brûlure au niveau du tibia lors d’activité physique et le plus souvent chez les adeptes de la course à pied."
                            },
                            {
                                "example_id": "737fcb5c-d5f4-481b-84dd-aa59203fe892",
                                "sense_id": "0fe7025d-ca34-3571-988b-89bf1c2696f0",
                                "text": "Dans la périostite avec mortification du périoste, la membrane se détache sous forme de fibres ou de lambeaux, que l’on voit quelquefois assez longtemps à nu et décollés sur l’os, et qui finissent par être entraînés par la suppuration."
                            }
                        ]
                    }
