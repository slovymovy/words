                        "target_lang_word": "Schwesterchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwesterchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "704017bf-147f-3643-ac74-a2d650440cbf",
                                        "entry_id": "4830c251-74ea-3325-ac1f-31c9cb326111",
                                        "glosses": [
                                            "kleine Schwester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05debcdf-84ba-4cf4-a853-9ce0e6bbf75c",
                                                "sense_id": "704017bf-147f-3643-ac74-a2d650440cbf",
                                                "text": "„Sie sorgt sich ein wenig um ihr Schwesterchen, das in der Dämmerung mit der Ziege losgezogen und bis zum Abendbrot nicht zurückgekommen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a35ab37c-e51a-4f45-93fe-6444b3d0f993",
                        "source_entry_id": "0a9a4270-21c1-3519-b4cc-347eadef4d3a",
                        "source_sense_id": "8bfe4b8d-9035-3b9f-aaf3-9a1dc0d44716",
