                "senses": [
                    {
                        "sense_id": "1fcd6436-8757-3e5f-b687-f2f47e6ef853",
                        "entry_id": "c33614ea-ad3f-334b-ba2c-5b02f083e4be",
                        "glosses": [
                            "Enlever quelque chose qui se trouvait dans un silo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44d8f79-e5bc-4e37-91b4-e7e4dd522468",
                                "sense_id": "1fcd6436-8757-3e5f-b687-f2f47e6ef853",
                                "text": "Emploi du jet d’eau pour désiloter les betteraves."
                            },
                            {
                                "example_id": "6b77c051-da0a-4d3e-ab2a-657616667b1b",
                                "sense_id": "1fcd6436-8757-3e5f-b687-f2f47e6ef853",
                                "text": "D’un autre côté, la moitié au moins de la pulpe ayant besoin d’être mise en silo et désilotée ensuite, il y a à prévoir une dépense supplémentaire pour cet objet, telle que le transport du silo à la manutention : de la manutention à l’auge, la vidange du fumier des étables, son chargement, son transport, son déchargement et son répandage aux champs."
                            }
                        ]
                    },
                    {
                        "sense_id": "3893778a-5030-3b33-9e64-1192c6cc19a9",
                        "entry_id": "c33614ea-ad3f-334b-ba2c-5b02f083e4be",
                        "glosses": [
                            "Refaire communiquer entre eux des silos de données, ou autres silos (le mot silo étant ici pris dans un sens péjoratif)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af539cc5-ec3c-4a1b-ba1c-0ca9c6740637",
                                "sense_id": "3893778a-5030-3b33-9e64-1192c6cc19a9",
                                "text": "Désiloter les données est un projet ambitieux, souvent complexe, qui ne peut pas se réaliser du jour au lendemain."
                            },
                            {
                                "example_id": "7075a572-9de0-4618-b77e-ece73653ea6b",
                                "sense_id": "3893778a-5030-3b33-9e64-1192c6cc19a9",
                                "text": "Pour “désiloter” vos entreprises, mariez les cultures !"
                            }
                        ]
                    }
                ],
