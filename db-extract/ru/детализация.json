                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cdc2b2e-1a57-4cd2-8876-6addfdd5beed",
                        "source_entry_id": "b223d6a7-24cc-3a28-8753-24bd75620ed0",
                        "source_sense_description": "действие",
                        "target_lang_word": "detailing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detailing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8d0abd-d68a-3a55-9373-9b11453131d9",
                                        "entry_id": "15bc3d5a-a6bf-3f6e-869f-4631f3d9409f",
                                        "glosses": [
                                            "A thorough description or explanation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6cd82df-7c47-4318-a5aa-e4972404750c",
                                                "sense_id": "bb8d0abd-d68a-3a55-9373-9b11453131d9",
                                                "text": "Less successful are the flotsam-y parts of the book — the arbitrary releases about Ebbesmeyer’s career struggles or the detailings of one too many garbage finds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef66ccfc-9e08-3649-a496-0d9174e34ab8",
                                        "entry_id": "15bc3d5a-a6bf-3f6e-869f-4631f3d9409f",
                                        "glosses": [
                                            "An assignment to someone to undertake a particular task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                        "entry_id": "15bc3d5a-a6bf-3f6e-869f-4631f3d9409f",
                                        "glosses": [
                                            "An ornamentation or decoration on something that has been constructed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6291efdd-88c2-446e-a7e1-24298cf62e22",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "a dress with elaborate neck detailings"
                                            },
                                            {
                                                "example_id": "667f66eb-cdb0-49c0-a594-8849510182ee",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "Provided are matching satin ribbon detailings, topped with an embroidered floral bouquet in delicate contrasting shades."
                                            },
                                            {
                                                "example_id": "57ecf0ba-2b71-4096-84a8-997f3df1f148",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "Terrific, new detailings including see-through full length walkway and platforms with special tank train end couplings"
                                            },
                                            {
                                                "example_id": "7b757402-fc5a-4beb-ac2a-d67524f26842",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "In 1963, the Penrose owners traded up to a giant DeRaffele unsurpassed in exaggerated detailings, including a towering, steel A-frame entryway and crinkle-cut, folded-plate eaves."
                                            },
                                            {
                                                "example_id": "541fe341-2a7c-4faf-a923-c283beb2960e",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "Early homes, such as Jacob Julian’s Second Empire–style mansion boasted a lot of Romantic influences with elaborate detailing."
                                            },
                                            {
                                                "example_id": "1a76c677-9b2b-4acc-ba09-464e568fa85f",
                                                "sense_id": "b3ca9735-6df3-3a56-89ac-09d99c82ef00",
                                                "text": "In the next few minutes, Molly tossed dress after dress aside, oohing and aahing at the varied fabrics, the elaborate detailing of each one, until she found a dress that was— / Breathtaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06dfaea9-4603-3ece-8328-23fd583dfc6d",
                                        "entry_id": "15bc3d5a-a6bf-3f6e-869f-4631f3d9409f",
                                        "glosses": [
                                            "A careful and thorough cleaning and refurbishing of an automobile, aircraft, boat, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "detailing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9d4fb3-1da1-3123-aee0-9b6b49147495",
                                        "entry_id": "e46f9220-6b2d-3adf-9696-f533e6925c0b",
                                        "glosses": [
                                            "present participle and gerund of detail"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
