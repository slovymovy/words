                        "sense_id": "67faea15-74eb-3eab-8a36-a81c417ad71d",
                        "entry_id": "b2f64053-6bb3-3747-9e01-c8623c171770",
                        "glosses": [
                            "Gewächs/Gattung aus der Familie der Zypressengewächse, zur Ordnung der Kiefernartigen gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edbd8ab-4826-45dc-95d2-d447e621c173",
                                "sense_id": "67faea15-74eb-3eab-8a36-a81c417ad71d",
                                "text": "Mehrere Thujen wurden im Garten als Begrenzung gepflanzt und bilden nun eine Hecke."
                            },
                            {
                                "example_id": "69bc8b8d-fe76-4cfd-8f07-a21e29ed515c",
                                "sense_id": "67faea15-74eb-3eab-8a36-a81c417ad71d",
                                "text": "„Rechts säumten meterhohe Thujen den Weg, dann sah man wieder nur Wiesen und Felder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16618963-c640-4e16-9ada-2caa911825d9",
