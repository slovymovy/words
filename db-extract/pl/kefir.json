                ],
                "translations": [
                    {
                        "translation_id": "ad29b986-0f87-4e61-8599-df646aa0fce2",
                        "source_entry_id": "543de058-b37e-37be-b707-14b8e2e635e9",
                        "source_sense_id": "edcbe363-982f-3c40-99d7-a53e9b03745e",
                        "target_lang_word": "kefir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kefir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a863afca-64d0-33ab-aebf-029defd55523",
                                        "entry_id": "fa47f6ee-c0be-3dd9-872b-c7136410ffc3",
                                        "glosses": [
                                            "A fermented milk drink from the Caucasus and Eastern Europe, similar to yogurt but more liquid."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d016372-c586-4c6f-92fe-7b32bb5cc276",
                                                "sense_id": "a863afca-64d0-33ab-aebf-029defd55523",
                                                "text": "Water kefir grains differ from milk kefir grains and are generally used to make kefirs based on fruit juices or sugared waters."
                                            },
                                            {
                                                "example_id": "811aee89-f97b-43c8-acf4-6b4b77baa94b",
                                                "sense_id": "a863afca-64d0-33ab-aebf-029defd55523",
                                                "text": "Mason jars are great for making kefirs."
                                            },
                                            {
                                                "example_id": "73ef56ec-1d28-4b75-b2d1-9db70cc864cc",
                                                "sense_id": "a863afca-64d0-33ab-aebf-029defd55523",
                                                "text": "Commercially made kefirs on the other hand have seen the development of starter cultures that make the whole process more efficient and quicker while also providing longer product shelf lives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kefir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0790bf40-0d4c-3082-8e9e-a21a2b818aee",
                                        "entry_id": "7de02633-e0f3-3e1d-85fa-5ae0022e979d",
                                        "glosses": [
                                            "Alternative form of kafir."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0677c5da-3464-4f84-995b-aa98e2c65879",
                        "source_entry_id": "543de058-b37e-37be-b707-14b8e2e635e9",
                        "source_sense_id": "edcbe363-982f-3c40-99d7-a53e9b03745e",
                        "target_lang_word": "kefír",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kefír",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c890e85b-5688-3d78-9968-e985326a69bb",
                                        "entry_id": "b240a7c1-a676-3c42-871e-aee0b71d0ecc",
                                        "glosses": [
                                            "kravské mléko kvašené některou ze dvou kefírových kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec3d75b-b785-4e2a-9917-fa0cb5c7978c",
                                                "sense_id": "c890e85b-5688-3d78-9968-e985326a69bb",
                                                "text": "Kefír se prodává i ochucený s ovocnou nebo čokoládovou příchutí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c9a1e4-fa5a-43ef-9267-e06b39df6cc4",
                        "source_entry_id": "543de058-b37e-37be-b707-14b8e2e635e9",
                        "source_sense_id": "edcbe363-982f-3c40-99d7-a53e9b03745e",
                        "target_lang_word": "kéfir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kéfir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                        "entry_id": "df481f14-8f8f-3b49-abc8-46ca55d56741",
                                        "glosses": [
                                            "Boisson issue de la fermentation du lait ou de jus de fruits sucrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac618d8-322d-441f-965e-4fc8cb4d4320",
                                                "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                                "text": "On peut aussi ajouter de la poudre de lait sec dans les farines maltées ou utiliser kéfirs et yoghourths en cas de troubles intestinaux."
                                            },
                                            {
                                                "example_id": "6ed1f4a3-2f76-49eb-b688-2506921d8994",
                                                "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                                "text": "Le Dr. Kühne (Wiesbaden) fait connaître le kéfir, liquide alimentaire analogue au koumys. Le kéfir peut être fabriqué avec le lait de vache ; son goût et son arôme sont agréables, ce qui n’est pas le cas du koumys ; sa fabrication est plus simple et moins coûteuse que celle de ce dernier liquide. Il entre ensuite dans d’assez longs développements sur le mode de préparation du kéfir."
                                            },
                                            {
                                                "example_id": "f4a9ba8b-3c4e-4130-bec6-fa227dd6008d",
                                                "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                                "text": "Le kéfir est un lait crémeux et mousseux, alcoolisé et acidifié, non coagulé, originaire du Caucase et que l’on trouve en Asie. C’est l’exemple d’une préparation fabriquée partout dans le monde. Il est produit par une association de bactéries lactiques, de bactéries acétiques et de levures présentes dans le grain de képhir, qui produit une fermentation principalement lactique et faiblement alcoolique… Il stimule fortement le système immunitaire…"
                                            },
                                            {
                                                "example_id": "30bce9dc-1c29-45b1-ba16-cab41604305b",
                                                "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                                "text": "À grands coups de verres de kéfir\nIvres de joie et sans l'savoir\nOn reprenait Mers el-Kebir"
                                            },
                                            {
                                                "example_id": "25c6743d-3c03-4c89-82e0-37855b6f835c",
                                                "sense_id": "12dd318d-2203-3730-91d1-ad7905336ca2",
                                                "text": "En plus, les paysans lituaniens qui ont « inventé » ce plat, ne connaissaient pas et n’utilisaient pas de « kéfir », qui n’est apparu en Lituanie qu’au cours de la période soviétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63059b8-b592-3206-8852-e446aa4d1150",
                                        "entry_id": "df481f14-8f8f-3b49-abc8-46ca55d56741",
                                        "glosses": [
                                            "Grain de micro-organismes servant à ensemencer cette boisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476bf165-8307-465a-b5ad-7e65aeaac5ad",
                                                "sense_id": "a63059b8-b592-3206-8852-e446aa4d1150",
                                                "text": "L’autre type de Kéfir : Le kéfir d’eau est un grain translucide. Il permet de fabriquer une boisson fermentée et riche en pro-biotiques."
                                            },
                                            {
                                                "example_id": "c46e8615-15a9-4fa0-9d92-70d592fdf044",
                                                "sense_id": "a63059b8-b592-3206-8852-e446aa4d1150",
                                                "text": "Le premier des SCOBY connus est peut être le kéfir, dans lequel plus d'une trentaine de variétés de microbes et de levures on sécrété des polysaccharides formant des grains, qui se maintiennent ensemble et se reproduisent à l'identique."
                                            },
                                            {
                                                "example_id": "0eab77b3-c137-407a-99dd-3c7193538423",
                                                "sense_id": "a63059b8-b592-3206-8852-e446aa4d1150",
                                                "text": "Prenez 1 litre d’eau (pauvre en chlore de préférence), ajoutez 20 grammes de sucre, 1 figue séchée (ou un abricot, ou un pruneau, ou des raisins secs), 2-3 rondelles de citron et 20 grammes de \"grains\" de kéfir…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
