                            {
                                "example_id": "c492ee6b-acb4-425e-bdf2-821bb877052f",
                                "sense_id": "ca2aaec3-ef2e-3bd3-93b3-b0558516ef2d",
                                "text": "Но еретики подались еще севернее, в Хазарию."
