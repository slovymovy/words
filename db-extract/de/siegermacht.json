                ],
                "senses": [
                    {
                        "sense_id": "b761d37e-bc31-330a-ab00-9d01f498e278",
                        "entry_id": "4f2f841b-5a71-308c-ba19-fe93a569b27f",
                        "glosses": [
                            "Staat, der aus einem Krieg als Sieger hervorgegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fff2e1-87f6-49a7-bb2d-ec17bc41e49b",
                                "sense_id": "b761d37e-bc31-330a-ab00-9d01f498e278",
                                "text": "„Die Existenz dieser Gerüchte zeigt, wie konsequent die Siegermächte auch nach der bedingungslosen Kapitulation Deutschlands über ihre Nachkriegspläne Stillschweigen bewahren.“"
                            },
                            {
                                "example_id": "105053dd-8057-43d4-ab97-df40246ac170",
                                "sense_id": "b761d37e-bc31-330a-ab00-9d01f498e278",
                                "text": "„Formell wurden die deutschen Kolonien unter die Verwaltung des neugeschaffenen Völkerbundes gestellt, praktisch wurden sie unter den Siegermächten Frankreich, England und Belgien aufgeteilt.“"
                            },
                            {
                                "example_id": "0bc00e44-877f-4c02-ad11-a32ff3a55dd6",
                                "sense_id": "b761d37e-bc31-330a-ab00-9d01f498e278",
                                "text": "„Die siebte Generation Schleswiger Briefmarken erscheint 1920, kurz vor der endgültigen Volksabstimmung über die Zugehörigkeit Schleswigs, die auf Druck der Siegermächte nach dem Ersten Weltkrieg stattfand.“"
                            },
                            {
                                "example_id": "e99d92a6-7866-4456-9856-38f70e93a64b",
                                "sense_id": "b761d37e-bc31-330a-ab00-9d01f498e278",
                                "text": "„Deutschland wurde nicht so zerstückelt, wie es den Siegermächten ursprünglich vorschwebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
