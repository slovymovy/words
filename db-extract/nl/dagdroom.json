                        "sense_id": "9b033798-8aaa-3ac1-96ac-724bfb5b857b",
                        "entry_id": "e9f67048-f7cd-3169-ab13-f3168b2bd473",
                        "glosses": [
                            "een fantasie voorstelling tijdens verlaagd bewustzijn zonder dat men al helemaal slaapt"
