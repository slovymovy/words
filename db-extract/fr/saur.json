                                "example_id": "7301c163-8d3c-4d78-81a0-c7652c0d11dc",
                                "sense_id": "3e5b89e4-4034-3ed1-a512-777d1ac361e8",
                                "text": "Hareng saur."
                            }
                        ]
                    },
                    {
                        "sense_id": "91067022-4115-3f41-9d60-a20c4ffcd7a5",
                        "entry_id": "5ac38faf-3a4c-358b-9746-6d8c5f81b351",
                        "glosses": [
                            "Qui est de couleur jaune tirant sur le brun, de couleur obtenue par la fumée. Il se dit spécialement des chevaux."
                        ],
                        "tags": [
                            "analogy",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e5e3f683-a0e2-48ad-86b7-69a08969ebdc",
                                "sense_id": "91067022-4115-3f41-9d60-a20c4ffcd7a5",
                                "text": "Un cheval saur."
                            },
                            {
                                "example_id": "3d5c5029-acaa-4d53-9389-8fd3ca670614",
                                "sense_id": "91067022-4115-3f41-9d60-a20c4ffcd7a5",
                                "text": "Sa figure saure et ridée, encadrée par le châle noir, la vieille Gaudry, la métisse, approuvait en clignant de ses petits yeux obliques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a8b1e2e-757f-3eb4-a946-6f2ec035fc67",
                        "entry_id": "5ac38faf-3a4c-358b-9746-6d8c5f81b351",
                        "glosses": [
                            "Qualifie un oiseau de proie pendant sa première année, où il porte encore son premier pennage, de couleur rousse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f61c47e-7f4a-418b-bdb3-5e8ee64fae91",
                                "sense_id": "9a8b1e2e-757f-3eb4-a946-6f2ec035fc67",
                                "text": "Le fauconnier le dédaigne comme un ennemi inférieur; mais l'émir ordonna qu'on fît voir la plume au faucon saur."
                            }
                        ]
                    }
