                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tanker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbf58d7-60f3-3d3a-81da-928436a7cb0a",
                                        "entry_id": "f18a3edb-a4af-340e-9c11-102f1bc5291f",
                                        "glosses": [
                                            "Navire-citerne pour le transport du pétrole."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47fd3b93-c473-4cbd-8237-2f1510d69def",
                                                "sense_id": "cbbf58d7-60f3-3d3a-81da-928436a7cb0a",
                                                "text": "La Shell apporte aussi aux associés le précieux appui de sa flotte de tankers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tanker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4747ea8-03fa-3736-9a89-eb6b58cf5b3b",
                                        "entry_id": "76cae74c-fd11-3a1e-866e-4efdd986fc39",
                                        "glosses": [
                                            "Encaisser des dégâts."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d0d7798-9d41-47ac-bab0-763427aaef13",
                                                "sense_id": "e4747ea8-03fa-3736-9a89-eb6b58cf5b3b",
                                                "text": "Au sud, placez une troupe blindé qui pourra tanker les coups adverses et désorganiser leur formation."
                                            },
                                            {
                                                "example_id": "5a2262f4-5c4c-468b-b30d-04defe60938d",
                                                "sense_id": "e4747ea8-03fa-3736-9a89-eb6b58cf5b3b",
                                                "text": "Il garde son efficacité tout au long du match grâce à ça capacité à tanker lorsque il se déplace pour le corps à corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
