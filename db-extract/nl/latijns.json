                        ],
                        "form": "Latijnste"
                    },
                    {
                        "form_id": "bd439ec7-8c79-46a2-a8a3-5eea524d788b",
                        "entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "Latijnsers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edb83097-5e3b-31ca-8f2a-2325c612e013",
                        "entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "glosses": [
                            "in of uit het Latijn, de taal van de Romeinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a134cb7e-db83-4f45-ab30-cad05d96d8ae",
                                "sense_id": "edb83097-5e3b-31ca-8f2a-2325c612e013",
                                "text": "Kazachstan stapt over op het Latijnse schrift, zo meldde president Noersoeltan Nazarbajev woensdag in staatskrant 'Egemen Kazakhstan'."
                            },
                            {
                                "example_id": "24170c46-af7e-4d52-a0e6-c71df1ad396c",
                                "sense_id": "edb83097-5e3b-31ca-8f2a-2325c612e013",
                                "text": "Elke poging tot verzet wordt in de kiem gesmoord met een aan het gymnasium of een gymnasiast ontleend Latijns of Grieks machtswoord, en al spoedig blijkt dat de strijd niet om niet gestreden is: alles blijft bij het oude en vertrouwde."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb692d0-0f2a-343c-81a7-cbb47b5e70aa",
                        "entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "glosses": [
                            "van of zoals bij volkeren die een Romaanse taal spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1376616f-c125-4581-a083-f2fd9ebf8043",
                                "sense_id": "7bb692d0-0f2a-343c-81a7-cbb47b5e70aa",
                                "text": "Het surrealisme moge dan een Frans of liever een Latijns gebeuren zijn in de kunstgeschiedenis, toch zijn er heel wat figuren uit Vlaanderen en Nederland, die onder deze ‘schatten’ werkelijk niet zouden misstaan, die veeleer hoger zouden staan dan sommige van de neven- of bijfiguren die hier aan het licht komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d6ce057-1bce-3c9f-8212-d82d3137791a",
                        "entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "glosses": [
                            "gericht op of horend bij de traditionele rooms-katholieke kerk, die een in het Latijn gesproken mis kent"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc07718-5709-46ae-96b7-8b4755533c6e",
                                "sense_id": "8d6ce057-1bce-3c9f-8212-d82d3137791a",
                                "text": "Het bepalende element ligt niet bij de ritus van de doop en van de bedienaar daarvan, maar bij de kerk, waartoe de beide Latijnse ouders behoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e15c6b9-a288-3216-b652-88d4a8e6933a",
                        "entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "glosses": [
                            "uit, van of zoals in Latium, de streek rondom Rome"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c9cfde-2794-40aa-bb92-63af98a4141e",
                                "sense_id": "1e15c6b9-a288-3216-b652-88d4a8e6933a",
                                "text": "Door deze ontwikkeling werd de verhouding tussen Rome en de steden van de Latijnse bond, die oorspronkelijk als gelijken hadden gegolden, steeds meer ongelijk, doordat Rome profiteerde van gebiedsuitbreiding en bovendien de beste elementen uit de Latijnse steden tot zich trok."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52349186-c2f8-4437-b45b-222bb3bbe05f",
                        "source_entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "target_lang_word": "latin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7eed80b2-7129-4fd1-b559-c20e68b25ee5",
                        "source_entry_id": "872a8c8e-86bc-379b-aa27-697911cad6f1",
                        "target_lang_word": "latin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5bafb6-674b-32b5-9b4f-402a19a78bfb",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Qui est originaire ou se rapporte aux Latins, les habitants du Latium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa18986-e9e2-4b25-94e4-59cb5dfa0c91",
                                                "sense_id": "8b5bafb6-674b-32b5-9b4f-402a19a78bfb",
                                                "text": "La mythologie latine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cec9c1c-392d-34e0-97ac-6938d6e19141",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Romain, relatif à l’empire romain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7ceb3b-9a1c-4019-a487-e14b138cf822",
                                                "sense_id": "7cec9c1c-392d-34e0-97ac-6938d6e19141",
                                                "text": "Le droit latin."
                                            },
                                            {
                                                "example_id": "f9a99455-a3c8-4b1f-8495-eb84c2c37c33",
                                                "sense_id": "7cec9c1c-392d-34e0-97ac-6938d6e19141",
                                                "text": "Empire latin d’Orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5611d870-8a62-32a2-83a2-8f808432335a",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Relatif au latin, la langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3be4a4d-0d2b-422c-b881-c181e6c4cb85",
                                                "sense_id": "5611d870-8a62-32a2-83a2-8f808432335a",
                                                "text": "La littérature française du moyen-âge n'a guère que des antécédens latins. Les poésies celtique et germanique n’y ont laissé que de rares et douteux vestiges ; la culture antérieure est purement latine. C’est du sein de cette culture latine que le moyen-âge français est sorti, comme la langue française elle-même a émané de la langue latine."
                                            },
                                            {
                                                "example_id": "e13ba9d6-5f25-4aee-bb56-f11775cc72bf",
                                                "sense_id": "5611d870-8a62-32a2-83a2-8f808432335a",
                                                "text": "Toute la nuit, il avait rêvé qu’il récitait un discours latin en présence de l’Archevêque, et il lui avait semblé prononcer, ore rotundo, un nombre infini de belles terminaisons et de nobles désinences : abunt, arentur, ibus, arum…"
                                            },
                                            {
                                                "example_id": "c192c8b1-00d9-4414-82f7-2508f20e1e80",
                                                "sense_id": "5611d870-8a62-32a2-83a2-8f808432335a",
                                                "text": "Les plus énormes bêtises qui sortaient de la bouche de Johnson prenaient en effet je ne sais quel accent de véracité qui tenait sans doute au style de l’orateur, à la parfaite symétrie de ses phrases et à son redoutable arsenal de mots savants à désinences latines."
                                            },
                                            {
                                                "example_id": "e1208017-0e23-4e5b-9b2a-1012fea57409",
                                                "sense_id": "5611d870-8a62-32a2-83a2-8f808432335a",
                                                "text": "Parallèlement, les historiens des sciences ont eu tendance à négliger les aspects liés au latin, qu’il s’agisse des dissertations universitaires ou de la tradition botanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f8c39d-0f3b-39c4-8ac2-2ab1a7e5fdd7",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Qui s’exprime dans cette langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5692f5-0723-46cb-8482-9815d196b805",
                                                "sense_id": "10f8c39d-0f3b-39c4-8ac2-2ab1a7e5fdd7",
                                                "text": "Les auteurs latins."
                                            },
                                            {
                                                "example_id": "45897c4b-eda3-4438-baf9-dc2fee6bea65",
                                                "sense_id": "10f8c39d-0f3b-39c4-8ac2-2ab1a7e5fdd7",
                                                "text": "– Je prenais sur mes nuits pour parfaire ma connaissance des maîtres latins. Car je les préfère aux Grecs. Ceux-ci sont plus élégants, peut-être. Mais les autres sont plus vigoureux, et ont davantage le sens du droit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37253599-c780-32cf-9e84-fdc94f09f15b",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Relatif à l’Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e48dc4-05bc-47c1-8292-1e2dc88de616",
                                                "sense_id": "37253599-c780-32cf-9e84-fdc94f09f15b",
                                                "text": "L’Église latine ; de rite latin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc05de0b-0f43-3582-b99a-2bab609b856c",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Qui a certaines caractéristiques des habitants du Latium, des anciens Romains et, par extension, des peuples qu’ils ont longtemps et durablement colonisés et influencés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af84af46-0629-4ed2-8f2d-984dd820426a",
                                                "sense_id": "bc05de0b-0f43-3582-b99a-2bab609b856c",
                                                "text": "Il releva ses cheveux. Sa beauté était célèbre à Tolède : nez aquilin, yeux très grands, le masque conventionnel de beauté latine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bebe2b7-4490-3d15-90df-3474e52a935d",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Qui a pour origine la langue latine, qui à l’origine parlait le latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3268b289-2dfd-4f46-bd2d-8d26ae7987f9",
                                                "sense_id": "6bebe2b7-4490-3d15-90df-3474e52a935d",
                                                "text": "Les peuples latins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7d19dbb-c486-378d-9fd4-439004eebd4b",
                                        "entry_id": "40bde65b-f244-3f3d-babf-0aca38cd8ab7",
                                        "glosses": [
                                            "Espagnol, portugais et italien par opposition à anglo-saxon."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff25053-ba3f-4978-b813-8f62b3d5d9e8",
                                                "sense_id": "e7d19dbb-c486-378d-9fd4-439004eebd4b",
                                                "text": "Amérique latine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "latin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                        "entry_id": "9b72493a-5a52-305e-a79b-6e324b48d04b",
                                        "glosses": [
                                            "Langue italique indo-européenne dont sont originaires les langues romanes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3c7239-8c59-459f-a551-188357abe586",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Lorenzo.– Je lui demanderai, si vous voulez, mais je vous avertis que c’est une pédante ; elle parle latin.\nLe Duc.– Bon ! elle ne fait pas l’amour en latin."
                                            },
                                            {
                                                "example_id": "b32e2bd6-cdb6-45b8-be73-1d07486dc3f3",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "L’homme ne doit savoir littérairement que deux langues, le latin et la sienne ; mais il doit comprendre toutes celles dont il a besoin pour ses affaires ou son instruction."
                                            },
                                            {
                                                "example_id": "f2b18e2e-776a-443e-b3a1-df25502e50cd",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Oh ! mon Dieu, le premier qui me fit commencer le latin (rosa, la rose ; cornu, la corne ; tonitru, le tonnerre), un grand vieux voûté, mal tenu, triste à regarder comme une pluie de novembre !"
                                            },
                                            {
                                                "example_id": "6c8dbb2b-90a6-4f2e-8eb6-ba161bd18a66",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Le bruit courut que les trois frères avaient été empoisonnés, et le public n’eut pas besoin de savoir le latin pour cherchez à découvrir le coupable pas l’application du vieil axiome « is fecit cui prodest »."
                                            },
                                            {
                                                "example_id": "4e248943-63e2-4286-ab02-b1f705314b9c",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "La mauvaise foi des « curés » était d’ailleurs prouvée par l’usage du latin, langue mystérieuse, et qui avait, pour les fidèles ignorants, la vertu perfide des formules magiques."
                                            },
                                            {
                                                "example_id": "3c771468-854b-4339-ab2a-aabe38173927",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "« Et puis, au lycée, dit l’oncle, tu apprendras le latin, et je te promets que ça va te passionner ! Moi, du latin, j’en faisais même pendant les vacances, pour le plaisir ! »"
                                            },
                                            {
                                                "example_id": "c77a33dc-646f-4660-b4a4-cb7c13ff737b",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "On récitait « rosa, la rose ». Aujourd’hui, la rentrée a eu lieu depuis longtemps. Les élèves de sixième ont déjà commencé à ne pas apprendre le latin. Des spécialistes nous assurent qu’ils en auront la tête mieux faite. Les connaissances barbouillent l’esprit, retardent le jugement et fatiguent la mémoire. On ne saurait commencer trop jeune à ignorer."
                                            },
                                            {
                                                "example_id": "fb06e96a-7c65-45ce-a5f3-23572c322527",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Le jeune jésuite chargé de la classe de latin lit à haute voix les thèmes des élèves sur un ton de persiflage, pour faire rire. Michel en particulier, nouveau venu expulsé depuis peu par une institution laïque, sert de cible.\n– Voici, Messieurs, du latin de lycée.\n– Cela vous changera de votre latin de sacristie."
                                            },
                                            {
                                                "example_id": "98918812-2196-46b1-a658-e22b3b7a55ca",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "On s’est plu à qualifier le latin de langue de communication universelle. Or, la multiplicité de ses prononciations et la vanité des efforts pour établir une prononciation unique invitent, pour l’époque moderne, à tenir des propos plus nuancés et, dans le temps, à mesurer, à partir d’un exemple précis – celui de la prononciation –, l’écart entre les discours élaborés sur le latin et la réalité des faits."
                                            },
                                            {
                                                "example_id": "b4a762a2-32db-4dc8-8375-91e8a539dc3c",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Dans cette étonnante maison j’entends affirmer que sans la clé magique du latin il est inutile d’espérer ouvrir les portes du monde et qu’on demeure à jamais aveugle, sourd, invalide (le médecin, du reste, entreprend, dans cette année d’avant la sixième, d’enseigner les déclinaisons à mon amie et à moi et de nous initier à l’épitomé)."
                                            },
                                            {
                                                "example_id": "d36da230-b0ef-493b-b6aa-c1f24db03c00",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "[…] le latin est une langue de la famille indo-européenne appartenant au groupe des langues italiques, qui comporte également quelques langues moins répandues, comme par exemple l’osque ou l’ombrien, qui ont laissé peu de traces, alors que le latin a réussi à se faire une place de choix parmi les langues du monde au cours de sa longue histoire."
                                            },
                                            {
                                                "example_id": "16d583ee-39b7-48c8-9819-354a00ecae30",
                                                "sense_id": "1b7a71ce-0b2b-3ba1-b874-e174b58d4a95",
                                                "text": "Parallèlement, les historiens des sciences ont eu tendance à négliger les aspects liés au latin, qu’il s’agisse des dissertations universitaires ou de la tradition botanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03803387-5c2d-3297-9623-cfaf8c0139a6",
                                        "entry_id": "9b72493a-5a52-305e-a79b-6e324b48d04b",
                                        "glosses": [
                                            "Alphabet utilisé par ces langues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
