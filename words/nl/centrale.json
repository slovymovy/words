                {
                    "sense_id": "fb6c2cd0-55d8-3b5a-bac2-e410541756d1",
                    "sense_definition": "Een groot complex of installatie waar energie, zoals elektriciteit of warmte, wordt opgewekt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "energy_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>centrale</w> wordt volgend jaar gesloten vanwege de vervuiling.",
                            "target_lang_translations": {
                                "en": "The old <w>power station</w> will be closed next year due to pollution.",
                                "ru": "Старая <w>электростанция</w> будет закрыта в следующем году из-за загрязнения окружающей среды."
                            }
                        },
                        {
                            "text": "Er werken honderden mensen in de nucleaire <w>centrale</w>.",
                            "target_lang_translations": {
                                "en": "Hundreds of people work in the nuclear <w>power plant</w>.",
                                "ru": "На атомной <w>электростанции</w> работают сотни людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "krachtcentrale",
                        "elektriciteitscentrale"
                    ],
                    "common_phrases": [
                        "kerncentrale",
                        "kolencentrale",
                        "windcentrale"
                    ],
                    "target_lang_definitions": {
                        "en": "A large complex or installation where energy, such as electricity or heat, is generated",
