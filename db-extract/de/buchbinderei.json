                                "example_id": "f53cafa9-b70c-481b-9b4b-a3a20350f0e5",
                                "sense_id": "dc23b1a2-6489-3029-8a01-b99dd19bb079",
                                "text": "„Anfangs wurden die Farbabbildungen noch von Klischees gedruckt, ausgeschnitten und in den Buchbindereien von Hand eingeklebt.“"
                            }
