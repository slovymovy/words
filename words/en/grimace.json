{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                    "sense_definition": "A contorted facial expression, usually indicating disgust, disapproval, or pain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face twisted in a <w>grimace</w> of pain as she stepped on the sharp stone.",
                            "target_lang_translations": {
                                "de": "Ihr Gesicht verzog sich zu einer schmerzverzerrten <w>Grimasse</w>, als sie auf den spitzen Stein trat."
                            }
                        },
                        {
                            "text": "He tried to hide his true feelings, but a brief <w>grimace</w> gave him away.",
                            "target_lang_translations": {
                                "de": "Er versuchte, seine wahren Gefühle zu verbergen, doch eine kurze <w>Grimasse</w> verriet ihn."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl",
                        "frown"
                    ],
                    "antonyms": [
                        "smile",
                        "grin"
                    ],
                    "common_phrases": [
                        "grimace of pain",
                        "grimace of disgust"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein verzerrter Gesichtsausdruck, der meist Ekel, Missbilligung oder Schmerz ausdrückt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Grimasse",
                                "target_lang_sense_clarification": "verzerrter Gesichtsausdruck"
                            },
                            {
                                "target_lang_word": "Fratze",
                                "target_lang_sense_clarification": "verzerrtes oder hässliches Gesicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                    "sense_definition": "An unnatural, insincere manner or affectation; pretense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He saw right through her polite sympathy, dismissing it as mere fashionable <w>grimace</w>.",
                            "target_lang_translations": {
                                "de": "Er durchschaute ihr höfliches Mitgefühl sofort und tat es als bloßes modisches <w>Gehabe</w> ab."
                            }
                        },
                        {
                            "text": "Her show of sorrow was regarded by the family as hollow <w>grimace</w> and deceit.",
                            "target_lang_translations": {
                                "de": "Ihre Zurschaustellung von Trauer wurde von der Familie als hohle <w>Verstellung</w> und Täuschung angesehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "affectation",
                        "pretense",
                        "sham"
                    ],
                    "antonyms": [
                        "sincerity"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein unnatürliches, unaufrichtiges Verhalten oder Gehabe; Heuchelei oder Verstellung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gehabe",
                                "target_lang_sense_clarification": "unnatürliches, aufgesetztes Verhalten"
                            },
                            {
                                "target_lang_word": "Verstellung",
                                "target_lang_sense_clarification": "unaufrichtiges Verhalten, Heuchelei"
                            },
                            {
                                "target_lang_word": "Affektiertheit",
                                "target_lang_sense_clarification": "gekünsteltes Auftreten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c91c4ea-8242-3763-a63e-b8c0de8891b1",
                    "sense_definition": "To contort one's face, often in reaction to pain, disgust, or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient <w>grimaced</w> in pain as the nurse cleaned the deep wound.",
                            "target_lang_translations": {
                                "de": "Der Patient <w>verzog</w> vor Schmerz <w>das Gesicht</w>, als die Krankenschwester die tiefe Wunde reinigte."
                            }
                        },
                        {
                            "text": "She took a sip of the bitter medicine and immediately <w>grimaced</w>.",
                            "target_lang_translations": {
                                "de": "Sie nahm einen Schluck der bitteren Medizin und <w>verzog</w> sofort <w>das Gesicht</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl",
                        "wince"
                    ],
                    "antonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "grimace in pain",
                        "grimace with disgust"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Gesicht verziehen, häufig als Reaktion auf Schmerz, Ekel oder Unbehagen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Gesicht verziehen",
                                "target_lang_sense_clarification": "wegen Schmerz oder Ekel"
                            },
                            {
                                "target_lang_word": "Grimassen schneiden",
                                "target_lang_sense_clarification": "das Gesicht verzerren"
                            },
                            {
                                "target_lang_word": "eine Grimasse ziehen",
                                "target_lang_sense_clarification": "einen verzerrten Gesichtsausdruck machen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}