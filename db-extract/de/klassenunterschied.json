                "senses": [
                    {
                        "sense_id": "b7a8aac6-98dc-3570-9696-1c29001f43b6",
                        "entry_id": "542559ae-fca4-3718-820b-b40acc921d6d",
                        "glosses": [
                            "Unterschied zwischen den Mitgliedern verschiedener sozialer Klassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6de807-ca1f-4fbb-a028-855602677611",
                                "sense_id": "b7a8aac6-98dc-3570-9696-1c29001f43b6",
                                "text": "„Wie jede andere Gesellschaft kannten die Juden natürlich Klassenunterschiede.“"
                            },
                            {
                                "example_id": "a024ecc7-4e29-4515-ada6-b9518ddf47df",
                                "sense_id": "b7a8aac6-98dc-3570-9696-1c29001f43b6",
                                "text": "„Klassenunterschiede werden insbesondere bei den Beamten deutlich, bei denen der Zugang zu Privilegien und Vergünstigungen von Status, Dienstgrad, Stellung und Sektor abhängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba1c2d8e-4b22-3139-a09f-850fbf5c8e50",
                        "entry_id": "542559ae-fca4-3718-820b-b40acc921d6d",
                        "glosses": [
                            "Differenz im Können, der dem Unterschied zwischen Mitgliedern verschiedener Leistungs-/Spielklassen vergleichbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde5fe9c-4467-4bff-8608-4aaa93c4c147",
                                "sense_id": "ba1c2d8e-4b22-3139-a09f-850fbf5c8e50",
                                "text": "Das Pokalspiel bestätigte einmal mehr den Klassenunterschied zwischen den beiden Kontrahenten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
