                "senses": [
                    {
                        "sense_id": "035c8a28-ffa1-3a7d-adff-6b5721fdf78c",
                        "entry_id": "92b67830-d6d4-390e-8d1c-c946e36dd67d",
                        "glosses": [
                            "Gesamtheit besonders bedeutsamer Stätten/Gebiete für die Menschheits- oder Erdgeschichte (erfasst und unterstützt von der UNESCO)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "03551fd3-52bd-40a9-a79e-4f994a659f1e",
                                "sense_id": "035c8a28-ffa1-3a7d-adff-6b5721fdf78c",
                                "text": "„Russland hatte die Aufnahme der ukrainischen Stadt am Schwarzen Meer [Odessa] in das Welterbe vergeblich zu verhindern versucht. Der Aufnahme-Antrag sei aus Wikipedia abgeschrieben, betonte der russische Vertreter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ac6dbbc-cdcc-3e14-abdd-18a820cb032d",
                        "entry_id": "92b67830-d6d4-390e-8d1c-c946e36dd67d",
                        "glosses": [
                            "ein einzelnes Kultur- oder Naturdenkmal aus [1]"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "edc92c6f-8841-4835-a3bc-b43257d89a2d",
                                "sense_id": "6ac6dbbc-cdcc-3e14-abdd-18a820cb032d",
                                "text": "„Die Unesco hat am Sonntagabend drei weitere Kulturstätten und drei Landschaften zum Welterbe erklärt, darunter weite Teile der französischen Insel La Réunion.“"
                            },
                            {
                                "example_id": "b37f030a-5f0d-44fe-8222-1c7ceefe888d",
                                "sense_id": "6ac6dbbc-cdcc-3e14-abdd-18a820cb032d",
                                "text": "„In einem übersichtlichen Anhang von A bis Z werden zu allen übrigen Welterben die wichtigsten Daten und Basisinformationen genannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
