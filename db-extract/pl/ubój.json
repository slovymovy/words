                "senses": [
                    {
                        "sense_id": "5b30a087-301b-3281-8a02-17c5da7a5665",
                        "entry_id": "c9551116-70bf-33d1-b6ad-3aa4eed758d0",
                        "glosses": [
                            "zabijanie zdrowych zwierząt hodowlanych, zwykle dla mięsa,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db93c6f3-8007-4e10-a358-b1e940ea1a25",
                                "sense_id": "5b30a087-301b-3281-8a02-17c5da7a5665",
                                "text": "Świeżo wykryty zalążek świńskiej grypy spowodował ubój trzody (chlewnej) w gospodarstwach znajdujących się w strefie zakażenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a951d71e-5091-4f3a-8e3f-23212ade4e1f",
                        "source_entry_id": "c9551116-70bf-33d1-b6ad-3aa4eed758d0",
                        "source_sense_id": "5b30a087-301b-3281-8a02-17c5da7a5665",
                        "target_lang_word": "slaughter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaughter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4df15dc5-a537-36c0-84e6-06fe249990ff",
                                        "entry_id": "e1635f61-57c0-38a2-af79-e0aeeb7d0d13",
                                        "glosses": [
                                            "The killing of animals, generally for food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5de1d472-1b62-388e-a837-7940ca4e2807",
                                        "entry_id": "e1635f61-57c0-38a2-af79-e0aeeb7d0d13",
                                        "glosses": [
                                            "A massacre; the killing of a large number of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c3183d-40ea-4763-b6d2-f6408cd965d4",
                                                "sense_id": "5de1d472-1b62-388e-a837-7940ca4e2807",
                                                "text": "1674, John Milton, Paradise Lost, Book VI, 1773, The First Six Books of Milton's Paradise Lost, Edinburgh, page 416,\nFor ſin, on war and mutual ſlaughter bent."
                                            },
                                            {
                                                "example_id": "db494895-3ccd-4aa3-9c7d-759ca25fb1fc",
                                                "sense_id": "5de1d472-1b62-388e-a837-7940ca4e2807",
                                                "text": "[…] I ſee\nTh’ Inſulting Tyrant prancing o’er the Field\nStrow’d with Rome’s Citizens, and drench’d in Slaughter,\nHis Horſe’s Hoofs wet with Patrician Blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849c82d3-5b8e-37a1-9d4f-15115dd9424e",
                                        "entry_id": "e1635f61-57c0-38a2-af79-e0aeeb7d0d13",
                                        "glosses": [
                                            "A mass destruction of non-living things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd11107-34ea-4663-bb0c-e9ded3a8a6a5",
                                                "sense_id": "849c82d3-5b8e-37a1-9d4f-15115dd9424e",
                                                "text": "There was a massive slaughter of W.R. steam power at the conclusion of the summer timetable. In all, 169 locomotives were condemned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daec13a-25ff-3871-82fd-59b8ee8ec156",
                                        "entry_id": "e1635f61-57c0-38a2-af79-e0aeeb7d0d13",
                                        "glosses": [
                                            "A rout or decisive defeat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "012e15f0-cbac-33b9-8903-3b6d854ab01e",
                                        "entry_id": "e1635f61-57c0-38a2-af79-e0aeeb7d0d13",
                                        "glosses": [
                                            "A group of iguanas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slaughter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2772646c-291e-3451-be55-66d19d5c9d32",
                                        "entry_id": "f47b1b42-5668-38b3-85bf-e937c1049cde",
                                        "glosses": [
                                            "To butcher animals, generally for food."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3fc70ec-9b63-3670-9077-3c7d12f494e5",
                                        "entry_id": "f47b1b42-5668-38b3-85bf-e937c1049cde",
                                        "glosses": [
                                            "To massacre people in large numbers."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5479b45-53d0-4c29-a59e-99122a1c43f1",
                                                "sense_id": "c3fc70ec-9b63-3670-9077-3c7d12f494e5",
                                                "text": "Hurriedly he snatched up others, one or two at a time, until he had slaughtered thirty of Hrothgar's doughtiest earls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3466b666-2f50-3a25-ab7a-612f3b8095e3",
                                        "entry_id": "f47b1b42-5668-38b3-85bf-e937c1049cde",
                                        "glosses": [
                                            "To kill someone or something, especially in a particularly brutal manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c76a714-c0c7-46d3-831e-27ed06b76225",
                                                "sense_id": "3466b666-2f50-3a25-ab7a-612f3b8095e3",
                                                "text": "Therefore cheere vp your mindes, prepare to fight,\nHe that can take or ſlaughter Tamburlaine,\nShall rule the Prouince of Albania."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8315bb5d-6ff7-4d2d-bb00-9f995fd883d2",
                        "source_entry_id": "c9551116-70bf-33d1-b6ad-3aa4eed758d0",
                        "source_sense_id": "5b30a087-301b-3281-8a02-17c5da7a5665",
                        "target_lang_word": "Schlachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7fcb72-f3bf-3811-baae-fcc2b7963751",
                                        "entry_id": "6271feaa-eac1-32e3-beec-6ba068121a47",
                                        "glosses": [
                                            "das Schlachten, fachgerechte Tötung und Zerlegung eines Nutztiers, um Fleisch und andere Rohstoffe zu gewinnen, in anderen Kulturen auch generell das Töten von Tieren zur Nahrungsgewinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d6f24a-bb5b-4c8d-8d26-249441963f51",
                                                "sense_id": "3a7fcb72-f3bf-3811-baae-fcc2b7963751",
                                                "text": "„Diese Verordnung dient dem Schutz von Tieren im Zusammenhang mit der Schlachtung oder Tötung, insbesondere der Durchführung der Verordnung (EG) Nr. 1099/2009 des Rates vom 24. September 2009 über den Schutz von Tieren zum Zeitpunkt der Tötung (ABl. L 303 vom 18.11.2009, S. 1).“"
                                            },
                                            {
                                                "example_id": "9b5ece4e-9197-4de9-a927-fa87a03a3943",
                                                "sense_id": "3a7fcb72-f3bf-3811-baae-fcc2b7963751",
                                                "text": "„Die Schlachtungen nahm er in seinem Betrieb unter veterinärärztlicher Aufsicht vor.“"
                                            },
                                            {
                                                "example_id": "d3b450a4-d0dd-440b-b26d-fb3833094344",
                                                "sense_id": "3a7fcb72-f3bf-3811-baae-fcc2b7963751",
                                                "text": "„Insgesamt gibt es 5 Voraussetzungen für eine reguläre Schlachtung im Islam.“"
                                            },
                                            {
                                                "example_id": "0f7c16b6-4a5a-455e-8365-edfb22299fe2",
                                                "sense_id": "3a7fcb72-f3bf-3811-baae-fcc2b7963751",
                                                "text": "Rituelle Schlachtung hat auch mit »Kaschrut« und »halal« zu tun, Begriffen aus den Vorschriften über die Eignung und Reinheit von Lebensmitteln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a4b7847-684b-42b5-bbf9-0dc1069f9b45",
                        "source_entry_id": "c9551116-70bf-33d1-b6ad-3aa4eed758d0",
                        "source_sense_id": "5b30a087-301b-3281-8a02-17c5da7a5665",
                        "target_lang_word": "убой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "убой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db883c20-7f11-33ad-b1aa-19308b791321",
                                        "entry_id": "72288c87-5d17-389c-8ef0-c6b448c1f89d",
                                        "glosses": [
                                            "умерщвление животных в промысловых целях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea20b9fb-6c51-44e5-aa77-8aa55dcb52a8",
                                                "sense_id": "db883c20-7f11-33ad-b1aa-19308b791321",
                                                "text": "Свиньи летом пасутся в стаде, а зимою кормят мякиною; опоросившуюся свинью и взрослых боровов, готовящихся на убой, кормят несколько хлебом."
                                            },
                                            {
                                                "example_id": "688d3f0e-da4d-4a68-9c03-5507ea96a36d",
                                                "sense_id": "db883c20-7f11-33ad-b1aa-19308b791321",
                                                "text": "Скот на продажу большою частию пригоняется в Бельцы и для прогона в Австрию, а по местам овцы, волы покупаются единственно промышленниками для убою."
                                            },
                                            {
                                                "example_id": "b4334133-5ccf-433a-98ef-17a8e00d5063",
                                                "sense_id": "db883c20-7f11-33ad-b1aa-19308b791321",
                                                "text": "После убоя скота полутуши взвешивают на монорельсовых весах «Моно» и информация поступает в базу данных предприятия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb27c396-2262-39ba-a851-407972d3ba44",
                                        "entry_id": "72288c87-5d17-389c-8ef0-c6b448c1f89d",
                                        "glosses": [
                                            "старин. убийство"
                                        ],
