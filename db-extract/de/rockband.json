                    {
                        "sense_id": "d3c2d5bd-4313-3cf0-b907-eef8de38c1c9",
                        "entry_id": "7ca377d3-c8c9-3cf6-8a4d-f8453483c705",
                        "glosses": [
                            "Gruppe von Musikern, die Rockmusik spielen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8996e999-0293-45dc-a7cf-f214ad4ce0d7",
                                "sense_id": "d3c2d5bd-4313-3cf0-b907-eef8de38c1c9",
                                "text": "Heute Abend treten mehrere Rockbands auf dem Konzert auf."
                            },
                            {
                                "example_id": "4d3b095a-6031-4657-9cca-c77481d754dc",
                                "sense_id": "d3c2d5bd-4313-3cf0-b907-eef8de38c1c9",
                                "text": "„Rockbands wie Junoon in Karatschi, die begannen, mehr als zweihundert Jahre alte Gedichte von Bulleh Shah (1680–1757) zu vertonen, oder Nusrat Fateh Ali Khans Vermischung von klassischen Qawwalis mit westlichen Rhythmen brachten den reichen Sufi-Traditionen ab den späten 1980er Jahren erneut überregionale Aufmerksamkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
