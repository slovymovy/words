                "senses": [
                    {
                        "sense_id": "ca85269f-de88-35a3-84b6-e0c3e7bb4184",
                        "entry_id": "da0da7e0-cb58-3c7b-bc35-4f5640b2b060",
                        "glosses": [
                            "Petit châssis à fromages à fond d’osier, fabriqué par un boisselier."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "820f289d-fde0-4f34-9e68-fa992e17f3a0",
                                "sense_id": "ca85269f-de88-35a3-84b6-e0c3e7bb4184",
                                "text": "Lorsque le lait est pris, enlevez-le avec une cuiller, et déposez-le dans un chaseret d’osier, garni d’un morceau de linge blanc, et recevez le lait qui s’écoule."
                            },
                            {
                                "example_id": "ec2bb136-a82f-4e5f-ab12-62b5e765c511",
                                "sense_id": "ca85269f-de88-35a3-84b6-e0c3e7bb4184",
                                "text": "Un chaseret en cuivre ou bronze, d’une forme ancienne et toute particulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "2779702d-9c11-318f-8a88-b5a55efff39b",
                        "entry_id": "da0da7e0-cb58-3c7b-bc35-4f5640b2b060",
                        "glosses": [
                            "Sorte de panier, maniveau."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "655585e1-4277-4220-95a8-78de432c6e97",
                                "sense_id": "2779702d-9c11-318f-8a88-b5a55efff39b",
                                "text": "C’est une sorte de petit chaseret en osier, qui ne sert guère qu’à mettre des fraises et des champignons pour la vente en détail."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b738791-6d60-30c9-8733-66da21b5b15e",
