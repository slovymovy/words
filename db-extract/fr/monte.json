                    {
                        "sense_id": "6db464b2-2128-3017-960d-49b1dd6da01e",
                        "entry_id": "52fc96d7-a307-3eb7-bc27-580efb73f213",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de monter."
