                        "cross_references": [
                            {
                                "target_word": "мусковит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3c7b5959-81ff-38ce-9019-fd168b5832db",
                                        "entry_id": "50fae9d4-2d68-3467-9ecb-8d208d8a67fd",
                                        "glosses": [
                                            "минер. тугоплавкий пластинчатый минерал (обычно бесцветный), применяющийся в радио- и электротехнике, в промышленности стройматериалов; калиевая слюда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19eeddab-949a-4eaf-943a-f12e9833c558",
                                                "sense_id": "3c7b5959-81ff-38ce-9019-fd168b5832db",
                                                "text": "Копи слюды в Сибири разрабатывались в XVI — XVIII веках, когда слюда, особенно мусковит (белая слюда) заменяла оконное стекло и была в большом спросе."
                                            },
                                            {
                                                "example_id": "791c663b-1d71-4a0e-b255-c61d7cf70050",
                                                "sense_id": "3c7b5959-81ff-38ce-9019-fd168b5832db",
                                                "text": "Недалеко от Кандалакши, на юго-западе Мурманской области, разрабатывается месторождение самой ценной из слюд — мусковита."
                                            },
                                            {
                                                "example_id": "0e8c9370-5ca8-4c93-8f8e-e19e728c4f81",
                                                "sense_id": "3c7b5959-81ff-38ce-9019-fd168b5832db",
                                                "text": "Мусковит — светлую слюду — раньше называли «московитом», московской слюдой. Когда-то мусковит использовали вместо стёкол в окнах, в 1930-х начали употреблять в авиационных моторах в качестве термостойких прокладок."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
