                                "target_senses": [
                                    {
                                        "sense_id": "deabb661-731a-3eec-89a4-f2fbdeed6d21",
                                        "entry_id": "dc9af475-fd25-3dc8-be3e-7367cb52a763",
                                        "glosses": [
                                            "Störung des Säure-Basen-Haushaltes, wobei der pH-Wert des Blutes unter 7,36 sinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79908eb1-5a8a-4f15-8357-473f8f26ae8c",
                                                "sense_id": "deabb661-731a-3eec-89a4-f2fbdeed6d21",
                                                "text": "„Oberste Priorität im Säure-Basen-Haushalt hat allerdings das Blut, dessen pH-Wert mit winzigen Abweichungen um 7,4 schwankt. Sinkt der Wert nur um eine Nuance, unter 7,35, diagnostizieren auch Schulmediziner eine Azidose - eine Übersäuerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
