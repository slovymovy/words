                "senses": [
                    {
                        "sense_id": "668e1aff-a7f0-3c03-ad32-2b7c13d59745",
                        "entry_id": "3625dcc7-f472-392c-9472-f06b849836a0",
                        "glosses": [
                            "Chor, in dem Häftlinge singen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f1c99ef-9168-43ff-8296-dbd118764c2e",
                                "sense_id": "668e1aff-a7f0-3c03-ad32-2b7c13d59745",
                                "text": "„Einmal hatte er eine Fidelio-Aufführung zu besprechen, bei welcher der Gefangenenchor greulich falsch gesungen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28d87e71-9866-3634-b37b-77ca316e0038",
                        "entry_id": "3625dcc7-f472-392c-9472-f06b849836a0",
                        "glosses": [
                            "Chorwerk, das den Gesang der Gefangenen thematisiert/wiedergibt/darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf18652-9c40-4d7b-aef1-b50bf58ea74c",
                                "sense_id": "28d87e71-9866-3634-b37b-77ca316e0038",
                                "text": "Der Gefangenenchor aus Verdi's Nabucco ist eine der berühmtesten und ergreifendsten Szenen der Operngeschichte."
                            },
                            {
                                "example_id": "5bbec8e5-297e-44db-8cd1-06def6c12b7b",
                                "sense_id": "28d87e71-9866-3634-b37b-77ca316e0038",
                                "text": "„Kant beugt sich über die Arbeitsplatte und schnippt mit seinem Mittelfinger gegen eines der Gläser, nickt zufrieden, greift zur Feder und notiert eine kleine Theorie des Schalls, schaut allerdings häufig verärgert aus dem Fenster, weil nicht der Gefangenenchor, sondern Lampe theorieverhindernden Lärm macht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
