                                "target_senses": [
                                    {
                                        "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                        "entry_id": "11ac3883-8aae-3c69-a4b0-96cbc2598eab",
                                        "glosses": [
                                            "gemeinsames, festliches Mahl mit Gästen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83f3f57-2bfe-4b01-aedb-fe1916018062",
                                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                                "text": "„Glaubt man den antiken Autoren, spielten Gastmähler und Gelage eine wichtige Rolle in der keltischen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "a658738b-cd20-49d2-a89e-fab5f678ba82",
                                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                                "text": "„Skral wollte einen Wagen mieten, ich sagte, das lohne sich nicht so sehr, denn da, wo wir hinwollten, nach Valle Gran Grey, ins Tal des großen Königs, wo wir unser Gastmahl halten würden, da bräuchten wir kein Auto.“"
                                            },
                                            {
                                                "example_id": "8846fbfc-ab00-4571-8ffc-ab2815117a18",
                                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                                "text": "„Um die Zeit der ersten Nachtwache kehrte er von dem Gastmahle beim Richter Sja heim.“"
                                            },
                                            {
                                                "example_id": "a452e885-3d48-4594-808d-16f2322d5aa2",
                                                "sense_id": "c7b99dfe-1f30-364e-bf78-1cb26ff2ec92",
                                                "text": "„Die Königin hat zu Ehren ihres Gemahls, des Königs, ihrer Mutter, der deutschen Prinzessin, und ihres Bruders, des Herzogs von Hannover, ein Gastmahl veranstaltet.“"
                                            }
                                        ],
