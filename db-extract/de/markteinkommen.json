                "senses": [
                    {
                        "sense_id": "b82daf7b-788f-3855-bd1b-c2211ff1a8cd",
                        "entry_id": "08995810-424e-36fa-a667-12625b431b20",
                        "glosses": [
                            "am Markt erwirtschaftetes Einkommen"
                        ],
                        "tags": [
                            "Wirtschaftswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc26f6a-e29e-45a0-9efd-b975fc2c7c0b",
                                "sense_id": "b82daf7b-788f-3855-bd1b-c2211ff1a8cd",
                                "text": "„Gleichwohl kann der deutschen Einkommensteuer eine relativ hohe Umverteilungswirkung bescheinigt werden, die jedoch auf eine vergleichsweise hohe Ungleichheit der Markteinkommen zurückführen ist.“"
                            },
                            {
                                "example_id": "581575fb-24b4-4462-ab14-67a5df01527f",
                                "sense_id": "b82daf7b-788f-3855-bd1b-c2211ff1a8cd",
                                "text": "„Somit würde das Markteinkommen der Produzenten letztlich um vier Prozent zunehmen.“"
                            },
                            {
                                "example_id": "9b3dcb4f-cd6d-4e9a-98b1-23616c2b0e71",
                                "sense_id": "b82daf7b-788f-3855-bd1b-c2211ff1a8cd",
                                "text": "„Im strengen Sinne einer Marktökonomie konnte dabei die Besteuerung von Markteinkommen die einzige reguläre staatliche Finanzquelle sein.“"
                            },
                            {
                                "example_id": "88896feb-ac37-4140-89f8-928aa79e52de",
                                "sense_id": "b82daf7b-788f-3855-bd1b-c2211ff1a8cd",
                                "text": "„Wenn sich die Markteinkommen spreizen, sollte das Steuersystem progressiver werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
