                    {
                        "translation_id": "b59feee6-0814-4b38-af75-0bd7b9e10adc",
                        "source_entry_id": "46620096-1302-356a-9523-a6b27137c4b7",
                        "source_sense_id": "4552cd60-6cae-32b2-a485-509ac6d17630",
                        "target_lang_word": "palpitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palpitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                                        "entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                                        "glosses": [
                                            "An abnormal beating of the heart that may be perceived by the patient, a result of excitement, exertion, or illness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00243df9-d76e-4f64-8afb-9769495a4481",
                                                "sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                                                "text": "Sometimes my pulse beat so quickly and hardly, that I felt the palpitation of every artery; at others, I nearly sank to the ground through languor and extreme weakness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11bdd376-9fb8-401a-b30b-3ffda335000b",
                        "source_entry_id": "46620096-1302-356a-9523-a6b27137c4b7",
                        "source_sense_id": "4552cd60-6cae-32b2-a485-509ac6d17630",
                        "target_lang_word": "palpitación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0220aa4-aa24-4445-9296-1b18a74c8cbd",
                        "source_entry_id": "46620096-1302-356a-9523-a6b27137c4b7",
                        "source_sense_id": "4552cd60-6cae-32b2-a485-509ac6d17630",
                        "target_lang_word": "Herzklopfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzklopfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                        "entry_id": "8c28cde3-b0e5-3848-924f-0ad7851b51ed",
                                        "glosses": [
                                            "verstärkter, schnellerer Herzschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750eaf57-7887-4b3e-8414-dc8aff6dd850",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Sogleich wurde mir das Schmähliche meines Herzklopfens und dieser Schläfrigkeit klar, in die ich mich wie unter einen Mantel verkrochen hatte.“"
                                            },
                                            {
                                                "example_id": "0662ca9d-8346-4ac7-ac94-5e1f6a389b92",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Unter Herzklopfen erprobte sie ihr Vietnamesisch und zauberte damit ein Strahlen in die von der weiten Reise müden Gesichter.“"
                                            },
                                            {
                                                "example_id": "f20ff392-efee-4657-84c0-2134c60c96fa",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Mit leichtem Herzklopfen und zunehmendem Unbehagen überlegte er, ob es Kritikpunkte an seiner Arbeit geben könnte.“"
                                            },
                                            {
                                                "example_id": "ca4f5bd7-1087-4b66-85d3-cf69ab78795e",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Daß wir dennoch die Nacht mit Herzklopfen erwarten, läßt sich nicht leugnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3fbc17-6345-48d0-a165-2908424ee717",
                        "source_entry_id": "46620096-1302-356a-9523-a6b27137c4b7",
                        "source_sense_id": "4552cd60-6cae-32b2-a485-509ac6d17630",
