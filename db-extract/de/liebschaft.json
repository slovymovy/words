                        ],
                        "form": "die Liebschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                        "entry_id": "463ea29a-7074-3144-afe4-6d0f0f6ebacd",
                        "glosses": [
                            "vorübergehende intime Beziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3464a68a-a032-42fd-9b76-b38979e7cdb2",
                                "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                                "text": "Während ihrer zwanzig Ehejahre hatte sie unzählige Liebschaften, von denen ihr Mann nichts ahnte."
                            },
                            {
                                "example_id": "33cec58f-a01c-49b4-b00f-c1318f42004b",
                                "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                                "text": "„Kleine Liebschaften, flüchtige Bindungen spielen nur eine Episodenrolle, deren absurden Charakter er selber spürt.“"
                            },
                            {
                                "example_id": "b0798e93-c01c-42ca-92d4-757e30f0cdc4",
                                "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                                "text": "„Er lachte und meinte, das sei keine Liebe, sondern eine Liebschaft, die ich trotzdem pflegen könne, und er überzeugte mich.“"
                            },
                            {
                                "example_id": "e94bcc00-2d85-4751-b03c-30a69e949667",
                                "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                                "text": "„Es hatte jüdisch-muslimische Liebschaften gegeben, in der Moschee wurden gemischte Paare verheiratet, […].“"
                            },
                            {
                                "example_id": "5e7aae12-6d35-473e-b617-cb8824e083f2",
                                "sense_id": "780e1c74-c0e5-31b0-9053-f89349c2d513",
                                "text": "„Da schrieben sich zwei Menschen ständig Liebesbriefe und waren doch dauernd mit Liebschaften beschäftigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
