                    {
                        "form_id": "7ddf0825-a14f-42d1-aef9-13429d0e8366",
                        "entry_id": "40b35e96-99e0-3a8f-af2d-0341e860d477",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Weltmarkt"
                    },
                    {
                        "form_id": "0b156ded-716c-48b3-8c3f-dce185b9ad4c",
                        "entry_id": "40b35e96-99e0-3a8f-af2d-0341e860d477",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weltmärkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                        "entry_id": "40b35e96-99e0-3a8f-af2d-0341e860d477",
                        "glosses": [
                            "globaler Markt mit einheitlichem Preis für gehandelte Güter und Dienstleistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a310e046-1fd7-4828-9338-b5d1169c8c50",
                                "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                                "text": "„Exportsubventionen sind staatliche Leistungen für Warenexporte, um sonst nicht konkurrenzfähige Waren auf dem Weltmarkt wettbewerbsfähig zu machen.“"
                            },
                            {
                                "example_id": "95864a86-6bd5-48fd-938c-888e56175a4a",
                                "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                                "text": "„Einerseits erkennt er, dass Äthiopien inmitten der Kolonialmächte nur mit einer starken Zentralregierung und einer Wirtschaft, die auf den Weltmarkt ausgerichtet ist, überleben kann.“"
                            },
                            {
                                "example_id": "54cb5c0c-42c6-4d03-9d6a-ab055b5a699b",
                                "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                                "text": "„Überall, wo Regierungen am Weltmarkt teilnehmen, geht es bergauf.“"
                            },
                            {
                                "example_id": "c2bc7a39-69fe-4eb0-bb8a-64af69235a43",
                                "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                                "text": "„Gemeinsam mit Russland stellt die Ukraine etwa beim für die Lebensmittelproduktion besonders wichtigen Weizen knapp ein Drittel des gesamten Angebots auf dem Weltmarkt.“"
                            },
                            {
                                "example_id": "a13e705e-3a52-4a35-b875-aebcd4c5c6ab",
                                "sense_id": "a5339122-ec69-3a63-88e0-2fe8370408f5",
                                "text": "„In Industriegebieten, wie z.B. nordöstlich des Flughafens von Shenzen, steht eine Vielzahl Werkhallen, in denen für den Weltmarkt produziert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
