    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1abdf83f-3b33-3590-ace3-0751e22b5605",
                    "sense_definition": "Se déplacer ou se maintenir dans les airs au moyen d'ailes ou d'un appareil.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les oiseaux <w>volent</w> dans le ciel bleu dès le lever du soleil."
                        },
                        {
                            "text": "Cet avion de ligne peut <w>voler</w> à plus de dix mille mètres d'altitude."
                        }
                    ],
                    "common_phrases": [
                        "voler en éclats",
                        "voler de ses propres ailes"
                    ]
                },
                {
                    "sense_id": "f95d1ca4-8b17-3ed1-88e2-3d58b06a2ca2",
                    "sense_definition": "S'approprier le bien d'autrui contre son gré ou à son insu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appropriation_illegale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelqu'un a <w>volé</w> mon vélo pendant que je faisais des courses."
                        },
                        {
                            "text": "Un homme a <w>volé</w> le portefeuille d'une touriste dans le métro."
                        }
                    ],
                    "synonyms": [
                        "chouraver",
                        "dérober",
                        "faucher",
                        "piquer"
                    ],
                    "common_phrases": [
                        "voler la vedette"
                    ]
                },
                {
                    "sense_id": "cba83253-59da-3d5e-98c2-4a707ede0bcc",
                    "sense_definition": "Se déplacer très rapidement ou se précipiter avec empressement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En apprenant l'accident, il a aussitôt décidé de <w>voler</w> au secours de son ami."
                        },
                        {
                            "text": "Les années passent vite et le temps <w>vole</w> quand on est heureux."
                        }
                    ],
                    "common_phrases": [
                        "voler au secours"
                    ]
                },
                {
                    "sense_id": "d69a45ac-356f-3ba2-b004-e3ed489c1c34",
                    "sense_definition": "Mériter pleinement un événement positif ou négatif, presque toujours employé à la forme négative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "merite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après tous ses efforts tout au long de l'année, il n'a vraiment pas <w>volé</w> son succès."
                        },
                        {
                            "text": "Il a reçu une punition sévère pour son insolence et il ne l'a pas <w>volée</w>."
                        }
                    ],
                    "common_phrases": [
                        "ne pas l'avoir volé"
                    ]
                },
                {
                    "sense_id": "3dcaf264-056c-3411-8c26-91e0ece6925f",
                    "sense_definition": "Escroquer ou léser quelqu'un en lui faisant payer un prix excessif ou injuste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriation_illegale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce commerçant peu scrupuleux a tenté de <w>voler</w> les clients en doublant ses tarifs."
                        },
                        {
                            "text": "À ce prix excessif pour un simple café, les touristes ont l'impression de se faire <w>voler</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier pour désigner une arnaque ou un abus de prix"
                        }
                    ]
                }
            ]
        }
    ]
}