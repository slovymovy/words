                "senses": [
                    {
                        "sense_id": "1a4bb5d8-8a9a-3170-919b-ad96b50cdb06",
                        "entry_id": "127618fa-8c6a-367e-a045-e0d2821764b0",
                        "glosses": [
                            "Gefühl, bekümmert zu sein, sich einige Sorgen zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12306164-a2ed-4186-b3f1-763665d70299",
                                "sense_id": "1a4bb5d8-8a9a-3170-919b-ad96b50cdb06",
                                "text": "„Ich wollte also morgen früh zu ihm auf die Station gehen und uns loskaufen, damit unser Tag ohne Kümmernisse sein möchte.“"
                            },
                            {
                                "example_id": "ccf2e5e1-30b2-4bd4-b45d-23b3ce6d1d6f",
                                "sense_id": "1a4bb5d8-8a9a-3170-919b-ad96b50cdb06",
                                "text": "„Das waren meine ersten Kümmernisse, und zwar die bittersten, die ein junger Mensch empfinden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
