                        "source_entry_id": "7eee337a-b616-3448-a733-9533aaa98cef",
                        "source_sense_description": "act or process of making somebody or something proletarian",
                        "target_lang_word": "prolétarisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolétarisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68543ebc-2547-3000-9927-b4ebc296dbae",
                                        "entry_id": "0f0f425c-f4c9-3006-bb2b-c91e7f1ea327",
                                        "glosses": [
                                            "Action de prolétariser, de rendre prolétaire ou de paupériser la classe ouvrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3440c329-cea4-4726-bdea-30e907d08592",
                                                "sense_id": "68543ebc-2547-3000-9927-b4ebc296dbae",
                                                "text": "En Russie, le marxisme s’était greffé sur le drame d’une prolétarisation que le XIXᵉ siècle impérial échoua à réduire, quand il ne s’y refusait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7738fb-8625-3f14-b694-ec74bd7f3a12",
                                        "entry_id": "0f0f425c-f4c9-3006-bb2b-c91e7f1ea327",
                                        "glosses": [
                                            "Processus de dépossession de savoirs (savoir-faire, savoir-vivre, savoir-penser). Concept stieglerien."
                                        ],
                                        "tags": [
                                            "Époque contemporaine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3675e0-b0a2-406e-b4c0-9164dc2b87a3",
                                                "sense_id": "2d7738fb-8625-3f14-b694-ec74bd7f3a12",
                                                "text": "Or, comme le soutient Stiegler, la question aujourd’hui n’est pas vraiment celle de l’aliénation mais celle d’« une prolétarisation généralisée », définie comme perte de savoirs (savoir-vivre, savoir-faire, savoir théoriser et savoir concevoir)."
                                            },
                                            {
                                                "example_id": "5543b9c7-1d1c-47eb-acba-c972da28f3c9",
                                                "sense_id": "2d7738fb-8625-3f14-b694-ec74bd7f3a12",
                                                "text": "Le concept stieglerien de prolétarisation est issu d’une relecture de Marx."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
