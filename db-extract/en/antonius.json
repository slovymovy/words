                                "target_senses": [
                                    {
                                        "sense_id": "a226c449-0bb8-32c4-bf73-538dc112a8ff",
                                        "entry_id": "2277c022-b3f2-3b9a-b624-e14ba692e8bf",
                                        "glosses": [
