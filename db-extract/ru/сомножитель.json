                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplicand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa719341-66cd-3abb-b982-245629c57046",
                                        "entry_id": "981abb3b-71ab-3994-8ef5-cbdd4eb1a2a1",
                                        "glosses": [
                                            "A number that is to be multiplied by another (the multiplier)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed848d1a-5545-468a-8275-b407125d5e7d",
                                                "sense_id": "aa719341-66cd-3abb-b982-245629c57046",
                                                "text": "In the expression 5 × 3, the \"3\" is the multiplicand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "009f9565-682a-4fea-aaec-3f865c095ecd",
                        "source_entry_id": "70765b3d-64f7-3780-bba2-04f7097729f0",
                        "source_sense_id": "0a8c8ee4-e2a1-3a6d-afe5-9143e1755109",
                        "target_lang_word": "Faktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "883b6da1-9e64-3842-af44-548a66d55180",
                                        "entry_id": "b1307942-9f87-3795-bc24-23fff31d1c39",
                                        "glosses": [
                                            "Operand der Multiplikation, Teil eines Produktes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42656578-a43b-4ffd-9d61-15583952e500",
                                                "sense_id": "883b6da1-9e64-3842-af44-548a66d55180",
                                                "text": "Der Faktor 2 verdoppelt eine Zahl."
                                            },
                                            {
                                                "example_id": "43cb472b-fac9-44f5-ab38-895c7c867af2",
                                                "sense_id": "883b6da1-9e64-3842-af44-548a66d55180",
                                                "text": "Faktor mal Faktor = Produkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cf3348d-57a8-3df6-be13-484a0a63fe60",
                                        "entry_id": "b1307942-9f87-3795-bc24-23fff31d1c39",
                                        "glosses": [
                                            "mitwirkender Bestandteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b42c6d-9630-487b-8942-ec5b74cb0f2d",
                                                "sense_id": "5cf3348d-57a8-3df6-be13-484a0a63fe60",
                                                "text": "Das traumatische Erlebnis in ihrer Kindheit könnte ein entscheidender Faktor für ihre Verhaltensstörung sein."
                                            },
                                            {
                                                "example_id": "a6fcb0be-6b1e-4bb8-81d7-21c89731b6e1",
                                                "sense_id": "5cf3348d-57a8-3df6-be13-484a0a63fe60",
                                                "text": "„Diese Faktoren sind auch für die sprachliche Entwicklung maßgebend.“"
                                            },
                                            {
                                                "example_id": "fca2d9c7-5451-44ee-bce2-afe184cc5ce4",
                                                "sense_id": "5cf3348d-57a8-3df6-be13-484a0a63fe60",
                                                "text": "„Für die explodierten Kosten sind besonders zwei Faktoren verantwortlich, die in diesem Jahr zusammenkommen: der gestiegene Mindestlohn und die Energiekrise.“"
                                            },
                                            {
                                                "example_id": "11220c25-48f9-4540-9d86-2b0a5d1a33ba",
                                                "sense_id": "5cf3348d-57a8-3df6-be13-484a0a63fe60",
                                                "text": "„Wie schon das ebenfalls nicht für seine Einfachheit bekannte Latein zeigt, sind es ökonomische, machtpolitische und kulturelle Faktoren, die einer Sprache internationale Verbreitung verschaffen. Vor diesem Hintergrund könnte bald das Mandarin-Zeitalter anbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f4f69bba-b039-3f7b-b07c-40fe7bab0902",
                                        "entry_id": "b1307942-9f87-3795-bc24-23fff31d1c39",
                                        "glosses": [
                                            "Vorsteher einer Faktorei, Faktorist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "298cfea1-d91a-3602-8e75-950ed55694e5",
                                        "entry_id": "b1307942-9f87-3795-bc24-23fff31d1c39",
                                        "glosses": [
                                            "Werkmeister einer Buchdruckerei"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3bde89a-d879-47f9-8525-1372e5e28076",
