                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bathymètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95bb12f8-d7e9-3b8e-992d-b9781623f931",
                                        "entry_id": "21faedd3-d687-3c2f-8bef-4617bcba44a0",
                                        "glosses": [
                                            "Appareil de mesure des fonds marins, généralement en utilisant la réflexion d’une onde acoustique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "face5f8f-7027-459d-b80d-38ea4b59cafd",
                                                "sense_id": "95bb12f8-d7e9-3b8e-992d-b9781623f931",
                                                "text": "Le sonar et le bathymètre du submersible avaient rendu l’âme avant lui, et Mahnmut avait commis le plus antique et le plus grave des crimes que peut commettre un capitaine : il avait fait échouer son navire."
                                            },
                                            {
                                                "example_id": "eba3860e-1d62-4a6e-8a27-6470f2c53946",
                                                "sense_id": "95bb12f8-d7e9-3b8e-992d-b9781623f931",
                                                "text": "bathymètre : Instrument destiné à mesurer la profondeur de la mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c3761b3-a8ed-42c7-8050-8bfedc3ef364",
                        "source_entry_id": "3cc89f6a-ec97-3bf7-b8ee-dfd59affad24",
