                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e217b1f7-0c72-3e3f-a0f1-916352b7e5f5",
                        "entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
                        "glosses": [
                            "Conduite ou fossé destiné à recevoir les écoulements captés dans les parcelles par plusieurs types d’ouvrages et à les acheminer jusqu'à l’exutoire."
                        ],
                        "tags": [
                            "Hydraulique",
                            "Drainage agricole"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e15b5ddd-8dda-3e76-accf-4db9c1a058ff",
                        "entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
                        "glosses": [
                            "Sorte de tube ou de tubulure qui reçoit des fluides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714a5903-729a-415a-a50a-6d4586ec963e",
                                "sense_id": "e15b5ddd-8dda-3e76-accf-4db9c1a058ff",
                                "text": "Les paramètres de température des organes du compartiment moteur sont contrôlés avant chaque expérience, ceci afin d'assurer que la température du collecteur d’échappement est supérieure à la température d’auto-inflammation de l’essence indice octane 95, soit env. 370°C."
                            }
                        ]
                    },
                    {
                        "sense_id": "c754caa5-4f7d-38a1-8003-7b39fa643550",
                        "entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
                        "glosses": [
                            "Programme qui parcourt la toile pour en extraire des éléments de repérage de contenus, destinés à être utilisés par un moteur de recherche."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "981cf182-95e2-4e4b-8327-2a1273672c03",
                        "source_entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
