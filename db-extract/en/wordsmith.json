                "senses": [
                    {
                        "sense_id": "c68073b1-2bf6-3e53-b759-187ed7e0bc65",
                        "entry_id": "498b9a34-369c-3b36-94e6-1e640d289d1c",
                        "glosses": [
                            "One who uses words skilfully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87dcabab-d7e6-41b5-8452-315be4f8eaf0",
                                "sense_id": "c68073b1-2bf6-3e53-b759-187ed7e0bc65",
                                "text": "She has always been known as a capable wordsmith, but in this latest novel she also shows surprising emotional depth."
                            },
                            {
                                "example_id": "cce010c0-b6eb-47e7-a614-97f4d92b02a8",
                                "sense_id": "c68073b1-2bf6-3e53-b759-187ed7e0bc65",
                                "text": "I bottle up and then spill it in verses / One day, I'm wordless, next day, I'm a wordsmith / Close to success, but to happiness, I'm the furthest"
                            }
                        ]
                    }
                ],
