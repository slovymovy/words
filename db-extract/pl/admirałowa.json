                "senses": [
                    {
                        "sense_id": "a1147b58-7e35-3889-ab03-86d2e9b516d9",
                        "entry_id": "4ce00f61-02a3-34ea-abca-e836f2340bcd",
                        "glosses": [
                            "admiral's wife"
                        ],
                        "tags": [
                            "feminine",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f48ae2-6f29-45f4-8213-1f548e06dfb0",
                                "sense_id": "a1147b58-7e35-3889-ab03-86d2e9b516d9",
                                "text": "Dnia 19 m.b. umarła tu Admirałowa Sir Sidney Smith.",
                                "translation": "On the 19th m.b. the admiral Sir Sidney Smith's wife died here.",
                                "english": "On the 19th m.b. the admiral Sir Sidney Smith's wife died here."
                            },
                            {
                                "example_id": "90472344-d7d7-43e4-85bd-80c7d5b7abe8",
                                "sense_id": "a1147b58-7e35-3889-ab03-86d2e9b516d9",
                                "text": "Podobnież zaledwie z największą trudnością uniknął rozbicia statek Superb, na którym jechała admirałowa Napier i mocno uszkodzony zawinął do portu Gorunna.",
                                "translation": "Likewise, the ship Superb, on which the admiral's wife Napier was riding, just nearly avoided being wrecked, and was heavily damaged at Gorunna port.",
                                "english": "Likewise, the ship Superb, on which the admiral's wife Napier was riding, just nearly avoided being wrecked, and was heavily damaged at Gorunna port."
                            },
                            {
                                "example_id": "822b4783-8181-498b-afa7-b87c37ab74fe",
                                "sense_id": "a1147b58-7e35-3889-ab03-86d2e9b516d9",
                                "text": "- To szef kancelarii jest krewnym admirałowej?",
                                "translation": "\"So the boss is a relative of the admiral's wife?\"",
                                "english": "\"So the boss is a relative of the admiral's wife?\""
                            }
                        ]
                    }
                ],
