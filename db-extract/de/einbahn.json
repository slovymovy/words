                "senses": [
                    {
                        "sense_id": "86e2cba7-43c1-3519-838d-f7d68d33bada",
                        "entry_id": "a1fbec9a-1eea-3605-bb23-2ff12ac0cd10",
                        "glosses": [
                            "Straße, welche nur in eine Richtung befahren werden darf"
                        ],
                        "tags": [
                            "Austrian German",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "09c780bf-7ed7-41f9-a25c-0b9112046b97",
                                "sense_id": "86e2cba7-43c1-3519-838d-f7d68d33bada",
                                "text": "„Einhellig sprechen sich die Wirte daher dafür aus, die Einbahn umzudrehen.“"
                            },
                            {
                                "example_id": "75a2a9af-f2bf-4966-ade5-7752e5222fbc",
                                "sense_id": "86e2cba7-43c1-3519-838d-f7d68d33bada",
                                "text": "Ich bin in der falschen Richtung in eine Einbahn eingebogen."
                            },
                            {
                                "example_id": "2cdb9d34-5144-468b-a17f-5f48c3087abe",
                                "sense_id": "86e2cba7-43c1-3519-838d-f7d68d33bada",
                                "text": "„Gegen die Einbahn zu fahren ist knapp jedem Dritten (32 Prozent) schon passiert.“"
                            },
                            {
                                "example_id": "bb1d9425-ecc7-4480-88a5-86be2d7dabb0",
                                "sense_id": "86e2cba7-43c1-3519-838d-f7d68d33bada",
                                "text": "„Für sechs Wochen wird die Verkehrsverbindung daher streckenweise zur Einbahn, in die Gegenrichtung gibt es eine Umleitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
