            {
                "entry_id": "b34c9927-e579-3343-8aee-c55e4bb2820f",
                "word": "Soninké",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d0de48d-2b5c-41d3-9d35-362168280fb9",
                        "entry_id": "b34c9927-e579-3343-8aee-c55e4bb2820f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Soninkés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd266146-5eeb-31b2-a63f-611dcd46ffae",
                        "entry_id": "b34c9927-e579-3343-8aee-c55e4bb2820f",
                        "glosses": [
                            "Peuple mandingue de l’Afrique de l’Ouest, vivant principalement au Mali entre Nara et Nioro, ainsi qu’au Sénégal, en Mauritanie et en Guinée-Bissau"
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "8caf69cd-e3dc-4096-b094-e363f0046e55",
                                "sense_id": "dd266146-5eeb-31b2-a63f-611dcd46ffae",
                                "text": "Ce sera un parti pluriethnique où le dirigeant sera un Wolof, comme il existe en Mauritanie certains partis où il y aura des Arabo-berbères, des Haratines, des Peuls, des Soninkés."
                            },
                            {
                                "example_id": "f41786e3-dd01-4cdd-ab6d-7904e3701779",
                                "sense_id": "dd266146-5eeb-31b2-a63f-611dcd46ffae",
                                "text": "Le plus souvent, cette entraide concerne essentiellement les Soninké, qu'ils soient du Mali, du Sénégal ou de Mauritanie."
                            }
                        ]
                    }
                ],
