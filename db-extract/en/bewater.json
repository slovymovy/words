                        "glosses": [
                            "To water about or all over; cover, douse, or fill with water; make wet; water; hydrate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5207eeb8-80a4-4677-9766-f113aa33fdd0",
                                "sense_id": "c9027d00-af80-3490-ab7c-ac9cd16dd103",
                                "text": "A piece of brass may as easily melt, or a flint bewater itself, as the heart of man, by any innate power of its own, resolve itself into a penitential humiliation."
                            },
                            {
                                "example_id": "be1f124c-3ca3-4ff9-8e3b-4c335b27aa2c",
                                "sense_id": "c9027d00-af80-3490-ab7c-ac9cd16dd103",
                                "text": "For ten days my wife and I fed this mile, every two hours by day, and three by night, wi'h drops of cow's milk, sugared and bewatered."
                            },
                            {
                                "example_id": "3e7ed72b-2c78-46ab-b7e9-362e96449900",
                                "sense_id": "c9027d00-af80-3490-ab7c-ac9cd16dd103",
                                "text": "[...] unto my chamber aloft now will I go And lie on the bed that knoweth the wailing of my woe, With many a tear bewatered since the day Odysseus fared With Atreus' sons to Ilios."
                            }
                        ]
                    }
