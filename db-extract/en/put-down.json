{
    "word": "put-down",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                "word": "put-down",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4a44485b-4516-484a-bcc5-0bc58d389aa9",
                        "entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "tags": [
                            "plural"
                        ],
                        "form": "put-downs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "glosses": [
                            "An insult or barb; a snide or demeaning remark."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed969d1-c69c-44cf-9654-fea374061e1f",
                                "sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                                "text": "When he called you a know-it-all, he meant it as a put-down."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c8b035-ed1a-4c7a-914c-e5d91a8288e7",
                        "source_entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "source_sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "source_sense_description": "insult or barb",
                        "target_lang_word": "Erniedrigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erniedrigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                        "entry_id": "3e4ea25f-80ab-3674-b879-7ecac59167fa",
                                        "glosses": [
                                            "menschenunwürdige Behandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbdbd06-a718-410f-88cc-7364a83ad016",
                                                "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                                "text": "„Wie lange lassen sich die Völker von Mauretanien bis Jemen und vom Sudan bis Syrien diese Erniedrigungen noch gefallen?“"
                                            },
                                            {
                                                "example_id": "564679c7-9468-4338-8d0c-314cd366d5b1",
                                                "sense_id": "7e4fec12-a912-3dee-8bb0-0f9647350bbc",
                                                "text": "„Der Unterschied zwischen völliger Unschuld und völliger Erniedrigung ist so gering, daß sie sogleich bei ihrem ersten Versuch jenen Grad gewollter Niedrigkeit erreichte, durch den sie mich zu verführen dachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4aab2af0-630d-33d2-854c-46a65165cae7",
                                        "entry_id": "3e4ea25f-80ab-3674-b879-7ecac59167fa",
                                        "glosses": [
                                            "Maßnahme oder Ergebnis der Verringerung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5eaab5-9091-4b01-a864-8ca20b2ba777",
                                                "sense_id": "4aab2af0-630d-33d2-854c-46a65165cae7",
                                                "text": "„Bei der antihypertensiven Therapie ist es die Erniedrigung des Blutdrucks, die das Risiko für Schlaganfall, Herzinfarkt, Herzinsuffizienz und Nierenschädigung verringert. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad16879b-896e-4c47-a903-31b09a33d916",
                        "source_entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "source_sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "source_sense_description": "insult or barb",
                        "target_lang_word": "Herabsetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herabsetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                        "entry_id": "b62f3149-6d6f-3336-8841-26f97be355b5",
                                        "glosses": [
                                            "Handlung, etwas weniger oder kleiner zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a574e9-f82b-4977-9812-a913a35bde3f",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Sollte das Finanzamt den Antrag auf Herabsetzung ablehnen, kann der Unternehmer Einspruch einlegen.“"
                                            },
                                            {
                                                "example_id": "7154b583-689f-4a7d-bf24-8dc82dcb46b5",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Sofern der Anspruch auf Herabsetzung bereits zum Zeitpunkt der Gebührenfestsetzung feststeht, darf die Gebühr nur in der Höhe festgesetzt werden, die der in den Kanal eingeleiteten Wassermenge entspricht.“"
                                            },
                                            {
                                                "example_id": "9d38b120-5945-45d1-923c-063f8196a2b9",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Mit seiner Berufung erstrebt er die Herabsetzung des Strafausmaßes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1248759d-0fb5-3d2c-9faf-0efacdb3ad7f",
                                        "entry_id": "b62f3149-6d6f-3336-8841-26f97be355b5",
                                        "glosses": [
                                            "unsachliche Geringschätzung der Bedeutung eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fcd250-7889-4701-86b7-a3488bff91c0",
                                                "sense_id": "1248759d-0fb5-3d2c-9faf-0efacdb3ad7f",
                                                "text": "„[Andreas Rödder:] Die Grenze würde ich dort ziehen, wo die Menschenwürde betroffen ist und es zu persönlichen Beleidigungen, völkischem Denken und der Herabsetzung anderer Menschen kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "757cd436-1dee-4fe6-9830-becbba31c050",
                        "source_entry_id": "50a1a225-7d89-3b04-81d5-e61645200a3a",
                        "source_sense_id": "738acd21-3e19-36d8-bec1-80a1b5de629a",
                        "source_sense_description": "insult or barb",
                        "target_lang_word": "afront",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afront",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                                        "entry_id": "fa9fcc75-ebd0-383f-a291-27583d1b496d",
                                        "glosses": [
                                            "zniewaga, lekceważące zachowanie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0256a1a7-a484-4603-b527-3da9b9b0e130",
                                                "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                                                "text": "Zrobiła mi dziś afront, komentując przy wszystkich moją nadwagę."
                                            },
                                            {
                                                "example_id": "fdc955e6-fa43-4af5-8b97-b0be0b1bf897",
                                                "sense_id": "e9573fbd-7c15-3bb5-83fb-b7e59f843dc9",
                                                "text": "Musi on za ten afront odpokutować, bo to całego stanu szlacheckiego krzywda."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
