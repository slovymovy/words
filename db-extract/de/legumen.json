                "senses": [
                    {
                        "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                        "entry_id": "32e8d85e-2c39-3bcb-b5ed-46732f74165f",
                        "glosses": [
                            "Frucht der Leguminosen (Hülsenfrüchtler oder Hülsenfrüchter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d219d5af-cc35-490d-8302-852c7f28575a",
                                "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                                "text": "Legumen sind eine wichtige pflanzliche Proteinquelle."
                            },
                            {
                                "example_id": "3fa7c78d-e575-4c79-bfbc-87103a8f39b1",
                                "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                                "text": "Gemüse und Legumen werden für die Zubereitung köstlicher Suppen verwendet."
                            },
                            {
                                "example_id": "7e71a9e4-06f3-43f1-a90a-bc56dbea70ce",
                                "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                                "text": "Manche der Legumen, wie zum Beispiel die Erdnuss, führt zu allergischen Reaktionen."
                            },
                            {
                                "example_id": "aeda740b-4b50-46a5-9d71-14b0c3f392f9",
                                "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                                "text": "Was wir auch tun können, um den Kohlenhydratanteil bekömmlicher zu machen: wir lassen die Getreidesamen bzw. Legumen und Bohnen spriessen."
                            },
                            {
                                "example_id": "bb784b40-ec0e-480f-bf1c-153ad3d024a3",
                                "sense_id": "8616e41b-5d00-30eb-ad5f-3e131ff8340d",
                                "text": "Beispielsweise würden die in der Landwirtschaft so wichtigen Legumen aller Art - ohne das Spurenelement - für die menschliche Ernährung sowie als Tierfutter ausfallen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
