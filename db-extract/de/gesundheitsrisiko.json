                "senses": [
                    {
                        "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                        "entry_id": "f214eb25-343a-3352-a0ea-c273cf9a8e98",
                        "glosses": [
                            "etwas, das sich negativ auf den gesundheitlichen Zustand auswirkt; Risiko für die Gesundheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec2c1f8-cd9d-40b6-93cc-149bedfcd3ed",
                                "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                                "text": "„Vor allem im Bauchbereich ist zu viel Fettgewebe ein Gesundheitsrisiko.“"
                            },
                            {
                                "example_id": "945f7b53-b0c4-409f-a4ff-e7bc463bfd96",
                                "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                                "text": "„Das größte Gesundheitsrisiko, das man selbst beeinflussen kann, ist immer noch das Rauchen.“"
                            },
                            {
                                "example_id": "c1ce3dcf-aad3-47bd-9ff4-3ef358a539b7",
                                "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                                "text": "„Der übermäßige Konsum von alkoholhaltigen Getränken entwickelt sich immer mehr zum Gesundheitsrisiko.“"
                            },
                            {
                                "example_id": "3055a759-44c8-4e9b-90cb-142d4d06adff",
                                "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                                "text": "„Einhergehend zu dem Gesundheitsrisiko verursacht durch Bewegungsmangel werden immer mehr Kinder und Jugendliche erfasst, die an Übergewicht oder Adipositas leiden.“"
                            },
                            {
                                "example_id": "7556f63e-e6c7-4711-8ad3-770c1c294aea",
                                "sense_id": "92f4d782-d5d8-31f5-b459-116390b35999",
                                "text": "„Selbst geringste Strahlenbelastung verursacht Effekte und ist damit ein Gesundheitsrisiko für Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
