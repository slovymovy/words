{
    "word_family": [
        "plunger",
        "plunging",
        "plunged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5367f29b-3355-3193-9140-47c398966d72",
                    "sense_definition": "To fall, move, or drop suddenly and quickly into a particular state, condition, or physical space.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sudden_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's stock prices began to <w>plunge</w> after the disappointing quarterly report was released.",
                            "target_lang_translations": {
                                "ru": "Цены на акции компании начали <w>резко падать</w> после публикации разочаровывающего квартального отчета."
                            }
                        },
                        {
                            "text": "The hikers watched as the waterfall started to <w>plunge</w> into the deep canyon below.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы наблюдали, как водопад начал <w>низвергаться</w> в глубокий каньон внизу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunge into debt",
                        "profits plunge",
                        "plunge into darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и быстро упасть, переместиться или перейти в определенное состояние, условие или физическое пространство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко падать",
                                "target_lang_sense_clarification": "о ценах, показателях"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "в состояние, например, в долги или тьму"
                            },
                            {
                                "target_lang_word": "устремляться вниз",
                                "target_lang_sense_clarification": "о физическом движении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb90a03-4f60-3687-9b4d-4dfa0224ec06",
                    "sense_definition": "To jump or dive quickly and energetically into water or another liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a hot summer day, the children love to <w>plunge</w> into the cold lake.",
                            "target_lang_translations": {
                                "ru": "В жаркий летний день дети обожают <w>нырять</w> в холодное озеро."
                            }
                        },
                        {
                            "text": "He decided to <w>plunge</w> into the pool without checking the temperature first.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>прыгнуть</w> в бассейн, не проверив сначала температуру воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunge into the river",
                        "plunge into the sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и энергично прыгнуть или нырнуть в воду или другую жидкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нырять",
                                "target_lang_sense_clarification": "в воду"
                            },
                            {
                                "target_lang_word": "бросаться",
                                "target_lang_sense_clarification": "в воду"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "в жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "714afb1f-3325-3f51-9df4-77100574356a",
                    "sense_definition": "To push something sharp or heavy into something else with force and speed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forceful_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef had to <w>plunge</w> a knife into the large pumpkin to start carving it.",
                            "target_lang_translations": {
                                "ru": "Повару пришлось <w>вонзить</w> нож в большую тыкву, чтобы начать её вырезать."
                            }
                        },
                        {
                            "text": "In the movie, the hero had to <w>plunge</w> a dagger into the wooden table to make his point.",
                            "target_lang_translations": {
                                "ru": "В фильме герою пришлось <w>воткнуть</w> кинжал в деревянный стол, чтобы подтвердить свои слова."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunge a knife",
                        "plunge a dagger"
                    ],
                    "target_lang_definitions": {
                        "ru": "С силой и скоростью вонзить что-то острое или тяжелое во что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонзать",
                                "target_lang_sense_clarification": "нож или кинжал"
                            },
                            {
                                "target_lang_word": "втыкать",
                                "target_lang_sense_clarification": "с силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c5dbfb-8302-3b24-b990-244aa682db8b",
                    "sense_definition": "To use a rubber suction tool to clear a blockage in a pipe or toilet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the water does not go down, you might need to <w>plunge</w> the toilet.",
                            "target_lang_translations": {
                                "ru": "Если вода не уходит, возможно, вам придется <w>прочистить</w> унитаз вантузом."
                            }
                        },
                        {
                            "text": "He had to <w>plunge</w> the sink for ten minutes before the drain finally cleared.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>прокачивать</w> раковину вантузом десять минут, прежде чем слив наконец очистился."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunge a toilet",
                        "plunge the sink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать вантуз для устранения засора в трубе или унитазе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочищать вантузом",
                                "target_lang_sense_clarification": "трубы или унитаз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5065534f-da53-36cc-8263-6cbe56d7254c",
                    "sense_definition": "To bet or risk a large amount of money in a reckless or hazardous way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>plunge</w> his entire inheritance on a single horse race.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>поставить</w> всё своё наследство на один кон в скачках."
                            }
                        },
                        {
                            "text": "Many investors <w>plunge</w> into risky markets without understanding the potential for loss.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы <w>бросаются</w> на рискованные рынки, не понимая возможности убытков."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить на кон или рисковать большой суммой денег безрассудным или опасным способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускаться в авантюру",
                                "target_lang_sense_clarification": "финансовую"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "крупной суммой"
                            },
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "опрометчиво"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1455d711-2c15-3d3a-982c-09212b26a758",
                    "sense_definition": "A sudden dive or jump into water, or a sudden downward movement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long hike, a quick <w>plunge</w> in the mountain stream felt refreshing.",
                            "target_lang_translations": {
                                "ru": "После долгого похода быстрое <w>окунание</w> в горный ручей принесло освежение."
                            }
                        },
                        {
                            "text": "The sudden <w>plunge</w> in temperature caught everyone by surprise this morning.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>падение</w> температуры сегодня утром застало всех врасплох."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a plunge",
                        "a plunge into the sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное погружение или прыжок в воду, либо резкое движение вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "в воду"
                            },
                            {
                                "target_lang_word": "ныряние",
                                "target_lang_sense_clarification": "погружение"
                            },
                            {
                                "target_lang_word": "резкое падение",
                                "target_lang_sense_clarification": "температуры или цен"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64da484b-cf19-303e-87dd-b35404ae3b92",
                    "sense_definition": "A reckless or heavy bet, or a very risky financial speculation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His latest financial <w>plunge</w> resulted in a significant loss for the firm.",
                            "target_lang_translations": {
                                "ru": "Его последняя финансовая <w>авантюра</w> привела к значительным убыткам для фирмы."
                            }
                        },
                        {
                            "text": "Taking a <w>plunge</w> on such an unproven technology was a bold move for the startup.",
                            "target_lang_translations": {
                                "ru": "<w>Рискнуть</w> с такой непроверенной технологией было смелым шагом для стартапа."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Безрассудная или крупная ставка, либо очень рискованная финансовая спекуляция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рискованный шаг",
                                "target_lang_sense_clarification": "в финансах"
                            },
                            {
                                "target_lang_word": "авантюра",
                                "target_lang_sense_clarification": "спекуляция"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
