                ],
                "senses": [
                    {
                        "sense_id": "6f8985e5-58b6-3fe7-81fa-84d924d96325",
                        "entry_id": "469b54c3-9c97-3386-81d3-40e8553c969d",
                        "glosses": [
                            "Signal, das sich am Ende eines Zuges befindet, um die Vollständigkeit des Zuges feststellen zu können"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "36910414-8763-4989-8360-f0c542b5d451",
                                "sense_id": "6f8985e5-58b6-3fe7-81fa-84d924d96325",
                                "text": "„Das normale Zugschlusssignal an Wagen (16b) bestand tagsüber aus den bekannten rot–weißen Schlussscheiben und nachts aus zwei roten Signal–Lichtern.“"
                            },
                            {
                                "example_id": "026b8161-0655-4d9e-80de-e5df46924f43",
                                "sense_id": "6f8985e5-58b6-3fe7-81fa-84d924d96325",
                                "text": "„Das Zugschlusssignal markiert – am Tag mit speziellen Scheiben oder bei Dunkelheit mit roten Lichtern – an der Rückseite des letzten Wagens die Vollständigkeit eines jeden Zuges.“"
                            },
                            {
                                "example_id": "51c83bb9-6b52-42af-b050-50a899799947",
                                "sense_id": "6f8985e5-58b6-3fe7-81fa-84d924d96325",
                                "text": "„Das Zugschlusssignal darf nur am Schluss des letzten Fahrzeugs eines Zuges gezeigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
