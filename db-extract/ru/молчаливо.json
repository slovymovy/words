                "senses": [
                    {
                        "sense_id": "7176cb5d-3e43-365f-a809-9183c61eab6f",
                        "entry_id": "1c0b2b93-7035-3440-b66d-50d43b0b465f",
                        "glosses": [
                            "наречие к молчаливый; без слов, молча"
                        ],
