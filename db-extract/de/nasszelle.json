                                            {
                                                "example_id": "9a16b76f-57fe-4fec-a492-4edf27a08fce",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Au premier étage, l’architecte a ménagé deux grandes chambres accompagnées chacune d’un cabinet de toilette, auxquelles la véranda sert de salon ; […] ."
                                            },
                                            {
                                                "example_id": "9e13bb89-cc1e-483a-9677-56173b323e87",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Les wagons de première classe sont pourvus de cabinets de toilette, ménagés à l’arrière, […]."
                                            },
                                            {
                                                "example_id": "a5537836-adcb-44d3-b542-bf14f8ae527c",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Elle s’habille. Je viens de la voir disparaître par la porte du cabinet de toilette."
