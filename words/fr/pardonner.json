{
    "word_family": [
        "pardon",
        "pardonnable",
        "impardonnable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eba66402-f66c-3cb5-a422-7d0580783bbc",
                    "sense_definition": "S'excuser poliment auprès de quelqu'un dans des formules de politesse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pardonnez</w>-moi de vous déranger si tard dans la soirée."
                        },
                        {
                            "text": "Vous me <w>pardonnerez</w> mon retard, les transports ne fonctionnaient pas bien ce matin."
                        }
                    ],
                    "common_phrases": [
                        "pardonnez-moi"
                    ]
                },
                {
                    "sense_id": "169725c1-a04c-3c59-a71f-217b82b70ced",
                    "sense_definition": "Accorder le pardon pour une faute commise ou cesser d'éprouver de la rancune envers quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lui <w>pardonne</w> de tout mon cœur son erreur passée."
                        },
                        {
                            "text": "Elle a décidé de <w>pardonner</w> à son ami pour sauver leur relation."
                        }
                    ],
                    "synonyms": [
                        "absoudre"
                    ],
                    "common_phrases": [
                        "pardonner une faute",
                        "pardonner à quelqu'un"
                    ]
                },
                {
                    "sense_id": "3f602930-389b-3ef4-90de-b4eccdc73b8a",
                    "sense_definition": "Excuser, tolérer ou trouver des circonstances atténuantes à une action ou un comportement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une longue amitié, il faut savoir <w>pardonner</w> de petites maladresses."
                        },
                        {
                            "text": "Je ne me <w>pardonne</w> pas d'avoir cru à ses mensonges évidents."
                        }
                    ],
                    "common_phrases": [
                        "se pardonner"
                    ]
                },
                {
                    "sense_id": "5b0764bc-1ae0-372c-a18e-4c33da0abe72",
                    "sense_definition": "Épargner quelqu'un ou quelque chose, le plus souvent employé à la forme négative pour désigner un effet impitoyable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poison violent ne <w>pardonne</w> pas une fois dans l'organisme."
                        },
                        {
                            "text": "Le temps qui passe ne <w>pardonne</w> à personne sans exception."
                        }
                    ],
                    "common_phrases": [
                        "ne pas pardonner"
                    ]
                },
                {
                    "sense_id": "90027ddf-72d6-394e-9024-3f6cce0b2607",
                    "sense_definition": "Faire grâce d'une peine ou remettre une punition de manière officielle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le souverain a choisi de <w>pardonner</w> aux condamnés lors de la fête nationale."
                        },
                        {
                            "text": "Par une amnistie, le nouveau gouvernement a choisi de <w>pardonner</w> aux opposants emprisonnés."
                        }
                    ],
                    "synonyms": [
                        "absoudre",
                        "amnistier"
                    ]
                }
            ]
        }
    ]
}