                                "text": "Prêt bancaire capé à 6 %."
                            }
                        ]
                    },
                    {
                        "sense_id": "af181e2a-6e6e-338f-a3ea-57bf63927fda",
                        "entry_id": "626d197d-64a1-39c8-aea9-8e0bab30c780",
