                                        "glosses": [
                                            "composto chimico derivato dall'ammoniaca, in cui una catena laterale è legata ad un radicale formato dall'unione di un carbonile con un derivato dell'ammina; le ammidi trovano impiego principalmente nelle industrie della plastica e dei fertilizzanti"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
