                        "sense_id": "62102f1f-f811-33ef-8170-c78dec3d4d2e",
                        "entry_id": "7693ff34-51da-3435-b9a2-068b45214738",
                        "glosses": [
                            "Personne du peuple atikamekw, peuple amérindien de la province de Québec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2125713c-4aa4-4382-ae4d-9a080ab90e8b",
                                "sense_id": "62102f1f-f811-33ef-8170-c78dec3d4d2e",
                                "text": "La teneur des discussions et le ras-le-bol généralisé manifesté par les Atikamekws montrent que le problème est autrement plus complexe."
                            },
                            {
                                "example_id": "ac4334b3-0285-41a9-b46a-78e8e57fc177",
                                "sense_id": "62102f1f-f811-33ef-8170-c78dec3d4d2e",
                                "text": "Le mémoire qui se veut «un appel à l’action et à l’engagement» est l’initiative du Conseil des Atikamekw de Manawan (CDAM), et a été élaboré avec le conseil de la Nation Atikamekw (CNA)."
                            }
                        ]
                    }
