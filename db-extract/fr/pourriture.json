                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dc7c9da-cc04-3b7a-8def-443f3deb030a",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Corruption, décomposition, état de ce qui est pourri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f01e0d7-cb4f-46c8-8ec6-561d6848cb2a",
                                "sense_id": "0dc7c9da-cc04-3b7a-8def-443f3deb030a",
                                "text": "Sa jambe est si gangrenée qu’elle tombe en pourriture."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fb60220-6b42-392e-8cb6-edb17428a999",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Ce qui est pourri."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "86afd179-6136-45fb-b283-3493adef7039",
                                "sense_id": "0fb60220-6b42-392e-8cb6-edb17428a999",
                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides : depuis un mois, ils avaient bu de l’eau dans laquelle mijotait ce noyé ; depuis un mois tout le pays s’abreuvait de cette pourriture."
                            }
                        ]
                    },
                    {
                        "sense_id": "4675226d-e738-3cc4-b223-e2804521498a",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Maladie contagieuse qui s’observait surtout dans certains locaux hospitaliers où les plaies et les ulcères étaient soignés, au temps où l’antisepsie et l’asepsie étaient insuffisamment pratiquées."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d1802267-c4c4-309d-b90b-786dc51e7353",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Altération du bois accompagnée d’une dégradation de ses qualités mécaniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1423ed3-f8a0-4143-9192-bc471ea21058",
                                "sense_id": "d1802267-c4c4-309d-b90b-786dc51e7353",
                                "text": "Ces altérations limitées au bois de cœur présentent un caractère évolutif avec apparition d’une coloration jaunâtre sans dégradation du bois au départ, puis disparition progressive de la structure du bois qui prend un aspect fibreux et blanc. Au stade final, le bois disparaît au centre de la pourriture."
                            }
                        ]
                    },
                    {
                        "sense_id": "7291c1a9-699b-34ef-8125-09ace68b05e2",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Moisissure de plantes cultivées qui est due à divers champignons selon les espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b832597-1ecc-4ea9-9650-54f8898fd86b",
                                "sense_id": "7291c1a9-699b-34ef-8125-09ace68b05e2",
                                "text": "L’imazalil est un nouveau fongicide efficace sur les pourritures à Pénicillium des fruits en cours de conservation."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea63550d-2e7b-359b-87eb-a9b1c0ac39e5",
                        "entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "glosses": [
                            "Individu dénué de toute valeur morale."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986ad195-5b7f-4597-b36c-5df5d063eb5b",
                        "source_entry_id": "1c6e687c-9b42-3960-a653-cf9ca309c89a",
                        "target_lang_word": "Fäule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fäule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                        "entry_id": "8f57becc-719e-3576-a865-7fa116dc0b1c",
                                        "glosses": [
                                            "Vorgang, in dem ein biologischer Stoff, beispielsweise Blätter, Früchte, ganze Bäume oder (veraltet) Tier- oder Menschenkörper durch den Befall mit Mikroorganismen, wie Pilzen, Bakterien, Protozoen und anderen Destruenten zersetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d4fc068-751d-4033-ae8b-8d956fca36b2",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "Mangelnde Düngung mit Stickstoff erzeugt bei Tomaten eine zu dünne Haut, die sie anfällig macht für Fäule."
                                            },
                                            {
                                                "example_id": "ce1616dc-016d-44ce-8772-c81250b12f80",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "Welche natürlichen, biologischen Stoffe können anstelle des Schwermetalls [Kupfer] den Schorf an Äpfeln, den Mehltau an Weintrauben und die Fäule an Kartoffeln und Tomaten verhindern?"
                                            },
                                            {
                                                "example_id": "92265202-f8ea-4c8e-843f-3a5ac0f14f79",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "„Der Tau kommt abends früher und bleibt morgens länger“, sagt [der US-amerikanische Klimatologe Gene] Takle. „Dadurch haben Schädlinge, Pilze, Fäule und Toxine deutlich bessere Bedingungen“."
                                            },
                                            {
                                                "example_id": "eb6ab10b-9b50-42f0-8542-fb5d368f187c",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "[…] wann gehen die Samen auf? Gehen sie überhaupt auf? Oder werden Fäule und Schimmel sie holen? Um dies zu verhindern lüfte ich den Wintergarten, hebe die Folien, mit denen die Schalen bedeckt sind und am granitenen Boden läuft ein dort stehender Ventilator."
                                            },
                                            {
                                                "example_id": "07f50331-568c-424c-9002-cbeb5d160f11",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "[…] 1845 bis 1848 war die große Hungernot in Irland, wo die Kartoffelernte durch eine Fäule zerstört wurde […]."
                                            },
                                            {
                                                "example_id": "3a8f6447-6853-4ffe-95cb-f218fee50bbb",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "Immer noch ungelöst ist hingegen das Problem Phytophtora infestans, Schrecken aller Kartoffelanbauer, auch der aus der Ökoszene: ein Pilz, der Pflanze und Knollen zur Fäule bringt."
                                            },
                                            {
                                                "example_id": "1d46a3e1-edc6-434b-b274-21b9b782757a",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "Die Blumenweichfäule des Blumenkohls (Cauliflower Curd Rot) stellt ein zweifaches Problem das. Erstens sind Blumen mit Fäule nicht vermarktbar, jeder Anteil an Blumen mit Fäule im Bestand mindert die Aberntequote, bzw. schränkt bei Selbstversorgungsanbau die Nutzbarkeit erheblich ein. Zweitens wird der Samenbau durch die Fäule der Blumen erschwert bis verunmöglicht (Molter et al., 2009: 98) […]."
                                            },
                                            {
                                                "example_id": "0ada3d26-833e-48c1-a6e3-f1e8685ea5dd",
                                                "sense_id": "701ab387-39cb-30e0-9795-33a0db943841",
                                                "text": "„[…] ganz schlimm ist Mannheim, dort gibt es etwa 5000 Platanen, von denen sind mindestens die Hälfte schon betroffen. Das Holz bekommt eine Fäule in einer Geschwindigkeit, wir sprechen mittlerweile da von einer sogenannten Turbofäule, dass man innerhalb weniger Monate diesen Baum absägen muss oder es kommt zum Bruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "314e83cb-4435-4d8d-8180-770b7a147e54",
