                                    {
                                        "sense_id": "e4569e7c-607f-333f-af6f-e292335c9834",
                                        "entry_id": "ca5af92f-62ae-30cf-857b-79c7dbb49730",
                                        "glosses": [
                                            "předmět vzniklý zahnutím drátu či obdobného materiálu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5683e68-664c-49d7-87b4-32c181e64770",
                                                "sense_id": "e4569e7c-607f-333f-af6f-e292335c9834",
                                                "text": "Zadní vrátka do zahrady nebyla zamčená, jen zajištěná háčkem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24907641-201c-3834-94c9-8c44de72576b",
                                        "entry_id": "ca5af92f-62ae-30cf-857b-79c7dbb49730",
                                        "glosses": [
                                            "háček (1) používaný při rybaření pro lov ryb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "975f1f7a-43d5-4a49-9a8c-a4f0a53d51d8",
                                                "sense_id": "24907641-201c-3834-94c9-8c44de72576b",
                                                "text": "Rybář napíchl na háček žížalu a nadhodil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97a23a7e-8813-309d-8ddf-00ded8645ae0",
                                        "entry_id": "ca5af92f-62ae-30cf-857b-79c7dbb49730",
                                        "glosses": [
                                            "diakritické znaménko ve tvaru malého písmene v"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9906fed-b710-4a7e-a2f8-46878ef1acea",
                                                "sense_id": "97a23a7e-8813-309d-8ddf-00ded8645ae0",
                                                "text": "Háček se v češtině vyvinul z tečky nad měkkými souhláskami, která nahradila starší řešení – spřežky."
                                            },
                                            {
                                                "example_id": "84431e00-375e-4f80-821f-7adacb53151f",
                                                "sense_id": "97a23a7e-8813-309d-8ddf-00ded8645ae0",
                                                "text": "Háček má dvě různé grafické podoby: obvykle má klínový tvar a je umístěný přímo nad písmenem (ˇ), ale u písmen ď, ť se zapisuje jinak – vypadá téměř jako apostrof připojený k písmenu z pravé strany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c5807b-2d6e-3201-a06c-fb3e5d8e89fa",
                                        "entry_id": "ca5af92f-62ae-30cf-857b-79c7dbb49730",
                                        "glosses": [
                                            "problém; okolnost ztěžující situaci"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3574821-0aa1-451e-aff0-bd0c6c72b25a",
                                                "sense_id": "c1c5807b-2d6e-3201-a06c-fb3e5d8e89fa",
                                                "text": "Ten nápad zajet za nimi na návštěvu je dobrý, což o to, ale má (to) jeden háček: rozbilo se nám auto."
                                            },
                                            {
