        "fr-extract.jsonl": [
            {
                "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                "word": "euphonie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b358a94-1614-4781-92bf-fcf0cb251032",
                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "tags": [
                            "plural"
                        ],
                        "form": "euphonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "glosses": [
                            "Ce qui rend la prononciation plus douce et plus coulante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c241ab6-baa8-46fc-bbe4-64a97aca52e8",
                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                "text": "Admettre, ainsi que le veulent certains volapükistes, qu'il y a des principes d’euphonie ou d’harmonie, qui doivent guider l'élèves dans le choix des tournures ou dans la construction des phrases, ce serait oublier qu’Orientaux et Occidentaux établissent l’euphonie grammaticale sur des bases complétement différentes, et confier les destinées de la langue aux caprices des esprits irréfléchis."
                            },
                            {
                                "example_id": "83bb2be7-ec31-4b58-a2a0-11bf225ac7da",
                                "sense_id": "92e29a2c-db09-387b-bb78-da1e17479782",
                                "text": "Sensible à la seule euphonie, leur maître les nommait Black et Bianca."
                            }
                        ]
                    },
                    {
                        "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                        "entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "glosses": [
                            "Harmonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc7ce2c-ca12-4356-9f7f-86cde8c9087d",
                                "sense_id": "21dfa19d-7fc5-3cd6-9a51-e02aad63301c",
                                "text": "Quel plaisir de se retremper dans l’euphonie multisonore des cordes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c73ad29-0639-4c5f-950b-cebba04195a2",
                        "source_entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "target_lang_word": "Wohlklang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlklang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                        "entry_id": "8ea1dd2f-e254-36a0-a540-0c9aa1764ebb",
                                        "glosses": [
                                            "Klang oder Ton, der als angenehm empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6f89ef-5381-4451-8ff3-240269f2a273",
                                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                                "text": "Ich telefoniere gerne mit der Sekretärin meines Onkologen, denn ihre Stimme ist ein wahrer Wohlklang."
                                            },
                                            {
                                                "example_id": "6cf139e9-c8a4-4ec3-bd9d-b3df49f969ae",
                                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                                "text": "„Die Instrumentation des Streichquartetts ist übrigens in Beziehung auf den Wohlklang am leichtesten mit zu erwerben, wegen der Klangverwandtschaft dieser Instrumente[.]“"
                                            },
                                            {
                                                "example_id": "579be139-828f-45f4-b315-659849545f91",
                                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                                "text": "„Er entdeckte, in unserer Sprechweise, daß Wohlklang und Mißklang eines Akkords davon abhängen, in welchem Verhältnis die Schwingungszahlen der Töne zueinander stehen.“"
                                            },
                                            {
                                                "example_id": "0766b7d7-8113-4f03-b778-a598ac831d28",
                                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                                "text": "„Mittels der Funktionswerte können dann Intervalle hinsichtlich ihres Wohlklangs verglichen werden: je kleiner der Funktionswert, desto ausgeprägter der Wohlklang.“"
                                            },
                                            {
                                                "example_id": "caccef05-b97c-4c9e-ad35-d162b09a3537",
                                                "sense_id": "af4d9e15-9e2b-3ee8-984d-bac286a032f3",
                                                "text": "„Noch gab es nur reinen Wohlklang, die drei Os rollten wie die Bassstimmen eines Männerchors.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e3d9fa7-a3a4-474c-acfb-475df38690b7",
                        "source_entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "target_lang_word": "Wohllaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohllaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                        "entry_id": "b332a7d6-9981-3a56-8b9b-a12b1659c6c0",
                                        "glosses": [
                                            "guter, angenehmer Klang/Ton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02abf06b-32ab-49ab-9c49-73ed5ef950a5",
                                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                                "text": "„Dann sah er sie auf der Bühne stehen, ruhig, ihres Erfolges sicher, und es war ihm, als vernähme er den Wohllaut ihrer Stimme.“"
                                            },
                                            {
                                                "example_id": "6eb3da93-5778-4fff-927a-0d9c48d34c96",
                                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                                "text": "„Mit anderen Worten: Anita Cerquetti hatte eine Stradivari in der Kehle, die beglückenden Wohllaut verströmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66734974-2eb2-4d42-b488-96dd5ae16aec",
                        "source_entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
                        "target_lang_word": "euphony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44e85da0-6083-396d-99c6-3f5b3d122de8",
                                        "entry_id": "61862f8a-5fd3-3a12-896d-0cab4e6498e5",
                                        "glosses": [
                                            "A pronunciation of letters and syllables which is pleasing to the ear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1537b41c-5435-448f-af2f-d03693e74891",
                                                "sense_id": "44e85da0-6083-396d-99c6-3f5b3d122de8",
                                                "text": "Mandalay. In the name there was a euphony which beckoned to the imagination, yet this was the bitter, withered reality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74e0b5c-9519-3386-ba85-cbd601c2c2ba",
                                        "entry_id": "61862f8a-5fd3-3a12-896d-0cab4e6498e5",
                                        "glosses": [
                                            "Pleasant phonetic quality of certain words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3711a58b-e94e-4396-b9df-76d40b8475f0",
                                                "sense_id": "f74e0b5c-9519-3386-ba85-cbd601c2c2ba",
                                                "text": "When I hear you speak, I hear beautiful euphony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cfe4484-2b45-45d4-b0a0-0207b677569b",
                        "source_entry_id": "029fb9c8-a0e0-3a7c-b8a4-068f3628d188",
