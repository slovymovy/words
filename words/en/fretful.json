    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "040524aa-95a9-35b1-8f58-ded00bff90a0",
                    "sense_definition": "Restless, anxious, and unable to relax.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agitated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sick child spent a <w>fretful</w> night tossing and turning in bed.",
                            "target_lang_translations": {
                                "ru": "Больной ребёнок провёл <w>беспокойную</w> ночь, ворочаясь в постели."
                            }
                        },
                        {
                            "text": "Passengers grew increasingly <w>fretful</w> as the flight delay stretched on for hours.",
                            "target_lang_translations": {
                                "ru": "Пассажиры становились всё более <w>раздражёнными и беспокойными</w>, так как задержка рейса затянулась на несколько часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "restless",
                        "worried",
                        "fidgety"
                    ],
                    "antonyms": [
                        "calm",
                        "patient"
                    ],
                    "common_phrases": [
                        "fretful night",
                        "fretful sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойный, тревожный и неспособный расслабиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойный",
                                "target_lang_sense_clarification": "тревожный, мятущийся"
                            },
                            {
                                "target_lang_word": "неугомонный",
                                "target_lang_sense_clarification": "не могущий усидеть на месте"
                            },
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "испытывающий волнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcd22b77-04e7-3fc5-a707-0099dc80a2ff",
                    "sense_definition": "Easily irritated or annoyed; bad-tempered and peevish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agitated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of sleep always made the toddler whine in a <w>fretful</w> voice.",
                            "target_lang_translations": {
                                "ru": "Из-за недосыпа малыш всегда ныл <w>капризным</w> голосом."
                            }
                        },
                        {
                            "text": "He answered the urgent telephone call with a <w>fretful</w> sigh.",
                            "target_lang_translations": {
                                "ru": "Он ответил на срочный телефонный звонок с <w>раздражённым</w> вздохом."
                            }
                        }
                    ],
                    "synonyms": [
                        "peevish",
                        "irritable",
                        "petulant",
                        "fractious"
                    ],
                    "antonyms": [
                        "contented",
                        "forbearing",
                        "uncomplaining"
                    ],
                    "common_phrases": [
                        "fretful whine",
                        "fretful tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко раздражающийся, капризный или ворчливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "недовольный, плаксивый (о детях, тоне)"
                            },
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "легко выходящий из себя"
                            },
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "выражающий недовольство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}