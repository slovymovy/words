                "senses": [
                    {
                        "sense_id": "c7f47a26-616f-38ac-951e-564741de03b7",
                        "entry_id": "d6ccafac-8d95-3ab0-bc3b-9b1819210e3b",
                        "glosses": [
                            "Permettre à un site web de s'adapter automatiquement à la taille disponible sur l’écran ou la fenêtre de façon intelligente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad86b76a-e741-4f41-9322-80fcad75df7f",
                                "sense_id": "c7f47a26-616f-38ac-951e-564741de03b7",
                                "text": "J’ai ensuite présenté la stratégie « responsive web design au chausse pied » ou retrofitting qui permet de « responsiviser » un site à moindre coût à partir d’un site desktop."
                            },
                            {
                                "example_id": "c3871a27-c32e-4656-a803-d721d6eb5be6",
                                "sense_id": "c7f47a26-616f-38ac-951e-564741de03b7",
                                "text": "Pour mon site, je me suis retroussé les manches en me préparant à des heures de combat pour le responsiviser, et finalement c’était fait en six lignes."
                            },
                            {
                                "example_id": "15886e34-7fd0-4107-8e75-268ac05f250e",
                                "sense_id": "c7f47a26-616f-38ac-951e-564741de03b7",
                                "text": "Effectivement l’utilisation des stats sur un site non commercial est relativement limitée : tendances générales et agents utilisateurs (le fait de constater que j’avais entre 15 et 20% de visites via mobiles sur certains sites m’a poussé à les \"responsiviser\")."
                            }
                        ]
                    }
