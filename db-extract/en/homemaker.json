                        "form": "homemakers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b49dc693-3323-3fa8-a478-739ffefdd3bf",
                        "entry_id": "c3daabb6-de8c-3109-b323-cf89404de0f4",
                        "glosses": [
                            "A person who maintains the administration and upkeep of his or her residence, especially one who is not employed outside the home; one who runs the household."
                        ],
                        "tags": [
                            "Australia",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "94ba6fe0-6dca-4e2f-a9b4-a8bb9cf7ed4f",
                                "sense_id": "b49dc693-3323-3fa8-a478-739ffefdd3bf",
                                "text": "Forty-seven-year-old homemaker and volunteer museum guide, holder of a master's degree in English, married twenty-three years to a professor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6303747-abf5-44af-9c04-a46a9f7f2229",
                        "source_entry_id": "c3daabb6-de8c-3109-b323-cf89404de0f4",
                        "source_sense_id": "b49dc693-3323-3fa8-a478-739ffefdd3bf",
                        "source_sense_description": "person who maintains his or her residence",
                        "target_lang_word": "homme au foyer",
