                        "entry_id": "7de5e420-cd08-3727-b1fb-ef39739c14f0",
                        "glosses": [
                            "spezielle Einbauten in Fahrzeugen, die die Insassen im Fall eines Überschlags schützen sollen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d3c9164-4f32-4639-957c-f3051093eb47",
                                "sense_id": "93f06e1f-103a-3e99-b641-62ae0563b67f",
                                "text": "Der Überrollbügel schützt die Insassen des Fahrzeugs, wenn sich das Fahrzeug überschlägt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11433a4d-5a04-476b-83c3-b7aea17f2a51",
                        "source_entry_id": "7de5e420-cd08-3727-b1fb-ef39739c14f0",
                        "source_sense_id": "93f06e1f-103a-3e99-b641-62ae0563b67f",
                        "target_lang_word": "roll bar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roll bar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5e9b8d-da1b-384f-84a3-b02074d66add",
                                        "entry_id": "d8750120-baff-32bb-a4c2-1f063c4b2cb4",
                                        "glosses": [
                                            "A strong U-shaped bar fastened to the frame of a vehicle, such as an off-road vehicle or a race car to protect the driver and passengers from being crushed in the event that the vehicle rolls over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca8dc4a-fd72-4026-ba4f-f0930e7b4002",
                                                "sense_id": "fa5e9b8d-da1b-384f-84a3-b02074d66add",
                                                "text": "Once the two left wheels departed the surface, Travis knew he was in for trouble. Since there wasn't a roll bar on the SUV, the roof was probably going to collapse on his head when it contacted the asphalt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f47290e8-603f-30e7-8f23-9a7802b07c75",
                                        "entry_id": "d8750120-baff-32bb-a4c2-1f063c4b2cb4",
                                        "glosses": [
                                            "An anti-roll bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98230b70-3811-4ce8-95ab-d09bc08cdaf5",
                                                "sense_id": "f47290e8-603f-30e7-8f23-9a7802b07c75",
                                                "text": "The roll bar is a metal bar linking one side of the suspension to the other. It limits how much the car rolls during cornering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
