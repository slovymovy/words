                        "entry_id": "af40e338-15ae-3cec-a9c7-ff7f7523f8cd",
                        "glosses": [
                            "Unité de mesure de puissance du Système international (SI), valant 10⁶ watts, et dont le symbole est MW."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "eca10dbc-df7c-458f-964d-7dceb04ac5a2",
                                "sense_id": "d3793863-767a-3fbd-9eba-2d46540e2774",
                                "text": "La centrale Manic 1 a une puissance de 184 mégawatts."
                            },
                            {
                                "example_id": "dbab5e11-fe8c-4ecf-a210-66569bf5f69c",
                                "sense_id": "d3793863-767a-3fbd-9eba-2d46540e2774",
                                "text": "La Cour des comptes a évalué le coût de sa construction à 836 000 euros le mégawatt en 2010, soit 942 000 euros en valeur 2021."
                            }
                        ]
                    }
                ],
