        "fr-extract.jsonl": [
            {
                "entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
                "word": "immunosuppression",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61578f97-0513-4aa0-a489-aa1d40847a64",
                        "entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
                        "tags": [
                            "plural"
                        ],
                        "form": "immunosuppressions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                        "entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
                        "glosses": [
                            "Inhibition, pathologique ou volontaire et thérapeutique, de l’activation du système immunitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af36e72-1b3e-4b13-ac2e-94125ec2b4f6",
                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                "text": "Le suivi de l’immunosuppression et le monitoring du rejet sont donc des éléments centraux du succès d’une greffe cardiaque."
                            },
                            {
                                "example_id": "ca5d5189-a900-4db0-b4ee-59b4483869b5",
                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                "text": "En transplantation rénale des progrès considérables ont été réalisés ces dernières années dans la prise en charge de l’immunosuppression, notamment, grâce à l’apparition de nouvelles molécules."
                            },
                            {
                                "example_id": "dbf8a0d1-05b8-4625-857e-5b7c22e69c58",
                                "sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                                "text": "Pour preuve : les personnes prenant un traitement immunosuppresseur (ralentissant le système immunitaire) ou ayant des maladies avec immunosuppression, comme le Sida, ont plus de risques de développer une tumeur que les autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ca63d65-27ab-4c3d-bb24-dcc7e5c2d06f",
                        "source_entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
                        "source_sense_id": "a371d0af-ef54-3c80-95a2-3ce14d41c267",
                        "target_lang_word": "Immunsuppression",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immunsuppression",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "257d83cf-0899-3454-bc88-9e148001370d",
                                        "entry_id": "257f649f-d894-30d6-ab73-7a3c40d1e33e",
                                        "glosses": [
                                            "Vorgang, der immunologische Prozesse unterdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1d52b4-078e-45cb-8c51-759766367173",
                                                "sense_id": "257d83cf-0899-3454-bc88-9e148001370d",
                                                "text": "In der Medizin ist die Immunsuppression erforderlich, wenn unerwünschte Reaktionen des Immunsystems durch Medikamente gehemmt werden sollen."
                                            },
                                            {
                                                "example_id": "641945e5-5026-4cb5-ac34-ecd6c04ffda9",
                                                "sense_id": "257d83cf-0899-3454-bc88-9e148001370d",
                                                "text": "Ziel der Immunsuppression ist es, dass das neue Organ nicht als körperfremd erkannt und bekämpft wird, also eine Abstoßungsreaktion erfolgt."
                                            },
                                            {
                                                "example_id": "c819c4e9-6a27-424c-b422-a2c0fc70fd69",
                                                "sense_id": "257d83cf-0899-3454-bc88-9e148001370d",
                                                "text": "Zu den allgemeinen Risiken einer Immunsuppression gehören eine erhöhte Anfälligkeit gegenüber Infektionen und das erhöhte Risiko von Tumorbildungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e44b59a8-6262-48ce-b5c0-2520a74916e2",
                        "source_entry_id": "6995d069-81f6-31e6-b988-dda0e2f73160",
