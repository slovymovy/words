                    },
                    {
                        "translation_id": "0f64bc97-1ed7-4cae-9907-6c0415282a92",
                        "source_entry_id": "a7d8c852-0d07-3d34-b9fc-b1d6b6cb6e51",
                        "source_sense_id": "fd36da2b-8be7-308a-a5cb-04f43124965e",
                        "target_lang_word": "saleté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saleté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06fd25e6-75e4-3027-ba98-38c44bef9849",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "État de ce qui est sale, malpropre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3356053-ff4e-47e6-b46e-090699746d70",
                                                "sense_id": "06fd25e6-75e4-3027-ba98-38c44bef9849",
                                                "text": "La saleté de ses habits, de son linge, de ses meubles. - La saleté des rues. - Cet homme est d’une saleté dégoûtante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a2704b-cc22-3fbb-abc3-70a395d02b64",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Chose qui est sale par elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361bc1ea-1dec-416b-b9f7-be095ac465dd",
                                                "sense_id": "b1a2704b-cc22-3fbb-abc3-70a395d02b64",
                                                "text": "Il y a ici de la saleté, des saletés, qu’il faut ôter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a10bcd-3994-3909-87fd-998b8e599f39",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Obscénité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9f8cbb-e0cb-45c9-b3e2-e2f30f830513",
                                                "sense_id": "45a10bcd-3994-3909-87fd-998b8e599f39",
                                                "text": "« Ne chantez donc pas ces saletés-là, dis-je familièrement à Marguerite et avec un ton de prière."
                                            },
                                            {
                                                "example_id": "d0fe790a-7ff4-42f3-9947-4171e3f4c5a9",
                                                "sense_id": "45a10bcd-3994-3909-87fd-998b8e599f39",
                                                "text": "La saleté de cette chanson."
                                            },
                                            {
                                                "example_id": "a77cb88f-bef0-48d1-8729-411911d2b8d2",
                                                "sense_id": "45a10bcd-3994-3909-87fd-998b8e599f39",
                                                "text": "La saleté de ce propos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185810c3-1a77-323b-80e9-8d7675dc0939",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Parole, image, comportement, sale et obscène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20015a8d-12a7-451f-ade5-25c09429ce5c",
                                                "sense_id": "185810c3-1a77-323b-80e9-8d7675dc0939",
                                                "text": "Le plus curieux, c'est qu'ils sont presque tous affligés d'un travers, d'un vice, d'un maboulisme périlleux, d'une tare, ou qu'ils ont des histoires intimes, des saletés familiales, tous, les plus respectés, les plus grands, les plus insoupçonnés."
                                            },
                                            {
                                                "example_id": "4c778f2e-e91e-4a54-b1e2-9b0db7f69332",
                                                "sense_id": "185810c3-1a77-323b-80e9-8d7675dc0939",
                                                "text": "Il se plaît à dire des saletés. - Ce livre est plein de saletés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b12497-7cab-3f17-8a03-1c32e77674f1",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Vilenie, méchanceté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30d9bc24-856a-4aef-b39f-a5dd31e7aa23",
                                                "sense_id": "80b12497-7cab-3f17-8a03-1c32e77674f1",
                                                "text": "Armandine.— Ah ! non, ou alors il n’y a rien de fait… parce que tu sais, je ne voulais pas lui faire une saleté."
                                            },
                                            {
                                                "example_id": "611c677b-3cdc-4c76-91ef-192e4d3a4526",
                                                "sense_id": "80b12497-7cab-3f17-8a03-1c32e77674f1",
                                                "text": "« Quoi! lui dit un de ses amis, […], il ne vous salue pas? — Il m'a fait une saleté, il ne me la pardonne pas... Ce n'était pas d'ailleurs la première."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea05a86a-f9bd-38d3-a8ce-b3b1f03c6223",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Chose qui ne vaut rien, qui n’a pas de valeur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55418c8d-27a9-4031-872a-86db80d76732",
                                                "sense_id": "ea05a86a-f9bd-38d3-a8ce-b3b1f03c6223",
                                                "text": "Ce magasin ne vend que de la saleté."
                                            },
                                            {
                                                "example_id": "3c0f9e18-7d73-4757-a7b4-e95fa9fa22db",
                                                "sense_id": "ea05a86a-f9bd-38d3-a8ce-b3b1f03c6223",
                                                "text": "Si l’enfant n’est pas au bout, l’amour n’est qu’une saleté inutile…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf21f80-ae43-31ab-9433-f6556969bc2a",
                                        "entry_id": "c55147ec-230f-3fd6-98cd-9dc4211bf5d5",
                                        "glosses": [
                                            "Ordure, personne méprisable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886040e1-d30f-4c0a-87f7-554e34f6ee20",
                                                "sense_id": "ebf21f80-ae43-31ab-9433-f6556969bc2a",
                                                "text": "Saleté de gosse ! Saleté, va ! Ah ! la saleté d'homme ! cria-t-elle"
                                            },
                                            {
                                                "example_id": "d0b04956-e727-498d-a0be-c756b39b6cfb",
                                                "sense_id": "ebf21f80-ae43-31ab-9433-f6556969bc2a",
                                                "text": "Cette idée, née sans doute d’une suggestion de commère malveillante, avait grandi en elle au cours de ses longues réflexions solitaires ; le soupçon s’était changé en certitude : elle considérait mes frères comme des garnements et ma belle-sœur Claudine comme une saleté. Elle répétait à satiété ces mots-là :\n— Les garnements ! la saleté !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
