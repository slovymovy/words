                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f2d7435-7f79-35fc-8802-3c06e37c67f5",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "A state in which opposing forces harmonise; equilibrium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0769ccc-f47e-4941-b125-94c56b8f3039",
                                                "sense_id": "9f2d7435-7f79-35fc-8802-3c06e37c67f5",
                                                "text": "But civilized man is quite a different animal, and when he wipes out an entire city or levels a forest, he is no longer working within the natural balance of things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a15e49b-15f6-323c-89d4-3afd7acb6592",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "Mental equilibrium; mental health; calmness, a state of remaining clear-headed and unperturbed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1351de95-6103-3c54-ac04-c071c5f36180",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "Something of equal weight used to provide equilibrium; counterweight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e394e56-66cb-4e07-8ca9-afb667d0087c",
                                                "sense_id": "1351de95-6103-3c54-ac04-c071c5f36180",
                                                "text": "These weights are used as a balance for the overhanging verandah."
                                            },
                                            {
                                                "example_id": "b4d14f35-7e57-460c-9c31-532446640b6f",
                                                "sense_id": "1351de95-6103-3c54-ac04-c071c5f36180",
                                                "text": "Blair thought he could provide a useful balance to Bush's policies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b464b0-bda3-30d2-9f49-5aac5efccfd5",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "A pair of scales."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af0f5171-fa13-3cef-abd0-603094665fa0",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "Awareness of both viewpoints or matters; neutrality; rationality; objectivity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87087b9d-b69a-3660-9e15-7dc825d74279",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "The overall result of conflicting forces, opinions etc.; the influence which ultimately \\\"weighs\\\" more than others."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195b8008-4b4f-416e-92d4-05dd9f17be39",
                                                "sense_id": "87087b9d-b69a-3660-9e15-7dc825d74279",
                                                "text": "The balance of power finally lay with the Royalist forces."
                                            },
                                            {
                                                "example_id": "b83f8f28-0d8a-4d6c-abf6-93dda7399c13",
                                                "sense_id": "87087b9d-b69a-3660-9e15-7dc825d74279",
                                                "text": "I think the balance of opinion is that we should get out while we're ahead."
                                            },
                                            {
                                                "example_id": "bff4a734-42fc-41a8-8dac-523ecf26bfa1",
                                                "sense_id": "87087b9d-b69a-3660-9e15-7dc825d74279",
                                                "text": "The shift in the balance of power online has allowed anyone to publish to the world, from dispirited teenagers in south London to an anonymous cyber-dissident in a Middle East autocracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b12ea117-3acd-36c6-8d5b-53bbf55aacdc",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "Apparent harmony in art (between differing colours, sounds, etc.)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "388aa784-e681-3df3-974a-aaf2de0a907d",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "A list accounting for the debits on one side, and for the credits on the other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac3968f-bd78-3ef9-aa66-38bef823ba83",
                                        "entry_id": "bc217263-9fbb-3afb-9aa2-accb12d79111",
                                        "glosses": [
                                            "The result of such a procedure; the difference between credit and debit of an account."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07243c5-539e-43dc-9dbb-119172dc2540",
                                                "sense_id": "6ac3968f-bd78-3ef9-aa66-38bef823ba83",
                                                "text": "I just need to nip to a bank and check my balance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6d977f-19be-33c9-8044-a698c84e2f89",
