{
    "word_family": [
        "nuisances"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                    "sense_definition": "A minor annoyance or inconvenience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The barking dog is a real <w>nuisance</w> during the night.",
                            "target_lang_translations": {
                                "ru": "Лающая собака — это настоящая <w>помеха</w> по ночам."
                            }
                        },
                        {
                            "text": "It is a <w>nuisance</w> to have to wait in line for so long.",
                            "target_lang_translations": {
                                "ru": "Это такое <w>неудобство</w> — ждать в очереди так долго."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyance",
                        "inconvenience",
                        "irritation"
                    ],
                    "antonyms": [
                        "enjoyment"
                    ],
                    "common_phrases": [
                        "real nuisance",
                        "minor nuisance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое раздражение или неудобство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудо́бство",
                                "target_lang_sense_clarification": "ситуация, вызывающая дискомфорт"
                            },
                            {
                                "target_lang_word": "поме́ха",
                                "target_lang_sense_clarification": "то, что мешает или затрудняет действие"
                            },
                            {
                                "target_lang_word": "неприя́тность",
                                "target_lang_sense_clarification": "нежелательное, досадное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e889ce-7cc1-3dcb-8c0e-ccd0a3aa3aaa",
                    "sense_definition": "A person or thing causing annoyance or inconvenience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop being such a <w>nuisance</w> and let me finish my work.",
                            "target_lang_translations": {
                                "ru": "Перестань быть такой <w>занозой</w> и дай мне закончить работу."
                            }
                        },
                        {
                            "text": "He was making a <w>nuisance</w> of himself at the party.",
                            "target_lang_translations": {
                                "ru": "Он вел себя на вечеринке как <w>докучливый человек</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "pest",
                        "trouble"
                    ],
                    "common_phrases": [
                        "making a nuisance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые вызывают раздражение или неудобство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зано́за",
                                "target_lang_sense_clarification": "переносное значение: человек, который постоянно докучает"
                            },
                            {
                                "target_lang_word": "докучли́вый челове́к",
                                "target_lang_sense_clarification": "назойливый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa4cf19-c195-3419-832a-d63475b99119",
                    "sense_definition": "Anything harmful or offensive to the community for which a legal remedy exists.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory was sued for creating a public <w>nuisance</w> due to the noise.",
                            "target_lang_translations": {
                                "ru": "На завод подали в суд за создание <w>общественного нарушения</w> из-за шума."
                            }
                        },
                        {
                            "text": "The city council took action against the <w>nuisance</w> affecting the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Городской совет принял меры против <w>источника вреда</w>, беспокоящего район."
                            }
                        }
                    ],
                    "common_phrases": [
                        "public nuisance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или объект, наносящие вред обществу, за которые предусмотрена юридическая ответственность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обще́ственное наруше́ние",
                                "target_lang_sense_clarification": "правовой термин для действий, мешающих обществу"
                            },
                            {
                                "target_lang_word": "исто́чник вре́да",
                                "target_lang_sense_clarification": "объект, создающий угрозу или неудобства для окружающих"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}