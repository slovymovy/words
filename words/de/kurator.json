    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca493b6c-943b-3e27-9e23-06f04c51e14f",
                    "sense_definition": "Person, die für die Organisation, Gestaltung und Betreuung einer Ausstellung oder Sammlung verantwortlich ist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kultur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Kurator</w> sprach mit dem Museumsdirektor über die Schwerpunkte der kommenden Ausstellung."
                        },
                        {
                            "text": "Als leitender <w>Kurator</w> wählt er alle Kunstwerke für die Galerie sorgfältig aus."
                        }
                    ],
                    "synonyms": [
                        "Kustos"
                    ],
                    "common_phrases": [
                        "leitender Kurator",
                        "Kurator der Ausstellung"
                    ]
                },
                {
                    "sense_id": "d6d6db78-6a22-3b7a-b039-309603e32c19",
                    "sense_definition": "Verwalter einer Stiftung oder beauftragte Aufsichtsperson im Bildungswesen, besonders an Universitäten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwaltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Kurator</w> der Stiftung hat die Stipendiaten für das kommende Studienjahr ausgewählt."
                        },
                        {
                            "text": "An dieser Universität überwacht der <w>Kurator</w> die Einhaltung der wirtschaftlichen Vorgaben."
                        }
                    ],
                    "synonyms": [
                        "Aufsichtsbeamter",
                        "Verwalter"
                    ],
                    "common_phrases": [
                        "Kurator der Stiftung"
                    ]
                },
                {
                    "sense_id": "4a88f45e-c6c3-3f78-bd78-f265a9a8b181",
                    "sense_definition": "Gerichtlich oder behördlich bestellte Person, die als Vormund oder Pfleger die rechtliche Fürsorge übernimmt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für das elternlose Kind wurde vom Gericht ein gesetzlicher <w>Kurator</w> bestimmt."
                        },
                        {
                            "text": "Der eingesetzte <w>Kurator</w> kümmerte sich gewissenhaft um das Vermögen des Minderjährigen."
                        }
                    ],
                    "synonyms": [
                        "Pfleger",
                        "Vormund"
                    ]
                },
                {
                    "sense_id": "78e779b1-1cbd-3390-a05f-cfb6da3c9672",
                    "sense_definition": "Vom Gericht bestellter Sachwalter oder Treuhänder, der Rechte und Interessen wahrnimmt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn in Österreich jemand ohne bekannte Erben stirbt, wird oft ein <w>Kurator</w> eingesetzt."
                        },
                        {
                            "text": "Das Gericht ernannte einen unparteiischen <w>Kurator</w> zur vorübergehenden Verwaltung des strittigen Nachlasses."
                        }
                    ],
                    "synonyms": [
                        "Bevollmächtigter",
                        "Treuhänder"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "besonders in Österreich"
                        }
                    ]
                }
            ]
        }
    ]
}