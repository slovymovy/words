                        "glosses": [
                            "Pertaining to Noah or his time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "733f2795-142b-4d6e-80a1-456393e9e8bf",
                                "sense_id": "f1bc32f2-93f8-3de9-bdb8-027ad147897a",
                                "text": "At the next meeting he was back on a geological topic illustrated by maps, diagrams and specimens, and the following year he spoke on \"The Noachian Deluge, universal with regard to man, but very restricted with regard to the earth\"[.]"
                            },
                            {
                                "example_id": "b3f1b335-faca-408c-bffa-abe0e1d79053",
                                "sense_id": "f1bc32f2-93f8-3de9-bdb8-027ad147897a",
                                "text": "The victims of the Noachian flood would add another 20 million or so to the total."
                            },
                            {
                                "example_id": "4e021cb0-c881-4afc-b2a2-32326c1f6ac4",
                                "sense_id": "f1bc32f2-93f8-3de9-bdb8-027ad147897a",
                                "text": "At the time of my visit, EVACC was down to just one Rabbs' Frog, so the possibility of saving even a single, Noachian pair had obviously passed."
                            }
                        ]
                    }
                ],
