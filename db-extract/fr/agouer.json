                "senses": [
                    {
                        "sense_id": "6b94b825-7cd6-3f51-ae06-da8f681ab990",
                        "entry_id": "f09cdbac-df0d-3f8a-990f-6e6ffb50e902",
                        "glosses": [
                            "Nourrir jusqu’à l’écœurement."
                        ],
                        "tags": [
                            "Berry",
                            "Centre"
                        ],
                        "examples": [
                            {
                                "example_id": "50cee3ac-6b71-4cfb-90fc-0cf63ecc0a6c",
                                "sense_id": "6b94b825-7cd6-3f51-ae06-da8f681ab990",
                                "text": "[…]ceux qui mangent trop souvent la même chose déclarent, par exemple, «j’en sée agoué d’ tes pois rouges »."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed70d23-fdc4-37f2-a348-f8ffbfc0be3e",
                        "entry_id": "f09cdbac-df0d-3f8a-990f-6e6ffb50e902",
                        "glosses": [
                            "Insupporter."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6f4f6dfd-2dc8-48d1-8b58-8e6f64b0c516",
                                "sense_id": "6ed70d23-fdc4-37f2-a348-f8ffbfc0be3e",
                                "text": "«Quand on est las d'une chose, on en est agoué. La grand-mère qui reçoit ses petits-enfants (ses agouants) en est vite agouée ;…."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7aec9f9-2dd7-3f5d-a4eb-cd29c5c7d6f0",
                        "entry_id": "f09cdbac-df0d-3f8a-990f-6e6ffb50e902",
                        "glosses": [
                            "S’étouffer, s’étrangler avec de la nourriture ou de la boisson."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "48dbfb4d-903c-4ebd-bd6c-a8dc8397b683",
                                "sense_id": "f7aec9f9-2dd7-3f5d-a4eb-cd29c5c7d6f0",
                                "text": "…entre comme un voleur, descend à la cave, lampe un pot (oh ! le bon !), un deuxième, si vite qu’il manque de s’agouer,…."
                            }
                        ]
                    }
                ],
