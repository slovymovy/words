                ],
                "senses": [
                    {
                        "sense_id": "8a16fb6c-e1ec-3287-9512-5991f403e7ee",
                        "entry_id": "b7c72654-7d31-3549-829d-53ed4dbc36ad",
                        "glosses": [
                            "Volumen eines Mediums (fest, flüssig, gasförmig), das sich in einer Zeiteinheit durch einen Querschnitt bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88bb3ec-209f-40db-b9d2-5340094422bb",
                                "sense_id": "8a16fb6c-e1ec-3287-9512-5991f403e7ee",
                                "text": "„Die Kontinuitätsgleichung für den Volumenstrom besagt, dass ein Volumenstrom in einer Leitung immer konstant ist. Dies ändert sich auch nicht, wenn sich der Querschnitt der Leitung verändert.“"
                            },
                            {
                                "example_id": "f80016f6-22e0-4829-a921-fe5a37c4b184",
                                "sense_id": "8a16fb6c-e1ec-3287-9512-5991f403e7ee",
                                "text": "„Mit Hilfe der Reynolds-Zahl Re, eine der wichtigsten strömungsmechanischen Kenngrößen, können wir bei gegebenem Volumenstrom feststellen, ob die Rohrströmung laminar oder turbulent ist.“"
                            },
                            {
                                "example_id": "7fef51f1-9362-4fdb-892b-6a8fc01d73aa",
                                "sense_id": "8a16fb6c-e1ec-3287-9512-5991f403e7ee",
                                "text": "„Der Volumenstrom ist ein pro Zeiteinheit fließendes Volumen. Übliche Masseinheit ist m³/h.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
