                "senses": [
                    {
                        "sense_id": "9b4176fe-a173-31ff-8128-b95eed1fbeb0",
                        "entry_id": "bf7c9e0d-34d8-3178-a7a1-675587eeb82f",
                        "glosses": [
                            "afrikanische Art der Wildhunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f79c79c-2433-4ece-961b-4e3dec88dc05",
                                "sense_id": "9b4176fe-a173-31ff-8128-b95eed1fbeb0",
                                "text": "„In der afrikanischen Savanne lebt der Schabrackenschakal (Canis mesomelas), in Afrika südlich der Sahara der Streifenschakal (Canis adustus). Goldschakale hingegen kommen im Nahen Osten, in Indien und in weiteren Regionen Asiens vor.“"
                            },
                            {
                                "example_id": "bd71d65b-a2b5-4a4c-93fb-ef3bc82c4616",
                                "sense_id": "9b4176fe-a173-31ff-8128-b95eed1fbeb0",
                                "text": "„Hervorragender Eckzahngesundheit erfreuten sich zu Lebzeiten auch die untersuchten Exemplare von Streifenschakal und Afrikanischem Goldwolf, recht gut sah es zudem beim Afrikanischen Wildhund und beim Schabrackenschakal aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
