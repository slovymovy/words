                                        "entry_id": "ad113291-b5ac-35dd-9e27-676215489d55",
                                        "glosses": [
                                            "nabyta skłonność do mechanicznego wykonywania jakiejś czynności, wynikająca z częstego jej wykonywania, także: sama ta czynność"
                                        ],
                                        "tags": [
                                            "psychology"
