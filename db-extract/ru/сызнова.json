                            {
                                "example_id": "4e839742-59f4-45bf-b7a4-96dbdd7ff779",
                                "sense_id": "681ea857-399d-3754-b8f1-6fcca27ae9fb",
                                "text": "Ры́бникова пои́ли ча́ем, угоща́ли папиро́сами, отвеча́ли на его́ бестолко́вые вопро́сы и поскоре́е сплавля́ли в друго́й отде́л, где всё повторя́лось сы́знова.",
                                "translation": "They poured Rybnikov tea, regaled him with papiroses, answered his gormless questions and dispatched him with all possible haste to some other section, where the whole business was repeated all over again.",
                                "english": "They poured Rybnikov tea, regaled him with papiroses, answered his gormless questions and dispatched him with all possible haste to some other section, where the whole business was repeated all over again."
                            }
                        ]
                    }
                ],
                "translations": [],
