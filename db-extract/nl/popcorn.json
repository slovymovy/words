        "nl-extract.jsonl": [
            {
                "entry_id": "beb1da09-a703-3ae3-944a-7b71c0434b19",
                "word": "popcorn",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2074603c-7d25-3560-a224-7790576d78d2",
                        "entry_id": "beb1da09-a703-3ae3-944a-7b71c0434b19",
                        "glosses": [
                            "een ondersoort Zea mays everta van maïssoorten die speciaal voor het poffen veredeld zijn, het meest wordt Zea mays ssp. mays gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b13cbdf-d7ec-4aa5-a4b3-7f348716a9f0",
                                "sense_id": "2074603c-7d25-3560-a224-7790576d78d2",
                                "text": "Tijdens het bekijken van de film aten we popcorn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "659ed1e4-386f-44f8-8173-32be712accc6",
                        "source_entry_id": "beb1da09-a703-3ae3-944a-7b71c0434b19",
                        "source_sense_id": "2074603c-7d25-3560-a224-7790576d78d2",
                        "target_lang_word": "Popcorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Popcorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                        "entry_id": "eb73ed66-6273-3a1a-942e-5cd147ef0ff9",
                                        "glosses": [
                                            "zum Verzehr durch Erhitzen in heißem Fett unter hohem Druck röstend gedämpfte und nach folgender Aufhebung des Druckes aufgeplatzte, zu lockeren Massen aufgeblähte Maiskörner; gepuffter Mais"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdc0bdf-8da9-43ae-9dcb-76f961d502fa",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "Bringst du mir eine Tüte Popcorn mit?!"
                                            },
                                            {
                                                "example_id": "47791263-6bdb-496e-9280-06f09e359fec",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "Immer wenn ich mir im Kino einen Film ansehe oder einen Videoabend zuhause veranstalte, darf Popcorn nicht fehlen."
                                            },
                                            {
                                                "example_id": "1ee180c6-1d08-44d2-8de6-d4a7f46ce38e",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Mit Kino hat dies alles nur am Rand zu tun, denn ohne das Rascheln von Zellophanverpackungen, ohne den Duft frischer Popcorns, ohne die amüsanten Zwischenrufe vorlauter Besucher und ohne kollektives Gelächter, ist Kino eben kein Erlebnis.“"
                                            },
                                            {
                                                "example_id": "bf0ffb37-e8ec-4a48-8c59-1bb58ddfc4ca",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Sie wissen ja, wer an solchen Kreuzfahrten teilnimmt. Zu 90 Prozent sind es US-Amerikaner, die den ganzen Tag Popcorn und Eis fressen und an Land gehen, um T-Shirts zu kaufen oder ins Kasino zu gehen.“"
                                            },
                                            {
                                                "example_id": "1e6457df-c742-448b-893b-466ea9be0a2d",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Der Charme des Popcorns liegt für die Kinobetreiber in der attraktiven Gewinnmarge.“"
                                            },
                                            {
                                                "example_id": "0d199ca1-17c5-41fc-9cf6-6da9c0323ccb",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Und auch die obligatorischen Popcorns gab es natürlich in der Harry-Potter-Tüte.“"
                                            },
                                            {
                                                "example_id": "fdc96932-9c4f-45b4-b97c-6de3c73d3f15",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Gewonnen hatte jene Gruppe, die am Schluss über dem Feuer am meisten Popcorns zubereiten konnte.“"
                                            },
                                            {
                                                "example_id": "8ca05399-fa83-419a-831d-fe9a24dbda86",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Und schon zerstieben Dutzende von Insekten aller Farben, Grösse und Form in alle Richtungen – wie Popcorns aus der Pfanne.“"
                                            },
                                            {
                                                "example_id": "e50953b4-2d40-4281-bacb-4c5cfd825f9e",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Bei diesem Kinonachmittag kam dank selbst gemachten Popcorns Atmosphäre wie im richtigen Lichtspielhaus auf – wobei schon allein die Popcornmaschine ein Höhepunkt für die Kinder war, die bei jedem ‚Plop‘ noch größere Augen bekamen.“"
                                            },
                                            {
                                                "example_id": "0c07f749-294a-4432-b6f1-728e8d058e3f",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Stundenlang erfinden sie Geschichten für die Tiere, die sie in den einzelnen Popcorns erkennen.“"
                                            },
                                            {
                                                "example_id": "f91d5e4c-dcac-49ec-ba1f-d60f8da185fd",
                                                "sense_id": "7393e2b9-97ba-3bec-982a-b2d1f95a5afe",
                                                "text": "„Wir hatten einfach vergessen, dass es an der Kinokasse kein Schlangestehen geben, dass nach dem Film der Saal nicht wie eine Müllhalde aus Plasticbechern und Popcorn aussehen muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "708b47ee-9826-4951-bfe3-6a7965f01be4",
                        "source_entry_id": "beb1da09-a703-3ae3-944a-7b71c0434b19",
                        "source_sense_id": "2074603c-7d25-3560-a224-7790576d78d2",
                        "target_lang_word": "popcorn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "popcorn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdc50934-80f1-3910-bc1c-c49ecc0b4acd",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A snack food made from corn or maize kernels popped by dry heating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7373c04a-316a-4c42-b2c7-327a676b6b9f",
                                                "sense_id": "cdc50934-80f1-3910-bc1c-c49ecc0b4acd",
                                                "text": "My friends and I ordered popcorn during the interval of the movie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf80f6d-91cb-3fd5-b6e9-87f86a8286b3",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A serving of popcorn."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c62ea7-4902-4b01-8835-d2a7fc44638b",
                                                "sense_id": "8cf80f6d-91cb-3fd5-b6e9-87f86a8286b3",
                                                "text": "Warner Bros has offered the two executives less than dollars 1m as an out-of-court settlement, a sum dismissed by Mr [Pierce] O'Donnell as 'two popcorns and two Cokes'."
                                            },
                                            {
                                                "example_id": "78b5bf2c-71b1-4df1-ba51-3e8d2071525a",
                                                "sense_id": "8cf80f6d-91cb-3fd5-b6e9-87f86a8286b3",
                                                "text": "When we went to Astoria, to see 'Drive Me Crazy,' they gave you one popcorn and the other one was free. I asked her if she wanted to eat mine, but she said there was so much popcorn, she was going to get sick."
                                            },
                                            {
                                                "example_id": "71e73b3b-570d-4dd4-aafd-6c139700af1a",
                                                "sense_id": "8cf80f6d-91cb-3fd5-b6e9-87f86a8286b3",
                                                "text": "Every Wednesday night is Date Night, and for $10 sweethearts can get two tickets, two popcorns and two sodas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A piece of popcorn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d6c845-536e-4820-945e-423a3d86cc1b",
                                                "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                                "text": "Some popcorns silently flicked off like face peelings on his shoe."
                                            },
                                            {
                                                "example_id": "b9bc4278-10ea-4276-a9d1-157d894095b0",
                                                "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                                "text": "Don’t you feel this is nothing but throwing popcorns before a hungry elephant? This is definitely throwing popcorns before the hungry elephant. This is the imbalance that I wanted to pointed out."
                                            },
                                            {
                                                "example_id": "605e3d63-4d8f-4dbb-aac8-7e4e02282a7f",
                                                "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                                "text": "Sarani threw a few popcorns into her mouth."
                                            },
                                            {
                                                "example_id": "9c256725-1be5-402a-bae1-053ba8010f63",
                                                "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                                "text": "The boat lurches through choppy waves with resonating booms, tourists chatter with excitement, and the woman throwing popcorns squeals whenever our seagull guards reappear, ready for the next assault."
                                            },
                                            {
                                                "example_id": "c10f08d2-a446-4d5a-9021-41d7ed993e4f",
                                                "sense_id": "64ba68b5-19c6-3f54-8221-5fd606c13031",
                                                "text": "“Blah, kiss her you fool!” an annoyingly familiar voice yelled from the door as he threw a handful of popcorns at us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38a848b-dc23-375e-b56b-1226b5176adc",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A type of corn or maize with a hard outer hull that, along with the type of starch it contains, makes it suitable for popping."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214dff57-8ea8-31b1-9897-91c9e52f2829",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A kind of stitch similar to a bobble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e57b984-0bf5-431f-8472-e1d81bbe7ed5",
                                                "sense_id": "214dff57-8ea8-31b1-9897-91c9e52f2829",
                                                "text": "From the top the sample shows four stitch popcorns, five stitch bobbles, two rows of bells and a central leaf with leaves sloping to the left and right each side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b00cd6-86ff-305c-a089-54b482668bfa",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "A form of brainstorming in which participants call out their ideas immediately, instead of waiting for an assigned turn to speak."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6652541-dc9e-462c-8e7b-a51e3271fb55",
                                                "sense_id": "f0b00cd6-86ff-305c-a089-54b482668bfa",
                                                "text": "With the \"popcorn\" method, all team members in the session spontaneously call out ideas and a facilitator writes them on a flip chart."
                                            },
                                            {
                                                "example_id": "e1e27fe2-f841-4cac-b743-e43152527335",
                                                "sense_id": "f0b00cd6-86ff-305c-a089-54b482668bfa",
                                                "text": "As a way to begin the discussion about God's will, you might want to ask the group to do some \"popcorn\" brainstorming about the pros and cons of believing that everything that happens is God's will."
                                            },
                                            {
                                                "example_id": "04c0d24e-c13a-4566-aab6-93eacb63a178",
                                                "sense_id": "f0b00cd6-86ff-305c-a089-54b482668bfa",
                                                "text": "Ask: What Twitter-style hashtag characterizes our community? (Use popcorn brainstorming to elicit responses.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63395b8a-9d26-3f8f-b9b2-ccecaac0151f",
                                        "entry_id": "aa355edf-51c1-3848-b144-9b7d2c774797",
                                        "glosses": [
                                            "Entertainment for observers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40512230-01f1-42eb-9269-661c598391ed",
                                                "sense_id": "63395b8a-9d26-3f8f-b9b2-ccecaac0151f",
                                                "text": "And not at all about how a state picks which group of electors to send, which is the whole basis of the NaPoVoInterCo plan, and will yield plenty more Supreme Court popcorn if it ever gets enacted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3a4d0c-e1a3-3f2e-b13c-2ee0b36e08ca",
