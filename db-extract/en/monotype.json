                ],
                "senses": [
                    {
                        "sense_id": "fc30c91c-855a-3284-98e7-42a8c2594019",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "A print made by creating the design using oil paint or printer's ink on metal or glass, then transferring the image directly to paper."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e78fdc11-6875-3beb-9389-1bc55ebdfc72",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "The technique of making such prints."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "76eaaf10-176d-32c4-a562-71ebbef8ba23",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "A monotypic taxon."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c224c572-578d-3276-b9e0-a3a1e585f2f1",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "A keyboard-operated typesetting and casting machine that makes and sets separate characters."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1de6c9f6-0045-3a89-ab79-aecae85e66c1",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "A sailboat designed to be crewed or raced by a single person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "af1a738c-c2fb-31ac-9503-0ecba24190eb",
                        "entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "glosses": [
                            "In the Hindley–Milner type system, a single specific data type."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b97c6c95-35e4-4270-b460-b76c11ae3092",
                        "source_entry_id": "43408006-f82a-3c80-95a8-28b6145594a8",
                        "source_sense_description": "a print of some design created on metal or glass",
                        "target_lang_word": "monotype",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dafc7c9-efba-3cd9-9058-26dabab85821",
                                        "entry_id": "32a25b29-bf50-3b03-82ff-127ae74036b1",
                                        "glosses": [
                                            "Voilier conçu pour que les concurrents aient des chances égales lors de régates."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d648a8db-e136-4586-a898-dcb6843db95e",
                                                "sense_id": "7dafc7c9-efba-3cd9-9058-26dabab85821",
                                                "text": "La création des monotypes officiels dans les voiliers de régate a permis de faire courir ensemble des bateaux construits sur les mêmes plans et dont les succès en courses étaient dus de ce fait seulement aux qualités des équipages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ed2dd3-7e1e-3fb6-8ac4-4d9d344738d0",
                                        "entry_id": "32a25b29-bf50-3b03-82ff-127ae74036b1",
                                        "glosses": [
                                            "Produit de l'estampage d'un support qui est non poreux, en métal, plexiglas, etc., recouvert à l'encre typographique ou aqualaque, à la peinture à l'huile, à la gouache, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d3e9f5-fa77-4399-9d6d-2256b9428cf5",
                                                "sense_id": "99ed2dd3-7e1e-3fb6-8ac4-4d9d344738d0",
                                                "text": "Le monotype ne peut être numéroté, car, comme son nom l'indique, son tirage est unique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monotype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b24e2313-0692-399a-ad66-54f263488688",
                                        "entry_id": "f8905bc3-e3f9-39a4-91e8-be7780d32fe6",
                                        "glosses": [
                                            "Machine de composition d'imprimerie, chainon entre la typographie manuelle et la photocomposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341db514-244f-44c7-9bb7-c4f12c34da6f",
                                                "sense_id": "b24e2313-0692-399a-ad66-54f263488688",
                                                "text": "La monotype a été rapidement dépassée en tant que technique d'impression par les progrès de la photocomposition, mais, dans certains ateliers, elle a survécu jusqu'à l'époque de la PAO."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monotype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0b044d-f70f-333d-a1c0-d451794a0e14",
                                        "entry_id": "2728b5c8-ea97-3fec-9cd4-bd4459bf4eca",
                                        "glosses": [
                                            "Qui ne possède qu’un seul taxon immédiatement subordonné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
