                                "target_senses": [
                                    {
                                        "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                        "entry_id": "f750af24-1b9f-391b-bacc-1a1b741fa738",
                                        "glosses": [
                                            "In secret, covertly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955eb3c7-3628-4239-b56d-95885089fe35",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Mary cheated secretly in the test, and never got caught."
                                            },
                                            {
                                                "example_id": "0700bdb5-d9fa-46ff-b7bd-e8349ca073f2",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Sometimes her prose hyperventilates (\"Once, years ago, his and N.'s love for each other had glowed like phosphorescent fire on the surfaces of their bodies\"), and she has a weakness for epiphanies (\"There was a man, no longer young, though not yet old, who, traveling alone in northern Europe, began to feel that his soul was being drained slowly, almost secretly from him, drop by drop\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d356171b-fccf-48c6-a770-5919a8e90643",
                        "source_entry_id": "996474ed-cf1d-3758-8bb7-fe991b662454",
                        "source_sense_id": "6d03620d-ef9c-3845-adfb-b95de349d7ee",
                        "target_lang_word": "under the rose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "under the rose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e3f3497-23e9-3d39-9491-976a1339bd41",
                                        "entry_id": "116fbdb7-6d41-3926-aa3a-671d17326ff9",
                                        "glosses": [
                                            "In secret; secretly, privately."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247e8fa1-ec54-405c-a237-9675f3884480",
                                                "sense_id": "5e3f3497-23e9-3d39-9491-976a1339bd41",
                                                "text": "‘If you become the purchaser of the East Lynne estate, Mr Carlyle, it must be under the rose.’"
                                            },
                                            {
                                                "example_id": "018c8069-9746-4ebc-8e70-ff7a779bce06",
                                                "sense_id": "5e3f3497-23e9-3d39-9491-976a1339bd41",
                                                "text": "We are organising (but this is quite under the rose as yet) a company for the production of furniture and decoration of all kinds, for the sale of which we are going to open an actual shop!"
                                            }
                                        ]
                                    }
