                                "target_senses": [
                                    {
                                        "sense_id": "0055c0d2-fa7a-3d0c-95ed-d26bae607796",
                                        "entry_id": "10ec988b-2165-3039-9e55-30f5904bc321",
                                        "glosses": [
                                            "Qui a de la règle et de la méthode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c332d9-ecda-439c-910f-59686c14b86e",
                                                "sense_id": "0055c0d2-fa7a-3d0c-95ed-d26bae607796",
                                                "text": "11 mai. — Comme le 10, l'aviation ennemie agit en force dès le matin, s'attaquant de façon plus méthodique aux positions et à leurs abords immédiats."
                                            },
                                            {
                                                "example_id": "bc5bc634-3345-4ab6-b7d1-6f3ed57e7d00",
                                                "sense_id": "0055c0d2-fa7a-3d0c-95ed-d26bae607796",
                                                "text": "Homme, esprit méthodique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b7b157-7866-335a-a7f0-303b2e16051f",
                                        "entry_id": "10ec988b-2165-3039-9e55-30f5904bc321",
                                        "glosses": [
                                            "Qui est fait avec méthode, avec règle, où il y a de la méthode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29312753-f6f8-44bb-9b7f-f82aa72c1c3a",
                                                "sense_id": "85b7b157-7866-335a-a7f0-303b2e16051f",
                                                "text": "Discours, traité méthodique."
                                            },
                                            {
                                                "example_id": "a80c577a-a948-4508-b26e-2a018a26adc4",
                                                "sense_id": "85b7b157-7866-335a-a7f0-303b2e16051f",
                                                "text": "Ordre méthodique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374b85d6-90dd-32e2-9e1b-cccfd3f9d292",
                                        "entry_id": "10ec988b-2165-3039-9e55-30f5904bc321",
                                        "glosses": [
                                            "Qualifie une personne trop compassée qui n’agit que par poids et par mesure."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67093e2f-8153-455e-b2b2-6bf168ed2aee",
                        "source_entry_id": "6977227f-54a5-3726-b435-3ba8fea5bbea",
                        "source_sense_description": "in an organized manner",
                        "target_lang_word": "methodisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methodisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                        "entry_id": "d5dcdb97-aca9-3bea-9a9a-c18785d0952f",
                                        "glosses": [
                                            "einer durchdachten Methode folgend; häufig in der Pädagogik und der Wissenschaft verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c165de-257a-43b7-95a3-eb54475f4dcc",
                                                "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                                "text": "Das ist für mich typisch deutsch: Dass die Menschen so organisiert sind und methodisch vorgehen. Ich glaube, das findet man kaum in anderen Ländern."
                                            },
                                            {
                                                "example_id": "33299767-2cfe-4d94-9224-0f5d95b70de5",
                                                "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                                "text": "\"Digitale Forensik ist eine relativ neue Wissenschaft, die sich damit beschäftigt, digitale Beweisträger zu analysieren, sie sicherzustellen und methodisch aufzubereiten\", definiert der Programmleiter Steve Kovacs [von der Hochschule Albstadt-Sigmaringen] das Fachgebiet."
                                            },
                                            {
                                                "example_id": "69900778-df86-4436-b7dd-43265e0837e1",
                                                "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                                "text": "Schlussfolgerung der Wissenschaftler ist, dass die Bush-Regierung methodisch Fehlinformationen in Umlauf gebracht hat, um die öffentliche Meinung zu beeinflussen, und um das Land unter falschen Behauptungen in den Krieg zu führen."
                                            },
                                            {
                                                "example_id": "0cddbdfe-8c01-4182-a397-64f558819b15",
                                                "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                                "text": "Über die Doktorarbeit der Bildungsministerin Annette Schavan: \"Das ist keine wissenschaftliche Arbeit. Es wurde wiederholt und methodisch von anderen Quellen abgeschrieben, ohne sie an den entsprechenden Stellen zu nennen.\""
                                            },
                                            {
                                                "example_id": "eff92356-16dd-46f4-9abe-9613493295d9",
                                                "sense_id": "6f30f552-b67d-3ff1-8bb4-d30786ce2d91",
                                                "text": "Nicht jeder hat sich im Grund- und Hauptstudium das methodische Handwerkzeug aneignen können, das nun [bei der Doktorarbeit] vorausgesetzt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
