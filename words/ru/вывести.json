                                "target_lang_word": "derive",
                                "target_lang_sense_clarification": "a formula or rule"
                            },
                            {
                                "target_lang_word": "deduce",
                                "target_lang_sense_clarification": "a conclusion or pattern"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "afleiden",
                                "target_lang_sense_clarification": "een formule of regel"
                            },
                            {
                                "target_lang_word": "concluderen",
                                "target_lang_sense_clarification": "een conclusie of patroon"
                            }
