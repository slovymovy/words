                    },
                    {
                        "translation_id": "8a70be80-e1cc-4e77-92cf-890fc0792a06",
                        "source_entry_id": "554642e9-130c-3bfa-a5ed-16c45a0ff4c9",
                        "source_sense_id": "ac498412-de58-3f9b-bba4-ad67e807ebeb",
                        "target_lang_word": "Verbreitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbreitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "die (bewusste oder unbewusste) Handlung des Verbreitens; eine Sache weitergeben und somit vervielfachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b4f0b6-5c79-4bf6-9b79-f0df5951eafe",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung von pornographischen Dateien ist nicht erlaubt."
                                            },
                                            {
                                                "example_id": "e97490e3-4348-4b0d-8bee-7e689898a1d6",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung der Krankheit muss schnellstmöglich verhindert werden."
                                            },
                                            {
                                                "example_id": "1c624f3f-8a1b-4753-920e-3eb7459a874f",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Ein CIA-Spion, der schon zwanzig Jahre dabei war, hatte mitgeholfen, die Verbreitung von Massenvernichtungswaffen zu verhindern.“"
                                            },
                                            {
                                                "example_id": "de144ce8-1e0c-47c1-b6b5-8c0f2794023e",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "a337cf52-53c4-4431-b443-bc46cc98fa7b",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Doch mit Zensur und Zeitungsverboten konnte die Verbreitung der Nachrichten aus Österreich natürlich nicht unterbunden werden.“"
                                            },
                                            {
                                                "example_id": "c561c365-20e5-417d-ac2a-117e69668242",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Flächendeckende Verbreitung erfuhr es dann durch die Pornoindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "der Zustand, in einem bestimmtem Raum oder in einem gewissen Maße verbreitet zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a506a9-1007-4e97-b0f7-a141b186b735",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Bei einer so weiten Verbreitung ist es kein Wunder, dass auch Prominente betroffen sind.“"
                                            },
                                            {
                                                "example_id": "c0a20a7a-d07e-432c-9cd7-faad5c4ba546",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Die Verbreitung von Cannabis ist in den Niederlanden sogar geringer als in Ländern, die eine repressive Drogenpolitik verfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
