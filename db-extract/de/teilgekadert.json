                ],
                "senses": [
                    {
                        "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                        "entry_id": "09593b6d-552a-33db-96c5-4fc67c7b17c0",
                        "glosses": [
                            "in Teilen nur aus Kernbereichen bestehend, die im Spannungs- oder Verteidigungsfall ergänzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c235e0e7-6bae-4431-97c1-34a180415e81",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Die aktiven Kompanien dieser teilgekaderten Einheit wurden auf die aktiven Bataillone der Brigade aufgeteilt und diesen unterstellt, so beispielsweise die 2./Panzerbataillon 341 dem Panzergrenadierbataillon 342, die 3./Panzerbataillon 341 dem Panzerbataillon 343 und die 4./Panzerbataillon 341 dem Panzerbataillon 344.“"
                            },
                            {
                                "example_id": "8471cab6-bfe5-4c07-aa05-3cbb3a2dee08",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Vor allem die Korps- und Divisionstruppen wurden teilgekadert.“"
                            },
                            {
                                "example_id": "821f7691-9195-4dc2-94e6-8ec51d08fee1",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Die bodengestützte Luftverteidigung wird reorganisiert: 36 Staffeln Patriot und 24 Staffeln Hawk bleiben aktiv, 12 weitere Staffeln Hawk werden gekadert, drei Gruppen Roland teilgekadert.“"
                            },
                            {
                                "example_id": "a45f13dc-326b-4391-a8e0-bae4eefdddd1",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Die vier aktiven Verbände des Logistikregiments werden teilgekadert sein.“"
                            },
                            {
                                "example_id": "bfdf545c-261c-4057-afb9-0d8028af8374",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Im Frieden sind diese Infanterie-Divisionen in geringem Umfang teilgekadert und werden erst in der Mobilmachung voll aufgefüllt.“"
                            },
                            {
                                "example_id": "e7075ad0-05aa-419a-849b-7abb9aee234f",
                                "sense_id": "c20ac906-3d0e-39f7-bee4-b8b56c0b8c4c",
                                "text": "„Die Niederlande haben insgesamt eine verstärkte Division mit vier Brigaden vorgesehen, von denen zwei aktiv und die beiden anderen teilgekadert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
