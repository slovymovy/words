                        "examples": [
                            {
                                "example_id": "17525373-22a0-477a-9384-4f7ad1c6b945",
                                "sense_id": "8bb571fe-b728-344b-bfff-53440630dfbc",
                                "text": "Hij zat al maanden niet meer op de fiets als gevolg van een blessure aan beide knieën. ,,Officieel heet het overbelasting, maar concreet is het een zeurende pijn in het midden van beide knieschijven."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fe093cb-24a1-3032-bcb4-bd37a0004dd3",
                        "entry_id": "caab7fb5-3a94-3340-8557-673ccdf4d91b",
                        "glosses": [
                            "langdurig en op een vervelende manier klagend en vragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b67f8f-09e1-4764-91e4-0e8eeba2a542",
                                "sense_id": "0fe093cb-24a1-3032-bcb4-bd37a0004dd3",
                                "text": "Het meest bewierookte team van de moderne tijd was na 79 minuten gedegradeerd tot een stelletje zeurende, struikelende toeschouwers in gele shirtjes\", zo wordt Barcelona op de plek gezet."
                            }
                        ]
                    }
