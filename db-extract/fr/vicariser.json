                "senses": [
                    {
                        "sense_id": "db64a06e-3a44-321c-8c8b-25e0e6bc0723",
                        "entry_id": "18e74f9b-13a6-3afe-99e8-3535dd72a208",
                        "glosses": [
                            "Avoir une activité de vicaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed719194-a710-4a44-acd9-ce532dc40369",
                                "sense_id": "db64a06e-3a44-321c-8c8b-25e0e6bc0723",
                                "text": "Votre pièce ne vaut rien, votre discours est une extravagance, tous ces messieurs se moquent de vous ; sortez d’ici, et retournez vicariser dans votre village."
                            },
                            {
                                "example_id": "5e65dca9-1572-4e8a-9751-917b3657348e",
                                "sense_id": "db64a06e-3a44-321c-8c8b-25e0e6bc0723",
                                "text": "Ceux qu’on appelle mendiants sont accoutumés à une vie plus active, à vicariser, à prêcher ; ils auront plus de moyens d’améliorer leur sort."
                            }
                        ]
                    }
                ],
