                                            {
                                                "example_id": "a04a0e76-63d2-4526-b903-2ccab1d409a9",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "A high percentage of secondary school leavers take a gap year."
                                            },
                                            {
                                                "example_id": "2b934f59-fc31-4e61-9f44-25439231d735",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "The replacement percentages are based largely on household spending data from the Department of Labor's Consumer Expenditure Survey."
                                            },
                                            {
                                                "example_id": "85665076-b72d-466a-bd96-3c0501bc9446",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "Kramer said California’s legislation is weak compared to the laws in Norway and other European countries, which require a certain percentage of women on boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa511b3-3d25-3b5a-98de-b276c1f1bc19",
