                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4fd00f-d1b6-317b-9e3e-da51653cc5c1",
                                        "entry_id": "cba1d645-aea0-3474-829c-b43090766221",
                                        "glosses": [
                                            "Doctrine hérétique des débuts du christianisme des sectateurs d’Arius, qui niait la consubstantialité de Jésus-Christ avec Dieu-le-Père."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9ea131-b34b-4ff7-a0cd-9d9a118a8d87",
                                                "sense_id": "5f4fd00f-d1b6-317b-9e3e-da51653cc5c1",
                                                "text": "Car si les Goths, les Francs et les Burgondes embrassèrent le christianisme, ils le firent d’une manière superficielle et ils se laissèrent facilement gagner aux hérésies, en particulier à l’arianisme."
                                            }
