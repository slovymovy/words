                "senses": [
                    {
                        "sense_id": "73f5ab1c-be76-3ba9-a880-f3e6942d701b",
                        "entry_id": "a6f7307b-4d7b-3293-a36d-7bc09a5a6410",
                        "glosses": [
                            "ein Fest, eine Party, um einen Geburtstag zu feiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c380ed0c-c305-4c02-8b2a-6eb7085d623e",
                                "sense_id": "73f5ab1c-be76-3ba9-a880-f3e6942d701b",
                                "text": "„Im Schwimmbad quasselte Renate drei Typen an, Jochen und Henry und Dirk, die sie alle zu ihrer Geburtstagsparty einlud.“"
                            },
                            {
                                "example_id": "658ed446-d172-42c0-b93a-90ac2cf3f019",
                                "sense_id": "73f5ab1c-be76-3ba9-a880-f3e6942d701b",
                                "text": "„Der türkische Unternehmer lud mich derweil zu einer Geburtstagsparty ein.“"
                            },
                            {
                                "example_id": "e802ac67-35a3-4677-8f18-302f8adf8ef8",
                                "sense_id": "73f5ab1c-be76-3ba9-a880-f3e6942d701b",
                                "text": "„Zum Glück war sie diesmal so schlau gewesen, ein riesiges, leerstehendes Lagerhaus in der Nähe des Hauptbahnhofs zu mieten statt den kleinen Gemeindesaal, den sie letztes Jahr für eine Geburtstagsparty organisiert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
