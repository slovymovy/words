                        "entry_id": "0b4157a7-77cc-345b-8fe2-5b9f7bec0050",
                        "glosses": [
                            "A mythical Chinese hooved chimerical creature, said to appear in conjunction with the arrival of a sage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7abec941-50a5-492b-94b5-6edda05e0594",
                                "sense_id": "6cbb04d9-8420-3ae3-bc5b-4cff06a9712e",
                                "text": "...a red and gold textile with phoenixes in one row swooping towards qilins in the next amidst a densely foliated ground..."
                            },
                            {
                                "example_id": "f1ca7218-7d10-43bf-b343-09532c16888d",
                                "sense_id": "6cbb04d9-8420-3ae3-bc5b-4cff06a9712e",
                                "text": "Roundel depicting dragon attacked by qilins; mounted on an album page."
                            },
                            {
                                "example_id": "df49fd64-b75d-4da3-a189-d02a38e72d45",
                                "sense_id": "6cbb04d9-8420-3ae3-bc5b-4cff06a9712e",
                                "text": "When the qilin leaves, the emperor traces the shapes he saw into the dirt."
                            }
                        ]
                    }
