                "senses": [
                    {
                        "sense_id": "53e456a6-8e65-39a8-b3b1-865952a454af",
                        "entry_id": "484fea11-99fc-323e-8581-f4e00c81536d",
                        "glosses": [
                            "Noter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b925694c-5b93-4db9-a012-884bd5c5706a",
                                "sense_id": "53e456a6-8e65-39a8-b3b1-865952a454af",
                                "text": "Auto-noter son entreprise pour en connaitre sa valeur et ses performances."
                            },
                            {
                                "example_id": "c92e7799-3d1e-49bb-9e75-02558103f9c7",
                                "sense_id": "53e456a6-8e65-39a8-b3b1-865952a454af",
                                "text": "S’évaluer ne devrait pas être synonyme de s’auto-noter ou de remplir un imposant tableau de compétences en y traçant des croix."
                            },
                            {
                                "example_id": "47618ef0-9aac-44f5-a83d-e1595fbc948b",
                                "sense_id": "53e456a6-8e65-39a8-b3b1-865952a454af",
                                "text": "C'est bon Pierre arrête de t'auto-noter et de flooder les commentaires, on t'a reconnu!"
                            }
                        ]
                    }
