                "senses": [
                    {
                        "sense_id": "639be403-e522-3b60-b8c9-3ebd14d806ad",
                        "entry_id": "5e102312-e1e4-3403-8794-0d9dd95e2221",
                        "glosses": [
                            "Mettre du cirage sur quelque chose (en général des chaussures)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c321f7c-0c79-4e8d-9f42-5b1c83d07711",
                                "sense_id": "639be403-e522-3b60-b8c9-3ebd14d806ad",
                                "text": "Toujours est-il que les bidasses, sabre au clair, bérets vissés, képis enfoncés et rangers ciragées arrivaient maintenant devant la tribune présidentielle."
                            },
                            {
                                "example_id": "d5390c9c-0f83-4f7b-a5fa-6b149d3f25d7",
                                "sense_id": "639be403-e522-3b60-b8c9-3ebd14d806ad",
                                "text": "Que sont les machines à cirager les chaussures ?"
                            },
                            {
                                "example_id": "c7871c50-1e5b-45e7-ad27-a598196689d1",
                                "sense_id": "639be403-e522-3b60-b8c9-3ebd14d806ad",
                                "text": "Tapis de sol ultra-résistant, tampon à cirager, tapis antidérapant 40*60CM demi-cercle."
                            },
                            {
                                "example_id": "ce87eeab-748f-46db-a445-b44a8341c984",
                                "sense_id": "639be403-e522-3b60-b8c9-3ebd14d806ad",
                                "text": "Avec ses dimensions compactes et son look « acier inox » unique, cette machine à cirager les chaussures s'adapte à tous les environnements."
                            }
                        ]
                    }
