                    {
                        "sense_id": "174a555d-f7ef-3513-bc40-38dd06de6196",
                        "entry_id": "52d75be8-e62c-3a67-8eb1-d6de20067d90",
                        "glosses": [
                            "To meet with friends without any agenda or goals."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "33e24f24-291a-470e-a11d-4aa38c18179c",
                                "sense_id": "174a555d-f7ef-3513-bc40-38dd06de6196",
                                "text": "We spent a whole lot of time kiki'ing around—fooling around."
                            },
                            {
                                "example_id": "f158206a-e2b7-4860-9403-6bdcc7ce08cf",
                                "sense_id": "174a555d-f7ef-3513-bc40-38dd06de6196",
                                "text": "Went home, changed for my show, kikied with Bruce and walked over to the apartment for my weekly meeting and Sally was just walking into the building from Sirius."
                            },
                            {
                                "example_id": "75040abf-a006-4d82-9312-85f2aa398839",
                                "sense_id": "174a555d-f7ef-3513-bc40-38dd06de6196",
                                "text": "“I still had my corporate job, so we would talk on GChat all day while I was at work,” says Olisa. (She’s still based in New York; Garner Valentine has since relocated to Georgia. Both are in their 30s.) “To the outside world, I was working diligently, but I was really kiki-ing with my friend.”"
                            }
                        ]
                    }
