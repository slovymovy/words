                                "target_senses": [
                                    {
                                        "sense_id": "1fc179d2-9aee-317e-8cf4-d933571144e0",
                                        "entry_id": "1eca6f70-8244-3feb-8017-a086bbc8d155",
                                        "glosses": [
                                            "Einwohnerin des Bundeslandes Salzburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8be894f-05ff-4fc4-b11e-af87205b9e57",
                                                "sense_id": "1fc179d2-9aee-317e-8cf4-d933571144e0",
                                                "text": "Sie ist eine gebürtige Salzburgerin."
                                            },
                                            {
                                                "example_id": "e439dce7-f385-41cc-a6b7-d0a36642c644",
                                                "sense_id": "1fc179d2-9aee-317e-8cf4-d933571144e0",
                                                "text": "„Die Salzburgerin ist nicht nur Weltcupsiegerin, sondern hat auch ein besonderes Kunststück im Repertoire.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
