    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9fc7002a-fe85-3c0e-88f0-c876a8309f06",
                    "sense_definition": "waardeloos, van zeer slechte kwaliteit of beneden de maat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waardeloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die hele vertoning was toch gewoon <w>flut</w>?",
                            "target_lang_translations": {
                                "en": "That whole performance was just <w>lousy</w>, wasn't it?"
                            }
                        },
                        {
                            "text": "Ik heb gisteravond een <w>flut</w> film gekeken die echt zonde van mijn tijd was.",
                            "target_lang_translations": {
                                "en": "I watched a <w>crappy</w> movie last night that was a real waste of my time."
                            }
                        }
                    ],
                    "synonyms": [
                        "waardeloos",
                        "ondermaats",
                        "slecht"
                    ],
                    "antonyms": [
                        "geweldig",
                        "uitstekend"
                    ],
                    "common_phrases": [
                        "een flut film",
                        "echt flut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "worthless, of very poor quality, or below standard"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lousy",
                                "target_lang_sense_clarification": "of very poor quality"
                            },
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "worthless or bad"
                            },
                            {
                                "target_lang_word": "crappy",
                                "target_lang_sense_clarification": "informal, low quality"
                            },
                            {
                                "target_lang_word": "trashy",
                                "target_lang_sense_clarification": "cheap and poor quality"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "719c9330-1682-3816-93f5-f3f0cb25c69b",
                    "sense_definition": "waardeloze spullen, rommel of onzin",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waardeloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gooi die oude <w>flut</w> nu eindelijk eens een keer weg.",
                            "target_lang_translations": {
                                "en": "Throw that old <w>junk</w> away once and for all."
                            }
                        },
                        {
                            "text": "Hij verkoopt alleen maar goedkope <w>flut</w> op de rommelmarkt.",
                            "target_lang_translations": {
                                "en": "He only sells cheap <w>rubbish</w> at the flea market."
                            }
                        }
                    ],
                    "synonyms": [
                        "rommel",
                        "onzin",
                        "troep"
                    ],
                    "antonyms": [
                        "kwaliteit"
                    ],
                    "common_phrases": [
                        "alleen maar flut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "worthless items, junk, or nonsense"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "junk",
                                "target_lang_sense_clarification": "worthless things"
                            },
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "useless waste or items"
                            },
                            {
                                "target_lang_word": "crap",
                                "target_lang_sense_clarification": "informal, worthless stuff"
                            },
                            {
                                "target_lang_word": "trash",
                                "target_lang_sense_clarification": "discarded or worthless items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bda6e11-536b-3985-b3f1-bc74840ee952",
                    "sense_definition": "een waardeloos of onbetrouwbaar persoon",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt niet op hem rekenen, hij is echt een <w>flut</w>.",
                            "target_lang_translations": {
                                "en": "You can't count on him, he is really a <w>good-for-nothing</w>."
                            }
                        },
                        {
                            "text": "Die luie <w>flut</w> weigert al maanden om fatsoenlijk werk te zoeken.",
                            "target_lang_translations": {
                                "en": "That lazy <w>slacker</w> has been refusing to look for a decent job for months."
                            }
                        }
                    ],
                    "synonyms": [
                        "nietsnut",
                        "luilak"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a worthless, unreliable, or lazy person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "good-for-nothing",
                                "target_lang_sense_clarification": "a lazy or useless person"
                            },
                            {
                                "target_lang_word": "loser",
                                "target_lang_sense_clarification": "an unsuccessful or worthless person"
                            },
                            {
                                "target_lang_word": "slacker",
                                "target_lang_sense_clarification": "a lazy person who avoids work"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "968c5420-c874-3603-a697-94084e418584",
                    "sense_definition": "zeer slappe, smaakloze thee",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze thee heeft nauwelijks smaak, het is pure <w>flut</w>.",
                            "target_lang_translations": {
                                "en": "This tea has barely any flavor, it is pure <w>dishwater</w>."
                            }
                        },
                        {
                            "text": "Zij serveert altijd van die slappe <w>flut</w> als je op bezoek komt.",
                            "target_lang_translations": {
                                "en": "She always serves that weak <w>slop</w> when you come to visit."
                            }
                        }
                    ],
                    "synonyms": [
                        "slootwater"
                    ],
                    "common_phrases": [
                        "slappe flut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "very weak, tasteless tea or drink"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dishwater",
