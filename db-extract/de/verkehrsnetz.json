                "senses": [
                    {
                        "sense_id": "482c8c3b-dd1f-3117-a55d-512c0e53fdd2",
                        "entry_id": "33be8615-1da8-3d36-b625-d7cc62de092c",
                        "glosses": [
                            "Gesamtheit der Verkehrslinien, die ein bestimmtes Gebiet erschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb693824-ab68-4bfa-9239-d1965aaf05df",
                                "sense_id": "482c8c3b-dd1f-3117-a55d-512c0e53fdd2",
                                "text": "„Im gleichen Jahr ging die Brücke in die Nutzung der Straßenbahn über, die damit ihr Verkehrsnetz auf die rechte Rheinseite ausdehnen konnte (…).“"
                            },
                            {
                                "example_id": "1358f4ed-b6c2-4e94-9a2f-1844fff301ee",
                                "sense_id": "482c8c3b-dd1f-3117-a55d-512c0e53fdd2",
                                "text": "„Weil die Anbindung ans öffentliche Verkehrsnetz nicht gut ist, will Düsterdick eine Seilbahn bauen, mit Gondeln, bis rüber zur S-Bahn-Station Vaihingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
