            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ac7111e-4511-3b28-abaa-36c647157dc3",
                    "sense_definition": "iets wat aanzet tot lachen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grappig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De komiek vertelde een <w>lachwekkend</w> verhaal over zijn vakantie in Frankrijk.",
                            "target_lang_translations": {
                                "en": "The comedian told a <w>hilarious</w> story about his holiday in France."
                            }
                        },
                        {
                            "text": "Het was een <w>lachwekkende</w> situatie toen de hond met de worst vandoor ging.",
                            "target_lang_translations": {
                                "en": "It was a <w>laughable</w> situation when the dog ran off with the sausage."
                            }
                        }
                    ],
                    "synonyms": [
                        "hilarisch"
                    ],
                    "antonyms": [
                        "serieus",
                        "ernstig"
                    ],
                    "common_phrases": [
                        "lachwekkende situatie",
                        "lachwekkend verhaal"
                    ],
                    "target_lang_definitions": {
                        "en": "something that causes laughter or is very funny"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laughable",
                                "target_lang_sense_clarification": "causing laughter"
                            },
                            {
                                "target_lang_word": "hilarious",
                                "target_lang_sense_clarification": "extremely funny"
                            },
                            {
                                "target_lang_word": "laugh-inducing",
                                "target_lang_sense_clarification": "making people laugh"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf10683d-1502-3b76-8cd8-cb7ee523be5e",
                    "sense_definition": "zo onzinnig of slecht dat het bespottelijk is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bespottelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>lachwekkend</w> dat hij denkt dit probleem zonder hulp op te lossen.",
                            "target_lang_translations": {
                                "en": "It is <w>ridiculous</w> that he thinks he can solve this problem without help."
                            }
                        },
                        {
                            "text": "Zijn excuses voor het te laat komen waren werkelijk <w>lachwekkend</w>.",
                            "target_lang_translations": {
                                "en": "His excuses for being late were truly <w>laughable</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hilarisch"
                    ],
                    "antonyms": [
                        "indrukwekkend",
                        "geloofwaardig"
                    ],
                    "common_phrases": [
                        "werkelijk lachwekkend",
                        "lachwekkend voorstel"
                    ],
                    "target_lang_definitions": {
                        "en": "so nonsensical or bad that it is ridiculous or pathetic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ridiculous",
                                "target_lang_sense_clarification": "deserving mockery"
                            },
                            {
                                "target_lang_word": "laughable",
                                "target_lang_sense_clarification": "so bad it is funny"
                            },
                            {
                                "target_lang_word": "ludicrous",
                                "target_lang_sense_clarification": "foolish or unreasonable"
                            },
                            {
                                "target_lang_word": "absurd",
                                "target_lang_sense_clarification": "wildly unreasonable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
