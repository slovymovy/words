                "senses": [
                    {
                        "sense_id": "cbb1a37a-c01c-3cb9-99cc-065b59aa198f",
                        "entry_id": "430e8145-7b5e-3cc7-a5a5-5f4a90ccf1f2",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ba6f8c-b0b9-490b-b6e6-ff48daa5583a",
                                "sense_id": "cbb1a37a-c01c-3cb9-99cc-065b59aa198f",
                                "text": "Ms. Gates, who is named after Phoebe from “The Catcher in the Rye,” grew up in Seattle, the youngest of three."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ec8396c-34d4-3437-8fa5-27728c43d7be",
                        "entry_id": "430e8145-7b5e-3cc7-a5a5-5f4a90ccf1f2",
                        "glosses": [
                            "A Titan, goddess of the moon, sister-wife of Coeus, and daughter of Uranus and Gaia."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e9b6a70-dbf1-3e3a-bf93-5904cec40a52",
                        "entry_id": "430e8145-7b5e-3cc7-a5a5-5f4a90ccf1f2",
                        "glosses": [
                            "An epithet and synonym for Selene; Phoebe Selene, after her maternal aunt, Phoebe (see above)."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1b725a3d-a4b3-3aad-b35d-73259ea0fa73",
                        "entry_id": "430e8145-7b5e-3cc7-a5a5-5f4a90ccf1f2",
                        "glosses": [
                            "An epithet and synonym for Artemis; Phoebe Artemis, after her maternal grandmother, Phoebe (see above)."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b406db48-111b-3866-b59d-07565e02abaf",
                        "entry_id": "430e8145-7b5e-3cc7-a5a5-5f4a90ccf1f2",
                        "glosses": [
                            "The 14th moon of Saturn."
