                                    {
                                        "sense_id": "cdb37aca-203e-34e9-b0f9-7e6fef99a74b",
                                        "entry_id": "323b891e-35ea-3710-b99a-de941854da97",
                                        "glosses": [
                                            "einen Ort beibehalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9132a5d3-7f6b-4d91-873f-7771131d8955",
                                                "sense_id": "cdb37aca-203e-34e9-b0f9-7e6fef99a74b",
                                                "text": "Der Mann blieb zu Hause."
                                            },
                                            {
                                                "example_id": "d0c659e8-5680-47fe-8ea9-db082e4b124e",
                                                "sense_id": "cdb37aca-203e-34e9-b0f9-7e6fef99a74b",
                                                "text": "Die Vase bleibt auf dem Tisch!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                        "entry_id": "323b891e-35ea-3710-b99a-de941854da97",
                                        "glosses": [
                                            "einen bestimmten Zustand beibehalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa71d489-6bcf-42a8-a85d-2dbe8dcd1298",
                                                "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                                "text": "Er bleibt mein Freund."
                                            },
                                            {
                                                "example_id": "3ac0e9ba-db70-4e85-aaa7-916d65f37147",
                                                "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben.“"
                                            },
                                            {
                                                "example_id": "98f882fc-34d8-45ec-b761-f7616b490f79",
                                                "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                                "text": "„Sie begnügten sich mit den provenzalischen Stierspielen - da bleibt der Stier am Leben.“"
                                            },
                                            {
                                                "example_id": "90a14292-4936-4060-a9dd-ad305fb99e8e",
                                                "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                                "text": "„Oliver Gerber heisst eigentlich anders. Weil die Familie seiner Partnerin in China lebt und mit Repressionen rechnet, wenn sein Name in der Zeitung steht, möchte er anonym bleiben.“"
                                            },
                                            {
                                                "example_id": "2465c289-be75-4284-a367-2807e13631eb",
                                                "sense_id": "af8aab91-6068-37c0-bdaf-4cf100581f91",
                                                "text": "„Dubslav von Stechlin blieb also Witwer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "20b8f4d1-0b68-3451-8da3-80dc069d1bd1",
                                        "entry_id": "323b891e-35ea-3710-b99a-de941854da97",
                                        "glosses": [
                                            "überdauern, langfristig existieren"
                                        ],
                                        "tags": [
                                            "häufig unpersönlich und mit Einschränkungen wie „noch“",
                                            "„etwas“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e12632-eac6-4ed1-aa6b-71f7845d2b33",
                                                "sense_id": "20b8f4d1-0b68-3451-8da3-80dc069d1bd1",
                                                "text": "Es bleibt noch Hoffnung."
                                            },
                                            {
                                                "example_id": "17e3cb62-871e-40b4-91ef-b60026dafbe5",
                                                "sense_id": "20b8f4d1-0b68-3451-8da3-80dc069d1bd1",
                                                "text": "Alles, was blieb, war eine Idee von einer besseren Zukunft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "23e658a3-0e5e-3685-9e79-451b7afba993",
                                        "entry_id": "323b891e-35ea-3710-b99a-de941854da97",
                                        "glosses": [
                                            "an einem Ort, zu einer Zeit sterben und von dort nicht zurückkehren"
                                        ],
                                        "tags": [
                                            "meist in Formen der Vergangenheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc296be8-07f6-4de4-9cd4-1c278086b68d",
                                                "sense_id": "23e658a3-0e5e-3685-9e79-451b7afba993",
                                                "text": "Er blieb vor Verdun."
                                            },
                                            {
                                                "example_id": "608c0ab5-d141-4fe8-865f-2ed907e7a4d8",
                                                "sense_id": "23e658a3-0e5e-3685-9e79-451b7afba993",
                                                "text": "Der Korvettenkapitän blieb auf See."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
