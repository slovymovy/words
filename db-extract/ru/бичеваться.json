                        "sense_id": "f8ba7bc1-db07-36b3-87c6-1d6288c3f7e6",
                        "entry_id": "b0fb1f3a-1f6c-3be3-b27c-e1ca09c0dbb3",
                        "glosses": [
                            "страд. к бичевать I"
