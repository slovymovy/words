            {
                "entry_id": "7286f6dd-9ee2-3624-92a5-102155733283",
                "word": "locutaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "97aaa3bd-4197-4523-84aa-062bdf9d8e4a",
                        "entry_id": "7286f6dd-9ee2-3624-92a5-102155733283",
                        "tags": [
