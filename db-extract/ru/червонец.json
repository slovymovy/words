                ],
                "senses": [
                    {
                        "sense_id": "5ab4d1b5-56dc-3949-9539-450fdde77be8",
                        "entry_id": "5683141c-04e2-3d96-9ec7-5f4709dcf366",
                        "glosses": [
                            "истор., нумизм. золотая монета (в 5 или 10 руб.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bd8a27-3879-42ba-9ee6-02965e49016e",
                                "sense_id": "5ab4d1b5-56dc-3949-9539-450fdde77be8",
                                "text": "На закупку за границей нашли в качестве валюты один золотой царский червонец."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fd68e72-cbf7-3c49-b719-3c6f6610b96d",
                        "entry_id": "5683141c-04e2-3d96-9ec7-5f4709dcf366",
                        "glosses": [
                            "истор., нумизм. купюра достоинством в десять рублей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b3df8b-ba38-49dd-9f49-a137ac0915b6",
                                "sense_id": "4fd68e72-cbf7-3c49-b719-3c6f6610b96d",
                                "text": "Советский червонец."
                            },
                            {
                                "example_id": "661d6207-6a53-4f72-a1ae-b496c3a17c79",
                                "sense_id": "4fd68e72-cbf7-3c49-b719-3c6f6610b96d",
                                "text": "Разменять три червонца."
                            },
                            {
                                "example_id": "424b6187-b1d9-49ea-8586-fd2896a91845",
                                "sense_id": "4fd68e72-cbf7-3c49-b719-3c6f6610b96d",
                                "text": "Вася, одолжи червонец до получки."
                            }
                        ]
                    },
                    {
                        "sense_id": "d93af4c6-c600-3976-9ebc-117e9598d2ff",
                        "entry_id": "5683141c-04e2-3d96-9ec7-5f4709dcf366",
                        "glosses": [
                            "перен., жарг. десять единиц чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec753a07-84a5-4449-a3b5-cedf1b67259e",
                                "sense_id": "d93af4c6-c600-3976-9ebc-117e9598d2ff",
                                "text": "Слышал, он в тюрьму загремел; червонец впаяли."
                            },
                            {
                                "example_id": "a0f229d4-036d-4d2a-9f8e-96fe36dbefb1",
                                "sense_id": "d93af4c6-c600-3976-9ebc-117e9598d2ff",
                                "text": "Червонец баксов не раскидаешь?"
                            }
                        ]
                    },
                    {
                        "sense_id": "69d4107b-2be0-3312-8dff-e9a9fa6967b8",
                        "entry_id": "5683141c-04e2-3d96-9ec7-5f4709dcf366",
                        "glosses": [
                            "мн. ч., устар. вообще монеты, золото, деньги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e58d377-1955-4ee0-a942-b45df9d6b77e",
                                "sense_id": "69d4107b-2be0-3312-8dff-e9a9fa6967b8",
                                "text": "И червонцы твои не украдены у сирот беззащитных и вдов."
                            }
                        ]
                    }
                ],
