                    },
                    {
                        "form_id": "d4d23d0b-0a1b-4cca-a495-9485411cc04d",
                        "entry_id": "7502f1ed-61ef-3588-b6b5-0b22d785dde9",
                        "tags": [],
                        "form": "tapuscript"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                        "entry_id": "7502f1ed-61ef-3588-b6b5-0b22d785dde9",
                        "glosses": [
                            "Écrit tapé à l’aide d’un clavier (ordinateur ou machine à écrire)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a6dea81e-def1-4c53-a830-853f7e3e8cc1",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Lorsqu’on relit un manuscrit dactylographié (ou tapuscrit) il y a lieu de corriger non seulement les erreurs de frappe possibles […]"
                            },
                            {
                                "example_id": "a8ae6241-1a2f-478a-99fd-2bedbe0b388d",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Tapuscrit (Le). Recommandations pour la présentation et la dactylographie des travaux scientifiques (sciences humaines) réunies par M.-L. Dufour. E.P.H.E. (VIᵉ section), Service des publications, 1971. 102 pages"
                            },
                            {
                                "example_id": "1ac2867b-0069-4c1f-9fb1-8304d5ca811b",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Muñ avait pris le tapuscrit et l’avait dissimulé sous son habit."
                            },
                            {
                                "example_id": "ec5c028e-e1e0-450e-936c-0dad3f796525",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Et, selon toute vraisemblance pour augmenter cette illisibilité, Perec va jusqu’à supprimer de son texte la ponctuation encore présente dans un tapuscrit antérieur."
                            },
                            {
                                "example_id": "4d4942cc-73ed-4612-b80e-d89449f0dc3f",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Voilà plus de deux ans qu’un tapuscrit de Napoléon, signé Stanley Kubric, se balade sur le Net."
                            },
                            {
                                "example_id": "8584e9b9-3f7d-46ae-8ccd-3669e4eb7e31",
                                "sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                                "text": "Floriana Lebovici, inquiétée par le contenu sulfureux, un peu pornographique – pour l’époque – du roman de Farmer, avait envoyé le tapuscrit de la traduction à Kiejman sans page de titre pour une consultation juridique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6ee16dd-6b28-406d-bb6b-47a540cc4431",
                        "source_entry_id": "7502f1ed-61ef-3588-b6b5-0b22d785dde9",
                        "source_sense_id": "2545ca9a-b3c0-3c60-8f7e-9df6cbe786e7",
                        "target_lang_word": "Typoskript",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Typoskript",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f34747d8-ffed-389e-a9cb-2fa802ffbac6",
                                        "entry_id": "a74e608a-a270-327a-ba23-5381b14c4b0b",
                                        "glosses": [
                                            "mit der Schreibmaschine oder einem Computer geschriebenes Manuskript"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d99e703-527f-4e9c-aa96-ed72620e6c0a",
                                                "sense_id": "f34747d8-ffed-389e-a9cb-2fa802ffbac6",
                                                "text": "„Das Typoskript mit dem Titel \"Jans muß sterben\" hatte der in Paris lebende Sohn der Autorin, Pierre Radvanyi, erst vor kurzem in dem bei ihm verbliebenen Nachlass seiner Mutter entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "632d7e59-7dad-4bfa-99fd-627d0f0f071b",
                        "source_entry_id": "7502f1ed-61ef-3588-b6b5-0b22d785dde9",
