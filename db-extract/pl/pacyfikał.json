                                "target_senses": [
                                    {
                                        "sense_id": "c27afb67-39f0-3704-a177-0c76757e9d59",
                                        "entry_id": "6f3da72c-b8f3-3e13-9050-8a5c35904ed5",
                                        "glosses": [
                                            "A painted, stamped or carved tablet with a representation of Christ or the Virgin Mary, which was kissed by the priest during the Mass (\\\"kiss of peace\\\") and then passed to other officiating clergy and the congregation to be kissed. See also osculatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc1b103-1349-4abe-96b6-34ab33cc33c8",
                                                "sense_id": "c27afb67-39f0-3704-a177-0c76757e9d59",
                                                "text": "Fortune is Bardolphs foe, and frownes on him: for he hath ſtolne a Pax, and hanged muſt a be: […] Exeter hath giuen the doome of death, for Pax of little price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51ec827-1105-38aa-afa2-9c5e7d9d1dd1",
                                        "entry_id": "6f3da72c-b8f3-3e13-9050-8a5c35904ed5",
                                        "glosses": [
                                            "Friendship; truce."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c999f991-2e5c-41f8-9695-3117daf2624a",
                                                "sense_id": "d51ec827-1105-38aa-afa2-9c5e7d9d1dd1",
                                                "text": "to make pax with someone"
                                            },
                                            {
                                                "example_id": "27f4f4dc-eb55-434d-93e4-d78b9fd195e9",
                                                "sense_id": "d51ec827-1105-38aa-afa2-9c5e7d9d1dd1",
                                                "text": "to be good pax (i.e., good friends)"
                                            },
                                            {
                                                "example_id": "6d53c9de-e362-4866-a1b7-52e942ee99b1",
                                                "sense_id": "d51ec827-1105-38aa-afa2-9c5e7d9d1dd1",
                                                "text": "\"I say, Lu! I'm sorry I didn't believe you. I see now you were right all along. Do come out. Make it Pax.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6ea295-23e0-3405-b886-2cd452b9b167",
                                        "entry_id": "6f3da72c-b8f3-3e13-9050-8a5c35904ed5",
                                        "glosses": [
                                            "The kiss of peace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50d0da7c-7877-3d35-be00-5b610ccbbbf8",
                                        "entry_id": "6f3da72c-b8f3-3e13-9050-8a5c35904ed5",
                                        "glosses": [
                                            "A crucifix, a tablet with the image of Christ on the cross upon it, or a reliquary."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "901f771b-7ef5-355e-bef7-4044e79845ad",
                                        "entry_id": "6f3da72c-b8f3-3e13-9050-8a5c35904ed5",
                                        "glosses": [
                                            "Any of several notable periods of peace in human history, particularly owing to unquestionable hegemony on the model of the Pax Romana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
