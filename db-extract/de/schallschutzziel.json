                "senses": [
                    {
                        "sense_id": "d8dff212-91fe-3269-b2cf-0960f0158d25",
                        "entry_id": "0a30e11d-ac9a-3d68-b66c-3c61fef9756f",
                        "glosses": [
                            "klar umrissene Ausrichtung oder gedanklicher Endpunkt einer schallschutztechnischen Bestrebung, etwas oder jemanden vor Schallbelästigung zu bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8264cd1-9d3f-4177-bc6d-a81bc559dd43",
                                "sense_id": "d8dff212-91fe-3269-b2cf-0960f0158d25",
                                "text": "„Um das erforderliche Schallschutzziel in den anspruchsberechtigten Räumen zu erreichen, kann der Einbau von Dach-, Decken- und Außenwanddämmungen partiell erforderlich sein.“"
                            },
                            {
                                "example_id": "8cb53f16-3b42-44d4-a39b-31be6fd5994d",
                                "sense_id": "d8dff212-91fe-3269-b2cf-0960f0158d25",
                                "text": "„Nach den früheren Angaben der FBB sind die Mehrkosten für das durch das OVG Berlin-Brandenburg bestätigte Schallschutzziel gegenüber der Ursprungskalkulation auf ca. 591 Millionen € zu beziffern.“"
                            },
                            {
                                "example_id": "0482cea1-cca7-495b-ab65-fda07e0fe50b",
                                "sense_id": "d8dff212-91fe-3269-b2cf-0960f0158d25",
                                "text": "„Es waren das beklagte Land Brandenburg selbst und die Flughafengesellschaft, die dieses strenge Schallschutzziel beantragt und im Ergebnis planfestgestellt haben, um den Flughafen Berlin- Brandenburg an dem gewählten stadtnahen Standort zu rechtfertigen.“"
                            },
                            {
                                "example_id": "ff51308f-259c-4716-bd7c-89527979d162",
                                "sense_id": "d8dff212-91fe-3269-b2cf-0960f0158d25",
                                "text": "„Was ist das entsprechende Schallschutzziel?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
