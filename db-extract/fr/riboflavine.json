                                    {
                                        "sense_id": "aad1aa37-38f1-3e4a-8e11-1a967fa07ef6",
                                        "entry_id": "17d984a7-8ca2-3779-aae0-e05ba19da7e8",
                                        "glosses": [
                                            "vitamin B₂ or riboflavin."
                                        ],
