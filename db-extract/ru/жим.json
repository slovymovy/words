                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To drive or thrust by pressure, to force in a certain direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cec2140-b6e4-44d1-8d50-24eef510b0a0",
                                                "sense_id": "a765aeb3-ee87-3558-b257-52f151127c73",
                                                "text": "to press a crowd back"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416142c6-14db-3456-ab39-92b5a0e85877",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To weigh upon, oppress, trouble."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d079e8-23c3-40d1-b1f0-3297a68d65e4",
                                                "sense_id": "416142c6-14db-3456-ab39-92b5a0e85877",
                                                "text": "He turns from us; / Alas, he weeps too! Something presses him / He would reveal, but dare not. Sir, be comforted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8aea8e4-eb81-387f-9249-c3e3ca010519",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To force to a certain end or result; to urge strongly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcd54fdf-db5b-474d-9182-2b293d197c47",
                                                "sense_id": "c8aea8e4-eb81-387f-9249-c3e3ca010519",
                                                "text": "The two gentlemen who conducted me to the island were pressed by their private affairs to return in three days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0baac3c-7c96-314c-ae37-0790b14cda26",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To try to force (something upon someone)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ecbdecd-980e-40c7-8e02-696ace5f3c37",
                                                "sense_id": "f0baac3c-7c96-314c-ae37-0790b14cda26",
                                                "text": "to press the Bible on an audience"
                                            },
                                            {
                                                "example_id": "ac2d76cf-0af2-4531-90ad-f2650d2a2dcc",
                                                "sense_id": "f0baac3c-7c96-314c-ae37-0790b14cda26",
                                                "text": "He press'd a letter upon me within this hour."
                                            },
                                            {
                                                "example_id": "08661c13-8bc7-4933-b245-7417ff789235",
                                                "sense_id": "f0baac3c-7c96-314c-ae37-0790b14cda26",
                                                "text": "Be sure to press upon him every motive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960f354c-4ecb-3e0d-b263-a9ab1c818cf0",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To hasten, urge onward."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed28c19b-e68a-4c9f-a0d4-65660cda20ad",
                                                "sense_id": "960f354c-4ecb-3e0d-b263-a9ab1c818cf0",
                                                "text": "to press a horse in a race"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80fc3a45-ebc2-3a56-9b49-0999f86c11bb",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To urge, beseech, entreat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850f55a6-9c27-41fd-b4da-4995502ac2f1",
                                                "sense_id": "80fc3a45-ebc2-3a56-9b49-0999f86c11bb",
                                                "text": "God heard their prayers, wherein they earnestly pressed him for the honor of his great name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb0e999-c06d-3cae-8a6f-bdf8363f718d",
                                        "entry_id": "dff7c639-8dd8-31b3-89e0-b624e2abeb18",
                                        "glosses": [
                                            "To lay stress upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a911595-cd6d-4476-98a1-202cff741477",
                                                "sense_id": "9fb0e999-c06d-3cae-8a6f-bdf8363f718d",
                                                "text": "If we read but a very little, we naturally want to press it all; if we read a great deal, we are willing not to press the whole of what we read, and we learn what ought to be pressed and what not."
                                            }
                                        ]
                                    },
