                "senses": [
                    {
                        "sense_id": "3b77bd69-d5f3-334e-bba0-47cce79ab9f9",
                        "entry_id": "388e5cd5-2c12-3468-8a3a-73d0c0fb9167",
                        "glosses": [
                            "semisynthetisches Opioid, das als Schmerzmittel bei starken und stärksten Schmerzen zugelassen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2589bee0-a8ba-45b1-bdd4-a6b222b06ef8",
                                "sense_id": "3b77bd69-d5f3-334e-bba0-47cce79ab9f9",
                                "text": "„Nachdem er sich vergewissert hatte, dass Oryx gut gesichert war und eine Weile allein zurechtkam, öffnete der Amerikaner den Rucksack, ließ die Hydrocodon-Tabletten links liegen und holte eine Spritze mit dem wirkungsvollsten Hydromorphon heraus, das die CIA zu bieten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65d0181-9821-4a41-a90c-1a2516c51d2c",
                        "source_entry_id": "388e5cd5-2c12-3468-8a3a-73d0c0fb9167",
                        "source_sense_id": "3b77bd69-d5f3-334e-bba0-47cce79ab9f9",
                        "source_sense_description": "semisynthetisches Opioid",
                        "target_lang_word": "hydromorphone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydromorphone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bfca3e-20c7-3f73-8b77-d8a35178122d",
                                        "entry_id": "a9c3ef49-c29f-34dd-a771-ca74b490a59c",
                                        "glosses": [
                                            "A synthetic narcotic analgesic, (4,5 alpha-epoxy-3-hydroxy-17-methyl morphinan-6-one), similar to morphine and heroin. It is used for moderate to severe pain under the trade name Dilaudid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d666d69-ae8e-49fb-95ce-c93dd3d0e5ae",
                                                "sense_id": "f8bfca3e-20c7-3f73-8b77-d8a35178122d",
                                                "text": "She hadnʼt needed regular doses of hydromorphone in a month."
                                            },
                                            {
                                                "example_id": "81c21692-2c88-461c-b82b-2046b85f9ca9",
                                                "sense_id": "f8bfca3e-20c7-3f73-8b77-d8a35178122d",
                                                "text": "I had what seemed an unlimited prescription of the almighty hydromorphone. Even the sound of the name of the pill felt like its strength, like some water monster, or like some kind of supernatural disaster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
