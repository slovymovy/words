                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7555440a-729a-4159-b3b1-bca1a5d7a85e",
                        "source_entry_id": "aa1844fc-abc7-36fe-af80-7c1785576240",
