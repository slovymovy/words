{
    "word_family": [
        "commander",
        "commandant",
        "commanding",
        "commandment",
        "commander-in-chief"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cc2a76e-3668-3788-b05e-e19fd8a097dd",
                    "sense_definition": "An order to do something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was given a <w>command</w> to cease shooting immediately.",
                            "target_lang_translations": {
                                "ru": "Солдату был дан <w>приказ</w> немедленно прекратить огонь."
                            }
                        },
                        {
                            "text": "He obeyed the <w>command</w> without asking any questions.",
                            "target_lang_translations": {
                                "ru": "Он подчинился <w>команде</w>, не задавая никаких вопросов."
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "instruction",
                        "directive",
                        "bidding",
                        "behest"
                    ],
                    "common_phrases": [
                        "obey a command",
                        "give a command",
                        "direct command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приказ или распоряжение сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приказ",
                                "target_lang_sense_clarification": "официальное распоряжение"
                            },
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "краткий устный приказ"
                            },
                            {
                                "target_lang_word": "приказание",
                                "target_lang_sense_clarification": "требование выполнить что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61c277ef-8edb-3b05-84b6-a6dfc7741009",
                    "sense_definition": "A directive to a computer program acting as an interpreter of some kind, in order to perform a specific task.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to type the <w>command</w> into the terminal to start the process.",
                            "target_lang_translations": {
                                "ru": "Вам нужно ввести <w>команду</w> в терминал, чтобы запустить процесс."
                            }
                        },
                        {
                            "text": "The software did not recognize the <w>command</w> I entered.",
                            "target_lang_translations": {
                                "ru": "Программа не распознала <w>команду</w>, которую я ввел."
                            }
                        }
                    ],
                    "synonyms": [
                        "instruction"
                    ],
                    "common_phrases": [
                        "command line",
                        "execute a command",
                        "voice command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Директива компьютерной программе для выполнения определенной задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "инструкция в программировании или интерфейсе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b96ba2e-52a0-370c-bc87-e1a61381b48d",
                    "sense_definition": "Power of control, direction or disposal; mastery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a good <w>command</w> of the English language.",
                            "target_lang_translations": {
                                "ru": "Она хорошо <w>владеет</w> английским языком."
                            }
                        },
                        {
                            "text": "The general had full <w>command</w> of the situation during the crisis.",
                            "target_lang_translations": {
                                "ru": "Генерал полностью <w>контролировал</w> ситуацию во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "direction",
                        "lead",
                        "ruling"
                    ],
                    "common_phrases": [
                        "good command of",
                        "take command",
                        "in command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Власть, контроль или мастерское владение чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владение",
                                "target_lang_sense_clarification": "навык или знание (например, языка)"
                            },
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "власть над ситуацией"
                            },
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "способность направлять действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed10742-f373-3bb5-880d-caf4616992f2",
                    "sense_definition": "A position of chief authority; a position involving the right or power to order or control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "General Smith was placed in <w>command</w> of the entire division.",
                            "target_lang_translations": {
                                "ru": "Генерал Смит был назначен <w>командовать</w> всей дивизией."
                            }
                        },
                        {
                            "text": "He was relieved of his <w>command</w> after the failed mission.",
                            "target_lang_translations": {
                                "ru": "Он был освобожден от <w>командования</w> после провала миссии."
                            }
                        }
                    ],
                    "synonyms": [
                        "mandate"
                    ],
                    "common_phrases": [
                        "second in command",
                        "chain of command",
                        "assume command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Должность верховного руководителя; право или власть отдавать приказы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "командование",
                                "target_lang_sense_clarification": "руководство войсками или подразделением"
                            },
                            {
                                "target_lang_word": "начальствование",
                                "target_lang_sense_clarification": "главенство над группой лиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7925bedd-111c-3d5a-a225-91d557d5d119",
                    "sense_definition": "A body of troops, or any naval or military force, under the control of a particular officer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer led his <w>command</w> through the dense forest.",
                            "target_lang_translations": {
                                "ru": "Офицер вел свой <w>отряд</w> через густой лес."
                            }
                        },
                        {
                            "text": "The police <w>command</w> defended the actions of the officers involved.",
                            "target_lang_translations": {
                                "ru": "Полицейское <w>командование</w> защитило действия причастных офицеров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "military command",
                        "police command"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воинское подразделение или группа под управлением офицера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "небольшое воинское подразделение или отряд"
                            },
                            {
                                "target_lang_word": "подразделение",
                                "target_lang_sense_clarification": "военная единица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e130c2f5-179e-3a4e-818c-0c1b0fcf644b",
                    "sense_definition": "The degree of control a pitcher has over his pitches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher showed excellent <w>command</w> of his fastball tonight.",
                            "target_lang_translations": {
                                "ru": "Питчер показал отличный <w>контроль</w> фастбола сегодня вечером."
                            }
                        },
                        {
                            "text": "Without better <w>command</w>, he will struggle to win the game.",
                            "target_lang_translations": {
                                "ru": "Без лучшего <w>владения</w> мячом ему будет трудно выиграть игру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pitching command"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень контроля питчера над своими бросками (в бейсболе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контроль",
                                "target_lang_sense_clarification": "точность подачи"
                            },
                            {
                                "target_lang_word": "владение",
                                "target_lang_sense_clarification": "мастерство управления мячом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ffa4dd8-b822-3c67-b110-869bf56f4fc2",
                    "sense_definition": "A performance given by royal request.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band was invited to give a <w>command</w> performance for the Queen.",
                            "target_lang_translations": {
                                "ru": "Группу пригласили дать <w>специальное</w> выступление по просьбе королевы."
                            }
                        },
                        {
                            "text": "It was a rare <w>command</w> that the actors could not refuse.",
                            "target_lang_translations": {
                                "ru": "Это было редкое <w>повеление</w>, от которого актеры не могли отказаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "command performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представление, данное по просьбе монарха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевский запрос",
                                "target_lang_sense_clarification": "выступление по требованию монарха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e9ab933-b669-3795-908e-6b9262988c31",
                    "sense_definition": "To order, give orders; to compel or direct with authority.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ordering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>commanded</w> his servant to bring him dinner immediately.",
                            "target_lang_translations": {
                                "ru": "Король <w>приказал</w> слуге немедленно принести ему ужин."
                            }
                        },
                        {
                            "text": "The officer <w>commanded</w> the troops to halt at the border.",
                            "target_lang_translations": {
                                "ru": "Офицер <w>скомандовал</w> войскам остановиться на границе."
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "decree",
                        "enjoin",
                        "bidding"
                    ],
                    "common_phrases": [
                        "command respect",
                        "command attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приказывать, отдавать распоряжения; властно направлять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приказывать",
                                "target_lang_sense_clarification": "отдавать приказ"
                            },
                            {
                                "target_lang_word": "командовать",
                                "target_lang_sense_clarification": "отдавать устные команды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8dda50a-5a20-3a1e-8e7f-0b4311061d08",
                    "sense_definition": "To have or exercise supreme power, control or authority over, especially military.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was chosen to <w>command</w> the entire expedition.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали, чтобы <w>возглавить</w> всю экспедицию."
                            }
                        },
                        {
                            "text": "He has <w>commanded</w> the army for over ten years.",
                            "target_lang_translations": {
                                "ru": "Он <w>командовал</w> армией более десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead"
                    ],
                    "common_phrases": [
                        "command an army"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществлять верховную власть или контроль, особенно военный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "командовать",
                                "target_lang_sense_clarification": "быть командиром"
                            },
                            {
                                "target_lang_word": "возглавлять",
                                "target_lang_sense_clarification": "стоять во главе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eae82b8-80b9-3731-a89c-3aff72641b9d",
                    "sense_definition": "To exact, compel or secure by influence; to deserve or claim.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good leader <w>commands</w> the respect of his team.",
                            "target_lang_translations": {
                                "ru": "Хороший лидер <w>внушает</w> уважение своей команде."
                            }
                        },
                        {
                            "text": "The best products <w>command</w> a higher price in the market.",
                            "target_lang_translations": {
                                "ru": "Лучшие товары <w>требуют</w> более высокой цены на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand",
                        "enjoin"
                    ],
                    "common_phrases": [
                        "command a salary",
                        "command respect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать или обеспечивать что-либо своим влиянием; заслуживать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользоваться",
                                "target_lang_sense_clarification": "обладать авторитетом или уважением"
                            },
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "вызывать чувство (например, уважение)"
                            },
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "претендовать на высокую цену или внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e39ff33-f38e-3aa7-9abe-3373ca67949b",
                    "sense_definition": "To have a view of something from a superior or higher position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle <w>commands</w> a breathtaking view of the valley below.",
                            "target_lang_translations": {
                                "ru": "Из замка <w>открывается</w> захватывающий вид на долину внизу."
                            }
                        },
                        {
                            "text": "From this height, the tower <w>commands</w> the entire coastline.",
                            "target_lang_translations": {
                                "ru": "С этой высоты башня <w>господствует</w> над всей береговой линией."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiat"
                    ],
                    "common_phrases": [
                        "command a view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь вид на что-либо с возвышенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "господствовать",
                                "target_lang_sense_clarification": "возвышаться над местностью"
                            },
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "иметь вид на что-либо (об окнах, зданиях)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}