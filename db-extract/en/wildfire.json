                        "sense_id": "d34ec9ee-6eb0-3dd3-8603-a5300b2a8fa5",
                        "entry_id": "7bf672a6-6532-3e4f-a693-03ca5d4fa6e6",
                        "glosses": [
                            "A spreading disease of the skin, particularly erysipelas."
                        ],
