                "senses": [
                    {
                        "sense_id": "5e05e1d0-5e40-3865-9bf5-b814b88a3819",
                        "entry_id": "eb78971f-1baf-3d59-b9e8-c2e46540c9c8",
                        "glosses": [
                            "een soort broodbeleg, bestaande uit strooisel van chocolade of gekleurde suiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b549db8-83a0-4e6a-839d-c3d1313bec88",
                                "sense_id": "5e05e1d0-5e40-3865-9bf5-b814b88a3819",
                                "text": "- Hij eet de laatste tijd veel hagelslag op zijn brood."
                            },
                            {
                                "example_id": "36f440a9-ff14-4024-8396-e28d04dc6dcd",
                                "sense_id": "5e05e1d0-5e40-3865-9bf5-b814b88a3819",
                                "text": "- Fabrikanten van hagelslag vrezen dat hun product het volgende slachtoffer van 'de dopinghetze' zal zijn. 'Wij hebben topsporters verzocht hun hagelslaggebruik niet aan de grote klok te hangen. Want dat maakt je meteen verdacht.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "4f7a530d-b47c-347a-82e3-4c9e549e5f6f",
                        "entry_id": "eb78971f-1baf-3d59-b9e8-c2e46540c9c8",
                        "glosses": [
                            "het met kracht neervallen van de hagel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d284f4aa-8e2e-43a9-bf94-3c97d5318379",
                                "sense_id": "4f7a530d-b47c-347a-82e3-4c9e549e5f6f",
                                "text": "De hagelslag van gisteren overtrof de ergste verwachtingen!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f48a405-ddc6-3101-a8c6-1370dde8d172",
                        "entry_id": "eb78971f-1baf-3d59-b9e8-c2e46540c9c8",
                        "glosses": [
                            "hagelschade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab796c4-7c5d-48d7-a916-9122092af4be",
                                "sense_id": "0f48a405-ddc6-3101-a8c6-1370dde8d172",
                                "text": "De hagelslag aan onze auto was enorm."
                            }
                        ]
                    }
