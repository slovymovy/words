                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнок учился красиво <вывести> каждую букву своего имени.",
                            "target_lang_translations": {
                                "en": "The child was learning to beautifully <write out> every letter of his name.",
                                "nl": "Het kind leerde om elke letter van zijn naam mooi uit te <schrijven>."
