        "de-extract.jsonl": [
            {
                "entry_id": "02a95388-4099-387f-83f4-6336d92aa700",
                "word": "seewärts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                        "entry_id": "02a95388-4099-387f-83f4-6336d92aa700",
                        "glosses": [
                            "in Richtung des Meeres oder eines Sees (Binnengewässer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b7eb0e-786d-4b62-9bf7-1461ac85f5af",
                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                "text": "„Wenn du mit deiner Luftmatratze vom Strand seewärts treibst, bleibe unbedingt drauf, das ist deine einzige Chance!“"
                            },
                            {
                                "example_id": "703690d4-929f-4739-848a-1a61c2ba51a5",
                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                "text": "Marineboote und -schiffe sicherten den Tagungsort seewärts ab."
                            },
                            {
                                "example_id": "21db3ae6-9249-489a-b890-51ac0ad36fc4",
                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                "text": "„Wir brauchen [für die auf Grund gelaufene Fähre] nur die sprichwörtliche Handbreit Wasser unterm Kiel. Dann könnten wir uns mit Motorenkraft freischwimmen,“ hofft Ackermann. „Da könnte das Hochwasser gerade so reichen.“ Allerdings drückt Ostwind seewärts, da fällt das Hochwasser schon mal niedriger aus."
                            },
                            {
                                "example_id": "cd9ff38e-81df-405e-8f10-cd514a8595ef",
                                "sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                                "text": "Geologisch gesehen sind die Förden aber keine Fjorde, weil letztere durch seewärts wandernde Gletscher entstanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f0a74d3-3631-45ac-af22-ceb0ec1e8e89",
                        "source_entry_id": "02a95388-4099-387f-83f4-6336d92aa700",
                        "source_sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                        "source_sense_description": "in Richtung des Meeres oder eines Sees (Binnengewässer)",
                        "target_lang_word": "seaward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                        "entry_id": "c6521062-6b1d-3b6e-98b5-0ccfd73981ec",
                                        "glosses": [
                                            "Being in or facing towards the sea, as opposed to the land."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4c5ab2c-09c0-4ec8-bb1e-8c5e3fc312bd",
                                                "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                                "text": "The landward side of the fort faced more dangerous guns than the seaward side, which only faced what could be put on a ship."
                                            },
                                            {
                                                "example_id": "a11e846e-fafc-4f46-b089-e949f1e52a91",
                                                "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                                "text": "Following service in the First World War, when it was leased by the Admiralty, it suffered a swift decline. And despite reconstruction efforts, concerns about its safety were raised in the 1930s and its seaward portion was demolished in the 1940s."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seaward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                        "entry_id": "207019e5-875c-3f88-9f96-b627cf0d7816",
                                        "glosses": [
                                            "In the direction of the sea, toward the sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475b1eed-d722-46de-9d0d-e0441e36caf5",
                                                "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                                "text": "Ever the sailor's widow looked seaward, hoping to see her missing man coming home."
                                            },
                                            {
                                                "example_id": "9757665f-1f5e-47eb-86df-7de2db710293",
                                                "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ac5e2a6-ab5e-4801-ab07-2a1bad7a7bcd",
                        "source_entry_id": "02a95388-4099-387f-83f4-6336d92aa700",
                        "source_sense_id": "1ea0aa0e-38a1-3d54-bfc3-dc9840a45978",
                        "source_sense_description": "in Richtung des Meeres oder eines Sees (Binnengewässer)",
                        "target_lang_word": "seawards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seawards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab32254-8d9a-3fef-8e3f-48ec3b6aa10d",
                                        "entry_id": "4888bfc2-a1dd-38f0-9290-3e625bee35c6",
                                        "glosses": [
                                            "Towards the sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29976ae4-a4d3-467a-bac4-cef4dfa568b3",
                                                "sense_id": "0ab32254-8d9a-3fef-8e3f-48ec3b6aa10d",
                                                "text": "We sailed seawards, away from land and straight towards the open sea."
                                            }
