            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe6353a0-6668-367b-ad39-b6230502a5be",
                    "sense_definition": "De bovenkant van de menselijke voet tussen de tenen en de enkel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schoot de bal met de <w>wreef</w> van zijn voet precies in de hoek van het doel.",
                            "target_lang_translations": {
                                "en": "He shot the ball with the <w>instep</w> of his foot right into the corner of the goal.",
                                "pl": "Posłał piłkę <w>podbiciem</w> stopy prosto w róg bramki."
                            }
                        },
                        {
                            "text": "Na een lange wandeling deed zijn <w>wreef</w> veel pijn door de strakke schoenen.",
                            "target_lang_translations": {
                                "en": "After a long walk, his <w>instep</w> hurt a lot because of the tight shoes.",
                                "pl": "Po długim spacerze jego <w>podbicie</w> bardzo bolało z powodu ciasnych butów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met de wreef",
                        "hoge wreef"
                    ],
                    "target_lang_definitions": {
                        "en": "The top part of the human foot between the toes and the ankle.",
                        "pl": "Górna część ludzkiej stopy znajdująca się między palcami a kostką."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "instep",
                                "target_lang_sense_clarification": "top arched part of the human foot"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podbicie",
                                "target_lang_sense_clarification": "górna, wypukła część stopy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "409c2b17-5c49-352e-ae48-8a071f20fb94",
                    "sense_definition": "Enkelvoud verleden tijd van <w>wrijven</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wreef</w> in mijn ogen omdat ik heel moe was.",
                            "target_lang_translations": {
                                "en": "I <w>rubbed</w> my eyes because I was very tired.",
                                "pl": "<w>Tarłem</w> oczy, ponieważ byłem bardzo zmęczony."
                            }
                        },
                        {
                            "text": "Hij <w>wreef</w> over zijn handen om ze op te warmen in de kou.",
                            "target_lang_translations": {
                                "en": "He <w>rubbed</w> his hands to warm them up in the cold.",
                                "pl": "<w>Tarł</w> dłonie, żeby je rozgrzać na mrozie."
                            }
                        }
                    ],
                    "traits": [
