                        "sense_id": "9b9145eb-5267-36be-8618-5906b3d2073c",
                        "entry_id": "2c9c76a8-c15b-3dd0-9ecd-feb8cb713f59",
                        "glosses": [
                            "A type of flat, dry bread or cracker, usually baked of rye flour, popular in the Nordic countries."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "16045a58-2dd8-4a75-9c49-40f060ea5c9a",
                                "sense_id": "9b9145eb-5267-36be-8618-5906b3d2073c",
                                "text": "She describes how Irina, left at home during one of Lawrence’s extended business trips, feels herself turning “into one of those dry Scandinavian crispbreads that never have enough salt.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
