{
    "word_family": [
        "poor",
        "impoverish",
        "impoverishment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b971abb6-3080-3108-83ab-599bd6c12410",
                    "sense_definition": "The state of being extremely poor; a lack of money or material possessions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families in the region live in extreme <w>poverty</w>.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в этом регионе живут в крайней <w>бедности</w>.",
                                "zh": "该地区许多家庭生活在极度<w>贫困</w>之中。"
                            }
                        },
                        {
                            "text": "The government aims to reduce <w>poverty</w> by creating new jobs.",
                            "target_lang_translations": {
                                "ru": "Правительство стремится сократить <w>бедность</w> путем создания новых рабочих мест.",
                                "zh": "政府旨在通过创造就业机会来减少<w>贫困</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "destitution",
                        "penury",
                        "neediness",
                        "indigence",
                        "hardship",
                        "want"
                    ],
                    "antonyms": [
                        "wealth"
                    ],
                    "common_phrases": [
                        "live in poverty",
                        "extreme poverty",
                        "poverty line",
                        "escape poverty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние крайней бедности; отсутствие денег или материальных благ",
                        "zh": "处于极度贫困的状态；缺乏金钱或物质财富。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедность",
                                "target_lang_sense_clarification": "общее состояние нехватки материальных средств"
                            },
                            {
                                "target_lang_word": "нищета",
                                "target_lang_sense_clarification": "крайняя степень бедности, нужда"
                            },
                            {
                                "target_lang_word": "нужда",
                                "target_lang_sense_clarification": "острая потребность в самом необходимом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贫困",
                                "target_lang_sense_clarification": "指生活贫穷，缺乏基本物质条件"
                            },
                            {
                                "target_lang_word": "贫穷",
                                "target_lang_sense_clarification": "指经济状况不好，缺乏钱财"
                            },
                            {
                                "target_lang_word": "贫困线",
                                "target_lang_sense_clarification": "指衡量贫困程度的经济标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e1c4f1b-b7b1-3641-a1fe-290ab23f97db",
                    "sense_definition": "A lack or deficiency of a specific quality or element.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic noted a <w>poverty</w> of original ideas in the novel.",
                            "target_lang_translations": {
                                "ru": "Критик отметил <w>скудность</w> оригинальных идей в романе.",
                                "zh": "评论家指出这部小说缺乏原创思想，显得十分<w>贫乏</w>。"
                            }
                        },
                        {
                            "text": "Crops failed to grow because of the <w>poverty</w> of the soil.",
                            "target_lang_translations": {
                                "ru": "Урожай не вырос из-за <w>скудности</w> почвы.",
                                "zh": "由于土壤<w>贫瘠</w>，庄稼没能长出来。"
                            }
                        }
                    ],
                    "antonyms": [
                        "wealth"
                    ],
                    "common_phrases": [
                        "poverty of imagination",
                        "poverty of speech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие или недостаток определенного качества или элемента",
                        "zh": "指某种特质或要素的匮乏或不足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудность",
                                "target_lang_sense_clarification": "недостаточность, малое количество чего-либо"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "отсутствие нужного количества"
                            },
                            {
                                "target_lang_word": "бедность",
                                "target_lang_sense_clarification": "перен. скудость содержания или состава"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匮乏",
                                "target_lang_sense_clarification": "指资源或某种特质严重不足"
                            },
                            {
                                "target_lang_word": "贫乏",
                                "target_lang_sense_clarification": "指内容、思想或某种品质的单调或不足"
                            },
                            {
                                "target_lang_word": "贫瘠",
                                "target_lang_sense_clarification": "特指土地肥力不足"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}