                        "form_id": "ad604865-d9dd-42c8-a36c-1747a573f798",
                        "entry_id": "0ddc4f80-2b70-3e3c-9d5d-090d7752dfc6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "подслепова́тей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a31100f6-9724-3120-8c89-542050e05e76",
                        "entry_id": "0ddc4f80-2b70-3e3c-9d5d-090d7752dfc6",
                        "glosses": [
                            "плохо видящий, почти слепой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5bf172b-9d09-4700-83fc-9b7bcd891c9d",
                                "sense_id": "a31100f6-9724-3120-8c89-542050e05e76",
                                "text": "Провожать собрались все интеллигенты, начиная с предводителя и кончая подслеповатым пасынком надзирателя Вонючкина."
                            },
                            {
                                "example_id": "1b12160f-1e3b-47d4-806c-57806c9263b2",
                                "sense_id": "a31100f6-9724-3120-8c89-542050e05e76",
                                "text": "Маленький, тощенький, белобрысенький и подслеповатый, в очках и с длинной шевелюрой, при встречах он производил самое незавидное впечатление бурсачка, за нерадение уволенного в архирейский хор."
                            }
                        ]
                    }
