                "senses": [
                    {
                        "sense_id": "5fb6013d-67fa-3695-a023-c01ec8da45ab",
                        "entry_id": "ad1f1e70-20dd-3e7e-b2d9-80a76e2b9d25",
                        "glosses": [
                            "лингв. западногерманский язык, происходящий от нидерландского, один из 11 официальных языков ЮАР, также распространённый в ряде соседних государств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f016f0-db3e-4f70-ac3d-2da6d2823cda",
                                "sense_id": "5fb6013d-67fa-3695-a023-c01ec8da45ab",
                                "text": "Много раз брался учить разные языки, вплоть до китайского и африкаанс (а теперь уже — вплоть до иврита)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
