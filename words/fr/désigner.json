    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64875e85-fb72-34ab-9ba6-9621dd8b00dd",
                    "sense_definition": "Nommer ou choisir quelqu'un pour exercer une fonction, une charge ou une mission.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>désigner</w> un responsable pour coordonner la nouvelle équipe."
                        },
                        {
                            "text": "Après de longues délibérations, le jury a <w>désigné</w> le vainqueur du concours."
                        }
                    ],
                    "common_phrases": [
                        "désigner un successeur",
                        "désigner un responsable",
                        "désigner un représentant"
                    ]
                },
                {
                    "sense_id": "a979bb0e-a2bf-38ac-9f4c-29b0bf50f735",
                    "sense_definition": "Indiquer une personne ou une chose par un geste ou une parole pour la faire reconnaître.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a pu <w>désigner</w> le suspect parmi les personnes convoquées au commissariat."
                        },
                        {
                            "text": "L'enfant a tendu la main pour <w>désigner</w> le jouet exposé dans la vitrine."
                        }
                    ],
                    "synonyms": [
                        "montrer"
                    ],
                    "common_phrases": [
                        "désigner du doigt"
                    ]
                },
                {
                    "sense_id": "89f440a9-6fc5-3e3f-b280-97c3bc2c611d",
                    "sense_definition": "Représenter, signifier ou servir de terme pour exprimer quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En linguistique, ce mot permet de <w>désigner</w> une réalité abstraite très précise."
                        },
                        {
                            "text": "Sur ce plan de la ville, le point bleu <w>désigne</w> la gare centrale."
                        }
                    ],
                    "common_phrases": [
                        "terme pour désigner"
                    ]
                },
                {
                    "sense_id": "f70317af-3bc9-3249-af44-d4381f740ba9",
                    "sense_definition": "Fixer ou déterminer à l'avance un moment ou un lieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "determination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les invités se sont réunis au lieu <w>désigné</w> par les organisateurs de la conférence."
                        },
                        {
                            "text": "Il est arrivé exactement à l'heure <w>désignée</w> pour son entretien d'embauche."
                        }
                    ],
                    "common_phrases": [
                        "à l'heure désignée",
                        "au lieu désigné"
                    ]
                }
            ]
        }
    ]
