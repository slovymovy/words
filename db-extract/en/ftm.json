                                    {
                                        "sense_id": "1b671679-cf36-373f-bbc0-63cb7645160f",
                                        "entry_id": "9472a6c2-efa0-3e59-9b89-f9aa639d4e3f",
                                        "glosses": [
                                            "Variante orthographique de FtM."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b502ab-66ee-47f3-88bf-5333691322c4",
                                                "sense_id": "1b671679-cf36-373f-bbc0-63cb7645160f",
                                                "text": "Je me suis lancé dans la création d'un site internet d’information pour tous les transsexuels FTM avec l’aide de ma chérie afin de partager nos connaissances \"techniques\" et \"humaines\" sur le sujet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "FTM",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91d06b50-6d81-361f-961b-c66ae9ff4d97",
                                        "entry_id": "eb187c34-b209-3435-be42-d685f4a74056",
                                        "glosses": [
                                            "Variante orthographique de FtM."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6887dfe9-c67d-4d59-ac1a-6144a66c20dd",
                                                "sense_id": "91d06b50-6d81-361f-961b-c66ae9ff4d97",
                                                "text": "Ce blog, les forums où je discutais avec d’autres FTM, et tout le reste… Il se passait rarement une heure sans que le fait d’être transsexuel ne me revienne en tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d6de89-fe0f-4cf2-9af0-c530ff493dee",
