                                    },
                                    {
                                        "sense_id": "9fa9a6d5-cd13-3b97-b965-36be423b3849",
                                        "entry_id": "2f6ec847-745d-3f86-9b95-43b909ed4c83",
                                        "glosses": [
                                            "The young bulb of a tulip, not of flowering size."
