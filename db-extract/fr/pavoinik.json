                                "target_senses": [
                                    {
                                        "sense_id": "3062ce34-334e-3426-9851-62718b41babb",
                                        "entry_id": "2e928cdd-ae76-3e2d-aebf-39d43d6f3085",
                                        "glosses": [
                                            "истор. старинный русский будничный головной убор у крестьянок, прежде обычно у замужних, в виде платка, полотенца, повитого вокруг головы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11833a30-e408-4a49-85f4-a84e6856430d",
                                                "sense_id": "3062ce34-334e-3426-9851-62718b41babb",
                                                "text": "Пёстрые платки, повязки, повойники, зипуны, бороды всех родов: заступом, лопатой и клином, рыжие, русые и белые, как серебро, покрыли всю площадь."
                                            },
                                            {
                                                "example_id": "524a96ce-15a3-415e-9469-9e1b70fcf10f",
                                                "sense_id": "3062ce34-334e-3426-9851-62718b41babb",
                                                "text": "Ещё пять лет прошло мимо, а с ними боярыне стукнуло пять десятков, и она наложила на себя старушечий повойник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf70997-67ee-33ad-926f-96bae5c26098",
                                        "entry_id": "2e928cdd-ae76-3e2d-aebf-39d43d6f3085",
                                        "glosses": [
                                            "истор. мягкая шапочка из ткани, имевшая различную форму, но большей частью с круглым или овальным дном, околышем и завязками сзади"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332ba2bc-3a5a-46de-9fcd-3e2bbb3e2946",
                                                "sense_id": "eaf70997-67ee-33ad-926f-96bae5c26098",
                                                "text": "Будничные головные уборы женщин ― повойники в виде шапочки из ситца ― не украшали."
                                            }
                                        ]
                                    }
