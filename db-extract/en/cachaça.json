                                        "entry_id": "c024f098-e436-3a1a-816f-38c14329dcfc",
                                        "glosses": [
                                            "Lentitud, tranquilidad en exceso."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
