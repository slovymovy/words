                "senses": [
                    {
                        "sense_id": "c4710dd1-2203-386c-8f27-d5606a91fa53",
                        "entry_id": "f9172e13-b369-3e59-a508-0a5cdece147e",
                        "glosses": [
                            "Éteindre encore une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa468a3-4f84-47ab-a097-e878f41fd639",
                                "sense_id": "c4710dd1-2203-386c-8f27-d5606a91fa53",
                                "text": "Pouvez-vous rééteindre maintenant, s’il vous plaît ?"
                            },
                            {
                                "example_id": "9f982527-78b1-4a52-b0a2-5f7d2e98f2d8",
                                "sense_id": "c4710dd1-2203-386c-8f27-d5606a91fa53",
                                "text": "Il ne s'agit pas toutefois de revenir en arrière, de rééteindre la lumière, mais d'aller encore plus loin, de réintroduire artificiellement la nuit dans le jour continu de la ville."
                            }
                        ]
                    },
