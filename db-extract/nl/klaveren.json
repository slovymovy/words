                                                "sense_id": "506822aa-5a66-3e9c-a922-08ecd3a66ac6",
                                                "text": "Vor der Note steht ein Kreuz, also ist sie einen Halbton höher."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "94d30833-bc13-3ac0-a80f-314df813cd17",
