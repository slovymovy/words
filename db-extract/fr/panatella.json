                "senses": [
                    {
                        "sense_id": "04d49a29-54f8-3382-8851-20ecf57e5f64",
                        "entry_id": "c56e561c-dae8-31fe-b831-62e7b1f86afb",
                        "glosses": [
                            "Cigare de La Havane, mince et de forme allongée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3845dc3-3c43-488f-b3c9-8dfd933ff7c3",
                                "sense_id": "04d49a29-54f8-3382-8851-20ecf57e5f64",
                                "text": "Je m’allume un nouveau panatella, puis passe à chacun de nous cinq cartes d’un paquet nouvellement ouvert, une à une."
                            },
                            {
                                "example_id": "1ef885e4-7b98-4422-bf4a-f17b48ccaaee",
                                "sense_id": "04d49a29-54f8-3382-8851-20ecf57e5f64",
                                "text": "L'amazone porte éperons et cravache ; si elle ne porte pas moustache, c'est que ses fournisseurs ordinaires n'en tiennent pas ; mais elle se dédommage en portant les culottes dans son intérieur. (…) Elle est de toutes les chasses à courre ; elle boit du kirsch et fume des panatellas."
                            },
                            {
                                "example_id": "df0db94c-98a8-4274-9f72-ce5e5d999177",
                                "sense_id": "04d49a29-54f8-3382-8851-20ecf57e5f64",
                                "text": "Voulant parler contre le tabac, je vous ai invité à allumer un cigare pour m'écouter. Vous voici déjà pris de somnolence. Vous n'avez plus qu'un souci : conserver blanche et intacte la cendre de votre panatellas^([sic])."
                            }
                        ]
                    }
