                        "glosses": [
                            "ungrateful, showing no gratitude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af825af0-725b-43cc-a83f-6339f746eaa7",
                                "sense_id": "bddad49c-2bf0-3ed9-a6cf-830952a89b5b",
                                "text": "Wees niet zo ondankbaar als iemand je een plezier doet.",
                                "translation": "Don't be so ungrateful when someone does you a favor.",
                                "english": "Don't be so ungrateful when someone does you a favor."
                            }
