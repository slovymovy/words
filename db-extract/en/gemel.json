                                            {
                                                "example_id": "d6e42a81-4576-46a7-bf79-58fd9dce4965",
                                                "sense_id": "fcc22fbc-6b24-330d-9ba4-7ecd736c59cc",
                                                "text": "He, Zwilling, komm mal her!"
                                            },
                                            {
                                                "example_id": "3a540f60-619f-43dc-84f2-fb5db9881e79",
                                                "sense_id": "fcc22fbc-6b24-330d-9ba4-7ecd736c59cc",
                                                "text": "Der Zwilling aus dem Nachbarhaus hat schon wieder auf dem Balkon gegrillt."
                                            },
                                            {
                                                "example_id": "64d568e7-29f2-49f8-a8f2-c70e8e710abc",
                                                "sense_id": "fcc22fbc-6b24-330d-9ba4-7ecd736c59cc",
                                                "text": "Die neuen Mieter, diese Zwillings, sind nicht sehr hilfsbereit."
                                            },
                                            {
                                                "example_id": "1af442bb-b4dc-4651-8f2b-e46c0b99c55e",
                                                "sense_id": "fcc22fbc-6b24-330d-9ba4-7ecd736c59cc",
                                                "text": "Die kleine Zwilling ist vielleicht ein Frechdachs!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
