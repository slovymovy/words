                "senses": [
                    {
                        "sense_id": "eaf8afb8-51c7-3b85-98d3-a7235e35fe94",
                        "entry_id": "f1d3436b-622f-39dd-bc2b-730cfdb5fe2a",
                        "glosses": [
                            "Qu’on ne peut pas décacheter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c4d9a0-d1da-461d-9f31-3c172c111262",
                                "sense_id": "eaf8afb8-51c7-3b85-98d3-a7235e35fe94",
                                "text": "L’enveloppe ne peut plus être fermée par un paon à cacheter. Ou elle l’est par la gomme, qui rend la fermeture indécahetable, ou par la cire."
                            },
                            {
                                "example_id": "c25b242e-3edb-49fb-8459-65a62d7bb3b8",
                                "sense_id": "eaf8afb8-51c7-3b85-98d3-a7235e35fe94",
                                "text": "La Maison SUSSE est la seule où l’on vend le papier à lettre dit parchemin, timbré sans frais et délivré en boite à 10 centimes le cahier, ainsi que les enveloppes indécachetables à 4 francs le cent."
                            },
                            {
                                "example_id": "a0e3f822-7c81-4612-9fe8-610041c7c80b",
                                "sense_id": "eaf8afb8-51c7-3b85-98d3-a7235e35fe94",
                                "text": "Maudite enveloppe ! ah ça ! mais elle est donc indécachetable ! Opération césarienne, éventrement."
                            }
                        ]
                    }
                ],
