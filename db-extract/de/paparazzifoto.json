                "senses": [
                    {
                        "sense_id": "1f666283-3738-3b8a-b16c-90b83b5d7b56",
                        "entry_id": "f903b549-fe66-3703-bf57-dfa0be635a97",
                        "glosses": [
                            "reißerisches, von einem Paparazzo geschossenes Foto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a615d35-b92c-4377-a7cd-e1cd0732c7f5",
                                "sense_id": "1f666283-3738-3b8a-b16c-90b83b5d7b56",
                                "text": "„Penny wusste, dass ein solcher Erfolg harte Arbeit und große Opfer erforderte, aber die Paparazzifotos ließen alles so einfach und mühelos aussehen.“"
                            },
                            {
                                "example_id": "2bf9510b-28f5-499e-af27-cbe218223f41",
                                "sense_id": "1f666283-3738-3b8a-b16c-90b83b5d7b56",
                                "text": "„Auf der Titelseite waren drei Paparazzifotos von Jasper Boonstras Geliebter Jenny Abbott zu sehen, die aus ihrem luxuriösen Haus in Franschhoek auszog.“"
                            },
                            {
                                "example_id": "bfa4eaad-e196-43f8-abe1-109485894ec4",
                                "sense_id": "1f666283-3738-3b8a-b16c-90b83b5d7b56",
                                "text": "„Meine Aufgabe war es, als kindliches Äquivalent einer Begleitservicedame aufzutreten, Beweis für die Fruchtbarkeit meiner Mutter und das prächtige genetische Vermächtnis meines Vaters, ein lächelndes Ding auf den Paparazzifotos von meinen Eltern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
