                "senses": [
                    {
                        "sense_id": "f83990b0-96d8-3efc-9871-215316c5b5ab",
                        "entry_id": "22dbee08-7b4a-30af-92b0-2c97bc919677",
                        "glosses": [
                            "snore (act and noise of snoring)"
                        ],
                        "tags": [
