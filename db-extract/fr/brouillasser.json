                ],
                "senses": [
                    {
                        "sense_id": "ad40eac2-029c-3aad-8ba2-c8a7a33c8b1a",
                        "entry_id": "f4330a4b-8136-38cd-a816-87ed1ab0c36d",
                        "glosses": [
                            "Faire de la bruine ou un brouillard épais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99da797-5fef-48b9-b69a-72e260daa9ef",
                                "sense_id": "ad40eac2-029c-3aad-8ba2-c8a7a33c8b1a",
                                "text": "Beaucoup de personnes disent abusivement : « Il brouine , ou il brouillasse. »"
                            },
                            {
                                "example_id": "8ffdcb8d-8f89-4383-b915-b84def3bacc0",
                                "sense_id": "ad40eac2-029c-3aad-8ba2-c8a7a33c8b1a",
                                "text": "Ça brouillassait dans les vignes, il broussinait. Il avait pas mal lichotté au café, et, un peu derne, il manque de s’empierger dans les échalas et de se rétaler."
                            },
                            {
                                "example_id": "9a7beac6-40c4-4024-9979-9921916ff44d",
                                "sense_id": "ad40eac2-029c-3aad-8ba2-c8a7a33c8b1a",
                                "text": "Il s’était exempté de voisiner, en prétextant de ses occupations, de ses habitudes et de sa santé, qui ne lui permettaient pas, disait-il, de revenir la nuit par une route le long de laquelle brouillassait la Thune."
                            },
                            {
                                "example_id": "60a1af1c-0c52-46a4-abce-44128d3dc0b8",
                                "sense_id": "ad40eac2-029c-3aad-8ba2-c8a7a33c8b1a",
                                "text": "Il brouillassait. C’était un de ces temps de Paris, sales et pourris, où il semble que l’eau qui tombe soit déjà de la boue avant d’être tombée."
                            }
                        ]
                    }
                ],
