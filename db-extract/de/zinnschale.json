                                "example_id": "f75c5e02-b5ef-4b28-994d-54a23db174d7",
                                "sense_id": "828eba49-bc8e-395c-a77f-c4d8b461e814",
                                "text": "Da hab ich doch gestern wirklich eine Zinnschale auf dem Dachboden gefunden."
                            },
                            {
                                "example_id": "4a9e9f1b-3e99-448c-bf06-9e8ba92bd3da",
                                "sense_id": "828eba49-bc8e-395c-a77f-c4d8b461e814",
                                "text": "„Sie holte eine Zinnschale mit Wasser und Seifenlauge, legte den Mann auf den Rücken, so daß seine Beine von der Truhe herabhingen.“"
                            }
