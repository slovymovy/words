                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af5297b5-54ad-31da-95bd-1fdbee14dcc3",
                        "entry_id": "8e026d69-a898-3ae4-96d3-702deb0affe5",
                        "glosses": [
                            "всегда, вечно"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a3b845d-c24c-3e21-b408-ed27faad8686",
                        "entry_id": "8e026d69-a898-3ae4-96d3-702deb0affe5",
                        "glosses": [
                            "никогда"
                        ],
                        "tags": [
                            "при глаголе с отрицанием"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17e0a766-b142-4fe2-9c76-c8c403d2282d",
                        "source_entry_id": "8e026d69-a898-3ae4-96d3-702deb0affe5",
                        "source_sense_description": "всегда, вечно",
                        "target_lang_word": "forever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "For all time, for all eternity; for a lifetime; for an infinite amount of time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd58a8b-20e6-419f-a8a7-bb18d6d81d22",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "I shall love you forever."
                                            },
                                            {
                                                "example_id": "94e9e59e-7930-4962-9134-9c0fff250f94",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "Secondly, When a body is once in motion it will continue to move forever, unless something stops it. When a ball is struck on the surface of the earth, the friction of the earth and the resistance of the air soon stop its motion."
                                            },
                                            {
                                                "example_id": "f5d96fd6-3c36-4d2c-8031-12eb488dd464",
                                                "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                                                "text": "If you want a picture of the future, imagine a boot stamping on a human face — for ever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "For a very long time, a seeming eternity."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d39b3d-cfa1-4386-b1f8-6a6c0edf52fd",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "We had to wait forever to get inside."
                                            },
                                            {
                                                "example_id": "a5717684-cca9-464f-a039-deb6e71278e9",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "That was forever ago."
                                            },
                                            {
                                                "example_id": "40fee6cb-05c5-4fe6-ac53-ed80d53bdede",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "She and Serena had been friends forever. Or nearly forever: forty-two years, beginning with Miss Kimmel's first grade."
                                            },
                                            {
                                                "example_id": "b7d8cfee-d02d-44f8-95c7-a24e7620cc52",
                                                "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                                                "text": "Anything in the world of transport takes forever to do, and costs far too much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                        "entry_id": "1773dd74-964b-3e4d-8d64-91402219b3ba",
                                        "glosses": [
                                            "Constantly or frequently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb3893e-ed3d-4843-9324-e0af90fbe665",
                                                "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                                "text": "You are forever nagging me."
                                            },
                                            {
                                                "example_id": "e4acd009-5c40-4c2c-882b-4e8a0f845361",
                                                "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                                                "text": "Early in his boyhood he had learned to form ropes by twisting and tying long grasses together, and with these he was forever tripping Tublat or attempting to hang him from some overhanging branch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                        "entry_id": "0ef3f3f7-d841-35cb-976b-fa68e5858f82",
                                        "glosses": [
                                            "An extremely long time."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c1e8ae-5983-4495-99c8-6dce996827ec",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "I haven't seen him in forever!"
                                            },
                                            {
                                                "example_id": "b89417ca-93c5-4c09-bfce-c0308603e18f",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "It took me forever to make up my mind."
                                            },
                                            {
                                                "example_id": "4d0c5b88-5016-42a4-82dc-65d91e5dd51a",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "Don't spend forever on the phone!"
                                            },
                                            {
                                                "example_id": "99f4827e-6be2-4f21-ba2d-5f3e6da8f064",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "She should've been here five forevers ago!"
                                            },
                                            {
                                                "example_id": "a70d01cb-b30f-4854-ba49-7551a7d54e60",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "It's been a fortnight of forevers since the Braves could count on a late-game comeback."
                                            },
                                            {
                                                "example_id": "9cfe283e-5adb-42b2-984e-39a7b8103511",
                                                "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                                                "text": "In the airport, holiday lovers kiss, mouth forevers, the usual argot betrays you. Desire makes love dull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ed1d6d-6219-3c99-867c-76f093b09ce2",
                                        "entry_id": "0ef3f3f7-d841-35cb-976b-fa68e5858f82",
                                        "glosses": [
                                            "A mythical time in the future that will never come."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c891c739-5e07-47b6-a240-a1d72d5b878c",
                                                "sense_id": "a1ed1d6d-6219-3c99-867c-76f093b09ce2",
                                                "text": "Sure, I'd be happy to meet with you on the 12th of forever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                        "entry_id": "60dd6139-fd18-3b85-b07b-40eb2fe3fba5",
                                        "glosses": [
                                            "Permanent, lasting; constant, perpetual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370b5dc8-a681-4335-8243-3281633df92c",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "It'd be a peaceful life / With a forever wife / And a kid someday"
                                            },
                                            {
                                                "example_id": "b0d38ca2-3b9a-43a3-b1b2-8c402578a794",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "We'll take care of you and help you find a Forever Home."
                                            },
                                            {
                                                "example_id": "f3dc286d-733f-4c79-8450-caed7e9540d0",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "He is a forever friend."
                                            },
                                            {
                                                "example_id": "7cb42831-5510-49f3-9b48-57535b975eac",
                                                "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                                                "text": "Danner posits that the United States has been trapped in a \"forever war\" by 9/11, and describes a nation that has been altered in fundamental ways by President Bush's having declared a war of choice and without an exit plan, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c16d16f-a846-4772-95e3-467707b4c701",
                        "source_entry_id": "8e026d69-a898-3ae4-96d3-702deb0affe5",
                        "source_sense_description": "всегда, вечно",
                        "target_lang_word": "always",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "always",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "At all times; throughout all time; since the beginning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b1048c-016a-4312-98cf-cef24fcb655e",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "God is always the same."
                                            },
                                            {
                                                "example_id": "247dca47-5a2a-4392-a08a-d71d2058aae3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Green has always been my favorite color. I’ve loved it for as long as I can remember."
                                            },
                                            {
                                                "example_id": "e604797a-8906-4603-81cd-d2c45f4e5fc0",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Airplanes did not always exist as a form of transportation."
                                            },
                                            {
                                                "example_id": "00e2fdfb-15a9-4f40-a240-a59b2f00ccb3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "Constantly during a certain period, or regularly at stated intervals (opposed to sometimes or occasionally)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed5dc33-9b90-41fe-aa21-2b00eb8056d3",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "In this street, the shops always close during lunchtime."
                                            },
                                            {
                                                "example_id": "fd75fa21-b5bd-4837-a692-2954b04117df",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "His liveries are black,—his carriage is black,—he always rides a black galloway,—and, faith, if he ever marry again, I think he will show his respect to the sainted Maria by marrying a black woman."
                                            },
                                            {
                                                "example_id": "18121f5c-e758-4cd3-82e9-2f1ab0d5ef52",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "2550f152-88c4-4595-b96a-39b8d2b264f1",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "And so it had always pleased M. Stutz to expect great things from the dark young man whom he had first seen in his early twenties ; and his expectations has waxed rather than waned on hearing the faint bruit of the love of Ivor and Virginia—for Virginia, M. Stutz thought, would bring fineness to a point in a man like Ivor Marlay,[…]."
                                            },
                                            {
                                                "example_id": "d6715328-d62c-4a80-8b5e-f0e0f60260c0",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            },
                                            {
                                                "example_id": "64f5eb36-5e62-40fd-a1c6-b960fe0db509",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "She used to always talk about how she wished she had time to write all day, but now she had the time, she never even went near the typewriter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "if necessary, or if there is no better option; in any event."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c452717-8129-42ad-af27-1ddbb2bedff5",
                                                "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                                "text": "I thought I could always go back to work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81b99245-f091-4233-b882-9149101308a1",
                        "source_entry_id": "8e026d69-a898-3ae4-96d3-702deb0affe5",
                        "source_sense_description": "никогда",
                        "target_lang_word": "never",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "never",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "At no time; on no occasion; in no circumstance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3dc271-8ba3-402b-9c25-ec6d42fe8663",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "I finally finished, and I never do wanna do it again."
                                            },
                                            {
                                                "example_id": "7eb84767-e693-4e2b-b218-d9662c591c03",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "We were at the same college, but happened never to meet."
                                            },
                                            {
                                                "example_id": "eac52bb3-1dfb-4d8f-99a7-521ac4f9727f",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "I'll never not like you."
                                            },
                                            {
                                                "example_id": "5d56e62e-970c-47e5-8830-81dc94a2ad19",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "Why should I love this Gentleman? Tis odds / He never will affect me;"
                                            },
                                            {
                                                "example_id": "8f878594-0075-4ea4-a675-3ea46321fae2",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "194a4f51-a514-43f8-b862-75149774953d",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "\"I never thought you were so fond of Mr. Phillips that you'd require two handkerchiefs to dry your tears just because he was going away,\" said Marilla."
                                            },
                                            {
                                                "example_id": "e4e844e1-03c0-4c32-8ec1-db02d35cd330",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "Never speak of the symptoms of your patient in his presence, unless questioned by the doctor, whose orders you are always to obey implicitly."
                                            },
                                            {
                                                "example_id": "eccacf82-3594-4247-a345-26baec99a048",
                                                "sense_id": "29d586a7-85cf-3422-8f5b-98fdecdd6ab1",
                                                "text": "\"You don't believe the Soviet Union is going to reduce its defense budget, do you?\" Boggs asked.\nPremier Chou didn't wait for the translator to finish. \"Never, never, never,\" he replied in perfect English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "Not at any other time; not on any other occasion; not previously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45cace57-6971-405c-bb8c-b94380566cf3",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "There is no jewel, be it of never so rich a price, which I set before this jewel: I mean your love."
                                            },
                                            {
                                                "example_id": "087214b7-23df-4be4-b930-d45ee349aa84",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "\"He is just what a young man ought to be,\" said she, \"sensible, good-humoured, lively; and I never saw such happy manners!--so much ease, with such perfect good breeding!\""
                                            },
                                            {
                                                "example_id": "ca84eb67-55d8-4588-84f9-1d275b4fcef6",
                                                "sense_id": "37f4e3af-6948-3d27-b228-79bc6eec21da",
                                                "text": "1908, Lucy Maud Montgomery, Anne of Green Gables, Chapter XIII: The Delights of Anticipation,\nI never saw such an infatuated man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                        "entry_id": "e92bab11-f545-3a1d-b9c6-b9d91325f67c",
                                        "glosses": [
                                            "Negative particle (used to negate verbs in the simple past tense; also used absolutely)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d40e00-d5fd-4b5d-838b-e7ff84231337",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "The police say I stole the car, but I never did it."
                                            },
                                            {
                                                "example_id": "7bebde1c-c551-4888-a1e3-8245559a932c",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "You said you were going to mow the lawn today. – I never!"
                                            },
                                            {
                                                "example_id": "3f3e3876-bc92-4842-bc6d-c886bbf80b7b",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "\"You're never going to break in?\"\n\"This instant, if you'll, help me; in five or ten minutes, if you won't.\""
                                            },
                                            {
                                                "example_id": "55c71787-b90d-44da-99d8-d3c62c643286",
                                                "sense_id": "304c1e91-723a-37ab-8e63-123088fde291",
                                                "text": "Well I looked at Jay and I said \"hey, did you hear what I just heard?\"\nHe nodded his head and his face turned red and he never said a word"
                                            }
                                        ]
                                    }
                                ]
                            },
