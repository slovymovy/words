                "senses": [
                    {
                        "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                        "entry_id": "77edd9ae-c353-38f7-9f95-821bc7dad306",
                        "glosses": [
                            "Staatsbürger von Mosambik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a22fd8-1607-4db3-bc97-77e889375cc2",
                                "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                                "text": "Der Mosambikaner vom Kiosk an der Ecke grüßt stets sehr freundlich."
                            },
                            {
                                "example_id": "dd3d9019-c591-4b5b-97d5-f7300e5db901",
                                "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                                "text": "„Nur Machels mahnende Worte, nicht denselben Fehler zu begehen wie die Mosambikaner und die Siedler mitsamt ihrem Know-how zu vertreiben, ermöglichten nach 1980 die Versöhnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
