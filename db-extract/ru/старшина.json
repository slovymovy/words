                                "example_id": "d3444b49-befb-44a9-bd5a-06361e0606ae",
                                "sense_id": "6a1c45cf-2c80-3026-948d-bf57379ed8fb",
                                "text": "Старшина находится в каптёрке."
                            },
                            {
                                "example_id": "7b7ea71c-23c7-4b84-9374-ea4ac6b1252b",
                                "sense_id": "6a1c45cf-2c80-3026-948d-bf57379ed8fb",
                                "text": "Старшина выдает солдатам обмундирование."
                            }
                        ]
