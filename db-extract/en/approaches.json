                                        "entry_id": "94b8a082-3710-3045-a13a-0540e9adc4f4",
                                        "glosses": [
                                            "een poging om meer bevriend met iemand te worden, of minder vijandig te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf844c72-991a-4780-88ad-7bc1e3f43fb6",
                                                "sense_id": "400a0a42-883b-30ee-8a6a-0affd3295656",
                                                "text": "Zowel Fillon als Le Pen pleiten voor toenadering tot Moskou, beiden hebben warme banden met het Kremlin. Maar Macron wil, net als deze twee, de voor het Franse bedrijfsleven pijnlijke sancties tegen Rusland opheffen – mits de akkoorden van Minsk over Oekraïne worden uitgevoerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
