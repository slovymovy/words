                        "sense_id": "1000d583-f09a-3932-b404-7b1575ff2a9f",
                        "entry_id": "a9d86997-56d6-3cf4-afff-033385a400fb",
                        "glosses": [
                            "mess, chaos"
                        ],
                        "tags": [
                            "colloquial",
