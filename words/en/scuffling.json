{
    "word_family": [
        "scuffle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaa1202a-c1c9-3309-b8f4-8864c1f84713",
                    "sense_definition": "A short, confused, and often minor physical fight or struggle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived just as the <w>scuffling</w> in the alleyway began to escalate.",
                            "target_lang_translations": {
                                "cs": "Policie dorazila právě ve chvíli, kdy <w>potyčka</w> v uličce začala nabírat na intenzitě."
                            }
                        },
                        {
                            "text": "There was some minor <w>scuffling</w> between the players after the referee made a controversial call.",
                            "target_lang_translations": {
                                "cs": "Po kontroverzním rozhodnutí rozhodčího došlo mezi hráči k menší <w>strkanici</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussle",
                        "skirmish",
                        "fracas"
                    ],
                    "common_phrases": [
                        "minor scuffling",
                        "brief scuffling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Krátká, zmatená a často drobná fyzická potyčka nebo zápas."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "potyčka",
                                "target_lang_sense_clarification": "obecné označení pro krátký fyzický konflikt"
                            },
                            {
                                "target_lang_word": "strkanice",
                                "target_lang_sense_clarification": "konflikt zahrnující postrkování a menší fyzický kontakt"
                            },
                            {
                                "target_lang_word": "šarvátka",
                                "target_lang_sense_clarification": "menší, často nepřehledný střet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13d1ddab-63fc-3aea-9514-a2e59d586c70",
                    "sense_definition": "Present participle and gerund of <w>scuffle</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two boys were <w>scuffling</w> over a toy when their mother walked into the room.",
                            "target_lang_translations": {
                                "cs": "Ti dva chlapci se <w>prali</w> o hračku, když do místnosti vešla jejich matka."
                            }
                        },
                        {
                            "text": "He was <w>scuffling</w> with the intruder before he managed to push him out the door.",
                            "target_lang_translations": {
                                "cs": "Než se mu podařilo vetřelce vytlačit ze dveří, <w>pral se</w> s ním."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussling",
                        "grappling"
                    ],
                    "common_phrases": [
                        "scuffling with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb scuffle."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'scuffle' (prát se, strkat se)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prát se",
                                "target_lang_sense_clarification": "fyzicky se přetahovat nebo zápasit"
                            },
                            {
                                "target_lang_word": "strkat se",
                                "target_lang_sense_clarification": "vzájemné postrkování v rámci konfliktu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}