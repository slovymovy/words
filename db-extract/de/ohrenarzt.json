                                "sense_id": "7e9797ff-35da-3adf-9a76-ca4d4c410353",
                                "text": "Morgen habe ich einen Termin beim Ohrenarzt."
                            },
                            {
                                "example_id": "486e3f08-0f30-4ab7-ae45-8c18fee3433c",
                                "sense_id": "7e9797ff-35da-3adf-9a76-ca4d4c410353",
                                "text": "Mein Hausarzt hat mir empfohlen, wegen meiner Hörstörung einen Ohrenarzt aufzusuchen."
                            }
                        ],
