                    {
                        "translation_id": "084ac62f-fd7f-4247-b52d-7013b1b8021a",
                        "source_entry_id": "bd038e9c-e9ab-39a3-bf01-f220ef93ebec",
                        "source_sense_id": "ed93e710-22d4-3c37-8240-be5499442c80",
                        "target_lang_word": "série télévisée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "série télévisée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6872a70-c714-32cb-990f-88234a0885cd",
                                        "entry_id": "32a225e5-d591-3e39-81cc-bde1444342c0",
                                        "glosses": [
                                            "Œuvre de fiction télévisuelle qui se déroule en plusieurs parties, chacune d’une durée généralement équivalente appelée « épisode »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b09bee-3ff3-4568-84b2-94a7abed53d1",
                                                "sense_id": "c6872a70-c714-32cb-990f-88234a0885cd",
                                                "text": "Le mot \"Soap\" dérive du fait que cette forme de série télévisée était à l’origine sponsorisée par des lessiviers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693b5032-5972-4626-ac52-7106e2bb707d",
                        "source_entry_id": "bd038e9c-e9ab-39a3-bf01-f220ef93ebec",
                        "source_sense_id": "ed93e710-22d4-3c37-8240-be5499442c80",
                        "target_lang_word": "téléfilm",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléfilm",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07f011e4-44bc-3a7e-9d29-d2b829086a07",
                                        "entry_id": "c5d8bdda-4d9b-3235-afd0-0e857e34ae8c",
                                        "glosses": [
                                            "Film de fiction tourné pour la télévision, par opposition aux films tournés pour le cinéma ou la vidéo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b8ab04-f2a1-4178-baef-3511ee394e55",
                                                "sense_id": "07f011e4-44bc-3a7e-9d29-d2b829086a07",
                                                "text": "Il sait toutefois d'expérience que ce type de quête testimoniale - […] – exige un temps et une patience infinis ; impossible de la boucler en trois coups de cuillère à pot comme dans les téléfilms où les poulets élucident un double meurtre en une heure et demie montre en main, pause-café comprise."
                                            },
                                            {
                                                "example_id": "00deefea-a8f6-484f-af09-61766741ffcb",
                                                "sense_id": "07f011e4-44bc-3a7e-9d29-d2b829086a07",
                                                "text": "Soudain Ann crache la banale évidence d’un vaudeville – la femme, le mari, la maîtresse, matière invraisemblable d’un vulgaire mélodrame, d’un piètre téléfilm, pourtant ils n’ont même pas la télévision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
