        "fr-extract.jsonl": [
            {
                "entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                "word": "minutie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce7066bb-b836-49a5-a38c-a415147399c4",
                        "entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "tags": [
                            "plural"
                        ],
                        "form": "minuties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00fd11ae-e539-35f2-a318-64464d42a997",
                        "entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "glosses": [
                            "Chose de peu d’importance."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7ccafd17-2ec2-4bd9-8249-ac10872c9cd2",
                                "sense_id": "00fd11ae-e539-35f2-a318-64464d42a997",
                                "text": "Le teint de madame de Chasteller avait cette fraîcheur inimitable qui semble annoncer une âme trop haut placée pour être troublée par les minuties vaniteuses et les petites haines d’un bal de province."
                            },
                            {
                                "example_id": "2e02e5d1-bf17-4f3d-94b0-e6e8d903e748",
                                "sense_id": "00fd11ae-e539-35f2-a318-64464d42a997",
                                "text": "L'essentiel pour les jésuites, c'était d'affaiblir, d'amoindrir, de rendre les âmes faibles et fausses, de faire des petits très-petits, et les simples idiots ; une âme nourrie de minuties, amusées de brimborions, devait être facile à conduire."
                            },
                            {
                                "example_id": "72f2687e-188e-4f83-ab2a-c453e1a0fc64",
                                "sense_id": "00fd11ae-e539-35f2-a318-64464d42a997",
                                "text": "De ma tendre enfance je ne parlerai pas. […]. Eussé-je autrement décidé que je me garderais du ridicule qui s'attache à quiconque fait un sort aux minuties du premier âge."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e35628d-bbd4-36b4-8574-4b8b8991ad8a",
                        "entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "glosses": [
                            "Application attentive aux menus détails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a5bca5e-cdc2-4221-b693-0bbb6bc8b002",
                                "sense_id": "8e35628d-bbd4-36b4-8574-4b8b8991ad8a",
                                "text": "Ce culte pour sa personne, défaut qu’il poursuivait jadis de ses railleries, il le poussa jusqu’à la minutie."
                            },
                            {
                                "example_id": "2f88f464-0624-4283-a88b-31802ae14d5f",
                                "sense_id": "8e35628d-bbd4-36b4-8574-4b8b8991ad8a",
                                "text": "Exceptis excipiendis, répliqua l’ermite, comme notre vieux prieur m’a enseigné de répondre quand des laïques impertinents me demandent si j’observe toutes les minuties de mon ordre."
                            },
                            {
                                "example_id": "e79293fc-e170-4661-8d5c-d94a9486a93c",
                                "sense_id": "8e35628d-bbd4-36b4-8574-4b8b8991ad8a",
                                "text": "Telles furent les opérations qui furent conduites avec cette patience et cette minutie pendant plus d’un mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "578ee2fd-d279-371f-b6e4-9ec6f1f95cec",
                        "entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "glosses": [
                            "Point caractéristique formé par la disposition des lignes papillaires."
                        ],
                        "tags": [
                            "Anthropométrie"
                        ],
                        "examples": [
                            {
                                "example_id": "0f0e2710-09dd-4542-9d5f-951c0ba4962d",
                                "sense_id": "578ee2fd-d279-371f-b6e4-9ec6f1f95cec",
                                "text": "Pendant la phase d'enrolement l'empreinte de l'utilisateur est enregistrée puis traitée pour en extraire les singularités ou minutie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f338d20-7814-4a22-aa41-e51866228980",
                        "source_entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "source_sense_description": "Application attentive aux menus détails",
                        "target_lang_word": "Gründlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gründlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                        "entry_id": "2bfc5916-689f-3261-ab9b-5bb3077df806",
                                        "glosses": [
                                            "Gründlichsein; gründliche Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84a788e-8e20-4fce-b23f-67774dc036b1",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "Mit verminderter Gründlichkeit ging er hier ans Werk."
                                            },
                                            {
                                                "example_id": "f31e312a-58e2-4cf3-afee-f94d64add36b",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "„Auf alle Vorstellungen Denissows, er solle dableiben, antwortete Petja nur, er sei ebenso wie Dolochow an klare Verhältnisse und Gründlichkeit gewöhnt und tue nichts blindlings, und die Gefahr mache ihm nichts aus.“"
                                            },
                                            {
                                                "example_id": "d3ee619c-5cd0-4b37-befa-320f97605736",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "„Er verhimmelt seine Tüchtigkeit, seine Gründlichkeit, seinen Gehorsam, seine Ordnungsliebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad35a9a7-01a3-4b76-b606-721cb84c9570",
                        "source_entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "source_sense_description": "Application attentive aux menus détails",
                        "target_lang_word": "Kleinlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e96570fd-f710-43a7-aca9-efbf14a3fdbb",
                        "source_entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "source_sense_description": "Application attentive aux menus détails",
                        "target_lang_word": "Akkuratesse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkuratesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                        "entry_id": "f76b2371-426a-3223-a063-1dec1eb7ac57",
                                        "glosses": [
                                            "die Sorgfalt, die Gründlichkeit, mit der eine Handlung ausgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a0cbf9-52a8-4a96-b4d4-d5fc6cf07cb7",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Ein Mann von solcher Akkuratesse, von solchem Scharfsinn … Ihre vorgesetzte Behörde muß Sie einfach schätzen, muß schließlich Verständnis für Sie gewinnen!“"
                                            },
                                            {
                                                "example_id": "16d6923d-d9d2-4dc8-a8fb-bf88e78dbffe",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Auf der einen Seite treibt der Staat seine Steuern mit der Strenge und Akkuratesse des Rechtsstaates ein.“"
                                            },
                                            {
                                                "example_id": "f07508ca-53ad-4421-9ce4-94bd2cd7cfba",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Dem Motiv ‚Neid‘ kommt die zentrale Rolle zu: Selten sah man diese Emotion mit derart abstoßender Akkuratesse dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                        "entry_id": "f76b2371-426a-3223-a063-1dec1eb7ac57",
                                        "glosses": [
                                            "die Art einer Arbeit, die mit höchster Sorgfältigkeit durchgeführt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d923939d-a8fe-4420-8068-687e57e4fda3",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„An die zurücktretenden Winkel der einen fügen sich mit geometrischer Akkuratesse die herausspringenden Winkel der andern.“"
                                            },
                                            {
                                                "example_id": "6943debb-7f30-4a7b-8e7a-f5c857be9459",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„Ein Lichtblick nicht nur dank klanglicher Akkuratesse, sondern auch auf Grund spielerischen Engagements, das in den Dialogen mit Nicholas Ofczarek zuweilen zu großer theatralischer Intensität anschwoll.“"
                                            },
                                            {
                                                "example_id": "0c2e9ca3-e01b-4d3e-b300-9d195423dcd8",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„Zwar entspricht das nicht einmal einem Promille des gesamten Genoms des Ursäugers, doch nach Kontrollrechnungen bescheinigten die Genarchäologen ihrem Ergebnis im Fachblatt Genome Research 98 Prozent Akkuratesse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c4ece44-2d3e-406a-b14b-b04c629c4207",
                        "source_entry_id": "4c1de7dc-8568-3492-8ee7-a369deb63c41",
                        "source_sense_description": "Application attentive aux menus détails",
