                        "sense_id": "760a3c23-1f27-3e65-8933-456f5d164d5d",
                        "entry_id": "4e33d711-c267-34fa-b327-e88b4d042cfc",
                        "glosses": [
                            "Fait de piétonniser, d’établir des zones piétonnières."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b7919ed8-c0ab-448d-a669-a6f5ac2e2391",
                                "sense_id": "760a3c23-1f27-3e65-8933-456f5d164d5d",
                                "text": "Pourtant, cet habitant du XVIIIᵉ n’est pas un opposant acharné de la piétonnisation."
                            },
                            {
                                "example_id": "cb646475-54e5-45f3-a926-9a8d4f745258",
                                "sense_id": "760a3c23-1f27-3e65-8933-456f5d164d5d",
                                "text": "Un brouillard de chiffres aussi épais qu’un nuage de particules fines vient de saluer le premier anniversaire de la piétonnisation de la voie sur berge rive droite, dans le centre de la capitale."
                            },
                            {
                                "example_id": "06fdbb81-ac5c-4fd7-919d-db00d7674039",
                                "sense_id": "760a3c23-1f27-3e65-8933-456f5d164d5d",
                                "text": "L’expression vise tour à tour la circulation alternée ou différenciée et la vignette Crit’Air, les mesures antidiesel, la piétonnisation des berges de Seine ou l’extension des pistes cyclables."
                            }
                        ]
                    }
