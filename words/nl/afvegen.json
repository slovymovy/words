{
    "word_family": [
        "vegen",
        "veger",
        "veeg",
        "schoonvegen",
        "uitvegen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06e4019e-9f59-3632-914a-f27ddccd7b48",
                    "sense_definition": "met een doekje, papiertje of de hand vuil of vloeistof van iets verwijderen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest eerst zijn handen <w>afvegen</w> voordat hij de man kon feliciteren.",
                            "target_lang_translations": {
                                "en": "He first had to <w>wipe</w> his hands before he could congratulate the man."
                            }
                        },
                        {
                            "text": "Je moet je mond <w>afvegen</w> met een servet na het eten.",
                            "target_lang_translations": {
                                "en": "You should <w>wipe</w> your mouth with a napkin after eating."
                            }
                        }
                    ],
                    "synonyms": [
                        "schoonvegen",
                        "afpoetsen"
                    ],
                    "common_phrases": [
                        "handen afvegen",
                        "mond afvegen",
                        "tafel afvegen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove dirt or liquid from something using a cloth, paper, or the hand"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wipe",
                                "target_lang_sense_clarification": "to clean a surface by rubbing"
                            },
                            {
                                "target_lang_word": "wipe off",
                                "target_lang_sense_clarification": "to remove something from a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "980668d4-8fee-3432-b9cf-731e842ff644",
                    "sense_definition": "iets door een vegende beweging van een oppervlak verwijderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>veegde</w> het stof van de oude boeken <w>af</w>.",
                            "target_lang_translations": {
                                "en": "He <w>wiped</w> the dust off the old books."
                            }
                        },
                        {
                            "text": "Kun je die kruimels even van de tafel <w>afvegen</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>wipe</w> those crumbs off the table?"
                            }
                        }
                    ],
                    "synonyms": [
                        "wegvegen"
                    ],
                    "common_phrases": [
                        "stof afvegen",
                        "kruimels afvegen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove something from a surface with a sweeping motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wipe off",
                                "target_lang_sense_clarification": "to remove particles or dust"
                            },
                            {
                                "target_lang_word": "brush off",
                                "target_lang_sense_clarification": "to remove with a quick movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf0aaeb2-8e85-363f-9c61-abcf4c165259",
                    "sense_definition": "met een scherp voorwerp een snijdende beweging maken, vaak langs de keel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "snijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die gewelddadige film dreigde de schurk iemands keel <w>af te vegen</w>.",
                            "target_lang_translations": {
                                "en": "In that violent movie, the villain threatened to <w>slit</w> someone's throat."
                            }
                        },
                        {
                            "text": "De piraat <w>veegde</w> met zijn zwaard de keel van zijn vijand <w>af</w>.",
                            "target_lang_translations": {
                                "en": "The pirate <w>cut</w> his enemy's throat with his sword."
                            }
                        }
                    ],
                    "synonyms": [
                        "afsnijden",
                        "doorsnijden"
                    ],
                    "common_phrases": [
                        "de keel afvegen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis is verouderd en wordt zelden meer gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to make a cutting motion with a sharp object, often along the throat"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slit",
                                "target_lang_sense_clarification": "to cut a long straight opening"
                            },
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to slice through"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}