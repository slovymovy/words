                                "example_id": "faef4a6a-4ce7-4c8f-af2b-861eda7d36a0",
                                "sense_id": "57f488c1-ce49-359e-94fc-934e39d3b008",
                                "text": "There shall not a sin be left unenquired after, or concealed when found; for the first step towards heaven is to see and lament the near approaches we have made to Hell."
                            },
                            {
                                "example_id": "993c189a-109b-45e8-b294-fe5fcacbfb7c",
                                "sense_id": "57f488c1-ce49-359e-94fc-934e39d3b008",
                                "text": "The chapels of the Calvinists would have been closed, but private opinion would have remained unenquired into, and the Protestants of Holland and Flanders would have been in the same position as the Catholics in England."
                            }
                        ]
                    }
