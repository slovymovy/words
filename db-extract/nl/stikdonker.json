                                        "glosses": [
                                            "Intense darkness with no light whatsoever."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94871935-1d54-40a9-a0b4-37fc17e37877",
                                                "sense_id": "d028bd36-cbda-39dd-add4-f25b0490fa9c",
                                                "text": "To go through this experience in bitter winter weather and stumble along the line in the pitch darkness at 6 o'clock in the morning, into an icy-cold foundry, as was the writer's experience, was not too good."
                                            },
                                            {
                                                "example_id": "bbb63ef2-9ec4-4613-bf89-c861c3642d51",
                                                "sense_id": "d028bd36-cbda-39dd-add4-f25b0490fa9c",
                                                "text": "The trip is interesting, but hard to describe in pitch darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
