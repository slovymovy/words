                ],
                "senses": [
                    {
                        "sense_id": "4b726945-96e5-37f8-aacc-96959c06a190",
                        "entry_id": "ba8d55fc-63bd-3279-89d9-52fcfeb422a3",
                        "glosses": [
                            "Faire perdre son caractère historique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ec9da1-b4d9-4252-9aaf-dc69c2c90f69",
                                "sense_id": "4b726945-96e5-37f8-aacc-96959c06a190",
                                "text": "Tout cela est très précis, et pourtant, il me semble qu'il faut « désanecdotiser », déshistoriciser, pour le dire comme ça... ne serait ce que pour éviter le kitsch, le convenu."
                            },
                            {
                                "example_id": "17840e48-0494-43fa-974a-205362f64241",
                                "sense_id": "4b726945-96e5-37f8-aacc-96959c06a190",
                                "text": "On cherche aujourd'hui à déshistoriciser Miron."
                            },
                            {
                                "example_id": "fe1c82a2-5363-4b54-946f-439e6b96dc4f",
                                "sense_id": "4b726945-96e5-37f8-aacc-96959c06a190",
                                "text": "Ils n'en contribuent pas moins à déshistoriciser les cultures des « Autres », en s'efforçant de les entourer d'une sorte de « magie »."
                            }
                        ]
                    }
