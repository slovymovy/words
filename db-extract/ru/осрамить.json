                                        "examples": [
                                            {
                                                "example_id": "73b5c8ae-f0c0-4747-9a00-b5ce2653a3d3",
                                                "sense_id": "c38a8a57-6649-3e2f-83ae-9320c9a571e2",
                                                "text": "She says that she doesn't touch them, this is important, sometimes maybe a handshake may make them more shame, that is shy or embarrassed."
