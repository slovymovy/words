                        "entry_id": "fdd2dc07-2e99-3609-8bff-38f377179093",
                        "glosses": [
                            "Resembling or characteristic of a mire; swampy, boggy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b536c29-d7bd-4c71-9371-1cafbc6539dc",
                                "sense_id": "2beade46-049d-38c6-9a25-e651cb5cfd76",
                                "text": "Only these marishes and myrie bogs, / In which the fearefull ewftes do build their bowres, / Yeeld me an hostry mongst the croking frogs […]."
                            },
                            {
                                "example_id": "4d4e9f22-cc51-4918-b73f-51a15d18df02",
                                "sense_id": "2beade46-049d-38c6-9a25-e651cb5cfd76",
                                "text": "summer was long over, and cold and frost and miry ways kept them much indoors […]"
                            },
                            {
                                "example_id": "de6282d3-9b66-4050-abd0-84567730b171",
                                "sense_id": "2beade46-049d-38c6-9a25-e651cb5cfd76",
                                "text": "Beyond the bazaar one could see the huge, miry river.\""
                            }
                        ]
                    }
                ],
