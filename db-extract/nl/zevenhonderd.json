                                "sense_id": "ce4cf474-cf07-3634-ab6a-03aad972d22e",
                                "text": "Als jij zevenhonderd opruimt doe ik de twee kamers daarna wel, want die zijn kleiner."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74e697e-29c8-33d8-bbcc-52b702aef2ae",
                        "entry_id": "84fd3f8c-fcfe-3245-bdc7-614759edb73b",
                        "glosses": [
