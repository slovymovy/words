                    {
                        "sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "glosses": [
                            "The quality of being jaunty."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30432ac4-2204-4937-bb8c-435ed63c800e",
                                "sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                                "text": "\"That jauntiness of air I was once master of.\" - Joseph Addison"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab259f4d-a849-489b-87c5-ddc8b874e5da",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Unbeschwertheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbeschwertheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                        "entry_id": "d42ec561-8392-3abc-8c06-ed44ada494c8",
                                        "glosses": [
                                            "psychischer Zustand, von nichts belastet/beschwert zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e414e372-db39-4842-a0b0-2fb9586ab234",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Unbeschwertheit würde es wohl nur noch in wenigen Sekunden des temporären Vergessens geben.“"
                                            },
                                            {
                                                "example_id": "251a9b2a-5d9c-4a08-83b2-62642f4356a1",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Er schnitt lustige Themen an; ich unterstützte ihn, aber bei weitem nicht mit der Unbeschwertheit, die uns im Wagen so herzlich lachen ließ.“"
                                            },
                                            {
                                                "example_id": "13030c85-b5a4-4e7b-9e1d-ceeb4b788757",
                                                "sense_id": "7c55baaf-c317-36fd-b3a5-336a581ff342",
                                                "text": "„Mit Beginn des Ersten Weltkriegs endete die Unbeschwertheit im Hause Schmidt – jäh riss der heitere, um Babygewicht, erste Zähnchen und Schrittchen kreisende Ton im Tagebuch der Familie ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42280228-8f62-449f-b004-503b96191b3f",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Sorglosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorglosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                        "entry_id": "17b7c2a3-95ce-36a5-ba3e-2b8ca87c5889",
                                        "glosses": [
                                            "Einstellung/Gefühl, sich keine Sorgen machen zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df8a888-168c-4d69-a821-f88d15ac78d6",
                                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                                "text": "„Das entsprach wohl so der Sorglosigkeit ihrer Generation, die ihm infolge eines Mißverständnisses das Theater füllte und von der er keine Ahnung hatte.“"
                                            },
                                            {
                                                "example_id": "2237b16d-6bec-4cbe-9779-169739e082ba",
                                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                                "text": "„Im schummrigen Licht des Lokals hatte sie Mühe, die Sorglosigkeit zu spielen, die nötig war, um einen Mann erfolgreich verführen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95c0078f-35bf-4955-b31d-8071e07024be",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Sprezzatura",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprezzatura",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                                        "entry_id": "dd400b95-d0ef-304c-aa8d-0ea32af55a97",
                                        "glosses": [
                                            "Begriff der italienischen Renaissance: Haltung, die den Anschein der Leichtigkeit/Mühelosigkeit auch bei der Bewältigung schwieriger Probleme vorgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebdfac1-00e1-489e-b4b4-913b86bfa2fc",
                                                "sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ca23c1e-2274-406d-8480-48c6e3ea1c4c",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Unbekümmertheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbekümmertheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6828db-35ac-356d-aed3-b2b773761205",
                                        "entry_id": "0abc505e-fc11-3cc5-a1f4-3d0ad2c5f16b",
                                        "glosses": [
                                            "psychischer Zustand, nicht beschwert/bekümmert zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b7baa9-1330-4388-8a50-3cb9ec654ef6",
                                                "sense_id": "bd6828db-35ac-356d-aed3-b2b773761205",
                                                "text": "„Ich liebte die völlige Unbekümmertheit, mit der sie nackt umherging, oder sich anzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8054a91-cd3c-4b13-8cb7-f7b2f2fead7f",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Munterkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Munterkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e403226-40fe-3a90-9163-a77639a67296",
                                        "entry_id": "7650e37b-d2f6-3881-b4a1-746b83c68472",
                                        "glosses": [
                                            "Eigenschaft/Verhalten, munter zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0bc73b-3653-4cb0-a78d-5f7be2cce22d",
                                                "sense_id": "4e403226-40fe-3a90-9163-a77639a67296",
                                                "text": "„So beschränkte er sich darauf, mir, wenn ich ihn traf, mit heiserer Munterkeit guten Tag zu sagen und mir den Weg zum Zimmer seines Vaters zu zeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de35113-d880-43f2-bd28-18e292b7b183",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Fröhlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fröhlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                        "entry_id": "bf264646-eeca-3a4e-b1ad-37f1c4f8bd9d",
                                        "glosses": [
                                            "Zustand, Stimmung einer Person oder Gruppe voller erkennbarer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf35cf-c8d0-4521-a5ea-40d01854e1f3",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "Ihre Fröhlichkeit wirkte auf alle anderen ansteckend."
                                            },
                                            {
                                                "example_id": "e08ccdd2-c7b1-4e28-8ce5-ffb261643579",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "„In diesem Augenblick trat die Sonne völlig aus den Wolken heraus, und der kraftvolle Schall des einzelnen Schusses und der Glanz der hellen Sonne flossen für alle zu einem einzigen Eindruck von Kühnheit und Fröhlichkeit zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968701a3-df7b-404f-9cf1-95ef8d779657",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Heiterkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiterkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                        "entry_id": "ed69b608-134e-3e17-8b08-b5c5bed4a816",
                                        "glosses": [
                                            "frohe, heitere, aufgelockerte Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a76224-4a71-4f0d-8032-57b2ffb218bb",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "Mit einem lustigen Witz trug er zur allgemeinen Heiterkeit bei."
                                            },
                                            {
                                                "example_id": "346d4350-f5a1-4464-9ae4-70e9e40d732c",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Die subversive Heiterkeit des künstlerischen Werkes von Yves Klein ist nur die Vorderseite seines hintergründigen Ernstes.“"
                                            },
                                            {
                                                "example_id": "cdebacbc-11df-481a-8d97-c7f5ce2e27f9",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„In unserer Runde hat er den Eindruck unerschöpflicher Vitalität und Lebensfreude vermittelt, sein freundliches Wesen, sein stiller Humor, seine Gelassenheit haben mich, der ich oft und schnell vom Gipfel der Heiterkeit ins Tal der Schwermut gleite, immer beschämt.“"
                                            },
                                            {
                                                "example_id": "f7608300-8cea-48ce-af37-02e62236c723",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Nach diesem Entschluß brachte mich Lias Heiterkeit um den Appetit.“"
                                            },
                                            {
                                                "example_id": "114b9851-2f06-4162-86bb-1bd1bb4071f4",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Dieser Sandersche Schmerzensschrei stellte die Heiterkeit wieder her, und unter Tappen und Tasten war man endlich bis in Nähe der Hoftür gekommen, wo, nach rechts hin, einige der Fässer weniger dicht nebeneinander lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bb58624-e84c-4a10-ad03-6f47467edfc7",
                        "source_entry_id": "190ef235-48a6-3e43-a038-0900f130b8cc",
                        "source_sense_id": "fe253644-ce09-39cf-9551-682015f553b3",
                        "source_sense_description": "quality of being jaunty",
                        "target_lang_word": "Eleganz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eleganz",
