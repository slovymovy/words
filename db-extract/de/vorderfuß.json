                            {
                                "example_id": "c88a5a43-32d2-4775-8111-1998c41cf092",
                                "sense_id": "b6ca3c9f-136f-30ff-98d8-2c18bcfce91b",
                                "text": "„Das Tier hatte sich mit dem linken Vorderfuß in dem herabhängenden Zügel verfangen.“"
                            },
                            {
                                "example_id": "edc1f800-973f-4e63-85ef-901f32db8c18",
                                "sense_id": "b6ca3c9f-136f-30ff-98d8-2c18bcfce91b",
                                "text": "„Boncœur hatte den Kopf zwischen die Vorderfüße gelegt, und nur dann und wann sah er zu seiner selbstgewählten Herrin auf, als ob er sich wegen seiner Saumseligkeit entschuldigen wolle.“"
                            }
                        ],
