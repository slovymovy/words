                        ],
                        "examples": [
                            {
                                "example_id": "7d22c3b9-1ee1-4bb0-8eef-db6b7e06c81e",
                                "sense_id": "a684a096-287b-32b9-bb65-f86f9964d1e3",
                                "text": "He unstoppered the little flask and took a few swigs."
                            },
                            {
                                "example_id": "d5e30fd9-176d-4c0c-985e-2238f2f8bbdd",
                                "sense_id": "a684a096-287b-32b9-bb65-f86f9964d1e3",
                                "text": "In vials of ivory and coloured glass / Unstoppered, lurked her strange synthetic perfumes, / Unguent, powdered, or liquid— […]"
                            },
                            {
                                "example_id": "5a695fa6-2438-4787-aeb0-5d38a233bbed",
                                "sense_id": "a684a096-287b-32b9-bb65-f86f9964d1e3",
                                "text": "That night the whisky was unstoppered and Bradly lolled in bed, smoking, and betimes sweeping out an arm of conquest for his nobbler and taking a lordly pull at it."
                            }
                        ]
                    }
