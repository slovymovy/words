                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102da8ef-eeef-47c0-b4f1-e1ea7c1314cf",
                                "sense_id": "d5abb640-ff23-3435-8af0-0f16b58eabdb",
                                "text": "„Für 2017 erwartet die Branche wieder einen Jahresverbrauch auf hohem Niveau bei 6,7 Millionen Tonnen.“"
                            },
                            {
                                "example_id": "49b51ef4-be6a-4418-8050-2bfe38cb89f1",
                                "sense_id": "d5abb640-ff23-3435-8af0-0f16b58eabdb",
                                "text": "„Der Stromverbrauch in der Schweiz ist vergangenes Jahr um 0,6 Prozent gestiegen. Nach dem Rekordjahr 2012 ist das der zweithöchste Jahresverbrauch.“"
                            },
                            {
                                "example_id": "7c720cdf-cc33-47bb-87c0-1a4141c9d4c2",
                                "sense_id": "d5abb640-ff23-3435-8af0-0f16b58eabdb",
                                "text": "„[…] Deutschland hatte […] im Jahr 2023 einen Jahresverbrauch von rund 76 Milliarden Kubikmeter Erdgas.“"
                            }
                        ],
