    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0ccdc07-69e0-3c67-a574-d4ef754aa323",
                    "sense_definition": "Surface qui forme la partie supérieure d'une pièce ou d'un espace couvert.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une suspension moderne est fixée au <w>plafond</w> du salon pour éclairer la table."
                        },
                        {
                            "text": "Il est resté allongé sur son lit en regardant le <w>plafond</w> blanc de sa chambre."
                        }
                    ],
                    "antonyms": [
                        "mur",
                        "sol"
                    ],
                    "common_phrases": [
                        "au plafond",
                        "hauteur sous plafond",
                        "peindre le plafond"
                    ]
                },
                {
                    "sense_id": "335662e5-8ae3-345c-b231-fbde04d17032",
                    "sense_definition": "Limite supérieure ou montant maximal fixé à ne pas dépasser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque a établi un <w>plafond</w> strict pour les retraits d'argent chaque semaine."
                        },
                        {
                            "text": "Ses revenus annuels dépassent le <w>plafond</w> légal requis pour toucher cette aide financière."
                        }
                    ],
                    "common_phrases": [
                        "atteindre le plafond",
                        "dépasser le plafond",
                        "plafond de dépenses"
                    ]
                },
                {
                    "sense_id": "4d22791b-13c7-35cc-ac9e-b060ca275b9d",
                    "sense_definition": "Altitude maximale qu'un aéronef a la capacité technique d'atteindre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet avion de tourisme possède un <w>plafond</w> limité à quatre mille mètres d'altitude."
                        },
                        {
                            "text": "Les ingénieurs cherchent à augmenter le <w>plafond</w> de vol du nouvel appareil expérimental."
                        }
                    ],
                    "common_phrases": [
                        "plafond pratique",
                        "plafond opérationnel"
                    ]
                },
                {
                    "sense_id": "a0647cee-0770-357d-8265-e756f91f826b",
                    "sense_definition": "Œuvre picturale ou fresque peinte qui orne la partie supérieure d'un bâtiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les touristes lèvent les yeux pour contempler le sublime <w>plafond</w> peint de cette église."
                        },
                        {
                            "text": "Ce maître de la Renaissance a conçu un immense <w>plafond</w> commandé par le prince."
                        }
                    ]
                },
                {
                    "sense_id": "8969fac3-97e0-348c-bc8f-417fdb5c6eb7",
                    "sense_definition": "Voûte rocheuse ou partie supérieure d'une carrière souterraine ou d'une mine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des ouvriers inspectent le <w>plafond</w> de la galerie pour prévenir tout risque d'éboulement."
                        },
                        {
                            "text": "De profondes fissures sont apparues sur le <w>plafond</w> calcaire de la vieille carrière abandonnée."
