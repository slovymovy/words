            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4e2b822-47d8-3273-ad1e-ebd17c275fba",
                    "sense_definition": "Qui éprouve de l'inquiétude, qui est tourmenté par des tracas ou des préoccupations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs jours, il paraît très <w>soucieux</w> à cause de ses problèmes financiers."
                        },
                        {
                            "text": "Elle reste <w>soucieuse</w> quand ses enfants rentrent tard le soir sans prévenir."
                        }
                    ],
                    "synonyms": [
                        "inquiet",
                        "préoccupé",
                        "tracassé"
                    ],
                    "antonyms": [
                        "insouciant",
                        "serein",
                        "tranquille"
                    ]
                },
                {
                    "sense_id": "a14c2725-f3bc-3c93-9d48-b38fae83bc3d",
                    "sense_definition": "Qui accorde beaucoup d'importance et d'attention à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attentif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toujours <w>soucieux</w> du détail, l'artisan vérifie chaque pièce avant de la vendre."
                        },
                        {
                            "text": "Cette entreprise est particulièrement <w>soucieuse</w> de son impact sur l'environnement."
                        }
                    ],
                    "synonyms": [
                        "attentif",
                        "soigneux"
                    ],
                    "antonyms": [
                        "insouciant",
                        "négligent"
                    ],
                    "common_phrases": [
                        "soucieux du détail",
                        "soucieux de bien faire",
                        "peu soucieux de"
                    ]
                },
                {
                    "sense_id": "a332bf1d-707f-350b-b2aa-f0bbb7e16cfc",
                    "sense_definition": "Qui manifeste ou trahit une inquiétude, en parlant d'une attitude, d'un visage ou d'une expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin avait un air <w>soucieux</w> en observant les résultats des examens."
                        },
                        {
                            "text": "Elle affichait une mine <w>soucieuse</w> en découvrant le message sur son téléphone."
                        }
                    ],
                    "synonyms": [
                        "inquiet",
                        "préoccupé"
                    ],
                    "antonyms": [
                        "détendu",
                        "serein"
                    ],
                    "common_phrases": [
                        "air soucieux",
                        "mine soucieuse",
                        "regard soucieux"
                    ]
                }
            ]
