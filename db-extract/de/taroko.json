                                "target_senses": [
                                    {
                                        "sense_id": "34db5560-1a48-35a1-a98f-967f184f2fa6",
                                        "entry_id": "1c68ff8b-e255-38c3-940d-6d770bb70429",
                                        "glosses": [
                                            "Taroko people, descendants of Truku Seediq people who moved to the east side of Formosa in the 16th century"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "578cfc62-5f93-3372-ad9e-f374328b366a",
                                        "entry_id": "1c68ff8b-e255-38c3-940d-6d770bb70429",
                                        "glosses": [
                                            "Taroko language, often used to refer or include Seediq languages as a result of misunderstanding in early linguistics"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                        "entry_id": "1c68ff8b-e255-38c3-940d-6d770bb70429",
                                        "glosses": [
                                            "Taroko National Park in Taiwan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ad3bc5-e17b-49a0-8c98-48199b4b04c0",
                                                "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                                "text": "During her stay here she toured a number of scenic spots, including the Taroko Gorge, one of the great natural wonders of the world."
                                            },
                                            {
                                                "example_id": "6a481126-aa9d-42f4-9e0d-f996b34d0afa",
                                                "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                                "text": "TAROKO GORGE IS SIMPLY A SPECTACULAR PLACE, A wonderland of natural beauty that would leave even the most jaded visitor impressed."
                                            },
                                            {
                                                "example_id": "1c85fba7-83b0-4981-b19a-6b06cbadb086",
                                                "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                                "text": "\"Tommy, I'm here in Taiwan. How's that for alliteration? Tom, I'm here in Taiwan at Taroko.\""
                                            },
                                            {
                                                "example_id": "f4cad420-3054-4bf9-8191-cb852345ec4d",
                                                "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                                "text": "Hualien is close to Taroko National Park, where the famous Taroko Gorge cuts down through the mountains to the sea."
                                            },
                                            {
                                                "example_id": "1bf69c59-f5ee-474a-b739-bd05b93e4c1e",
                                                "sense_id": "64f6378b-4b57-3d0e-8ab6-c2a218cb91bf",
                                                "text": "In 2019, before coronavirus pandemic lockdowns began, the nearby Taroko Gorge national park received 4.8 million visitors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
