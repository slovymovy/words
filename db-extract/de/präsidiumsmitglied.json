                        "examples": [
                            {
                                "example_id": "d1f81e1f-ffb5-4408-9e57-ca9307468b73",
                                "sense_id": "74566df3-3cc3-3def-908a-e20aa41185ac",
                                "text": "„Auf einer Veranstaltung der christlichen Gewerkschaften in Köln erklärt Adam Stegerwald, Präsidiumsmitglied des Kriegsernährungsamtes, es sei sichergestellt, dass jeder Erwachsene während des Krieges eine Wochenration von 250 g Fleisch erhalten könne.“"
                            },
                            {
                                "example_id": "35a4687c-a1cd-41a8-bd0c-cb9049d0e26f",
                                "sense_id": "74566df3-3cc3-3def-908a-e20aa41185ac",
                                "text": "„Bei der SPD stimmten zehn Präsidiumsmitglieder für die große Koalition, ein Mitglied votierte dagegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
