                "senses": [
                    {
                        "sense_id": "4c6d22cd-e75b-3851-b880-9b6c5c49761b",
                        "entry_id": "f56946f6-57fa-351b-a4c4-916e59f8bb67",
                        "glosses": [
                            "Faire jaillir."
                        ],
                        "tags": [
                            "Lorraine",
                            "Alsace"
                        ],
                        "examples": [
                            {
                                "example_id": "7362ed5b-ee58-48bd-b219-ed2dc6f8cd74",
                                "sense_id": "4c6d22cd-e75b-3851-b880-9b6c5c49761b",
                                "text": "Pour Pâques elle a reçu une baleine qui schpritze de l’eau pour de vrai !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee42330d-8247-3fc2-b3db-50d0ac993586",
                        "entry_id": "f56946f6-57fa-351b-a4c4-916e59f8bb67",
                        "glosses": [
                            "Faire jaillir sur quelque chose."
                        ],
                        "tags": [
                            "Lorraine",
                            "Alsace"
                        ],
                        "examples": [
                            {
                                "example_id": "c9237b50-89a9-4f02-84c5-3a0435497500",
                                "sense_id": "ee42330d-8247-3fc2-b3db-50d0ac993586",
                                "text": "Je les schpritze de peinture noire, et pendant que c’est encore mouillé, je saupoudre de fine poudre de vrai charbon."
                            },
                            {
                                "example_id": "8bbaf090-104c-4e76-86b1-c78c082f383a",
                                "sense_id": "ee42330d-8247-3fc2-b3db-50d0ac993586",
                                "text": "Tu le schpritze ^([sic : schpritzes]) à l’intérieur de la poignée que tu vas monter, pis t’as 30 sec pour mettre la poignée."
                            }
                        ]
                    }
                ],
