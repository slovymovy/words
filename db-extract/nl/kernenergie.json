                                            {
                                                "example_id": "75c42918-4b12-4fcd-a6d9-d0bc7f9c8d86",
                                                "sense_id": "981e6b08-0e23-3fbc-ac2b-43af4333de10",
                                                "text": "„Gegen den Widerstand der Atomkonzerne peilt die deutsche Energiewirtschaft einen Ausstieg aus der Kernenergie bis 2020 an.“"
                                            }
