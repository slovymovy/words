                "senses": [
                    {
                        "sense_id": "d4bbab10-25e8-3798-b477-337cf1885b4f",
                        "entry_id": "285c016f-f883-325b-9c82-107af28c141a",
                        "glosses": [
                            "Faire des pamphlets (sur)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa9ec33f-89b9-4b22-8c75-d77ad06add9e",
                                "sense_id": "d4bbab10-25e8-3798-b477-337cf1885b4f",
                                "text": "Et moi, je projetais de pamphléter à loisir dans le magazine culturel de J.F. P., qui ne verrait jamais le jour."
                            },
                            {
                                "example_id": "89eba33b-56d0-43cf-8085-30b033653dcc",
                                "sense_id": "d4bbab10-25e8-3798-b477-337cf1885b4f",
                                "text": "Ce n’est pas encore la gloire, sa rubrique tient dans un quart de page et se résume à « pamphléter » une figure politique, mais c’est un début qui devrait lui ouvrir d’autres portes."
                            }
                        ]
                    }
