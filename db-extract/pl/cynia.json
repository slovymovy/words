                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "327280f1-6f95-3e83-8490-aed2d7caf227",
                        "entry_id": "d56101dd-92f1-3570-8a6d-f6db3f4be5ac",
                        "glosses": [
                            "roślina z rodzaju cynii (1.1), m.in. uprawiana dla ozdobnych kwiatów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d6b3fb-3eb6-4ff2-a0d2-648ce17c7595",
                                "sense_id": "327280f1-6f95-3e83-8490-aed2d7caf227",
                                "text": "Gdy letnie dni stają się krótkie, a wieczory i ranki chłodne, na rabatach rozkwitają cynie. Wyróżniają się nasyconymi barwami i wytworną posturą. Kochają je motyle i pszczoły"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "01234ba3-639d-3932-acc1-b661f4e35b3b",
                        "entry_id": "d56101dd-92f1-3570-8a6d-f6db3f4be5ac",
                        "glosses": [
                            "kwiat cynii (1.2)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9df1173-f09b-4867-8216-0872b587f71a",
                        "source_entry_id": "d56101dd-92f1-3570-8a6d-f6db3f4be5ac",
                        "source_sense_id": "17df4c2c-1c8a-3e23-b490-0808f7349264",
                        "target_lang_word": "zinnia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zinnia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ea8461a3-5f0b-3f16-9b39-1aa8a680b3ce",
                                        "entry_id": "e141dd35-501d-321f-9461-6710cb8dca8d",
                                        "glosses": [
                                            "Género de plantas anuales y perennes de la familia Asteraceae, originalmente de praderas secas de un área que se extiende del sudoeste norteamericano hasta América del sur, pero sobre todo México, es notable por sus flores solitarias que vienen en una variedad de colores brillantes."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a5a8f0-35db-4f89-9399-89c423334d55",
                        "source_entry_id": "d56101dd-92f1-3570-8a6d-f6db3f4be5ac",
                        "source_sense_id": "17df4c2c-1c8a-3e23-b490-0808f7349264",
                        "target_lang_word": "Zinnie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zinnie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "debd7e99-126f-3a5b-9c13-8230883a3432",
                                        "entry_id": "38be428a-0e13-302a-bc22-e9e380308e55",
                                        "glosses": [
                                            "Blume aus der Familie der Korbblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457074b9-c1b9-432e-8574-94b80c518822",
                                                "sense_id": "debd7e99-126f-3a5b-9c13-8230883a3432",
                                                "text": "„Eine weiße Kuh frisst Zinnien aus einem Blumenkasten vor dem Postamt.“"
                                            },
                                            {
                                                "example_id": "a95a5299-dd1f-4997-a83c-9ff3eae40e5e",
                                                "sense_id": "debd7e99-126f-3a5b-9c13-8230883a3432",
                                                "text": "„Sie überquerten eine Hochweide, die mit einem Teppich aus Wiesenblumen ausgelegt war, passierten Felder voller Goldkraut, Zinnien, tiefrotem Enzian und Purpurwinden, zogen durch eine weite, mit bunten Blümchen bewachsene Ebene, die sich wie bedruckter Gingan blauschleirig bis zum äußersten, dicht geschlossenen Rand dehnte, die diamantenen Bergketten ragten, den Rücken von Meerestieren in devonischer Morgendämmerung gleich, aus dem Nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
