                        ],
                        "examples": [
                            {
                                "example_id": "bd0c419c-2bab-478d-84d0-af7a940cf9e2",
                                "sense_id": "1e5f8a8a-da7f-30b3-b19d-a0731c2175a9",
                                "text": "Radi sollte erst ab April im Garten ausgesät werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "750d658b-dc7d-3c81-8804-961dbd2746f8",
                        "entry_id": "e4ea246f-c91b-326d-b415-be53a3847e20",
