{
    "word_family": [
        "burst"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "792cf6e8-7ef7-369f-8758-0f880bc61ce0",
                    "sense_definition": "A sudden, often violent expression of strong emotion or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden eruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone was shocked by his sudden <w>outburst</w> of anger during the meeting.",
                            "target_lang_translations": {
                                "ru": "Все были шокированы его внезапной <w>вспышкой</w> гнева во время встречи."
                            }
                        },
                        {
                            "text": "She later apologized for her emotional <w>outburst</w> in front of the guests.",
                            "target_lang_translations": {
                                "ru": "Позже она извинилась за свой эмоциональный <w>срыв</w> перед гостями."
                            }
                        }
                    ],
                    "synonyms": [
                        "explosion",
                        "blast"
                    ],
                    "antonyms": [
                        "inburst"
                    ],
                    "common_phrases": [
                        "outburst of anger",
                        "emotional outburst",
                        "violent outburst"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, часто бурное проявление сильных эмоций или активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "внезапное резкое проявление чувства или эмоции"
                            },
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "бурный выплеск сильных эмоций"
                            },
                            {
                                "target_lang_word": "выплеск",
                                "target_lang_sense_clarification": "резкое внешнее выражение накопившихся эмоций"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапный душевный импульс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1a43ba3-73ed-3c40-a4a3-5fc0c9f453e0",
                    "sense_definition": "To suddenly erupt, explode, or burst out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sudden eruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laughter suddenly <w>outburst</w> from the audience during the awkward silence.",
                            "target_lang_translations": {
                                "ru": "Среди неловкого молчания в зале внезапно <w>грянул</w> смех."
                            }
                        },
                        {
                            "text": "Flames began to <w>outburst</w> through the broken windows of the old building.",
                            "target_lang_translations": {
                                "ru": "Сквозь разбитые окна старого здания начало <w>вырываться</w> пламя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно извергаться, взрываться или вырываться наружу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырываться",
                                "target_lang_sense_clarification": "внезапно с силой выходить наружу"
                            },
                            {
                                "target_lang_word": "грянуть",
                                "target_lang_sense_clarification": "внезапно и громко начаться (о звуках)"
                            },
                            {
                                "target_lang_word": "вспыхивать",
                                "target_lang_sense_clarification": "внезапно и бурно проявляться или загораться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}