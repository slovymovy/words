                        "target_lang_word": "chance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                        "entry_id": "b53eaf64-2eab-3aad-b6c0-3db0bc199a47",
                                        "glosses": [
                                            "An opportunity or possibility."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed5e6d0-f707-4ded-b64d-cef5978cb8a4",
                                                "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                                "text": "We had the chance to meet the president last week: we have a good/strong chance of making / to make a profit."
                                            },
                                            {
                                                "example_id": "ef21679d-9a02-4b22-ae52-cd0788aa982b",
                                                "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                                "text": "There was a fat/slim chance that my letter would arrive in time."
                                            },
                                            {
                                                "example_id": "b1286137-43e2-40f0-bbef-4ce2f8913d4f",
                                                "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                                "text": "If you get the chance, try and catch the new production of \"Hamlet.\""
                                            },
                                            {
                                                "example_id": "d52654c3-adba-460e-905e-520395a8d634",
                                                "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                                "text": "Here was my chance. I took the old man aside, and two or three glasses of Old Crow launched him into reminiscence."
                                            },
                                            {
                                                "example_id": "a0038048-b6eb-471b-a1cb-92aec6095944",
                                                "sense_id": "cf69f693-5bdf-3ac1-988e-5e387f9758af",
                                                "text": "It never even occurred to me in my fondest dreams that I might have the chance to help the sons and daughters of those students and to help people like them all over this country.\nBut now I do have that chance, and I'll let you in on a secret: I mean to use it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf3204cd-286d-3957-98de-764734a79266",
                                        "entry_id": "b53eaf64-2eab-3aad-b6c0-3db0bc199a47",
                                        "glosses": [
                                            "Random occurrence; luck."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe130af2-c436-4656-bd7c-46e60ddcbad6",
                                                "sense_id": "bf3204cd-286d-3957-98de-764734a79266",
                                                "text": "Why leave it to chance when a few simple steps will secure the desired outcome?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0900a69-1e18-3d5e-8dc2-a741e652a9a0",
                                        "entry_id": "b53eaf64-2eab-3aad-b6c0-3db0bc199a47",
                                        "glosses": [
                                            "The probability of something happening."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e0cde6-606c-48a4-9fa7-8c0c5b7b5637",
                                                "sense_id": "c0900a69-1e18-3d5e-8dc2-a741e652a9a0",
                                                "text": "There is a 30 percent chance of rain tomorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21701834-7c9d-3fcf-90a8-57b246d3d992",
                                        "entry_id": "b53eaf64-2eab-3aad-b6c0-3db0bc199a47",
                                        "glosses": [
                                            "probability; possibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f280e0a-9fa3-4dc2-967a-b8bd63181c7b",
                                                "sense_id": "21701834-7c9d-3fcf-90a8-57b246d3d992",
                                                "text": "Sometimes the name is changed because it is thought to be unlucky. If \"Chua\" is ill, the chances are that there are certain spirits who do not like his name, so the parents alter his name to \"Mee,\" or something else, and then he gets well again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3985013f-0572-3e37-9640-1f289b4abc87",
                                        "entry_id": "b53eaf64-2eab-3aad-b6c0-3db0bc199a47",
                                        "glosses": [
                                            "What befalls or happens to a person; their lot or fate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbb9a3e-158b-4cf9-bb56-8fe72e61822f",
                                                "sense_id": "3985013f-0572-3e37-9640-1f289b4abc87",
                                                "text": "Wild-visag'd Wanderer! ah for thy heavy chance!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3567b0e-138f-3c64-b125-19231f3eb34e",
                                        "entry_id": "91a4b5a1-ac3d-32e4-8c64-5a780e7d1d75",
                                        "glosses": [
                                            "Happening by chance, casual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63374e55-865b-4472-802c-e2359d12d787",
                                                "sense_id": "c3567b0e-138f-3c64-b125-19231f3eb34e",
                                                "text": "No crowd was about the door; no people were discernible at any of the many windows; not even a chance passer-by was in the street. An unnatural silence and desertion reigned there."
                                            },
                                            {
                                                "example_id": "26b2130f-bfef-4816-bdc0-74993241edb1",
                                                "sense_id": "c3567b0e-138f-3c64-b125-19231f3eb34e",
                                                "text": "Heaven knows what pains the author has been at, what bitter experiences he has endured and what heartache suffered, to give some chance reader a few hours' relaxation or to while away the tedium of a journey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ac7fc8a-447b-32d8-8efd-1fe296f9d909",
                                        "entry_id": "51ebeef7-0b5a-33ff-bb6e-e556afd73440",
                                        "glosses": [
                                            "Perchance; perhaps."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e338f734-ef29-341e-afcf-f255275a8db5",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To happen by chance, to occur."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9458da3-775b-44e3-bf24-519c58f308b0",
                                                "sense_id": "e338f734-ef29-341e-afcf-f255275a8db5",
                                                "text": "It chanced that I found a solution the very next day."
                                            },
                                            {
                                                "example_id": "d4cc8396-a7a0-4f2a-aedc-fe316cee6d25",
                                                "sense_id": "e338f734-ef29-341e-afcf-f255275a8db5",
                                                "text": "if a bird's nest chance to be before thee"
                                            },
                                            {
                                                "example_id": "ceaf0fdf-16c6-44e2-bb53-8278649b24ed",
                                                "sense_id": "e338f734-ef29-341e-afcf-f255275a8db5",
                                                "text": "Once […] it chanced that Geoffrey Riddell Bishop of Ely, a Prelate rather troublesome to our Abbot, made a request of him for timber from his woods towards certain edifices going on at Glemsford."
                                            },
                                            {
                                                "example_id": "b189b951-38fa-4c58-bd0c-813c4cf09505",
                                                "sense_id": "e338f734-ef29-341e-afcf-f255275a8db5",
                                                "text": "Mr. Mason, shivering as some one chanced to open the door, asked for more coal to be put on the fire, which had burnt out its flame, though its mass of cinder still shone hot and red. The footman who brought the coal, in going out, stopped near Mr. Eshton's chair, and said something to him in a low voice, of which I heard only the words, \"old woman,\"—\"quite troublesome.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb94189-53d0-3fde-ab24-c421020f9300",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To befall; to happen to."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451f24d7-354f-4bd8-b9b8-0d07a7b471a9",
                                                "sense_id": "cbb94189-53d0-3fde-ab24-c421020f9300",
                                                "text": "[…] while the King and Godwine sate at the table, accompanied with others of the nobilitie, it chanced the cupbearer (as he brought wine to the bourd) to slip with the one foote, and yet by good strength of his other leg, to recover himselfe without falling […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25a89dc-5605-3b10-a8a5-d32a4d3b2230",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To try or risk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96be9e3-a50f-4ca0-a1c4-9e9a3029538e",
                                                "sense_id": "f25a89dc-5605-3b10-a8a5-d32a4d3b2230",
                                                "text": "Shall we carry the umbrella, or chance a rainstorm?"
                                            },
                                            {
                                                "example_id": "d2a7ee0a-f20e-4193-a36d-fcd6ca6a9ee0",
                                                "sense_id": "f25a89dc-5605-3b10-a8a5-d32a4d3b2230",
                                                "text": "He does chance it in stocks, but he's always played on the square, if you call stocks gambling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef86843c-0955-3b5f-b8df-702f8bcdece5",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To discover something by chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d00fece-ee25-4cc6-9810-dffe33f68110",
                                                "sense_id": "ef86843c-0955-3b5f-b8df-702f8bcdece5",
                                                "text": "He chanced upon a kindly stranger who showed him the way."
                                            },
                                            {
                                                "example_id": "228167a4-13d4-4cc1-a8bf-1f09a6fa373e",
                                                "sense_id": "ef86843c-0955-3b5f-b8df-702f8bcdece5",
                                                "text": "I chanced on this letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead49b3d-67f7-37f0-9945-6733a3f03ff2",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To rob, cheat or swindle someone."
                                        ],
                                        "tags": [
                                            "Belize"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916dc283-a0c8-47c5-890c-8f960b7fb0de",
                                                "sense_id": "ead49b3d-67f7-37f0-9945-6733a3f03ff2",
                                                "text": "The car broke down a week after I bought it. I was chanced by that fast-talking salesman."
                                            },
                                            {
                                                "example_id": "85e8436d-ef88-4648-a2de-2ea460736524",
                                                "sense_id": "ead49b3d-67f7-37f0-9945-6733a3f03ff2",
                                                "text": "Be prepared to engage in protests of all businesses nationwide who are violating the copyright act and chancing our members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18645ff9-a2c9-3b9c-9f7b-da1ade33ad9a",
                                        "entry_id": "350db621-b004-3724-9717-05466c61a8c9",
                                        "glosses": [
                                            "To take an opportunity from someone; to cut a queue."
                                        ],
                                        "tags": [
                                            "Nigeria"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
