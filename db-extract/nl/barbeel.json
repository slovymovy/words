                                            {
                                                "example_id": "16f2beb6-196c-4a25-a5a3-38360ebda164",
                                                "sense_id": "ba4f2fd3-f9e3-35e1-af69-c56c19eb9371",
                                                "text": "The Barble fishes, if one of them chance to be engaged, will set the line against their backes, and with a fin they have, toothed like a sharp saw, presently saw and fret the same asunder."
                                            }
                                        ]
