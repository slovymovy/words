                        "erg blij"
                    ],
                    "target_lang_definitions": {
                        "en": "having a cheerful or satisfied feeling, often for a shorter period",
                        "ru": "испытывать веселое или удовлетворенное чувство, часто в течение короткого периода времени"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happy",
                                "target_lang_sense_clarification": "feeling or showing pleasure or contentment"
                            },
                            {
                                "target_lang_word": "glad",
                                "target_lang_sense_clarification": "pleased and happy about something"
                            },
                            {
                                "target_lang_word": "pleased",
                                "target_lang_sense_clarification": "feeling or showing satisfaction with a situation"
                            }
