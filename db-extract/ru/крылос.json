                        "cross_references": [
                            {
                                "target_word": "Chor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32af9f81-5bf2-34e3-9d4e-215293befefb",
                                        "entry_id": "3e7fb670-4eb7-3b32-887d-834d54fb2081",
                                        "glosses": [
                                            "Gesindel, Pack"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e52c03-bec5-496b-91d1-c2903e066abd",
                                                "sense_id": "32af9f81-5bf2-34e3-9d4e-215293befefb",
                                                "text": "Dieses liederliche Chor treibt sich schon wieder vor unserem Haus herum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8dd7f4d-32e8-340c-b2ad-80f84e0446b0",
                                        "entry_id": "3e7fb670-4eb7-3b32-887d-834d54fb2081",
                                        "glosses": [
                                            "allgemein ein Kreis, ein Reigen, eine Menge"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f07d56-eb7b-43ff-97e8-f0d0a6cbb841",
                                                "sense_id": "f8dd7f4d-32e8-340c-b2ad-80f84e0446b0",
                                                "text": "Er schwelgt in einem Chor der stillen Freuden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d85bcb5-a59b-3d5d-abe9-7210f1e02d48",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "Ensemble von Sängern, das gemeinsam Chorwerke vorträgt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d506adb9-9cc9-4489-8b30-357c3b10cc2f",
                                                "sense_id": "7d85bcb5-a59b-3d5d-abe9-7210f1e02d48",
                                                "text": "Der Chor sucht neue Sänger."
                                            },
                                            {
                                                "example_id": "6d86adf5-3734-4de3-98a1-88ef1562d487",
                                                "sense_id": "7d85bcb5-a59b-3d5d-abe9-7210f1e02d48",
                                                "text": "„Marie singt auch sehr schön; jedem Chor würde sie zur Zierde gereichen.“"
                                            },
                                            {
                                                "example_id": "50fdd521-5c5b-4739-b3d8-4bedf86fe1e9",
                                                "sense_id": "7d85bcb5-a59b-3d5d-abe9-7210f1e02d48",
                                                "text": "„Der Chor wartet auf seinen Einsatz.“"
                                            },
                                            {
                                                "example_id": "5f90b483-341d-4339-b84c-7b4ae576afe9",
                                                "sense_id": "7d85bcb5-a59b-3d5d-abe9-7210f1e02d48",
                                                "text": "„Der Pastor sah stumm vor sich hin, als wartete er darauf, dass der Chor das letzte Lied anstimmte, ein siebenköpfiger Chor, fünf Frauen, zwei Männer, ein größerer Chor hätte auf der kleinen Empore kaum Platz gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "404b559b-33a6-3440-93ac-f2cfcae91616",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "Gruppe ähnlicher oder gleicher Musikinstrumente und ihrer Spieler"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a38bd0-620c-4eda-bad1-566b58324847",
                                                "sense_id": "404b559b-33a6-3440-93ac-f2cfcae91616",
                                                "text": "Der Posaunenchor besteht aus mehreren Tuben, Posaunen, Hörnern und Trompeten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a00548a4-77b6-37cb-a94d-5a64a6ae09ac",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "Musikstück, das von einem Chor (siehe [1]) dargeboten wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b43a9f0-99c2-4ebf-ba92-0a0fa5decd9e",
                                                "sense_id": "a00548a4-77b6-37cb-a94d-5a64a6ae09ac",
                                                "text": "In der Matthäuspassion werden besonders die Chöre geschätzt."
                                            },
                                            {
                                                "example_id": "f46000ae-a0ab-4598-827c-c68597a853d7",
                                                "sense_id": "a00548a4-77b6-37cb-a94d-5a64a6ae09ac",
                                                "text": "Das Lied 'Va, pensiero' ist einer der berühmtesten Chöre der Operngeschichte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf3670b7-1f01-3ba2-b08d-aac003798b13",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "gemeinsamer Gesang von mehreren Sängerinnen und Sängern"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57f7daf-3c02-4499-a7d2-0414797c5448",
                                                "sense_id": "cf3670b7-1f01-3ba2-b08d-aac003798b13",
                                                "text": "Chor und Orgel harmonieren perfekt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6a94cb84-d454-392b-883d-0bcd3a43761c",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "Saiten, die gleich gestimmt sind"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3a961c-5bd5-4d84-a8fa-2713476eb936",
                                                "sense_id": "6a94cb84-d454-392b-883d-0bcd3a43761c",
                                                "text": "Bis 1500 hatten Lauten vier oder fünf, danach zunächst sechs Chöre."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1af8e403-ee15-34a1-bbfb-a085417ef9f5",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "(bei den gemischten Stimmen der Orgel) die zu einer Taste gehörenden Pfeifen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "999a9385-1e75-43cf-a0dc-fedd097b304e",
                                                "sense_id": "1af8e403-ee15-34a1-bbfb-a085417ef9f5",
                                                "text": "Ein gut geschulter Organist kann den Chor 'Blockflöte' wählen, um den Klang des gleichnamigen Holzblasinstruments nachzuahmen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "867e98d9-bb90-32f7-956c-ea5320963d61",
                                        "entry_id": "056e51ce-55cc-35ea-840d-4c6aae0ad99a",
                                        "glosses": [
                                            "Schauspielergruppe, die das Geschehen auf der Bühne kommentiert"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c655cdbd-e9b6-4d16-bb8e-75dffefb48c7",
                                                "sense_id": "867e98d9-bb90-32f7-956c-ea5320963d61",
                                                "text": "In der antiken Tragödie gibt es einen Chor."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            },
