                        "examples": [
                            {
                                "example_id": "77a9bc28-b68a-4b2c-82e2-5776391fdb9c",
                                "sense_id": "9f5118b1-1bec-3b69-ae66-ba24f1bc719d",
                                "text": "Peer Mascini en zijn trouwe koe zijn na twaalf jaar weer terug op de Nederlandse televisie. De acteur, die in de jaren '90 in vele Melkunie-commercials schitterde, zal vanaf volgende week weer samen met zijn gevlekte grazer het zuivelmerk gaan promoten."
                            },
                            {
                                "example_id": "3226df54-0bed-41e8-a6cf-796762716c23",
                                "sense_id": "9f5118b1-1bec-3b69-ae66-ba24f1bc719d",
                                "text": "Internetgigant Google blurt voor het kaartsysteem Google Streetview al jaren de gezichten van mensen om hun privacy te beschermen. Maar nu is er op één van de 360 graden-panoramafoto's die voor het programma worden gebruikt een koe opgedoken waarvan de kop wazig is gemaakt. Sinds de mysterieuze grazer, gefotografeerd in het Britse graafschap Cambridgeshire, is ontdekt vraagt menigeen zich ernstig af waarom de 'identiteit' van het rund geheim moet blijven."
                            },
                            {
                                "example_id": "7cf2cb78-7d45-4439-8a4b-06839c86e21a",
                                "sense_id": "9f5118b1-1bec-3b69-ae66-ba24f1bc719d",
                                "text": "Nog maar een paar jaar geleden golden de Oostvaardersplassen, mede dankzij de film De Nieuwe Wildernis, als de parel van Nederland. Sinds afgelopen winter is het gebied tussen Lelystad en Almere het meest verguisde stukje Nederland. Vandaag staan Provinciale Staten Flevoland voor hét besluit over de toekomst van de Oostvaardersplassen en de grote grazers. Hoe zit het ook alweer?"
                            }
                        ]
