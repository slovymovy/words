                        "glosses": [
                            "En Espagne, premier officier de justice d’une ville, d’une province."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd69a92e-bc18-45d2-8801-a05552c9d1af",
                                "sense_id": "5b4e8b75-6fe5-3ec1-ac13-ac35ba5e92e0",
                                "text": "Un cacique, un corrégidor formaient le corps militaire et civil des réductions."
                            },
                            {
                                "example_id": "4944b4be-a6fb-485a-b1e3-2c0cdce70f63",
                                "sense_id": "5b4e8b75-6fe5-3ec1-ac13-ac35ba5e92e0",
                                "text": "Onze corrégidors, répandus dans la province, sont chargés, sous ses ordres, des détails de l’administration."
                            },
                            {
                                "example_id": "1214fac4-f4aa-4aa9-a417-b1e0b521a5d6",
                                "sense_id": "5b4e8b75-6fe5-3ec1-ac13-ac35ba5e92e0",
                                "text": "J’épouse une riche veuve de Cordoue, et je renonce au stylet du brigand pour la baguette du corrégidor."
                            }
                        ]
                    }
