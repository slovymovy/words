                                        "sense_id": "04903401-3dc6-37f6-9939-9babbfc2794d",
                                        "entry_id": "3922898f-e321-3898-b87e-e557eb70cc9d",
                                        "glosses": [
                                            "To promote or sell (goods) in an aggressive, showy manner."
