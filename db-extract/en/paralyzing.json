                            {
                                "example_id": "9088b28e-1ac8-49e5-a6db-5b698c8941ed",
                                "sense_id": "5ecb3592-0843-3181-afc2-5ec5c6740e41",
                                "text": "The snake's paralyzing venom prevented the mouse from escaping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fed9add1-a5ac-4198-a872-84202a718caa",
                        "source_entry_id": "5e0d75d9-978b-35bf-8dcc-4943b0923141",
                        "source_sense_id": "5ecb3592-0843-3181-afc2-5ec5c6740e41",
                        "source_sense_description": "that paralyzes",
                        "target_lang_word": "paralysant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralysant",
