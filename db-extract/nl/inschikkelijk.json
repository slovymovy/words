                                        "glosses": [
                                            "Affording, or disposed to afford, accommodation; obliging; helpful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9f684e-14d8-47bf-8780-76e1298bcf5b",
                                                "sense_id": "caffa20e-5091-3580-8cd0-884a520cee24",
                                                "text": "Richard DeLongpre: I have to say, we were surprised that Principal Gottlieb wasn't more accommodating.\nJudith Gottlieb: Oh, for God's sake, he's a child. I'm not gonna date him."
                                            },
                                            {
                                                "example_id": "2031f1e6-002f-4dd4-a9a5-a7e1e828969c",
                                                "sense_id": "caffa20e-5091-3580-8cd0-884a520cee24",
                                                "text": "The staff were very accommodating and made sure we had everything we needed."
                                            },
                                            {
                                                "example_id": "551f275e-d29d-48a8-91e0-60a4ec6a27e7",
                                                "sense_id": "caffa20e-5091-3580-8cd0-884a520cee24",
                                                "text": "He’s always been an accommodating neighbor, offering to help with anything."
                                            },
                                            {
                                                "example_id": "2eb12bfe-4b1b-42c4-b16f-272543fa8216",
                                                "sense_id": "caffa20e-5091-3580-8cd0-884a520cee24",
                                                "text": "She was extremely accommodating when it came to changing her schedule."
                                            }
                                        ]
                                    },
