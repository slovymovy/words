                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Creole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abdb48c2-b1a7-320e-aaa2-7b3756307dd5",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "A descendant of European settlers who is born in a colonized country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ff48a7-e6d7-4af8-8c14-e6d754b88f3d",
                                                "sense_id": "abdb48c2-b1a7-320e-aaa2-7b3756307dd5",
                                                "text": "Within the Spanish society, a great difference evolved between the Insular Spaniards, sent over for different periods of time from Spain, to serve as officials, etc., and the \"native\" Spaniards, the Creoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390b718-8429-3be8-9d24-c5935b01b1b4",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "Anyone with mixed ancestry born in a country colonized by Europeans, now especially one who speaks a creole language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dd66cbd-c5b8-3542-a3db-5b3a2889e5f7",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "Someone of African descent who is born in the Caribbean or Americas (originally as opposed to an African immigrant)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffb8e92d-6498-3ef8-a4ed-537efc7a3b53",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "A native-born of Francophone descent in the Louisiana territory of any race, as opposed to Anglo-American settlers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Creole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6313bc3d-dbef-3662-a9de-541648483987",
                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "Pertaining to or characteristic of someone who is a Creole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "018bebda-306b-3096-a0cc-983166a1f2dd",
                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "That is a Creole; especially, born in a colonized country different from that of his or her ancestors."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ba0f7e1-c44f-34ba-b9f4-b66f06808f5d",
                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "Designating a creolized language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "061b616c-b848-3345-bb5e-9ebfe2026c80",
                                        "entry_id": "861105f9-1a46-315b-acb3-d94c6c7a44c1",
                                        "glosses": [
                                            "Prepared according to a cooking style developed in a Creole area, now especially that of Louisiana, characterised by a mixture of European and African influences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Creole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                        "entry_id": "c07080b6-6d75-37b5-ad6a-c5c632560f4f",
                                        "glosses": [
                                            "Any specific creole language, especially that of Haiti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f8fd1c-2b02-4b2f-bac8-87e00fe2b80e",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "She grew up speaking Creole."
                                            },
                                            {
                                                "example_id": "b87f6b04-3f2c-4994-83ce-4788a9d827ae",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "Along with French, Creole is one of Haiti's official languages."
                                            },
                                            {
                                                "example_id": "42f56de3-5221-4395-81f0-d15d36c679b4",
                                                "sense_id": "10d8f222-2b7a-3d0c-990b-da060e07ca38",
                                                "text": "His English is still in its beginning stages, like my Creole, but he was able to translate some Creole songs that he's written into English—not the best English, but English nonetheless."
                                            }
                                        ]
                                    }
                                ]
                            }
