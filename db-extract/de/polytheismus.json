                "senses": [
                    {
                        "sense_id": "4fd7c740-8aa2-3c92-a947-94dea9188fd6",
                        "entry_id": "42f62c76-5901-3a5a-9de4-d298972d8059",
                        "glosses": [
                            "Polythéisme."
                        ],
                        "tags": [],
                        "note": "Le pluriel est plutôt rare, et peut décrire des types de polythéisme différents, ou aussi désigner plusieurs religions polythéistes",
                        "examples": [
                            {
                                "example_id": "7ab2bc51-c5a1-467b-9202-6ca9e14e87b9",
                                "sense_id": "4fd7c740-8aa2-3c92-a947-94dea9188fd6",
                                "text": "Das Judentum hat den Polytheismus abgelegt, da die Juden nur an einen Gott glauben.",
                                "translation": "Le judaïsme a renié le polythéisme, car les Juifs ne croient qu'à un seul dieu."
                            },
                            {
                                "example_id": "d205a8a6-9609-4c86-89db-12aa12b8f9b0",
                                "sense_id": "4fd7c740-8aa2-3c92-a947-94dea9188fd6",
                                "text": "Vor dem Christentum glaubten die Europäer an verschiedene Polytheismen.",
                                "translation": "Avant le christianisme, les Européens croyaient à différents polythéismes."
                            }
                        ]
                    }
                ],
