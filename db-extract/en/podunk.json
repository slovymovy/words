                    {
                        "translation_id": "4ef3662f-a2ae-4348-8788-090b4f2309d5",
                        "source_entry_id": "cd09750f-d43d-3000-986d-22451a7e3bdb",
                        "source_sense_description": "mythical small town of no importance",
                        "target_lang_word": "Trifouillis-les-Oies",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trifouillis-les-Oies",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a1f0f89-2378-39be-a662-8434e3210baf",
                                        "entry_id": "eb3d8b3f-d86d-32b5-8749-76fac10212b1",
                                        "glosses": [
                                            "Variante orthographique de Trifouilly-les-Oies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db9f864-1bcd-460c-bda7-fd60abbbdbeb",
                                                "sense_id": "2a1f0f89-2378-39be-a662-8434e3210baf",
                                                "text": "Non, non, généralement les mecs ont été : soit vainqueur du rallye automobile de Tataouine-les-Bains ; soit vainqueur du critérium de Trifouillis-les-Oies ; […]."
                                            },
                                            {
                                                "example_id": "0a71b911-5b0d-46c6-8a90-34b05af05b2b",
                                                "sense_id": "2a1f0f89-2378-39be-a662-8434e3210baf",
                                                "text": "Sinon c'est moi qui viens habiter ici ou à Trifouillis les oies si tu pars à Trifouillis les oies ! J'ai réfléchi et je m'en tape des qu'en dira-t-on ! Je n'aurai qu'une vie, n'étant ni dieu ni chat, et c'est du court, une vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdae56d-8592-48c8-8bcd-59b3b60a3f91",
                        "source_entry_id": "cd09750f-d43d-3000-986d-22451a7e3bdb",
                        "source_sense_description": "mythical small town of no importance",
                        "target_lang_word": "Hintertupfingen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hintertupfingen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11872ab8-f6e8-3454-8c0f-6848545edc0a",
                                        "entry_id": "7c5d4c53-21ba-3bcc-b16b-a7e07dfb6d2d",
                                        "glosses": [
                                            "fiktiver Ortsname, der für einen kleinen, weit abgelegenen Ort steht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "519f55a5-3fdd-4a60-b76b-fdb0faebc0ec",
                                                "sense_id": "11872ab8-f6e8-3454-8c0f-6848545edc0a",
                                                "text": "Mein Chef will mich irgendwo nach Hintertupfingen versetzen."
                                            },
                                            {
                                                "example_id": "8787db84-f503-46b9-93e0-4a6a596ea7af",
                                                "sense_id": "11872ab8-f6e8-3454-8c0f-6848545edc0a",
                                                "text": "„Statt dessen triumphiert wie nie zuvor – und vielleicht wie niemals wieder – der Lokalstolz von Krähwinkel: Sollte es sich auch um den letzten Kampf handeln – noch einmal flattert jeder Hahn auf seinen Misthaufen, um ihn mit geschwollenem Kamm zu verteidigen; und ob er nun in Hintertupfingen oder in Großprotzstadt kräht: die Reaktion der Betroffenen unterscheidet sich nur in der Wahl der Mittel.“"
                                            },
                                            {
                                                "example_id": "a2722cae-bed4-433b-aa5a-acb6468d53ce",
                                                "sense_id": "11872ab8-f6e8-3454-8c0f-6848545edc0a",
                                                "text": "«Schliesslich gab es kein globales Fernsehprogramm, das jedem Kleingeist in Hintertupfingen einen ebenso kosten- wie mühelosen Blick in die Welt gewährt hätte.»"
                                            },
                                            {
                                                "example_id": "ef3001c2-3336-4411-a669-c5ed307c0638",
                                                "sense_id": "11872ab8-f6e8-3454-8c0f-6848545edc0a",
                                                "text": "„Ich steh mir bei der Kälte doch nicht in Hintertupfingen die Beine in den Bauch, nee, echt nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
