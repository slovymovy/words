                "senses": [
                    {
                        "sense_id": "2d9bf959-c6c4-38ba-95e0-386a06cffff0",
                        "entry_id": "0cdf6b12-7e68-3ce6-904a-882d867e707d",
                        "glosses": [
                            "Brühwurst aus Kalbfleisch, Speck, Gewürzen und Kräutern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506a3355-6353-4350-9e57-a06ddd3f58d8",
                                "sense_id": "2d9bf959-c6c4-38ba-95e0-386a06cffff0",
                                "text": "Weißwürste nach 12 Uhr mittags zu essen, gilt in München als Sakrileg."
                            },
                            {
                                "example_id": "3d04c92f-44b7-4ba9-947d-9135d5b5600c",
                                "sense_id": "2d9bf959-c6c4-38ba-95e0-386a06cffff0",
                                "text": "Ohne süßen Senf schmeckt mir die Weißwurst überhaupt nicht."
                            },
                            {
                                "example_id": "12cdcb86-8ca2-4d2b-8c5a-b7b2d5e147a4",
                                "sense_id": "2d9bf959-c6c4-38ba-95e0-386a06cffff0",
                                "text": "Weißwurst mit süßem Senf, Brezel und Weißbier: Ein typisches bayerisches Frühstück."
                            },
                            {
                                "example_id": "ed7dfc57-f625-424e-9acb-64b405a8d4b9",
                                "sense_id": "2d9bf959-c6c4-38ba-95e0-386a06cffff0",
                                "text": "„Als er aus der Kurznarkose erwacht, die er für das CT bekommen hat, fragt er als Erstes nach ein paar Weißwürsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
