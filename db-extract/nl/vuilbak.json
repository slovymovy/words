                    {
                        "translation_id": "d945ad75-d55f-4127-a193-fce4d54ab960",
                        "source_entry_id": "9aa69ca5-8ccd-329d-adfa-e45694482fe1",
                        "source_sense_id": "35dc7bd3-33a4-3317-acee-9e8f179fd7fb",
                        "source_sense_description": "een bak waarin men huisvuil verzamelt",
                        "target_lang_word": "Abfalleimer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfalleimer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "126b1ff6-d2e9-3747-9f41-5617dd47c9d9",
                                        "entry_id": "a79ba7c6-bda9-3a94-9c3d-22ca8eaaebf9",
                                        "glosses": [
                                            "Behältnis (Eimer), in dem Abfall/Müll gesammelt wird, um ihn später zu entsorgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29c71e9-8c24-4ccf-9974-ed48448218f4",
                                                "sense_id": "126b1ff6-d2e9-3747-9f41-5617dd47c9d9",
                                                "text": "„Er hat sich bislang nur einmal beschwert, und zwar über die jungen Spieler, die im Mannschaftsbus ihre Essensreste liegen lassen hatten, statt sie in die Abfalleimer zu werfen.“"
                                            },
                                            {
                                                "example_id": "e0a3ad08-8d88-4826-8cbe-f58b51acc293",
                                                "sense_id": "126b1ff6-d2e9-3747-9f41-5617dd47c9d9",
                                                "text": "„Die Abfalleimer aus Aluminium standen überquellend von Müll auf der Straße neben den Treppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e57442ac-9973-4b75-8e68-734b5f1542e7",
                        "source_entry_id": "9aa69ca5-8ccd-329d-adfa-e45694482fe1",
                        "source_sense_id": "35dc7bd3-33a4-3317-acee-9e8f179fd7fb",
                        "source_sense_description": "een bak waarin men huisvuil verzamelt",
                        "target_lang_word": "Mülleimer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mülleimer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                        "entry_id": "6838c096-d10e-306e-b610-dbda82c6738c",
                                        "glosses": [
                                            "Behältnis, in dem Abfall gesammelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e5cd62-0c37-4e61-8eca-7ad166b93edb",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "Der Mülleimer müsste mal wieder geleert werden."
                                            },
                                            {
                                                "example_id": "127cae13-c384-437f-9910-fbba3cdebac1",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "Bitte stellen Sie die Mülleimer vor sechs Uhr an den Straßenrand."
                                            },
                                            {
                                                "example_id": "779430ba-a64f-47b0-bb03-3f60408ec795",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Zu Beginn wird ein junger Mann überfahren, der sturzbetrunken nach seinem Junggesellenabschied eine Tasche mit Scheinen aus einem Mülleimer zieht und dabei unwissentlich die Geldübergabe bei einer Entführung stört.“"
                                            },
                                            {
                                                "example_id": "8cc11075-186c-4b02-a5d6-817ff6912d0a",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Er war aufgestanden, um die Brötchentüte in den Mülleimer zu werfen.“"
                                            },
                                            {
                                                "example_id": "232973af-e996-4738-b4a2-4f6b58a3eeb1",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Ich lege also meine Wagenschlüssel auf den Tisch, werfe die Werbung in den Mülleimer und bemerke, dass er voll ist.“"
                                            },
                                            {
                                                "example_id": "2f47e7de-43f3-4905-bf5b-622184f20bd2",
                                                "sense_id": "5c91a15f-ecd3-321f-bc38-2bb3374984e1",
                                                "text": "„Er zwängte sich zwischen dem Wagen und einem Mülleimer durch, schloß auf und ging die Treppe hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc928e34-a67c-4357-bc29-194746a5ded6",
                        "source_entry_id": "9aa69ca5-8ccd-329d-adfa-e45694482fe1",
                        "source_sense_id": "35dc7bd3-33a4-3317-acee-9e8f179fd7fb",
                        "source_sense_description": "een bak waarin men huisvuil verzamelt",
                        "target_lang_word": "poubelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poubelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Récipient destiné à recevoir des détritus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c599155-bd68-4583-bbfe-013c346a6bcc",
                                                "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                                "text": "Il lui fallait pêcher sa croûte, n’importe comment, dans les poubelles, à plat ventre, dans la fange, dans la m... Tout d’ailleurs n’était que m... La société, la belle société, un vaste pot de m..., un gulf-stream de m..."
                                            },
                                            {
                                                "example_id": "84b71e92-16a6-4183-98c8-ea7394e64002",
                                                "sense_id": "ea247a63-47f8-352d-9b79-5f64119e1b26",
                                                "text": "Les zoniers sont nombreux encore qui habitent des cabanes plus ou moins construites avec de vieilles boites à sardines. L'industrie des chiffons et l'exploration matutinale des poubelles ne leur permettent pas de villas plus cossues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e0a692-32a5-3b96-9c20-bfcd9c397c21",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Ensemble des ordures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1bca21d-547f-3318-9f5e-83c385c10b1e",
                                        "entry_id": "3e177374-d7d0-3972-ab03-f4204a1414b8",
                                        "glosses": [
                                            "Mécanisme logiciel qui permet de mettre à l’écart des fichiers qu’on envisage de supprimer → voir corbeille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b29a15-c499-42e6-9798-04925d85e32a",
                                                "sense_id": "a1bca21d-547f-3318-9f5e-83c385c10b1e",
                                                "text": "Sur le bureau on trouve aussi la poubelle. C’est ici que se retrouve tous les objets que vous supprimez. Donc pas de panique si vous avez supprimé un objet par mégarde, il est ici."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poubelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                        "entry_id": "da4ac02f-0fee-314b-aa90-2eb229ffe4eb",
                                        "glosses": [
                                            "Qui est fortement dévalorisé, qui constitue un rebut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f47a94-f644-42a8-9fca-711dd1641bc9",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "Au fond du H.L.M.\nDe cette cité poubelle\nSe cache une fillette\nQui s’ennuie à mourir"
                                            },
                                            {
                                                "example_id": "b879e223-5bcd-4688-ba42-95be2b3a2588",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "Vous passiez un bac G,\nUn bac à bon marché\nDans un lycée poubelle,\nL'ouverture habituelle\nDes horizons bouchés"
                                            },
                                            {
                                                "example_id": "d371ba4e-739e-4e9a-8108-3d072bd5df97",
                                                "sense_id": "82942db5-0eac-3eb1-9be0-f7331601b12b",
                                                "text": "En réponse à « À Québec, il n’y a que des radios poubelles », affiché depuis plusieurs jours un peu partout en ville, les nouvelles affiches diffuseront : « Faux, Québec fait de la bonne radio »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
