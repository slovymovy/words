                            },
                            {
                                "target_lang_word": "偏僻地区",
                                "target_lang_sense_clarification": "指地理位置偏远、交通不便的地方。"
                            },
                            {
                                "target_lang_word": "穷乡僻壤",
                                "target_lang_sense_clarification": "形容非常偏远、荒凉且落后的地方。"
                            }
                        ]
                    },
                    "synonyms": [
