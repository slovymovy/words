                },
                {
                    "sense_id": "9743ef33-4c7b-386b-a08a-190a2b614b18",
                    "sense_definition": "Gebiedende wijs van <w>dweilen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dweil</w> nu direct die gemorste koffie op!",
                            "target_lang_translations": {
                                "en": "<w>Mop</w> up that spilled coffee right now!"
                            }
                        },
                        {
                            "text": "<w>Dweil</w> de vloer grondig voordat je naar buiten gaat.",
                            "target_lang_translations": {
                                "en": "<w>Mop</w> the floor thoroughly before you go outside."
                            }
