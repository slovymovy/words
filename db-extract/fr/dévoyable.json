                        "glosses": [
                            "Qui peut être dévoyé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f915d0a0-35e3-4e18-aad4-4c301b0da6cc",
                                "sense_id": "6c6f0e3a-eb23-3232-8829-309a9fe538bb",
                                "text": "Camus a été obsédé par l’idée que toute entreprise historique est dévoyable."
                            },
                            {
                                "example_id": "4bd0d60e-d851-42f1-b267-3846fe91134a",
                                "sense_id": "6c6f0e3a-eb23-3232-8829-309a9fe538bb",
                                "text": "Tout se révélait dévoyable, chacun s’avérait abusable, on cultivait les dupes dans les grandes villes comme les haricots dans les campagnes."
                            },
                            {
                                "example_id": "caae9af4-0f26-4030-ab08-8812dab0a1b8",
                                "sense_id": "6c6f0e3a-eb23-3232-8829-309a9fe538bb",
                                "text": "En parallèle, les élus locaux pourront modifier le plan local d’urbanisme (PLU) afin de délimiter des zones destinées à la relocalisation des activités et des biens. Mais où seront ces zones, alors que ces territoires sont déjà très peuplés, avec de nombreux espaces protégés ? « C’est un système compliqué, potentiellement très coûteux, et facilement dévoyable », estime Olivier Lozachmeur."
                            }
                        ]
                    }
