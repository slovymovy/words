                        "entry_id": "78f4708d-88f9-3fb2-a210-d07f4f8f7075",
                        "glosses": [
                            "Personne qui transporte et accompagne, dans des véhicules affectés à cet usage, des malades, des blessés ou des parturientes."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
