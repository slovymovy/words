                "senses": [
                    {
                        "sense_id": "ef7c2413-5d78-3084-9894-97660a6dfce2",
                        "entry_id": "1414c4b1-b704-3736-bb7b-5b954eba9c10",
                        "glosses": [
                            "разг. нанять на временную работу на определенных условиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7322eb50-8ace-4be1-98ff-4b5ca2cc7411",
                                "sense_id": "ef7c2413-5d78-3084-9894-97660a6dfce2",
                                "text": "Выяснилось: офицеры вдвоем подрядили извозчика, сели и поехали к месту службы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f29074a0-d199-4440-8059-4e0b8f80ed83",
                        "source_entry_id": "1414c4b1-b704-3736-bb7b-5b954eba9c10",
                        "source_sense_id": "ef7c2413-5d78-3084-9894-97660a6dfce2",
                        "target_lang_word": "hire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dd0f6f1-5046-35f5-823d-3c152095efbc",
                                        "entry_id": "064e3d32-25df-3834-bfdf-b7797d675a4e",
                                        "glosses": [
                                            "A person who has been hired, especially in a cohort."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fdd8b1-8f5f-4b66-af31-90ecb4ec93c8",
                                                "sense_id": "2dd0f6f1-5046-35f5-823d-3c152095efbc",
                                                "text": "We pair up each of our new hires with one of our original hires."
                                            },
                                            {
                                                "example_id": "b96c65af-be04-43e0-a52c-67b41ab0981c",
                                                "sense_id": "2dd0f6f1-5046-35f5-823d-3c152095efbc",
                                                "text": "Employment statistics, the other key indicator of Diversity & Inclusion performance, shows that almost 30% of new Southeastern hires are women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bf530f2-c41e-3550-bb82-59cc129fb811",
                                        "entry_id": "064e3d32-25df-3834-bfdf-b7797d675a4e",
                                        "glosses": [
                                            "The state of being hired, or having a job; employment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17dfd52c-165d-4324-8bac-e1b898810e81",
                                                "sense_id": "1bf530f2-c41e-3550-bb82-59cc129fb811",
                                                "text": "When my grandfather retired, he had over twenty mechanics in his hire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19d0297d-725b-3d08-b445-0faeb5dbbb10",
                                        "entry_id": "064e3d32-25df-3834-bfdf-b7797d675a4e",
                                        "glosses": [
                                            "Payment for the temporary use of something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3d1161-10f3-46da-bbd9-9264a634089d",
                                                "sense_id": "19d0297d-725b-3d08-b445-0faeb5dbbb10",
                                                "text": "The sign offered pedalos on hire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97a1f95-6585-3762-ac16-a62d1eb808c4",
                                        "entry_id": "064e3d32-25df-3834-bfdf-b7797d675a4e",
                                        "glosses": [
                                            "Reward."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9eb6c3-8ac6-4fc1-813d-a47ee19dd175",
                                                "sense_id": "d97a1f95-6585-3762-ac16-a62d1eb808c4",
                                                "text": "I vvill him reaue of armes, the victors hire, / And of that ſhield, more vvorthy of good knight; / For vvhy ſhould a dead dog be deckt in armour bright?"
                                            },
                                            {
                                                "example_id": "0f00e140-9d13-4990-be01-d1cd0d57e50b",
                                                "sense_id": "d97a1f95-6585-3762-ac16-a62d1eb808c4",
                                                "text": "I have five hundred crovvns, / The thrifty hire I ſav'd under your father […]"
                                            },
                                            {
                                                "example_id": "85545029-1b41-48ef-9742-330c40c095b5",
                                                "sense_id": "d97a1f95-6585-3762-ac16-a62d1eb808c4",
                                                "text": "The labourer is worthy of his hire."
                                            },
                                            {
                                                "example_id": "6d7f61f3-f218-4b29-947d-f330ac2150ad",
                                                "sense_id": "d97a1f95-6585-3762-ac16-a62d1eb808c4",
                                                "text": "I haue ſeene a pardon giuen to a man vpon the gallovves, but vvho ſo emboldeneth himſelfe thereuypon, perhaps the rope may be his hire: it is not good to put it vpon the Pſalme of Miſerere, and the neck-verſe, for ſometime he prooues no clarke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66f7cc93-c880-324f-8565-273969b65e12",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To obtain the services of in return for fixed payment."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101cd2f9-876f-46f9-9838-c6432f7f6dcf",
                                                "sense_id": "66f7cc93-c880-324f-8565-273969b65e12",
                                                "text": "We hired a car for two weeks because ours had broken down."
                                            },
                                            {
                                                "example_id": "219a4e50-7565-4538-bdb5-72bc5ae69285",
                                                "sense_id": "66f7cc93-c880-324f-8565-273969b65e12",
                                                "text": "“[…] She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781d6663-bbf4-3970-8262-966bb7d6ecf5",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To occupy premises in exchange for rent."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f37a734-073b-42af-8d28-f65aa59110a8",
                                                "sense_id": "781d6663-bbf4-3970-8262-966bb7d6ecf5",
                                                "text": "I do not mean to insist here on the disadvantage of hiring compared with owning, but it is evident that the savage owns his shelter because it costs so little, while the civilized man hires his commonly because he cannot afford to own it; nor can he, in the long run, any better afford to hire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7289f3cf-116c-3072-be25-5e8a5213e04a",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To employ; to obtain the services of (a person) in exchange for remuneration; to give someone a job."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d81f24ce-cfd5-4347-b81d-4cf6c875de55",
                                                "sense_id": "7289f3cf-116c-3072-be25-5e8a5213e04a",
                                                "text": "The company had problems when it tried to hire more skilled workers."
                                            },
                                            {
                                                "example_id": "157810c4-8f51-423e-83fb-e5a973cccae6",
                                                "sense_id": "7289f3cf-116c-3072-be25-5e8a5213e04a",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345aaa3c-5f6f-3bae-8c30-defbb1fbcfbe",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To exchange the services of for remuneration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5ac265-be42-42a7-9b3b-8b5ceaa5077e",
                                                "sense_id": "345aaa3c-5f6f-3bae-8c30-defbb1fbcfbe",
                                                "text": "They hired themselves out as day laborers.  They hired out their basement for Inauguration week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df1cd06-36f8-3d94-aa04-ec4c6516fe3d",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To accomplish by paying for services."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e520f4-0c5a-48a3-8b01-db9bbcae8248",
                                                "sense_id": "0df1cd06-36f8-3d94-aa04-ec4c6516fe3d",
                                                "text": "After waiting two years for her husband to finish the tiling, she decided to hire it done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3c1458-a065-3f37-b5a3-c705b2d35245",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "To accept employment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45971128-91cd-411b-ad83-80385eefe04a",
                                                "sense_id": "0d3c1458-a065-3f37-b5a3-c705b2d35245",
                                                "text": "They hired out as day laborers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e55d84b-e3fd-3255-a2b5-9fdf6118367c",
                                        "entry_id": "8a17da04-eda8-3dec-8637-f9e219e7cd8a",
                                        "glosses": [
                                            "(neologism) (in the Jobs-to-be-Done Theory) To buy something in order for it to perform a function, to do a job"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c363d3-9098-440e-9f15-a493b9223529",
                                                "sense_id": "9e55d84b-e3fd-3255-a2b5-9fdf6118367c",
                                                "text": "They hired a milkshake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
