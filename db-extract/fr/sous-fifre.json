        "fr-extract.jsonl": [
            {
                "entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                "word": "sous-fifre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cecab8a8-9a16-4359-89da-e5a028d3f68e",
                        "entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "sous-fifres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d96849e-9e16-3ff9-bddd-946820607596",
                        "entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "glosses": [
                            "Personne chargée de basse besogne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32deb16-6a25-40f6-ae39-ba33632f42d3",
                                "sense_id": "3d96849e-9e16-3ff9-bddd-946820607596",
                                "text": "Toujours en France, les sous-fifres, les sous-ordres, les galopins, les saute-ruisseaux, les marmitons, les gâte-sauces (ou gars de sauce) ont décuplé le personnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "94adcd6d-23ba-3332-bf4a-f1304e235b42",
                        "entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "glosses": [
                            "Personne située bas dans une hiérarchie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6169aa1-a6a7-4e62-8a3b-b19492064be9",
                                "sense_id": "94adcd6d-23ba-3332-bf4a-f1304e235b42",
                                "text": "Administrativement, Salah Doba est sous-fifre au sous-sol de la banque nationale Wafa, rue des Trois-Pendules."
                            },
                            {
                                "example_id": "3d6bba09-0c91-41bb-9e2f-60d3ead24172",
                                "sense_id": "94adcd6d-23ba-3332-bf4a-f1304e235b42",
                                "text": "Et il y a là un effet boule de neige puisque, à chaque gros ponte rendu oisif, on libère par la même occasion ses sous-fifres et ses larbins."
                            },
                            {
                                "example_id": "f38c4e87-aa81-4fbb-a551-9241c655ae47",
                                "sense_id": "94adcd6d-23ba-3332-bf4a-f1304e235b42",
                                "text": "Les statistiques montrent qu’à qualité de soin et mode de vie équivalents, le gradient existe toujours. Si vous fumez un paquet de cigarettes par jour, mieux vaut donc, pour votre santé, être chef que sous-fifre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8511ddbb-70a9-4485-b19e-99dc2c5ed9a9",
                        "source_entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "source_sense_id": "3d96849e-9e16-3ff9-bddd-946820607596",
                        "source_sense_description": "Personne chargée de basse besogne",
                        "target_lang_word": "Handlanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handlanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "ungelernte Hilfskraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87b7058-8e02-40aa-a453-53c2ae548cdd",
                                                "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                                "text": "\"Was/wer steckt dahinter? Investmentbankster Goldman-Sachs, im Einklang mit IWF, EZB und deren ausführenden Handlanger der Politik. Interessant zu wissen: Frühere EU- Politiker wie Papademos, Samaras, Simitis aber auch Monti und Prodi (Italien) und Draghi (EZB) standen (stehen auch noch heute?) in Lohn und Brot von Goldman-Sachs. Ein Schelm, der Böses denkt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "\\\"die Absichten oder Aufträge eines Anderen ausführende und erfüllende Person\\"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbcd5e93-27e3-4cb5-bc7a-975a55afc688",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "\"Polier kommt von Polieren und welcher Maurer oder Handlanger hätte seinem Polier nicht gerne schon einmal die Fresse poliert.\""
                                            },
                                            {
                                                "example_id": "4afc4b16-87f1-42b5-af52-1e113e76efcd",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Dann wieder: Die Polen hätten bloß als Handlanger der Russen gehandelt, das Ziel sei Sibirien.“"
                                            },
                                            {
                                                "example_id": "8dbbd451-90d0-45c5-888c-7281b704e27e",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Es bildet sich eine Gruppe als Handlanger der nie erscheinenden Befehlsgeber.“"
                                            },
                                            {
                                                "example_id": "de637129-af77-4158-bbd4-ab1c6b07af52",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Deshalb wurden die ehemaligen Produzenten von Massenvernichtungswaffen zu Handlangern der Massenunterhaltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec95ca97-c50d-495b-9888-5b773f7441ad",
                        "source_entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "source_sense_id": "3d96849e-9e16-3ff9-bddd-946820607596",
                        "source_sense_description": "Personne chargée de basse besogne",
                        "target_lang_word": "Lakai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lakai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                        "entry_id": "0beb8530-9b5d-34b1-a177-1887b1d71213",
                                        "glosses": [
                                            "livrierter Diener"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed62cbd1-6f73-4e63-a5f6-206d61e40ba6",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "In vornehmen Hotels gibt es Lakaien."
                                            },
                                            {
                                                "example_id": "72bf5603-02a9-45e1-adab-746fd8312f7d",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Die Julirevolution machte die Lakaien stellungslos, auch ihn, der seiner Wesensart nach alles eher war denn ein Lakai.“"
                                            },
                                            {
                                                "example_id": "ff1b3a56-4efb-4094-9812-bb461cc36b8c",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Ein Lakai und ein Kirchendiener mit einem Räucherfass kamen ihnen auf den Zehenspitzen entgegen, ohne sie aber zu beachten.“"
                                            },
                                            {
                                                "example_id": "744cf7bc-cf3b-44c8-9496-853aa3270703",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Ich ließ mein Gepäck heraufbringen; mein Lakai kam und machte mir einen anständigen Eindruck.“"
                                            },
                                            {
                                                "example_id": "b96be1bb-03f2-4a17-acb0-c88c2ccbd19b",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Der Lakai auf dem Kutschbock versucht mit verklammten Fingern das Halstuch um die frostroten Ohren zu knüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                        "entry_id": "0beb8530-9b5d-34b1-a177-1887b1d71213",
                                        "glosses": [
                                            "Ja-Sager, Heuchler, der etwas unterstützt, beziehungsweise nicht dagegen vorgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6afba8-dc90-43ee-8086-96bd4f6154fa",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "Der Herr Apotheker hatten den Mitgliedern des Stadtrates gegenüber den Lakaien gemacht."
                                            },
                                            {
                                                "example_id": "1bd26007-bf20-4ccd-adbf-42a8564aee02",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "Die Ölindustrie und ihre Lakaien müssen zur Verantwortung gezogen werden!"
                                            },
                                            {
                                                "example_id": "2346f20c-cf74-4dcc-af59-49fa14063a30",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "„Es war Hugo Machowski mit drei seiner Lakaien, allesamt bemüht, ihn aufzurichten, abzuklopfen und in eine Decke zu hüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d664bd-aedb-45fc-bd51-dbb4d1e5721a",
                        "source_entry_id": "2d83af5f-80a5-35a8-9764-d4582246e5bd",
                        "source_sense_id": "3d96849e-9e16-3ff9-bddd-946820607596",
