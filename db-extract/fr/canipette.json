                        ],
                        "examples": [
                            {
                                "example_id": "2f9e9dd9-d2f5-4643-b822-a3a0e1e44f18",
                                "sense_id": "e9db5ecf-34ca-3603-b1f7-9e44f9599b17",
                                "text": "Oh ! que nenni! je m’passerons ben volontiers du devantiau d’soie, d’la canipette neuve, et des anneaux d’oreilles... plutôt que de vous causer du souci, j’aime ben mieux me conjoindre telle que me v’là, en bonnet de coton."
                            },
                            {
                                "example_id": "cd33ec30-0d23-4fff-b0f9-d09fe7d1b9fd",
                                "sense_id": "e9db5ecf-34ca-3603-b1f7-9e44f9599b17",
                                "text": "Liane s'était contentée d'un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s'appelle une canipette."
                            }
                        ]
                    }
