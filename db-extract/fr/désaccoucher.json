                ],
                "senses": [
                    {
                        "sense_id": "176bbb95-32ed-3724-8710-69c5f4c60379",
                        "entry_id": "c6813770-ef11-3ac4-a31c-da1f66f7694b",
                        "glosses": [
                            "Annuler un accouchement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e004b887-d760-4446-ad91-82b8e0604f34",
                                "sense_id": "176bbb95-32ed-3724-8710-69c5f4c60379",
                                "text": "Seigneur, viens à mon aide ! Ne sois pas mort ! Que notre sœur la mort te désaccouche, qu’elle t’enlève tes langes, qu’elle te naufrage de nouveau sur nos rivages !"
                            },
                            {
                                "example_id": "c7563dad-9101-428f-b628-eefefbb442e1",
                                "sense_id": "176bbb95-32ed-3724-8710-69c5f4c60379",
                                "text": "J’veux vieillir Pour m’amortir du temps qui passe Et rembourser mes godasses Me désaccoucher sans douleur"
                            },
                            {
                                "example_id": "b3dacb6e-4b6d-42b1-9bcb-ca0b570cb7ca",
                                "sense_id": "176bbb95-32ed-3724-8710-69c5f4c60379",
                                "text": "Comment on fait pour désaccoucher (j’veux qu’il rentre dans le ventre de sa môman maintenant mon fils !!!)"
                            },
                            {
                                "example_id": "9d440fb2-e29f-4c58-a77d-ac708f33d688",
                                "sense_id": "176bbb95-32ed-3724-8710-69c5f4c60379",
                                "text": "Effort littéralement démesuré, procédant sans art, opérant comme une contre-chirurgie, désaccouchant de lui-même, se libérant des mains et des forces qui la maintiennent dans l'écart - au centre d’un écart qui ne devrait pas s’ouvrir ou déboucher sur un autre temps."
                            }
                        ]
                    }
                ],
