                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aba18e9-d43a-4c1d-89fc-da4ebca7df6c",
                                "sense_id": "01b4fc45-4f1c-3e87-a46e-c2f91da1fff0",
                                "text": "On rencontre des stations à sol limono-sableux (ou sablo-limoneux, ou limono-sablo-argileux) et souvent très caillouteux (plus de 60 % de cailloux de calcaire dur)."
