                "senses": [
                    {
                        "sense_id": "e8144f89-03f7-3585-909a-9cdec476d784",
                        "entry_id": "c6adfb14-51a2-3b18-b917-11ae2ce8dddb",
                        "glosses": [
                            "das Fehlen von Treue; die Eigenschaft treulos zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "371ea8af-890a-4611-9c84-52fad329224d",
                                "sense_id": "e8144f89-03f7-3585-909a-9cdec476d784",
                                "text": "„Die Mätresse des Marquis hängte sich bei mir ein und sagte rundheraus, ich sei für meine Treulosigkeit bekannt.“"
                            },
                            {
                                "example_id": "ffa97262-1d56-4fec-88b5-24745845efa2",
                                "sense_id": "e8144f89-03f7-3585-909a-9cdec476d784",
                                "text": "Er war schockiert über ihre Treulosigkeit."
                            },
                            {
                                "example_id": "4400bb9d-061b-4cd2-8732-4a35d92d3df6",
                                "sense_id": "e8144f89-03f7-3585-909a-9cdec476d784",
                                "text": "„Das Leben ist eine fortlaufende Kette von Treulosigkeiten.“"
                            },
                            {
                                "example_id": "1632637b-085a-4bc8-b247-3c17ddcb4834",
                                "sense_id": "e8144f89-03f7-3585-909a-9cdec476d784",
                                "text": "„Seine weiblichen Wachsfiguren waren ein endloses Konzentrat der Unreife und Treulosigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
