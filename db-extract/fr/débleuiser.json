                "senses": [
                    {
                        "sense_id": "979dcdb5-d16e-34b5-ad92-2e031c201e69",
                        "entry_id": "d52c8a73-9940-3543-9237-8efaa3ebde37",
                        "glosses": [
                            "Enlever sa couleur bleue à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e40627f-8a11-4af0-9fd9-b04728c0f530",
                                "sense_id": "979dcdb5-d16e-34b5-ad92-2e031c201e69",
                                "text": "Si tu fais un titre accrocheur, prends aussi un peu de temps pour débleuiser (je sais j'ai inventé un mot) tes photos."
                            },
                            {
                                "example_id": "1da508c5-2ae7-46a6-a46e-7db0fa22167f",
                                "sense_id": "979dcdb5-d16e-34b5-ad92-2e031c201e69",
                                "text": "Ne débleuise rien, j'adore cette photo!"
                            },
                            {
                                "example_id": "b62d7f4e-c9d7-4ac6-8baa-42149b9f2ce8",
                                "sense_id": "979dcdb5-d16e-34b5-ad92-2e031c201e69",
                                "text": "Du matin jusqu’au soir, nous attribuant la musculature efficace et la morphologie dynamique du discobole, nous sillonnons l’espace, épiant le globe qui se débleuise, qui se vertdegrise, en décomposition, ivres de notre divin pouvoir, nous esclaffant en passant de la pieuse beauté des icônes de moi."
                            }
                        ]
                    }
                ],
