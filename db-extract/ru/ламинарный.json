                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c626848a-0f44-4bfd-b254-6139785144db",
                                "sense_id": "e39a1606-f451-3e5d-9c98-74cb806a5329",
                                "text": "Обычный ламинарный поток газа, испускаемый соплом рожка, мы можем условно рассматривать как сумму двух потоков: …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9cd82ce-5c05-424b-9ab7-d598a9e40f3d",
