                    {
                        "sense_id": "af378ff5-ea6a-33b8-bb8e-59ccafa560bf",
                        "entry_id": "2182d967-ed0e-3cf4-80b0-0c1a33b89ad4",
                        "glosses": [
                            "Qui vocifère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5bfd17e-a63c-4fc3-9396-21afece6516f",
                                "sense_id": "af378ff5-ea6a-33b8-bb8e-59ccafa560bf",
                                "text": "Comme un lapin dans son terrier, il se précipita dans sa cabine, juste à temps pour éviter le terrifiant et vociférant personnage."
                            },
                            {
                                "example_id": "d2b9aeac-55d6-49fe-98bd-dc37f3d9a9d0",
                                "sense_id": "af378ff5-ea6a-33b8-bb8e-59ccafa560bf",
                                "text": "Les quartiers populaires regorgent d’une humanité vociférante et sordide qu’évoquent quasi tendrement les poèmes en dialecte de Belli."
                            },
                            {
                                "example_id": "042104fb-76f7-46f2-bd7b-60ed88e7a054",
                                "sense_id": "af378ff5-ea6a-33b8-bb8e-59ccafa560bf",
                                "text": "Les émeutiers arrivèrent, une horde vociférante et écervelée, et leur avant-garde se lança vers la barricade comme s’il s’agissait d’une course d’obstacle."
                            }
                        ]
                    }
