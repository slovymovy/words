    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bb9639e-2227-3be5-b9e8-29d71ba3f4ac",
                    "sense_definition": "Établissement public d'enseignement artistique consacré à la musique, à la danse ou à l'art dramatique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "institution_enseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle étudie le violon au <w>conservatoire</w> de la ville depuis trois ans."
                        },
                        {
                            "text": "Pour préparer son examen, il s'entraîne chaque jour au <w>conservatoire</w>."
                        }
                    ],
                    "common_phrases": [
                        "entrer au conservatoire",
                        "conservatoire de musique",
                        "professeur de conservatoire"
                    ]
                },
                {
                    "sense_id": "f4e2d91c-f4ae-3e7c-8b7a-55227a4f6b86",
                    "sense_definition": "Établissement ou organisme destiné à préserver des savoirs, des traditions ou un patrimoine naturel et culturel.",
