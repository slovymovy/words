                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ca0032-42f5-4d9f-8ad6-a98b842d2876",
                                                "sense_id": "91721404-b652-3d8b-839f-5f639ccdf5ae",
                                                "text": "The mad march of Red fascism is a cause for concern in America."
                                            },
                                            {
                                                "example_id": "6be59ef8-5bf9-4d92-a960-65682a70f4bc",
                                                "sense_id": "91721404-b652-3d8b-839f-5f639ccdf5ae",
                                                "text": "Sandra: And the lad who said Joe Stalin was a fascist was right. That's why they called it Red Fascism."
                                            },
                                            {
                                                "example_id": "64ee830c-4ca7-42d7-9594-32c0fd785514",
                                                "sense_id": "91721404-b652-3d8b-839f-5f639ccdf5ae",
                                                "text": "> > Where have you been for the last 40 years ?\n> Obviously in some dimension that runs parallel to your own. Perhaps you should return to yours, and your statement might be greeted with a little less incredulity...\nBy apologists for red fascism you mean."
                                            },
                                            {
                                                "example_id": "ef70a56d-ace3-4cd8-b5cb-f40a241a6762",
                                                "sense_id": "91721404-b652-3d8b-839f-5f639ccdf5ae",
                                                "text": "Red fascism is fascism and if facism^([sic]) is wrong, Communism is doubly so."
                                            },
                                            {
                                                "example_id": "1996b169-e745-4917-b6ee-088e5bcdfa38",
                                                "sense_id": "91721404-b652-3d8b-839f-5f639ccdf5ae",
                                                "text": "The East Germans were Hitler's children in a very real sense. They went from blue fascism to red fascism without a glimpse or memory of freedom."
                                            }
                                        ]
                                    }
