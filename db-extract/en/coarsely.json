                        ]
                    },
                    {
                        "translation_id": "90c11baf-8731-425a-b4cd-d958a8a11c82",
                        "source_entry_id": "02cc8cbf-653a-3586-a9a4-fa20baff3ad7",
                        "source_sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                        "source_sense_description": "in a coarse manner",
                        "target_lang_word": "grossièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une manière grossière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bfdad5-2ad9-47de-a3d9-0ef7a076dc39",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Il y avait dans la chaise un jeune homme grossièrement vêtu."
                                            },
                                            {
                                                "example_id": "535af6a6-0154-4334-a531-5f3373571160",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Les volets, grossièrement faits, se recommandaient par une solide peinture vert dragon."
                                            },
                                            {
                                                "example_id": "2cfc904f-8818-41ac-8d5f-4a0242d8f7ea",
                                                "sense_id": "aebfc8de-dcb5-333b-9e6a-167b4d3a887e",
                                                "text": "Quelques chiffres grossièrement ébauchés sur l’écorce des ormeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fe0dfd-a3d4-3e11-a0b8-6147200bb5db",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une façon opposée à ce qu’il y a de spirituel, d’intellectuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b093fc-a9c8-4058-937e-83e5cc09c0fd",
                                                "sense_id": "11fe0dfd-a3d4-3e11-a0b8-6147200bb5db",
                                                "text": "L’usage des pensées et de l’écriture me sert au besoin [dans l’absence] ; mais cependant, ma fille, je vous avoue grossièrement que j’ai une très sensible envie de vous voir et de vous embrasser de tout mon cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eff68ee-6c12-385f-af28-e02d79f9517b",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Avec maladresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3856d204-548e-4956-b591-c10d0384e67e",
                                                "sense_id": "2eff68ee-6c12-385f-af28-e02d79f9517b",
                                                "text": "Il loue grossièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "D’une manière qui suppose ignorance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3205975-e02f-424b-8b59-35f8ba0cf710",
                                                "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                                "text": "S’ils s’emportent seulement contre les répréhensions et non pas contre les choses qu’on a reprises, je ne m’empêcherai jamais de leur dire qu’ils sont grossièrement abusés et que leur zèle est bien aveugle."
                                            },
                                            {
                                                "example_id": "c2e106cf-3b53-4af5-b2ea-1fc16948860e",
                                                "sense_id": "76648ade-9f6f-386e-97cd-d653ba132c1d",
                                                "text": "Vous êtes donc grossièrement et visiblement trompé, quand, au préjudice de cette divine loi, vous n’apportez à la prière nulle préparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcf9207-6509-35df-842c-ae424b5870c9",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Avec incivilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d171c669-96e4-4010-ab06-08ff19357bf4",
                                                "sense_id": "0dcf9207-6509-35df-842c-ae424b5870c9",
                                                "text": "Répondre grossièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                        "entry_id": "9c0fd0b0-d416-3d57-aed1-7262bb5b893d",
                                        "glosses": [
                                            "Sommairement, imparfaitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f7a2aa-0048-4412-a009-8b067cad0f90",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Les bases des tours visigothes sont carrées ou ont été grossièrement arrondies pour recevoir les défenses du Vᵉ siècle."
                                            },
                                            {
                                                "example_id": "3ef9ed71-1e4a-437a-9c58-2cbfce11f671",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Arrivée au troisième étage, qui passait pour être le second, Manon s’arrêta, fit mouvoir les ressorts d’une antique serrure, et ouvrit une porte peinte en couleur d’acajou ronceux grossièrement imité."
                                            },
                                            {
                                                "example_id": "f91e7d3e-464f-4a41-baf8-b494a7b638cf",
                                                "sense_id": "da806bb6-339e-3185-a5a0-fc1e80dd1fe2",
                                                "text": "Content d’avoir grossièrement esquissé mon plan, je revins aux situations de détail que j’avais tracées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
