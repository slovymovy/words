                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1180b245-42d9-4e9e-85fc-ba26c2847f23",
                                "sense_id": "bc8268f8-d25a-35fc-a01d-71f980770ccd",
                                "text": "Near-synonym: dartlike"
                            },
