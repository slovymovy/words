{
    "word_family": [
        "slag",
        "omslag",
        "slagen",
        "verslaan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b266cb49-8d9b-3ad3-841c-cd4d889ca62b",
                    "sense_definition": "een bladzijde of blad papier omdraaien om de andere kant te bekijken of verder te lezen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "omdraaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>sloeg</w> de bladzijde <w>om</w> om aan het volgende hoofdstuk te beginnen.",
                            "target_lang_translations": {
                                "en": "She <w>turned the page</w> to start the next chapter."
                            }
                        },
                        {
                            "text": "Je moet voorzichtig de pagina <w>omslaan</w> zodat het papier niet scheurt.",
                            "target_lang_translations": {
                                "en": "You must <w>turn</w> the page carefully so that the paper doesn't tear."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdraaien",
                        "omkeren"
                    ],
                    "common_phrases": [
                        "bladzijde omslaan",
                        "pagina omslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn over a page or sheet of paper to see the other side or continue reading"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn over",
                                "target_lang_sense_clarification": "a page or leaf of paper"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "the page"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5ddf78-d6d4-3a42-adc7-5d2c10b4d4c2",
                    "sense_definition": "een plotselinge en vaak volledige verandering ondergaan van een toestand, stemming of situatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "veranderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het weer zal snel <w>omslaan</w> van zonnig naar regenachtig.",
                            "target_lang_translations": {
                                "en": "The weather will <w>change</w> quickly from sunny to rainy."
                            }
                        },
                        {
                            "text": "De sfeer in de groep kan plotseling <w>omslaan</w> als er ruzie ontstaat.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the group can suddenly <w>turn</w> if an argument arises."
                            }
                        }
                    ],
                    "synonyms": [
                        "veranderen",
                        "kantelen"
                    ],
                    "common_phrases": [
                        "weer omslaan",
                        "stemming omslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to undergo a sudden and often complete change in condition, mood, or situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "change",
                                "target_lang_sense_clarification": "suddenly, like weather or mood"
                            },
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "a sudden shift in atmosphere or weather"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "a change in mood or situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb01ec01-8663-36d2-a49c-5a4e43fdd958",
                    "sense_definition": "het onbedoeld kantelen of ondersteboven raken van een voertuig of vaartuig",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kantelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boot <w>sloeg om</w> en alle opvarenden vielen in het koude water.",
                            "target_lang_translations": {
                                "en": "The boat <w>capsized</w> and all those on board fell into the cold water."
                            }
                        },
                        {
                            "text": "Door de harde wind kan een kleine zeilboot gemakkelijk <w>omslaan</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong wind, a small sailboat can easily <w>capsize</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkantelen",
                        "omvallen",
                        "kapseizen"
                    ],
                    "common_phrases": [
                        "boot omslaan",
                        "schip omslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "the unintentional tilting or turning upside down of a vehicle or vessel"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "capsize",
                                "target_lang_sense_clarification": "specifically for boats or ships"
                            },
                            {
                                "target_lang_word": "overturn",
                                "target_lang_sense_clarification": "a vehicle or vessel"
                            },
                            {
                                "target_lang_word": "tip over",
                                "target_lang_sense_clarification": "to lose balance and fall"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "665b76c1-a850-3dae-8d9a-2e7db791f7e3",
                    "sense_definition": "een hoek of bocht omgaan om een andere richting in te slaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto reed erg hard waarna hij de hoek <w>omsloeg</w>.",
                            "target_lang_translations": {
                                "en": "The car was driving very fast, after which it <w>turned</w> the corner."
                            }
                        },
                        {
                            "text": "Je moet de eerste straat <w>omslaan</w> om bij het museum te komen.",
                            "target_lang_translations": {
                                "en": "You have to <w>turn into</w> the first street to get to the museum."
                            }
                        }
                    ],
                    "synonyms": [
                        "afslaan",
                        "omgaan"
                    ],
                    "common_phrases": [
                        "hoek omslaan",
                        "straat omslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to go around a corner or bend to take a different direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "around a corner or into a street"
                            },
                            {
                                "target_lang_word": "go around",
                                "target_lang_sense_clarification": "a corner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}