                        "form_id": "59ef1f94-3890-4e40-8db7-7583e4b17d01",
                        "entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
                        "tags": [
                            "comparative"
                        ],
                        "form": "речи́стей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3da916bb-e17a-34da-918a-6713a3268dde",
                        "entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
                        "glosses": [
                            "разг. легко, красиво говорящий; красноречивый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd17dea-7ad3-4633-a7ea-bbea4c2ac9a0",
                                "sense_id": "3da916bb-e17a-34da-918a-6713a3268dde",
                                "text": "О Марк Туллий! О ты, речистый самый Из праправнуков Ромула на свете"
                            }
                        ]
                    },
                    {
                        "sense_id": "daa68e7c-11a3-3f6d-8f9f-07852afbd8fa",
                        "entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
                        "glosses": [
                            "разг. словоохотливый, разговорчивый, любящий говорить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ff72b2-d505-422a-83b1-0988318276e0",
                                "sense_id": "daa68e7c-11a3-3f6d-8f9f-07852afbd8fa",
                                "text": "Дядя Василий ― бойкий и речистый мужик ― любит натолковать и покричать не хуже иной бабы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ba6eeff-a4d2-483d-a17c-cf121b49d94f",
                        "source_entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
                        "source_sense_description": "легко, красиво говорящий; красноречивый",
                        "target_lang_word": "eloquent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eloquent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "434ee677-0be9-35bd-9687-39f641b64d9d",
                                        "entry_id": "361e7739-6f76-3905-b4fc-f10ba25fafef",
                                        "glosses": [
                                            "Fluently persuasive and articulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9e3cb9-c43a-4740-8361-93e056f2f0fe",
                                                "sense_id": "434ee677-0be9-35bd-9687-39f641b64d9d",
                                                "text": "an eloquent writer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b934f5da-20dd-370a-9644-68e9d639d96d",
                                        "entry_id": "361e7739-6f76-3905-b4fc-f10ba25fafef",
                                        "glosses": [
                                            "Effective in expressing meaning by speech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d4e2e24-3863-4e5f-8da8-d03eec2f37aa",
                                                "sense_id": "b934f5da-20dd-370a-9644-68e9d639d96d",
                                                "text": "an eloquent article"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362e174c-43c6-34e9-b874-7fee4a3ce618",
                                        "entry_id": "361e7739-6f76-3905-b4fc-f10ba25fafef",
                                        "glosses": [
                                            "Relating to areas in the brain that serve an identifiable neurological function, in which injury leads to focal deficits or disability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043a9b42-11fe-4dd9-a50d-5b92fdaf81fc",
                                                "sense_id": "362e174c-43c6-34e9-b874-7fee4a3ce618",
                                                "text": "Lydiard was diagnosed shortly after new year following speech disturbance and subtle memory issues. He has a high-grade glioma, an aggressive malignant primary brain tumour in the left side. It is in the “eloquent brain”, very close to the part that controls speech, and would have been considered untreatable in the past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa21b8f0-078c-4977-899b-db2376404d80",
                        "source_entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
                        "source_sense_description": "словоохотливый, разговорчивый, любящий говорить",
                        "target_lang_word": "voluble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voluble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                                        "entry_id": "daa9a1f0-3bf0-339b-93f1-edba0776b79b",
                                        "glosses": [
                                            "Fluent or having a ready flow of speech."
                                        ],
                                        "tags": [
                                            "of a person or a manner of speaking"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55248623-ebff-4288-bf87-e0cca2c10c09",
                                                "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                                                "text": "A moſt acute Iuuvenal, voluble and free of grace, […]"
                                            },
                                            {
                                                "example_id": "176221fe-3a14-4041-9f8b-829c54da96e9",
                                                "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                                                "text": "What fun shone in his eyes as he recalled some of her fine speeches, and repeated them, imitating her voluble delivery!"
                                            },
                                            {
                                                "example_id": "b717449d-76a2-4800-a5c3-6a604eec13f9",
                                                "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                                                "text": "But Wolf Larsen seemed voluble, prone to speech as I had never seen him before. It was as though he were bursting with pent energy which must find an outlet somehow."
                                            },
                                            {
                                                "example_id": "6bd12e53-554d-4862-9c35-e7f1b2ea1cd7",
                                                "sense_id": "3d27d3ad-da7c-3946-823b-2fc92c96a7e8",
                                                "text": "In the summer of 2020, Daniel Beunza, a voluble Spanish social scientist who taught at Cass business school in London, organised a stream of video calls with a dozen senior bankers in the US and Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                                        "entry_id": "daa9a1f0-3bf0-339b-93f1-edba0776b79b",
                                        "glosses": [
                                            "Of thoughts, feelings, or something that is expressed: expressed readily or at length and in a fluent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35631fd3-534e-40d2-a043-3cb74610db8d",
                                                "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                                                "text": "Thus farr the occaſion of this diſcours againſt Tumults; now to the diſcours itſelf, voluble anough, and full of ſentence, but that, for the moſt part, either ſpecious rather then ſolid, or to his cauſe nothing pertinent."
                                            },
                                            {
                                                "example_id": "5899ae8c-5a12-4793-8bb1-4d860d3acced",
                                                "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                                                "text": "[H]e heard the voice of the drunken woman, now sober, poured out in voluble remorse, and in voluble promise of amendment for the future, to every one who passed, if they would let her off easy."
                                            },
                                            {
                                                "example_id": "e5a8e628-f1f1-42ed-b76a-43168c590612",
                                                "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                                                "text": "As a rule Lady Anne's displeasure became articulate and markedly voluble after four minutes of introductory muteness."
                                            },
                                            {
                                                "example_id": "f57a5f35-6972-4dad-aae3-f5de8b3ca10e",
                                                "sense_id": "44cd58ea-53d3-3bac-bd8a-ba9c78417e96",
                                                "text": "In the daylit corridor he talked with voluble pains of zeal, in duty bound, most fair, most kind, most honest broadbrim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb3ecf4-911c-37ab-a5d7-ea096813267a",
                                        "entry_id": "daa9a1f0-3bf0-339b-93f1-edba0776b79b",
                                        "glosses": [
                                            "Easily rolling or turning; having a fluid, undulating motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0208533-9035-4e27-9514-1b6d1eed367b",
                                                "sense_id": "8fb3ecf4-911c-37ab-a5d7-ea096813267a",
                                                "text": "Seen from the west, their sky-line gallops away north and south like a sea-serpent in voluble motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3d03002-31d4-3ab6-84d7-156ee9c2e0e3",
                                        "entry_id": "daa9a1f0-3bf0-339b-93f1-edba0776b79b",
                                        "glosses": [
                                            "Twisting and turning like a vine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcc01629-e5e8-4955-ac65-7a42f943ea9d",
                        "source_entry_id": "fbefe34b-828a-3d61-9ccc-c5d7dd725269",
