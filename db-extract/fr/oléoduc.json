                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e791a2-a68c-479e-914b-068c6605c187",
                                                "sense_id": "e6f3fa8c-9927-3d2f-8e10-d248500e807c",
                                                "text": "An oil pipeline has been opened from the Caspian Sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df3bdc88-c629-3e02-9066-d4806e618d96",
                                        "entry_id": "21b945a4-ab9d-3f7a-bb42-bdbbc5692636",
                                        "glosses": [
                                            "A channel (either physical or logical) by which information is transmitted sequentially (that is, the first information in is the first information out)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a9ed95-92f6-414c-996c-f961e1643cc8",
                                                "sense_id": "df3bdc88-c629-3e02-9066-d4806e618d96",
                                                "text": "3D images are rendered using the graphics pipeline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                        "entry_id": "21b945a4-ab9d-3f7a-bb42-bdbbc5692636",
                                        "glosses": [
                                            "A system or process through which something is conducted."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d5d835b-1659-4f55-b7d8-7cc7f82ca4b4",
                                                "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                                "text": "A new version of the software is in the pipeline, but has not been rolled out."
                                            },
                                            {
                                                "example_id": "b2a5a16e-a9ad-453e-9796-0c49519b118f",
                                                "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                                "text": "April 19 2002, Scott Tobias, AV Club Fightvillehttp://www.avclub.com/articles/fightville,72589/\nThe gym’s proprietor, “Crazy” Tim Credeur, heads up the Gladiator Academy, which serves as a pipeline for amateur MMA fighters to move up the ranks, though few of them do."
                                            },
                                            {
                                                "example_id": "de0b4ffa-6b3f-440f-8a5b-ca7787102d75",
                                                "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                                "text": "History education has also been considered as a pipeline that connects learners with 'their roots', thereby imbuing in them an awareness of their identity."
                                            },
                                            {
                                                "example_id": "086d36f2-f6b4-49ee-9266-50231eb33934",
                                                "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                                "text": "A bracing Department of Justice lawsuit filed last month against Meridian, Miss[issippi] […] argues that the city’s juvenile justice system has operated a school to prison pipeline that shoves students out of school and into the criminal justice system […]"
                                            },
                                            {
                                                "example_id": "fce44f59-eecf-4802-89f5-1bb4e75ebc05",
                                                "sense_id": "bd1ba16e-2b0a-36a6-b70d-dd21285d1b29",
                                                "text": "Scottish rail suppliers have told the Government that they can only reach their target of employing 500 apprentices if they are given a clear pipeline of work, rather than having to endure the current stop-go programme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a5db585-f495-3fe0-bb8a-117dc5ed26b4",
                                        "entry_id": "21b945a4-ab9d-3f7a-bb42-bdbbc5692636",
                                        "glosses": [
                                            "A widely observed pattern of development in personal interests, circumstances, or opinions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e7720e-e903-4746-9b11-07f524d4b829",
                                                "sense_id": "1a5db585-f495-3fe0-bb8a-117dc5ed26b4",
                                                "text": "Many who grew up in foster homes in the county have fallen victim to the foster-care-to-homelessness pipeline."
                                            },
                                            {
                                                "example_id": "d7866638-dbe8-4907-ab27-408a0303c279",
                                                "sense_id": "1a5db585-f495-3fe0-bb8a-117dc5ed26b4",
                                                "text": "I recently had a peer reviewer demand that I refer to the so-called “Fortnite to alt-right pipeline” as though games automatically turn players into right-wing extremists."
                                            },
                                            {
                                                "example_id": "f780588a-4fde-41c7-ba79-2755be70aeb3",
                                                "sense_id": "1a5db585-f495-3fe0-bb8a-117dc5ed26b4",
                                                "text": "Belew’s book offers a comprehensive history of the military-to-extremism pipeline in America since the Vietnam War, arguing that the ‘potent sense of betrayal’ felt by some white military personnel contributed to the rise of an over-trained and over-armed anti-government militia movement with a distinctly violent racist agenda."
                                            },
                                            {
                                                "example_id": "ca4cf4ab-6c10-47c4-a507-25ff34c9d1ac",
                                                "sense_id": "1a5db585-f495-3fe0-bb8a-117dc5ed26b4",
                                                "text": "But increasingly, the reality TV-to-social-influencer pipeline has dried up. While the majority of contestants on reality TV dating shows like The Bachelor don’t come out meeting their forever love, they previously knew that if they resonated with viewers at home, they would be all but guaranteed hundreds of thousands, or millions of Instagram followers—and a lucrative career as an influencer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a324266-2655-34a6-b336-4ece3153824d",
                                        "entry_id": "21b945a4-ab9d-3f7a-bb42-bdbbc5692636",
                                        "glosses": [
                                            "A continuous, contributing source of benefits, talent, or innovation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bca189a4-7d6b-31d2-9e98-b07075c05761",
                                        "entry_id": "21b945a4-ab9d-3f7a-bb42-bdbbc5692636",
                                        "glosses": [
                                            "The inside of a wave that a surfer is riding, when the wave has started closing over it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
