                    {
                        "translation_id": "564ec872-411b-49d2-a507-1642cdf85c04",
                        "source_entry_id": "fc6eb121-53e8-3e14-89a2-d5584b60a36a",
                        "source_sense_id": "f07dd0dc-a517-3f45-af74-85c31682740d",
                        "source_sense_description": "a drug that numbs the pain in the body",
                        "target_lang_word": "pijnstiller",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pijnstiller",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                        "entry_id": "f4080ae0-08ac-3236-a5ea-fb6c58822c39",
                                        "glosses": [
                                            "een middel dat de verschijnselen van een ziekte onderdrukt zonder de ziekte te genezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1a0149-360c-4703-b0d5-dc74f3c825be",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Hij leefde bij gratie van de pijnstiller."
                                            },
                                            {
                                                "example_id": "2f7275b9-d5e3-4a25-b827-ada724443835",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Twee artsen constateren op basis van een meta-analyse dat twee morfine-achtige pijnstillers (oxycodon en fentanyl) nauwelijks beter werken dan een placebo"
                                            },
                                            {
                                                "example_id": "ff17c09a-3679-4fd0-8692-7445ed65e2b2",
                                                "sense_id": "0b733590-6175-3cad-8df6-f8561b15811a",
                                                "text": "Sinds OxyContin op de markt kwam zijn in Amerika zo'n tweehonderdduizend Amerikanen gestorven door een overdosis pijnstillers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48f9a8e7-6aa9-4191-b74d-bbe8ab4cbeca",
                        "source_entry_id": "fc6eb121-53e8-3e14-89a2-d5584b60a36a",
                        "source_sense_id": "f07dd0dc-a517-3f45-af74-85c31682740d",
                        "source_sense_description": "a drug that numbs the pain in the body",
                        "target_lang_word": "analgésique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analgésique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "332729ed-f519-38e5-9126-f31f96a8597d",
                                        "entry_id": "b48c90c3-a39f-36e8-be7d-7c92a11b0665",
                                        "glosses": [
                                            "Qui produit l’analgésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62cf09ba-ca97-4d88-8bf4-f8c95d86141c",
                                                "sense_id": "332729ed-f519-38e5-9126-f31f96a8597d",
                                                "text": "Lorsque ce bilan est rapide et la lésion causale facilement accessible ( pulpite, desmodontite… ) celle-ci n’appelle qu’une thérapeutique locale. Dans un cas contraire la thérapeutique analgésique est habituellement inévitable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "analgésique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                        "entry_id": "c70d107a-4517-3836-b327-d59722138fcc",
                                        "glosses": [
                                            "Médicament utilisé pour calmer la douleur."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c466f196-302c-4d04-8b92-9b21ccbf73f2",
                                                "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                                "text": "L’antipyrine est très employée comme analgésique et hémostatique."
                                            },
                                            {
                                                "example_id": "345c0d8b-968a-4968-b160-17d19cb7051c",
                                                "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                                "text": "C’est à l’origine un sédatif et anesthésiant pour animaux hyperpuissant. Mais la xylazine est aujourd’hui, aux États-Unis, vendue mélangée à un analgésique de synthèse, le fentanyl, qui, utilisé seul, était déjà considéré par l’agence fédérale dédiée à la prévention des risques sanitaires comme « cinquante fois plus fort que l’héroïne». Le cocktail des deux, appelé «zombie drug» ou «tranq dope », est donc pire encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e3356d-45d3-4671-9fe3-725dd63cee3c",
                        "source_entry_id": "fc6eb121-53e8-3e14-89a2-d5584b60a36a",
                        "source_sense_id": "f07dd0dc-a517-3f45-af74-85c31682740d",
