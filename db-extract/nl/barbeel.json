                                        "examples": [
                                            {
                                                "example_id": "f7de3e85-dfb1-431f-a04a-8b58376aead7",
                                                "sense_id": "ff8b6946-aba1-3a8e-b91d-75f0513807ab",
                                                "text": "Der Rogen der Barbe ist giftig."
                                            },
                                            {
                                                "example_id": "f912237a-c30f-4ad2-a1ff-525e327491f3",
                                                "sense_id": "ff8b6946-aba1-3a8e-b91d-75f0513807ab",
                                                "text": "„Wahrhaftig hatte Ausonius zu Beginn der Stelle über die Fische der Mosel nämlich auch davon geschrieben, wie er sich über das Wasser gebeugt und in die klare Tiefe des Moselwassers geschaut und dort in der Tiefe den Sand und sogar die grünen Gräser und die leuchtenden Kiesel gesehen und dann, bei längerem Hinschauen, schließlich die Fische entdeckt hatte: Forellen, Barben, Hechte, Welse und noch viele andere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bd84701-e83f-3f0d-a3ba-7044d7fbc00e",
                                        "entry_id": "c37cdd2f-866a-3399-9d01-901a5e1cc076",
                                        "glosses": [
                                            "die Unterfamilie Barbinae oder auch Gattung Barbus im weiteren Sinne"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5840ed2a-7167-4f16-a19f-e9fcab276d44",
                                                "sense_id": "1bd84701-e83f-3f0d-a3ba-7044d7fbc00e",
                                                "text": "In Amerika gibt es keine Barben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
