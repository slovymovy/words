                        "examples": [
                            {
                                "example_id": "f91c6644-2716-478f-8949-d95565b33fd9",
                                "sense_id": "3b221846-ba1d-3f96-b51e-500e627bd5ba",
                                "text": "The Walkers make their bread from cornmeal, which they grate on a piece of tin punched full of holes and fastened to a board. This is known as \"gritten\" bread."
                            },
                            {
                                "example_id": "18cf5e6e-d7d8-43c6-a4aa-c212f18c6d56",
                                "sense_id": "3b221846-ba1d-3f96-b51e-500e627bd5ba",
                                "text": "He would go out into one of his cornfields and select a few ears of corn, the kernels of which could be barely dented with the thumb nail. These ears were converted into \"gritten cornbread.\""
                            }
                        ]
                    }
