                "senses": [
                    {
                        "sense_id": "5ae046c2-3129-3a5d-ad90-6b1a20c9f9ad",
                        "entry_id": "3a58ed55-880d-3652-999a-070d41e4a2d6",
                        "glosses": [
                            "Teilbereich der Buchhaltung (früher ein Heft/Buch, erst im Besitz des Arbeitnehmers, später vom Arbeitgeber geführt), in dem Entgeltzahlungen (Ausgaben für Lohn und Gehalt) festgehalten werden"
                        ],
                        "tags": [
                            "Betriebswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "bf78f2ac-9f38-421a-839a-f52060d6dd5a",
                                "sense_id": "5ae046c2-3129-3a5d-ad90-6b1a20c9f9ad",
                                "text": "„Insbesondere hat der Arbeitgeber auf Verlangen die Lohnbücher vorzulegen.“"
                            },
                            {
                                "example_id": "3f7db519-f0cc-404d-a25a-2069ac252381",
                                "sense_id": "5ae046c2-3129-3a5d-ad90-6b1a20c9f9ad",
                                "text": "„Der § 114a der Gewerbeordnung enthält die folgende Fassung: Für bestimmte Gewerbe kann der Bundesrat Lohnbücher oder Arbeitszettel vorschreiben und die zur Ausführung erforderlichen Vorschriften erlassen.“"
                            },
                            {
                                "example_id": "40205f47-d47a-48f1-9f94-4bdf863d0061",
                                "sense_id": "5ae046c2-3129-3a5d-ad90-6b1a20c9f9ad",
                                "text": "„So berichteten die Gewerkschaften der Enquetekommission, der Staatsanwalt habe ihnen untersagt, Arbeiter auf der Straße anzuhalten und anhand des Lohnbuches zu kontrollieren, ob sie Arbeit unter Tarif angenommen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
