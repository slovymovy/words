{
    "word_family": [
        "coherence",
        "coherency",
        "cohere",
        "coherently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                    "sense_definition": "Not making logical sense; not logically connected or consistent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "logical_consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When we confronted her, she gave us a hasty, <w>incoherent</w> explanation.",
                            "target_lang_translations": {
                                "ru": "Когда мы потребовали объяснений, она дала нам поспешное и <w>бессвя́зное</w> объяснение."
                            }
                        },
                        {
                            "text": "After just a few drinks, he becomes <w>incoherent</w>.",
                            "target_lang_translations": {
                                "ru": "Всего после нескольких рюмок он становится <w>несвя́зным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unintelligible",
                        "disjointed",
                        "disconnected"
                    ],
                    "antonyms": [
                        "coherent"
                    ],
                    "common_phrases": [
                        "incoherent speech",
                        "incoherent rambling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий логического смысла; нелогичный или непоследовательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессвя́зный",
                                "target_lang_sense_clarification": "о речи или мыслях, лишенных логической связи"
                            },
                            {
                                "target_lang_word": "несвя́зный",
                                "target_lang_sense_clarification": "о высказывании, которое трудно понять из-за отсутствия логики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5213cf6b-7423-3f83-9ac6-d4492c8204f8",
                    "sense_definition": "Not holding together physically; loose; unconnected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sand was <w>incoherent</w> and shifted easily under our feet.",
                            "target_lang_translations": {
                                "ru": "Песок был <w>ры́хлым</w> и легко осыпался под нашими ногами."
                            }
                        },
                        {
                            "text": "The material was just a pile of <w>incoherent</w> particles.",
                            "target_lang_translations": {
                                "ru": "Материал представлял собой просто кучу <w>несцементи́рованных</w> частиц."
                            }
                        }
                    ],
                    "synonyms": [
                        "disconnected",
                        "discontinuous"
                    ],
                    "antonyms": [
                        "coherent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не скрепленный физически; рассыпчатый, несвязный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ры́хлый",
                                "target_lang_sense_clarification": "о сыпучих материалах, не имеющих плотной структуры"
                            },
                            {
                                "target_lang_word": "несцементи́рованный",
                                "target_lang_sense_clarification": "о частицах, которые не соединены друг с другом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "533a0715-eade-31ea-8e5e-7b8b6fa204f1",
                    "sense_definition": "Not united or organized as a group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_unity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters remained an <w>incoherent</w> mass without a clear leader.",
                            "target_lang_translations": {
                                "ru": "Протестующие оставались <w>разро́зненной</w> массой без четкого лидера."
                            }
                        },
                        {
                            "text": "They struggled to organize the <w>incoherent</w> group into a team.",
                            "target_lang_translations": {
                                "ru": "Им было трудно превратить эту <w>неорганизо́ванную</w> группу в команду."
                            }
                        }
                    ],
                    "synonyms": [
                        "disjointed",
                        "unrelated"
                    ],
                    "antonyms": [
                        "coherent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не объединенный в группу; разрозненный, неорганизованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разро́зненный",
                                "target_lang_sense_clarification": "о группе людей, не имеющей единства или общей цели"
                            },
                            {
                                "target_lang_word": "неорганизо́ванный",
                                "target_lang_sense_clarification": "о группе, лишенной структуры и порядка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}