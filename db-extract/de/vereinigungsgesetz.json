                "senses": [
                    {
                        "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                        "entry_id": "bac69d2b-681e-3da4-ba99-d9e93d5b6b8a",
                        "glosses": [
                            "vom Gesetzgeber erlassene Regel unter anderem über das Bei- und Austreten eines Vereins oder einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6fab64-c0ab-4289-9920-77968f5b8538",
                                "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                                "text": "„Am 21. Oktober hatte die badische Landessynode einstimmig das Vereinigungsgesetz für die beiden Kirchenbezirke im Südwesten beschlossen.“"
                            },
                            {
                                "example_id": "8df825d9-755a-4014-9904-b58f8886edf7",
                                "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                                "text": "„Neue Medien- und Vereinigungsgesetze traten im Dezember 2011 in Kraft.“"
                            },
                            {
                                "example_id": "16a85952-15dd-4c39-a611-715ad31bd308",
                                "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                                "text": "„Ein Zusatz zum Vereinigungsgesetz verbietet den Angestellten im öffentlichen Dienst, sich gewerkschaftlich zusammenzuschließen.“"
                            },
                            {
                                "example_id": "36a8403c-2fb3-459a-b1f1-372a7ac7c2ab",
                                "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                                "text": "„Viele haben jetzt schon Sorge um das als beinahe heilig geltende Vereinigungsgesetz.“"
                            },
                            {
                                "example_id": "d72cba29-ab11-4ea7-b0ab-74dcab071d40",
                                "sense_id": "2530851f-f18a-392d-90d5-a6c0f7c37963",
                                "text": "„Seit dem späten siebzehnten Jahrhundert hatten sich die Beziehungen zwischen England und Schottland verschlechtert - dann, mit dem Vereinigungsgesetz, kam es sozusagen zur Heirat, wurden doch die Regierungen beider Länder durch das Parliament of Great Britain in Westminster ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
