                                        "glosses": [
                                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch eines Hammels; kurz für Hammelfleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f2a913-6b28-499c-9e72-f67a1077f838",
                                                "sense_id": "f0a5c8be-7201-378d-892d-306f05ed0d52",
                                                "text": "Vielen Leuten schmeckt Hammel nicht besonders gut."
                                            },
                                            {
                                                "example_id": "04f623ae-ccb2-43ca-8e08-137f755375b1",
                                                "sense_id": "f0a5c8be-7201-378d-892d-306f05ed0d52",
                                                "text": "„Jahrelang hatte ich von den wunderbaren Hühnergerichten in den dortigen Restaurants gehört, aber wir hatten Hammel gegessen.“"
