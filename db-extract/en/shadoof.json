                                        "glosses": [
                                            "rodzaj dźwignicy do wydobywania wody ze studni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492f8be9-a0aa-4dc2-ba9c-61d7b0d26f9f",
                                                "sense_id": "a7959bd4-93c3-3df1-bd06-6670d4d03574",
                                                "text": "Studnie z żurawiami były kiedyś charakterystycznym elementem gospodarstw na Podlasiu."
                                            }
