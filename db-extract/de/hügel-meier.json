                "senses": [
                    {
                        "sense_id": "1320b2f4-7856-3281-9fa0-70ebfe32cd6c",
                        "entry_id": "0a770b44-fa21-39a2-9c33-d00f8583436b",
                        "glosses": [
                            "Pflanzenart (Asperula cynanchica) aus der Gattung Meier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f851cb3f-2ab9-4638-9c73-ef2e568faae0",
                                "sense_id": "1320b2f4-7856-3281-9fa0-70ebfe32cd6c",
                                "text": "„Die Raupen ernähren sich unter anderem von Hügel-Meier (Asperula cynanchica), Gänseblümchen (Bellis perennis) und Labkrautarten (Galium).“"
                            },
                            {
                                "example_id": "74ef204c-9465-41c9-aa60-b8a2ef949f77",
                                "sense_id": "1320b2f4-7856-3281-9fa0-70ebfe32cd6c",
                                "text": "„Asperula cynanchica, der Hügel-Meier oder Hügel-Meister, ist ein naher verwandter des besser bekannten Waldmeisters und ebenfalls eine einheimische Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
