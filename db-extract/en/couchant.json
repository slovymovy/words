                "senses": [
                    {
                        "sense_id": "027c808b-f836-3bd2-947e-055b9d550c0b",
                        "entry_id": "98b2f4fb-fbf3-303e-9ee7-e284de20cc8b",
                        "glosses": [
                            "Lying with belly down and front legs extended; crouching."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fa135659-2bca-4885-a65e-a099409fcafa",
                                "sense_id": "027c808b-f836-3bd2-947e-055b9d550c0b",
                                "text": "The dogs, with eager yelp, / Are struggling to be free; / The hawks in frequent stoop / Token their haste for flight; / And couchant on the saddle-bow, / With tranquil eyes, and talons sheath’d, / The ounce expects his liberty."
                            },
                            {
                                "example_id": "fec274a4-12bd-4521-9ce8-956c2a7948ce",
                                "sense_id": "027c808b-f836-3bd2-947e-055b9d550c0b",
                                "text": "There were the tawny rocks, like lions couchant, defying the ocean, whose waves incessantly dashed against and scoured them with vast quantities of gravel."
                            },
                            {
                                "example_id": "11884cd4-10d0-40b3-871c-e6b81c0ec076",
                                "sense_id": "027c808b-f836-3bd2-947e-055b9d550c0b",
                                "text": "Two figures faced each other, large, austere; / A couchant sphinx in shadow to the breast, / An angel standing in the moonlight clear; […]"
                            },
                            {
                                "example_id": "084970d1-8dee-4afb-8fb9-3813821de7c4",
                                "sense_id": "027c808b-f836-3bd2-947e-055b9d550c0b",
                                "text": "Or again, have you ever watched fine collie dogs couchant at twenty yards' distance?"
                            }
                        ]
                    },
                    {
                        "sense_id": "37fecf0e-92b0-3c0e-b9b1-fea25664d83b",
                        "entry_id": "98b2f4fb-fbf3-303e-9ee7-e284de20cc8b",
                        "glosses": [
                            "Represented as crouching with the head raised."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fbe708e2-6746-4351-b235-6e6f31f92bd6",
                                "sense_id": "37fecf0e-92b0-3c0e-b9b1-fea25664d83b",
                                "text": "His crest was covered with a couchant Hownd, / And all his armour seem'd of antique mould […]"
                            }
                        ]
                    }
