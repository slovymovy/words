                "senses": [
                    {
                        "sense_id": "63a21338-cc14-3d1c-9c87-ed63d09807ad",
                        "entry_id": "0b9bda28-59cd-31cb-a452-ea40fb512b37",
                        "glosses": [
                            "eine große Menge Blutes, die auf einmal hervorbricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49a1fc7-4a6a-4456-914e-c47c8759f1be",
                                "sense_id": "63a21338-cc14-3d1c-9c87-ed63d09807ad",
                                "text": "„Er schrie auf, taumelte hoch und besudelte die Oberdecke seines Bettes mit einem Blutschwall, der aus der rechten Seite unter dem Haar hervorquoll.“"
                            },
                            {
                                "example_id": "7374613a-ca53-4ff4-b330-7c73c53739a0",
                                "sense_id": "63a21338-cc14-3d1c-9c87-ed63d09807ad",
                                "text": "„Auf einer „Silly Hats Only“-Party wird ein Zylinderträger von den anderen Anwesenden gelyncht und zwei Männchen sprechen erneut Nonsense, woraufhin aus dem Auge des einen ein Blutschwall strömt und den anderen in Blut tränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
