                    {
                        "sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
                        "entry_id": "a91de9e3-67c2-391d-8d89-1da2b324c659",
                        "glosses": [
                            "Having or showing pluck, courage or spirit in trying circumstances."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "69c3e511-7512-44b8-9647-bfcafcb9bc45",
                                "sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
                                "text": "For my military knowledge, though I'm plucky and adventury, / Has only been brought down to the beginning of the century"
                            },
                            {
                                "example_id": "a04f9474-31dd-47c4-a5fd-a2c4515675ae",
                                "sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
                                "text": "\"Dam' plucky of you, fixing it up like that. I kept that copper talking...give you a chance. By George, you did it perfectly.\""
                            },
                            {
                                "example_id": "067df42b-27a4-423d-ae6d-765184c81898",
                                "sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
                                "text": "At the start of the hearing, Mr. Bezos introduced himself as a lucky and humble example of the success of American democracy — the son of a plucky mother and a supportive, immigrant father who “fostered my curiosity and encouraged me to dream big.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34758cab-9e93-474d-a4a9-80fb010c408b",
                        "source_entry_id": "a91de9e3-67c2-391d-8d89-1da2b324c659",
                        "source_sense_id": "575a0bb7-1ef9-3635-9df6-bc79ebcaee4b",
