                    "frequency": "High",
                    "semantic_group_id": "peinture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant trempe son <w>pinceau</w> dans la gouache bleue pour peindre le ciel."
                        },
                        {
                            "text": "Il applique un dernier coup de <w>pinceau</w> sur le cadre en bois avant de le laisser sécher."
                        }
                    ],
                    "synonyms": [
                        "brosse"
                    ],
                    "common_phrases": [
