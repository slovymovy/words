                "senses": [
                    {
                        "sense_id": "09710a6c-9938-3e53-9510-d6c591b5475a",
                        "entry_id": "d898ecdb-a940-311b-8445-18bfc144ba7e",
                        "glosses": [
                            "Que l’on peut passer à gué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d7115a-0e1a-4480-9e5b-152dfd4f5362",
                                "sense_id": "09710a6c-9938-3e53-9510-d6c591b5475a",
                                "text": "Voilà pourquoi il faut franchir les rivières sous la conduite d'un guide local qui connaisse les points guéables."
                            },
                            {
                                "example_id": "ead9378a-8c4d-42af-85b4-635510121906",
                                "sense_id": "09710a6c-9938-3e53-9510-d6c591b5475a",
                                "text": "Son embouchure, à 32 ou 33 kilomètres au sud de Safi, est bloquée par une barre guéable à marée basse pendant presque toute l'année."
                            },
                            {
                                "example_id": "edce2c80-b0fa-42ba-a17a-ca59188dc5f8",
                                "sense_id": "09710a6c-9938-3e53-9510-d6c591b5475a",
                                "text": "[…]; mais la colonne resta bloquée à Dar El-Caïd Hafed par l’impraticabilité des pistes et des oueds. Ce ne fut que le 23, le Zegotta et le Mekkès étant devenus guéables, qu’elle put enfin quitter le territoire des Cherarda."
                            },
                            {
                                "example_id": "cc69c25a-d86d-459a-aa3c-e6306919602b",
                                "sense_id": "09710a6c-9938-3e53-9510-d6c591b5475a",
                                "text": "[…] sans s’informer si l'onde\nÉtait ou guéable ou profonde."
                            }
                        ]
                    }
                ],
