                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c052510-bb95-48d7-be3d-224368eb676e",
                        "source_entry_id": "a5da4e77-7c49-3c62-9640-8cf1a4d679d1",
                        "source_sense_id": "719b09ed-df79-3790-b42f-fb7a4b884179",
                        "source_sense_description": "soziales Netzwerk",
                        "target_lang_word": "TikTok",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "TikTok",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a949323-f07a-388c-871e-80f003b4cc33",
                                        "entry_id": "23249605-0b3d-3c69-a01c-b7d2b4161f41",
