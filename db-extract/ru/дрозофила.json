                "senses": [
                    {
                        "sense_id": "2f71108e-d1bd-3648-92a7-bf15afa86945",
                        "entry_id": "0b0104b1-fbce-3c3d-b90c-742935fa7def",
                        "glosses": [
                            "энтомол. мелкая плодовая мушка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570eccca-4c5a-4949-abdf-8bd17423f9f9",
                                "sense_id": "2f71108e-d1bd-3648-92a7-bf15afa86945",
                                "text": "На Сейшельских островах, что в Индийском океане не далеко от Африки, обитают многие виды знаменитой в генетике мушки дрозофилы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4230803c-8b3d-45e9-ac93-437f3c3c3ef2",
                        "source_entry_id": "0b0104b1-fbce-3c3d-b90c-742935fa7def",
                        "source_sense_id": "2f71108e-d1bd-3648-92a7-bf15afa86945",
                        "target_lang_word": "drosophila",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drosophila",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1419b73b-c011-3b26-8888-b36a455d049c",
                                        "entry_id": "241b0b04-f5ca-3df5-a154-dd0016ee76da",
                                        "glosses": [
                                            "Any fruit fly of the genus Drosophila"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "098c33fa-4601-4c75-a4b3-db3698b5bf23",
                                                "sense_id": "1419b73b-c011-3b26-8888-b36a455d049c",
                                                "text": "In contrast, the drosophilas of Hawaii owe their oddity entirely to the whims of natural selection."
                                            },
                                            {
                                                "example_id": "834819e5-e924-4e63-8ff7-10ec5e1540a2",
                                                "sense_id": "1419b73b-c011-3b26-8888-b36a455d049c",
                                                "text": "Moreover, the host plant relationships of cactus-specific drosophilae which serve as dispersal agents are well known (Fellows and Heed, 1972; Heed, 1978). The discussion which follows is based on the above studies of yeasts, cacti and drosophilae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5ae21de-179c-4ecc-858f-b438a978ae89",
                        "source_entry_id": "0b0104b1-fbce-3c3d-b90c-742935fa7def",
                        "source_sense_id": "2f71108e-d1bd-3648-92a7-bf15afa86945",
