                        "glosses": [
                            "Relating to appellation or naming."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c3222b9-d1e1-401e-934f-0da9f1b58989",
                                "sense_id": "2787b50c-d67e-39dd-959f-163359eac418",
                                "text": "It will, moreover, be convenient to keep a separate place (6) for names attributable to miscellaneous fancies; while, lastly (7), we shall speak of those appellational oddities which cease to be oddities, or become less odd than before, when they area rightly understood."
                            },
                            {
                                "example_id": "19d9db71-f34d-4272-a7c5-cb67ea8faa86",
                                "sense_id": "2787b50c-d67e-39dd-959f-163359eac418",
                                "text": "From thy appellational womb / spew birth-gusts of great worms"
                            },
                            {
                                "example_id": "30afa66f-e689-4657-8ab9-5c24738732fb",
                                "sense_id": "2787b50c-d67e-39dd-959f-163359eac418",
                                "text": "In the military, appellational protocol is mandatory. A corporal or sergeant would never dare address a captain or a major by his or her first name."
                            }
                        ]
