                ],
                "senses": [
                    {
                        "sense_id": "910bcff9-4d43-3715-b927-d8381cb7a991",
                        "entry_id": "da4f739b-f188-38e8-b227-e89ebb62da85",
                        "glosses": [
                            "Hauptstadt eines bestimmten Verwaltungsgebiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f16a6e-ce37-4a26-9d27-8116a812c560",
                                "sense_id": "910bcff9-4d43-3715-b927-d8381cb7a991",
                                "text": "„Radikalislamische Taliban haben in der Nacht zu Freitag die ostafghanische Provinzhauptstadt Gasni attackiert.“"
                            },
                            {
                                "example_id": "878bb25a-1e97-4226-83b3-aafe3398159e",
                                "sense_id": "910bcff9-4d43-3715-b927-d8381cb7a991",
                                "text": "„Die letzten Jungen und der Trainer waren am Dienstagabend aus der Tropfsteinhöhle Tham Luang-Khun Nam Nang Non im Norden des Landes befreit worden. […] Sie sind derzeit noch zur Beobachtung im Krankenhaus der Provinzhauptstadt Chiang Rai.“"
                            },
                            {
                                "example_id": "d36636c1-5a34-4ea9-9678-a665d89304aa",
                                "sense_id": "910bcff9-4d43-3715-b927-d8381cb7a991",
                                "text": "„Dafür mietete sie eine Wohnung in der Provinzhauptstadt an, wo die Kinder versorgt, aber nicht mütterlich betreut waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
