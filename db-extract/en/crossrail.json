                    {
                        "sense_id": "553d6184-83d6-32c9-9514-2ee682d53001",
                        "entry_id": "b61e58af-ab91-3e7e-a39d-a0ebd1099323",
                        "glosses": [
                            "A rail that goes across something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfe24e9-0631-4360-8125-dbf491bed180",
                                "sense_id": "553d6184-83d6-32c9-9514-2ee682d53001",
                                "text": "The stroke of the planer is remarkably uniform, the reverse taking place at the same the same screws which carry the crossrail."
                            },
                            {
                                "example_id": "3770b1b0-b40c-4866-ae51-17df82af67c7",
                                "sense_id": "553d6184-83d6-32c9-9514-2ee682d53001",
                                "text": "After you have done caveletti for a little bit you should go into small crossrails about 1 foot high."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e85cde0-983e-38cb-bbcd-ece2c9e34d98",
                        "entry_id": "b61e58af-ab91-3e7e-a39d-a0ebd1099323",
                        "glosses": [
                            "A commuter rail line that crosses a major city through a tunnel and which continues for a significant distance into the surrounding areas, generally with relatively high speeds and widely spaced stations compared to an underground or metro."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "6e46505c-6672-42f7-b06e-0676bb032c5f",
                                "sense_id": "1e85cde0-983e-38cb-bbcd-ece2c9e34d98",
                                "text": "A crossrail link to Aberdeen and Stonehaven is planned."
                            },
                            {
                                "example_id": "206df24a-a671-43bf-bdb1-3fe1a0ed8c37",
                                "sense_id": "1e85cde0-983e-38cb-bbcd-ece2c9e34d98",
                                "text": "We need to change the name of the Manchester Hub. Crossrail for the north of England is a better term, otherwise people will view it as a Greater Manchester project and will miss out on exactly what it is actually going to do."
                            },
                            {
                                "example_id": "29dc0460-8ba4-4654-b5e3-97af8661797a",
                                "sense_id": "1e85cde0-983e-38cb-bbcd-ece2c9e34d98",
                                "text": "The proposal to build a second Crossrail line would create a new high-frequency, high-capacity rail line running south west to north east across London."
                            }
                        ]
                    }
