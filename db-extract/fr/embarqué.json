                                                "sense_id": "8311aaa5-c9ab-36f8-8052-57540e34a7bf",
                                                "text": "Near Maldonado I saw estuary shells of recent species embedded in clay, and raised above the level of a neighbouring fresh-water lake."
                                            },
                                            {
                                                "example_id": "d1c075f6-f4a3-4587-8aa4-b51de9d81ef8",
                                                "sense_id": "8311aaa5-c9ab-36f8-8052-57540e34a7bf",
                                                "text": "That is, a program which will execute in an embedded target computer is developed on a host computer which offers extensive support facilities."
                                            }
                                        ]
                                    },
