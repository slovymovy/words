{
    "word_family": [
        "queasiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f65a929a-d485-3ed4-9a7f-8c51ed866b7d",
                    "sense_definition": "Experiencing or causing nausea or an unsettled stomach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nausea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rough boat ride made everyone feel <w>queasy</w>.",
                            "target_lang_translations": {
                                "zh": "颠簸的船程让每个人都感到<w>恶心</w>。"
                            }
                        },
                        {
                            "text": "The smell of the garbage made me feel <w>queasy</w> and <w>sick</w> to my stomach.",
                            "target_lang_translations": {
                                "zh": "垃圾的臭味让我感到<w>反胃</w>，胃里很不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nauseous",
                        "sick",
                        "ill"
                    ],
                    "common_phrases": [
                        "feel queasy",
                        "sick to my stomach"
                    ],
                    "target_lang_definitions": {
                        "zh": "感到恶心或胃部不适。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶心",
                                "target_lang_sense_clarification": "指感到胃部不适，想呕吐。"
                            },
                            {
                                "target_lang_word": "反胃",
                                "target_lang_sense_clarification": "指胃里翻腾，有呕吐感。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5095138b-bc7c-3827-b26f-2e8dc6821edc",
                    "sense_definition": "Easily troubled or bothered by unpleasant things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nausea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is too <w>queasy</w> to watch horror movies.",
                            "target_lang_translations": {
                                "zh": "他太<w>胆小</w>了，不敢看恐怖电影。"
                            }
                        },
                        {
                            "text": "She felt <w>queasy</w> about the unethical decision made by the company.",
                            "target_lang_translations": {
                                "zh": "她对公司做出的不道德决定感到<w>不安</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squeamish",
                        "faint-hearted"
                    ],
                    "target_lang_definitions": {
                        "zh": "容易因不愉快的事物而感到不安或难受。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易受惊的",
                                "target_lang_sense_clarification": "指心理上容易感到不安或害怕。"
                            },
                            {
                                "target_lang_word": "神经质的",
                                "target_lang_sense_clarification": "指对不愉快的事物过于敏感。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}