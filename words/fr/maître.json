                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le client a rendez-vous avec <w>Maître</w> Dupont, avocat au barreau de Paris."
                        },
                        {
                            "text": "Le notaire, <w>maître</w> Martin, a lu le testament devant toute la famille."
