                "senses": [
                    {
                        "sense_id": "05b74562-5486-3cd9-a42f-ff7a79b6eacc",
                        "entry_id": "03a86c37-8179-3647-af5d-23eb59aee450",
                        "glosses": [
                            "dotyczący wyobrażenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35ea0a3-e44b-4fae-89f1-50d466072fa1",
                                "sense_id": "05b74562-5486-3cd9-a42f-ff7a79b6eacc",
                                "text": "Ćwiczenia fizyczne są w ich wykonaniu zachowaniami kompulsywnymi, kompensującymi wyobrażeniowe niedostatki dotyczące fizycznego wyglądu"
                            },
                            {
                                "example_id": "4477a974-f268-488b-812e-bd1397eab965",
                                "sense_id": "05b74562-5486-3cd9-a42f-ff7a79b6eacc",
                                "text": "Jeżeli więc nawet nie cechował go ejdetyzm, to przynajmniej jego zdolności wyobrażeniowe były na pewno ponadprzeciętne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
