            {
                "entry_id": "2618c670-7840-346a-b44a-001e650f5298",
                "word": "yéniche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bb96b58c-76ed-3e8d-badf-362cb4afe82e",
                        "entry_id": "2618c670-7840-346a-b44a-001e650f5298",
                        "glosses": [
                            "Langue des Yéniches, apparentée à l’allemand et parlée par des minorités linguistiques en Allemagne, Autriche, Bénélux, France et Suisse."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ece359d-484e-42d1-b99c-52e3a69e7c6b",
                        "source_entry_id": "2618c670-7840-346a-b44a-001e650f5298",
                        "source_sense_id": "bb96b58c-76ed-3e8d-badf-362cb4afe82e",
                        "target_lang_word": "Jenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a530b9cf-bb9c-3ea5-9d02-e736343394b6",
                                        "entry_id": "13d95153-53df-3c12-970f-0ea440cef04b",
                                        "glosses": [
                                            "regionale, süddeutsche Form des Rotwelschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa869260-1a9b-4fb9-b56d-2e589634823d",
                                                "sense_id": "a530b9cf-bb9c-3ea5-9d02-e736343394b6",
                                                "text": "„Im mittelfränkischen Schillingsfürst (bei Rothenburg ob der Tauber) hat sich das »Schillingsfürster Jenisch« eingenistet und ganz in der Nähe davon, in Schopfloch, die Händlersprache »Lachoudisch« erhalten.“"
                                            },
                                            {
                                                "example_id": "e10ed814-26ce-4671-adf2-a1a524580794",
                                                "sense_id": "a530b9cf-bb9c-3ea5-9d02-e736343394b6",
                                                "text": "„In Süddeutschland wurde diese Sprache auch Jenisch genannt.“"
                                            },
                                            {
                                                "example_id": "12610c8f-d45a-42cc-8a92-c369cfb14867",
                                                "sense_id": "a530b9cf-bb9c-3ea5-9d02-e736343394b6",
                                                "text": "„Das Rotwelsch, JENISCH oder PLATT ist mehr als 700 Jahre alt.“"
                                            },
                                            {
                                                "example_id": "b8266b41-7f8e-4e5d-b9e9-4862e5661f88",
                                                "sense_id": "a530b9cf-bb9c-3ea5-9d02-e736343394b6",
                                                "text": "„Jenisch als Sondersprache ist eine Mischspache, die sich vor allem durch eine Sonderlexik auszeichnet, wobei ein einzelner Sprecher heutzutage im Durchschnitt über einen Sonderwortschatz von rund 500 Wörtern oder Basismorphemen verfügt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Jenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                        "entry_id": "b852a6cd-3045-3bbc-9501-4221cc9c8fb8",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6ebefa-8804-4259-8f16-f85ba6e70f8e",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Der Jenisch trägt nie die Schals, die die Jenisch ihm strickt."
                                            },
                                            {
                                                "example_id": "43b46ae5-2bbf-4a91-963c-7f18e7e2a489",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jenisch kommt, geht der Herr Jenisch.“"
                                            },
                                            {
                                                "example_id": "2cf23d89-b97d-4ffe-b238-147613307605",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Jenisch kommt und geht."
                                            },
                                            {
                                                "example_id": "2d67054b-5f5a-45dd-b359-84fb513d9ece",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Frau Jenisch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "098af4a8-4d6c-48b6-bea7-ed822096905d",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Herr Jenisch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "db817ba8-87be-4c75-9f80-96eadf89faa9",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Die Jenischs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "f3ab357d-c5f9-44d1-8101-a6f6d018cc29",
                                                "sense_id": "a09dbab5-9ed1-3572-a86f-a8a05719359c",
                                                "text": "Jenischs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
