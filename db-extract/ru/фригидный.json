                                        "sense_id": "7bacd325-fe29-3a73-ac8d-d5e9a6b93c6c",
                                        "entry_id": "0e65bb60-2982-3b41-ab3a-24f03758b39f",
                                        "glosses": [
                                            "Chilly in manner; lacking affection or zeal; impassive."
                                        ],
