{
    "word_family": [
        "aanmerking",
        "merk",
        "merken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23ee66b5-7f4a-3ee2-a29d-fec250dc1304",
                    "sense_definition": "Opmerkingen maken, meestal met de suggestie van kritiek of afkeuring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kritiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt altijd wel iets <w>aanmerken</w> op het werk van een ander.",
                            "target_lang_translations": {
                                "en": "You can always find something to <w>criticize</w> in someone else's work."
                            }
                        },
                        {
                            "text": "Zij had veel <w>aan te merken</w> op het nieuwe beleid van de directie.",
                            "target_lang_translations": {
                                "en": "She had a lot to <w>criticize</w> about the board's new policy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets aan te merken hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "To make remarks, usually suggesting criticism or disapproval."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "criticize",
                                "target_lang_sense_clarification": "to express disapproval or point out faults"
                            },
                            {
                                "target_lang_word": "find fault with",
                                "target_lang_sense_clarification": "to look for and complain about mistakes or flaws"
                            },
                            {
                                "target_lang_word": "object to",
                                "target_lang_sense_clarification": "to express opposition or disapproval"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9298716f-de21-3dcf-9532-3e95e45c7b6e",
                    "sense_definition": "Beschouwen of bestempelen als iets specifieks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd ten onrechte als hoofdverdachte <w>aangemerkt</w>.",
                            "target_lang_translations": {
                                "en": "He was wrongly <w>designated</w> as the prime suspect."
                            }
                        },
                        {
                            "text": "De belastingdienst zal deze inkomsten <w>aanmerken</w> als winst.",
                            "target_lang_translations": {
                                "en": "The tax authorities will <w>regard</w> this income as profit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aanmerken als"
                    ],
                    "target_lang_definitions": {
                        "en": "To consider, designate, or label as something specific."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "to consider or think of in a specified way"
                            },
                            {
                                "target_lang_word": "designate",
                                "target_lang_sense_clarification": "to officially label or classify as"
                            },
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to deem or view as"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41312ac8-0cd0-37d1-b79c-424d42ed442a",
                    "sense_definition": "Waarnemen, opmerken of nota nemen van iets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waarnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder dat men het <w>aanmerkt</w>, verandert de situatie langzaam.",
                            "target_lang_translations": {
                                "en": "Without anyone <w>noticing</w> it, the situation is slowly changing."
                            }
                        },
                        {
                            "text": "Men moet goed <w>aanmerken</w> hoe deze processen verlopen.",
                            "target_lang_translations": {
                                "en": "One must <w>note</w> well how these processes proceed."
                            }
                        }
                    ],
                    "synonyms": [
                        "merken",
                        "opmerken"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In de betekenis van waarnemen of opmerken is het woord verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To perceive, notice, or take note of something (dated)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "notice",
                                "target_lang_sense_clarification": "to become aware of"
                            },
                            {
                                "target_lang_word": "note",
                                "target_lang_sense_clarification": "to pay attention to or observe carefully"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}