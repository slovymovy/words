            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3917d39b-8dfe-39d1-bacb-ba0829d9f464",
                    "sense_definition": "ein scharfes, reibendes Geräusch erzeugen wie entweichende Luft, kochendes Fett oder eine Schlange",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das heiße Fett <w>zischt</w> laut beim Braten des Fleisches in der Pfanne."
                        },
                        {
                            "text": "Die bedrohte Schlange hob ihren Kopf und <w>zischte</w> gefährlich im Gras."
                        }
                    ],
                    "synonyms": [
                        "fauchen"
                    ],
                    "common_phrases": [
                        "in der Pfanne zischen"
                    ]
                },
                {
                    "sense_id": "15bbbd66-0b2a-34f0-a1b2-e1bd91ba05f9",
                    "sense_definition": "in scharfem, zornigem Tonfall leise oder flüsternd sprechen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sprechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„Sei endlich ruhig!“, <w>zischte</w> sie ihrer Nachbarin während des Konzerts ärgerlich zu."
                        },
                        {
                            "text": "Er <w>zischte</w> eine wütende Drohung, bevor er den Raum hastig verließ."
                        }
                    ],
                    "common_phrases": [
                        "wütend zischen"
                    ]
                },
                {
                    "sense_id": "51ecb290-b685-3caa-bb07-05fdc8a730cb",
                    "sense_definition": "sich sehr schnell und meist mit einem sausenden Laut fortbewegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eine helle Rakete <w>zischte</w> in der Silvesternacht hoch über die dunklen Dächer."
                        },
                        {
                            "text": "Der schnelle Zug <w>zischte</w> ohne anzuhalten am Bahnsteig der kleinen Station vorbei."
                        }
                    ],
                    "synonyms": [
                        "rasen",
                        "sausen"
                    ],
                    "common_phrases": [
                        "durch die Luft zischen"
                    ]
                },
                {
                    "sense_id": "5955f6db-b21f-3d71-a073-30bcae42974f",
                    "sense_definition": "hastig oder mit großem Genuss ein meist alkoholisches Getränk konsumieren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der anstrengenden Schicht wollen die Arbeiter noch gemeinsam ein kühles Bier <w>zischen</w>."
                        },
                        {
                            "text": "Wir haben gestern Abend in der gemütlichen Kneipe ein paar Getränke <w>gezischt</w>."
                        }
                    ],
                    "synonyms": [
                        "einen heben",
                        "trinken"
                    ],
                    "common_phrases": [
                        "ein Bier zischen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich verwendet"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60756e79-c30a-332b-a153-d031e2a8ff26",
                    "sense_definition": "scharfer, reibender Laut, der durch entweichendes Gas, Hitze oder Tiere erzeugt wird",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das laute <w>Zischen</w> des defekten Ventils erschreckte alle Arbeiter in der Fabrik."
                        },
                        {
                            "text": "Aus dem Gebüsch am Wegrand war plötzlich ein bedrohliches <w>Zischen</w> zu hören."
                        }
                    ],
                    "common_phrases": [
                        "ein lautes Zischen"
                    ]
                }
            ]
        }
    ]
