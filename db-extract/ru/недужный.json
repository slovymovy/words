                ],
                "senses": [
                    {
                        "sense_id": "e3bca8a1-ce07-3203-b1ed-e280b9a41929",
                        "entry_id": "a0434f93-af92-35d9-a272-ad290e70f9cf",
                        "glosses": [
                            "устар. слабый, больной; немощный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b133226a-e40a-4c44-8ba6-261bc4377d3a",
                                "sense_id": "e3bca8a1-ce07-3203-b1ed-e280b9a41929",
                                "text": "В домах остались лишь трехлетние дети и недужные старики."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e063185-cf6b-398b-9e33-6a960734f277",
                        "entry_id": "a0434f93-af92-35d9-a272-ad290e70f9cf",
                        "glosses": [
                            "субстантивир. больной человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c66896-ec23-4a6f-beca-867c7fbdd966",
                                "sense_id": "2e063185-cf6b-398b-9e33-6a960734f277",
                                "text": "Варвары опустошили домы, храм Десятинный, Софийский, монастыри; умертвили старцев и недужных; оковали цепями молодых и здоровых; не щадили ни знаменитых людей, ни юных жен, ни священников, ни монахинь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c74f9b16-9f27-4d47-93ba-ad9c44d134d9",
                        "source_entry_id": "a0434f93-af92-35d9-a272-ad290e70f9cf",
                        "target_lang_word": "ailing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af6f2c73-50a2-3eb7-80f5-a5026f2791b6",
                                        "entry_id": "2f405b86-3114-3eaa-8ed0-ecc2c467f6a3",
                                        "glosses": [
                                            "An ailment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db431eb-90c4-47ea-8644-7ec05c92a383",
                                                "sense_id": "af6f2c73-50a2-3eb7-80f5-a5026f2791b6",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ailing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d79a8dc3-8e38-37b5-b490-b7083732f865",
                                        "entry_id": "b251cb57-1183-3046-aa85-54ec55396d5a",
                                        "glosses": [
                                            "present participle and gerund of ail"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ailing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "821ea901-8ec4-3265-966b-a295a8f9379d",
                                        "entry_id": "919fa819-c50b-33d1-abb6-8c9a0efd37b3",
                                        "glosses": [
                                            "Sickly; sick; ill; unwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe87185-91cf-46b0-9cb7-3437053bdb6e",
                                                "sense_id": "821ea901-8ec4-3265-966b-a295a8f9379d",
                                                "text": "She cared for her ailing brother day in, day out."
                                            },
                                            {
                                                "example_id": "4d4a4520-1c9a-425f-8ff3-de1e3b3d3025",
                                                "sense_id": "821ea901-8ec4-3265-966b-a295a8f9379d",
                                                "text": "Based on the successful Class 59 but with a much more modern engine, what was to become the Class 66 was designed to replace much of the company's elderly and ailing locomotive fleet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
