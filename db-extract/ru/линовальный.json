                ],
                "senses": [
                    {
                        "sense_id": "010f4c18-1eac-3dab-8248-8d81a429ca5a",
                        "entry_id": "13f8956d-d20a-3d64-85f1-b4ffbd169b1d",
                        "glosses": [
                            "связанный с линованием, предназначенный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf53bdb-1382-4722-84ad-e9c75345016b",
                                "sense_id": "010f4c18-1eac-3dab-8248-8d81a429ca5a",
                                "text": "Принадлежности линовальные (ЛП-1) (рис. 84, в) предназначены для выполнения различных разграфок и штриховальных работ. В комплект линовальных принадлежностей входят пропорциональные линейки и два прямоугольных равнобедренных треугольника с катетами 50 и 100 мм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "751f9437-70df-4363-8279-7ce9452de0e3",
                        "source_entry_id": "13f8956d-d20a-3d64-85f1-b4ffbd169b1d",
                        "source_sense_id": "010f4c18-1eac-3dab-8248-8d81a429ca5a",
                        "target_lang_word": "linear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff731926-5ece-383c-b68c-c285b2723ce1",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "Having the form of a line; straight or roughly straight; following a direct course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aede525-4716-498a-b322-0fd39ed5d952",
                                                "sense_id": "ff731926-5ece-383c-b68c-c285b2723ce1",
                                                "text": "The route taken does not have to be a perfectly straight line, just so long as it is linear and is followed consistently for each transect taken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1fd40f-53e7-3ab9-a3b3-c81e773e4e47",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "Of or relating to lines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f3a6db9-bbfb-3074-be0b-3215fadd1230",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "Made, or designed to be used, in a step-by-step, sequential manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2329c14b-dd4c-4ee8-aba6-4c3724c21aef",
                                                "sense_id": "1f3a6db9-bbfb-3074-be0b-3215fadd1230",
                                                "text": "a linear medium"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a17d051-0c28-3964-b59e-cd181bcd258f",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "Long and narrow, with nearly parallel sides."
                                        ],
                                        "tags": [
                                            "of leaves"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25d3fe15-4c8a-3dc2-9e40-07df1d5fad71",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "(of polynomials or polynomial equations)",
                                            "Having degree one; that is, being of the form a_1x_1+a_2x_2+⋯+a_nx_n+b, where each x_i is a variable. See also Linear polynomials on Wikipedia.Wikipedia"
                                        ],
                                        "tags": [
                                            "of a polynomial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56ae87e-336f-4c14-ac89-c3d9a552b738",
                                                "sense_id": "25d3fe15-4c8a-3dc2-9e40-07df1d5fad71",
                                                "text": "4x#43;5y#43;#92;frac#123;1#125;#123;2#125;z is a linear polynomial, but 4xy#43;#92;frac#123;1#125;#123;2#125;z and 4x#43;z² are not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e2be317-f96a-3291-a182-51c623f514c7",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "(of polynomials or polynomial equations)",
                                            "Involving only linear polynomials. See also Linear equation on Wikipedia.Wikipedia"
                                        ],
                                        "tags": [
                                            "of a polynomial equation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30285a36-f382-4820-bcb0-28cc6ef48fda",
                                                "sense_id": "4e2be317-f96a-3291-a182-51c623f514c7",
                                                "text": "The graph of the linear equation y#61;ax#43;b is a straight line with slope a and y-intercept b"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885f6b1f-7cba-3bec-b4b9-89a1fbefebea",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "(of functions or maps)",
                                            "An additive, homogeneous mapping; that is, a function f:V→W is linear if it distributes over vector addition (f( mathbf v+ mathbf w)=f( mathbf v)+f( mathbf w)) and respects scalar multiplication (f(c mathbf v)=cf( mathbf v)). If V and W are vector spaces over a field K, f may also be called a K-linear map. See also linear map on Wikipedia.Wikipedia"
                                        ],
                                        "tags": [
                                            "of a function between vector spaces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9253f9e7-4030-410b-8fed-fcf47ac1b6ed",
                                                "sense_id": "885f6b1f-7cba-3bec-b4b9-89a1fbefebea",
                                                "text": "The map f#58;#92;mathbb#123;R#125;³#92;to#92;mathbb#123;R#125;² taking (x,y,z)#92;mapsto(x#43;y#43;z,x-y#43;3z) is a linear map."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e20da31b-2be9-3bc7-aa44-6214dec6dbc1",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "(of functions or maps)",
                                            "A module homomorphism; that is, a group homomorphism that commutes with scalar multiplication. See also Module homomorphism on Wikipedia.Wikipedia"
                                        ],
                                        "tags": [
                                            "of a function over a module"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e78405fc-f542-37fd-81d0-b4a6d74e4ead",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "A type of length measurement involving only one spatial dimension (as opposed to area or volume)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb0ca40-38c9-438d-b819-71eec268b8cd",
                                                "sense_id": "e78405fc-f542-37fd-81d0-b4a6d74e4ead",
                                                "text": "a linear meter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a753c05d-3c63-3c70-9e11-1f82f286f484",
                                        "entry_id": "189ab319-6cfb-3d82-90d7-9a3bc646ab02",
                                        "glosses": [
                                            "Delivered or delivering on a fixed schedule, as opposed to on-demand."
                                        ],
                                        "tags": [
                                            "of video and audio"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8e27952-5a30-4279-b45f-aec8c9a03170",
                                                "sense_id": "a753c05d-3c63-3c70-9e11-1f82f286f484",
                                                "text": "linear TV, linear content, linear video, linear radio"
                                            },
                                            {
                                                "example_id": "7b613800-38cc-49f6-841a-5d52e64e82fb",
                                                "sense_id": "a753c05d-3c63-3c70-9e11-1f82f286f484",
                                                "text": "Linear television is dead or, at least, declining."
                                            },
                                            {
                                                "example_id": "cf047df2-5d93-4d0d-b1b7-ba4ee1bec5e9",
                                                "sense_id": "a753c05d-3c63-3c70-9e11-1f82f286f484",
                                                "text": "Linear television includes traditional over-the-air broadcasting, as well as much cable and satellite broadcasting."
                                            },
                                            {
                                                "example_id": "606765bd-b1f5-4502-87c1-9bdafb10c242",
                                                "sense_id": "a753c05d-3c63-3c70-9e11-1f82f286f484",
                                                "text": "Linear radio relates to our well-known tune-in radio, where the listener depends on the programmers schedule. In non-linear radio applications, the listener is able to choose previously broadcast audio pieces, which are held in local storage of the receiver (“mailbox”)."
                                            }
                                        ]
                                    }
                                ]
                            },
