    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                "word": "dropbox",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e9ec451e-940b-4c88-9f99-75c91e19b0e7",
                        "entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "tags": [
                            "plural"
                        ],
                        "form": "dropboxes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ef77701-bc1e-37e0-ad0c-59033216088c",
                        "entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "glosses": [
                            "A box wherein objects can be deposited by one person for later collection by another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c19b302-fe92-44c0-99dc-99437a828e4c",
                                "sense_id": "8ef77701-bc1e-37e0-ad0c-59033216088c",
                                "text": "The two smaller slots are for the dropping of cash or markers into the dropbox when players cash these for casino chips."
                            },
                            {
                                "example_id": "7058ca51-44c9-4692-b93e-2fae17d627ac",
                                "sense_id": "8ef77701-bc1e-37e0-ad0c-59033216088c",
                                "text": "“The measures include things like enhanced power for poll ‘monitors,’ fewer voting drop-boxes, restrictions on voting by mail, penalties for election officials who fail to purge voters from the rolls, and enhanced power in politicians over election procedures.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "46d0e444-2049-3d7f-87ad-d19fd0502add",
                        "entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "glosses": [
                            "A computer folder to which files may be dragged and dropped and from which users of other computers on the network can access those files."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a80743-0135-4355-9bac-7bbe55efed60",
                                "sense_id": "46d0e444-2049-3d7f-87ad-d19fd0502add",
                                "text": "A desktop computer leaves changes in a dropbox on the network."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cdb1916-0188-3171-bdd7-37a977720e7a",
                        "entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "glosses": [
                            "An enhancement to a loom that allows patterns of multiple colors to be woven from the same loom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c01e691-a07c-4c61-9d17-5df53fcb2796",
                                "sense_id": "3cdb1916-0188-3171-bdd7-37a977720e7a",
                                "text": "In 1738, John Kay, a native of Bury (though at the time residing in Colchester) invented the fly-shuttle, and in 1760 his son Robert invented the dropbox, by which patterns of various colours are woven nearly with the same facility as plain calico."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66e31213-a4dc-41be-a965-15415f0be7e5",
                        "source_entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "source_sense_description": "physical box",
                        "target_lang_word": "boîte de dépôt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boîte de dépôt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb88d13-a664-3604-b8fb-00b3ab06fb31",
                                        "entry_id": "21495aaf-45e3-3e16-8210-0e4da81d3b6c",
                                        "glosses": [
                                            "Boîte dans laquelle un objet peut être déposé par une personne pour être récupéré plus tard par une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb75b7e4-2c0a-49ce-9448-3bb471a34fa4",
                                                "sense_id": "4bb88d13-a664-3604-b8fb-00b3ab06fb31",
                                                "text": "Du côté des designers, on trouve de nouvelles propositions, comme une boîte de dépôt spécifique pour les colis, permettant d'éviter tout contact avec le livreur (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7121b6e4-f7bb-3b14-afd2-55e3278eec89",
                                        "entry_id": "21495aaf-45e3-3e16-8210-0e4da81d3b6c",
                                        "glosses": [
                                            "Dossier informatique dans lequel des fichiers peuvent être glissés-déposés depuis d’autres ordinateurs sur le réseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab8a4db-6bf6-45a0-b8bc-a0e5eda1bfc0",
                                                "sense_id": "7121b6e4-f7bb-3b14-afd2-55e3278eec89",
                                                "text": "Pour transmettre un fichier à un autre utilisateur, copiez-le dans la boîte de dépôt de cette personne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea167dd2-be17-4ae6-afb1-9dc14cb98d28",
                        "source_entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "source_sense_description": "physical box",
                        "target_lang_word": "urne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "953ea804-f952-3e83-b66f-b9a56c4861d0",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Vase de forme et de capacité variables qui, chez les anciens, servait à divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9fd1220-70ea-43c5-abf7-03eab03aec9b",
                                                "sense_id": "953ea804-f952-3e83-b66f-b9a56c4861d0",
                                                "text": "Dans cette urne sont les cendres du grand Pompée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24155a5-0299-3b19-b214-79fa342400a9",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Vases de porcelaine, de faïence ou d’autre matière, qui ont la forme des urnes antiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de0ef9f-2262-4839-815b-aa52dac455e3",
                                                "sense_id": "d24155a5-0299-3b19-b214-79fa342400a9",
                                                "text": "[…], et il exprimait un sentiment qui, en dépit des théories matérialistes, vivra toujours dans le cœur des simples : ceux qui ne comprennent pas qu'on puisse aller pleurer sur des cendres enfermées dans une urne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Contenant destiné à recevoir des bulletins de vote. → voir urne électorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8fbea9-9edd-4301-9ce3-8f73c10d1097",
                                                "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                                "text": "Vous aviez à élire un conseiller général. Il en est résulté des rixes autour des urnes, évidemment, des rixes sanglantes. Ma foi, tant pis : l'urne, même électorale, appelle le cadavre."
                                            },
                                            {
                                                "example_id": "dca05821-718b-428e-9382-a9e8cb22941d",
                                                "sense_id": "6b405b76-3b72-3b6d-9cff-4aed4f40aa6a",
                                                "text": "Quand, par un beau dimanche électoral, nous mettons notre bulletin dans l’urne, nous embarquons sans y penser toute l’histoire de la philosophie politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f30260d-882d-3b9d-ac2e-0a4f0b548a22",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Chez les mousses, organe contenant les spores et qui forme avec le filament qui le soutient le sporophyte. → voir capsule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd0f941-74cd-48df-bb14-88999d29f7ea",
                                                "sense_id": "9f30260d-882d-3b9d-ac2e-0a4f0b548a22",
                                                "text": "Urne ovale à cylindrique, non plissée, très rugueuse, dépourvue d’apophyse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ddfa2f-8f28-3248-b5f0-c867b90ef1e3",
                                        "entry_id": "1c7bd959-5bb7-3ce7-8dd6-d59a60c79080",
                                        "glosses": [
                                            "Chez certaines plantes carnivores, feuille spécialisée formant une cavité destinée à piéger des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71d4322-7f53-4226-ac98-2eac62ce8992",
                                                "sense_id": "52ddfa2f-8f28-3248-b5f0-c867b90ef1e3",
                                                "text": "Nepenthes madagascariensis : […] Face inférieure de l’opercule portant (30-) 50-80 (-100) glandes nectarifères; partie interne et renflée de l’urne ayant 250 à 380 glandes digestives par cm. Ascidies des formes de transition (rameaux courts), à urne allongée, cylindrique, sans ailes, à 2 nervures saillantes longitudinales, de couleur jaune ou jaune tacheté ou striée de rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3ed2b7c-86d1-4a42-a966-48623c767760",
                        "source_entry_id": "bbbb95f4-80fc-385c-b1f1-05345102db55",
                        "source_sense_description": "physical box",
                        "target_lang_word": "buzón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9e3c79-bd2f-3536-8788-c4cb51e44932",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Ranura para depositar envíos de correo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a0f8d1-b241-4b26-aacc-ee4344d43614",
                                                "sense_id": "ec9e3c79-bd2f-3536-8788-c4cb51e44932",
                                                "text": "Como andan las cosas tan trocadas, imaginé desde luego que habría participado ya mi naturaleza de esta atmósfera que respiramos, y que habría enviado al Español mi carta en vez del primer artículo de teatros que debía darle, y echado el original destinado a la imprenta en el buzón del correo, en vez de nuestra correspondencia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55f42701-830b-3419-a523-9ea9fb89b99a",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Recipiente al que se abre un buzón₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b58d922-9ea0-4674-933a-0d3542ea2d08",
                                                "sense_id": "55f42701-830b-3419-a523-9ea9fb89b99a",
                                                "text": "Lucía fue derecha al rojo reverbero del estanco, y acercándose a la caja de madera que hacía de buzón, echó en ella la epístola."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "32b7929e-0b15-3864-97e2-554fc0834049",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Por analogía, fichero o directorio en que se almacenan mensajes de correo electrónico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e39963f-3457-482c-b1ff-834cfbaed8a7",
                                                "sense_id": "32b7929e-0b15-3864-97e2-554fc0834049",
                                                "text": "Actualmente, el tamaño máximo asignado a cada buzón de Correo Electrónico del Ciudadano es de 10 MB, aunque en breve se ampliará su capacidad de almacenamiento."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fe079ff0-46a2-3582-a0ab-de0ac2750242",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Desagüe de un estanque o tanque de agua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07244e69-8401-4c46-b216-218ba3f7364c",
                                                "sense_id": "fe079ff0-46a2-3582-a0ab-de0ac2750242",
                                                "text": "Luego con ella enpareja\nun vezino a la sazón,\ny díxole, puta vieja,\nde rezar hazéis semeja\ny destapáis el buzón."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4936dcbd-d051-3b88-8cc7-8df379b43310",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Por analogía, boca grande."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa3cdc2-65de-4f76-a8d3-21ad81d9cbd3",
                                                "sense_id": "4936dcbd-d051-3b88-8cc7-8df379b43310",
                                                "text": "Y antes de que pudiera evitarlo me abrazó Rosaura por el gañote y en un rapto efusivo me largó una recatafila de besos en los cachetes, en la ñata y el buzón."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d175213f-fd9a-33d0-90e6-82367d99d0be",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Por metonimia, tapón de un buzón₄."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "35ab001e-54ca-3b7f-b030-9c59190da1c3",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Figuradamente, persona de contacto en una organización secreta."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "ffe95e2c-3033-3385-8919-0fee114c5ebd",
                                        "entry_id": "0c5a5e56-2562-3b6d-ac91-5006367dba33",
                                        "glosses": [
                                            "Celda de castigo."
                                        ],
                                        "tags": [
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf606409-09f2-45e3-a158-73e0e699af6d",
                                                "sense_id": "ffe95e2c-3033-3385-8919-0fee114c5ebd",
                                                "text": "—¿Será éste el precio por tantas noches en ‘el buzón’ de Las Heras?— interroga sin esperar respuesta.\n—¿En un buzón?\n—Así lo llamamos a un calabozo de ‘ablandamiento’; no quiero entristecerte."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
