                                                "sense_id": "f9cf53aa-d832-36bf-9e0c-c26ab1e1c330",
                                                "text": "Das ist ein analoger Fall."
                                            },
                                            {
                                                "example_id": "8ac09e72-4064-4d9a-80db-b9248b19c93d",
                                                "sense_id": "f9cf53aa-d832-36bf-9e0c-c26ab1e1c330",
                                                "text": "„Wie aus der Zusammenfassung der Entwicklung der Argumentation bei Kupisch ersichtlich, hat sich Kupisch von seiner ursprünglichen These einer analogen Anwendung des § 812 I 1 BGB im Laufe der Zeit tatsächlich immer weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b25ea0b8-75c1-3f5d-901a-c06eb53bb94f",
                                        "entry_id": "cec7ffe0-6bfe-3526-8c97-023d27043695",
                                        "glosses": [
                                            "stufenlos, kontinuierlich; nicht digital"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d80727b-30c1-4976-adc4-ae45d5ea5262",
                                                "sense_id": "b25ea0b8-75c1-3f5d-901a-c06eb53bb94f",
                                                "text": "Bei einem analogen Telefonanschluss ist die Stromstärke in der Leitung proportional zum momentanen Schalldruck am Mikrophon."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14ae2c95-c7ba-3b2f-b0db-83747126d57c",
                                        "entry_id": "cec7ffe0-6bfe-3526-8c97-023d27043695",
                                        "glosses": [
                                            "physisch (dinglich) vorhanden statt virtuell oder elektronisch dargestellt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb53b0b-a748-4a3f-aa49-375052160257",
                                                "sense_id": "14ae2c95-c7ba-3b2f-b0db-83747126d57c",
                                                "text": "Ich lese lieber ein anfassbares, analoges Buch als ein E-Book."
                                            },
                                            {
                                                "example_id": "9f575905-f081-4b40-95a9-4ea1272b1876",
                                                "sense_id": "14ae2c95-c7ba-3b2f-b0db-83747126d57c",
                                                "text": "In einem sozialen Medium wird man leichter in einer Blase einheitlicher Ansichten gefangen als in einem analogen Freundeskreis."
                                            },
                                            {
                                                "example_id": "a33b8316-2a4c-4bd8-af88-25855d8028c1",
                                                "sense_id": "14ae2c95-c7ba-3b2f-b0db-83747126d57c",
                                                "text": "„Das Project Breathe von Scott Unterberg entwickelte sich dank einer analogen Erfindung namens Adobe Kickbox von einer zusammengewürfelten Gruppe zu einer unternehmensweiten Initiative.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
